                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e496d06-2907-3ef5-afcf-a266786640e1",
                        "entry_id": "caa422b5-f9c8-3309-91ba-b29c5078e5f5",
                        "glosses": [
                            "Qui se trouve dans un état de sommeil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71923953-8e7d-49a5-8ca2-4527f0ddca15",
                                "sense_id": "2e496d06-2907-3ef5-afcf-a266786640e1",
                                "text": "« Vous qui faites l'endormie,\nN'entendez-vous pas,\nÔ Catherine, ma mie,\nMa voix et mes pas?... »"
                            },
                            {
                                "example_id": "d111634b-c240-422f-941a-71950b3117c7",
                                "sense_id": "2e496d06-2907-3ef5-afcf-a266786640e1",
                                "text": "Il avait réussi à prendre quelques photos : des CRS à moitié endormis, bottés et casqués, le Mauser lance-grenades à la bretelle, rencognés, non loin du CHU et de la fac de droit, comme une poignée d’oiseaux mouillés, sous les grimaces provocatrices et vengeresses des masques de pierre du vieil hôtel de Cerisy ; un garde-mobile ronflant la bouche ouverte, le visage grotesquement déformé par la vitre du car Berliet le long duquel sa joue s’était ventousée comme une limace ; un gradé en civil, arrogant et sec, juché sur le refuge central du carrefour des Palomières comme un coq sur son fumier."
                            },
                            {
                                "example_id": "27706093-bfb7-491f-9ae3-5ec80c476079",
                                "sense_id": "2e496d06-2907-3ef5-afcf-a266786640e1",
                                "text": "Cela ne réveilla pas le vieil homme endormi."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a3144e6-87e9-3ae9-8779-7a157c0979b1",
                        "entry_id": "caa422b5-f9c8-3309-91ba-b29c5078e5f5",
                        "glosses": [
                            "Qui manque de vivacité, qui est lent, paresseux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48371b0-09b7-4a00-ac34-853ace884d0e",
                                "sense_id": "2a3144e6-87e9-3ae9-8779-7a157c0979b1",
                                "text": "C’est un homme endormi, un esprit endormi."
                            },
                            {
                                "example_id": "b6e3a3bf-d769-4287-8d60-8ad20bed7f92",
                                "sense_id": "2a3144e6-87e9-3ae9-8779-7a157c0979b1",
                                "text": "Avoir l’air endormi."
                            },
                            {
                                "example_id": "5d133ad0-138c-4bd4-a26c-c5a049e2c052",
                                "sense_id": "2a3144e6-87e9-3ae9-8779-7a157c0979b1",
                                "text": "Il accordait à son frère une grande habileté. Selon lui, ce gros garçon endormi ne sommeillait jamais que d’un œil, comme les chats à l’affût devant un trou de souris."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89787f5c-32dd-4529-aa5d-edc17512fda8",
                        "source_entry_id": "caa422b5-f9c8-3309-91ba-b29c5078e5f5",
                        "source_sense_description": "Qui se trouve dans un état de sommeil",
                        "target_lang_word": "asleep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asleep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d703fc07-1016-3d86-adbc-676c0acbae09",
                                        "entry_id": "604390c0-8675-3f17-8b04-29c1f5b170ba",
                                        "glosses": [
                                            "In a state of sleep; also, broadly, resting."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631d98ea-1add-4c7c-bbc8-467ef0ae47b4",
                                                "sense_id": "d703fc07-1016-3d86-adbc-676c0acbae09",
                                                "text": "I was asleep when you called."
                                            },
                                            {
                                                "example_id": "d0a4fbae-6cf6-4383-a3dc-3763123dfbd2",
                                                "sense_id": "d703fc07-1016-3d86-adbc-676c0acbae09",
                                                "text": "Never disturb a man asleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e8d9321-ee37-39e7-bdd0-d8cbaddaf3d1",
                                        "entry_id": "604390c0-8675-3f17-8b04-29c1f5b170ba",
                                        "glosses": [
                                            "Inattentive."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9d33089-b93f-4492-80ad-4524a60616f8",
                                                "sense_id": "7e8d9321-ee37-39e7-bdd0-d8cbaddaf3d1",
                                                "text": "How could you miss that? Were you asleep?"
                                            },
                                            {
                                                "example_id": "50f534e0-2684-406b-b11c-f56e0e54b6d2",
                                                "sense_id": "7e8d9321-ee37-39e7-bdd0-d8cbaddaf3d1",
                                                "text": "The reason they call it the American Dream is because you have to be asleep to believe it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85434181-347f-3bac-b331-4b452ef54c3c",
                                        "entry_id": "604390c0-8675-3f17-8b04-29c1f5b170ba",
                                        "glosses": [
                                            "Having a numb or prickling sensation accompanied by a degree of unresponsiveness."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91da21f3-7f22-4ee1-9904-05882f2206d0",
                                                "sense_id": "85434181-347f-3bac-b331-4b452ef54c3c",
                                                "text": "My arm fell asleep. You know, like pins and needles."
                                            },
                                            {
                                                "example_id": "3fe2ad7f-4279-469e-81e3-4d9f6982ef4c",
                                                "sense_id": "85434181-347f-3bac-b331-4b452ef54c3c",
                                                "text": "Louisa sat in the car crying, until her foot fell asleep. She shook her foot violently, afraid the numbness would turn to frostbite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca9549f-2ec5-38bc-885d-f46160d71dbe",
                                        "entry_id": "604390c0-8675-3f17-8b04-29c1f5b170ba",
                                        "glosses": [
                                            "Dead."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
