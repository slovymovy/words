                        "examples": [
                            {
                                "example_id": "6d059c4d-bc26-423c-9089-74656b3f1828",
                                "sense_id": "3c5563ec-ba5a-33a6-8009-c76e9518bcfa",
                                "text": "La lecture des clichés induit alors soit à une cardiographie directe s’il s’agit de lésions situées au-dessus du bulbe carotidien, soit à une aortographie rétrograde si on est en présence de lésions congénitales à préciser."
                            },
                            {
                                "example_id": "cb2e1b18-7a33-48fd-bc31-136b3fd07c02",
                                "sense_id": "3c5563ec-ba5a-33a6-8009-c76e9518bcfa",
                                "text": "La radiographie est plus sensible que la cardiographie pour déceler les prépondérances envisagées comme suractivité fonctionnelle ou organique d’un ventricule ."
                            }
                        ]
                    }
