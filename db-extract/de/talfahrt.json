                "senses": [
                    {
                        "sense_id": "432ee26b-e5b7-3047-a000-5265df58249d",
                        "entry_id": "019f3712-8e8b-30e2-8b34-fc0055dea0a9",
                        "glosses": [
                            "Fahrt flussabwärts mit einem Schiff"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "1d5b734b-3f0f-432f-8094-beb5e0721861",
                                "sense_id": "432ee26b-e5b7-3047-a000-5265df58249d",
                                "text": "Die Talfahrt mit dem Dampfer geht deutlich schneller als die Bergfahrt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ae113b5-143f-321a-8d1f-e809f0c81b56",
                        "entry_id": "019f3712-8e8b-30e2-8b34-fc0055dea0a9",
                        "glosses": [
                            "Fahrt aus höheren in tiefer gelegene Bereiche"
                        ],
                        "tags": [
                            "Bergbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "727d61eb-180e-4d46-a696-1010e7fb1125",
                                "sense_id": "3ae113b5-143f-321a-8d1f-e809f0c81b56",
                                "text": "Bei der Bergbahn dauert die Bergfahrt genau so lang wie die Talfahrt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "359cdcd8-bdff-382a-9463-41b9b6768ce2",
                        "entry_id": "019f3712-8e8b-30e2-8b34-fc0055dea0a9",
                        "glosses": [
                            "Bewegung in ein niedrigeres Niveau"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "1a62c131-6877-47ee-afcb-de0b6be9ec96",
                                "sense_id": "359cdcd8-bdff-382a-9463-41b9b6768ce2",
                                "text": "„Befürchtet wird eine weitere heillose Talfahrt der Aktienkurse.“"
                            },
                            {
                                "example_id": "8d2cf73d-61a4-4dcd-9204-66e5328b0f74",
                                "sense_id": "359cdcd8-bdff-382a-9463-41b9b6768ce2",
                                "text": "Preis auf Talfahrt."
                            },
                            {
                                "example_id": "d808e68f-4f15-4fed-a500-9145477f2afb",
                                "sense_id": "359cdcd8-bdff-382a-9463-41b9b6768ce2",
                                "text": "Als Jonathan und seine Freunde die Schule verließen, hatte die Finanzkrise die englische Wirtschaft gerade auf Talfahrt geschickt."
                            },
                            {
                                "example_id": "c4ab9de6-ac90-4585-8f9d-b6641f181e1c",
                                "sense_id": "359cdcd8-bdff-382a-9463-41b9b6768ce2",
                                "text": "„Denn die Ökonomie war weiter auf Talfahrt, es regte sich immer lauter Unzufriedenheit in der Bevölkerung, und die lange vernachlässigten Kriegsveteranen begannen mobilzumachen.“"
                            },
                            {
                                "example_id": "da768a72-c6c2-492c-94af-f8f063afffd7",
                                "sense_id": "359cdcd8-bdff-382a-9463-41b9b6768ce2",
                                "text": "„Der VfL Wolfsburg hat am Sonntag auf die sportliche Talfahrt in der Fußball-Bundesliga reagiert und sich von Coach Niko Kovac getrennt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
