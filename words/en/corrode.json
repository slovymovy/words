{
    "word_family": [
        "corrosion",
        "corrosive",
        "corrodible",
        "corrosiveness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b42fb0ff-8b57-3e99-91ee-ab1849515667",
                    "sense_definition": "To eat away or destroy the surface of something gradually, especially by a chemical action like acid or oxidation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salt water began to <w>corrode</w> the metal hull of the ship over several years.",
                            "target_lang_translations": {
                                "ru": "Соленая вода начала <w>разъедать</w> металлический корпус корабля в течение нескольких лет."
                            }
                        },
                        {
                            "text": "Strong acids can quickly <w>corrode</w> metal pipes if they are not properly treated.",
                            "target_lang_translations": {
                                "ru": "Сильные кислоты могут быстро <w>разрушить</w> металлические трубы, если они не обработаны должным образом."
                            }
                        }
                    ],
                    "synonyms": [
                        "rust"
                    ],
                    "common_phrases": [
                        "corrode metal pipes",
                        "slowly corrode surfaces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно разрушать поверхность чего-либо, особенно в результате химического воздействия, такого как окисление или действие кислоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъедать",
                                "target_lang_sense_clarification": "о химическом воздействии"
                            },
                            {
                                "target_lang_word": "корродировать",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "разрушать",
                                "target_lang_sense_clarification": "поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7692f4c-3dd1-36b5-a883-584e88915136",
                    "sense_definition": "To gradually weaken, impair, or destroy something non-physical, such as morale, trust, or values.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant criticism and lack of support can <w>corrode</w> a person's confidence over time.",
                            "target_lang_translations": {
                                "ru": "Постоянная критика и отсутствие поддержки могут со временем <w>подорвать</w> уверенность человека в себе."
                            }
                        },
                        {
                            "text": "The scandal continued to <w>corrode</w> public trust in the local government.",
                            "target_lang_translations": {
                                "ru": "Скандал продолжал <w>разъедать</w> общественное доверие к местным властям."
                            }
                        }
                    ],
                    "synonyms": [
                        "waste",
                        "gnaw",
                        "canker"
                    ],
                    "common_phrases": [
                        "corrode public trust",
                        "corrode the spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно ослаблять, ухудшать или разрушать что-либо нематериальное, например, моральный дух, доверие или ценности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъедать",
                                "target_lang_sense_clarification": "переносное значение, о чувствах или обществе"
                            },
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "доверие или авторитет"
                            },
                            {
                                "target_lang_word": "разрушать",
                                "target_lang_sense_clarification": "постепенно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64da6667-98c0-37ed-bcc0-453bc92e2949",
                    "sense_definition": "To undergo the process of being eaten away or becoming rusty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain types of steel will <w>corrode</w> much faster when exposed to humid air.",
                            "target_lang_translations": {
                                "ru": "Определенные виды стали будут <w>корродировать</w> гораздо быстрее при воздействии влажного воздуха."
                            }
                        },
                        {
                            "text": "The old iron railings have started to <w>corrode</w> due to the constant rain.",
                            "target_lang_translations": {
                                "ru": "Старые железные перила начали <w>ржаветь</w> из-за постоянных дождей."
                            }
                        }
                    ],
                    "synonyms": [
                        "rust"
                    ],
                    "common_phrases": [
                        "tend to corrode",
                        "start to corrode"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергаться процессу разрушения или покрываться ржавчиной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корродировать",
                                "target_lang_sense_clarification": "о процессе металла"
                            },
                            {
                                "target_lang_word": "ржаветь",
                                "target_lang_sense_clarification": "окисляться"
                            },
                            {
                                "target_lang_word": "окисляться",
                                "target_lang_sense_clarification": "химический процесс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
