                "senses": [
                    {
                        "sense_id": "66879b94-68ff-336a-ba12-ae4abd4bf32f",
                        "entry_id": "3a3b67d5-0d0f-343a-9c37-86f00fcfa8af",
                        "glosses": [
                            "Anzeichen für Nachwirkungen/Langzeitfolgen von Covid-19; Weiterbestehen von Krankheitssymptomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c19736-2e41-419f-83e0-77d63f71a9d3",
                                "sense_id": "66879b94-68ff-336a-ba12-ae4abd4bf32f",
                                "text": "„Das Risiko, ein Long-COVID-Symptom zu entwickeln, ist nach COVID-19-Infektion damit um 16,6% höher als nach einer Infektion mit Influenza.“"
                            },
                            {
                                "example_id": "f49a1ac5-7eee-4505-89be-3f5c23dc19c3",
                                "sense_id": "66879b94-68ff-336a-ba12-ae4abd4bf32f",
                                "text": "„Mehr als die Hälfte der COVID-Patienten weltweit leidet postakut an mindestens einem Long-COVID-Symptom.“"
                            },
                            {
                                "example_id": "26c4431a-8231-419c-a7b6-83de685a4147",
                                "sense_id": "66879b94-68ff-336a-ba12-ae4abd4bf32f",
                                "text": "„In einer am 15. Juli 2021 veröffentlichten Studie wurden 3.762 Patienten aus 56 Ländern zu möglichen Long-COVID-Symptomen befragt.“"
                            },
                            {
                                "example_id": "a33e38c0-121e-4d42-b06f-b1561a91578b",
                                "sense_id": "66879b94-68ff-336a-ba12-ae4abd4bf32f",
                                "text": "„Danach wiesen 12,9 Prozent der unter 11-Jährigen und etwa 15 Prozent der 12- bis 16-Jährigen fünf Wochen nach einer bestätigten COVID-19-Infektion mindestens ein Long-COVID-Symptom auf […].“"
                            },
                            {
                                "example_id": "b41d5c82-7853-48ee-8a2c-c713be4a4d2c",
                                "sense_id": "66879b94-68ff-336a-ba12-ae4abd4bf32f",
                                "text": "„Wenn ein Linienflug aufgrund von starken Long-COVID-Symptomen nicht empfehlenswert ist, stellt ein Flug mittels Ambulanzflugzeug eine gute Alternative dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
