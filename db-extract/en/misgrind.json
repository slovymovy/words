                "senses": [
                    {
                        "sense_id": "14876f40-86d1-3498-88e2-69c8fe0fd51d",
                        "entry_id": "f7166078-78a4-3e88-8942-b8873a0a99bc",
                        "glosses": [
                            "To grind improperly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3005182-db6f-4c83-93a0-11caad57418e",
                                "sense_id": "14876f40-86d1-3498-88e2-69c8fe0fd51d",
                                "text": "In many shops, a floor grinder is provided so that the men are perfectly free to misgrind their tools."
                            },
                            {
                                "example_id": "fd0a441b-3a71-49b5-889e-f62c4ab8accd",
                                "sense_id": "14876f40-86d1-3498-88e2-69c8fe0fd51d",
                                "text": "Overheating of the enamel slip during grinding, or misgrinding from other causes, brings out difficulties with respect to set of the enamel, dipping, draining, and spraying, as well as surface texture."
                            },
                            {
                                "example_id": "9ab1a38a-6054-4406-bbd4-301e119c629a",
                                "sense_id": "14876f40-86d1-3498-88e2-69c8fe0fd51d",
                                "text": "As a saw doctor, I have spent many frustrating hours trying to level saws that were misground (thick and thin spots) ."
                            },
                            {
                                "example_id": "c3355b2c-883c-4ae1-8df5-37ad83fc874d",
                                "sense_id": "14876f40-86d1-3498-88e2-69c8fe0fd51d",
                                "text": "Suddenly, we hear the rasping sound of a lens being misground and a shot of the chart shows production declining once again."
                            }
                        ]
                    }
                ],
