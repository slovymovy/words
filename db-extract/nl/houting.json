                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                        "entry_id": "f9402386-26c4-35c2-980b-549fbb2e18b5",
                                        "glosses": [
                                            "To fish for whitefish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e850ce75-6a9c-401b-983e-ab844f0335ad",
                                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                                "text": "“Perhaps he went whitefishing after he had his supper.”"
                                            },
                                            {
                                                "example_id": "1c3db0a7-d188-44af-b936-36aae1aee55f",
                                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                                "text": "“Bill” is said to have whitefished on the lake since Paul Bunyan and his big blue ox first plowed it out."
                                            },
                                            {
                                                "example_id": "bb1dd93a-c60b-4c18-9a48-4e4dd47040b2",
                                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                                "text": "Beth and I whitefished in the broken ice along the banks of the Clark, a fire of driftwood roaring in the wind with the coffeepot set among the coals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37e52ef4-cdaf-4820-9202-4ae0a9f35c0f",
                        "source_entry_id": "e8cf0b8d-d872-3178-b104-67176c68ef43",
                        "source_sense_id": "d905ebe5-6bb3-368b-aa0c-91e53fed57f4",
                        "source_sense_description": "q. bepaald soort zoutwatervis, Coregonus oxyrinchus",
                        "target_lang_word": "outil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bae5541b-c988-3cc4-b171-4a5cef119e4d",
                                        "entry_id": "6c22269d-a233-3fd5-88a4-9b9d943b64de",
                                        "glosses": [
                                            "Instrument dont les artisans, les jardiniers, etc., se servent pour leur travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c81c41-b7e8-49c9-acd7-78e9ad0299e5",
                                                "sense_id": "bae5541b-c988-3cc4-b171-4a5cef119e4d",
                                                "text": "L'un d'eux, le plus petit, tira de sa poche un outil qui pouvait bien être un ciseau à froid et se mit avec ardeur à desceller la plaque en pratiquant des pesées de place en place."
                                            },
                                            {
                                                "example_id": "c2b4fbb1-92c2-4d48-a359-34f0116cc9c7",
                                                "sense_id": "bae5541b-c988-3cc4-b171-4a5cef119e4d",
                                                "text": "[…] ; jadis, on croyait que la férule était l’outil le plus nécessaire pour le maître d'école ; aujourd'hui, les peines corporelles ont disparu de notre enseignement public."
                                            },
                                            {
                                                "example_id": "de55a2a8-8469-45c1-b1e8-c33473d55dd9",
                                                "sense_id": "bae5541b-c988-3cc4-b171-4a5cef119e4d",
                                                "text": "Il faut se méfier des gens qui vendent des outils mais qui ne s’en servent jamais."
                                            },
                                            {
                                                "example_id": "989226d9-8ea6-4124-8716-89f9a675381e",
                                                "sense_id": "bae5541b-c988-3cc4-b171-4a5cef119e4d",
                                                "text": "Alors, c'était du neuf, à part un lot d’outils de jardin et quelques meubles en plastique que j'avais récupérés dans une vente de garage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641b1fc1-addb-3b7e-b64d-895edc1b812c",
                                        "entry_id": "6c22269d-a233-3fd5-88a4-9b9d943b64de",
                                        "glosses": [
                                            "Instrument pour réaliser une action."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b82dfd-e611-4ac4-9282-3c6d6d1899e2",
                                                "sense_id": "641b1fc1-addb-3b7e-b64d-895edc1b812c",
                                                "text": "Technique intéressante par son coût réduit tout en permettant de construire des forteresses solides, la motte castrale va devenir l’outil privilégié de la mise en place de la société médiévale."
                                            },
                                            {
                                                "example_id": "395d71c8-90f5-49a9-8534-a5fcd6419885",
                                                "sense_id": "641b1fc1-addb-3b7e-b64d-895edc1b812c",
                                                "text": "Ainsi, ces outils numériques, qui peuvent nous aider à produire plus, peuvent aussi nous entraîner, si on les considère comme des partenaires cognitifs, à moins comprendre et moins pouvoir expliquer ce que l'on fait, à commettre des erreurs, à ne pas nous rendre compte que notre espace de recherche s'est réduit et appauvri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2936f7d-746d-3f8c-95ef-1fea30bf8902",
                                        "entry_id": "6c22269d-a233-3fd5-88a4-9b9d943b64de",
                                        "glosses": [
                                            "Synonyme de corégone oxyrhynque (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ec98cab-6dfb-3029-b555-88d5890edbb8",
                                        "entry_id": "6c22269d-a233-3fd5-88a4-9b9d943b64de",
                                        "glosses": [
                                            "Personne maladroite."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27569bba-0556-4848-8a73-7786628b86e8",
                                                "sense_id": "5ec98cab-6dfb-3029-b555-88d5890edbb8",
                                                "text": "Va donc, eh! outil!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f1f31f1-8eba-46e0-a723-a15f4177bb09",
                        "source_entry_id": "e8cf0b8d-d872-3178-b104-67176c68ef43",
                        "source_sense_id": "d905ebe5-6bb3-368b-aa0c-91e53fed57f4",
                        "source_sense_description": "q. bepaald soort zoutwatervis, Coregonus oxyrinchus",
                        "target_lang_word": "corégone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corégone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a698990f-8f6d-34ac-8fc7-6a4289de798f",
                                        "entry_id": "8d31a594-e966-3c2e-9c58-91673b94b807",
                                        "glosses": [
                                            "Poisson d’eau douce lacustre de la famille des salmonidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf99836-61c8-4185-a6fb-21a88872b0f3",
                                                "sense_id": "a698990f-8f6d-34ac-8fc7-6a4289de798f",
                                                "text": "[…] ; des corégones rouges semblaient faucher les flots avec leur pectorale tranchante, et des sélènes argentées, dignes de leur nom, se levaient sur l’horizon des eaux comme autant de lunes aux reflets blanchâtres."
                                            },
                                            {
                                                "example_id": "23e28def-d4da-470b-a377-b7d7d5a914fb",
                                                "sense_id": "a698990f-8f6d-34ac-8fc7-6a4289de798f",
                                                "text": "Le Léman abritait jusque dans les années 1920 deux corégones, « la féra » et « la gravenche ». Bien que ce soit difficile à imaginer, ces poissons très prisés ont pourtant été exterminés par une surpêche systématique qui a duré plusieurs décennies. Des introductions massives d’alevins de palées provenant du lac de Neuchâtel ont permis de reconstituer une population importante de corégones dès les années 1940."
                                            },
                                            {
                                                "example_id": "5f6747b4-38b2-4df8-a9d0-ec8500461fcc",
                                                "sense_id": "a698990f-8f6d-34ac-8fc7-6a4289de798f",
                                                "text": "Dominic Papineau de Saint-Jérôme taquine toutes les espèces de poissons, dont le grand corégone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e910d7e7-a4ab-3775-9414-7c5501ccb730",
                                        "entry_id": "8d31a594-e966-3c2e-9c58-91673b94b807",
                                        "glosses": [
                                            "Poisson du genre Saurus ^([1])."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e257adf-8649-4eff-818d-171e52fdc0dd",
                                                "sense_id": "e910d7e7-a4ab-3775-9414-7c5501ccb730",
                                                "text": "Des corégones rouges semblaient faucher les flots avec leur pectorale tranchante, et des sélènes argentées, dignes de leur nom, se levaient sur l’horizon des eaux comme autant de lunes aux reflets blanchâtres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
