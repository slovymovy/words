    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f2bfcb6d-a3dc-3854-a17d-c4b591143005",
                    "sense_definition": "für alle Menschen, Fälle oder Orte gleichermaßen zutreffend und überall geltend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geltung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Menschenrechte sollten auf der ganzen Welt als <w>universell</w> gültig anerkannt werden."
                        },
                        {
                            "text": "Bestimmte Emotionen wie Freude und Trauer gelten als <w>universelle</w> Erfahrungen der Menschheit."
                        }
                    ],
                    "synonyms": [
                        "allgemeingültig"
                    ],
                    "antonyms": [
                        "lokal",
                        "punktuell"
                    ],
                    "common_phrases": [
                        "universell gültig",
                        "universelle Werte"
                    ]
                },
                {
                    "sense_id": "794ebd1e-103b-33ab-b317-e353d9a49f42",
                    "sense_definition": "für viele verschiedene Zwecke geeignet oder flexibel einsetzbar",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nutzung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dieses praktische Werkzeug ist <w>universell</w> einsetzbar und ersetzt mehrere andere Geräte im Haushalt."
                        },
                        {
                            "text": "Das neue Kabel besitzt einen <w>universellen</w> Stecker, der mit vielen verschiedenen Geräten kompatibel ist."
                        }
                    ],
                    "synonyms": [
                        "vielseitig"
                    ],
                    "antonyms": [
                        "begrenzt"
                    ],
                    "common_phrases": [
                        "universell einsetzbar",
                        "universell verwendbar"
                    ]
                },
                {
                    "sense_id": "5e8656fc-5ae7-308b-a55a-e5093779d3c1",
                    "sense_definition": "sehr viele Fachgebiete umfassend und durch eine weite geistige Bildung gekennzeichnet",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bildung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine <w>universelle</w> Bildung ermöglichte es ihm, mühelos über Kunst, Philosophie und Naturwissenschaften zu diskutieren."
                        },
                        {
                            "text": "Ein Wissenschaftler der Renaissance strebte oft nach einem möglichst <w>universellen</w> Wissen über die Welt."
                        }
                    ],
                    "synonyms": [
                        "umfassend"
                    ],
                    "antonyms": [
                        "lückenhaft",
                        "begrenzt"
                    ],
                    "common_phrases": [
                        "universelle Bildung",
                        "universelles Wissen"
                    ]
                }
            ]
        }
    ]
