{
    "word_family": [
        "brothy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "829ca01a-7323-3523-9f07-d385242c44be",
                    "sense_definition": "Water in which food such as meat or vegetables has been boiled.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef simmered the bones for hours to create a rich <w>broth</w>.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар часами варил кости на медленном огне, чтобы получить наваристый <w>бульон</w>."
                            }
                        },
                        {
                            "text": "Add a little salt to the vegetable <w>broth</w> to improve the flavor.",
                            "target_lang_translations": {
                                "ru": "Добавьте немного соли в овощной <w>бульон</w>, чтобы улучшить вкус."
                            }
                        }
                    ],
                    "synonyms": [
                        "stock",
                        "bouillon"
                    ],
                    "common_phrases": [
                        "clear broth",
                        "chicken broth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вода, в которой варилось мясо, овощи или другие продукты; основа для супов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бульон",
                                "target_lang_sense_clarification": "мясной, куриный или овощной отвар"
                            },
                            {
                                "target_lang_word": "отвар",
                                "target_lang_sense_clarification": "жидкость после варки овощей, грибов или трав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4228218-34eb-33a8-b86a-c241c2c95a66",
                    "sense_definition": "A soup made from broth and other ingredients like vegetables or meat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She served a hearty vegetable <w>broth</w> for lunch on a cold day.",
                            "target_lang_translations": {
                                "ru": "В холодный день она подала на обед сытную овощную <w>похлёбку</w>."
                            }
                        },
                        {
                            "text": "The traditional <w>broth</w> was filled with fresh herbs and diced chicken.",
                            "target_lang_translations": {
                                "ru": "В традиционный <w>суп</w> добавили свежую зелень и нарезанную кубиками курицу."
                            }
                        }
                    ],
                    "synonyms": [
                        "soup"
                    ],
                    "common_phrases": [
                        "hot broth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суп или жидкое блюдо, приготовленное на основе бульона с добавлением овощей или мяса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суп",
                                "target_lang_sense_clarification": "жидкое первое блюдо"
                            },
                            {
                                "target_lang_word": "похлёбка",
                                "target_lang_sense_clarification": "лёгкий или густой суп на отваре"
                            },
                            {
                                "target_lang_word": "бульон",
                                "target_lang_sense_clarification": "жидкое первое блюдо с заправкой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}