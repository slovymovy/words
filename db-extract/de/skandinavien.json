                "senses": [
                    {
                        "sense_id": "25aefd18-4125-3f13-bb16-21188fe4aa1c",
                        "entry_id": "26eb8347-ec7b-3e9b-bd1f-4585abf1d781",
                        "glosses": [
                            "Länder im Norden Europas; die skandinavischen Staaten Norwegen und Schweden; mit Dänemark mit Finnland, Island und den Färöern"
                        ],
                        "tags": [
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "bad190b7-7f7f-43f5-8dca-390dd9025c02",
                                "sense_id": "25aefd18-4125-3f13-bb16-21188fe4aa1c",
                                "text": "Skandinavien ist insgesamt sehr dünn besiedelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c973ec98-e82a-3b29-914c-7e4fbe605085",
                        "entry_id": "26eb8347-ec7b-3e9b-bd1f-4585abf1d781",
                        "glosses": [
                            "Gebiet im Norden Europas; die skandinavische Halbinsel mit Norwegen und Schweden, mit Dänemark ohne Grönland und Färöer und mit dem Nordwesten Finnlands"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "58317417-b565-49a5-b849-ec4cceaa6ea2",
                                "sense_id": "c973ec98-e82a-3b29-914c-7e4fbe605085",
                                "text": "„Im 7. Jahrtausend dürfte auch Skandinavien eisfrei gewesen sein. In dieser Zeit folgte auf das Yoldia-Meer, das über Mittelschweden eine Verbindung zur Nordsee hatte, der sogenannte Ancylus-See.“"
                            },
                            {
                                "example_id": "289cbc90-d6aa-4ff6-85d0-12be81ff61a1",
                                "sense_id": "c973ec98-e82a-3b29-914c-7e4fbe605085",
                                "text": "„Gleichzeitig könnte der Vulkanausbruch auch das Ende der Trichterbecherkultur in Skandinavien eingeläutet haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
