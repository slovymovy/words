                "senses": [
                    {
                        "sense_id": "ce9dead8-371e-33f0-8644-6691edb7ecb6",
                        "entry_id": "390caed0-ce3e-3f85-a2a8-d8950bef9d97",
                        "glosses": [
                            "driehoekig gebied onderaan de buik van een vrouw begroeit met haar dat bovenop het schaambeen gelegen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7da92c9e-496f-4e9a-823d-a82a5fea1956",
                                "sense_id": "ce9dead8-371e-33f0-8644-6691edb7ecb6",
                                "text": "Te zien zijn onder andere een venusheuvel als magnetisch veld, vrouwen die hun vagina spreiden, erecties, dames en heren die zich enthousiast overgeven aan de radslag en een donkere jongeman die zijn achterste in de aanbieding doet."
                            },
                            {
                                "example_id": "9c6cdec9-77f2-400a-821a-04c2ef4836d3",
                                "sense_id": "ce9dead8-371e-33f0-8644-6691edb7ecb6",
                                "text": "Pas in de jaren zestig van de vorige eeuw werd schaamhaarverwijdering steeds gebruikelijker. Althans... het verwijderen van het haar dat uit het bikinibroekje piepte. Want nog geen tien procent van de bevolking haalde het haar volledig weg, zo blijkt uit een onderzoek dat in die tijd is gehouden. Een ‘getrimd’ pruikje was destijds nog het meest populair. Hoewel veel feministen juist de voorkeur hadden voor welig tierend haar op de venusheuvel!"
                            }
                        ]
                    }
