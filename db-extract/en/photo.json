                "senses": [
                    {
                        "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                        "entry_id": "1b7d0747-72d5-346c-9822-74e57bbf82c6",
                        "glosses": [
                            "To take a photograph of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "532ea76e-73b7-47a0-8493-e9480a99229d",
                                "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                                "text": "[1956] 1992 ed., The Complete Lyrics of Cole Porter http://print.google.com/print?hl=en&id=5kjheskJwVAC&pg=PA465&lpg=PA465&sig=_CY8N5ZLStxnOIlf_CNHhhBEPjA\nWhat fun to be photoed together, / What luck for a break so opportune. / Oh, what a lark / To be posed in the park / Underneath the adolescent crescent of the moon."
                            },
                            {
                                "example_id": "060b2a32-37cc-4602-895f-df34fbdded63",
                                "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                                "text": "1998, Hans Schmidt, Maverick Marine http://print.google.com/print?hl=en&id=vQ7DKhq0ZckC&pg=PA192&lpg=PA192&sig=hrMAoHDI9vAnq4RQwgFro_Lp24M\nHe even had himself photoed helping to hold one of the fire-hose."
                            },
                            {
                                "example_id": "77a176b5-f098-4f17-9aa3-2f8681ae0adf",
                                "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                                "text": "Always photoing exits. What are all these ways out but rehearsals for his own?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f3dd1af-80ad-47ed-a956-374f4f3745e3",
                        "source_entry_id": "1b7d0747-72d5-346c-9822-74e57bbf82c6",
                        "source_sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                        "source_sense_description": "to take a photograph",
                        "target_lang_word": "fotograferen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fotograferen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f94bc8d-8ec8-3e55-af87-c74cc181bc81",
                                        "entry_id": "b4c82e36-975a-34e6-8aa4-575e53a44d3c",
                                        "glosses": [
                                            "een afbeelding maken door de projectie van beeld op een lichtgevoelige laag"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5dde580-9b88-4a05-b2d0-19dd43b263ea",
                                                "sense_id": "8f94bc8d-8ec8-3e55-af87-c74cc181bc81",
                                                "text": "Je bent vergeten die mooie dieren te fotograferen!"
                                            },
                                            {
                                                "example_id": "4503de8e-5cdd-4655-a69b-c507726c56e8",
                                                "sense_id": "8f94bc8d-8ec8-3e55-af87-c74cc181bc81",
                                                "text": "Ik ben Krijn van Noordwijk zeer erkentelijk voor het fotograferen van mijn portret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb2816bd-d81b-4edf-96c5-b67deca93c7e",
                        "source_entry_id": "1b7d0747-72d5-346c-9822-74e57bbf82c6",
                        "source_sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                        "source_sense_description": "to take a photograph",
                        "target_lang_word": "photographier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photographier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d81834e-535d-30e6-aa50-c706e2e7510f",
                                        "entry_id": "f60f16b5-cd73-3380-863a-7f6a97abb45a",
                                        "glosses": [
                                            "Obtenir une image par les procédés de la photographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12988e5-b438-4dbd-9f09-f4068ea99019",
                                                "sense_id": "1d81834e-535d-30e6-aa50-c706e2e7510f",
                                                "text": "Dans un livre récent, M. Maxime Du Camp raconte qu'il photographiait, en Égypte, au cours d'un voyage entrepris en compagnie de G. Flaubert, en 1849.\nC'était peu après l'invention de la photographie."
                                            },
                                            {
                                                "example_id": "ee27ef3a-e237-44a8-b40a-d8778039ae1a",
                                                "sense_id": "1d81834e-535d-30e6-aa50-c706e2e7510f",
                                                "text": "Je me ferai faire un costume breton... celui des femmes de Pont-Labbé... c'est le plus joli... et nous nous ferons photographier tous les deux, la main dans la main, au pied de cet énorme dolmen que vous nous avez montré de loin."
                                            },
                                            {
                                                "example_id": "17e9eed5-e654-4ae2-9f81-eb0944ecde36",
                                                "sense_id": "1d81834e-535d-30e6-aa50-c706e2e7510f",
                                                "text": "Aussi n’aimaient-ils pas à ce que les rarissimes piroguiers de passage photographiassent leur antiques et vénérables maisons croulantes."
                                            },
                                            {
                                                "example_id": "024bb54b-420e-4fc9-8713-996726198931",
                                                "sense_id": "1d81834e-535d-30e6-aa50-c706e2e7510f",
                                                "text": "Ils photographièrent le nouvel État albanais à peine formé, qui se muait tour à tour en république, en royaume et parfois en chaos; ils photographièrent des milliers de montagnards, les dames et demoiselles de la société, les malades dans les couloirs des hopitaux, des propriétaires, des fabriques […]."
                                            },
                                            {
                                                "example_id": "36813c4b-122a-438d-92f9-9c9fb844a5cc",
                                                "sense_id": "1d81834e-535d-30e6-aa50-c706e2e7510f",
                                                "text": "Elle refusait que je la photographiasse, m'expliquant que je ne lui avais pas donné suffisamment d'argent. Alors que moi avec le cliché que je pourrais prendre d'elle, je pouvais gagner plein d'argent là-bas en France sur son dos."
                                            },
                                            {
                                                "example_id": "078e1532-5847-4dd1-913e-8e1ced4d0aca",
                                                "sense_id": "1d81834e-535d-30e6-aa50-c706e2e7510f",
                                                "text": "— Avec une dextérité toute professionnelle, Kuch dirigea vers un angle de la pièce un jet de lumière électrique et un appareil instantané sur la plaque duquel se photographièrent deux têtes ahuries de coupables réveillés en sursaut. Le cliché obtenu, l’artiste habile fit place à l’époux irrité et Kuch de tomber à bras raccourci sur le séducteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b8cd91c-69db-3cbd-b1cd-9de1d3760e5c",
                                        "entry_id": "f60f16b5-cd73-3380-863a-7f6a97abb45a",
                                        "glosses": [
                                            "Graver dans sa mémoire une vision rapide ou furtive."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11109a76-8357-4cf6-ad6f-6166f4c1d9d3",
                                                "sense_id": "2b8cd91c-69db-3cbd-b1cd-9de1d3760e5c",
                                                "text": "Il avait déjà pu saisir ce regard profond et si vert dans la forêt de Chantilly. Il l’avait photographié et il le conservait à jamais gravé dans sa mémoire."
                                            },
                                            {
                                                "example_id": "7727884d-29cc-4085-aa4f-2b24bac92871",
                                                "sense_id": "2b8cd91c-69db-3cbd-b1cd-9de1d3760e5c",
                                                "text": "Il […] jette un nouveau coup d'œil par-dessus son épaule : personne. Il fait carrément demi-tour, scrute la cohue moutonnière, ne voit rien qui confirme son affreuse vision. Il manque de se pincer, et pourtant il est sûr de bien avoir « photographié » ces deux types."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
