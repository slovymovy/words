                                                "example_id": "fceab19e-751b-41b1-9bd7-ff7a0107f703",
                                                "sense_id": "0acf5b4c-640c-3198-9aba-9511d95ad1ea",
                                                "text": "They put off paedophiles by spraying the child with eight litres of pressurized sewerage."
                                            },
                                            {
                                                "example_id": "a93dbd19-4447-4788-a33b-2b618b964394",
                                                "sense_id": "0acf5b4c-640c-3198-9aba-9511d95ad1ea",
                                                "text": "About 3.6 billion tonnes of untreated sewerage flows daily into the Yamuna, which supplies over 60 percent of Delhi's water."
