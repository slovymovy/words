                {
                    "sense_id": "7816eab3-dc0f-3892-8cd7-05d0187eca47",
                    "sense_definition": "Déterminer avec plus de netteté ou d'exactitude en apportant des détails.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clarifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous <w>préciser</w> votre pensée afin que tout le monde comprenne bien l'enjeu ?"
                        },
                        {
                            "text": "Le contrat doit <w>préciser</w> la date exacte de la livraison des marchandises."
                        }
                    ],
                    "synonyms": [
                        "spécifier",
                        "clarifier",
                        "expliciter",
                        "définir",
                        "déterminer"
                    ],
                    "common_phrases": [
