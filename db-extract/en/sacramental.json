            },
            {
                "entry_id": "48eec65c-0125-3a96-97bc-ae9905452b46",
                "word": "sacramental",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3a989128-313d-424c-b12b-52b6fcfb72d7",
                        "entry_id": "48eec65c-0125-3a96-97bc-ae9905452b46",
                        "tags": [
                            "plural"
                        ],
                        "form": "sacramentals"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                        "entry_id": "48eec65c-0125-3a96-97bc-ae9905452b46",
                        "glosses": [
                            "An object (such as holy water or a crucifix) or an action (such as making the sign of the cross) which is regarded as encouraging devotion and thus spiritually aiding the person who uses it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "898adedb-8164-4178-99f5-dc15e211e035",
                                "sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                                "text": "But under the twofold pressure of solafideism’s rejection of \"good works\" for the sake of merit and sola scriptura’s denial of anything not explicitly mentioned in the Bible, sacramentals such as images, relics, blessings, and pilgrimages became the objects of the dissenters' most bitter condemnation and scorn."
                            },
                            {
                                "example_id": "c3183a75-bfd9-46d1-86fe-3689e92dc3ef",
                                "sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                                "text": "The Sacramentals.\nBesides the holy sacraments there are things which the Church blesses in order that by the pious use of them the Christian may obtain from God temporal benefits and spiritual health. Now as these things bear a certain resemblance to the sacraments, they are called sacramentals."
                            },
                            {
                                "example_id": "8217fab4-9ce2-4d78-b317-074ab5f0ccb7",
                                "sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                                "text": "The activities in this strategy immerse the young people in the many sacramentals that are part of the daily, weekly, and seasonal Catholic individual and communal religious expressions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3749965-8b23-4b08-96ec-30efef040f6f",
                        "source_entry_id": "48eec65c-0125-3a96-97bc-ae9905452b46",
                        "source_sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                        "source_sense_description": "an object or action which spiritually aids its faithful users",
                        "target_lang_word": "sacramental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacramental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7258ca4d-5c37-3b2f-91df-fb369d6d48a9",
                                        "entry_id": "feed9f66-6edf-3e0b-9403-ea6dac1f8cef",
                                        "glosses": [
                                            "Un des signes sensibles et sacrés institués par l’Église, qui ont une certaine analogie avec les sacrements et qui sont destinés à produire certains effets spirituels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ae427d-a1e2-41bb-9d7f-c9c35cca411a",
                                                "sense_id": "7258ca4d-5c37-3b2f-91df-fb369d6d48a9",
                                                "text": "Il est utile (mais pas forcément nécessaire) d'avoir également quelques sacramentaux à disposition : eau et sel exorcisés, ou huile bénite pour des onctions."
                                            },
                                            {
                                                "example_id": "019879b5-50db-4df4-913f-db868eb75f8e",
                                                "sense_id": "7258ca4d-5c37-3b2f-91df-fb369d6d48a9",
                                                "text": "Cela ressort de la définition du sacramental donnée par le concile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacramental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80553fd7-7762-3b6d-961c-f1db9f2e1e7a",
                                        "entry_id": "004474ed-8c5a-3eb8-8bc6-13b12f3d93c5",
                                        "glosses": [
                                            "Variante de sacramentel."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc7c9ac2-9730-40a1-8d1e-01d03e602667",
                                                "sense_id": "80553fd7-7762-3b6d-961c-f1db9f2e1e7a",
                                                "text": "[À Londres, aux Communes], le président et les secrétaires seuls portaient la robe de soie et la perruque sacramentale de laine grise à deux ou trois boudins."
                                            },
                                            {
                                                "example_id": "c0a14992-625c-45ae-ba43-079794e593ce",
                                                "sense_id": "80553fd7-7762-3b6d-961c-f1db9f2e1e7a",
                                                "text": "Celui-ci, apoplectique, bredouillant des borborygmes, réussit enfin à retrouver son souffle pour dire à mon témoin le sacramental : « Veuillez reprendre votre place », parmi les rires même pas étouffés de l’assistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45a548c4-0b24-4f99-94a6-a08bea0a7860",
                        "source_entry_id": "48eec65c-0125-3a96-97bc-ae9905452b46",
                        "source_sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                        "source_sense_description": "an object or action which spiritually aids its faithful users",
                        "target_lang_word": "Sakramentale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sakramentale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cacb1c2-0ea7-394b-a5a7-441210b0cd9d",
                                        "entry_id": "b8480440-2387-3543-9409-5c449b666941",
                                        "glosses": [
                                            "Zeichenhandlungen mit geistlicher Wirkung durch die Fürbitte von Gläubigen"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed5abb6-c11f-4a15-9991-8e0ef332c215",
                                                "sense_id": "5cacb1c2-0ea7-394b-a5a7-441210b0cd9d",
                                                "text": "„Die Theologie der Predigt ist fast so etwas wie ein Sakramentale.“"
                                            },
                                            {
                                                "example_id": "783c047b-2c49-4bb1-87e5-854d1891da7f",
                                                "sense_id": "5cacb1c2-0ea7-394b-a5a7-441210b0cd9d",
                                                "text": "„Das Benediktionale legt fest, ob ein Sakramentale nur von Geistlichen bzw. Klerikern eines bestimmten Weihegrades (Bischof, Priester, Diakon) oder auch von Laien gespendet werden darf.“"
                                            },
                                            {
                                                "example_id": "330d70dd-9291-4ed7-861c-1820d5d87746",
                                                "sense_id": "5cacb1c2-0ea7-394b-a5a7-441210b0cd9d",
                                                "text": "Der Gebrauch von Sakramentalien „ist heilsam, empfohlen, aber nicht geboten und ist von jedem Aberglauben freizuhalten.“"
                                            },
                                            {
                                                "example_id": "967a5fd6-8741-45a3-b7c4-c9c6c6a04051",
                                                "sense_id": "5cacb1c2-0ea7-394b-a5a7-441210b0cd9d",
                                                "text": "„Der Protestantismus kennt zwar heilige Bräuche, aber keine Sakramentalien im eigentlichen Sinn.“"
                                            },
                                            {
                                                "example_id": "89660c49-1594-4907-9356-81c9f6e7583f",
                                                "sense_id": "5cacb1c2-0ea7-394b-a5a7-441210b0cd9d",
                                                "text": "„S[kapulier] heißt in der katholischen Kirche auch ein Sakramentale (s. Sakramentalien), das aus zwei mit dem Bilde Mariens oder der Leidenswerkzeuge Christi versehenen Tuchflecken besteht und an zwei Bändchen unter den Kleidern auf Brust und Rücken getragen wird. Die Inhaber solcher Skapuliere gehören einer Skapulierbruderschaft (s. Bruderschaften, religiöse) an, deren vorzüglichste die »Unserer Lieben Frau vom Berge Karmel« (daher Karmelitenskapulier, eingeführt 1587) ist mit dem Skapulierfest am dritten Sonntag im Juli.“"
                                            },
                                            {
                                                "example_id": "f3790860-56f2-41cf-ac27-998361becee4",
                                                "sense_id": "5cacb1c2-0ea7-394b-a5a7-441210b0cd9d",
                                                "text": "„Die Jungfrauenweihe ist ein Sakramentale, also kein Sakrament wie die Bischofs- oder Priesterweihe.“"
                                            },
                                            {
                                                "example_id": "fa88acba-f6fc-49a6-8bc9-4c314bff3358",
                                                "sense_id": "5cacb1c2-0ea7-394b-a5a7-441210b0cd9d",
                                                "text": "„Auch das Begräbnis ist ein Sakramentale, denn es ist kein Sakrament.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
