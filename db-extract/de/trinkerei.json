                ],
                "senses": [
                    {
                        "sense_id": "e9e21963-f3df-3245-95dc-d0ba5293b23f",
                        "entry_id": "8ba90263-f432-3378-b125-9732c321cfe9",
                        "glosses": [
                            "anhaltendes Trinken von alkoholischen Getränken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "390a3895-d21a-4bb2-a3e1-22cdde26f4b2",
                                "sense_id": "e9e21963-f3df-3245-95dc-d0ba5293b23f",
                                "text": "„1933 setzt der Senat fünfzehn Jahren heimlicher Trinkerei ein Ende und legalisiert den Alkoholkonsum wieder.“"
                            },
                            {
                                "example_id": "63f005e9-1123-4109-9006-7c049475357f",
                                "sense_id": "e9e21963-f3df-3245-95dc-d0ba5293b23f",
                                "text": "„Aber die Trinkerei hatte auch ihr Gutes – man litt nie an Verstopfung.“"
                            },
                            {
                                "example_id": "05cd5c65-7093-4ca3-b554-c6a36ff5465f",
                                "sense_id": "e9e21963-f3df-3245-95dc-d0ba5293b23f",
                                "text": "„Die oft genügte, um ihren Mann daran zu erinnern, was in seinem Leben wirklich zählte, sodass er seine Trinkerei für eine Weile zügelte.“"
                            },
                            {
                                "example_id": "902a598b-f595-4ca0-a818-f2063101e171",
                                "sense_id": "e9e21963-f3df-3245-95dc-d0ba5293b23f",
                                "text": "„Als wir im Dunkeln von Philadelphia nach Wilmington fuhren und die Trinkerei angefangen hatte, wurde der Chauffeur unruhig, weil der Motor sich aufheizte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
