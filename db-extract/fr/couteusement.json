                                        "glosses": [
                                            "Of high cost; expensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab1dddc-2dbe-4cf3-8d53-1037dad6a995",
                                                "sense_id": "3be9a0be-94be-389a-8493-dd6664c775dd",
                                                "text": "a costly activity"
                                            },
                                            {
                                                "example_id": "e10df104-1cbe-4820-9e1f-b5f9718d95d0",
                                                "sense_id": "3be9a0be-94be-389a-8493-dd6664c775dd",
                                                "text": "a costly error"
                                            },
                                            {
                                                "example_id": "cde1a990-73d3-49fa-bfef-a4ccf02c8ca6",
                                                "sense_id": "3be9a0be-94be-389a-8493-dd6664c775dd",
                                                "text": "In the early days troubles were experienced with oscillation from the rod drive and with the transformers, but were overcome later, and these machines performed useful service until superseded by more modern locomotives less costly in maintenance."
                                            },
                                            {
                                                "example_id": "6f1f6bc5-80dd-426a-aded-5fb9d91f71e0",
                                                "sense_id": "3be9a0be-94be-389a-8493-dd6664c775dd",
                                                "text": "Individual mistakes proved costly for Wigan who, particularly after the half-time introduction of Hugo Rodallega, dominated for long periods."
                                            },
                                            {
                                                "example_id": "9645c04c-a7a1-40b9-acb3-7fb2943ff373",
                                                "sense_id": "3be9a0be-94be-389a-8493-dd6664c775dd",
                                                "text": "Since sexual relationships are more costly for female primates – they bear the kids – females are the choosier sex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3315ced6-6c30-4fa2-9fe9-4311f830fd56",
