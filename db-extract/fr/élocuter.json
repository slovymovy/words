                "senses": [
                    {
                        "sense_id": "7eea8512-20e8-3645-94da-2eee746d577d",
                        "entry_id": "da0cd234-9579-3221-b7be-6a80e59119f2",
                        "glosses": [
                            "Dire, exprimer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ad625cf5-a352-48e3-ba00-d233260aab80",
                                "sense_id": "7eea8512-20e8-3645-94da-2eee746d577d",
                                "text": "Avoir déjà tweeté n'empêche pas d'avoir beaucoup de peine à élocuter sa commande de café en gare"
                            },
                            {
                                "example_id": "628bfa66-c3fd-4984-8dd8-82ccd522a344",
                                "sense_id": "7eea8512-20e8-3645-94da-2eee746d577d",
                                "text": "Je viens de te voir élocuter dans le micro sur le petit écran où tu racontais modestement ton exploit avec toute la componction qui te caractérise."
                            },
                            {
                                "example_id": "cbe4b082-1310-4e75-a9e5-e5a749cfcd3b",
                                "sense_id": "7eea8512-20e8-3645-94da-2eee746d577d",
                                "text": "Oui, c'est ça, c'était pour corriger ses défauts de prononciation mais en même temps c'est pour apprendre à élocuter comme il faut."
                            },
                            {
                                "example_id": "e96b17a6-8d4b-4d8a-87f3-732add4a631e",
                                "sense_id": "7eea8512-20e8-3645-94da-2eee746d577d",
                                "text": "Je ne peux m'empêcher de les déclamer, élocuter, manduquer, décortiquer. sur le rythme rap/clap/map/slam. à coups d'égosillage."
                            }
                        ]
                    }
