                "senses": [
                    {
                        "sense_id": "12d1eb0f-b4e6-3641-ad56-81358928d47a",
                        "entry_id": "9c9150fd-5bc9-3ac8-ba92-f669de4a44bc",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e16d0c62-519c-42be-9147-f42d621f1077",
                                "sense_id": "12d1eb0f-b4e6-3641-ad56-81358928d47a",
                                "text": "Frau Buckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "50e6eb47-0b0f-447d-b21f-840f8138a496",
                                "sense_id": "12d1eb0f-b4e6-3641-ad56-81358928d47a",
                                "text": "Herr Buckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9380f556-a4c1-4b40-8146-4bc4627115bd",
                                "sense_id": "12d1eb0f-b4e6-3641-ad56-81358928d47a",
                                "text": "Die Buckles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "675eefbc-0891-47e9-b863-8a4cddefd904",
                                "sense_id": "12d1eb0f-b4e6-3641-ad56-81358928d47a",
                                "text": "Der Buckle trägt nie die Schals, die die Buckle ihm strickt."
                            },
                            {
                                "example_id": "2ca6fedb-12d6-447a-8ca6-b3c12eedbd75",
                                "sense_id": "12d1eb0f-b4e6-3641-ad56-81358928d47a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buckle kommt, geht der Herr Buckle.“"
                            },
                            {
                                "example_id": "6d2b76d4-5611-4699-a039-3e2e93fecb07",
                                "sense_id": "12d1eb0f-b4e6-3641-ad56-81358928d47a",
                                "text": "Buckle kommt und geht."
                            },
                            {
                                "example_id": "48909c5b-ffb0-4a65-83ec-2d2ab97de4e7",
                                "sense_id": "12d1eb0f-b4e6-3641-ad56-81358928d47a",
                                "text": "Buckles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
