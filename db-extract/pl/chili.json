                    {
                        "translation_id": "f2b64a70-5b52-4b3a-ba51-a1259f161e36",
                        "source_entry_id": "937494bf-725d-3814-a595-bf67d4665105",
                        "source_sense_id": "8a8f2cf6-7ee5-3f3d-97ca-07a93dbaf5ed",
                        "target_lang_word": "chili",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chili",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e66c0323-71b9-3b19-9b2f-368f6e2c1b35",
                                        "entry_id": "512da182-d863-30ac-a378-eedd4a061b6d",
                                        "glosses": [
                                            "The pungent, spicy fresh or dried fruit of any of several cultivated varieties of capsicum peppers, used in cooking."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e461e0-cf29-46ea-948a-9dc1bd71a436",
                                                "sense_id": "e66c0323-71b9-3b19-9b2f-368f6e2c1b35",
                                                "text": "Capsicum—the dried ripe fruit of Capsicum fastigiatum—is also known as Chilly pepper, Chillies, Guinea, or pod pepper, and is chiefly brought from Zanzibar. The several varieties differ in shape and size, are of a red colour, and filled with numerous red-brown, pungent seeds."
                                            },
                                            {
                                                "example_id": "12a9ae88-5dfc-4568-bef7-1847085c1c69",
                                                "sense_id": "e66c0323-71b9-3b19-9b2f-368f6e2c1b35",
                                                "text": "Kama Indian Bistro, […] Everything is made from scratch, including the spice blends and sauces; the ingredients are quality; and the heat is no-holds-barred. Planks of crispy, \"chilly\" potatoes and elegant, delicately flavored shrimp Sunnaina in white-wine garlic-tomato concassé are hits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e5931b-bc57-3273-bd44-bc6cdbed6db3",
                                        "entry_id": "512da182-d863-30ac-a378-eedd4a061b6d",
                                        "glosses": [
                                            "Powdered chili pepper, used as a spice or flavouring in cooking."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6515a29-8841-3ec9-ae4e-3139334e3619",
                                        "entry_id": "512da182-d863-30ac-a378-eedd4a061b6d",
                                        "glosses": [
                                            "A spicy stew of chicken or paneer, capsicum and onion, eaten as an appetizer."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
