{
    "word_family": [
        "powstanie",
        "powstaniec",
        "powstańczy",
        "powstać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f5fad01e-7a41-38a9-b8ed-e5556dcaa1a3",
                    "sense_definition": "Zaczynać istnieć, tworzyć się lub formować w jakimś procesie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowe osiedle mieszkaniowe <w>powstaje</w> na obrzeżach dużego miasta.",
                            "target_lang_translations": {
                                "ru": "Новый жилой комплекс <w>появляется</w> на окраине большого города.",
                                "en": "A new housing estate <w>is being built</w> on the outskirts of the big city."
                            }
                        },
                        {
                            "text": "W mojej głowie powoli <w>powstawał</w> szczegółowy plan działania.",
                            "target_lang_translations": {
                                "ru": "В моей голове медленно <w>формировался</w> подробный план действий.",
                                "en": "A detailed action plan <w>was</w> slowly <w>forming</w> in my head."
                            }
                        }
                    ],
                    "synonyms": [
                        "tworzyć się",
                        "formować się",
                        "pojawiać się",
                        "rodzić się"
                    ],
                    "common_phrases": [
                        "powstawać z niczego",
                        "powstawać w bólach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать существовать, образовываться или формироваться в каком-либо процессе.",
                        "en": "To begin to exist, be created, or take shape in a process."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возникать",
                                "target_lang_sense_clarification": "начинать существовать"
                            },
                            {
                                "target_lang_word": "появляться",
                                "target_lang_sense_clarification": "становиться видимым или известным"
                            },
                            {
                                "target_lang_word": "образовываться",
                                "target_lang_sense_clarification": "формироваться"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "to come into being or notice"
                            },
                            {
                                "target_lang_word": "develop",
                                "target_lang_sense_clarification": "to take form or shape gradually"
                            },
                            {
                                "target_lang_word": "be created",
                                "target_lang_sense_clarification": "to be built or formed"
                            },
                            {
                                "target_lang_word": "emerge",
                                "target_lang_sense_clarification": "to appear or come into existence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b160497c-2f5e-302b-a4f7-9752cd5ecf06",
                    "sense_definition": "Być skutkiem lub konsekwencją czegoś; brać z czegoś początek.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiele nieporozumień <w>powstaje</w> z braku szczerej rozmowy.",
                            "target_lang_translations": {
                                "ru": "Многие недоразумения <w>возникают</w> из-за отсутствия искреннего разговора.",
                                "en": "Many misunderstandings <w>arise</w> from a lack of honest conversation."
                            }
                        },
                        {
                            "text": "Konflikt <w>powstaje</w> zazwyczaj tam, gdzie są sprzeczne interesy.",
                            "target_lang_translations": {
                                "ru": "Конфликт <w>возникает</w> обычно там, где есть противоречивые интересы.",
                                "en": "Conflict usually <w>arises</w> where there are conflicting interests."
                            }
                        }
                    ],
                    "synonyms": [
                        "wynikać"
                    ],
                    "common_phrases": [
                        "problem powstaje",
                        "pytanie powstaje",
                        "błędy powstają"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть следствием чего-либо; брать начало от чего-либо.",
                        "en": "To be the result or consequence of something; to originate from."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возникать",
                                "target_lang_sense_clarification": "появляться как следствие"
                            },
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "брать начало"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "to originate or result from something"
                            },
                            {
                                "target_lang_word": "stem",
                                "target_lang_sense_clarification": "to originate from a cause"
                            },
                            {
                                "target_lang_word": "result",
                                "target_lang_sense_clarification": "to occur as a consequence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87fcd520-f459-3cbe-ac44-970a0d5ea2d0",
                    "sense_definition": "Sprzeciwiać się władzy, rozpoczynać walkę zbrojną w celu odzyskania wolności.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rebellion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W XIX wieku Polacy kilkakrotnie <w>powstawali</w> przeciwko zaborcom.",
                            "target_lang_translations": {
                                "ru": "В XIX веке поляки несколько раз <w>восставали</w> против захватчиков.",
                                "en": "In the 19th century, Poles <w>rose up</w> against the partitioners several times."
                            }
                        },
                        {
                            "text": "Historia uczy, że uciskane narody prędzej czy później <w>powstają</w> przeciwko tyranom.",
                            "target_lang_translations": {
                                "ru": "История учит, что угнетённые народы рано или поздно <w>восстают</w> против тиранов.",
                                "en": "History teaches us that oppressed nations, sooner or later, <w>rise up</w> against tyrants."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprzeciwiać się",
                        "buntować się"
                    ],
                    "common_phrases": [
                        "powstawać przeciwko okupantowi",
                        "naród powstaje",
                        "powstawać do walki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противиться власти, начинать вооруженную борьбу за свободу.",
                        "en": "To oppose authority, to take up arms in revolt to regain freedom."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восставать",
                                "target_lang_sense_clarification": "поднимать восстание"
                            },
                            {
                                "target_lang_word": "бунтовать",
                                "target_lang_sense_clarification": "выражать активную непокорность"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "rise up",
                                "target_lang_sense_clarification": "to rebel against oppression or authority"
                            },
                            {
                                "target_lang_word": "revolt",
                                "target_lang_sense_clarification": "to take part in a rebellion"
                            },
                            {
                                "target_lang_word": "uprise",
                                "target_lang_sense_clarification": "to take part in an uprising"
                            },
                            {
                                "target_lang_word": "rebel",
                                "target_lang_sense_clarification": "to resist authority actively"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9279264f-49f7-3059-bd6a-483a1e6f0b6b",
                    "sense_definition": "Podnosić się z pozycji siedzącej lub leżącej na stojącą.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy zgromadzeni <w>powstawali</w>, gdy sędzia wszedł na salę rozpraw.",
                            "target_lang_translations": {
                                "ru": "Все собравшиеся <w>вставали</w>, когда судья вошел в зал суда.",
                                "en": "Everyone present <w>stood up</w> as the judge entered the courtroom."
                            }
                        },
                        {
                            "text": "Ranny żołnierz z wielkim trudem <w>powstawał</w> z ziemi.",
                            "target_lang_translations": {
                                "ru": "Раненый солдат с большим трудом <w>поднимался</w> с земли.",
                                "en": "The wounded soldier <w>was rising</w> from the ground with great difficulty."
                            }
                        }
                    ],
                    "synonyms": [
                        "wstawać"
                    ],
                    "common_phrases": [
                        "powstawać z miejsc",
                        "powstawać z kolan",
                        "powstawać z krzesła"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "współcześnie w tym znaczeniu częściej używa się słowa 'wstawać'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься из сидячего или лежачего положения; вставать.",
                        "en": "To get up or rise from a sitting or lying position."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставать",
                                "target_lang_sense_clarification": "принимать вертикальное положение"
                            },
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "вставать с места"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "stand up",
                                "target_lang_sense_clarification": "to get to one's feet"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "to move upward to a standing position"
                            },
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "to get up from sitting or lying"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d97f4e12-184d-3ed0-b210-2b80de22563a",
                    "sense_definition": "Wracać do życia lub odzyskiwać dawną świetność po upadku.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regeneration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W mitologii greckiej feniks <w>powstawał</w> z popiołów, by żyć na nowo.",
                            "target_lang_translations": {
                                "ru": "В греческой мифологии феникс <w>восставал</w> из пепла, чтобы жить заново.",
                                "en": "In Greek mythology, the phoenix <w>rose</w> from the ashes to live again."
                            }
                        },
                        {
                            "text": "Zrujnowane wojną miasto powoli <w>powstawało</w> z gruzów dzięki pracy mieszkańców.",
                            "target_lang_translations": {
                                "ru": "Разрушенный войной город медленно <w>возрождался</w> из руин благодаря труду жителей.",
                                "en": "The war-ruined city slowly <w>rose</w> from the rubble thanks to the work of its inhabitants."
                            }
                        }
                    ],
                    "synonyms": [
                        "zmartwychwstawać",
                        "odradzać się"
                    ],
                    "common_phrases": [
                        "powstawać z martwych",
                        "powstawać z popiołów",
                        "powstawać z gruzów"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane metaforycznie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возрождаться, возвращаться к жизни или восстанавливать былое величие.",
                        "en": "To return to life or regain former glory after ruin or decline."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возрождаться",
                                "target_lang_sense_clarification": "обновляться после упадка"
                            },
                            {
                                "target_lang_word": "восставать",
                                "target_lang_sense_clarification": "возвращаться к жизни (высок.)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "to be reborn or recover (e.g. from the ashes)"
                            },
                            {
                                "target_lang_word": "revive",
                                "target_lang_sense_clarification": "to regain life or vigor"
                            },
                            {
                                "target_lang_word": "resurrect",
                                "target_lang_sense_clarification": "to rise from the dead"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}