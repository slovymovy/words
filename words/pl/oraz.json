        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "f0fd102d-f47a-3bf5-ae84-b3e557cedc2f",
                    "sense_definition": "Słowo łączące wyrazy lub zdania równorzędne, wskazujące na to, że wymienione elementy występują wspólnie; i, a także.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W naszym ogrodzie rosną kwiaty <w>oraz</w> warzywa.",
                            "target_lang_translations": {
                                "ru": "В нашем саду растут цветы, <w>а также</w> овощи.",
                                "en": "Flowers <w>and</w> vegetables grow in our garden.",
                                "nl": "In onze tuin groeien bloemen <w>en</w> groenten.",
                                "de": "In unserem Garten wachsen Blumen <w>sowie</w> Gemüse.",
                                "fr": "Dans notre jardin poussent des fleurs <w>ainsi que</w> des légumes.",
                                "it": "Nel nostro giardino crescono fiori <w>e</w> verdure.",
                                "cs": "V naší zahradě rostou květiny <w>a</w> zelenina.",
                                "tr": "Bahçemizde çiçekler <w>ve</w> sebzeler yetişiyor.",
                                "es": "En nuestro jardín crecen flores <w>así como</w> verduras.",
                                "zh": "我们的花园里种着花卉<w>以及</w>蔬菜。"
                            }
                        },
                        {
                            "text": "Wikipedia <w>oraz</w> Wikisłownik działają na oprogramowaniu Mediawiki.",
                            "target_lang_translations": {
                                "ru": "Википедия <w>и</w> Викисловарь работают на программном обеспечении Mediawiki.",
                                "en": "Wikipedia <w>and</w> Wiktionary run on MediaWiki software.",
                                "nl": "Wikipedia <w>alsook</w> Wiktionary draaien op Mediawiki-software.",
                                "de": "Wikipedia <w>und</w> Wiktionary laufen auf der MediaWiki-Software.",
                                "fr": "Wikipédia <w>et</w> le Wiktionnaire fonctionnent avec le logiciel Mediawiki.",
                                "it": "Wikipedia <w>e</w> Wikizionario funzionano con il software Mediawiki.",
                                "cs": "Wikipedie <w>a</w> Wikislovník fungují na softwaru Mediawiki.",
                                "tr": "Wikipedia <w>ve</w> Vikisözlük, Mediawiki yazılımı üzerinde çalışmaktadır.",
                                "es": "Wikipedia <w>y</w> Wikcionario funcionan con el software Mediawiki.",
                                "zh": "维基百科<w>和</w>维基词典都运行在Mediawiki软件上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "i",
                        "(a) także",
                        "również"
                    ],
                    "antonyms": [
                        "ani"
                    ],
                    "common_phrases": [
                        "wiedza oraz doświadczenie",
                        "szybko oraz sprawnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Союз, соединяющий слова или равноправные предложения; указывает на то, что перечисленные элементы выступают вместе.",
                        "en": "A conjunction used to connect words or equivalent clauses, indicating that the listed elements occur together; and, as well as.",
                        "nl": "Voegwoord dat woorden of gelijkwaardige zinnen verbindt; geeft aan dat de genoemde elementen samen voorkomen; en, alsook.",
                        "de": "Konjunktion, die Wörter oder gleichwertige Sätze verbindet; drückt aus, dass die genannten Elemente zusammen auftreten; und, sowie.",
                        "fr": "Conjonction reliant des mots ou des propositions de même rang, indiquant que les éléments mentionnés sont présents ensemble ; et, ainsi que.",
                        "it": "Congiunzione che unisce parole o frasi di pari grado, indicando che gli elementi elencati si presentano insieme; e, nonché.",
                        "cs": "Spojka spojující slova nebo rovnocenné věty; vyjadřuje, že uvedené prvky existují společně.",
                        "tr": "Eşit değerdeki kelimeleri veya cümleleri birbirine bağlayan, belirtilen unsurların birlikte bulunduğunu gösteren bağlaç; ve, hem de.",
                        "es": "Conjunción que une palabras o frases equivalentes, indicando que los elementos mencionados aparecen juntos; y, además.",
                        "zh": "用于连接词语或并列句，表示所列事物同时存在；和，以及。"
                    },
