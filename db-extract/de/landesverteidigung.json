                "senses": [
                    {
                        "sense_id": "aeb36bc4-94ec-36fc-8a53-e1c8629b154d",
                        "entry_id": "18233dc1-c44e-34e2-9471-0c166fbfb35b",
                        "glosses": [
                            "militärische Abwehr eines Landes gegenüber einer äußeren Aggression"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9446c45a-7f1b-4aac-a9fd-63db46e5987f",
                                "sense_id": "aeb36bc4-94ec-36fc-8a53-e1c8629b154d",
                                "text": "„Es stellt sich die Frage: Kann die Bundeswehr ihre Aufgaben der Landesverteidigung und internationalen Krisenbewältigung überhaupt noch erfüllen?“"
                            },
                            {
                                "example_id": "206ba998-c443-49e8-831c-e1e65c913fb0",
                                "sense_id": "aeb36bc4-94ec-36fc-8a53-e1c8629b154d",
                                "text": "„Eine Schlüsselrolle in der Landesverteidigung sollen U-Boote spielen.“"
                            }
                        ],
