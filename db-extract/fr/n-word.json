                "translations": [
                    {
                        "translation_id": "3a90627b-b519-4987-9d9f-57e7b5b52e91",
                        "source_entry_id": "98c02d55-fb49-3eaa-a202-0483ee2bbf1c",
                        "source_sense_id": "2cd8cf35-980a-3aaa-a23b-ca417cc9fe94",
                        "target_lang_word": "n-word",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "n-word",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7a5fcce-6df5-366f-8899-576acf4899d8",
                                        "entry_id": "c128989b-cb79-3c2c-a399-f152ba8ff0f0",
                                        "glosses": [
                                            "The word nigger or nigga or nigra."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1ba811-023a-42b2-a47c-80beb3fbaea7",
                                                "sense_id": "b7a5fcce-6df5-366f-8899-576acf4899d8",
                                                "text": "The prosecutor, his voice trembling, added that the \"N-word\" was so vile that he would not utter it."
                                            },
                                            {
                                                "example_id": "72874268-b417-46b5-bb07-ba4e8eda9ff4",
                                                "sense_id": "b7a5fcce-6df5-366f-8899-576acf4899d8",
                                                "text": "I do not use “children”, because I see that word as being an equivalent to the N-word in this context [the out-right slavery that those under 18 face]. “Childish”, “child-like”, etc. usually have very negative or derogatory connotations."
                                            },
                                            {
                                                "example_id": "30edeeb9-4319-4038-a2b7-799e0758369f",
                                                "sense_id": "b7a5fcce-6df5-366f-8899-576acf4899d8",
                                                "text": "That well-spoken token, who ain't been heard / The only white rapper who's allowed to say the N-word"
                                            },
                                            {
                                                "example_id": "8bcfa687-6eb3-44ad-9ded-b4a6eeaf3a29",
                                                "sense_id": "b7a5fcce-6df5-366f-8899-576acf4899d8",
                                                "text": "[Pain and sorrow are feelings] that has not lessened no matter how many times I hear the n-word."
                                            },
                                            {
                                                "example_id": "7a4bfd08-aaf4-4eee-853e-a14c5d4ff861",
                                                "sense_id": "b7a5fcce-6df5-366f-8899-576acf4899d8",
                                                "text": "Don't say the N word if you a good person\n Unless you black, then it's ok."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdcbdefd-f869-3c06-9f01-091a8f33702b",
                                        "entry_id": "c128989b-cb79-3c2c-a399-f152ba8ff0f0",
                                        "glosses": [
                                            "Any word, regardless of its starting letter, that is used oppressively, marginalizes or oppresses a group of people."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a86a8c-7bd6-45f8-9ce0-e8fe49a32252",
                                                "sense_id": "cdcbdefd-f869-3c06-9f01-091a8f33702b",
                                                "text": "[It] has become ... an equivalent of the n''' word for Maori[s]."
                                            },
                                            {
                                                "example_id": "941a0feb-f725-4f46-a003-d3148658c74e",
                                                "sense_id": "cdcbdefd-f869-3c06-9f01-091a8f33702b",
                                                "text": "\"It's important to understand that for Indigenous people, this word is our N-word,\" said Douglas Stewart, an Indigenous teacher at Harrison Trimble High School in Moncton."
                                            },
                                            {
                                                "example_id": "bcee6349-474a-40b7-90d4-71cb5b1796e5",
                                                "sense_id": "cdcbdefd-f869-3c06-9f01-091a8f33702b",
                                                "text": "[I]t was effectively the N-word for Brown people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d687a2-28b7-3df2-a585-f606b7d975c4",
                                        "entry_id": "c128989b-cb79-3c2c-a399-f152ba8ff0f0",
                                        "glosses": [
                                            "The word Nazi."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d60ad8b-80cf-4432-8d00-40ded676ba7c",
                                                "sense_id": "27d687a2-28b7-3df2-a585-f606b7d975c4",
                                                "text": "After that episode aired a new rule was posted: \"Do not mention the N Word (Nazi)!\""
                                            },
                                            {
                                                "example_id": "855807c4-0813-493f-8087-60126ec0ad85",
                                                "sense_id": "27d687a2-28b7-3df2-a585-f606b7d975c4",
                                                "text": "The preceding poem inspired the “Not Say Nazi” movement to stamp out widespread ignorance and to abolish the N-word and the F-word."
                                            },
                                            {
                                                "example_id": "d967e098-76c5-4d87-8ddb-4605e75247d2",
                                                "sense_id": "27d687a2-28b7-3df2-a585-f606b7d975c4",
                                                "text": "By dropping the N-word, you don't just stop the thinking processes in most of your audience; if you're not careful, you also stop your own mind from functioning. Most of these Nazi detectives conclude with their \"revelation\" that X has Nazi connections, and then expect the public to erupt in indignant outbursts of hate against X."
                                            },
                                            {
                                                "example_id": "7ef1baa8-4c5a-443b-90ee-1eb63af6051b",
                                                "sense_id": "27d687a2-28b7-3df2-a585-f606b7d975c4",
                                                "text": "Americans realize that von Braun had been a member of the Nazi party and an officer in the SS and that the V-2 was constructed using forced labor from concentration camps who were worked to death (2012). NASA refused to budge from its position. Regrettably, CFCH retreated and removed the offending N word."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89a15aaa-140a-3c8e-810b-1acf8b0849f0",
                                        "entry_id": "c128989b-cb79-3c2c-a399-f152ba8ff0f0",
                                        "glosses": [
                                            "The word nuclear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed5ff6c-5d91-4a4c-a4ab-43f7b30ec539",
                                                "sense_id": "89a15aaa-140a-3c8e-810b-1acf8b0849f0",
                                                "text": "Parkinson has to live with the dreaded “N” word. So feared is the word “nuclear” that there are those who balk at using such harmless phrases as “nuclear family”."
                                            },
                                            {
                                                "example_id": "c2567a78-480f-4705-815d-6aebb18aef41",
                                                "sense_id": "89a15aaa-140a-3c8e-810b-1acf8b0849f0",
                                                "text": "—and there is a large tendency, I think, to think of our sites totally in terms of the “n” word, the nuclear radioactive word, but 80 percent of the waste that we have on these sites is chemical hazardous waste , which makes us no different in that respect from all of the major industrial companies in the United States who have to deal with this problem."
                                            },
                                            {
                                                "example_id": "cc675220-bd23-4644-9ebe-09cf148a99ef",
                                                "sense_id": "89a15aaa-140a-3c8e-810b-1acf8b0849f0",
                                                "text": "Their methods depend on nuclear magnetic resonance (NMR) spectroscopy, a technology widely used by physicists, chemists, and biologists to analyze molecular structures and by doctors for medical diagnosis. In its medical setting NMR is better known as magnetic resonance imaging (MRI), a name that avoids unnecessarily provoking fears over the dreaded N-word: nuclear. Nuclear magnetic resonance actually doesn’t involve radioactivity or any ionizing radiation but instead uses harmless but powerful magnetic fields and pulses of radio waves to probe the atomic nuclei that quietly reside within all materials, chemical and biological."
                                            },
                                            {
                                                "example_id": "da8983c9-f1bd-43a7-9b02-eddc88483a17",
                                                "sense_id": "89a15aaa-140a-3c8e-810b-1acf8b0849f0",
                                                "text": "'Plus of course, there's the “N” word - nuclear is a big no, no, in British politics. Successive governments, both Labour and Tory, have shied away from doing what they both know is actually unavoidable.'"
                                            },
                                            {
                                                "example_id": "7ec8f158-93b7-4fac-b772-4d22a71a6f76",
                                                "sense_id": "89a15aaa-140a-3c8e-810b-1acf8b0849f0",
                                                "text": "‘Are you going to tell me the N word?”\n‘N word?’\n’Nuclear.’"
                                            },
                                            {
                                                "example_id": "c3355fc5-ad9d-4cf6-ba8a-7d034416c79d",
                                                "sense_id": "89a15aaa-140a-3c8e-810b-1acf8b0849f0",
                                                "text": "The machine was originally called NMRI, but \"nuclear\" is one of the two forbidden \"n\" words of our times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b15598d-8745-30ff-981c-4bfab0ed33f7",
                                        "entry_id": "c128989b-cb79-3c2c-a399-f152ba8ff0f0",
                                        "glosses": [
                                            "A negation word, such as not, nobody, or nothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa9eda6-28a6-4dc6-83c5-d8f95c64843a",
                                                "sense_id": "9b15598d-8745-30ff-981c-4bfab0ed33f7",
                                                "text": "Hence, the reasoning applied to (15) above extends to (20), leading us to conclude that the n-word rien,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ed63d17-d94f-3704-a7f4-e076f17c3ee9",
                                        "entry_id": "c128989b-cb79-3c2c-a399-f152ba8ff0f0",
                                        "glosses": [
                                            "A Danish/Swedish/Norwegian noun of the common gender (their indefinite article being en), as opposed to t-words, nouns of the neuter gender (their indefinite article being et)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
