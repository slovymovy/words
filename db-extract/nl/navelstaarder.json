                    {
                        "sense_id": "9e4d9c56-60d8-3a5f-801a-3e947ec06927",
                        "entry_id": "036de95f-f769-311b-b07c-4e0416649035",
                        "glosses": [
                            "iemand die zich alleen maar bezighoudt met zijn eigen zielenroerselen dan met de praktische buitenwereld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "217dd518-b221-4bcb-9db8-30d491075ae4",
                                "sense_id": "9e4d9c56-60d8-3a5f-801a-3e947ec06927",
                                "text": "Amerika en Rusland hebben de wapens, China het geld. Lange tijd was het Aziatische land nauwelijks bezig met wat er in de rest van de wereld allemaal gebeurde, maar sinds het land zijn deuren heeft geopend, en zich tot een grootmacht heeft ontwikkeld, kan een belangrijke rol op dat politieke toneel niet ontbreken. China is definitief navelstaarder af."
                            },
                            {
                                "example_id": "75e36a81-399d-44f5-b3e7-35718866b338",
                                "sense_id": "9e4d9c56-60d8-3a5f-801a-3e947ec06927",
                                "text": "Materiaal uit schoenendozen op zolder. Niet gefilmd zoals de navelstaarders, de selfiekoningen van deze tijd, maar naar buiten gericht."
                            }
                        ]
                    }
