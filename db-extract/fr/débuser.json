                "senses": [
                    {
                        "sense_id": "58008a4b-950c-3510-920e-e4bba85e27a0",
                        "entry_id": "25493984-ac07-319c-bc68-fd28cdcb9b4e",
                        "glosses": [
                            "Enlever la buse qui équipait quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33c7ade-faba-4d76-8eaa-0450af111564",
                                "sense_id": "58008a4b-950c-3510-920e-e4bba85e27a0",
                                "text": "Les projets privés font également l'objet d'obligations (hors cas particuliers) afin de débuser les canaux."
                            },
                            {
                                "example_id": "e650e64b-3ab7-4779-b22c-f3039de001ae",
                                "sense_id": "58008a4b-950c-3510-920e-e4bba85e27a0",
                                "text": "Cette année, il est prévu de supprimer un clapet, de renaturer le lit mineur du Dhuy notamment sur la commune de Vienne-en-Val, et de débuser deux confluences d'affluents."
                            },
                            {
                                "example_id": "a51d047d-0d85-45fd-9bf4-5ce577833f86",
                                "sense_id": "58008a4b-950c-3510-920e-e4bba85e27a0",
                                "text": "J'ai un Bocar récent (qui marche très bien contrairement à ce que j'ai pu beaucoup lire), et je souhaiterais savoir si il est possible de rebuser en 28/28.5 ou débuser ce carbu."
                            }
                        ]
                    }
