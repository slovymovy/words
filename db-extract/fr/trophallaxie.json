                        "sense_id": "8362596a-3e9a-3f6e-b57f-20b481c3e104",
                        "entry_id": "50b8ce5f-b862-3a22-94db-059e20f87566",
                        "glosses": [
                            "Échange de nourriture régurgitée entre insectes sociaux, permettant de nourrir l’individu receveur, mais aussi d'échanger des phéromones et de communiquer au sein d’une même communauté d’insectes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1391f7f-3fbc-4e50-aff3-e852a7ad0140",
                                "sense_id": "8362596a-3e9a-3f6e-b57f-20b481c3e104",
                                "text": "Les fourmis ont deux estomacs, et l'échange de nourriture par trophallaxie permet de resserrer les liens sociaux entre les insectes."
                            }
                        ]
                    }
                ],
