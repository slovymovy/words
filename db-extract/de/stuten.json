                                            {
                                                "example_id": "eaca5447-846e-4d4f-a8c6-f97a37b7aae3",
                                                "sense_id": "a2529354-02cb-311b-a700-2f512e988df5",
                                                "text": "Is die stoet nou nog niet afgelopen?"
                                            },
                                            {
                                                "example_id": "a928f1fa-64d7-4002-9dc5-5cd12220b034",
                                                "sense_id": "a2529354-02cb-311b-a700-2f512e988df5",
                                                "text": "Een stoet van honderd auto's heeft zaterdagmiddag overlast veroorzaakt in het centrum en de buitenwijken van Bergen op Zoom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b70c6c0-4e75-34e1-952f-0a68bc0f0fbe",
                                        "entry_id": "fe89dc44-0437-3049-a25e-7de3e5d67c4b",
                                        "glosses": [
                                            "grote hoeveelheid"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea81724-e3c4-4f9f-8f49-b3e4fc5407ab",
                                                "sense_id": "2b70c6c0-4e75-34e1-952f-0a68bc0f0fbe",
                                                "text": "Oh, daar is een hele stoet van!"
                                            },
                                            {
                                                "example_id": "75560cec-b286-4a5a-a022-a355b1233fea",
                                                "sense_id": "2b70c6c0-4e75-34e1-952f-0a68bc0f0fbe",
                                                "text": "Rechthebbenden, meervoud, want de auteur is niet de enige die een leenrechtvergoeding krijgt. (…) Dat betekent dat naast de auteur, die financieel echt afhankelijk is van de verkoop van het boek, een hele stoet ‘belanghebbenden’ de hand ophoudt die al lang voor de verrichte werkzaamheden betaald is."
                                            }
                                        ]
                                    }
