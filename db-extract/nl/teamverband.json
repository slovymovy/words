                        "examples": [
                            {
                                "example_id": "9a75fe63-346c-4ead-96bd-3d8523332c92",
                                "sense_id": "c4678651-587c-3754-8b13-4ddb8f40f3c6",
                                "text": "Er waren tal van projecten die we in teamverband moesten aanpakken. Marlies moest als coördinator mij aansturen. Zo kreeg ik af en toe instructies om iets aan te passen, maar dat deed ze steeds met zachte hand. De samenwerking was een bevestiging dat we ook professioneel elkaar goed konden aanvullen."
                            },
                            {
                                "example_id": "281f210d-bcbf-4a77-b948-9f07ed6a860e",
                                "sense_id": "c4678651-587c-3754-8b13-4ddb8f40f3c6",
                                "text": "Voormalig schermkampioen Oscar Kardolus is in een ziekenhuis in Delft op 60-jarige leeftijd overleden. Kardolus was al enige tijd ernstig ziek. Hij werd in zijn actieve loopbaan negen keer Nederlands kampioen sabelschermen en veroverde in teamverband liefst achttien nationale titels."
                            }
                        ]
                    }
