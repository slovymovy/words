            {
                "entry_id": "9d9c2895-3649-310d-a132-f7b8444d536c",
                "word": "Vincent",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e2b5d6d-141d-3b9e-adb8-ecd21300558b",
                        "entry_id": "9d9c2895-3649-310d-a132-f7b8444d536c",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77529724-f416-4ef4-b29d-f0ef6ffd87b6",
                                "sense_id": "4e2b5d6d-141d-3b9e-adb8-ecd21300558b",
                                "text": "Quand tante Claire donnait le signal du départ, Vincent bougonnait que les femmes étaient des casseuses de veillée. Il finissait par se lever péniblement."
                            },
                            {
                                "example_id": "2a835c60-7d07-4b2c-90c5-333a664635bc",
                                "sense_id": "4e2b5d6d-141d-3b9e-adb8-ecd21300558b",
                                "text": "Bien accompagnée par des musiciens talentueux dont l’harmoniciste inspiré, Vincent Bucher, Joyce Tape a chanté, dansé au rythme du blues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19efc924-02b9-4022-9013-d3172cbdcb71",
                        "source_entry_id": "9d9c2895-3649-310d-a132-f7b8444d536c",
                        "source_sense_id": "4e2b5d6d-141d-3b9e-adb8-ecd21300558b",
                        "target_lang_word": "Vincent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vincent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b77b78f-f560-3f67-9f59-7b4f00dd7a65",
                                        "entry_id": "b60b2e89-4d3f-3f15-b533-30d781bff1c0",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
