{
    "word_family": [
        "zwerm",
        "gezwerm",
        "zwermer",
        "uitzwermen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4059d7e-8e54-3cf9-ae20-7ee3cac8a7da",
                    "sense_definition": "zich in een grote groep of menigte voortbewegen, meestal vliegend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wespen <w>zwermden</w> samen in het rond bij de picknicktafel.",
                            "target_lang_translations": {
                                "en": "The wasps <w>swarmed</w> around together near the picnic table."
                            }
                        },
                        {
                            "text": "In de zomer zie je vaak muggen die in grote groepen <w>zwermen</w> boven het water.",
                            "target_lang_translations": {
                                "en": "In the summer, you often see mosquitoes <w>swarming</w> in large groups above the water."
                            }
                        }
                    ],
                    "synonyms": [
                        "krioelen",
                        "wemelen"
                    ],
                    "common_phrases": [
                        "zwermen rond",
                        "in groten getale zwermen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move in a large group or crowd, usually while flying"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to swarm",
                                "target_lang_sense_clarification": "moving together in a large group, especially insects"
                            },
                            {
                                "target_lang_word": "to flock",
                                "target_lang_sense_clarification": "moving together in a large group, especially birds"
                            },
                            {
                                "target_lang_word": "to teem",
                                "target_lang_sense_clarification": "to be present in large, moving numbers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9555a302-3872-3ee8-a00b-b366bb0e77db",
                    "sense_definition": "zich zonder duidelijk doel of vaste richting verplaatsen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De toeristen <w>zwermden</w> door de smalle straatjes van de oude stad.",
                            "target_lang_translations": {
                                "en": "The tourists <w>wandered</w> through the narrow streets of the old city."
                            }
                        },
                        {
                            "text": "Na de voorstelling <w>zwermde</w> het publiek langzaam naar buiten.",
                            "target_lang_translations": {
                                "en": "After the performance, the audience slowly <w>milled</w> outside."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwerven",
                        "dwalen",
                        "ronddolen"
                    ],
                    "common_phrases": [
                        "door de straten zwermen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move around without a clear purpose or fixed direction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to mill about",
                                "target_lang_sense_clarification": "moving around aimlessly in a crowd"
                            },
                            {
                                "target_lang_word": "to wander",
                                "target_lang_sense_clarification": "moving without a fixed destination"
                            },
                            {
                                "target_lang_word": "to scatter",
                                "target_lang_sense_clarification": "moving away in different directions"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e06b285-d011-3c39-b573-30b0951c782b",
                    "sense_definition": "meervoud van <w>zwerm</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "groepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de herfst zie je grote <w>zwermen</w> vogels naar het zuiden vliegen.",
                            "target_lang_translations": {
                                "en": "In the autumn, you see large <w>flocks</w> of birds flying south."
                            }
                        },
                        {
                            "text": "De imker probeert de verschillende <w>zwermen</w> bijen onder controle te houden.",
                            "target_lang_translations": {
                                "en": "The beekeeper tries to keep the various <w>swarms</w> of bees under control."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zwermen vogels",
                        "zwermen bijen"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'swarm'; large groups of insects, birds, or people"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swarms",
                                "target_lang_sense_clarification": "plural of swarm, usually for insects"
                            },
                            {
                                "target_lang_word": "flocks",
                                "target_lang_sense_clarification": "plural of flock, usually for birds"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}