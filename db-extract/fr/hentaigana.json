                "senses": [
                    {
                        "sense_id": "a964415e-975b-34b0-8565-8af2d61b7729",
                        "entry_id": "5c206db9-d971-314e-a0ad-794115488f82",
                        "glosses": [
                            "Ancien caractère syllabique japonais provenant d’une écriture cursive d’un kanji, ayant été supplanté par les hiraganas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad68287-e259-422d-800d-9f1edc28f83f",
                                "sense_id": "a964415e-975b-34b0-8565-8af2d61b7729",
                                "text": "L’augmentation du nombre des kanji, l’abandon de l’orthographe phonétique des kana au profit de leur orthographe historique et la réintroduction des hentaigana poussèrent les instituteurs et les spécialistes de l’enseignement de la langue à privilégier, dans leurs cours et dans leurs recherches, le code au détriment du message."
                            }
                        ]
                    }
