                "senses": [
                    {
                        "sense_id": "a040c643-8bbb-3a20-92ca-c1c04c12d081",
                        "entry_id": "1d9300e5-c1bf-3d14-9204-566ea1517572",
                        "glosses": [
                            "With a dry, harsh voice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b9e278c-2853-4393-8578-857dffaa80e6",
                                "sense_id": "a040c643-8bbb-3a20-92ca-c1c04c12d081",
                                "text": "She spoke hoarsely because of her cough."
                            },
                            {
                                "example_id": "3d26de39-2e3e-4ed1-8690-af9eb5ca8443",
                                "sense_id": "a040c643-8bbb-3a20-92ca-c1c04c12d081",
                                "text": "`Say, hast thou seen enough!' `I have looked on beauty, and I am blinded,' I said hoarsely, lifting my hand to cover up my eyes."
                            },
                            {
                                "example_id": "a793894c-a1e0-484d-abd3-8c6d988a6b7b",
                                "sense_id": "a040c643-8bbb-3a20-92ca-c1c04c12d081",
                                "text": "I hope that my philosopher may yet walk on the hills with me, if only for the sake of the love I bear the green valleys; and when I see the great stream passing silently from translucent pool to pool, overhung by rowans and sun-warmed rocks, I shall be glad to think that I have walked on the heights where it was gathered and drawn, and that I have heard it talk hoarsely to itself, cold and uncomforted, among the bleak and dripping stones."
                            },
                            {
                                "example_id": "6279a1e8-a167-4a74-972d-b9a9b5f74daa",
                                "sense_id": "a040c643-8bbb-3a20-92ca-c1c04c12d081",
                                "text": "\"Where do you keep your cash, bub?\" asked Idris hoarsely. His American was better than Hassan's English."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "747e1330-c1d4-4b66-8169-32c4f029be88",
                        "source_entry_id": "1d9300e5-c1bf-3d14-9204-566ea1517572",
                        "source_sense_id": "a040c643-8bbb-3a20-92ca-c1c04c12d081",
