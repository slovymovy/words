                "entry_id": "51f9fa36-e455-3a39-be4a-5d4b1efe9e9d",
                "word": "pectin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2c483a2a-b3c0-4aa2-a584-8d190c536cdd",
                        "entry_id": "51f9fa36-e455-3a39-be4a-5d4b1efe9e9d",
                        "tags": [
                            "plural"
                        ],
                        "form": "pectins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b504f4e-76df-38a1-a02c-1a5cfed639e1",
                        "entry_id": "51f9fa36-e455-3a39-be4a-5d4b1efe9e9d",
                        "glosses": [
                            "A polysaccharide extracted from the cell walls of plants, especially of fruits; under acidic conditions it forms a gel. It is often used in processed foods, especially jellies and jams where it causes thickening (setting)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "69973738-285b-4ab4-8512-c54848081f0f",
                                "sense_id": "7b504f4e-76df-38a1-a02c-1a5cfed639e1",
                                "text": "Apple is rich in pectin and so is often added to other fruits when making jam so it will set."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6f51411-b09f-4542-b23c-1da94babe0eb",
                        "source_entry_id": "51f9fa36-e455-3a39-be4a-5d4b1efe9e9d",
                        "source_sense_id": "7b504f4e-76df-38a1-a02c-1a5cfed639e1",
