                    {
                        "translation_id": "6350be37-22da-4396-b429-c780d74447fb",
                        "source_entry_id": "1b0e3e5d-77da-3321-ba83-968b51083a74",
                        "source_sense_id": "6eea2076-d23e-32d3-8db5-62c6b03c315c",
                        "source_sense_description": "duck of genus Somateria",
                        "target_lang_word": "eider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d8951f2-89d2-3a87-8dfa-39368d09d30e",
                                        "entry_id": "d9d11a63-6686-39a0-84ba-93a08ee081f4",
                                        "glosses": [
                                            "Anatidé, aux formes massives, dont une espèce fournit l’édredon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b020c9a1-b5ae-4021-babc-ad7d8505a956",
                                                "sense_id": "7d8951f2-89d2-3a87-8dfa-39368d09d30e",
                                                "text": "L'eider est un canard maritime nordique et migrateur qui niche notamment sur des îles de l'estuaire du Bas-Saint-Laurent comme l'île aux Pommes, l'île Bicquette ou l'île aux Lièvres."
                                            },
                                            {
                                                "example_id": "5b762ab2-c9a2-4df7-aae4-080840821c2e",
                                                "sense_id": "7d8951f2-89d2-3a87-8dfa-39368d09d30e",
                                                "text": "Plus petit que l’eider à duvet, l’eider à lunettes est immédiatement identifiable à l’emplumage de son bec jusqu’aux narines et à ses lunettes visibles en toutes saisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92442575-f248-3261-a6e2-693ee032439f",
                                        "entry_id": "d9d11a63-6686-39a0-84ba-93a08ee081f4",
                                        "glosses": [
                                            "Eider à duvet."
                                        ],
                                        "tags": [
                                            "Sens restreint"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83d8eac7-2f61-44e2-a39d-fcc41e66d86b",
                                                "sense_id": "92442575-f248-3261-a6e2-693ee032439f",
                                                "text": "Voici la fameuse oie à duvet ou canard Eider, sous l’édredon de laquelle dorment nos petites maîtresses."
                                            },
                                            {
                                                "example_id": "a78ce358-ba08-4189-9826-05caff91dbd9",
                                                "sense_id": "92442575-f248-3261-a6e2-693ee032439f",
                                                "text": "Ces îlots, constitués de basalte, servent de repaires à des myriades d’eiders qui nichent dans les rochers. Ces oiseaux donnent le précieux duvet connu sous le nom d’édredon, et sont la principale ressource des habitants : la loi défend de les tuer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f33a5ed2-655b-457d-a2d8-3723d634cffd",
                        "source_entry_id": "1b0e3e5d-77da-3321-ba83-968b51083a74",
                        "source_sense_id": "6eea2076-d23e-32d3-8db5-62c6b03c315c",
                        "source_sense_description": "duck of genus Somateria",
                        "target_lang_word": "Eiderente",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eiderente",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29e920a7-445c-352d-83d8-81c9d29f9d18",
                                        "entry_id": "ec190b6f-335d-344d-a832-8a3dabe422fc",
                                        "glosses": [
                                            "Vogelart aus der Familie der Entenvögel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f0b36f-8a8d-4c70-aa02-1048bbbf0ac9",
                                                "sense_id": "29e920a7-445c-352d-83d8-81c9d29f9d18",
                                                "text": "Die Daunen der Eiderente werden zur Füllung von Daunendecken verwendet."
                                            },
                                            {
                                                "example_id": "8d8b74eb-39b0-4c4a-b861-653b22146694",
                                                "sense_id": "29e920a7-445c-352d-83d8-81c9d29f9d18",
                                                "text": "„Sie hörte lautes Gerede von ein paar Fischern drüben bei den Bootshäusern, und als sie stehen blieb, hörte sie auch, wie die Enten und Eiderenten an der Mündung des Flüsschens erwachten.“"
                                            },
                                            {
                                                "example_id": "65db4676-dfd0-4f43-b681-a39054890318",
                                                "sense_id": "29e920a7-445c-352d-83d8-81c9d29f9d18",
                                                "text": "„Pär hatte beim Anchovis-Fang außerdem große Konkurrenz durch Eiderenten, die sich von Anchovis ernähren.“"
                                            },
                                            {
                                                "example_id": "8bf09193-e21f-427a-87e3-d8bbe6658667",
                                                "sense_id": "29e920a7-445c-352d-83d8-81c9d29f9d18",
                                                "text": "„Im Sommer kamen noch viel mehr Vögel auf den Steinen zusammen, dann tummelten sich dort Meeresstrandläufer, Steinwälzer, Austernfischer und Eiderenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0da866b8-034e-3a7f-aa0d-181aa238eee9",
                                        "entry_id": "ec190b6f-335d-344d-a832-8a3dabe422fc",
                                        "glosses": [
                                            "Gattung der Entenvögel (Somateria)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6491b1a-1ec1-49cf-9f89-e3289feec814",
                                                "sense_id": "0da866b8-034e-3a7f-aa0d-181aa238eee9",
                                                "text": "Die Gattung der Eiderenten umfasst drei Arten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
