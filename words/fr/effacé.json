                    "sense_id": "930bb07a-52f6-3f33-b48d-cd0c520fb64b",
                    "sense_definition": "Participe passé masculin singulier de <w>effacer</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a <w>effacé</w> le tableau avant d'écrire la nouvelle leçon.",
                            "target_lang_translations": {
                                "en": "The teacher <w>erased</w> the board before writing the new lesson.",
                                "ru": "Учитель <w>стёр</w> доску перед тем, как написать новый урок.",
                                "de": "Der Lehrer hat die Tafel <w>abgewischt</w>, bevor er die neue Lektion schrieb.",
                                "es": "El profesor <w>borró</w> la pizarra antes de escribir la nueva lección.",
                                "zh": "老师在写新课之前<w>擦掉</w>了黑板。"
                            }
                        },
                        {
                            "text": "J'ai accidentellement <w>effacé</w> tous mes courriels importants ce matin.",
                            "target_lang_translations": {
                                "en": "I accidentally <w>deleted</w> all my important emails this morning.",
                                "ru": "Сегодня утром я случайно <w>удалил</w> все свои важные электронные письма.",
                                "de": "Ich habe heute Morgen versehentlich alle meine wichtigen E-Mails <w>gelöscht</w>.",
                                "es": "He <w>borrado</w> accidentalmente todos mis correos electrónicos importantes esta mañana.",
                                "zh": "今天早上我不小心<w>删除</w>了所有重要的电子邮件。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past participle of the verb effacer, meaning erased.",
