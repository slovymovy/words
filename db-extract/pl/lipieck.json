                                        "examples": [
                                            {
                                                "example_id": "a0305381-1c8b-4ea1-8ae5-f787df6c7ade",
                                                "sense_id": "2d6e7203-e819-3a83-be1c-be02c56da526",
                                                "text": "„Anstelle eines Kremls hat Lipezk ein Stahlwerk.“"
                                            }
