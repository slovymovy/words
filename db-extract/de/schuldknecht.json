                        "examples": [
                            {
                                "example_id": "16338eb6-6b90-4716-b522-0343c061023c",
                                "sense_id": "66a78006-8903-3338-8c73-c10eea604c70",
                                "text": "Wie Caesar die gallischen Gemeinden vorfand, mit einer in völliger politischer wie ökonomischer Abhängigkeit gehaltenen Volksmasse und einem übermächtigen Adel, so sind sie im wesentlichen auch unter römischer Herrschaft geblieben; genau wie in vorrömischer Zeit die großen Adligen mit ihrem nach Tausenden zählenden Gesinde von Hörigen und Schuldknechten ein jeder in seiner Heimat die Herren spielten, so schildert uns Tacitus in Tiberius’ Zeit die Zustände bei den Treverern.",
                                "translation": "The History of Rome",
                                "english": "The History of Rome"
                            }
                        ]
                    }
