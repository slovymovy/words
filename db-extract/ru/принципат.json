                    {
                        "translation_id": "ee54df35-dce1-41ba-b079-099c26c68f02",
                        "source_entry_id": "3fdc8dc6-6d67-33b1-87ea-43b2190f625a",
                        "source_sense_id": "78007d18-407c-313d-9728-64d8ca491e59",
                        "target_lang_word": "principat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "principat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d26facfb-35d6-37ab-8424-f2b99f33c84d",
                                        "entry_id": "5e910c56-a00d-3847-ad45-d4cea3755154",
                                        "glosses": [
                                            "Dignité impériale chez les Romains antiques."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8d8b1b6-49d6-4ebe-9c75-a1196bcb1a3b",
                                                "sense_id": "d26facfb-35d6-37ab-8424-f2b99f33c84d",
                                                "text": "Et ne sais-tu pas que, sous le principat de Tibère, un jeune chevalier se fit passer pour le Jupiter cornu des Égyptiens et obtint sous ce déguisement les faveurs d’une dame illustre, trop vertueuse pour rien refuser aux dieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb8306c-52a5-3ec2-96e2-0f9a2ed75703",
                                        "entry_id": "5e910c56-a00d-3847-ad45-d4cea3755154",
                                        "glosses": [
                                            "Forme de gouvernement correspondant."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0977ac70-1758-48df-ba8d-5bc5c90356ba",
                                                "sense_id": "4eb8306c-52a5-3ec2-96e2-0f9a2ed75703",
                                                "text": "Il a vu l'émergence d'un type de régime politique sans précédent, où l'exercice personnel du pouvoir l'emporte, mais que les Romains appellent toujours la République car en subsistent des institutions et des traditions. De plus en plus, ils le nomment « principat » en référence aux pouvoirs du prince, premier des citoyens et premier des sénateurs. Les Modernes le désignent, le plus souvent, sous le nom d'Empire, quitte à confondre une période historique, les territoires sur lesquels s'exercent l'autorité de Rome et cette nouvelle forme de gouvernement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
