                    {
                        "sense_id": "689120bc-8a89-3a72-8f31-059e189ba7fa",
                        "entry_id": "2c1758fd-8985-3a4d-9076-8f61f67edb8a",
                        "glosses": [
                            "ciepłe kraje, do których odlatują ptaki"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "810b7691-c395-4252-a7ba-1b055aadafab",
                                "sense_id": "689120bc-8a89-3a72-8f31-059e189ba7fa",
                                "text": "Coraz liczniej przylatywało z wyraju ptactwo leśne, polne i błotne; ożywiły się puste gęstwiny i wody"
                            },
                            {
                                "example_id": "3e20b999-fa54-40ff-8c68-b9834ffd7131",
                                "sense_id": "689120bc-8a89-3a72-8f31-059e189ba7fa",
                                "text": "– Na wyraj, jazda! – zakomenderował Rosomak, lokując but z Tupciem i sam siadając byle jak, z nogami poza drabiną"
                            }
                        ],
