                ],
                "senses": [
                    {
                        "sense_id": "814e4361-ac81-3ea8-8031-7b9ed975805b",
                        "entry_id": "15dbc6a4-1400-3618-8a16-4afffa74c943",
                        "glosses": [
                            "een uurwerk dat om de pols gedragen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df34b6ce-f973-4e1c-b984-1846940b6fc4",
                                "sense_id": "814e4361-ac81-3ea8-8031-7b9ed975805b",
                                "text": "Hij had net een nieuw polshorloge gekocht, daarom moest het bandje nog iets worden ingekort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a3d2322-154d-4dcc-b715-f043f8466a56",
                        "source_entry_id": "15dbc6a4-1400-3618-8a16-4afffa74c943",
                        "source_sense_id": "814e4361-ac81-3ea8-8031-7b9ed975805b",
                        "source_sense_description": "een uurwerk dat om de pols gedragen wordt",
                        "target_lang_word": "Armbanduhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armbanduhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a63b540-ec9e-36f8-8fdb-87a222d2dd97",
                                        "entry_id": "600ac034-a79a-3547-8c76-ac1df6af7868",
                                        "glosses": [
                                            "eine an einem Armband befestigte Uhr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08caaf31-3f60-4e28-a31c-c4fbaf68e85a",
                                                "sense_id": "2a63b540-ec9e-36f8-8fdb-87a222d2dd97",
                                                "text": "Er trägt an seinem linken Handgelenk eine vornehme Armbanduhr."
                                            },
                                            {
                                                "example_id": "04b93feb-2c66-48cc-a546-64aa31ef712b",
                                                "sense_id": "2a63b540-ec9e-36f8-8fdb-87a222d2dd97",
                                                "text": "In den 1960er Jahren war es noch nicht selbstverständlich, eine Armbanduhr zu haben. Heute ist sie schon fast nicht mehr notwendig, weil jedes Handy oder Smartphone die Zeit anzeigt."
                                            },
                                            {
                                                "example_id": "e0c2cde1-5431-4177-8692-adcc0eae213b",
                                                "sense_id": "2a63b540-ec9e-36f8-8fdb-87a222d2dd97",
                                                "text": "„Ich blickte auf das Leuchtzifferblatt meiner Armbanduhr.“"
                                            },
                                            {
                                                "example_id": "74f2db1e-5200-4d04-a5f1-faa35fe0c30a",
                                                "sense_id": "2a63b540-ec9e-36f8-8fdb-87a222d2dd97",
                                                "text": "„Ich hatte meine Armbanduhr die ganze Nacht anbehalten, und als ich darauf schaute, sah ich, dass es schon acht Uhr war.“"
                                            },
                                            {
                                                "example_id": "8e8c530e-ee1b-4724-8785-acc4c1ba453f",
                                                "sense_id": "2a63b540-ec9e-36f8-8fdb-87a222d2dd97",
                                                "text": "„Der junge Mann blickte unmerklich auf seine Armbanduhr.“"
                                            },
                                            {
                                                "example_id": "9850db57-a027-4d26-815a-2afd0bad22f4",
                                                "sense_id": "2a63b540-ec9e-36f8-8fdb-87a222d2dd97",
                                                "text": "„Sisi wird sich keine goldene Armbanduhr kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09f122f8-641a-4e9d-b3c7-8c13f05a8e73",
                        "source_entry_id": "15dbc6a4-1400-3618-8a16-4afffa74c943",
                        "source_sense_id": "814e4361-ac81-3ea8-8031-7b9ed975805b",
                        "source_sense_description": "een uurwerk dat om de pols gedragen wordt",
                        "target_lang_word": "wristwatch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wristwatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c060b323-300f-390a-a2ca-013dfb93172d",
                                        "entry_id": "78d58d3e-1737-3293-a1c8-701c62981b17",
                                        "glosses": [
                                            "A watch that is worn on a strap or band fastened around the wrist"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21040e85-f472-46b6-9b56-0158d4c65398",
                        "source_entry_id": "15dbc6a4-1400-3618-8a16-4afffa74c943",
                        "source_sense_id": "814e4361-ac81-3ea8-8031-7b9ed975805b",
                        "source_sense_description": "een uurwerk dat om de pols gedragen wordt",
                        "target_lang_word": "watch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2daf845-eeef-3269-b373-8943e9206a9e",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "A portable or wearable timepiece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c94b4e-a1ee-4da8-ab9d-8599208e15d3",
                                                "sense_id": "f2daf845-eeef-3269-b373-8943e9206a9e",
                                                "text": "Meronyms: watch face, watch receiver, watchspring, watch battery, watchstrap, watch strap, watchband"
                                            },
                                            {
                                                "example_id": "d1db151a-a869-4a93-baf2-1b1261f94d20",
                                                "sense_id": "f2daf845-eeef-3269-b373-8943e9206a9e",
                                                "text": "More people today carry a watch on their wrists than in their pockets; some people today don't use a watch at all, because their smartphone serves the purpose well enough."
                                            },
                                            {
                                                "example_id": "2937c16e-68fb-482d-97e6-b9d389d933f0",
                                                "sense_id": "f2daf845-eeef-3269-b373-8943e9206a9e",
                                                "text": "He set the alarm on his watch to 8:00 am."
                                            },
                                            {
                                                "example_id": "c3a3202d-b6c7-4822-a400-8ee3ef544625",
                                                "sense_id": "f2daf845-eeef-3269-b373-8943e9206a9e",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb6d08d7-d366-398a-833d-4c8c730259bf",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "The act of guarding and observing someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00feeb69-024d-418c-bb70-609efc9819de",
                                                "sense_id": "eb6d08d7-d366-398a-833d-4c8c730259bf",
                                                "text": "shepherds keeping watch by night"
                                            },
                                            {
                                                "example_id": "0e66f61a-a53c-4048-961d-563e38abc00c",
                                                "sense_id": "eb6d08d7-d366-398a-833d-4c8c730259bf",
                                                "text": "All the long night their mournful watch they keep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ccb9467-ea19-325c-a079-5ee5a5806a63",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "A particular time period when guarding is kept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dff7e6-f63a-4f46-ae7a-81c23b930884",
                                                "sense_id": "4ccb9467-ea19-325c-a079-5ee5a5806a63",
                                                "text": "The second watch of the night began at midnight."
                                            },
                                            {
                                                "example_id": "fe8e3e07-5e45-4a6a-8238-5ec3325ed3e9",
                                                "sense_id": "4ccb9467-ea19-325c-a079-5ee5a5806a63",
                                                "text": "I did stand my watch upon the hill."
                                            },
                                            {
                                                "example_id": "a982fac2-e42a-4ca5-8293-5ffcb7228b2d",
                                                "sense_id": "4ccb9467-ea19-325c-a079-5ee5a5806a63",
                                                "text": "Might we but hear […]\n Or whistle from the lodge, or village cock\n Count the night watches to his feathery dames.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "f7d6124d-47a2-4b7a-85e2-b88eb13d22c6",
                                                "sense_id": "4ccb9467-ea19-325c-a079-5ee5a5806a63",
                                                "text": "In the evening a tremendous thunder storm, accompanied by wind and rain. It is my watch and I find it a terrible time to act as sentry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33da3cb5-327a-38fe-837a-2fa9caecd847",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "A period of wakefulness between the two sleeps of a biphasic sleep pattern (the dead sleep or first sleep and morning sleep or second sleep): the first waking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6327753-177a-3d8b-8c4a-aeb957702ebf",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "A person or group of people who guard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08850602-4864-4cc8-943d-86caa20c3b20",
                                                "sense_id": "f6327753-177a-3d8b-8c4a-aeb957702ebf",
                                                "text": "The watch stopped the travelers at the city gates."
                                            },
                                            {
                                                "example_id": "00155e2a-f308-4965-a5c0-c17e503e3975",
                                                "sense_id": "f6327753-177a-3d8b-8c4a-aeb957702ebf",
                                                "text": "Pilate said unto them, Ye have a watch; go your way, make it as sure as ye can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b069103-e2bc-34f7-8c89-b4f38a106ef8",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "The post or office of a watchman; also, the place where a watchman is posted, or where a guard is kept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa581c4f-a013-4df7-8e8c-2d08c65ae6e4",
                                                "sense_id": "7b069103-e2bc-34f7-8c89-b4f38a106ef8",
                                                "text": "He upbraids Iago, that he made him\n Brave me upon the watch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36562805-630e-3081-ab89-3e36357a5c29",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "A group of sailors and officers aboard a ship or shore station with a common period of duty: starboard watch, port watch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9904c35-dde2-3caf-86c0-0d33ba3cb159",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "A period of time on duty, usually four hours in length; the officers and crew who tend the working of a vessel during the same watch. (FM 55–501)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6088239-d66d-39c6-b95b-435a30544566",
                                        "entry_id": "9424efd3-f8f1-382c-8387-cedcc344c6f1",
                                        "glosses": [
                                            "The act of seeing, or viewing, for a period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c335081a-37cb-4ecb-9494-c004e6beba68",
                                                "sense_id": "b6088239-d66d-39c6-b95b-435a30544566",
                                                "text": "A quick watch of Stanley Kubrick's Clockwork Orange sends this reality home fast. Amoral, vacuous, cold-blooded, unsympathetic, and chillingly evil describe only parts of the story."
                                            },
                                            {
                                                "example_id": "7e5f1a94-da0e-4c36-acf9-02f8e8b88641",
                                                "sense_id": "b6088239-d66d-39c6-b95b-435a30544566",
                                                "text": "The first third of the film is laugh after laugh; […] But half an hour in and this movie gets unnervingly dark and is an uncomfortable watch at times."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "watch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd376cc5-d10d-3595-b066-fb1d5c948de9",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To look at, see, or view for a period of time."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7199b3cf-630e-4621-ad2d-cff1db2f1045",
                                                "sense_id": "fd376cc5-d10d-3595-b066-fb1d5c948de9",
                                                "text": "Watching the clock will not make time go faster."
                                            },
                                            {
                                                "example_id": "fa2de08a-2b65-4e81-867f-42d66658455b",
                                                "sense_id": "fd376cc5-d10d-3595-b066-fb1d5c948de9",
                                                "text": "I'm tired of watching TV."
                                            },
                                            {
                                                "example_id": "f8ff3412-29e1-40db-9edf-19f36ca66250",
                                                "sense_id": "fd376cc5-d10d-3595-b066-fb1d5c948de9",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c146258d-71bd-3063-821e-b00e8593d315",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To observe over a period of time; to notice or pay attention."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5bb6e74-2782-4e62-ba0f-3b4c76d3fcbc",
                                                "sense_id": "c146258d-71bd-3063-821e-b00e8593d315",
                                                "text": "Watch this!"
                                            },
                                            {
                                                "example_id": "03057f2e-e52b-4841-8a7c-bf832e8b9d7f",
                                                "sense_id": "c146258d-71bd-3063-821e-b00e8593d315",
                                                "text": "Put a little baking soda in some vinegar and watch what happens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7080748b-9a97-3515-a17c-dcbd0b30a7d9",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To mind, attend, or guard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06da64bf-9466-4bb6-ae48-97ee929561ab",
                                                "sense_id": "7080748b-9a97-3515-a17c-dcbd0b30a7d9",
                                                "text": "Please watch my suitcase for a minute."
                                            },
                                            {
                                                "example_id": "0dccdd8a-cf8b-4a08-93c1-6656bac945b7",
                                                "sense_id": "7080748b-9a97-3515-a17c-dcbd0b30a7d9",
                                                "text": "He has to watch the kids that afternoon."
                                            },
                                            {
                                                "example_id": "80dc096c-a51b-4fe0-aae1-eda118db82af",
                                                "sense_id": "7080748b-9a97-3515-a17c-dcbd0b30a7d9",
                                                "text": "[…] (it was the town's humour to be always gassing of phantom investors who were likely to come any moment and pay a thousand prices for everything) — “[…] Them rich fellers, they don't make no bad breaks with their money. They watch it all th' time b'cause they know blame well there ain't hardly room fer their feet fer th' pikers an' tin-horns an' thimble-riggers what are layin' fer 'em. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90abe58b-2d12-37d3-8895-b4ab2083a7a9",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To be wary or cautious of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8cae34b-c8a8-46f6-874b-5a79f152fe3c",
                                                "sense_id": "90abe58b-2d12-37d3-8895-b4ab2083a7a9",
                                                "text": "You should watch that guy. He has a reputation for lying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a334f55f-56dd-3cd2-80c3-e922d28c8983",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To attend to dangers to or regarding."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6abf79a-4da0-4aaa-8c52-294a7b5425d0",
                                                "sense_id": "a334f55f-56dd-3cd2-80c3-e922d28c8983",
                                                "text": "watch your head; watch your step"
                                            },
                                            {
                                                "example_id": "8a8ccb7d-32ee-49c5-8368-3302b317931f",
                                                "sense_id": "a334f55f-56dd-3cd2-80c3-e922d28c8983",
                                                "text": "Watch yourself when you talk to him."
                                            },
                                            {
                                                "example_id": "650370e4-afaa-4368-aeed-fc5a3214dab6",
                                                "sense_id": "a334f55f-56dd-3cd2-80c3-e922d28c8983",
                                                "text": "Watch what you say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbfa9d37-877e-3d49-8b09-9aab8ce51932",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To remain awake with a sick or dying person; to maintain a vigil."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8340261-85e8-40fe-a2d3-3ed544fb8f68",
                                                "sense_id": "fbfa9d37-877e-3d49-8b09-9aab8ce51932",
                                                "text": "At the funeralls in Yorkeshire, to this day, they continue the custome of watching & sitting-up all night till the body is interred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95c3cd2-68c6-3b5c-bff5-1d8b335b93d9",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To be vigilant or on one's guard."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a42d460-c729-4547-8cb1-fad9a0a8ba69",
                                                "sense_id": "a95c3cd2-68c6-3b5c-bff5-1d8b335b93d9",
                                                "text": "For some must watch, while some must sleep: So runs the world away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31a1fd9-014f-3c0a-9704-f8483f9bbc00",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To act as a lookout."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73a5ec71-7bda-3336-bf88-00cc318e8301",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To serve the purpose of a watchman by floating properly in its place."
                                        ],
                                        "tags": [
                                            "of a buoy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6b47487-a1aa-300b-a818-c0ebcda5f9d9",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To be awake."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2329832-c73b-4adc-983c-c4a63e54dd15",
                                                "sense_id": "b6b47487-a1aa-300b-a818-c0ebcda5f9d9",
                                                "text": "So on the morne Sir Trystram, Sir Gareth and Sir Dynadan arose early and went unto Sir Palomydes chambir, and there they founde hym faste aslepe, for he had all nyght wacched […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6befc78e-6efc-3b6c-9456-60637b4dbf54",
                                        "entry_id": "5a815f49-afaf-3a8f-9590-c7c089c57194",
                                        "glosses": [
                                            "To be on the lookout for; to wait for expectantly."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456f9214-41f3-43d1-9126-eb0e2da12e4d",
                                                "sense_id": "6befc78e-6efc-3b6c-9456-60637b4dbf54",
                                                "text": "[S]he had reason to dread that her husband had formed a very criminal project of being revenged on Zeluco, and watched an opportunity of putting it in execution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d23eaa5f-e544-4786-b36a-9464a474885d",
