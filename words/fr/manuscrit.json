            "senses": [
                {
                    "sense_id": "48f82b1f-14d0-3a4a-b221-52da056e4e05",
                    "sense_definition": "Qui est écrit à la main, par opposition à ce qui est imprimé ou saisi à l'ordinateur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ecrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a conservé une lettre <w>manuscrite</w> reçue de son grand-père il y a cinquante ans."
                        },
                        {
                            "text": "Le professeur demande une note <w>manuscrite</w> pour justifier chaque absence en cours."
