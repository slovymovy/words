                                        "entry_id": "027cb497-e97c-3766-997f-d0052039da21",
                                        "glosses": [
                                            "vierteljährliche Fastentage zur Heiligung der vier Jahreszeiten (der Mittwoch, Freitag und Samstag nach dem 3. Advents-, dem 1. Fastensonntag, in der Pfingstwoche und nach Kreuzerhöhung)"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f660f2ea-74c3-4214-a4db-a2658e7d7110",
                                                "sense_id": "80bbb1cf-9d40-3da7-b92e-b688a1aacb29",
                                                "text": "„Die liturgische Feier der Quatember endete in der Regel mit der Feier einer Vigil.“"
