                ],
                "senses": [
                    {
                        "sense_id": "821a31ec-8064-3003-9bdf-716d9d72a4d8",
                        "entry_id": "30666054-84e4-32b6-afbc-4467d9c3dfba",
                        "glosses": [
                            "Fachgebiet, das sich wissenschaftlich mit der tamilischen Sprache (Tamil) und Kultur beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f46b57-7a59-42d0-bfe8-d02eea56688d",
                                "sense_id": "821a31ec-8064-3003-9bdf-716d9d72a4d8",
                                "text": "„Die Tamilistik (Sprach- und Literaturwissenschaft des Tamil) ist in der Indologie aber nach wie vor weniger stark präsent als die Beschäftigung mit dem Sanskrit oder Hindi.“"
                            },
                            {
                                "example_id": "65c8fd25-6618-4303-9128-a5497a033dc1",
                                "sense_id": "821a31ec-8064-3003-9bdf-716d9d72a4d8",
                                "text": "Die Arbeit Dhamotharans verdient anerkennende Worte, sie vermittelt über die Titelangaben hinaus eine Reihe wertvoller Erkenntnisse sowohl zum Entwicklungsstand der Tamilistik, als auch zu den Tendenzen der südasiatischen Sprachwissenschaft."
                            },
                            {
                                "example_id": "4045ece3-623c-4f51-bc62-68cdbf2a56bd",
                                "sense_id": "821a31ec-8064-3003-9bdf-716d9d72a4d8",
                                "text": "„Professor Dr. Ulrike Niklas wurde Mitte 2006 auf den Lehrstuhl für Tamilistik in Köln berufen; sie wird für die KOHD die Fortführung der Katalogisierung von Tamilhandschriften fachlich begleiten.“"
                            },
                            {
                                "example_id": "37a52099-45b1-489d-b037-bb760b9271b1",
                                "sense_id": "821a31ec-8064-3003-9bdf-716d9d72a4d8",
                                "text": "„In diesem für die Tamilistik unentbehrlichen Werk sind Wortbedeutungen durch lediglich einfache englische Übersetzungen ohne Kontextangaben jedoch häufig unklar geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
