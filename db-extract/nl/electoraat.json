        "nl-extract.jsonl": [
            {
                "entry_id": "25c88805-a343-31b2-8cb5-601eb2f4be06",
                "word": "electoraat",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ecdc568b-b942-4abb-8b8d-65905080bbed",
                        "entry_id": "25c88805-a343-31b2-8cb5-601eb2f4be06",
                        "tags": [
                            "plural"
                        ],
                        "form": "electoraten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "301cf8b3-0211-3e0b-a410-277a17f99001",
                        "entry_id": "25c88805-a343-31b2-8cb5-601eb2f4be06",
                        "glosses": [
                            "geheel van personen die stemmen of kunnen stemmen bij een verkiezing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee594b90-30f9-429a-90f7-86c30c201f80",
                                "sense_id": "301cf8b3-0211-3e0b-a410-277a17f99001",
                                "text": "Het electoraat zal daarover een uitspraak moeten doen."
                            },
                            {
                                "example_id": "f3fd3190-90da-4c4c-b8a8-67acf0b313ca",
                                "sense_id": "301cf8b3-0211-3e0b-a410-277a17f99001",
                                "text": "Halverwege de dag (rond 14.00 uur) had in Den Haag iets meer dan 19 procent van het electoraat zijn stem uitgebracht voor de gemeenteraad."
                            },
                            {
                                "example_id": "602ad930-6eb5-4b96-adb8-10b23892816c",
                                "sense_id": "301cf8b3-0211-3e0b-a410-277a17f99001",
                                "text": "Zijn electoraat zijn vooral oudere kiezers die niet hebben geprofiteerd van de opbloei van de economie en met nostalgische gevoelens op de vroegere Sovjet-Unie terugkijken."
                            },
                            {
                                "example_id": "ace77f51-7d34-4073-814e-a214ba17d392",
                                "sense_id": "301cf8b3-0211-3e0b-a410-277a17f99001",
                                "text": "⧖ De heer Beulé heeft gister in de decentralisatiecommissie de zienswijze van het Gouvernement doen kennen over het ontwerp gemeentewet, dat door die commissie aan de Regering ter goedkeuring werd onderworpen. Tegen de vier eerste artikelen verklaarde de heer Beulé geen aanmerkingen te hebben, maar in het vijfde zou de Minister gaarne eenige wijzigingen gebragt te zien, wat betreft het electoraat en zijn voorwaarden."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f214b17-b117-3cf1-b48c-5f605a74c603",
                        "entry_id": "25c88805-a343-31b2-8cb5-601eb2f4be06",
                        "glosses": [
                            "van de 13e tot 19e eeuw elk van de Duitse vorstendommen die een stem hadden bij het aanwijzen van een keizer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6be95b15-202b-4403-a475-353f154025d8",
                                "sense_id": "4f214b17-b117-3cf1-b48c-5f605a74c603",
                                "text": "⧖ Het gerucht loopt dat een jong Reiziger van den eersten rang, thans te Hanover, eene hevige passie heeft opgevat, voor eene Princes, die hy in een van de kleine Hoven, welke dat Electoraat omringen gezien heeft (…)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7125884-e1b3-4325-afb1-ad9be05aa4f2",
                        "source_entry_id": "25c88805-a343-31b2-8cb5-601eb2f4be06",
                        "source_sense_id": "301cf8b3-0211-3e0b-a410-277a17f99001",
                        "target_lang_word": "electorate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electorate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67e02fdd-c662-3b49-b442-f284e89ce86f",
                                        "entry_id": "eaf739d6-105a-3cd3-83cd-b2f974780b7d",
                                        "glosses": [
                                            "The collective people of a country, state, or electoral district who are entitled to vote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf3fea5-4f63-4cfb-b1b4-f0656c841cc2",
                                                "sense_id": "67e02fdd-c662-3b49-b442-f284e89ce86f",
                                                "text": "The votes have been counted and the electorate has spoken."
                                            },
                                            {
                                                "example_id": "4e3e7898-7daa-4a3a-b06f-d0728572e135",
                                                "sense_id": "67e02fdd-c662-3b49-b442-f284e89ce86f",
                                                "text": "Incoming governments normally announce that they will seek to serve the whole electorate. Now, playing out in triplicate across the UK is a \"divide and rule\" approach to leadership, straight from Donald Trump's playbook: each faction consolidating its base, choosing an enemy and accusing opponents of treason in the hope that in a multiparty system they can win with a minority of votes."
                                            },
                                            {
                                                "example_id": "21f33445-cdea-4aa5-a22e-59c1a6836585",
                                                "sense_id": "67e02fdd-c662-3b49-b442-f284e89ce86f",
                                                "text": "His cerebral candidacy, inspired by European and North American political and economic philosophers, and his very appearance, with his light-colored skin, trim physique and penchant for preppy sweaters, contrasted with an electorate largely made up of impoverished Quechua-speaking people and Spanish-speaking mestizos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff5b575a-73f4-31c4-ae3f-b26d3bbc0344",
                                        "entry_id": "eaf739d6-105a-3cd3-83cd-b2f974780b7d",
                                        "glosses": [
                                            "The office, or area of dominion, of an Elector (“a German prince entitled to elect the emperor of the Holy Roman Empire”); an electorship."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f92c03de-e6d0-4a41-8184-1f7fd22c867a",
                                                "sense_id": "ff5b575a-73f4-31c4-ae3f-b26d3bbc0344",
                                                "text": "[I]n case Hanover should be attacked on the ground of a German quarrel, unconnected with English politics, we were not bound to defend her; yet, if a power at war with England should think fit to consider that electorate as part of the king's dominions, which perhaps according to the law of nations might be done, our honour must require that it should be defended against such an attack."
                                            },
                                            {
                                                "example_id": "f9d22da0-ec69-498a-9265-4b74505a087e",
                                                "sense_id": "ff5b575a-73f4-31c4-ae3f-b26d3bbc0344",
                                                "text": "The line of demarcation [between Protestantism and Roman Catholicism] ran, as it still runs, through the midst of the Netherlands, of Germany, and of Switzerland, dividing province from province, electorate from electorate, and canton from canton."
                                            },
                                            {
                                                "example_id": "ca6a4ac4-ff72-477d-be94-c87c8da02899",
                                                "sense_id": "ff5b575a-73f4-31c4-ae3f-b26d3bbc0344",
                                                "text": "[…] Brandenburg, emerging around what would become Berlin, acquired distinct status as an electorate in the mid-fourteenth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c9cd525-8821-301c-b50a-ce39feae499f",
                                        "entry_id": "eaf739d6-105a-3cd3-83cd-b2f974780b7d",
                                        "glosses": [
                                            "A geographical area represented by one or more elected officials; a constituency, an electoral district."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4e319c-83e1-4c1a-ae20-179be63bae78",
                                                "sense_id": "1c9cd525-8821-301c-b50a-ce39feae499f",
                                                "text": "The electorate of Finchley borders on the electorate of Much-Binding-in-the-Marsh, splitting the new housing estate of Royal Cupolas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
