                {
                    "sense_id": "5ffc173c-e86f-3607-9842-45781e9bb49b",
                    "sense_definition": "Qui est sujet à des changements fréquents, qui manque de constance ou de régularité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La situation politique reste très <w>instable</w> depuis plusieurs mois dans la région.",
                            "target_lang_translations": {
                                "en": "The political situation in the region has remained very <w>unstable</w> for several months.",
                                "ru": "Политическая ситуация в регионе уже несколько месяцев остаётся очень <w>нестабильной</w>.",
                                "de": "Die politische Lage in der Region bleibt seit mehreren Monaten sehr <w>instabil</w>.",
                                "es": "La situación política de la región sigue siendo muy <w>inestable</w> desde hace varios meses.",
                                "zh": "这个地区的政治局势几个月来一直非常<w>不稳定</w>。"
                            }
                        },
                        {
                            "text": "Cette météo <w>instable</w> alterne entre de belles éclaircies et de fortes averses.",
                            "target_lang_translations": {
                                "en": "This <w>unsettled</w> weather alternates between bright spells and heavy showers.",
                                "ru": "Эта <w>неустойчивая</w> погода чередует солнечные просветы с сильными ливнями.",
                                "de": "Dieses <w>wechselhafte</w> Wetter pendelt zwischen schönen Aufheiterungen und kräftigen Schauern.",
                                "es": "Este tiempo <w>inestable</w> alterna entre hermosos claros y fuertes chubascos.",
                                "zh": "这种<w>多变</w>的天气时而放晴，时而大雨倾盆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "changeant",
                        "inconstant",
                        "variable"
