                        "examples": [
                            {
                                "example_id": "1c01d9ae-9e09-4e82-855b-563af5eabd1c",
                                "sense_id": "5e13d962-dfdd-37dd-8a4e-e5c43d2e996c",
                                "text": "On further acquaintance I concluded that Mr. Spear's bruskness was assumed, and that beneath the tough husk there beats a very tender heart."
                            },
                            {
                                "example_id": "cfa94dd4-569e-4f2f-a3ac-1b909007de6c",
                                "sense_id": "5e13d962-dfdd-37dd-8a4e-e5c43d2e996c",
                                "text": "\"Why didn't you send for me at once?\" asked the older man with increasing bruskness."
                            },
                            {
                                "example_id": "8f1cbaf7-cee0-4d2f-b4ec-082408cf44ce",
                                "sense_id": "5e13d962-dfdd-37dd-8a4e-e5c43d2e996c",
                                "text": "When he had eaten, hungrily and in silence, responding to the mildly ironical sociability of his fellows with a brevity which only his soft voice saved from bruskness, he unrolled his new bed and lay down with not a thought for the part he was playing."
                            }
                        ]
                    }
