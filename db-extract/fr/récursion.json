                                "target_senses": [
                                    {
                                        "sense_id": "eca2a8a8-460e-33f8-b5fd-f5a31608a337",
                                        "entry_id": "70f4e4b1-42d6-365c-a6aa-37a09555db38",
                                        "glosses": [
                                            "eine Definition, die zur Beschreibung des Definitionsgegenstand auf sich selbst verweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60261da4-7e9b-472a-a8af-7ae3db363742",
                                                "sense_id": "eca2a8a8-460e-33f8-b5fd-f5a31608a337",
                                                "text": "Die Summe der ersten n Zahlen kann als Rekursion definiert werden: Ist n = 0, so ist sie Null, sonst ist sie die Summe der ersten (n-1) Zahlen plus n."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02cd579f-3d44-3f97-ad04-f9223fb4a712",
                                        "entry_id": "70f4e4b1-42d6-365c-a6aa-37a09555db38",
                                        "glosses": [
                                            "eine Funktion, die sich selbst aufruft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff96d181-7480-4e7b-8fdf-69bb4ac8dbaa",
                                                "sense_id": "02cd579f-3d44-3f97-ad04-f9223fb4a712",
                                                "text": "Zur Sortierung der Liste wird eine Rekursion genutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "648fa943-43f9-334e-9a50-4a95bf8104cd",
                                        "entry_id": "70f4e4b1-42d6-365c-a6aa-37a09555db38",
                                        "glosses": [
                                            "Möglichkeit, in sprachlich gefasste Gedanken weitere Gedanken einzufügen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82495623-6cd0-474a-90a0-10c0394aef68",
                                                "sense_id": "648fa943-43f9-334e-9a50-4a95bf8104cd",
                                                "text": "„Rekursion sei die Fähigkeit, die das menschliche Denken von allen anderen Kognitionsformen unterscheide ...“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d501c73-08ef-4860-b1e6-ed90ab5482a3",
                        "source_entry_id": "9ffd8256-dbb6-394c-8d2e-4f8d143a22db",
                        "source_sense_id": "8cd2c041-af88-3e64-a606-a08aa94544a2",
                        "target_lang_word": "recursion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recursion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b424937a-4246-312d-aeef-f353209788cf",
                                        "entry_id": "c6e0144e-ab9a-3840-9aaf-0b63c51cbe72",
                                        "glosses": [
                                            "The act of recurring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a2ce6bc-bd50-4cc4-8edb-358fbbd8180c",
                                                "sense_id": "b424937a-4246-312d-aeef-f353209788cf",
                                                "text": "The inhabitants predicate the recursion of these storms by numerous other signs, and are prompt to take every precaution to avoid their effects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c916f83-ecbc-3a2d-b639-86d7a1c24f4d",
                                        "entry_id": "c6e0144e-ab9a-3840-9aaf-0b63c51cbe72",
                                        "glosses": [
                                            "The act of defining an object (usually a function) in terms of that object itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e59c5ec-1531-4dd3-89fa-1c35df41d67c",
                                                "sense_id": "2c916f83-ecbc-3a2d-b639-86d7a1c24f4d",
                                                "text": "n! = n × (n − 1)! (for n > 0) or 1 (for n = 0) defines the factorial function using recursion."
                                            },
                                            {
                                                "example_id": "295dfe47-8caf-4524-bc3d-78d52c214b94",
                                                "sense_id": "2c916f83-ecbc-3a2d-b639-86d7a1c24f4d",
                                                "text": "However, we have still not achieved our goal of devising a finite set of rules which will generate an infinite set of sentence structures. In order to achieve this goal, we need to allow for the fact that natural languages typically have the property that they allow potentially infinite recursion of particular structures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9dddd9-285d-3a0f-888b-f613a4138b46",
                                        "entry_id": "c6e0144e-ab9a-3840-9aaf-0b63c51cbe72",
                                        "glosses": [
                                            "The invocation of a procedure from within itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82a39ec7-1e52-4f7e-a019-96d4764db1d6",
                                                "sense_id": "aa9dddd9-285d-3a0f-888b-f613a4138b46",
                                                "text": "This function uses recursion to compute factorials."
                                            },
                                            {
                                                "example_id": "6cac0c57-e94e-41bd-874d-2b84f00372ae",
                                                "sense_id": "aa9dddd9-285d-3a0f-888b-f613a4138b46",
                                                "text": "When an algorithm makes two recursive calls, we say that it uses binary recursion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e143fef8-a590-4a9c-a749-2d6264c9e645",
                        "source_entry_id": "9ffd8256-dbb6-394c-8d2e-4f8d143a22db",
