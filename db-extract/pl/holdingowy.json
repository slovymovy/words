                        "translation_id": "928a59fa-60be-4c70-95c8-23e0bbbcd096",
                        "source_entry_id": "b5d2064c-90b6-3b7b-b879-b46646ff6cef",
                        "source_sense_id": "f83a0190-1623-3ac8-9842-ee3e99eff33c",
                        "target_lang_word": "holding",
