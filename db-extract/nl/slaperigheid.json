                                "target_senses": [
                                    {
                                        "sense_id": "0571fc4b-bf4e-38bb-9c5e-9ab79244f6b8",
                                        "entry_id": "ff46092c-3dcd-375e-811b-205d68b27a21",
                                        "glosses": [
                                            "The characteristic of being dreamy."
                                        ],
                                        "tags": [
                                            "uncountable",
