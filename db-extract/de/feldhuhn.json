                                        "entry_id": "3e43781e-67e4-3e00-a5fd-d6af33f29338",
                                        "glosses": [
                                            "Espèce d’oiseau gallinacé, gibier, une perdrix d’Eurasie et d’Amérique du Nord, au plumage gris bleuté, ocré à brunâtre sur les ailes et les côtés de la tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "788013d8-b533-4c89-9cde-b8f88ad8f3e6",
                                                "sense_id": "a921027d-c9da-372f-9390-66cbe23ba69b",
                                                "text": "La perdrix grise a une aire de répartition si vaste avec des données climatiques si différentes qu’elle a su s’adapter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6dd11f2-8f20-4bba-ad22-fd4983c49e75",
                        "source_entry_id": "ad05d112-bd08-3652-b214-41a1bcf362db",
