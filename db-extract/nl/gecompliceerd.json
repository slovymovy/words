                "entry_id": "df136b38-a69e-3b6b-8029-7ab2ae275f4c",
                "word": "gecompliceerd",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a57d99c1-b5b9-3510-9e16-7dd91a5e05bc",
                        "entry_id": "df136b38-a69e-3b6b-8029-7ab2ae275f4c",
                        "glosses": [
                            "ingewikkeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e81441-2725-4d4d-a85e-f9ce20092384",
                                "sense_id": "a57d99c1-b5b9-3510-9e16-7dd91a5e05bc",
                                "text": "Ze zat vol tegenstrijdigheden, was ontwapenend lief maar kon ook onverwacht fel uit de hoek komen zodra iemand te dichtbij kwam of te veel van haar verwachtte. Jetfighter had een aantal gecompliceerde relaties achter de rug."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c702d9ef-e89e-406c-ac37-b1838d84016f",
                        "source_entry_id": "df136b38-a69e-3b6b-8029-7ab2ae275f4c",
                        "source_sense_id": "a57d99c1-b5b9-3510-9e16-7dd91a5e05bc",
                        "source_sense_description": "ingewikkeld",
                        "target_lang_word": "kompliziert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kompliziert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d81c34c-c7db-3fe7-af27-3982a7cc9413",
                                        "entry_id": "e8764674-8200-3298-ab40-c731907b2ac5",
                                        "glosses": [
                                            "umständlich, undurchschaubar, schwierig, verzwickt, verstrickt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad5bdf57-2ed3-4023-91f6-8aaad580bd41",
                                                "sense_id": "0d81c34c-c7db-3fe7-af27-3982a7cc9413",
                                                "text": "Er hat den Weg ziemlich kompliziert beschrieben, aber es hätte genügt, wenn er gesagt hätte: \"Folgt den Wegweisern, denn es ist gut ausgeschildert!\"."
                                            },
                                            {
                                                "example_id": "cec43050-f16d-4dc2-b0be-40b594a44d1c",
                                                "sense_id": "0d81c34c-c7db-3fe7-af27-3982a7cc9413",
                                                "text": "Das Verfahren ist noch etwas kompliziert und deswegen nicht so effizient, wie es sein könnte."
                                            },
                                            {
                                                "example_id": "9714548e-e80a-4971-81ea-8aaa6cea7336",
                                                "sense_id": "0d81c34c-c7db-3fe7-af27-3982a7cc9413",
                                                "text": "Die Beziehung meiner Eltern ist echt kompliziert, da mische ich mich lieber nicht ein."
                                            },
                                            {
                                                "example_id": "0c3869cd-2022-451f-9002-1713c0392c24",
                                                "sense_id": "0d81c34c-c7db-3fe7-af27-3982a7cc9413",
                                                "text": "Die Einsteinsche Relativitätstheorie ist mir zu kompliziert."
                                            },
                                            {
                                                "example_id": "f5a9b611-f61e-4b01-b8e2-9fd5d47d9ecd",
                                                "sense_id": "0d81c34c-c7db-3fe7-af27-3982a7cc9413",
                                                "text": "Das Geozentrische Weltbild des Ptolemäus ist komplizierter als das Heliozentrische Weltbild des Kopernikus."
                                            },
                                            {
                                                "example_id": "3105a1ba-1f3d-4cb9-b272-b3255bda6ad3",
                                                "sense_id": "0d81c34c-c7db-3fe7-af27-3982a7cc9413",
                                                "text": "„Die wirkliche Bahn des Mondes ist außerordentlich kompliziert, da er sich mit der Erde um die Sonne bewegt und auch unser Sonnensystem als Ganzes nicht ruht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
