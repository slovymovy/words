                "senses": [
                    {
                        "sense_id": "ead0813c-a8ee-3055-a3c1-d1b5b4fa2342",
                        "entry_id": "e23e90c7-b19d-3dfa-848b-412d017bc620",
                        "glosses": [
                            "To take away; remove; deprive."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "924d56a7-2fe5-4838-8b67-6ad27d93f2dc",
                                "sense_id": "ead0813c-a8ee-3055-a3c1-d1b5b4fa2342",
                                "text": "Be ye not willing to hoard to you gold hoards on earth, where rust and moth fortake it, and where thieves delve it and forsteal, [...]"
                            },
                            {
                                "example_id": "9cbd9292-7b73-427c-9ff7-e0fc6fb5033d",
                                "sense_id": "ead0813c-a8ee-3055-a3c1-d1b5b4fa2342",
                                "text": "In a slaughter wide they fell, woeful days of Bale came on; Famine-death fortook fortitude from men!"
                            }
                        ]
                    },
                    {
                        "sense_id": "bb1477f5-df24-360e-914a-33096d00b2b3",
                        "entry_id": "e23e90c7-b19d-3dfa-848b-412d017bc620",
