                "senses": [
                    {
                        "sense_id": "0972df83-86b2-3770-8c5e-81dc86e92339",
                        "entry_id": "567babae-c4e6-334c-81fd-9fd70f00f163",
                        "glosses": [
                            "Cabine automatique de photographie d'identité à développement instantané, installées dans les gares, le métro, les centres commerciaux ou les administrations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9169d4-92a1-4ae7-bb38-24c0c42e2556",
                                "sense_id": "0972df83-86b2-3770-8c5e-81dc86e92339",
                                "text": "Voilà comment ils procédaient, sans exception, tous ces soi-disant grands photographes, Jed en connaissait quelques-uns personnellement et n’avait pour eux que mépris, il les considérait tous autant qu’ils étaient comme à peu près aussi créatifs qu’un Photomaton."
                            },
                            {
                                "example_id": "8def1633-f20d-4314-bef3-a3bb16e5e6de",
                                "sense_id": "0972df83-86b2-3770-8c5e-81dc86e92339",
                                "text": "Cette réflexion qui mène le duo d’un photomaton, à une fête d’étudiants, sur les bords de Seine, puis dans un club libertin touche par sa tendresse."
                            }
                        ]
                    },
                    {
                        "sense_id": "70c2b06d-77e4-32c5-83fe-64a986ed6cb6",
                        "entry_id": "567babae-c4e6-334c-81fd-9fd70f00f163",
                        "glosses": [
                            "Photo d’identité obtenue avec cet appareil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b31a495-cf36-4c9b-93ec-8e7ce9646efb",
                                "sense_id": "70c2b06d-77e4-32c5-83fe-64a986ed6cb6",
                                "text": "Quarante ans plus tard, quand l’agrandissement de la (sic) photomaton lui tomberait entre les mains, il ne saurait même plus que c’était lui, cet enfant-là."
                            }
                        ]
                    }
                ],
