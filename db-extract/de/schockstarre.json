                "senses": [
                    {
                        "sense_id": "ff0de378-d6a2-370f-a4f3-2ad69e1881aa",
                        "entry_id": "9becc935-191f-3bb8-ac79-27e58af3eff8",
                        "glosses": [
                            "durch einen Schock ausgelöste Unbeweglichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc38c74e-041e-4d93-b63e-304a099e8eb0",
                                "sense_id": "ff0de378-d6a2-370f-a4f3-2ad69e1881aa",
                                "text": "„Basler Hirnforscher haben bei Mäusen herausgefunden, wie Furcht vom Gehirn bis in die Muskeln wirken und Schockstarre auslösen kann.“"
                            },
                            {
                                "example_id": "1dfb3de0-5da9-4207-ba38-8ead7633b7a1",
                                "sense_id": "ff0de378-d6a2-370f-a4f3-2ad69e1881aa",
                                "text": "„Der Krach vorbeifahrender Boote versetzt die Beutetiere demnach in eine Art Schockstarre, und sie versuchen gar nicht erst, näher kommenden Räubern davonzuschwimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2b38c11d-7b1e-342e-a363-e3672cbb7341",
                        "entry_id": "9becc935-191f-3bb8-ac79-27e58af3eff8",
                        "glosses": [
                            "Handlungsunfähigkeit, die durch Erschrecken ausgelöst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "672fe4f3-7e9b-4d40-9257-2dd28e7f29ed",
                                "sense_id": "2b38c11d-7b1e-342e-a363-e3672cbb7341",
                                "text": "„Kein Wunder, dass die Welt in eine Art diplomatische Schockstarre gefallen ist.“"
                            },
                            {
                                "example_id": "a40fc4dc-9c45-45c1-b9c7-cdaf65d82428",
                                "sense_id": "2b38c11d-7b1e-342e-a363-e3672cbb7341",
                                "text": "„Im Landratsamt sitzen die Kommunalpolitiker ihrer Partei wie in Schockstarre an den Tischen.“"
                            },
                            {
                                "example_id": "71fa7f84-d28e-493e-8437-8c5a27e17999",
                                "sense_id": "2b38c11d-7b1e-342e-a363-e3672cbb7341",
                                "text": "„Es ist nicht verwunderlich, wenn viele da erst einmal in eine Schockstarre verfallen und versuchen, Aktivitäten und Kosten zu reduzieren, bis sie mehr Gewissheit haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
