                                        "entry_id": "d171e9d4-db4f-3647-9e9d-52bd68f6751d",
                                        "glosses": [
                                            "Reconnaissance des individus à partir de leurs caractères biologiques spécifiques : empreintes digitales, iris de l’œil, voix, démarche, odeur corporelle, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb879c64-5156-4768-85ec-163d00f8cfbd",
                                                "sense_id": "27ddb276-b387-342f-919a-dbd248273d6c",
                                                "text": "La biométrie en temps réel est interdite en Europe, rappelle pourtant Adrien Basdevant, avocat spécialiste du numérique."
                                            },
                                            {
                                                "example_id": "2743336a-0be1-4751-8bfe-b43a3ecb556a",
                                                "sense_id": "27ddb276-b387-342f-919a-dbd248273d6c",
                                                "text": "Au collège Joliment de Toulouse, pour manger à la cantine, à partir de cette rentrée, c’est soit biométrie, soit carte à l’ancienne."
                                            }
                                        ]
                                    }
