    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee080504-c026-3a1e-8693-f8cdde673eef",
                    "sense_definition": "Het samengaan van twee of meer bedrijven of organisaties tot één nieuwe eenheid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "samensmelting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>fusie</w> tussen de twee banken zorgde voor veel onrust onder het personeel.",
                            "target_lang_translations": {
                                "en": "The <w>merger</w> between the two banks caused a lot of unrest among the staff."
                            }
                        },
                        {
                            "text": "Na een lange onderhandeling werd de <w>fusie</w> eindelijk officieel bekendgemaakt.",
                            "target_lang_translations": {
                                "en": "After a long negotiation, the <w>merger</w> was finally officially announced."
                            }
                        }
                    ],
                    "synonyms": [
                        "aaneensluiting"
                    ],
                    "antonyms": [
                        "opsplitsing"
                    ],
                    "common_phrases": [
                        "een fusie aangaan",
                        "de fusie tussen"
                    ],
                    "target_lang_definitions": {
                        "en": "The merging of two or more companies or organizations into a single new entity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "merger",
                                "target_lang_sense_clarification": "business and organizational context"
                            },
                            {
                                "target_lang_word": "amalgamation",
                                "target_lang_sense_clarification": "formal joining of organizations"
                            },
                            {
                                "target_lang_word": "fusion",
                                "target_lang_sense_clarification": "the act of merging separate things"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac698438-b9df-3097-8cc2-84fef60eee99",
                    "sense_definition": "Een algemene versmelting of combinatie van verschillende elementen of delen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "samensmelting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn muziekstijl is een interessante <w>fusie</w> van jazz en klassieke elementen.",
                            "target_lang_translations": {
                                "en": "His musical style is an interesting <w>fusion</w> of jazz and classical elements."
                            }
                        },
                        {
                            "text": "In de kern van de zon vindt voortdurend nucleaire <w>fusie</w> plaats.",
                            "target_lang_translations": {
                                "en": "Nuclear <w>fusion</w> is constantly taking place in the core of the sun."
                            }
                        }
                    ],
                    "synonyms": [
                        "aaneensluiting"
                    ],
                    "common_phrases": [
                        "een fusie van",
                        "nucleaire fusie"
                    ],
                    "target_lang_definitions": {
                        "en": "A general blending or combination of different elements, parts, or scientific particles."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fusion",
                                "target_lang_sense_clarification": "blending of styles, elements, or nuclear particles"
                            },
                            {
                                "target_lang_word": "blend",
                                "target_lang_sense_clarification": "a mixture of different things"
                            },
                            {
                                "target_lang_word": "combination",
                                "target_lang_sense_clarification": "joining different parts together"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44465a95-55a8-3d54-bc54-df89391f86a1",
                    "sense_definition": "Een fakkel die door de brandweer wordt gebruikt om vegetatie opzettelijk te verbranden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brandweerman gebruikte een <w>fusie</w> om een tegenvuur te creëren.",
                            "target_lang_translations": {
                                "en": "The firefighter used a <w>drip torch</w> to create a backfire."
                            }
                        },
                        {
                            "text": "Zonder de juiste <w>fusie</w> was het lastig om het droge gras gecontroleerd aan te steken.",
                            "target_lang_translations": {
                                "en": "Without the right <w>fusee</w>, it was difficult to light the dry grass in a controlled manner."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specifiek jargon in bepaalde regio's of korpsen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A torch used by firefighters to intentionally burn vegetation for fire control."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drip torch",
