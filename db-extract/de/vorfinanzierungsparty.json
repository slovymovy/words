                "senses": [
                    {
                        "sense_id": "ed9a32bd-1042-3878-83c4-f1e82b0945be",
                        "entry_id": "5a2e295c-8c14-392b-94c8-dc13fc01156c",
                        "glosses": [
                            "meist von Schülern/Studenten organisierte Veranstaltung zur Beschaffung von Mitteln, um mit dem Abschluss verbundene Aufwendungen finanzieren zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba74feb6-2acd-4874-9796-e24052cdadda",
                                "sense_id": "ed9a32bd-1042-3878-83c4-f1e82b0945be",
                                "text": "„Seit vier Jahren kocht das Thema pünktlich zum Abitur hoch. Oft mit emotionalen Zwischentönen. Das alte Kempter Sportheim nutzten Vorfinanzierungspartys („Vofis“) als Kompromiss.“"
                            },
                            {
                                "example_id": "c414062f-534d-4b21-9030-fcfa9f33ea01",
                                "sense_id": "ed9a32bd-1042-3878-83c4-f1e82b0945be",
                                "text": "„Eine sogenannte Vorfinanzierungsparty in der Mensa der TU Darmstadt in der Petersenstraße wurde am Dienstagabend vom Veranstalter abgebrochen.“"
                            },
                            {
                                "example_id": "ccbb8883-8725-4b6f-a0c9-bc52040d488b",
                                "sense_id": "ed9a32bd-1042-3878-83c4-f1e82b0945be",
                                "text": "„Früher beim Abitur habe ich mal versucht, diese Vorfinanzierungspartys zu organisieren.“"
                            },
                            {
                                "example_id": "e648ad11-e1c2-4faa-ba0e-6e9f695180ad",
                                "sense_id": "ed9a32bd-1042-3878-83c4-f1e82b0945be",
                                "text": "„Irgendjemand muss ja den Abiball, die Abizeitung, Vorfinanzierungspartys und den ganzen Rest organisieren und durchführen.“"
                            },
                            {
                                "example_id": "18b467cc-1971-4eb3-932b-cd0040f2b28f",
                                "sense_id": "ed9a32bd-1042-3878-83c4-f1e82b0945be",
                                "text": "„Was die Einnahmen betrifft, so müssen diese von den Produktionskosten abgezogen werden. Ihr könnt Einnahmen aus Vorfinanzierungspartys oder Werbeverträgen erzielen.“"
                            },
                            {
                                "example_id": "58092d19-c6ba-4c22-bc5d-b164f54aef0e",
                                "sense_id": "ed9a32bd-1042-3878-83c4-f1e82b0945be",
                                "text": "„Rund 800 Partygäste waren im an der Füchteler Mühle, wo die Jahrgangsstufe 12 eine Vorfinanzierungsparty für den Abiball veranstaltete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
