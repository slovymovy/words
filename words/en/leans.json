            "senses": [
                {
                    "sense_id": "1e0d9cc3-266d-324a-a25a-e19362145f7a",
                    "sense_definition": "Third-person singular simple present indicative form of <w>lean</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning he waits by the gate and <w>leans</w> against the wooden fence.",
                            "target_lang_translations": {
                                "ru": "Каждое утро он ждет у ворот и <w>прислоняется</w> к деревянному забору."
                            }
                        },
                        {
                            "text": "She <w>leans</w> toward the microphone whenever she wants to make an important point.",
                            "target_lang_translations": {
                                "ru": "Она <w>наклоняется</w> к микрофону каждый раз, когда хочет подчеркнуть важную мысль."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leans against",
                        "leans forward",
                        "leans toward"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа настоящего времени от глагола lean (опираться, наклоняться, прислоняться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прислоняется",
                                "target_lang_sense_clarification": "к чему-либо для опоры"
                            },
                            {
                                "target_lang_word": "наклоняется",
                                "target_lang_sense_clarification": "в какую-либо сторону"
                            },
                            {
                                "target_lang_word": "опирается",
                                "target_lang_sense_clarification": "на опору или стену"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a885efe4-1cdb-3bdb-afdd-e65559d0edf1",
                    "sense_definition": "Plural of <w>lean</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect measured the slight <w>leans</w> of the old support columns.",
                            "target_lang_translations": {
                                "ru": "Архитектор измерил небольшие <w>наклоны</w> старых опорных колонн."
                            }
                        },
                        {
                            "text": "He noticed several distinct <w>leans</w> in the fence posts after the winter storm.",
                            "target_lang_translations": {
                                "ru": "После зимней бури он заметил явный <w>крен</w> у нескольких столбов забора."
                            }
