                        "examples": [
                            {
                                "example_id": "c295eff2-0796-404b-b52d-078f78904755",
                                "sense_id": "e33cb0fd-945c-3a74-88ef-f2a0304f9e71",
                                "text": "Smith kreeg de generaalsster van haar vrouw, met wie ze vorig jaar trouwde, op een erebegraafplaats dichtbij Washington DC. Een andere ster werd door haar vader op haar uniform gespeld."
                            },
                            {
                                "example_id": "0cef4cdb-d3ef-4a53-a650-32fddb2842ea",
                                "sense_id": "e33cb0fd-945c-3a74-88ef-f2a0304f9e71",
                                "text": "Zoals elk jaar op 11 juli, worden de stoffelijke overschotten van de slachtoffers die de afgelopen twaalf maanden zijn geïdentificeerd, een herbegrafenis op de begraafplaats van Potocari, bij Srebrenica. De erebegraafplaats ligt pal naast de fabriek waar het hoofdkwartier was gevestigd van Dutchbat."
                            }
                        ]
