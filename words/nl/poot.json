                {
                    "sense_id": "316069e3-9fde-375e-8759-21bef83ea4be",
                    "sense_definition": "Afgesneden deel van een plant dat weer tot een nieuwe plant kan uitgroeien.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt deze plant vermeerderen door een <w>poot</w> in water te zetten.",
                            "target_lang_translations": {
                                "en": "You can propagate this plant by putting a <w>cutting</w> in water.",
                                "ru": "Можно размножить это растение, поставив <w>черенок</w> в воду.",
                                "pl": "Możesz rozmnożyć tę roślinę, wkładając <w>sadzonkę</w> do wody.",
                                "de": "Du kannst diese Pflanze vermehren, indem du einen <w>Steckling</w> in Wasser stellst.",
                                "fr": "Tu peux multiplier cette plante en mettant une <w>bouture</w> dans l'eau.",
                                "it": "Puoi moltiplicare questa pianta mettendo una <w>talea</w> in acqua.",
                                "cs": "Tuto rostlinu můžeš množit tak, že dáš <w>řízek</w> do vody.",
                                "tr": "Bu bitkiyi bir <w>çeliği</w> suya koyarak çoğaltabilirsin.",
                                "es": "Puedes propagar esta planta poniendo un <w>esqueje</w> en agua.",
                                "zh": "你可以把这株植物的<w>插条</w>放在水里来繁殖它。"
                            }
                        },
                        {
                            "text": "De tuinman plantte de <w>poot</w> voorzichtig in de aarde.",
                            "target_lang_translations": {
                                "en": "The gardener planted the <w>cutting</w> carefully in the soil.",
                                "ru": "Садовник осторожно посадил <w>черенок</w> в землю.",
                                "pl": "Ogrodnik ostrożnie posadził <w>sadzonkę</w> w ziemi.",
                                "de": "Der Gärtner pflanzte den <w>Steckling</w> vorsichtig in die Erde.",
                                "fr": "Le jardinier a planté la <w>bouture</w> délicatement dans la terre.",
                                "it": "Il giardiniere ha piantato con cura la <w>talea</w> nel terreno.",
                                "cs": "Zahradník opatrně zasadil <w>sazenici</w> do země.",
                                "tr": "Bahçıvan <w>fideyi</w> dikkatlice toprağa dikti.",
                                "es": "El jardinero plantó el <w>esqueje</w> cuidadosamente en la tierra.",
                                "zh": "园丁小心翼翼地把<w>幼苗</w>种进土里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stek",
                        "loot"
                    ],
                    "target_lang_definitions": {
                        "en": "Cut part of a plant that can grow into a new plant.",
                        "ru": "Срезанная часть растения, пригодная для посадки и выращивания нового растения.",
                        "pl": "Część rośliny przeznaczona do sadzenia, z której wyrośnie nowa roślina.",
                        "de": "Abgeschnittenes Teil einer Pflanze, das zu einer neuen Pflanze heranwachsen kann.",
