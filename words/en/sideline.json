                    ]
                },
                {
                    "sense_id": "b82416d6-9364-35e5-bbfe-67e0b268d481",
                    "sense_definition": "The area outside the playing field beyond the boundary lines.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach stood on the <w>sidelines</w> and shouted instructions to the team."
                        },
                        {
                            "text": "Injured players often watch the game from the <w>sidelines</w>."
                        }
                    ],
                    "common_phrases": [
