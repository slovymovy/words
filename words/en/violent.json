{
    "word_family": [
        "violence",
        "violently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2accf6ba-b303-3500-a5fd-87d4c11a1620",
                    "sense_definition": "Involving physical conflict or aggression.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protest started peacefully but became <w>violent</w> later in the day.",
                            "target_lang_translations": {
                                "ru": "Протест начался мирно, но позже принял <w>наси́льственный</w> характер.",
                                "zh": "抗议活动开始时很和平，但当天晚些时候变得<w>暴力</w>起来。"
                            }
                        },
                        {
                            "text": "They decided to use <w>violent</w> means to achieve their political goals.",
                            "target_lang_translations": {
                                "ru": "Они решили использовать <w>наси́льственные</w> методы для достижения своих политических целей.",
                                "zh": "他们决定使用<w>暴力</w>手段来实现其政治目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aggressive",
                        "brutal",
                        "fierce"
                    ],
                    "antonyms": [
                        "peaceful"
                    ],
                    "common_phrases": [
                        "violent crime",
                        "violent conflict",
                        "violent behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с физическим конфликтом или агрессией",
                        "zh": "涉及身体冲突或侵略行为的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наси́льственный",
                                "target_lang_sense_clarification": "связанный с применением силы"
                            },
                            {
                                "target_lang_word": "ожесточённый",
                                "target_lang_sense_clarification": "о конфликтах или спорах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴力",
                                "target_lang_sense_clarification": "指涉及武力或伤害的行为"
                            },
                            {
                                "target_lang_word": "激烈",
                                "target_lang_sense_clarification": "指冲突或争论的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4e9625e-8a29-34b0-8f8e-0ffaa97f9e78",
                    "sense_definition": "Likely to use physical force to hurt others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police warned the public that the escaped prisoner is armed and <w>violent</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция предупредила общественность, что сбежавший заключённый вооружён и <w>скло́нен к наси́лию</w>.",
                                "zh": "警方警告公众，逃犯持有武器且具有<w>暴力</w>倾向。"
                            }
                        },
                        {
                            "text": "She was afraid to leave her <w>violent</w> husband.",
                            "target_lang_translations": {
                                "ru": "Она боялась уйти от своего <w>жесто́кого</w> мужа.",
                                "zh": "她不敢离开她那<w>残暴</w>的丈夫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aggressive",
                        "dangerous",
                        "vicious"
                    ],
                    "antonyms": [
                        "peaceful"
                    ],
                    "common_phrases": [
                        "violent criminal",
                        "violent man",
                        "violent temper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к применению физической силы для причинения вреда",
                        "zh": "可能使用武力伤害他人的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жесто́кий",
                                "target_lang_sense_clarification": "причиняющий боль и страдания"
                            },
                            {
                                "target_lang_word": "агресси́вный",
                                "target_lang_sense_clarification": "враждебный, склонный к нападению"
                            },
                            {
                                "target_lang_word": "бу́йный",
                                "target_lang_sense_clarification": "неуправляемый, склонный к дебошу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴力",
                                "target_lang_sense_clarification": "形容人具有攻击性或倾向于使用武力"
                            },
                            {
                                "target_lang_word": "残暴",
                                "target_lang_sense_clarification": "指性格凶狠、残忍"
                            },
                            {
                                "target_lang_word": "暴躁",
                                "target_lang_sense_clarification": "指脾气急躁且易动武"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea8a9136-4baf-3954-b4f1-39e65b765b6f",
                    "sense_definition": "Involving extreme force or uncontrolled motion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "natural_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>violent</w> wind ripped the heavy branch from the old tree.",
                            "target_lang_translations": {
                                "ru": "<w>Неи́стовый</w> ветер сорвал тяжёлую ветку со старого дерева.",
                                "zh": "<w>猛烈</w>的狂风将那根粗壮的树枝从老树上扯了下来。"
                            }
                        },
                        {
                            "text": "The ship was tossed around by the <w>violent</w> waves during the storm.",
                            "target_lang_translations": {
                                "ru": "Корабль швыряло <w>я́ростными</w> волнами во время шторма.",
                                "zh": "暴风雨中，船只被<w>剧烈</w>的海浪抛来抛去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "powerful",
                        "destructive",
                        "strong"
                    ],
                    "common_phrases": [
                        "violent storm",
                        "violent shaking",
                        "violent earthquake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий огромной силой или неконтролируемым движением",
                        "zh": "涉及极大的力量或不受控制的运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неи́стовый",
                                "target_lang_sense_clarification": "о стихии или чувствах"
                            },
                            {
                                "target_lang_word": "си́льный",
                                "target_lang_sense_clarification": "обладающий большой мощью"
                            },
                            {
                                "target_lang_word": "мо́щный",
                                "target_lang_sense_clarification": "производящий сильное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛烈",
                                "target_lang_sense_clarification": "形容力量大、动作急"
                            },
                            {
                                "target_lang_word": "剧烈",
                                "target_lang_sense_clarification": "形容程度深、强度大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84d116a3-4f46-3296-8b2b-a2aea7c1e646",
                    "sense_definition": "Intensely vivid, extreme, or sharp in effect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist expressed his emotions through <w>violent</w> colors like bright red and orange.",
                            "target_lang_translations": {
                                "ru": "Художник выражал свои эмоции через <w>я́ркие</w> цвета, такие как ярко-красный и оранжевый.",
                                "zh": "艺术家通过鲜红和橙色等<w>强烈</w>的色彩来表达他的情感。"
                            }
                        },
                        {
                            "text": "There is a <w>violent</w> contrast between the rich and poor areas of the city.",
                            "target_lang_translations": {
                                "ru": "Существует <w>ре́зкий</w> контраст между богатыми и бедными районами города.",
                                "zh": "这座城市的贫富地区之间存在着<w>强烈</w>的对比。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intense",
                        "vivid",
                        "sharp"
                    ],
                    "common_phrases": [
                        "violent colors",
                        "violent contrast",
                        "violent dislike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно яркий, резкий или сильный по воздействию",
                        "zh": "极其鲜明、极端或效果强烈的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ре́зкий",
                                "target_lang_sense_clarification": "о контрасте или перемене"
                            },
                            {
                                "target_lang_word": "я́ркий",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强烈",
                                "target_lang_sense_clarification": "指效果或对比显著"
                            },
                            {
                                "target_lang_word": "刺眼",
                                "target_lang_sense_clarification": "指颜色或光线过于强烈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f50b4fb-7b87-38f9-a2fc-a257976bb883",
                    "sense_definition": "Produced or effected by force; not spontaneous; unnatural.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literary_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These <w>violent</w> delights have <w>violent</w> ends.",
                            "target_lang_translations": {
                                "ru": "У этих <w>бу́рных</w> наслаждений — <w>неи́стовый</w> конец.",
                                "zh": "这些<w>狂暴</w>的欢愉，终将有<w>惨烈</w>的结局。"
                            }
                        },
                        {
                            "text": "The sudden silence felt <w>violent</w> and unnatural after the loud noise.",
                            "target_lang_translations": {
                                "ru": "Внезапная тишина казалась <w>наси́льственной</w> и неестественной после громкого шума.",
                                "zh": "在巨大的噪音之后，这突如其来的寂静显得<w>生硬</w>且不自然。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызванный силой; неестественный; неспонтанный",
                        "zh": "由外力产生；非自发的；不自然的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бу́рный",
                                "target_lang_sense_clarification": "стремительный и сильный"
                            },
                            {
                                "target_lang_word": "наси́льственный",
                                "target_lang_sense_clarification": "неестественный, принужденный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强迫",
                                "target_lang_sense_clarification": "指非自愿的、被施加的"
                            },
                            {
                                "target_lang_word": "生硬",
                                "target_lang_sense_clarification": "指不自然、不流畅"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9df39159-09d2-3cda-b5d5-f14656904221",
                    "sense_definition": "An assailant or attacker.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>violents</w> tried to take the city by force.",
                            "target_lang_translations": {
                                "ru": "<w>Захва́тчики</w> пытались взять город силой.",
                                "zh": "<w>侵略者</w>试图通过武力夺取这座城市。"
                            }
                        },
                        {
                            "text": "He defended himself against the <w>violents</w> who ambushed him.",
                            "target_lang_translations": {
                                "ru": "Он защищался от <w>напада́вших</w>, которые устроили ему засаду.",
                                "zh": "他奋力反抗那些伏击他的<w>袭击者</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete usage found in older texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нападающий или агрессор",
                        "zh": "袭击者或攻击者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напада́ющий",
                                "target_lang_sense_clarification": "тот, кто совершает атаку"
                            },
                            {
                                "target_lang_word": "захва́тчик",
                                "target_lang_sense_clarification": "тот, кто захватывает силой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "袭击者",
                                "target_lang_sense_clarification": "指发动攻击的人"
                            },
                            {
                                "target_lang_word": "侵略者",
                                "target_lang_sense_clarification": "指通过武力进行掠夺或占领的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19b4ccf8-e0d5-3b2f-918d-27ed3ed70123",
                    "sense_definition": "To urge or act with violence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry crowd <w>violented</w> the gates of the palace.",
                            "target_lang_translations": {
                                "ru": "Разъярённая толпа <w>штурмова́ла</w> ворота дворца.",
                                "zh": "愤怒的人群<w>强攻</w>了宫殿的大门。"
                            }
                        },
                        {
                            "text": "He <w>violented</w> his way through the opposing army.",
                            "target_lang_translations": {
                                "ru": "Он <w>пробива́лся</w> сквозь вражескую армию.",
                                "zh": "他<w>硬闯</w>穿过了敌军的防线。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать с применением насилия",
                        "zh": "以暴力方式行事或催促。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штурмова́ть",
                                "target_lang_sense_clarification": "атаковать укрепление"
                            },
                            {
                                "target_lang_word": "пробива́ться",
                                "target_lang_sense_clarification": "идти напролом с силой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强攻",
                                "target_lang_sense_clarification": "指用武力强行进攻"
                            },
                            {
                                "target_lang_word": "硬闯",
                                "target_lang_sense_clarification": "指不顾阻拦强行通过"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}