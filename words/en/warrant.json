{
    "word_family": [
        "warranty",
        "warrantee",
        "warrantor",
        "warrantable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5f5b08c-a5e4-3268-b09b-7270b69059a7",
                    "sense_definition": "A judicial writ authorizing an officer to make a search, seizure, or arrest, or to execute a judgment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal authorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrived at the suspect's house with a search <w>warrant</w> signed by the judge.",
                            "target_lang_translations": {
                                "ru": "Полиция прибыла к дому подозреваемого с <w>ордером</w> на обыск, подписанным судьей."
                            }
                        },
                        {
                            "text": "A <w>warrant</w> for his arrest was issued after he failed to appear in court for the third time.",
                            "target_lang_translations": {
                                "ru": "<w>Ордер</w> на его арест был выдан после того, как он в третий раз не явился в суд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "arrest warrant",
                        "search warrant",
                        "issue a warrant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Судебный приказ, разрешающий должностному лицу производить обыск, изъятие или арест."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ордер",
                                "target_lang_sense_clarification": "на арест или обыск"
                            },
                            {
                                "target_lang_word": "предписание",
                                "target_lang_sense_clarification": "судебное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eebd9f68-446c-3a7a-abf0-e37cdf28894d",
                    "sense_definition": "Official authorization or certification; a sanction given by a superior or authority.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal authorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal <w>warrant</w> allowed the company to supply goods directly to the palace.",
                            "target_lang_translations": {
                                "ru": "Королевское <w>разрешение</w> позволяло компании поставлять товары напрямую во дворец."
                            }
                        },
                        {
                            "text": "He acted without the <w>warrant</w> of his superiors and was later disciplined for his behavior.",
                            "target_lang_translations": {
                                "ru": "Он действовал без <w>санкции</w> своего начальства и позже был наказан за свое поведение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "royal warrant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное разрешение или сертификация; санкция, данная вышестоящим лицом или органом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полномочие",
                                "target_lang_sense_clarification": "право на совершение действий"
                            },
                            {
                                "target_lang_word": "мандат",
                                "target_lang_sense_clarification": "документ, удостоверяющий права"
                            },
                            {
                                "target_lang_word": "санкция",
                                "target_lang_sense_clarification": "официальное разрешение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80730993-d8c4-317b-a84e-723b797de53d",
                    "sense_definition": "Something that provides assurance or confirmation; a guarantee or proof.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "assurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high quality of his previous work is a <w>warrant</w> for his future success in this role.",
                            "target_lang_translations": {
                                "ru": "Высокое качество его предыдущей работы является <w>залогом</w> его будущего успеха в этой должности."
                            }
                        },
                        {
                            "text": "The museum provided a <w>warrant</w> of authenticity for the ancient artifact.",
                            "target_lang_translations": {
                                "ru": "Музей предоставил <w>подтверждение</w> подлинности древнего артефакта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warrant of authenticity"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что дает уверенность или подтверждение; гарантия или доказательство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарантия",
                                "target_lang_sense_clarification": "залог успеха или качества"
                            },
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "доказательство чего-либо"
                            },
                            {
                                "target_lang_word": "залог",
                                "target_lang_sense_clarification": "обеспечение уверенности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dabe65c-d359-36dd-999b-0fad7c4d5455",
                    "sense_definition": "A financial security that offers the holder the right to purchase stock from the issuer at a specific price within a certain time frame.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company issued a <w>warrant</w> to purchase the same principal amount of bonds at a fixed rate.",
                            "target_lang_translations": {
                                "ru": "Компания выпустила <w>варрант</w> на покупку облигаций на ту же основную сумму по фиксированной ставке."
                            }
                        },
                        {
                            "text": "Investors often trade a <w>warrant</w> separately from the bond it was originally attached to.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто торгуют <w>варрантом</w> отдельно от облигации, к которой он изначально был прикреплен."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stock warrant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценная бумага, дающая право на покупку акций эмитента по определенной цене в течение установленного срока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варрант",
                                "target_lang_sense_clarification": "финансовый инструмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d19a5a44-c4f8-382a-b30f-0ed1c7e4a8db",
                    "sense_definition": "A certificate of appointment given to a <w>warrant officer</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of service, he finally received his <w>warrant</w> and became a junior officer.",
                            "target_lang_translations": {
                                "ru": "После многих лет службы он наконец получил свое <w>удостоверение</w> и стал младшим офицером."
                            }
                        },
                        {
                            "text": "The captain told him to take up his <w>warrant</w> for the new ship immediately.",
                            "target_lang_translations": {
                                "ru": "Капитан велел ему немедленно принять <w>назначение</w> на новый корабль."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свидетельство о назначении на должность, выдаваемое уорент-офицеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патент",
                                "target_lang_sense_clarification": "на офицерское звание"
                            },
                            {
                                "target_lang_word": "удостоверение",
                                "target_lang_sense_clarification": "о присвоении чина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9347f200-e7ab-3688-bdcf-09648407b2d0",
                    "sense_definition": "A document certifying that a motor vehicle meets certain standards of mechanical soundness and safety.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle safety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old car routinely failed its <w>warrant</w> because the brakes were in poor condition.",
                            "target_lang_translations": {
                                "ru": "Старая машина постоянно не проходила <w>техосмотр</w>, потому что тормоза были в плохом состоянии."
                            }
                        },
                        {
                            "text": "You cannot drive the vehicle on public roads without a current <w>warrant</w> of fitness.",
                            "target_lang_translations": {
                                "ru": "Вы не можете управлять транспортным средством на дорогах общего пользования без действующего <w>талона</w> о технической исправности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warrant of fitness"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ, подтверждающий соответствие транспортного средства стандартам технической исправности и безопасности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "талон техосмотра",
                                "target_lang_sense_clarification": "подтверждение исправности"
                            },
                            {
                                "target_lang_word": "сертификат годности",
                                "target_lang_sense_clarification": "для транспортного средства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "615a67f9-cddd-365a-b074-3cbc9b228896",
                    "sense_definition": "Underclay found in a coal mine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners noticed a thick layer of <w>warrant</w> beneath the coal seam.",
                            "target_lang_translations": {
                                "ru": "Шахтеры заметили толстый слой <w>подстилающей глины</w> под угольным пластом."
                            }
                        },
                        {
                            "text": "Geologists studied the composition of the <w>warrant</w> to understand the mine's history.",
                            "target_lang_translations": {
                                "ru": "Геологи изучили состав <w>почвы пласта</w>, чтобы понять историю шахты."
                            }
                        }
                    ],
                    "synonyms": [
                        "warren earth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой подстилающей глины, находящийся в угольной шахте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстилающая глина",
                                "target_lang_sense_clarification": "в горном деле"
                            },
                            {
                                "target_lang_word": "почва пласта",
                                "target_lang_sense_clarification": "в угольной шахте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0008f73a-7f70-3abd-a53b-2c211bac7f24",
                    "sense_definition": "To justify; to give grounds for a particular action or decision.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evidence was not strong enough to <w>warrant</w> a full investigation into the matter.",
                            "target_lang_translations": {
                                "ru": "Улик было недостаточно, чтобы <w>оправдать</w> полномасштабное расследование этого дела."
                            }
                        },
                        {
                            "text": "The current level of traffic does not <w>warrant</w> the construction of a second bridge.",
                            "target_lang_translations": {
                                "ru": "Текущий уровень трафика не <w>дает оснований</w> для строительства второго моста."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warrant a response",
                        "warrant further investigation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оправдывать; давать основания для определенного действия или решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдывать",
                                "target_lang_sense_clarification": "служить основанием"
                            },
                            {
                                "target_lang_word": "давать основания",
                                "target_lang_sense_clarification": "для чего-либо"
                            },
                            {
                                "target_lang_word": "заслуживать",
                                "target_lang_sense_clarification": "внимания или действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44836835-511d-395b-8a0d-d2329df4295a",
                    "sense_definition": "To guarantee as being true; to believe strongly or be certain of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is going to be late again, I'll <w>warrant</w>.",
                            "target_lang_translations": {
                                "ru": "Он снова опоздает, <w>ручаюсь</w>."
                            }
                        },
                        {
                            "text": "I'll <w>warrant</w> you that they will find a way to solve this problem.",
                            "target_lang_translations": {
                                "ru": "Я вам <w>гарантирую</w>, что они найдут способ решить эту проблему."
                            }
                        }
                    ],
                    "common_phrases": [
                        "I'll warrant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'I'll warrant'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручаться за истинность; твердо верить или быть уверенным в чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ручаться",
                                "target_lang_sense_clarification": "заверять в чем-либо"
                            },
                            {
                                "target_lang_word": "поручиться",
                                "target_lang_sense_clarification": "быть уверенным"
                            },
                            {
                                "target_lang_word": "гарантировать",
                                "target_lang_sense_clarification": "подтверждать истинность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "925bc371-b0b4-3c4f-ba41-618043da864c",
                    "sense_definition": "To authorize; to give someone official permission or sanction to do something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "authorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officers were <w>warranted</w> to search the premises for any illegal substances.",
                            "target_lang_translations": {
                                "ru": "Офицеры были <w>уполномочены</w> обыскать помещение на предмет наличия запрещенных веществ."
                            }
                        },
                        {
                            "text": "The commission is not <w>warranted</w> to treat with anyone other than the named officials.",
                            "target_lang_translations": {
                                "ru": "Комиссия не <w>имеет полномочий</w> вести переговоры с кем-либо, кроме указанных должностных лиц."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уполномочивать; давать кому-либо официальное разрешение на совершение чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уполномочивать",
                                "target_lang_sense_clarification": "давать право"
                            },
                            {
                                "target_lang_word": "санкционировать",
                                "target_lang_sense_clarification": "официально разрешать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86d90f40-5865-3573-8501-3ddc7e0d7e5c",
                    "sense_definition": "To guarantee something to be of a specified quality, value, or durability.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "assurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer <w>warranted</w> the engine to last for at least ten years.",
                            "target_lang_translations": {
                                "ru": "Производитель <w>гарантировал</w>, что двигатель прослужит не менее десяти лет."
                            }
                        },
                        {
                            "text": "This carpet is <w>warranted</w> to do well in all climates without fading.",
                            "target_lang_translations": {
                                "ru": "На этот ковер дается <w>гарантия</w>, что он сохранит свои свойства в любом климате и не выцветет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warranted to last"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гарантировать определенное качество, стоимость или долговечность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарантировать",
                                "target_lang_sense_clarification": "качество или срок службы"
                            },
                            {
                                "target_lang_word": "давать гарантию",
                                "target_lang_sense_clarification": "на товар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84741ab-1c0f-334a-8d00-aa31882d5b8f",
                    "sense_definition": "To protect or keep safe from danger or harm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient spell was said to <w>warrant</w> its user against all risk of injury.",
                            "target_lang_translations": {
                                "ru": "Говорили, что древнее заклинание <w>оберегает</w> того, кто его использует, от любого риска получения травмы."
                            }
                        },
                        {
                            "text": "He sought an honest means to <w>warrant</w> himself from the evils of the world.",
                            "target_lang_translations": {
                                "ru": "Он искал честный способ <w>оградить</w> себя от мирового зла."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "in the sense of physical protection"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищать или оберегать от опасности или вреда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защищать",
                                "target_lang_sense_clarification": "от вреда"
                            },
                            {
                                "target_lang_word": "оберегать",
                                "target_lang_sense_clarification": "от опасности"
                            },
                            {
                                "target_lang_word": "ограждать",
                                "target_lang_sense_clarification": "от рисков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}