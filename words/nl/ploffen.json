{
    "word_family": [
        "plof",
        "plofkip",
        "plofkraak",
        "plofzak"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3dc5b58-7d51-3478-b5ef-fc5a8e6c15e6",
                    "sense_definition": "zich met een dof geluid ergens op laten vallen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange werkdag wilde hij alleen maar op de bank <w>ploffen</w>.",
                            "target_lang_translations": {
                                "en": "After a long workday, he just wanted to <w>flop down</w> on the couch."
                            }
                        },
                        {
                            "text": "Moe was ze in haar luie stoel <w>geploft</w> en had haar benen op het bankje gelegd.",
                            "target_lang_translations": {
                                "en": "Tired, she had <w>flopped</w> into her easy chair and put her legs on the stool."
                            }
                        }
                    ],
                    "synonyms": [
                        "neervallen",
                        "neerploffen"
                    ],
                    "common_phrases": [
                        "op de bank ploffen",
                        "in een stoel ploffen"
                    ],
                    "target_lang_definitions": {
                        "en": "To let oneself fall onto something with a dull sound, often due to tiredness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to flop down",
                                "target_lang_sense_clarification": "to sit or lie down heavily"
                            },
                            {
                                "target_lang_word": "to plop down",
                                "target_lang_sense_clarification": "to sit down suddenly and heavily"
                            },
                            {
                                "target_lang_word": "to slump",
                                "target_lang_sense_clarification": "to sit or fall down heavily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0135db6-dd9b-3ced-890e-7408af57e261",
                    "sense_definition": "een dof geluid maken, zoals een zwaar voorwerp dat op de grond valt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde het dikke boek met een luide klap op de vloer <w>ploffen</w>.",
                            "target_lang_translations": {
                                "en": "I heard the thick book <w>thud</w> onto the floor with a loud bang."
                            }
                        },
                        {
                            "text": "De zware postzakken <w>ploften</w> een voor een op de tegels.",
                            "target_lang_translations": {
                                "en": "The heavy mailbags <w>thumped</w> onto the tiles one by one."
                            }
                        }
                    ],
                    "synonyms": [
                        "bonken"
                    ],
                    "common_phrases": [
                        "op de grond ploffen",
                        "neer ploffen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a dull sound, like a heavy object hitting the ground"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to thud",
                                "target_lang_sense_clarification": "to hit something with a low, heavy sound"
                            },
                            {
                                "target_lang_word": "to thump",
                                "target_lang_sense_clarification": "to hit or fall with a heavy, dull sound"
                            },
                            {
                                "target_lang_word": "to plop",
                                "target_lang_sense_clarification": "to fall with a soft, dull sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a10b96a-c253-3475-9c39-e64136c67e52",
                    "sense_definition": "plotseling en met geluid kapotgaan, uit elkaar springen of doorbranden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontploffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn voeding is, denk ik, <w>geploft</w>, want er kwam wat rook uit.",
                            "target_lang_translations": {
                                "en": "I think my power supply <w>blew</w>, because some smoke came out of it."
                            }
                        },
                        {
                            "text": "De oude gloeilamp <w>plofte</w> toen ik de schakelaar omzette.",
                            "target_lang_translations": {
                                "en": "The old light bulb <w>popped</w> when I flipped the switch."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontploffen",
                        "knallen",
                        "klappen"
                    ],
                    "common_phrases": [
                        "uit elkaar ploffen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor elektronica of kleine explosies"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly break, burst, or burn out with a sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pop",
                                "target_lang_sense_clarification": "to burst or break with a short sound"
                            },
                            {
                                "target_lang_word": "to blow",
                                "target_lang_sense_clarification": "to burn out or explode (electronics)"
                            },
                            {
                                "target_lang_word": "to go bang",
                                "target_lang_sense_clarification": "to explode or break loudly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3aadd5e-5c70-3460-94be-639816243064",
                    "sense_definition": "het geluid maken van een reeks zachte explosies",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ploffend</w> en knallend reed de antieke auto door de straat.",
                            "target_lang_translations": {
                                "en": "<w>Sputtering</w> and banging, the antique car drove through the street."
                            }
                        },
                        {
                            "text": "De oude motor begon te <w>ploffen</w> voordat hij eindelijk afsloeg.",
                            "target_lang_translations": {
                                "en": "The old engine started to <w>chug</w> before it finally stalled."
                            }
                        }
                    ],
                    "synonyms": [
                        "pruttelen"
                    ],
                    "common_phrases": [
                        "ploffend en knallend"
                    ],
                    "target_lang_definitions": {
                        "en": "To make the sound of a series of soft explosions, like an old engine"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sputter",
                                "target_lang_sense_clarification": "to make a series of soft explosive sounds"
                            },
                            {
                                "target_lang_word": "to chug",
                                "target_lang_sense_clarification": "to move with a regular muffled explosive sound"
                            },
                            {
                                "target_lang_word": "to pop",
                                "target_lang_sense_clarification": "to make small explosive noises"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e247ca8-38a1-3976-9ced-0a87a3ca5db7",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>plof</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hoorden verschillende doffe <w>ploffen</w> in de verte.",
                            "target_lang_translations": {
                                "en": "We heard several dull <w>thuds</w> in the distance."
                            }
                        },
                        {
                            "text": "De <w>ploffen</w> van de vallende stenen waren tot in de kelder te horen.",
                            "target_lang_translations": {
                                "en": "The <w>thumps</w> of the falling stones could be heard as far as the basement."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'plof'; multiple dull, heavy sounds"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thuds",
                                "target_lang_sense_clarification": "multiple dull impact sounds"
                            },
                            {
                                "target_lang_word": "thumps",
                                "target_lang_sense_clarification": "multiple heavy impact sounds"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}