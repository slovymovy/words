                        "examples": [
                            {
                                "example_id": "b96c2480-71de-4804-be9f-ccd3b6e89697",
                                "sense_id": "9eba3be0-fb5c-352a-9e6b-22d126c17b0b",
                                "text": "Les assurances ne veulent jamais rembourser les vols de portables. Non, moi j’veux mettre la main sur le baltringue qui me l’a chourav'."
                            },
                            {
                                "example_id": "f14cd307-ade8-478b-8583-bbab89455991",
                                "sense_id": "9eba3be0-fb5c-352a-9e6b-22d126c17b0b",
                                "text": "Dire que je te laisse le maousse cinq minutes et toi, tu te le fais chourav’."
                            },
                            {
                                "example_id": "cbe3af9b-07fb-4f6e-95e3-f60d18bbce5f",
                                "sense_id": "9eba3be0-fb5c-352a-9e6b-22d126c17b0b",
                                "text": "Attention tout de même à ne pas se faire « chourav’ » son bigo par un trépané."
                            }
                        ]
                    }
