            "senses": [
                {
                    "sense_id": "30e3c725-98ab-30c3-bdb1-96d08951c3fa",
                    "sense_definition": "A state of low priority for a project or task, often used in the phrase on the <w>backburner</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "priority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was put on the <w>backburner</w> until the company had more funding."
                        },
                        {
                            "text": "We decided to keep the renovation plans on the <w>backburner</w> for the rest of the year."
                        }
                    ],
                    "synonyms": [
                        "backlog"
                    ],
                    "common_phrases": [
                        "on the backburner"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1818e0f6-c678-3bb6-842f-fc7400b1d1e4",
                    "sense_definition": "To delay or reduce the importance of a task or project.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "priority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to <w>backburner</w> the new marketing campaign to focus on sales."
                        },
                        {
                            "text": "They had to <w>backburner</w> their personal goals while dealing with the family crisis."
                        }
                    ],
                    "synonyms": [
