        "fr-extract.jsonl": [
            {
                "entry_id": "c0943da7-0bfb-3fc6-b92c-c9baa7727e7e",
                "word": "urgemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0d6b40c-2e6d-324d-8bb0-a29f175230bb",
                        "entry_id": "c0943da7-0bfb-3fc6-b92c-c9baa7727e7e",
                        "glosses": [
                            "D’une manière urgente ; de toute urgence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c568f25-67bf-48e4-a628-c4c0f5650ad0",
                                "sense_id": "b0d6b40c-2e6d-324d-8bb0-a29f175230bb",
                                "text": "Quant à la société civile, elle est en retard de vingt ans. Elle doit se rattraper urgemment en se réunissant et en apprenant ce qu'elle doit apprendre."
                            },
                            {
                                "example_id": "909f8abe-9ec5-47e3-816a-47b131ee838f",
                                "sense_id": "b0d6b40c-2e6d-324d-8bb0-a29f175230bb",
                                "text": "Ce n'est pas tant d'outils nouveaux dont a urgemment besoin la démocratie, que d'une mentalité nouvelle, centrée sur cette valeur fondamentale qu'est la responsabilité : responsabilité vis-à-vis d'autrui, responsabilité vis-à-vis de la famille humaine, responsabilité vis-à-vis des générations futures."
                            },
                            {
                                "example_id": "a952c8c4-8371-401b-9679-b45760829705",
                                "sense_id": "b0d6b40c-2e6d-324d-8bb0-a29f175230bb",
                                "text": "Si, pour la deuxième fois de sa présidence, il est soumis urgemment à la procédure de destitution, c’est parce qu’il a nourri la hargne, sciemment, des émeutiers du Capitole."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac970289-304b-4228-b475-19b7bb3e2f55",
                        "source_entry_id": "c0943da7-0bfb-3fc6-b92c-c9baa7727e7e",
                        "source_sense_id": "b0d6b40c-2e6d-324d-8bb0-a29f175230bb",
                        "target_lang_word": "urgently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urgently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                        "entry_id": "8409db82-4f66-30dd-9ea4-67f26a9f0a7c",
                                        "glosses": [
                                            "With great haste, with a sense of urgency, because it is very important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0960ee83-65a9-4fe0-b355-135de6f1041e",
                                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                                "text": "We all urgently need to apply solutions to the problem of pollution."
                                            },
                                            {
                                                "example_id": "5f897afc-c224-44d0-abbe-dc942424a401",
                                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                                "text": "Funds are urgently required if this work is to be completed as planned."
                                            },
                                            {
                                                "example_id": "81e8f139-3e98-4dee-8dcb-40ffc4ed41d4",
                                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                                "text": "And now we're waiting for the very same people to establish GBR, drive through urgently needed fares reform, and come up with imaginative and effective train operating contracts..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6244cb10-a5cd-3be6-895c-daac72513640",
                                        "entry_id": "8409db82-4f66-30dd-9ea4-67f26a9f0a7c",
                                        "glosses": [
                                            "Continuously. With insistence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7392ed-5d36-450f-b4d3-828069e868c3",
                                                "sense_id": "6244cb10-a5cd-3be6-895c-daac72513640",
                                                "text": "He pleaded urgently for release from what he considered to be an unjust imprisonment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69bc3f9a-1c21-445b-8704-478ee3ebbf83",
                        "source_entry_id": "c0943da7-0bfb-3fc6-b92c-c9baa7727e7e",
                        "source_sense_id": "b0d6b40c-2e6d-324d-8bb0-a29f175230bb",
                        "target_lang_word": "quickly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quickly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c691aa24-7e91-32a6-b444-d39381f6d1ef",
                                        "entry_id": "f3961116-097f-3e04-a150-a2ccec102a55",
                                        "glosses": [
                                            "Rapidly; with speed; fast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b52c08b9-e4cb-4940-9c0a-35c4ad749edd",
                                                "sense_id": "c691aa24-7e91-32a6-b444-d39381f6d1ef",
                                                "text": "Luckily, the error was quickly corrected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c32b780-5bed-31d9-bfec-f92808dac6d4",
                                        "entry_id": "f3961116-097f-3e04-a150-a2ccec102a55",
                                        "glosses": [
                                            "Very soon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49781661-9ed8-4b50-a3df-96e9af377b24",
                                                "sense_id": "8c32b780-5bed-31d9-bfec-f92808dac6d4",
                                                "text": "If we go this way, we'll get there quickly."
                                            },
                                            {
                                                "example_id": "ec0c7da4-29a3-412e-b1a6-d952c194da30",
                                                "sense_id": "8c32b780-5bed-31d9-bfec-f92808dac6d4",
                                                "text": "Another Karadeniz cross led to Cudicini's first save of the night, with the Spurs keeper making up for a weak punch by brilliantly pushing away Christian Noboa's snap-shot.\nTwo more top-class stops followed quickly afterwards, first from Natcho's rasping shot which was heading into the top corner, and then to deny Ryazantsev at his near post."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7723b7a-d127-48d7-907c-6fb7a3b99b18",
                        "source_entry_id": "c0943da7-0bfb-3fc6-b92c-c9baa7727e7e",
                        "source_sense_id": "b0d6b40c-2e6d-324d-8bb0-a29f175230bb",
                        "target_lang_word": "emergently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emergently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0032a791-3837-3907-8a80-5eb705ed6f8a",
                                        "entry_id": "e2fdf504-7da7-3382-bc19-16764eda9a65",
                                        "glosses": [
                                            "In an emergent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeeb4306-52f6-4f8f-a4d6-3548fca16938",
                                                "sense_id": "0032a791-3837-3907-8a80-5eb705ed6f8a",
                                                "text": "I have responded to his call, and have to the best of my ability explained the causes and effects of that defective condition of the Mercantile Marine, which has been much and loudly complained of; and I have, in a full and comprehensive manner, detailed all existing abuses, and suggested those remedial measures which I consider essentially necessary to obtain that system of reform which is so emergently required."
                                            },
                                            {
                                                "example_id": "127699f4-8c16-4d19-88cd-76e2684f6896",
                                                "sense_id": "0032a791-3837-3907-8a80-5eb705ed6f8a",
                                                "text": "For example, being ratified by a constitutionally bound legislative body is one way in which an institution can be emergently justified."
                                            },
                                            {
                                                "example_id": "0d7b6491-907d-4eaf-a1a8-b96e169892ed",
                                                "sense_id": "0032a791-3837-3907-8a80-5eb705ed6f8a",
                                                "text": "Similarly, for a three-dimensional Newtonian world with N point particles, it is unreasonable to hold that a single point particle in 3N-dimensional space emergently exists, even though there is a sense in which the 3N-dimensional configuration space with the single particle has a straightforward mathematical correspondence with the N point particles in three-dimensional space."
                                            },
                                            {
                                                "example_id": "5953c2c4-2f0b-4652-9a30-d150290efbf7",
                                                "sense_id": "0032a791-3837-3907-8a80-5eb705ed6f8a",
                                                "text": "Then, with his emergently famous precision, he enumerated the flaws Bridges had made when he copied the map."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4ba10e7-6bd5-4869-bc7a-b26263d9a3c5",
                        "source_entry_id": "c0943da7-0bfb-3fc6-b92c-c9baa7727e7e",
