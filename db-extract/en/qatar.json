                                            {
                                                "example_id": "aa27994a-c06f-4355-b8b9-9ef2598f028c",
                                                "sense_id": "05924161-ab9e-3bac-aa8a-8160bd38deb3",
                                                "text": "Das Katar der letzten Jahre war wirtschaftlich erfolgreich."
                                            },
                                            {
                                                "example_id": "df8d0549-fbca-434f-9f75-90255372709d",
                                                "sense_id": "05924161-ab9e-3bac-aa8a-8160bd38deb3",
                                                "text": "„Donald Trump ist käuflich. Er verdient an der eigenen Kryptowährung und nimmt Geschenke aus Katar an.“"
