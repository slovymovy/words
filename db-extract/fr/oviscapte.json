                        "glosses": [
                            "Prolongement de l’abdomen de certains insectes, à l’aide duquel les femelles font des trous pour loger leurs œufs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd82725d-298e-4ef7-a402-c996400142f2",
                                "sense_id": "814b7986-a5e9-34d6-9059-65b50b1ef156",
                                "text": "Tandem du leste à forceps (Lestes forcipatus) : à l’aide de son oviscapte, la femelle, retenue par le mâle, insère un à un ses œufs dans le tissu végétal."
                            }
                        ]
                    }
