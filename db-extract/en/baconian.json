                    {
                        "sense_id": "66fbaad2-2099-3851-908c-6622f994fdeb",
                        "entry_id": "b0e0ceac-5482-355a-8448-ad2b7a3cd337",
                        "glosses": [
                            "One who believes that Francis Bacon wrote the plays attributed to William Shakespeare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9881bb0-0be5-46d0-a3be-45bd96955999",
                                "sense_id": "66fbaad2-2099-3851-908c-6622f994fdeb",
                                "text": "So looks the Shakespearean who is confronted by a rancid Baconian, or the astronomer who is assailed by a flat-earth fanatic."
                            },
                            {
                                "example_id": "93d73ffc-ce66-468a-94a6-a4333b559ed3",
                                "sense_id": "66fbaad2-2099-3851-908c-6622f994fdeb",
                                "text": "In this paper I propose to say something about the attempt of the Baconian theorists to \"work\" Ben Jonson over into a witness against William Shakespeare, not because it is necessary to reslay the slain Baconian, but to illustrate that here as elsewhere, and all along the line, there is \"nothing in it.\""
                            }
                        ]
                    }
