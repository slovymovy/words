                    },
                    {
                        "translation_id": "79176db8-dd8e-4a55-ad2d-728131cb7687",
                        "source_entry_id": "711e1513-cac0-37f4-b88d-02dea2da32e5",
                        "source_sense_id": "b8a695a6-147a-34fc-b318-84dd21da93a9",
                        "target_lang_word": "bauxite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bauxite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f010309b-b6cc-3a5b-a467-7d9912ca093a",
                                        "entry_id": "a8b7d8f0-2fde-3be1-962c-b2bfe540aca2",
                                        "glosses": [
                                            "Roche sédimentaire caractérisée par sa forte teneur en alumine et en oxydes de fer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7470255-4b2f-440a-871e-9516b149cc58",
                                                "sense_id": "f010309b-b6cc-3a5b-a467-7d9912ca093a",
                                                "text": "L'origine des bauxites, dit M. Coquand, se rattache incontestablement à l'intervention de sources minérales qui ont apporté, soit dans les lacs, soit à la surface des sols immergés, les aluminates de fer et les diaspores qui constituent les minerais de bauxite."
                                            },
                                            {
                                                "example_id": "c26324d3-2313-402a-9cce-30a87737a175",
                                                "sense_id": "f010309b-b6cc-3a5b-a467-7d9912ca093a",
                                                "text": "La bauxite est encore utilisée dans cette industrie."
                                            },
                                            {
                                                "example_id": "33034a20-ffe9-4451-a920-02ce9d00500f",
                                                "sense_id": "f010309b-b6cc-3a5b-a467-7d9912ca093a",
                                                "text": "La limonite pourrait provenir de la bauxite du synclinal d’Ollières et les quartz du Crétacé supérieur de ce même synclinal ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cf08579-e17e-423d-8588-76cf731e604d",
                        "source_entry_id": "711e1513-cac0-37f4-b88d-02dea2da32e5",
                        "source_sense_id": "b8a695a6-147a-34fc-b318-84dd21da93a9",
                        "target_lang_word": "Bauxit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauxit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd0a8558-a1a3-3604-87e7-2f18365daa13",
                                        "entry_id": "995c84f5-b5b0-3f3c-8e4e-b8bccac26e8f",
                                        "glosses": [
                                            "festes, kolloidales Aluminiumhydroxid mit etwas Eisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3a1142-ee66-47fb-8402-9ee3e5919d9f",
                                                "sense_id": "dd0a8558-a1a3-3604-87e7-2f18365daa13",
                                                "text": "„Das einzige wirtschaftlich wichtige Ausgangsmaterial für die Aluminiumproduktion ist Bauxit.“"
                                            },
                                            {
                                                "example_id": "e7dc194d-8b3d-411d-a5cc-802a6843b7c8",
                                                "sense_id": "dd0a8558-a1a3-3604-87e7-2f18365daa13",
                                                "text": "„Im Rahmen der Explorationsgeologie kann der Untersuchung des Regoliths eine große Bedeutung u.a. bei der Aufspürung von Lagerstätten von Kaolin (und anderen technisch verwertbaren Tonen), Bauxit, Nickel, Edelmetallen, Edel- und Halbedelsteinen zukommen.“"
                                            }
                                        ],
