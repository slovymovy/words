    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ac713c64-7d8b-31c3-9b50-e038bdfb10ef",
                    "sense_definition": "pijn, leed of onrecht verdragend zonder te klagen of in verzet te komen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passief_verdragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de bezetting vertoonde de bevolking soms een <w>lijdzame</w> houding tegenover de indringers.",
                            "target_lang_translations": {
                                "en": "During the occupation, the population sometimes showed a <w>passive</w> attitude towards the invaders."
                            }
                        },
                        {
                            "text": "Zij onderging de pijnlijke medische behandeling op een bewonderenswaardig <w>lijdzame</w> manier.",
                            "target_lang_translations": {
                                "en": "She underwent the painful medical treatment in an admirably <w>patient</w> manner."
                            }
                        }
                    ],
                    "synonyms": [
                        "geduldig",
                        "passief",
                        "berustend",
                        "lijdelijk"
                    ],
                    "antonyms": [
                        "opstandig",
                        "actief",
                        "weerbaar"
                    ],
                    "common_phrases": [
                        "lijdzame houding",
                        "lijdzaam toezien"
                    ],
                    "target_lang_definitions": {
                        "en": "bearing pain, suffering, or injustice without complaining or resisting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resigned",
                                "target_lang_sense_clarification": "accepting something unpleasant that one cannot change"
                            },
                            {
                                "target_lang_word": "passive",
                                "target_lang_sense_clarification": "submissive and not reacting or resisting"
                            },
                            {
                                "target_lang_word": "patient",
                                "target_lang_sense_clarification": "bearing trials or pain calmly and without complaint"
                            },
                            {
                                "target_lang_word": "long-suffering",
                                "target_lang_sense_clarification": "patiently enduring lasting hardship or difficulties"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "056a4fca-74e5-36c8-be84-c508a780c596",
                    "sense_definition": "op een lijdzame, gelaten of passieve wijze",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passief_verdragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze moest <w>lijdzaam</w> toezien hoe haar spullen in beslag werden genomen door de deurwaarders.",
                            "target_lang_translations": {
                                "en": "She had to watch <w>passively</w> as her belongings were seized by the bailiffs."
                            }
                        },
                        {
                            "text": "De gevangenen ondergingen hun lot <w>lijdzaam</w> en zonder protest.",
                            "target_lang_translations": {
                                "en": "The prisoners met their fate <w>resignedly</w> and without protest."
                            }
                        }
                    ],
                    "synonyms": [
                        "gelaten",
                        "passief",
                        "berustend"
                    ],
                    "antonyms": [
                        "opstandig",
                        "actief"
                    ],
                    "common_phrases": [
                        "lijdzaam toezien",
                        "lijdzaam ondergaan"
                    ],
                    "target_lang_definitions": {
                        "en": "in a passive, resigned, or submissive manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passively",
                                "target_lang_sense_clarification": "without active response or resistance"
                            },
                            {
                                "target_lang_word": "resignedly",
                                "target_lang_sense_clarification": "with resignation and acceptance of one's fate"
                            },
                            {
                                "target_lang_word": "patiently",
                                "target_lang_sense_clarification": "with patience and endurance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
