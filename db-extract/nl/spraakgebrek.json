                ],
                "translations": [
                    {
                        "translation_id": "b3f1cc4f-5bdb-4ef9-898c-bfe6f9359357",
                        "source_entry_id": "4ac1e8e3-5030-332f-979e-6aa9e5c0a0c1",
                        "source_sense_id": "42bbafb7-88ac-334a-b354-f9c8e7662b90",
                        "source_sense_description": "een spreekstoornis",
                        "target_lang_word": "Sprachfehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachfehler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "587f82f2-135e-3e23-ba79-8543e6c490e9",
                                        "entry_id": "52b48c04-8c9e-3bc8-a189-9cecf1954077",
                                        "glosses": [
                                            "mangelnde Fähigkeit, bestimmte Laute korrekt auszusprechen"
                                        ],
                                        "tags": [
                                            "Linguistik/Logopädie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30dbd074-842b-4c1d-aad1-962f799a4179",
                                                "sense_id": "587f82f2-135e-3e23-ba79-8543e6c490e9",
                                                "text": "„Sprachfehler bei Kindern im Vorschulalter werden nach Einschätzung von Experten oft nicht richtig diagnostiziert.“"
                                            },
                                            {
                                                "example_id": "c668063c-6082-4fd8-86d9-2343a401993c",
                                                "sense_id": "587f82f2-135e-3e23-ba79-8543e6c490e9",
                                                "text": "„Bei uns finden Sie Informationen zu Sprachfehler (lispeln) nach Zahnimplantation und Medizinrecht.“"
                                            },
                                            {
                                                "example_id": "b973aa27-7b87-4247-bdaa-0e51bc8d2fc7",
                                                "sense_id": "587f82f2-135e-3e23-ba79-8543e6c490e9",
                                                "text": "„Sollte es mit einfachen und spielerischen Übungen nicht gelingen, zumindest eine Besserung des \"Sprachfehlers\" zu erreichen, ist auf jeden Fall logopädisches Fachpersonal zu konsultieren, weil nur Logopäden die wahrscheinliche Ursache diagnostizieren und dann die entsprechende Therapie einleiten können.“"
                                            },
                                            {
                                                "example_id": "f24a948e-5f69-4af1-91d5-c88f36cb6f8f",
                                                "sense_id": "587f82f2-135e-3e23-ba79-8543e6c490e9",
                                                "text": "„Er brüllt in das Mikrophon, verschluckt die Silben und hat einen erheblichen Sprachfehler.“"
                                            },
                                            {
                                                "example_id": "a28ac732-f190-4bce-b0d3-c71087f6f872",
                                                "sense_id": "587f82f2-135e-3e23-ba79-8543e6c490e9",
                                                "text": "„In der Klasse war einer mit Sprachfehler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1db0da9-277d-4e1a-b7e7-a00b710d8905",
                        "source_entry_id": "4ac1e8e3-5030-332f-979e-6aa9e5c0a0c1",
                        "source_sense_id": "42bbafb7-88ac-334a-b354-f9c8e7662b90",
                        "source_sense_description": "een spreekstoornis",
                        "target_lang_word": "Sprachstörung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachstörung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                        "entry_id": "4590dd57-e59d-3d97-8aa8-72d6c0353702",
                                        "glosses": [
                                            "Störung der Fähigkeit zu sprechen bzw. Sprachliches zu verstehen, die auf physische oder psychische Ursachen zurückgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d1050a-3213-454d-91a3-a0ef594f9936",
                                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                                "text": "Sprachstörungen müssen von Sprech- und Verstehensfehlern unterschieden werden, die keine physischen oder psychischen Ursachen haben, sondern lediglich auf mangelnde Konzentration oder Stress zurückzuführen sind."
                                            },
                                            {
                                                "example_id": "be83141e-a5f1-4fff-a4ec-d79932e0aec5",
                                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                                "text": "Lewandowski definiert Sprachstörungen als „Störungen der Sprachproduktion und/oder Sprechrezeption bzw. der Sprachwahrnehmung.“"
                                            },
                                            {
                                                "example_id": "12231c19-d832-4ead-9ce3-8634ded0f5ce",
                                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                                "text": "„Überhaupt wird, je genauer man die eigentlichen Ursachen der Sprachstörungen untersucht, die entscheidende Rolle des Gehirns auch in den Außenbezirken immer klarer.“"
                                            },
                                            {
                                                "example_id": "0b6d3005-762a-4c63-8745-88a626fbe8ba",
                                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                                "text": "Die häufigsten kindlichen Sprachstörungen sind Aussprachstörungen, auch Dyslalie oder Stammeln genannt."
                                            },
                                            {
                                                "example_id": "fe3e09d6-5d69-4fa6-8c7d-c309f2bca9fb",
                                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                                "text": "„Er sprach über typische Sprachstörungen bei Schizophrenen, in denen Denkstörungen zum Ausdruck kamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
