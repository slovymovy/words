                        "entry_id": "1fc1bfd8-8d5f-3b3e-b3b9-3382faef98ac",
                        "glosses": [
                            "In a way that entirely consumes one"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efaf6cf-6e78-47d5-9396-e79af21b9f06",
                                "sense_id": "25b51eae-53ba-3f07-90ef-59fb309b91a3",
                                "text": "They give every token of hating their neighbors consumedly; argal, they are going to be madly enamored of them."
                            },
                            {
                                "example_id": "63bacd39-7ca6-4c53-b3eb-eb2268595726",
                                "sense_id": "25b51eae-53ba-3f07-90ef-59fb309b91a3",
                                "text": "The men took it as a huge joke, and at every pause laughed consumedly."
                            },
                            {
                                "example_id": "b5b186ae-107e-4461-9745-282af06d6b36",
                                "sense_id": "25b51eae-53ba-3f07-90ef-59fb309b91a3",
                                "text": "And so, we are proud--yes! we are consumedly proud, and we know that we have earned the right to be proud."
                            }
                        ]
                    },
                    {
                        "sense_id": "7167e642-7a9a-3017-978e-b23457b9396a",
                        "entry_id": "1fc1bfd8-8d5f-3b3e-b3b9-3382faef98ac",
                        "glosses": [
                            "deucedly; extremely"
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3b58fcd2-138d-4e49-91f7-a0ac54974e06",
                                "sense_id": "7167e642-7a9a-3017-978e-b23457b9396a",
                                "text": "These border rascals are apt to be restless in the dark hours, and their knives prick most consumedly sharp!"
                            }
                        ]
                    }
