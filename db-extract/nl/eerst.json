                                    {
                                        "sense_id": "234ffb79-20a2-3ce6-a719-ba22ef276a15",
                                        "entry_id": "024f3970-f9fa-3185-99cd-ffc49526ede4",
                                        "glosses": [
                                            "In the first place; before anything else; first."
                                        ],
                                        "tags": [
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc9423ba-bb21-403c-8756-1c440de4b58f",
                                                "sense_id": "234ffb79-20a2-3ce6-a719-ba22ef276a15",
                                                "text": "Firstly, I continue to base most species treatments on personally collected material, rather than on herbarium plants. […] Secondly, I continue to base my concepts on intensive study of a limited suite of collections, rather than superficial study of every packet that comes to hand."
                                            },
                                            {
                                                "example_id": "91c32fc6-f0c8-4532-b8b8-e6cbaf37e0fd",
                                                "sense_id": "234ffb79-20a2-3ce6-a719-ba22ef276a15",
                                                "text": "We'll go into more depth with all the specs shortly so anyone less well versed in espresso speak will understand what I'm harping on about, but firstly let's just talk about using the machine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c41376e3-a7d3-447e-bf1f-145d2eb7b4c7",
                        "source_entry_id": "4ac17f21-2eeb-3e6f-969e-f1e869cadbf9",
                        "source_sense_id": "526ff4c6-fdce-3733-8228-e66377c2e980",
