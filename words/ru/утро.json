                },
                {
                    "sense_id": "2886ca42-d9c9-3655-b140-d7b714fc140f",
                    "sense_definition": "Утреннее публичное собрание, концерт или представление",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В воскресенье мы посетили музыкальное <w>утро</w> в филармонии.",
                            "target_lang_translations": {
                                "en": "On Sunday we attended a musical <w>matinee</w> at the philharmonic.",
                                "zh": "周日我们去爱乐乐团参加了一场音乐<w>日场</w>。"
                            }
