                "senses": [
                    {
                        "sense_id": "d0223711-5668-3afa-b429-19e14487e1e1",
                        "entry_id": "74f347b9-8fce-3b9e-a11e-d7fe8fe306ec",
                        "glosses": [
                            "Antwort und technischer Vorschlag, für die einzusetzende Lüftungsart und Lüftungstechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50689763-dea0-467d-8809-e537043d37bc",
                                "sense_id": "d0223711-5668-3afa-b429-19e14487e1e1",
                                "text": "„Gemäß der Zielvorgabe und Vorlieben der Bewohner wird eine passende Lüftungslösung ausgewählt und das zu installierende Modell bestimmt.“"
                            },
                            {
                                "example_id": "c9ea8b9d-d686-4a36-a492-57e2040cdcec",
                                "sense_id": "d0223711-5668-3afa-b429-19e14487e1e1",
                                "text": "„Wenn eine Lüftung durch den Nutzer nicht gewährleistet werden kann, müssen mechanische Lüftungslösungen zum Einsatz kommen.“"
                            },
                            {
                                "example_id": "aebcf19c-2f8c-4f3f-bd55-2746c4093c03",
                                "sense_id": "d0223711-5668-3afa-b429-19e14487e1e1",
                                "text": "„Sowohl für Sanierungs- als auch Neubauprojekte bietet Brink Climate Systems maßgeschneiderte Lüftungslösungen – passgenau abgestimmt auf aktuelle und künftige Anforderungsprofile und Rechtsvorschriften.“"
                            },
                            {
                                "example_id": "f8aeef98-6499-4805-82ae-3cb6e8a69378",
                                "sense_id": "d0223711-5668-3afa-b429-19e14487e1e1",
                                "text": "„Die Lüftungslösung airModul von Schrag kombiniert im Geschosswohnungsbau mit bis zu acht Stockwerken Vorteile von dezentralen und zentralen Lüftungslösungen.“"
                            },
                            {
                                "example_id": "6049ff32-f215-4b81-b7dd-f940072b61c7",
                                "sense_id": "d0223711-5668-3afa-b429-19e14487e1e1",
                                "text": "„Mit dieser hocheffizienten Lüftungslösung direkt am Kochfeld werden Dämpfe und Gerüche besonders wirkungsvoll nach unten abgesaugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
