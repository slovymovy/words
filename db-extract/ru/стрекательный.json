                ],
                "senses": [
                    {
                        "sense_id": "bdeb4ec6-47ce-3b3f-89dd-0860913e1e9b",
                        "entry_id": "8f588854-ccfb-3771-a01e-ecd40a7688ea",
                        "glosses": [
                            "колющий, жгущий (обычно о специальных клетках, органах животных и растений)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6764f01b-33ec-4cde-ae87-8db3433bff1f",
                                "sense_id": "bdeb4ec6-47ce-3b3f-89dd-0860913e1e9b",
                                "text": "Щупальца прилипли к спине рыбки, рыбка замерла, словно парализованная; стрекательные нити, выброшенные из щупалец, вонзились в ее тело, впущенный яд моментально оглушил ее."
                            },
                            {
                                "example_id": "e76c1001-d1f0-491d-ac0d-c0453c7673ef",
                                "sense_id": "bdeb4ec6-47ce-3b3f-89dd-0860913e1e9b",
                                "text": "Стрекательные органы гидры больно жалят, парализуют добычу (от ожогов у меня и теперь болят руки)."
                            }
                        ]
                    }
                ],
