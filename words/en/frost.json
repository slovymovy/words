                {
                    "sense_id": "7f26d7c1-767f-363d-af47-e9f2d6b8d639",
                    "sense_definition": "A place name used for various towns and communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped in the small town of <w>Frost</w> while driving through Texas.",
                            "target_lang_translations": {
                                "ru": "Они остановились в маленьком городке <w>Фрост</w>, проезжая через Техас.",
                                "zh": "他们开车穿过德克萨斯州时，在<w>弗罗斯特</w>小镇停了下来。"
                            }
                        },
                        {
                            "text": "My grandparents live in a community called <w>Frost</w> in West Virginia.",
                            "target_lang_translations": {
                                "ru": "Мои бабушка и дедушка живут в общине под названием <w>Фрост</w> в Западной Вирджинии.",
                                "zh": "我的祖父母住在西弗吉尼亚州一个叫<w>弗罗斯特</w>的社区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
