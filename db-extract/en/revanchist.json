                                        "sense_id": "33f6b345-621a-38e9-bde5-c4a0b8efe35f",
                                        "entry_id": "85c3b582-2a26-3c98-9bbe-3927014c8c74",
                                        "glosses": [
                                            "Que pertenece o concierne al revanchismo."
                                        ],
