                "senses": [
                    {
                        "sense_id": "e10f6612-36fa-34ef-ac2f-68090994d160",
                        "entry_id": "3af14110-fd2e-3347-b061-c41f4853cb6f",
                        "glosses": [
                            "dor en droog"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5baa5d-a3fb-46c7-88a3-a98dc0389b1c",
                                "sense_id": "e10f6612-36fa-34ef-ac2f-68090994d160",
                                "text": "Een model dat de reactie van ecosystemen op klimaat en CO2-aanbod nabootst kwam op 3,9. Beide methoden wezen de zuidelijke semi-aride gebieden aan als voornaamste ‘sink’ van CO2."
                            },
                            {
                                "example_id": "b71a63c6-c56d-42d8-a055-d5da237e80fd",
                                "sense_id": "e10f6612-36fa-34ef-ac2f-68090994d160",
                                "text": "De Sahel, de uitgestrekte aride regio tussen de tropen en de Sahara, werd synoniem met honger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06a6eb1f-1912-4138-a6de-d0f608442d8a",
                        "source_entry_id": "3af14110-fd2e-3347-b061-c41f4853cb6f",
                        "source_sense_id": "e10f6612-36fa-34ef-ac2f-68090994d160",
                        "source_sense_description": "dor en droog",
                        "target_lang_word": "arid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a9c100a-b747-31ea-964d-b7bef8ae88f8",
                                        "entry_id": "3a955f91-24a7-3e08-a9bd-ad240b551e12",
                                        "glosses": [
                                            "Very dry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9aa5a34-d389-42b1-9a31-efb2f00db0a6",
                                                "sense_id": "7a9c100a-b747-31ea-964d-b7bef8ae88f8",
                                                "text": "The cake was arid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "605be8b5-b542-3a6f-84d5-21bc8e27f5e4",
                                        "entry_id": "3a955f91-24a7-3e08-a9bd-ad240b551e12",
                                        "glosses": [
                                            "Describing a very dry climate. Typically defined as less than 25 cm or 10 inches of rainfall annually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324d3bb3-1ce6-4174-aae7-23b30fe33b29",
                                                "sense_id": "605be8b5-b542-3a6f-84d5-21bc8e27f5e4",
                                                "text": "Deserts are known for being arid."
                                            },
                                            {
                                                "example_id": "608785a1-0e1a-44e0-8e9b-bc15428d5370",
                                                "sense_id": "605be8b5-b542-3a6f-84d5-21bc8e27f5e4",
                                                "text": "And because this part of Utah is arid, the geologic landscape is fully revealed with very little vegetation to hide it, faults and all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3a14566-d793-30f9-8ba5-7591558ff272",
                                        "entry_id": "3a955f91-24a7-3e08-a9bd-ad240b551e12",
                                        "glosses": [
                                            "Devoid of value."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6772b9bc-0a2e-4254-8dfb-efdc1b0c256c",
                                                "sense_id": "e3a14566-d793-30f9-8ba5-7591558ff272",
                                                "text": "The millionaire viewed his gift as arid."
                                            },
                                            {
                                                "example_id": "82d0e2de-d266-4de8-82ce-d8ecaeecb6d1",
                                                "sense_id": "e3a14566-d793-30f9-8ba5-7591558ff272",
                                                "text": "Such occupations might have seemed arid to those who did not possess the intellect to appreciate their subtleties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bedd972c-985e-4ed6-acdf-dbe3464f387c",
                        "source_entry_id": "3af14110-fd2e-3347-b061-c41f4853cb6f",
                        "source_sense_id": "e10f6612-36fa-34ef-ac2f-68090994d160",
                        "source_sense_description": "dor en droog",
                        "target_lang_word": "aride",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aride",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3778179c-21e8-35af-848a-9d0ff4d98d32",
                                        "entry_id": "92873716-73a6-3efd-8e2e-ce2431bc7de7",
                                        "glosses": [
                                            "Qualifie un milieu ou un climat très sec, caractérisé par une absence ou une très faible quantité d’humidité limitant fortement la végétation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f46f511-da9b-4e39-9eb3-8c01eb17d6d0",
                                                "sense_id": "3778179c-21e8-35af-848a-9d0ff4d98d32",
                                                "text": "La vérité est que je n’ai jamais vu de terrains si dénudés, si arides, à tel point réfractaires à la végétation, […]."
                                            },
                                            {
                                                "example_id": "ced12922-4046-42ce-9c42-2b2a67cd81ca",
                                                "sense_id": "3778179c-21e8-35af-848a-9d0ff4d98d32",
                                                "text": "Le Roi des Rois est enfin revenu dans sa capitale. Il a conquis le monde jusqu’aux rives de la mer Rouge, jusqu’aux monts arides du Caucase, jusqu’aux terres inviolées où la neige tombe même en été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                        "entry_id": "92873716-73a6-3efd-8e2e-ce2431bc7de7",
                                        "glosses": [
                                            "Très sec, qui est dépourvu d’intérêt, qui manque de sensibilité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aaa3184-0ab1-42dd-8224-6c48382cbf02",
                                                "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                                "text": "Ordonnez encore une fois à ces ossements arides de se ranimer."
                                            },
                                            {
                                                "example_id": "539892e9-002e-4812-8626-a8cf9d120d08",
                                                "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                                "text": "Son corps aride [de saint Benoît] et exténué de mortifications et de souffrances, ne paraît plus se soutenir que par la grandeur de sa foi."
                                            },
                                            {
                                                "example_id": "848a054b-fecb-4bc9-8897-59a463179678",
                                                "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                                "text": "Il ne faut pas oublier l'Italien C. Émery, grand classificateur qui s'est consacré au travail ingrat, aride, mais nécessaire qui consiste à établir le signalement détaillé et technique, la fiche myrmécologique, si l'on peut dire, de la plupart des fourmis afin qu'on puisse les identifier sans erreur."
                                            },
                                            {
                                                "example_id": "3e4f67c9-c39a-4780-aacb-76903f91ff7f",
                                                "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                                "text": "Mais quoi ! toute beauté se flétrit sous les doigts de l’aride vieillesse."
                                            },
                                            {
                                                "example_id": "bb4087ff-a28f-45e0-8ca5-7f5dd53fe1e8",
                                                "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                                "text": "J'aurai toujours le regret de cette poésie qui est action elle-même, dans son détachement des choses, dans sa musique, qui n'exprime rien sinon son aride et sublime passion d'elle-même."
                                            },
                                            {
                                                "example_id": "002ce960-36a4-4003-abc7-8b17b3a38f75",
                                                "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                                "text": "Il n'y a rien de plus aride que ses bonnes grâces."
                                            },
                                            {
                                                "example_id": "3962b3cd-4b4e-4761-a472-c99dd2fcf8eb",
                                                "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                                "text": "Il vient des temps de sécheresse et de langueur, où l’on fait d’arides réflexions."
                                            },
                                            {
                                                "example_id": "6db3c57d-8e99-4580-9965-d4677977109f",
                                                "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                                                "text": "Quelquefois je le sens si malheureux, si isolé dans son univers aride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3569e31-48b8-3eb2-9111-87da3ce86748",
                                        "entry_id": "92873716-73a6-3efd-8e2e-ce2431bc7de7",
                                        "glosses": [
                                            "Se dit d’une surface qui présente une certaine sécheresse et âpreté au doigt."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
