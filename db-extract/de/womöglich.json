                        "target_lang_word": "wellicht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wellicht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ea9cfee9-99ad-3ad6-8bbc-8cfa0457cf16",
                                        "entry_id": "6f3292e5-26cc-3663-9f5d-47136e47f955",
                                        "glosses": [
                                            "misschien, mogelijk, mogelijkerwijs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2291b75f-bffe-4680-b7ed-efb582acadb1",
                                                "sense_id": "ea9cfee9-99ad-3ad6-8bbc-8cfa0457cf16",
                                                "text": "Wellicht zal hij haar een huwelijksaanzoek doen."
                                            },
                                            {
                                                "example_id": "b0b2c0d8-897a-46d7-b64d-ee6db2d05a39",
                                                "sense_id": "ea9cfee9-99ad-3ad6-8bbc-8cfa0457cf16",
                                                "text": "Zo kunnen Afrikaanse voetballers als Didier Drogba (aan het begin van de eenentwintigste eeuw bij Chelsea) of Mohamed Salah (thans bij Liverpool) bezongen worden door dezelfde mensen die wellicht hun stemgedrag laten leiden door nativistische en xenofobe sentimenten."
                                            },
                                            {
                                                "example_id": "6a90fc6f-0424-4eb7-b743-056952e8b958",
                                                "sense_id": "ea9cfee9-99ad-3ad6-8bbc-8cfa0457cf16",
                                                "text": "Als ze uw brieven niet heeft beantwoord, dacht ze wellicht dat u haar boodschap begreep."
                                            },
                                            {
                                                "example_id": "7c100a1d-19d3-4982-97bc-24060f9e2d68",
                                                "sense_id": "ea9cfee9-99ad-3ad6-8bbc-8cfa0457cf16",
                                                "text": "Wellicht was ik door mijn drukke agenda thuis wat mat en ingeslapen geraakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
