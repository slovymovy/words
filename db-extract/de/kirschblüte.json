                                "target_senses": [
                                    {
                                        "sense_id": "e42bac0d-4b70-368f-8848-4baa664f8dad",
                                        "entry_id": "9c0417da-e049-3fe3-9a24-72cd4da1275b",
                                        "glosses": [
                                            "Cerisier du Japon, terme générique s'appliquant à de nombreuses espèces appartenant à la famille des Rosacées (ou Rosaceae)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ebe0a7b-8e58-4754-8e71-801eddd68fcd",
                                                "sense_id": "e42bac0d-4b70-368f-8848-4baa664f8dad",
                                                "text": "La saison des sakuras, les traditionnels cerisiers ornementaux, attire, chaque année, beaucoup de touristes au pays du Soleil-Levant."
                                            },
                                            {
                                                "example_id": "e6640a6c-78b7-4c6c-8a94-32d0d67bd20b",
                                                "sense_id": "e42bac0d-4b70-368f-8848-4baa664f8dad",
                                                "text": "On trouvait aussi des Cerasus kurilensis ou sachalinensis, cousins du sakura nippon, qui peuplent le sud de Sakhaline."
                                            },
                                            {
                                                "example_id": "c82c5333-c7d5-4708-9f63-8667f2a30d97",
                                                "sense_id": "e42bac0d-4b70-368f-8848-4baa664f8dad",
                                                "text": "Les sakura ne les avaient pas attendues. Une infinité de monticules roses tachetaient trottoirs et allées ; les dernières pétales s’accrochaient aux branches, guettés par la prochaine bise."
                                            },
                                            {
                                                "example_id": "fc57146f-0450-4813-81de-ea3d991e4cee",
                                                "sense_id": "e42bac0d-4b70-368f-8848-4baa664f8dad",
                                                "text": "Les sakuras tiennent une place de première importance dans la plupart des jardins japonais et des parcs publics, écoles et bâtiments publics japonais."
                                            },
                                            {
                                                "example_id": "0634ffe4-f609-4fc1-b114-54f771b57c07",
                                                "sense_id": "e42bac0d-4b70-368f-8848-4baa664f8dad",
                                                "text": "[…] qui dit Japon dit sakura, ces fleurs rose pâle en grappes comme des boules de coton, qui font l’admiration de tout un peuple et de nous tous gaijin. C’est la fleur représentée sur les pièces de cent yen. On admire, on admire, on admire encore, on s’extasie, on s’émerveille, on photographie, on admire toujours, on ne se lasse jamais de ces sakura, et on recommence de printemps en printemps avec toujours la même attente, la même émotion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
