                                        "entry_id": "1004e7b4-ae7f-39a5-a335-40ead342836f",
                                        "glosses": [
                                            "Aufhebung eines Gerichtsurteils aus einem Zivilprozess oder Strafprozess durch die nächsthöhere Instanz ohne in der Sache selbst zu entscheiden"
                                        ],
                                        "tags": [
                                            "Rechtsprechung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73041f15-e920-4228-a494-6543fd8348bf",
                                                "sense_id": "ac258b86-3596-3ebd-8246-33778766795b",
                                                "text": "Birotteau folgte Popinot, von einer Angst gefoltert, wie sie der Verurteilte in der Erwartung der Kassation des Urteils oder der Zurückweisung seiner Berufung empfindet."
                                            },
                                            {
                                                "example_id": "93480824-82ea-4df3-b2e4-e11d8e34189e",
                                                "sense_id": "ac258b86-3596-3ebd-8246-33778766795b",
                                                "text": "„Aber sie setzt die Kassation durch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e1bb3ab-9af8-3bbc-a00f-c856bffd1ca9",
                                        "entry_id": "1004e7b4-ae7f-39a5-a335-40ead342836f",
                                        "glosses": [
                                            "Ungültigkeitserklärung oder Einziehung einer Urkunde"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "435e7d52-cb56-4555-b287-9f37295699ee",
                                                "sense_id": "3e1bb3ab-9af8-3bbc-a00f-c856bffd1ca9",
                                                "text": "Ein Mitglied beantragte die zusätzliche Vorschrift, der Aussteller sei auch zur Kassation der Urkunde befugt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "81b77a48-b78f-3860-8c3a-b127f51cc93f",
                                        "entry_id": "1004e7b4-ae7f-39a5-a335-40ead342836f",
                                        "glosses": [
                                            "gesetzeskonforme Aussonderung und Kennzeichnung nicht archivwürdig bewerteter Unterlagen mit anschließender Vernichtung"
                                        ],
                                        "tags": [
                                            "Archivwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9c3e57c-8ace-4806-88d1-a9e9f478f246",
                                                "sense_id": "81b77a48-b78f-3860-8c3a-b127f51cc93f",
                                                "text": "Um zu verhindern, dass wichtige Beweise vernichtet werden, hat der Gesetzgeber sich ausdrücklich gegen archivübliche Kassationen entschieden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0ce592ac-1e03-3c77-b1d1-70b06460fdc9",
                                        "entry_id": "1004e7b4-ae7f-39a5-a335-40ead342836f",
                                        "glosses": [
                                            "bedingungslose Entlassung von Beamten aus dem Staatsdienst oder Militärdienst"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31ebeb02-4b63-4b1c-9d6c-26c9fec71086",
                                                "sense_id": "0ce592ac-1e03-3c77-b1d1-70b06460fdc9",
                                                "text": "Von Keith, wie schon in einer früheren Anmerkung hervorgehoben, war durch das Kriegsgericht zum Strang, von Spaën zu Kassation, von Ingersleben zu sechsmonatiger Festungshaft verurteilt worden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
