        "pl-extract.jsonl": [
            {
                "entry_id": "2eef18ca-bdd7-3ca4-8cbf-befa293c4749",
                "word": "życzliwość",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "885b6a64-70f1-34ff-ba6e-5d6d8a111ecd",
                        "entry_id": "2eef18ca-bdd7-3ca4-8cbf-befa293c4749",
                        "glosses": [
                            "przyjazny stosunek do innych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4230dcfd-e69e-480c-80f0-99d07ac00a85",
                                "sense_id": "885b6a64-70f1-34ff-ba6e-5d6d8a111ecd",
                                "text": "Ktoś, kto wie, jak oddać życzliwość, której doświadczył, musi być przyjacielem ponad wszelką cenę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7867a60a-9df9-4159-93cb-5f351c91a497",
                        "source_entry_id": "2eef18ca-bdd7-3ca4-8cbf-befa293c4749",
                        "source_sense_id": "885b6a64-70f1-34ff-ba6e-5d6d8a111ecd",
                        "target_lang_word": "kindness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                        "entry_id": "c96eba70-ee76-3630-a286-7398193bcd26",
                                        "glosses": [
                                            "The state of being kind."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b64ef6-5462-418a-8af6-4e71ad930cc9",
                                                "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                                "text": "Jamie's kindness is legendary, so much that people have taken advantage of her."
                                            },
                                            {
                                                "example_id": "f9b2b7d7-ef5b-47b7-8b3a-7ef7986e4d5d",
                                                "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                                "text": "If attending to your childhood wounds and responding with kindness feels selfish, it is important to remember that compassion for oneself often makes people more compassionate to others, Lev said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                        "entry_id": "c96eba70-ee76-3630-a286-7398193bcd26",
                                        "glosses": [
                                            "An instance of kind or charitable behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c828946f-6ab7-4e60-84b3-67ae6975cb42",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "How can I thank you for your many kindnesses?"
                                            },
                                            {
                                                "example_id": "891af2e3-a28b-4c81-bd15-09d0a1fe2f68",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "Do me a kindness and leave."
                                            },
                                            {
                                                "example_id": "bb3885f8-fea5-4449-a2bf-a24340da0ca8",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "i'm going to turn a blind eye to this misdemeanour, out of the kindness of my heart."
                                            },
                                            {
                                                "example_id": "f61e6fa4-502f-4f9e-8b88-d09025a0a72e",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "They are grateful for kindnesses that they may have received."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d3ce451-04bc-4e20-98e2-1178cace7d98",
                        "source_entry_id": "2eef18ca-bdd7-3ca4-8cbf-befa293c4749",
                        "source_sense_id": "885b6a64-70f1-34ff-ba6e-5d6d8a111ecd",
                        "target_lang_word": "vriendelijkheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vriendelijkheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f154784-fcf5-30d5-b5ed-a82a8dcea79f",
                                        "entry_id": "b39ec926-8a56-39a5-9f28-019e041477e8",
                                        "glosses": [
                                            "het vriendelijk zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c18046-2a2b-4385-8806-99d10bbc8201",
                                                "sense_id": "6f154784-fcf5-30d5-b5ed-a82a8dcea79f",
                                                "text": "Ik was overweldigd door hun vrijgevigheid en oprechte vriendelijkheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a39cb6d-a749-4aba-8cbe-8a3b8169fa3a",
                        "source_entry_id": "2eef18ca-bdd7-3ca4-8cbf-befa293c4749",
                        "source_sense_id": "885b6a64-70f1-34ff-ba6e-5d6d8a111ecd",
                        "target_lang_word": "Freundlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freundlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                        "entry_id": "77fb2f66-647b-35a6-b64b-2dda0ca7688f",
                                        "glosses": [
                                            "Liebenswürdigkeit, wohlwollende Geneigtheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65268c1-8194-4a89-8472-f8aab1271292",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "Ich möchte Ihnen danken, denn soviel Freundlichkeit bin ich von Fremden nicht gewohnt."
                                            },
                                            {
                                                "example_id": "d26908f9-5d09-404e-97d5-ef24db5cf62b",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Bald verwandelte sich die Freundlichkeit zu meinem Erstaunen in überschwängliche Vertraulichkeit.“"
                                            },
                                            {
                                                "example_id": "e81d5d6f-a334-4ead-92aa-9525d0fa3e3c",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Er bat schnell den Bekannten, der nicht sehr beglückt schien, um die Freundlichkeit, bei seinem Koffer einen Augenblick zu warten, überblickte noch die Situation, um sich bei der Rückkehr zurechtzufinden, und eilte davon.“"
                                            },
                                            {
                                                "example_id": "88fdef06-b88b-4898-82d9-a2739a8fcf21",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„In ihn hatte ich größeres Vertrauen, und ich beschloss, auf seine Freundlichkeit zu zählen.“"
                                            },
                                            {
                                                "example_id": "1ad64ea1-33cb-4abb-8743-cf531a58353f",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Der Rektor empfing mich mit überströmender Freundlichkeit.“"
                                            },
                                            {
                                                "example_id": "6dcbf7a5-259d-4c4c-9542-75dca622d6b0",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Freundlichkeit heißt, auf andere zuzugehen, ohne ihnen hinterher zu laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
