                    {
                        "sense_id": "66d52880-bb18-3d8f-b85c-71cec2ad5715",
                        "entry_id": "f7662c9e-cf0d-358a-b80d-d10b81658d28",
                        "glosses": [
                            "steppe"
                        ],
