                ],
                "senses": [
                    {
                        "sense_id": "adf1a4d4-c577-36b2-8a16-0bdba7eef09d",
                        "entry_id": "7164f0a3-3e1b-3ffe-aefd-ec0b9105ac49",
                        "glosses": [
                            "In manuscripts (typically before the invention of printing), the note, usually at the end, left by the scribe who copied it, giving information on his exemplar, where and when the copy was made, and sometimes, his own name."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f1804d40-1f76-3d5b-8953-35c27023b118",
                        "entry_id": "7164f0a3-3e1b-3ffe-aefd-ec0b9105ac49",
                        "glosses": [
                            "A printer's or publisher's identifying inscription or logo appearing at the front or end of a book, or the same appearing on the spine or dust jacket."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bd5e107d-5f88-3499-8f82-c7cd7ec6eecd",
                        "entry_id": "7164f0a3-3e1b-3ffe-aefd-ec0b9105ac49",
                        "glosses": [
                            "A page on a website identifying the details of its creation, such as the author's name and the technologies used."
                        ],
                        "tags": [
                            "Internet",
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2294d79a-5b2c-3465-8369-1bb20b190e96",
                        "entry_id": "7164f0a3-3e1b-3ffe-aefd-ec0b9105ac49",
                        "glosses": [
                            "A finishing stroke or crowning touch."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "26242f5a-9026-4e8a-8873-9376819d78a9",
                                "sense_id": "2294d79a-5b2c-3465-8369-1bb20b190e96",
                                "text": "He comes to the creation of man, and makes him the Colophon, or conclusion of all things else."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76b211fb-285f-4697-ba78-fb3f5bf995c5",
                        "source_entry_id": "7164f0a3-3e1b-3ffe-aefd-ec0b9105ac49",
                        "source_sense_description": "end note about author and manuscript",
                        "target_lang_word": "colofon",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colofon",
