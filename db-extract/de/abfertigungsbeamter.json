                "senses": [
                    {
                        "sense_id": "4f420361-708c-315b-b1bb-040b83d1a372",
                        "entry_id": "1cb5b7b0-7128-3326-88e0-c3468af27e93",
                        "glosses": [
                            "Beamter, der für die ordnungsgemäße Abfertigung von Gütern und Personen verantwortlich ist"
                        ],
                        "tags": [
                            "Verkehrswesen",
                            "Zoll"
                        ],
                        "examples": [
                            {
                                "example_id": "b4ac85cb-2a30-4480-9355-f3667854b827",
                                "sense_id": "4f420361-708c-315b-b1bb-040b83d1a372",
                                "text": "Mein Onkel arbeitet am Frankfurter Flughafen; er ist dort Abfertigungsbeamter."
                            },
                            {
                                "example_id": "adcb06c7-02c0-4f01-96cb-1061e6af0c86",
                                "sense_id": "4f420361-708c-315b-b1bb-040b83d1a372",
                                "text": "„Als Zielvorstellungen wurden eine Kostensenkung im Personalbereich des Hauptzollamtes um mehr als 50 v. H. sowie zahlreiche nicht berechenbare Vorteile genannt, vor allem die Beschleunigung der Abfertigung und die Freistellung der Abfertigungsbeamten von routinemäßigen Arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec91300c-0757-426b-81d3-b74cd5908148",
                        "source_entry_id": "1cb5b7b0-7128-3326-88e0-c3468af27e93",
                        "source_sense_id": "4f420361-708c-315b-b1bb-040b83d1a372",
                        "source_sense_description": "Beamter, der für die ordnungsgemäße Abfertigung von Gütern und Personen verantwortlich ist",
                        "target_lang_word": "dispatcher",
                        "target_lang_code": "en",
