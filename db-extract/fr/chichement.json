        "fr-extract.jsonl": [
            {
                "entry_id": "b7b7b3fe-3f6a-3a3e-a50e-4ffbc50eb869",
                "word": "chichement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4dc166b0-6096-30cf-a6a2-9b9933cc067c",
                        "entry_id": "b7b7b3fe-3f6a-3a3e-a50e-4ffbc50eb869",
                        "glosses": [
                            "D’une manière chiche ; avec parcimonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cc57946-f415-49fd-98c6-f9ce77557447",
                                "sense_id": "4dc166b0-6096-30cf-a6a2-9b9933cc067c",
                                "text": "Mais, dans la pratique, celles qu’on appelle des filles-mères sont chichement aidées, tenues en état de mépris et, le plus souvent, jetées à la rue, précipitées aux abîmes."
                            },
                            {
                                "example_id": "460dea7d-db71-4794-aa18-516aed1a33a4",
                                "sense_id": "4dc166b0-6096-30cf-a6a2-9b9933cc067c",
                                "text": "Il n’en distribua d’ailleurs que chichement, à regret."
                            },
                            {
                                "example_id": "e5b07cf0-35a2-4e66-9ded-a650c7dc25e6",
                                "sense_id": "4dc166b0-6096-30cf-a6a2-9b9933cc067c",
                                "text": "Lorsqu'ils se retrouvaient tous les deux, il aurait pu bouder pendant des heures ; mais le temps leur était chichement mesuré."
                            },
                            {
                                "example_id": "2b4f5ce6-d26f-442a-8793-6ba73a08db16",
                                "sense_id": "4dc166b0-6096-30cf-a6a2-9b9933cc067c",
                                "text": "Ensemble, ils vivent chichement, sinon pauvrement."
                            },
                            {
                                "example_id": "38de85d6-04a7-461a-94db-884799ffacb9",
                                "sense_id": "4dc166b0-6096-30cf-a6a2-9b9933cc067c",
                                "text": "Elle vivait chichement dans neuf mètres carrés\nUn meublé cafardeux dans un quartier paumé,\nLui, il avait vingt ans et faisait son sapin\nDans la plate Sologne, près de Romorantin."
                            },
                            {
                                "example_id": "a0307435-1964-4730-be59-7ccf0d0063ce",
                                "sense_id": "4dc166b0-6096-30cf-a6a2-9b9933cc067c",
                                "text": "— Je laisse mon regard errer ailleurs, vers la fenêtre, qui, malgré sa grandeur, illumine chichement la pièce."
                            }
                        ]
                    }
                ],
