                                        "sense_id": "640e7ad4-fa8c-3b73-855c-54452e03f1af",
                                        "entry_id": "e299806c-4494-34eb-a788-dd51c0c0d3d8",
                                        "glosses": [
                                            "To record (activity, or a motion picture) on photographic film."
