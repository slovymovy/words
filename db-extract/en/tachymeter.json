                    },
                    {
                        "translation_id": "62d92aa2-15f3-4937-9c67-094b862aee9e",
                        "source_entry_id": "354a1d14-fb33-3560-a6b1-c1038bd0f4a0",
                        "source_sense_description": "surveying instrument",
