                                "target_senses": [
                                    {
                                        "sense_id": "d0873db6-5c1f-368d-ba18-72d947328eee",
                                        "entry_id": "2b6c7431-d8a3-30f8-aba0-0ed9075f035b",
                                        "glosses": [
                                            "Opium raffiné préparé pour être fumé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a59ce7-b6d1-4fa4-afc2-bb67744d9f1b",
                                                "sense_id": "d0873db6-5c1f-368d-ba18-72d947328eee",
                                                "text": "L’opium que les Chinois ont l’habitude de fumer se nomme chandoo. On le prépare en enlevant la partie interne et molle des morceaux d’opium , et en faisant ramollir la partie externe qu’on passe à travers un morceau de toile."
                                            },
                                            {
                                                "example_id": "5fd3a359-9f5b-4855-a957-d4803c6f8ba1",
                                                "sense_id": "d0873db6-5c1f-368d-ba18-72d947328eee",
                                                "text": "Un bon chandoo se gonfle en une bulle d’une belle teinte ambrée et d’une odeur agréable."
                                            },
                                            {
                                                "example_id": "b820e404-618e-49b7-a789-c5afd50d48f4",
                                                "sense_id": "d0873db6-5c1f-368d-ba18-72d947328eee",
                                                "text": "Le chandoo qui a été fumé peut servir une seconde fois ; on le retire des pipes et il est connu sous le nom de tye-chandoo , ou opium focal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddb8ff53-c62a-4191-9a12-15e7d0f7fc8a",
                        "source_entry_id": "cb72f847-2cef-3371-89d4-70bf287492d8",
                        "source_sense_id": "1df9bec0-56d9-38c9-b1c4-accb64127902",
                        "source_sense_description": "Opium, das so präpariert ist, dass es über Rauchen konsumiert werden kann",
