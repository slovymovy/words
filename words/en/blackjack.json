{
    "word_family": [
        "jack"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79d2e962-e676-3e18-b600-42cf04ac3381",
                    "sense_definition": "A common gambling card game in casinos, where the object is to get as close to 21 without going over.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "card games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists spent the entire evening playing <w>blackjack</w> at the casino.",
                            "target_lang_translations": {
                                "ru": "Туристы провели весь вечер, играя в <w>блэкджек</w> в казино."
                            }
                        },
                        {
                            "text": "He won a large sum of money after a lucky round of <w>blackjack</w>.",
                            "target_lang_translations": {
                                "ru": "Он выиграл крупную сумму денег после удачного раунда в <w>очко</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pontoon",
                        "twenty-one",
                        "vingt-et-un"
                    ],
                    "common_phrases": [
                        "play blackjack",
                        "blackjack table"
                    ],
                    "target_lang_definitions": {
                        "ru": "Популярная азартная карточная игра в казино, целью которой является набор очков, максимально близких к 21, но не превышающих это число."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блэкдже́к",
                                "target_lang_sense_clarification": "название игры в казино"
                            },
                            {
                                "target_lang_word": "два́дцать одно́",
                                "target_lang_sense_clarification": "традиционное название игры"
                            },
                            {
                                "target_lang_word": "очко́",
                                "target_lang_sense_clarification": "разговорное название игры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6ebd420-71e6-33e2-99f7-b1353d4bf1f9",
                    "sense_definition": "A hand in the game of blackjack consisting of a face card and an ace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "card games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dealer paid out three to two because the player had a <w>blackjack</w>.",
                            "target_lang_translations": {
                                "ru": "Дилер выплатил выигрыш три к двум, потому что у игрока был <w>блэкджек</w>."
                            }
                        },
                        {
                            "text": "Getting a <w>blackjack</w> on the first deal is the best way to start the game.",
                            "target_lang_translations": {
                                "ru": "Получить <w>двадцать одно</w> при первой раздаче — лучший способ начать игру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "natural blackjack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Комбинация карт в игре блэкджек, состоящая из туза и карты достоинством в 10 очков (картинки или десятки)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блэкдже́к",
                                "target_lang_sense_clarification": "выигрышная комбинация карт"
                            },
                            {
                                "target_lang_word": "два́дцать одно́",
                                "target_lang_sense_clarification": "максимальное количество очков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d028e0c9-44c6-3d02-ace1-092a34b2481a",
                    "sense_definition": "A small, flat, blunt, usually leather-covered weapon loaded with heavy material such as lead, used to knock someone unconscious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weapons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective found a leather <w>blackjack</w> hidden in the suspect's coat pocket.",
                            "target_lang_translations": {
                                "ru": "Детектив нашел кожаную <w>дубинку</w>, спрятанную в кармане пальто подозреваемого."
                            }
                        },
                        {
                            "text": "The guard was struck with a <w>blackjack</w> and fell to the floor instantly.",
                            "target_lang_translations": {
                                "ru": "Охранника ударили <w>кистенем</w>, и он мгновенно упал на пол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leather blackjack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое, плоское, тупое оружие, обычно обтянутое кожей и наполненное тяжелым материалом, таким как свинец, используемое для оглушения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуби́нка",
                                "target_lang_sense_clarification": "короткая и гибкая"
                            },
                            {
                                "target_lang_word": "кисте́нь",
                                "target_lang_sense_clarification": "небольшое ударное оружие"
                            },
                            {
                                "target_lang_word": "блэкдже́к",
                                "target_lang_sense_clarification": "вид полицейской или бандитской дубинки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21baa1bc-22e7-3c12-a8dc-7cef246f753b",
                    "sense_definition": "A common name for the <w>blackjack oak</w>, a small oak tree of the southeastern United States.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry ridge was covered in a thick growth of stunted <w>blackjacks</w>.",
                            "target_lang_translations": {
                                "ru": "Сухой гребень был покрыт густыми зарослями низкорослых <w>мариландских дубов</w>."
                            }
                        },
                        {
                            "text": "A little creek ran through the land with nothing but <w>blackjacks</w> for miles around.",
                            "target_lang_translations": {
                                "ru": "Через участок протекал небольшой ручей, а вокруг на мили не было ничего, кроме <w>дубов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blackjack oak"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обиходное название дуба мариландского (Quercus marilandica), небольшого дуба, произрастающего на юго-востоке США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуб марила́ндский",
                                "target_lang_sense_clarification": "ботаническое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10350ff6-3b96-31eb-9819-e2b87ad62806",
                    "sense_definition": "The flag traditionally flown by pirate ships, often featuring a white skull and crossbones on a black field.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flags",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirate ship hoisted the <w>blackjack</w> as it approached the merchant vessel.",
                            "target_lang_translations": {
                                "ru": "Пиратский корабль поднял <w>Весёлого Роджера</w>, приближаясь к торговому судну."
                            }
                        },
                        {
                            "text": "Legend says the <w>blackjack</w> was meant to strike fear into the hearts of sailors.",
                            "target_lang_translations": {
                                "ru": "Легенда гласит, что <w>пиратский флаг</w> должен был вселять страх в сердца моряков."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционный флаг пиратских кораблей, обычно с изображением белого черепа и скрещенных костей на черном фоне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Весёлый Ро́джер",
                                "target_lang_sense_clarification": "традиционное название пиратского флага"
                            },
                            {
                                "target_lang_word": "пира́тский флаг",
                                "target_lang_sense_clarification": "общее описание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbb66ed4-c77d-364b-8409-2b8c451897b2",
                    "sense_definition": "Any of a series of hard, dark clay soils, often considered low quality but suitable for certain crops.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "soil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cotton grew robustly in the local <w>blackjack</w> soil despite its high clay content.",
                            "target_lang_translations": {
                                "ru": "Хлопок бурно рос на местной <w>глинистой почве</w>, несмотря на высокое содержание глины."
                            }
                        },
                        {
                            "text": "The farmer struggled to plow the heavy <w>blackjack</w> during the dry season.",
                            "target_lang_translations": {
                                "ru": "Фермер с трудом пахал тяжелый <w>солончак</w> в засушливый сезон."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blackjack soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип тяжелой, темной глинистой почвы, часто считающейся низкокачественной, но подходящей для определенных культур."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжёлая гли́нистая по́чва",
                                "target_lang_sense_clarification": "описание состава"
                            },
                            {
                                "target_lang_word": "солонча́к",
                                "target_lang_sense_clarification": "в некоторых контекстах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9ca43e9-892d-38cf-9d15-29d26957df4e",
                    "sense_definition": "To strike someone with a blackjack or a similar blunt weapon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief tried to <w>blackjack</w> the night watchman from behind.",
                            "target_lang_translations": {
                                "ru": "Вор попытался <w>оглушить дубинкой</w> ночного сторожа сзади."
                            }
                        },
                        {
                            "text": "He was <w>blackjacked</w> and bound before he could call for help.",
                            "target_lang_translations": {
                                "ru": "Его <w>ударили по голове</w> и связали прежде, чем он успел позвать на помощь."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-либо блэкджеком или подобным тупым оружием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́рить дуби́нкой",
                                "target_lang_sense_clarification": "оглушить оружием"
                            },
                            {
                                "target_lang_word": "оглуши́ть",
                                "target_lang_sense_clarification": "ударом по голове"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c54ca800-2e9d-31f6-b14b-e24d85063e00",
                    "sense_definition": "A dedicated fan of the South Korean girl group 2NE1.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fandom",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Thousands of <w>Blackjacks</w> gathered at the airport to welcome the group.",
                            "target_lang_translations": {
                                "ru": "Тысячи <w>Блэкджеков</w> собрались в аэропорту, чтобы поприветствовать группу."
                            }
                        },
                        {
                            "text": "As a loyal <w>Blackjack</w>, she has every single one of their albums.",
                            "target_lang_translations": {
                                "ru": "Как преданная <w>фанатка</w>, она купила все их альбомы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "K-pop fandom slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преданный поклонник южнокорейской женской группы 2NE1."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блэкдже́к",
                                "target_lang_sense_clarification": "название фандома группы 2NE1"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}