                                "sense_id": "ac291408-ce8e-3cad-ac8b-4bf91652dc3d",
                                "text": "„Die Narkotiseurin, Frau Dr. Ute Kämpfert-Mohn, gab schon vermehrt Sauerstoff, um die Patientin aus der Narkose herauszuführen.“"
                            },
                            {
                                "example_id": "96dee7b7-7070-45ee-b5ea-6c1ed52c4021",
                                "sense_id": "ac291408-ce8e-3cad-ac8b-4bf91652dc3d",
                                "text": "Die Narkotiseurin muss dem Operierenden wichtige Veränderungen mitteilen."
                            }
