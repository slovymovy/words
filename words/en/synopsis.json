    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "680e643e-695c-360b-859b-72f7b1ba9d4f",
                    "sense_definition": "A brief summary of the major points of a written work, such as a book, play, or film.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author provided a brief <w>synopsis</w> of the plot on the back cover of the book.",
                            "target_lang_translations": {
                                "ru": "Автор представил краткий <w>синопсис</w> сюжета на задней обложке книги."
                            }
                        },
                        {
                            "text": "Before the meeting, please read the brief <w>synopsis</w> to understand the main arguments of the proposal.",
                            "target_lang_translations": {
                                "ru": "Перед встречей, пожалуйста, прочитайте краткое <w>описание</w>, чтобы понять основные аргументы предложения."
                            }
                        }
                    ],
                    "synonyms": [
                        "abridgment",
                        "abstract",
                        "outline",
                        "overview",
                        "summary"
                    ],
                    "common_phrases": [
                        "brief synopsis",
                        "plot synopsis",
                        "provide a synopsis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое изложение основных положений литературного произведения, такого как книга, пьеса или фильм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синопсис",
                                "target_lang_sense_clarification": "сценария или книги"
                            },
                            {
                                "target_lang_word": "краткое описание",
                                "target_lang_sense_clarification": "сюжета"
                            },
                            {
                                "target_lang_word": "резюме",
                                "target_lang_sense_clarification": "краткий вывод или суть"
                            },
                            {
                                "target_lang_word": "конспект",
                                "target_lang_sense_clarification": "краткое изложение содержания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88f8f8cb-121b-3617-9437-9a1c6d2105d7",
                    "sense_definition": "A reference work or document containing brief articles that together provide an overview of an entire field of study.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This medical <w>synopsis</w> offers a comprehensive look at all known treatments for the disease.",
                            "target_lang_translations": {
                                "ru": "Этот медицинский <w>обзор</w> предлагает всесторонний взгляд на все известные методы лечения данного заболевания."
                            }
                        },
                        {
                            "text": "The professor recommended a <w>synopsis</w> of historical events to help the students prepare for the exam.",
                            "target_lang_translations": {
                                "ru": "Профессор рекомендовал <w>конспект</w> исторических событий, чтобы помочь студентам подготовиться к экзамену."
                            }
                        }
                    ],
                    "synonyms": [
                        "conspectus",
                        "overview"
                    ],
                    "common_phrases": [
                        "comprehensive synopsis",
                        "historical synopsis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Справочное издание или документ, содержащий краткие статьи, которые в совокупности дают обзор целой области знаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синопсис",
                                "target_lang_sense_clarification": "сводный обзор области знаний"
                            },
                            {
                                "target_lang_word": "краткий обзор",
                                "target_lang_sense_clarification": "общий взгляд на предмет"
                            },
                            {
                                "target_lang_word": "обозрение",
                                "target_lang_sense_clarification": "систематизированный обзор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25c3fa80-75c1-386d-afc0-0f91f60994e4",
                    "sense_definition": "A specific type of prayer book intended for use by the laity within certain Christian church traditions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly woman carried her well-worn <w>synopsis</w> to the morning service every Sunday.",
                            "target_lang_translations": {
                                "ru": "Пожилая женщина каждое воскресенье приносила свой потрёпанный <w>синопсис</w> на утреннюю службу."
                            }
                        },
                        {
                            "text": "Scholars studied the ancient <w>synopsis</w> to understand the liturgical practices of the lay people.",
                            "target_lang_translations": {
                                "ru": "Ученые изучали древний <w>синопсис</w>, чтобы понять литургические практики мирян."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "religious context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый тип молитвенника, предназначенный для использования мирянами в определенных христианских церковных традициях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синопсис",
                                "target_lang_sense_clarification": "вид молитвенника для мирян"
                            }
                        ]
                    }
                }
            ]
        }
    ]
