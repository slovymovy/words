            "senses": [
                {
                    "sense_id": "e67f55cf-f7e4-3d3e-af1b-8ef1fc1dd585",
                    "sense_definition": "Langes, schmales Tuch aus Wolle oder Stoff, das wärmend oder als modisches Accessoire um Hals oder Schultern getragen wird.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleidung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im kalten Winter trage ich immer einen dicken <w>Schal</w> aus Wolle."
                        },
                        {
                            "text": "Sie band sich vor dem Verlassen des Hauses einen bunten <w>Schal</w> um den Hals."
                        }
                    ],
                    "synonyms": [
                        "Tuch"
                    ],
                    "common_phrases": [
                        "einen Schal tragen",
                        "einen Schal umbinden",
                        "einen warmen Schal"
                    ]
                },
                {
                    "sense_id": "216c05ee-7df0-3d3d-a876-337bb1969a2e",
                    "sense_definition": "Lange, schmale Stoffbahn, die als Ziergardine seitlich an Fenstern herabhängt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wohnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die hohen Fenster im Wohnzimmer waren mit schweren roten <w>Schals</w> dekoriert."
                        },
                        {
                            "text": "Zur Renovierung wählte sie elegante seidene <w>Schals</w> als Übergardinen aus."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9e36ced7-ab9a-3dda-af0e-e754d7158589",
                    "sense_definition": "Von Speisen oder Getränken: nicht mehr frisch, ohne Aroma oder Kohlensäure; abgestanden schmeckend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geschmack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn die Flasche zu lange geöffnet herumsteht, wird das Bier schnell <w>schal</w>."
                        },
                        {
                            "text": "Das Mineralwasser schmeckte nach einigen Stunden in der Sonne völlig <w>schal</w>."
                        }
                    ],
                    "synonyms": [
                        "abgestanden"
                    ],
                    "antonyms": [
                        "frisch"
                    ],
                    "common_phrases": [
                        "schales Bier",
                        "schal werden",
                        "schal schmecken"
                    ]
                },
                {
                    "sense_id": "a508a503-3382-38b0-8f39-61cb79ce04d3",
                    "sense_definition": "Im übertragenen Sinne: ohne geistigen Gehalt, fade und unbefriedigend; ernüchternd oder langweilig wirkend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "charakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die unüberlegten Ausreden des Politikers hinterließen bei den Bürgern einen <w>schalen</w> Beigeschmack."
                        },
                        {
                            "text": "Die Witze des Moderators wirkten auf das Publikum am Ende ziemlich <w>schal</w> und abgedroschen."
                        }
                    ],
                    "antonyms": [
                        "geistvoll"
                    ],
                    "common_phrases": [
                        "einen schalen Beigeschmack hinterlassen"
                    ],
                    "synonyms": [
                        "fad"
                    ]
                }
            ]
        }
    ]
