                                "target_senses": [
                                    {
                                        "sense_id": "60ebedd8-8279-38eb-b0be-629634cf8ec6",
                                        "entry_id": "c6143724-e19e-3aa0-b86e-2c9f1ccc5129",
                                        "glosses": [
                                            "die Kelten betreffend, zu den Kelten gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebdc7d6d-8848-40c7-a701-58b427a113e9",
                                                "sense_id": "60ebedd8-8279-38eb-b0be-629634cf8ec6",
                                                "text": "„Keltische Kriegerscharen fielen, von Gallien kommend, in Italien ein, die Römer stellten sich ihnen in der Schlacht an der Allia und erlitten eine katastrophale Niederlage.“"
                                            },
                                            {
                                                "example_id": "846c6df3-9d5a-44fd-9779-452ccf870420",
                                                "sense_id": "60ebedd8-8279-38eb-b0be-629634cf8ec6",
                                                "text": "„Auch treibt sich da ein gewisses keltisches Element herum zwischen den Anoraks und Fellmützen - lange Nasen - häufiger dabei in den Gesichtern von Frauen.“"
                                            },
                                            {
                                                "example_id": "7f4f72c7-5df1-4ad4-91e5-687ab0887b13",
                                                "sense_id": "60ebedd8-8279-38eb-b0be-629634cf8ec6",
                                                "text": "„Zwar gab es Aufstände gegen die Fremden, und im gebirgigen Norden und Westen des Landes lebte die keltische Kultur ungebrochen weiter.“"
                                            },
                                            {
                                                "example_id": "14b625d2-29ef-4d68-b62f-0273b02c5072",
                                                "sense_id": "60ebedd8-8279-38eb-b0be-629634cf8ec6",
                                                "text": "„Im Altmühltal zwischen Kelheim und Dietfurt wurden so viele keltische Funde ausgegraben, dass daraus ein Archäologie-Park entstand.“"
                                            },
                                            {
                                                "example_id": "f4d64ef4-cfa8-45d9-ae53-98377b51cdfb",
                                                "sense_id": "60ebedd8-8279-38eb-b0be-629634cf8ec6",
                                                "text": "„Die keltischen Stämme in den verschiedenen Gegenden Europas verwendeten dieselben Wörter, und die keltischen Ortsnamen weisen oft dieselben Endungen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90faafb3-c19f-3797-8eba-8cb0c8801c83",
                                        "entry_id": "c6143724-e19e-3aa0-b86e-2c9f1ccc5129",
                                        "glosses": [
                                            "keine Steigerung: die keltischen Sprachen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
