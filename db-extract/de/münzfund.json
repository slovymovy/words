                "senses": [
                    {
                        "sense_id": "b88c1045-91fd-358c-ae55-53a531988778",
                        "entry_id": "f2abd2de-3ad8-3fb3-af45-4f0bcb47d793",
                        "glosses": [
                            "das Finden von alten Münzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214a4f5c-a7c8-4024-8c56-2d3584a8416c",
                                "sense_id": "b88c1045-91fd-358c-ae55-53a531988778",
                                "text": "„Im Neuen Turm des Gotischen Hauses zu Wörlitz haben Handwerker einen erstaunlichen Münzfund gemacht.“"
                            },
                            {
                                "example_id": "d2f60297-22f7-485d-9af2-20ad9c8b1849",
                                "sense_id": "b88c1045-91fd-358c-ae55-53a531988778",
                                "text": "„Die Experten des Archäologischen Museums Hamburg haben den Münzfund nun wissenschaftlich ausgewertet und präsentieren ihre Ergebnisse im Rahmen einer Sonderausstellung.“"
                            },
                            {
                                "example_id": "832afd78-1c18-47ac-ad77-48e913e4f109",
                                "sense_id": "b88c1045-91fd-358c-ae55-53a531988778",
                                "text": "„Dies ist besonders durch Münzfunde mit griechischen Inschriften, griechische Namen der Herrscher wie auch im Einfluss griechischer Stilelemente in der Kunst der folgenden Reiche belegt.“"
                            },
                            {
                                "example_id": "77f7d2ae-3d2a-4815-b82d-f1852d9f1ce4",
                                "sense_id": "b88c1045-91fd-358c-ae55-53a531988778",
                                "text": "„Zum Dorf Montrecy gehört eine Wiese, berühmt durch Münzfunde, die man einst dort gemacht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
