                ],
                "senses": [
                    {
                        "sense_id": "07dcc5dd-ab3a-3d52-ad08-41da63de1faf",
                        "entry_id": "a0e5f83b-d593-3245-8f0d-17f340135e3d",
                        "glosses": [
                            "bis in die Poren (der Haut oder eines Gegenstandes) eindringend und wirksam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c107d1a-f803-4e71-839c-f6872d380998",
                                "sense_id": "07dcc5dd-ab3a-3d52-ad08-41da63de1faf",
                                "text": "„Kochlöffel, Fleischklopfer und andere Holzutensilien können auf die gleiche Weise porentief gereinigt werden.“"
                            },
                            {
                                "example_id": "02a51ee0-afe7-4b97-95c8-11b43f249fc9",
                                "sense_id": "07dcc5dd-ab3a-3d52-ad08-41da63de1faf",
                                "text": "„Gesichtsreinigungsprodukte, die den Talg porentief entfernen, schaden mehr, als sie nützen.“"
                            },
                            {
                                "example_id": "c13cbd38-f1fc-40e8-bad6-bbfc85ef6411",
                                "sense_id": "07dcc5dd-ab3a-3d52-ad08-41da63de1faf",
                                "text": "„Die Haut wird von Unreinheiten befreit und porentief gereinigt, sie wird optimal durchblutet und der Teint ist danach wieder frisch, gesund und rosig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
