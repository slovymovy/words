                ],
                "senses": [
                    {
                        "sense_id": "2021ebb1-93a9-3ea0-8a54-4ab7e2529c20",
                        "entry_id": "c0374b1d-7b30-3283-887c-da2a8757ef30",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e003c6-204c-41a2-9c50-1a64ef10e2b4",
                                "sense_id": "2021ebb1-93a9-3ea0-8a54-4ab7e2529c20",
                                "text": "Frau Gröber ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2730a2f2-1e8a-4c6c-93e5-9b670fb1ed1c",
                                "sense_id": "2021ebb1-93a9-3ea0-8a54-4ab7e2529c20",
                                "text": "Herr Gröber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "282b575a-efd8-4ee2-9eab-33918cac9ebb",
                                "sense_id": "2021ebb1-93a9-3ea0-8a54-4ab7e2529c20",
                                "text": "Die Gröbers fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "6a287cb5-2dce-49bc-b557-fe63bce52a03",
                                "sense_id": "2021ebb1-93a9-3ea0-8a54-4ab7e2529c20",
                                "text": "Der Gröber trägt nie die Pullover, die die Gröber ihm strickt."
                            },
                            {
                                "example_id": "aea79313-7a53-4c84-bc5f-329b9f3a5217",
                                "sense_id": "2021ebb1-93a9-3ea0-8a54-4ab7e2529c20",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gröber kommt, geht der Herr Gröber.“"
                            },
                            {
                                "example_id": "5de962d2-9307-4116-b42a-9059247e9702",
                                "sense_id": "2021ebb1-93a9-3ea0-8a54-4ab7e2529c20",
                                "text": "Gröber kommt und geht."
                            },
                            {
                                "example_id": "e42e5b2e-aded-4d7e-8c8b-58f046bda6e0",
                                "sense_id": "2021ebb1-93a9-3ea0-8a54-4ab7e2529c20",
                                "text": "Gröbers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
