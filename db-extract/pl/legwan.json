                                "target_senses": [
                                    {
                                        "sense_id": "bae2e6ee-2566-302c-93d3-a518dcdcacd6",
                                        "entry_id": "5068cb8d-4820-3081-8d0a-cf579c7699bc",
                                        "glosses": [
                                            "hauptsächlich in Amerika vorkommende Echse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf8333b6-996b-4882-b457-6787f6b1c2a0",
                                                "sense_id": "bae2e6ee-2566-302c-93d3-a518dcdcacd6",
                                                "text": "Sie hatten ein Terrarium für den grünen Leguan gebaut."
                                            }
