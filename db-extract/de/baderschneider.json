                ],
                "senses": [
                    {
                        "sense_id": "6e3eb36e-a358-3a4f-8029-3872af347bfd",
                        "entry_id": "d78af871-117b-34fe-9794-c7ec62208dba",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb0f3d3-47a7-4f53-b55f-667c53885f23",
                                "sense_id": "6e3eb36e-a358-3a4f-8029-3872af347bfd",
                                "text": "Herr Baderschneider wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5dccb038-464c-4085-9593-32d21d4fac47",
                                "sense_id": "6e3eb36e-a358-3a4f-8029-3872af347bfd",
                                "text": "Die Baderschneiders fliegen heute nach Stockholm."
                            },
                            {
                                "example_id": "8cfb54a9-94ad-4859-ab46-e1b5aea48e31",
                                "sense_id": "6e3eb36e-a358-3a4f-8029-3872af347bfd",
                                "text": "Der Baderschneider trägt nie die Pullover, die die Baderschneider ihm strickt."
                            },
                            {
                                "example_id": "a8ca04ca-1da0-48f9-91bd-d56b14a37e71",
                                "sense_id": "6e3eb36e-a358-3a4f-8029-3872af347bfd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baderschneider kommt, geht der Herr Baderschneider.“"
                            },
                            {
                                "example_id": "805b9b14-094f-4b17-ab5a-25bd757afb55",
                                "sense_id": "6e3eb36e-a358-3a4f-8029-3872af347bfd",
                                "text": "Baderschneider kommt und geht."
                            },
                            {
                                "example_id": "92a4ab14-23be-43b6-b63e-b619934de64b",
                                "sense_id": "6e3eb36e-a358-3a4f-8029-3872af347bfd",
                                "text": "Baderschneiders kamen, sahen und siegten."
                            },
                            {
                                "example_id": "045d898a-d8c4-4ba1-af28-9cb4c1c8ca69",
                                "sense_id": "6e3eb36e-a358-3a4f-8029-3872af347bfd",
                                "text": "Frau Baderschneider ist ein Genie im Verkauf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
