                    "frequency": "Middle",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We planted a <w>lemon</w> in the backyard, hoping for fruit next year.",
                            "target_lang_translations": {
                                "ru": "Мы посадили <w>лимон</w> на заднем дворе, надеясь на плоды в следующем году."
                            }
