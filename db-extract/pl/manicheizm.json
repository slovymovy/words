                                "example_id": "46e775c6-b9ab-48f1-9f41-9e5466d702c8",
                                "sense_id": "50ed08ff-270e-35db-9cae-da251291c53e",
                                "text": "Podstawowym elementem manicheizmu jest dualizm."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a2c76c3-f119-405f-9f7a-db84a179171f",
