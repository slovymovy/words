                    },
                    {
                        "sense_id": "8f8b4769-e6a5-3d58-b910-3c451d2195ac",
                        "entry_id": "ef18bfe4-70a3-37a7-b5a5-069d9a70fb8a",
                        "glosses": [
                            "wodoszczelny, pusty przedział na statku, zwykle oddzielający zbiorniki płynów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "406f2823-27cd-4ae4-a149-708edf477edc",
                        "source_entry_id": "ef18bfe4-70a3-37a7-b5a5-069d9a70fb8a",
                        "source_sense_id": "3e8da667-380e-3d12-9ad7-29195f58acc3",
                        "target_lang_word": "Deich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "864f21b4-4ed0-3fa8-89db-2562b2e528eb",
                                        "entry_id": "b2787d6b-9062-319d-9222-433d3b589cd3",
                                        "glosses": [
                                            "Damm an Gewässern (wie beispielsweise Flüssen, den Küsten) zum Schutz vor Hochwasser und Sturmfluten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38d6d8de-c3c0-4ca6-b6df-80fdfd8b2585",
                                                "sense_id": "864f21b4-4ed0-3fa8-89db-2562b2e528eb",
                                                "text": "„Zum typischen Bild von Norddeutschland gehören die Deiche.“"
                                            },
                                            {
                                                "example_id": "d55bd908-5813-4779-b915-3da4bc515c5e",
                                                "sense_id": "864f21b4-4ed0-3fa8-89db-2562b2e528eb",
                                                "text": "„Wie wichtig der Küstenschutz durch Deiche ist, zeigt sich bei Ebbe.“"
                                            },
                                            {
                                                "example_id": "5daf8006-f974-44c7-ae0a-09578d89811c",
                                                "sense_id": "864f21b4-4ed0-3fa8-89db-2562b2e528eb",
                                                "text": "„Es werden nicht nur einfach künstliche Dämme aufgeschüttet, heutige Deiche sind ein ausgeklügeltes System.“"
                                            },
                                            {
                                                "example_id": "a0afb37b-065e-46f0-8c88-5fedc30f7c45",
                                                "sense_id": "864f21b4-4ed0-3fa8-89db-2562b2e528eb",
                                                "text": "„Um die Wellen zu brechen, liegt vor dem Deich das Vorland.“"
                                            },
                                            {
                                                "example_id": "f88a5318-bf09-4afb-a830-6db60576a265",
                                                "sense_id": "864f21b4-4ed0-3fa8-89db-2562b2e528eb",
                                                "text": "„Damit die Küsten Norddeutschlands sicher bleiben, müssen die Deiche stetig kontrolliert und ausgebessert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69c69b03-88a4-4c19-8cfa-dcc652ddddb1",
                        "source_entry_id": "ef18bfe4-70a3-37a7-b5a5-069d9a70fb8a",
