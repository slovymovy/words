                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76173a95-3ea6-4c36-9375-cfdd6b07d66a",
                                "sense_id": "0038ca21-5049-3c3d-bdb3-500c2301b2e7",
                                "text": "W salonach dominują modele z turbodoładowanymi jednostkami napędowymi, zaś silniki wolnossące powoli odchodzą do lamusa."
                            },
