                                        "entry_id": "fc0ece42-2175-354b-ae3f-30be6ba957f9",
                                        "glosses": [
                                            "Maßnahmen zur Umstellung der Wirtschaft mit dem Ziel der Verminderung kohlenstoffhaltiger Emissionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45706187-10aa-4e99-aa98-e1937b34a15b",
                                                "sense_id": "12138f26-c9fb-3650-abbb-03346949d941",
                                                "text": "„Die Dekarbonisierung des Straßenverkehrs ist eine langfristige Kraftanstrengung.“"
                                            },
                                            {
                                                "example_id": "c7608696-a738-4f97-a561-536a8a2cb39c",
                                                "sense_id": "12138f26-c9fb-3650-abbb-03346949d941",
                                                "text": "„Die Zeit also drängt, um in die Wege zu leiten, was ansteht: die Dekarbonisierung der Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "d124b072-fea2-48c9-bb42-55d178057097",
                                                "sense_id": "12138f26-c9fb-3650-abbb-03346949d941",
                                                "text": "„Unterstützen soll“ [der Bund] „mit dem Geld Projekte für die Dekarbonisierung von Verkehr, Gebäuden und Wirtschaft.“"
                                            },
                                            {
                                                "example_id": "5ba94195-f730-4fb2-ab3c-f747317a7353",
                                                "sense_id": "12138f26-c9fb-3650-abbb-03346949d941",
                                                "text": "„»Die notwendige umfassende Dekarbonisierung verläuft einfach zu langsam«,“ […]."
                                            }
