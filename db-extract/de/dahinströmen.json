                ],
                "senses": [
                    {
                        "sense_id": "7ed13921-de8d-3d83-bdd6-d61010a9325e",
                        "entry_id": "d1ac18cb-3d21-388d-8aa0-c5674c97a83b",
                        "glosses": [
                            "gemächlich, frei vor sich hin fließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71f1567e-6e2e-4d37-b77b-34ea757db1bb",
                                "sense_id": "7ed13921-de8d-3d83-bdd6-d61010a9325e",
                                "text": "„So wie ein Fluss dahinströmt, genauso lass den Verstand ungehindert dahinströmen.“"
                            },
                            {
                                "example_id": "5f345371-327a-4cfa-9c51-6a4f2348dd7b",
                                "sense_id": "7ed13921-de8d-3d83-bdd6-d61010a9325e",
                                "text": "„Am Ende der Diluvialzeit sehen wir in den Thälern gewaltige Wassermassen dahinströmen.“"
                            },
                            {
                                "example_id": "4db6bb31-1069-4574-ab4b-1316c1d8c49c",
                                "sense_id": "7ed13921-de8d-3d83-bdd6-d61010a9325e",
                                "text": "„Lichtkünstler lassen die Flüsse in grellen Farben dahinströmen ein vorweihnachtlicher Kindertraum, auch für Erwachsene.“"
                            },
                            {
                                "example_id": "4c422486-9f27-45ba-833e-24570df5c54f",
                                "sense_id": "7ed13921-de8d-3d83-bdd6-d61010a9325e",
                                "text": "„Es ist charakteristisch für die nordischen Flüsse, dass sie meilenweit ruhig dahinströmen, so dass ein einzelner Schiffer ohne Anstrengung einen Kahn gegen den Strom rudert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
