                        "entry_id": "a9451f26-76f6-3d2f-b280-fc989564c332",
                        "glosses": [
                            "Foreordained, predetermined, established in advance by fate."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "59babab6-15eb-4ea0-932f-0b344aebe498",
                                "sense_id": "e736f779-f625-3a5f-80c3-0368b835c6a2",
                                "text": "This scheme was fated to be forgotten, at any rate in the form of the 1820 proposal."
                            },
                            {
                                "example_id": "28c43442-cdac-4fe1-83a1-7e561feb0bc2",
                                "sense_id": "e736f779-f625-3a5f-80c3-0368b835c6a2",
                                "text": "Kristi Noem[…] may have committed a class two misdemeanor offence when her fated dog Cricket, a 14-month-old wirehair pointer Noem deemed “untrainable” for hunting pheasant, killed a neighbor’s chickens."
                            }
                        ]
                    }
