                ],
                "senses": [
                    {
                        "sense_id": "701e7b60-7bc3-32e3-87fc-ce713a86e55e",
                        "entry_id": "3479fbd7-f190-3547-a8eb-5ef15dc9005f",
                        "glosses": [
                            "Mouvoir deçà et delà, balancer."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d89b19bc-7676-424f-b1b6-4d9af0a44631",
                                "sense_id": "701e7b60-7bc3-32e3-87fc-ce713a86e55e",
                                "text": "Brandiller les jambes."
                            },
                            {
                                "example_id": "b512542f-1195-49db-872b-e304eee66677",
                                "sense_id": "701e7b60-7bc3-32e3-87fc-ce713a86e55e",
                                "text": "Brandiller les bras."
                            },
                            {
                                "example_id": "a1188d2f-b35f-4215-8dc5-10da0f3d236c",
                                "sense_id": "701e7b60-7bc3-32e3-87fc-ce713a86e55e",
                                "text": "– […] Il brandille à Montfaucon, au bout d’une chaîne de fer, en attendant que sa carcasse déchiquetée des oiseaux tombe en la fosse du gibet, sur les ossements des camarades qui l’ont précédé."
                            },
                            {
                                "example_id": "a5dd6754-5bb4-48ce-8d14-aaf6f02cba1b",
                                "sense_id": "701e7b60-7bc3-32e3-87fc-ce713a86e55e",
                                "text": "Contre le vent et la pluie continuelle, beaucoup de maisons sont caparaçonnées d’ardoises, flancs et toitures ; ces ardoises demi-cassées, moussues, brandillent, et la maison a l’air d’un lézard demi-écaillé."
                            },
                            {
                                "example_id": "dea1d74a-4411-4061-b35b-182061b5ddf2",
                                "sense_id": "701e7b60-7bc3-32e3-87fc-ce713a86e55e",
                                "text": "Sous escorte, les villageois allèrent contempler ceux des leurs qui gisaient dans les fossés ou brandillaient sous les arbres."
                            },
                            {
                                "example_id": "1bdd5dcc-85cf-4753-8293-fe165c323384",
                                "sense_id": "701e7b60-7bc3-32e3-87fc-ce713a86e55e",
                                "text": "Tout aurait été silence hormis ce halètement lancinant du vent, hormis le gémissement de quelque ferrure qui brandillait."
                            }
                        ]
                    },
                    {
                        "sense_id": "16bac4d5-2982-3ddc-9145-3e32bc2b2ccf",
                        "entry_id": "3479fbd7-f190-3547-a8eb-5ef15dc9005f",
                        "glosses": [
                            "Se mouvoir deçà, delà."
                        ],
                        "tags": [
                            "dated",
                            "intransitive"
                        ],
                        "examples": []
                    }
