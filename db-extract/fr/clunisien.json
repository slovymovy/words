                "senses": [
                    {
                        "sense_id": "099c1e7d-71dd-3a9b-bd41-55b6f8a5b96b",
                        "entry_id": "4b7752ac-c3c6-377e-b4a0-025f2bb940dd",
                        "glosses": [
                            "Relatif à l’ordre monastique chrétien, défini à l’abbaye de Cluny."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d2c4046-6250-42e9-a4c3-ec161514a063",
                                "sense_id": "099c1e7d-71dd-3a9b-bd41-55b6f8a5b96b",
                                "text": "Le rayonnement clunisien sur la chrétienté au Moyen-Âge."
                            },
                            {
                                "example_id": "d80445b5-b4a0-4da2-9b06-75885131e3d6",
                                "sense_id": "099c1e7d-71dd-3a9b-bd41-55b6f8a5b96b",
                                "text": "La première conséquence de l’entrée des peuples nordiques dans la communauté des peuples chrétiens, dans la civilisation européenne, fut que, si tu te rappelles, durant deux siècles — en l’occurrence aux Xᵉ et XIᵉ siècles, l’époque de la réforme clunisienne —, il n’a été question que de la mort."
                            },
                            {
                                "example_id": "ccf41147-efeb-443c-97a4-97a2e958c5f2",
                                "sense_id": "099c1e7d-71dd-3a9b-bd41-55b6f8a5b96b",
                                "text": "Passant par notre maison ou celle de Rémi, elle n’avait que la rue à traverser pour gagner l’église où, depuis sa mise en retraite, elle avait entrepris de tout réorganiser dans un esprit clunisien."
                            }
                        ]
                    }
                ],
