                    {
                        "translation_id": "04332119-74e0-4633-8c4a-ddea130a9c01",
                        "source_entry_id": "51bcdca0-d3cb-3460-b007-9ed1e5e08f49",
                        "source_sense_id": "26953e4e-2e58-3ac7-8a5a-c1849cffd3ba",
                        "source_sense_description": "veraltet: streuen",
                        "target_lang_word": "streuen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "streuen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7882962-115f-3ec5-9bc1-1eae4633f22b",
                                        "entry_id": "7ca03ac1-94ed-3888-a9b7-847e35d32a56",
                                        "glosses": [
                                            "(pulvrige oder körnige Substanz) werfen, damit sie sich auf einer Fläche verteilt"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce5170d-b90b-4ae2-9606-2fc79400920a",
                                                "sense_id": "c7882962-115f-3ec5-9bc1-1eae4633f22b",
                                                "text": "Im Winter streuen die Anwohner Tausalz oder Split auf den Gehweg, damit niemand ausrutscht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6270e414-660e-31cb-b00d-dff48f2736fc",
                                        "entry_id": "7ca03ac1-94ed-3888-a9b7-847e35d32a56",
                                        "glosses": [
                                            "ablenken eines Teils einer (gebündelten) Strahlung aus der ursprünglichen Richtung"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a0ccb7-18f7-4966-84fb-d635225463f7",
                                                "sense_id": "6270e414-660e-31cb-b00d-dff48f2736fc",
                                                "text": "Körperliche Ursachen für eine erhöhte Blendempfindlichkeit sind alters- oder krankheitsbedingte Trübungen des Auges (Hornhaut, Linse, Glaskörper), welche ähnlich einem zerkratzten Glas, die Lichtstrahlen streuen."
                                            },
                                            {
                                                "example_id": "30fe1f68-9b9a-494b-9078-2a44dd57ed53",
                                                "sense_id": "6270e414-660e-31cb-b00d-dff48f2736fc",
                                                "text": "Ein neu entwickeltes Computerprogramm von Forschern des Amerikanischen Mineralogischen Instituts in Carlsbad simuliert, wie Diamanten Lichtstrahlen streuen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1b10663a-9c8f-3805-9c8c-f0692fae0196",
                                        "entry_id": "7ca03ac1-94ed-3888-a9b7-847e35d32a56",
                                        "glosses": [
                                            "sich (von einem Ort aus) verteilen"
                                        ],
                                        "tags": [
                                            "naturwissenschaftlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89837d0e-f2a0-42b9-bc8d-c13e0face3a3",
                                                "sense_id": "1b10663a-9c8f-3805-9c8c-f0692fae0196",
                                                "text": "Beim Doppelspaltexperiment geht das Teilchen durch einen der beiden Spalte hindurch und streut ganz klassisch am Spalt."
                                            },
                                            {
                                                "example_id": "1f04f6e6-53f1-49a1-ae05-af7da2a29476",
                                                "sense_id": "1b10663a-9c8f-3805-9c8c-f0692fae0196",
                                                "text": "Fließt Licht durch zwei benachbarte Spalte wie beim beschriebenen Doppelspaltexperiment, so führen die Beugungen an den Kanten jedes Schlitzes dazu, daß das Licht wie zuvor beschrieben von den Kanten nach beiden Seiten zur Seite streut."
                                            },
                                            {
                                                "example_id": "4b8beb5c-e3bc-4fdb-b1d3-c9c3ad35e7e6",
                                                "sense_id": "1b10663a-9c8f-3805-9c8c-f0692fae0196",
                                                "text": "Man versucht zu verhindern, dass der Tumor streut."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5fcb1584-f93b-3851-a435-8b9fd101557e",
                                        "entry_id": "7ca03ac1-94ed-3888-a9b7-847e35d32a56",
                                        "glosses": [
                                            "etwas in der Öffentlichkeit verbreiten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6963e3ab-c858-480e-a671-854b68c851ad",
                                                "sense_id": "5fcb1584-f93b-3851-a435-8b9fd101557e",
                                                "text": "„Sie streuen gezielt Zweifel an den Taten des NS-Regimes, um Deutschland wieder zu der von ihnen erhofften nationalen Größe zu führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
