                                    },
                                    {
                                        "sense_id": "9a4a18ce-3715-361d-adc0-dd9839d63410",
                                        "entry_id": "784b6767-762c-3506-8a77-3b1c4b291819",
                                        "glosses": [
                                            "Doing or exemplifying (a characteristic or pursuit) on a large scale; active or enthusiastic."
                                        ],
                                        "tags": [],
                                        "examples": [
