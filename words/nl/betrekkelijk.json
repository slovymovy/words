                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zin de man die daar loopt is het woord die een <w>betrekkelijk</w> voornaamwoord.",
                            "target_lang_translations": {
                                "en": "In the sentence 'the man who is walking there', the word 'who' is a <w>relative</w> pronoun."
                            }
                        },
                        {
                            "text": "De leraar legde uit hoe je een <w>betrekkelijke</w> bijzin correct moet formuleren.",
                            "target_lang_translations": {
                                "en": "The teacher explained how to correctly formulate a <w>relative</w> clause."
                            }
