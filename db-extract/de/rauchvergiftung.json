                                            {
                                                "example_id": "c12e0181-a374-4f38-958a-bd4dfa58e55e",
                                                "sense_id": "28249bd5-bf51-37bd-b066-addfc5f523c8",
                                                "text": "Bij de brand kwam veel rook vrij. Het personeel en de gasten konden daardoor de uitgang niet vinden en raakten in paniek. De mensen die omkwamen, zijn overleden aan de gevolgen van rookvergiftiging."
                                            },
                                            {
                                                "example_id": "0c4049b8-26cf-493a-9ee6-d6eabe0955c4",
                                                "sense_id": "28249bd5-bf51-37bd-b066-addfc5f523c8",
                                                "text": "In een van de cellencomplexen hadden gevangenen matrassen en dekens in brand gestoken. Zeker twintig mensen liepen een rookvergiftiging op. Dertien van hen vonden de dood."
                                            }
