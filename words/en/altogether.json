                    "sense_definition": "A state of being naked.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist asked the model to pose in the <w>altogether</w>.",
                            "target_lang_translations": {
                                "ru": "Художник попросил модель позировать <w>голышом</w>.",
                                "zh": "艺术家要求模特<w>一丝不挂</w>地摆姿势。"
                            }
                        },
                        {
                            "text": "He was shocked to find them swimming in the <w>altogether</w>.",
                            "target_lang_translations": {
                                "ru": "Он был шокирован, обнаружив, что они купаются <w>в чём мать родила</w>.",
                                "zh": "他很震惊地发现他们正在<w>赤身裸体</w>地游泳。"
                            }
                        }
