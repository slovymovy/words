                "translations": [
                    {
                        "translation_id": "58033ece-adc7-477d-9766-be8f0753fcfa",
                        "source_entry_id": "5faa9d18-29ae-3da1-ab77-47f200a0d49c",
                        "source_sense_id": "3a78f48c-6dc5-3597-b286-9145951c69bb",
                        "source_sense_description": "Musik: Akkompagnist, Begleiter",
                        "target_lang_word": "Akkompagnist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "17c3ea6e-d47e-4292-a161-a0022e7e6875",
                        "source_entry_id": "5faa9d18-29ae-3da1-ab77-47f200a0d49c",
                        "source_sense_id": "3a78f48c-6dc5-3597-b286-9145951c69bb",
                        "source_sense_description": "Musik: Akkompagnist, Begleiter",
                        "target_lang_word": "Begleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "886beaee-8ca9-3762-8d2b-59ba80d973be",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "jemand, der jemanden begleitet; jemand, der gemeinsam mit jemandem irgendwo hingeht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f7bb203-1c6e-495d-b3c7-e6e0060c96a1",
                                                "sense_id": "886beaee-8ca9-3762-8d2b-59ba80d973be",
                                                "text": "Der Wald ist nachts zu gefährlich, ohne Begleiter hineinzugehen."
                                            },
                                            {
                                                "example_id": "13a8b2a7-8b04-459c-a9ed-2cbff06d5b6f",
                                                "sense_id": "886beaee-8ca9-3762-8d2b-59ba80d973be",
                                                "text": "„Da sein Begleiter so hartnäckig schwieg, wollte Schefold, wie es seine Gewohnheit war, die ersten Häuser von Winterspelt zum Bild machen.“"
                                            },
                                            {
                                                "example_id": "f3f6a7f4-8bc7-42eb-b002-52eae32999fa",
                                                "sense_id": "886beaee-8ca9-3762-8d2b-59ba80d973be",
                                                "text": "„Mit gespaltenen Rohrstöcken bemühten sich die Begleiter, unter lauten Rufen die Straße frei zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a48967a2-3688-330d-ac41-d576fbccc292",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "Person, die einen Solisten auf einem Instrument begleitet"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af81dd67-e874-4686-bafe-3b2e5903e780",
                                                "sense_id": "a48967a2-3688-330d-ac41-d576fbccc292",
                                                "text": "Er war der Sängerin ein einfühlsamer Begleiter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0ba65c7b-5d12-3ae1-bfd4-40f9e153ddcb",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "deutsche Bezeichnung für Artikel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b09cd5a-2244-4a3d-8774-a694f740b5be",
                                                "sense_id": "0ba65c7b-5d12-3ae1-bfd4-40f9e153ddcb",
                                                "text": "„Der“ und „ein“ können als Begleiter verwendet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3d84f860-e76f-3b51-91a3-2e18e1322fd4",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "umschreibend für: Freund, Liebhaber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d77175-5328-4715-8503-ac1e1be76ff6",
                                                "sense_id": "3d84f860-e76f-3b51-91a3-2e18e1322fd4",
                                                "text": "Man sah sie erstmals mit ihrem Begleiter."
                                            },
                                            {
                                                "example_id": "f23881c3-2dad-42d4-ae59-9a0d4b1a7994",
                                                "sense_id": "3d84f860-e76f-3b51-91a3-2e18e1322fd4",
                                                "text": "„Das jüngere weibliche Wesen schwankte auf der Suche nach seinem Mantel und seinem Begleiter an ihnen vorüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "951250a2-4b53-3c02-b948-62101ca23d3f",
                                        "entry_id": "270e6601-cdea-3d31-831d-fe488eb09a07",
                                        "glosses": [
                                            "Himmelskörper, der einen anderen umkreist oder die gleiche Bahn wie dieser verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ddbb7e-17da-466a-885d-8ee5d42782f1",
                                                "sense_id": "951250a2-4b53-3c02-b948-62101ca23d3f",
                                                "text": "„Die bekanntesten koorbitalen Begleiter sind die Trojaner des Jupiters.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
