                        "examples": [
                            {
                                "example_id": "0f84d151-94d4-4f57-a992-c4d9936439b9",
                                "sense_id": "2ab05e18-9581-3f57-8593-75e47657ed15",
                                "text": "„Zahlreiche Serienausstattungsmerkmale und umfangreiche Sonderausstattungsoptionen runden das neue Design des Escalade ab: Als Beispiele seien genannt die Scheibenwischer mit flachem Wischerblatt und Wischerarmen in neuem Design (Scheibenwischer mit Regensensor und die beheizbare Windschutzscheibenwaschanlage gehören zur Serienausstattung) und das optional erhältliche größere Sonnendach.“"
                            },
                            {
                                "example_id": "af691af8-fb47-4026-a38c-0dee711043d9",
                                "sense_id": "2ab05e18-9581-3f57-8593-75e47657ed15",
                                "text": "Eine neue Windschutzscheibenwaschanlage hätte ein Vermögen gekostet, aber zum Glück war nur der Wasserbehälter undicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
