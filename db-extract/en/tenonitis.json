                            {
                                "example_id": "2b5a65d8-1ef6-4143-8f1f-568392cd47ef",
                                "sense_id": "ad205d2d-c317-378d-a2a9-a89351c3b6fb",
                                "text": "Another group of painful conditions called soft-tissue rheumatism rises sharply in incidence among women during the middle years. It includes bursitis, tenonitis, fibrositis and tennis elbow."
                            },
                            {
                                "example_id": "e91be97d-5305-438f-b8df-7c8c06096cf7",
                                "sense_id": "ad205d2d-c317-378d-a2a9-a89351c3b6fb",
                                "text": "Antecedent pain in the back of the calf or heel may be an indication of prior tendon damage and vulnerability (e.g. tendinitis, tendinosis, tenonitis)."
                            },
                            {
                                "example_id": "0ad2bfe1-a852-45ab-890a-391446aa76a3",
                                "sense_id": "ad205d2d-c317-378d-a2a9-a89351c3b6fb",
                                "text": "Treatment is similar to that used for Achilles tenonitis."
                            }
                        ]
                    }
