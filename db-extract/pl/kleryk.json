                        ]
                    },
                    {
                        "translation_id": "30b8e353-5cf2-467f-8ca4-e03f646230dc",
                        "source_entry_id": "c8aa544b-fd07-3bad-8fcb-f9277ea2379e",
                        "source_sense_id": "1852cff0-dcff-368e-8af5-37fe553ae0df",
                        "target_lang_word": "séminariste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séminariste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae5f81bc-1aae-3a73-bf41-fd3225ccbb47",
                                        "entry_id": "206791d5-3883-3a0c-992c-359634c0befc",
                                        "glosses": [
                                            "Celui qui est élevé ou qui est instruit dans un séminaire catholique, en vue de devenir prêtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4655d33-fadd-4e23-b78a-13f69739e88f",
                                                "sense_id": "ae5f81bc-1aae-3a73-bf41-fd3225ccbb47",
                                                "text": "Suivant les ordres donnés à voix basse par le corsaire, […], les hommes désignés pour chaque service allèrent, comme des séminaristes marchant à la messe, sur le tillac de la prise lier les mains aux matelots, aux passagers, et s'emparer des trésors."
                                            },
                                            {
                                                "example_id": "f7dc2ca5-f779-4d89-92d8-a743ef697098",
                                                "sense_id": "ae5f81bc-1aae-3a73-bf41-fd3225ccbb47",
                                                "text": "Le reste des trois cent vingt et un séminaristes ne se composait que d'êtres grossiers qui n'étaient pas bien sûrs de comprendre les mots latins qu'ils répétaient tout le long de la journée."
                                            },
                                            {
                                                "example_id": "2ec1bcc7-6073-4963-90c2-78e3d95a40f6",
                                                "sense_id": "ae5f81bc-1aae-3a73-bf41-fd3225ccbb47",
                                                "text": "Il n'est rien de plus inepte qu'un séminariste ; rien de moins propre à être un jour ce que l'on veut qu'il soit, un pasteur éclairé : ces jeunes gens n'ont la tète remplie que de fadaises mystiques."
                                            },
                                            {
                                                "example_id": "59e53655-e8ad-4045-b50e-d7e619a9d4e1",
                                                "sense_id": "ae5f81bc-1aae-3a73-bf41-fd3225ccbb47",
                                                "text": "Prêtre et psychanalyste, fervent défenseur de la repsychatrisation de l’homosexualité dans les années 1990, acteur majeur de la «croisade \"anti-genre\"» du Vatican ensuite, celui-ci vient d’être sanctionné par le diocèse de Paris pour attouchements sexuels sur des séminaristes qu’il suivait en psychothérapie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52850e52-969a-3042-b719-1cd03015a3bd",
                                        "entry_id": "206791d5-3883-3a0c-992c-359634c0befc",
                                        "glosses": [
                                            "Celui ou celle qui est élevé ou qui est instruit dans un séminaire protestant, en vue de devenir ministre du culte protestant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e11fe66-b0a2-4320-bec4-a059569a319f",
                        "source_entry_id": "c8aa544b-fd07-3bad-8fcb-f9277ea2379e",
                        "source_sense_id": "1852cff0-dcff-368e-8af5-37fe553ae0df",
                        "target_lang_word": "Kleriker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleriker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                        "entry_id": "efc1449b-b343-33dc-92ce-ed76535c585c",
                                        "glosses": [
                                            "Geistlicher der römisch-katholischen Kirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be848e1-786a-4b36-b81a-6d33f65aa34e",
                                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                                "text": "Ein Kleriker von Augsburg ist Bischof Ulrich."
                                            },
                                            {
                                                "example_id": "0f7d6a74-b386-44b5-8a1a-4a6b7f494fc0",
                                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                                "text": "„Hierzu bediente man sich zunächst der Hilfe von Klerikern.“"
                                            },
                                            {
                                                "example_id": "28194d07-a4a2-44ef-b790-ab3c2881df67",
                                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                                "text": "„Tatsächlich muss, wer die Volksmärchen nicht nur der Gebrüder Grimm studiert, einräumen, dass die Kleriker sehr erfolgreich darin waren, bestimmte Frauen als Hexen zu denunzieren.“"
                                            },
                                            {
                                                "example_id": "538c3a27-10ed-4fc5-a582-06e32183a8d2",
                                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                                "text": "„Die Kleriker kommen vor allem aus Russland und Byzanz - jener Weltregion, die Harald so lange bereist hat und deren Form des Christentums er vor allem kennt.“"
                                            },
                                            {
                                                "example_id": "055643df-192c-47db-9e79-a8142c1d34c5",
                                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                                "text": "„Ungefähr ein Dutzend männliche und weibliche Gestalten in der Tracht des 18. Jahrhunderts standen laut singend im Kreis, in dessen Zentrum ein kleiner Herr im langen Rock des Klerikers und in weißer Perücke dazu den Takt schlug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d756bcdf-9ac9-42a2-9ba8-232d500c7a06",
                        "source_entry_id": "c8aa544b-fd07-3bad-8fcb-f9277ea2379e",
                        "source_sense_id": "1852cff0-dcff-368e-8af5-37fe553ae0df",
