                                "target_lang_sense_clarification": "informal addition"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "математическое сложение"
                            },
                            {
                                "target_lang_word": "и",
                                "target_lang_sense_clarification": "разговорное сложение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42dc1000-fd0d-3c20-97f0-437c3eb6fbc2",
