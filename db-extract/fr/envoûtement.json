                                        "glosses": [
                                            "Handlung/Vorgang, jemand oder etwas kraft eines Zaubers zu verwandeln und Ergebnis davon"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3155c557-466e-328d-b79f-ebceb84c5bb6",
                                        "entry_id": "09ec9c38-0fc2-305b-8bba-035482f9526a",
                                        "glosses": [
                                            "Handlung/Vorgang, jemand oder etwas kraft seiner Reize zu betören und Ergebnis davon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17ba7927-93a4-4b53-b87f-4be879ac55b1",
                                                "sense_id": "3155c557-466e-328d-b79f-ebceb84c5bb6",
                                                "text": "„Ich überlegte, welche Art von Verzauberung mich zwang, mich stets wieder in eine Frau zu verlieben, die mir neu erschien und doch nur das gleiche Verlangen einflößte wie die letzte, die ich geliebt und zu lieben aufgehört hatte, weil das Verlangen erloschen war.“"
                                            },
                                            {
                                                "example_id": "96e6e967-f283-4171-90b1-dafda4231bea",
                                                "sense_id": "3155c557-466e-328d-b79f-ebceb84c5bb6",
                                                "text": "„Draußen begann die große Verzauberung des Abends.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96d262ea-6f83-4c22-98c6-8c9c2c0e4b59",
                        "source_entry_id": "179e7a2a-23a2-376d-92db-093a2aff0312",
