                                "sense_id": "b1f99472-fcdf-37a4-98c8-a796aa332878",
                                "text": "We move to higher social realms in the next chapter, in which Harrison refuses to bewhore his conscience to a peer by supporting Colonel Trompington for parliament, this being the price for favor towards Booth."
                            },
                            {
                                "example_id": "681c2dfb-f314-41ca-b274-c107415f2644",
                                "sense_id": "b1f99472-fcdf-37a4-98c8-a796aa332878",
                                "text": "They've asked her the name of him that bewhored her, but she will not speak."
                            }
