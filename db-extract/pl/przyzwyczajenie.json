                                "sense_id": "19588792-dc79-37d8-ad6f-7d4e623f7d66",
                                "text": "Miał kilka dziwnych przyzwyczajeń, np. pił herbatę wyłącznie zimną."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ee771507-154a-3f93-ab34-06c690dc234f",
                        "entry_id": "aa20d19f-781b-3cbf-ae3f-637b17ed4563",
