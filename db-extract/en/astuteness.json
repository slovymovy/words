                                "target_senses": [
                                    {
                                        "sense_id": "37e7c9c6-3424-3d3d-89b9-52b4f96e0ddc",
                                        "entry_id": "8d788704-5b9e-32e4-a43e-0a685d711b8f",
                                        "glosses": [
                                            "свойство по значению прилагательного проницательный; способность быстро и верно понимать сущность чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab83cc39-67de-482e-aa9a-e56bc3ee5c80",
                                                "sense_id": "37e7c9c6-3424-3d3d-89b9-52b4f96e0ddc",
                                                "text": "Достоевский с огромной проницательностью сумел увидеть проникновение этого овеществляющего обесценивания человека во все поры современной ему жизни и в самые основы человеческого мышления."
                                            }
                                        ]
