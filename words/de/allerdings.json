            "senses": [
                {
                    "sense_id": "39a80476-5155-3503-82da-51484a4af953",
                    "sense_definition": "Drückt eine Einschränkung, einen Einwand oder einen Gegensatz zu einer vorherigen Aussage aus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich würde gerne mitkommen, <w>allerdings</w> habe ich heute Abend schon einen Termin."
                        },
                        {
                            "text": "Das Hotel war sehr schön, <w>allerdings</w> lag es ziemlich weit vom Strand entfernt."
                        }
                    ],
                    "synonyms": [
                        "aber",
                        "freilich",
                        "jedoch"
                    ]
                },
                {
                    "sense_id": "66c42ccc-9140-349c-9c67-9b9e98be55b4",
                    "sense_definition": "Dient als nachdrückliche Bejahung oder Bestätigung einer vorangegangenen Aussage oder Frage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "„Hast du die schwere Prüfung bestanden?“ – „<w>Allerdings</w>, und sogar mit einer sehr guten Note!“"
                        },
                        {
                            "text": "„War die Reise nach Rom anstrengend?“ – „<w>Allerdings</w>, aber es hat sich wirklich gelohnt.“"
                        }
                    ],
                    "synonyms": [
                        "freilich",
                        "gewiss",
                        "in der Tat",
                        "jawohl",
                        "natürlich"
                    ]
                }
            ]
