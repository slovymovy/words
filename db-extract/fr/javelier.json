                        "entry_id": "1dc63067-1be9-3706-bead-7dc19891d27e",
                        "glosses": [
                            "Ancien instrument agricole qui regroupe les céréales moissonnées en javelle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "726463d2-5f3b-4412-9e73-b98e5d534266",
                                "sense_id": "95de1aac-a5b0-3899-9024-dfb2f31fe5a4",
                                "text": "Cette année encore, et plus que jamais, je renonce pour les moissonneuses à l'emploi d'un javelier mécanique."
                            },
                            {
                                "example_id": "77bdd306-87ab-4c44-a5d3-2fd18bf4bbf7",
                                "sense_id": "95de1aac-a5b0-3899-9024-dfb2f31fe5a4",
                                "text": "On vendait surtout le javelier, faux munie de dents de bois, sur lesquelles s’entassaient les tiges de blé à rassembler en javelles; (…)."
                            },
                            {
                                "example_id": "6c9de643-af86-44c7-923c-3c53968d6334",
                                "sense_id": "95de1aac-a5b0-3899-9024-dfb2f31fe5a4",
                                "text": "Jadis on moissonnait à la faux, avec un javelier qui versait les javelles sur le côté."
                            }
                        ]
                    }
