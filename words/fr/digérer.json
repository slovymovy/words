                {
                    "sense_id": "974e9d7d-ca82-3831-aae8-a820b43c1523",
                    "sense_definition": "Classer et ordonner méthodiquement les différentes parties d'un travail ou d'une réflexion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "méthode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet ouvrage rassemble des données précieuses, mais les faits y sont mal <w>digérés</w>."
                        },
                        {
                            "text": "Avant de rédiger sa thèse, le chercheur a pris soin de bien <w>digérer</w> ses sources."
