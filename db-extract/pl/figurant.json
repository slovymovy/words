        "pl-extract.jsonl": [
            {
                "entry_id": "061e0fab-e0e1-3e77-a565-cdc6f0d37711",
                "word": "figurant",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "212e8c59-142a-32df-a711-93ac80f859ed",
                        "entry_id": "061e0fab-e0e1-3e77-a565-cdc6f0d37711",
                        "glosses": [
                            "osoba zajmująca wysokie stanowisko, ale niesprawująca faktycznej władzy, niemająca wpływu na podejmowane decyzje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb04e301-95b8-4052-bfa4-a33bb3bded0c",
                                "sense_id": "212e8c59-142a-32df-a711-93ac80f859ed",
                                "text": "W czasach rządów AWS (1997-2001) mówiono również o kierowaniu z tylnego siedzenia – ówczesny premier Jerzy Buzek miał być w istocie figurantem, a faktycznie rządem miał kierować przewodniczący „Solidarności” Marian Krzaklewski"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0194953b-bbf2-3489-b4ec-afb93f6ff940",
                        "entry_id": "061e0fab-e0e1-3e77-a565-cdc6f0d37711",
                        "glosses": [
                            "statysta teatralny"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "925f0e9e-8912-37c7-8b33-a118936ee3f1",
                        "entry_id": "061e0fab-e0e1-3e77-a565-cdc6f0d37711",
                        "glosses": [
                            "osoba będąca obiektem zainteresowania służb specjalnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f338ab-3140-4706-9f96-7f91f8ff39f4",
                                "sense_id": "925f0e9e-8912-37c7-8b33-a118936ee3f1",
                                "text": "Za pomocą osobowych źródeł informacji i innych środków operacyjnych (np. podsłuchów) zbierano wszelkie informacje na temat figuranta"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f85c815c-5936-4ca9-899d-a0ca0cb8cf79",
                        "source_entry_id": "061e0fab-e0e1-3e77-a565-cdc6f0d37711",
                        "source_sense_id": "212e8c59-142a-32df-a711-93ac80f859ed",
                        "target_lang_word": "figurehead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurehead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e207f1e0-a99e-3d4c-b4a4-90e9ce5b075e",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "A carved figure on the prow of a sailing ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "Someone in a nominal position of leadership who has little to no actual power."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f27d9ef-a9f8-45f0-8683-fc6b33dd9d2f",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Evidently he did not mean to be a mere figurehead, but to carry on the old tradition of Wilsthorpe's; and that was considered to be a good thing in itself and an augury for future prosperity."
                                            },
                                            {
                                                "example_id": "d37432da-8daa-4496-8643-7db23139b423",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Instead she played, largely impeccably, the part of a modern constitutional monarch, a symbolic figurehead with a right to be consulted and to advise and warn political leaders privately and to show herself publicly as a focus of national life, celebration and commemoration."
                                            },
                                            {
                                                "example_id": "fb9e707b-f047-4585-903a-8ec0d943d83e",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Supporters of Wagenknecht, a controversial but prominent figurehead, are already hatching plans for a breakaway party to compete in the 2024 European elections, the German newspaper Taz reported this week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba44fb2a-a2e2-3fa0-a6d7-5ab563e8e211",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "A person's face."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0a748f-587d-4680-8b00-e75ddf62b3ee",
                                                "sense_id": "ba44fb2a-a2e2-3fa0-a6d7-5ab563e8e211",
                                                "text": "HATCHET. Bring up, I say, or I'll spoil your figurehead. [Lifting his cudgel]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e6dcaea-7fda-41ac-b1f8-d11f562c4594",
                        "source_entry_id": "061e0fab-e0e1-3e77-a565-cdc6f0d37711",
                        "source_sense_id": "212e8c59-142a-32df-a711-93ac80f859ed",
                        "target_lang_word": "figurant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "092cc866-b587-3831-b3cb-f5055293b330",
                                        "entry_id": "43b1e27f-f068-3b0c-888b-be00727ca2e3",
                                        "glosses": [
                                            "Personne qui au théâtre ou au cinéma remplit un rôle généralement muet et secondaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edfc92be-e115-455f-8e9a-76d5fecacd06",
                                                "sense_id": "092cc866-b587-3831-b3cb-f5055293b330",
                                                "text": "— […]... quand je pense que moi qui aimais tant à servir la messe, je suis figurant au Châtelet!\n— Et pourquoi, diable t'es-tu fait figurant ?\n— Pour gagner trente sous par soirée."
                                            },
                                            {
                                                "example_id": "d3b6e800-918e-4877-bf5d-b12789f1c50f",
                                                "sense_id": "092cc866-b587-3831-b3cb-f5055293b330",
                                                "text": "Trois heures après, le réalisateur appelle celui qu’il croit être un figurant et lui demande de jouer une courte scène avec l’actrice Gwyneth Paltrow, l’héroïne du film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d1897a7-9f6c-3093-94b7-505dcc7c472c",
                                        "entry_id": "43b1e27f-f068-3b0c-888b-be00727ca2e3",
                                        "glosses": [
                                            "Toute personne dont le rôle est effacé dans une réunion, dans une société."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "figurant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56ae004e-e356-3dd7-b592-92ea3f063767",
                                        "entry_id": "90e50287-d604-3cac-889b-1466f51e50f2",
                                        "glosses": [
                                            "Participe présent de figurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d55a64b-7e94-4cc5-a284-fec93a95b30a",
                                                "sense_id": "56ae004e-e356-3dd7-b592-92ea3f063767",
                                                "text": "La multiplicité des esquisses théologiques figurant dans les écrits néotestamentaires ne peut s’insérer dans un cadre uniforme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
