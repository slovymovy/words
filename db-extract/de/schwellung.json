                "senses": [
                    {
                        "sense_id": "a3a0c19a-e1cd-3211-92a2-c2fa6b9e75ca",
                        "entry_id": "4570d634-989c-3197-8dae-a2489f170f6f",
                        "glosses": [
                            "Stelle am Körper, die dicker als normal ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62d75702-bc7b-46ee-94fe-c0d88b3d200d",
                                "sense_id": "a3a0c19a-e1cd-3211-92a2-c2fa6b9e75ca",
                                "text": "„Pathogenetisch können einer Schwellung sehr unterschiedliche Erkrankungen zugrunde liegen, beispielsweise Allergien, Infektionen oder Traumen.“"
                            },
                            {
                                "example_id": "f86a1893-2a24-4ee6-9796-c6977cd7fdb1",
                                "sense_id": "a3a0c19a-e1cd-3211-92a2-c2fa6b9e75ca",
                                "text": "Die Schwellung an der Einstichstelle wird nach wenigen Stunden verschwinden."
                            },
                            {
                                "example_id": "44de3688-388f-4fc6-9cf5-9f445c28a2a1",
                                "sense_id": "a3a0c19a-e1cd-3211-92a2-c2fa6b9e75ca",
                                "text": "„Die Lippen waren aufgerissen, und die Schwellung um die Augen hatte sich grünblau und braun verfärbt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
