                                        "glosses": [
                                            "viel und lange arbeitend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc52b6b3-0137-4b28-8247-345f9deda366",
                                                "sense_id": "04ad1d62-0920-303a-90e9-1d0f3f99190c",
                                                "text": "Es war einmal vor langer Zeit in einem Dorf der Bretagne ein junger Mann namens Wilhem Lostik. Wilhem war arbeitsam und rechtschaffen, aber er trank gern einen über den Durst …"
                                            },
                                            {
                                                "example_id": "d4457051-2dd6-4bbc-8d2c-32f584331b96",
                                                "sense_id": "04ad1d62-0920-303a-90e9-1d0f3f99190c",
                                                "text": "Die Deutschen gelten vielen in der Welt als arbeitsam und fleißig."
                                            },
                                            {
                                                "example_id": "656e359a-b357-4593-93e8-25e951053b65",
                                                "sense_id": "04ad1d62-0920-303a-90e9-1d0f3f99190c",
                                                "text": "Michèle Alliot-Marie stand seit 2002 an der Spitze diverser Ministerien. Sie genoss den Ruf, überaus kompetent, arbeitsam und korrekt zu sein."
                                            },
                                            {
                                                "example_id": "8e9f5785-94a8-42ff-9778-b74750396345",
                                                "sense_id": "04ad1d62-0920-303a-90e9-1d0f3f99190c",
                                                "text": "Wird Ihnen die Arbeit manchmal zu viel? Haben Sie das Gefühl, dass das Leben dabei zu kurz kommt? Oder leben Sie, um zu arbeiten, können gar nicht genug davon bekommen und sich ein weniger arbeitsames Leben gar nicht vorstellen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
