                    {
                        "sense_id": "7f10ebc9-8535-3c3f-9dc4-208b922bb966",
                        "entry_id": "a41fa0ce-c397-3b62-b588-2410e078ae80",
                        "glosses": [
                            "Erlernen einer zweiten Sprache (Zweitsprache), nachdem die Muttersprache (Erstsprache) bereits erlernt ist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3768b81-c40e-4cc7-a558-b01e26abdae7",
                                "sense_id": "7f10ebc9-8535-3c3f-9dc4-208b922bb966",
                                "text": "Mit Zweitspracherwerb ist gemeint, dass jemand eine weitere Sprache erlernt, nachdem er seine Muttersprache bereits erlernt hat. Bei bilingual oder multilingual aufwachsenden Kindern, die ihre Sprachen etwa gleichzeitig erwerben, zählen diese nicht zum Zweitspracherwerb."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
