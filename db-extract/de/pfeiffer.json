                ],
                "senses": [
                    {
                        "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                        "entry_id": "e7a90be2-77ff-3763-956a-9f3a482540af",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4480850d-49ea-4dbe-871f-f82c66f06f6c",
                                "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pfeiffer kommt, geht der Herr Pfeiffer.“"
                            },
                            {
                                "example_id": "238ce062-df4a-4530-a000-528af4892be3",
                                "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                                "text": "Pfeiffer kommt und geht."
                            },
                            {
                                "example_id": "a6d562ee-e386-4426-9b11-13afd629c6e5",
                                "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                                "text": "Pfeiffers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b9dbbba6-0865-4973-8ad8-08080ff5dd18",
                                "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                                "text": "Herr Pfeiffer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "eaed12d5-c4b7-43c5-b1e7-d489cc336aea",
                                "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                                "text": "Die Pfeiffers fahren heute ins Sauerland."
                            },
                            {
                                "example_id": "a6f767ce-2629-46d7-9621-9969843f3f0f",
                                "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                                "text": "Der Pfeiffer trägt nie die Schals, die die Pfeiffer ihm strickt."
                            },
                            {
                                "example_id": "4125684e-41c0-4274-b1ce-389da898a2c1",
                                "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                                "text": "Frau Pfeiffer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4b6de76d-7b31-43e6-88cf-b18cb3abb595",
                                "sense_id": "61b8e569-ab19-334e-8429-31af33fa8c1d",
                                "text": "„Wenn im September dieses Jahres die Leichtathletik-WM in Tokio stattfindet, wäre Pfeiffer nach den international geltenden Qualifikationsregeln von World Athletics startberechtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
