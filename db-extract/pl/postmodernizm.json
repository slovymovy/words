                        "translation_id": "011f486a-9605-4c54-88fd-ad52416174f8",
                        "source_entry_id": "93da426b-c923-36ec-a44c-10b1790679cc",
                        "source_sense_id": "8d78c6d8-6788-3bde-966f-dd9f8bcf3dfc",
