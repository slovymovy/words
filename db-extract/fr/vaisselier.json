                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c575911-21d9-3535-857b-2c518b3b189b",
                        "entry_id": "72ea51f2-81ac-3362-b005-b021611e9f59",
                        "glosses": [
                            "Dressoir sur lequel on place, en général verticalement, des plats et des assiettes, dans une salle à manger ou une cuisine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e038f92-40de-4ce3-89c6-991ba3659026",
                                "sense_id": "9c575911-21d9-3535-857b-2c518b3b189b",
                                "text": "Au fond, dans la pénombre, Bern était accroupi et décapait un vieux vaisselier au chalumeau. Des couches de peinture faisaient des cloques noires sous la flamme bleue."
                            },
                            {
                                "example_id": "59db4e30-408a-44ea-9c5c-2c68045fe399",
                                "sense_id": "9c575911-21d9-3535-857b-2c518b3b189b",
                                "text": "C’est Saint-Ange qui réagit le premier. Il se saisit d’une petite tasse en porcelaine qui attendait, sans but, sur un vaisselier. Il s’agenouille auprès du mort, et recueille un peu du sang tiède qui dégoutte de son visage. Quand il en a suffisamment pris, il se relève, l’air austère. Il porte alors la tasse à ses lèvres, boit dedans, et me la tend."
                            }
                        ]
                    },
                    {
                        "sense_id": "0167cc51-85c5-3c55-bbbe-b93513d1f37f",
                        "entry_id": "72ea51f2-81ac-3362-b005-b021611e9f59",
                        "glosses": [
                            "Ensemble des artefacts relevant du mobilier de la table."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1155ec-1b84-480b-87b8-ab5bfb183185",
                                "sense_id": "0167cc51-85c5-3c55-bbbe-b93513d1f37f",
                                "text": "Le vaisselier découvert renseigne sur l’équipement de la maison […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd149611-8af2-41bf-a982-2b984535dc0e",
                        "source_entry_id": "72ea51f2-81ac-3362-b005-b021611e9f59",
