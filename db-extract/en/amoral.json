                        "entry_id": "3772153d-e759-3c47-a2dc-5ae898eaa6e7",
                        "glosses": [
                            "Done without consideration for morality or immorality."
                        ],
                        "tags": [
                            "of acts"
                        ],
                        "examples": [
                            {
                                "example_id": "d785093f-bb70-41c1-988a-1edc46df7e49",
                                "sense_id": "abaecd4d-19f1-358a-b815-cdf775f34d3e",
                                "text": "If free will is a myth, and our actions are the mere amoral outcome of biological luck for which we are not responsible, why not just run amok?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a6c25299-8fa5-3e3c-983a-0cb3e9555538",
                        "entry_id": "3772153d-e759-3c47-a2dc-5ae898eaa6e7",
                        "glosses": [
                            "Not believing in or caring for morality and immorality."
                        ],
                        "tags": [
                            "of people"
                        ],
                        "examples": []
                    }
                ],
