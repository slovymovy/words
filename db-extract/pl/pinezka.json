                        ]
                    },
                    {
                        "translation_id": "be5436f0-c4a0-4aff-8a61-898e46b2ce72",
                        "source_entry_id": "80de5e2d-d152-363e-891f-5b6986dd755d",
                        "source_sense_id": "cedad8db-5b6f-37b1-a3c2-89863dc1f07d",
                        "target_lang_word": "thumbtack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thumbtack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e96aed27-0f27-3015-ad3a-153332fcad1e",
                                        "entry_id": "fb463820-ed2c-3638-be91-f757ea726f2c",
                                        "glosses": [
                                            "A small nail-like tack with a slightly rounded head that can be pressed into place with light pressure from the thumb; used for hanging light articles on a wall or noticeboard."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "328672b1-9895-4061-9e2e-cc4bd7314bb4",
                                                "sense_id": "e96aed27-0f27-3015-ad3a-153332fcad1e",
                                                "text": "You say that I'm broke my nigga, how is that?\nBitch I'm stickin to this paper like a thumbtack"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thumbtack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21cf7bd1-1ec6-3836-88a4-229c1fe29487",
                                        "entry_id": "cf0991da-1d1a-3c0a-8d15-ed531fb0e860",
                                        "glosses": [
                                            "To fix or attach something with a thumbtack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dc93c7c-40d5-4101-97a7-39248f42d1c2",
                                                "sense_id": "21cf7bd1-1ec6-3836-88a4-229c1fe29487",
                                                "text": "On the particle-board partition that separated his cubicle from the next, Paul had thumbtacked things that might inspire him […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1221c927-4e30-41d6-bcaf-48bad6fb81b1",
                        "source_entry_id": "80de5e2d-d152-363e-891f-5b6986dd755d",
                        "source_sense_id": "cedad8db-5b6f-37b1-a3c2-89863dc1f07d",
                        "target_lang_word": "punaise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17fc12ea-c12b-3acd-af72-e22fa4d54544",
                                        "entry_id": "741c8903-9eb6-34c9-b3e1-2f4225cd9303",
                                        "glosses": [
                                            "Nom désignant de nombreuses sortes d’insectes, souvent de forme plate, qui émettent une odeur désagréable lorsqu’ils sont effrayés ou tués."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2215d6-d8d0-498a-a12e-aa4e3f883514",
                                                "sense_id": "17fc12ea-c12b-3acd-af72-e22fa4d54544",
                                                "text": "Glaciers, soleils d'argent, flots nacreux, cieux de braises !\nÉchouages hideux au fond des golfes bruns\nOù les serpents géants dévorés des punaises\nChoient, des arbres tordus, avec de noirs parfums !"
                                            },
                                            {
                                                "example_id": "3514e631-4db9-4cc2-ad7f-501b52e33ca7",
                                                "sense_id": "17fc12ea-c12b-3acd-af72-e22fa4d54544",
                                                "text": "Les punaises ont des mœurs particulières ; elles attendent que la bougie soit soufflée, et, sitôt dans le noir, s’élancent. Elles ne se dirigent pas au hasard ; vont droit au cou, qu’elles prédilectionnent ; s’adressent parfois aux poignets ; quelques rares préfèrent les chevilles. On ne sait trop pourquoi elles infusent sous la peau du dormeur une subtile huile urticante dont la virulence à la moindre friction s’exaspère…"
                                            },
                                            {
                                                "example_id": "5b1c442d-f827-4e6b-9bcc-a355ee832148",
                                                "sense_id": "17fc12ea-c12b-3acd-af72-e22fa4d54544",
                                                "text": "C’est ainsi que parmi les insectes nous trouvons beaucoup d’espèces d’animaux comme la punaise qui exhalent une odeur fétide."
                                            },
                                            {
                                                "example_id": "710bfcb7-c42f-43db-95d9-d2ab3420f64e",
                                                "sense_id": "17fc12ea-c12b-3acd-af72-e22fa4d54544",
                                                "text": "[…] dans l’atelier sordide où nous nous réunissions, aux murs moisis et chargé de punaises qui avaient du moins l’utilité, en nous empêchant de dormir, d’éterniser nos conversations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab6fc605-8a7e-3615-8734-62445b5baf48",
                                        "entry_id": "741c8903-9eb6-34c9-b3e1-2f4225cd9303",
                                        "glosses": [
                                            "Personne petite, malingre, peu imposante."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "075ea1e1-4ed2-46e4-982b-5f349c2ae936",
                                                "sense_id": "ab6fc605-8a7e-3615-8734-62445b5baf48",
                                                "text": "Peut-être n’avait-il jamais pensé qu’il était si petit. Lucien se promit de l’appeler punaise, dès le lendemain matin à la récréation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd658c35-d56b-3516-8059-3e93da75fbb7",
                                        "entry_id": "741c8903-9eb6-34c9-b3e1-2f4225cd9303",
                                        "glosses": [
                                            "Personne malveillante."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff40330-7587-4f13-92d2-a1bda6f8f137",
                                                "sense_id": "cd658c35-d56b-3516-8059-3e93da75fbb7",
                                                "text": "À mort les punaises à Badinguet ! à mort les salauds qui veulent qu’on se batte !"
                                            },
                                            {
                                                "example_id": "1edb9289-4ae5-4e66-8557-28a94a8c63f9",
                                                "sense_id": "cd658c35-d56b-3516-8059-3e93da75fbb7",
                                                "text": "A celle-ci je pourrais dire, si elle n’avait pas rendu sa vilaine âme au diable : « Si je suis encore en vie, sale punaise, ce n’est vraiment pas de ta faute. » La suite de mon histoire vous prouvera combien est justifiée mon apostrophe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f652e97-b58d-35bb-93b1-51c9b9a2cd21",
                                        "entry_id": "741c8903-9eb6-34c9-b3e1-2f4225cd9303",
                                        "glosses": [
                                            "(Par analogie de forme) Petit clou court, à tête plate et large, dont on se sert pour fixer au mur ou sur une planche des feuilles de papier, des images, des affiches, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab1407d-949f-48a1-9a75-c523ff0f7b1e",
                                                "sense_id": "6f652e97-b58d-35bb-93b1-51c9b9a2cd21",
                                                "text": "Rien n’y manque : le photographe n’a oublié ni le tapis de velours ponceau et les livres dorés sur tranches, ni le fauteuil vaguement Renaissance agrémenté de punaises en cuivre et lourdement capitonné."
                                            },
                                            {
                                                "example_id": "3dfd800a-e8c0-4a95-b20c-5824b299f8b2",
                                                "sense_id": "6f652e97-b58d-35bb-93b1-51c9b9a2cd21",
                                                "text": "En passant devant le panneau où les vues du film étaient affichées, Frédéric fit semblant de s’arrêter pour voir et, protégé par son manteau, dans la bousculade du public, il fait sauter les quatre punaises qui retenaient la photographie de Suzy Prim, dansant devant la mer sur un rocher, tel le personnage de l’ouate Thermogène sur l’affiche de Cappiello."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "punaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "179596cc-c8ea-3ad1-9025-693ee56cf675",
                                        "entry_id": "64ad6370-b266-32ac-a897-11482b763fd6",
                                        "glosses": [
                                            "Expression d’étonnement, forme édulcorée du juron putain !"
                                        ],
                                        "tags": [
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21d3acf6-1a3c-4fed-8a82-ae6bcdbcafda",
                                                "sense_id": "179596cc-c8ea-3ad1-9025-693ee56cf675",
                                                "text": "Oh punaise !"
                                            }
                                        ]
                                    }
                                ]
                            },
