                "entry_id": "73fb7c6d-bd2d-3bd1-b404-54f5ddf4f38f",
                "word": "hossa",
                "pos": "intj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1dc8cb17-7602-3ae9-80cd-02384742b54b",
                        "entry_id": "73fb7c6d-bd2d-3bd1-b404-54f5ddf4f38f",
                        "glosses": [
                            "in einem Schlager der 1970er Jahre verwendete Variante des Freudenrufs hussa!, heute Schlachtruf des Schlager-Kults"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff311a98-ea7f-4ff2-b727-58c3dc8f2cdd",
                                "sense_id": "1dc8cb17-7602-3ae9-80cd-02384742b54b",
                                "text": "Hossa! Die Schlager der 70er Jahre!"
                            },
                            {
                                "example_id": "6a9cf92f-a86c-4ff7-a7dd-aa48f2b5f622",
                                "sense_id": "1dc8cb17-7602-3ae9-80cd-02384742b54b",
                                "text": "„Wenn mir jemand drei Stunden lang ein Endlosband von Rex Gildos ›Hossa! Hossa! Fiesta Mexicana‹ vorspielen würde, spränge ich garantiert nach 30 Minuten aus dem nächstbesten Fenster.“"
                            },
                            {
                                "example_id": "30f2940e-1704-4148-b718-10cba7cc833c",
                                "sense_id": "1dc8cb17-7602-3ae9-80cd-02384742b54b",
                                "text": "„»Hossa!« »Hossa!«, rufen die Gefangenen im Chor. »Von nun an soll eure Arbeit nicht mehr vergebens sein!« »Hossa!« »Von nun an werdet ihr nicht mehr Hunger leiden, während ihr Feldfrüchte für den Tisch des Generaldirektors anbaut!“"
                            },
                            {
                                "example_id": "05629cf5-167c-4bcd-b56c-4b2911ebbe39",
                                "sense_id": "1dc8cb17-7602-3ae9-80cd-02384742b54b",
                                "text": "„Hossa Hossa und die Stimmung war im Partykeller.“"
                            },
                            {
                                "example_id": "e848d97d-a237-42c6-8330-f61bd6b3b657",
                                "sense_id": "1dc8cb17-7602-3ae9-80cd-02384742b54b",
                                "text": "„Gegen Mitternacht aber… heya… da ging es ab, das Zäpfchen. „Eye.. spielt doch mal… Hossa Hossa…! Los… komm'… macht doch nicht dauernd Pause, ihr werdet fürs Spielen bezahlt. Los, Hossa… kennt ihr doch… müsst ihr doch drauf haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
