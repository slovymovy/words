                "senses": [
                    {
                        "sense_id": "eea7298d-5080-32ba-9588-e1984d0c19d8",
                        "entry_id": "93cd16db-3457-3642-9a85-6d375d66d96a",
                        "glosses": [
                            "Faire perdre à (quelque chose) son caractère musulman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a30bc9c-fdaa-413d-90fb-12320029b94b",
                                "sense_id": "eea7298d-5080-32ba-9588-e1984d0c19d8",
                                "text": "L’objectif est double (cf.supra) : en s’appuyant complètement sur les élites traditionnelles, musulmanes au Nord, chrétiennes ou coutumières au Sud, il s’agit de « désislamiser » le Sud et de « déségyptianiser » le Nord."
                            },
                            {
                                "example_id": "c2324868-d710-4f56-bb98-52de99e4a55b",
                                "sense_id": "eea7298d-5080-32ba-9588-e1984d0c19d8",
                                "text": "En un siècle la micro-toponymie de l’Anatolie a été totalement dénomadisée, déchristianisée, dégrécisée, désarménisée, dékurdisée mais aussi parfois désislamisée."
                            }
                        ]
                    }
                ],
