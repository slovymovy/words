                        ],
                        "form": "die Polarisierungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0736f6f9-05de-3978-b5a3-6e24f80c1b16",
                        "entry_id": "4a0080f9-cfba-3038-ba75-bf923c7330e7",
                        "glosses": [
                            "Vorgang der Ausrichtung von Teilchen oder elektromagnetischer Wellen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "68272d7e-1ebe-4ed9-9bbb-eef5e66b6047",
                                "sense_id": "0736f6f9-05de-3978-b5a3-6e24f80c1b16",
                                "text": "„Europäer wundern sich oft über die starke Polarisierung in den USA – bei Streitthemen wie Waffenrecht, Todesstrafe, Schwulenehe, Rassismus und Religion – zwischen den vermeintlich rückschrittlichen Konservativen im ländlichen Süden und Westen und den eher linken, urbanen Fortschrittlichen an der Ostküste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52e33821-3164-354d-a46d-f881ba463a2a",
                        "entry_id": "4a0080f9-cfba-3038-ba75-bf923c7330e7",
                        "glosses": [
                            "Vorgang der Verstärkung von Gegensätzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30c02f3-95b9-4383-b25b-75677f3a6156",
                                "sense_id": "52e33821-3164-354d-a46d-f881ba463a2a",
                                "text": "„Im Wettbewerb der Schweizer Kantone um die beste Standortqualität für Unternehmen zeichnet sich eine stärkere Polarisierung ab.“"
                            },
                            {
                                "example_id": "ea645533-3044-4e1c-b8d3-dfa9d481fccf",
                                "sense_id": "52e33821-3164-354d-a46d-f881ba463a2a",
                                "text": "„Die Polarisierung in Freund und Feind, in Gut und Böse, spiegelt sich auch in den politischen Witzen über andere Staaten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01860e20-46bf-472f-82c2-f74da3da42b7",
                        "source_entry_id": "4a0080f9-cfba-3038-ba75-bf923c7330e7",
                        "source_sense_id": "0736f6f9-05de-3978-b5a3-6e24f80c1b16",
                        "source_sense_description": "Physik, Chemie: Vorgang der Ausrichtung von Teilchen oder elektromagnetischer Wellen",
                        "target_lang_word": "polarization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polarization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f69437bf-db82-31f7-ba84-348b9e641909",
                                        "entry_id": "2c12b98f-fc03-3b1e-bc19-2240035b56c8",
                                        "glosses": [
                                            "The production or the condition of polarity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "696e63f6-72a4-42e5-a0e8-8dfc17e8be76",
                                                "sense_id": "f69437bf-db82-31f7-ba84-348b9e641909",
                                                "text": "The subtopologies that we discovered include: a glide-symmetric analog of the quantum spin Hall effect, an hourglass-flow topology (exemplified by our recently-proposed KHgSb material class), and quantized non-Abelian polarizations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c3afc8-cc13-392b-a5e3-c682c0e519fb",
                                        "entry_id": "2c12b98f-fc03-3b1e-bc19-2240035b56c8",
                                        "glosses": [
                                            "The production or the condition of polarity.",
                                            "The grouping of opinions into two extremes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa666755-30f3-4d2a-aae1-9ff2fa0cd26f",
                                                "sense_id": "00c3afc8-cc13-392b-a5e3-c682c0e519fb",
                                                "text": "What frazzled pollsters, surly op-ed pages, snarling cable talkfests and issue-starved candidates for office need is a fresh source of hot-eyed national polarization."
                                            },
                                            {
                                                "example_id": "7c8b8486-7239-45a5-9551-87104dba24bb",
                                                "sense_id": "00c3afc8-cc13-392b-a5e3-c682c0e519fb",
                                                "text": "Polarization is tearing at the seams of democracies around the world, from Brazil and India to Poland and Turkey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b622b52-7ee0-3e14-9d37-3c6dbb72cc08",
                                        "entry_id": "2c12b98f-fc03-3b1e-bc19-2240035b56c8",
                                        "glosses": [
                                            "The production or the condition of polarity.",
                                            "The production of polarized light; the direction in which the electric field of an electromagnetic wave points."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e89570c7-6766-479d-99dc-66c3b2dfa6f8",
                                                "sense_id": "6b622b52-7ee0-3e14-9d37-3c6dbb72cc08",
                                                "text": "We don’t usually notice polarization because direct sunlight and light from ordinary incandescent and fluorescent bulbs is unpolarized: it contains equal mixtures of horizontally and vertically polarized light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c5b0dfe-94a1-37f6-8c6b-d67dcfe11b48",
                                        "entry_id": "2c12b98f-fc03-3b1e-bc19-2240035b56c8",
                                        "glosses": [
                                            "The production or the condition of polarity.",
                                            "The separation of positive and negative charges in a nucleus, atom, molecule or system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
