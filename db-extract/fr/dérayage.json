                "senses": [
                    {
                        "sense_id": "8093f809-b484-3e57-9c84-e1e530d3e492",
                        "entry_id": "a26ff998-cd2b-3bbe-9f9c-2872cb9aae47",
                        "glosses": [
                            "Fait de dérayer un cuir, d’en égaliser l’épaisseur par raclage de sa face intérieure."
                        ],
                        "tags": [
                            "Tannage"
                        ],
                        "examples": [
                            {
                                "example_id": "f0160a4f-3333-4024-a042-d3732898efc7",
                                "sense_id": "8093f809-b484-3e57-9c84-e1e530d3e492",
                                "text": "Les peaux sont ensuite butées ou débarrassées du tan et des parties filamenteuses, puis soumises au dérayage, qui achève cette opération et égalise le cuir ; on emploie pour cela un couteau en acier et un chevalet ou une table."
                            },
                            {
                                "example_id": "75234b61-872b-4848-910f-b18f6ec26a60",
                                "sense_id": "8093f809-b484-3e57-9c84-e1e530d3e492",
                                "text": "Sorties du séchage, les peaux n’ont pas toutes la même épaisseur. Afin de répondre à des normes, il est indispensable de réaliser le travail de dérayage qui consiste à gratter le cuir pour l’égaliser. On peut comparer cette étape au rabotage du bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "eade669a-51e0-33df-b687-325eccd193bb",
                        "entry_id": "a26ff998-cd2b-3bbe-9f9c-2872cb9aae47",
                        "glosses": [
                            "Fait de dérayer, d’arrêter provisoirement ou définitivement le labour d’un champ, après avoir achevé un dernier sillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dd45948-2f29-42f1-a253-81f5394e9a96",
                                "sense_id": "eade669a-51e0-33df-b687-325eccd193bb",
                                "text": "Aux avantages précieux de l’exécution simultanée du dernier labour, de l’épandage des engrais, de l’ensemencement, du hersage et du curage des raies, s’ajoute la certitude qu'entre l’un de ces travaux et le dérayage final une pluie violente ne pourra pas damer la terre, avant qu'on ne l’ait mise en état de dégorger."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e8416a3-b7c9-3a18-be80-a6aa35c02d9e",
                        "entry_id": "a26ff998-cd2b-3bbe-9f9c-2872cb9aae47",
                        "glosses": [
                            "Opération consistant à atténuer les rayures sur les pellicules d’un film en cours de restauration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea1d9d5-78bd-457a-944a-74b1faf60c75",
                                "sense_id": "3e8416a3-b7c9-3a18-be80-a6aa35c02d9e",
                                "text": "De plus, lorsque la Cinémathèque possède plusieurs copies d’un même film, un travail de comparaison et de réfection (décollage, nettoyage, dérayage, réparations des perforations, etc.) doit être entrepris pour reconstituer une copie d’archive aussi fidèle que possible à l’œuvre originale."
                            }
                        ]
                    }
