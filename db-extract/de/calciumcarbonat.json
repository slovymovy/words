                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f60f3b69-a1b1-4b52-ace7-ee63f12c27d0",
                                "sense_id": "5eebbd59-e371-3132-ae4c-c52bf1824df4",
                                "text": "Calciumcarbonat ist ein farbloser, kristalliner Feststoff."
                            },
                            {
                                "example_id": "213bf7fa-07eb-4bd0-a347-283a51749db8",
                                "sense_id": "5eebbd59-e371-3132-ae4c-c52bf1824df4",
                                "text": "Calciumcarbonat ist auf der Erde weit verbreitet."
                            }
                        ],
