                                        "glosses": [
                                            "A type of European synthesizer-driven dance music which became popular worldwide in the early- to mid-1990s and continuing up until today."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187eebf2-4bc9-4640-9773-d72a7b7dfa65",
                                                "sense_id": "fa46c988-f9f8-3421-bcff-608c2b320688",
                                                "text": "A left field U.S. pick, this combination of big beat Eurodisco (or is that Eurodance now?) and westernized Japanese musical motifs is the unlikely work of a Scottish doctor’s wife and singer of traditional Gaelic folk songs."
                                            },
                                            {
                                                "example_id": "c67e3720-40c5-4754-800a-ccfa95fe5f4b",
                                                "sense_id": "fa46c988-f9f8-3421-bcff-608c2b320688",
                                                "text": "Though the genre's formation took place in several countries across Europe, 20 years later Eurodance became the internationally most widespread popular music from Germany."
                                            }
                                        ]
