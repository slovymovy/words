                        "examples": [
                            {
                                "example_id": "da791cca-f49d-4c5c-8660-bbaf6f385141",
                                "sense_id": "a8c48691-c0c2-3c6d-b990-8d02d7d91fe0",
                                "text": "Car son œuvre n’est pas, comme celle de bien d’autres poètesses ou romancières, une auto-biographie, mais plutôt l’auto-biographie du Féminin tout entier, et comme le cri unanime de la corporation."
                            },
                            {
                                "example_id": "032f5436-ebcf-4c07-9b0d-df9efcce91c7",
                                "sense_id": "a8c48691-c0c2-3c6d-b990-8d02d7d91fe0",
                                "text": "Miss Frances Brown ! quelle est cette Miss qui fait des vers dignes de la sybille de Cumes ? demanda-t-il ? — C’est une poètesse, lui répondit-on, et qui est aveugle."
                            }
                        ]
