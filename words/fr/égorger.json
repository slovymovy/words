            "senses": [
                {
                    "sense_id": "1a8ae58c-a5d7-3927-9466-8fe20625dfd7",
                    "sense_definition": "Tuer un animal en lui coupant ou tranchant la gorge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boucher a appris la méthode traditionnelle pour <w>égorger</w> le mouton sans le faire souffrir."
                        },
                        {
                            "text": "Dans cette ferme, on <w>égorge</w> les volailles avant de les préparer pour le marché local."
                        }
                    ],
                    "synonyms": [
                        "couper la gorge",
                        "trancher la gorge"
                    ],
                    "common_phrases": [
                        "égorger un mouton"
                    ]
                },
                {
                    "sense_id": "6178fdbb-7fc1-3955-a120-b7f4ec9a8269",
                    "sense_definition": "Tuer une personne en lui tranchant la gorge, ou massacrer violemment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le criminel a menacé d'<w>égorger</w> les otages si la police tentait d'entrer dans le bâtiment."
                        },
                        {
                            "text": "Pendant la guerre civile, les rebelles ont <w>égorgé</w> des dizaines d'habitants dans ce village isolé."
                        }
                    ],
                    "synonyms": [
                        "couper la gorge",
                        "trancher la gorge"
                    ],
                    "common_phrases": [
                        "se faire égorger"
                    ]
                },
                {
                    "sense_id": "a2f717c5-04ef-3c57-8720-c8ac544dc623",
                    "sense_definition": "Mettre quelqu'un dans une situation financière intenable ou le ruiner complètement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruiner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec des taux d'intérêt aussi élevés, cette banque est en train d'<w>égorger</w> les petites entreprises."
                        },
                        {
                            "text": "Dans la crise financière actuelle, m'imposer de telles pénalités revient tout simplement à m'<w>égorger</w>."
                        }
                    ]
                }
            ]
        }
