                    {
                        "sense_id": "63debb27-2859-3b58-a54f-f634391acd18",
                        "entry_id": "337daae0-91c2-3424-9718-c0d86899e758",
                        "glosses": [
                            "Homme faible de corps, petit et grêle."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "438a5a63-3cbb-4405-ac22-5b515b31a137",
                                "sense_id": "63debb27-2859-3b58-a54f-f634391acd18",
                                "text": "Il le trouvait bien un peu gringalet, et ce n’était pas là un gendre comme il l’eût souhaité."
                            },
                            {
                                "example_id": "a3fb4bce-dc38-4b5f-bbd9-c9f33d284306",
                                "sense_id": "63debb27-2859-3b58-a54f-f634391acd18",
                                "text": "Il le dominait de sa force et de son assurance ; l’autre serrait les poings, tendait la tête, mais détournait le regard, gringalet rageur dans son veston étriqué."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f07a9365-0191-40ec-8805-61981649ea7d",
                        "source_entry_id": "337daae0-91c2-3424-9718-c0d86899e758",
