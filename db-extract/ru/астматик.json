                        "translation_id": "e03dcc5e-c386-4324-ac35-927d3f8bb9b6",
                        "source_entry_id": "4661e548-7b94-3ee1-b4b9-d6fb83c2d34a",
                        "source_sense_id": "4cf3eea1-532f-3997-b248-d34509a214b5",
                        "target_lang_word": "Asthmatiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asthmatiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56be126e-1c0d-3cd3-ac92-749056ba5eec",
                                        "entry_id": "d6ba391f-abad-3ee8-bf1f-4667397f5000",
                                        "glosses": [
                                            "Person, die an Asthma leidet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eade79aa-29a8-481c-8dfa-5a92413a9f0c",
                                                "sense_id": "56be126e-1c0d-3cd3-ac92-749056ba5eec",
                                                "text": "Er darf nicht teilnehmen, weil er Asthmatiker ist."
                                            },
                                            {
                                                "example_id": "f8d4d757-22cc-4ae5-a283-01d087742e66",
                                                "sense_id": "56be126e-1c0d-3cd3-ac92-749056ba5eec",
                                                "text": "„Darauf verstummte der Asthmatiker wieder, drückte sich in seinen Mantel, sie schlenderten durch den sanften Schnee.“"
                                            },
                                            {
                                                "example_id": "2180a555-03fe-4aba-ba0e-2f9110acaecf",
                                                "sense_id": "56be126e-1c0d-3cd3-ac92-749056ba5eec",
                                                "text": "„Es war ein sehniger Typus, mit flinken Bewegungen, der sich allerdings beim Sprechen als Asthmatiker erwies.“"
                                            },
                                            {
                                                "example_id": "0e5dc6c6-1a7c-4b1f-ac29-2ac726233b73",
                                                "sense_id": "56be126e-1c0d-3cd3-ac92-749056ba5eec",
                                                "text": "„Sein Rücken war gebeugt, seine Knie zitterten und mühevoll rang er nach Atem wie ein Asthmatiker, während er sich auf einen dicken Eichenstock stützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
