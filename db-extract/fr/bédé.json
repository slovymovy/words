                "translations": [
                    {
                        "translation_id": "df3b3a60-2244-4137-bd27-d59dc4e91ae4",
                        "source_entry_id": "9ca968e4-431d-3d29-b7dd-c59b4b8fa5ba",
                        "source_sense_id": "05cbb2e9-f853-374c-b671-6309540981e5",
                        "source_sense_description": "umgangssprachlich: Comic",
                        "target_lang_word": "Comic",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Comic",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f72f36de-ab33-36a5-bf4f-1788ef8baf55",
                                        "entry_id": "0c4d8de5-1103-36b2-afa0-9494118e4e32",
                                        "glosses": [
                                            "eine (nicht zwangsläufig komische) Bildergeschichte oder Bilderabfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "334d44b4-0d6f-4cf6-b081-571065899b21",
                                                "sense_id": "f72f36de-ab33-36a5-bf4f-1788ef8baf55",
                                                "text": "Die Bildergeschichten von Wilhelm Busch gelten als Vorläufer der Comics."
                                            },
                                            {
                                                "example_id": "4e3d95c2-ed9c-4a14-b93b-9fa333dbe80a",
                                                "sense_id": "f72f36de-ab33-36a5-bf4f-1788ef8baf55",
                                                "text": "„In den bürgerlichen Familien meiner Generation waren Comics streng verboten.“"
                                            },
                                            {
                                                "example_id": "f94f6408-51b7-447c-91ce-c66d355100f8",
                                                "sense_id": "f72f36de-ab33-36a5-bf4f-1788ef8baf55",
                                                "text": "„Im Comic streiten sich anfangs Dagobert und Donald im Geldspeicher.“"
                                            },
                                            {
                                                "example_id": "3e2756f5-9ca9-433a-a0fc-8cfa8d5f2622",
                                                "sense_id": "f72f36de-ab33-36a5-bf4f-1788ef8baf55",
                                                "text": "„In einem Comic würde jetzt das ganze Zugabteil wackeln.“"
                                            },
                                            {
                                                "example_id": "3d51c717-4a1d-44df-8e01-4dacad2b82b3",
                                                "sense_id": "f72f36de-ab33-36a5-bf4f-1788ef8baf55",
                                                "text": "„Interessant ist ein Vergleich dieser Onomatopoetika aus den Comics der letzten Jahrzehnte mit den von Wilhelm Busch in seinen Bildergeschichten seit 1864 verwendeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fdabdbf-31e7-37e9-ba21-b9a04ddb3f43",
                                        "entry_id": "0c4d8de5-1103-36b2-afa0-9494118e4e32",
                                        "glosses": [
                                            "ein Heft, das Comics [1] enthält; kurz für Comicheft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3ba7f7a-d2ba-4b05-bed9-aa18f425d137",
                                                "sense_id": "9fdabdbf-31e7-37e9-ba21-b9a04ddb3f43",
                                                "text": "Er hat sich heute einen Comic gekauft."
                                            },
                                            {
                                                "example_id": "4dbd97f6-6689-49eb-9ef8-03da7dc036ff",
                                                "sense_id": "9fdabdbf-31e7-37e9-ba21-b9a04ddb3f43",
                                                "text": "„Die Serie war aber kein Erfolg, die Comics wurden eingestampft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20f66579-c594-436f-a537-c3e5a6276fc0",
                        "source_entry_id": "9ca968e4-431d-3d29-b7dd-c59b4b8fa5ba",
