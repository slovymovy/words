                                                "sense_id": "4caca1c4-8f73-3443-9911-e21981b621e6",
                                                "text": "„Zwischen 1973 und 1984 wurde hier insgesamt zehnmal der Große Preis von Belgien der Formel 1 ausgetragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
