                "senses": [
                    {
                        "sense_id": "5c9cd8fc-0ef7-3f6f-83be-6f69d13c29e5",
                        "entry_id": "ae7920c8-7154-3ca9-b724-ea3a94c7b100",
                        "glosses": [
                            "eine stark ausgeprägte Fehlgestaltung eines Lebewesens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75764819-376f-4763-9d2d-ce38f04a4ffa",
                                "sense_id": "5c9cd8fc-0ef7-3f6f-83be-6f69d13c29e5",
                                "text": "„Der inhaltlichen Weite und Amorphie des gesamten Schmerzbereiches entspricht die Multivalenz des einzelnen Wortes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de1f9803-109b-3211-a519-f040282fd560",
                        "entry_id": "ae7920c8-7154-3ca9-b724-ea3a94c7b100",
                        "glosses": [
                            "amorpher Zustand – also ohne größere Ordnung – eines Stoffes"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "653671bd-929f-400b-9d6f-ffca94014bd4",
                                "sense_id": "de1f9803-109b-3211-a519-f040282fd560",
                                "text": "Ist dieser Stoff ein Kristall oder liegt Amorphie vor?"
                            },
                            {
                                "example_id": "4ebb9494-0995-450f-981d-57ae0f60e9db",
                                "sense_id": "de1f9803-109b-3211-a519-f040282fd560",
                                "text": "„Eine Linie von Mach zu Gehlen (vgl. S. 64) ziehend, schreibt der Verfasser Musil die Erkenntnis zu, »daß das Handeln des Menschen aus dem Verlust der anthropogenen Instinktsicherheit, der Amorphie, entspringt und immer in kompensatorischer Absicht geschieht« (S. 361).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
