                ],
                "senses": [
                    {
                        "sense_id": "5a8f7c4a-6c00-327a-89a5-f08a6061a6b1",
                        "entry_id": "02727109-cb55-3fe5-8918-d9b02a3db9ba",
                        "glosses": [
                            "Sand, der sich in einer Wüste befindet; aus dem die Oberfläche einer Sandwüste besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7602b9fa-a33b-41a3-a708-dc9571288c93",
                                "sense_id": "5a8f7c4a-6c00-327a-89a5-f08a6061a6b1",
                                "text": "„Die warme Luft aus Nordafrika hat Deutschland in den vergangenen Tagen nicht nur einen Vorgeschmack auf den Sommer beschert, sondern auch große Mengen an Wüstensand in unsere Gefilde geschaufelt.“"
                            },
                            {
                                "example_id": "ef553e92-2cde-4e40-8511-b503407c2460",
                                "sense_id": "5a8f7c4a-6c00-327a-89a5-f08a6061a6b1",
                                "text": "„Da Wüstensand nicht für Beton taugt, gerät der Meeresboden ins Visier.“"
                            },
                            {
                                "example_id": "607848c0-8440-4837-8434-f8e6f09d6c76",
                                "sense_id": "5a8f7c4a-6c00-327a-89a5-f08a6061a6b1",
                                "text": "„Wüstensand ist vom Wind so rund geschliffen, dass ihn kein Zement der Welt zusammenhält.“"
                            },
                            {
                                "example_id": "96428113-21d1-4195-85f6-37b2fe354682",
                                "sense_id": "5a8f7c4a-6c00-327a-89a5-f08a6061a6b1",
                                "text": "„Die Landschaft ist jämmerlich arm, alles ist verbrannt und begraben unter Wüstensand, Steppensand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
