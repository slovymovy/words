                    {
                        "sense_id": "193c2d9d-ed65-3751-8d5a-f0ad51a9a980",
                        "entry_id": "a76e79b5-fcb8-3efa-a4cd-5d8636bc39fd",
                        "glosses": [
                            "A fictional metal that is indestructible or nearly so."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f026f444-ea52-4846-824d-0cedf43c9f25",
                                "sense_id": "193c2d9d-ed65-3751-8d5a-f0ad51a9a980",
                                "text": "It was a bullet. It was a small slug of adamantium, the toughest and hardest of all metals, crammed to capacity with the terrific explosive feroxite and would burst instantly on any reasonable heavy impact."
                            },
                            {
                                "example_id": "6a6f460d-5dbd-4277-93cb-d175f90db43a",
                                "sense_id": "193c2d9d-ed65-3751-8d5a-f0ad51a9a980",
                                "text": "It's imperative that these experiments be concluded with haste! The military must know the potential of this new adamantium at once! Even the President is standing by!"
                            }
                        ]
                    }
                ],
