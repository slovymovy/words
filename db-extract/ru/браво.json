                                                "sense_id": "d5ac9f54-9d51-368e-b384-eb2060553ac1",
                                                "text": "It was a job well done."
                                            },
                                            {
                                                "example_id": "dcff7802-af18-4be5-9326-fa770bd667b8",
                                                "sense_id": "d5ac9f54-9d51-368e-b384-eb2060553ac1",
                                                "text": "\"We've never looked on the Borders Railway as it stands as a job well done. It's part one of a job well done.\""
                                            },
                                            {
                                                "example_id": "a1657ae6-dae1-48fa-8421-5bace4686629",
                                                "sense_id": "d5ac9f54-9d51-368e-b384-eb2060553ac1",
                                                "text": "They survived a poor second half in Italy and a drab first half-hour here but the end results certainly count as a job well done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80ef1833-f128-3585-86e8-c52a93a0db0f",
