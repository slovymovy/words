                                                "sense_id": "38aa3375-da1c-38f9-8d8c-84828df46c47",
                                                "text": "The prop fouled on the kelp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c1ad9a-4194-3303-9e95-d7dcce660789",
