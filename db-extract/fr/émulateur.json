                                    {
                                        "sense_id": "a2206062-54c7-3f88-afeb-72caa73babb7",
                                        "entry_id": "5c7182e3-6732-3650-9d44-81ac14fd9b74",
                                        "glosses": [
                                            "A person or thing that emulates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efaad74d-116c-4321-91b1-b1396aaac56e",
                                                "sense_id": "a2206062-54c7-3f88-afeb-72caa73babb7",
                                                "text": "I admire the conqueror of Tlajcala and of Culna, but I find in the life of this emulator of Caesar actions which, if necessity warranted, the heart must still refuse to approve […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1311a886-0c3b-390d-a70a-68c429f9f02f",
                                        "entry_id": "5c7182e3-6732-3650-9d44-81ac14fd9b74",
                                        "glosses": [
                                            "A piece of software or hardware that simulates another system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9a92ac0-ac6f-46b3-b3d7-bb8eb521a506",
                        "source_entry_id": "5966da19-e8f1-3eca-ad9e-3a1a95701e8f",
                        "source_sense_id": "6cf6032f-3ffd-3a0f-8f50-3c787c371d4e",
                        "source_sense_description": "programme informatique",
                        "target_lang_word": "emulatrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
