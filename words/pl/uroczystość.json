                {
                    "sense_id": "6f11f627-57d2-3924-92f6-1bab7117d308",
                    "sense_definition": "Oficjalne wydarzenie, ceremonia lub spotkanie zorganizowane w celu uczczenia ważnej okazji, święta lub osoby.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cała rodzina zjechała się na <w>uroczystość</w> z okazji złotych godów dziadków.",
                            "target_lang_translations": {
                                "ru": "Вся семья съехалась на <w>торжество</w> по случаю золотой свадьбы дедушки и бабушки.",
                                "en": "The whole family gathered for the <w>celebration</w> of their grandparents' golden wedding anniversary."
                            }
                        },
                        {
                            "text": "Oficjalna <w>uroczystość</w> państwowa rozpoczęła się od odegrania hymnu narodowego.",
                            "target_lang_translations": {
                                "ru": "Официальная государственная <w>церемония</w> началась с исполнения национального гимна.",
                                "en": "The official state <w>ceremony</w> began with the playing of the national anthem."
                            }
                        }
                    ],
                    "synonyms": [
                        "ceremonia",
                        "obchody",
                        "gala",
                        "świętowanie",
                        "celebracja"
                    ],
                    "common_phrases": [
                        "uroczystość rodzinna",
                        "uroczystość państwowa",
                        "uroczystość ślubna",
                        "udział w uroczystości",
                        "organizować uroczystość"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное событие, церемония или встреча, организованная в честь важного случая, праздника или человека.",
                        "en": "An official event, ceremony, or gathering organized to honor an important occasion, holiday, or person."
                    },
