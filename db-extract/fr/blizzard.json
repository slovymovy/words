                                "target_senses": [
                                    {
                                        "sense_id": "badca033-07b3-32a0-9409-e173deaf00dd",
                                        "entry_id": "01eadc5d-e8b5-3ae5-8492-9f320511cd5e",
                                        "glosses": [
                                            "ein starker Schneesturm"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e4b974-5da9-484e-92eb-7701d4c2e3c1",
                                                "sense_id": "badca033-07b3-32a0-9409-e173deaf00dd",
                                                "text": "Der Blizzard fordert jedes Jahr Opfer."
                                            },
                                            {
                                                "example_id": "3a0559b6-3a1a-4e54-8871-a4492f8d36f4",
                                                "sense_id": "badca033-07b3-32a0-9409-e173deaf00dd",
                                                "text": "Der Blizzard Jonas hat an der Ostküste der USA ein Verkehrschaos verursacht. Zwölf Menschen kamen bislang ums Leben, mehrere Bundesstaaten haben den Notstand ausgerufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
