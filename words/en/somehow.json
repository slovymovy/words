{
    "word_family": [
        "someway",
        "somewhat",
        "somewhere",
        "someone",
        "something"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "70030fe2-0143-3b3c-84a5-b811c0d303d1",
                    "sense_definition": "In one way or another; in a way not yet known or explained; by some means",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We don't know how he survived the accident, but <w>somehow</w> he is still alive.",
                            "target_lang_translations": {
                                "ru": "Мы не знаем, как он выжил в аварии, но <w>как-то</w> он все еще жив.",
                                "zh": "我们不知道他是怎么在事故中幸存下来的，但<w>不知怎么地</w>，他还活着。"
                            }
                        },
                        {
                            "text": "This difficult problem has to be <w>somehow</w> managed before the deadline tomorrow.",
                            "target_lang_translations": {
                                "ru": "Эту сложную проблему нужно <w>как-нибудь</w> решить до завтрашнего дедлайна.",
                                "zh": "这个难题必须在明天截止日期前<w>设法</w>解决。"
                            }
                        },
                        {
                            "text": "I forgot my keys, but I managed to get <w>somehow</w> inside the house.",
                            "target_lang_translations": {
                                "ru": "Я забыл ключи, но мне удалось <w>каким-то образом</w> попасть внутрь дома.",
                                "zh": "我忘了带钥匙，但我还是<w>以某种方式</w>进了屋。"
                            }
                        }
                    ],
                    "synonyms": [
                        "someway",
                        "somewise"
                    ],
                    "common_phrases": [
                        "somehow managed",
                        "somehow or other",
                        "get somehow inside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тем или иным образом; способом, который еще не известен или не объяснен; какими-то средствами",
                        "zh": "以某种方式；以一种尚不清楚或无法解释的方式；通过某种手段"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "как-то",
                                "target_lang_sense_clarification": "каким-то образом, неизвестно как"
                            },
                            {
                                "target_lang_word": "как-нибудь",
                                "target_lang_sense_clarification": "любым возможным способом, так или иначе"
                            },
                            {
                                "target_lang_word": "каким-то образом",
                                "target_lang_sense_clarification": "неизвестным или непонятным путем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不知怎么地",
                                "target_lang_sense_clarification": "表示原因或方式不明"
                            },
                            {
                                "target_lang_word": "设法",
                                "target_lang_sense_clarification": "表示通过某种手段达成目的"
                            },
                            {
                                "target_lang_word": "以某种方式",
                                "target_lang_sense_clarification": "强调通过某种途径"
                            }
                        ]
                    }
                }
            ]
        }
    ]
