                "senses": [
                    {
                        "sense_id": "d71215a7-2814-330d-857d-e86e885d7b92",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "elk van de vier ledematen van een mannelijke geit of hert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28870b72-c7fc-4cc5-a4bb-522833fbf1cf",
                                "sense_id": "d71215a7-2814-330d-857d-e86e885d7b92",
                                "text": "Meestal moet een amulet een gevaar voor de drager afweren, maar welk: een of andere bokkenziekte, een trap van een bokkenpoot, de vrees geofferd te worden?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a4f93ba-2ef6-3d3a-9766-494d47dcec2d",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "benaming voor op ledematen van een bok lijkende benen van een mythisch wezen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f3bb01b4-27b6-4086-a55f-7d1290ab841e",
                                "sense_id": "5a4f93ba-2ef6-3d3a-9766-494d47dcec2d",
                                "text": "Mijn boeken zitten vol met djinns – dat zijn demonen uit de arabische wereld die in waterputten en toiletten huizen – en dit toneelstuk begint al met een visioen van de hel: in de openingsmonoloog vermeng ik de schaduw van de God Pan met het middeleeuwse beeld van de duivel met bokkenpoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bd9a491-bc0f-3e19-b5ec-1309b6f2fda2",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "aanduiding voor een mythisch wezen met benen die op de poten van een bok lijken, zoals een duivel of een sater"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "32032fef-d961-4aac-9160-d5ddfc0c8f7d",
                                "sense_id": "7bd9a491-bc0f-3e19-b5ec-1309b6f2fda2",
                                "text": "Eerst komt de aanval van satan, die bokkenpoot, van buitenaf."
                            }
                        ]
                    },
                    {
                        "sense_id": "780058b1-139e-348c-977a-ed2422b439de",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "kwast waarvan de borstel met een knik aan de steel zit, om plekken te schilderen of smeren die met een rechte steel moeilijk te bereiken zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff26f75-52ee-4078-8646-f03d2fdd5ed8",
                                "sense_id": "780058b1-139e-348c-977a-ed2422b439de",
                                "text": "In vroeger tijden had iedere sluis een eigen onderhoudsmonteur die op geregelde tijden met een emmertje smeermiddel en een bokkenpoot de kettingen smeerde."
                            }
                        ]
                    },
                    {
                        "sense_id": "84dc31eb-9791-35f8-b736-a8e37bedd85d",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "sierlijke poot van een meubelstuk die onderaan met een ronde verdikking eindigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9cc84c6-1a0a-485b-978c-564268a65d9f",
                                "sense_id": "84dc31eb-9791-35f8-b736-a8e37bedd85d",
                                "text": "De stoel heeft overhoekse bokkenpoten die als voet een uitgedijde zool hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fda3a28-563c-3f4c-a07f-68433918068a",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "handvat met een plat afgerond uiteinde, waarmee de nagelriem kan worden teruggeduwd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28194e22-9178-4c96-a068-805a2e07aace",
                                "sense_id": "4fda3a28-563c-3f4c-a07f-68433918068a",
                                "text": "Een onmisbare accessoire in de manicure behandeling is de bokkenpoot. Zijn je nagelriemen soepel en zacht geworden door de nagelriemcrème? Dan is het tijd om met een bokkenpoot de nagelriem voorzichtig terug te duwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa5b5d43-a1af-3542-be40-df428b854ffe",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "staafje in een uurwerk dat ervoor zorgt dat op gezette tijden een geluidssignaal wordt gegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79469e2a-0a4e-463a-8b97-6659f8c1324e",
                                "sense_id": "aa5b5d43-a1af-3542-be40-df428b854ffe",
                                "text": "Een andere manier is het handmatig oplichten van de bokkenpoot of de paardenkop. Na deze handeling gaat het uurwerk slaan. Dat oplichten kan dan worden herhaald tot het uurwerk weer op slag is."
                            }
                        ]
                    },
                    {
                        "sense_id": "be08d1bf-e7cd-377a-964d-c60071c088e0",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "sierplant met schijnstammen, Alpinia purpurata, bloeiend met een aar die rode schutbladen heeft#:▸ “Wij hebben tijdens ons bezoek vele van deze vrouwen persoonlijk een bloemetje aangeboden en hun een fijne Moederdag toegewenst. De bloemetjes, onze Surinaamse bokkenpoot en Braziliaanse lelie, vielen ook bijzonder in de smaak”, zegt voorzitter Angelic del Castilho."
                        ],
                        "tags": [
                            "Suriname"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ec91ee53-cd6e-3e67-a01d-ea9eda9503e9",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "onderdeel van een hijskraan of heistelling, bestaande uit twee schuine palen die bovenaan met elkaar zijn verbonden en scharnierend met de ondergrond zijn verbonden"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a50b91fa-44d0-498d-95fb-521116b25ded",
                                "sense_id": "ec91ee53-cd6e-3e67-a01d-ea9eda9503e9",
                                "text": "⧖ Hierop komen de beenen van een bok, de z.g. „bokkenpoot”, (een kleine schrank) met hun topeinden te rusten. De voeteinden vinden op dezelfde plaat steun als de stellingbeenen. Zoowel de ondereinden van de stellingschrank als van den bokkenpoot zijn van „proken” (…) voorzien om het onderuitglijden tegen te gaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "3eb56ac4-e263-3823-b430-358285510aa8",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "scharnierende constructie waarmee de mast van een zeilschip kan worden opgezet of gestreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1a9eb77-f442-4bb0-aa93-18c4d1421bca",
                                "sense_id": "3eb56ac4-e263-3823-b430-358285510aa8",
                                "text": "Bij het strijken van de mast op een tjalk brak de bokkenpoot, waardoor de mast viel en vrouw, schipper en knecht gekwetst werden; de vrouw is per brancard naar het Gasthuis vervoerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "2807f365-3c2b-32c1-aad4-2f53ac9699d5",
                        "entry_id": "60723f22-6c2d-3c1a-93da-404d6608b55e",
                        "glosses": [
                            "benaming voor infanterist of marinier"
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "46938ac0-db0c-4892-8258-529f4ab28710",
                                "sense_id": "2807f365-3c2b-32c1-aad4-2f53ac9699d5",
                                "text": "Was je infanterist, dan werd je nageroepen voor „bokkenpoot\" of zandhaas."
                            }
                        ]
                    }
                ],
