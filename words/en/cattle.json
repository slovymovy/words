{
    "word_family": [
        "cattleman",
        "cattlewoman",
        "cattleship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c96f686-8d0b-3d3f-89e3-dc2d4051e5e4",
                    "sense_definition": "Large domesticated farm animals kept for their milk or meat; cows, bulls, and oxen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer keeps a large herd of <w>cattle</w> in the green pasture.",
                            "target_lang_translations": {
                                "ru": "Фермер держит большое стадо <w>скота</w> на зеленом пастбище.",
                                "tr": "Çiftçi yeşil otlakta büyük bir <w>sığır</w> sürüsü besliyor.",
                                "zh": "农夫在绿色的牧场里养了一大群<w>牲畜</w>。"
                            }
                        },
                        {
                            "text": "We saw many <w>cattle</w> grazing peacefully on the hillside.",
                            "target_lang_translations": {
                                "ru": "Мы видели много <w>скота</w>, мирно пасущегося на склоне холма.",
                                "tr": "Tepede huzur içinde otlayan birçok <w>büyükbaş hayvan</w> gördük.",
                                "zh": "我们看到许多<w>牛</w>在山坡上安静地吃草。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cows",
                        "livestock"
                    ],
                    "common_phrases": [
                        "herd of cattle",
                        "dairy cattle",
                        "beef cattle",
                        "raising cattle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный рогатый скот, разводимый ради молока или мяса; коровы, быки и волы.",
                        "tr": "Sütü veya eti için yetiştirilen, inek, boğa ve öküz gibi büyükbaş evcil çiftlik hayvanları.",
                        "zh": "为获取乳制品或肉类而饲养的大型家畜，如牛、公牛和阉牛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скот",
                                "target_lang_sense_clarification": "общее название сельскохозяйственных животных"
                            },
                            {
                                "target_lang_word": "крупный рогатый скот",
                                "target_lang_sense_clarification": "сельскохозяйственный термин"
                            },
                            {
                                "target_lang_word": "скотина",
                                "target_lang_sense_clarification": "разговорное, собирательное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sığır",
                                "target_lang_sense_clarification": "büyükbaş hayvanların genel adı"
                            },
                            {
                                "target_lang_word": "büyükbaş hayvan",
                                "target_lang_sense_clarification": "çiftlik hayvanları için kullanılan terim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牲畜",
                                "target_lang_sense_clarification": "泛指家畜"
                            },
                            {
                                "target_lang_word": "牛群",
                                "target_lang_sense_clarification": "指成群的牛"
                            },
                            {
                                "target_lang_word": "家牛",
                                "target_lang_sense_clarification": "农业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b85f0f6-0a97-3017-a8ad-ef5b328a227e",
                    "sense_definition": "People who are treated as a mass without individuality or who follow orders blindly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired commuters were herded onto the crowded train like <w>cattle</w>.",
                            "target_lang_translations": {
                                "ru": "Уставших пассажиров загнали в переполненный поезд, как <w>скот</w>.",
                                "tr": "Yorgun yolcular kalabalık trene <w>sürü</w> gibi bindirildi.",
                                "zh": "疲惫的通勤者像<w>牲口</w>一样被赶上了拥挤的火车。"
                            }
                        },
                        {
                            "text": "He refused to be treated like <w>cattle</w> by the aggressive security guards.",
                            "target_lang_translations": {
                                "ru": "Он отказался позволять агрессивным охранникам обращаться с собой, как с <w>быдлом</w>.",
                                "tr": "Saldırgan güvenlik görevlileri tarafından kendisine <w>sığır</w> muamelesi yapılmasını reddetti.",
                                "zh": "他拒绝被那些咄咄逼人的保安像<w>牛马</w>一样对待。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sheeple"
                    ],
                    "common_phrases": [
                        "treated like cattle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, к которым относятся как к безликой массе или которые слепо подчиняются приказам.",
                        "tr": "Bireyselliği yok sayılarak bir kitle gibi davranılan veya emirlere körü körüne uyan insanlar.",
                        "zh": "指被视为无个性的群体，或盲目服从命令的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быдло",
                                "target_lang_sense_clarification": "презрительное, о покорных людях"
                            },
                            {
                                "target_lang_word": "скот",
                                "target_lang_sense_clarification": "переносное значение, грубо"
                            },
                            {
                                "target_lang_word": "стадо",
                                "target_lang_sense_clarification": "метафора бездумной толпы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sürü",
                                "target_lang_sense_clarification": "düşüncesizce hareket eden topluluk anlamında mecaz"
                            },
                            {
                                "target_lang_word": "sığır",
                                "target_lang_sense_clarification": "aşağılayıcı veya kaba kullanım"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牛马",
                                "target_lang_sense_clarification": "比喻受人驱使、任劳任怨的人"
                            },
                            {
                                "target_lang_word": "行尸走肉",
                                "target_lang_sense_clarification": "比喻没有思想、盲目随大流的人"
                            },
                            {
                                "target_lang_word": "乌合之众",
                                "target_lang_sense_clarification": "比喻无组织、盲从的群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40b6aae0-fb67-31b2-8b38-158406e5fb38",
                    "sense_definition": "Livestock other than cows, such as horses, sheep, or pigs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old story, the coachman checked the horses, referring to them as his <w>cattle</w>.",
                            "target_lang_translations": {
                                "ru": "В старом рассказе кучер проверял лошадей, называя их своим <w>скотом</w>.",
                                "tr": "Eski hikayede arabacı, atları kontrol ederken onlardan kendi <w>davar</w>ı olarak bahsediyordu.",
                                "zh": "在那个古老的故事里，马车夫检查马匹时，把它们称为自己的<w>牲口</w>。"
                            }
                        },
                        {
                            "text": "The market sold various goods and <w>cattle</w>, including sheep and swine.",
                            "target_lang_translations": {
                                "ru": "На рынке продавались различные товары и <w>скот</w>, включая овец и свиней.",
                                "tr": "Pazarda koyun ve domuz da dahil olmak üzere çeşitli mallar ve <w>hayvanlar</w> satılıyordu.",
                                "zh": "市场上出售各种商品和<w>家畜</w>，包括羊和猪。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Домашний скот, отличный от коров, например лошади, овцы или свиньи.",
                        "tr": "At, koyun veya domuz gibi inek dışındaki evcil çiftlik hayvanları (eski kullanım).",
                        "zh": "除牛以外的家畜，如马、羊或猪（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скот",
                                "target_lang_sense_clarification": "устаревшее использование для любых животных"
                            },
                            {
                                "target_lang_word": "живность",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "davar",
                                "target_lang_sense_clarification": "küçükbaş veya genel evcil hayvanlar için kullanılan eski terim"
                            },
                            {
                                "target_lang_word": "hayvanlar",
                                "target_lang_sense_clarification": "genel canlı/çiftlik hayvanı kullanımı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牲口",
                                "target_lang_sense_clarification": "指供役用的家畜"
                            },
                            {
                                "target_lang_word": "家畜",
                                "target_lang_sense_clarification": "泛指饲养的动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c7ea2ef-a0d1-3ea2-a1da-472440559ac9",
                    "sense_definition": "Personal property or goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law seized all his goods and <w>cattle</w> to pay the outstanding debt.",
                            "target_lang_translations": {
                                "ru": "По закону все его товары и <w>движимое имущество</w> были изъяты для уплаты непогашенного долга.",
                                "tr": "Kanun, ödenmemiş borcunu ödemek için tüm mallarına ve <w>taşınır mülküne</w> el koydu.",
                                "zh": "法律没收了他所有的货物和<w>动产</w>以偿还未清偿的债务。"
                            }
                        },
                        {
                            "text": "He lost his land and all his <w>cattle</w> in the unfortunate lawsuit.",
                            "target_lang_translations": {
                                "ru": "Он потерял свою землю и всё своё <w>имущество</w> в результате неудачного судебного процесса.",
                                "tr": "Talihsiz dava sonucunda toprağını ve tüm <w>mülkünü</w> kaybetti.",
                                "zh": "在那场不幸的官司中，他失去了土地和所有的<w>财物</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "legal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личное имущество или товары.",
                        "tr": "Kişisel mülk veya taşınır mal (eski hukuki terim).",
                        "zh": "个人财产或物品（法律旧称）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имущество",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "движимость",
                                "target_lang_sense_clarification": "устаревшее юридическое значение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "taşınır mal",
                                "target_lang_sense_clarification": "hukuki terim"
                            },
                            {
                                "target_lang_word": "mülk",
                                "target_lang_sense_clarification": "kişisel eşya ve mal varlığı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动产",
                                "target_lang_sense_clarification": "法律术语，指可移动的财产"
                            },
                            {
                                "target_lang_word": "财物",
                                "target_lang_sense_clarification": "泛指财产和物品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1edc8399-8b7b-3648-8d88-26f7b51e77a4",
                    "sense_definition": "A surname used to identify a person's family.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cattle</w> arrived late for the board meeting yesterday.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кэттл</w> вчера опоздал на заседание совета директоров.",
                                "tr": "Bay <w>Cattle</w> dün yönetim kurulu toplantısına geç geldi.",
                                "zh": "<w>卡特尔</w>先生昨天开董事会迟到了。"
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Cattle</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Кэттл</w>.",
                                "tr": "Daha önce soyadı <w>Cattle</w> olan kimseyle karşılaşmamıştım.",
                                "zh": "我以前从未见过姓<w>卡特尔</w>的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, указывающая на принадлежность к семье.",
                        "tr": "Bir kişinin aile kimliğini belirten bir soyadı.",
                        "zh": "用于标识个人家族的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кэттл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Cattle",
                                "target_lang_sense_clarification": "özel soyadı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡特尔",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb85e968-8d05-3beb-af27-cf6ddb7493af",
                    "sense_definition": "To break or destroy something completely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to fix the engine, but I think I <w>cattled</w> it instead.",
                            "target_lang_translations": {
                                "ru": "Я пытался починить двигатель, но, кажется, вместо этого <w>угробил</w> его.",
                                "tr": "Motoru tamir etmeye çalıştım ama sanırım bunun yerine onu <w>haşat ettim</w>.",
                                "zh": "我试着修理引擎，但我觉得我反而把它<w>搞坏</w>了。"
                            }
                        },
                        {
                            "text": "Be careful with that machine so you do not <w>cattle</w> it.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен с этой машиной, чтобы не <w>сломать</w> её.",
                                "tr": "O makineye dikkat et ki onu <w>bozmayasın</w>.",
                                "zh": "小心使用那台机器，别把它<w>报废</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Cockney rhyming slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью сломать или разрушить что-либо.",
                        "tr": "Bir şeyi tamamen kırmak veya mahvetmek (argo).",
                        "zh": "彻底破坏或毁坏某物（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угробить",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "сломать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haşat etmek",
                                "target_lang_sense_clarification": "argo, bozmak veya bozuluşa uğratmak"
                            },
                            {
                                "target_lang_word": "bozmak",
                                "target_lang_sense_clarification": "kullanılmaz hale getirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞坏",
                                "target_lang_sense_clarification": "口语，指弄坏"
                            },
                            {
                                "target_lang_word": "报废",
                                "target_lang_sense_clarification": "指彻底损坏无法使用"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}