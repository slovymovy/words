                "senses": [
                    {
                        "sense_id": "3e4a1ed0-4248-343d-baae-02dc55d9221d",
                        "entry_id": "22329330-06b2-3f14-aa5a-e985c2152619",
                        "glosses": [
                            "разг. тот, кто устраивает, организует что либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d32002f-edd5-4b68-9c7f-ff3d906e2a78",
                                "sense_id": "3e4a1ed0-4248-343d-baae-02dc55d9221d",
                                "text": "Имя устроителя Руси, конечно, принадлежит Иоанну."
                            },
                            {
                                "example_id": "999885a8-96f6-49e0-b380-6de699112821",
                                "sense_id": "3e4a1ed0-4248-343d-baae-02dc55d9221d",
                                "text": "Что Наполеон в действии, то Гёте в созерцании; оба ― устроители хаоса ― Революции."
                            },
                            {
                                "example_id": "0c81e5bd-1712-495c-9f06-98a2c6cfd2a6",
                                "sense_id": "3e4a1ed0-4248-343d-baae-02dc55d9221d",
                                "text": "Надеемся, что его изобретение заинтересует устроителей Олимпийских игр в Москве."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "732c6b14-9df3-4383-b2a0-cc77d6f5ad18",
                        "source_entry_id": "22329330-06b2-3f14-aa5a-e985c2152619",
                        "source_sense_id": "3e4a1ed0-4248-343d-baae-02dc55d9221d",
                        "target_lang_word": "organizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be8dfc42-ee2d-3eea-b50c-1e30661139ad",
                                        "entry_id": "b5fe9042-4197-3ee6-bc25-9f0243561c7c",
                                        "glosses": [
                                            "A person who arranges the details of a public event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fee91b-d2f0-49d5-9653-3bf3f2c691e0",
                                                "sense_id": "be8dfc42-ee2d-3eea-b50c-1e30661139ad",
                                                "text": "Jennifer Pastore Monroy, executive director of the National Association of Productivity and Organizing Professionals, emphasized that “the relationship that clients build with a professional organizer is a very personal one, and so your experience will depend on what you’re trying to get out of it.” […] “Professional organizers and productivity consultants work a whole spectrum of services to help people,” she explained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3c924c3-2d54-38a5-8986-a1d7953f709b",
                                        "entry_id": "b5fe9042-4197-3ee6-bc25-9f0243561c7c",
                                        "glosses": [
                                            "A hand-held micro-computer that will perform specific tasks; can be used as an electronic diary, alarm clock, recorder of memos and notes, a portable database etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4492b281-9a6f-41c3-a4e7-e06a10f64027",
                                                "sense_id": "e3c924c3-2d54-38a5-8986-a1d7953f709b",
                                                "text": "I'll add that meeting to my organizer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038034f3-1bb3-3c25-90e5-18989a6871d6",
                                        "entry_id": "b5fe9042-4197-3ee6-bc25-9f0243561c7c",
                                        "glosses": [
                                            "A non-electronic notebook or calendar or something similar, used to organize one's affairs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "961b801b-2f45-326c-9585-92f18f76c225",
                                        "entry_id": "b5fe9042-4197-3ee6-bc25-9f0243561c7c",
                                        "glosses": [
                                            "A group of cells that, together with the evocator, control differentiation in the embryo; the inductor"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73728413-7d4a-3f22-bbaf-a956082d7800",
                                        "entry_id": "b5fe9042-4197-3ee6-bc25-9f0243561c7c",
                                        "glosses": [
                                            "a recipient, such as a box or a case, used for storing gadgets, trinkets and other knick-knacks; an organizer box"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "061f4b4e-d388-45aa-9741-ad6c797eb699",
                                                "sense_id": "73728413-7d4a-3f22-bbaf-a956082d7800",
                                                "text": "desk organizer"
                                            },
                                            {
                                                "example_id": "1a651b1d-2066-40ae-8ad5-49bd28a7396d",
