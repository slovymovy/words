                "senses": [
                    {
                        "sense_id": "80dec1d9-1997-3efa-a016-c952e18249d9",
                        "entry_id": "4706d921-4c0d-3ed8-b08a-dd36e404881a",
                        "glosses": [
                            "Qui décontracte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a064ce-99db-4791-a3ea-7b86ddebf8af",
                                "sense_id": "80dec1d9-1997-3efa-a016-c952e18249d9",
                                "text": "Ici la question se complique. Elle ne peut plus seulement se résoudre par les principes, il faut qu’elle se résolve par l’accord des parties contractantes, ou plutôt décontractantes, et sous la tutelle de leur bonne foi."
                            },
                            {
                                "example_id": "c86aa91a-fed5-485d-92a5-c1d0852d6338",
                                "sense_id": "80dec1d9-1997-3efa-a016-c952e18249d9",
                                "text": "Un troisième problème est de fournir une réponse sur l’efficacité souvent médiocre en thérapeutique humaine des drogues décontractantes utilisées aux doses usuelles en cas de crise douloureuse biliaire."
                            }
                        ]
                    }
                ],
