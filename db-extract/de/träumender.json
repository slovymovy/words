                "senses": [
                    {
                        "sense_id": "a97a5f5d-6335-372f-b67a-21e5370b6ac0",
                        "entry_id": "02f69a20-d22f-3dcd-8f60-cd44a7a36293",
                        "glosses": [
                            "Person, die träumt, einen Traum hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b435ab86-fe89-43d7-a60b-77d57ce8b932",
                                "sense_id": "a97a5f5d-6335-372f-b67a-21e5370b6ac0",
                                "text": "„Die Träumenden, sie würden uns für verrückt halten.“"
                            },
                            {
                                "example_id": "072fa2b0-cb0b-48ce-8551-22067effec6e",
                                "sense_id": "a97a5f5d-6335-372f-b67a-21e5370b6ac0",
                                "text": "„Auch der Träumende befand sich unter den Demütigen, und als der Segen erteilt war und die Sonne allmählich schwarz wurde, drängte er sich nach vorne, hob die Hand und rief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
