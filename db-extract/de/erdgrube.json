                        "examples": [
                            {
                                "example_id": "4134f56f-4ce2-45c5-8666-a41b464d8607",
                                "sense_id": "ef025296-854b-3b18-95a7-b21297defa4d",
                                "text": "„Es waren zwei Erdgruben da, nur knietief, aber breit genug, um je zwei Züge aufzunehmen.“"
                            },
                            {
                                "example_id": "be8f14c4-e439-4e08-8ebe-cda75a05166f",
                                "sense_id": "ef025296-854b-3b18-95a7-b21297defa4d",
                                "text": "„All die Jahrzehnte, die es auf dem Boden der Erdgrube gelegen hatte, hatte es auf uns gewartet.“"
                            }
                        ],
