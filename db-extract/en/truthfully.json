                        "glosses": [
                            "In a truthful manner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "467bf2e1-3742-4183-a1eb-e6cacf463251",
                                "sense_id": "7f83f8bd-7b03-3780-8d40-1aea196bf6ce",
                                "text": "He spoke truthfully."
                            },
                            {
                                "example_id": "e85eb77d-019b-4644-b210-5b98e7cce68a",
                                "sense_id": "7f83f8bd-7b03-3780-8d40-1aea196bf6ce",
                                "text": "The common gay does well being less concerned with joining the Great Gay Bandwagon […] and more concerned with living unostentatiously, honestly, truthfully, and quietly."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ee39a8e-9682-3dc3-82dd-4fd6df465c8d",
                        "entry_id": "130a9e6b-0f5d-3626-932c-823289c59df2",
                        "glosses": [
                            "Frankly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82bccf85-612c-42dc-8cd2-2c87c7928635",
                                "sense_id": "3ee39a8e-9682-3dc3-82dd-4fd6df465c8d",
                                "text": "Truthfully, I didn't suspect a thing."
                            },
                            {
                                "example_id": "ba558b56-148a-4353-828b-97cfc2f8226c",
                                "sense_id": "3ee39a8e-9682-3dc3-82dd-4fd6df465c8d",
                                "text": "Truthfully, I was kind of average until my life went from snooze to snazztastic in about sixty seconds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
