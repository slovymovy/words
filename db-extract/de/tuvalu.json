                "senses": [
                    {
                        "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                        "entry_id": "bb5c0a69-a2e4-3f78-8cfd-e55f88442b2f",
                        "glosses": [
                            "Inselstaat in Ozeanien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21cd50b-8733-45ad-99f6-8f3ed7b92268",
                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                "text": "Der Verkauf von Tuvalus Internetadressendung „.tv“ hat der dem kleinen Staat bereits über 50 Millionen Dollar eingebracht."
                            },
                            {
                                "example_id": "242418ca-3751-4b7a-818a-03bed5524bc9",
                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                "text": "Das Tuvalu der Zukunft wird vielleicht eine Unterwasserlandschaft sein."
                            },
                            {
                                "example_id": "9c00f9e0-5dcb-4d8a-b9fc-a5e0f1d03066",
                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                "text": "Funafuti ist die Hauptstadt von Tuvalu."
                            },
                            {
                                "example_id": "f8a554bb-efbd-4a26-bd84-d2ba9ab2e518",
                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                "text": "Der reiselustige Theo will sich demnächst endlich ein Bild von Tuvalus Schönheit machen."
                            },
                            {
                                "example_id": "660b85a4-c876-41ff-82c8-b378c3050be6",
                                "sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
                                "text": "„Um 500 n. Chr. kamen polynesische Einwanderer von Samoa und Tonga nach Tuvalu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48d76689-86dc-4d38-94ee-50731918e13c",
                        "source_entry_id": "bb5c0a69-a2e4-3f78-8cfd-e55f88442b2f",
                        "source_sense_id": "079b89f7-440c-3765-8f6c-4596e68d74d4",
