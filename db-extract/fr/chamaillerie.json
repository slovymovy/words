                        "cross_references": [
                            {
                                "target_word": "gekibbel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ae8b22b6-c266-3287-a208-877ae1f0f802",
                                        "entry_id": "aff55acf-6342-3c0b-8278-940f7cdc232f",
                                        "glosses": [
                                            "aanhoudend ruzie maken over onbelangrijke dingen, over beuzelingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9182ab87-b8a3-42b4-b98e-f47528075549",
                                                "sense_id": "ae8b22b6-c266-3287-a208-877ae1f0f802",
                                                "text": "Waarom zouden de politici, wier beleid tot nu toe heeft uitgeblonken in zigzagbewegingen, uitstelgedrag en onderling gekibbel, dit keer wel in staat zijn tot daadkrachtig beleid? Het grootste probleem van het ontwerp is dat de concrete uitwerking ontbreekt."
                                            },
                                            {
                                                "example_id": "c72fe5d8-6071-47ed-901b-72c38174f5e6",
                                                "sense_id": "ae8b22b6-c266-3287-a208-877ae1f0f802",
                                                "text": "Ondanks het gekibbel, was er ook ruimte om over emoties te praten. De Robinsonners kregen in de vorm van een brief of korte video eindelijk bericht van het thuisfront. En dat deed ze goed, al zorgde het wel voor de nodige waterlanders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c666de8b-50e2-460d-9217-ed82eb475731",
                        "source_entry_id": "6104feab-8858-39e8-a645-d54acff3043d",
                        "source_sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                        "target_lang_word": "размолвка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "размолвка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d9f4d598-a057-3fc0-a78a-935625611ef2",
                                        "entry_id": "7453c22d-97e0-364a-ab64-f86c4c4fc73f",
                                        "glosses": [
                                            "лёгкая ссора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d86d11fc-c802-4a4a-b3f9-e0cb890179f7",
                                                "sense_id": "d9f4d598-a057-3fc0-a78a-935625611ef2",
                                                "text": "Если продолжить чеченскую тему, то, к сожалению, на этой почве у меня получилась размолвка с некоторыми моими добрыми друзьями, к счастью, не очень долгая."
                                            },
                                            {
                                                "example_id": "3120bc6e-0fca-4164-8b23-bb8a57a47f6a",
                                                "sense_id": "d9f4d598-a057-3fc0-a78a-935625611ef2",
                                                "text": "Я заметил, что перед моим приходом у них что-то произошло, ссора или серьёзная размолвка."
                                            },
                                            {
                                                "example_id": "f098e328-b3da-4a06-98f4-6d02aba30267",
                                                "sense_id": "d9f4d598-a057-3fc0-a78a-935625611ef2",
                                                "text": "Они выпили и, прожёвывая пирожки, опять молча полюбовались друг другом, понимая, что в эту минуту их не может разъединить никакая размолвка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
