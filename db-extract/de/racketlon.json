                    {
                        "sense_id": "c80bf4e3-26af-3fa9-b6b7-b352f7665f16",
                        "entry_id": "e28af069-04da-3910-a97b-dc3145c57b4b",
                        "glosses": [
                            "Kombinationsturniersportart, die aus den vier Disziplinen Tischtennis, Badminton, Squash und Tennis besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cffbb67e-faf3-4a25-ad3e-166f408632be",
                                "sense_id": "c80bf4e3-26af-3fa9-b6b7-b352f7665f16",
                                "text": "Die heute übliche Reihenfolge im Rackelton, Tischtennis, Badminton, Squash und Tennis wurde gewählt, weil es mit dem kleinsten Schläger beginnt und dem größten aufhört."
                            },
                            {
                                "example_id": "573ae597-c96e-47b9-8d30-50a2f2af9da9",
                                "sense_id": "c80bf4e3-26af-3fa9-b6b7-b352f7665f16",
                                "text": "Es treten beim Rackelton jeweils dieselben Spieler (Einzel oder Doppel) in allen vier Disziplinen gegeneinander an."
                            },
                            {
                                "example_id": "6f15ddc8-78a2-4d04-9a22-6395da127daf",
                                "sense_id": "c80bf4e3-26af-3fa9-b6b7-b352f7665f16",
                                "text": "An Racketlon-Turnieren können alle Racketsport-Anhänger unabhängig ihrer Spielstärke teilnehmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
