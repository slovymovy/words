                ],
                "senses": [
                    {
                        "sense_id": "08291844-139d-37aa-9d68-ff6e9e0613a7",
                        "entry_id": "6b3c20bf-4341-37c4-b9ce-4e24edee406b",
                        "glosses": [
                            "Sport mit hohen physischen und psychischen Belastungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c542526-7cff-41bc-846e-f56fc0f4f161",
                                "sense_id": "08291844-139d-37aa-9d68-ff6e9e0613a7",
                                "text": "„Heutzutage wird Apnoetauchen als Freizeit-, aber auch als Leistungs- bzw. Extremsport betrieben“"
                            },
                            {
                                "example_id": "0e270e0e-1fa2-4ad9-96e0-557ae829311b",
                                "sense_id": "08291844-139d-37aa-9d68-ff6e9e0613a7",
                                "text": "„Coubertin schuf damit eine Formel, unter welcher der Spitzensport, der Extremsport und der Wagnissport spiralförmig aufblühten.“"
                            },
                            {
                                "example_id": "fa95cc3f-59ad-4647-9e76-93b417bbfd75",
                                "sense_id": "08291844-139d-37aa-9d68-ff6e9e0613a7",
                                "text": "„Canyoning ist ein Extremsport, bei dem man dem Lauf des Wassers durch Schluchten folgt.“"
                            },
                            {
                                "example_id": "457a9425-3e89-4642-ad10-03b0dcf579d9",
                                "sense_id": "08291844-139d-37aa-9d68-ff6e9e0613a7",
                                "text": "„Auf der stetigen Suche nach neuen Herausforderungen und Extremen entwickelten sich die unterschiedlichsten Arten des Extremsportes.“"
                            },
                            {
                                "example_id": "5d7bcb8d-f3cb-49d5-8e91-b3bfff7e2b40",
                                "sense_id": "08291844-139d-37aa-9d68-ff6e9e0613a7",
                                "text": "„Vor vier Jahren hängte der gelernte Sozialpädagoge seinen Beruf als Jugendpfleger an den Nagel, um sich ganz dem Extremsport zu widmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
