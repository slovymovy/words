                "senses": [
                    {
                        "sense_id": "5492d9da-322f-3f57-a29b-b0f98ca8d2c1",
                        "entry_id": "e724fd3a-d491-36e3-b9a4-07d756333aa8",
                        "glosses": [
                            "Konstruktion im Detail"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a4e75fc-fdd0-41af-8f1e-ee193fb28523",
                                "sense_id": "5492d9da-322f-3f57-a29b-b0f98ca8d2c1",
                                "text": "„Der makroskopischen Anatomie, die ohne optische Hilfsmittel arbeitet, steht die Lupe, Licht-Mikroskop und Elektronenmikroskop einsetzende mikroskopische Anatomie gegenüber, die den Feinbau der Organe, Gewebe und Zellen bis zu den Makromolekülen hinunter erforscht und den Anschluß an die Biochemie knüpft.“"
                            },
                            {
                                "example_id": "cac62aec-daba-4ae7-9692-c04c2b2d9a03",
                                "sense_id": "5492d9da-322f-3f57-a29b-b0f98ca8d2c1",
                                "text": "„Der südamerikanische Morphofalter ist berühmt für seine einzigartig schillernde Blaufärbung, die durch den Feinbau der Schuppen hervorgerufen wird.“"
                            },
                            {
                                "example_id": "f7a5c4c0-24c2-4e4e-a73c-3a39dc20048e",
                                "sense_id": "5492d9da-322f-3f57-a29b-b0f98ca8d2c1",
                                "text": "„Erst unter dem Mikroskop ist der Feinbau der Leitgewebe eines Blattes zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
