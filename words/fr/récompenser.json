{
    "word_family": [
        "récompense",
        "récompensable",
        "irrécompensable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7be9a85-882f-3ddf-8c3b-d18eb111190e",
                    "sense_definition": "Donner un prix, un avantage ou une gratification à quelqu'un en reconnaissance d'un mérite, d'un travail ou d'un service rendu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "remuneration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé de <w>récompenser</w> tous les employés pour leurs efforts constants."
                        },
                        {
                            "text": "Ce prix annuel vient <w>récompenser</w> le meilleur film du festival."
                        }
                    ],
                    "synonyms": [
                        "primer",
                        "gratifier",
                        "rémunérer"
                    ],
                    "antonyms": [
                        "punir",
                        "sanctionner"
                    ],
                    "common_phrases": [
                        "récompenser les efforts",
                        "récompenser la fidélité"
                    ]
                },
                {
                    "sense_id": "640a2f0a-2d5a-3a73-82f6-dd40fd9499f7",
                    "sense_definition": "Infliger une punition ou faire subir une conséquence fâcheuse en retour d'un mauvais comportement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a été durement <w>récompensé</w> de sa trahison en perdant tous ses amis."
                        },
                        {
                            "text": "Le destin l'a cruellement <w>récompensé</w> de son imprudence par un échec cuisant."
                        }
                    ],
                    "synonyms": [
                        "punir",
                        "châtier"
                    ]
                },
                {
                    "sense_id": "f1f69b41-f17e-3f4b-b1fd-3b77ec6d433c",
                    "sense_definition": "Dédommager ou indemniser quelqu'un d'une perte subie ou d'un dommage causé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "indemnisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a promis de <w>récompenser</w> le propriétaire pour les dommages causés."
                        },
                        {
                            "text": "Il espère que l'assurance saura le <w>récompenser</w> de ce préjudice financier."
                        }
                    ],
                    "synonyms": [
                        "dédommager",
                        "indemniser",
                        "compenser"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "au sens de dédommager"
                        }
                    ]
                }
            ]
        }
    ]
