                "senses": [
                    {
                        "sense_id": "d1a75477-0f03-3fc1-874b-c8b6c87e50e4",
                        "entry_id": "812b5ade-a54c-3097-a1c0-7c900a66de40",
                        "glosses": [
                            "Fleischscheibe aus dem Rippenstück eines Schweins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9381a1a7-098d-4867-b01d-e948a51692d1",
                                "sense_id": "d1a75477-0f03-3fc1-874b-c8b6c87e50e4",
                                "text": "„Man breitete ein Tuch über einen großen Tisch und stellte eine halbe Stunde später eine ungeheure Menge Polenta darauf, von der zwölf Personen satt werden konnten; dazu brachte man eine große Schüssel voll Schweinekoteletts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10d026bd-a5a7-410e-8c51-da865d49787b",
                        "source_entry_id": "812b5ade-a54c-3097-a1c0-7c900a66de40",
                        "source_sense_id": "d1a75477-0f03-3fc1-874b-c8b6c87e50e4",
                        "source_sense_description": "Gastronomie: Fleischscheibe aus dem Rippenstück eines Schweins",
                        "target_lang_word": "pork chop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pork chop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "649db0bb-a2e9-31a1-b57f-23609b600de5",
                                        "entry_id": "624f8316-b1b8-3a95-a16a-39e7a09925b7",
                                        "glosses": [
                                            "A loin cut taken perpendicular to the spine of the pig, usually a rib or part of a vertebra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e04ba3e-9e40-4b9c-9df4-3055d5f0a0f3",
                                                "sense_id": "649db0bb-a2e9-31a1-b57f-23609b600de5",
                                                "text": "Browned and simmered in orange juice with raisins, tender pork chops are the nucleus of a delicious family dinner."
                                            },
                                            {
                                                "example_id": "0088d8db-d01b-4b48-a469-52ea4ec88c28",
                                                "sense_id": "649db0bb-a2e9-31a1-b57f-23609b600de5",
                                                "text": "With very little fat, boneless pork chops are the fast and flavorful answer whether counting calories, or counting on a tasty meal."
                                            },
                                            {
                                                "example_id": "4a3fb8f8-1610-42a6-a424-3f34d9d3ba44",
                                                "sense_id": "649db0bb-a2e9-31a1-b57f-23609b600de5",
                                                "text": "Pork chops are the go-to dish in the Midwest for an easy, inexpensive, and satisfying meal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
