                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b803fb06-008f-4189-9652-0e43290a3a00",
                                "sense_id": "9c12a614-3464-3d5e-b768-3d819b01da4e",
                                "text": "Abe werd doodgeschoten toen hij vrijdag in de stad Nara kiezers toesprak namens regeringspartij LDP, in de aanloop naar de senaatsverkiezingen van zondag. Yamagami heeft bekend en volgens Kyodo ook toegegeven dat hij meerdere plekken had bezocht waar Abe verkiezingstoespraken hield."
                            },
                            {
                                "example_id": "3dcc4593-38a2-4c14-8fba-bda134038156",
                                "sense_id": "9c12a614-3464-3d5e-b768-3d819b01da4e",
                                "text": "Bij een verkiezingstoespraak in de zuidelijke stad Ashkelon werd hij gisteravond van het podium gehaald na een melding dat er vanuit de Gazastrook een raket was afgevuurd. Dit gebeurde tijdens de vorige campagne ook al, waarna de vermoedelijke dader werd geliquideerd."
                            }
                        ]
