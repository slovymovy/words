                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "abcca471-023c-3fd6-b9ec-27fdc2e49ae3",
                        "entry_id": "90639edb-37e7-3a5e-86eb-9441758108d4",
                        "glosses": [
                            "A person who stands on a rock or eminence to observe shoals of herring, etc., and to give notice to the men in boats which way they pass."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a1972942-5be8-43cc-90bf-00f2880da037",
                                "sense_id": "abcca471-023c-3fd6-b9ec-27fdc2e49ae3",
                                "text": "The Pilcherd are pursued and deuoured by a bigger kinde of fish, called a Plusher, being somewhat like the Dog-fish, who leapeth now and then aboue water, and therethrough bewrayeth them to the Balker […]"
                            },
                            {
                                "example_id": "9faa05b7-39e3-43d3-9150-2657c6ddcfbb",
                                "sense_id": "abcca471-023c-3fd6-b9ec-27fdc2e49ae3",
                                "text": "“Ye are caught, master wizard,” cried Fleetwood, laughing; “the balkers have marked their fish, and we hold you as our prize.[”]"
                            },
                            {
                                "example_id": "7ffc62eb-b8fc-4b43-b10f-84e5a6710721",
                                "sense_id": "abcca471-023c-3fd6-b9ec-27fdc2e49ae3",
                                "text": "For remedy whereof, and for the maintenance of the profitable trade of fishing, it is enacted that fishermen, balcors, huors, condors, guiders, etc., may enter lands near fishing-places to watch for and draw fish on shore, any law, usage, or custom to the contrary notwithstanding."
                            }
                        ]
                    }
