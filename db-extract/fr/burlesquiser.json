                "senses": [
                    {
                        "sense_id": "e731436f-8ef6-3f78-8b0e-7a3237eb048a",
                        "entry_id": "2bcb330c-c138-302a-a5ee-66d0f0587ced",
                        "glosses": [
                            "Donner un caractère burlesque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "288d22d6-8588-473f-98b8-fe967692e46c",
                                "sense_id": "e731436f-8ef6-3f78-8b0e-7a3237eb048a",
                                "text": "Même si le reproche peut lui être fait d'avoir voulu burlesquiser le monde occidental, certains admettent selon les postulats de Schopenhauer que c'est bien le burlesque, la pantalonnade, le comique troupier qui a trouvé le digne représentant d'un monde occidental qui se cherchait, n'ayons pas peur des mots, avant... \"lui\" !"
                            },
                            {
                                "example_id": "1f845699-2a72-46c9-a054-27eb38f14262",
                                "sense_id": "e731436f-8ef6-3f78-8b0e-7a3237eb048a",
                                "text": "Je compte bien être la première à \"burlesquiser\" décemment Chun Li ou Super Mario."
                            },
                            {
                                "example_id": "d0b23132-6c7f-4feb-b492-fd7a44505c5e",
                                "sense_id": "e731436f-8ef6-3f78-8b0e-7a3237eb048a",
                                "text": "Cette façon de burlesquiser sur quelque chose qu'on a déjà vu me plaît beaucoup."
                            }
                        ]
                    }
                ],
