                                        "sense_id": "8e1d96e6-06ed-3526-bce2-1f8a4e454cdf",
                                        "entry_id": "4b16f081-2d00-3570-b071-d1b2f3ceda88",
                                        "glosses": [
                                            "A constructed language created by J. R. R. Tolkien modelled on Greek, Latin and Finnish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ae8558-da43-4ca7-a036-0ce4164f745d",
                                                "sense_id": "8e1d96e6-06ed-3526-bce2-1f8a4e454cdf",
                                                "text": "If the idea of “exotic” and complex languages with features you’ve never imagined thrills you, I guarantee you’ll get more out of studying Navajo, American Sign Language, Kikuyu, Vietnamese, Cree, Cantonese, Quechua, or Nuuchahnnulth than Quenya, Klingon, or attempting to make your own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df1e6030-b9dc-4949-9f3c-791eb99a0199",
                        "source_entry_id": "c0e55be9-0453-346a-83e2-8e990f6ec319",
                        "source_sense_id": "5d4ecda5-76cd-3aad-b9e2-9ded810b0a5e",
                        "target_lang_word": "quenya",
