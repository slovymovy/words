                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "gramático",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "015eb07f-f04e-3e8a-9cd4-9df2dbdc28ad",
                                        "entry_id": "d1fb7f37-fa88-316b-9112-6b61febd3d88",
                                        "glosses": [
                                            "Persona entendida en gramática o que escribe de ella."
                                        ],
                                        "tags": [
                                            "Profesiones"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c823c89-467b-4d08-b712-19ac273fee9f",
                                                "sense_id": "015eb07f-f04e-3e8a-9cd4-9df2dbdc28ad",
                                                "text": "«En este dominio, como no sea por la boca del vulgo ignaro, no hay que registrar fanfarronería alguna dialectal. Los gramáticos y filólogos que han estudiado esa curiosa modalidad lingüística, lo han hecho con singular amor y competencia científica»."
                                            },
                                            {
                                                "example_id": "98effde7-8bff-4ff3-8a2c-2b048ebfaf6b",
                                                "sense_id": "015eb07f-f04e-3e8a-9cd4-9df2dbdc28ad",
                                                "text": "«Pinciano Quintiliano, demás de los precebtos ordinarios y reglas comunes, pide que el buen gramático sea muy leído en los poetas y en historias, y muy curioso en las antigüedades, y docto en latín y griego, y abundoso de buenas y ordenadas palabras, porque no basta hablar congruamente como gramático, sed oportet latine dicere»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "994ce135-aaa1-4aa1-9328-269cdb995c2e",
                        "source_entry_id": "3e75df3b-95c9-3559-abd7-0529bdf5a4a2",
