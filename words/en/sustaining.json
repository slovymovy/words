                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot soup provided a <w>sustaining</w> meal for the hikers after a long day in the cold.",
                            "target_lang_translations": {
                                "nl": "De hete soep vormde een <w>voedzame</w> maaltijd voor de wandelaars na een lange dag in de kou."
                            }
                        },
                        {
                            "text": "Her kind words were a <w>sustaining</w> comfort during the difficult weeks of recovery.",
                            "target_lang_translations": {
                                "nl": "Haar vriendelijke woorden waren een <w>bemoedigende</w> troost tijdens de moeilijke weken van herstel."
                            }
