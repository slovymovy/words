                                        "entry_id": "6ce7bd97-16dc-304d-b3d4-7efbaedd85dd",
                                        "glosses": [
                                            "açúcar monossacarídeo (com fórmula C₆H₁₂O₆), com os seis átomos de carbono dispostos em anel, formado no processo de hidrólise da sacarose da qual é isômera, o mais solúvel em água dos açúcares, comumente encontrado em frutas e no néctar (e, por conseguinte, no mel) e ainda em plantas como os cereais"
                                        ],
                                        "tags": [
                                            "Biologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9079bc-64fb-4de9-ab96-218584118c04",
                                                "sense_id": "c72d6c10-37fb-3789-ad40-b7860b125516",
                                                "text": "A frutose no produto também é metabolizada pelo fígado, o que pode contribuir para a esteatose hepática ou \"fígado gorduroso\"."
                                            }
