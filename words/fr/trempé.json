                {
                    "sense_id": "36036996-d614-315b-b7c4-300f7bfda338",
                    "sense_definition": "Complètement mouillé, saturé d'eau ou d'un autre liquide.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "humidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir marché sous cette grosse averse, son manteau était complètement <w>trempé</w>.",
                            "target_lang_translations": {
                                "en": "After walking in that heavy downpour, his coat was completely <w>soaked</w>.",
                                "ru": "После прогулки под сильным ливнем его пальто было совершенно <w>промокшим</w>.",
                                "de": "Nach dem Marsch durch den heftigen Regenschauer war sein Mantel völlig <w>durchnässt</w>.",
                                "es": "Después de caminar bajo ese fuerte aguacero, su abrigo estaba completamente <w>empapado</w>.",
                                "zh": "在那场大雨中走过之后，他的大衣已经完全<w>湿透</w>了。"
                            }
                        },
                        {
                            "text": "Change immédiatement tes vêtements <w>trempés</w> pour éviter d'attraper froid.",
                            "target_lang_translations": {
                                "en": "Change your <w>soaked</w> clothes right away to avoid catching a cold.",
                                "ru": "Сразу же переодень свою <w>промокшую</w> одежду, чтобы не простудиться.",
                                "de": "Wechsle sofort deine <w>durchnässte</w> Kleidung, um dich nicht zu erkälten.",
                                "es": "Cámbiate enseguida la ropa <w>empapada</w> para no resfriarte.",
                                "zh": "立刻换掉你<w>湿透</w>的衣服，以免着凉。"
                            }
                        }
