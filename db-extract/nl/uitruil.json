                                    {
                                        "sense_id": "08e05a44-0151-37ce-b715-a3d010135432",
                                        "entry_id": "1e9bbcd4-d3ee-3ce9-852d-8b957992da4b",
                                        "glosses": [
                                            "A conversation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
