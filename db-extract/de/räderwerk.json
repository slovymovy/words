                "senses": [
                    {
                        "sense_id": "9970f8b8-20b6-3156-8e04-576d1b4e5e7f",
                        "entry_id": "99c518ee-615d-33e9-aa21-62670f08ae5c",
                        "glosses": [
                            "Gesamtheit von ineinandergreifenden Rädern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8815104f-15d3-4445-8317-0f54a9b9bfe1",
                                "sense_id": "9970f8b8-20b6-3156-8e04-576d1b4e5e7f",
                                "text": "„Ihr übersteigertes Bewußtsein, ihre Hybris holte das mechanische Räderwerk der Unterwelt schon auf die Ebene ihres Lebens herauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1237fb3-fa8d-465b-9b3f-f475344ff221",
                        "source_entry_id": "99c518ee-615d-33e9-aa21-62670f08ae5c",
                        "source_sense_id": "9970f8b8-20b6-3156-8e04-576d1b4e5e7f",
                        "source_sense_description": "Gesamtheit von ineinandergreifenden Rädern",
                        "target_lang_word": "engrenage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engrenage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12058d3f-d097-3797-b3d1-58a657cb0cf4",
                                        "entry_id": "9021f948-cfb8-3bec-bff8-9720b76cbb97",
                                        "glosses": [
                                            "Disposition de plusieurs roues qui s’engrènent les unes dans les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc90586e-334f-4833-8667-476759e692e1",
                                                "sense_id": "12058d3f-d097-3797-b3d1-58a657cb0cf4",
                                                "text": "Deux grands défauts qu'on doit éviter dans un engrenage, c'est qu'il soit trop fort ou trop faible. Dans le premier cas, les dents de la roue sont sujettes à quoter, c'est-à-dire, que les deux pointes de deux dents voisines vont toucher les deux faces opposées des deux ailes du pignon ; de sorte que ni la roue, ni le pignon ne peuvent se mouvoir."
                                            },
                                            {
                                                "example_id": "76c0186b-085a-4a0f-a9fe-486dec053bce",
                                                "sense_id": "12058d3f-d097-3797-b3d1-58a657cb0cf4",
                                                "text": "Le mouvement de rotation imprimé par le vent à l'arbre est transmis aux meules par l’intermédiaire d’engrenages, qui sont ordinairement en bois."
                                            },
                                            {
                                                "example_id": "fec6f694-5ed2-4aba-8a3e-fffebc5eb297",
                                                "sense_id": "12058d3f-d097-3797-b3d1-58a657cb0cf4",
                                                "text": "La disposition à engrenages planétaires comporte un pignon central monté directement sur l'arbre du moteur, un équipage de satellites et une couronne fixe dans laquelle les satellites engrènent en tournant sur eux-mêmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd25247b-64e8-3f1a-9866-bb8b7bc4ccc4",
                                        "entry_id": "9021f948-cfb8-3bec-bff8-9720b76cbb97",
                                        "glosses": [
                                            "Enchaînement de circonstances dont on ne peut se dégager."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02f23c30-4133-4c86-b5c2-5491de7bf927",
                                                "sense_id": "fd25247b-64e8-3f1a-9866-bb8b7bc4ccc4",
                                                "text": "Vatelin. — Ah ! pauvre Vatelin, tu t’es fourré là dans un engrenage !"
                                            },
                                            {
                                                "example_id": "59527482-ef8f-4431-ae67-1399e34a8ffb",
                                                "sense_id": "fd25247b-64e8-3f1a-9866-bb8b7bc4ccc4",
                                                "text": "Et tous déjà avaient oublié Laveuve, le misérable qui agonisait, et tous couraient à leurs soucis, à leurs passions, ressaisis par l’engrenage, retombés sous la meule, dans cette ruée de Paris dont la fièvre les charriait, les heurtait en une ardente bousculade, à qui arriverait le premier, en passant sur le corps des autres."
                                            },
                                            {
                                                "example_id": "8976c8ea-29b4-48b0-ad01-f335179eec9a",
                                                "sense_id": "fd25247b-64e8-3f1a-9866-bb8b7bc4ccc4",
                                                "text": "Et si vous lui disiez qu'une fois le doigt dans l'engrenage, la main, le bras y passent et que le corps tout entier est happé, broyé, croyez-vous qu'il vous rembarrerait ?"
                                            },
                                            {
                                                "example_id": "1e7e63d5-59d1-48b6-ae83-d359eb48e7ad",
                                                "sense_id": "fd25247b-64e8-3f1a-9866-bb8b7bc4ccc4",
                                                "text": "Pour la première fois, Mattia eut honte d'avoir vingt-deux ans et de ne pas être en possession du permis de conduire. C'était une des choses qu'il avait négligées, un pas évident dans la vie d'un garçon qu'il avait décidé de ne pas accomplir pour échapper le plus possible à l'engrenage de la vie."
                                            },
                                            {
                                                "example_id": "fbf47643-ee10-46fa-b87c-2d7cb396772e",
                                                "sense_id": "fd25247b-64e8-3f1a-9866-bb8b7bc4ccc4",
                                                "text": "Chaque baisse supplémentaire du cours alourdissait la facture de l’acquisition d'Orange, dans une sorte d’engrenage vicieux et compliquait le désendettement de France Télécom."
                                            },
                                            {
                                                "example_id": "0aeeb545-dfd8-46b0-8794-52ed2bdb774f",
                                                "sense_id": "fd25247b-64e8-3f1a-9866-bb8b7bc4ccc4",
                                                "text": "Pour ma part, je suis donc convaincue que la connaissance de l'histoire de la Shoah, des engrenages, et des contextes historiques et politiques qui y ont conduit, doivent rester au cœur des enseignements dans nos écoles et nos universités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bc46af3-610b-3916-8216-04d8c2237892",
                                        "entry_id": "9021f948-cfb8-3bec-bff8-9720b76cbb97",
                                        "glosses": [
                                            "Rouge d’engrenage."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99b4b24c-f658-49f3-96bd-a63b25bf3550",
                                                "sense_id": "2bc46af3-610b-3916-8216-04d8c2237892",
                                                "text": "D’azur à deux bars adossés d’or accompagnés en chef d’un besant d’or, à dextre et à senestre, de deux cailloux du même et en pointe d’une gerbe de blé aussi d’or; un engrenage de sable brochant sur le tout, qui est de la commune de Saint-Ail de Meurthe-et-Moselle"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efd9a15f-b41a-44ef-a71f-7398387b0985",
                        "source_entry_id": "99c518ee-615d-33e9-aa21-62670f08ae5c",
                        "source_sense_id": "9970f8b8-20b6-3156-8e04-576d1b4e5e7f",
                        "source_sense_description": "Gesamtheit von ineinandergreifenden Rädern",
                        "target_lang_word": "rouage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5367bb-c265-31f8-8665-8e18ba51de44",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Élément de roue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9716587-6e59-4c51-81cc-5569f980da37",
                                                "sense_id": "4d5367bb-c265-31f8-8665-8e18ba51de44",
                                                "text": "Bois de rouage, celui qu’on emploie à faire des roues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ddc1778-df6a-379d-9a61-8503ac84884c",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Chacune des pièces qui concourent au fonctionnement d’une machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "819097c1-5739-4528-83c1-92afb7da03ca",
                                                "sense_id": "2ddc1778-df6a-379d-9a61-8503ac84884c",
                                                "text": "Un rouage du moteur s’est brisé. Les rouages d’une montre, d’une locomotive."
                                            },
                                            {
                                                "example_id": "e915ea0d-2cf1-4f44-9edf-16d9af8d0721",
                                                "sense_id": "2ddc1778-df6a-379d-9a61-8503ac84884c",
                                                "text": "Jetant l’ouvrier dans la bourdonnante oisiveté de la caserne, il détourne l’être jeune et robuste du métier qu’il connaît, des activités que lui confère un long apprentissage, ne lui demandant autre chose, en retour, que d’obéir sans raison, d’obéir sans honneur, d’obéir comme une brute, comme un rouage silencieux dans un appareil de mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1558f5dd-db46-3f08-8f45-10b07afb00ea",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Mécanisme à fonctionnement régulier et prévisible."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6167c61d-5826-4fa4-a109-7a8aef918661",
                                                "sense_id": "1558f5dd-db46-3f08-8f45-10b07afb00ea",
                                                "text": "Le boîtier ouvert lui avait livré l’état désespérant d'un mécanisme hors d'usage : rouages encrassés, ressort cassé, cette montre était morte, non de maladie mais de vieillesse."
                                            },
                                            {
                                                "example_id": "18a738ad-ed40-4506-a03b-10553d2b9e67",
                                                "sense_id": "1558f5dd-db46-3f08-8f45-10b07afb00ea",
                                                "text": "tourner comme les rouages d’une montre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Chaque élément participant au fonctionnement d’un ensemble."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0378ae8-03ad-456d-b015-90d0d47c3757",
                                                "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                                "text": "Le vieillard devait avoir soixante-dix ans, […]. On devinait dans ce corps rachitique une effrayante usure de tous les rouages organiques."
                                            },
                                            {
                                                "example_id": "d5603fc3-1d51-470c-9fc3-4aeedbab4810",
                                                "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                                "text": "Ceux qui ne souffrent pas très cruellement ont une sensation de malaise. Ils comprennent qu'il se passe quelque chose d'anormal, que les rouages sociaux sont faussés."
                                            },
                                            {
                                                "example_id": "e9faea30-8595-4813-9632-e686e1ead56f",
                                                "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                                "text": "Car la culture devient vite un enfer pour qui n’est pas de la partie, ne maîtrise pas les rouages, croit – à tort – que c’est plus aisé de la bouger que de réformer la SNCF, ne sait pas tenir tête aux artistes."
                                            },
                                            {
                                                "example_id": "a4390bee-fc2c-4189-b88e-34e2be6df9f8",
                                                "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                                "text": "Les médias demeurent un rouage du théâtre de la politique, mais on sent bien qu’ils façonnent de moins en moins les opinions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c7ec00a-db74-38bf-be6d-a116830f68f1",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Paiement de la location des places occupées dans les foires ou les marchés par les marchands étrangers."
                                        ],
                                        "tags": [
                                            "Au Moyen Âge"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "123a7144-a224-369b-b21b-76a24e9f0194",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Péage pour circuler sur les routes."
                                        ],
                                        "tags": [
                                            "Droit d’Ancien Régime"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
