                                                "example_id": "a882672b-cbf9-4a5c-bc2b-fa7223df2109",
                                                "sense_id": "87f372b8-a166-31e0-b472-475da44b14fa",
                                                "text": "Huilen was vroeger een teken van vrouwelijkheid."
