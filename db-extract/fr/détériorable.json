                        "sense_id": "86fec96c-09f3-32f8-87d4-8d44d79524dc",
                        "entry_id": "ccf3094e-55e8-3d3c-a068-5b944015dd11",
                        "glosses": [
                            "Qui peut être détérioré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95096e4-1b44-4022-896e-a43f9f2057eb",
                                "sense_id": "86fec96c-09f3-32f8-87d4-8d44d79524dc",
                                "text": "La Direction générale avait pris une série de mesures quant à la vitesse de l’exportation des marchandises facilement détériorables, ce qui a augmenté en 1930 le nombre de tonnes exportées de ces marchandises."
                            },
                            {
                                "example_id": "32d8208b-ee54-472e-a8c4-4dd19973505a",
                                "sense_id": "86fec96c-09f3-32f8-87d4-8d44d79524dc",
                                "text": "En posant pour Paul Nadar, elle sculpte son art sur un support fragile. Non pas dans un matériau durable, mais sur du verre ; parce que cassable, détériorable, incertain, il conserve l’éphémère passager du théâtre dans sa matière même."
                            },
                            {
                                "example_id": "01475b70-7fff-416f-b054-f5e9de4f0fcb",
                                "sense_id": "86fec96c-09f3-32f8-87d4-8d44d79524dc",
                                "text": "Le 19 décembre, la Cour de justice de l’Union européenne a jugé que les e-book, de par leur nature immatérielle et donc non détériorable, ne pouvaient être vendus d’occasion."
                            }
                        ]
                    }
