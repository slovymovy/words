                    {
                        "translation_id": "11c3c53d-cc41-4ec8-9f75-76a6e6a79446",
                        "source_entry_id": "2490ffa7-99f7-3302-acb2-cc2afb9fdc28",
                        "source_sense_id": "b7c0fee5-0da5-3f84-ab4b-32baf67901cf",
