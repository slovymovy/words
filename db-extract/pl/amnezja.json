                "senses": [
                    {
                        "sense_id": "9a369f11-9a80-3be4-ab00-d9c314418a79",
                        "entry_id": "591ca1fa-5175-32d1-a4fb-9bae740aeacd",
                        "glosses": [
                            "zanik pamięci"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e22f4183-d9d5-4ec4-91c5-8181e6a9d623",
                                "sense_id": "9a369f11-9a80-3be4-ab00-d9c314418a79",
                                "text": "Całkowitą lub przejściową amnezję może spowodować mocne uderzenie w głowę. Amnezja (ostra, nieodwracalna) występuje również w chorobie Alzheimera"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9685def-bd09-4c33-bbcf-dddfda93e0d7",
                        "source_entry_id": "591ca1fa-5175-32d1-a4fb-9bae740aeacd",
                        "source_sense_id": "9a369f11-9a80-3be4-ab00-d9c314418a79",
                        "target_lang_word": "amnesia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amnesia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9229b18b-2757-3047-815e-f47f181cfecb",
                                        "entry_id": "56cbfd46-87fa-38d5-a6d4-a4c961f95ae8",
                                        "glosses": [
                                            "Loss of memory; forgetfulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44eb691d-ae5a-4c72-99eb-c9c95faec6b2",
                                                "sense_id": "9229b18b-2757-3047-815e-f47f181cfecb",
                                                "text": "I lay around my Barnard dorm room listening to Nina Simone records and reading his first novel, “Forgetting Elena,” which takes place in a highly mythopoeticized version of Fire Island and nominally concerns a man with amnesia."
                                            },
                                            {
                                                "example_id": "0c1a1ef3-0427-4ecd-8537-9ae2fbb9c138",
                                                "sense_id": "9229b18b-2757-3047-815e-f47f181cfecb",
                                                "text": "They must have amnesia, they forgot that I'm him"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00a6dbc-aa5d-39f8-a239-0f0fed771109",
                                        "entry_id": "56cbfd46-87fa-38d5-a6d4-a4c961f95ae8",
                                        "glosses": [
                                            "Forgetfulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2dce31e-91af-4ed8-bdb7-a59417c09f62",
                                                "sense_id": "e00a6dbc-aa5d-39f8-a239-0f0fed771109",
                                                "text": "a state of cultural amnesia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57e34c61-437b-3318-bfee-68d77657ba7e",
                                        "entry_id": "56cbfd46-87fa-38d5-a6d4-a4c961f95ae8",
                                        "glosses": [
                                            "A potent sativa-dominant strain of marijuana."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a51bcfcb-3ceb-457b-a1ff-a53621c798d6",
                                                "sense_id": "57e34c61-437b-3318-bfee-68d77657ba7e",
                                                "text": "She's lighting up some sensis, he's lighting up amnesias / I'm 'bout to get it started, I'm 'bout to get amnesia'd"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff460f30-97e5-480b-87e5-597ca0b0afe2",
                        "source_entry_id": "591ca1fa-5175-32d1-a4fb-9bae740aeacd",
                        "source_sense_id": "9a369f11-9a80-3be4-ab00-d9c314418a79",
                        "target_lang_word": "amnésie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amnésie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92620853-ecb6-3f04-8c50-73b457a38d05",
                                        "entry_id": "cf6478c0-c48e-30f7-a61b-1d41b14aa5d5",
                                        "glosses": [
                                            "Affaiblissement ou perte de la mémoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52983d34-1de5-44e2-b7a2-e8959b17cbd4",
                                                "sense_id": "92620853-ecb6-3f04-8c50-73b457a38d05",
                                                "text": "– Ah ! que j’ai de belles… Ah ! que j’ai de belles… répète Mᵐᵉ S., qui ne peut pas trouver ce qu’elle veut nommer.\n– Ah ! que tu as de belles… Ah ! que tu as de belles « ce que tu ne dis pas », ma chère Alice, reprend Mᵐᵉ D., sans sourire.\nEt l’effet d’une amnésie constatée si froidement est sinistre.\nMᵐᵉ S. hésite à ne pas devenir folle et tout d’un coup le devient."
                                            },
                                            {
                                                "example_id": "70f64cf7-fecb-4977-8a62-17ea69e96625",
                                                "sense_id": "92620853-ecb6-3f04-8c50-73b457a38d05",
                                                "text": "Lʼamnésie fonctionnelle est souvent décrite comme perte de lʼidentité personnelle."
                                            },
                                            {
                                                "example_id": "1510f8c9-4134-498c-9cba-aaa20cc4355f",
                                                "sense_id": "92620853-ecb6-3f04-8c50-73b457a38d05",
                                                "text": "Le sage savait très bien de quoi parlait la princesse, mais il feint l’amnésie : « Quelle vache ma fille ? »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7853b52c-cde7-41b0-b7da-4b7392f50e40",
                        "source_entry_id": "591ca1fa-5175-32d1-a4fb-9bae740aeacd",
                        "source_sense_id": "9a369f11-9a80-3be4-ab00-d9c314418a79",
                        "target_lang_word": "amnesia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amnesia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c815dfc7-dc74-326f-afe4-2b4a5633ec23",
                                        "entry_id": "adafe68f-a52a-37c6-b873-10224a3ba3aa",
                                        "glosses": [
                                            "Pérdida o disminución considerables de la memoria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b02502ee-29a9-4e9f-9a7a-328861070c9b",
                                                "sense_id": "c815dfc7-dc74-326f-afe4-2b4a5633ec23",
                                                "text": "La pérdida de la memoria (amnesia) es el olvido inusual. Usted posiblemente no es capaz de recordar hechos nuevos o traer a su memoria uno o más recuerdos del pasado, o ambos. La pérdida de memoria puede presentarse por un corto tiempo y luego resolverse (transitorio) o puede no desaparecer y, dependiendo de la causa, puede empeorar con el tiempo"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43042dea-4de4-4c03-9d0e-ae2c46e8981e",
                        "source_entry_id": "591ca1fa-5175-32d1-a4fb-9bae740aeacd",
                        "source_sense_id": "9a369f11-9a80-3be4-ab00-d9c314418a79",
