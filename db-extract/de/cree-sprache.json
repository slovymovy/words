                "senses": [
                    {
                        "sense_id": "73ca7216-16bc-395c-88f6-41cd4c25cf52",
                        "entry_id": "50496ecb-a1f4-3263-a4ba-df991d7d8102",
                        "glosses": [
                            "Sprache des Indianerstamms der Cree, die zwischen den Rocky Mountains und dem Atlantik gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cdff6db-e725-4d7f-88c5-cedd88544054",
                                "sense_id": "73ca7216-16bc-395c-88f6-41cd4c25cf52",
                                "text": "„Takkakaw ist ein indianisches Wort der Cree-Sprache und bedeutet ‚es ist großartig‘.“"
                            },
                            {
                                "example_id": "32b12fa4-f6d5-4c88-931f-c98d84ec7fb7",
                                "sense_id": "73ca7216-16bc-395c-88f6-41cd4c25cf52",
                                "text": "„Bei den Indianern heißen sie: hlighag, misâskwatômina (in der Cree-Sprache), sgan gam.“"
                            },
                            {
                                "example_id": "da5330e5-b5f1-4dbe-a2cd-8504b984c087",
                                "sense_id": "73ca7216-16bc-395c-88f6-41cd4c25cf52",
                                "text": "„Howes, der Verfasser einer Grammatik der Cree-Sprache, hat versprochen, die Methode bei der Bildung von aggregirten Wörtern in den amerikanischen Idiomen weiter zu beleuchten.“"
                            },
                            {
                                "example_id": "349ba1d7-b95e-4d2e-aec2-1e3f2cc1843e",
                                "sense_id": "73ca7216-16bc-395c-88f6-41cd4c25cf52",
                                "text": "„Das Steckenbleiben der Pferde im Schlamm, das Abfallen der Packete, das Anrufen der Thiere in der Cree-Sprache und das Fluchen auf dieselben im Französischen, denn in den indianischen Sprachen gibt es keine Flüche, Alles vereinigte sich, um den Tag zu dem geschäftigsten, langweiligsten, geräuschvollsten und unangenehmsten meines Lebens zu machen.“"
                            },
                            {
                                "example_id": "9d9ac28c-b302-46d4-bb5d-a31b9e347ee9",
                                "sense_id": "73ca7216-16bc-395c-88f6-41cd4c25cf52",
                                "text": "„Doch nimmt die Cree-Sprache in manchen Beziehungen die Stelle der Verkehrssprache ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
