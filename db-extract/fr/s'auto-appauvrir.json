                        "glosses": [
                            "S’appauvrir soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b5bf8f0-573d-4ebe-be38-83d7b9eb8812",
                                "sense_id": "c540ba8a-5225-37e1-8f07-123d560c9391",
                                "text": "Les pauvres ne sont pas oubliés : ils ont droit à du crédit (cher) et des jeux d'argent (pour s’auto-appauvrir davantage)."
                            },
                            {
                                "example_id": "ea3decd6-9057-4e1f-b1be-3bcb7cf476fd",
                                "sense_id": "c540ba8a-5225-37e1-8f07-123d560c9391",
                                "text": "Autrement dit, quand on veut bénéficier de l'initiative PPTE, il faut soi-même s'auto-appauvrir."
                            }
                        ]
                    }
