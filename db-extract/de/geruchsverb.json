                ],
                "senses": [
                    {
                        "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                        "entry_id": "b749b469-8b29-348c-b1e6-692cb4f50de4",
                        "glosses": [
                            "Emissionsverb, mit dem eine Handlung (beispielsweise verbreiten), ein Zustand (stechend) oder ein Geschehen (ausdünsten) ausgedrückt wird, welches den Geruch betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d84407b-e8c2-4e2c-bccb-a316684a9ceb",
                                "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                                "text": "„Wenn wir also den Wortschatz des Geruchs strukturell untersuchen wollen, so müssen wir getrennt Wortfelder der Geruchssubstantive, Geruchsverben und Geruchsadjektive analysieren.“"
                            },
                            {
                                "example_id": "06f1220e-ea33-48be-8f7d-7ed5dfe36597",
                                "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                                "text": "„Möglicherweise haben ja die p. t. Leser noch andere solche Geruchsverben auf –eln im Gedächtnis oder können uns gar kreative Neubildungen vorschlagen, die wir schon immer gerne gehabt hätten, aber an die wir nicht zu denken wagten.“"
                            },
                            {
                                "example_id": "c298941e-e0ae-43be-8c94-b4ac97fd39d6",
                                "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                                "text": "„Die Beispiele (7) stellen Sinnesverben dar, wie die Geräuschverben: es klingelt, läutet, kracht, klopft, knarrt, knackt, raschelt, rauscht, scheppert oder auch die Geruchsverben: es duftet, riecht, stinkt.“"
                            },
                            {
                                "example_id": "8c04aba0-069a-4d33-a665-f777c1cd0151",
                                "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                                "text": "„Semantische Objekttypen der Geruchsverben“"
                            },
                            {
                                "example_id": "6b0a4a18-e125-41a0-be56-074bd45ebfdf",
                                "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                                "text": "„Kreative lexikalische Erweiterungen in Form von Bewegungsvarianten von selten als Bewegungsverben verwendeten Geräusch- und Geruchsverben (z.B. knistern, stinken) verbinden sich bevorzugt mit den direktionalen Ausdrücken der hochfrequenten Geräusch-als-Bewegungsverben.“"
                            },
                            {
                                "example_id": "2a2e172b-c955-4231-b795-259fa73356da",
                                "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                                "text": "Diese Verknüpfung wird im Wesentlichen durch das stereotype Geruchsverb riechen und die vergleichende Konjunktion wie geleistet."
                            },
                            {
                                "example_id": "fba2d661-cf67-4ce7-94ed-74aa92a62421",
                                "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                                "text": "Bei den deutschen Geruchsverben haben wir auch das von Keller an den Beispielen Frau und Dame beschriebene Pejorisierungs-Phänomen."
                            },
                            {
                                "example_id": "36988db1-ac8b-4449-8fa0-0f42c8704543",
                                "sense_id": "d06e9216-0f65-3b33-a0c0-20014d5493b1",
                                "text": "„Riechen“ als Wahrnehmungverb bedeutet einen Geruch aufnehmen, „riechen“ als Geruchsverb, dass etwas einen bestimmten Duft verbreitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
