                    },
                    {
                        "translation_id": "6d22ad19-637a-48ec-8b4d-45074b969100",
                        "source_entry_id": "f1a26a08-af3b-305d-92a5-105d6e0f8024",
                        "source_sense_id": "d84b9be1-3b90-324d-bd5e-4f43263528fc",
                        "target_lang_word": "extradition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extradition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42e38016-baf1-3e9b-8ef0-dd158c361db6",
                                        "entry_id": "dac79106-11cd-39b2-86cc-2d2e89b7c4e8",
                                        "glosses": [
                                            "Action d’extrader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bae141e-f9e1-4bc8-be7a-d4a2a9d617dc",
                                                "sense_id": "42e38016-baf1-3e9b-8ef0-dd158c361db6",
                                                "text": "Il s’était réfugié en pays étranger ; le gouvernement demanda son extradition."
                                            },
                                            {
                                                "example_id": "1c9811c4-0601-453d-8836-089bebb627c7",
                                                "sense_id": "42e38016-baf1-3e9b-8ef0-dd158c361db6",
                                                "text": "Cette administration a passé en 1998 un accord d’extradition avec les États-Unis, qui comporte une exception pour les délits politiques."
                                            },
                                            {
                                                "example_id": "0b80f7af-ac26-4f0d-812a-0e7bce0dfe16",
                                                "sense_id": "42e38016-baf1-3e9b-8ef0-dd158c361db6",
                                                "text": "Invoquant un risque de suicide, la justice britannique a rejeté lundi la demande d'extradition du fondateur de Wikileaks Julian Assange vers les États-Unis, qui le réclament pour la publication de centaines de milliers de documents confidentiels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f426492b-3224-37fc-967b-7cc7802bb822",
                                        "entry_id": "dac79106-11cd-39b2-86cc-2d2e89b7c4e8",
                                        "glosses": [
                                            "Remise de pièces conservées au greffe d’un tribunal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
