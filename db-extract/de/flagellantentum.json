                            {
                                "example_id": "5a1c9ee3-4355-4fa1-97e2-2297e70959bb",
                                "sense_id": "e095e38e-1386-3422-88dc-3837c3b4517f",
                                "text": "Bei gewissen schiitischen Festlichkeiten ist das Flagellantentum immer noch weit verbreitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e3861654-20cf-3dfd-b9e3-8ea1e46942ac",
                        "entry_id": "ba624659-6a0c-3e15-ab5a-acebd876be2e",
                        "glosses": [
                            "religiöse Praktik, durch Selbstgeißelung Buße zu tun",
                            "insbesondere Bezeichnung für mittelalterliche christlich-religiöse Bewegungen, die durch Selbstgeißelung Sündenvergebung zu erlangen erhofften, insbesondere in allgemeinen Krisen, zum Beispiel während der Pest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fda9d4eb-bce2-4d0b-a2a6-0e6711cd8c52",
                                "sense_id": "e3861654-20cf-3dfd-b9e3-8ea1e46942ac",
                                "text": "Nach Ausbruch der Pest verbreitete sich das Flagellantentum in ganz Europa."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "8d743815-a8fa-39a0-9c42-13c2381e9d04",
                        "entry_id": "ba624659-6a0c-3e15-ab5a-acebd876be2e",
                        "glosses": [
                            "abschätziger Ausdruck dafür, dass sich jemand aus Schuldgefühl oder anderen moralischen Gefühlen bewusst selbstschädigend verhält, ohne dass dies jemand anderem nütze"
                        ],
                        "tags": [
                            "im moderneren Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "360d47ce-2df2-4f66-be82-00acc6b99eba",
                                "sense_id": "8d743815-a8fa-39a0-9c42-13c2381e9d04",
                                "text": "\"Auf den Abschluss dieses allseits vorteilhaften Abkommens nur wegen einer vermeintlichen historischen Schuld zu verzichten, grenzt an politisches Flagellantentum.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
