                "senses": [
                    {
                        "sense_id": "97424c3f-dbc6-3052-9cd3-e82e9977c75d",
                        "entry_id": "1e8425a2-1af8-3fb9-b4f5-460cb0a07ea4",
                        "glosses": [
                            "stowarzyszenie, organizacja religijna skupiająca głównie laikat"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3a6d3ffb-ba37-3d0c-8803-b3d47221a7db",
                        "entry_id": "1e8425a2-1af8-3fb9-b4f5-460cb0a07ea4",
                        "glosses": [
                            "stowarzyszenie (dawniej skupiające mieszczan), oparte na wspólnocie zawodu lub wykonywanej profesji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6a811c3-282f-45f9-b2fe-fce4d7cc5987",
                        "source_entry_id": "1e8425a2-1af8-3fb9-b4f5-460cb0a07ea4",
                        "source_sense_id": "97424c3f-dbc6-3052-9cd3-e82e9977c75d",
                        "target_lang_word": "confraternity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confraternity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5346ad66-2e4c-3334-a226-cfc0898c5843",
                                        "entry_id": "73385258-3ee4-3caf-9cdf-dd9e0daf0e56",
                                        "glosses": [
                                            "A group with a common interest."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ddce0bc-a137-4b09-9ef9-ad096f533e2b",
                                                "sense_id": "5346ad66-2e4c-3334-a226-cfc0898c5843",
                                                "text": "First the cell, then combinations of cells, then combinations of combinations, then more and more complex combinations, till the body of man is reached, where endless confraternities of cells, all with different functions, working to build and sustain different organs, […]"
                                            },
                                            {
                                                "example_id": "b3aabfe4-d5ab-44a9-8b5e-e24b1f3e2d3c",
                                                "sense_id": "5346ad66-2e4c-3334-a226-cfc0898c5843",
                                                "text": "The two gravitated together in response to that law of nature which rules that the whole confraternity of politicians prefer to operate within the closed circle of its own initiates, rather than waste time with outsiders […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9362cb6a-98c3-386f-b412-7c29dee70ce4",
                                        "entry_id": "73385258-3ee4-3caf-9cdf-dd9e0daf0e56",
                                        "glosses": [
                                            "A religious fraternity or brotherhood."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6882d1a2-cacd-47d0-94be-fe3969f26776",
                                                "sense_id": "9362cb6a-98c3-386f-b412-7c29dee70ce4",
                                                "text": "[…] in the later Middle Ages, in an urban complex, Carthusians and Benedictines would have existed alongside friars and beguines (and their southern counterparts) and possibly a Jewish community, […] many others committed to a confraternity or to special ascetic exercises […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b3c3f64-78ed-31b8-92a2-28b52d68eb4c",
                                        "entry_id": "73385258-3ee4-3caf-9cdf-dd9e0daf0e56",
                                        "glosses": [
                                            "Brotherly friendship."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc4d8e01-a03a-4e0b-a0f9-7491bd8ce4c4",
                                                "sense_id": "1b3c3f64-78ed-31b8-92a2-28b52d68eb4c",
                                                "text": "[Napoleon's] coronation as Emperor had been followed immediately by the great battle of Austerlitz, which had prostrated Austria at his feet, and reduced the Czar of Russia to so humiliating a condition as ended in the total disruption of his confraternity with the Germanic powers."
                                            },
                                            {
                                                "example_id": "a6b303fe-931d-4ec5-9b2c-de4e335e550a",
                                                "sense_id": "1b3c3f64-78ed-31b8-92a2-28b52d68eb4c",
                                                "text": "The great lights of commercial jurisprudence, international confraternity, and biological deviation, of all ages, all civilizations, and all nationalities, from Zoroaster down to Horace Greeley […]"
                                            },
                                            {
                                                "example_id": "05a257c1-ddfb-40cf-ae7e-c9e463d8dd22",
                                                "sense_id": "1b3c3f64-78ed-31b8-92a2-28b52d68eb4c",
                                                "text": "I had seen and done things in the past few days that my entire life had not prepared me for, and I had felt emotions unknown to me: righteous anger, political confraternity and solidarity, deep fear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61fe557a-e753-4548-99cb-515a25fb2359",
                        "source_entry_id": "1e8425a2-1af8-3fb9-b4f5-460cb0a07ea4",
                        "source_sense_id": "97424c3f-dbc6-3052-9cd3-e82e9977c75d",
                        "target_lang_word": "confrérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confrérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb900e33-54ba-30bb-852d-6c59b449660b",
                                        "entry_id": "a36ab58f-20f8-3cf4-b1ad-4c56c9057500",
                                        "glosses": [
                                            "Compagnie de personnes associées pour quelque objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc37ac49-fa37-41f9-839f-d6961433a499",
                                                "sense_id": "bb900e33-54ba-30bb-852d-6c59b449660b",
                                                "text": "La confrérie des archers de Saint-Sébastien avait fait afficher, en manière de prix, cinq plats et trois cafetières d'étain, plus six cuillers à café en argent pour le dernier oiselet abattu."
                                            },
                                            {
                                                "example_id": "64ee0a0d-fddd-42fa-954c-489626411edf",
                                                "sense_id": "bb900e33-54ba-30bb-852d-6c59b449660b",
                                                "text": "On voit par le statut ici reproduit que les maréchaux, les férons, les serruriers et les taillandiers formaient, à Abbeville, une seule corporation industrielle et une même confrérie religieuse sous l’invocation de saint Eloy; […]."
                                            },
                                            {
                                                "example_id": "c2075905-7cba-440b-b670-7d6eb640f8f2",
                                                "sense_id": "bb900e33-54ba-30bb-852d-6c59b449660b",
                                                "text": "Vous connaissez cette intéressante confrérie des cornichons. Elle a un uniforme. Ceux du sexe masculin portent de longues redingotes […]."
                                            },
                                            {
                                                "example_id": "52b6887d-39dd-4ec5-a7d8-b3c2e25ab888",
                                                "sense_id": "bb900e33-54ba-30bb-852d-6c59b449660b",
                                                "text": "Bannis de Lyon en 1420, les juifs s’établirent à Trévoux (Ain) et y formèrent de puissantes confréries, s’occupant principalement de l’étirage de l’or et de l’argent."
                                            },
                                            {
                                                "example_id": "07cdba6d-0762-4605-939a-5f00ed381883",
                                                "sense_id": "bb900e33-54ba-30bb-852d-6c59b449660b",
                                                "text": "Appartenant à la grande confrérie des conteurs et chanteurs errants, ce troubadour marocain ne possède pour toute fortune qu'un âne famélique, un vieux haïk en lambeaux, une pipe et une blague à kif et un petit instrument primitif à deux cordes, un gimbri, attribut de son état."
                                            },
                                            {
                                                "example_id": "76284a5d-7237-4d50-bc84-fecf6a27b18d",
                                                "sense_id": "bb900e33-54ba-30bb-852d-6c59b449660b",
                                                "text": "À partir de 1950, les confréries connaissent un regain d’intérêt dû au développement du tourisme, à la volonté de mettre les terroirs français en valeur et de défendre une tradition française sur le plan culinaire et agricole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
