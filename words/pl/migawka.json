            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6909d872-52ca-3399-a40f-1fc28ee063f5",
                    "sense_definition": "część aparatu fotograficznego odsłaniająca materiał światłoczuły lub matrycę na określony czas",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fotografia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nacisnął spust, a <w>migawka</w> aparatu otworzyła się na ułamek sekundy.",
                            "target_lang_translations": {
                                "ru": "Он нажал на спуск, и <w>затвор</w> фотоаппарата открылся на долю секунды."
                            }
                        },
                        {
                            "text": "W starym aparacie fotograficznym zepsuła się mechaniczna <w>migawka</w>.",
                            "target_lang_translations": {
                                "ru": "В старом фотоаппарате сломался механический <w>затвор</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "przesłona migawkowa"
                    ],
                    "common_phrases": [
                        "szybkość migawki",
                        "czas otwarcia migawki",
                        "spust migawki"
                    ],
                    "target_lang_definitions": {
                        "ru": "устройство в фотоаппарате, регулирующее время воздействия света на матрицу или плёнку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затвор",
                                "target_lang_sense_clarification": "в фотоаппарате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51912cb6-0c56-3dac-a10e-659efc577cbc",
                    "sense_definition": "krótka relacja filmowa lub seria ujęć przedstawiająca jakieś wydarzenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "film_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W wiadomościach pokazano krótką <w>migawkę</w> z wczorajszego meczu piłkarskiego.",
                            "target_lang_translations": {
                                "ru": "В новостях показали короткий <w>сюжет</w> со вчерашнего футбольного матча."
                            }
                        },
                        {
                            "text": "Telewizja przygotowała interesujące <w>migawki</w> z festiwalu muzycznego.",
                            "target_lang_translations": {
                                "ru": "Телевидение подготовило интересные <w>видеозарисовки</w> с музыкального фестиваля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "migawka z wydarzeń",
                        "migawki z meczu"
                    ],
                    "target_lang_definitions": {
                        "ru": "короткий видеосюжет, репортаж или нарезка кадров, освещающая событие"
                    },
                    "translations": {
