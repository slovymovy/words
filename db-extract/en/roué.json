    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1942c9e4-7d51-3d91-bf5c-117216efa6d5",
                "word": "roué",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "919bf015-4cfe-4990-b6ee-2eb97b01b8f8",
                        "entry_id": "1942c9e4-7d51-3d91-bf5c-117216efa6d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "roués"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf59cf16-e22a-39a0-8c7a-11a5e23ccd62",
                        "entry_id": "1942c9e4-7d51-3d91-bf5c-117216efa6d5",
                        "glosses": [
                            "A debauched or lecherous person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d778a697-6f09-4bc1-a533-fc9d191ecdea",
                                "sense_id": "cf59cf16-e22a-39a0-8c7a-11a5e23ccd62",
                                "text": "A taste and knowledge of wines and cookery appears to them to be the sign of an accomplished roué and manly gentleman."
                            },
                            {
                                "example_id": "fbb7eac7-cf43-4703-a7ea-7790244cd3c2",
                                "sense_id": "cf59cf16-e22a-39a0-8c7a-11a5e23ccd62",
                                "text": "The old roué, twice married and patriarch of an extended family, never concealed the fact that he was “a ladies’ man”."
                            },
                            {
                                "example_id": "1f982a33-a6ef-4a4c-806c-c525224d8fdf",
                                "sense_id": "cf59cf16-e22a-39a0-8c7a-11a5e23ccd62",
                                "text": "Would you trust him alone with your young daughter? Certainly not, though who could blame her for being captivated? In this day and age especially, a good roué is hard to find."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f175b70-146c-4292-8490-f50cbdfdbd18",
                        "source_entry_id": "1942c9e4-7d51-3d91-bf5c-117216efa6d5",
                        "source_sense_id": "cf59cf16-e22a-39a0-8c7a-11a5e23ccd62",
