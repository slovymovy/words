{
    "word_family": [
        "pity",
        "pitifully",
        "pitifulness",
        "pitiable",
        "pitiless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bfa0300f-5207-3cf6-a35c-9c8badd16edc",
                    "sense_definition": "Evoking compassion or sympathy because of distressing inadequacy or suffering; pathetic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arousing_pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The abandoned puppy was a <w>pitiful</w> sight, shivering cold in the heavy rain.",
                            "target_lang_translations": {
                                "es": "El cachorro abandonado era una estampa <w>lastimosa</w>, tiritando de frío bajo la intensa lluvia."
                            }
                        },
                        {
                            "text": "He offered a <w>pitiful</w> excuse for why he had failed to finish the assignment.",
                            "target_lang_translations": {
                                "es": "Ofreció una excusa <w>patética</w> de por qué no había terminado la tarea."
                            }
                        }
                    ],
                    "synonyms": [
                        "pathetic",
                        "pitiable",
                        "miserable",
                        "lamentable",
                        "deplorable"
                    ],
                    "common_phrases": [
                        "pitiful sight",
                        "pitiful excuse"
                    ],
                    "target_lang_definitions": {
                        "es": "Que evoca compasión o simpatía debido a un sufrimiento, precariedad o condición deplorable; patético."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lastimoso",
                                "target_lang_sense_clarification": "que da lástima o conmiseración"
                            },
                            {
                                "target_lang_word": "penoso",
                                "target_lang_sense_clarification": "que da pena o resulta lamentable"
                            },
                            {
                                "target_lang_word": "lamentable",
                                "target_lang_sense_clarification": "deplorable o patético"
                            },
                            {
                                "target_lang_word": "patético",
                                "target_lang_sense_clarification": "que despierta tristeza o compasión"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e1ddd49-d231-3f68-83a6-70d8d74a4427",
                    "sense_definition": "Extremely small, inadequate, or insignificant in amount.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inadequate_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>pitiful</w> number of students bothered to turn up for the morning lecture.",
                            "target_lang_translations": {
                                "es": "Un número <w>irrisorio</w> de estudiantes se molestó en presentarse a la clase matutina."
                            }
                        },
                        {
                            "text": "They were paid a <w>pitiful</w> amount of money for working twelve hours a day.",
                            "target_lang_translations": {
                                "es": "Les pagaban una cantidad <w>mísera</w> de dinero por trabajar doce horas al día."
                            }
                        }
                    ],
                    "synonyms": [
                        "pathetic",
                        "miserable"
                    ],
                    "common_phrases": [
                        "pitiful amount",
                        "pitiful number"
                    ],
                    "target_lang_definitions": {
                        "es": "Extremadamente pequeño, escaso, insignificante o miserable en cantidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mísero",
                                "target_lang_sense_clarification": "extremadamente escaso o mezquino"
                            },
                            {
                                "target_lang_word": "irrisorio",
                                "target_lang_sense_clarification": "tan insignificante que causa risa o burla"
                            },
                            {
                                "target_lang_word": "ridículo",
                                "target_lang_sense_clarification": "insignificante o escaso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b55f02c-b3cd-37a6-be7a-dd126fd3a7c4",
                    "sense_definition": "Feeling sorrow or compassion for others; showing mercy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feeling_pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kind king remained <w>pitiful</w> toward the captured rebels despite their treason.",
                            "target_lang_translations": {
                                "es": "El bondadoso rey se mantuvo <w>piadoso</w> con los rebeldes capturados a pesar de su traición."
                            }
                        },
                        {
                            "text": "She hoped for a <w>pitiful</w> judge who might forgive her desperate mistake.",
                            "target_lang_translations": {
                                "es": "Esperaba un juez <w>compasivo</w> que pudiera perdonar su error desesperado."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean 'merciful'"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Que siente compasión o misericordia hacia los demás; compasivo o piadoso."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "piadoso",
                                "target_lang_sense_clarification": "que muestra misericordia o conmiseración"
                            },
                            {
                                "target_lang_word": "compasivo",
                                "target_lang_sense_clarification": "que se compadece de los demás"
                            },
                            {
                                "target_lang_word": "misericordioso",
                                "target_lang_sense_clarification": "inclinado a perdonar y tener piedad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "def83193-3b29-38be-95d1-90d4b9eec3f6",
                    "sense_definition": "In a pitiful or pathetic manner; pitifully.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arousing_pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lost child cried <w>pitiful</w> while searching for her parents in the crowded station.",
                            "target_lang_translations": {
                                "es": "La niña perdida lloraba <w>lastimeramente</w> mientras buscaba a sus padres en la abarrotada estación."
                            }
                        },
                        {
                            "text": "The injured dog whined <w>pitiful</w> as the vet carefully bandaged its wounded leg.",
                            "target_lang_translations": {
                                "es": "El perro herido gemía <w>lastimosamente</w> mientras el veterinario le vendaba con cuidado la pata lesionada."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used adverbially instead of 'pitifully'"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "De manera lastimera o lastimosa; con pena o provocando compasión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lastimosamente",
                                "target_lang_sense_clarification": "de forma que da lástima"
                            },
                            {
                                "target_lang_word": "lastimeramente",
                                "target_lang_sense_clarification": "con quejido o tristeza que conmueve"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}