                    {
                        "translation_id": "681285bc-9a3b-43f4-9232-859aea359359",
                        "source_entry_id": "45a5e44c-abcf-3a35-8991-6360126af298",
                        "source_sense_id": "51ec6085-c6d1-39d0-b1ac-912d75e531cb",
                        "source_sense_description": "En mauvais état",
                        "target_lang_word": "ramshackle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ramshackle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "782ae92c-b800-329a-b16b-298913033785",
                                        "entry_id": "581b2da4-d229-33a5-b726-19fc25cd06d8",
                                        "glosses": [
                                            "In disrepair or disorder; poorly maintained; lacking upkeep, usually of buildings or vehicles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32554401-be5e-40d8-8393-f769fb0e79b6",
                                                "sense_id": "782ae92c-b800-329a-b16b-298913033785",
                                                "text": "They stayed in a ramshackle cabin on the beach."
                                            },
                                            {
                                                "example_id": "980b61f0-0285-4cb4-a1f4-4b2bb0e68764",
                                                "sense_id": "782ae92c-b800-329a-b16b-298913033785",
                                                "text": "Steady old Curés come jolting past, now and then, in such ramshackle, rusty, musty, clattering coaches as no Englishman would believe in;[…]"
                                            },
                                            {
                                                "example_id": "031a199b-2c3f-4620-a662-c6e1a5039449",
                                                "sense_id": "782ae92c-b800-329a-b16b-298913033785",
                                                "text": "There came […] my lord the cardinal, in his ramshackle coach."
                                            },
                                            {
                                                "example_id": "b3897005-4366-47fe-ae0c-6baafbfa29af",
                                                "sense_id": "782ae92c-b800-329a-b16b-298913033785",
                                                "text": "I called for the cheeses, and took them away in a cab. It was a ramshackle affair, dragged along by a knock-kneed, broken-winded somnambulist, which his owner, in a moment of enthusiasm, during conversation, referred to as a horse."
                                            },
                                            {
                                                "example_id": "e6346ca1-6301-46cd-a2c4-f4c9c77032a3",
                                                "sense_id": "782ae92c-b800-329a-b16b-298913033785",
                                                "text": "A ramshackle old empire. (of Austria-Hungary)."
                                            },
                                            {
                                                "example_id": "9ec892bc-2084-4994-9b41-28ed4ab48ff3",
                                                "sense_id": "782ae92c-b800-329a-b16b-298913033785",
                                                "text": "The villa was a roomy white house, which, as is the case with most continental houses, looked to an English eye frail, ramshackle, and absurdly frivolous, more like a pagoda in a tea-garden than a place where one slept."
                                            },
                                            {
                                                "example_id": "ac5770f5-4332-4aec-90ac-7969ef512a55",
                                                "sense_id": "782ae92c-b800-329a-b16b-298913033785",
                                                "text": "When they got out of the Gare du Nord, and trundled along the cobbled streets in a ramshackle, noisy cab, it seemed to him that he was breathing a new air so intoxicating that he could hardly restrain himself from shouting aloud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58c83c50-0a3b-3ba5-b611-30175d9c74f2",
                                        "entry_id": "581b2da4-d229-33a5-b726-19fc25cd06d8",
                                        "glosses": [
                                            "Badly or carelessly organized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a455767-72b2-49bb-976b-ac010fce0ea0",
                                                "sense_id": "58c83c50-0a3b-3ba5-b611-30175d9c74f2",
                                                "text": "So ramshackle was the locals' attempt at defence that, with energetic wingers pouring into the space behind panicked full-backs and centre-halves dizzied by England's movement, it was cruel to behold at times."
                                            },
                                            {
                                                "example_id": "61222726-8ed0-4d31-a854-0d7dd337863a",
                                                "sense_id": "58c83c50-0a3b-3ba5-b611-30175d9c74f2",
                                                "text": "The alliance that pushed the Inflation Reduction Act into law in August was always a somewhat fragile and ramshackle one: Green New Dealers and the coal-state senator Joe Manchin, carbon-capture geeks and environmental justice warriors, all herded together in the sort of big-tent play you get with a 50-50 Senate and one party functionally indifferent on climate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ramshackle",
                                "target_lang_code": "en",
                                "target_senses": [
