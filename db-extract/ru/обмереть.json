                                        "sense_id": "2036d35a-89ac-3908-8428-908e29609809",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Lacking strength; weak; languid; inclined to lose consciousness"
                                        ],
                                        "tags": [
                                            "of a being"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0debfb51-4f43-4444-a049-48e4b78235f4",
                                                "sense_id": "2036d35a-89ac-3908-8428-908e29609809",
                                                "text": "I felt faint after my fifth gin and tonic."
                                            },
                                            {
                                                "example_id": "cdfd5d34-f618-41e5-9181-abadbf6459d9",
                                                "sense_id": "2036d35a-89ac-3908-8428-908e29609809",
                                                "text": "He almost fell faint due to the hot climate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53563a5f-1ea6-30f9-8941-52b28b8812e8",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Lacking courage, spirit, or energy; cowardly; dejected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4716ada-7a4d-4045-a42e-237229c1ca3c",
                                                "sense_id": "53563a5f-1ea6-30f9-8941-52b28b8812e8",
                                                "text": "Faint heart ne'er won fair lady."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa33356b-7f8c-394d-81f5-68b7f65120e0",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Barely perceptible; not bright, or loud, or sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f5df67-ed17-4a0e-85a9-9ad65b89f6ff",
                                                "sense_id": "aa33356b-7f8c-394d-81f5-68b7f65120e0",
                                                "text": "There was a faint red light in the distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f47e17c-10bd-3ebf-a71d-a889052e7618",
                                        "entry_id": "8d72b145-d1b5-3e50-a03c-a0249d90879a",
                                        "glosses": [
                                            "Performed, done, or acted, weakly; not exhibiting vigor, strength, or energy."
