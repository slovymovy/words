                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f8a9971-4691-4bab-bb61-ec630ddd0794",
                                "sense_id": "f74a931d-1ee5-3322-9e03-798d2f8b3251",
                                "text": "Europejczycy to dopiero rasiści - mówi przy popołudniowej herbatce Afrykanerka Eve, wykształcona pani w średnim wieku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e92aaa4d-1614-46b2-ad0d-ac4cbf614eca",
                        "source_entry_id": "44f1c409-d003-30a6-8d7d-fdeaa05353b7",
                        "source_sense_id": "f74a931d-1ee5-3322-9e03-798d2f8b3251",
                        "target_lang_word": "raciste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c91ae98-1beb-392e-bf58-2cc161c1aab2",
                                        "entry_id": "5ddb853b-3b03-3e1c-8e24-af294c738f99",
                                        "glosses": [
                                            "Qui fait preuve ou qui va dans le sens des théories du racisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "772ccab0-c728-44a7-9c8d-41a43344f6e7",
                                                "sense_id": "4c91ae98-1beb-392e-bf58-2cc161c1aab2",
                                                "text": "Et pourtant les discriminations racistes se perpétuent, de génération en génération, dans des proportions massives et une remarquable indifférence."
                                            },
                                            {
                                                "example_id": "b7e74616-c1ca-4612-8e97-1f4fda4739ec",
                                                "sense_id": "4c91ae98-1beb-392e-bf58-2cc161c1aab2",
                                                "text": "Le terme de « nazislamisme » désigne une idéologie fondée sur une approche raciste et religieuse alimentée par la lecture littérale dévoyée du texte coranique utilisé par des groupes sectaires comme le salafisme, le wahabbisme ou les Frères musulmans."
                                            },
                                            {
                                                "example_id": "2f16d74d-7d8d-4f4d-ad42-8d46c0546a66",
                                                "sense_id": "4c91ae98-1beb-392e-bf58-2cc161c1aab2",
                                                "text": "Cet islam là était celui de la jeunesse. Il avait, dans les têtes, réussi à détrôner l’« islam consulaire » des pères et vouait aux gémonies toute la camarilla intellectuelle blédarde qui pondait des tribunes hostiles aux musulmans dans des journaux racistes."
                                            },
                                            {
                                                "example_id": "2fc05b28-40e1-422c-9c4a-202ebdbf6f1c",
                                                "sense_id": "4c91ae98-1beb-392e-bf58-2cc161c1aab2",
                                                "text": "Si tout est raciste, rien ne l’est vraiment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4be3a05a-8e3a-3ad0-9cf3-4abd097aca19",
                                        "entry_id": "e1389298-9e57-3119-81aa-bf0ec4aa37b6",
                                        "glosses": [
                                            "Celui ou celle qui adhère aux thèses, théories ou doctrines du racisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4e1e29-6a26-4bdc-b1b0-6fa5cff4261f",
                                                "sense_id": "4be3a05a-8e3a-3ad0-9cf3-4abd097aca19",
                                                "text": "J'ai vu les racistes allemands invoquer Odin. Frénésies moribondes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f512efb-bdaf-3b31-81cc-340cb6ae9541",
                                        "entry_id": "e1389298-9e57-3119-81aa-bf0ec4aa37b6",
                                        "glosses": [
                                            "Personne dont le comportement montre du racisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
