                        "entry_id": "6f29738d-a56b-399d-b888-1d7e87bd30bd",
                        "glosses": [
                            "Finne des Dregwurms (eines Bandwurms, der das Gehirn besonders von Schafen befällt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c7499ec-2709-4aad-bb42-18f2ba0bca44",
                                "sense_id": "42cdddf8-9b0f-37b9-ba26-9a9dc88c1953",
                                "text": "Aus der Quese entsteht im Darm des Hundes der Quesenbandwurm. Durch Hundeexkremente landen die Bandwurmeier wieder in der Natur."
                            }
                        ],
