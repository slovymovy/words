                        "examples": [
                            {
                                "example_id": "f30f290d-8971-4d44-a014-66fa37465639",
                                "sense_id": "2b1cde68-22e7-3bf1-9089-7188c200f012",
                                "text": "Protest katowickich straganiarzy osiągnął zamierzony skutek."
                            }
