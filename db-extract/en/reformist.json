                    {
                        "sense_id": "ffba3462-cb63-3b4e-99b3-d57ceaabe110",
                        "entry_id": "168f1f16-12ba-3905-b5ea-929e60dcf3d6",
                        "glosses": [
                            "Advocating reform of an institution or body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6910851-ffd7-4aef-98a6-86b87f9a9050",
                                "sense_id": "ffba3462-cb63-3b4e-99b3-d57ceaabe110",
                                "text": "[...] all the prose is German, all reformist, all moralising, and has little or practically no echo of antiquity."
                            }
                        ]
                    },
                    {
                        "sense_id": "384598f6-2ea6-3d8f-ab16-0e54bc77be2e",
                        "entry_id": "168f1f16-12ba-3905-b5ea-929e60dcf3d6",
                        "glosses": [
                            "Specifically, advocating reform and the gradual accumulation of small changes, as opposed to revolutionary action."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8534e81c-27dc-4dd4-99e1-eec7a488655f",
                        "source_entry_id": "168f1f16-12ba-3905-b5ea-929e60dcf3d6",
                        "source_sense_description": "advocating reform of an institution or body",
                        "target_lang_word": "réformiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réformiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0528481e-7b5e-33c5-8097-c0080db2b95e",
                                        "entry_id": "77220f64-a2e2-326b-95c8-334c3f46822b",
                                        "glosses": [
                                            "Qui est partisan d’une réforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a4c8cd-d43a-458e-971f-6e6ce3555b38",
                                                "sense_id": "0528481e-7b5e-33c5-8097-c0080db2b95e",
                                                "text": "Soyez tranquille, si une fois je me fais huguenot, je serai plus huguenot que Luther, que Calvin, que Mélanchthon et que tous les réformistes de la terre."
                                            },
                                            {
                                                "example_id": "a4cac588-847a-4351-902d-bcd2a507ec24",
                                                "sense_id": "0528481e-7b5e-33c5-8097-c0080db2b95e",
                                                "text": "Seulement, remarquez bien ceci, l’Académie, même à cette époque où elle était si franchement réformiste, ne devançait pas l’usage ; elle le suivait."
                                            },
                                            {
                                                "example_id": "23feaed1-1888-4286-8625-f2ad42ee9da9",
                                                "sense_id": "0528481e-7b5e-33c5-8097-c0080db2b95e",
                                                "text": "Le nationalisme […] a partagé cette responsabilité avec le mouvement réformiste islamique antérieur, qui cherchait à revivifier l'islam, comme moyen de résister aux empiétements et aux incursions de la puissance et des idées européennes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "réformiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abaacc90-86b4-3749-a8d7-84c8ae932119",
                                        "entry_id": "52df23cf-06bc-3f96-ae09-98a7e35856a9",
                                        "glosses": [
                                            "Partisan d’une réforme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ea1095a-a267-3790-99da-3233e551492d",
                                        "entry_id": "52df23cf-06bc-3f96-ae09-98a7e35856a9",
                                        "glosses": [
                                            "Celui ou celle qui professe le changement social par des réformes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "778d3661-9a04-414d-914b-d084216b267d",
                                                "sense_id": "6ea1095a-a267-3790-99da-3233e551492d",
                                                "text": "Ce réformiste en politique est jugé diversement par ses propres contemporains."
                                            },
                                            {
                                                "example_id": "9f45d144-dd6d-4916-9e3c-35699b8c1865",
                                                "sense_id": "6ea1095a-a267-3790-99da-3233e551492d",
                                                "text": "Un de nos réformistes les plus distingués, Henri Turot, longtemps rédacteur de la Petite République et conseiller municipal de Paris, a écrit un livre sur les « prolétaires de l'amour » ; il désigne ainsi les prostituées de bas étage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
