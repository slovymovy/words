                    {
                        "sense_id": "b7560864-9f67-38b3-84c1-92ded9ca7ed8",
                        "entry_id": "4921de7a-3f17-3105-8585-87444151a0e2",
                        "glosses": [
                            "A member of certain so self-styled Novatian and other medieval Christian sects embracing a form of dualism and extraordinary practices purportedly adhering to Mary Magdalene's teachings, persecuted by Roman Catholics as heretics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0bbb966-45b1-4794-b00e-ded20532fb16",
                                "sense_id": "b7560864-9f67-38b3-84c1-92ded9ca7ed8",
                                "text": "The Albigenses, famous Cathars in and around Albi (southern France), were eradicated in a bloody ‘crusade’."
                            }
                        ]
                    }
                ],
                "translations": [
