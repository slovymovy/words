                        "examples": [
                            {
                                "example_id": "1693ec8c-fe76-457c-b476-245769cfe08d",
                                "sense_id": "859b0e50-a871-39a2-9807-5fb4bae398bd",
                                "text": "„Ich stehle die nachgemachten Blumen und stecke sie in die Gartenerde.“"
                            },
                            {
                                "example_id": "ea56c64d-b044-4f1c-a07b-2a098257ab93",
                                "sense_id": "859b0e50-a871-39a2-9807-5fb4bae398bd",
                                "text": "„Schon sahen sie sich in Hemdsärmeln am Rande eines Beetes beim Rosen-Okulieren, Umgraben, Hacken, Prüfen der Gartenerde und Austopfen von Tulpen.“"
                            }
                        ],
