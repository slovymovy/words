                    {
                        "translation_id": "93fa9773-a4bd-4cf5-9002-00449adbd43a",
                        "source_entry_id": "19bb8c68-9f44-3a89-8ce5-2c00b905f91f",
                        "source_sense_description": "quality of being sage",
                        "target_lang_word": "му́дрость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "му́дрость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "89a0c063-7ef9-323f-9b05-71bda69252f3",
                                        "entry_id": "edc48fa2-879d-3129-954e-141abf336c76",
                                        "glosses": [
                                            "свойство по значению прилагательного мудрый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb8b914-9dc7-42b4-b985-297758a21bbb",
                                                "sense_id": "89a0c063-7ef9-323f-9b05-71bda69252f3",
                                                "text": "В прологе автор уподобляет своё сочинение зданию, возведённому «на камне Христовом» и опирающемуся на четыре колонны: на авторитет пророков, достоинство апостолов, мудрость толкователей и размышления магистров."
                                            },
                                            {
                                                "example_id": "441721ef-3e8c-40c8-a9be-62dfa8924341",
                                                "sense_id": "89a0c063-7ef9-323f-9b05-71bda69252f3",
                                                "text": "Сейчас она была уверена в правильности Вальки, в мудрости и логичности всех его поступков…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b856df53-a6e4-3fdc-ab9c-79765e86d256",
                                        "entry_id": "edc48fa2-879d-3129-954e-141abf336c76",
                                        "glosses": [
                                            "разг. сложность, замысловатость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e2a0cd4-095b-4157-b1bc-170fe1ae9e87",
                                                "sense_id": "b856df53-a6e4-3fdc-ab9c-79765e86d256",
                                                "text": "Извозчика, пожалуй, и не мудрость нанять, да ехать-то некуда."
                                            },
                                            {
                                                "example_id": "f67d8c56-64dc-423c-8e0e-b15990bf55dd",
                                                "sense_id": "b856df53-a6e4-3fdc-ab9c-79765e86d256",
                                                "text": "― Ведь тут не мудрость какая, ― сказал Петрушка, глядя искоса, ― окроме того, что, спустясь с горы, взять попрямей, ничего больше и нет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d9077cc-5067-32af-b9d0-946465e6cf6a",
                                        "entry_id": "edc48fa2-879d-3129-954e-141abf336c76",
                                        "glosses": [
                                            "мудрое высказывание, суждение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc31ea6c-aac2-4971-879c-5799c182ce05",
                                                "sense_id": "7d9077cc-5067-32af-b9d0-946465e6cf6a",
                                                "text": "А ведь последуй депутаты небезызвестной мудрости не пытаться объять необъятное ― не было бы проблемы."
                                            },
                                            {
                                                "example_id": "937f3582-5c79-4c56-9ec4-e426d9fc3d52",
                                                "sense_id": "7d9077cc-5067-32af-b9d0-946465e6cf6a",
                                                "text": "Недаром старинная мудрость гласит: «Ночью все кошки серы»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e05080ce-3536-4e8a-85aa-5f9801682ee1",
