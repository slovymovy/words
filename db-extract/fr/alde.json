                "senses": [
                    {
                        "sense_id": "d0b476d9-9fc1-35dc-93d8-66b632d038f8",
                        "entry_id": "2694e909-cfb5-3c8e-8d2a-aab4ac66cdd1",
                        "glosses": [
                            "Livre imprimé par Alde Manuce ou ses descendants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b2b6b1-01ab-4d6a-b0b5-758dad624dae",
                                "sense_id": "d0b476d9-9fc1-35dc-93d8-66b632d038f8",
                                "text": "— C’étoit, s’il m’en souvient, l’ombre de Purgold dont les funestes ciseaux mordoient d’un pouce et demi sur les marges de mes aldes brochés, tandis que celle d’Heudier plongeoit impitoyablement dans un acide dévorant mon plus beau volume d’édition princeps, et l’en retiroit tout blanc ; mais j’ai de bonnes raisons de penser qu’ils sont au moins en purgatoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "d26bff63-3bd4-331f-a5ca-45af73def7aa",
                        "entry_id": "2694e909-cfb5-3c8e-8d2a-aab4ac66cdd1",
                        "glosses": [
                            "Livre précieux."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c35abc0e-a6c3-43d3-92ca-b7d71713e0da",
                                "sense_id": "d26bff63-3bd4-331f-a5ca-45af73def7aa",
                                "text": "Enfin, il est à lui, le livre,\nCet alde rare et précieux."
                            }
                        ]
                    }
