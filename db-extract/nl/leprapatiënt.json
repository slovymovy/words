                        "glosses": [
                            "persoon lijdend aan lepra, een ernstige huidinfectie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b5d696a-20b8-4295-9d78-a6fb94b0faff",
                                "sense_id": "905612c6-ea15-3257-a8cc-db8cd28bef23",
                                "text": "Marianne Cope, die eind negentiende eeuw naar Hawaii vertrok om te zorgen voor leprapatiënten en Pedro Calungsod, een Filipijnse tiener die in de zeventiende eeuw missiewerk deed in Guam, maar werd vermoord door de lokale bevolking."
                            },
                            {
                                "example_id": "0fcf78f0-44c9-4e2d-9714-ed9dc0b03b12",
                                "sense_id": "905612c6-ea15-3257-a8cc-db8cd28bef23",
                                "text": "'Reisadvies Negatief' gaat over landen en regio's waar de gemiddelde toerist zich niet laat zien. Vanaf zondag neemt Sander de Kramer (De Rekenkamer) de kijker in vier afleveringen mee naar aidsgevangenissen in Oekraïne, restanten van tropisch regenwoud op Sumatra en leprapatiënten op Madagaskar."
                            }
                        ]
                    }
