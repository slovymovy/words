                        ]
                    },
                    {
                        "translation_id": "2700549f-ec86-4bb3-a85b-24ca6c92bb55",
                        "source_entry_id": "22e2095f-4cdc-356c-9313-495267fb46bc",
                        "source_sense_id": "5d981a98-4017-3bbc-b834-bed7d79b23c5",
                        "target_lang_word": "ВИЧ",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ВИЧ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "da2c4479-b7e5-3198-9317-1057ac0f24c6",
                                        "entry_id": "66ba4b36-e30a-3efc-bac8-d77f854eef34",
                                        "glosses": [
                                            "мед. сокр. от вирус иммунодефицита человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc355775-5ce5-443f-b95c-f1b019907a1e",
                                                "sense_id": "da2c4479-b7e5-3198-9317-1057ac0f24c6",
                                                "text": "Вирус иммунодефицита человека (ВИЧ), который и вызывает болезнь, внедряется в генетический материал клеток, где долгое время может оставаться в «спящем» состоянии."
                                            },
                                            {
                                                "example_id": "6d6de4d7-e44d-47f1-beda-5f6099636a3f",
                                                "sense_id": "da2c4479-b7e5-3198-9317-1057ac0f24c6",
                                                "text": "Вирус иммунодефицита человека (ВИЧ) убивает Т-хелперный лимфоцит, иммунный ответ «отключается»: человека начинают одолевать вирусные и бактериальные заболевания, а также рак — в результате выключения иммунного надзора."
                                            },
                                            {
                                                "example_id": "7c37e94a-0a3e-499d-98ff-06e44529423f",
                                                "sense_id": "da2c4479-b7e5-3198-9317-1057ac0f24c6",
                                                "text": "33 тыс. заключённых, содержащихся в российских колониях и тюрьмах, заражены ВИЧ."
                                            },
                                            {
                                                "example_id": "fdc5842d-38b6-4026-8f9b-021b0afa5321",
                                                "sense_id": "da2c4479-b7e5-3198-9317-1057ac0f24c6",
                                                "text": "Если вы решили сдать анализ на ВИЧ в Мурманском центре специализированных видов медицинской помощи, в просторечии — кожно-венерологическом диспансере (КВД), придётся сообщить о себе немало."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a15417ed-a761-31bc-9217-79c4a520f39b",
                                        "entry_id": "66ba4b36-e30a-3efc-bac8-d77f854eef34",
                                        "glosses": [
                                            "разг. медицинский анализ на наличие ВИЧ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1ac44c-5d4b-4275-bf75-8b7eeb269b80",
                                                "sense_id": "a15417ed-a761-31bc-9217-79c4a520f39b",
                                                "text": "― Я сдала РВ и ВИЧ! ― бойко вставила Саша."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7018963f-82d4-3233-bb0e-7c55775bc6c5",
                                        "entry_id": "66ba4b36-e30a-3efc-bac8-d77f854eef34",
                                        "glosses": [
                                            "заболевание иммунной системы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
