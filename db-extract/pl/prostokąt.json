                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rectangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93bffba8-cfc3-3c65-8ce8-eb210c580d24",
                                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                                        "glosses": [
                                            "Any quadrilateral having opposing sides parallel and four right angles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab064e0e-b329-3a8c-b2c7-f27c1b0dda63",
                                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                                        "glosses": [
                                            "Such a quadrilateral that is oblong (longer than it is wide): one that is not regular (equilateral), that is, any except a square."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ad1b3bc-043e-3367-995b-b95f8cd99680",
                                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                                        "glosses": [
                                            "A right angle."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64147a08-8662-4b9d-9630-916e6afe0a30",
                                                "sense_id": "2ad1b3bc-043e-3367-995b-b95f8cd99680",
                                                "text": "For why should you praise, for example, the integrity of a Square who faithfully defends the interests of his client, when you ought in reality rather to admire the exact precision of his Rectangles?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4bbda37-53b9-3fee-83f7-7428dd5dabe7",
                                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                                        "glosses": [
                                            "The product of two quantities."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "959cbb32-331b-42df-a23a-51fc2baf5594",
                                                "sense_id": "b4bbda37-53b9-3fee-83f7-7428dd5dabe7",
                                                "text": "In Lines it [the product] is always (and ſometimes in Numbers) call'd the Rectangle between the two Lines, multiply'd by one another."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rectangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2801a1e1-54e9-3cda-b50c-dd4c581229ea",
                                        "entry_id": "bf08906e-0d61-332d-95a0-9fd066ca0fef",
                                        "glosses": [
                                            "Right-angled."
                                        ],
                                        "tags": [
                                            "archaic",
