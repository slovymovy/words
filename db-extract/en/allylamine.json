                        "sense_id": "8dfbcde6-d482-33c7-840d-93698c012772",
                        "entry_id": "0ccfd505-67ca-34f9-abe5-ef739c1e1d43",
                        "glosses": [
                            "The unsaturated primary amine CH₂=CH-CH₂-NH₂ or any of its derivatives"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7825dc6d-a620-4887-bddc-00a66d72e6a1",
                                "sense_id": "8dfbcde6-d482-33c7-840d-93698c012772",
                                "text": "The formation of this substance, which we propose to designate allylamine, is perfectly analogous to the production of ethylamine by means of cyanate of ethyl."
                            },
                            {
                                "example_id": "9c1dbe19-90ea-43f2-b63e-8a9453ea3427",
                                "sense_id": "8dfbcde6-d482-33c7-840d-93698c012772",
                                "text": "Because the sequela of allylamine cardiac toxicity was believed to involve myocardial ischemia due to lesions in the cardiac vasculature, attention has focused on its effects on the aorta and coronary arteries."
                            },
                            {
                                "example_id": "d8abb198-5211-430d-9cfe-e9bd974e7410",
                                "sense_id": "8dfbcde6-d482-33c7-840d-93698c012772",
                                "text": "Late metals, on the other hand, have been used to cleave the C-N bonds of allylamines."
                            }
                        ]
                    }
                ],
