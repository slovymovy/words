                                                "example_id": "5ba6118f-0c93-4836-9a21-256a6e6ead6e",
                                                "sense_id": "9c706506-3d8a-3dea-b2f3-3608859e3aa8",
                                                "text": "Occasional aberrations of intellect"
                                            },
                                            {
                                                "example_id": "1b9c988c-13cc-4592-966a-2b01692fd824",
                                                "sense_id": "9c706506-3d8a-3dea-b2f3-3608859e3aa8",
                                                "text": "We see indeed the aberrations of unruly appetite"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04c80e4c-42ba-3ebc-87ce-261284177c64",
                                        "entry_id": "537b2f75-5add-334f-a766-71927fc59d89",
                                        "glosses": [
                                            "Any creature with supernatural powers not found in the organized classes of beings in a given setting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7543f7-0958-4a73-b375-18fe6c95fe46",
                                                "sense_id": "04c80e4c-42ba-3ebc-87ce-261284177c64",
                                                "text": "Only by submitting to the aberration could the human traders travel safely through the territory of Zularn."
                                            }
