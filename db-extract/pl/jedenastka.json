                                                "text": "Auf die Zehn folgt die Elf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6472add-6aa7-3650-b57e-dc4e375917f0",
                                        "entry_id": "7603b601-b34b-3ddc-a60f-34044c5e8579",
                                        "glosses": [
                                            "Fußballmannschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd75ac77-7a68-41eb-9daf-16ccfbcd9d08",
                                                "sense_id": "a6472add-6aa7-3650-b57e-dc4e375917f0",
                                                "text": "Die Hamburger Elf feierte ein großes Comeback."
                                            },
                                            {
                                                "example_id": "1f30cec7-2247-4c7f-9586-15027e68db72",
                                                "sense_id": "a6472add-6aa7-3650-b57e-dc4e375917f0",
                                                "text": "Auch die Elfen aus der Elfenbeinküste und aus Dänemark sind nun auf dem Rasen im Stadion, um ihr jeweils erstes WM-Spiel zu absolvieren."
                                            }
                                        ],
