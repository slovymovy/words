                ],
                "senses": [
                    {
                        "sense_id": "5c9d6c79-f64a-3320-a437-c9533bf65667",
                        "entry_id": "a59fa913-a170-3ae2-bb10-48dbae608e76",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "390af821-e86f-44ff-96d1-f2a6e2fbb752",
                                "sense_id": "5c9d6c79-f64a-3320-a437-c9533bf65667",
                                "text": "Frau Lindle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a0a5c420-e5e7-499b-b287-c1740980344c",
                                "sense_id": "5c9d6c79-f64a-3320-a437-c9533bf65667",
                                "text": "Herr Lindle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9199ec4c-6bb0-463f-ada4-157ce2dad8e5",
                                "sense_id": "5c9d6c79-f64a-3320-a437-c9533bf65667",
                                "text": "Die Lindles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "11dd0a2b-281a-45f0-8b50-8b2670670942",
                                "sense_id": "5c9d6c79-f64a-3320-a437-c9533bf65667",
                                "text": "Der Lindle trägt nie die Schals, die die Lindle ihm strickt."
                            },
                            {
                                "example_id": "eb47bff8-f33e-4fc0-9c60-e364e886193d",
                                "sense_id": "5c9d6c79-f64a-3320-a437-c9533bf65667",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lindle kommt, geht der Herr Lindle.“"
                            },
                            {
                                "example_id": "5f58361b-1f72-4366-9372-901f468397ac",
                                "sense_id": "5c9d6c79-f64a-3320-a437-c9533bf65667",
                                "text": "Lindle kommt und geht."
                            },
                            {
                                "example_id": "7b3d9e4b-fb56-492e-b703-a5d08ccaaefd",
                                "sense_id": "5c9d6c79-f64a-3320-a437-c9533bf65667",
                                "text": "Lindles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
