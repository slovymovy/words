                                                "sense_id": "265ba008-a120-3c31-84dd-1e98827ae658",
                                                "text": "We hebben die hele zondagochtend in het ziekenhuis doorgebracht."
                                            },
                                            {
                                                "example_id": "b412e916-2bed-4b6b-8064-d242bfbaee78",
                                                "sense_id": "265ba008-a120-3c31-84dd-1e98827ae658",
                                                "text": "Op zondagochtend fietste ik richting onbekende kerkklokken om te zien of de gemeente en de sfeer daar iets voor mij was."
                                            },
                                            {
                                                "example_id": "f7dfdb75-3756-46d0-8e9f-0a92a7f215f6",
                                                "sense_id": "265ba008-a120-3c31-84dd-1e98827ae658",
                                                "text": "Op zondagochtend nam Lauritz Karl besluitvaardig mee op een vistochtje, de zoon moest roeien."
                                            }
