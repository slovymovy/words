                "translations": [
                    {
                        "translation_id": "eadd3595-50ed-45be-bc87-5290ae23ea58",
                        "source_entry_id": "1ba6c457-19e5-34ea-bb83-a1be5c8f6a67",
                        "source_sense_id": "fbf91226-69cb-33ff-b471-2acd154a41d2",
                        "target_lang_word": "treelike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treelike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34df1e03-027a-3509-b648-1c5c8bd2fd75",
                                        "entry_id": "0476368a-a65a-3ba7-90de-939126f5d7c1",
                                        "glosses": [
                                            "Having some characteristics of a tree; resembling or similar to a tree."
                                        ],
                                        "tags": [],
