                                                "sense_id": "11adc19a-fc2f-3b16-b509-31f6b0a88df2",
                                                "text": "„Die Polizisten hatten Schlagstock und Pistolentasche abgeschnallt und regelten den Verkehr.“"
                                            },
                                            {
                                                "example_id": "115793ea-1d35-4e7a-89c0-ab710584e2e6",
                                                "sense_id": "11adc19a-fc2f-3b16-b509-31f6b0a88df2",
                                                "text": "„Die weiße Pistolentasche für die Pistole Walther P1 hängt auf der linken Seite des Koppels.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
