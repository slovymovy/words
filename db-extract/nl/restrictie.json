                            {
                                "example_id": "22a4d8f7-f3e6-487e-907c-49a8da920f42",
                                "sense_id": "81840d05-2e7b-3db5-a4b3-2435780e3d95",
                                "text": "Dat is aan allerlei wettelijke restricties onderhevig."
                            },
                            {
                                "example_id": "16c7efd3-4796-4882-acb5-ca3676c531f6",
                                "sense_id": "81840d05-2e7b-3db5-a4b3-2435780e3d95",
                                "text": "Kinderen moeten meer offline, meer spelen, en minder in de gaten gehouden worden. Ze moeten vaker ‘nee’ te horen krijgen: meer (figuurlijke) tikken op de vingers, minder aaien over de bol. Meer vrijheid en meer restricties tegelijk dus."
                            }
                        ]
                    }
