                    "sense_definition": "Not often; at infrequent intervals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>seldom</w> come here now because they moved to another city.",
