        "de-extract.jsonl": [
            {
                "entry_id": "02448d6e-1d6c-3077-9e40-53e6bf43161e",
                "word": "recuperation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9217597e-386e-3899-8b8f-025c09734117",
                        "entry_id": "02448d6e-1d6c-3077-9e40-53e6bf43161e",
                        "glosses": [
                            "Erholung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d91e9a-fd3b-43ee-8b55-3db2283a904c",
                                "sense_id": "9217597e-386e-3899-8b8f-025c09734117",
                                "text": "„Recuperation, in the sociological sense, is the process by which politically radical ideas and images are twisted, co-opted, absorbed, defused, incorporated, annexed and commodified within media culture and bourgeois society, and thus become interpreted through a neutralized, innocuous or more socially conventional perspective.[1][2][3] More broadly, it may refer to the cultural appropriation of any subversive works or ideas by mainstream culture. It is the opposite of détournement, in which images and other cultural artifacts are appropriated from mainstream sources and repurposed with radical intentions.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb9604f7-901c-3518-8cec-45cca4be9ed8",
                        "entry_id": "02448d6e-1d6c-3077-9e40-53e6bf43161e",
                        "glosses": [
                            "Rückgewinnung, Wiedergewinnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d37b506-5fc8-4511-8168-77690de14e92",
                                "sense_id": "eb9604f7-901c-3518-8cec-45cca4be9ed8",
                                "text": "„Recuperation, in common usage, refers to a period of recovery. This has many uses, from medicine, in which sense it refers to the process by which medical patients recover from disease, injury, or mental illness, or finance, where it refers to the financial recovery of an individual or company.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
