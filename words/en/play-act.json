            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7fd215e-6aea-3019-b19d-3d4c7daf0986",
                    "sense_definition": "To perform a role in a theatrical production.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students decided to <w>play-act</w> a famous scene from Shakespeare for their final project."
                        },
                        {
                            "text": "She loves to <w>play-act</w> in local community theater productions during the summer."
                        }
                    ],
                    "synonyms": [
                        "perform",
                        "act"
                    ],
                    "common_phrases": [
                        "play-act on stage"
                    ]
                },
                {
                    "sense_id": "41b39bbe-d2d4-391c-9fd6-de3efcc08fa9",
                    "sense_definition": "To act out a specific scene or role in a dramatic or illustrative way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children began to <w>play-act</w> a scene where they were explorers discovering a new land."
                        },
                        {
                            "text": "They decided to <w>play-act</w> the historical event to help the students understand the context better."
                        }
                    ],
                    "synonyms": [
                        "enact",
                        "dramatize"
                    ],
                    "common_phrases": [
                        "play-act a scene"
                    ]
                },
                {
                    "sense_id": "3cadde3b-13d6-3b7d-9d26-20a4adc8f6a9",
                    "sense_definition": "To feign or simulate a condition or emotion, often to deceive others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was accused of <w>play-acting</w> an injury to waste time during the final minutes of the game."
                        },
                        {
                            "text": "He would often <w>play-act</w> confusion to avoid answering difficult questions from the reporters."
                        }
                    ],
                    "synonyms": [
                        "feign",
                        "simulate",
                        "pretend"
                    ],
                    "common_phrases": [
                        "play-act an injury"
                    ]
                },
                {
                    "sense_id": "45725581-47af-3671-9a3a-1b76dca60110",
                    "sense_definition": "To engage in insincere behavior or adopt a false persona to mislead or gain an advantage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician likes to <w>play-act</w> at being a man of the people while living in luxury."
                        },
                        {
                            "text": "She felt uncomfortable watching him <w>play-act</w> as a concerned friend when he clearly did not care."
                        }
                    ],
                    "synonyms": [
                        "pretend",
                        "pose"
                    ],
                    "common_phrases": [
                        "play-act at being"
                    ]
                }
            ]
        }
    ]
