                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f852246-5a11-38b4-8571-651b92ca9df5",
                        "entry_id": "c54c2145-d8f4-3a58-86f2-39f3de36b52b",
                        "glosses": [
                            "Rivière qui coule dans le département de la Sarthe, affluent de la Braye."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b04f2f28-2016-3901-b51a-032bd55f10ca",
                        "entry_id": "c54c2145-d8f4-3a58-86f2-39f3de36b52b",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc789757-d314-4c49-a970-6fe09674f600",
                                "sense_id": "b04f2f28-2016-3901-b51a-032bd55f10ca",
                                "text": "Elle avait pour aides immédiats Julot, natif de Miremont, qui commençait à se former au service, et Anille, jolie fillette de l’Isle-Adam, qui regardait Paris de loin comme les Hébreux rêvaient la terre promise."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "badd79c9-b15d-3003-8538-b2c0060a60fa",
