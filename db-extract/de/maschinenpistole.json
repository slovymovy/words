                ],
                "senses": [
                    {
                        "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                        "entry_id": "f6ea9a0d-f2dd-3484-93ae-e42515a41ef5",
                        "glosses": [
                            "vollautomatische Handfeuerwaffe mit geringer Masse und kurzem Lauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2806774-a827-4e47-9ff3-9d0af8bc8b5d",
                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                "text": "Die Polizisten schossen mit ihren Maschinenpistolen auf die Demonstranten."
                            },
                            {
                                "example_id": "86b26425-451a-41d9-bc94-680824bf78e0",
                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                "text": "„Zudem konnte schon bald jeder von uns die an Bord mitgeführten Handfeuerwaffen wie Maschinengewehre oder Maschinenpistolen fast schon mit verbundenen Augen zerlegen und pflegen.“"
                            },
                            {
                                "example_id": "ce0c712f-1460-48e2-81f3-222b2ab3c6da",
                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                "text": "„Hinter ihm treten ein paar Männer in einem seltsamen Aufzug mit Maschinenpistolen aus dem Gebüsch.“"
                            },
                            {
                                "example_id": "bcfd15f4-0ffa-4a59-955b-b68c8d4648dd",
                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                "text": "„Ich bekam meine Maschinenpistole.“"
                            },
                            {
                                "example_id": "331e4a28-2f4c-4b5c-842a-45acf8180a71",
                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                "text": "„Und kein Cherubim mit dem bloßen, hauenden Schwert, kein Russe mit seiner Maschinenpistole verwehrt den Zutritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a954455a-fc50-4c13-9b6d-7447cd9c30a7",
                        "source_entry_id": "f6ea9a0d-f2dd-3484-93ae-e42515a41ef5",
                        "source_sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
