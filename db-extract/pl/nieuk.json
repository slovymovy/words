                "senses": [
                    {
                        "sense_id": "70cdfac2-d504-32dc-a0c2-5778253eec8f",
                        "entry_id": "e54dfd3a-e6de-3e49-afa1-78f62f69438e",
                        "glosses": [
                            "ktoś, kto nie ma zamiłowania do nauki, także niedouczony"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d08477d9-8ec9-4581-a9cb-177da6f59d36",
                                "sense_id": "70cdfac2-d504-32dc-a0c2-5778253eec8f",
                                "text": "Jak będziesz takim nieukiem, to nie zdobędziesz odpowiedniego wykształcenia i dobrej pracy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65f95682-5019-4323-85eb-633a5a4545c1",
                        "source_entry_id": "e54dfd3a-e6de-3e49-afa1-78f62f69438e",
                        "source_sense_id": "70cdfac2-d504-32dc-a0c2-5778253eec8f",
                        "target_lang_word": "ignoramus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignoramus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9209963-ff66-39d9-adb9-c7df68bea091",
                                        "entry_id": "8a951be3-ada6-3c15-be43-ba340d072bd0",
                                        "glosses": [
                                            "A totally ignorant person—unknowledgeable, uneducated, or uninformed; a fool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e70edf61-3575-467d-867d-e3e72d8a4743",
                                                "sense_id": "c9209963-ff66-39d9-adb9-c7df68bea091",
                                                "text": "“The cost of appearing with this bloviating ignoramus is obvious, it seems to me,” he said on “This Week,” the ABC News program."
                                            },
                                            {
                                                "example_id": "27c2074c-776d-4db8-ba02-cbe4c644affe",
                                                "sense_id": "c9209963-ff66-39d9-adb9-c7df68bea091",
                                                "text": "“I am sorry to say your History teacher is an ignoramus! She can’t even spell ‘Bayeux’!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ignoramus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98de2371-21a0-3c82-a4a2-bd90a60b3a6e",
                                        "entry_id": "913d1e5d-e5c0-3e46-9f9c-a780c76191f0",
                                        "glosses": [
                                            "A grand jury's ruling on an indictment when the evidence is determined to be insufficient to send the case to trial."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ignoramus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef5cb51-1cdd-32a3-b46e-af3577b0dc27",
                                        "entry_id": "aec9c04e-c58f-356b-b658-7bf23948d804",
                                        "glosses": [
                                            "To make such a ruling against (an indictment)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b1e84e1-07ba-4783-ad4e-e90419adb86d",
                        "source_entry_id": "e54dfd3a-e6de-3e49-afa1-78f62f69438e",
                        "source_sense_id": "70cdfac2-d504-32dc-a0c2-5778253eec8f",
                        "target_lang_word": "неуч",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неуч",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "385e8a1e-d533-391e-85c2-67d5a7cd85fc",
                                        "entry_id": "0fcd0a90-c8c6-3965-8094-05afedd561b8",
                                        "glosses": [
                                            "разг. необразованный, невежественный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b432a1-fe7c-4f88-843b-01fdb3e49d60",
                                                "sense_id": "385e8a1e-d533-391e-85c2-67d5a7cd85fc",
                                                "text": "Все соседи наши такие неучи, такие скоты, которые сидят по домам, обнявшись с жёнами."
                                            },
                                            {
                                                "example_id": "3c6d5f36-a7d4-4b34-ad60-d665e70de9a6",
                                                "sense_id": "385e8a1e-d533-391e-85c2-67d5a7cd85fc",
                                                "text": "Иному мужику, конечно, всякая дрянь в диво; ему что — он деревенщина, неуч; где ему!"
                                            },
                                            {
                                                "example_id": "c9414f91-bec0-4fa5-8096-3991db661db4",
                                                "sense_id": "385e8a1e-d533-391e-85c2-67d5a7cd85fc",
                                                "text": "— Силою природы тоже вот такие пустомели и неучи, как ты, рождаются, но и то силою той же природы на них посылается учительная лоза, вводящая их в послушание и в разум."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfb13bd2-c10d-4333-9c2a-1ab9ebdb5e94",
                        "source_entry_id": "e54dfd3a-e6de-3e49-afa1-78f62f69438e",
                        "source_sense_id": "70cdfac2-d504-32dc-a0c2-5778253eec8f",
                        "target_lang_word": "невежда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "невежда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "76b3367f-5055-3e78-bfc1-b72bf4a5dc54",
                                        "entry_id": "6fc3d48a-b555-39e7-b73d-6facdcf10707",
                                        "glosses": [
                                            "тёмный, необразованный или несведущий в чём-то человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95940cd3-c3aa-4564-af3f-288871579ec1",
                                                "sense_id": "76b3367f-5055-3e78-bfc1-b72bf4a5dc54",
                                                "text": "В астрономии он был полный невежда."
                                            },
                                            {
                                                "example_id": "11ef1031-1b11-4826-8344-cca49bc17b12",
                                                "sense_id": "76b3367f-5055-3e78-bfc1-b72bf4a5dc54",
                                                "text": "Но этот народ — невежда в законе, проклят он."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
