                {
                    "sense_id": "6c29d85f-b166-3d5d-b9cf-be9154aaeba0",
                    "sense_definition": "Grundlegendes moralisches und rechtliches Prinzip oder Ideal, nach dem jeder Mensch fair und unvoreingenommen behandelt wird und das erhält, was ihm gebührt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prinzip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Bürger demonstrieren seit Wochen auf den Straßen für mehr soziale <w>Gerechtigkeit</w>."
                        },
                        {
                            "text": "Viele Menschen zweifeln nach diesem milden Urteil an der <w>Gerechtigkeit</w> des Rechtssystems."
                        }
                    ],
                    "synonyms": [
                        "Fairness",
                        "Gleichbehandlung"
                    ],
                    "antonyms": [
                        "Ungerechtigkeit"
                    ],
                    "common_phrases": [
                        "soziale Gerechtigkeit",
                        "Gerechtigkeit widerfahren lassen"
                    ]
                },
                {
                    "sense_id": "88e02cb0-5166-32c3-86d8-75cfe0401b21",
                    "sense_definition": "Die persönliche Eigenschaft, Tugend oder Haltung, in Handlungen und Urteilen stets unparteiisch, fair und objektiv zu sein.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tugend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen ihrer bemerkenswerten <w>Gerechtigkeit</w> schätzten alle Mitarbeiter die neue Abteilungsleiterin sehr."
                        },
                        {
                            "text": "Der erfahrene Richter handelte stets mit einem ausgeprägten Sinn für <w>Gerechtigkeit</w>."
                        }
                    ],
                    "synonyms": [
                        "Rechtschaffenheit",
                        "Unparteilichkeit",
                        "Fairness"
                    ],
                    "antonyms": [
                        "Ungerechtigkeit"
                    ],
                    "common_phrases": [
                        "Sinn für Gerechtigkeit"
                    ]
                },
                {
                    "sense_id": "24fe3fa6-20e9-3d1d-9e27-829b682c48b3",
                    "sense_definition": "Ein verbrieftes oder hergebrachtes Nutzungsrecht an einer Sache oder einem Grundstück.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zu dem alten Hof gehörte die im Grundbuch eingetragene <w>Gerechtigkeit</w>, im See zu fischen."
                        },
                        {
                            "text": "Der Müller besaß die verbriefte <w>Gerechtigkeit</w>, am Bach eine Mühle zu betreiben."
