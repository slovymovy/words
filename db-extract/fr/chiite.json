                    {
                        "form_id": "ff6e46b4-3799-4c23-9ee3-1a8ed4e79fde",
                        "entry_id": "f4b88cf7-34bf-348d-9693-1dfab7e14724",
                        "tags": [],
                        "form": "shîʻite"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                        "entry_id": "f4b88cf7-34bf-348d-9693-1dfab7e14724",
                        "glosses": [
                            "Schismatique, en se référant à l’islam."
                        ],
                        "tags": [
                            "Chiisme"
                        ],
                        "examples": [
                            {
                                "example_id": "d5ec9ece-26ac-4372-a5d4-72c233e83ee1",
                                "sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                                "text": "Je viens d’une famille chiite traditionnelle. On m’a toujours appris que les ismaéliens n’étaient que des hérétiques."
                            },
                            {
                                "example_id": "50a89f44-16b1-4cc4-9d93-70d2467e094c",
                                "sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                                "text": "Le haut clergé chiite, de plus en plus majoritairement iranien, a eu de plus en plus tendance à identifier la cause du chiisme et celle de la nation iranienne."
                            },
                            {
                                "example_id": "6c84b793-e1b5-47c7-b23c-d4135eb9219b",
                                "sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                                "text": "On se confie nos craintes : si la liste chiite (pro-iranienne) garde le pouvoir, que deviendront les femmes qui, comme nous, sont en faveur de la liberté féminine et ne veulent pas se plier à la volonté d’une société hyper-masculine ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8917fe0d-f65e-4d08-8e9a-10014c3d58c4",
                        "source_entry_id": "f4b88cf7-34bf-348d-9693-1dfab7e14724",
                        "source_sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                        "target_lang_word": "schiitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schiitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "951abb14-636f-344a-a936-66fce84eeaef",
                                        "entry_id": "db59a570-8c89-3466-a83a-c05dc1564a8a",
                                        "glosses": [
                                            "den Schiismus betreffend; dem Schiismus angehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a49aad78-6c80-4818-9792-778f78076006",
                                                "sense_id": "951abb14-636f-344a-a936-66fce84eeaef",
                                                "text": "In der nordirakischen Stadt Samarra befindet sich eines der wichtigsten Heiligtümer der schiitischen Muslime."
                                            },
                                            {
                                                "example_id": "89d88f99-db36-4f3d-9571-c805ef7fb9ae",
                                                "sense_id": "951abb14-636f-344a-a936-66fce84eeaef",
                                                "text": "„Der von den USA angeführte Irakkrieg und Sturz Saddam Husseins 2003 sowie die erste schiitische, proiranische Regierung im Irak unter Nuri Al-Maliki stellte eine einschneidende Neuordnung der regionalen Kräftekonstellation dar.“"
                                            },
                                            {
                                                "example_id": "a5988af5-e65a-41e8-9d46-e7d9570c8571",
                                                "sense_id": "951abb14-636f-344a-a936-66fce84eeaef",
                                                "text": "„Auch die schiitischen Aserbaidschaner am Ostufer des Kaspischen Meeres unterwarfen sich Moskau bis Ende des 19. Jahrhunderts.“"
                                            },
                                            {
                                                "example_id": "d1448e75-d832-49d7-90b2-349258c5caa0",
                                                "sense_id": "951abb14-636f-344a-a936-66fce84eeaef",
                                                "text": "„Agha Muhammad Yahya Khan (1917–1980) stammte aus einer schiitischen Familie persisch-türkischen Ursprungs, wuchs nahe Peschawar auf und machte in der Armee schnell Karriere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c280743f-f9b3-46ea-8c14-c97d43577949",
                        "source_entry_id": "f4b88cf7-34bf-348d-9693-1dfab7e14724",
