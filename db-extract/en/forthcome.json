                        "examples": [
                            {
                                "example_id": "29de1c2a-89c2-422e-8e45-ec44dcf6d268",
                                "sense_id": "9a34c015-c766-3e39-a135-8099933e7a21",
                                "text": "By dropping a penny in the slot, the gas was forthcoming, and when a penny's worth had forthcome the supply was automatically shut off."
                            },
                            {
                                "example_id": "a6cccb9c-f3f9-4f09-a99c-65211db0fe6d",
                                "sense_id": "9a34c015-c766-3e39-a135-8099933e7a21",
                                "text": "The crowd slowly dissolved as news from doctors and Service upstairs failed to forthcome."
                            },
                            {
                                "example_id": "afb6f7bf-07ed-4ec0-808d-352d8785fb08",
                                "sense_id": "9a34c015-c766-3e39-a135-8099933e7a21",
                                "text": "With little information forthcoming from Laos authorities, some travelers in Vang Vieng and friends of those who died have taken it upon themselves to investigate."
                            }
                        ]
