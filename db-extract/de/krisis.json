                        "form": "die Krisis"
                    },
                    {
                        "form_id": "8c365437-e325-4697-8424-fbb112c7cebe",
                        "entry_id": "061b3cf5-11e2-334f-b56d-9fec9a6465c4",
                        "tags": [
                            "accusative",
