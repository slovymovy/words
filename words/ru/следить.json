                {
                    "sense_id": "27be608b-e08f-3458-9557-1c2b8bb4c105",
                    "sense_definition": "Наблюдать взглядом за движением кого-либо или чего-либо, не отрывая глаз.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кот внимательно <следил> за птицей за окном.",
                            "target_lang_translations": {
                                "en": "The cat was carefully <watching> the bird outside the window.",
                                "es": "El gato <observaba> atentamente al pájaro tras la ventana.",
                                "fr": "Le chat <suivait attentivement du regard> l'oiseau par la fenêtre."
                            }
                        },
                        {
                            "text": "Зрители с интересом <следили> за игрой актёров на сцене.",
                            "target_lang_translations": {
                                "en": "The audience <watched> the actors' performance on stage with interest.",
                                "es": "Los espectadores <seguían> con interés la actuación de los actores en el escenario.",
                                "fr": "Les spectateurs <observaient> avec intérêt le jeu des comédiens sur scène."
                            }
                        }
                    ],
                    "common_phrases": [
                        "следить глазами",
                        "следить за полётом",
                        "следить за мячом"
                    ],
                    "target_lang_definitions": {
