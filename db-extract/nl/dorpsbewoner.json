        "nl-extract.jsonl": [
            {
                "entry_id": "9ee22123-dce8-348c-88e0-a9b02b535a09",
                "word": "dorpsbewoner",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "5d2118ad-0092-4ab9-9745-94c891d8eb3c",
                        "entry_id": "9ee22123-dce8-348c-88e0-a9b02b535a09",
                        "tags": [
                            "plural"
                        ],
                        "form": "dorpsbewoners"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8e232c7-8367-3f5d-83bb-df2893b656b9",
                        "entry_id": "9ee22123-dce8-348c-88e0-a9b02b535a09",
                        "glosses": [
                            "iemand die in een dorp woont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b387b9c-916f-4e13-9545-472629629c4d",
                                "sense_id": "d8e232c7-8367-3f5d-83bb-df2893b656b9",
                                "text": "In 2006 was 15 procent van de Nederlanders negatief over homo- en biseksualiteit, aldus het SCP-rapport, en vorig jaar was dat verder gedaald tot 7 procent. Ook in kringen die doorgaans minder blijmoedig over homoseksuelen denken, zoals wekelijkse kerkgangers, mannen, ouderen, dorpsbewoners en stemmers op christelijke partijen, wordt minder negatief geoordeeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3ee79cc-c25c-4a9f-bfa8-f7bafc6bd42e",
                        "source_entry_id": "9ee22123-dce8-348c-88e0-a9b02b535a09",
                        "source_sense_id": "d8e232c7-8367-3f5d-83bb-df2893b656b9",
                        "source_sense_description": "iemand die in een dorp woont",
                        "target_lang_word": "Dorfbewohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dorfbewohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9900597c-1461-39e7-87ba-220d6b907d60",
                                        "entry_id": "38298563-a62d-36c3-b42f-6e75d2987dab",
                                        "glosses": [
                                            "Einwohner eines Dorfes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb7d2a9d-abb7-44f7-b8c0-b5ada8668e51",
                                                "sense_id": "9900597c-1461-39e7-87ba-220d6b907d60",
                                                "text": "Ein Dorfbewohner ist ein Mensch, der in einem Dorf wohnt."
                                            },
                                            {
                                                "example_id": "52e5852f-2413-45f5-98f7-f4cdde88506c",
                                                "sense_id": "9900597c-1461-39e7-87ba-220d6b907d60",
                                                "text": "„Gleich nach dem Frühstück fuhren wir mit der Weinlese fort und im Laufe des Vormittags kamen noch einige Dorfbewohner hinzu.“"
                                            },
                                            {
                                                "example_id": "73128c06-f87e-44fd-8e90-70514769638a",
                                                "sense_id": "9900597c-1461-39e7-87ba-220d6b907d60",
                                                "text": "„Ich weiß auch von anderen Dorfbewohnern, dass sie ab und zu an verschiedenen Orten und völlig unerwartet Stromschläge bekommen.“"
                                            },
                                            {
                                                "example_id": "3b72fb99-3a91-470f-8a3c-65be3f994578",
                                                "sense_id": "9900597c-1461-39e7-87ba-220d6b907d60",
                                                "text": "„Wenngleich das Geschäft mit Skiurlaubern lukrativer war, spielten die Dorfbewohner den Sommer hindurch mit nicht geringem Stolz Gastgeber erlauchter Versammlungen von Koryphäen der Wissenschaft und anderer Prominenz.“"
                                            },
                                            {
                                                "example_id": "d37033f4-0f92-45c9-ada1-c213892bb5a8",
                                                "sense_id": "9900597c-1461-39e7-87ba-220d6b907d60",
                                                "text": "„Zbigniew legte sie auf einem kleinen Platz unter einem Baum aus, und die Dorfbewohner holten sich, was sie brauchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "479a006d-79e4-4fa6-b9fb-d3f3f528228c",
                        "source_entry_id": "9ee22123-dce8-348c-88e0-a9b02b535a09",
                        "source_sense_id": "d8e232c7-8367-3f5d-83bb-df2893b656b9",
                        "source_sense_description": "iemand die in een dorp woont",
                        "target_lang_word": "Dörfler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dörfler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0238ae0c-09ff-349d-9272-6c08ad1c9c83",
                                        "entry_id": "6306877e-9391-3d5e-a1bb-6d0a192f01d1",
                                        "glosses": [
                                            "Person, die in einem Dorf lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eccae50f-adda-4696-a5a5-06e4da0b0ce8",
                                                "sense_id": "0238ae0c-09ff-349d-9272-6c08ad1c9c83",
                                                "text": "„Den Dörflern hier ist die Grenze vor allem lästig.“"
                                            },
                                            {
                                                "example_id": "11ebbbb1-8413-4456-ac07-015888734a26",
                                                "sense_id": "0238ae0c-09ff-349d-9272-6c08ad1c9c83",
                                                "text": "„Nach der Zerstörung der Bahnstation und einiger Wohnhäuser am Südende von Velda wurde die Evakuierung angeordnet, und die Dörfler machten sich mit Handwagen und Ochsenkarren auf den Weg.“"
                                            },
                                            {
                                                "example_id": "ac6f51a5-0269-4fe3-a697-5eccb531b3fd",
                                                "sense_id": "0238ae0c-09ff-349d-9272-6c08ad1c9c83",
                                                "text": "„Dörfler trabten wie elektrisiert in die Kirche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dörfler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7beb239f-3008-3249-b546-b00f60b0c4b5",
                                        "entry_id": "1a341072-3450-36bb-93cc-e18d71fbac72",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
