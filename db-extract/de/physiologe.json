                        "entry_id": "6a568fcc-1377-3688-b243-096813124ede",
                        "glosses": [
                            "Biologe oder Mediziner, dessen Spezialgebiet die Physiologie ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "825ef07a-06ea-4349-94d7-6825bad1b5c2",
                                "sense_id": "fbf72c2d-f263-300e-a816-59ebd70a9688",
                                "text": "Ich bin Physiologe."
                            },
                            {
                                "example_id": "0a8a8642-ac5d-4aef-8648-926ffe3d233e",
                                "sense_id": "fbf72c2d-f263-300e-a816-59ebd70a9688",
                                "text": "„Der Jenaer Physiologe Wilhelm Preyer jedoch ist der erste gewesen, der die Gesamtentwicklung des Kindes und seiner Sprache zum Gegenstand einer mehrjährigen systematischen Untersuchung gemacht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
