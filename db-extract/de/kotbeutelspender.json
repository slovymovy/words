                "senses": [
                    {
                        "sense_id": "292452d7-343d-3ce7-bd5c-69a68bbd9709",
                        "entry_id": "e1f594b4-880a-3e4d-9a52-33a822efe3fa",
                        "glosses": [
                            "Automat oder Ausgabestelle für Hundekotbeutel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dc4c3f1-ebd2-476c-acb3-3bb50816e37e",
                                "sense_id": "292452d7-343d-3ce7-bd5c-69a68bbd9709",
                                "text": "„\"Wir werde uns mit dem Thema also nicht weiter befassen\", sagt Umweltdezernent Matthias Welpmann, der jedoch darauf hinweist, dass die Kotbeutelspender, die nicht Teil des Pilotprojektes sind - wie etwa am Jahnstadion -, auch weiterhin für Hundehalter nutzbar seien.“"
                            },
                            {
                                "example_id": "35bcbbeb-72d0-4a1a-af5e-dad46260b1e1",
                                "sense_id": "292452d7-343d-3ce7-bd5c-69a68bbd9709",
                                "text": "„Die Kot-Wiese soll eingezäunt und mit Kotbeutelspendern ausgestattet werden. Den Kot zu konzentrieren käme letzlich allen zugute, \"den Münchnerinnen und Münchnern und den Touristen\", so die CSU.“"
                            },
                            {
                                "example_id": "9471c2aa-ebb6-409c-8afc-d7bde7133415",
                                "sense_id": "292452d7-343d-3ce7-bd5c-69a68bbd9709",
                                "text": "„Auch das Betreiben von Kotbeutelspendern sei keine kommunale Aufgabe.“"
                            },
                            {
                                "example_id": "284eac51-0a4f-4731-b21f-962416b0481a",
                                "sense_id": "292452d7-343d-3ce7-bd5c-69a68bbd9709",
                                "text": "„Die Hundesteuer halte sie unter anderem für sinnvoll, um die Straßen sauber zu halten. „Und trotzdem stehen in Dransfeld nicht genügend Kotbeutelspender“, sagt sie.“"
                            },
                            {
                                "example_id": "887eb255-4313-4304-b2e5-3c780013c004",
                                "sense_id": "292452d7-343d-3ce7-bd5c-69a68bbd9709",
                                "text": "„Immerhin, der Umweltbetrieb hat zwei Kotbeutelspender aufgestellt und befüllt sie auch regelmäßig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
