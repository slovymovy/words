                                    {
                                        "sense_id": "3dcf8d88-09ed-33e1-b6db-ebae20ddd425",
                                        "entry_id": "c0802c69-aa84-3234-b2c6-75cade8e4b1a",
                                        "glosses": [
                                            "christliche Musik der Afroamerikaner, die sich in verschiedene Stilrichtungen aufgliedert"
                                        ],
                                        "tags": [
                                            "Religion, Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d024d04-668d-4561-b1dd-7b2272637e8b",
                                                "sense_id": "3dcf8d88-09ed-33e1-b6db-ebae20ddd425",
                                                "text": "Meine Mutter hört gerne Gospel, ich kann damit aber nichts anfangen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8bbbfc3-8f4d-3f9b-ba80-b9714d28a41c",
                                        "entry_id": "c0802c69-aa84-3234-b2c6-75cade8e4b1a",
                                        "glosses": [
                                            "bestimmtes Lied, das der gleichnamigen Musikrichtung zuzuordnen ist"
                                        ],
                                        "tags": [
                                            "Religion, Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "721f5529-f778-4225-91a8-934f2584dbb5",
                                                "sense_id": "e8bbbfc3-8f4d-3f9b-ba80-b9714d28a41c",
                                                "text": "Wir werden am Schluss noch ein Gospel spielen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
