{
    "word_family": [
        "inky",
        "inkwell",
        "inkpot",
        "inkpad",
        "inkstand",
        "inkblot",
        "inkjet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9af62066-01c1-3f4f-949a-f668f31e43de",
                    "sense_definition": "A pigment-based fluid used for writing, printing, or drawing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "writing_fluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure this official form is filled out in blue <w>ink</w> only.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что эта официальная форма заполнена только синими <w>чернилами</w>.",
                                "zh": "请确保这份正式表格仅用蓝色<w>墨水</w>填写。"
                            }
                        },
                        {
                            "text": "The artist used a special waterproof <w>ink</w> to create the detailed drawing.",
                            "target_lang_translations": {
                                "ru": "Художник использовал специальные водостойкие <w>чернила</w> для создания детального рисунка.",
                                "zh": "艺术家使用了一种特殊的防水<w>墨水</w>来创作这幅精细的画作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blue ink",
                        "black ink",
                        "pen and ink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красящая жидкость, используемая для письма, печати или рисования.",
                        "zh": "用于书写、印刷或绘画的颜料液体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернила",
                                "target_lang_sense_clarification": "жидкость для письма"
                            },
                            {
                                "target_lang_word": "краска",
                                "target_lang_sense_clarification": "для принтера или печати"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "墨水",
                                "target_lang_sense_clarification": "书写或绘画用的液体"
                            },
                            {
                                "target_lang_word": "油墨",
                                "target_lang_sense_clarification": "印刷用的颜料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "154609de-4e83-3dc8-a888-4104a8889bc7",
                    "sense_definition": "The dark fluid ejected by creatures like squid or octopuses as a defense mechanism.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_fluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened octopus released a cloud of <w>ink</w> to confuse the predator.",
                            "target_lang_translations": {
                                "ru": "Испуганный осьминог выпустил облако <w>чернил</w>, чтобы запутать хищника.",
                                "zh": "受惊的章鱼喷出一团<w>墨汁</w>以迷惑捕食者。"
                            }
                        },
                        {
                            "text": "Squid <w>ink</w> is sometimes used as a natural food coloring in pasta dishes.",
                            "target_lang_translations": {
                                "ru": "Чернила <w>кальмара</w> иногда используются в качестве натурального пищевого красителя в блюдах из пасты.",
                                "zh": "乌贼<w>墨汁</w>有时被用作意大利面食中的天然食用色素。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "squid ink",
                        "octopus ink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темная жидкость, выбрасываемая такими существами, как кальмары или осьминоги, в качестве защитного механизма.",
                        "zh": "乌贼或章鱼等生物为防御而喷出的深色液体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернила",
                                "target_lang_sense_clarification": "защитная жидкость моллюсков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "墨汁",
                                "target_lang_sense_clarification": "头足类动物分泌的防御性液体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eccfb73e-b17e-344d-b6db-052c204c9c4e",
                    "sense_definition": "Tattoo work or the act of getting a tattoo.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tattooing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the studio yesterday to get some new <w>ink</w> on his arm.",
                            "target_lang_translations": {
                                "ru": "Вчера он ходил в студию, чтобы набить новую <w>тату</w> на руке.",
                                "zh": "他昨天去了工作室，在手臂上<w>纹</w>了新的图案。"
                            }
                        },
                        {
                            "text": "She has some impressive <w>ink</w> covering her entire back.",
                            "target_lang_translations": {
                                "ru": "У нее впечатляющие <w>татуировки</w> на всю спину.",
                                "zh": "她整个背部都有令人印象深刻的<w>纹身</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "paint"
                    ],
                    "common_phrases": [
                        "get some ink"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in the context of tattoo culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Татуировка или процесс нанесения татуировки.",
                        "zh": "纹身或纹身的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тату",
                                "target_lang_sense_clarification": "разговорное обозначение татуировки"
                            },
                            {
                                "target_lang_word": "татуировка",
                                "target_lang_sense_clarification": "рисунок на теле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纹身",
                                "target_lang_sense_clarification": "皮肤上的刺青"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "250868ae-f267-30fd-baed-4aceb3059799",
                    "sense_definition": "Media coverage or publicity in newspapers and magazines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new startup has been getting a lot of <w>ink</w> in the business journals lately.",
                            "target_lang_translations": {
                                "ru": "В последнее время новый стартап получает много <w>внимания прессы</w> в деловых журналах.",
                                "zh": "这家初创公司最近在商业期刊上获得了不少<w>媒体报道</w>。"
                            }
                        },
                        {
                            "text": "The politician's controversial comments generated a significant amount of <w>ink</w> across the country.",
                            "target_lang_translations": {
                                "ru": "Противоречивые комментарии политика вызвали волну <w>публикаций</w> по всей стране.",
                                "zh": "这位政客的争议性言论在全国范围内引发了大量的<w>版面</w>报道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ballyhoo",
                        "hoopla",
                        "hype",
                        "plug",
                        "spotlight"
                    ],
                    "common_phrases": [
                        "get ink"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in journalism and media contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освещение в прессе или публичность в газетах и журналах.",
                        "zh": "在报纸和杂志上的媒体报道或宣传。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внимание прессы",
                                "target_lang_sense_clarification": "публикации в СМИ"
                            },
                            {
                                "target_lang_word": "освещение в печати",
                                "target_lang_sense_clarification": "упоминания в газетах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "媒体报道",
                                "target_lang_sense_clarification": "在报刊上的曝光度"
                            },
                            {
                                "target_lang_word": "版面",
                                "target_lang_sense_clarification": "指代在报刊上获得的关注"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72d6fba7-338a-3b52-8582-17310fa0331e",
                    "sense_definition": "To apply ink to a surface or to smear something with ink.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer must <w>ink</w> the rollers thoroughly before starting the press.",
                            "target_lang_translations": {
                                "ru": "Печатник должен тщательно <w>смазать чернилами</w> валики перед запуском пресса.",
                                "zh": "印刷工在启动印刷机前必须将滚筒彻底<w>上墨</w>。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>ink</w> your fingers while changing the cartridge.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>испачкать</w> пальцы чернилами при замене картриджа.",
                                "zh": "更换墨盒时要小心，别让手指<w>沾上</w>墨水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ink the plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить чернила на поверхность или пачкать что-либо чернилами.",
                        "zh": "在表面涂抹墨水或弄脏某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смазывать чернилами",
                                "target_lang_sense_clarification": "наносить краску"
                            },
                            {
                                "target_lang_word": "пачкать чернилами",
                                "target_lang_sense_clarification": "загрязнять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上墨",
                                "target_lang_sense_clarification": "在印刷辊上涂抹油墨"
                            },
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "被墨水沾染"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "717c8dbb-dcc3-3024-90ca-b81858cd6f26",
                    "sense_definition": "To sign a formal agreement or contract.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companies are expected to <w>ink</w> a deal by the end of the week.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что две компании <w>подпишут</w> соглашение до конца недели.",
                                "zh": "预计两家公司将在本周末前<w>签署</w>协议。"
                            }
                        },
                        {
                            "text": "The star player finally decided to <w>ink</w> a new five-year contract with the team.",
                            "target_lang_translations": {
                                "ru": "Звездный игрок наконец решил <w>подписать</w> новый пятилетний контракт с командой.",
                                "zh": "这位明星球员最终决定与球队<w>签署</w>一份新的五年合同。"
                            }
                        }
                    ],
                    "synonyms": [
                        "endorse",
                        "initial",
                        "subscribe"
                    ],
                    "common_phrases": [
                        "ink a deal",
                        "ink a contract"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in sports and business journalism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подписать официальное соглашение или контракт.",
                        "zh": "签署正式协议或合同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подписывать",
                                "target_lang_sense_clarification": "ставить подпись на контракте"
                            },
                            {
                                "target_lang_word": "скреплять подписью",
                                "target_lang_sense_clarification": "официально заключать сделку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "签署",
                                "target_lang_sense_clarification": "正式签订合同"
                            },
                            {
                                "target_lang_word": "签约",
                                "target_lang_sense_clarification": "达成协议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa2e5441-bf4e-3dfe-af4f-fd53c260bda3",
                    "sense_definition": "To give someone a tattoo.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tattooing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist spent four hours <w>inking</w> the complex design onto his client's shoulder.",
                            "target_lang_translations": {
                                "ru": "Художник потратил четыре часа, <w>набивая</w> сложный рисунок на плечо клиента.",
                                "zh": "艺术家花了四个小时将复杂的图案<w>纹</w>在客户的肩膀上。"
                            }
                        },
                        {
                            "text": "He decided to <w>ink</w> a small bird on his wrist to remember his travels.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>набить</w> маленькую птичку на запястье в память о своих путешествиях.",
                                "zh": "他决定在手腕上<w>纹</w>一只小鸟来纪念他的旅行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ink a tattoo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Specific to the tattoo industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать кому-либо татуировку.",
                        "zh": "给某人纹身。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набивать тату",
                                "target_lang_sense_clarification": "процесс нанесения татуировки"
                            },
                            {
                                "target_lang_word": "татуировать",
                                "target_lang_sense_clarification": "наносить рисунок иглой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纹",
                                "target_lang_sense_clarification": "刺青动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}