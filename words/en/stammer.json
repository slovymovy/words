{
    "word_family": [
        "stammerer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08dfb7b1-09fe-38aa-b77f-012f5c32df00",
                    "sense_definition": "To involuntarily repeat sounds or syllables while speaking",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tends to <w>stammer</w> when he is nervous or under pressure.",
                            "target_lang_translations": {
                                "cs": "Má tendenci <w>koktat</w>, když je nervózní nebo pod tlakem."
                            }
                        },
                        {
                            "text": "Many children <w>stammer</w> for a short time while they are learning to talk.",
                            "target_lang_translations": {
                                "cs": "Mnoho dětí po krátkou dobu <w>koktá</w>, zatímco se učí mluvit."
                            }
                        }
                    ],
                    "synonyms": [
                        "stutter",
                        "falter"
                    ],
                    "antonyms": [
                        "articulate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nedobrovolné opakování zvuků nebo slabik během mluvení"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "koktat",
                                "target_lang_sense_clarification": "běžný výraz pro poruchu plynulosti řeči"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "638bf3e2-e301-35be-b24e-f687f53584d2",
                    "sense_definition": "To speak with difficulty or hesitation due to nervousness or fear",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>stammered</w> an apology when she realized she had made a mistake.",
                            "target_lang_translations": {
                                "cs": "Když si uvědomila, že udělala chybu, <w>zajíkavě</w> se omluvila."
                            }
                        },
                        {
                            "text": "He <w>stammered</w> through his presentation because he was so afraid of the audience.",
                            "target_lang_translations": {
                                "cs": "Svou prezentaci <w>prokoktal</w>, protože se tak bál publika."
                            }
                        }
                    ],
                    "synonyms": [
                        "falter",
                        "hesitate"
                    ],
                    "antonyms": [
                        "articulate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mluvit s obtížemi nebo váháním kvůli nervozitě či strachu"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zajíkat se",
                                "target_lang_sense_clarification": "mluvit přerývaně vlivem silných emocí"
                            },
                            {
                                "target_lang_word": "koktat",
                                "target_lang_sense_clarification": "přeneseně mluvit nesouvisle kvůli nervozitě"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14eb6d21-f1c8-3511-9a30-09f661f9434b",
                    "sense_definition": "The involuntary repetition of sounds or syllables during speech",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with a slight <w>stammer</w> that became more noticeable when he was tired.",
                            "target_lang_translations": {
                                "cs": "Mluvil s mírným <w>koktáním</w>, které bylo patrnější, když byl unavený."
                            }
                        },
                        {
                            "text": "She tried to hide her <w>stammer</w> by speaking very slowly.",
                            "target_lang_translations": {
                                "cs": "Snažila se své <w>koktání</w> skrýt tím, že mluvila velmi pomalu."
                            }
                        }
                    ],
                    "synonyms": [
                        "stutter"
                    ],
                    "antonyms": [
                        "articulate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nedobrovolné opakování zvuků nebo slabik při řeči"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "koktání",
                                "target_lang_sense_clarification": "podstatné jméno označující poruchu řeči"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bebb5aea-c081-3a1d-a8a7-90136f3bb6cf",
                    "sense_definition": "A surname of German origin",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The professor's last name is <w>Stammer</w>.",
                            "target_lang_translations": {
                                "cs": "Profesorovo příjmení je <w>Stammer</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Stammer</w> is a well-known researcher in the field of linguistics.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Stammer</w> je známý výzkumník v oboru lingvistiky."
                            }
                        }
                    ],
                    "traits": [
