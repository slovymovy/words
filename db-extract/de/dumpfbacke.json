                "senses": [
                    {
                        "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                        "entry_id": "a7566c3c-56ac-33af-ad07-ff10594d08bc",
                        "glosses": [
                            "naive, törichte und dumme Person, die es an jeglichem Einfühlungsvermögen gegenüber Mitmenschen fehlen lässt"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "9f57a8b4-c33f-411b-8c6a-afad8e3d440d",
                                "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                "text": "„Mit drastischen Worten haben die Bundesminister Steinmeier und Schäuble vor Stimmungsmache mit den Ängsten der Bürger gewarnt. Steinmeier bezeichnete dies als „geistige Brandstiftung“. Sein Kabinettskollege warnte vor dem Wetteifern mit „Dumpfbacken“.“"
                            },
                            {
                                "example_id": "84dcd6e1-49d1-4317-b95d-40033bae026e",
                                "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                "text": "Du bist eine Dumpfbacke!"
                            },
                            {
                                "example_id": "160351c1-aac6-48df-8018-32e7da195bfb",
                                "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                "text": "„Jene Dumpfbacken, die von den Tribünen in Gelsenkirchen aus den dunkelhäutigen Hertha-Verteidiger Jordan Torunarigha mit Affenlauten bedachten, sollten einen Blick ins Grundgesetz werfen. Sie brauchen nicht mal weiter als Artikel 3 zu lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
