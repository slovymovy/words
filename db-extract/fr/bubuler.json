                                "example_id": "dd571fb5-45d5-45a6-9e2c-9aa4231eda33",
                                "sense_id": "3e3b70ce-662b-32a6-a79b-02244e0b30a5",
                                "text": "Au loin, un hibou bubula."
                            }
                        ]
