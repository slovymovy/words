                                        "entry_id": "3e75ec3c-ee77-3bb3-822e-8fb5097ff5cd",
                                        "glosses": [
                                            "nicht in eine Umlaufbahn gelangend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d63886-af62-4e60-a18c-83e3f73b7d46",
                                                "sense_id": "b76f82a6-d066-3677-b248-f75fc1123716",
                                                "text": "„Ein suborbitaler Flug beschreibt eine Flugbahn, bei der ein Fluggerät eine große Flughöhe erreicht, aber nicht in eine Umlaufbahn gelangt.“"
                                            },
                                            {
                                                "example_id": "307a1ed7-1c15-44f2-8ba3-3e474b992e49",
                                                "sense_id": "b76f82a6-d066-3677-b248-f75fc1123716",
                                                "text": "„In ferner Zukunft sei es mit den suborbitalen Fliegern vielleicht sogar möglich, in eineinhalb Stunden von Hamburg nach New York zu reisen […].“"
                                            },
                                            {
                                                "example_id": "342b8cb9-8a20-4f7c-a773-cf58fcd19dab",
                                                "sense_id": "b76f82a6-d066-3677-b248-f75fc1123716",
                                                "text": "„Das Raumschiff Spaceship Two seines Unternehmens Virgin Galactic hat am Samstag erstmals von seinem Startplatz für Weltraumtouristen in New Mexico aus einen kurzen suborbitalen Testflug absolviert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
