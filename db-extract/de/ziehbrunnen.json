                "senses": [
                    {
                        "sense_id": "c8f65408-4d38-3381-b00c-b9fe5e2bc9a5",
                        "entry_id": "8671743e-f588-38ea-bc8c-8ccb99e9089d",
                        "glosses": [
                            "Brunnen mit einer Vorrichtung, um Wasser in einem Behältnis aus der Tiefe heraufzuziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "793861c9-b53d-4690-bc0f-657db1e50f1c",
                                "sense_id": "c8f65408-4d38-3381-b00c-b9fe5e2bc9a5",
                                "text": "„Da war zunächst einmal der Ziehbrunnen, ein steinernes Rund mit einem schwarzen Loch, in dem es tief unten aufblinkte, wenn der Eimer an der langen Leine den Spiegel zerschmetterte, um mit klarem, eisenhaltig schmeckendem Wasser wieder nach oben gezogen zu werden.“"
                            },
                            {
                                "example_id": "bdb5564c-dfa3-4926-86ed-fbb0aff25b66",
                                "sense_id": "c8f65408-4d38-3381-b00c-b9fe5e2bc9a5",
                                "text": "„Im Garten gab es einen gemauerten Ziehbrunnen, aus dem man Wasser schöpfen, und sich über eine primitive, aber gut funktionierende Installation duschen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
