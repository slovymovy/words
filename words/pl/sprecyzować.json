    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "422c2f71-53b7-3ba0-8d38-0c928742b793",
                    "sense_definition": "wyjaśnić coś dokładnie, podać szczegóły lub doprecyzować wypowiedź",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wyjaśnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz <w>sprecyzować</w> swoje oczekiwania, zanim zaczniemy współpracę.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>уточнить</w> свои ожидания, прежде чем мы начнем сотрудничество."
                            }
                        },
                        {
                            "text": "Proszę, <w>sprecyzuj</w> swoje stanowisko w tej sprawie, abyśmy mogli podjąć decyzję.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>уточни</w> свою позицию по этому вопросу, чтобы мы могли принять решение."
                            }
                        }
                    ],
                    "synonyms": [
                        "doprecyzować",
                        "wyjaśnić",
                        "określić"
                    ],
                    "common_phrases": [
                        "sprecyzować oczekiwania",
                        "sprecyzować stanowisko"
                    ],
                    "target_lang_definitions": {
                        "ru": "изложить что-либо более точно, предоставить детали или уточнить высказывание"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уточнить",
                                "target_lang_sense_clarification": "сделать более точным, ясным"
                            },
                            {
                                "target_lang_word": "конкретизировать",
                                "target_lang_sense_clarification": "придать чему-либо конкретный характер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f5e9a29-23b9-3fa5-be00-d2fd40237893",
                    "sense_definition": "aspekt dokonany od czasownika <w>precyzować</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wyjaśnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzięki tej rozmowie udało się <w>sprecyzować</w> wszystkie punkty umowy.",
                            "target_lang_translations": {
                                "ru": "Благодаря этому разговору удалось <w>уточнить</w> все пункты договора."
                            }
                        },
                        {
                            "text": "Warto <w>sprecyzować</w> cel projektu, aby uniknąć nieporozumień w zespole.",
                            "target_lang_translations": {
                                "ru": "Стоит <w>конкретизировать</w> цель проекта, чтобы избежать недопонимания в команде."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола, означающий доведение чего-либо до точности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уточнить",
                                "target_lang_sense_clarification": "совершенный вид, результат действия"
                            },
                            {
                                "target_lang_word": "определить",
                                "target_lang_sense_clarification": "установить границы или суть чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4adaccdc-9858-38f3-bd7c-b940de8f5177",
                    "sense_definition": "aspekt dokonany od czasownika <w>precyzować</w> się",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wyjaśnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z czasem jego plany na przyszłość zaczęły się <w>sprecyzować</w>.",
                            "target_lang_translations": {
                                "ru": "Со временем его планы на будущее начали <w>уточняться</w>."
                            }
                        },
                        {
                            "text": "W trakcie dyskusji nasze poglądy zaczęły się <w>sprecyzować</w>.",
                            "target_lang_translations": {
                                "ru": "В ходе дискуссии наши взгляды начали <w>уточняться</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться более точным, ясным или определенным (о планах, мыслях)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уточняться",
                                "target_lang_sense_clarification": "становиться более ясным в процессе"
                            },
                            {
                                "target_lang_word": "обретать четкость",
                                "target_lang_sense_clarification": "становиться более определенным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
