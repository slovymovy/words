                    {
                        "sense_id": "4503c083-5ccb-3334-95e6-cb9466b6ee19",
                        "entry_id": "82d3057a-bc19-3ef9-ae11-d02e28a05d25",
                        "glosses": [
                            "człowiek cierpiący na histerię; taki, który ma ataki histerii"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "15431812-8dc3-3201-9bdf-4054ae157ea2",
                        "entry_id": "82d3057a-bc19-3ef9-ae11-d02e28a05d25",
                        "glosses": [
                            "człowiek reagujący zbyt gwałtownie lub taki, który jest przesadnie wrażliwy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
