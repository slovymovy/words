                "senses": [
                    {
                        "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                        "entry_id": "d66882c0-5641-37a6-a07b-79197643b725",
                        "glosses": [
                            "Person, die sich für Fußball begeistert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddeb276b-37a7-44ed-9e0f-f988e761f6e3",
                                "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                "text": "Auf dem Marktplatz versammelten sich tausende Fußballfans zum Public Viewing."
                            },
                            {
                                "example_id": "3944f784-c8be-40f0-9e31-689a7db44ee2",
                                "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                "text": "„Die Mehrheit der Fußballfans sorgt sich um den Knöchel von Schweinsteiger, die Genialität von Özil und die latente Abwehrschwäche von Boateng.“"
                            },
                            {
                                "example_id": "9dacc355-eedf-4562-85b1-8150c9920953",
                                "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                "text": "„Parteigänger Kasavubus und Fußballfans verbrüdern sich.“"
                            },
                            {
                                "example_id": "f1679a9b-200e-4c7e-a105-597cba6ef0c8",
                                "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                "text": "„Den Text dieses Rembetiko sangen alle mit wie Fußballfans ihr Vereinslied in der Kurve.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69ed10c5-4186-4e18-9a61-2d1dc94df8c1",
                        "source_entry_id": "d66882c0-5641-37a6-a07b-79197643b725",
                        "source_sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                        "source_sense_description": "Person, die sich für Fußball begeistert",
                        "target_lang_word": "supporteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supporteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e566510a-dd63-3738-a471-a08c0acc6c69",
                                        "entry_id": "9ae27c32-165a-3570-a4eb-d07a81052df2",
                                        "glosses": [
                                            "Personne qui soutient un concurrent ou une équipe, en particulier dans le domaine sportif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e626548-0806-47f7-aeb8-c01044d328d9",
                                                "sense_id": "e566510a-dd63-3738-a471-a08c0acc6c69",
                                                "text": "Les apologistes de l’astrologie font flèche de tout bois et englobent dans leur cercle de supporteurs de nombreuses personnalités incluant Jung."
                                            },
                                            {
                                                "example_id": "6a1a8961-3661-4c6b-863e-c4f5632d6f3b",
                                                "sense_id": "e566510a-dd63-3738-a471-a08c0acc6c69",
                                                "text": "Défaite 4-1 par l’Italie en match amical mercredi, la Mannschaft n’a pas rassuré ses supporteurs à trois mois de « son » Mondial."
                                            },
                                            {
                                                "example_id": "d7ff1e9e-801f-4606-8160-45b73d98fd69",
                                                "sense_id": "e566510a-dd63-3738-a471-a08c0acc6c69",
                                                "text": "« Nous allons le démolir et le reconstruire selon les normes de la Fifa, avec des installations appropriées pour assurer la sécurité des joueurs et des supporteurs », a déclaré le président de la République, Joko Widodo, à la presse, après des entretiens avec Gianni Infantino, le président de la Fifa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eadbc110-d0da-37c2-801a-1a0686cd3baf",
                                        "entry_id": "9ae27c32-165a-3570-a4eb-d07a81052df2",
                                        "glosses": [
                                            "Personne qui agit en soutien à."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "169b357e-5f86-4dbf-9ad9-46853ea2f64e",
                                                "sense_id": "eadbc110-d0da-37c2-801a-1a0686cd3baf",
                                                "text": "Un supporteur de Trump lourdement armé a été arrêté mardi dans un bureau de vote de la Caroline du Nord, d’où il avait déjà été expulsé plus tôt en journée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
