                "senses": [
                    {
                        "sense_id": "dba36b1a-14e0-3a01-8f25-43b7e617e7af",
                        "entry_id": "56d13cef-a2c8-3161-aac7-67a9c9b01040",
                        "glosses": [
                            "příslušník NKVD; enkávéďák"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c38d9d91-38b3-4416-9120-6b46f335cc89",
                                "sense_id": "dba36b1a-14e0-3a01-8f25-43b7e617e7af",
                                "text": "Ilu Polaków po wojnie zamordowali enkawudziści? Aresztowania, katorga, wywózki na wschód."
                            },
                            {
                                "example_id": "6015a48f-a9ea-46c6-9b82-96bed7e5201a",
                                "sense_id": "dba36b1a-14e0-3a01-8f25-43b7e617e7af",
                                "text": "Sanitariusz, który sprawdzał zwłoki, zorientował się, że żołnierz nadal ma puls. Nim zdołał zawołać enkawudzistów, Niemcy rozpoczęli ostrzał artyleryjski. W chaosie \"rozstrzelany\" najpierw usiadł, a potem powlókł się w stronę niemieckich linii. (…) Kiedy enkawudzistów rzucano do prawdziwej walki, jak w Stalingradzie, \"pękali\" znacznie szybciej niż zwykli frontowi żołnierze."
                            }
                        ]
                    }
                ],
