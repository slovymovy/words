                ],
                "senses": [
                    {
                        "sense_id": "4935553f-d7f7-32d7-95b8-c21a8167a2af",
                        "entry_id": "6e205f60-3844-378d-bb21-bc76856b37d1",
                        "glosses": [
                            "Très légèrement ouvert, en parlant d’une porte, d’une fenêtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e8eddaa-580e-43a0-9451-88f502ab0f55",
                                "sense_id": "4935553f-d7f7-32d7-95b8-c21a8167a2af",
                                "text": "Joséphine, la servante, était sortie de la salle. Mais il semblait que son ombre attentive y rentrât de minute en minute par la porte entrebâillée."
                            },
                            {
                                "example_id": "463531ec-79b4-4503-828f-4911be4131ba",
                                "sense_id": "4935553f-d7f7-32d7-95b8-c21a8167a2af",
                                "text": "La porte, restée entrebâillée pour maintenir un courant d’air au milieu de la nuit trop chaude, tournait légèrement sur elle-même."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "33aaaa20-e632-3dca-9595-0ada5c45e3e7",
