                                                "sense_id": "4df9b919-38f6-3786-9699-5cf6cf87852a",
                                                "text": "Well, unfortunately for you, my dearest Waggipoos, I'm much more skill than you!"
                                            },
                                            {
                                                "example_id": "39ada234-9c49-41d8-8240-35f849587edf",
                                                "sense_id": "4df9b919-38f6-3786-9699-5cf6cf87852a",
                                                "text": "This game is skill. Remember that because it's going to sound really complicated."
                                            },
                                            {
                                                "example_id": "34355aab-3886-456e-b0f6-1bdfb88eab71",
                                                "sense_id": "4df9b919-38f6-3786-9699-5cf6cf87852a",
                                                "text": "And I am skiller than you."
                                            }
                                        ]
                                    }
                                ]
                            },
