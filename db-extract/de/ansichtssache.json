                "senses": [
                    {
                        "sense_id": "981c2de5-2806-3e2f-9638-0935f998e69f",
                        "entry_id": "77eb402d-0a90-355f-9706-6d5efcf0abe2",
                        "glosses": [
                            "Möglichkeit, etwas unterschiedlich zu beurteilen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a991f799-e4df-4489-8bd2-5b67757d5932",
                                "sense_id": "981c2de5-2806-3e2f-9638-0935f998e69f",
                                "text": "Für viele ist es eine reine Ansichtssache, welche politische Konstellation für die nächste Wahlperiode am günstigsten wäre."
                            },
                            {
                                "example_id": "d800bebe-7aa7-4597-aba0-e2a4a986e4c1",
                                "sense_id": "981c2de5-2806-3e2f-9638-0935f998e69f",
                                "text": "„Das war nun wirklich Ansichtssache.“"
                            },
                            {
                                "example_id": "7c467ee7-2438-4088-91a5-7427a7a62180",
                                "sense_id": "981c2de5-2806-3e2f-9638-0935f998e69f",
                                "text": "„Ich nehme an, das ist ewas, das man Ansichtssache nennt, dabei kommt es darauf an, von wo aus man es betrachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8731d730-ccad-312c-abf7-531145f96348",
                        "entry_id": "77eb402d-0a90-355f-9706-6d5efcf0abe2",
                        "glosses": [
                            "oft in wortwörtlicher Bedeutung: etwas, das man ansehen kann (etwa als Motto/Thema einer Ausstellung oder dergleichen)"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9595f27c-7185-49a3-8dc5-86b56866814e",
                                "sense_id": "8731d730-ccad-312c-abf7-531145f96348",
                                "text": "Beispiel für eine entsprechende Überschrift: „optische anstalten - bewegte, unbewegliche und bewegende Ansichtssachen“"
                            },
                            {
                                "example_id": "32d645c6-f2e9-4634-8753-3b913f9d5c8b",
                                "sense_id": "8731d730-ccad-312c-abf7-531145f96348",
                                "text": "„Zum 100-jährigen Jubiläum des Museums der Weltkulturen wurde ein vielfältiges Programm geboten: die Ausstellungseröffnung „Ansichtssachen zu 100 Jahren Museum der Weltkulturen“, eine Gedenkveranstaltung im Römer, die Enthüllung eines Kunstwerks von Bob Haouzous und weitere Highlights für das Publikum.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
