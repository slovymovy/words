                        "examples": [
                            {
                                "example_id": "3153e692-9d43-436d-b6ca-9cc49af416cc",
                                "sense_id": "05eac62c-dae7-35ba-858d-a7a4c1ca123e",
                                "text": "Rikka De Roy, studentenarts aan de KU Leuven, spreekt van een verzevenvoudiging in tien jaar. Was er toen sprake van een tiental diagnoses per jaar, dan zijn dat er nu een zeventigtal, zegt ze aan VTM Nieuws. Maar veel jongeren weten niet eens dat ze de ziekte hebben, omdat ze meestal ook geen klachten hebben. Maar na lange tijd is er meer kans op bijvoorbeeld een blaasontsteking, een bijbalontsteking of zelfs onvruchtbaarheid."
                            },
                            {
                                "example_id": "e5002428-3f2f-42fd-801d-4db68b993cb8",
                                "sense_id": "05eac62c-dae7-35ba-858d-a7a4c1ca123e",
                                "text": "‘Zonder behandeling kan de aandoening ernstige complicaties veroorzaken, zoals ontsteking van het baarmoederslijmvlies, de eileiders of eierstokken bij vrouwen of bijbalontsteking bij mannen’, aldus Van den Eynde."
                            }
                        ]
