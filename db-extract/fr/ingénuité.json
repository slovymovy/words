        "fr-extract.jsonl": [
            {
                "entry_id": "cd6c3397-38dc-3bac-89bf-4639a28738ec",
                "word": "ingénuité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d97f772-87c0-468f-9e4c-1c73a69a3fe9",
                        "entry_id": "cd6c3397-38dc-3bac-89bf-4639a28738ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "ingénuités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f3cb786-e10e-372c-8657-cf746695b634",
                        "entry_id": "cd6c3397-38dc-3bac-89bf-4639a28738ec",
                        "glosses": [
                            "État d’une personne née libre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07186f79-360a-44e8-9932-d2f352b9ec4c",
                                "sense_id": "1f3cb786-e10e-372c-8657-cf746695b634",
                                "text": "Neantmoins en ce Royaume il faut obtenir lettres du Prince, qui a tousjours accoustumé de restituer aux hommes de main-morte, & de servile condition, l’estat d’ingénuité, …"
                            },
                            {
                                "example_id": "7c3c3ed9-f78b-418c-bb9f-b12dfc891dff",
                                "sense_id": "1f3cb786-e10e-372c-8657-cf746695b634",
                                "text": "L’ingénuité qui s’acquiert par le port d’un anneau d'or chez les Romains, n’étoit qu’une image & une ombre d’ingénuité : ce droit d’anneau d’or ne changeoit pas l’état de l’esclave, il ne le faisoit pas libre ; mais il faisoit qu’il ressembloit à un homme libre , vivant comme un homme libre, & mourant comme un esclave."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cf9a999-611c-33d6-bffc-db762b1e6e84",
                        "entry_id": "cd6c3397-38dc-3bac-89bf-4639a28738ec",
                        "glosses": [
                            "Franchise pleine de simplicité et quelquefois mêlée de naïveté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e67d1482-c336-48ef-adca-6a645e9187ea",
                                "sense_id": "4cf9a999-611c-33d6-bffc-db762b1e6e84",
                                "text": "Vue de près, la femme réelle révoltait notre ingénuité ; il fallait qu'elle apparût reine ou déesse, et surtout n'en pas approcher."
                            },
                            {
                                "example_id": "0efd9952-8ed8-4b38-b356-f49efe77e595",
                                "sense_id": "4cf9a999-611c-33d6-bffc-db762b1e6e84",
                                "text": "Elle parlait encore qu’il l’avait attirée dans ses bras, vaincu par son ingénuité, gagné par son abandon."
                            },
                            {
                                "example_id": "62b6a201-af1c-4fb5-9930-b0a7db5709ab",
                                "sense_id": "4cf9a999-611c-33d6-bffc-db762b1e6e84",
                                "text": "C’était le temps où Alger avait la blancheur des colombes et des ingénuités, où, dans les prunelles de nos mioches, les horizons de la terre venaient se refaire une virginité."
                            }
                        ]
                    },
                    {
                        "sense_id": "c08813ae-7b96-3088-882d-a5fd2d8f0da5",
                        "entry_id": "cd6c3397-38dc-3bac-89bf-4639a28738ec",
                        "glosses": [
                            "Rôles de jeune fille naïve. On dit plutôt, aujourd’hui, ingénues."
                        ],
                        "tags": [
                            "dated",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e978e1e9-78ab-4b6b-a98b-564331c6ca81",
                                "sense_id": "c08813ae-7b96-3088-882d-a5fd2d8f0da5",
                                "text": "Sa femme, âgée de dix-sept ans, joue les ingénuités et les jeunes premières dans la comédie et les premières amoureuses dans l’opéra."
                            },
                            {
                                "example_id": "d83baea8-d052-492b-9aed-c4eee1131292",
                                "sense_id": "c08813ae-7b96-3088-882d-a5fd2d8f0da5",
                                "text": "Elle avait un talent inimitable dans les ingénuités, un naturel rare ; ses accents naïfs excitaient le rire, sa voix touchante faisait fondre en larmes dans le drame."
                            },
                            {
                                "example_id": "73e372ee-c64f-42f2-a6a3-f4d01805abc9",
                                "sense_id": "c08813ae-7b96-3088-882d-a5fd2d8f0da5",
                                "text": "Mme Valmore, moins bien douée du côté de la figure que Mlle Mars, avait une voix pleine de charme et de sensibilité. Elle avait aussi joué l’emploi des ingénuités ; mais élevée à l’air libre, n’ayant passé à l’école que le temps d’épeler ses lettres, sa nature naïve n’avait point subi les entraves de l’éducation d’un pensionnat ( j’allais dire l’hypocrisie )."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de9c346b-21d7-4953-9d25-92c122201732",
                        "source_entry_id": "cd6c3397-38dc-3bac-89bf-4639a28738ec",
                        "target_lang_word": "Arglosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arglosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed19856-2287-3f82-9e36-883304a434d7",
                                        "entry_id": "39db0b02-2fd6-32be-ac07-186459a1beed",
                                        "glosses": [
                                            "argloses Wesen von etwas oder jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "970fd7a9-9477-4ee0-916c-d55c256098f1",
                                                "sense_id": "1ed19856-2287-3f82-9e36-883304a434d7",
                                                "text": "Die Frage, die der Inquisitor ihr stellte, war von scheinbarer Arglosigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f10baf7-a3b7-37db-a900-48829800f9ea",
                                        "entry_id": "39db0b02-2fd6-32be-ac07-186459a1beed",
                                        "glosses": [
                                            "Zustand eines Menschen, der davon ausgeht, dass ihm nichts Schlimmes widerfahren werde, und der sich insbesondere keines Angriffes auf ihn versieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eea0d09-aacd-4650-80d1-498593ae9850",
                                                "sense_id": "1f10baf7-a3b7-37db-a900-48829800f9ea",
                                                "text": "Die Arglosigkeit deiner Schwester wird sie irgendwann ins Verderben führen."
                                            },
                                            {
                                                "example_id": "5833628f-c924-41f9-9711-a48ab6913348",
                                                "sense_id": "1f10baf7-a3b7-37db-a900-48829800f9ea",
                                                "text": "„Es gibt auf der Welt eine ganze Reihe Mütter von diesem Schlag, alle anständig und mit sämtlichen Tugenden gesegnet; da die erste von ihnen die Arglosigkeit ist, werden sie fast alle das Opfe des Vertrauens, das sie jedem entgegenbringen, der ihnen einen rechtschaffenen Eindruck macht.“"
                                            },
                                            {
                                                "example_id": "635edfa1-1e4d-4c85-a643-f3eca9b5931a",
                                                "sense_id": "1f10baf7-a3b7-37db-a900-48829800f9ea",
                                                "text": "Heimtücke wird vielfach als Ausnutzung der auf Arglosigkeit beruhenden Wehrlosigkeit des Opfers in feindlicher Willensrichtung definiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b448dd5-41ac-4c94-8398-f21ad0568cdb",
                        "source_entry_id": "cd6c3397-38dc-3bac-89bf-4639a28738ec",
