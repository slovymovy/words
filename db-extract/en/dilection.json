                        "examples": [
                            {
                                "example_id": "faed85c9-3808-4eb5-a13b-ac3cfa4d0bd9",
                                "sense_id": "4c0be5c4-f0ee-37ce-a08a-14adeb498a42",
                                "text": "1554, Dr. Martin [ Stephen Gardiner? ], Treatise on the Marriage of Priestes\nThese words mine, and thine, proceeded first of iniquitie, because men did not observe mutual and natural dilection."
                            },
                            {
                                "example_id": "fff311d3-0bb2-4966-be4a-f1abfcb9f992",
                                "sense_id": "4c0be5c4-f0ee-37ce-a08a-14adeb498a42",
                                "text": "And this was the first testimony of the infinite dilection of God towards man."
                            },
                            {
                                "example_id": "f33f6f62-c317-44b5-a057-1e478a2328be",
                                "sense_id": "4c0be5c4-f0ee-37ce-a08a-14adeb498a42",
                                "text": "A bone not far from his heart, to put him in mind of dilection and love to the woman."
                            },
                            {
                                "example_id": "f0275eea-f893-4704-b24f-816317393304",
                                "sense_id": "4c0be5c4-f0ee-37ce-a08a-14adeb498a42",
                                "text": "So free is Christ's dilection, that the grand condition of our felicity is our belief."
                            }
                        ]
                    },
