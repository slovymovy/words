                    {
                        "translation_id": "6ef183bc-2a41-48cd-a389-c6531a8e903d",
                        "source_entry_id": "23a89612-5687-3525-b322-1904d18506eb",
                        "source_sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                        "target_lang_word": "Dichterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dichterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                        "entry_id": "6790c659-4ce2-3213-83c5-2d5d43f9b24f",
                                        "glosses": [
                                            "weibliche Person, die sprachlich kunstvolle Werke verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c396530b-3604-44c7-b50e-91d1273dc89b",
                                                "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                                "text": "„Die Dichterin war auf einen Schlag berühmt geworden.“"
                                            },
                                            {
                                                "example_id": "4e2ffe77-2917-4f92-9fd4-03fff8cfb51a",
                                                "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                                "text": "„Die jüdische Dichterin war aus ihrem Heimatland gejagt worden und hielt nun das Zerbrechen der Welt in Versen fest.“"
                                            },
                                            {
                                                "example_id": "23fb6d14-a89c-413d-bf1f-4e0fb6375f72",
                                                "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                                "text": "„Er stellt Murdoch als eine Dichterin dar, die ein typisches Produkt aus anderen sei, aus Personen ihrer Umgebung in Oxford und in London.“"
                                            },
                                            {
                                                "example_id": "9c9db88c-ed39-40ab-a045-6de93f309bc4",
                                                "sense_id": "78570f54-da28-3a2a-b53e-c8cf78132908",
                                                "text": "„Die Liebe ist eine große Dichterin, der Stoff geht ihr nie aus; wenn sie aber nie zum erstrebten Ziel gelangt, wird sie abgestanden wie der Teig beim Bäcker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c257128c-ff78-484f-9a2c-199c54c27129",
                        "source_entry_id": "23a89612-5687-3525-b322-1904d18506eb",
                        "source_sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                        "target_lang_word": "dichteres",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dichteres",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0c09e8d6-2d8c-3db9-ba8e-f1705fa72115",
                                        "entry_id": "285f38df-9f0c-3a63-9669-e46b2c56cf3c",
                                        "glosses": [
                                            "vrouwelijker dichter"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce66066a-61e6-4471-a072-6cc38dd8aa3f",
                                                "sense_id": "0c09e8d6-2d8c-3db9-ba8e-f1705fa72115",
                                                "text": "Amerikaanse onderzoekers hebben berekend in welk seizoen de Griekse lyrische dichteres Sappho haar gedicht Middernacht schreef. Sappho was de grootste dichteres van de Oudheid en even beroemd als haar eerdere tegenpool Homerus."
                                            },
                                            {
                                                "example_id": "5995d7e8-bf12-4759-a37a-264aae958a60",
                                                "sense_id": "0c09e8d6-2d8c-3db9-ba8e-f1705fa72115",
                                                "text": "Ze had een hautaine, zowel gekwetste als neerbuigende blik, alsof ze een dichteres was die zich met tegenzin onder het ongevoelige gepeupel begaf. `Frarwaise; fluisterde de grote Griek en hij keek mij aan met een veelbetekenende blik, waarvan ik niet goed wist wat die betekende."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
