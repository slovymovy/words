                ],
                "senses": [
                    {
                        "sense_id": "6b359b31-9597-3ecf-9dba-0c4ba9e258f6",
                        "entry_id": "81072bdc-710b-3389-a892-79161d431faa",
                        "glosses": [
                            "Handlung, Einstellung, gegen etwas oder jemanden Widerstand zu leisten; Empörung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd58888-0c91-454d-99ab-07b4dd57af51",
                                "sense_id": "6b359b31-9597-3ecf-9dba-0c4ba9e258f6",
                                "text": "„In einem Akt der Auflehnung hatten die beiden auf einem Regime-Fest mit dieser Pose die Protesthymne ‚Wandel‘ der spätsowjetischen Band Kino gespielt (und wurden danach zu je zehn Tagen Arrest verurteilt).“"
                            },
                            {
                                "example_id": "9c961830-86cb-4cd4-8ca1-77f05740f73a",
                                "sense_id": "6b359b31-9597-3ecf-9dba-0c4ba9e258f6",
                                "text": "„So hebt sie zwar immer wieder hervor, weder ‚Krawall und Mobilmachung‘, sondern nur ‚Revolution‘, die Auflehnung gegen ein als korrumpiert empfundenes Gesellschaftssystem gewollt zu haben.“"
                            },
                            {
                                "example_id": "2577072c-d223-4b46-a34b-3758b649f84d",
                                "sense_id": "6b359b31-9597-3ecf-9dba-0c4ba9e258f6",
                                "text": "„Ein Aufheulen ist nicht zu hören, von Widerstand und Auflehnung keine Spur.“"
                            },
                            {
                                "example_id": "afb47f8b-a286-4ccb-80e8-6d3efb7e7885",
                                "sense_id": "6b359b31-9597-3ecf-9dba-0c4ba9e258f6",
                                "text": "„Anschaulich und fesselnd erzählt Eva Pankok, die im Rollstuhl sitzt, aber mit fester Stimme und hochkonzentriert 60 Minuten frei vor den gut 100 Zuhörern spricht, von ihren kleinen Auflehnungen gegen das Regime.“"
                            },
                            {
                                "example_id": "e39852e3-ebdf-4baf-b64b-468c01049e02",
                                "sense_id": "6b359b31-9597-3ecf-9dba-0c4ba9e258f6",
                                "text": "„Es gab viele Auflehnungen westlicher Länder gegen die Ideen der Amerikanischen und der Französischen Revolution, geboren aus dem Geist des Nationalismus, der in vieler Hinsicht selbst ein Phänomen der westlichen Moderne war, darunter die radikalste dieser Auflehnungen, die deutsche, die im Nationalsozialismus gipfelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
