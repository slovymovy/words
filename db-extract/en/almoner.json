                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a180deab-5613-4c20-9569-2ef08030dc73",
                                                "sense_id": "f77db4df-0bc3-3c5d-9ce4-6fb77ec607b5",
                                                "text": "Opaci tego klasztoru byli jałmużnikami królów portugalskich"
