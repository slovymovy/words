                                        "sense_id": "b26a7865-ec36-32d7-9a07-f2a666761307",
                                        "entry_id": "cee138dc-571b-3b04-a266-bbe337b01be7",
                                        "glosses": [
                                            "In a voluntary manner."
                                        ],
