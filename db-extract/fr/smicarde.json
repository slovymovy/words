                        "examples": [
                            {
                                "example_id": "0bdc1f74-e032-4dcf-a262-9c7b5ed46a3f",
                                "sense_id": "eb70f380-4d33-35b4-9887-3fdda4212d70",
                                "text": "Heureux hasard, Alain partait juste pour une longue virée asiatique en compagnie de MarieCath, la séduisante smicarde du tourisme qui depuis plusieurs mois le dorlotait dans sa chambre sous les toits rue Chapon."
                            },
                            {
                                "example_id": "1e2060a5-ba57-44ab-9291-f500dea8c8dc",
                                "sense_id": "eb70f380-4d33-35b4-9887-3fdda4212d70",
                                "text": "Aujourd’hui 2,5 millions de personnes, soit plus d’un salarié sur six, sont smicardes : deux fois plus qu’en 1994."
                            }
                        ]
                    }
