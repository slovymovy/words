                                "sense_id": "a1f3d02c-21d7-3437-8a09-cd5728d946aa",
                                "text": "Ruhe ist die erste Bürgerpflicht",
                                "translation": "keep calm and carry on",
                                "english": "keep calm and carry on"
                            },
                            {
                                "example_id": "eedb3ae7-947f-49f6-89e6-a21b3015129b",
                                "sense_id": "a1f3d02c-21d7-3437-8a09-cd5728d946aa",
                                "text": "Der Schutz jüdischen Leben^([sic]) ist Staatsaufgabe, aber auch Bürgerpflicht. Attacken auf jüdische Synagogen sind keine Zeichen von Freiheit^([sic]) sie sind Straftaten."
                            }
                        ]
