                    }
                ],
                "senses": [
                    {
                        "sense_id": "97a24a68-a516-3a21-b455-e5f0717e6df6",
                        "entry_id": "4bfbfc2a-cd12-30a7-ac8c-5a04bde11843",
                        "glosses": [
                            "aus Wolle bestehende Decke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3da4e6-d187-4b7b-85f1-5955022ec112",
                                "sense_id": "97a24a68-a516-3a21-b455-e5f0717e6df6",
                                "text": "„Er legte sich angezogen aufs Bett, schlug die Wolldecke um sich und versuchte, zu entspannen.“"
                            },
                            {
                                "example_id": "401d8c0b-4920-45b9-a571-ae1e7cc7a7f3",
                                "sense_id": "97a24a68-a516-3a21-b455-e5f0717e6df6",
                                "text": "„Über die Rückwand des Sofas hatte er eine gehäkelte Wolldecke drapiert.“"
                            },
                            {
                                "example_id": "92e4558d-358c-46f2-b58f-e8fe89528010",
                                "sense_id": "97a24a68-a516-3a21-b455-e5f0717e6df6",
                                "text": "„Unter der rauhen Wolldecke räkelte und reckte er sich, bäumte sich trotzig auf und schlenkerte und fitschelte übermütig hin und her.“"
                            },
                            {
                                "example_id": "c6cac5b6-4588-4d25-ab8b-d7a0c1cb8ce1",
                                "sense_id": "97a24a68-a516-3a21-b455-e5f0717e6df6",
                                "text": "„Und mit diesen Worten streckte er seine Schenkel auf die Bank, hüllte sich in seine Wolldecke und legte sich zur Ruhe.“"
                            },
                            {
                                "example_id": "378efc9e-bbae-4bd9-8cd0-6740ac84209a",
                                "sense_id": "97a24a68-a516-3a21-b455-e5f0717e6df6",
                                "text": "„In eine Wolldecke gehüllt saß Oksana da und starrte zu Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ab1afdc-865f-47c9-8bb4-c06d24e2e545",
                        "source_entry_id": "4bfbfc2a-cd12-30a7-ac8c-5a04bde11843",
                        "source_sense_id": "97a24a68-a516-3a21-b455-e5f0717e6df6",
                        "source_sense_description": "aus Wolle bestehende Decke",
                        "target_lang_word": "blanket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blanket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61d4685c-6cdf-392b-9dd0-22d6f1c46426",
                                        "entry_id": "7afe6b2e-8cf1-3f1a-8295-abc3cbb28a54",
                                        "glosses": [
                                            "A heavy, loosely woven fabric, usually large and woollen, used for warmth while sleeping or resting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6567b7ee-cddd-4488-a49f-9d365f921e99",
                                                "sense_id": "61d4685c-6cdf-392b-9dd0-22d6f1c46426",
                                                "text": "The baby was cold, so his mother put a blanket over him."
                                            },
                                            {
                                                "example_id": "ded7a33d-6e2c-4239-af1f-f9fe730e3522",
                                                "sense_id": "61d4685c-6cdf-392b-9dd0-22d6f1c46426",
                                                "text": "The little boys in the front bedroom had thrown off their blankets and lay under the sheets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d512e5a-1ae4-3ada-bfda-b52404e54866",
                                        "entry_id": "7afe6b2e-8cf1-3f1a-8295-abc3cbb28a54",
                                        "glosses": [
                                            "A covering layer of anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9adb0a9-0e39-419e-9ff1-f43cca832f23",
                                                "sense_id": "7d512e5a-1ae4-3ada-bfda-b52404e54866",
                                                "text": "The city woke under a thick blanket of fog."
                                            },
                                            {
                                                "example_id": "513ebbac-21ed-4a6b-8f4b-5895e818502d",
                                                "sense_id": "7d512e5a-1ae4-3ada-bfda-b52404e54866",
                                                "text": "In this case, the excavations were carried down to a depth of 3 ft. 9 in. below rail level, and pre-cast concrete slabs were laid between a 12 in. blanket of quarry waste and the ballast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d61858-a961-3041-84a5-76f9fcd7bfea",
                                        "entry_id": "7afe6b2e-8cf1-3f1a-8295-abc3cbb28a54",
                                        "glosses": [
                                            "A thick rubber mat used in the offset printing process to transfer ink from the plate to the paper being printed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045dce9f-adb3-41e5-b77c-1c2fae22e380",
                                                "sense_id": "20d61858-a961-3041-84a5-76f9fcd7bfea",
                                                "text": "A press operator must carefully wash the blanket whenever changing a plate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35be39cf-a79c-3660-8a97-deeeb185f4ed",
                                        "entry_id": "7afe6b2e-8cf1-3f1a-8295-abc3cbb28a54",
                                        "glosses": [
                                            "A streak or layer of blubber in whales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blanket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58874422-b202-3ed2-ad11-789ff8e1f61a",
                                        "entry_id": "8f461dbe-09c1-3368-b894-6243f839cd22",
                                        "glosses": [
                                            "General; covering or encompassing everything."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6934b45b-25d8-4596-a390-a015a00dac74",
                                                "sense_id": "58874422-b202-3ed2-ad11-789ff8e1f61a",
                                                "text": "Another observer offered a less blanket criticism."
                                            },
                                            {
                                                "example_id": "8bd75ccc-6436-4f31-b770-02ce97ab6805",
                                                "sense_id": "58874422-b202-3ed2-ad11-789ff8e1f61a",
                                                "text": "Some others appear to be adopting a more blanket approach"
                                            },
                                            {
                                                "example_id": "f4668bc7-12f6-4f97-aceb-e629a4ebad62",
                                                "sense_id": "58874422-b202-3ed2-ad11-789ff8e1f61a",
                                                "text": "Disenchanted with socialism, they unleashed free enterprise (or tried to) and backed it up with a more-or-less blanket endorsement of the old ways."
                                            },
                                            {
                                                "example_id": "5f18ba79-7c08-486c-a623-3793548525fe",
                                                "sense_id": "58874422-b202-3ed2-ad11-789ff8e1f61a",
                                                "text": "By contrast, any emotional or motivational explanation of autism would seem to predict too blanket a degree of social disinterest."
                                            },
                                            {
                                                "example_id": "e90d41a4-b22b-49bc-aedc-023a616b9533",
                                                "sense_id": "58874422-b202-3ed2-ad11-789ff8e1f61a",
                                                "text": "The second reason offered for blanket nonprosecutions for crimes committed at the megabanks involves the possibility that such prosecutions could harm the economy."
                                            },
                                            {
                                                "example_id": "dcac8e99-a441-4b2f-b3e1-658ea008792d",
                                                "sense_id": "58874422-b202-3ed2-ad11-789ff8e1f61a",
                                                "text": "Tamil Nadu Chief Minister M.K. Stalin on Friday wrote to his counterparts in Delhi, Haryana, Odisha and Rajasthan urging them to reconsider the blanket ban on sale of firecrackers in their respective States."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blanket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68827bf1-cf4b-32b7-988c-40791c7a031b",
                                        "entry_id": "6bdd8ebf-48ff-370a-84cb-684a21765c54",
                                        "glosses": [
                                            "To cover with, or as if with, a blanket."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea28a26-500f-4ea3-918a-9f04451578b4",
                                                "sense_id": "68827bf1-cf4b-32b7-988c-40791c7a031b",
                                                "text": "A fresh layer of snow blanketed the area."
                                            },
                                            {
                                                "example_id": "fc34d417-523e-4178-9617-3c37b20545e6",
                                                "sense_id": "68827bf1-cf4b-32b7-988c-40791c7a031b",
                                                "text": "[…] / I will preſerue my ſelfe, and am bethought / To take the baſeſt and moſt pooreſt ſhape, / That euer penury in contempt of man, / Brought neare to beaſt, my face ile grime with filth, / Blanket my loynes, elſe all my haire with knots, / And with preſented nakedness outface, / The wind, and perſecution of the skie, / […]"
                                            },
                                            {
                                                "example_id": "531c729b-85ef-415c-85e2-43d1ddf5a5f9",
                                                "sense_id": "68827bf1-cf4b-32b7-988c-40791c7a031b",
                                                "text": "I see the moon go off watch and the darkness begin to blanket the river."
                                            },
                                            {
                                                "example_id": "4797864f-013c-4689-a8ce-d95a6dd39cfe",
                                                "sense_id": "68827bf1-cf4b-32b7-988c-40791c7a031b",
                                                "text": "The whole world was shut away outside in blood-red glory, as he rocked in his cradle on the immaculate sea, where the warm air blanketted him above the water sheets cold below."
                                            },
                                            {
                                                "example_id": "f42507cb-34ad-4691-a5e6-a1f94066fb76",
                                                "sense_id": "68827bf1-cf4b-32b7-988c-40791c7a031b",
                                                "text": "Leaping lightly on his back he led the grateful horse in an easy canter back to the stable where he waited and watched as the stable girl rubbed him down and blanketted him."
                                            },
                                            {
                                                "example_id": "502c4202-6975-41f4-a5ee-dc6a451c2574",
                                                "sense_id": "68827bf1-cf4b-32b7-988c-40791c7a031b",
                                                "text": "The noise of the fire silenced the seabirds. Then snow blanketted the fire. Birds sang in the snow, and I awoke."
                                            },
                                            {
                                                "example_id": "8b7c3b1c-c766-49f9-b69e-3f3c4a28d094",
                                                "sense_id": "68827bf1-cf4b-32b7-988c-40791c7a031b",
                                                "text": "In another damaging twist, former Trump lawyer Jenna Ellis, who blanketed television networks after President Joe Biden’s victory to falsely claim he was elected because of fraud, reached a plea deal with Georgia prosecutors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57d9bea3-99ea-3943-b4d1-6e31bc1d596c",
                                        "entry_id": "6bdd8ebf-48ff-370a-84cb-684a21765c54",
                                        "glosses": [
                                            "To traverse or complete thoroughly."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc97f81-f8fd-4917-8f68-29c9b9c9639d",
                                                "sense_id": "57d9bea3-99ea-3943-b4d1-6e31bc1d596c",
                                                "text": "The salesman blanketed the entire neighborhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa45523-1202-3340-8b1f-8887188a42ca",
                                        "entry_id": "6bdd8ebf-48ff-370a-84cb-684a21765c54",
                                        "glosses": [
                                            "To toss in a blanket by way of punishment."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a0df50b-2048-488c-a244-8a04adec56ea",
                                                "sense_id": "afa45523-1202-3340-8b1f-8887188a42ca",
                                                "text": "Hang him, poore grogran-raſcall, pray thee thinke not of him: I’le ſend for him to my lodging, and haue him blanketted when thou wilt, man."
                                            },
                                            {
                                                "example_id": "727d0ac9-84ab-4991-9a08-55fc6fd9c023",
                                                "sense_id": "afa45523-1202-3340-8b1f-8887188a42ca",
                                                "text": "Wee'll haue our men blanket 'hem i' the hall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa4b57a-e25c-335e-b55f-369927d64ba2",
                                        "entry_id": "6bdd8ebf-48ff-370a-84cb-684a21765c54",
                                        "glosses": [
                                            "To take the wind out of the sails of (another vessel) by sailing to windward of it."
                                        ],
