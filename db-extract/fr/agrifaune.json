                "senses": [
                    {
                        "sense_id": "6d813755-d8b9-3e22-ad64-29dab7ba77fc",
                        "entry_id": "00e68751-1c5f-3bfe-80d5-c2551989fc25",
                        "glosses": [
                            "Projet national français qui vise à prôner une agriculture respectant la faune sauvage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea14e125-aa87-471e-b89c-602959e490c8",
                                "sense_id": "6d813755-d8b9-3e22-ad64-29dab7ba77fc",
                                "text": "Agrifaune est un partenariat national signé en mai 2006 entre l’Office National de la Chasse et de la Faune Sauvage (ONCFS), la Fédération nationale des Chasseurs (FNC), la Fédération Nationale des Syndicats des Exploitants Agricoles (FNSEA) et l’Assemblée Permanente des Chambres d’Agricultures (APCA). L’objectif de ce projet : animer un réseau et susciter des initiatives permettant de mieux concilier l’agriculture et la prise en compte de la faune sauvage."
                            }
                        ]
                    }
