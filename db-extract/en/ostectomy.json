                "senses": [
                    {
                        "sense_id": "fa0a2acb-31fb-3bec-8f80-469b84b4e1c0",
                        "entry_id": "274c985c-681a-3d41-a56a-1dbd289ffa3a",
                        "glosses": [
                            "Excision of all or part of a bone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4328052c-cf85-4363-b925-87bc2dddc32f",
                                "sense_id": "fa0a2acb-31fb-3bec-8f80-469b84b4e1c0",
                                "text": "femoral head ostectomy"
                            },
                            {
                                "example_id": "22202776-c1ae-4799-a4db-03b07ab319c3",
                                "sense_id": "fa0a2acb-31fb-3bec-8f80-469b84b4e1c0",
                                "text": "Bell and Levy have shown that if the blood supply to the anterior maxilla is interrupted both on its labial and palatal surfaces during ostectomies, the maxilla will undergo necrosis."
                            },
                            {
                                "example_id": "8f6cc049-c365-4b45-bcea-8540939c7af3",
                                "sense_id": "fa0a2acb-31fb-3bec-8f80-469b84b4e1c0",
                                "text": "Distal ulnar ostectomy is indicated as an early corrective surgery for premature closure of the distal ulnar physis, before the appearance of severe angular limb deformities."
                            },
                            {
                                "example_id": "034bed1c-1c75-4e01-b986-a15ed81f1e5f",
                                "sense_id": "fa0a2acb-31fb-3bec-8f80-469b84b4e1c0",
                                "text": "An alternative to transposing the nail unit onto a shortened skeleton is to reduce the nail and shorten the digit further with segmental ostectomies along the length of the digit."
                            },
                            {
                                "example_id": "30c7ffb2-3fcb-4490-98f7-c9186de1e9b4",
                                "sense_id": "fa0a2acb-31fb-3bec-8f80-469b84b4e1c0",
                                "text": "Enucleation with peripheral ostectomy is an extension of the curettage technique described above."
                            },
                            {
                                "example_id": "1d0cd44c-cd24-4924-aa4f-781a66355fe7",
                                "sense_id": "fa0a2acb-31fb-3bec-8f80-469b84b4e1c0",
                                "text": "After ulnar ostectomy, postoperative radiographs document the location and length of the ostectomy gap. A soft padded bandage or splint may be used to protect the limb for 2 weeks if bilateral procedures are done."
                            },
                            {
                                "example_id": "cc7d653f-aef7-4088-aadc-f781d7ec0e93",
                                "sense_id": "fa0a2acb-31fb-3bec-8f80-469b84b4e1c0",
                                "text": "Ostectomies of the glenoid rim and humeral head are made with and sharp osteotome, oscillating saw, or high-speed rotating burr."
                            }
                        ]
                    }
                ],
