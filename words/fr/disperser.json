            "senses": [
                {
                    "sense_id": "51794d04-ea5e-3d18-a455-f107febca213",
                    "sense_definition": "Éparpiller, répandre des choses en divers endroits.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent violent a fait <w>disperser</w> tous les papiers sur la terrasse."
                        },
                        {
                            "text": "La famille a décidé de <w>disperser</w> les cendres du défunt au sommet de la montagne."
                        }
                    ],
                    "antonyms": [
                        "rassembler",
                        "regrouper"
                    ],
                    "common_phrases": [
                        "disperser les cendres",
                        "disperser des feuilles"
                    ]
                },
                {
                    "sense_id": "4504bb93-78be-34e7-9807-fdf7e194c87c",
                    "sense_definition": "Forcer les membres d'un groupe ou d'une foule à se séparer et à fuir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation_groupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a utilisé des canons à eau pour <w>disperser</w> la foule en colère."
                        },
                        {
                            "text": "Les soldats ont réussi à <w>disperser</w> les troupes ennemies après une longue bataille."
                        }
                    ],
                    "antonyms": [
                        "rassembler",
                        "réunir"
                    ],
                    "common_phrases": [
                        "disperser la foule",
                        "disperser les manifestants"
                    ]
                },
                {
                    "sense_id": "fc37d80e-a7ad-3f80-b56f-dfcf2dcba238",
                    "sense_definition": "Consacrer son énergie ou son attention à trop de tâches diverses au lieu de se concentrer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a trop de projets en cours et finit par se <w>disperser</w> sans rien terminer."
                        },
                        {
                            "text": "Pour réussir cet examen difficile, tu dois éviter de te <w>disperser</w> inutilement."
                        }
                    ],
                    "antonyms": [
                        "concentrer"
                    ],
                    "common_phrases": [
                        "se disperser dans son travail",
                        "tendance à se disperser"
