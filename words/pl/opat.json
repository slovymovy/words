                    "sense_definition": "wyższy duchowny katolicki będący przełożonym klasztoru w niektórych zakonach męskich",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "monastic_superior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doświadczony <w>opat</w> zarządzał wszystkimi sprawami klasztoru oraz dbał o dyscyplinę wśród mnichów.",
                            "target_lang_translations": {
                                "en": "The experienced <w>abbot</w> managed all the affairs of the monastery and maintained discipline among the monks."
                            }
                        },
                        {
                            "text": "W średniowieczu <w>opat</w> klasztoru benedyktynów cieszył się dużym autorytetem w całym regionie.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, the <w>abbot</w> of the Benedictine monastery enjoyed great authority throughout the entire region."
                            }
                        }
                    ],
                    "synonyms": [
                        "abat"
                    ],
                    "common_phrases": [
                        "opat klasztoru",
                        "wybór opata"
                    ],
                    "target_lang_definitions": {
                        "en": "a senior Catholic clergyman who is the superior or head of a monastery in certain male religious orders"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abbot",
                                "target_lang_sense_clarification": "head of a monastery"
                            }
                        ]
