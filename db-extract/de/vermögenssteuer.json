                            {
                                "example_id": "9cdb7c81-7523-4d4d-a806-97daf45736f6",
                                "sense_id": "6212406a-7b1b-321f-975c-90a2d26544da",
                                "text": "„Allein eine Sonderabgabe zur Vermögenssteuer soll bis Jahresende 2,3 Milliarden Euro einbringen.“"
                            },
                            {
                                "example_id": "378c57e5-95c6-4fee-aaa7-a216041778f8",
                                "sense_id": "6212406a-7b1b-321f-975c-90a2d26544da",
                                "text": "„Zum 1. Januar 1997 wurde die Vermögenssteuer zwar nicht abgeschafft, aber sie wird einfach nicht mehr erhoben. Damit steht Deutschland unter den Industriestaaten ziemlich alleine da – und schenkt Reichen geschätzte acht Milliarden Euro im Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
