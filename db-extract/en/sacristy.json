                "entry_id": "5d5947ce-776b-3374-9ad5-5345a80210fb",
                "word": "sacristy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7232ac1c-c716-4cd0-a167-0458781a072b",
