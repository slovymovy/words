            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da331b77-188c-331b-88d0-5e8afb46f708",
                    "sense_definition": "Выборный глава государства в странах с республиканской формой правления.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Действующий <w>президент</w> выступил с обращением к народу по телевидению.",
                            "target_lang_translations": {
                                "en": "The incumbent <w>president</w> addressed the nation on television.",
                                "zh": "现任<w>总统</w>在电视上向全国发表了讲话。"
                            }
                        },
                        {
                            "text": "В следующем году в нашей стране пройдут выборы <w>президента</w>.",
                            "target_lang_translations": {
                                "en": "Next year, elections for the <w>president</w> will be held in our country.",
                                "zh": "明年我国将举行<w>总统</w>选举。"
                            }
                        }
                    ],
                    "synonyms": [
                        "первое лицо",
                        "глава государства"
                    ],
                    "common_phrases": [
                        "выборы президента",
                        "указ президента",
                        "стать президентом",
                        "президент страны"
                    ],
                    "target_lang_definitions": {
                        "en": "An elected head of state in countries with a republican form of government.",
                        "zh": "共和制国家中由选举产生的国家元首。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "president",
                                "target_lang_sense_clarification": "head of state"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总统",
                                "target_lang_sense_clarification": "国家元首"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8896a8da-2acf-34ef-a6b0-243b88691fa8",
                    "sense_definition": "Руководитель общества, объединения, крупной компании или научного учреждения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На совете директоров выступил <w>президент</w> компании с отчётом за год.",
                            "target_lang_translations": {
                                "en": "The company <w>president</w> spoke at the board meeting with the annual report.",
                                "zh": "公司<w>总裁</w>在董事会上作了年度报告。"
                            }
                        },
                        {
                            "text": "Моего отца избрали <w>президентом</w> местного шахматного клуба.",
                            "target_lang_translations": {
                                "en": "My father was elected <w>president</w> of the local chess club.",
                                "zh": "我父亲被选为当地国际象棋俱乐部的<w>会长</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "председа́тель"
                    ],
                    "common_phrases": [
                        "президент компании",
                        "президент банка",
                        "президент клуба",
                        "президент фонда"
                    ],
                    "target_lang_definitions": {
                        "en": "The head of a society, association, large company, or scientific institution.",
                        "zh": "社会团体、协会、大型企业或科研机构的负责人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "president",
