                                        "glosses": [
                                            "den US-Bundesstaat Texas betreffend, zu ihm gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b2e26f-5897-49fe-b6a1-5d53648bb656",
                                                "sense_id": "972e0c23-1cc5-3479-9f8c-20232fd9e61b",
                                                "text": "„Vor noch nicht einmal zehn Jahren hatte eine mittelständische texanische Ölgesellschaft den Fund gemacht - Anson Energy, mittlerweile ein Gigant, selbst nach Maßstäben der amerikanischen Energiewirtschaft.“"
                                            },
                                            {
                                                "example_id": "a55badcc-99fb-497d-942c-40197a5696b5",
                                                "sense_id": "972e0c23-1cc5-3479-9f8c-20232fd9e61b",
                                                "text": "„Er sprach mit deutlichem texanischem Einschlag.“"
                                            },
                                            {
                                                "example_id": "5e88b5fb-6b3f-4b8b-af9d-6e181c305004",
                                                "sense_id": "972e0c23-1cc5-3479-9f8c-20232fd9e61b",
                                                "text": "„Hinter ihnen leckten die Flammen an der oberen Hotelecke empor, dunkle Rauchwolken stiegen in den warmen texanischen Morgen.“"
                                            },
                                            {
                                                "example_id": "28a36978-7b61-4fea-8359-5e1e225b002b",
                                                "sense_id": "972e0c23-1cc5-3479-9f8c-20232fd9e61b",
                                                "text": "„Und die Kunstsammlerin hatte einen texanischen Akzent, als sie den Mund aufmachte.“"
                                            }
