                    "frequency": "High",
                    "semantic_group_id": "conservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces de police veillent constamment au <w>maintien</w> de l'ordre dans le centre de la ville."
                        },
                        {
                            "text": "Le médecin recommande le <w>maintien</w> du traitement médical jusqu'à la disparition complète des symptômes."
                        }
                    ],
                    "synonyms": [
