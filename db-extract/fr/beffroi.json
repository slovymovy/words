        "fr-extract.jsonl": [
            {
                "entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                "word": "beffroi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9048734-4b9d-4bbe-994f-1177a3a98c9b",
                        "entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                        "tags": [
                            "plural"
                        ],
                        "form": "beffrois"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f73d3da3-dbd2-3a3b-b684-0746778adaa7",
                        "entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                        "glosses": [
                            "Édifice mobile en bois qui servait à prendre d’assaut des fortifications."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "5c780475-e417-4287-ab3a-bc0d0db987ea",
                                "sense_id": "f73d3da3-dbd2-3a3b-b684-0746778adaa7",
                                "text": "Du côté méridional, l’ennemi, […], pouvait […] faire approcher de la muraille intérieure, sur un plan incliné, un de ces beffrois de charpente, recouverts de peaux fraîches pour les garantir du feu et au moyen desquels on se jetait de plain-pied sur les chemins de ronde supérieurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "549fbc59-ef96-3f8d-8636-d06b8dc7140e",
                        "entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                        "glosses": [
                            "Tour ou clocher servant à faire le guet et où se trouvait une cloche pour sonner l’alarme, campanile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f36098-a2d9-4f6f-a7da-ce02947101ed",
                                "sense_id": "549fbc59-ef96-3f8d-8636-d06b8dc7140e",
                                "text": "Entendez-vous le canon ? Il vous rappelle celui qui retentissait si péniblement il y a un mois, et qui se mêlait à l’effrayant beffroi de Notre-Dame."
                            },
                            {
                                "example_id": "e380bebe-8e65-4907-827f-32f488915d89",
                                "sense_id": "549fbc59-ef96-3f8d-8636-d06b8dc7140e",
                                "text": "Un soir, au moment où le couvre-feu sonnait à tous les beffrois de Paris, les sergents du guet, s’il leur eût été donné d’entrer dans la redoutable cour des Miracles, auraient pu remarquer qu’il se faisait dans la taverne des truands."
                            },
                            {
                                "example_id": "8ed5f4f6-ec9f-4fe4-8b30-c632c63504f8",
                                "sense_id": "549fbc59-ef96-3f8d-8636-d06b8dc7140e",
                                "text": "C’est à Namur que Gaspard vit le premier beffroi."
                            },
                            {
                                "example_id": "6dfefd4d-ab00-4c96-97f4-8ae963142cc4",
                                "sense_id": "549fbc59-ef96-3f8d-8636-d06b8dc7140e",
                                "text": "Les révoltés du Moyen-Âge\nL’ont arboré sur maints beffrois.\nEmblème éclatant du courage,\nToujours il fit pâlir les rois."
                            }
                        ]
                    },
                    {
                        "sense_id": "8eacbf99-c94e-3637-8d96-64428c8de7e7",
                        "entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                        "glosses": [
                            "Cloche du beffroi."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "19c52d81-7fae-4f22-899a-f2ef11f826b9",
                                "sense_id": "8eacbf99-c94e-3637-8d96-64428c8de7e7",
                                "text": "On peut maintenant considérer comme Beffroi la grosse cloche de l’Église métropolitaine (Notre-Dame); on ne la sonne que dans les grandes solennités publiques, et dans des circonstances tout à fait extraordinaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd6a67a2-43d9-3676-8097-ea00336ee286",
                        "entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                        "glosses": [
                            "Charpente qui porte les cloches."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "64d5a192-0cb5-49f1-a797-11389130eaca",
                                "sense_id": "cd6a67a2-43d9-3676-8097-ea00336ee286",
                                "text": "Avant le fatal incendie qui a consumé la célèbre charpente de la cathédrale de Chartres, il y avait un beffroi qui faisait l'admiration des connaisseurs. Nous n'en possédons plus aujourd'hui que la description."
                            }
                        ]
                    },
                    {
                        "sense_id": "98ec5dfd-9bd5-318f-ad62-7301a8f10716",
                        "entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                        "glosses": [
                            "Charpente qui soutient les meules d’un moulin ; charpente de bois ou de fer qui supporte un train de laminoirs dans les forges et dans les aciéries."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "30d5fb09-9c92-4c29-b07d-8b54cea713eb",
                                "sense_id": "98ec5dfd-9bd5-318f-ad62-7301a8f10716",
                                "text": "Le beffroi d'un moulin à l'anglaise est, à proprement parler, le bali ou la partie fixe sur laquelle est assise toute la partie mobile du mécanisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9a42f2b-ec0e-3146-9f01-41863ad7443e",
                        "entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                        "glosses": [
                            "Meuble représentant le bâtiment du même nom dans les armoiries. À rapprocher de donjon, phare et tour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de049e0-63c8-4af1-a4a0-e548600d46eb",
                                "sense_id": "c9a42f2b-ec0e-3146-9f01-41863ad7443e",
                                "text": "D’azur au beffroi accompagné de quatre pattes de lion mouvant des flancs de l’écu, deux de chaque côté, l’une sur l’autre, le tout d’or, qui est de la commune de Maubec du Vaucluse → voir illustration « armoiries avec un beffroi »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46e1c405-7400-4793-a3d6-67b5a7b770f0",
                        "source_entry_id": "8c9362e2-cf06-3046-a9eb-635ba92954db",
                        "source_sense_description": "Tour ou clocher servant à faire le guet et où se trouvait une cloche pour sonner l’alarme, campanile",
                        "target_lang_word": "belfry",
