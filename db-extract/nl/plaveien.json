                                "target_senses": [
                                    {
                                        "sense_id": "6d2f83ef-f20c-3ab9-ba14-0fcfd889ce2c",
                                        "entry_id": "136a7998-2368-3c6c-a3e6-a6bb245a3aad",
                                        "glosses": [
                                            "To cover something with paving slabs."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "074f7bac-5fcb-3895-834b-f8830d007cb0",
                                        "entry_id": "136a7998-2368-3c6c-a3e6-a6bb245a3aad",
                                        "glosses": [
                                            "To cover with stone, concrete, blacktop or other solid covering, especially to aid travel."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f485ac5f-ce65-4044-99da-24ebdcf3c70e",
                                                "sense_id": "074f7bac-5fcb-3895-834b-f8830d007cb0",
                                                "text": "They paved Paradise and put up a parking lot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b80ca2b0-9404-36e2-9e60-c7cab87b9749",
                                        "entry_id": "136a7998-2368-3c6c-a3e6-a6bb245a3aad",
                                        "glosses": [
                                            "To pave the way for; to make easy and smooth."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06880ae7-35e3-4145-9997-6fef23cf9486",
                                                "sense_id": "b80ca2b0-9404-36e2-9e60-c7cab87b9749",
                                                "text": "After two weeks Miguel began to circulate freely about the city in his truck, albeit with the long, chrome-plated pistol cocked and ready on his lap. It wouldn't be for three more years that Gonzo would tell Miguel about the secret leverage that paved his path to freedom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
