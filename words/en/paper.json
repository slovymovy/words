                        "pl": [
                            {
                                "target_lang_word": "papier",
                                "target_lang_sense_clarification": "gest w grze"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7aac0335-791f-3350-87bf-d09d14a61030",
                    "sense_definition": "Made of paper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She packed her lunch in a brown <w>paper</w> bag.",
                            "target_lang_translations": {
                                "ru": "Она упаковала свой обед в коричневый <w>бумажный</w> пакет.",
                                "pl": "Zapakowała drugie śniadanie do brązowej <w>papierowej</w> torebki."
                            }
                        },
                        {
                            "text": "The children made <w>paper</w> airplanes and threw them across the room.",
                            "target_lang_translations": {
                                "ru": "Дети сделали <w>бумажные</w> самолетики и бросали их по комнате.",
                                "pl": "Dzieci zrobiły <w>papierowe</w> samoloty i rzucały nimi po pokoju."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paper bag",
                        "paper cup",
                        "paper plane",
                        "paper towel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из бумаги.",
                        "pl": "Wykonany z papieru."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бумажный",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "papierowy",
                                "target_lang_sense_clarification": "wykonany z papieru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "679d495e-c84b-3b02-a36e-060c41072dcf",
                    "sense_definition": "Existing only in plans or documents, not in reality; theoretical.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theoretical_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company made a huge <w>paper</w> profit, but they had no actual cash.",
                            "target_lang_translations": {
                                "ru": "Компания получила огромную <w>бумажную</w> прибыль, но у них не было реальных денег.",
                                "pl": "Firma osiągnęła ogromny <w>papierowy</w> zysk, ale nie miała realnej gotówki."
                            }
                        },
                        {
                            "text": "It looks like a perfect solution on <w>paper</w>, but it might fail in real life.",
                            "target_lang_translations": {
                                "ru": "Это выглядит идеальным решением <w>на бумаге</w>, но в реальной жизни может не сработать.",
                                "pl": "To wygląda na idealne rozwiązanie <w>na papierze</w>, ale w rzeczywistości może zawieść."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on paper",
                        "paper profit",
                        "paper loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий только в планах или документах, а не в реальности; теоретический.",
                        "pl": "Istniejący tylko w planach lub dokumentach, a nie w rzeczywistości; teoretyczny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на бумаге",
                                "target_lang_sense_clarification": "идиома"
                            },
                            {
                                "target_lang_word": "бумажный",
                                "target_lang_sense_clarification": "существующий формально"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "na papierze",
                                "target_lang_sense_clarification": "teoretycznie"
                            },
                            {
                                "target_lang_word": "papierowy",
                                "target_lang_sense_clarification": "istniejący tylko formalnie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bec1bad-1c3d-3d09-8eac-390591d30aaf",
                    "sense_definition": "Insubstantial or weak, despite appearing threatening or strong.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theoretical_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy army turned out to be a <w>paper</w> tiger and surrendered quickly.",
                            "target_lang_translations": {
                                "ru": "Вражеская армия оказалась <w>бумажным</w> тигром и быстро сдалась.",
                                "pl": "Armia wroga okazała się <w>papierowym</w> tygrysem i szybko się poddała."
                            }
                        },
                        {
                            "text": "Critics called the new law a <w>paper</w> dragon because it had no power to punish anyone.",
                            "target_lang_translations": {
                                "ru": "Критики назвали новый закон <w>бумажным</w> драконом, потому что он не имел силы кого-либо наказать.",
                                "pl": "Krytycy nazwali nową ustawę <w>papierowym</w> smokiem, ponieważ nie miała mocy, by kogokolwiek ukarać."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paper tiger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Несущественный или слабый, несмотря на угрожающий или сильный вид.",
                        "pl": "Słaby lub nieistotny, mimo że wydaje się groźny lub silny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бумажный",
                                "target_lang_sense_clarification": "в идиомах (тигр, дракон)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "papierowy",
                                "target_lang_sense_clarification": "pozornie silny (np. tygrys)"
                            }
                        ]
                    }
                }
            ]
        },
        {
