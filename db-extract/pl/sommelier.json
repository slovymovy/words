                    },
                    {
                        "sense_id": "3d7a3880-76da-36b7-ba13-111a2b039fa3",
                        "entry_id": "ae416cc7-fefa-36bb-885e-bba27e4e0e44",
                        "glosses": [
                            "wykwalifikowany kelner, który specjalizuje się w podawaniu wina"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60fa9691-55e4-497d-83e3-edc8031e99bd",
                        "source_entry_id": "ae416cc7-fefa-36bb-885e-bba27e4e0e44",
                        "source_sense_id": "2309071c-fddd-3937-883d-df4ffe937250",
                        "target_lang_word": "sommelier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sommelier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e21e1b8-d512-3eed-93e4-29243014b6aa",
                                        "entry_id": "dc41f2b5-4dbc-3e3d-b2d3-4fc28e8b31f4",
                                        "glosses": [
                                            "The member of staff at a restaurant who keeps the wine cellar and advises the guests on a choice of wines; a wine steward / stewardess, a wine waiter / waitress / server."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ccd2b4-fd8b-4cbb-bac7-43aef34a60f7",
                                                "sense_id": "8e21e1b8-d512-3eed-93e4-29243014b6aa",
                                                "text": "The sommelier recommended the perfect wine, opened the bottle with panache, and served it into glasses."
                                            },
                                            {
                                                "example_id": "7fac1937-a64b-4483-ae46-e1b98cb1f596",
                                                "sense_id": "8e21e1b8-d512-3eed-93e4-29243014b6aa",
                                                "text": "A Sommelier or wine steward organizes a restaurant's entire wine program, from tasting to pairing of wines with foods the chef might prepare according to seasonal meat, seafood, and produce availability, to ordering and keeping inventory, staying on top of local, domestic, and foreign releases, and educating waitstaff about wines and their nuances. […] A Sommelier must make novice wine drinkers comfortable and explain wine complexities simply, while knowing wines well enough to satisfy the most demanding customer."
                                            },
                                            {
                                                "example_id": "772baed6-05bf-4c02-8246-4417de47e5a8",
                                                "sense_id": "8e21e1b8-d512-3eed-93e4-29243014b6aa",
                                                "text": "There's a new kid on the block: the tea sommelier. […] In the Western world, the first acting tea sommelier on the scene was Helen Gustafson, although the title was never bestowed her. […] She stayed at the restaurant for twenty years, and although she did not have the formal title of tea sommelier—no one did at the time—many in the industry credit her with leading the charge that has resulted in fine-dining establishments improving their tea service."
                                            },
                                            {
                                                "example_id": "81e77a5b-59ef-48e8-995e-415206c5ba62",
                                                "sense_id": "8e21e1b8-d512-3eed-93e4-29243014b6aa",
                                                "text": "The fMRI [functional magnetic resonance imaging] brain images of sommeliers show that their brains act very differently from ordinary brains when they taste wine. An Italian radiology research group (Castriota-Scanderbeg et al., 2005) showed activation of the cerebral network in the left insula and adjoining orbito-frontal cortex in sommeliers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sommelier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "886e84e5-79c5-33d3-8b61-07721b070d19",
                                        "entry_id": "9d171234-cd13-355f-b208-17d0a7abcd16",
                                        "glosses": [
                                            "To act as a sommelier."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb84600-cfd7-45c6-91ed-2e207f7567cc",
                                                "sense_id": "886e84e5-79c5-33d3-8b61-07721b070d19",
                                                "text": "The final nerve-wracking task involved “sommeliering” throughout a gourmet lunch for judges and wine writers – and answering the tricky questions which were inevitably thrown their way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d58b7ae-9321-4fc3-9bd2-e437c8e2df87",
                        "source_entry_id": "ae416cc7-fefa-36bb-885e-bba27e4e0e44",
                        "source_sense_id": "2309071c-fddd-3937-883d-df4ffe937250",
                        "target_lang_word": "sommelier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sommelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "944d5caa-f90f-3699-b96b-cf8592d50ce5",
                                        "entry_id": "168577d3-eeec-3218-bacf-dc05b18e2ba1",
                                        "glosses": [
                                            "Celui qui dans une communauté, dans une maison, a la charge du linge, de la vaisselle, du pain, du vin et des liqueurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f3998f-b8ab-4b58-ba8e-dc1acb8ac9b9",
                                                "sense_id": "944d5caa-f90f-3699-b96b-cf8592d50ce5",
                                                "text": "Bon, fidèle sommelier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b52ff25-4930-3e86-bb3a-4267008fd33e",
                                        "entry_id": "168577d3-eeec-3218-bacf-dc05b18e2ba1",
                                        "glosses": [
                                            "Celui qui, dans un restaurant, a la charge de la cave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c2587b-de54-4195-9a2c-8713c3af8e2c",
                                                "sense_id": "6b52ff25-4930-3e86-bb3a-4267008fd33e",
                                                "text": "Le défaut majeur de beaucoup de sommeliers, c’est de vouloir conclure avant d’analyser."
                                            },
                                            {
                                                "example_id": "03982327-633e-498b-bc5f-3a2c3f6a01b6",
                                                "sense_id": "6b52ff25-4930-3e86-bb3a-4267008fd33e",
                                                "text": "Savez-vous, jeune homme, qu’il fut un temps où caviste, sommelier et échanson correspondaient à trois professions bien distinctes, alors qu’aujourd’hui, les traditions se perdent, conserver, préparer et servir le vin, c’est tout un…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25c0ae17-f44b-33f3-a17d-6bd8fc61d2fd",
                                        "entry_id": "168577d3-eeec-3218-bacf-dc05b18e2ba1",
                                        "glosses": [
                                            "Maître artisan qui fabrique des sommiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "948bcee6-ab0a-4feb-868f-4ba0b57dcca8",
                        "source_entry_id": "ae416cc7-fefa-36bb-885e-bba27e4e0e44",
                        "source_sense_id": "2309071c-fddd-3937-883d-df4ffe937250",
                        "target_lang_word": "сомелье",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сомелье",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5733aa29-516f-3e0f-a24d-af22a9154da6",
                                        "entry_id": "89391a5e-5ea8-33c0-baad-81777cbd4c92",
                                        "glosses": [
                                            "работник ресторана, отвечающий за алкогольные напитки, дающий клиенту советы в их выборе, сервирующий стол ими или следящий за представлением их клиенту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492b3582-eeaa-473b-88fb-fdb6d4d88d46",
                                                "sense_id": "5733aa29-516f-3e0f-a24d-af22a9154da6",
                                                "text": "Через несколько месяцев вы так хорошо изучите историю вин, что спокойно сможете предлагать себя в качестве сомелье владельцам московских ресторанов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
