                "translations": [
                    {
                        "translation_id": "381d7299-dd25-4ffd-92b0-4380c9a6b9cd",
                        "source_entry_id": "c3b39c7b-2b79-385e-aecc-8b79b2c3702e",
                        "source_sense_id": "8a65d3dc-2af9-39ba-b928-5ec3776c9053",
                        "target_lang_word": "debate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To participate in a debate; to dispute, argue, especially in a public arena."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bed9ca-6579-4253-b10d-6656efc74b9a",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "\"Debate me, coward!\" snarled the completely normal intellectual."
                                            },
                                            {
                                                "example_id": "eb8729b9-2bf5-42b3-aedf-adfdb483402c",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "a wise council […] that did debate this business"
                                            },
                                            {
                                                "example_id": "387097f8-b990-4f54-bc8d-c8fb97f52003",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "Debate thy cause with thy neighbour himself."
                                            },
                                            {
                                                "example_id": "2085742e-e8ad-4cad-b921-4bb66199dc19",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "He presents that great soul debating upon the subject of life and death with his intimate friends."
                                            },
                                            {
                                                "example_id": "4929d094-8fbd-46c4-a8c1-c9580f3dd815",
                                                "sense_id": "829c2d34-18ec-36e3-8298-ad012ec1d12d",
                                                "text": "When the legislation was debated by the House of Commons, Labour Deputy Leader Angela Rayner said it was \"riddled with holes\", while former Conservative Commons Leader Jacob Rees-Mogg said it was \"badly written\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To fight."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62eb8683-8fa3-4abe-81d2-61eac10f6536",
                                                "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                                "text": "Well knew they both his person, sith of late / With him in bloudie armes they rashly did debate."
                                            },
                                            {
                                                "example_id": "a85892a5-5746-46d6-ad07-1e4b15d4a429",
                                                "sense_id": "752b9c92-1614-3345-b803-2b624dbb1e03",
                                                "text": "[…] wasteful Time debateth with Decay,\nTo change your day of youth to sullied night"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc2a51b-c0be-3e9c-91e4-e2bf5cebde2c",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To engage in combat for; to strive for."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "316e49f4-cedc-4910-8327-3a8a8feb97ef",
                                                "sense_id": "5dc2a51b-c0be-3e9c-91e4-e2bf5cebde2c",
                                                "text": "Volunteers […] thronged to serve under his banner, and the cause of religion was debated with the same ardour in Spain as on the plains of Palestine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4507488b-1107-36d9-bd76-4809eea9eeb8",
                                        "entry_id": "fe441944-0075-3543-bead-dbb4008fb22f",
                                        "glosses": [
                                            "To consider (to oneself), to think over, to attempt to decide"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cafcb58-caf6-454d-bb64-311dbd02ed8e",
                                                "sense_id": "4507488b-1107-36d9-bd76-4809eea9eeb8",
                                                "text": "He was debating where he'd spend his holiday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "debate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f030b9e-95fd-385f-bdb3-4789cea390aa",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "An argument, or discussion, usually in an ordered or formal setting, often with more than two people, generally ending with a vote or other decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c039e8c5-433c-4f00-a28d-5d18e9f9762f",
                                                "sense_id": "0f030b9e-95fd-385f-bdb3-4789cea390aa",
                                                "text": "After a four-hour debate, the committee voted to table the motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "An informal and spirited but generally civil discussion of opposing views."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa23377-8856-4644-8c09-81cc82928210",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "The debate over the age of the universe is thousands of years old."
                                            },
                                            {
                                                "example_id": "5c5e2055-afc4-413d-aaea-a7eba9c9e737",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "There was a bit of a debate over who should pay for the damaged fence."
                                            },
                                            {
                                                "example_id": "c96da967-9dcf-4817-bf77-101d5ebc8e90",
                                                "sense_id": "00b0c005-2329-3678-9a75-65afcea8a184",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives. And, as their ubiquity spreads, so too does the debate around whether we should allow ourselves to become so reliant on them – and who, if anyone, is policing their use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "Discussion of opposing views."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59179a42-5b68-447d-aa7e-882a53ecd7ef",
                                                "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                                "text": "There has been considerable debate concerning exactly how to format these articles."
                                            },
                                            {
                                                "example_id": "2c0c1e0e-3751-407a-8f93-4bb01bbd35e0",
                                                "sense_id": "b1e7b9c5-b0fe-371e-8967-9d3e4cc947b3",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eccd06d-09d6-3dbd-8c22-52e2632c933f",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "A type of literary composition, taking the form of a discussion or disputation, commonly found in the vernacular medieval poetry of many European countries, as well as in medieval Latin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "825e5560-a37e-31fb-a29d-aa5c5193bc5b",
                                        "entry_id": "57681edb-1dd3-3002-9a6b-333fbfc67778",
                                        "glosses": [
                                            "Strife, discord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "648708dd-050b-4385-b1b1-9b25c62787f9",
                        "source_entry_id": "c3b39c7b-2b79-385e-aecc-8b79b2c3702e",
                        "source_sense_id": "8a65d3dc-2af9-39ba-b928-5ec3776c9053",
                        "target_lang_word": "discuss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51f157da-f819-325a-9ab8-a2781a9e8ca7",
                                        "entry_id": "3d68c1d2-1ea7-356e-9ee0-b857147cf6c9",
                                        "glosses": [
                                            "To converse or debate concerning a particular topic."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f52b7b0-6956-417d-9cdf-5fdf2caea057",
                                                "sense_id": "51f157da-f819-325a-9ab8-a2781a9e8ca7",
                                                "text": "Let's sit down and discuss whether we should have a baby."
                                            },
                                            {
                                                "example_id": "923a750c-34a8-44d7-96dc-c3dabc62e909",
                                                "sense_id": "51f157da-f819-325a-9ab8-a2781a9e8ca7",
                                                "text": "I don't wish to discuss this further."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea4b63ad-2883-3a4d-82a9-e28e6ff67b77",
                                        "entry_id": "3d68c1d2-1ea7-356e-9ee0-b857147cf6c9",
                                        "glosses": [
                                            "To communicate, tell, or disclose (information, a message, etc.)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab3b5fcf-c4aa-4ce4-9789-3bf6e1ab2cc3",
                                                "sense_id": "ea4b63ad-2883-3a4d-82a9-e28e6ff67b77",
                                                "text": "Nym: I will discuss the humour of this love to Page."
                                            },
                                            {
                                                "example_id": "2d21d29e-b6df-460f-8d46-546f6b3bc017",
                                                "sense_id": "ea4b63ad-2883-3a4d-82a9-e28e6ff67b77",
                                                "text": "Pistol: Discuss unto me; art thou officer? Or art thou base, common and popular?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18c8fb37-fd59-346b-8b15-7aa9eb1eef7b",
                                        "entry_id": "3d68c1d2-1ea7-356e-9ee0-b857147cf6c9",
                                        "glosses": [
                                            "To break to pieces; to shatter."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06a6a647-6d22-3ceb-b3f2-9a8bfea970a0",
                                        "entry_id": "3d68c1d2-1ea7-356e-9ee0-b857147cf6c9",
                                        "glosses": [
                                            "To deal with, in eating or drinking; consume."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9c65d9b-15ed-4108-87aa-f21377a28985",
                                                "sense_id": "06a6a647-6d22-3ceb-b3f2-9a8bfea970a0",
                                                "text": "When the preparations were finished, he invited me with—“Now, sir, bring forward your chair.” And we all, including the rustic youth, drew round the table: an austere silence prevailing while we discussed our meal."
                                            },
                                            {
                                                "example_id": "39f0f46d-af78-49b6-93e1-65b7b402a5ed",
                                                "sense_id": "06a6a647-6d22-3ceb-b3f2-9a8bfea970a0",
                                                "text": "We sat quietly down and discussed a cold fowl that we had brought with us."
                                            },
                                            {
                                                "example_id": "dc621c8d-838a-45d6-9649-3b7f34566b44",
                                                "sense_id": "06a6a647-6d22-3ceb-b3f2-9a8bfea970a0",
                                                "text": "In the first room we entered, a soldier and a man, like a clerk or dominie, were discussing a bottle of red wine; they immediately sprang up and politely proffered us each a bumper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "479af4b7-51ad-34e3-8a80-b58eca819710",
                                        "entry_id": "3d68c1d2-1ea7-356e-9ee0-b857147cf6c9",
                                        "glosses": [
                                            "To examine or search thoroughly; to exhaust a remedy against, as against a principal debtor before proceeding against the surety."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36e5d23a-e36f-3767-9e2d-05595b3173bf",
                                        "entry_id": "3d68c1d2-1ea7-356e-9ee0-b857147cf6c9",
                                        "glosses": [
                                            "To drive away, disperse, shake off; said especially of tumors."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338b6afd-ba10-4782-9750-389ff8bc17c5",
                                                "sense_id": "36e5d23a-e36f-3767-9e2d-05595b3173bf",
                                                "text": "For she was giuen all to fleshly lust, / And poured forth in sensuall delight, / That all regard of shame she had discust, / And meet respect of honour put to flight […]"
                                            },
                                            {
                                                "example_id": "ea53d44a-e511-4223-a12e-6803d7847d05",
                                                "sense_id": "36e5d23a-e36f-3767-9e2d-05595b3173bf",
                                                "text": "If too much milke be the cauſe, then the Nurſe ſhall not give the childe ſucke ſo often, nor in ſuch plenty: If it proceed from wind, and that doe cauſe the childe to be thus troubled, it ſhall be diſcuſſed with Fomentations applied to the belly and navell; and with Carminative Cliſters, which ſhall bee given him, […]"
                                            },
                                            {
                                                "example_id": "a573199e-10de-440f-900f-4fd49b08271a",
                                                "sense_id": "36e5d23a-e36f-3767-9e2d-05595b3173bf",
                                                "text": "June 15, 1751, Samuel Johnson, letter in The Rambler\nThe softness of my hands was secured by medicated gloves, and my bosom rubbed with a pomade prepared by my mother, of virtue to discuss pimples, and clear discolourations."
                                            },
                                            {
                                                "example_id": "d6341e45-71f5-49ee-827e-ca1349ccbb32",
                                                "sense_id": "36e5d23a-e36f-3767-9e2d-05595b3173bf",
                                                "text": "Many arts were used to discuss the beginnings of new affliction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfc520ac-b422-4c8f-b6cf-9e07692cfa13",
                        "source_entry_id": "c3b39c7b-2b79-385e-aecc-8b79b2c3702e",
                        "source_sense_id": "8a65d3dc-2af9-39ba-b928-5ec3776c9053",
                        "target_lang_word": "debattieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debattieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9503b56f-4f0d-32be-9a3a-ff90338f521a",
                                        "entry_id": "fcd0bd9c-b249-336d-bbe0-7294a9bc74bb",
                                        "glosses": [
                                            "eine Auseinandersetzung, Debatte, Diskussion führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e5d0a1-0da7-4cf1-826c-806aca288682",
                                                "sense_id": "9503b56f-4f0d-32be-9a3a-ff90338f521a",
                                                "text": "Sehr wenig ist jedoch über die grundlegende Bevölkerungsstruktur dieser Jahre bekannt – selbst die Einwohnerzahl wird heftig debattiert."
                                            },
                                            {
                                                "example_id": "cfa764f8-4056-431b-a9c5-538835a0d9f6",
                                                "sense_id": "9503b56f-4f0d-32be-9a3a-ff90338f521a",
                                                "text": "„Merkel wählte diesen Bypass, statt Parlament und Gesellschaft debattieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "84acf8e8-3706-45fc-b151-2ef14479a648",
                                                "sense_id": "9503b56f-4f0d-32be-9a3a-ff90338f521a",
                                                "text": "„Einmal debattieren sie eine Woche lang darüber, ob sie den General in ihr Haus einladen könnten, und beide bringen die spitzfindigsten Einwendungen vor.“"
                                            },
                                            {
                                                "example_id": "dae88cad-86fa-4417-9079-fd1a47944ae5",
                                                "sense_id": "9503b56f-4f0d-32be-9a3a-ff90338f521a",
                                                "text": "Das heiß debattierte Problem der Zuwanderung sollte das Land noch lange beschäftigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea83677c-05e3-4532-85de-44e45198c075",
                        "source_entry_id": "c3b39c7b-2b79-385e-aecc-8b79b2c3702e",
                        "source_sense_id": "8a65d3dc-2af9-39ba-b928-5ec3776c9053",
                        "target_lang_word": "diskutieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
