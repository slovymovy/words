                        "sense_id": "55dd2ddf-fdd7-3729-9cb0-5b30b9686e84",
                        "entry_id": "2c7b49c5-332e-3a5a-926a-bf4594cab18e",
                        "glosses": [
                            "A state of transcendent union supposed to be assumed by a holy man or yogi at his death."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "764921be-293d-41e3-8124-297dcdf2a3ab",
                                "sense_id": "55dd2ddf-fdd7-3729-9cb0-5b30b9686e84",
                                "text": "She had seated herself cross-legged in the samadhi position and simply ceased to be."
                            }
                        ]
                    },
                    {
                        "sense_id": "36c6b84f-a9fb-3e94-b571-dc4348fcb9d7",
                        "entry_id": "2c7b49c5-332e-3a5a-926a-bf4594cab18e",
                        "glosses": [
                            "The highest state of meditation, at which complete unity is reached."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f85a8dd9-4faa-45d4-9463-12fd4d5d868e",
                                "sense_id": "36c6b84f-a9fb-3e94-b571-dc4348fcb9d7",
                                "text": "The yogi, or disciple, who has by these means overcome the obscurations of his lower nature sufficiently, enters into the condition termed samâdhi, and ‘comes face to face with facts which no instinct or reason can ever know.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "9693b500-6ee9-35a2-bec9-c443af899994",
                        "entry_id": "2c7b49c5-332e-3a5a-926a-bf4594cab18e",
                        "glosses": [
                            "The tomb of a holy person or saint in India."
                        ],
