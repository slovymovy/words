                        "source_sense_id": "6646fc25-939e-3195-aceb-c0e317f28c13",
                        "source_sense_description": "het zaken die verkeerd zijn zo beschrijven dat ze goed lijken; het recht praten wat krom is",
                        "target_lang_word": "explaining-away",
