                        "sense_id": "d9288afe-2d6c-38a1-b8a0-6b76065b46ba",
                        "entry_id": "24faba8c-0410-312a-9c05-92f0e4650387",
                        "glosses": [
                            "Instrument à vent à anches libres et à clavier, comme l’accordéon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b92dd2f-0d2b-4cc1-8440-cd5561899b22",
                                "sense_id": "d9288afe-2d6c-38a1-b8a0-6b76065b46ba",
                                "text": "Mais peut-être doit-on, parmi ce premier groupe d’instruments, souligner la fréquence et la popularité de deux d’entre eux : le tuba et le concertina."
                            },
                            {
                                "example_id": "a17d3e89-249c-4c9d-bcb1-9567cc374be8",
                                "sense_id": "d9288afe-2d6c-38a1-b8a0-6b76065b46ba",
                                "text": "Une méthode pour apprendre le concertina irlandais enfin disponible en langue française"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd746875-31a4-4436-8496-aa8f138fa80f",
                        "source_entry_id": "24faba8c-0410-312a-9c05-92f0e4650387",
