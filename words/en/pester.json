{
    "word_family": [
        "pest"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a07ede4-67e5-3b15-bb40-02398469ca7a",
                    "sense_definition": "To bother, harass, or annoy someone persistently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>pester</w> their parents for toys whenever they go to the store.",
                            "target_lang_translations": {
                                "ru": "Дети <w>пристают</w> к родителям с просьбами купить игрушки каждый раз, когда они приходят в магазин."
                            }
                        },
                        {
                            "text": "Stop <w>pestering</w> me with constant questions while I am trying to work.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>досаждать</w> мне постоянными вопросами, пока я пытаюсь работать."
                            }
                        }
                    ],
                    "synonyms": [
                        "badger",
                        "bug",
                        "harass",
                        "pester",
                        "pester"
                    ],
                    "antonyms": [
                        "leave alone",
                        "let alone",
                        "lay off"
                    ],
                    "common_phrases": [
                        "pester with questions",
                        "pester for help"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно беспокоить, докучать или раздражать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досажда́ть",
                                "target_lang_sense_clarification": "вызывать раздражение постоянными просьбами или действиями"
                            },
                            {
                                "target_lang_word": "приставать",
                                "target_lang_sense_clarification": "назойливо обращаться с просьбами или вопросами"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "сильно утомлять кого-либо назойливостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72b280ee-1fa4-318b-985c-dbb357a7b1a1",
                    "sense_definition": "To crowd or pack together very closely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crowding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep were <w>pestered</w> together in the small pen during the heavy storm.",
                            "target_lang_translations": {
                                "ru": "Во время сильной бури овец <w>сбили в кучу</w> в маленьком загоне."
                            }
                        },
                        {
                            "text": "Travelers were <w>pestered</w> into the narrow hallway while waiting for the train.",
                            "target_lang_translations": {
                                "ru": "В ожидании поезда путешественники <w>скучились</w> в узком коридоре."
                            }
                        }
                    ],
                    "synonyms": [
                        "crowd",
                        "huddle",
                        "throng"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скучивать или тесно сбивать в кучу (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбивать в кучу",
                                "target_lang_sense_clarification": "собирать вместе в тесном пространстве"
                            },
                            {
                                "target_lang_word": "скучивать",
                                "target_lang_sense_clarification": "размещать плотно друг к другу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe6c170b-8633-3452-ba57-0fc6805f2d45",
                    "sense_definition": "A person or thing that causes annoyance or bother.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the construction site became a real <w>pester</w> for the neighbors.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум со стройки стал настоящим <w>источником раздражения</w> для соседей."
                            }
                        },
                        {
                            "text": "I felt like a <w>pester</w> because I kept asking for updates on the project.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал себя <w>занозой</w>, потому что постоянно спрашивал о ходе проекта."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые вызывают раздражение или беспокойство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заноза",
                                "target_lang_sense_clarification": "переносное значение: человек, который постоянно досаждает"
                            },
                            {
                                "target_lang_word": "источник раздражения",
                                "target_lang_sense_clarification": "нечто, вызывающее постоянное беспокойство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}