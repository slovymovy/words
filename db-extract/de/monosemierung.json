                "senses": [
                    {
                        "sense_id": "8841dce8-f366-317f-ab88-462842b3d8ad",
                        "entry_id": "e6ef9056-5455-36de-a3ca-d20856f287fe",
                        "glosses": [
                            "das Eindeutigmachen/-werden eines mehrdeutigen sprachlichen Ausdrucks durch den sprachlichen Kontext oder außersprachliche Informationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4aa5bbd-354c-464d-bd8b-0d03a30d50db",
                                "sense_id": "8841dce8-f366-317f-ab88-462842b3d8ad",
                                "text": "\"Bank\" ist eine mehrdeutige (homonyme) Wortform; es steht für \"Geldinstitut\" oder \"Sitzmöbel\". Monosemierung erfolgt z.B. in einem Satz: \"Er hebt bei seiner Bank Geld ab.\" (Monosemierung durch sprachlichen Kontext)"
                            },
                            {
                                "example_id": "6a7325c6-f8cd-4879-abb0-223b2b685e0e",
                                "sense_id": "8841dce8-f366-317f-ab88-462842b3d8ad",
                                "text": "Auch die Gesprächssituation kann Monosemierung bewirken, etwa, wenn man beim Anblick einer Bank sagt: \"Lass uns eben zur Bank gehen!\" (Monosemierung durch situativen Kontext)"
                            },
                            {
                                "example_id": "99a3e817-5a3e-4028-a75a-44f949208bcf",
                                "sense_id": "8841dce8-f366-317f-ab88-462842b3d8ad",
                                "text": "„Felder können die Bedingungen für die Monosemierung sichtbar machen und erhellen, daß jedes Semem eines polysemen Wortes wiederum Ausgangspunkt für ein Feld sein kann.“"
                            },
                            {
                                "example_id": "44e4190c-58b3-4912-af13-25be0af2d69e",
                                "sense_id": "8841dce8-f366-317f-ab88-462842b3d8ad",
                                "text": "„Angesichts dieses Befundes stellt sich die Frage, wie die Monosemierung, die, falls man nicht in Wortspielen oder bestimmten Textsorten auf Mehrdeutigkeit abzielt, eine der Voraussetzungen der Kommunikation ist, zustandekommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
