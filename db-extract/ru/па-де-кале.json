                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "578a9333-b2fa-4404-bea6-5c9ee02044a2",
                        "source_entry_id": "63479343-977f-391b-9942-8401afda5940",
                        "source_sense_id": "369f51c6-c42c-3668-a783-0c110be82c52",
                        "target_lang_word": "Pas-de-Calais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pas-de-Calais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb96e008-986a-3e59-a074-cbce2b7d10ff",
                                        "entry_id": "48676d4e-8555-3820-9c05-d2ded7a21107",
                                        "glosses": [
                                            "Détroit qui marque la limite entre la Manche et la mer du Nord, et sépare la Grande-Bretagne de la France."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5356175-cf29-450f-8f6d-daa283ffbbe8",
                                                "sense_id": "cb96e008-986a-3e59-a074-cbce2b7d10ff",
                                                "text": "Bientôt, un pont fut jeté sur le Pas-de-Calais, composé d’une série de piliers semblables à autant de tours Eiffel et supportant des câbles de monorails à cent cinquante pieds au-dessus de l’eau ; […]."
                                            },
                                            {
                                                "example_id": "0b859936-b398-49f0-8cd0-c863b351ab32",
                                                "sense_id": "cb96e008-986a-3e59-a074-cbce2b7d10ff",
                                                "text": "[…] : trois mille ans plus tôt, le préhistorien nous a fait assister à la formation du fossé du Pas-de-Calais ; il nous a fait visiter la caverne de Lascaux, ce Louvre de l’Âge de pierre remontant à vingt mille ans ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab0c1f5e-f75a-348d-9341-a586a2674c87",
                                        "entry_id": "48676d4e-8555-3820-9c05-d2ded7a21107",
                                        "glosses": [
                                            "Département français de la région Hauts-de-France. Ce département porte le numéro 62."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b05914-3c79-48d5-b9cd-2f0576971984",
                                                "sense_id": "ab0c1f5e-f75a-348d-9341-a586a2674c87",
                                                "text": "Les phosphates arénacés, ou sables phosphatés, se rencontrent dans des poches à la partie supérieure de la craie à bélemnites, sur la limite des départements de la Somme et du Pas-de-Calais. Les principaux gisements sont à Beauval, Hallencourt et Orville."
                                            },
                                            {
                                                "example_id": "e4d6c504-829f-425e-959e-94faae8b6117",
                                                "sense_id": "ab0c1f5e-f75a-348d-9341-a586a2674c87",
                                                "text": "Le Nord et le Pas-de-Calais présentent une marqueterie de petits pays, tout en nuances subtiles, où se mêlent harmonieusement milieux naturels et paysages humanisés."
                                            },
                                            {
                                                "example_id": "1f9cfa43-f3cb-454c-823f-2d71a2ef9269",
                                                "sense_id": "ab0c1f5e-f75a-348d-9341-a586a2674c87",
                                                "text": "Pierre-Henri Dumont, député LR du Pas-de-Calais, nuance : « On peut vous taper sur les doigts si vous êtes parmi les plus absents, donc il faut garder un œil dessus. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
