        "fr-extract.jsonl": [
            {
                "entry_id": "851c4d9f-5909-31a6-82fd-6d4b20a36fcb",
                "word": "organogenèse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dd7fb00f-b0b1-3e7f-b768-6a03be21aad0",
                        "entry_id": "851c4d9f-5909-31a6-82fd-6d4b20a36fcb",
                        "glosses": [
                            "Histoire de la manière dont les organes se développent depuis l'état embryonnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3a9b7e2-e3b1-4066-9173-01005a6a9204",
                                "sense_id": "dd7fb00f-b0b1-3e7f-b768-6a03be21aad0",
                                "text": "L'organogenèse est une des étapes de l'embryogenèse qui représente la transformation que subit l'embryon de stade œuf jusqu’à maturité."
                            },
                            {
                                "example_id": "6556d4e7-d159-4dd3-8a91-8a40103d5790",
                                "sense_id": "dd7fb00f-b0b1-3e7f-b768-6a03be21aad0",
                                "text": "Des preuves de plus en plus nombreuses indiquent que l'organogenèse de l'ovaire n'est pas un processus passif qui survient par défaut en cas d'absence du développement des testicules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acc999fe-98e2-4de1-8c49-ffd0dce882ac",
                        "source_entry_id": "851c4d9f-5909-31a6-82fd-6d4b20a36fcb",
                        "source_sense_id": "dd7fb00f-b0b1-3e7f-b768-6a03be21aad0",
