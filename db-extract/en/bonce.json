                "senses": [
                    {
                        "sense_id": "b489bc71-6683-380a-b390-ddc4f80f31fe",
                        "entry_id": "8a09edcc-006f-3b75-8aa4-fa2960023746",
                        "glosses": [
                            "A large marble of grey stone used in various games, such as bonce about, bonce-eye, and French bonce."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4cdfbb3a-767c-4ae5-a14f-640cf759804b",
                                "sense_id": "b489bc71-6683-380a-b390-ddc4f80f31fe",
                                "text": "Bonces, or very large stone marbles, made chiefly in Holland."
                            },
                            {
                                "example_id": "7f7f573b-dd38-466c-b30f-016521b82ba7",
                                "sense_id": "b489bc71-6683-380a-b390-ddc4f80f31fe",
                                "text": "BONCE ABOUT is played with a big kind of marbles, called \"bonces.\" The game does not require much skill. The first player puts down his bonce, and the second aims at it from a given distance. If he hits the bonce of the first player with his own, he wins a marble; if not, the first player aims at the bonce of the second, from the place where his own rests. Each time the bonces strike together, a marble is lost and won. […] The Dutch marbles of grey stone, sometimes stained with various colours, are the honest workable marbles for \"shoot in the ring,\" and similar games."
                            }
                        ]
                    },
                    {
                        "sense_id": "c22481d2-f2b8-3929-a7d6-8269a04712e5",
                        "entry_id": "8a09edcc-006f-3b75-8aa4-fa2960023746",
                        "glosses": [
                            "A marble game played with bonces."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "32efc31f-fa0d-4840-8514-fbf40f6aaa30",
                                "sense_id": "c22481d2-f2b8-3929-a7d6-8269a04712e5",
                                "text": "Bonce is played with very large marbles. One boy pitches his bonce, and another tries to strike it, each throwing by turns: if the bonce be struck, its owner pays a forfeit of one or more marbles, as agreed on."
                            }
                        ]
                    },
                    {
                        "sense_id": "847f88cd-d908-361d-8865-f68811fff9be",
                        "entry_id": "8a09edcc-006f-3b75-8aa4-fa2960023746",
                        "glosses": [
                            "The human head."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dad0809e-a8cd-4842-9bf4-242736e61a2c",
                                "sense_id": "847f88cd-d908-361d-8865-f68811fff9be",
                                "text": "Bonce (various), the head, called also \"crust, chump.\" From bonce, a marble of larger size than ordinary, used by boys."
                            },
                            {
                                "example_id": "8372dbf7-7775-45af-aeef-7988c5da032b",
                                "sense_id": "847f88cd-d908-361d-8865-f68811fff9be",
                                "text": "To see Nina herself Nick had to crane round the big white bonce of Norman Kent, who was as sensitive to music as he was to conservatives, and kept shifting in his seat."
                            },
                            {
                                "example_id": "250eaa4d-10f1-4c63-82bc-2cb9661b305a",
                                "sense_id": "847f88cd-d908-361d-8865-f68811fff9be",
                                "text": "2010, Skins, Season 4 Episode 8, \"Everyone\".\nCook: I don't think you know what I am, mate. ... I'm a fucking waste of space. I'm just a stupid kid. I got no sense. A criminal. I'm no fucking use, me. I am nothing. So, please... please... get it into, you know, into your bonce... that you killed my friend. And... I'm Cook. I'M COOK!"
                            }
                        ]
                    }
