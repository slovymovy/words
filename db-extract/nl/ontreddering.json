                                "target_senses": [
                                    {
                                        "sense_id": "5a2ccb7b-6869-31cf-b1c6-cce8416d1ff0",
                                        "entry_id": "8183937a-f52b-39ef-8a18-1c36e2af57d6",
                                        "glosses": [
                                            "Disruptive change, from one state to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843f7c4b-347b-4e0e-8ea3-89350360fe4d",
                                                "sense_id": "5a2ccb7b-6869-31cf-b1c6-cce8416d1ff0",
                                                "text": "Scotland's bottleneck junction between the West and East Coast main lines at Carstairs will be the site of major upheaval until the end of May, while £164 million worth of improvements are carried out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474b8ff7-cefa-3e73-98cc-12d8f176f587",
                                        "entry_id": "8183937a-f52b-39ef-8a18-1c36e2af57d6",
                                        "glosses": [
                                            "The process of being heaved upward, especially the raising of part of the earth's crust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5129d349-227e-37b7-b4fc-f25986677356",
                                        "entry_id": "8183937a-f52b-39ef-8a18-1c36e2af57d6",
                                        "glosses": [
                                            "A sudden violent upset, disruption or convulsion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54c668ce-7071-432a-8fe3-9e16ed15247e",
                                                "sense_id": "5129d349-227e-37b7-b4fc-f25986677356",
                                                "text": "Since that upheaval Wales have won just once in seven games, beating Northern Ireland in the Nations Cup last May."
                                            }
                                        ]
                                    }
                                ]
                            }
