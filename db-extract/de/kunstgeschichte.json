                    {
                        "form_id": "ef93c829-399a-4781-a962-6ecd708c1099",
                        "entry_id": "ce628af4-1d51-30e8-8476-3232dfba0ca1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kunstgeschichten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09eecbcc-27e7-3665-975e-8a1d88eda316",
                        "entry_id": "ce628af4-1d51-30e8-8476-3232dfba0ca1",
                        "glosses": [
                            "Plural selten: die geschichtliche Entwicklung der bildenden Kunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6fe4083-8c5f-4ff9-9e78-f8568050af16",
                                "sense_id": "09eecbcc-27e7-3665-975e-8a1d88eda316",
                                "text": "Die Renaissance gilt als epochale Wandlung der Kunstgeschichte."
                            },
                            {
                                "example_id": "1279c6ec-ca9f-4de3-9a2d-292be382abc3",
                                "sense_id": "09eecbcc-27e7-3665-975e-8a1d88eda316",
                                "text": "„Es handelte sich um Darstellungen höchst unanständiger Szenen von Leda mit dem Schwan, von Pan und den Nymphen, von Susanna im Bade und ähnlichen Sachen, die schon längst zur Konfiskation der Bibel, der Mythologie und der gesamten Kunstgeschichte hätte führen müssen, wenn sich alles nach der Berliner Polizei richten würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8fc9bc8e-d455-3781-9eee-1a79709551a9",
                        "entry_id": "ce628af4-1d51-30e8-8476-3232dfba0ca1",
                        "glosses": [
                            "Plural selten: die Wissenschaft von der Kunstgeschichte (Kunstwissenschaft)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "842aa85f-2ccc-4b62-9605-e018f61e4af6",
                                "sense_id": "8fc9bc8e-d455-3781-9eee-1a79709551a9",
                                "text": "Winckelmann hat die Kunstgeschichte erschaffen."
                            },
                            {
                                "example_id": "f9fd0dc6-244c-4c9c-8cbf-2caa65679ade",
                                "sense_id": "8fc9bc8e-d455-3781-9eee-1a79709551a9",
                                "text": "An der Universität Wien kann man auch Kunstgeschichte studieren."
                            },
                            {
                                "example_id": "8125174f-2ae7-4883-bae0-3a22eb9c1ad9",
                                "sense_id": "8fc9bc8e-d455-3781-9eee-1a79709551a9",
                                "text": "„Sie begann ein Studium der Kunstgeschichte, wechselte dann und wurde Juristin.“"
                            },
                            {
                                "example_id": "022d1ba3-6db6-4cf0-81e7-c343216c15ca",
                                "sense_id": "8fc9bc8e-d455-3781-9eee-1a79709551a9",
                                "text": "„Die Kunstgeschichte hat ihn zwar (nicht ganz grundlos) mit Mißachtung gestraft, aber der damals 33jährige – mit großer Künstlerschleife und einem breiten Schlapphut als Bohemien durch die Stadt bummelnd – war für seine jugendlichen Bewunderer offenbar eine charismatische Persönlichkeit.“"
                            },
                            {
                                "example_id": "50ec15e1-7ec5-43b1-9ba6-274261aaa4d6",
                                "sense_id": "8fc9bc8e-d455-3781-9eee-1a79709551a9",
                                "text": "„Ich selbst hatte in Deutschland zwei Semester Kunstgeschichte studiert und dann Journalist werden wollen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
