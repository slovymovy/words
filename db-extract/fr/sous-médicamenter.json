                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fe96dda-58c3-4e01-a345-f823037128cf",
                                "sense_id": "a3cbff60-0add-3a89-8c7e-992499ad0183",
                                "text": "Le collier aide à mesurer la bonne quantité de médicament, de sorte que vous n’avez pas à vous soucier de sur ou sous-médicamenter vos plantes."
                            },
                            {
                                "example_id": "20123211-74a0-4c62-bbc2-e0c6342d3864",
                                "sense_id": "a3cbff60-0add-3a89-8c7e-992499ad0183",
                                "text": "À l’inverse, les Français se sous-médicamentent dans d’autres secteurs, notamment pour les enfants souffrant de troubles de l’attention."
                            },
                            {
                                "example_id": "dee67ab9-3ff8-45f6-a83e-ac3cb1aec44a",
                                "sense_id": "a3cbff60-0add-3a89-8c7e-992499ad0183",
                                "text": "D’après mon expérience, je pense qu’il pourrait y avoir une forme de compensation inconsciente de l’automédication lorsque vous êtes trop prudent - l’anxiété de développer un TUO pourrait vous amener à vous sous-médicamenter ou à vous surmédicamenter inconsciemment."
                            }
                        ]
                    }
