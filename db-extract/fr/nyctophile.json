                    {
                        "sense_id": "b5bdb2cb-964e-3da5-b389-797147a06f20",
                        "entry_id": "dfdc0368-fa1d-381c-a3b1-092c1a5abbdd",
                        "glosses": [
                            "Chauve-souris australienne du genre Nyctophilus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "297d895b-4d1c-4558-919a-bf6b74fc9079",
                                "sense_id": "b5bdb2cb-964e-3da5-b389-797147a06f20",
                                "text": "Les nyctophiles ont vingt-huit dents ; deux incisives supérieurs coniques, aiguës et allongées ; six inférieurs trifides, égales, à lobes arrondis ; deux canines à chaque mâchoire, les inférieurs avec une petite pointe à leur base, en arrière ; seize molaires garnies de tubercules aigus …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10abb165-3ede-4e54-a7f0-949e4607a8c8",
                        "source_entry_id": "dfdc0368-fa1d-381c-a3b1-092c1a5abbdd",
                        "target_lang_word": "nyctophile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nyctophile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4be51631-1bbd-356e-b55a-b53d72ed3423",
                                        "entry_id": "6321ac6d-1184-3e26-adb5-b16ec1ee4e79",
                                        "glosses": [
                                            "Someone who loves the night or darkness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a41357bf-b090-4dba-956c-4db6d0fbcc2c",
                                                "sense_id": "4be51631-1bbd-356e-b55a-b53d72ed3423",
                                                "text": "He reads—he writes—late into the night. It's his way. He's a night person. A 'nyctophile' he calls himself."
                                            },
                                            {
                                                "example_id": "c728399b-2a01-4b51-9b4a-c9fc7d983a56",
                                                "sense_id": "4be51631-1bbd-356e-b55a-b53d72ed3423",
                                                "text": "Altogether, these four varieties of nyctophiles chewed great hunks out of my sleeping time, and accounted for many of my less charitable thoughts, during the hours that the \"general populace\" was enjoying restful \"shut-eye\"'."
                                            },
                                            {
                                                "example_id": "b52ddac3-2057-4f85-ab51-ba35f07cb1cf",
                                                "sense_id": "4be51631-1bbd-356e-b55a-b53d72ed3423",
                                                "text": "Britain will not see a total solar eclipse until September 23, 2090, but there are a plethora of partial eclipses in the meantime to keep nyctophiles content."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc3c246b-439e-39f8-979f-26c9b8d5991e",
                                        "entry_id": "6321ac6d-1184-3e26-adb5-b16ec1ee4e79",
                                        "glosses": [
                                            "Any of the Australian bats of the genus Nyctophilus."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9016616-7e9e-4275-820e-b23e00f50a7f",
                                                "sense_id": "cc3c246b-439e-39f8-979f-26c9b8d5991e",
                                                "text": "Case 25. The Nycteres of Africa, and the Petalias of Java; the Nyctophiles of Australia; the Barbastelles and long-eared bats of Europe; and the true bat and Scotophiles, which are scattered over different parts of the world, and the Lasiures of America."
                                            }
                                        ]
                                    }
                                ]
                            }
