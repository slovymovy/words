                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa465b05-6240-42b9-8d60-3fc2f0aefbea",
                                "sense_id": "6647f8a6-5536-38b5-bc31-57015a501968",
                                "text": "„Und schließlich gibt es noch immer die geheimnisumwitterte Kuriermaschine, die in den letzten Kriegstagen einiges von Hitlers Privatbesitz aus Berlin ausfliegen sollte.“"
                            },
                            {
                                "example_id": "cba16928-d962-4d20-a50e-ed63bc43ae7c",
                                "sense_id": "6647f8a6-5536-38b5-bc31-57015a501968",
                                "text": "„Die Kuriermaschine mit Stauffenberg und Haeften an Bord landet sechs Kilometer vom geheimen Standort des Führerhauptquartiers entfernt.“"
                            },
                            {
                                "example_id": "5b76e9d8-a513-47b1-b711-a1cb953e7002",
                                "sense_id": "6647f8a6-5536-38b5-bc31-57015a501968",
                                "text": "„Schneller und schneller jagte die zweimotorige Kuriermaschine mit den deutschen Hoheitszeichen über die Startpiste des Flughafens Marseille.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
