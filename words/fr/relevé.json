                {
                    "sense_id": "1ae80056-afb4-36c5-9ceb-bc0daff500bb",
                    "sense_definition": "Action de mesurer, noter ou enregistrer des données techniques sur le terrain, ou document qui en résulte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte effectue un <w>relevé</w> précis des dimensions du bâtiment ancien.",
                            "target_lang_translations": {
                                "en": "The architect carries out an accurate <w>survey</w> of the old building's dimensions.",
                                "ru": "Архитектор проводит точный <w>обмер</w> размеров старого здания.",
                                "de": "Der Architekt fertigt ein genaues <w>Aufmaß</w> der Abmessungen des alten Gebäudes an.",
                                "es": "El arquitecto realiza un <w>levantamiento</w> preciso de las dimensiones del edificio antiguo.",
                                "zh": "建筑师对这座老建筑的尺寸进行了精确的<w>测量</w>。"
                            }
                        },
                        {
                            "text": "Les techniciens ont terminé le <w>relevé</w> topographique de la nouvelle route.",
                            "target_lang_translations": {
                                "en": "The technicians have finished the topographic <w>survey</w> of the new road.",
                                "ru": "Техники завершили топографическую <w>съёмку</w> новой дороги.",
                                "de": "Die Techniker haben die topografische <w>Vermessung</w> der neuen Straße abgeschlossen.",
                                "es": "Los técnicos han terminado el <w>levantamiento</w> topográfico de la nueva carretera.",
                                "zh": "技术人员已经完成了新公路的地形<w>勘测</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "faire un relevé",
                        "relevé topographique",
                        "relevé de compteur"
                    ],
                    "target_lang_definitions": {
                        "en": "The action of measuring, noting or recording technical data on site, or the document resulting from it.",
                        "ru": "Измерение и запись технических данных на месте или документ, в котором они зафиксированы.",
                        "de": "Das Messen, Erfassen oder Aufnehmen technischer Daten vor Ort oder das Dokument, in dem sie festgehalten werden.",
                        "es": "Acción de medir, anotar o registrar datos técnicos en el lugar, o el documento que los recoge.",
                        "zh": "在现场对技术数据进行测量、记录，或指记录这些数据的文件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "survey",
                                "target_lang_sense_clarification": "site measurement or land survey"
                            },
                            {
                                "target_lang_word": "reading",
                                "target_lang_sense_clarification": "meter or gauge value"
                            }
                        ],
                        "ru": [
