                "senses": [
                    {
                        "sense_id": "65f73bd7-26fc-3fff-8255-2fd77ff20a5a",
                        "entry_id": "b72b5e3a-c46d-33fa-8145-876102cea26f",
                        "glosses": [
                            "Partie du rhombencéphale embryonnaire dont sont issus, au terme du développement embryonnaire, le pont de Varole (dit aussi protubérance annulaire) et le cervelet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf90d9e-10a0-4d87-a0d0-d391fb77027c",
                                "sense_id": "65f73bd7-26fc-3fff-8255-2fd77ff20a5a",
                                "text": "La flexion pontique au terme du 35ᵉ jour de développement divise le rhombencéphale en myélencéphale et en métencéphale."
                            },
                            {
                                "example_id": "eb329b0b-8bed-4c77-b34a-dbf899e2c15d",
                                "sense_id": "65f73bd7-26fc-3fff-8255-2fd77ff20a5a",
                                "text": "Ces noyaux vont faire partie d’un regroupement de noyaux, pour la plupart médians, situés à divers niveaux du tronc cérébral (myélencéphale, métencéphale, mésencéphale) et du diencéphale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26dba84e-48a0-4014-abd9-7c04567c066d",
                        "source_entry_id": "b72b5e3a-c46d-33fa-8145-876102cea26f",
                        "source_sense_id": "65f73bd7-26fc-3fff-8255-2fd77ff20a5a",
                        "source_sense_description": "Sens 1",
                        "target_lang_word": "Metencephalon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metencephalon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d22f822-fd17-343d-9fb1-623c52004fc1",
                                        "entry_id": "c052cefd-5407-361e-af35-b805dad6c2df",
                                        "glosses": [
                                            "der an Rückenmark und Nachhirn (Myelenecephalon) in Richtung zur Großhirnrinde hin anschließende Gehirnteil der Wirbeltiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "126d5e89-7e34-4e32-975c-f7461293bd9b",
                                                "sense_id": "0d22f822-fd17-343d-9fb1-623c52004fc1",
                                                "text": "„Von rostral nach kaudal gliedert sich das Gehirn (Abb. 1-11, 1-12) in ein Endhirn (Telencephalon), Zwischenhirn (Diencephalon), Mittelhirn (Mesencephalon), Hinterhirn (Metencephalon) und Nachhirn (Myelencephalon), das in das Rückenmark (Medulla spinalis) übergeht.“"
                                            },
                                            {
                                                "example_id": "746fcb7b-4ce2-4f07-845a-36061dcd6769",
                                                "sense_id": "0d22f822-fd17-343d-9fb1-623c52004fc1",
                                                "text": "„Bei den Nilhechten (Mormyriden) erreicht das vergrößerte Metencephalon sogar die Vorderhirnzone und wölbt sich über diese hin vor, wobei die Deckplatte als feiner Schleier über der vorderen Hälfte dieses neuen «Großhirns» liegen bleibt […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
