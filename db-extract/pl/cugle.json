                    {
                        "sense_id": "401db196-0188-343a-a9f6-964c8c1540e5",
                        "entry_id": "670d0d75-3d56-3b1a-9204-ca0a6dd49b46",
                        "glosses": [
                            "rzemienne pasy służące do kierowania koniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85efdfc-b8a0-4479-8c28-06a0e6c0d1c6",
                                "sense_id": "401db196-0188-343a-a9f6-964c8c1540e5",
                                "text": "Pierwszy i trzeci szwadron polski skrócił cugle. Broń do ataku!"
                            },
                            {
                                "example_id": "e45f706a-b757-4aa6-bf19-5f296c422290",
                                "sense_id": "401db196-0188-343a-a9f6-964c8c1540e5",
                                "text": "Runął w śnieg i ledwo utrzymał cugle. Po chwili namacał końcem stopy strzemię i gnał za saniami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4ce5e2d-cdb3-4433-9908-1a7813278743",
                        "source_entry_id": "670d0d75-3d56-3b1a-9204-ca0a6dd49b46",
                        "source_sense_id": "401db196-0188-343a-a9f6-964c8c1540e5",
                        "target_lang_word": "rêne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rêne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5740ce5c-526a-3f2f-b01d-e5d533bea671",
                                        "entry_id": "b543b941-8a51-38a1-be4c-33282d49bd75",
                                        "glosses": [
                                            "Courroie fixée au mors d’un cheval et dont le cavalier se sert pour diriger sa monture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb1ea02-b51a-41d7-823a-f5fc3451e7fe",
                                                "sense_id": "5740ce5c-526a-3f2f-b01d-e5d533bea671",
                                                "text": "Pour arrêter le cheval étant au pas, au trot ou au galop, passer du galop au trot ou au pas, du trot au pas, et même pour reculer, la tension des rênes, la pression des jambes, la position des mains et des jambes sont les mêmes, c’est-à-dire que les mains doivent être à la même hauteur et les jambes également en arrière."
                                            },
                                            {
                                                "example_id": "49cfb273-83ca-408f-9a4a-4e09d10cd7b9",
                                                "sense_id": "5740ce5c-526a-3f2f-b01d-e5d533bea671",
                                                "text": "Parfois les rênes s’échappent de nos doigts engourdis, et nos montures aveuglées, tournant le dos à la tempête, refusent d’avancer."
                                            },
                                            {
                                                "example_id": "04ff8538-74ba-4939-896d-c7df2640c8fc",
                                                "sense_id": "5740ce5c-526a-3f2f-b01d-e5d533bea671",
                                                "text": "Objet évoquant l’aspect d’une rêne."
                                            },
                                            {
                                                "example_id": "5e061bb0-78bb-44eb-bbc5-fa8a394600cf",
                                                "sense_id": "5740ce5c-526a-3f2f-b01d-e5d533bea671",
                                                "text": "Tu t’es encore mis cette nuit un papier à papillotes sur le front, hein, mâtine ? Enfin…\nElle lâchait ma rêne de cheveux, s’éloignait de moi pour me mieux voir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2e8edb-7e0f-3938-849f-8c90c5d2ee68",
                                        "entry_id": "b543b941-8a51-38a1-be4c-33282d49bd75",
                                        "glosses": [
                                            "Symbolise le pouvoir que l’on exerce sur quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "formal",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd68339-d477-4f94-9720-a28e34ffe2ad",
                                                "sense_id": "7b2e8edb-7e0f-3938-849f-8c90c5d2ee68",
                                                "text": "Par un hardi coup d’état Si Ahmed Ben Moussa s’était alors emparé du grand-vizirat et des rênes du gouvernement."
                                            },
                                            {
                                                "example_id": "2c15e4b7-bb96-4c34-85c7-655bd897a529",
                                                "sense_id": "7b2e8edb-7e0f-3938-849f-8c90c5d2ee68",
                                                "text": "Quitter les rênes du gouvernement et les remettre en d’autres mains."
                                            },
                                            {
                                                "example_id": "6672842a-4aad-46a6-9ed5-43aa8f6f9b45",
                                                "sense_id": "7b2e8edb-7e0f-3938-849f-8c90c5d2ee68",
                                                "text": "Greg Kroah-Hartman, responsable de manière temporaire du noyau Linux, a publié la version 4.19 du noyau Linux. Mais, c’est Linus Torvalds qui va finalement reprendre les rênes du projet pour le développement de Linux dans ses moutures 4.20 puis 5.0."
                                            }
                                        ]
                                    }
                                ]
                            },
