                "senses": [
                    {
                        "sense_id": "4e3f4a92-585f-3b8b-ae5f-328ff6c0690e",
                        "entry_id": "0f20e4d0-14bc-3f8d-8812-13933e6623b1",
                        "glosses": [
                            "Débarrasser de l’influence de Nicolas Sarkozy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eacdbf8b-437b-4f1e-b781-d4bece45e7bb",
                                "sense_id": "4e3f4a92-585f-3b8b-ae5f-328ff6c0690e",
                                "text": "Or, il sait que si François Fillon devenait président de l’UMP, il s’empresserait de « désarkoïser » le mouvement pour s’affirmer lui-même."
                            },
                            {
                                "example_id": "e6be5499-48de-438e-9ac7-929468b8b826",
                                "sense_id": "4e3f4a92-585f-3b8b-ae5f-328ff6c0690e",
                                "text": "Ils ont cinq mois pour “désarkoïser” l'UMP, peste un fidèle de l'ancien président."
                            },
                            {
                                "example_id": "4ac8223a-34ad-4c15-bb45-d708c5c68ff0",
                                "sense_id": "4e3f4a92-585f-3b8b-ae5f-328ff6c0690e",
                                "text": "Et ils entendent bien tirer un trait sur les années Copé et \"désarkoïser\" le parti comme l'a confié un proche de Fillon au journal Le Monde."
                            }
                        ]
                    }
                ],
