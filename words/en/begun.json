{
    "word_family": [
        "beginner",
        "beginning"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e3198f0-fa17-32ab-93f1-b70ba0b5e8a8",
                    "sense_definition": "The past participle of <w>begin</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concert has already <w>begun</w> so we must be quiet.",
                            "target_lang_translations": {
                                "ru": "Концерт уже <w>начался</w>, поэтому мы должны вести себя тихо.",
                                "zh": "音乐会已经<w>开始</w>了，所以我们必须保持安静。"
                            }
                        },
                        {
                            "text": "They have <w>begun</w> to build a new house down the street.",
                            "target_lang_translations": {
                                "ru": "Они <w>начали</w> строить новый дом в конце улицы.",
                                "zh": "他们已经<w>开始</w>在街那头盖新房子了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "started",
                        "commenced",
                        "initiated"
                    ],
                    "antonyms": [
                        "finished",
                        "ended",
                        "stopped",
                        "concluded"
                    ],
                    "common_phrases": [
                        "has begun",
                        "have begun",
                        "had begun",
                        "just begun"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени глагола <w>begin</w> (начинать).",
                        "zh": "动词 begin 的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начал",
                                "target_lang_sense_clarification": "форма прошедшего времени (активный залог)"
                            },
                            {
                                "target_lang_word": "начался",
                                "target_lang_sense_clarification": "форма прошедшего времени (для событий/процессов)"
                            },
                            {
                                "target_lang_word": "начатый",
                                "target_lang_sense_clarification": "страдательное причастие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开始",
                                "target_lang_sense_clarification": "表示动作或状态的起始"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cf0e603-5504-3549-9401-d7a43e747bbb",
                    "sense_definition": "The simple past of <w>begin</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain <w>begun</w> to fall just as we left the house.",
                            "target_lang_translations": {
                                "ru": "Дождь <w>начался</w> как раз тогда, когда мы вышли из дома.",
                                "zh": "我们刚离开家，雨就<w>开始</w>下了。"
                            }
                        },
                        {
                            "text": "We've no less days to sing God's praise than when we first <w>begun</w>.",
                            "target_lang_translations": {
                                "ru": "У нас не меньше дней, чтобы воспевать хвалу Богу, чем когда мы впервые <w>начали</w>.",
                                "zh": "我们赞美上帝的日子，并不比我们最初<w>开始</w>时少。"
                            }
                        }
                    ],
                    "synonyms": [
                        "started",
                        "commenced"
                    ],
                    "antonyms": [
                        "finished",
                        "ended"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often considered non-standard or dialectal; standard English uses 'began'"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "found in older poetry and hymns"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола <w>begin</w> (устаревшая или разговорная форма).",
                        "zh": "动词 begin 的一般过去式（非标准用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начал",
                                "target_lang_sense_clarification": "устаревшее или просторечное употребление вместо 'began'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开始",
                                "target_lang_sense_clarification": "表示动作或状态的起始"
                            }
                        ]
                    }
                }
            ]
        },
        {
