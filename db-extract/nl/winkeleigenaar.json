                                "example_id": "f2fa8b3c-e3b8-4248-b334-bcc7a3c8bbb2",
                                "sense_id": "0997ab3e-1c40-3581-a581-b83fd4cb9848",
                                "text": "De bakker, de slager en de kruidenier in het dorp waren nog zelfstandige winkeleigenaren en dus niet filiaalhouders voor een grotere keten."
                            },
                            {
                                "example_id": "c413d1b1-78ec-4d1d-baaa-7f3f6f433dd3",
                                "sense_id": "0997ab3e-1c40-3581-a581-b83fd4cb9848",
                                "text": "Hijzelf en vooral Oscar waren evenwel gelouterd als het ging om het hebben van winkeleigenaars als huurders."
                            }
                        ]
