                "senses": [
                    {
                        "sense_id": "6247b234-0808-39ff-9ca9-a9a1e2f6c4c0",
                        "entry_id": "40b89153-9c81-3dfd-a5c9-1867b2310fc0",
                        "glosses": [
                            "to manage to hear"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9abab15c-e248-43c3-9557-9ff4c49152d5",
                                "sense_id": "6247b234-0808-39ff-9ca9-a9a1e2f6c4c0",
                                "text": "Не услыха́ли ли вы́, что́ переда́ли по ра́дио?",
                                "translation": "Did you happen to catch what they said on the radio?",
                                "english": "Did you happen to catch what they said on the radio?"
                            },
                            {
                                "example_id": "5ccc2c78-0c9b-4600-b9c3-697c68e8dd4b",
                                "sense_id": "6247b234-0808-39ff-9ca9-a9a1e2f6c4c0",
                                "text": "— Позво́льте спроси́ть, вы бу́дете на э́том ба́ле? — обрати́лся я к до́чери моего́ знако́мого. Мне хоте́лось услыха́ть звук её го́лоса.",
                                "translation": "'Allow me to ask, will you be at the ball?' I said, turning to my friend's daughter. I wanted to hear the sound of her voice.",
                                "english": "'Allow me to ask, will you be at the ball?' I said, turning to my friend's daughter. I wanted to hear the sound of her voice."
                            }
                        ]
                    }
                ],
