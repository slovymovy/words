{
    "word_family": [
        "uptightness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c75c98d-b8fe-3306-ae5a-0565a2d28e73",
                    "sense_definition": "Anxious, nervous, or unable to relax; emotionally tense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anxious_tense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was feeling very <w>uptight</w> before her big interview and could not sit still.",
                            "target_lang_translations": {
                                "nl": "Ze voelde zich erg <w>gespannen</w> voor haar grote sollicitatiegesprek en kon niet stilzitten.",
                                "de": "Sie fühlte sich vor ihrem wichtigen Vorstellungsgespräch sehr <w>angespannt</w> und konnte nicht stillsitzen."
                            }
                        },
                        {
                            "text": "Whenever he has to speak in public, he gets visibly <w>uptight</w> and defensive.",
                            "target_lang_translations": {
                                "nl": "Telkens wanneer hij in het openbaar moet spreken, wordt hij zichtbaar <w>zenuwachtig</w> en defensief.",
                                "de": "Immer wenn er in der Öffentlichkeit sprechen muss, wird er sichtlich <w>nervös</w> und abweisend."
                            }
                        }
                    ],
                    "synonyms": [
                        "tense",
                        "nervous",
                        "anxious",
                        "strung out"
                    ],
                    "antonyms": [
                        "relaxed",
                        "laid-back",
                        "calm"
                    ],
                    "common_phrases": [
                        "feel uptight",
                        "get uptight"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Gespannen, nerveus of niet in staat om te ontspannen; emotioneel gestrest.",
                        "de": "Ängstlich, nervös oder unfähig, sich zu entspannen; emotional angespannt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gespannen",
                                "target_lang_sense_clarification": "niet ontspannen, nerveus"
                            },
                            {
                                "target_lang_word": "zenuwachtig",
                                "target_lang_sense_clarification": "onrustig, nerveus"
                            },
                            {
                                "target_lang_word": "nerveus",
                                "target_lang_sense_clarification": "angstig of onrustig"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "angespannt",
                                "target_lang_sense_clarification": "emotional oder körperlich unter Druck"
                            },
                            {
                                "target_lang_word": "nervös",
                                "target_lang_sense_clarification": "unruhig und ängstlich"
                            },
                            {
                                "target_lang_word": "verkrampft",
                                "target_lang_sense_clarification": "nicht locker, innerlich blockiert"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6efd32e8-9a92-3b96-aae0-c3d319f0c4eb",
                    "sense_definition": "Excessively concerned with rules and propriety; overly rigid, strict, or serious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rigid_conventional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be so <w>uptight</w>! You won't go to jail for crossing the street against the light.",
                            "target_lang_translations": {
                                "nl": "Doe niet zo <w>krampachtig</w>! Je gaat heus niet naar de gevangenis voor door rood lopen.",
                                "de": "Sei nicht so <w>verkrampft</w>! Du kommst schon nicht ins Gefängnis, wenn du bei Rot über die Straße gehst."
                            }
                        },
                        {
                            "text": "The new manager is far too <w>uptight</w> about minor scheduling details.",
                            "target_lang_translations": {
                                "nl": "De nieuwe manager is veel te <w>strak</w> wat betreft kleine details in de planning.",
                                "de": "Der neue Manager ist bei winzigen Details im Zeitplan viel zu <w>spießig</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "strait-laced",
                        "rigid",
                        "inflexible",
                        "puritanical"
                    ],
                    "antonyms": [
                        "easygoing",
                        "open-minded",
                        "flexible"
                    ],
                    "common_phrases": [
                        "be so uptight",
                        "too uptight"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Overdreven bezorgd over regels en fatsoen; star, krampachtig of overdreven serieus.",
                        "de": "Übertrieben bedacht auf Regeln und Schicklichkeit; übermäßig starr, spießig oder ernst."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "krampachtig",
                                "target_lang_sense_clarification": "star, overdreven strikt"
                            },
                            {
                                "target_lang_word": "stijf",
                                "target_lang_sense_clarification": "formeel en star"
                            },
                            {
                                "target_lang_word": "bekrompen",
                                "target_lang_sense_clarification": "strikt vasthoudend aan regels of normen"
                            },
                            {
                                "target_lang_word": "geremd",
                                "target_lang_sense_clarification": "niet spontaan, terughoudend"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "spießig",
                                "target_lang_sense_clarification": "kleinkariert, engstirnig bezüglich Normen"
                            },
                            {
                                "target_lang_word": "verklemmt",
                                "target_lang_sense_clarification": " gehemmt und überkorrekt"
                            },
                            {
                                "target_lang_word": "verkrampft",
                                "target_lang_sense_clarification": "starr an Regeln festhaltend"
                            },
                            {
                                "target_lang_word": "steif",
                                "target_lang_sense_clarification": "förmlich und unentspannt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83a28d6d-d53d-3d04-ad50-85d3ea4d4f76",
                    "sense_definition": "Hostile, irritable, or snappy toward others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anxious_tense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no reason to get <w>uptight</w> with me when I was just asking a question.",
                            "target_lang_translations": {
                                "nl": "Er is geen reden om <w>katterig</w> tegen me te doen, ik stelde alleen maar een vraag.",
                                "de": "Es gibt keinen Grund, mir gegenüber <w>gereizt</w> zu werden, wenn ich nur eine Frage gestellt habe."
                            }
                        },
                        {
                            "text": "He always becomes <w>uptight</w> and unfriendly when he is stressed about money.",
                            "target_lang_translations": {
                                "nl": "Hij wordt altijd <w>prikkelbaar</w> en onvriendelijk als hij gestrest is over geld.",
                                "de": "Er wird immer <w>unleidlich</w> und unfreundlich, wenn er wegen Geld im Stress ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "touchy",
                        "irritable",
                        "prickly"
                    ],
                    "antonyms": [
                        "friendly",
                        "genial"
                    ],
                    "common_phrases": [
                        "get uptight with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Krikkel, prikkelbaar of vijandig tegenover anderen.",
                        "de": "Feindselig, gereizt oder gereizt-bissig gegenüber anderen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "prikkelbaar",
                                "target_lang_sense_clarification": "lichtgeraakt, snel geïrriteerd"
                            },
                            {
                                "target_lang_word": "kortaf",
                                "target_lang_sense_clarification": "onvriendelijk en snibbig"
                            },
                            {
                                "target_lang_word": "katterig",
                                "target_lang_sense_clarification": "snauwerig en chagrijnig"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gereizt",
                                "target_lang_sense_clarification": "schnell verärgert oder nervös"
                            },
                            {
                                "target_lang_word": "zickig",
                                "target_lang_sense_clarification": "schnippisch und angriffslustig"
                            },
                            {
                                "target_lang_word": "empfindlich",
                                "target_lang_sense_clarification": "dünnhäutig und reizbar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e98ade8-3ecf-3e96-8976-4be274ddb61a",
                    "sense_definition": "Sexually repressed or excessively prudish about sex.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rigid_conventional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He came from a very <w>uptight</w> religious background, but you wouldn't know that now.",
                            "target_lang_translations": {
                                "nl": "Hij kwam uit een heel <w>preutse</w> religieuze achtergrond, maar dat zou je nu niet meer zeggen.",
                                "de": "Er stammte aus einem sehr <w>prüden</w> religiösen Umfeld, aber das würde man heute nicht mehr vermuten."
                            }
                        },
                        {
                            "text": "The culture was surprisingly <w>uptight</w> regarding any mention of romance or intimacy.",
                            "target_lang_translations": {
                                "nl": "De cultuur was verrassend <w>geremd</w> wat betreft elke vermelding van romantiek of intimiteit.",
                                "de": "Die Kultur war überraschend <w>verklemmt</w>, was jede Erwähnung von Romantik oder Intimität anging."
                            }
                        }
                    ],
                    "synonyms": [
                        "prudish",
                        "inhibited"
                    ],
                    "antonyms": [
                        "uninhibited",
                        "liberated"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Seksueel geremd of overdreven preuts.",
                        "de": "Sexuell gehemmt oder übertrieben prüde bei intimen Themen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "preuts",
                                "target_lang_sense_clarification": "overdreven zedig wat betreft seksualiteit"
                            },
                            {
                                "target_lang_word": "geremd",
                                "target_lang_sense_clarification": "niet vrij op seksueel vlak"
                            },
                            {
                                "target_lang_word": "kordaat preuts",
                                "target_lang_sense_clarification": "strak en afwijzend tegenover intimiteit"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "prüde",
                                "target_lang_sense_clarification": "übertrieben sittsam bezüglich Sexualität"
                            },
                            {
                                "target_lang_word": "verklemmt",
                                "target_lang_sense_clarification": "sexuell gehemmt oder unsicher"
                            },
                            {
                                "target_lang_word": "gehemmt",
                                "target_lang_sense_clarification": "zurückhaltend bei körperlicher Nähe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35f0cb9f-8cdd-3fd4-9919-eb13c4e4541a",
                    "sense_definition": "A person who is excessively tense, anxious, or rigid about rules.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rigid_conventional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody wanted to invite that <w>uptight</w> to the party because he would ruin the fun.",
                            "target_lang_translations": {
                                "nl": "Niemand wilde die <w>stijve hark</w> uitnodigen voor het feestje omdat hij de pret zou bederven.",
                                "de": "Niemand wollte diesen <w>Spießer</w> zur Party einladen, weil er den Spaß verderben würde."
                            }
                        },
                        {
                            "text": "The office was full of <w>uptights</w> who objected to any form of music during work hours.",
                            "target_lang_translations": {
                                "nl": "Het kantoor zat vol met <w>zeikerds</w> die bezwaar maakten tegen elke vorm van muziek tijdens werktijd.",
                                "de": "Das Büro war voll von <w>Paragrafenreitern</w>, die etwas gegen jede Form von Musik während der Arbeitszeit hatten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "rare noun usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die overdreven gespannen, star of bezorgd over regeltjes is.",
                        "de": "Eine Person, die übermäßig angespannt, ängstlich oder starrsinnig bezüglich Regeln ist."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "hark",
                                "target_lang_sense_clarification": "stijf, star persoon"
                            },
                            {
                                "target_lang_word": "stijve hark",
                                "target_lang_sense_clarification": "iemand die overdreven formeel of geremd is"
                            },
                            {
                                "target_lang_word": "zeikerd",
                                "target_lang_sense_clarification": "informeel voor een pietluttig of krampachtig persoon"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Spießer",
                                "target_lang_sense_clarification": "engstirnige, überkorrekte Person"
                            },
                            {
                                "target_lang_word": "Stockfisch",
                                "target_lang_sense_clarification": "humorloser, steifer Mensch"
                            },
                            {
                                "target_lang_word": "Paragrafenreiter",
                                "target_lang_sense_clarification": "penible, auf Regeln fixierte Person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}