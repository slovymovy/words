                    {
                        "sense_id": "5947629b-c0fd-315e-88ad-92a763c0c5c0",
                        "entry_id": "80a93e78-c0ac-31fb-9c26-32916a803287",
                        "glosses": [
                            "Cejna Kepreşîne, cejna Holikçêkirinê, cejneke cihûyan ya payîzê ye, kepiran çê dikin û heftiyekê li wêrê dimînin da li bîra wan bimînît ku ew çil salan li çolî man piştî derkeftina wan ji Misrê."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f44347-bbbc-4b84-ab09-e40edd84cd92",
                                "sense_id": "5947629b-c0fd-315e-88ad-92a763c0c5c0",
                                "text": "But when the Jewish Festival of Tabernacles was near"
                            },
                            {
                                "example_id": "7ef13f90-d015-410e-b157-4f3f42a60a12",
                                "sense_id": "5947629b-c0fd-315e-88ad-92a763c0c5c0",
                                "text": "Gava Cejna Holikçêkirinê ya Cihûyan nêzîk bû"
                            },
                            {
                                "example_id": "4f6a7a21-8651-48f4-a75e-20cba3ff7451",
                                "sense_id": "5947629b-c0fd-315e-88ad-92a763c0c5c0",
                                "text": "دەمێ جەژنا كەپرەشینان یا جوهیان نێزیك بووی"
                            },
                            {
                                "example_id": "f7b11736-9371-4449-8277-a8d000ccb0ca",
                                "sense_id": "5947629b-c0fd-315e-88ad-92a763c0c5c0",
                                "text": "Demê Cejna Kepreşînan ya Cuhiyan nêzîk bûyî"
                            }
                        ]
                    }
