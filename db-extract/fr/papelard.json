                    },
                    {
                        "form_id": "307d614e-9db9-44a2-8ec4-558446d1a036",
                        "entry_id": "d16c1528-4c53-3e49-ba5f-167b231b8cad",
                        "tags": [
                            "feminine"
                        ],
                        "form": "papelarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "faabeb75-71d0-3671-99aa-bd2c53d92f6d",
                        "entry_id": "d16c1528-4c53-3e49-ba5f-167b231b8cad",
                        "glosses": [
                            "Hypocrite, dévot en apparence seulement, mauvais chrétien, tartufe."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "957865bc-8836-432e-8420-156911ef2bfc",
                                "sense_id": "faabeb75-71d0-3671-99aa-bd2c53d92f6d",
                                "text": "Ô papelards, qu’on se trompe à vos mines !"
                            },
                            {
                                "example_id": "3e757524-a69f-4f39-9bfd-f863514d79cc",
                                "sense_id": "faabeb75-71d0-3671-99aa-bd2c53d92f6d",
                                "text": "Grattant avec ferveur les cordes sous mes doigts,\n J’entonnai \"le Gorille\" avec \"Putain de toi\".\n Criant à l’imposteur, au traître, au papelard ,\n Elles veulent me faire subir le supplice d’Abélard."
                            },
                            {
                                "example_id": "a7439787-054c-4510-8fa4-f93483907667",
                                "sense_id": "faabeb75-71d0-3671-99aa-bd2c53d92f6d",
                                "text": "Tous ces papelards ne me disent rien qui vaille."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f17328f7-ec25-36e3-b808-97506d51f92c",
                "word": "papelard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c18d5a48-0c9b-4bd5-a9ec-2d2c549d1d01",
                        "entry_id": "f17328f7-ec25-36e3-b808-97506d51f92c",
                        "tags": [
                            "plural"
                        ],
                        "form": "papelards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa35cec9-07fe-3909-8c8f-0e5a25e63946",
                        "entry_id": "f17328f7-ec25-36e3-b808-97506d51f92c",
                        "glosses": [
                            "Papier."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "676b6eca-33f5-452d-af66-048b941179a1",
                                "sense_id": "aa35cec9-07fe-3909-8c8f-0e5a25e63946",
                                "text": "Si ce n’est pas toi qui écris les papelards, ce sera un autre et ça me coûtera moins cher."
                            },
                            {
                                "example_id": "302922fa-cc49-404e-b1a9-078134fd9990",
                                "sense_id": "aa35cec9-07fe-3909-8c8f-0e5a25e63946",
                                "text": "— On pourrait foutre le feu à ses papelards ? proposa Maillat."
                            },
                            {
                                "example_id": "187b6175-ecb5-4e8a-ae07-d454e128e2e6",
                                "sense_id": "aa35cec9-07fe-3909-8c8f-0e5a25e63946",
                                "text": "« Je me fous de vos billettes comme de l’an quarante, disait l’officier. Je sais comment on fait ces papelards. Ce n’est pas à un vieux singe qu’on apprend à faire la grimace »."
                            },
                            {
                                "example_id": "283cda98-4193-44dd-bcc9-e4daa2cd6ae3",
                                "sense_id": "aa35cec9-07fe-3909-8c8f-0e5a25e63946",
                                "text": "Mais avec votre papelard à dix sacs la rame, vous pourrez toujours vous établir marchand de papier, ou vous en servir à ce que je pense, comme ça vous liquiderez votre stock !"
                            },
                            {
                                "example_id": "4a5df008-0c32-470f-b2ca-a7d634c619ac",
                                "sense_id": "aa35cec9-07fe-3909-8c8f-0e5a25e63946",
                                "text": "Nous eûmes droit à de pesants papelards, à d'indigestes tartines démagogiques qui puaient le pernod, le vieux cigare et le fond de culotte."
                            }
                        ]
                    },
                    {
                        "sense_id": "e91b4269-e347-300a-a4ee-2291e85c9b2b",
                        "entry_id": "f17328f7-ec25-36e3-b808-97506d51f92c",
                        "glosses": [
                            "Papier d’identité."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9aa79441-cb2c-45aa-87b4-6719b2bdf0da",
                        "source_entry_id": "f17328f7-ec25-36e3-b808-97506d51f92c",
                        "target_lang_word": "Papierkram",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papierkram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                        "entry_id": "69ea6080-bb28-38aa-b952-7931fb6a1af7",
                                        "glosses": [
                                            "Menge von Schriftstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32968e1-0066-496f-aaad-e064bb24051c",
                                                "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                                "text": "„Auf seinem Schreibtisch zu Hause stapelt sich der Papierkram, …“"
                                            },
                                            {
                                                "example_id": "1be1221c-be70-4092-ba78-6472aa37d8fb",
                                                "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                                "text": "„Aber irgendjemand muss die Hunderte Rechnungen überweisen, die Unterlagen für den Steuerberater vorbereiten, die Mahnungen schreiben, schlicht, den ganzen Papierkram bewältigen.“"
                                            },
                                            {
                                                "example_id": "33606b22-b712-4777-975c-10cd59c75385",
                                                "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                                "text": "„Trotzdem gab es noch jede Menge Stempel und Papierkram zu erledigen, bis ich endlich einreisen konnte.“"
                                            },
                                            {
                                                "example_id": "eb5b34c9-f09f-422f-9c19-3a9f743a8ae5",
                                                "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                                "text": "„Sie saß in Papierkram vertieft bei Hörđur am Schreibtisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
