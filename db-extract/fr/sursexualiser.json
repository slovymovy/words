                "senses": [
                    {
                        "sense_id": "0b8710a6-75e8-36cd-b4e8-03a0ad4842de",
                        "entry_id": "63ce5377-3f4f-399b-a227-018d70fb3602",
                        "glosses": [
                            "Sexualiser de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62c99f4-f62c-4e11-a703-dbe934a69caf",
                                "sense_id": "0b8710a6-75e8-36cd-b4e8-03a0ad4842de",
                                "text": "Il l’accuse de banaliser la sexualité, de \"sursexualiser\" notre environnement, de réduire la sexualité en objet de consommation."
                            },
                            {
                                "example_id": "bbb3da08-2aa1-40cd-a1d7-ec9f9f8db25e",
                                "sense_id": "0b8710a6-75e8-36cd-b4e8-03a0ad4842de",
                                "text": "Et, inversement, les connaissances issues de la clinique sont organisées — viennent se grossir et se sursexualiser pour ainsi dire — par les réalités prototypiques et trans-historiques de la « horde primitive »."
                            }
                        ]
                    }
