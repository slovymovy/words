                    "semantic_group_id": "forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent violent finit par <w>contourner</w> les branches des vieux arbres le long de la côte."
                        },
                        {
                            "text": "L'artisan s'amuse à <w>contourner</w> le métal chaud pour lui donner une forme originale."
