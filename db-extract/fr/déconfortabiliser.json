                ],
                "senses": [
                    {
                        "sense_id": "9625a44f-0987-338b-9b98-f11bc13c7cc2",
                        "entry_id": "bdff9e9c-fcce-3a5d-be6b-9693e708fb13",
                        "glosses": [
                            "Faire perdre son caractère confortable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e452d4-98e8-48a3-aa17-a319ffb10cb6",
                                "sense_id": "9625a44f-0987-338b-9b98-f11bc13c7cc2",
                                "text": "Nous ne voulons pas avoir avec nous des gens qui ne veulent pas se dépayser, se déconfortabiliser… mais nous sommes très bien avec l’idée d’augmenter la zone d’émerveillement de ces gens qui veulent bien pousser un peu."
                            },
                            {
                                "example_id": "c8d377fd-c0af-49e1-8153-f18708c40f8e",
                                "sense_id": "9625a44f-0987-338b-9b98-f11bc13c7cc2",
                                "text": "L’ambitieux nous désécurise sans le vouloir, nous fait ouvrir les yeux. Il déconfortabilise, donc relance le questionnement que trop de satiété tarit."
                            },
                            {
                                "example_id": "b6afa76c-a4fd-459b-a712-64921600e326",
                                "sense_id": "9625a44f-0987-338b-9b98-f11bc13c7cc2",
                                "text": "Son intérêt n’est pas de délivrer un message fort mais de créer le doute, de remettre en cause, de « déconfortabiliser » le quotidien."
                            }
                        ]
                    }
                ],
