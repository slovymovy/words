                        "glosses": [
                            "Femme trans."
                        ],
                        "tags": [
                            "pejorative",
                            "rare"
                        ],
                        "note": "L’usage de ce terme, plutôt que femme trans, sous-entend que les femmes trans ne sont pas des femmes, d’où l’utilisation de trans- comme préfixe pour les différencier des femmes",
                        "examples": [
                            {
                                "example_id": "fdbef47d-eab0-4e7b-ac48-a6771af67700",
                                "sense_id": "443fd6b0-d7ab-3fe7-afe2-73fb0dc0fda8",
                                "text": "Vous avez amené un transfemme à être considéré comme suffisamment femme pour être admis dans une prison pour femmes."
                            },
                            {
                                "example_id": "3e7bbe35-e070-46e9-bd7f-31a41e33bc2e",
                                "sense_id": "443fd6b0-d7ab-3fe7-afe2-73fb0dc0fda8",
                                "text": "Et pour cause puisque chaque transfemme activiste est un homme..."
                            },
                            {
                                "example_id": "b6367e1b-8ca9-4e2c-861a-84a9b8b92aae",
                                "sense_id": "443fd6b0-d7ab-3fe7-afe2-73fb0dc0fda8",
                                "text": "La célèbre transfemme Christa Muth s'indigne que le buvetier du FC Morat puisse perdre son poste à cause de sa transition de genre."
                            }
                        ]
                    }
