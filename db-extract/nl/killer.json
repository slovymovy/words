                        ]
                    },
                    {
                        "translation_id": "3f7e1405-54c1-48af-be1f-d35d1fb1b9e1",
                        "source_entry_id": "3637303a-a568-3519-a730-ccd220b27b41",
                        "source_sense_id": "c6d7df33-d73e-3245-a2a9-b925efdb6092",
