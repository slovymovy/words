                                "example_id": "7835fc07-9998-4109-98df-db51bc15ff79",
                                "sense_id": "9ba94add-8e84-3768-8f5a-a218b6b84d7a",
                                "text": "Avec l’idéalisme rousseauesque des Lettres d’un cultivateur américain de St John Crèvecœur, penser s’installer en Amérique et y créer une colonie agricole allait apparaître tout naturel."
                            },
                            {
                                "example_id": "7733afdf-5846-48d9-9a27-f344ecc8ce55",
                                "sense_id": "9ba94add-8e84-3768-8f5a-a218b6b84d7a",
                                "text": "Nous essayons de protéger le mythe de l’humanisme occidental, le mythe rousseauesque de la bonté naturelle et primitive de l’homme."
                            }
                        ]
                    }
