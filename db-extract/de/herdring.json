                "senses": [
                    {
                        "sense_id": "473b8e18-c968-33ed-8ade-aaa16d4f1fbe",
                        "entry_id": "784ae74f-d12f-3610-9f51-23131c1d65d8",
                        "glosses": [
                            "Metallring, mit dem die offene Feuerfläche eines Herdes (zum Beispiel eines Kohleherdes) vergrößert oder verkleinert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f40d0a-0d5d-4254-bdf1-e1689a13c838",
                                "sense_id": "473b8e18-c968-33ed-8ade-aaa16d4f1fbe",
                                "text": "„Frau Mörschel schob die Pfanne beiseite und hantierte mit den Herdringen.“"
                            },
                            {
                                "example_id": "e9ca57f1-b3c2-47b8-9e7b-699f1c1c8447",
                                "sense_id": "473b8e18-c968-33ed-8ade-aaa16d4f1fbe",
                                "text": "„Die Mutter ließ die Herdringe klappern, zaghafter als die Großmutter, aber immerhin.“"
                            },
                            {
                                "example_id": "959b53bc-3541-4486-91f8-230fe9f9d009",
                                "sense_id": "473b8e18-c968-33ed-8ade-aaa16d4f1fbe",
                                "text": "„Eine Petroleumlampe hing in der Küche an dem Balken, und aus den Herdringen lohte die Glut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
