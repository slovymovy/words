                        "glosses": [
                            "Action de cocheniller ; résultat de cette action."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b91b5e78-7c46-47b0-ae56-3e97c1b61be0",
                                "sense_id": "b31a6570-8864-3a3c-9134-6a750a19e046",
                                "text": "Il faut bien laver l'étoffe de cochenille , puis la passer sur un bain frais , avec le brésil cuit qu'on donne plus ou moins fort, selon le commencement du cochenillage, et cela avec jugement."
                            }
                        ]
                    },
