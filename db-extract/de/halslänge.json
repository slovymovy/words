                ],
                "senses": [
                    {
                        "sense_id": "45ccde83-b147-3810-9951-8228ab7d1a83",
                        "entry_id": "dbe21904-ca2b-3c3c-8dc2-a3cd77a62aca",
                        "glosses": [
                            "Länge des Körperteiles von Kopf bis Rumpf (besonders von Pferden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee899c6-643f-4c81-be26-b76f4dd48cfb",
                                "sense_id": "45ccde83-b147-3810-9951-8228ab7d1a83",
                                "text": "„Der Schwan jedoch sprang auf und schnappte dem laufenden Hündchen hinterher und, begünstigt mit seiner Halslänge, erwischte er das kleine Hinterteil, hielt ordentlich fest und zog das Fellchen in beachtliche Länge.“"
                            },
                            {
                                "example_id": "570d8bc6-60d4-4f1b-bec7-c0f322e346d8",
                                "sense_id": "45ccde83-b147-3810-9951-8228ab7d1a83",
                                "text": "„Selbst die Halslänge von Giraffenfossilien erzählt eine Geschichte: Die Länge des Halses besagt etwas darüber, ob große oder kleine Bäume vorhanden waren.“"
                            },
                            {
                                "example_id": "7bbed282-a9cd-4470-8d5a-399eb02aaca2",
                                "sense_id": "45ccde83-b147-3810-9951-8228ab7d1a83",
                                "text": "„Cunninghams Stute kämpfte sich verbissen vor und hängte die Führungsspitze um eine Halslänge ab.“"
                            },
                            {
                                "example_id": "416bb8c7-a0bd-46bd-8681-5755f8d58d24",
                                "sense_id": "45ccde83-b147-3810-9951-8228ab7d1a83",
                                "text": "„In einer Population von Pflanzenfressern mit verschiedenen Halslängen wird beispielweise der Anteil der ‚Langhalsigen‘ im Falle einer Futterknappheit zunehmen, da diese in der Lage sind, höhergelegene Äste an Bäumen zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
