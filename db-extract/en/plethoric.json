                    {
                        "form_id": "3e3f1314-dc6b-4991-b1fd-0894a64dfc64",
                        "entry_id": "6839576b-e14a-35ca-ba55-c4140bea4829",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most plethoric"
