                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b180c38-563e-3ef3-8a1b-9044651a5756",
                        "entry_id": "3cf8649d-2634-3024-b8a4-05331751c7c6",
                        "glosses": [
                            "Qui vacille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1864b611-6810-4162-ad81-0c324d6b07a3",
                                "sense_id": "8b180c38-563e-3ef3-8a1b-9044651a5756",
                                "text": "Démarche vacillante."
                            },
                            {
                                "example_id": "e5bda38f-7fd0-47c0-b3d3-ce6db9f94198",
                                "sense_id": "8b180c38-563e-3ef3-8a1b-9044651a5756",
                                "text": "À cette heure-là de la soirée en outre, l’éclairage affaibli des lampes qui pendaient au bout des poteaux vacillants rendait le coin sinistre et inquiétant."
                            },
                            {
                                "example_id": "0b23ad21-1af4-44dc-8817-5f9b12eb12bf",
                                "sense_id": "8b180c38-563e-3ef3-8a1b-9044651a5756",
                                "text": "Tous tenaient à la main droite ou des épées, ou des piques, ou des arquebuses, et quelques-uns, à la main gauche, des flambeaux qui répandaient sur cette scène un jour funèbre et vacillant."
                            },
                            {
                                "example_id": "2ce68083-ecfd-4379-9bdb-5efaaaf61cec",
                                "sense_id": "8b180c38-563e-3ef3-8a1b-9044651a5756",
                                "text": "L’image de Clarisse se dressa, confuse et douloureuse, comme au fond d’une petite chapelle ornée de cierges vacillants près desquels il irait prier de temps en temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c86c9a1-de70-3b33-9cb7-f2c5c66f88d4",
                        "entry_id": "3cf8649d-2634-3024-b8a4-05331751c7c6",
                        "glosses": [
                            "Qui est incertain, irrésolu, chancelant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bb519e6a-bea1-427a-b8a6-0e031179f436",
                                "sense_id": "7c86c9a1-de70-3b33-9cb7-f2c5c66f88d4",
                                "text": "Esprit vacillant."
                            },
                            {
                                "example_id": "dc796622-05fe-422c-9c3c-4c8f1f450ed5",
                                "sense_id": "7c86c9a1-de70-3b33-9cb7-f2c5c66f88d4",
                                "text": "Ces témoins sont vacillants dans leurs dépositions."
                            }
                        ]
                    }
                ],
