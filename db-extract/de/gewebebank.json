                "senses": [
                    {
                        "sense_id": "a420a931-1607-37a7-8fab-4f30a1e3d020",
                        "entry_id": "d3c93405-9f9d-350e-890d-681e45cfc403",
                        "glosses": [
                            "Einrichtung, in der menschliches oder tierisches Gewebe aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "513826ec-9734-43c8-8233-146023f39aed",
                                "sense_id": "a420a931-1607-37a7-8fab-4f30a1e3d020",
                                "text": "„Hüftköpfe sind als Rohmaterial für die Gewebebank begehrt.“"
                            },
                            {
                                "example_id": "9ab483a6-e1fb-4639-9b10-3b040759269d",
                                "sense_id": "a420a931-1607-37a7-8fab-4f30a1e3d020",
                                "text": "„In der Gewebebank seien 2017 rund 1100 Augenhornhäute aufbereitet worden.“"
                            },
                            {
                                "example_id": "74df2b65-bd23-4eba-8b0f-307c0ea994f5",
                                "sense_id": "a420a931-1607-37a7-8fab-4f30a1e3d020",
                                "text": "„Knapp drei Jahre nach Gründung der Gewebebank Mecklenburg-Vorpommern (GBM-V) ist in dieser Woche die tausendste Augenhornhaut transplantiert worden.“"
                            },
                            {
                                "example_id": "d32fcdc9-7a51-4614-b7fa-bca73359869e",
                                "sense_id": "a420a931-1607-37a7-8fab-4f30a1e3d020",
                                "text": "„Daraufhin konnten 14 infizierte Patienten identifiziert werden, die Material aus der gleichen Gewebebank erhalten hatten.“"
                            },
                            {
                                "example_id": "831f38aa-f981-4837-b44d-63aa1c79fd96",
                                "sense_id": "a420a931-1607-37a7-8fab-4f30a1e3d020",
                                "text": "„Vom einstigen Lebewesen selbst bleibt dabei immer weniger übrig: beatmete Körper, Gewebebanken, Zellkulturen, klonierte Gene.“"
                            },
                            {
                                "example_id": "e25d1798-3330-4b62-9f56-62b09db03c37",
                                "sense_id": "a420a931-1607-37a7-8fab-4f30a1e3d020",
                                "text": "„Von größerem Nutzen scheint es zu sein, Teile seines Körpers auf einer ganz besonderen Bank zu deponieren, einer Gewebebank.“"
                            },
                            {
                                "example_id": "f18abf78-0863-46e0-b81c-cfe180af7875",
                                "sense_id": "a420a931-1607-37a7-8fab-4f30a1e3d020",
                                "text": "„Auch eine Gewebebank mit sorgfältig charakterisierten Tumorproben ist im Aufbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
