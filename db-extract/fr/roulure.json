        "fr-extract.jsonl": [
            {
                "entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                "word": "roulure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e8ebc95-73fa-4675-a498-429b52b348b4",
                        "entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "tags": [
                            "plural"
                        ],
                        "form": "roulures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f928604d-9bb3-3bc6-abbb-79eeaccacf3c",
                        "entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "glosses": [
                            "Action de rouler, état de ce qui est roulé."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "448cf3c1-d6a2-37f2-8414-b9718584e978",
                        "entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "glosses": [
                            "Défaut de grume apparaissant lorsque des cernes n’adhèrent pas l’une à l’autre ; sur bois vif, ce défaut se remplit de fluide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684f13b1-1517-4b48-98a8-422b78a0e4a8",
                                "sense_id": "448cf3c1-d6a2-37f2-8414-b9718584e978",
                                "text": "La roulure peut être provoquée par des efforts mécaniques (vent) qui tendent à plier l’arbre dont les cernes sont d’épaisseurs irrégulières."
                            }
                        ]
                    },
                    {
                        "sense_id": "90292a1e-6d27-3cdd-bc4b-57a3db450c48",
                        "entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "glosses": [
                            "Femme de mauvaise vie, prostituée."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "462c7fef-2dbc-42b0-8a7a-e33116148aae",
                                "sense_id": "90292a1e-6d27-3cdd-bc4b-57a3db450c48",
                                "text": "C’était Satin, avec un chapeau et une voilette, prenant des airs de dame en visite. Une jolie roulure ! murmura Prullière."
                            },
                            {
                                "example_id": "d0a500ae-635e-4f19-a5b8-2e9b4a9159b4",
                                "sense_id": "90292a1e-6d27-3cdd-bc4b-57a3db450c48",
                                "text": "Entre parenthèses on assure que j’ai lâché ignominieusement ma femme pour aller vivre aux crochets d’une roulure."
                            },
                            {
                                "example_id": "4b6f9f4b-fbfb-4819-b774-5f8df03ad350",
                                "sense_id": "90292a1e-6d27-3cdd-bc4b-57a3db450c48",
                                "text": "La fille de bar dont je fus amoureux à quinze ans, parce qu'elle était lesbienne, qu'elle avait une voix éraillée et que je l`avais entendue geindre durant une rage de dents, – vague roulure qui purement et simplement m’entôla, ne couchant même pas avec moi et s`enfuyant avec l`argent que, comme un jobard, je lui avais donné, ce qui inimaginablement m`humilia."
                            },
                            {
                                "example_id": "6a4e47b1-6556-4f60-ab44-516ff73d5231",
                                "sense_id": "90292a1e-6d27-3cdd-bc4b-57a3db450c48",
                                "text": "Raphaële, une Marseillaise, roulure des ports de mer, jouait le rôle indispensable de la belle Juive, maigre, avec des pommettes saillantes plâtrées de rouge."
                            },
                            {
                                "example_id": "6417c6e7-a55b-4f8e-9530-dfd4a3eac659",
                                "sense_id": "90292a1e-6d27-3cdd-bc4b-57a3db450c48",
                                "text": "\"Une roulure !\" murmura Claude de son air de mépris."
                            }
                        ]
                    },
                    {
                        "sense_id": "06ef53e2-8386-3363-ba67-dde79d8b387e",
                        "entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "glosses": [
                            "Personne méprisable."
                        ],
                        "tags": [
                            "broadly",
                            "familiar",
                            "offensive",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "cea12d5c-f0d7-4ad5-80ac-30ac5f798fa8",
                                "sense_id": "06ef53e2-8386-3363-ba67-dde79d8b387e",
                                "text": "Eh bien, toutes ces gonzesses, c’est rien. T’as pas idée ! C’est moins que rien : des ordures, des roulures, bonnes à t’entuber comme personne, si peu qu’tu lâches la main."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "300f98b9-ebf7-4dea-9dbb-90eb01d7db91",
                        "source_entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "source_sense_id": "448cf3c1-d6a2-37f2-8414-b9718584e978",
