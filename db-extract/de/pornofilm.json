                        "examples": [
                            {
                                "example_id": "fc57b95e-6434-4742-a312-f7a539964beb",
                                "sense_id": "51e980fb-a7e7-3354-8109-b332b8221af0",
                                "text": "„Aus dem Westen eingeschmuggelte Pornofilme wurden mit selbstgebastelter Heimstudiotechnik kopiert und im privaten Kreis vorgeführt.“"
                            },
                            {
                                "example_id": "e1b0ea17-c568-4b0e-9439-c8dd877c2023",
                                "sense_id": "51e980fb-a7e7-3354-8109-b332b8221af0",
                                "text": "„Die Callgirls erhoben sich allesamt so verlegen, als hätte man ihnen gerade einen Pornofilm gezeigt.“"
                            },
                            {
                                "example_id": "f7eab533-c9cc-40e0-950d-0707e121631b",
                                "sense_id": "51e980fb-a7e7-3354-8109-b332b8221af0",
                                "text": "„Man begehrt die Frau in einem Pornofilm, doch man ist nicht eifersüchtig auf den Mann, der sie vögelt, weil er ein Ersatz für einen selbst ist.“"
                            },
                            {
                                "example_id": "7d0593aa-88bf-4bf9-9e9d-9aaddc768832",
                                "sense_id": "51e980fb-a7e7-3354-8109-b332b8221af0",
                                "text": "„Eines (fernen) Tages würde ich im Internet Pornofilme sehen und dabei Männer beobachten, die sich noch immer aufführen wie ich damals: Triebglühende Tiere, die umstandslos ins Weibchen fahren und mit Vollgas ihr Geschäft erledigen.“"
                            },
                            {
                                "example_id": "6f6fdbb9-0e61-4f8c-ad1d-099690ee1909",
                                "sense_id": "51e980fb-a7e7-3354-8109-b332b8221af0",
                                "text": "„Die Geräusche dauern schon so lange an, dass es sich um einen Pornofilm handeln muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
