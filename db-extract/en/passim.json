                                        "sense_id": "5c9e0aa0-6a91-37ff-a94e-de5b3af0bda3",
                                        "entry_id": "24b7b6d7-1c8b-38a7-86ad-f24d6bcd00ee",
                                        "glosses": [
                                            "(latin employé parfois en français avec la même signification) Çà et là, en différents endroits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea28ff0-ee7c-4142-bd10-0868f2865edf",
                                                "sense_id": "5c9e0aa0-6a91-37ff-a94e-de5b3af0bda3",
                                                "text": "Les autres convives européens ou asiatiques sont installés passim, avec l’évidente intention de faire honneur à ce repas."
                                            },
                                            {
                                                "example_id": "03b60c0e-806a-4e68-8051-8fac40290e0f",
                                                "sense_id": "5c9e0aa0-6a91-37ff-a94e-de5b3af0bda3",
                                                "text": "Je mordais ton ventre et ton torse gibbeux et passim…"
                                            },
                                            {
                                                "example_id": "f24d510a-7ef4-4e8c-aabb-e20462fcff25",
                                                "sense_id": "5c9e0aa0-6a91-37ff-a94e-de5b3af0bda3",
                                                "text": "Mais elle avait écrit aussi qu’il était vieux et las, qu’elle-même aimait le plaisir, tout en notant, passim, que le moine, de mœurs paillardes, était le fort jeune cadet de son époux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5603c94b-3604-45fe-b055-f9319f12a318",
                        "source_entry_id": "36a1c3e6-6e2b-39cd-a127-5d8c017afbbb",
                        "source_sense_id": "ab69941c-f57e-38ed-a276-e905a9a86722",
                        "source_sense_description": "here and there",
                        "target_lang_word": "passim",
