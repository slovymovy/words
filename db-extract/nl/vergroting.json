                                                "sense_id": "3a9093e6-6d4d-3f93-87d0-0eda2555ddee",
                                                "text": "Go, tenderness of years; take this key, give enlargement to the swain, bring him festinately hither."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b9d621-f628-3681-8646-b8736d3db862",
