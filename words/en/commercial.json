    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b72034f-3677-32e6-84d8-bbd3dcf9f794",
                    "sense_definition": "Relating to business and the buying and selling of goods and services.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is a major <w>commercial</w> center for the entire region.",
                            "target_lang_translations": {
                                "ru": "Город является крупным <w>торговым</w> центром для всего региона.",
                                "tr": "Şehir, tüm bölge için önemli bir <w>ticari</w> merkezdir."
                            }
                        },
                        {
                            "text": "They decided to turn their hobby into a <w>commercial</w> venture to make money.",
                            "target_lang_translations": {
                                "ru": "Они решили превратить свое хобби в <w>коммерческое</w> предприятие, чтобы заработать денег.",
                                "tr": "Para kazanmak için hobilerini <w>ticari</w> bir girişime dönüştürmeye karar verdiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "business",
                        "mercantile",
                        "trade"
                    ],
                    "antonyms": [
                        "noncommercial"
                    ],
                    "common_phrases": [
                        "commercial bank",
                        "commercial use",
                        "commercial success",
                        "commercial vehicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к бизнесу, торговле и купле-продаже товаров и услуг.",
                        "tr": "Ticaret, iş dünyası ve mal/hizmet alım satımı ile ilgili olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комме́рческий",
                                "target_lang_sense_clarification": "относящийся к получению прибыли"
                            },
                            {
                                "target_lang_word": "торго́вый",
                                "target_lang_sense_clarification": "относящийся к торговле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ticari",
                                "target_lang_sense_clarification": "ticaret veya iş ile ilgili"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28c7762c-6c50-3cb2-9599-676da357a518",
                    "sense_definition": "Relating to the public transport of passengers or cargo by air.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wants to become a <w>commercial</w> pilot after finishing flight school.",
                            "target_lang_translations": {
                                "ru": "Он хочет стать <w>коммерческим</w> пилотом после окончания летной школы.",
                                "tr": "Uçuş okulunu bitirdikten sonra <w>ticari</w> pilot olmak istiyor."
                            }
                        },
                        {
                            "text": "There are no <w>commercial</w> flights to the island during the winter season.",
                            "target_lang_translations": {
                                "ru": "В зимний сезон на остров нет <w>коммерческих</w> рейсов.",
                                "tr": "Kış sezonunda adaya <w>ticari</w> uçuş bulunmamaktadır."
                            }
                        }
                    ],
                    "synonyms": [
                        "civil"
                    ],
                    "antonyms": [
                        "military",
                        "private"
                    ],
                    "common_phrases": [
                        "commercial flight",
                        "commercial airline",
                        "commercial pilot",
                        "commercial airport"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к общественным воздушным перевозкам пассажиров или грузов.",
                        "tr": "Yolcu veya yükün hava yoluyla genel taşımacılığı ile ilgili olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражда́нский",
                                "target_lang_sense_clarification": "не военный"
                            },
                            {
                                "target_lang_word": "комме́рческий",
                                "target_lang_sense_clarification": "платный, пассажирский"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ticari",
                                "target_lang_sense_clarification": "yolcu veya yük taşıyan, yolcu/yük uçuşlarına dair"
                            },
                            {
                                "target_lang_word": "sivil",
                                "target_lang_sense_clarification": "askeri olmayan havacılık"
                            }
