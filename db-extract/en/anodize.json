                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a252883a-9ffb-4d7e-954a-4e0ae2b1d9a1",
                        "source_entry_id": "814e3193-7759-3a1e-a969-99b40598a73b",
                        "source_sense_id": "8da0384a-6241-326b-991c-be1349c594e3",
                        "source_sense_description": "to coat the surface of a metal electrolytically with an oxide",
                        "target_lang_word": "eloxieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eloxieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d408bf-5105-3cc9-a1c3-f852ca971a8d",
                                        "entry_id": "332f17af-455e-36be-bb6a-55958affcebf",
                                        "glosses": [
                                            "Erzeugen einer Schutzschicht auf der Oberfläche von Aluminium und Magnesium und deren Legierungen durch Oxidation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a35af82d-0012-46b8-bce6-c69237ae4879",
                                                "sense_id": "c7d408bf-5105-3cc9-a1c3-f852ca971a8d",
                                                "text": "Vor dem Eloxieren muss das Aluminium entfettet werden. Meist wird das Rohling danach silbern eloxiert, es gehen aber auch alle anderen Farben."
                                            },
                                            {
                                                "example_id": "ff1413c4-1fef-4f64-a47f-1bab416b2124",
                                                "sense_id": "c7d408bf-5105-3cc9-a1c3-f852ca971a8d",
                                                "text": "Wir eloxieren auch seltene Legierungen in allen Farben."
                                            },
                                            {
                                                "example_id": "d3859876-12ca-4c2c-b9a3-5fe51f33fd9e",
                                                "sense_id": "c7d408bf-5105-3cc9-a1c3-f852ca971a8d",
                                                "text": "„Um sich abzuheben, lassen einige [Autoenthusiasten] die Felgen lackieren, eloxieren, pulverbeschichten oder sogar vergolden.“"
                                            },
                                            {
                                                "example_id": "90df7f83-8a4f-4c85-91a3-ce3078d75ffb",
                                                "sense_id": "c7d408bf-5105-3cc9-a1c3-f852ca971a8d",
                                                "text": "„So bin ich auf Aluminium gekommen und konnte dann mit dem Volumen dieses Materials spielen und es farbig eloxieren.“"
                                            },
                                            {
                                                "example_id": "3a7d44a9-79d0-49b1-a990-bac8172c9736",
                                                "sense_id": "c7d408bf-5105-3cc9-a1c3-f852ca971a8d",
                                                "text": "„In den meisten Fällen wird man aber bei Stahlfenstern mit einer weniger dekorativ wirkenden, aber preiswerter zu gestaltenden Oberflächenbehandlung auskommen und die Leisten technisch, d. h. ohne mechanische Vorbehandlung, eloxieren.“"
                                            },
                                            {
                                                "example_id": "47e82d9e-a20d-48a8-ae1f-73409de980a8",
                                                "sense_id": "c7d408bf-5105-3cc9-a1c3-f852ca971a8d",
                                                "text": "„Diese Überzüge, die sich an sich gut polieren und auch eloxieren lassen, sind zur Zeit jedoch noch nicht porenfrei herzustellen, so daß eine Verwendung so hergestellter bzw. behandelter Teile nur für mäßige Korrosionsbeanspruchung in Frage kommen kann, da anderenfalls an den Undichtigkeiten die Korrosion durch Lokalelementbildung noch ganz wesentlich verstärkt wird.“"
                                            },
                                            {
                                                "example_id": "54ce8882-1f6f-4725-8714-c56d2285113b",
                                                "sense_id": "c7d408bf-5105-3cc9-a1c3-f852ca971a8d",
                                                "text": "„Nur eine einzige Oberflächenvorbehandlung - eloxieren in Phosphorsäure-Lösung (PAA) - führte zu einer Verringerung von etwa 40% der Festigkeit der Verbindung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
