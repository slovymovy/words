{
    "word_family": [
        "sacrifice",
        "sacrificiel",
        "sacrificateur",
        "sacrificatrice",
        "sacrifiable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab1820ad-e168-34c2-b84f-e1cbb5f51ce6",
                    "sense_definition": "Renoncer volontairement à un bien, un avantage ou une opportunité pour une personne ou une cause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "renoncement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>sacrifier</w> ses vacances pour aider ses parents à la ferme."
                        },
                        {
                            "text": "Ce soldat courageux a accepté de <w>sacrifier</w> sa vie pour sauver ses camarades."
                        }
                    ],
                    "common_phrases": [
                        "sacrifier sa vie",
                        "sacrifier son temps",
                        "sacrifier ses intérêts"
                    ]
                },
                {
                    "sense_id": "cf38e867-4199-3a10-8b31-fce2bf6fc5ee",
                    "sense_definition": "Offrir rituellement une victime animale, humaine ou un objet à une divinité dans un acte religieux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les prêtres de l'Antiquité aimaient <w>sacrifier</w> un agneau pour calmer la colère des dieux."
                        },
                        {
                            "text": "Dans ce récit biblique, Abraham s'apprête à <w>sacrifier</w> son propre fils par obéissance."
                        }
                    ],
                    "synonyms": [
                        "sacrificier"
                    ],
                    "common_phrases": [
                        "sacrifier aux dieux",
                        "sacrifier une victime"
                    ]
                },
                {
                    "sense_id": "943f06b3-a57c-3482-8f6a-57339e76bccb",
                    "sense_definition": "Se dévouer entièrement à autrui ou à un idéal, au détriment de son propre bien-être ou de sa sécurité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renoncement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces parents aimants ont choisi de se <w>sacrifier</w> pour assurer un bel avenir à leurs enfants."
                        },
                        {
                            "text": "Il est prêt à se <w>sacrifier</w> pour faire triompher la vérité."
                        }
                    ],
                    "common_phrases": [
                        "se sacrifier pour autrui"
                    ]
                },
                {
                    "sense_id": "b4a216a4-0290-3e92-a6d5-258ed7ad076e",
                    "sense_definition": "Faire d'une personne ou d'un groupe la victime d'un calcul politique, d'une décision ou d'un dessein.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "perte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a préféré <w>sacrifier</w> son conseiller pour étouffer le scandale financier."
                        },
                        {
                            "text": "L'entraîneur a dû <w>sacrifier</w> un joueur défensif afin de renforcer l'attaque en fin de match."
                        }
                    ],
                    "common_phrases": [
                        "sacrifier un pion",
                        "sacrifier un subalterne"
                    ]
                },
                {
                    "sense_id": "ed7b763b-1d2a-3158-9423-4dd919c8fab4",
                    "sense_definition": "Céder à une habitude, se conformer par complaisance ou convention à une pratique ou une tendance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conformisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain refuse catégoriquement de <w>sacrifier</w> à la mode du moment dans son nouveau roman."
                        },
                        {
                            "text": "Pour plaire à ses invités, elle a fini par <w>sacrifier</w> à la tradition des longs discours."
                        }
                    ],
                    "common_phrases": [
                        "sacrifier à la mode",
                        "sacrifier à la tradition",
                        "sacrifier au rituel"
                    ]
                }
            ]
        }
    ]
}