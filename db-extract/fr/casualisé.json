                "senses": [
                    {
                        "sense_id": "a0b121d2-05e0-380e-940a-aa5913a15956",
                        "entry_id": "2455ff78-2a79-3f21-84f0-30c74a0b4cc8",
                        "glosses": [
                            "Qui est réparti de façon casuelle, au hasard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b59c12d-5067-4d2a-b90e-8f4357b1b946",
                                "sense_id": "a0b121d2-05e0-380e-940a-aa5913a15956",
                                "text": "Les blocs casualisés ont été imaginés en premier lieu pour répondre aux nécessités de l’expérimentation agronomique. C’est de là d’ailleurs que vient l’expression « blocs casualisés » (« randomized blocks »)."
                            },
                            {
                                "example_id": "6fd2395a-9c37-4fa0-bcc8-b107e4a8b6ce",
                                "sense_id": "a0b121d2-05e0-380e-940a-aa5913a15956",
                                "text": "On adopte un dispositif casualisé, 4 objets (3 programmes dont 2 sous-objets), 8 répétitions."
                            },
                            {
                                "example_id": "1ed2651d-8fd1-4e57-9799-7dccd45b5677",
                                "sense_id": "a0b121d2-05e0-380e-940a-aa5913a15956",
                                "text": "Le dispositif expérimental était un bloc casualisé à 8 traitements avec 3 répétitions. Les traitements consistaient à laisser les mauvaises herbes en libre croissance avec le maïs pour différentes périodes au cours de la saison."
                            }
                        ]
                    },
                    {
                        "sense_id": "23715819-0352-3ab4-99af-25896bf10864",
                        "entry_id": "2455ff78-2a79-3f21-84f0-30c74a0b4cc8",
                        "glosses": [
                            "Qui jouit d’un casuel."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "47d26fc8-ba67-3dd9-9659-f85a8a79d958",
                        "entry_id": "2455ff78-2a79-3f21-84f0-30c74a0b4cc8",
                        "glosses": [
                            "Qui est soumis au casuel, à un paiement rétributif."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e9cab276-dd83-4822-9b67-5e109c3395c0",
                                "sense_id": "47d26fc8-ba67-3dd9-9659-f85a8a79d958",
                                "text": "L’église romaine a tout casualisé au profit de ses prêtres."
                            }
                        ]
                    }
