                "senses": [
                    {
                        "sense_id": "09610ea0-cbc8-30b3-a0a4-2435388de5e1",
                        "entry_id": "2f5955fd-cc7b-3175-82cc-3b43376fae8b",
                        "glosses": [
                            "Übergang von einem Besitzer zum nächsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac605024-5ead-4b7c-9a0d-e2dd55668c53",
                                "sense_id": "09610ea0-cbc8-30b3-a0a4-2435388de5e1",
                                "text": "„Und beim Gemeindezentrum St. Trinitatis in Gestringen ist die Kuh noch nicht vom Eis, es fehlt eine mögliche Nachfolgelösung mit Besitzerwechsel.“"
                            },
                            {
                                "example_id": "d957e980-d04f-4f4b-89f4-b22c8aec93ca",
                                "sense_id": "09610ea0-cbc8-30b3-a0a4-2435388de5e1",
                                "text": "„Sie war vielleicht noch nicht einmal geboren gewesen, als der Besitzerwechsel stattgefunden hatte.“"
                            },
                            {
                                "example_id": "f52b6b1f-98fa-4860-97b3-cdb09c405e9d",
                                "sense_id": "09610ea0-cbc8-30b3-a0a4-2435388de5e1",
                                "text": "„Es hat in den vergangenen zehn Jahren mehrere Besitzerwechsel erlebt und stand seit 2017 leer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
