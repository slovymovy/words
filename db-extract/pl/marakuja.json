                                        "entry_id": "cdb6e151-1649-3966-9fd7-71d8d924e540",
                                        "glosses": [
                                            "A plant, passiflora, that produces an edible fruit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c592f2e-2616-37e3-a325-b8cad4b26d75",
                                        "entry_id": "cdb6e151-1649-3966-9fd7-71d8d924e540",
                                        "glosses": [
                                            "The edible fruit of the passionflower, Passiflora edulis; a round fruit with a purple or yellow skin which is native to Brazil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec10cb6f-a045-4437-a085-5e0ed22e79cf",
                                                "sense_id": "2c592f2e-2616-37e3-a325-b8cad4b26d75",
                                                "text": "He brought four passion fruits from the market."
                                            },
                                            {
                                                "example_id": "86e0e9ae-31e6-45d4-805f-668ab4edafa3",
                                                "sense_id": "2c592f2e-2616-37e3-a325-b8cad4b26d75",
                                                "text": "Passion fruits are added for visual interest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37d1606-be0e-31a8-9c8c-1bb7af53f5ca",
                                        "entry_id": "cdb6e151-1649-3966-9fd7-71d8d924e540",
                                        "glosses": [
                                            "The flesh of the edible fruit."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d4190aa-c9c3-45d4-81c9-80ed9c1cc966",
                                                "sense_id": "b37d1606-be0e-31a8-9c8c-1bb7af53f5ca",
                                                "text": "A slice of passion fruit was added to the dessert for visual interest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fdbd41a-b2b6-37da-a399-1c01c26ba95f",
                                        "entry_id": "cdb6e151-1649-3966-9fd7-71d8d924e540",
                                        "glosses": [
                                            "A person whom one cherishes very much, especially a woman."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efc3cc41-7676-47fa-8338-64e9f73ac4e5",
                                                "sense_id": "1fdbd41a-b2b6-37da-a399-1c01c26ba95f",
                                                "text": "“Ah my little passion fruit,” José cooed, “I knew it. You are feeling the love too!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
