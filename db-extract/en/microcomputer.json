        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "207e3f07-53c3-3c97-b749-3eb34a97b0fa",
                "word": "microcomputer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d392140c-b879-4418-a1d8-0755929f2ec5",
                        "entry_id": "207e3f07-53c3-3c97-b749-3eb34a97b0fa",
                        "tags": [
                            "plural"
                        ],
                        "form": "microcomputers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7022290e-29f7-3439-aa7f-ac904c85c989",
                        "entry_id": "207e3f07-53c3-3c97-b749-3eb34a97b0fa",
                        "glosses": [
                            "A computer designed around a microprocessor, smaller than a minicomputer or a mainframe."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "da640358-be7e-47e9-8b03-f9f447987d31",
                                "sense_id": "7022290e-29f7-3439-aa7f-ac904c85c989",
                                "text": "In recent years, it had become the hallmark of the scientist, much as the stethoscope was that of the physician and the microcomputer that of the statistician."
                            },
                            {
                                "example_id": "8130c7ca-5323-496b-b591-22028bec51f2",
                                "sense_id": "7022290e-29f7-3439-aa7f-ac904c85c989",
                                "text": "The operation has installed nine Cygnet CoSystems, computerphones that send memos, letters, and even whole files from one microcomputer to another."
                            },
                            {
                                "example_id": "68572a59-3676-4073-a979-583cd936123d",
                                "sense_id": "7022290e-29f7-3439-aa7f-ac904c85c989",
                                "text": "In time of course, things became more efficient, with newer machines which could cope with large amounts of data - the microcomputers had 64 kilobytes of memory; your mobile phone has vastly more capacity."
                            }
                        ]
                    },
                    {
                        "sense_id": "efd68119-edc2-35cf-8e90-f64b995a1156",
                        "entry_id": "207e3f07-53c3-3c97-b749-3eb34a97b0fa",
                        "glosses": [
                            "A microprocessor that is based on a single chip."
                        ],
                        "tags": [
                            "dated",
                            "uncommon"
                        ],
                        "examples": []
                    }
                ],
