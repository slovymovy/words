                            {
                                "example_id": "78065770-c945-4c56-a5dc-c7b5ec9dab3b",
                                "sense_id": "aba83042-35ab-3fd2-a8a7-98383895f4ac",
                                "text": "L’écrivain est un transmetteur d’idées."
                            }
                        ]
                    },
                    {
                        "sense_id": "3617ca06-9719-3926-a344-80d4f41f30ee",
                        "entry_id": "ee44be9c-9b1f-3359-a0a7-cbdfe6f86039",
                        "glosses": [
                            "Appareil servant à transmettre les signaux de la télégraphie ou les signaux radioélectriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7081fea4-2aad-48ef-b744-89b7c5cf692e",
                                "sense_id": "3617ca06-9719-3926-a344-80d4f41f30ee",
                                "text": "Il est possible d’utiliser la même antenne pour effectuer réception et transmission du signal, à condition de pouvoir commuter alternativement entre le signal du transmetteur et celui du récepteur sans fuite entre les deux circuits."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaccc9d4-2992-4a58-b973-bdd855b732fe",
                        "source_entry_id": "ee44be9c-9b1f-3359-a0a7-cbdfe6f86039",
                        "source_sense_id": "3617ca06-9719-3926-a344-80d4f41f30ee",
