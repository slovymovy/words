                        "cross_references": [
                            {
                                "target_word": "progesterone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4917622b-3a3b-37b3-879b-7a818e64662d",
                                        "entry_id": "0cd305c0-e3ea-333e-a6ad-abcd29cfe504",
                                        "glosses": [
                                            "A steroid hormone, secreted by the ovaries, whose function is to prepare the uterus for the implantation of a fertilized ovum and to maintain pregnancy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6fa2757-0d7b-318f-9443-86f32deb1f60",
                                        "entry_id": "0cd305c0-e3ea-333e-a6ad-abcd29cfe504",
                                        "glosses": [
                                            "A synthetic version of the compound, used in contraceptive pills and other pharmaceutical products."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90880eb1-1bbc-4127-888b-38f75e7ee2fc",
                        "source_entry_id": "0a2c8d85-eafb-3e5e-8b7e-a945b5fe0121",
                        "source_sense_id": "b695ff51-27d1-39b1-b3ca-973892c40d30",
                        "target_lang_word": "progestérone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progestérone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28749628-d32a-3ad1-82cf-f16931a489f2",
                                        "entry_id": "740f9680-fa3d-3582-b88b-88468336f7b0",
                                        "glosses": [
                                            "Hormone stéroïde dérivée du cholestérol, principalement sécrétée par le corps jaune des ovaires et le placenta et impliquée dans le cycle œstral ou menstruel féminin, la gestation et l’embryogenèse des humains et d’autres espèces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9f54176-ddc4-4a4e-a31e-2f24a255e3c3",
                                                "sense_id": "28749628-d32a-3ad1-82cf-f16931a489f2",
                                                "text": "La progestérone est sécrétée surtout par le corps jaune de l’ovaire. Elle est indispensable à l’installation et au maintien de la gravidité."
                                            },
                                            {
                                                "example_id": "39f6266b-a1f7-4300-94a3-b8ba7c17bde5",
                                                "sense_id": "28749628-d32a-3ad1-82cf-f16931a489f2",
                                                "text": "Il n'y a donc plus, au cours de ces cycles avec anovulation, de sécrétion de progestérone, ce cycle anovulatoire étant en général plus long que les autres. Apparaît alors une insuffisance lutéale."
                                            },
                                            {
                                                "example_id": "8d402be0-9098-411c-9a0c-e1076fbfd2a7",
                                                "sense_id": "28749628-d32a-3ad1-82cf-f16931a489f2",
                                                "text": "Il s’agit de la LH (hormone lutéinisante) et de la FSH (hormone folliculostimulante), qui sont à l’origine de la régulation des œstrogènes et de la progestérone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
