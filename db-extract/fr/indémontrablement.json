                    {
                        "sense_id": "ae293a88-7c59-30df-92bd-dba12b1f5fe8",
                        "entry_id": "ed9caac0-26ad-3ec6-8db8-3e85898627ca",
                        "glosses": [
                            "D'une manière indémontrable."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "061bb1bb-5b64-4bae-bea8-abc0180e5030",
                                "sense_id": "ae293a88-7c59-30df-92bd-dba12b1f5fe8",
                                "text": "Il y a cependant à remarquer que l’individualité, bien tranchée, tombe nettement sous les sens et s’impose indémontrablement au sentiment."
                            },
                            {
                                "example_id": "9c06f36f-77e0-4b73-a63c-ec4f7fee3e1b",
                                "sense_id": "ae293a88-7c59-30df-92bd-dba12b1f5fe8",
                                "text": "Aussi, très subjectivement et indémontrablement, on pourrait y percevoir un personnage de roman à la Manon Lescaut, tout comme on peut voir dans Ali Oco un personnage à la Montesquieu des Lettres Persanes."
                            }
                        ]
                    }
