                "senses": [
                    {
                        "sense_id": "d83376b6-d87b-3eae-97b7-baea0798f008",
                        "entry_id": "a5cf2e1b-fe57-3297-8d47-b096adf2c908",
                        "glosses": [
                            "Bach, der in einem bergigem Gelände fließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4833fd14-3ca2-483b-9f1c-fb455a9be621",
                                "sense_id": "d83376b6-d87b-3eae-97b7-baea0798f008",
                                "text": "„Sie tranken Wasser aus kalten Bergbächen und wuschen die Wunden; an einer Quelle erlegten sie eine junge Hirschkuh, aßen sich satt und räucherten dann ein paar schmale Fleischstreifen für unterwegs.“"
                            },
                            {
                                "example_id": "e1371a0f-ae32-4189-89c6-b7b2ccadcba9",
                                "sense_id": "d83376b6-d87b-3eae-97b7-baea0798f008",
                                "text": "„Wie schön war es doch, an einem heißen Sommertag einen Bergbach zu betrachten, dachte der Mann, bis er das Fenster öffnete und feststellte, dass er die Abwässer Jerusalems vor sich sah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
