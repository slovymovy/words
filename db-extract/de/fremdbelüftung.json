                "senses": [
                    {
                        "sense_id": "65f386ed-1aa7-3079-a024-210bcbd78f27",
                        "entry_id": "bf4ba993-e2ee-336a-ba26-1bc8a7a43397",
                        "glosses": [
                            "zusätzliches belüften eines Bauteils oder technischen Geräts zur Kühlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564f6304-efc3-44bb-ade9-d03660c82d4a",
                                "sense_id": "65f386ed-1aa7-3079-a024-210bcbd78f27",
                                "text": "„Ein Durchbrennen der Motorwicklung kann daher nur durch die Fremdbelüftung des Antriebsmotors verhindert werden.“"
                            },
                            {
                                "example_id": "a915dfb3-f119-4797-ac7f-de95d59a7736",
                                "sense_id": "65f386ed-1aa7-3079-a024-210bcbd78f27",
                                "text": "„ Durch Überdimensionierung der Motoren ist ein Betrieb ohne Fremdbelüftung auch bei niedrigen Drehzahlen möglich.“"
                            },
                            {
                                "example_id": "9941df57-44c9-49e5-8e4e-7bcd0db14e17",
                                "sense_id": "65f386ed-1aa7-3079-a024-210bcbd78f27",
                                "text": "„Die Fremdbelüftung ist so dimensioniert, dass die Kühlleistung den Nennpunkt-Anforderungen jederzeit entspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "623cc279-5a27-33f8-a362-3147a46eba9d",
                        "entry_id": "bf4ba993-e2ee-336a-ba26-1bc8a7a43397",
                        "glosses": [
                            "zusätzliches belüften eines geschlossen Raumes oder Hülle mit Atemluft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bea19c2-14da-4358-be5e-8d4f4b96955e",
                                "sense_id": "623cc279-5a27-33f8-a362-3147a46eba9d",
                                "text": "„Solche für leichte Beanspruchung können ohne zusätzliche Maßnahmen wie etwa Fremdbelüftung während einer ganzen Arbeitsschicht getragen werden.“"
                            },
                            {
                                "example_id": "239f4e5d-bd35-4e94-acd2-ff6d75c7850e",
                                "sense_id": "623cc279-5a27-33f8-a362-3147a46eba9d",
                                "text": "„Die BGI 581 beschreibt, welche Funktionen, Komponenten und Einrichtungen an einer Fremdbelüftung vorhanden sein müssen, damit der sichere Betrieb in kontaminierten Bereichen gewährleistet wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
