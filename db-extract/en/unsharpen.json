                "senses": [
                    {
                        "sense_id": "bdb87997-6912-32df-9ac5-c55eef487ffe",
                        "entry_id": "a4949d4b-cb30-3139-ba72-f6c349e9feb0",
                        "glosses": [
                            "To render unsharp; to spoil the sharpness of (something)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bcea8512-f318-4835-9e25-996450c8d16f",
                                "sense_id": "bdb87997-6912-32df-9ac5-c55eef487ffe",
                                "text": "Thus, every product is branded with a legal marking, or a trademark respectively. In addition, as every product has a name, every product allows us to associate knowledge and meaning to this name. As the differentiation of products and brands unsharpens this distinction, we suggest the distinction of brands and the brand systems: […]"
                            },
                            {
                                "example_id": "40c318fd-1a35-4eb5-b3f6-aa079903f5fe",
                                "sense_id": "bdb87997-6912-32df-9ac5-c55eef487ffe",
                                "text": "That said, there is a curious solace in settling into a worldview by a writer who so refuses to unsharpen her vision, whose investment is in the clarity and freshness of the imagery and an honest portrayal of our craven impulses."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dff8cbe-9dc3-3e1b-a9c4-ca065ec17efe",
                        "entry_id": "a4949d4b-cb30-3139-ba72-f6c349e9feb0",
                        "glosses": [
                            "To undo a sharpening operation on (an image)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c1dff669-20c4-45b2-a0f6-94a5e98fa434",
                                "sense_id": "5dff8cbe-9dc3-3e1b-a9c4-ca065ec17efe",
                                "text": "When it sharpens the image, you can't unsharpen it again without losing data."
                            }
                        ]
                    }
