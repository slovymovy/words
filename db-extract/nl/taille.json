                "senses": [
                    {
                        "sense_id": "09b53052-0f67-3526-a051-1127fe503a99",
                        "entry_id": "84d4b850-ba69-372c-bbbc-a4411a3c2678",
                        "glosses": [
                            "het middelste deel van het lichaam, middel bet. [B]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b53624-3b9e-4778-9efb-b517f7a0ef53",
                                "sense_id": "09b53052-0f67-3526-a051-1127fe503a99",
                                "text": "De broek zit wat strak rond de taille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70002e9d-9202-4fd5-9a90-bbc1e459a000",
                        "source_entry_id": "84d4b850-ba69-372c-bbbc-a4411a3c2678",
                        "source_sense_id": "09b53052-0f67-3526-a051-1127fe503a99",
                        "source_sense_description": "het middelste deel van het lichaam",
                        "target_lang_word": "Taille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ee04c7f-2de2-3e27-859a-0ca0daa435d8",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "die schmalste Stelle des menschlichen Rumpfes zwischen Brustkorb (unterer Rippenbogen) und Hüfte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df74d733-6f3e-4541-b5b8-ecbf3b092ea8",
                                                "sense_id": "5ee04c7f-2de2-3e27-859a-0ca0daa435d8",
                                                "text": "In ihrem Hochzeitskleid kam Nataljas schlanke Taille gut zur Geltung."
                                            },
                                            {
                                                "example_id": "b96ab664-a4fb-4ec6-bdb4-eefd13dc8b51",
                                                "sense_id": "5ee04c7f-2de2-3e27-859a-0ca0daa435d8",
                                                "text": "„Die Damen ließen die Hula-Reifen um die entblößten Taillen kreisen.“"
                                            },
                                            {
                                                "example_id": "533f02f3-315d-4517-88b0-28e557a73109",
                                                "sense_id": "5ee04c7f-2de2-3e27-859a-0ca0daa435d8",
                                                "text": "„Sie hat den Mantel sehr eng um die Taille geschnürt, unter ihrem Arm klemmt ein Handtuch und eine Shampooflasche.“"
                                            },
                                            {
                                                "example_id": "4c6fbdd9-4a45-4200-af84-d81b7d3ec090",
                                                "sense_id": "5ee04c7f-2de2-3e27-859a-0ca0daa435d8",
                                                "text": "„Dean steht bis zur Taille im Wasser, wartet.“"
                                            },
                                            {
                                                "example_id": "ecf9f210-046d-454d-ae10-6b6483840e4a",
                                                "sense_id": "5ee04c7f-2de2-3e27-859a-0ca0daa435d8",
                                                "text": "„Die Hausherrin des achtzehnten Jahrhunderts trug ständig einen riesigen Schlüsselbund um die Taille, die mehr dem Schutz vor Langfingern im eigenen Haus als dem vor Einbrechern diente.“"
                                            },
                                            {
                                                "example_id": "14dfeab1-8746-4eb2-aa83-8373e0e9cdc5",
                                                "sense_id": "5ee04c7f-2de2-3e27-859a-0ca0daa435d8",
                                                "text": "„Mit dem rechten Arm umfaßte sie seine Taille, mit dem linken versuchte sie, ihre Petticoats zu bändigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c607fd18-b608-31db-85db-8656a92221f9",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "Umfang der unter [1] beschriebenen Körperstelle"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "728fd852-3089-4632-8cbe-2e76f13c0c6a",
                                                "sense_id": "c607fd18-b608-31db-85db-8656a92221f9",
                                                "text": "„Eine Taille zu haben, und zwar gut sichtbar, mehr Wünsche hat sie auch Weihnachten nicht.“"
                                            },
                                            {
                                                "example_id": "75f3987f-d12e-4517-a051-cf517c0a47c0",
                                                "sense_id": "c607fd18-b608-31db-85db-8656a92221f9",
                                                "text": "„Wer von einem Waschbrettbauch und einer schlanken Taille träumt, muss sich gesund ernähren und stundenlang im Fitnessstudio schwitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ba78b785-25ce-3924-b129-c3453d222d89",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "Teil eines Kleidungsstücks, der die unter [1] beschriebene Körperstelle bedeckt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbfcd4a9-9c5c-4dde-9892-debd3e1c5de3",
                                                "sense_id": "ba78b785-25ce-3924-b129-c3453d222d89",
                                                "text": "„Effi trug ein blau und weiß geſtreiftes, halb kittelartiges Leinwandkleid, dem erſt ein feſt zuſammengezogener, bronzefarbener Ledergürtel die Taille gab; der Hals war frei, und über Schulter und Nacken fiel ein breiter Matroſenkragen.“"
                                            },
                                            {
                                                "example_id": "4cf81e0a-d13b-4414-ae22-ad1cec71ef61",
                                                "sense_id": "ba78b785-25ce-3924-b129-c3453d222d89",
                                                "text": "„Diese waagerecht hin und her geführten Fäden, die Schußfäden, dürfen nicht zu fest angezogen werden, sonst bekommt das Gewebe eine häßliche Taille.“"
                                            },
                                            {
                                                "example_id": "58de83ed-73c7-44c3-84fa-fc56d4f14a09",
                                                "sense_id": "ba78b785-25ce-3924-b129-c3453d222d89",
                                                "text": "„Vielleicht hatten sie diese Kleider selber genäht, wollten aussehen wie Hilde Krahl, Hansi Knoteck, Ilse Werner, Brigitte Horney, Marikka Röck. Abenteuerliche Krägen und Taillen und Säume und Stulpen.“"
                                            },
                                            {
                                                "example_id": "95fb3bc5-c08c-43e1-b2f0-c7a1a1e6b39c",
                                                "sense_id": "ba78b785-25ce-3924-b129-c3453d222d89",
                                                "text": "„Sie trugen Backenbärte, die neueste Mode, und ihre Jacken hatten zu breite Schultern und zu enge Taillen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "688beb28-7899-329d-a0a4-d352b08971f9",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "(auf Stäbchen gearbeitetes) Oberteil eines (zweiteiligen) Kleides, das eng anliegt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc53bcf5-8dd2-44cc-a8b1-9a368f9f2ec9",
                                                "sense_id": "688beb28-7899-329d-a0a4-d352b08971f9",
                                                "text": "„Der junge Herr (bereits mit ihr hinter der Portière, im Schlafzimmer, nestelt ihr die Taille auf).“"
                                            },
                                            {
                                                "example_id": "dbb6f632-170a-47d1-bc46-afe4f8bcdb40",
                                                "sense_id": "688beb28-7899-329d-a0a4-d352b08971f9",
                                                "text": "„[…]: sie legte die rotsamtene verschossene Taille ab und liess den dunkelgrünen Tuchrock fallen und auch den Unterrock.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "dcc8768d-399a-3212-b6bc-a2ec667ad819",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "in England und Frankreich erhobene Vasallensteuer"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcaef8c9-f431-4e84-a3a8-cc44dfc52dcd",
                                                "sense_id": "dcc8768d-399a-3212-b6bc-a2ec667ad819",
                                                "text": "„Unsere landesherrlichen Vermögenssteuern waren wohl ähnlich, wie die Taille in Frankreich und in England, zuerst Abgaben, welche zum Entgelt für die Befreiung vom persönlichen Waffendienste dienen mußten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "cf55a8ad-084e-3e11-a889-40cf2155966c",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "in Frankreich von 1439 bis zur Französischen Revolution 1789 auf das Einkommen und Vermögen der nicht privilegierten Stände (Bauern, Bürger) erhobene Staatssteuer"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f995ad-03d9-4ed3-a128-f756941ef765",
                                                "sense_id": "cf55a8ad-084e-3e11-a889-40cf2155966c",
                                                "text": "„Drei directe Abgaben beſtehen: die Taille, die Kopfſteuer und der Zwanzigſte. — Ich unterbreche aber hier für eine Weile den Gang der Denkſchrift, um zu bemerken, daß die Taille die einzige Steuer war, welche erhöht werden konnte, ohne einer Einzeichnung von Seiten der Parlamente zu bedürfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "712d2ec5-4047-3208-974e-6b1c8fb6661c",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "tiefere Tenorlage in der Instrumentalmusik; das Musikinstrument selbst in dieser Tenorlage (zum Beispiel: Barockoboe, Bratsche)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48b5c5b3-57ed-4367-9971-25183fe46ed2",
                                                "sense_id": "712d2ec5-4047-3208-974e-6b1c8fb6661c",
                                                "text": "„Beginnend mit der Sonate Nr. 2 g-Moll aus den 12 Sonaten op.1 von Johann Michael Müller für konzertierende Oboe (Karla Schröter), zwei Oboen (Griet Cornelis und Petra Naethbohm), Taille, deren Stimme der Bratsche im Streicher-Ensemble entspricht (Martin Fendel) sowie Basso continuo (Bc mit (Cordula Caso, Barockfagott, und Orgelpositiv, Harald Hoeren) ließ sich das Publikum ohne Umschweife auf die klanglich überwältigende Lebensfreude der Barockmusik ein. Schröters Oboe leuchtete über allen Melodien, die Stimme der Taille wurde als neue Erfahrung wahrgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "0c17b9e4-bd32-3446-b359-641c97f395be",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "vom 16. bis 18. Jahrhundert in Frankreich verbreitete Tenorlage in der Vokal- und Instrumentalmusik"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "fa0b2dc6-8dde-38f9-86ac-11bbf196594a",
                                        "entry_id": "f684ebe0-a6e0-3e99-acd8-fa74837234ee",
                                        "glosses": [
                                            "Aufdecken der Karten zum Ermitteln des Gewinns oder Verlustes des Wettbetrages"
                                        ],
                                        "tags": [
                                            "besonders beim Pharao"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244faf64-1500-443c-9651-b661d55f9d68",
                                                "sense_id": "fa0b2dc6-8dde-38f9-86ac-11bbf196594a",
                                                "text": "„Roͤlzer und Thuning (ſtehen rechts an einem kleinen Tiſche. Roͤlzer ſchlaͤgt eine Taille Pharao. Thuning hat einige Kartenblaͤtter vor ſich liegen).“"
                                            },
                                            {
                                                "example_id": "793b6751-f9db-460e-8568-4af87c796620",
                                                "sense_id": "fa0b2dc6-8dde-38f9-86ac-11bbf196594a",
                                                "text": "„Nach dem ersten Ballett ging ich in den Spielsaal und gewann in vier Taillen fünfhundert Zechinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            }
                        ]
