                                        "entry_id": "bd554998-4304-3025-9007-3584463cc0c7",
                                        "glosses": [
                                            "The technique of repeating a phrase while reversing the order of certain elements or its grammatical structure, as a form of juxtaposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
