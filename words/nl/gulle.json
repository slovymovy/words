                    "sense_definition": "Tweede persoon meervoud, onderwerp: jullie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>gulle</w> jullie van plan om morgen ook naar het feest te komen?",
                            "target_lang_translations": {
                                "zh": "<w>你们</w>打算明天也来参加聚会吗？"
                            }
                        },
                        {
                            "text": "Waarom zijn <w>gulle</w> zo laat vertrokken van huis?",
                            "target_lang_translations": {
                                "zh": "<w>你们</w>为什么这么晚才从家里出发？"
                            }
                        }
                    ],
                    "synonyms": [
                        "jullie",
                        "gulder",
                        "gijlui"
                    ],
                    "traits": [
