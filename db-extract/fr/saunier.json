                ],
                "senses": [
                    {
                        "sense_id": "ac3ffcd4-a12c-357f-82b9-554eabac84aa",
                        "entry_id": "dfa0c100-07b7-3fad-a2ae-ec8c4383f70e",
                        "glosses": [
                            "Celui qui recueille le sel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ec403c-9ec8-4fbd-b1e4-b653fa25f769",
                                "sense_id": "ac3ffcd4-a12c-357f-82b9-554eabac84aa",
                                "text": "Mon ami, dit Balsamo, chantez-moi donc cette chanson que les sauniers de Batz chantent en rentrant le soir, après la journée faite."
                            },
                            {
                                "example_id": "339ae5b6-9a9b-435d-bdd2-77ee234e0059",
                                "sense_id": "ac3ffcd4-a12c-357f-82b9-554eabac84aa",
                                "text": "La saumure était récupérée, filtrée et enrichie. Ensuite, les sauniers la faisaient chauffer dans de grands fourneaux équipés de bassines en terre cuite."
                            },
                            {
                                "example_id": "d00bb2cb-a6a8-4150-a023-d535db2fbaef",
                                "sense_id": "ac3ffcd4-a12c-357f-82b9-554eabac84aa",
                                "text": "Selon les versions, le chenal doit son nom aux petites huttes où les sauniers s’abritaient, qu’on appelle les cayennes ou à la franc-maçonnerie, le Cayenne étant la maison mère où étaient alors reçus les apprentis tailleurs de pierre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a7731b3-18ac-31e9-85fa-7747574bb86d",
                        "entry_id": "dfa0c100-07b7-3fad-a2ae-ec8c4383f70e",
                        "glosses": [
                            "Marchand de sel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eafcc3cd-c2ae-40fe-b4b2-67e047c932ca",
                                "sense_id": "5a7731b3-18ac-31e9-85fa-7747574bb86d",
                                "text": "Faux-saunier, celui qui vendait, qui débitait du sel en fraude et contre les ordonnances. Le plus célèbre est Louis Mandrin."
                            },
                            {
                                "example_id": "6d25588d-6821-4a00-b413-b99d836fdb0b",
                                "sense_id": "5a7731b3-18ac-31e9-85fa-7747574bb86d",
                                "text": "Ce livre […] donne des détails sur la révolte des camisards, sur l’exil des protestants, sur cette célèbre ligue des faux-sauniers de Lorraine, dont Mandrin se servit plus tard pour lever des troupes régulières […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd5bd9cb-bbee-40cd-b1bf-d619d88f6cdc",
                        "source_entry_id": "dfa0c100-07b7-3fad-a2ae-ec8c4383f70e",
                        "source_sense_description": "Celui qui recueille le sel",
                        "target_lang_word": "Salzwerker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salzwerker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb0ebdb-e4d7-3cf6-9fc4-35728b4afce1",
                                        "entry_id": "f1bd8a3a-562c-3bde-9f7c-606d35012e95",
                                        "glosses": [
                                            "Arbeiter, der Salz durch Abdampfen von Sole gewinnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2b1cf3-26e5-41dd-a482-46daefc6051b",
                                                "sense_id": "cfb0ebdb-e4d7-3cf6-9fc4-35728b4afce1",
                                                "text": "Schon im Jahre 1399 hatte Konrad einen Salzwerker aus Halle hierher nach Preußen kommen lassen, um nachzuforschen, ob im hiesigen Lande nicht irgendwo Salz aufzufinden sey."
                                            }
                                        ],
