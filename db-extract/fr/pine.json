                "senses": [
                    {
                        "sense_id": "f99470d6-dfcf-34b6-ba06-a6dcfcfd7b5d",
                        "entry_id": "b5d4294e-b6a0-3b10-bdef-411020651804",
                        "glosses": [
                            "Sexe masculin, membre viril, pénis, phallus, verge, vit."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "dc663687-3177-4a4b-8e0d-1a0bc58baee5",
                                "sense_id": "f99470d6-dfcf-34b6-ba06-a6dcfcfd7b5d",
                                "text": "Voilà Gautier tournant, à propos d’un mot jeté par nous sur le Faune de Munich, tournant sur le beau pur de la sculpture grecque, qu’il reconnaît aux testicules des statues. Et le voilà à nous décrire la pine grecque et comme l’ingénuité du phallus dont parle Aristophane."
                            },
                            {
                                "example_id": "a3a5ca1a-c226-488a-9ef7-c2a731a3dd82",
                                "sense_id": "f99470d6-dfcf-34b6-ba06-a6dcfcfd7b5d",
                                "text": "Ne dessinez pas des pines sur les murs, même si vous avez un réel talent de dessinatrice."
                            }
                        ]
                    },
                    {
                        "sense_id": "c25490a5-e56f-3349-baf0-0358d8eda623",
                        "entry_id": "b5d4294e-b6a0-3b10-bdef-411020651804",
                        "glosses": [
                            "Sperme."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "72b1e467-b6b2-38d2-b594-6f0eb3bc2bf7",
                        "entry_id": "b5d4294e-b6a0-3b10-bdef-411020651804",
                        "glosses": [
                            "Idiot, idiote."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "30a77b4a-6d71-442b-b3e0-9b2df2d20bfb",
                                "sense_id": "72b1e467-b6b2-38d2-b594-6f0eb3bc2bf7",
                                "text": "Tête de pine."
                            },
                            {
                                "example_id": "91b98fa6-b695-494f-a50b-431979b015a9",
                                "sense_id": "72b1e467-b6b2-38d2-b594-6f0eb3bc2bf7",
                                "text": "Arrête de rigoler comme une pine !"
                            }
                        ]
                    },
                    {
                        "sense_id": "d04d9002-f271-3295-a4b3-9518dc976b05",
                        "entry_id": "b5d4294e-b6a0-3b10-bdef-411020651804",
                        "glosses": [
                            "antisèche, feuille de triche."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "188e3ac6-06c5-3de7-8ad8-d2c4cda83e5d",
                        "entry_id": "b5d4294e-b6a0-3b10-bdef-411020651804",
                        "glosses": [
                            "Pomme de pin."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8f264eb-b0f0-40a4-992e-bdc9a87641ea",
                        "source_entry_id": "b5d4294e-b6a0-3b10-bdef-411020651804",
                        "target_lang_word": "Pimmel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pimmel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                        "entry_id": "585feb42-a667-3ecb-87c0-3119bd5d6250",
                                        "glosses": [
                                            "männliches Geschlechtsglied"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e048da-457f-4d75-aaef-d91f9d89dde0",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "Jemand hat sich letztens den Pimmel eingeklemmt."
                                            },
                                            {
                                                "example_id": "f1aeb4c7-e321-4dd9-b512-9b1249193178",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "„Als das Licht aus war, fragte Volker mich, ob ich wisse, wie Babys entstehen. Die entstünden, wenn der Mann seinen steifen Pimmel bei der Frau in die Scheide stecke.“"
                                            },
                                            {
                                                "example_id": "a21d7632-9f0b-456f-8e5d-9c16fd75d325",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "„Er war barfuß, trug abgeschnittene Hosen und ein weißes T-Shirt mit dem fliegenden Pimmel des RFSU, des schwedischen Reichsverbands für sexuelle Aufklärung, auf der Brust.“"
                                            },
                                            {
                                                "example_id": "508ef298-daf2-44c5-8880-7bb44c7e55d3",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "„Dieser Großonkel steckte seine Hände in die schleimigen violetten Eingeweide und untersuchte je nach gusto ihre komischen, schlaffen Pimmel.“"
                                            },
                                            {
                                                "example_id": "a35babc5-18f5-48ae-b71d-ebd3faae5600",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "„Er rannte also ins Haus, schloss sich im Bad ein, zog die Hose aus, und schon allein nackt und mit einem steinharten Pimmel vor dem Spiegel zu stehen fühlte sich seltsam erregend an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
