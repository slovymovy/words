                "senses": [
                    {
                        "sense_id": "23a8dfe8-9fd7-3328-a468-84dd4c4eee4c",
                        "entry_id": "80d29671-6a6e-3d5e-815e-a27af9eec055",
                        "glosses": [
                            "Variante orthographique de lasagne."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e46dd764-b0ae-472a-ad3a-dae286941049",
                                "sense_id": "23a8dfe8-9fd7-3328-a468-84dd4c4eee4c",
                                "text": "La lazagne est une pâte d’Italie de la même composition que celle du macaroni, à la différence que celle-ci ressemble assez à la figure des copeaux de menuisier."
                            },
                            {
                                "example_id": "d35bff08-31e3-4419-be84-8aee0e302ced",
                                "sense_id": "23a8dfe8-9fd7-3328-a468-84dd4c4eee4c",
                                "text": "— Achetez, monsieur, achetez ma belle lazagne ; il n’y a pas de meilleure lazagne à Venise !…"
                            },
                            {
                                "example_id": "67892e6c-abdf-4b16-ba7e-483bbbc060d7",
                                "sense_id": "23a8dfe8-9fd7-3328-a468-84dd4c4eee4c",
                                "text": "[…] mais, pour rien au monde, je n’eusse accepté un morceau de pain à cette table, et j’allai trouver la Mariuccia, qui mangeait un plat de lazagne dans le casino, et qui le partagea joyeusement avec moi."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f1166b1-88f3-37c1-ad8e-2fcb130d00fd",
                        "entry_id": "80d29671-6a6e-3d5e-815e-a27af9eec055",
                        "glosses": [
                            "Lettre, missive."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f21a8cb3-6eb3-4176-a709-641935ff1da6",
                                "sense_id": "5f1166b1-88f3-37c1-ad8e-2fcb130d00fd",
                                "text": "Cependant, ceux qui désireront vivement une réponse de la P. L. n’auront qu’à joindre un timbre pour ça à leur lazagne, et la P. L. leur répondra."
                            },
                            {
                                "example_id": "6c4955c2-9b24-4fd5-8427-9c7dc32fe13b",
                                "sense_id": "5f1166b1-88f3-37c1-ad8e-2fcb130d00fd",
                                "text": "Identiques aussi sont les agissements des voleurs à la fausse lazagne (fausse lettre)."
                            }
                        ]
                    }
                ],
