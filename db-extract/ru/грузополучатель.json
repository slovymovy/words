                                        "examples": [
                                            {
                                                "example_id": "cad29c7d-52fb-4049-8994-2fc5dffea34b",
                                                "sense_id": "f4fb57ad-68af-3f67-bb87-28ee566b3225",
                                                "text": "Le consignataire délivra les fonds."
