                    },
                    {
                        "translation_id": "34870dc8-44f3-4cc6-93f0-efe48c917ba7",
                        "source_entry_id": "c7db74fd-0fec-35fd-91a5-48c8b73485d6",
                        "source_sense_description": "способность организма воспринимать раздражения",
