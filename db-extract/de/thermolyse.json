                ],
                "senses": [
                    {
                        "sense_id": "0e7635b0-b1e0-3e36-ab4f-236eeb7078d1",
                        "entry_id": "6be60db7-5610-3681-ab75-741a0dd9a875",
                        "glosses": [
                            "Thermolyse : rupture de liaisons chimiques à haute température."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a56d23-efed-41e9-a797-d32d89067f93",
                                "sense_id": "0e7635b0-b1e0-3e36-ab4f-236eeb7078d1",
                                "text": "Der Zerfall eines Diels-Alder-Addukts in die Ausgangskomponenten wird als Retro-Diels-Alder-Reaktion bezeichnet. Das einfachste Beispiel ist die Thermolyse von Cyclohexen in der Gasphase, welche 1,3-Butadien und Ethen ergibt.",
                                "translation": "La décomposition d’un adduit de Diels-Alder pour redonner les réactifs est appelée une réaction rétro-Diels-Alder. L’exemple le plus simple est la thermolyse du cyclohexène en phase gazeuse, donnant du 1,3-butadiène et de l’éthène."
                            },
                            {
                                "example_id": "f34943f6-5474-4a08-9085-83f4bfb362ce",
                                "sense_id": "0e7635b0-b1e0-3e36-ab4f-236eeb7078d1",
                                "text": "Eines der ersten großtechnischen Verfahren zur Herstellung von Acrylsäure basiert auf der Thermolyse von Propiolacton, welches man bei Temperaturen von 140–180 °C und Drücken von 25–250 bar in Gegenwart von Phosphorsäure und Kupferpulver als Katalysator quantitativ zu Acrylsäure umsetzt",
                                "translation": "Un des premiers procédés industriels pour la production d’acide acrylique est basé sur la thermolyse du propiolactone, qui se transforme quantitativement en acide acrylique à des températures entre 140 et 180°C et des pressions de 25 à 250 bar, en présence d’acide phosphorique et de poudre de cuivre comme catalyseur."
                            }
                        ]
                    },
                    {
                        "sense_id": "19de14bb-69d7-376d-aae0-bd6886680210",
                        "entry_id": "6be60db7-5610-3681-ab75-741a0dd9a875",
                        "glosses": [
                            "Élimination de la chaleur, par exemple par le processus de sudation ou de ventilation."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ad669c4d-5d8e-45b3-bf3b-bfc2281b49d1",
                                "sense_id": "19de14bb-69d7-376d-aae0-bd6886680210",
                                "text": "Dein Körper versucht dann, weniger Wärme zu erzeugen und stattdessen Wärme durch Schwitzen und Erweiterung der Blutgefäße abzugeben. Das nennt man dann eher Thermolyse als Thermogenese.",
                                "translation": "Ton corps essaie alors de produire moins de chaleur, et, au contraire, d’évacuer de la chaleur par la transpiration et la dilatation des vaisseaux sanguins. On appelle ce dernier phénomène la thermolyse plutôt que la thermogenèse."
                            },
                            {
                                "example_id": "bb78fe89-5bd5-4f70-a5fb-85d5173b226f",
                                "sense_id": "19de14bb-69d7-376d-aae0-bd6886680210",
                                "text": "Die überschüssige, innere Wärme wird verschwendet und nach aussen abgeführt. Das ist die sogenannte Thermolyse.",
                                "translation": "La chaleur interne excédentaire est grillée et évacuée vers l’extérieur. C’est ladite thermolyse."
                            }
                        ]
                    }
                ],
