                        "examples": [
                            {
                                "example_id": "da1d074a-21bb-4fac-85d7-7b4d08da058f",
                                "sense_id": "2a04924d-d231-3258-92f6-0f9caeb81619",
                                "text": "In juni was de landmacht aan de beurt. De prinses maakt in Drenthe kennis met de 43e gemechaniseerde brigade en reed mee in een Leopard-gevechtstank. Ook maakte ze kennis met het Duits-Nederlandse 414 Tankbataljon."
                            },
                            {
                                "example_id": "d6a73a17-15dc-42d0-af95-7cc8a78e3f82",
                                "sense_id": "2a04924d-d231-3258-92f6-0f9caeb81619",
                                "text": "Daarmee is een einde gekomen aan zo'n 90 jaar Nederlandse tankgeschiedenis. De eerste tank maakte kort na de Eerste Wereldoorlog zijn entree. Op het hoogtepunt van de Koude Oorlog beschikte Nederland over bijna 1000 gevechtstanks. Zij vormden de ruggengraat van de Nederlandse krijgsmacht."
                            }
                        ]
