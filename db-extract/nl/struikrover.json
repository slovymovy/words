                    {
                        "sense_id": "faf7fdd6-419f-3cd8-a530-b24978cb3e37",
                        "entry_id": "c6aadaab-472d-3fe2-8a7f-f984e72727d0",
                        "glosses": [
                            "iemand die vanuit een hinderlaag reizigers berooft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "72871abd-c028-4175-9e82-45caa03879fa",
                                "sense_id": "faf7fdd6-419f-3cd8-a530-b24978cb3e37",
                                "text": "Veel edelen in de vroege middeleeuwen waren niet veel meer dan gemene struikrovers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d29664d-8666-44e7-b96e-56055d8086d2",
                        "source_entry_id": "c6aadaab-472d-3fe2-8a7f-f984e72727d0",
                        "source_sense_id": "faf7fdd6-419f-3cd8-a530-b24978cb3e37",
                        "source_sense_description": "iemand die vanuit een hinderlaag reizigers berooft",
                        "target_lang_word": "Straßenräuber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Straßenräuber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "774c7d15-8bff-330d-ab2c-c96143f6f063",
                                        "entry_id": "4a4bf09f-fc81-31da-8c24-73c7517c3253",
                                        "glosses": [
                                            "Person, die ihre Raubüberfälle auf offener Straße begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eecf83c2-56c6-4346-a6dd-70c013daea41",
                                                "sense_id": "774c7d15-8bff-330d-ab2c-c96143f6f063",
                                                "text": "„Dort drängten sich Gasthäuser, in denen Banden von Prostituierten und Straßenräubern Unterkunft gefunden hatten.“"
                                            },
                                            {
                                                "example_id": "668bad65-2251-447c-ab42-2ca9c4d860c3",
                                                "sense_id": "774c7d15-8bff-330d-ab2c-c96143f6f063",
                                                "text": "„Sade läßt den historischen Giftmörder Desrues und den historischen Straßenräuber Cartouche in seinen Romanen auftreten.“"
                                            },
                                            {
                                                "example_id": "5641f6f2-893d-401e-bf37-30d8990615e5",
                                                "sense_id": "774c7d15-8bff-330d-ab2c-c96143f6f063",
                                                "text": "„Ein Straßenräuber hielt die Adam nicht unbekannte Kutsche auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19ba77ae-ee15-4107-ab1e-cc869b55af71",
                        "source_entry_id": "c6aadaab-472d-3fe2-8a7f-f984e72727d0",
                        "source_sense_id": "faf7fdd6-419f-3cd8-a530-b24978cb3e37",
                        "source_sense_description": "iemand die vanuit een hinderlaag reizigers berooft",
                        "target_lang_word": "Wegelagerer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wegelagerer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                                        "entry_id": "95169c6f-3039-3daf-88b6-c6f2c8f134fc",
                                        "glosses": [
                                            "Person, die einer anderen Person rechtswidrig und unter Androhung oder auch Anwendung von Gewalt etwas wegnimmt"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3532d6b-f92d-464a-8132-c45d61c6db09",
                                                "sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                                                "text": "Sie geraten in die Doppelmühle zwischen einem immer brutaler werdenden Arbeitsalltag und den Wegelagerern vom Ballhausplatz, die ihnen am Nachhauseweg weit mehr als die Hälfte des Lohns wieder abknöpfen."
                                            },
                                            {
                                                "example_id": "002f111b-e9fb-4813-9ede-df239adc8bbe",
                                                "sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                                                "text": "„Am 2. Juni sind sie in Zürich; es ist alles glatt gegangen, kein Radbruch, kein Wegelagerer.“"
                                            },
                                            {
                                                "example_id": "156eb13e-886a-4488-b3ef-de566d94657f",
                                                "sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                                                "text": "„An den Kaufmannszügen interessierten die Wegelagerer in erster Linie nicht deren Waren, die man hätte weiterverkaufen müssen, um sie zu Geld zu machen, sondern die Kaufleute selbst, für die Lösegelder verlangt wurden, manchmal sogar ›über das Vermögen‹, was die Frankfurter Bittschrift eigens hervorhebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ee2400b-a640-4472-a5ff-15240f0bce8f",
                        "source_entry_id": "c6aadaab-472d-3fe2-8a7f-f984e72727d0",
                        "source_sense_id": "faf7fdd6-419f-3cd8-a530-b24978cb3e37",
                        "source_sense_description": "iemand die vanuit een hinderlaag reizigers berooft",
                        "target_lang_word": "highwayman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highwayman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b20b9f6f-46b5-37fe-888c-033f8be6876f",
                                        "entry_id": "893279ec-2f31-34d3-9fd3-306b1c0926e4",
                                        "glosses": [
                                            "A person, usually mounted on horseback, who robbed travelers on public roads."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b8a295-2e97-42ec-90cb-7554f98dce8d",
                                                "sense_id": "b20b9f6f-46b5-37fe-888c-033f8be6876f",
                                                "text": "[…] here were no Gibers, Cenſurers, Backbiters, Pick-pockets, Highwaymen, Houſebreakers, Attorneys, Bawds, Buffoons, Gameſters, Politicians, Wits, ſplenetick tedious Talkers, Controvertiſts, Raviſhers, Murderers, Robbers, Virtuoſo's; […]"
                                            },
                                            {
                                                "example_id": "fa3a2e6b-213f-41dd-a6b7-38616a537745",
                                                "sense_id": "b20b9f6f-46b5-37fe-888c-033f8be6876f",
                                                "text": "And the highwayman came riding— / Riding—riding— / The highwayman came riding, up to the old inn-door."
                                            },
                                            {
                                                "example_id": "9cac1858-920b-46b5-baf5-6182b53c92e4",
                                                "sense_id": "b20b9f6f-46b5-37fe-888c-033f8be6876f",
                                                "text": "I was a highwayman / Across the coach roads I did ride / With sword and pistol by my side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6028733b-9b5e-4645-ae38-112739d97a07",
                        "source_entry_id": "c6aadaab-472d-3fe2-8a7f-f984e72727d0",
                        "source_sense_id": "faf7fdd6-419f-3cd8-a530-b24978cb3e37",
                        "source_sense_description": "iemand die vanuit een hinderlaag reizigers berooft",
                        "target_lang_word": "bandit de grand chemin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandit de grand chemin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3973c57-7f02-3568-ae3b-233106773c34",
                                        "entry_id": "238b587d-a380-369c-a2ed-4c6fd912176a",
                                        "glosses": [
                                            "Bandit, brigand qui attaque les voyageurs sur les routes pour les dépouiller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebd6de3-77e1-4000-8458-339d9d1a199e",
                                                "sense_id": "a3973c57-7f02-3568-ae3b-233106773c34",
                                                "text": "Ils avaient quitté le Valbise sans incident, aucun bandit de grand chemin ou monstre solitaire rôdant fréquemment sur ces pistes piégeuses n’ayant osé s’en prendre à une armée de près de cinq cents nains !"
                                            },
                                            {
                                                "example_id": "12b03bce-89d9-4d68-87fa-260f8494ec09",
                                                "sense_id": "a3973c57-7f02-3568-ae3b-233106773c34",
                                                "text": "Le narrateur rencontre dans la campagne andalouse un bandit de grand chemin, Don José, ancien militaire devenu meurtrier et contrebandier par amour pour une gitane, Carmen."
                                            },
                                            {
                                                "example_id": "d31ba987-ee2b-46ac-87fe-c25665d876ae",
                                                "sense_id": "a3973c57-7f02-3568-ae3b-233106773c34",
                                                "text": "… et le plus fantastique de cette soudaine apparition fut que le double de Marco n’était pas seul mais multiplié à quatre exemplaires, oui, comme dans je ne sais plus dans quel conte des Mille et Une Nuits, quatre borgnes du même œil, vêtus de cuir, chapeau, blouson, pantalon, foulard rouge autour du cou, large éperon au pied droit ou au pied gauche selon la mode de la Prairie, carabine sur les genoux, la gueule aduste, les mains sales, les doigts bagués, quatre vaqueiros en rut ou quatre bandits de grand chemin prêts à rançonner les voyageurs, quatre hors-la-loi dans une auto invraisemblable, pilotée par le sosie de Marco en personne, quatre types qui se ressemblaient comme des frères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7ebe431-69d1-3974-a55d-15fb22463c79",
                                        "entry_id": "238b587d-a380-369c-a2ed-4c6fd912176a",
                                        "glosses": [
                                            "Personne au comportement totalement injuste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f62d16-44be-4c46-8069-882d90aeb55e",
                                                "sense_id": "a7ebe431-69d1-3974-a55d-15fb22463c79",
                                                "text": "Bronca au palco, un trio aussi injuste qu’incapable, des bandits de grand chemin…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
