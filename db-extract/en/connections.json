                    {
                        "translation_id": "d5c8e932-9f70-46a3-8e98-5b1d8697d628",
                        "source_entry_id": "c448fefa-5e77-3785-83bb-4e7feee7012b",
                        "source_sense_description": "people with whom one is acquainted who can offer help and influence",
                        "target_lang_word": "piston",
                        "target_lang_code": "fr",
