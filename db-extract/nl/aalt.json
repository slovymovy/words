                "translations": [
                    {
                        "translation_id": "8386df21-78c1-4e92-ab78-7d7c9f8c2e88",
                        "source_entry_id": "f543ad28-5745-34e1-9937-338b198f62d3",
                        "source_sense_id": "6f7a0913-1255-35e0-8e58-b8567a88546a",
                        "source_sense_description": "aalt",
                        "target_lang_word": "Jauche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jauche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da2865d9-cf10-3218-b1cb-b28acaa2b7c8",
                                        "entry_id": "88a36cf4-20a9-393e-91c3-438f1871f60a",
                                        "glosses": [
                                            "gesammelte flüssige Exkremente (Harn) von Menschen und Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18835cad-3587-4bc8-ba54-d90e4fc0a0a0",
                                                "sense_id": "da2865d9-cf10-3218-b1cb-b28acaa2b7c8",
                                                "text": "Im Frühjahr bringen die Bauern die Jauche als Dünger auf die Felder."
                                            },
                                            {
                                                "example_id": "c2f3dc9a-33d3-4d11-9534-110345909333",
                                                "sense_id": "da2865d9-cf10-3218-b1cb-b28acaa2b7c8",
                                                "text": "„Eine Pumpe, auf einen Faßwagen montiert, spie Jauche auf die Erntefelder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8868974-32a3-3582-88cf-353c03a55647",
                                        "entry_id": "88a36cf4-20a9-393e-91c3-438f1871f60a",
                                        "glosses": [
                                            "Bereitung aus Wasser und Pflanzenteilen, die zu unterschiedlichen Zwecken im Gartenbau und der Landwirtschaft verwandt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae08b29-7c9f-4c75-a797-fa2aa3e69a95",
                                                "sense_id": "a8868974-32a3-3582-88cf-353c03a55647",
                                                "text": "Im biologischen Gartenbau wird zum Düngen eine Jauche aus Brennnessel- oder Rhabarberblättern genutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21bc995d-976e-3b88-b619-6e07ec56f2df",
                                        "entry_id": "88a36cf4-20a9-393e-91c3-438f1871f60a",
                                        "glosses": [
                                            "übelriechende, schlechte Flüssigkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7693274d-0fd3-45db-8727-c65efe1b37e2",
                                                "sense_id": "21bc995d-976e-3b88-b619-6e07ec56f2df",
                                                "text": "Dieses Bier kann man nicht trinken, das ist ja die reinste Jauche!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cabddad-a081-41e9-90a9-6bb1b9ca7c3c",
                        "source_entry_id": "f543ad28-5745-34e1-9937-338b198f62d3",
                        "source_sense_id": "6f7a0913-1255-35e0-8e58-b8567a88546a",
                        "source_sense_description": "aalt",
                        "target_lang_word": "purin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                        "entry_id": "3fac9be9-ef9d-3db2-b4bc-ad8d40df5e89",
                                        "glosses": [
                                            "Partie liquide du fumier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a12e9b-c7e9-4122-815a-8281ab5631af",
                                                "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                                "text": "Il n’y avait dans la cour, formée par quatre pauvres bâtiments, aucun être vivant, sinon les poules picorant le fumier qui, tout près de la bergerie, baignait dans un lit immonde de purin."
                                            },
                                            {
                                                "example_id": "a0109aef-0f28-412c-8bfa-825264bd8e4b",
                                                "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                                "text": "Il crut marcher une dernière fois dans la grande rue, criblée de soleil, parmi les tas de fumier, suant les flots noirs de purin, […]."
                                            },
                                            {
                                                "example_id": "e926a290-761d-4f5f-93bc-bd7ce3176adf",
                                                "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                                "text": "Le village auvergnat est resté malpropre, boueux, puant, délavé par les purins; il est sans lumières; les conditions d'habitation y sont exécrables."
                                            },
                                            {
                                                "example_id": "4f04084b-d952-44b0-b472-2e4aeb60fd81",
                                                "sense_id": "5c3db7d7-53ab-360a-bc20-09f1aecda08b",
                                                "text": "Les purins, étendus de quatre à six fois leur volume d'eau et utilisés en arrosage dans les cultures de légumes herbacés, communiquent une grande vigueur aux plantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a55b4600-3cc9-33b1-a3c1-e7a304947b28",
                                        "entry_id": "3fac9be9-ef9d-3db2-b4bc-ad8d40df5e89",
                                        "glosses": [
                                            "Produit issu de la macération de certains végétaux, utilisé à des fins de fertilisation ou de traitement des cultures."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b656b0e-47d5-4b9e-8abc-7fdc8bca8e83",
                                                "sense_id": "a55b4600-3cc9-33b1-a3c1-e7a304947b28",
                                                "text": "« Purins » ou « extraits fermentés » ? Peu importe le vocabulaire ... pourvu qu’on puisse en bénéficier !"
                                            },
                                            {
                                                "example_id": "cbf41964-3aa1-4882-b61f-ffc6a0558ba8",
                                                "sense_id": "a55b4600-3cc9-33b1-a3c1-e7a304947b28",
                                                "text": "Prévoyez un récipient par plante, même si, à l’application, les purins de consoude, ortie et prêle peuvent être mélangés pour certaines utilisations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
