                                "sense_id": "b1e46259-2545-3bfc-875d-f95eb337b408",
                                "text": "Hij droeg zijn trui per ongeluk andersom."
                            },
                            {
                                "example_id": "a98c7d26-5d34-4138-a7b2-ad00e497537a",
                                "sense_id": "b1e46259-2545-3bfc-875d-f95eb337b408",
                                "text": "Wat was het probleem? Oorlog was oorlog, maar dat zou jonge mensen er niet van moeten weerhouden te trouwen, eerder andersom."
                            },
                            {
                                "example_id": "bbcebc8a-e33a-41de-a8a7-57a73301a8a0",
                                "sense_id": "b1e46259-2545-3bfc-875d-f95eb337b408",
                                "text": "Eerder andersom, het zou van ons een primaire bedreiging maken die ten koste van alles onschadelijk moest worden gemaakt."
                            }
                        ]
                    }
