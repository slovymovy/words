                                        "glosses": [
                                            "On the deck of a ship, especially of a captain or officer; in charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a349878-1020-43bb-86bd-777ff8555243",
                                                "sense_id": "9be73030-97a0-380c-8386-2834e402a76f",
                                                "text": "In every sense of the expression he is ‘on deck’; but my Jim, for the most part, skulked down below as though he had been a stowaway."
                                            }
