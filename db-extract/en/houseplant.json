                        "glosses": [
                            "A plant that is grown indoors in places such as a house or office for decorative purposes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8edf0d7e-1270-4151-9f4e-a991434a144d",
                                "sense_id": "18059b49-22f2-321c-a4e4-7e2fdc9326bd",
                                "text": "Herbert thought that adding some houseplants would brighten up his desk."
                            }
                        ]
                    },
                    {
                        "sense_id": "852475f6-763c-3ad2-aa9e-cfb153dd954f",
                        "entry_id": "57f54fcb-d1e4-3d6f-b26c-053e82b92ab8",
                        "glosses": [
                            "A variety of plant that is especially suited to such cultivation, or that is frequently grown in such settings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf3ca29-c004-4e5a-a4a7-b4df19336bea",
                                "sense_id": "852475f6-763c-3ad2-aa9e-cfb153dd954f",
                                "text": "\"I always thought a begonia was a houseplant!\" exclaimed Sue, staring at the towering tropical specimen."
                            }
                        ]
                    }
