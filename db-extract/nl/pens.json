                "senses": [
                    {
                        "sense_id": "ed93f853-8acf-379f-8fe4-6d2cad7b4943",
                        "entry_id": "bbadc80b-481d-33fd-a893-c312475e2736",
                        "glosses": [
                            "paunch, rumen"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f8186eda-b166-4444-b500-cef6f15c6bcc",
                                "sense_id": "ed93f853-8acf-379f-8fe4-6d2cad7b4943",
                                "text": "In de pens wordt voedsel voorverteerd.",
                                "translation": "Food is pre-digested in the rumen.",
                                "english": "Food is pre-digested in the rumen."
                            },
                            {
                                "example_id": "8552b6cb-e37d-4b45-8f44-37cfaec5e6ce",
                                "sense_id": "ed93f853-8acf-379f-8fe4-6d2cad7b4943",
                                "text": "1871, F. C. Hekmeijer, Geïllustreerd Veeartsenijkundig Handboek voor elken Landman, voor ieder, die Dieren of Vee houdt, publ. B. Dekema, page 546.\nDe pens heeft 2 openingen, waarvan de bovenste, de maagmond, in den slokdarm voert, de onderste, grootere, is de netmaag-opening en voert in de tweede maag...",
                                "translation": "The rumen has two apertures, of which the upper or cardia leads to the esophagus and the lower and bigger aperture or opening of the reticulum leads to the second stomach...",
                                "english": "The rumen has two apertures, of which the upper or cardia leads to the esophagus and the lower and bigger aperture or opening of the reticulum leads to the second stomach..."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb39e3ea-7507-3a56-a5b8-6798c0de4f90",
                        "entry_id": "bbadc80b-481d-33fd-a893-c312475e2736",
                        "glosses": [
                            "tripe"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "579e244e-64ed-4760-b82e-2a5642b2c696",
                                "sense_id": "eb39e3ea-7507-3a56-a5b8-6798c0de4f90",
                                "text": "Vandaag de dag wordt pens als slachtafval gezien.",
                                "translation": "Nowadays, tripe is regarded as offal.",
                                "english": "Nowadays, tripe is regarded as offal."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a863fdf-d621-3adf-ae2f-bbb9de842370",
                        "entry_id": "bbadc80b-481d-33fd-a893-c312475e2736",
                        "glosses": [
                            "tripe filled with minced meat"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "9523e381-f6c7-43d7-aae7-7f0d5523bb0a",
                                "sense_id": "1a863fdf-d621-3adf-ae2f-bbb9de842370",
                                "text": "Vroeger werd pens veelal thuis gemaakt.",
                                "translation": "In the past, filled tripe was often made at home.",
                                "english": "In the past, filled tripe was often made at home."
                            }
                        ]
                    },
                    {
                        "sense_id": "5115fbb0-468a-38a3-af6f-7d9c1d32a4e8",
                        "entry_id": "bbadc80b-481d-33fd-a893-c312475e2736",
                        "glosses": [
                            "potbelly"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "d33b9878-18a8-45cd-8266-8b9867e39b3a",
                                "sense_id": "5115fbb0-468a-38a3-af6f-7d9c1d32a4e8",
                                "text": "Zo, jij hebt een aardige pens ontwikkeld!",
                                "translation": "Whew, you've developed quite a potbelly!",
                                "english": "Whew, you've developed quite a potbelly!"
                            }
                        ]
                    },
                    {
                        "sense_id": "967109b6-a901-3bad-b7d4-ee0dc7b4f0ce",
                        "entry_id": "bbadc80b-481d-33fd-a893-c312475e2736",
                        "glosses": [
                            "stomach"
                        ],
                        "tags": [
                            "dialectal",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "cdcbc188-a0ee-4bd9-ae4d-cd8ec9615972",
                                "sense_id": "967109b6-a901-3bad-b7d4-ee0dc7b4f0ce",
                                "text": "De hond heeft een opgezwollen pens.",
                                "translation": "The dog has a distended stomach.",
                                "english": "The dog has a distended stomach."
                            },
                            {
                                "example_id": "4e2bc045-5be4-4fce-a0de-0e979dc65f11",
                                "sense_id": "967109b6-a901-3bad-b7d4-ee0dc7b4f0ce",
                                "text": "(Hij) zwoer bij kris en kras dat hij den gevangen monsters (t.w. haaien) dikwijls levende jongen uit hun ”pens” had gehaald...",
                                "translation": "(He) swore up and down that he had often extricated live young from the ”stomachs” of the captured monsters (i.e. sharks)...",
                                "english": "(He) swore up and down that he had often extricated live young from the ”stomachs” of the captured monsters (i.e. sharks)..."
                            }
                        ]
                    }
                ],
