                "senses": [
                    {
                        "sense_id": "2cc4d8ef-6df6-394f-b2bc-fe9cd35ac7e5",
                        "entry_id": "004faf9a-c69a-35f3-bf4c-5b361f6c0cfe",
                        "glosses": [
                            "der wissenschaftliche Name für die Domäne der Archaeen (Singular: Archaeon) im aktuellen Drei-Domänen-System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f29f597-ac7f-4aaa-b281-96473ddb6c11",
                                "sense_id": "2cc4d8ef-6df6-394f-b2bc-fe9cd35ac7e5",
                                "text": "„[…] weitreichende Fortschritte in der molekularen Biologie machten eine generelle Änderung der Taxonomie notwendig: Eubakterien und Archaebakterien wurden in Bacteria und Archaea umbenannt und 1990 als eigenständige Domänen neben der Domäne der Eukarya im Rahmen des Drei-Domänen-Systems beschrieben.“"
                            },
                            {
                                "example_id": "b1950ae5-a092-43dd-8fe4-1f163307fdac",
                                "sense_id": "2cc4d8ef-6df6-394f-b2bc-fe9cd35ac7e5",
                                "text": "„Da es zahlreiche Unterschiede zwischen Archaea und Bacteria gibt, geht man davon aus, dass sich die Entwicklungslinien dieser beiden prokaryotischen Reiche früh getrennt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
