                            "singular"
                        ],
                        "form": "den Blogger"
                    },
                    {
                        "form_id": "a1d4cdbe-70e3-4e8f-843b-9b600d4d2c47",
                        "entry_id": "e07bcf5f-8c8e-3388-a9c0-7a5564f17645",
                        "tags": [
                            "accusative",
