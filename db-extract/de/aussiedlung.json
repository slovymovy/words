                        "examples": [
                            {
                                "example_id": "5364818e-90f6-46d2-8bb5-b95e740b2912",
                                "sense_id": "8bd34fee-fd9e-3de5-b303-895e0e676255",
                                "text": "Die Aussiedlung fand früh am Morgen statt."
                            },
                            {
                                "example_id": "b10dc534-40f4-44f1-85d4-b0d9ef9075c0",
                                "sense_id": "8bd34fee-fd9e-3de5-b303-895e0e676255",
                                "text": "„Im Januar 1946 beginnt die organisierte Aussiedlung der Deutschen, parallel dazu ziehen jetzt immer mehr Tschechen zu.“"
                            },
                            {
                                "example_id": "d9be4972-4ebc-4cc3-89f1-54d5201fac84",
                                "sense_id": "8bd34fee-fd9e-3de5-b303-895e0e676255",
                                "text": "„Die Belegschaften der Brünner Betriebe verlangten die sofortige Aussiedlung der arbeitsunfähigen deutschen Bevölkerung.“"
                            }
                        ],
