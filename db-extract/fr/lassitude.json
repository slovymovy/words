        "de-extract.jsonl": [
            {
                "entry_id": "8d09627e-4fc8-3647-8e2b-c479b2f644a5",
                "word": "lassitude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "12fac80e-163f-3f27-bfed-380bc60a74b8",
                        "entry_id": "8d09627e-4fc8-3647-8e2b-c479b2f644a5",
                        "glosses": [
                            "Müdigkeit"
                        ],
                        "tags": [],
                        "examples": [],
