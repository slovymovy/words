                    {
                        "translation_id": "6950a331-ba6e-42de-b940-950f2c8fbaa2",
                        "source_entry_id": "763ab28c-6605-3d96-8622-2e03c5cca381",
                        "source_sense_id": "5700bc8e-1a36-3fc6-80e1-49f96adcb3d6",
                        "target_lang_word": "Anästhesist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anästhesist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e12f2884-1f18-30a1-875a-6465c610b9ff",
                                        "entry_id": "95f8002c-68cc-3f3c-a818-7c731b84c55c",
                                        "glosses": [
                                            "Arzt mit Anästhesie als Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796cfd4b-e2c5-4ff8-9a3f-e19de66db91e",
                                                "sense_id": "e12f2884-1f18-30a1-875a-6465c610b9ff",
                                                "text": "„Im Rahmen operativer Eingriffe müssen die Folgen des sog. Operationstraumas vom Anästhesisten behandelt werden.“"
                                            },
                                            {
                                                "example_id": "f8ba7650-00c2-4411-bdb1-14a468733953",
                                                "sense_id": "e12f2884-1f18-30a1-875a-6465c610b9ff",
                                                "text": "„Der Patient, der dem Anästhesisten Kai Zacharowski den Glauben an sein Lehrbuchwissen raubte, war Zeuge Jehovas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54af7af5-1067-44a2-8456-3ef75c850ca3",
                        "source_entry_id": "763ab28c-6605-3d96-8622-2e03c5cca381",
                        "source_sense_id": "5700bc8e-1a36-3fc6-80e1-49f96adcb3d6",
                        "target_lang_word": "Narkosearzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narkosearzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26a7a42f-e67c-37a7-bc55-729e04a675f9",
                                        "entry_id": "5531fa18-4988-3907-94ac-3413f8e67a20",
                                        "glosses": [
                                            "Arzt, der bei Operationen die Betäubung (Narkose) des Patienten durchführt oder leitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76226302-34b6-4ec6-bd7c-831bac2ab761",
                                                "sense_id": "26a7a42f-e67c-37a7-bc55-729e04a675f9",
                                                "text": "Bei dieser Operation waren mehrere Narkoseärzte zugegen."
                                            },
                                            {
                                                "example_id": "0e347c01-25d1-4927-858d-65dc45b97f24",
                                                "sense_id": "26a7a42f-e67c-37a7-bc55-729e04a675f9",
                                                "text": "Vor dem Eingriff ist ein Gespräch mit Ihrem Narkosearzt geplant."
                                            },
                                            {
                                                "example_id": "7a67e515-2f34-47e7-a00a-9d9f4abb98cf",
                                                "sense_id": "26a7a42f-e67c-37a7-bc55-729e04a675f9",
                                                "text": "„»Also wenn wir operieren machen wir das so, dass wir die Patienten hier hinsitzen lassen, da kommt ein Stühlchen hin. Dann kommt ein Aufklärungsgespräch mit dem Narkosearzt hier in dem Raum.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
