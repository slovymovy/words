                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a24bc9f-5962-4955-97f2-c3fb67261020",
                                                "sense_id": "4e5c17c2-bcd5-3407-8862-82e6287dd827",
                                                "text": "Куртизанка Виолетта Валери устраивает званый вечер в своём салоне."
                                            },
                                            {
                                                "example_id": "2546d794-52c7-465a-955d-48328d5e5ae8",
                                                "sense_id": "4e5c17c2-bcd5-3407-8862-82e6287dd827",
                                                "text": ".. ласково похлопал своего верного любимца по крупу и, легко вскочив в седло, ровной, неторопливой рысью направился в сторону замка виконтессы Виолетты дю Мон де ла Кур…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
