                "senses": [
                    {
                        "sense_id": "a1c4c702-e3c0-3d49-a884-73e773d1b51e",
                        "entry_id": "8bced162-a98f-38e6-8958-28af9b1e3de0",
                        "glosses": [
                            "waschaktive Substanz, die (ohne Seifen hergestellt ist und) zur schonenden Reinigung (der Haut) verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6572d5-bceb-4491-9ffa-817ec34c5207",
                                "sense_id": "a1c4c702-e3c0-3d49-a884-73e773d1b51e",
                                "text": "„Die Rezeptur des Präparats basiert auf dem Auszug aus Portulak (PortulacaOleracea), wodurch es die Reizungen nach der Anwendung der Detergentia mildert.“"
                            },
                            {
                                "example_id": "451367a9-1d26-4539-81ce-a526bda687b3",
                                "sense_id": "a1c4c702-e3c0-3d49-a884-73e773d1b51e",
                                "text": "„Detergenzien, ursprünglich im deutschen Sprachgebrauch grenzflächenaktive Stoffe, für die heute der Begriff Tenside gilt.“"
                            },
                            {
                                "example_id": "6fa8e911-06bd-4f58-a749-ce1b228c461f",
                                "sense_id": "a1c4c702-e3c0-3d49-a884-73e773d1b51e",
                                "text": "„TEA-Laurylsulfat wird in der Kosmetik als Detergens, als Stabilisator für Dispergiersysteme und als Lösungsvermittler für Duftstoffe eingesetzt.“"
                            },
                            {
                                "example_id": "f4db9897-e34b-4e60-af0d-da5648641607",
                                "sense_id": "a1c4c702-e3c0-3d49-a884-73e773d1b51e",
                                "text": "Syndet steht für Synthetisches Detergens, eine medizinische Seife oder auch ein mildes, alkalifreies, synthetisches Waschmittel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ec91ca43-4dd1-3797-b0f8-01d3998ae4ba",
                        "entry_id": "8bced162-a98f-38e6-8958-28af9b1e3de0",
                        "glosses": [
                            "Mittel, das reinigt und desinfiziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a24782c6-1ca6-493c-b8ce-bfcb04fdaa7d",
                                "sense_id": "ec91ca43-4dd1-3797-b0f8-01d3998ae4ba",
                                "text": "„Durch Acid. lactic. ist die Emulsion auf einen pH-Wert von 5,5 eingestellt. Wirkung: pHisoHex ist ein hochaktives Detergens, d. h. Netzmittel und zeichnet sich durch eine hohe Waschaktivität aus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
