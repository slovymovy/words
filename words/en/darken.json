                    ]
                },
                {
                    "sense_id": "60ed8898-6689-3a0c-8280-846a00720894",
                    "sense_definition": "To become more serious, sad, or gloomy in mood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mood_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His expression seemed to <w>darken</w> when he heard the news."
                        },
                        {
                            "text": "Her eyes <w>darken</w> whenever she thinks about the past."
