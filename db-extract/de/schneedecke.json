                    },
                    {
                        "translation_id": "739cfe38-3972-44f6-ba28-f72294885459",
                        "source_entry_id": "2351ec12-6edd-37bf-94d3-32108cd9aae6",
                        "source_sense_id": "deab02bd-4c49-3c17-b287-045bee5f6bae",
                        "source_sense_description": "Lage von Schnee auf dem Boden",
                        "target_lang_word": "couche de neige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e586bf03-21b1-4c25-bdb1-ec545fd7d377",
                        "source_entry_id": "2351ec12-6edd-37bf-94d3-32108cd9aae6",
                        "source_sense_id": "deab02bd-4c49-3c17-b287-045bee5f6bae",
                        "source_sense_description": "Lage von Schnee auf dem Boden",
                        "target_lang_word": "manteau neigeux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manteau neigeux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf4b9d3-2e32-3b45-aac7-c6960f57b681",
                                        "entry_id": "45f03d35-d724-330d-82fc-976d78cd0987",
                                        "glosses": [
                                            "Dépôt de précipitations de neige au sol ou sur un toit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891ec0de-3f20-4ffe-a7a2-08e81c502cb6",
                                                "sense_id": "9bf4b9d3-2e32-3b45-aac7-c6960f57b681",
                                                "text": "Une avalanche correspond à un déplacement rapide d’une masse de neige sur une pente, provoqué par une rupture d’équilibre du manteau neigeux."
                                            },
                                            {
                                                "example_id": "d33943ce-e343-419d-a139-2611e595def9",
                                                "sense_id": "9bf4b9d3-2e32-3b45-aac7-c6960f57b681",
                                                "text": "Une fois au sol, la neige contribue à la constitution du manteau neigeux, un feuilletage de couches superposées correspondant aux chutes de neige successives. Ensuite, sa structure et sa densité évoluent en fonction des conditions météorologiques."
                                            },
                                            {
                                                "example_id": "5ac53c36-c2c1-45d1-b66c-916f1afa7766",
                                                "sense_id": "9bf4b9d3-2e32-3b45-aac7-c6960f57b681",
                                                "text": "À 2000 m en versant nord, le manteau neigeux reste partout épais, le plus généralement entre 1,40 m et 2 m, moins toutefois en Vanoise et en Haute-Maurienne, 1,10 m ou 1,20 m. En versant sud, il y a en général entre 1 m et 1,25 m de neige, moins toutefois dans la moitié sud de la Savoie, 50 à 70 cm."
                                            },
                                            {
                                                "example_id": "0b4e0238-50d8-41b2-8fb5-2970e9890586",
                                                "sense_id": "9bf4b9d3-2e32-3b45-aac7-c6960f57b681",
                                                "text": "Le nivologue a recours à différents moyens pour effectuer des prévisions. Il peut utiliser des mesures qui sont faites deux fois par jour sur des zones non damées et non skiées. Il peut aussi réaliser un sondage par battage du manteau neigeux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbe655b4-9d09-4f9f-872f-6e6c32b93182",
