{
    "word_family": [
        "stier"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "57918315-9ad3-3402-9de7-164472fbaa6f",
                    "sense_definition": "heel erg, in hoge mate (vooral gebruikt bij werkwoorden die verveling of onvrede uitdrukken)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensivering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De studenten verveelden zich <w>stierlijk</w> tijdens de lange en saaie presentatie over de geschiedenis van de boekhouding.",
                            "target_lang_translations": {
                                "en": "The students were <w>bored to tears</w> during the long and boring presentation on the history of accounting."
                            }
                        },
                        {
                            "text": "Ik heb me gisteren <w>stierlijk</w> verveeld omdat er de hele middag niets te doen was op het kantoor.",
                            "target_lang_translations": {
                                "en": "I was <w>bored stiff</w> yesterday because there was nothing to do at the office all afternoon."
                            }
                        }
                    ],
                    "synonyms": [
                        "als een stier"
                    ],
                    "common_phrases": [
                        "stierlijk vervelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in informele taal om verveling te benadrukken"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "extremely, to a high degree (primarily used with verbs expressing boredom or dissatisfaction)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bored to tears",
                                "target_lang_sense_clarification": "used specifically with boredom"
                            },
                            {
                                "target_lang_word": "bored stiff",
                                "target_lang_sense_clarification": "informal expression for extreme boredom"
                            },
                            {
                                "target_lang_word": "utterly",
                                "target_lang_sense_clarification": "general intensifier for negative states"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dcc565a-d741-375e-89b6-778363540132",
                    "sense_definition": "op een nadrukkelijke of grimmige wijze, in zeer sterke mate",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensivering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij ergerde zich <w>stierlijk</w> aan de constante onderbrekingen van zijn collega tijdens de belangrijke vergadering.",
                            "target_lang_translations": {
                                "en": "He was <w>terribly</w> annoyed by his colleague's constant interruptions during the important meeting."
                            }
                        },
                        {
                            "text": "Het was <w>stierlijk</w> koud buiten, waardoor niemand zin had om een wandeling in het park te maken.",
                            "target_lang_translations": {
                                "en": "It was <w>bitterly</w> cold outside, so no one felt like taking a walk in the park."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stierlijk ergeren"
                    ],
                    "target_lang_definitions": {
                        "en": "in an emphatic or grim manner, to a very strong degree"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "terribly",
                                "target_lang_sense_clarification": "used to intensify annoyance or discomfort"
                            },
                            {
                                "target_lang_word": "immensely",
                                "target_lang_sense_clarification": "to a great extent"
                            },
                            {
                                "target_lang_word": "bitterly",
                                "target_lang_sense_clarification": "specifically used for cold weather"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}