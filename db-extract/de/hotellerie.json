                "senses": [
                    {
                        "sense_id": "994534ee-25b9-3adb-846a-446c38a21a62",
                        "entry_id": "ae601801-cebd-3da1-9996-f43dbd99a365",
                        "glosses": [
                            "Gesamtheit der Hotels mit ihren Dienstleistungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "431ad5b1-1ba9-4cee-b45e-f7c1601e8fbf",
                                "sense_id": "994534ee-25b9-3adb-846a-446c38a21a62",
                                "text": "„Der hatte eigentlich geplant, sich nach dem Ende seiner Ausbildung zum Hotelfachmann auf Wanderschaft durch die Hotellerie Europas zu begeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fba9dd19-ec0f-4d40-839f-9b48cba31f37",
                        "source_entry_id": "ae601801-cebd-3da1-9996-f43dbd99a365",
                        "source_sense_id": "994534ee-25b9-3adb-846a-446c38a21a62",
                        "source_sense_description": "Gesamtheit der Hotels mit ihren Dienstleistungen",
                        "target_lang_word": "hôtellerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hôtellerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9807d1fc-70b9-3178-87ae-68e088ae41cc",
                                        "entry_id": "ce068d70-413e-3bce-8db2-b76720c6dc86",
                                        "glosses": [
                                            "Maison où les voyageurs et les passants sont logés et nourris pour leur argent."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f2125a6-b3b2-4937-bce5-b062bcfe93bd",
                                                "sense_id": "9807d1fc-70b9-3178-87ae-68e088ae41cc",
                                                "text": "C’était dans ces riantes hôtelleries, préparées par le Grand Esprit, que nous nous reposions à l’ombre."
                                            },
                                            {
                                                "example_id": "0c09e6d3-eedb-4a3d-bfb2-235d314ba5e8",
                                                "sense_id": "9807d1fc-70b9-3178-87ae-68e088ae41cc",
                                                "text": "[…], puis, ayant demandé à quelle hôtellerie se réunissaient plus particulièrement les archers, et, ayant appris que c’était au Héron-d’Or, il se dirigea vers cette auberge, […]."
                                            },
                                            {
                                                "example_id": "966a764e-188b-484b-839c-3bbd40c1e385",
                                                "sense_id": "9807d1fc-70b9-3178-87ae-68e088ae41cc",
                                                "text": "Ce jeune gentilhomme, […] jetant un regard assez dédaigneux sur les nombreuses hôtelleries qui étalaient à sa droite et à sa gauche leurs pittoresques enseignes, laissa pénétrer son cheval tout fumant jusqu’au cœur de la ville, […]."
                                            },
                                            {
                                                "example_id": "00575034-c961-4550-bbbd-58666928433b",
                                                "sense_id": "9807d1fc-70b9-3178-87ae-68e088ae41cc",
                                                "text": "De sur mon cheval gris, à Paris je vous mène dans une hôtellerie. — (Les Charbonnier de l'enfer, Dans la ville de Paris, 1996)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77ca1f8d-d660-3d61-96d0-3649613c45ab",
                                        "entry_id": "ce068d70-413e-3bce-8db2-b76720c6dc86",
                                        "glosses": [
                                            "Restaurant à la mode."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af397a54-7ad8-3772-9aec-ef1d0e8fb8c4",
                                        "entry_id": "ce068d70-413e-3bce-8db2-b76720c6dc86",
                                        "glosses": [
                                            "Corps de logis destiné à recevoir les étrangers, dans les grandes abbayes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bb8aa91-bb69-48c8-994b-7ed60bf74d2f",
                                                "sense_id": "af397a54-7ad8-3772-9aec-ef1d0e8fb8c4",
                                                "text": "Et les conditions imposées à ces pèlerinages étaient telles, qu’elles eussent dû décourager les volontés les plus tenaces. Avant d’atteindre l’hôtellerie perchée près de l’église, il faut, pendant des heures, subir les roulements paresseux des trains, endurer des changements répétés de lignes, supporter des journées de diligences, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e737e4-4bf7-3bc3-bcee-745deb7974cf",
                                        "entry_id": "ce068d70-413e-3bce-8db2-b76720c6dc86",
                                        "glosses": [
                                            "Milieu professionnel des hôtels."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
