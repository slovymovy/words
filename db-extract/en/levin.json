                        ],
                        "examples": [
                            {
                                "example_id": "213d4150-0e98-445a-838b-1a75ebd545a4",
                                "sense_id": "8c48b258-2bca-3af1-bace-41fb25595418",
                                "text": "According to the most recent available disclosures, UDP has spent more than $910,000 backing Stevens. AIPAC, a hawkish pro-Israel group that supports both Democrats and Republicans, endorsed Stevens and has attacked Levin, who is Jewish and comes from one of Michigan’s most prominent Jewish political families, over his willingness to criticize some Israeli policy."
                            }
                        ]
                    },
