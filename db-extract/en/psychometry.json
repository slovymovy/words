    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4b57e71e-1398-3f89-ba23-8d5c0682950a",
                "word": "psychometry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2731991f-75e8-4dd1-a975-6b7ef7f038ce",
                        "entry_id": "4b57e71e-1398-3f89-ba23-8d5c0682950a",
                        "tags": [
                            "plural"
                        ],
                        "form": "psychometries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a621f9d2-ea35-3c60-a450-b1a259043f79",
                        "entry_id": "4b57e71e-1398-3f89-ba23-8d5c0682950a",
                        "glosses": [
                            "The paranormal ability to discover information about an object's past, and especially about its past owners, merely by handling it."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7be04960-ab0c-4cf9-9f44-6f322ed2063c",
                                "sense_id": "a621f9d2-ea35-3c60-a450-b1a259043f79",
                                "text": "\"Their power and knowledge are as closely limited as ours. But this is not a matter for the spirit people. What I did then was psychometry, which, so far as we know, is a power of the human soul.\""
                            },
                            {
                                "example_id": "8b30fdd6-3b92-44c8-ad81-146f02643715",
                                "sense_id": "a621f9d2-ea35-3c60-a450-b1a259043f79",
                                "text": "Then there is that queer practice of the whites, psychometry, by which mediumistic people claim they can, by handling any object, tell events that occurred to the owner of it."
                            }
                        ]
                    },
                    {
                        "sense_id": "43dc0cea-75ad-371b-8864-ea5007ee24e9",
                        "entry_id": "4b57e71e-1398-3f89-ba23-8d5c0682950a",
                        "glosses": [
                            "The use of psychological tests to measure intelligence, abilities, attitudes, and personality traits."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e5dc501a-b1e8-4ff6-b806-5d3d12f1fe04",
                                "sense_id": "43dc0cea-75ad-371b-8864-ea5007ee24e9",
                                "text": "In psychometry and paedometry his original contributions will be little unless he had equipped himself well with the subjects like mathematics and statistics."
                            },
                            {
                                "example_id": "1313848b-3442-4eaf-8b0c-b066dfeff346",
                                "sense_id": "43dc0cea-75ad-371b-8864-ea5007ee24e9",
                                "text": "Again, barring in a few universities psychometry and physiological psychology are not regarded as compulsory papers."
                            }
                        ]
                    }
                ],
                "translations": [
