                                    },
                                    {
                                        "sense_id": "79a7c19c-bc49-3222-9b85-c9093680cdc3",
                                        "entry_id": "c521802e-9591-397a-ad81-bcb78b5adb2c",
                                        "glosses": [
                                            "A level or degree."
