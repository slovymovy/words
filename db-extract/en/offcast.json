                    },
                    {
                        "sense_id": "2a91c821-bf88-3741-b065-2be388ba0210",
                        "entry_id": "dc0441ff-af80-3825-b80e-fd26f722db57",
                        "glosses": [
                            "To remove from the cast of a production."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "58b807de-5923-475f-a6df-3e16492cfc31",
                                "sense_id": "2a91c821-bf88-3741-b065-2be388ba0210",
                                "text": "The experiment to offcast Davis began in 1937 with That Certain Woman; \"She's a lady,\" we are told."
                            },
                            {
                                "example_id": "cb286f2c-330c-4684-bd42-2281ae23b61a",
                                "sense_id": "2a91c821-bf88-3741-b065-2be388ba0210",
                                "text": "[...] and Paramount was not inclined to offcast its stars, the story was dropped."
                            },
                            {
                                "example_id": "43e4befa-4c96-440a-82b4-3704bcf64e2f",
                                "sense_id": "2a91c821-bf88-3741-b065-2be388ba0210",
                                "text": "White actresses were able to maintain a more multidimensional star persona than actresses of color, thanks in large part to their ability to off-cast themselves in challenging roles and control their off-screen image through publicity."
                            }
                        ]
                    }
