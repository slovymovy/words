                                        "glosses": [
                                            "het graag en veel willen geven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08ad915-9e70-4c38-be57-11a1712c2108",
                                                "sense_id": "f6edd3b5-2ab4-39de-ac77-47dd4dcef967",
                                                "text": "De vrijgevigheid van de oude man was alom bekend en gewaardeerd."
                                            },
                                            {
                                                "example_id": "e1b0c07a-6b22-45e4-b73e-e4b1abcc28ce",
                                                "sense_id": "f6edd3b5-2ab4-39de-ac77-47dd4dcef967",
                                                "text": "Ik was overweldigd door hun vrijgevigheid en oprechte vriendelijkheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
