                        "glosses": [
                            "Action de dévorer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d5ae2a-7fb9-4afa-a393-a3b011457f5f",
                                "sense_id": "7c637a55-790b-312b-ab64-5f6889199a2c",
                                "text": "Deux choses avaient changé en elle : l'entrain qu'elle mettait dans chaque journée pour la rendre plus jolie, et la dévorance dans son ventre, qui ne la lâchait pas."
                            },
                            {
                                "example_id": "149e310a-8043-4ca4-af3d-06d4eb173861",
                                "sense_id": "7c637a55-790b-312b-ab64-5f6889199a2c",
                                "text": "...à la dévorance n'y aurait-il d'autre remède que la dévorance ?"
                            },
                            {
                                "example_id": "70a1cdb4-1bc4-4ea0-b7c3-f4ddc04f0c1e",
                                "sense_id": "7c637a55-790b-312b-ab64-5f6889199a2c",
                                "text": "Et des milliers de fourmis en avaient pris possession. Une multitude affamée qui, dans sa dévorance, lui redonnait presque un semblant de vie."
                            }
                        ]
                    }
