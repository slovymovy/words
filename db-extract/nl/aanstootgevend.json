                ],
                "senses": [
                    {
                        "sense_id": "27b6eb1f-8f21-35a3-aece-85fdfe126ad3",
                        "entry_id": "4fd4b759-d6cd-3b10-86d2-9a9a394b688b",
                        "glosses": [
                            "ergernis veroorzakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7879eab-ce1f-45f9-b868-6dfa4da47687",
                                "sense_id": "27b6eb1f-8f21-35a3-aece-85fdfe126ad3",
                                "text": "Hij sloeg aanstootgevende taal uit tegen die aardige man."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54f6e1da-6861-4adb-b98d-815d552b88b8",
                        "source_entry_id": "4fd4b759-d6cd-3b10-86d2-9a9a394b688b",
                        "source_sense_id": "27b6eb1f-8f21-35a3-aece-85fdfe126ad3",
                        "target_lang_word": "anstößig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anstößig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d80a4da-078e-36fb-8bcc-0a17ec251e5b",
                                        "entry_id": "7b435c0e-8801-3264-97fc-d8dedca128b8",
                                        "glosses": [
                                            "Anstoß erregend, unschicklich, obszön"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599b9793-e6dc-419d-a91a-034aba0bf928",
                                                "sense_id": "0d80a4da-078e-36fb-8bcc-0a17ec251e5b",
                                                "text": "Theo bemüht sich auf seinen Reisen in ferne Länder stets, sich nicht anstößig zu verhalten."
                                            },
                                            {
                                                "example_id": "d54cc793-c7cd-437c-8671-787abaf45852",
                                                "sense_id": "0d80a4da-078e-36fb-8bcc-0a17ec251e5b",
                                                "text": "„Sie gab mir ihren Schmuckkasten mit allen Diamanten, all ihr Geld außer einer geringen Summe, alle anstößigen Bücher, die sie besaß, und alle ihre Briefe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee3a4376-2056-4a15-a7cc-955668b9d4dc",
                        "source_entry_id": "4fd4b759-d6cd-3b10-86d2-9a9a394b688b",
                        "source_sense_id": "27b6eb1f-8f21-35a3-aece-85fdfe126ad3",
                        "target_lang_word": "scandalous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scandalous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7e11b78-a48c-3f34-a8db-f7a46bbca721",
                                        "entry_id": "d9f92b02-80c9-3b1a-b927-9be11c1df0ba",
                                        "glosses": [
                                            "Of a thing: causing or having the nature of a scandal; regarded as so immoral or wrong as to be extremely disgraceful; despicable, shameful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191317c2-8616-4fde-955e-64fc265a9a67",
                                                "sense_id": "f7e11b78-a48c-3f34-a8db-f7a46bbca721",
                                                "text": "[S]omthing ſauors / Of Tyrannie, and vvill ignoble make you, / Yea, ſcandalous to the VVorld."
                                            },
                                            {
                                                "example_id": "d5e24fbc-70b9-4969-b5d4-2d230c46a4e0",
                                                "sense_id": "f7e11b78-a48c-3f34-a8db-f7a46bbca721",
                                                "text": "Maſters commands come vvith a povver reſiſtleſs / To ſuch as ovve them abſolute ſubjection; / And for a life vvho vvill not change his purpoſe? / (So mutable are all the vvays of men) / Yet this be ſure, in nothing to comply / Scandalous or forbidden in our Lavv."
                                            },
                                            {
                                                "example_id": "078631d7-8ee3-4e8c-be65-73a722f49a8d",
                                                "sense_id": "f7e11b78-a48c-3f34-a8db-f7a46bbca721",
                                                "text": "As the vvhole buſineſs, in vvhich the Courts uſually take an intereſt, goes on at preſent equally vvell, in vvhatever hands, vvhether high or lovv, vviſe or fooliſh, ſcandalous or reputable; there is nothing to hold it firm to any one body of men, or to any one conſiſtent scheme of politicks."
                                            },
                                            {
                                                "example_id": "66967d83-441a-4164-a127-f6b3500d2f4f",
                                                "sense_id": "f7e11b78-a48c-3f34-a8db-f7a46bbca721",
                                                "text": "\"I have heard something of such a matter,\" said the Glover, \"and was this instant setting forth to Kinfauns, to plead my innocence of this scandalous charge, to ask your lordship's counsel, and to implore your protection.\""
                                            },
                                            {
                                                "example_id": "0f79c106-3423-44aa-9838-d4ac16601fe2",
                                                "sense_id": "f7e11b78-a48c-3f34-a8db-f7a46bbca721",
                                                "text": "The treasurer soon found that, in using scandalous means for the purpose of attaining a laudable end, he had committed, not only a crime, but a folly. The queen was now his enemy."
                                            },
                                            {
                                                "example_id": "4d11cc3d-6e96-4af9-b471-8bb32b60ce69",
                                                "sense_id": "f7e11b78-a48c-3f34-a8db-f7a46bbca721",
                                                "text": "The thing made a big stir in the town, too, and a good many come out flat-footed and said it was scandalous to separate the mother and the children that way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1858b28-7c3d-3b10-b2d6-976842eaa679",
                                        "entry_id": "d9f92b02-80c9-3b1a-b927-9be11c1df0ba",
                                        "glosses": [
                                            "Of a person: delighted by scandal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b197d1c-ca47-4e86-9b04-c362558d8c43",
                                                "sense_id": "b1858b28-7c3d-3b10-b2d6-976842eaa679",
                                                "text": "You are the stateliest deer in all the herd— / Beyond his aim—but I am small and scandalous, / And love to hear bad tales of Philip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                        "entry_id": "d9f92b02-80c9-3b1a-b927-9be11c1df0ba",
                                        "glosses": [
                                            "Of speech or writing: defamatory, malicious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee5bb8b-e266-41e1-bc75-77cd79327966",
                                                "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                                "text": "Theſe be the ſcandalous reportes of ſuch, / As loues not mee, and hate my Lord too much."
                                            },
                                            {
                                                "example_id": "9549ce48-300b-443c-9059-4645a457c87c",
                                                "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                                "text": "Shall vve thus permit / A blaſting and ſcandalous breath to fall, / On him ſo neere vs?"
                                            },
                                            {
                                                "example_id": "94dba219-b879-436f-ac43-68b856513e50",
                                                "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                                "text": "He has a Humour more prevailing than his Curioſity, and vvill vvillingly diſpence vvith the hearing of one ſcandalous Story, to avoid giving an occaſion to make another by being ſeen to vvalk vvith his VVife."
                                            },
                                            {
                                                "example_id": "893f6efb-29d7-4604-bd41-3a9ebb12dc8d",
                                                "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                                "text": "Nay, the moſt ſcandalous Tongues have never dared cenſure my Reputation."
                                            },
                                            {
                                                "example_id": "c5bd9b89-b2de-41c4-b29f-4be02293994b",
                                                "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                                "text": "[I]t is novv held that for ſcandalous vvords of the ſeveral ſpecies before-mentioned, that may endanger a man in lavv, may exclude him from ſociety, may impair his trade, or may affect a peer of the realm, a magiſtrate, or one in public truſt, an action on the caſe may be had, vvithout proving any particular damage to have happened, but merely upon the probability that it might happen."
                                            },
                                            {
                                                "example_id": "d855039a-062e-46c8-bd15-cf3c00565ab5",
                                                "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                                "text": "Know you not / That, in distraining for ten thousand pounds / Upon his books and furniture at Lincoln, / Were found these scandalous and seditious letters / Sent from one Osbaldistone, who is fled?"
                                            },
                                            {
                                                "example_id": "e71df70b-d48e-42a5-8a4a-5e4820823e1a",
                                                "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                                "text": "[…] I assure you I never had any suspicions of you at all. I always disregard gossip—it is generally scandalous, and seldom true."
                                            },
                                            {
                                                "example_id": "2fd73cdb-6ba2-427c-ab46-85d7b6e8e8ff",
                                                "sense_id": "b9825306-7c5e-3332-90bc-f7cb56fc8641",
                                                "text": "The closest Believe gets to scandalous is on the deluxe-edition bonus track “Maria,” a response song to the woman who accused [Justin] Bieber of fathering her child in 2011."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3515b4e7-97ad-3497-aefc-fe5a181303b1",
                                        "entry_id": "d9f92b02-80c9-3b1a-b927-9be11c1df0ba",
                                        "glosses": [
                                            "Exceeding reasonable limits; outrageous."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc908db-ecc8-49bb-b352-a5144e9b7c74",
                                                "sense_id": "3515b4e7-97ad-3497-aefc-fe5a181303b1",
                                                "text": "Day after day passed away without bringing any other tidings of him than the report which shortly prevailed in Meryton of his coming no more to Netherfield the whole winter; a report which highly incensed Mrs. Bennet, and which she never failed to contradict as a most scandalous falsehood."
                                            },
                                            {
                                                "example_id": "a6ebdd6a-290a-4194-9658-50e9556511cb",
                                                "sense_id": "3515b4e7-97ad-3497-aefc-fe5a181303b1",
                                                "text": "There was a blizzard on. The cold was something frightful. Made one quite thankful to get back to the fug, though as a rule I think the way these trains are overheated is something scandalous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a813eeb-483c-3f5c-8f1f-f439d074636f",
                                        "entry_id": "d9f92b02-80c9-3b1a-b927-9be11c1df0ba",
                                        "glosses": [
                                            "Of a person: guilty of extremely disgraceful conduct or some misconduct; infamous; also, unfit for their office or position due to misconduct, etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e5f199-2087-4c8e-9662-f75e25e73daa",
                                                "sense_id": "5a813eeb-483c-3f5c-8f1f-f439d074636f",
                                                "text": "[H]e vvas enabled [financially] to become charitable to the poor, and kind to his friends, and to make ſuch proviſion for his children, that they vvere not left ſcandalous, as relating to their or his Profeſſion and Quality."
                                            },
                                            {
                                                "example_id": "ace3c09a-a7cf-42b6-adab-d214da25c9c8",
                                                "sense_id": "5a813eeb-483c-3f5c-8f1f-f439d074636f",
                                                "text": "[T]hey [Parliament] ſeemed inclinable to abate the renunciation of the Covenant, the aſſent and conſent to the diſpenſing vvith Ceremonyes, the reforming the Biſhops Courts, the taking avvay of Pluralityes, the rectifying of Excommunications, the puniſhing of ſcandalous Clergymen, and ſeverall things of this nature, […]"
                                            },
                                            {
                                                "example_id": "4514ac02-29f5-45a9-ba87-85099b74daa8",
                                                "sense_id": "5a813eeb-483c-3f5c-8f1f-f439d074636f",
                                                "text": "[T]he Houſe of Peers had aſſign'd him ſuch Council as he deſired, to aſſiſt him in matter of Lavv (vvhich never vvas, or can juſtly be denied to the moſt ſcandalous Felon, the moſt inhuman Murtherer, or the moſt infamous Traitor) […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5643803f-03d8-32eb-9213-9cf842761256",
                                        "entry_id": "d9f92b02-80c9-3b1a-b927-9be11c1df0ba",
                                        "glosses": [
                                            "Of information, a statement, etc.: not pertinent to a matter; irrelevant, and bringing the court into disrepute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0dca67-d493-4295-b159-2b2252400aff",
                                                "sense_id": "5643803f-03d8-32eb-9213-9cf842761256",
                                                "text": "Scandal may be taken advantage of at any time, impertinence not; if reported ſcandalous, it muſt be impertinent of courſe; but it may be impertinent vvithout being ſcandalous. […] [N]othing pertinent to the cauſe can be ſaid to be ſcandalous."
                                            },
                                            {
                                                "example_id": "412bc579-6206-4f70-9f5d-c6103e051a6f",
                                                "sense_id": "5643803f-03d8-32eb-9213-9cf842761256",
                                                "text": "A party who makes an affidavit to oppose a motion is only authorized to state the facts; and it is scandalous and impertinent to draw inferences or state arguments in the affidavit, reflecting on the character or impeaching the motives of the adverse party or his solicitor. Ibid. [Powell v. Kane, 5 Paige, 265.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "901fde51-896c-3524-aa5e-8e3df99a1d9e",
                                        "entry_id": "d9f92b02-80c9-3b1a-b927-9be11c1df0ba",
                                        "glosses": [
                                            "Causing offence or trouble."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cc3060-c971-478c-9d9e-9ddeda4e52e1",
                                                "sense_id": "901fde51-896c-3524-aa5e-8e3df99a1d9e",
                                                "text": "[M]any Lavvs, in the change of ignorant and obſcure Ages, may be found both ſcandalous, and full of greevance to their Poſterity that made them, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb4ee97-ffd0-30f3-ba63-758d1e9ce910",
                                        "entry_id": "d9f92b02-80c9-3b1a-b927-9be11c1df0ba",
                                        "glosses": [
                                            "Of a disease or symptom: putrid, rotting."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045e9d45-0ac1-4555-9c5a-35c16fafac53",
                                                "sense_id": "deb4ee97-ffd0-30f3-ba63-758d1e9ce910",
                                                "text": "Theſe are the Ulcers vvhich render fiſtulæ ani [anal fistulas] ſcandalous. If the matter paſſeth in perineo, for the moſt part it perforates the Urethra, ſometime like a Flute, and the Urine cometh thereout, othertimes it corrupteth vvithin, and diſchargeth the putrefaction into the pelvis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0196cae8-7a9e-4e25-909c-c8328f4dba1d",
                        "source_entry_id": "4fd4b759-d6cd-3b10-86d2-9a9a394b688b",
                        "source_sense_id": "27b6eb1f-8f21-35a3-aece-85fdfe126ad3",
                        "target_lang_word": "scandaleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scandaleux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85c98e74-b834-380d-89b3-e7520e9127f1",
                                        "entry_id": "abe70c71-46ac-3fcf-8690-646232f875bc",
                                        "glosses": [
                                            "Qui cause du scandale, qui est un mauvais exemple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133560e0-abf3-4f38-b731-557af0ce84b2",
                                                "sense_id": "85c98e74-b834-380d-89b3-e7520e9127f1",
                                                "text": "Il est expliqué plus bas que le scandale n’est qu'un mot, qu’on fait naitre la chose selon les besoins et les circonstances et que le plus scandaleux n’est point que tel banquier couche, un beau jour à la Santé, mais que tant d’autres dorment paisibles dans leurs draps."
                                            },
                                            {
                                                "example_id": "657ca1c5-85fa-4709-8874-f02d5f18906b",
                                                "sense_id": "85c98e74-b834-380d-89b3-e7520e9127f1",
                                                "text": "La métaphore la plus scandaleuse de l'histoire du théâtre est le fameux « Vous êtes mon lion superbe et généreux » de Victor Hugo qui déclencha la bataille d'Hernani."
                                            },
                                            {
                                                "example_id": "ced6606a-adde-4674-9e40-fd0731fba971",
                                                "sense_id": "85c98e74-b834-380d-89b3-e7520e9127f1",
                                                "text": "« J’allais rider un jour sur deux, j’arrivais en chaussures de snow en cours, c’était scandaleux », s’amuse-t-il."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scandaleux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c10e800-3ae8-3915-b686-9ec7c937900b",
                                        "entry_id": "a9a44969-2729-3384-842a-a487b90c7064",
                                        "glosses": [
                                            "Ce qui cause du scandale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ca4edf-56f2-4ac0-ae8f-2698770a569d",
                                                "sense_id": "8c10e800-3ae8-3915-b686-9ec7c937900b",
                                                "text": "Comme dans le meurtre d’Agamemnon, l’intolérable, le scandaleux est dans cette inversion des valeurs qui fait de la pluie, bénéfique, fécondante, un signe de ruine et de destruction par son association avec le sang et sa noirceur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
