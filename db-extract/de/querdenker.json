                            "accusative",
                            "singular"
                        ],
                        "form": "den Querdenker"
                    },
                    {
                        "form_id": "be1ac3d4-2248-4c5e-917e-7ca8ce07a62a",
                        "entry_id": "9ee06b60-a8e6-3cb3-9f86-9296c718d3c1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Querdenker"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "998d2da8-f6d1-3250-8542-6e50a360f7d6",
                        "entry_id": "9ee06b60-a8e6-3cb3-9f86-9296c718d3c1",
                        "glosses": [
                            "Person, die sich in ihrem Denken nicht an die üblichen Denkweisen hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6ccbf9-de1d-4260-8af5-573f6effe512",
                                "sense_id": "998d2da8-f6d1-3250-8542-6e50a360f7d6",
                                "text": "Er war uns schon immer als Querdenker aufgefallen."
                            },
                            {
                                "example_id": "736f3f08-66d1-49f1-bb5e-a550bce19552",
                                "sense_id": "998d2da8-f6d1-3250-8542-6e50a360f7d6",
                                "text": "„Der Verfasser ließ keinen Zweifel daran aufkommen, daß eine Nation ohne Querdenker ebenso verarmen würde.“"
                            },
                            {
                                "example_id": "3e4e4a4e-e1b7-430b-8324-c8526e7b6e21",
                                "sense_id": "998d2da8-f6d1-3250-8542-6e50a360f7d6",
                                "text": "„Was die kreativen Querdenker aber keinesfalls daran hinderte, ihr einmal durchdachtes Konzept in die Tat umzusetzen.“"
                            },
                            {
                                "example_id": "eacf370b-4a0a-4b71-af58-dea2eb80d979",
                                "sense_id": "998d2da8-f6d1-3250-8542-6e50a360f7d6",
                                "text": "„Kein Mobiltelefon, kein Notebook, kein GPS wäre je erfunden worden, wenn nicht Querdenker wie Einstein, Bohr oder Planck ihre Genialität darauf verwendet hätten, jahrhundertealte Vorstellungen über Raum und Zeit umzustürzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8365c1c7-6c86-3680-8637-0a16c18615c2",
                        "entry_id": "9ee06b60-a8e6-3cb3-9f86-9296c718d3c1",
                        "glosses": [
                            "Person, die Maßnahmen des Staates zur Bekämpfung der Coronapandemie ablehnt und die sich dabei überwiegend auf Informationen beruft, die von Experten als falsch oder zu stark vereinfachend eingestuft werden"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd9fb5dd-271b-4457-9357-a6d6bb58305a",
                        "source_entry_id": "9ee06b60-a8e6-3cb3-9f86-9296c718d3c1",
                        "source_sense_id": "998d2da8-f6d1-3250-8542-6e50a360f7d6",
                        "source_sense_description": "Person, die sich in ihrem Denken nicht an die üblichen Denkweisen hält",
                        "target_lang_word": "contrarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef63b54b-d82f-353b-b3da-00847151e461",
                                        "entry_id": "7d4e4ea0-126e-3353-afa4-e9f45828d192",
                                        "glosses": [
                                            "A person who likes or tends to express a contradicting viewpoint, especially from one held by a majority of people, usually because of nonconformity or spite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12292e15-52b3-470f-bac7-a84849daeaad",
                                                "sense_id": "ef63b54b-d82f-353b-b3da-00847151e461",
                                                "text": "Christopher [Hitchens] is bored by the epithet contrarian, which has been trailing him around for a quarter of a century. What he is, in any case, is an autocontrarian: he seeks not just the most difficult position, but the most difficult position for Christopher Hitchens."
                                            },
                                            {
                                                "example_id": "32612067-c843-484e-9e6a-10e09a914651",
                                                "sense_id": "ef63b54b-d82f-353b-b3da-00847151e461",
                                                "text": "[Søren] Kierkegaard had no university career, and [Friedrich] Nietzsche was a professor of Greek and Roman philology who had to retire because of ill health. Both were individualists, and both were contrarians by nature, dedicated to making people uncomfortable."
                                            },
                                            {
                                                "example_id": "9fcac90b-d010-4132-bad6-ebe19300f15b",
                                                "sense_id": "ef63b54b-d82f-353b-b3da-00847151e461",
                                                "text": "Hello, he lied / Like velvet, this magician's sleight of tongue and hand / Hello, he lied / Beware, belie his smile / As warm and calculated as heroin / Beware the contrarian"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "510f2a5a-6626-332c-a238-a6b2df9eca13",
                                        "entry_id": "7d4e4ea0-126e-3353-afa4-e9f45828d192",
                                        "glosses": [
                                            "A financial investor who tends to have an opinion of market trends at variance with most others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "203e56db-c65c-450d-91cf-f721a3ca9a6a",
                                                "sense_id": "510f2a5a-6626-332c-a238-a6b2df9eca13",
                                                "text": "[T]o succeed as a contrarian, you have to be able to time trades in exactly the opposite direction of the majority. This means you have to move in when everyone else is fearful, and step back when everyone else is euphoric. This advice is easier to give than to follow, so contrarians are not just good at timing. They also are highly disciplined and able to set and follow rules for themselves that fly in the face of what the majority thinks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contrarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bcd0288-d49f-34a3-836e-b722de5b2a62",
                                        "entry_id": "4e546836-41ca-3d66-bf24-047707adeed3",
                                        "glosses": [
                                            "Liking or tending to express a contradicting viewpoint, especially from one held by a majority of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b31da626-e5de-415e-92e3-dc17e46827cc",
                                                "sense_id": "1bcd0288-d49f-34a3-836e-b722de5b2a62",
                                                "text": "The second part [of the book] explores the normative forms of adolescent resistance and contrarian behavior that vex parents and teachers alike. This discussion is within the context of chapters that look at the ways in which parenting and teaching for moral development can positively make use of these normative challenges."
                                            },
                                            {
                                                "example_id": "8acc6351-18dc-4007-b44d-08564164d853",
                                                "sense_id": "1bcd0288-d49f-34a3-836e-b722de5b2a62",
                                                "text": "I began with the problem that I did not have enough confidence in what I had to say. Then I discovered that there could never be a single \"I\" who could speak for me, I could only communicate an aspect of myself: sometimes more friendly, sometimes more contrarian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "317563ab-2b7e-3d01-9fee-5b445c41eddc",
                                        "entry_id": "4e546836-41ca-3d66-bf24-047707adeed3",
                                        "glosses": [
                                            "Having an opinion of market trends at variance with most others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0f7a86-c892-4f48-bf1a-eb63cdf5e182",
                                                "sense_id": "317563ab-2b7e-3d01-9fee-5b445c41eddc",
                                                "text": "Yet at the same time, 401(k) traders became more contrarian in their response to falling markets during the crisis. Therefore, the increased sensitivity to market volatility was offset, in part, by a tendency to 'buy on the dips' in response to falling markets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee372838-be5a-44eb-ab82-a07be499e210",
                        "source_entry_id": "9ee06b60-a8e6-3cb3-9f86-9296c718d3c1",
                        "source_sense_id": "998d2da8-f6d1-3250-8542-6e50a360f7d6",
                        "source_sense_description": "Person, die sich in ihrem Denken nicht an die üblichen Denkweisen hält",
