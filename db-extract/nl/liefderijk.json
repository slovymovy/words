                "senses": [
                    {
                        "sense_id": "e925cf1c-ccd9-36df-b0d6-d418cb8c2f85",
                        "entry_id": "01d8bfa5-50a6-38d7-a96e-b7c83f09a225",
                        "glosses": [
                            "met heel veel zorg en toewijding die men een ander uit liefde geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc8303a-a966-4997-8b25-331bef09446e",
                                "sense_id": "e925cf1c-ccd9-36df-b0d6-d418cb8c2f85",
                                "text": "Koningin Beatrix hoopt dat ook het aanstaand koningspaar “zich gedragen zal voelen” door het “liefderijk vertrouwen” van het volk."
                            },
                            {
                                "example_id": "2cbfdbc4-bc3d-42ff-8bf9-bc181557099d",
                                "sense_id": "e925cf1c-ccd9-36df-b0d6-d418cb8c2f85",
                                "text": "Die moet nu door het leven met tijdelijk bedoelde scharen aan zijn polsen. Hij wordt liefderijk opgenomen in het gezin van een Avon-vertegenwoordigster."
                            }
                        ]
                    }
                ],
