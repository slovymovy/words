                "senses": [
                    {
                        "sense_id": "2a71bba2-fa3d-30c5-84d2-9e85f2affaf5",
                        "entry_id": "92c9bcfa-e3e3-31e9-bbd5-ab745b62f6fc",
                        "glosses": [
                            "junge Frau, die (alkoholfreie) Getränke verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df67eb2c-eec3-4b1e-a691-88aaaed52922",
                                "sense_id": "2a71bba2-fa3d-30c5-84d2-9e85f2affaf5",
                                "text": "„Ich komme als spanische Odaliske. […] Und ich als berliner Sodaliske.“"
                            },
                            {
                                "example_id": "3f2921fc-2625-44b8-a2c3-2d53e6cc5228",
                                "sense_id": "2a71bba2-fa3d-30c5-84d2-9e85f2affaf5",
                                "text": "„Und siehe da, am vierten Tage da schuf er diesen Menschen und der war weiblichen Geschlechtes; die Grazer aber kamen und sahen und tranken und nannten dieses Wesen – Sodaliske.“"
                            },
                            {
                                "example_id": "3465adcc-755a-490d-b3fd-551a306181ef",
                                "sense_id": "2a71bba2-fa3d-30c5-84d2-9e85f2affaf5",
                                "text": "„Die Sodaliske ist abermals ein ganz eigenartiger Typus.“"
                            },
                            {
                                "example_id": "1241f48f-bf90-4e36-b53f-6feb3ab06846",
                                "sense_id": "2a71bba2-fa3d-30c5-84d2-9e85f2affaf5",
                                "text": "„Bülow händigte gerade der Sodaliske eine Freikarte für sein Konzert in der Philharmonie aus, als er sah, daß das niedliche junge Mädchen ebenfalls die Budenbesitzerin gut kannte.“"
                            },
                            {
                                "example_id": "e16d9674-3335-4c81-88b3-1d1e8ce4e968",
                                "sense_id": "2a71bba2-fa3d-30c5-84d2-9e85f2affaf5",
                                "text": "„Der Conditor Jacobi hatte in diesem Sommer an der Ecke der Landsberger und Weberstraße eine Selter- und Sodawasser-Bude etablirt und als unvermeidliche Sodaliske, ein Fräulein Lepp hineingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
