                "senses": [
                    {
                        "sense_id": "7dcf3274-2dcc-39cd-a89c-c185716f024d",
                        "entry_id": "99fd2884-c4a0-3d37-b8c1-ec6e8c57dcbf",
                        "glosses": [
                            "Maschinentechnik, die Abfall sortiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dcee291-8ac8-411d-af33-5badb2303aa9",
                                "sense_id": "7dcf3274-2dcc-39cd-a89c-c185716f024d",
                                "text": "„Die neue Abfallsortieranlage ersetze und modernisiere die bisherige Bauabfallsortieranlage (am gleichen Standort) und die Sortieranlage für Gewerbeabfälle und Leichtverpackungen (Gelbe Tonne), bisheriger Standort Apoldaer Straße (Erfurt-Nord).“"
                            },
                            {
                                "example_id": "f737cf85-6f4f-4c09-be46-903e1b890970",
                                "sense_id": "7dcf3274-2dcc-39cd-a89c-c185716f024d",
                                "text": "„In der Abfallsortieranlage in Bochum wird jegliche Art von Haushalts-Verpackungsabfällen gelagert und für die weitere Aufbereitung sortiert.“"
                            },
                            {
                                "example_id": "196ba154-5d26-4d6e-8cea-2e7b2fd9899f",
                                "sense_id": "7dcf3274-2dcc-39cd-a89c-c185716f024d",
                                "text": "„Gemeinsam mit den zuständigen Unfallversicherungsträgern wurden mikrobiologische Messungen in Abfallsortieranlagen durchgeführt.“"
                            },
                            {
                                "example_id": "78c6389e-8138-4773-912f-f643becc49c0",
                                "sense_id": "7dcf3274-2dcc-39cd-a89c-c185716f024d",
                                "text": "„Der Brand entstand in der Abfallsortieranlage in der Rudolf-Diesel-Straße in Delitzsch und breitete sich rasch aus. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
