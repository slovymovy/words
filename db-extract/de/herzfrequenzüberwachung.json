                "senses": [
                    {
                        "sense_id": "f93d070c-f17e-331d-afa6-88624477a148",
                        "entry_id": "53bbe82e-f084-3a23-adfe-a57e11737355",
                        "glosses": [
                            "regelmäßige Messung/Überwachung der Herzfrequenz, häufig durch moderne Wearables wie Smartwatches oder Fitnessarmbänder, die die Herzfrequenz kontinuierlich messen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ddb8c7-415c-4548-894f-21f14727d7dd",
                                "sense_id": "f93d070c-f17e-331d-afa6-88624477a148",
                                "text": "„Den Patienten wird empfohlen, während der Einnahme von Qsymia eine regelmäßige Herzfrequenzüberwachung zu erhalten.“"
                            },
                            {
                                "example_id": "b9a86450-7fa5-4818-8d6b-29d782cf10c6",
                                "sense_id": "f93d070c-f17e-331d-afa6-88624477a148",
                                "text": "„So entdeckte der 25-jährige iOS-Entwickler Sharath Sreeram durch die Herzfrequenzüberwachung der Apple Watch einen Zusammenhang zwischen seinem stressigen Job und gesundheitlichen Problemen.“"
                            },
                            {
                                "example_id": "1ee1579e-9b24-4328-8112-801aea0e2e2e",
                                "sense_id": "f93d070c-f17e-331d-afa6-88624477a148",
                                "text": "„An mein Ohrläppchen wurde ein Kontroller zwecks Herzfrequenzüberwachung geklemmt und dann ging es eigentlich schon los.“"
                            },
                            {
                                "example_id": "b446552f-6e69-49ca-aea6-1b8054d82f3c",
                                "sense_id": "f93d070c-f17e-331d-afa6-88624477a148",
                                "text": "„Nach meinen Tests würde ich sagen, dass 5 Tage absolut zutreffen, und das bei regelmäßiger Nutzung von Fitness-Tracking, kontinuierlicher Herzfrequenzüberwachung und Smartwatch-Funktionen.“"
                            },
                            {
                                "example_id": "3b62b826-6345-4243-8bcf-cf43db5900ce",
                                "sense_id": "f93d070c-f17e-331d-afa6-88624477a148",
                                "text": "„Wettervorhersage, Schrittzähler, Fotos, Musiksteuerung, Kamerasteuerung, Herzfrequenzüberwachung, Blutdrucküberwachung, Trainingsüberwachung, Wecker, Nachrichtenbenachrichtigung, Menstruationsaufzeichnung, Schlafmodus, die Armbanduhr kann Ihre täglichen Bedürfnisse erfüllen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
