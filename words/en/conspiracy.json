{
    "word_family": [
        "conspire",
        "conspirator",
        "conspiratorial",
        "conspiratorially",
        "conspiratress"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5ecbc40-8ce1-365a-a582-26f0f0394f44",
                    "sense_definition": "A secret agreement or arrangement between multiple parties to perform a harmful, illegal, or subversive act.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "plot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels were arrested after the police uncovered a <w>conspiracy</w> to overthrow the government.",
                            "target_lang_translations": {
                                "ru": "Повстанцы были арестованы после того, как полиция раскрыла <w>заговор</w> с целью свержения правительства."
                            }
                        },
                        {
                            "text": "The investigation revealed a criminal <w>conspiracy</w> involving several high-ranking officials.",
                            "target_lang_translations": {
                                "ru": "Расследование выявило преступный <w>сговор</w>, в котором участвовали несколько высокопоставленных чиновников."
                            }
                        }
                    ],
                    "synonyms": [
                        "plot",
                        "collusion",
                        "intrigue",
                        "machination"
                    ],
                    "common_phrases": [
                        "criminal conspiracy",
                        "uncover a conspiracy",
                        "political conspiracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайное соглашение или договоренность между несколькими сторонами для совершения вредного, незаконного или подрывного действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заговор",
                                "target_lang_sense_clarification": "тайное соглашение против кого-либо"
                            },
                            {
                                "target_lang_word": "сговор",
                                "target_lang_sense_clarification": "секретная договоренность, часто преступная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ce9a3cb-75e1-3f09-b33d-4a569c800265",
                    "sense_definition": "A hypothesis or theory alleging that a secret group is responsible for an event or situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internet has made it much easier for a <w>conspiracy</w> theory to spread globally in minutes.",
                            "target_lang_translations": {
                                "ru": "Интернет значительно облегчил распространение <w>конспирологических</w> теорий по всему миру за считанные минуты."
                            }
                        },
                        {
                            "text": "He spent hours reading about every <w>conspiracy</w> regarding the moon landing.",
                            "target_lang_translations": {
                                "ru": "Он часами читал о каждом <w>заговоре</w>, касающемся высадки на Луну."
                            }
                        }
                    ],
                    "synonyms": [
                        "conspiracy theory"
                    ],
                    "common_phrases": [
                        "spread conspiracies",
                        "wild conspiracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гипотеза или теория, утверждающая, что за определенное событие или ситуацию несет ответственность секретная группа лиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конспирология",
                                "target_lang_sense_clarification": "теория заговора"
                            },
                            {
                                "target_lang_word": "заговор",
                                "target_lang_sense_clarification": "в контексте теории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a5dc85b-8f1a-32af-9054-5aef476165fe",
                    "sense_definition": "A secret agreement to do something harmless or benevolent, such as planning a surprise.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "plot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were involved in a benevolent <w>conspiracy</w> to throw their mother a surprise party.",
                            "target_lang_translations": {
                                "ru": "Дети участвовали в добром <w>сговоре</w>, чтобы устроить матери вечеринку-сюрприз."
                            }
                        },
                        {
                            "text": "She joined the <w>conspiracy</w> to keep the secret until the very last moment.",
                            "target_lang_translations": {
                                "ru": "Она примкнула к <w>заговору</w>, чтобы хранить секрет до самого последнего момента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "benevolent conspiracy",
                        "surprise party conspiracy",
                        "join the conspiracy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used playfully"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайное соглашение сделать что-то безобидное или доброе, например, спланировать сюрприз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сговор",
                                "target_lang_sense_clarification": "шутливое или доброе тайное соглашение"
                            },
                            {
                                "target_lang_word": "заговор",
                                "target_lang_sense_clarification": "ироничное использование для добрых целей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80ff7ea5-28f0-3d5c-b51f-dcdb50140cb6",
                    "sense_definition": "A situation in linguistics where different rules or processes lead to the same phonological or grammatical result.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The phonological <w>conspiracy</w> in this language ensures that no two vowels appear together.",
                            "target_lang_translations": {
                                "ru": "Фонологическая <w>конспирация</w> в этом языке гарантирует, что две гласные не могут стоять рядом."
                            }
                        },
                        {
                            "text": "Linguists studied the <w>conspiracy</w> of rules that maintained the syllable structure.",
                            "target_lang_translations": {
                                "ru": "Лингвисты изучали <w>взаимодействие</w> правил, поддерживающих структуру слога."
                            }
                        }
                    ],
                    "common_phrases": [
                        "phonological conspiracy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация в лингвистике, когда различные правила или процессы приводят к одному и тому же фонологическому или грамматическому результату."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конспирация",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adbd0c3d-d8fa-3630-a1dc-9db084741e87",
                    "sense_definition": "The collective noun for a group of ravens.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>conspiracy</w> of ravens gathered in the old oak tree as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "<w>Стая</w> воронов собралась на старом дубе, когда солнце начало садиться."
                            }
                        },
                        {
                            "text": "While a group of crows is a murder, a group of ravens is called a <w>conspiracy</w>.",
                            "target_lang_translations": {
                                "ru": "В то время как группа ворон называется 'murder', группа воронов называется <w>conspiracy</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "conspiracy of ravens"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "collective noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное существительное для группы воронов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа воронов (в русском нет прямого эквивалента 'conspiracy')"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0f5c21a-0d89-35eb-8cf3-dbcf0b26eb4c",
                    "sense_definition": "The collective noun for a group of lemurs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The zoo visitors were delighted to see a <w>conspiracy</w> of lemurs playing in the enclosure.",
                            "target_lang_translations": {
                                "ru": "Посетители зоопарка были в восторге, увидев <w>группу</w> лемуров, играющих в вольере."
                            }
                        },
                        {
                            "text": "Each <w>conspiracy</w> of lemurs has its own social hierarchy and territory.",
                            "target_lang_translations": {
                                "ru": "У каждой <w>группы</w> лемуров есть своя социальная иерархия и территория."
                            }
                        }
                    ],
                    "common_phrases": [
                        "conspiracy of lemurs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "collective noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное существительное для группы лемуров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "сообщество лемуров"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ad21860-72b3-3b7b-af03-2e25f4f6d1a2",
                    "sense_definition": "To <w>conspire</w>; to join in a secret agreement to do something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He claimed that his rivals were <w>conspiracying</w> against him to ruin his reputation.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что его соперники <w>сговариваются</w> против него, чтобы разрушить его репутацию."
                            }
                        },
                        {
                            "text": "They were caught <w>conspiracying</w> in the corner of the room during the meeting.",
                            "target_lang_translations": {
                                "ru": "Их застукали за <w>шушуканьем</w> в углу комнаты во время собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "conspire",
                        "plot",
                        "collude"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "non-standard usage of the noun as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в тайный сговор; участвовать в секретном соглашении для совершения чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сговариваться",
                                "target_lang_sense_clarification": "тайно договариваться"
                            },
                            {
                                "target_lang_word": "плести заговор",
                                "target_lang_sense_clarification": "участвовать в заговоре"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}