{
    "word_family": [
        "somersaulting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f6b27c1-7157-3567-a78a-7e043df320e0",
                    "sense_definition": "An acrobatic movement where a person rotates their body 360 degrees, either in the air or on the ground, by flipping their feet over their head.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "acrobatic_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast performed a perfect <w>somersault</w> during her floor routine.",
                            "target_lang_translations": {
                                "ru": "Гимнастка выполнила идеальное <w>сальто</w> во время вольных упражнений.",
                                "zh": "体操运动员在自由体操项目中完成了一个完美的<w>空翻</w>。"
                            }
                        },
                        {
                            "text": "The child did a <w>somersault</w> on the soft grass in the park.",
                            "target_lang_translations": {
                                "ru": "Ребёнок сделал <w>кувырок</w> на мягкой траве в парке.",
                                "zh": "那名儿童在公园柔软的草地上翻了一个<w>跟头</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "salto",
                        "flip"
                    ],
                    "common_phrases": [
                        "do a somersault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акробатическое движение, при котором человек совершает полный оборот тела (360 градусов) через голову, находясь в воздухе или на земле.",
                        "zh": "一种杂技或体操动作，身体在空中或地面向前或向后翻转360度（脚越过头顶）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кувыро́к",
                                "target_lang_sense_clarification": "переворот через голову с опорой на руки или без, обычно на земле"
                            },
                            {
                                "target_lang_word": "са́льто",
                                "target_lang_sense_clarification": "прыжок с переворотом тела в воздухе без опоры на руки"
                            },
                            {
                                "target_lang_word": "кульби́т",
                                "target_lang_sense_clarification": "акробатический трюк, переворот через голову"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "筋斗",
                                "target_lang_sense_clarification": "翻跟头的动作（常作“翻筋斗”）"
                            },
                            {
                                "target_lang_word": "跟头",
                                "target_lang_sense_clarification": "身体翻转的动作（常作“翻跟头”）"
                            },
                            {
                                "target_lang_word": "空翻",
                                "target_lang_sense_clarification": "空中翻腾动作，多用于体操或杂技"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f082beb-6312-30db-81e9-8333af4bcd5a",
                    "sense_definition": "To perform a somersault.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "acrobatic_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The acrobat <w>somersaulted</w> across the stage with incredible speed and grace.",
                            "target_lang_translations": {
                                "ru": "Акробат с невероятной скоростью и грацией <w>кувыркался</w> по сцене.",
                                "zh": "杂技演员以惊人的速度和优美的姿态在舞台上连续<w>翻筋斗</w>。"
                            }
                        },
                        {
                            "text": "He <w>somersaulted</w> into the pool to impress his friends.",
                            "target_lang_translations": {
                                "ru": "Он <w>сделал сальто</w>, прыгнув в бассейн, чтобы впечатлить своих друзей.",
                                "zh": "他一个<w>空翻</w>跃入泳池，想在朋友面前显摆一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "somersault across"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять кувырок или сальто.",
                        "zh": "做翻筋斗、翻跟头或空翻动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать кувыро́к",
                                "target_lang_sense_clarification": "выполнять акробатическое движение на земле"
                            },
                            {
                                "target_lang_word": "делать са́льто",
                                "target_lang_sense_clarification": "выполнять прыжок с переворотом в воздухе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻筋斗",
                                "target_lang_sense_clarification": "翻跟头"
                            },
                            {
                                "target_lang_word": "翻跟头",
                                "target_lang_sense_clarification": "身体旋转倒立翻滚"
                            },
                            {
                                "target_lang_word": "空翻",
                                "target_lang_sense_clarification": "在空中翻滚旋转"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}