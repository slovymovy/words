                "senses": [
                    {
                        "sense_id": "e9021d4d-58d5-3126-bb7a-54b19c470dd4",
                        "entry_id": "d809c5ed-67d1-3383-9f5f-9762e903e142",
                        "glosses": [
                            "Mener, promener de tous côtés, indiscrètement et hors de propos."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3baa0cb9-43c4-3726-8541-fcf83eb1a449",
                        "entry_id": "d809c5ed-67d1-3383-9f5f-9762e903e142",
                        "glosses": [
                            "Courir çà et là."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7fced713-70f7-4834-81ca-8b8bf44372ac",
                                "sense_id": "3baa0cb9-43c4-3726-8541-fcf83eb1a449",
                                "text": "« Ton oncle, ma guéline, c’est un bel homme. Un bon arcandier, pour sûr.»\nIl doit « trôler » avec des femmes, cet homme du devoir. C’est du propre !"
                            }
                        ]
                    },
                    {
                        "sense_id": "129e16ba-9b58-374f-b9b6-c6fdda5b5ea0",
                        "entry_id": "d809c5ed-67d1-3383-9f5f-9762e903e142",
                        "glosses": [
                            "Variante de trailler."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "854eb209-8201-3cbd-9986-df136fbf38eb",
                        "entry_id": "d809c5ed-67d1-3383-9f5f-9762e903e142",
                        "glosses": [
                            "Pêcher en suivant une technique particulière qui consiste à faire avancer l’embarcation lentement pendant que la ligne est à l’eau."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "0f436db9-d1a7-4856-b941-cb4d432fb6af",
                                "sense_id": "854eb209-8201-3cbd-9986-df136fbf38eb",
                                "text": "– Ralentis Maxime, c’est pas une course, là… Trôler, on fait ça tranquillement.\n– De même ?\n– Parfait !"
                            },
                            {
                                "example_id": "96c4992a-7b52-48b1-81a8-1a1e8ba95de0",
                                "sense_id": "854eb209-8201-3cbd-9986-df136fbf38eb",
                                "text": "Ma victime, elle, me talonnait ; elle était hameçonnée, il ne restait qu’à la trôler jusqu’à mon filet."
                            }
                        ]
                    }
                ],
