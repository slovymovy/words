                                "sense_id": "1203a9c3-402e-3d04-83e3-9f0ee0aa5ce4",
                                "text": "De maximumsnelheid op autosnelwegen gaat omhoog naar 130 km/u."
                            },
                            {
                                "example_id": "ec2cf27f-2a32-439b-825c-383ab94535d1",
                                "sense_id": "1203a9c3-402e-3d04-83e3-9f0ee0aa5ce4",
                                "text": "Experiment met maximumsnelheid op fietspad moet ongelukken terugdringen."
                            }
                        ]
                    }
