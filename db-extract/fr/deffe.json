                    {
                        "sense_id": "4f2d9067-35c4-3853-8c60-c61b872c40db",
                        "entry_id": "f9955303-f93c-3382-ba49-377f6b5fc9d8",
                        "glosses": [
                            "Desfoux, casquette à pont."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8a6057c0-6246-46a0-ac49-9680d9fab7ea",
                                "sense_id": "4f2d9067-35c4-3853-8c60-c61b872c40db",
                                "text": "Avec, comme coiffure, une deffe à pont galonnée tout ce qu'il y a de plus rupinskoff."
                            }
                        ]
                    },
                    {
                        "sense_id": "95311bcd-4785-34dc-8764-44893efad078",
                        "entry_id": "f9955303-f93c-3382-ba49-377f6b5fc9d8",
                        "glosses": [
                            "Casquette."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2885b79e-8986-4e60-a486-946528b563fe",
                                "sense_id": "95311bcd-4785-34dc-8764-44893efad078",
                                "text": "Il traverse la rue, les mains dans les poches de son autocoat, la deffe à carreaux inclinée sur l’oreille."
                            },
                            {
                                "example_id": "cbf16c27-8589-4abd-8c95-d68d1c5f8906",
                                "sense_id": "95311bcd-4785-34dc-8764-44893efad078",
                                "text": "Ah ! il n'était pas très flambard, le Max, avec sa deffe dont la visière formait un angle aigu, son chandail vert pomme marqué Albatros, son foulard rouge, son grimpant à patte d'éléphant !"
                            },
                            {
                                "example_id": "27cf6a95-2977-4c45-b21b-e23a7f803d1f",
                                "sense_id": "95311bcd-4785-34dc-8764-44893efad078",
                                "text": "Autrefois il était toujours en cotte bleue, le père Clancul, même le dimanche, une cotte rapiécée, et avec sa deffe sur le ciboulot, bien enfoncée, droite… Sa casquette d’honnête ouvrier. Là, en toge, le crâne chauve à l'air, c'était une surprise."
                            }
                        ]
                    }
