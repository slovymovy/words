                                    {
                                        "sense_id": "8d5f1513-3587-34da-b258-887510c09849",
                                        "entry_id": "4382472a-2f8a-375f-99d0-16fe26cbfd63",
                                        "glosses": [
                                            "(Sitz-)Möbel, meist mit vier hohen Beinen, Rückenlehne und eventuell Armlehnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7052a0-db80-4dbe-8ce0-95d6bf2415c8",
                                                "sense_id": "8d5f1513-3587-34da-b258-887510c09849",
                                                "text": "Auf diesem Stuhl kann man bequem sitzen."
                                            },
                                            {
                                                "example_id": "2b00b817-d2d1-44c9-8141-1aef758a0fcd",
                                                "sense_id": "8d5f1513-3587-34da-b258-887510c09849",
                                                "text": "„Aufgrund der Nummernangabe wußte sie, wie viele Stühle sie noch hinstellen und wieviel Kaffeewasser sie aufsetzen mußte.“"
                                            },
                                            {
                                                "example_id": "5c545a5e-dbeb-491f-b5e2-f678a42c2133",
                                                "sense_id": "8d5f1513-3587-34da-b258-887510c09849",
                                                "text": "„Er hat seinen Stuhl an die Wand zurückgeschoben, liest die Zeitung und raucht eine dicke Arbeiterzigarette, an der er nur selten zieht.“"
                                            },
                                            {
                                                "example_id": "daaf8839-c050-4855-b27f-e650f4371ee0",
                                                "sense_id": "8d5f1513-3587-34da-b258-887510c09849",
                                                "text": "„Irgendjemand schob mir einen Stuhl unter den Arsch.“"
                                            },
                                            {
                                                "example_id": "a049d565-6667-4d2f-bd26-38176e8f1571",
                                                "sense_id": "8d5f1513-3587-34da-b258-887510c09849",
                                                "text": "„Im Werkkreis bei Hirte saß man auf Stühlen um einen runden Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "58d4e098-5418-37b8-b31a-ead1a94c937c",
                                        "entry_id": "4382472a-2f8a-375f-99d0-16fe26cbfd63",
                                        "glosses": [
                                            "Gerüst oder Gestell, meist ortsfest (im Gegensatz zu Möbeln), meist aus Holz"
                                        ],
                                        "tags": [
                                            "nur in Zusammensetzungen"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ed2f04fe-d032-39ef-9293-c2b0c32379a8",
                                        "entry_id": "4382472a-2f8a-375f-99d0-16fe26cbfd63",
                                        "glosses": [
                                            "Kot (feste Exkremente)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
