{
    "word_family": [
        "weak",
        "weaken",
        "weakly",
        "weakling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf62c1ad-7cdb-3dc5-89ae-9868969c3972",
                    "sense_definition": "The state or condition of lacking physical strength or energy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The illness caused great physical <w>weakness</w> and fatigue.",
                            "target_lang_translations": {
                                "ru": "Болезнь вызвала сильную физическую <w>слабость</w> и усталость.",
                                "zh": "这场疾病导致了严重的身体<w>虚弱</w>和疲劳。"
                            }
                        },
                        {
                            "text": "He felt a sudden <w>weakness</w> in his legs and had to sit down.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал внезапную <w>слабость</w> в ногах и был вынужден сесть.",
                                "zh": "他感到双腿突然<w>无力</w>，不得不坐了下来。"
                            }
                        }
                    ],
                    "antonyms": [
                        "strength",
                        "power"
                    ],
                    "common_phrases": [
                        "sign of weakness",
                        "muscle weakness",
                        "physical weakness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нехватки физической силы или энергии",
                        "zh": "指缺乏体力或精力的一种状态或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабость",
                                "target_lang_sense_clarification": "физическое состояние, упадок сил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚弱",
                                "target_lang_sense_clarification": "指身体状况不佳，缺乏体力"
                            },
                            {
                                "target_lang_word": "无力",
                                "target_lang_sense_clarification": "指感到没有力气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c811d018-84c5-3adf-aa53-a0a99342ec6f",
                    "sense_definition": "A particular fault, defect, or inadequate quality in a person or plan.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fault_or_defect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to analyze the strengths and <w>weaknesses</w> of our competitors.",
                            "target_lang_translations": {
                                "ru": "Нам нужно проанализировать сильные и <w>слабые стороны</w> наших конкурентов.",
                                "zh": "我们需要分析竞争对手的优势和<w>弱点</w>。"
                            }
                        },
                        {
                            "text": "His inability to accept criticism is a major <w>weakness</w>.",
                            "target_lang_translations": {
                                "ru": "Его неспособность воспринимать критику — это серьезный <w>недостаток</w>.",
                                "zh": "他无法接受批评是一个主要的<w>缺点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defect",
                        "flaw"
                    ],
                    "antonyms": [
                        "strength",
                        "forte"
                    ],
                    "common_phrases": [
                        "strengths and weaknesses",
                        "major weakness",
                        "fatal weakness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный недостаток, дефект или несовершенство в человеке или плане",
                        "zh": "指人或计划中存在的特定缺陷、瑕疵或不足之处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "изъян, дефект"
                            },
                            {
                                "target_lang_word": "слабое место",
                                "target_lang_sense_clarification": "уязвимость"
                            },
                            {
                                "target_lang_word": "слабая сторона",
                                "target_lang_sense_clarification": "негативное качество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺点",
                                "target_lang_sense_clarification": "指人的性格或事物中的不足之处"
                            },
                            {
                                "target_lang_word": "弱点",
                                "target_lang_sense_clarification": "指容易被攻击或失败的地方"
                            },
                            {
                                "target_lang_word": "短处",
                                "target_lang_sense_clarification": "指某人不如他人的方面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dad797c-d116-39c2-b843-4e23c71b420f",
                    "sense_definition": "A special liking or fondness for something, often something that is hard to resist.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>weakness</w> for expensive chocolate.",
                            "target_lang_translations": {
                                "ru": "Она питает <w>слабость</w> к дорогому шоколаду.",
                                "zh": "她对昂贵的巧克力有一种<w>偏爱</w>。"
                            }
                        },
                        {
                            "text": "I must admit I have a <w>weakness</w> for romantic comedies.",
                            "target_lang_translations": {
                                "ru": "Должен признать, у меня <w>слабость</w> к романтическим комедиям.",
                                "zh": "我必须承认，我对浪漫喜剧有一种<w>偏爱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soft spot"
                    ],
                    "common_phrases": [
                        "have a weakness",
                        "weakness for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особая симпатия или влечение к чему-либо, часто труднопреодолимое",
                        "zh": "指对某事物特别喜爱或难以抗拒的偏好。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабость",
                                "target_lang_sense_clarification": "склонность, пристрастие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏爱",
                                "target_lang_sense_clarification": "指对某事物的特别喜爱"
                            },
                            {
                                "target_lang_word": "嗜好",
                                "target_lang_sense_clarification": "指难以戒除的特别爱好"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}