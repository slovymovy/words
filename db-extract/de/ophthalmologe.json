                    {
                        "translation_id": "f2ea781c-6f26-4736-98f6-47b4fe5f7ffb",
                        "source_entry_id": "bd1ee84f-cc33-3dbc-9f8e-98089e3bbee1",
                        "source_sense_id": "f0214bd3-3ced-37c4-a4fc-be9cf53e3d05",
                        "source_sense_description": "Medizin: Mediziner, der sich mit den Erkrankungen des Auges beschäftigt",
                        "target_lang_word": "ophtalmologue",
                        "target_lang_code": "fr",
