                                            {
                                                "example_id": "d69f8739-41a9-49af-b3f6-414927758bd4",
                                                "sense_id": "76afa4e7-2b98-3d1b-9972-07bea89f939e",
                                                "text": "Je kunt hem een excentrieke kunstenaar noemen, een anarchist, een oldskool-bohemien, die begin jaren zestig zijn homoseksualiteit exposeerde, terwijl de Engelse wet het nog verbood."
                                            },
                                            {
                                                "example_id": "3c53dd61-944d-426f-8a2f-ed427768846b",
                                                "sense_id": "76afa4e7-2b98-3d1b-9972-07bea89f939e",
                                                "text": "Pogue stelde me voor aan zijn vriend ‘Barbie’, een excentrieke man die de lievelingsbarbie van zijn dochter met zich meedroeg en haar op allerlei rare plekken fotografeerde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83a923be-0585-4d72-b8da-954d2823ab4b",
                        "source_entry_id": "62336912-edd3-36aa-9563-794a34979a84",
