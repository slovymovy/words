                    {
                        "form_id": "6a2e8e96-a738-413b-808b-78714eab2851",
                        "entry_id": "55534888-b115-3ad4-83ae-82dcca84a82f",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "сарде́льках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61536879-f4b0-312a-83c6-e83acd984518",
                        "entry_id": "55534888-b115-3ad4-83ae-82dcca84a82f",
                        "glosses": [
                            "кулин. толстая короткая сосиска"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "977f7ff3-1b0e-41ea-ba37-f0abfb3d3a93",
                                "sense_id": "61536879-f4b0-312a-83c6-e83acd984518",
                                "text": "На обед дали вполне съедобный перловый суп, на второе ― пюре с сарделькой, на третье ― компот из сухофруктов."
                            },
                            {
                                "example_id": "e99068a6-6c00-48cd-b395-23c0cba2f8c2",
                                "sense_id": "61536879-f4b0-312a-83c6-e83acd984518",
                                "text": "Сидели с папой в кафе, ели сардельки, пили кофе."
                            },
                            {
                                "example_id": "b9de6ad8-4bb2-4b68-9055-12e56fb3bfad",
                                "sense_id": "61536879-f4b0-312a-83c6-e83acd984518",
                                "text": "С хрустом вонзались вилки в толстые раздувшиеся от влаги сардельки."
                            },
                            {
                                "example_id": "c073bc5c-b4ff-499c-949a-f4782b7d85d5",
                                "sense_id": "61536879-f4b0-312a-83c6-e83acd984518",
                                "text": "В магазине не было ветчинной колбасы, и я купил себе полкило сарделек."
                            }
                        ]
                    }
                ],
                "translations": [
