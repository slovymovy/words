            "senses": [
                {
                    "sense_id": "6f4976c4-0926-3d8f-8f09-420456189921",
                    "sense_definition": "klei verdichten en soepel maken door deze stevig te kneden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kneden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De pottenbakker begon de verse klei grondig te <w>walken</w> om luchtbellen te verwijderen.",
                            "target_lang_translations": {
                                "en": "The potter began <w>to wedge</w> the fresh clay thoroughly to remove air bubbles."
                            }
                        },
                        {
                            "text": "Voordat je een vaas kunt draaien, moet je de klei eerst goed <w>walken</w> op de werkbank.",
                            "target_lang_translations": {
                                "en": "Before you can throw a vase, you first need <w>to wedge</w> the clay well on the workbench."
                            }
                        }
                    ],
                    "synonyms": [
                        "kneden"
                    ],
                    "common_phrases": [
                        "klei walken"
                    ],
                    "target_lang_definitions": {
                        "en": "to wedging or knead clay firmly to make it pliable and remove air bubbles"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to wedge",
                                "target_lang_sense_clarification": "clay"
                            },
                            {
                                "target_lang_word": "to knead",
                                "target_lang_sense_clarification": "clay"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f4875da-3722-39f3-8196-a3a3cd516217",
                    "sense_definition": "vilt of wol bewerken door te kneden en te persen met een vloeistof",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kneden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het historische museum lieten ambachtslieden zien hoe men vroeger vilt ging <w>walken</w>.",
                            "target_lang_translations": {
                                "en": "In the historical museum, craftsmen demonstrated how felt used <w>to be fulled</w> in the past."
                            }
                        },
                        {
                            "text": "De hoedenmaker moest de stof urenlang <w>walken</w> om het materiaal waterdicht te krijgen.",
                            "target_lang_translations": {
                                "en": "The hatter had <w>to full</w> the fabric for hours to make the material waterproof."
                            }
                        }
                    ],
                    "synonyms": [
                        "vollen"
                    ],
                    "common_phrases": [
