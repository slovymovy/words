{
    "word_family": [
        "coincidence",
        "coincidental",
        "coincidentally",
        "coincident"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "442d6084-ef8e-3f0e-83c9-688b330e34f3",
                    "sense_definition": "To happen at the same time as something else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conference will <w>coincide</w> with his vacation next month.",
                            "target_lang_translations": {
                                "ru": "Конференция <w>совпадет</w> с его отпуском в следующем месяце."
                            }
                        },
                        {
                            "text": "It was difficult to <w>coincide</w> with the schedule because of the unexpected delays.",
                            "target_lang_translations": {
                                "ru": "Было трудно <w>совпасть</w> с графиком из-за непредвиденных задержек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coincide with the schedule",
                        "coincide with the anniversary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить в то же самое время, что и что-либо другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "о времени или событиях"
                            },
                            {
                                "target_lang_word": "совпасть",
                                "target_lang_sense_clarification": "соверш. вид, о времени или событиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92a5fa4f-7521-39f3-9aee-fe925f370dcd",
                    "sense_definition": "To be the same or very similar in nature, character, or opinion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our ideas <w>coincide</w> perfectly on how to manage the new project.",
                            "target_lang_translations": {
                                "ru": "Наши идеи идеально <w>совпадают</w> в том, как управлять новым проектом."
                            }
                        },
                        {
                            "text": "Their interests <w>coincide</w> in many areas of research and development.",
                            "target_lang_translations": {
                                "ru": "Их интересы <w>совпадают</w> во многих областях исследований и разработок."
                            }
                        }
                    ],
                    "synonyms": [
                        "concur"
                    ],
                    "antonyms": [
                        "differ",
                        "disagree",
                        "clash"
                    ],
                    "common_phrases": [
                        "interests coincide",
                        "opinions coincide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть одинаковым или очень похожим по характеру, мнению или сути."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "о мнениях, интересах или взглядах"
                            },
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "быть в соответствии с чем-либо"
                            },
                            {
                                "target_lang_word": "пересекаться",
                                "target_lang_sense_clarification": "иметь общие точки соприкосновения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "775a66b4-c179-3f36-95cc-ffeba54a9167",
                    "sense_definition": "To occupy the same position in space.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In geometry, two lines <w>coincide</w> if they lie exactly on top of each other.",
                            "target_lang_translations": {
                                "ru": "В геометрии две прямые <w>совпадают</w>, если они лежат точно друг на друге."
                            }
                        },
                        {
                            "text": "The two squares <w>coincide</w> when you place one directly over the other.",
                            "target_lang_translations": {
                                "ru": "Два квадрата <w>совмещаются</w>, когда вы кладете один прямо на другой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "points coincide",
                        "lines coincide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимать то же самое положение в пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "матем., при наложении"
                            },
                            {
                                "target_lang_word": "совмещаться",
                                "target_lang_sense_clarification": "полностью покрывать друг друга"
                            },
                            {
                                "target_lang_word": "совпасть",
                                "target_lang_sense_clarification": "соверш. вид, о пространственном положении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}