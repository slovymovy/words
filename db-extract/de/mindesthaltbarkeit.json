                "senses": [
                    {
                        "sense_id": "9d88bfd8-96fa-3480-aff9-c418cb892e43",
                        "entry_id": "e60e3fc8-7740-3135-b3fb-a7473e049ce5",
                        "glosses": [
                            "minimale Dauer, ein Produkt konsumieren zu können, bevor es verdorben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff8d1168-77d4-45b0-9a1f-f31b73281e4e",
                                "sense_id": "9d88bfd8-96fa-3480-aff9-c418cb892e43",
                                "text": "Es gibt keine Mindesthaltbarkeit von Weißweinessig, trockenem Zucker und Salz, getrockneten Hülsenfrüchten und Honig. Diese Nahrungsmittel sind für immer und ewig haltbar."
                            },
                            {
                                "example_id": "a03ac352-3b1a-478a-9844-61a5ef979634",
                                "sense_id": "9d88bfd8-96fa-3480-aff9-c418cb892e43",
                                "text": "Riesige Mengen Lebensmittel werden grundlos weggeworfen, beklagt das Europaparlament. Viele Europäer verstehen offenbar nicht, was Mindesthaltbarkeit bedeutet."
                            },
                            {
                                "example_id": "1da8714f-8f83-4d57-a6ab-870b59930ba3",
                                "sense_id": "9d88bfd8-96fa-3480-aff9-c418cb892e43",
                                "text": "Im Supermarkt werden heute bis zu 20 Prozent der angebotenen Fleischwaren weggeworfen, weil sie nicht im Rahmen der Mindesthaltbarkeit verkauft werden können."
                            },
                            {
                                "example_id": "d1fe91df-096f-467a-9c92-ac0d4e26a9ce",
                                "sense_id": "9d88bfd8-96fa-3480-aff9-c418cb892e43",
                                "text": "Viele halten Lebensmittel mit abgelaufenem Haltbarkeitsdatum für verdorben. Das ist oft falsch – und führt zu großer Verschwendung. Die Industrie profitiert davon."
                            },
                            {
                                "example_id": "043b4ad9-0b00-40cf-9908-40a2b5e56c28",
                                "sense_id": "9d88bfd8-96fa-3480-aff9-c418cb892e43",
                                "text": "Der Verbraucher muss nach Ablauf der Mindesthaltbarkeit damit rechnen, dass das Lebensmittel nicht mehr voll seiner Erwartung entspricht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
