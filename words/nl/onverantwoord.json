{
    "word_family": [
        "verantwoord",
        "verantwoorden",
        "verantwoording",
        "onverantwoordelijk",
        "onverantwoordelijkheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cfc09cd7-0ed1-3aee-b86e-7f6d77b7e799",
                    "sense_definition": "onaanvaardbaar riskant of gevaarlijk door een gebrek aan voorzichtigheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "risicovol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>onverantwoord</w> om zonder gordel in een auto te rijden.",
                            "target_lang_translations": {
                                "en": "It is <w>irresponsible</w> to drive in a car without a seatbelt."
                            }
                        },
                        {
                            "text": "De arts vond het een <w>onverantwoorde</w> situatie om de patiënt nu al naar huis te sturen.",
                            "target_lang_translations": {
                                "en": "The doctor felt it was an <w>irresponsible</w> situation to send the patient home already."
                            }
                        }
                    ],
                    "synonyms": [
                        "onverantwoordelijk"
                    ],
                    "antonyms": [
                        "verantwoord"
                    ],
                    "common_phrases": [
                        "onverantwoorde situaties",
                        "totaal onverantwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "unacceptably risky or dangerous due to a lack of caution"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irresponsible",
                                "target_lang_sense_clarification": "lacking proper care or caution"
                            },
                            {
                                "target_lang_word": "reckless",
                                "target_lang_sense_clarification": "dangerously careless"
                            },
                            {
                                "target_lang_word": "unjustifiable",
                                "target_lang_sense_clarification": "too risky to be defended"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24a1f645-556f-3aad-b4f8-8b9be375c955",
                    "sense_definition": "niet te rechtvaardigen of moreel niet te verdedigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moreel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is moreel <w>onverantwoord</w> om nog langer zaken te doen met dat corrupte bedrijf.",
                            "target_lang_translations": {
                                "en": "It is morally <w>unjustifiable</w> to continue doing business with that corrupt company."
                            }
                        },
                        {
                            "text": "De directeur noemde het een <w>onverantwoorde</w> beslissing om het budget zo drastisch te verlagen.",
                            "target_lang_translations": {
                                "en": "The director called it an <w>irresponsible</w> decision to lower the budget so drastically."
                            }
                        }
                    ],
                    "antonyms": [
                        "verantwoord"
                    ],
                    "common_phrases": [
                        "moreel onverantwoord",
                        "onverantwoorde beslissing"
                    ],
                    "target_lang_definitions": {
                        "en": "unjustifiable or morally indefensible"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unjustifiable",
                                "target_lang_sense_clarification": "cannot be defended or excused"
                            },
                            {
                                "target_lang_word": "irresponsible",
                                "target_lang_sense_clarification": "morally or professionally unsound"
                            },
                            {
                                "target_lang_word": "indefensible",
                                "target_lang_sense_clarification": "not able to be maintained or justified"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}