                        "sense_id": "986b4b53-a75e-3f3e-b6b4-ab16d6a9e29c",
                        "entry_id": "affdcffe-6427-320c-904a-0fcce3add3bb",
                        "glosses": [
                            "geneigd om dingen goed te praten"
