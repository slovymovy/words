                                "target_senses": [
                                    {
                                        "sense_id": "53311a32-56a1-32ea-9e0a-4ea792e2120c",
                                        "entry_id": "99b73322-d5d7-3249-b7ba-ae4f86314aa4",
                                        "glosses": [
                                            "One who rationalizes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50fb2cf1-76c4-4c5a-bb70-01672a34ced0",
                                                "sense_id": "53311a32-56a1-32ea-9e0a-4ea792e2120c",
                                                "text": "Another factor that makes it difficult to forecast our future happiness is that most of us are rationalizers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "713558ec-6534-46e4-ae03-d7d34a3b573f",
                        "source_entry_id": "3ae69e8d-eb6a-3124-9256-ddafcd8d0c43",
                        "source_sense_id": "72702ccc-5f15-375b-9df3-6ebc4c13287d",
                        "target_lang_word": "innovator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innovator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "801d6cc4-6c0d-3377-97d5-bec87cf9d3c3",
                                        "entry_id": "e54028de-29c4-3d70-8178-6a6f7deabf69",
                                        "glosses": [
                                            "Someone who innovates; a creator of new ideas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9242a226-f9b6-46b7-afa5-afffe2b0a846",
                                                "sense_id": "801d6cc4-6c0d-3377-97d5-bec87cf9d3c3",
                                                "text": "Described by the judging panel as a \"Swiss army knife of the 21st century\", Apache Hadoop picked up the innovator of the year award for having the potential to change the face of media innovations."
                                            },
                                            {
                                                "example_id": "f88c95ad-bb40-4691-a7f3-21950712cd46",
                                                "sense_id": "801d6cc4-6c0d-3377-97d5-bec87cf9d3c3",
                                                "text": "Competition gets thinner still when it comes to the 00s: Animal Collective and Joanna Newsom do one thing very well, Gaga and MIA are aggregators not innovators. Björk is peerless."
                                            },
                                            {
                                                "example_id": "7275bbd4-c0ab-4959-a06a-38b474a4a497",
                                                "sense_id": "801d6cc4-6c0d-3377-97d5-bec87cf9d3c3",
                                                "text": "We now have good reason to question the pursuits of the vaunted innovators with whom Liu consorted in California – the blissed-out cultists at Google, whose only worry is over “the wrong kind of sparkling water in the microkitchens”, or the manic experts who specialise in “envisioning hyperplanes in n-dimensional space”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969932e5-cf95-35fb-8d06-b9df832486ec",
                                        "entry_id": "e54028de-29c4-3d70-8178-6a6f7deabf69",
                                        "glosses": [
                                            "An early adopter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
