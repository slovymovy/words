                    },
                    {
                        "translation_id": "ddeea879-2da7-4c4b-802f-39f11a450f61",
                        "source_entry_id": "f77ac6fd-93a7-3f90-9842-d7daeb3adddd",
                        "source_sense_id": "6cdc4ea3-3a71-3766-aac7-e7e2fbfd0884",
