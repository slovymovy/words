                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efae830f-0ae5-48ae-a900-cce599b8cd1e",
                                "sense_id": "3b2ae6bf-59d2-3875-bf2b-a15b3d481ad5",
                                "text": "Le temps de vol était fortement abaissé, la régularité du service mieux assurée, comme était renforcé l’attrait du vol long-courrier auprès de la clientèle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "237fb0ec-39db-3cf7-a770-c638587c14cf",
