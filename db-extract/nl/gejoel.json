                "senses": [
                    {
                        "sense_id": "1c4678e8-0532-3a20-8a72-1d7307152515",
                        "entry_id": "ff7093e8-3c7c-330e-8f41-da9df72c17cf",
                        "glosses": [
                            "luidruchtige uiting van een heftige emotie door een groep mensen, meestal als teken van vreugde maar het kan ook een teken van afkeuring zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f77bef-69e1-49ff-a82f-2a77023c53d4",
                                "sense_id": "1c4678e8-0532-3a20-8a72-1d7307152515",
                                "text": "Ineens is er gejoel. Oppositieleider en presidentskandidaat Henrique Capriles maakt zijn opwachting in de demonstratie. Capriles is naast Leopoldo López, die al drie jaar gevangen zit, het gezicht van de oppositie."
                            },
                            {
                                "example_id": "e2b8231c-5db2-48d0-8d6c-69231b446c3f",
                                "sense_id": "1c4678e8-0532-3a20-8a72-1d7307152515",
                                "text": "0, gegild werd er: kinderen werden nagezeten door heksen en kermisvolk, tieners werden van de ronddraaiende rodeostier geworpen, ouderen deden wedstrijdjes hoefijzerwerpen en hun gejoel steeg schril op in de straten van Beek, waar de laaghangende mist het vervormde tot een dissonant gefluister."
                            }
                        ]
                    }
                ],
