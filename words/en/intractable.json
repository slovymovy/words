{
    "word_family": [
        "tractable",
        "intractability",
        "intractableness",
        "intractably",
        "tractability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "77fdfd8d-4d56-3b12-99e7-9106c5d33691",
                    "sense_definition": "Very difficult to deal with, solve, or manage.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficult_or_unmanageable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee spent years trying to solve the <w>intractable</w> problem of urban poverty.",
                            "target_lang_translations": {
                                "tr": "Komite, kentsel yoksulluğun <w>içinden çıkılmaz</w> sorununu çözmeye çalışarak yıllarını harcadı."
                            }
                        },
                        {
                            "text": "Negotiators faced an seemingly <w>intractable</w> conflict that resisted all diplomatic solutions.",
                            "target_lang_translations": {
                                "tr": "Müzakereciler, tüm diplomatik çözümlere direnen ve görünüşte <w>çözümsüz</w> olan bir çatışmayla karşı karşıya kaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "insoluble",
                        "unmanageable"
                    ],
                    "antonyms": [
                        "tractable",
                        "manageable",
                        "solvable"
                    ],
                    "common_phrases": [
                        "intractable problem",
                        "intractable conflict",
                        "intractable dilemma"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başa çıkması, çözmesi veya idare etmesi son derece zor olan (sorun, durum vb.)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çözümsüz",
                                "target_lang_sense_clarification": "sorun veya anlaşmazlık"
                            },
                            {
                                "target_lang_word": "içinden çıkılmaz",
                                "target_lang_sense_clarification": "karmaşık durum"
                            },
                            {
                                "target_lang_word": "çözümü çok güç",
                                "target_lang_sense_clarification": "problem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afed8327-1822-3d09-b63a-b73b23f5bde0",
                    "sense_definition": "Stubborn, obstinate, and refusing to comply or be directed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficult_or_unmanageable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager found the new employee completely <w>intractable</w> and unwilling to listen.",
                            "target_lang_translations": {
                                "tr": "Müdür, yeni çalışanı tamamen <w>dikbaşlı</w> ve laf dinlemeye isteksiz buldu."
                            }
                        },
                        {
                            "text": "He remained <w>intractable</w> despite all our efforts to reason with him.",
                            "target_lang_translations": {
                                "tr": "Onunla mantıklı bir şekilde konuşma çabalarımıza rağmen <w>inatçı</w> tavrını sürdürdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "stubborn",
                        "obstinate",
                        "unruly"
                    ],
                    "antonyms": [
                        "tractable",
                        "compliant",
                        "docile"
                    ],
                    "target_lang_definitions": {
                        "tr": "İnatçı, dikbaşlı ve yönlendirilmeye ya da söz dinlemeye yanaşmayan (insan veya davranış)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dikbaşlı",
                                "target_lang_sense_clarification": "söz dinlemeyen insan"
                            },
                            {
                                "target_lang_word": "inatçı",
                                "target_lang_sense_clarification": "uzlaşmaz tutum"
                            },
                            {
                                "target_lang_word": "yola gelmez",
                                "target_lang_sense_clarification": "ele avuca sığmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f77f73e7-f6db-39a4-afd5-aed3caf25356",
                    "sense_definition": "Resistant to treatment or cure, as a disease or symptom.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficult_or_unmanageable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered from <w>intractable</w> pain that standard medications failed to relieve.",
                            "target_lang_translations": {
                                "tr": "Hasta, standart ilaçların dindiremediği <w>dinmeyen</w> ağrılardan muzdaripti."
                            }
                        },
                        {
                            "text": "Certain types of epilepsy are considered <w>intractable</w> when medications do not control seizures.",
                            "target_lang_translations": {
                                "tr": "Nöbetler ilaçlarla kontrol altına alınamadığında bazı epilepsi türleri <w>tedaviye dirençli</w> olarak kabul edilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "refractory",
                        "untreatable"
                    ],
                    "antonyms": [
                        "treatable",
                        "curable"
                    ],
                    "common_phrases": [
                        "intractable pain",
                        "intractable disease"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tedaviye veya iyileşmeye direnç gösteren (hastalık, ağrı veya semptom)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tedaviye dirençli",
                                "target_lang_sense_clarification": "hastalık veya semptom"
                            },
                            {
                                "target_lang_word": "dinmeyen",
                                "target_lang_sense_clarification": "ağrı"
                            },
                            {
                                "target_lang_word": "inatçı",
                                "target_lang_sense_clarification": "tıbbi semptom veya rahatsızlık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abdee0e9-926d-3908-8013-60ea6ef3b01f",
                    "sense_definition": "Not able to be managed, governed, or directed.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "difficult_or_unmanageable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country became nearly <w>intractable</w> during the prolonged political crisis.",
                            "target_lang_translations": {
                                "tr": "Ülke, uzayan siyasi kriz sırasında neredeyse <w>yönetilemez</w> hale geldi."
                            }
                        },
                        {
                            "text": "Colonial authorities often struggled to control <w>intractable</w> territories on the frontier.",
                            "target_lang_translations": {
                                "tr": "Sömürge yetkilileri, sınırdaki <w>kontrol edilemez</w> toprakları idare etmekte sıklıkla zorlandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "ungovernable",
                        "uncontrollable"
                    ],
                    "antonyms": [
                        "tractable",
                        "governable"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yönetilmesi, idare edilmesi veya kontrol altında tutulması neredeyse imkânsız olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yönetilemez",
                                "target_lang_sense_clarification": "ülke, bölge veya topluluk"
                            },
                            {
                                "target_lang_word": "kontrol edilemez",
                                "target_lang_sense_clarification": "durum veya bölge"
                            },
                            {
                                "target_lang_word": "zapt edilemez",
                                "target_lang_sense_clarification": "idare edilemeyen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1683455-cddd-3ab6-8792-fd30fe83526a",
                    "sense_definition": "In computational complexity theory, impossible to solve efficiently or within polynomial time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "difficult_or_unmanageable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Computer scientists proved that the optimization problem was computationally <w>intractable</w> for large inputs.",
                            "target_lang_translations": {
                                "tr": "Bilgisayar bilimcileri, optimizasyon probleminin büyük girdiler için hesaplamalı olarak <w>üstesinden gelinemez</w> olduğunu kanıtladı."
                            }
                        },
                        {
                            "text": "Even with modern supercomputers, this algorithm remains <w>intractable</w> due to exponential runtime.",
                            "target_lang_translations": {
                                "tr": "Modern süper bilgisayarlarla bile, bu algoritma üstel çalışma süresi nedeniyle <w>hesaplanamaz</w> kalmaya devam ediyor."
                            }
                        }
                    ],
                    "antonyms": [
                        "tractable"
                    ],
                    "common_phrases": [
                        "computationally intractable"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hesaplamalı karmaşıklık teorisinde, etkin şekilde veya polinom zamanda çözülmesi imkânsız olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hesaplanamaz",
                                "target_lang_sense_clarification": "etkin sürede çözülemez problem"
                            },
                            {
                                "target_lang_word": "üstesinden gelinemez",
                                "target_lang_sense_clarification": "hesaplama karmaşıklığı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}