                "senses": [
                    {
                        "sense_id": "c7ae49b0-4339-36ea-9bcf-7ba05c913b92",
                        "entry_id": "a2ea01c3-a81c-3f19-8595-6302d41bf606",
                        "glosses": [
                            "Contracter plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bbd3f8a-7aa5-4f3e-8372-2afebf648885",
                                "sense_id": "c7ae49b0-4339-36ea-9bcf-7ba05c913b92",
                                "text": "Ouais je me surprends parfois à tout surcontracter sur mes béquilles, des bons dips partiels mais avec plein de stabilisateurs qui bossent en plus!"
                            },
                            {
                                "example_id": "e4f758c7-978b-4ae2-8b12-43cd67d109b7",
                                "sense_id": "c7ae49b0-4339-36ea-9bcf-7ba05c913b92",
                                "text": "Vous ne voulez pas \"surcontracter\" à en restreindre le souffle, c'est très subtil vraiment."
                            },
                            {
                                "example_id": "0da246aa-5d4b-488d-bf44-2b97b59f47f7",
                                "sense_id": "c7ae49b0-4339-36ea-9bcf-7ba05c913b92",
                                "text": "Pour la deuxième façon de déclencher, il ne faut pas de contractions, sinon ça risque de surcontracter et là ce serait césa..."
                            }
                        ]
                    }
