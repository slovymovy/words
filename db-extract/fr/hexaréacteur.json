                        "examples": [
                            {
                                "example_id": "5fa191bc-3188-4d48-b87c-8c72505fc44d",
                                "sense_id": "c0552ec3-6bf6-3898-a0d6-27bb7bd6fa2b",
                                "text": "Ainsi, voyez-vous, le nom de tian wang ne devrait pas être porté par un brave appareil commercial comme celui-ci, mais par un puissant bombardier hexaréacteur, capable de transporter la bombe à hydrogène jusqu’à Moscou et Leningrad."
                            },
                            {
                                "example_id": "73d140c2-980c-4179-84aa-e6ae73aefc7d",
                                "sense_id": "c0552ec3-6bf6-3898-a0d6-27bb7bd6fa2b",
                                "text": "Il s’agit d'un projet d’avion géant hexaréacteur à double fuselage destiné à lancer des satellites en orbite basse et ainsi offrir un substitut aux lanceurs fusées classiques en étant moins onéreux."
                            }
                        ]
                    }
