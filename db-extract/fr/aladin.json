                        "glosses": [
                            "Désigne une chose se référant à Aladin ou au conte Aladin ou la Lampe merveilleuse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578ac839-965d-4e92-8792-7c096943a992",
                                "sense_id": "d78c9c15-1be6-36a7-a71e-d838fbeea450",
                                "text": "Colette. honnit le cocuage, elle émerge des profondeurs d'une Kasbah d'Alger, qu'elle a prospectée comme une mine, comme une caverne aladine, comme un fétide puisard."
                            }
                        ]
                    },
