                "senses": [
                    {
                        "sense_id": "a2ea0bbb-89b6-36ea-8a82-176c15c4ed36",
                        "entry_id": "2fe4b907-9e6f-3ded-b2a4-94b87a61e057",
                        "glosses": [
                            "großes, menschenähnliches, weibliches Wesen"
                        ],
                        "tags": [
                            "mythologisch"
                        ],
                        "examples": [
                            {
                                "example_id": "359431ab-d70b-4fd5-b51b-9a490e1d2a50",
                                "sense_id": "a2ea0bbb-89b6-36ea-8a82-176c15c4ed36",
                                "text": "Fenja ist eine Riesin der nordischen Mythologie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "14cbcbdc-d690-3204-8738-45cfc089b250",
                        "entry_id": "2fe4b907-9e6f-3ded-b2a4-94b87a61e057",
                        "glosses": [
                            "sehr große weibliche Person"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "08173342-f017-427b-87a3-560258eaf7af",
                                "sense_id": "14cbcbdc-d690-3204-8738-45cfc089b250",
                                "text": "Nach dem Vermessen der Knochen war klar, dass es sich hier um das Grab einer wahren Riesin handelte, die zu ihrer Zeit wohl auch die meisten Männer überragt hatte."
                            },
                            {
                                "example_id": "6e6bc9d0-51f0-49a3-b89e-4c15835be5ad",
                                "sense_id": "14cbcbdc-d690-3204-8738-45cfc089b250",
                                "text": "„Sie hatte nicht die geringsten Probleme damit, aber ich machte mir Sorgen, dass sie eine Riesin werden könnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
