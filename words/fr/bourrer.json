                {
                    "sense_id": "9726d7e5-38fc-3ba1-a368-0bc37c901057",
                    "sense_definition": "Remplir complètement un espace ou un contenant en tassant fortement son contenu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "remplir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il essaie de <w>bourrer</w> tous ses vêtements d'hiver dans une toute petite valise."
                        },
                        {
                            "text": "Le vieil homme nettoie sa pipe puis la <w>bourre</w> soigneusement de tabac brun."
                        }
                    ],
                    "synonyms": [
                        "entasser",
                        "tasser",
                        "remplir"
                    ],
                    "antonyms": [
                        "débourrer"
                    ],
                    "common_phrases": [
                        "bourrer une valise",
                        "bourrer sa pipe"
                    ]
                },
                {
