                            {
                                "example_id": "777cd9a5-32e8-485e-b474-66105688808a",
                                "sense_id": "66b2cfb6-12bc-3f45-95d9-89704d9718ef",
                                "text": "Pan sprzedał swoją duszę za nic; rzucił ją pan do stóp nędznej dzikuski, która zrobiła już z pana pomiotło, i wkrótce zabije pana tak czy inaczej, przez swą miłość albo nienawiść."
                            }
                        ],
