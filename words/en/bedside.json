{
    "word_family": [
        "bedside-table",
        "bedside-lamp",
        "bedside-manner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "caa02464-d890-3927-a890-4e43411492a1",
                    "sense_definition": "A position at the side of one's bed.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "bed_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She kept a glass of water on her <w>bedside</w> table every night.",
                            "target_lang_translations": {
                                "ru": "Каждую ночь она держала стакан воды на своем <w>прикроватном</w> столике."
                            }
                        },
                        {
                            "text": "The nurse sat at the patient's <w>bedside</w> to monitor his breathing.",
                            "target_lang_translations": {
                                "ru": "Медсестра сидела <w>у постели</w> пациента, чтобы следить за его дыханием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bedside table",
                        "bedside lamp",
                        "at the bedside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или пространство рядом с кроватью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикроватный",
                                "target_lang_sense_clarification": "находящийся рядом с кроватью"
                            },
                            {
                                "target_lang_word": "у изголовья",
                                "target_lang_sense_clarification": "расположенный у головы спящего"
                            },
                            {
                                "target_lang_word": "у постели",
                                "target_lang_sense_clarification": "нахождение рядом с больным или спящим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "851e30eb-3419-3db5-a140-2bbd997da5fd",
                    "sense_definition": "Any of the side panels of the bed of a truck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicle_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy cargo accidentally dented the left <w>bedside</w> of the pickup truck.",
                            "target_lang_translations": {
                                "ru": "Тяжелый груз случайно помял левый <w>борт</w> пикапа."
                            }
                        },
                        {
                            "text": "He painted the <w>bedside</w> of the truck to match the rest of the vehicle.",
                            "target_lang_translations": {
                                "ru": "Он покрасил <w>боковину</w> кузова грузовика в цвет остальной машины."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Боковая панель или борт кузова грузовика или пикапа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борт",
                                "target_lang_sense_clarification": "боковая стенка кузова грузовика"
                            },
                            {
                                "target_lang_word": "боковина",
                                "target_lang_sense_clarification": "боковая часть грузовой платформы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}