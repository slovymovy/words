                    {
                        "form_id": "140af0ba-bb5e-498b-b2dd-cc3ba0ed320c",
                        "entry_id": "61332289-52a2-37aa-b2bd-46b5c0678d59",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "œnologues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                        "entry_id": "61332289-52a2-37aa-b2bd-46b5c0678d59",
                        "glosses": [
                            "Spécialiste du vin, de son élaboration et de sa dégustation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba56d540-79b1-407b-b689-946f22a0e5bf",
                                "sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                                "text": "L’Othello, le barbare Othello, conspué, bafoué, honni par tous les Congrès, avait bien enrichi quelques adroits œnologues qui avaient su utiliser son acidité en la sucrant généreusement et défoxer son moût en le chauffant avant fermentation, […]."
                            },
                            {
                                "example_id": "05b8b106-4a62-4a61-b785-d01a0815d9cf",
                                "sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                                "text": "Les vins primeurs sont très flatteurs pour les consommateurs, car ils sont très aromatiques, explique l’œnologue Régine Le Coz."
                            },
                            {
                                "example_id": "fd38692c-e7d4-4e20-bd24-4a8667b6fdce",
                                "sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                                "text": "Les écrits des œnologues fourmillent de recettes qu’on propose pour corriger l’acidité des vins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4767e7d7-6860-4f77-9c9f-7950547ce650",
                        "source_entry_id": "61332289-52a2-37aa-b2bd-46b5c0678d59",
                        "source_sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                        "target_lang_word": "Önologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Önologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                                        "entry_id": "6f426f54-ecc0-3c36-a85b-e5cdff2778b8",
                                        "glosses": [
                                            "Fachmann im Weinbau, also in der Önologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "869d587c-8460-41d6-a569-d5fc8b95f651",
                                                "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                                                "text": "„Franz Wehrheim ist Betriebswirt, Önologe und hat einen Master of Business-Administration.“"
                                            },
                                            {
                                                "example_id": "0ccc5456-5ee5-4436-993d-1c39c40e6a61",
                                                "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                                                "text": "„Der Winzer, Önologe und Biochemiker Jules Chauvet war in den 1970ern im Beaujolais auf der Suche nach authentischen Terroirweinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3454c7a4-7ce4-4960-aed5-c5b32f8f6933",
                        "source_entry_id": "61332289-52a2-37aa-b2bd-46b5c0678d59",
                        "source_sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                        "target_lang_word": "Önologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Önologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad1539f-2394-3cb8-91a9-aad25e1a0372",
                                        "entry_id": "27fdc58a-5b09-3632-a629-2d45546b0d51",
                                        "glosses": [
                                            "Fachfrau im Weinbau, also in der Önologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2000af74-b5d1-432d-bcd6-ca7397b80455",
                                                "sense_id": "2ad1539f-2394-3cb8-91a9-aad25e1a0372",
                                                "text": "„2002 übernahm die studierte Önologin Carolin die Verantwortung im Weingut als Nachfolgerin von ihrem Vater – mit gerade einmal 24 Jahren.“"
                                            },
                                            {
                                                "example_id": "5b8c51a5-0368-45e3-bb86-c389ca6024db",
                                                "sense_id": "2ad1539f-2394-3cb8-91a9-aad25e1a0372",
                                                "text": "„Zuerst hatte sie Betriebswirtschaft studiert und sich gleich anschließend zur Winzerin und Önologin ausbilden lassen.“"
                                            },
                                            {
                                                "example_id": "5587acaa-5840-4f3c-927d-6738f23014c9",
                                                "sense_id": "2ad1539f-2394-3cb8-91a9-aad25e1a0372",
                                                "text": "„Das ist für mich der Traumberuf schlechthin. Der Flying Winemaker ist ein beratender Önologe (oder eine Önologin), dessen Kunden oft in der ganzen Welt verstreut sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
