                "senses": [
                    {
                        "sense_id": "f9ffa1ec-af23-36f7-abdf-23d411a36fa1",
                        "entry_id": "ae7e17ca-f15d-3b16-a86e-7a79df12bf8b",
                        "glosses": [
                            "ungeschlechtliche Vermehrung (Fortpflanzung) durch Zellteilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17064c6c-c216-4894-a909-38b7d1631101",
                                "sense_id": "f9ffa1ec-af23-36f7-abdf-23d411a36fa1",
                                "text": "„Oft wird das Parasitenwachstum synchronisiert, die Parasiten erreichen das Stadium der Schizogonie gleichzeitig und mit dem Zerfall der Erythrozyten werden Pyrogene freigesetzt, die für Fieber und die klinischen Symptome verantwortlich sind.“"
                            },
                            {
                                "example_id": "0f632c97-39d6-4007-b519-ae341b641d6f",
                                "sense_id": "f9ffa1ec-af23-36f7-abdf-23d411a36fa1",
                                "text": "„Nach mehreren Schizogonien erfolgt die Gamogonie und dann die Sporogonie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
