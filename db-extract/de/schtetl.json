                        "examples": [
                            {
                                "example_id": "069b94e1-6178-4caa-8814-4406945f06d6",
                                "sense_id": "cb16683d-71b7-3126-a6af-7665a0263bc5",
                                "text": "Das Schtetl ist, mit Sehnsucht verklärt, im kollektiven jüdischen Gedächtnis immer noch präsent. Auch und besonders jene, die es verdrängen wollen, als Ballast empfinden und über lange Strecken hinweg vergessen, tragen es weiter in sich."
                            }
