                                "target_senses": [
                                    {
                                        "sense_id": "e7522708-55b0-3f94-a4a8-82e3d49dcc59",
                                        "entry_id": "e302da27-56a5-3302-9769-9e9d1075963a",
                                        "glosses": [
                                            "Maßeinheit der Datenmenge, wobei ein Byte genau acht Bit entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b71a7d0a-76f1-46d7-9ecf-b18e3fa47cbe",
                                                "sense_id": "e7522708-55b0-3f94-a4a8-82e3d49dcc59",
                                                "text": "Heutige Festplatten können eine Datenmenge in einer Größenordnung von einer Billion Byte speichern."
                                            },
                                            {
                                                "example_id": "73770102-0727-4d04-8eef-0be858bfa1af",
                                                "sense_id": "e7522708-55b0-3f94-a4a8-82e3d49dcc59",
                                                "text": "Die ersten Disketten hatten eine Kapazität von 184 320 Byte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e445cc7-897e-3737-92a7-eff07e4ba85a",
                                        "entry_id": "e302da27-56a5-3302-9769-9e9d1075963a",
                                        "glosses": [
                                            "Kleinste adressierbare Datenmenge eines bestimmten technischen Systems, bei heutigen Computern meist 8 Bit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47bd416f-f877-420b-b734-8040615236a2",
                                                "sense_id": "8e445cc7-897e-3737-92a7-eff07e4ba85a",
                                                "text": "Moderne Prozessoren verarbeiten 8 Byte auf einmal."
                                            },
                                            {
                                                "example_id": "01970960-cca9-4d96-99cd-21eb3fa83b8a",
                                                "sense_id": "8e445cc7-897e-3737-92a7-eff07e4ba85a",
                                                "text": "Beim Rechnersystem UNIVAC 1100 war ein Byte 9 Bit lang."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7a27adef-c0a9-36b5-b1ba-cbdaf8b725e2",
                                        "entry_id": "e302da27-56a5-3302-9769-9e9d1075963a",
                                        "glosses": [
                                            "geordnete Zusammenstellung von 8 Bit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58dff7cf-31e9-4756-a6a3-8efa38929d1b",
                                                "sense_id": "7a27adef-c0a9-36b5-b1ba-cbdaf8b725e2",
                                                "text": "Der Wert eines Bytes wird meist als Hexadezimalzahl angeben, z.B. „0x41“ oder „41h“ für den Wert 65."
                                            },
                                            {
                                                "example_id": "1b60f978-9f4c-4892-86a8-36816f5df7df",
                                                "sense_id": "7a27adef-c0a9-36b5-b1ba-cbdaf8b725e2",
                                                "text": "Wenn es auf genaue Formulierungen ankommt, sollte man statt Byte das Wort „Oktett“ verwenden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "30f37b3d-42d4-3dd1-a7d0-32d30aa22d0f",
                                        "entry_id": "e302da27-56a5-3302-9769-9e9d1075963a",
                                        "glosses": [
                                            "Datentyp einiger Programmiersprachen, meistens der Länge 8 Bit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e31a7039-e88e-45bd-b1ec-e69cb6b14d23",
                                                "sense_id": "30f37b3d-42d4-3dd1-a7d0-32d30aa22d0f",
                                                "text": "Ein Byte in der Programmiersprache C ist auf verschiedenen Plattformen verschieden breit, umfasst aber immer wenigstens 8 Bit."
                                            },
                                            {
                                                "example_id": "b52fd04e-bb91-485a-a330-cd40051685e9",
                                                "sense_id": "30f37b3d-42d4-3dd1-a7d0-32d30aa22d0f",
                                                "text": "In dieser Programmiersprache ist der Datentyp Byte eine Zahl ohne Vorzeichen zwischen 0 und 255."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
