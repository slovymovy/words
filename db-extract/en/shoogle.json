                "senses": [
                    {
                        "sense_id": "c3f0c589-4646-3c86-b413-08be0e12749c",
                        "entry_id": "eb379ea1-140d-361a-9364-3fdd5c1ed369",
                        "glosses": [
                            "To shake or rock rapidly."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e6866814-5012-4d6c-8823-a1d319389638",
                                "sense_id": "c3f0c589-4646-3c86-b413-08be0e12749c",
                                "text": "I heard the sparks who drove us saying something like, ‘You keep these three Doc; we'll shoogle up the mess boys and find some breakfast.’"
                            },
                            {
                                "example_id": "14127746-a7a5-4857-b9f7-849e162ba5ee",
                                "sense_id": "c3f0c589-4646-3c86-b413-08be0e12749c",
                                "text": "Suddenly, a rhythmic shaking and rattling overtook the room, shoogling and shimmying the structure in time to the acid jazz stomp riverboat boogie shuffle beat of the song."
                            },
                            {
                                "example_id": "a373ef35-e657-4564-838e-d09bc24f1c9f",
                                "sense_id": "c3f0c589-4646-3c86-b413-08be0e12749c",
                                "text": "He dipped it, scooped up a sheet's worth of pulp from the vessel and shook it even, rocking it back and forth to let out the water. There is a wonderful Scots word, ‘shoogle’, for precisely this rocking motion. After shoogling the frame, he let it drip for a few seconds, then, as if opening the window, he raised the deckle and lifted out the gauze."
                            }
                        ]
                    }
