                                "target_senses": [
                                    {
                                        "sense_id": "bd3d78ef-9a02-3580-bb05-d6b7d842275a",
                                        "entry_id": "9b84d8c7-f257-3b2a-9c9d-0755715805cd",
                                        "glosses": [
                                            "An open hearth for holding a fire at the base of a chimney."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bcccfe5-b137-4fbb-b062-eb7bc8b9d554",
                                                "sense_id": "bd3d78ef-9a02-3580-bb05-d6b7d842275a",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            },
                                            {
                                                "example_id": "291a7191-7d61-4118-8be4-8191cd386e32",
                                                "sense_id": "bd3d78ef-9a02-3580-bb05-d6b7d842275a",
                                                "text": "Opposite the old church is a Tudor black-and-white cottage, flanked at one end by the Brocket Arms, a splendid 400-year-old pub with stone-flagged floors, a vast inglenook fireplace and a garden full of oak tables and benches for summer evening meditation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
