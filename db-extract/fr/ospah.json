                        "glosses": [
                            "Arme mystique utilisée par les guérillères dans l’œuvre éponyme de Monique Wittig. Se matérialise en un cercle vert lorsque utilisée."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "588bdd73-ae83-4f35-8415-464b529b819b",
                                "sense_id": "fc79e022-7e3f-37fc-a94b-9f3db77e912e",
                                "text": "L'ospah (un néologisme) est une autre arme mystique qu'utilisent les guérillères:"
                            },
                            {
                                "example_id": "eb940761-c58e-4c42-b370-e445dfbe0241",
                                "sense_id": "fc79e022-7e3f-37fc-a94b-9f3db77e912e",
                                "text": "Magnifique l’ospah, dit Philippe, superbe tous ces noms, tous ces O!"
                            },
                            {
                                "example_id": "89a9a467-0281-4826-ab97-f460cc38da53",
                                "sense_id": "fc79e022-7e3f-37fc-a94b-9f3db77e912e",
                                "text": "L'ospah est invisible tant qu'elle n'entre pas en action. Quand elle est maniée au cours du combat elle se matérialise en un cercle vert qui crépite en exhalant des odeurs."
                            }
                        ]
                    }
