        "ru-extract.jsonl": [
            {
                "entry_id": "894b2244-9657-3c8a-b3ed-cbdf81d0e0e1",
                "word": "ге",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "330b23e2-16a3-37f4-89b0-565588b6324c",
                        "entry_id": "894b2244-9657-3c8a-b3ed-cbdf81d0e0e1",
                        "glosses": [
                            "прост. возглас, выражающий радость, удивление и т. п. (обычно с повторением)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f172153f-8f24-4841-ab4e-9a9186af1172",
                                "sense_id": "330b23e2-16a3-37f4-89b0-565588b6324c",
                                "text": "— Тебя не касается. А тебе? — Четырнадцать, — сказал мальчик, слегка привирая. — Ге! — сказал Ваня и свистнул. — Чего — ге? — Так какой же ты солдат?"
                            }
                        ]
                    },
                    {
                        "sense_id": "1e88494e-a9c4-3a4d-8988-1cb8f5c6c145",
                        "entry_id": "894b2244-9657-3c8a-b3ed-cbdf81d0e0e1",
                        "glosses": [
                            "прост. возглас с целью окликнуть, подозвать кого-либо, соответствующий по значению словам: эй!, гей!"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d0aa2f0-55fd-4558-bbf3-4dbdc13665f8",
                                "sense_id": "1e88494e-a9c4-3a4d-8988-1cb8f5c6c145",
                                "text": "— Да, я шучу, молодой человек, — вытирая платком лоб, хладнокровно ответил дядя. — Шутка украшает жизнь. А иначе жизнь легка только тупицам да лежебокам. Ге! Так ли я говорю, юноша? — хлопнул он меня по плечу."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "856601e7-f193-38dc-aedc-d2db6d89e8d5",
