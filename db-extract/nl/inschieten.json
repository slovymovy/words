                "senses": [
                    {
                        "sense_id": "96a0fdfd-6cfb-3bc0-a844-17f0e476f4e6",
                        "entry_id": "42174dd6-590b-385c-810b-ceb0c1b3fbaf",
                        "glosses": [
                            "verontschuldigend zeggen dat je een afspraak niet bent nagekomen omdat je er geen tijd voor had of omdat je het vergeten bent"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "60ec4eb3-c4b9-4ed3-a312-7a4043a2ffe1",
                                "sense_id": "96a0fdfd-6cfb-3bc0-a844-17f0e476f4e6",
                                "text": "Het koken ging erbij inschieten. Dan maar sushi laten bezorgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2949a1c2-69e9-3a93-91db-0c78679dddfe",
                        "entry_id": "42174dd6-590b-385c-810b-ceb0c1b3fbaf",
                        "glosses": [
                            "iets (wat je dreigt te) verliezen in de drukte van het bestaan"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "78f115f8-8282-4962-a1a0-fa9a6ebb87ae",
                                "sense_id": "2949a1c2-69e9-3a93-91db-0c78679dddfe",
                                "text": "Kom je niet aan lezen, hardlopen en nadenken toe? Steeds meer mensen zetten hun wekker eerder, om nog voor het ontbijt iets te doen wat er anders bij inschiet."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcae43ac-4902-343c-8849-82ab1579c61c",
                        "entry_id": "42174dd6-590b-385c-810b-ceb0c1b3fbaf",
                        "glosses": [
                            "de bal met een schop naar het doel laten gaan bij voetbal"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fa27724e-d16d-4658-afb9-42196b7ae1c0",
                                "sense_id": "fcae43ac-4902-343c-8849-82ab1579c61c",
                                "text": "Kort nadat Bayern verzuimde op 2-0 te komen, omdat Vidal een strafschop miste, scoorde Cristiano Ronaldo, altijd hij, kort na rust voor het eerst. Het was een knappe goal van de Europees voetballer van het jaar. Even inhouden, dan weglopen van twee tegenstanders, anticiperen op de lage voorzet van Carvajal, en de bal vervolgens met de binnenkant van de voet, of deels met het scheenbeen, diagonaal inschieten. Het was meteen gedaan met het goede spel van Bayern, getraind door Carlo Ancelotti, die de beker met Real won in 2014."
                            },
                            {
                                "example_id": "ca5e9dcd-6e71-46a9-9693-a1fe91580c26",
                                "sense_id": "fcae43ac-4902-343c-8849-82ab1579c61c",
                                "text": "Even later tekende Lewandowski wel voor zijn tiende Champions League-treffer. Oud-Ajacied Maximilian Wöber ging het duel met de Poolse spits veel te lomp in, waarna Lewandowski zijn zelf verdiende strafschop snoeihard in de linkerhoek schoot: 1-0."
                            }
                        ]
                    },
                    {
                        "sense_id": "d206e7df-b0d5-3aa2-b2e9-0721c1f4197b",
                        "entry_id": "42174dd6-590b-385c-810b-ceb0c1b3fbaf",
                        "glosses": [
                            "testen van wapens"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5e375c1f-5dce-3c7a-aad6-ffa494c289be",
                        "entry_id": "42174dd6-590b-385c-810b-ceb0c1b3fbaf",
                        "glosses": [
                            "afspreken"
                        ],
                        "tags": [
                            "kantoorcliché"
                        ],
                        "examples": [
                            {
                                "example_id": "ee188339-bb6d-4d8a-8680-b55a9b3c6ab1",
                                "sense_id": "5e375c1f-5dce-3c7a-aad6-ffa494c289be",
                                "text": "Zo is ‘afspreken’ ‘inschieten’ geworden, als in „die meeting moeten we nog even inschieten”. De eerste keer dat ik iemand het hoorde zeggen heb ik gelijk een kogelwerend vest en een veiligheidsbril op internet besteld maar het bleek nog steeds dezelfde saaie vergadering als altijd."
                            }
                        ]
                    }
