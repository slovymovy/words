                    }
                ],
                "translations": [
                    {
                        "translation_id": "93cc6b33-3d7d-450a-b075-917a4cb48819",
                        "source_entry_id": "5d2d66c3-6df9-3c0f-bc28-7010c084a666",
                        "source_sense_id": "abc92bfa-e8d1-3417-bbcf-fabcf80ac215",
                        "source_sense_description": "mechanisches Gerät zum automatischen Bedrucken",
                        "target_lang_word": "printing machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4fe3a615-3754-45d6-8ec2-e0f72d7778da",
                        "source_entry_id": "5d2d66c3-6df9-3c0f-bc28-7010c084a666",
                        "source_sense_id": "abc92bfa-e8d1-3417-bbcf-fabcf80ac215",
                        "source_sense_description": "mechanisches Gerät zum automatischen Bedrucken",
                        "target_lang_word": "presse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c3a2694-aa3e-3ee6-96ae-d8d5bb19c494",
                                        "entry_id": "16edf4b7-6386-3e68-a8f6-7c53125caef1",
                                        "glosses": [
                                            "Action de presser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b515cbf0-a2f3-4ee1-99ac-dfe6ccb7b9d8",
                                                "sense_id": "5c3a2694-aa3e-3ee6-96ae-d8d5bb19c494",
                                                "text": "La noblesse d’Auch demande l’exemption de la milice en faveur des laboureurs et cultivateurs, hors le temps de presse, et que le tirage se fasse, lorsqu’il aura lieu, sous la direction des militaires commis à cet effet par les Etats de la province, p. 95, art. 16."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eebdbb15-e210-37e0-9d37-3d91a93160b6",
                                        "entry_id": "16edf4b7-6386-3e68-a8f6-7c53125caef1",
                                        "glosses": [
                                            "Mécanisme qui, à l’aide d’un effort minime, permet d’exercer une pression considérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ece994f-ac16-4dd1-b36c-a029663f722f",
                                                "sense_id": "eebdbb15-e210-37e0-9d37-3d91a93160b6",
                                                "text": "Presse à vis."
                                            },
                                            {
                                                "example_id": "514e74d4-6a9b-4029-8afd-edf6d62c8e12",
                                                "sense_id": "eebdbb15-e210-37e0-9d37-3d91a93160b6",
                                                "text": "Or comment voulez-vous qu’on vienne prendre tous les détenteurs de presses à copier pour leur faire un procès ?"
                                            },
                                            {
                                                "example_id": "a209c566-c90a-4874-9ca6-1066fdaedfb5",
                                                "sense_id": "eebdbb15-e210-37e0-9d37-3d91a93160b6",
                                                "text": "Les relieurs se servent de plusieurs sortes de presses."
                                            },
                                            {
                                                "example_id": "5ced4668-66b2-4468-8754-4b40afee58d4",
                                                "sense_id": "eebdbb15-e210-37e0-9d37-3d91a93160b6",
                                                "text": "Mettre du linge, des étoffes à la presse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a43d2ff-3cab-3640-827d-5412d618a316",
                                        "entry_id": "16edf4b7-6386-3e68-a8f6-7c53125caef1",
                                        "glosses": [
                                            "Machine destinée à presser et mettre en balles ou ballots le foin, la paille."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c73f3d-2a34-4218-92bc-240e5e2a3473",
                                                "sense_id": "4a43d2ff-3cab-3640-827d-5412d618a316",
                                                "text": "Le ramasseur fonctionne à la manière d’un râteau rotatif qui soulève le fourrage ou la paille en andain sur le sol et l’élève vers les organes internes de la presse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c1a559-8c3d-3613-81f8-378ce1a1bcb4",
                                        "entry_id": "16edf4b7-6386-3e68-a8f6-7c53125caef1",
                                        "glosses": [
                                            "Machine au moyen de laquelle on imprime soit les feuilles d’un livre, soit des gravures, etc."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9981ae7e-4114-4241-8528-ec6dbde8072e",
                                                "sense_id": "06c1a559-8c3d-3613-81f8-378ce1a1bcb4",
                                                "text": "Je converse avec Homère et Cicéron, les Homères et Cicérons des siècles à naitre converseront avec nous, en sorte qu’on peut hésiter à prononcer si une presse n’est pas autant un véritable sens intellectuel, révélé à l’homme par Gutenberg, qu’une machine matérielle."
                                            },
                                            {
                                                "example_id": "e7791a6b-6c44-4542-bed2-e42ad2ce932b",
                                                "sense_id": "06c1a559-8c3d-3613-81f8-378ce1a1bcb4",
                                                "text": "Dans la nuit du 9 au 10, les sectionnaires et les fédérés, dont le principal centre d’impulsion semble avoir été le club électoral siégeant à l’Évêché, brisent les presses des imprimeries girondines"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7520cfe0-9a85-385f-ae2e-a1fd1df89c6e",
                                        "entry_id": "16edf4b7-6386-3e68-a8f6-7c53125caef1",
                                        "glosses": [
                                            "Ensemble des journaux."
                                        ],
                                        "tags": [
                                            "collective",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28765ec3-0098-41b7-af91-da090a431a45",
                                                "sense_id": "7520cfe0-9a85-385f-ae2e-a1fd1df89c6e",
                                                "text": "La presse aussi ne laissait pas échapper une occasion de les dépopulariser. Des articles de journaux, conçus dans les termes les plus virulens, des pamphlets satiriques, et enfin tout ce que peut inventer l’esprit de parti fut mis en œuvre pour attirer la vengeance sur les nouveaux parias politiques."
                                            },
                                            {
                                                "example_id": "0fd714b9-fdd8-461b-9050-8dd653b684c3",
                                                "sense_id": "7520cfe0-9a85-385f-ae2e-a1fd1df89c6e",
                                                "text": "Une presse complaisante jusqu’à la servilité répandait dans le public, depuis les salons jusqu’aux mansardes, les idées les plus fausses et les plus dangereuses."
                                            },
                                            {
                                                "example_id": "40ffc84d-9bf6-4f62-a369-5215901179d2",
                                                "sense_id": "7520cfe0-9a85-385f-ae2e-a1fd1df89c6e",
                                                "text": "La presse se réjouit ouvertement de ces manifestations et félicite le peuple du fait que les juifs « ne peuvent plus maintenant comploter contre l’État sous couvert de services religieux »."
                                            },
                                            {
                                                "example_id": "2286ab01-23ca-490a-bc2d-294f80dd254d",
                                                "sense_id": "7520cfe0-9a85-385f-ae2e-a1fd1df89c6e",
                                                "text": "Tous les gouvernements le tolèrent parce qu’ils y trouvent leur compte - et certains le favorisent parce que, grâce à des presses salariées et à des majorités vénales, ils sont pratiquement asservis aux Rois de la Haute Banque et de la Grande Métallurgie."
                                            },
                                            {
                                                "example_id": "8cfce72d-6f49-454c-b5aa-6646f707170b",
                                                "sense_id": "7520cfe0-9a85-385f-ae2e-a1fd1df89c6e",
                                                "text": "Oui, mon petit… la presse indépendante… la presse d’idées… À peu près morte… dès sa naissance… C’est ce salaud de Girardin qui l’a zigouillée le jour où il a tué Armand Carrel…"
                                            },
                                            {
                                                "example_id": "8b008628-8905-4adb-8076-e2afeb4d8456",
                                                "sense_id": "7520cfe0-9a85-385f-ae2e-a1fd1df89c6e",
                                                "text": "N’est-il pas invraisemblable que le prince de Bismarck, qui manœuvrait sa presse comme un régiment, ait été étranger à cette campagne ?"
                                            },
                                            {
                                                "example_id": "020da8dd-f2a4-49a5-b63d-466660112e25",
                                                "sense_id": "7520cfe0-9a85-385f-ae2e-a1fd1df89c6e",
                                                "text": "Une immense joie s’empare de toute l’Italie, alimentée par les reportages dithyrambiques des journalistes embeded, comme on dirait aujourd’hui. La presse chante la victoire de la civilisation européenne sur l’obscurantisme des musulmans […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a49d11ba-f5bc-3563-9df1-c630e29fce97",
                                        "entry_id": "16edf4b7-6386-3e68-a8f6-7c53125caef1",
                                        "glosses": [
                                            "Foule, multitude de personnes qui se pressent les unes les autres dans un espace plus ou moins limité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77114ca8-60c0-4193-834f-243daa7bcaaa",
                                                "sense_id": "a49d11ba-f5bc-3563-9df1-c630e29fce97",
                                                "text": "Le roi a passé tous les jours gras à la Muette, et, le jeudi gras, il est venu au bal de l'Opéra. Il y avait tant de monde qu'il a été expressément (note: C'est-à-dire positivement, en termes exprès) pressé, sans pouvoir aller, ni venir. Toute sa compagnie était en bergers et bergères, et lui en chauve-souris. Cette presse l'a un peu dégoûté de ce bal."
                                            },
                                            {
                                                "example_id": "15b698c0-8814-410b-bcee-2bcb22c7b978",
                                                "sense_id": "a49d11ba-f5bc-3563-9df1-c630e29fce97",
                                                "text": "À la représentation du soir, la foule fut encore plus considérable que la veille, et peu s’en fallut que le portier ne restât étouffé dans la presse des spectateurs qui voulaient tous entrer en même temps à la comédie, craignant, bien qu’ils eussent payé, de n’y trouver place."
                                            },
                                            {
                                                "example_id": "ffb3f862-dc07-4b98-9292-8dc87473b17c",
                                                "sense_id": "a49d11ba-f5bc-3563-9df1-c630e29fce97",
                                                "text": "Tous ces gens, serrés les uns contre les autres […], se bousculaient […]. Si la presse devenait plus étouffante, des cris s’élevaient : « Ne poussez pas ! »"
                                            },
                                            {
                                                "example_id": "433fe89f-6f61-4dbe-8129-1ed72a16c846",
                                                "sense_id": "a49d11ba-f5bc-3563-9df1-c630e29fce97",
                                                "text": "L’aubergiste avait dressé ses tables dans la grange ; à l’entrée, il y avait presse."
                                            },
                                            {
                                                "example_id": "6ab8ba00-8351-4b49-9350-275ce973713c",
                                                "sense_id": "a49d11ba-f5bc-3563-9df1-c630e29fce97",
                                                "text": "C’est un des orchestres les plus appréciés du moment, aussi y a-t-il une grosse affluence – trop grosse même : la presse est telle qu’on transpire à grosses gouttes et qu’on entend mal l’orchestre au milieu du bruit des conversations, des danseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b8e6b24-b27e-3c7c-83ca-e81c1abfa40f",
                                        "entry_id": "16edf4b7-6386-3e68-a8f6-7c53125caef1",
                                        "glosses": [
                                            "Hâte, action de se hâter, fait d’être pressé, impatience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e7751d-2183-49b5-853e-6790c0f53256",
                                                "sense_id": "0b8e6b24-b27e-3c7c-83ca-e81c1abfa40f",
                                                "text": "Mais non, c’est un « tirant », il cherchera à profiter de la situation et de votre presse, il discutera sou à sou, vous n’en finirez pas."
                                            },
                                            {
                                                "example_id": "e642a142-f36a-4b00-86ca-f79f3665f432",
                                                "sense_id": "0b8e6b24-b27e-3c7c-83ca-e81c1abfa40f",
                                                "text": "Aux moments de presse, les patrons de bar savent ce que leur coûte le vol au rendez-moi, car s’ils refusent de s’exécuter, l’agent qu’on appelle donne forcement raison au voleur."
                                            },
                                            {
                                                "example_id": "93f66613-0cf2-4a52-8963-5543a53f7cbb",
                                                "sense_id": "0b8e6b24-b27e-3c7c-83ca-e81c1abfa40f",
                                                "text": "Elle admettait au temps de grande presse une femme de journée pour les lessives, plus abondantes à cette époque de l’année."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5417b633-4fd1-3442-aa29-58d26bc5d7e2",
                                        "entry_id": "16edf4b7-6386-3e68-a8f6-7c53125caef1",
                                        "glosses": [
                                            "Méthode d’enrôlement forcé dans les forces armées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a54a7fe-6051-4950-9a22-92ac3516eb8d",
                                                "sense_id": "5417b633-4fd1-3442-aa29-58d26bc5d7e2",
                                                "text": "Le résident supérieur du Tonkin organisa la presse, c’est-à-dire l’enrôlement forcé, à la fin de janvier 1916, quand on exigea de lui un contingent dans les trois jours ; la collaboration totale des hauts mandarins lui facilita grandement la tâche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "presse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd2f59bb-0ef6-325c-9b47-92919a798e80",
                                        "entry_id": "b85b8a4e-64d4-38ee-b6bd-60e19d8dfd03",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de presser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5f87b20-22ec-32a4-9fcc-315c680822fc",
                                        "entry_id": "b85b8a4e-64d4-38ee-b6bd-60e19d8dfd03",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de presser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e261a4-7d04-496c-b49f-244bc7127a08",
                                                "sense_id": "d5f87b20-22ec-32a4-9fcc-315c680822fc",
                                                "text": "Il y a l’égrappage, un léger foulage, puis on presse les grains et le jus est placé dans ces cuves en inox, qui sont thermorégulées."
                                            },
                                            {
                                                "example_id": "4dc9b114-7bb1-49bf-92ec-434aa319a156",
                                                "sense_id": "d5f87b20-22ec-32a4-9fcc-315c680822fc",
                                                "text": "Aujourd'hui, La Torche est devenue un spot de surf ultrafréquenté l’été, où une foule se presse sur la plage et dans les vagues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ea4650f-96a0-333a-b979-fdd1155b4a33",
                                        "entry_id": "b85b8a4e-64d4-38ee-b6bd-60e19d8dfd03",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de presser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47c2fa43-fe74-302b-87a1-1f51d884b6af",
                                        "entry_id": "b85b8a4e-64d4-38ee-b6bd-60e19d8dfd03",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de presser."
                                        ],
