                        "sense_id": "3dfb640f-5553-387c-9c0a-e6b5d9d3483d",
                        "entry_id": "ea10f073-adda-3c3f-b515-66eb64497a43",
                        "glosses": [
                            "To represent as being higher or greater than it is."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6591b195-4e4c-4ae5-8a25-184606f2120e",
                                "sense_id": "3dfb640f-5553-387c-9c0a-e6b5d9d3483d",
                                "text": "Ms. LeCrone was the only woman, probably overrepresenting the general percentage of female ballet choreographers, but perhaps the most experienced of the group."
                            },
                            {
                                "example_id": "8a3f008f-4054-4841-a4c9-34ffc1acb817",
                                "sense_id": "3dfb640f-5553-387c-9c0a-e6b5d9d3483d",
                                "text": "“The Senate is so tough for Democrats because the Senate so overrepresents these sparsely populated rural states,” says Alan Abramowitz, an Emory University political scientist who has extensively studied the relationship between presidential and congressional voting."
                            },
                            {
                                "example_id": "9fd86d31-a6a6-4dcf-90ba-dbcd8aef760d",
                                "sense_id": "3dfb640f-5553-387c-9c0a-e6b5d9d3483d",
                                "text": "Asian Americans are overrepresented in both elite universities like Harvard and also in community colleges."
                            },
                            {
                                "example_id": "fc90014f-3aa6-4548-b037-fae58d7228c2",
                                "sense_id": "3dfb640f-5553-387c-9c0a-e6b5d9d3483d",
                                "text": "Those with more formal education are more likely to take polls, and with an electorate newly divided by education in the Trump era, those polls that didn’t adjust for it tended to overrepresent those with college degrees who were less likely to back Donald Trump."
                            }
                        ]
                    }
