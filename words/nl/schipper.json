            "senses": [
                {
                    "sense_id": "a532c3f1-ba59-36ee-a34c-712910c2e997",
                    "sense_definition": "iemand die de leiding heeft over een schip",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>schipper</w> navigeerde het schip behendig door de smalle grachten.",
                            "target_lang_translations": {
                                "en": "The <w>skipper</w> navigated the ship skillfully through the narrow canals."
                            }
                        },
                        {
                            "text": "De ervaren <w>schipper</w> stuurde het schip veilig de haven binnen.",
                            "target_lang_translations": {
                                "en": "The experienced <w>captain</w> steered the ship safely into the harbor."
                            }
                        }
                    ],
                    "synonyms": [
                        "kapitein",
                        "gezagvoerder"
                    ],
                    "common_phrases": [
                        "ervaren schipper"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is in charge of a ship."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "skipper",
                                "target_lang_sense_clarification": "The person in command of a ship, especially a small one."
                            },
                            {
                                "target_lang_word": "captain",
                                "target_lang_sense_clarification": "The person lawfully in command of a ship or vessel."
                            }
                        ]
                    }
                },
                {
