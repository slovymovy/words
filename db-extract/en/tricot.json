                        ]
                    },
                    {
                        "translation_id": "7dc48231-158c-40e0-b6cf-683e764559d2",
                        "source_entry_id": "d16a16ab-1ca0-3947-af89-863aab90e9b3",
                        "source_sense_id": "53a1d502-dc6f-3a0d-b7c2-3af515d41171",
                        "source_sense_description": "soft knit fabric",
                        "target_lang_word": "Trikot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trikot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a33473e-0a71-3f81-a47b-c66cde6bca61",
                                        "entry_id": "318cbe1d-7ec3-3178-8f60-f49f75001b4a",
                                        "glosses": [
                                            "speziell gewirkter Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0935489-30c8-4a6f-a772-b4868ab5b93f",
                                                "sense_id": "7a33473e-0a71-3f81-a47b-c66cde6bca61",
                                                "text": "Bei der Kettenwirkware unterscheidet man sieben Grundbindungen, die nur aus dem Element Masche entstehen: Franse, Trikot, Tuch, Satin, Samt, Atlas und Köper."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Trikot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "340e6087-41a6-35ac-9ac6-8ba53a94f19d",
                                        "entry_id": "ee27ad3e-05ff-3edc-b27f-8dd583454fba",
                                        "glosses": [
                                            "meist farbiges Sporthemd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26bc3b57-9c21-458f-989c-2ef90af528a4",
                                                "sense_id": "340e6087-41a6-35ac-9ac6-8ba53a94f19d",
                                                "text": "„Gerd Müller hat die 13 berühmt gemacht. Riedle, Völler und Ballack hielten sie warm - nun schmückt sie das Trikot von Thomas Müller.“"
                                            },
                                            {
                                                "example_id": "fa1b0620-5430-4bbe-a733-9063dfe2d978",
                                                "sense_id": "340e6087-41a6-35ac-9ac6-8ba53a94f19d",
                                                "text": "„Das Trikot von damals, ein tief ausgeschnittener, eng sitzender Einteiler mit einem quer verlaufenden roten Balken auf der Brust, besaß er noch Jahrzehnte später.“"
                                            },
                                            {
                                                "example_id": "eed970f9-c5f9-488d-9748-628c1d64db5a",
                                                "sense_id": "340e6087-41a6-35ac-9ac6-8ba53a94f19d",
                                                "text": "„Mein blaues Trikot brauchst du nie zu waschen.“"
                                            },
                                            {
                                                "example_id": "309b9688-4468-4de1-8380-d5995c93a6d1",
                                                "sense_id": "340e6087-41a6-35ac-9ac6-8ba53a94f19d",
                                                "text": "„Sie trägt ein schwarzes Trikot und um das Haar ein festgeknotetes rotes Tuch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69bd6a9c-7607-4368-b26c-14fb1874bb01",
                        "source_entry_id": "d16a16ab-1ca0-3947-af89-863aab90e9b3",
                        "source_sense_id": "53a1d502-dc6f-3a0d-b7c2-3af515d41171",
                        "source_sense_description": "soft knit fabric",
                        "target_lang_word": "trykot",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trykot",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                        "entry_id": "15012542-c698-33ff-8a51-9e43b4a42f92",
                                        "glosses": [
                                            "tkanina z: wełny, bawełny, jedwabiu; dziana sposobem pończoszniczym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab31faac-f421-48fe-b5a8-0973963c9011",
                                                "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                                "text": "Najodpowiedniejszym materiałem na ubranie żeglarskie jest wełna (…) Na drugim miejscu należy postawić trykot bawełniany"
                                            },
                                            {
                                                "example_id": "ad1fed25-173a-40bf-9a94-a874f56f2118",
                                                "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                                "text": "Ciepła kurtka z jasnego trykotu"
                                            },
                                            {
                                                "example_id": "db8a8196-c371-4623-ac62-2023e2ce5325",
                                                "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                                "text": "Długą wąską spódnicę z trykotu lub dzianiny nosimy z obszernym kardiganem albo z dwoma"
                                            },
                                            {
                                                "example_id": "33e1490e-fd3d-419d-bc09-c48ccd9cb72d",
                                                "sense_id": "9a29c7e7-ec94-3b14-8a18-e6c12fd36e58",
                                                "text": "Po 1811 roku pojawiły się podwiązki wyrabiane z trykotu o specjalnym ściągaczowym ściegu, a w połowie XIX wieku zaczęto do ich wyrobu używać taśmy gumowej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                        "entry_id": "15012542-c698-33ff-8a51-9e43b4a42f92",
                                        "glosses": [
                                            "odzież z takiej tkaniny trykotu (1.1); zwłaszcza: obcisły, dziany kostium gimnastyczny, kąpielowy, sportowy, baletowy, itp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309d789c-e46a-4333-bff1-61efc1633958",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Mijają go pierwsi przebierańcy: zgarbiona kobieta w czarnym spiczastym kapeluszu o szerokim rondzie, zamiatająca chodnik peleryną, mężczyzna-motyl w sinych trykotach"
                                            },
                                            {
                                                "example_id": "35bab2eb-b737-492a-affc-a8eaddc0e4d3",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Zblazowany salonowymi perwersjami, do których wkładał specjalne czarne trykoty, i wściekłą pracą (był niezrównanym chemikiem i dyletantem w mechanice i matematyce), książę oddawał się zupełnemu wypoczynkowi i wszelkim wiejskim rozrywkom"
                                            },
                                            {
                                                "example_id": "b16aa425-d60f-487b-8e9d-efde18abf8e7",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Dziewczyny w gimnastycznych trykotach przerzucały z rąk do rąk piłkę, która wzbijała się wysoko ponad sztandary"
                                            },
                                            {
                                                "example_id": "2058a3d8-2a9d-41f3-81ab-54c224987226",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "W kąpieli panowie nosili cienkie trykoty sięgające od obojczyka do połowy uda"
                                            },
                                            {
                                                "example_id": "117ffc8a-83a5-47f1-a32b-64fbc8d28c0e",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Rick wchodził na scenę w pięknym trykocie czarnym, z wyhaftowaną na piersiach złotą żmiją"
                                            },
                                            {
                                                "example_id": "93a30cbb-12cf-4737-acde-4c7b4f4345cc",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Duch babki szepce do mnie, że ona nie nosiłaby tego, co ja, te dzianiny, trykoty opinające ciało, to dobre na ciepłe majtki, ale na wierzch"
                                            },
                                            {
                                                "example_id": "e94a8844-a254-4727-94c0-d2c9a69f8cb4",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Przychodziliśmy w trykotach, dziewczęta nie umalowane, niczego nie dało się ukryć"
                                            },
                                            {
                                                "example_id": "8e25436b-e30c-403b-86e6-110a3991a79d",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Niestety, już nigdy nie założy zapaśniczego trykotu"
                                            },
                                            {
                                                "example_id": "b427a08a-36c8-4ba5-b2e6-1bbb902bffa9",
                                                "sense_id": "b6a65f9b-1bf6-3182-b3fd-1783a460e2ef",
                                                "text": "Rożne białe, i w kolorach Wstążki, Kornety, kwiatki, Chustki Gazowe i Jedwabne, Fartuszki Gazowe i jedwabne, Rękawiczki, Pończochy Męskie i Damskie jedwabne, Trykoty na kamizelki i Sultany jedwabne i bawełniane"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d77e7ed5-4722-4cb9-a1be-03f00492879c",
                        "source_entry_id": "d16a16ab-1ca0-3947-af89-863aab90e9b3",
                        "source_sense_id": "53a1d502-dc6f-3a0d-b7c2-3af515d41171",
                        "source_sense_description": "soft knit fabric",
                        "target_lang_word": "трико́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "трико́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a248d962-8f2d-3801-8f43-94eae845d867",
                                        "entry_id": "b942f7df-047e-344f-899d-9da06344e497",
                                        "glosses": [
                                            "текст. шерстяная или полушерстяная трикотажная ткань узорчатого плетения для верхней одежды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7865a394-ecc6-4877-bbd0-e24e081d88c0",
                                                "sense_id": "a248d962-8f2d-3801-8f43-94eae845d867",
                                                "text": "Кому материи разные, коли женатый; а коли холостой ― сукна, трико; у кого лошади ― тому овса или сена, а то так и деньгами."
                                            },
                                            {
                                                "example_id": "328a8c03-7284-4269-8c91-5abdf2606854",
                                                "sense_id": "a248d962-8f2d-3801-8f43-94eae845d867",
                                                "text": "Елизавета Николаевна показала на свой худой бурнусишко, сшитый из легонького летнего трико, а на дворе между тем было сыро и холодно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a77218-70de-3fcf-a76c-ebae8bc4afe1",
                                        "entry_id": "b942f7df-047e-344f-899d-9da06344e497",
                                        "glosses": [
                                            "одежда и нижнее бельё из такой ткани, плотно облегающие тело"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6062a943-e8c0-4f01-aa77-3f6be09eb5a2",
                                                "sense_id": "20a77218-70de-3fcf-a76c-ebae8bc4afe1",
                                                "text": "Она не выдавалась ни силой, ни красотой, худая, бледная, истомленная, одетая в трико с блестящим шитьём."
                                            },
                                            {
                                                "example_id": "1411ada4-7c52-4797-a814-65d6d08358b5",
                                                "sense_id": "20a77218-70de-3fcf-a76c-ebae8bc4afe1",
                                                "text": "И, думая так, Нина Осиповна хлопала в ладоши, наскоро надевала розовое трико и газ и снова начинала свои дурацкие прыжки и экивоки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
