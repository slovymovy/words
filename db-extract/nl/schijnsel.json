                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9c8266-9a56-40f4-9e7b-1dfe03e63cbd",
                                "sense_id": "7f15549b-5f72-3b94-8325-2da7c6956a5f",
                                "text": "Bij het schijnsel van een paar kaarsen nuttigden wij een intieme maaltijd."
                            },
                            {
                                "example_id": "959bb316-ba64-417a-acc8-27e83ff3bedf",
                                "sense_id": "7f15549b-5f72-3b94-8325-2da7c6956a5f",
                                "text": "Dit alles schonk hem een moeilijk uit te leggen innerlijke vrede, ook wanneer hij zich 's ochtends voor de gebarsten spiegel schoor in het schijnsel van de petroleumlamp of in zijn wolfshuid de veranda op stapte en diep door zijn neus inademde."
                            }
                        ]
                    }
