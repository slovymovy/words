                "senses": [
                    {
                        "sense_id": "6a371f1a-f521-3ad4-9117-68c8a7ee2b24",
                        "entry_id": "f56d4bd2-b881-32db-93f7-fb47d80d5539",
                        "glosses": [
                            "Resembling or covered in lather."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2bc3d1c-b762-4ddb-be2c-3da47a109d75",
                                "sense_id": "6a371f1a-f521-3ad4-9117-68c8a7ee2b24",
                                "text": "This new shaving cream isn't as lathery as the old stuff: there just aren't as many bubbles to be had."
                            },
                            {
                                "example_id": "7c3de362-3b09-4aab-891b-18ae6d804727",
                                "sense_id": "6a371f1a-f521-3ad4-9117-68c8a7ee2b24",
                                "text": "1824, James Atkinson, “Peer Mahommud; The Moralist,” stanza 51, in The City of Palaces, Calcutta: Government Gazette Press, p. 128,\nThus rapidly my little tale advances,\nAnd now we come to him, who lives to shave!\nThe lathery Knight of Razors, not of lances,\nAnd without question more a fool than knave."
                            },
                            {
                                "example_id": "725418e0-fcb6-4a97-bda6-dccb1a27f6e5",
                                "sense_id": "6a371f1a-f521-3ad4-9117-68c8a7ee2b24",
                                "text": "“Oh, no!” said Bobbie, greatly shocked; “you don’t rub muslin. You put the boiled soap in the hot water and make it all frothy-lathery—and then you shake the muslin and squeeze it, ever so gently, and all the dirt comes out. […]”"
                            },
                            {
                                "example_id": "e5ef40d9-7288-42be-bf32-1b296dd7b337",
                                "sense_id": "6a371f1a-f521-3ad4-9117-68c8a7ee2b24",
                                "text": "They wash their clothes in running streams with lathery weeds—too poor to buy soap."
                            },
                            {
                                "example_id": "f6a5e597-d131-4d51-93c7-36b7a445be5a",
                                "sense_id": "6a371f1a-f521-3ad4-9117-68c8a7ee2b24",
                                "text": "He cleaned up the basin and flushed the lathery, hairy bits of toilet paper down the water closet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
