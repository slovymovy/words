                "senses": [
                    {
                        "sense_id": "d4f8a9d2-b8c1-382a-b7fa-836d9095124e",
                        "entry_id": "bdf64765-f099-3178-adea-a8c90640b19e",
                        "glosses": [
                            "Relatif au singe ; simiesque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36cadf30-bd25-4f3f-9fdc-b3b53676c42a",
                                "sense_id": "d4f8a9d2-b8c1-382a-b7fa-836d9095124e",
                                "text": "A partir des années vingt, en effet, un petit hominidé fossile - l’Australopithèque - avait été mis au jour en Afrique du sud d'abord, en Afrique orientale ensuite, qui va rapidement reposer le problème du chaînon manquant entre les formes simiennes et les formes humaines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9760cd5-8020-482d-9456-e586bc3c5603",
                        "source_entry_id": "bdf64765-f099-3178-adea-a8c90640b19e",
                        "source_sense_id": "d4f8a9d2-b8c1-382a-b7fa-836d9095124e",
                        "target_lang_word": "simian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10b6b7dd-5fec-3b3d-99a6-70a4a3203290",
                                        "entry_id": "09d5cffc-684c-36ab-ac95-f24bc47d8387",
                                        "glosses": [
                                            "Of or pertaining to apes and monkeys."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "173a2db3-0802-31e5-aa01-396445054d71",
                                        "entry_id": "09d5cffc-684c-36ab-ac95-f24bc47d8387",
                                        "glosses": [
                                            "Bearing resemblance to an ape or monkey; apelike or monkeylike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc8ea7b-d7cd-45ec-acca-b6bd7e0e02b5",
                                                "sense_id": "173a2db3-0802-31e5-aa01-396445054d71",
                                                "text": "In “Benguelê” (which refers to slaves’ nostalgic longing for Africa) he makes extensive use of crouching, stooped bodies in a simian, loping walk, arms hanging loosely and head down to suggest tribal dances, rituals, animals, a precivilization."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "simian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db7e16e7-801e-32f6-b97b-28056ea9aba9",
                                        "entry_id": "c335feff-3eed-3257-850e-2f4641adf67c",
                                        "glosses": [
                                            "An ape or monkey, especially an anthropoid (infraorder Simiiformes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2845d4c4-b852-4858-bf78-a8dc5607ed2f",
                                                "sense_id": "db7e16e7-801e-32f6-b97b-28056ea9aba9",
                                                "text": "The simians would require no special orientation courses to teach them the reasons for fighting, such as, “To make the world safe for Demagocracy,” or whatnot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
