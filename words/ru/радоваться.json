                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети искренне умеют <w>радоваться</w> жизни и замечать приятные мелочи каждый день.",
                            "target_lang_translations": {
                                "en": "Children sincerely know how to <w>enjoy</w> life and notice pleasant little things every day."
                            }
                        },
                        {
                            "text": "Я всегда буду <w>радоваться</w> за тебя и твои новые успехи в работе.",
                            "target_lang_translations": {
                                "en": "I will always <w>be happy</w> for you and your new successes at work."
                            }
                        }
                    ],
                    "synonyms": [
                        "ликовать",
                        "торжествовать"
                    ],
                    "antonyms": [
