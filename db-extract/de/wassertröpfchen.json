                                "example_id": "45b60e08-9eb2-4f99-9c14-cfba2970f563",
                                "sense_id": "ba571c1e-fa0e-3c28-ab6f-07c4f1ca308b",
                                "text": "„Auf dem Gras schimmerten Wassertröpfchen und der dunstige Horizont kündete von dem heraufziehenden Nebel.“"
                            },
                            {
                                "example_id": "14b93828-a4cd-4f41-bd28-c20837e0833e",
                                "sense_id": "ba571c1e-fa0e-3c28-ab6f-07c4f1ca308b",
                                "text": "„Wassertröpfchen glitzerten an den Wänden, während ich den Windungen der Treppe ins Innere der Erde folgte.“"
                            }
                        ],
