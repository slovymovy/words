                "senses": [
                    {
                        "sense_id": "54790548-69a6-31bc-9c8d-8e13472b2c4f",
                        "entry_id": "816fe568-0d27-3d26-a863-99c4c787ed7e",
                        "glosses": [
                            "(schriftlicher) Hinweis auf das Vorkommen von Schlüsselreizen, die beängstigend, traumatisierend oder verstörend wirken können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d223991-0694-4803-9c15-a0623e9da8ed",
                                "sense_id": "54790548-69a6-31bc-9c8d-8e13472b2c4f",
                                "text": "„Erstaunlich, wie gesagt, in Zeiten, in denen Jusprofessoren überlegen, ob sie den Studierenden den Begriff ‚Gesetzesverletzung‘ ohne Triggerwarnung zumuten dürfen.“"
                            },
                            {
                                "example_id": "d857cf3c-d394-478b-995b-b4bf72adaf54",
                                "sense_id": "54790548-69a6-31bc-9c8d-8e13472b2c4f",
                                "text": "„Redaktion so: Damit der Jugendschutz nicht auf dumme Gedanken kommt und die ganze Kiste noch weiter beanstandet, schreiben wir die Triggerwarnung gleich in den Folgennamen rein.“"
                            },
                            {
                                "example_id": "10cb8470-5e67-4722-bb14-555075f8ac0a",
                                "sense_id": "54790548-69a6-31bc-9c8d-8e13472b2c4f",
                                "text": "„Klar muss man immer abwägen, wo kann man Rücksicht auf eigene Traumatisierungen erwarten, die die Menschen, die eine Triggerwarnung erwarten zweifellos erlebt haben, und wo muss man lernen, sich der Realität schonungslos zu stellen.“"
                            },
                            {
                                "example_id": "c5a1b0b4-4e83-4187-9eba-eb32498bc3c8",
                                "sense_id": "54790548-69a6-31bc-9c8d-8e13472b2c4f",
                                "text": "„Timur ist sich der Verantwortung seiner Reichweite bewusst, er markiert seine Posts mit Triggerwarnungen.“"
                            },
                            {
                                "example_id": "28dc987b-9e25-4a0f-997b-c5550f46141e",
                                "sense_id": "54790548-69a6-31bc-9c8d-8e13472b2c4f",
                                "text": "„Kolek spricht eine Triggerwarnung aus, da er Situationen beschreibt, die starke Gefühlsreaktionen auslösen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55544d2f-b192-46b9-ba08-6ee1ac5f4e95",
                        "source_entry_id": "816fe568-0d27-3d26-a863-99c4c787ed7e",
                        "source_sense_id": "54790548-69a6-31bc-9c8d-8e13472b2c4f",
                        "source_sense_description": "Hinweis auf das Vorkommen von Schlüsselreizen, die beängstigend, traumatisierend oder verstörend wirken können",
                        "target_lang_word": "trigger warning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trigger warning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "112684e7-32a0-3cb5-97ab-4d911dd43c28",
                                        "entry_id": "a08985b9-ecc8-3c1c-aaac-ded162b88cf1",
                                        "glosses": [
                                            "A notice placed before the beginning of media content (usually an online article, e-mail, or post) to warn of potential traumatic triggers it contains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011508c5-c5c3-4de2-a081-ae35c8df9fe2",
                                                "sense_id": "112684e7-32a0-3cb5-97ab-4d911dd43c28",
                                                "text": "One film presentation group for Teeth, which features rape scenes, also chose to include “trigger warnings” and bring in a representative from a sexual assault centre as a resource for the class."
                                            },
                                            {
                                                "example_id": "a29ebe42-fdbd-49cf-91a0-969d11c443f6",
                                                "sense_id": "112684e7-32a0-3cb5-97ab-4d911dd43c28",
                                                "text": "I applaud the sensitivity and awareness demonstrated by those who take the time to put a trigger warning, for example, on a link posted on Facebook dealing with issues such as sexual abuse or violence."
                                            },
                                            {
                                                "example_id": "1b77cea5-716c-4047-9900-8d6aa301dc59",
                                                "sense_id": "112684e7-32a0-3cb5-97ab-4d911dd43c28",
                                                "text": "In its policies about posting, it asks users to include “trigger warnings” about content that “involves sexual assault or violence towards women and other marginalized groups, which may distress or cause readers to be triggered.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
