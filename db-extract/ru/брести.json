                    {
                        "translation_id": "1d43aca3-0b48-4231-9eaa-916a06864697",
                        "source_entry_id": "f8de1ee9-9498-3227-974e-00c22f2fe91f",
                        "source_sense_id": "40991dbf-510f-3777-a2fe-89231e815b42",
                        "target_lang_word": "schlendern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlendern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab38e991-ec96-3142-9370-bf0d14bb98c1",
                                        "entry_id": "1190f2a4-2562-3994-b955-8f0fcdb456ee",
                                        "glosses": [
                                            "ohne bestimmtes Ziel locker und langsam umhergehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c505820c-714d-4ae7-9524-e670b431487b",
                                                "sense_id": "ab38e991-ec96-3142-9370-bf0d14bb98c1",
                                                "text": "Ich schlenderte durch den Park, bis es Abend wurde."
                                            },
                                            {
                                                "example_id": "75da45af-6053-4ead-a466-2ec6305f4a94",
                                                "sense_id": "ab38e991-ec96-3142-9370-bf0d14bb98c1",
                                                "text": "„Bald werden wir im Sonnenschein durch Fußgängerzonen schlendern und in den Schaufenstern nach Sonderangeboten suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
