                    {
                        "translation_id": "bae57899-ea34-492e-bca2-4927a3bc3ac5",
                        "source_entry_id": "31f799f9-5ca7-37dc-91d9-1cd85adc1ee0",
                        "source_sense_id": "fd8087f2-fe7d-34a6-8a9b-8c2fd9a11d23",
                        "target_lang_word": "unermüdlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unermüdlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05bb1f3f-4612-39d4-a4c5-cca2ea29a5fb",
                                        "entry_id": "5e004105-ff57-30b4-a0ff-c37052d0a03d",
                                        "glosses": [
                                            "mit viel Geduld und Ausdauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "823bc0c4-1397-41d3-a39d-39b2e4c3913b",
                                                "sense_id": "05bb1f3f-4612-39d4-a4c5-cca2ea29a5fb",
                                                "text": "Er arbeitete unermüdlich an seiner Diplomarbeit."
                                            },
                                            {
                                                "example_id": "f6297aad-bd6c-427e-bee0-bf33eba90cd6",
                                                "sense_id": "05bb1f3f-4612-39d4-a4c5-cca2ea29a5fb",
                                                "text": "„Er avancierte zum bedeutendsten Indologen Deutschlands und brachte die Indologie durch seine unermüdlichen Forschungen in vielen Feldern voran.“"
                                            },
                                            {
                                                "example_id": "fbb6dba4-f469-4c75-b019-9e2ea0ecbf93",
                                                "sense_id": "05bb1f3f-4612-39d4-a4c5-cca2ea29a5fb",
                                                "text": "„Meine Freunde machen sich schon seit langem darüber lustig, daß keines meiner Bücher ohne ein Vorwort erscheint. Ja, ich hab auch schon Bücher mit zwei oder drei Vorworten zustande gebracht! In dieser Hinsicht bin ich unermüdlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88c54004-eb32-49d7-9988-88a6227b2356",
                        "source_entry_id": "31f799f9-5ca7-37dc-91d9-1cd85adc1ee0",
                        "source_sense_id": "fd8087f2-fe7d-34a6-8a9b-8c2fd9a11d23",
                        "target_lang_word": "beständig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beständig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd88ba7-ea14-3964-bbfa-ca3a11913543",
                                        "entry_id": "bf1f3727-bda9-37be-84f8-8bb65b09d238",
                                        "glosses": [
                                            "anhaltend, gleichbleibend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0336a60-a25d-404b-9805-3660ac29c620",
                                                "sense_id": "bdd88ba7-ea14-3964-bbfa-ca3a11913543",
                                                "text": "Er ist uns ein beständig zuverlässiger Freund."
                                            },
                                            {
                                                "example_id": "379b6eab-d1dc-4f6c-b61e-2462e99a6ead",
                                                "sense_id": "bdd88ba7-ea14-3964-bbfa-ca3a11913543",
                                                "text": "Das beständige Wetter erlaubt es, den geplanten Ausflug zu unternehmen."
                                            },
                                            {
                                                "example_id": "5af03566-6595-435c-bee3-c8846e6d9af6",
                                                "sense_id": "bdd88ba7-ea14-3964-bbfa-ca3a11913543",
                                                "text": "„Ein nahezu flächendeckender Zusammenbruch der Industrie, massenhafte Arbeitslosigkeit und beständige Abwanderung erschütterten in den neunziger Jahren die ostdeutschen Bundesländer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
