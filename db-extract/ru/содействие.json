                    {
                        "sense_id": "2c0658db-6e7d-3588-96c4-9530be311c15",
                        "entry_id": "0e02d5e7-9812-3df6-9dbc-6a0888f250a6",
                        "glosses": [
                            "устар. совместное действие; соучастие"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6841d4e8-dd2d-315f-ad72-7485bd717a9b",
                        "entry_id": "0e02d5e7-9812-3df6-9dbc-6a0888f250a6",
                        "glosses": [
                            "помощь, поддержка в чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e477eb3-b50d-474f-ad64-fca291769150",
                                "sense_id": "6841d4e8-dd2d-315f-ad72-7485bd717a9b",
                                "text": "Французский король обещал свое содействие английскому в великом деле утверждения самодержавия и уничтожения неприкосновенной святыни народной: палладиума его могущества ― конституционной хартии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c490970-b417-44af-969a-d655b06d90eb",
                        "source_entry_id": "0e02d5e7-9812-3df6-9dbc-6a0888f250a6",
                        "target_lang_word": "assistance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assistance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad8f49a-68f5-3a89-98cf-f38172e93fe1",
                                        "entry_id": "aa37e875-6dc3-382b-92e7-f31f4daf197a",
                                        "glosses": [
                                            "Aid; help; the act or result of assisting."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bed3c84-bf70-48fe-97a4-0e893f3b75f1",
                                                "sense_id": "5ad8f49a-68f5-3a89-98cf-f38172e93fe1",
                                                "text": "The volunteers offered assistance to the flood victims."
                                            },
                                            {
                                                "example_id": "e5662a0d-b931-40fe-a2fa-bafd82de9b96",
                                                "sense_id": "5ad8f49a-68f5-3a89-98cf-f38172e93fe1",
                                                "text": "He asked for technical assistance with the computer."
                                            },
                                            {
                                                "example_id": "d03add16-c161-42bc-8300-34909c032a0a",
                                                "sense_id": "5ad8f49a-68f5-3a89-98cf-f38172e93fe1",
                                                "text": "Financial assistance is available for low-income families."
                                            },
                                            {
                                                "example_id": "cdb43fb0-505c-4be8-aee7-98bac3759ebf",
                                                "sense_id": "5ad8f49a-68f5-3a89-98cf-f38172e93fe1",
                                                "text": "She could not have finished the project without his assistance."
                                            },
                                            {
                                                "example_id": "ecdd8744-a84e-4915-be32-377b42e78e4b",
                                                "sense_id": "5ad8f49a-68f5-3a89-98cf-f38172e93fe1",
                                                "text": "The program provides legal assistance to immigrants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8055618-e0eb-44a2-9759-181f2d1edbc2",
                        "source_entry_id": "0e02d5e7-9812-3df6-9dbc-6a0888f250a6",
                        "target_lang_word": "aid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e5a1c9a-5aaa-36f4-9342-b5d310fcd9f0",
                                        "entry_id": "c02a8ef8-342a-360e-ae05-d7a7928de823",
                                        "glosses": [
                                            "Help; assistance; succor, relief."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b2d450-856b-40ba-b072-49b2f21f626f",
                                                "sense_id": "0e5a1c9a-5aaa-36f4-9342-b5d310fcd9f0",
                                                "text": "He came to my aid when I was foundering."
                                            },
                                            {
                                                "example_id": "976d6ee8-c0b7-47e3-9b76-dcada007482a",
                                                "sense_id": "0e5a1c9a-5aaa-36f4-9342-b5d310fcd9f0",
                                                "text": "An unconstitutional method of obtaining aid."
                                            },
                                            {
                                                "example_id": "0bc51c6f-4d67-48f5-b949-d3377d03b142",
                                                "sense_id": "0e5a1c9a-5aaa-36f4-9342-b5d310fcd9f0",
                                                "text": "“[…] it is not fair of you to bring against mankind double weapons ! Dangerous enough you are as woman alone, without bringing to your aid those gifts of mind suited to problems which men have been accustomed to arrogate to themselves.”"
                                            },
                                            {
                                                "example_id": "f58fee94-88d8-407d-8167-2d2b3fb76729",
                                                "sense_id": "0e5a1c9a-5aaa-36f4-9342-b5d310fcd9f0",
                                                "text": "Musk said he checked with Trump “a few times” and Trump confirmed he wants to shut down the agency, which dispenses billions in humanitarian aid and development funding annually."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "191d8c98-71bc-3ce2-8365-8f2c72154333",
                                        "entry_id": "c02a8ef8-342a-360e-ae05-d7a7928de823",
                                        "glosses": [
                                            "A helper; an assistant."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5bad5a-cbc6-4c5b-8b0f-7ae56b697fbe",
                                                "sense_id": "191d8c98-71bc-3ce2-8365-8f2c72154333",
                                                "text": "It is not good that man should bee alone, let vs make vnto him an aide like to himselfe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a217792-3cdb-3618-aae5-1c78ac34a3b7",
                                        "entry_id": "c02a8ef8-342a-360e-ae05-d7a7928de823",
                                        "glosses": [
                                            "Something which helps; a material source of help."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893b11b4-ecc1-42e1-90c4-a7c535a71b03",
                                                "sense_id": "5a217792-3cdb-3618-aae5-1c78ac34a3b7",
                                                "text": "Slimming aids include dietary supplements and appetite suppressants."
                                            },
                                            {
                                                "example_id": "11e2e3c0-bf1b-4811-bebe-e011859b7959",
                                                "sense_id": "5a217792-3cdb-3618-aae5-1c78ac34a3b7",
                                                "text": "The human is so poorly designed for aquatic adventures that he cannot even see in the water without artificial aids."
                                            },
                                            {
                                                "example_id": "29bb07f6-605f-481d-8265-14eb5890f124",
                                                "sense_id": "5a217792-3cdb-3618-aae5-1c78ac34a3b7",
                                                "text": "The ability of a segment of a glass sphere to magnify whatever is placed before it was known around the year 1000, when the spherical segment was called a reading stone[…]. Scribes, illuminators, and scholars held such stones directly over manuscript pages as an aid in seeing what was being written, drawn, or read."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "020b9f8c-40dd-3348-95b8-721ab2324e3b",
                                        "entry_id": "c02a8ef8-342a-360e-ae05-d7a7928de823",
                                        "glosses": [
                                            "An historical subsidy granted to the crown by Parliament for an extraordinary purpose, such as a war effort."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d9ea70-a969-48af-8128-9842a043a284",
                                                "sense_id": "020b9f8c-40dd-3348-95b8-721ab2324e3b",
                                                "text": "In this parliament was granted to the king for defence against the Scots two aids and two quindecims, the which two aids did not extend over two quindecims."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c92ae1a6-3402-3230-bbb9-7080408b5e80",
                                        "entry_id": "c02a8ef8-342a-360e-ae05-d7a7928de823",
                                        "glosses": [
                                            "An exchequer loan."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f034701-c367-3699-8e69-e8e59fade6dc",
                                        "entry_id": "c02a8ef8-342a-360e-ae05-d7a7928de823",
                                        "glosses": [
                                            "A pecuniary tribute paid by a vassal to his feudal lord on special occasions."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bad3ce9-7a7b-3de7-9eb8-dbe5c7013585",
                                        "entry_id": "c02a8ef8-342a-360e-ae05-d7a7928de823",
                                        "glosses": [
                                            "Alternative form of aide (“an aide-de-camp”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba83214-af61-470d-980b-e147e2a9a80d",
                                                "sense_id": "6bad3ce9-7a7b-3de7-9eb8-dbe5c7013585",
                                                "text": "Suddenly, the general's aid entered the room and walked in a straight line, coming to a halt in front of the desk, standing at attention, waiting for the general to recognize him, allowing the aid to speak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fed27687-2e2e-315b-aab3-e37a7325714a",
