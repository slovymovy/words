                    }
                },
                {
                    "sense_id": "66f5a76b-d320-39ff-88d1-097972d799f1",
                    "sense_definition": "A province in northeastern Bulgaria.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The agricultural output of <w>Ruse</w> province contributes significantly to the regional economy.",
                            "target_lang_translations": {
                                "ru": "Сельскохозяйственная продукция области <w>Русе</w> вносит значительный вклад в региональную экономику."
                            }
                        },
                        {
                            "text": "Several protected natural areas are located within the borders of <w>Ruse</w>.",
                            "target_lang_translations": {
                                "ru": "В границах области <w>Русе</w> расположено несколько охраняемых природных территорий."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Область на северо-востоке Болгарии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Русе",
                                "target_lang_sense_clarification": "Русенская область Болгарии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c3c645a-833e-3652-9cc1-8b0f9669fbaa",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history museum features an exhibition dedicated to the pioneering work of James <w>Ruse</w>.",
                            "target_lang_translations": {
                                "ru": "В местном историческом музее представлена экспозиция, посвященная новаторской работе Джеймса <w>Рьюза</w>."
                            }
                        },
                        {
                            "text": "She did extensive genealogical research to trace her ancestors who carried the surname <w>Ruse</w>.",
                            "target_lang_translations": {
                                "ru": "Она провела обширное генеалогическое исследование, чтобы выявить своих предков, носивших фамилию <w>Русе</w>."
                            }
                        }
                    ],
                    "traits": [
