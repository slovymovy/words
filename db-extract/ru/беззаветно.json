                        "source_sense_id": "b39ab381-6296-3bce-9c6f-7faa01baf732",
                        "target_lang_word": "hingebungsvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hingebungsvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f485a16-b1d1-32ad-8ba7-eada84197252",
                                        "entry_id": "7c898424-ef76-3f7b-9aab-4603a1c6029d",
                                        "glosses": [
                                            "großen persönlichen Einsatz zeigend; voller Leidenschaft und Bereitschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f42ba6-96a6-498a-9ff9-c3f2a2f2b080",
                                                "sense_id": "1f485a16-b1d1-32ad-8ba7-eada84197252",
                                                "text": "„Durch die hingebungsvolle Interpretation des Songs ‚When a Man Loves a Woman‘ wurde er weltberühmt.“"
                                            },
                                            {
                                                "example_id": "e0ed1db9-deaa-43e5-a075-02d8866699a4",
                                                "sense_id": "1f485a16-b1d1-32ad-8ba7-eada84197252",
                                                "text": "„Der Titel, den der Maler selbst seinem Werk gegeben hat, war ein genialer Einfall und beschreibt die Stimmung der gestellten Szene scheinbar ebenso genau wie die hingebungsvolle Feinmalerei die Texturen der zerknitterten Landarbeitskleidung.“"
                                            },
                                            {
                                                "example_id": "0306dc28-d335-485d-b4a3-7dd496572727",
                                                "sense_id": "1f485a16-b1d1-32ad-8ba7-eada84197252",
                                                "text": "„Die Spanier sind noch hingebungsvollere Häuslebauer als die Schwaben und haben über Jahrzehnte erst jede Pesete und dann jeden Euro in Grund und Boden, Wohnungen, Häuser und Strandvillen gesteckt.“"
                                            },
                                            {
                                                "example_id": "8328ec1e-a9d9-4818-b1c3-5823fa1342f9",
                                                "sense_id": "1f485a16-b1d1-32ad-8ba7-eada84197252",
                                                "text": "„Sie sollen überhaupt fleißig lernen und ihre Pflicht erfüllen, denn das könnten ihnen selbst die hingebungsvollsten Lehrer, die fürsorglichsten Eltern und die besten Schulen der Welt nicht abnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
