{
    "word_family": [
        "smudge",
        "smudginess"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4043cce3-279a-3629-b79f-c3b3976f84e0",
                    "sense_definition": "Marked, smeared, or blurred with dirty marks or spots.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smeared",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child handed over a paper covered in <w>smudgy</w> fingerprints.",
                            "target_lang_translations": {
                                "de": "Das Kind übergab ein Blatt Papier, das mit <w>verschmierten</w> Fingerabdrücken übersät war."
                            }
                        },
                        {
                            "text": "I can hardly read this note because the pencil writing is too <w>smudgy</w>.",
                            "target_lang_translations": {
                                "de": "Ich kann diese Notiz kaum lesen, weil die Bleistiftschrift zu sehr <w>verwischt</w> ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "blurry",
                        "smeared",
                        "streaky"
                    ],
                    "antonyms": [
                        "clean",
                        "crisp",
                        "sharp"
                    ],
                    "common_phrases": [
                        "smudgy fingerprints",
                        "smudgy handwriting"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit schmutzigen Flecken, Streifen oder Schlieren versehen; verschmiert oder unleserlich verwischt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschmiert",
                                "target_lang_sense_clarification": "mit Flecken oder Schlieren bedeckt"
                            },
                            {
                                "target_lang_word": "verwischt",
                                "target_lang_sense_clarification": "unscharf oder undeutlich geworden"
                            },
                            {
                                "target_lang_word": "fleckig",
                                "target_lang_sense_clarification": "mit vielen Flecken versehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9a90b5d-2fb3-3051-b74f-14405c676342",
                    "sense_definition": "Thick, dark, and full of smoke.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old factory chimney belched a <w>smudgy</w> cloud across the morning sky.",
                            "target_lang_translations": {
                                "de": "Der alte Fabrikschornstein stieß eine <w>rußige</w> Wolke in den Morgenhimmel aus."
                            }
                        },
                        {
                            "text": "A <w>smudgy</w> fog drifted into the street, making it difficult to breathe.",
                            "target_lang_translations": {
                                "de": "Ein <w>qualmiger</w> Nebel zog in die Straße und machte das Atmen schwer."
                            }
                        }
                    ],
                    "synonyms": [
                        "smoky",
                        "sooty"
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "smudgy fog",
                        "smudgy smoke"
                    ],
                    "target_lang_definitions": {
                        "de": "Dick, dunkel und voller Rauch oder Ruß."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rauchig",
                                "target_lang_sense_clarification": "voller Rauch"
                            },
                            {
                                "target_lang_word": "rußig",
                                "target_lang_sense_clarification": "voller Ruß oder dunklem Qualm"
                            },
                            {
                                "target_lang_word": "qualmig",
                                "target_lang_sense_clarification": "dicht und voller Qualm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ba7e22c-3b3e-37ce-8911-381d4b263c45",
                    "sense_definition": "Overcast with light rain or drizzle; dreary and misty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to stay inside because it was such a <w>smudgy</w> day.",
                            "target_lang_translations": {
                                "de": "Wir beschlossen drinnen zu bleiben, weil es so ein <w>trüber</w> Tag war."
                            }
                        },
                        {
                            "text": "A light drizzle fell continuously through the grey, <w>smudgy</w> afternoon.",
                            "target_lang_translations": {
                                "de": "Ein leichter Nieselregen fiel ununterbrochen an diesem grauen, <w>diesigen</w> Nachmittag."
                            }
                        }
                    ],
                    "synonyms": [
                        "drizzly",
                        "misty"
                    ],
                    "antonyms": [
                        "sunny"
                    ],
                    "common_phrases": [
                        "smudgy day",
                        "smudgy weather"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used regionally to describe weather."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Trüb, neblig und von leichtem Nieselregen geprägt; ungemütlich grau."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "diesig",
                                "target_lang_sense_clarification": "neblig und sichtbehindert"
                            },
                            {
                                "target_lang_word": "trüb",
                                "target_lang_sense_clarification": "grau und bedeckt"
                            },
                            {
                                "target_lang_word": "nieselig",
                                "target_lang_sense_clarification": "mit leichtem Sprühregen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f25d034d-bf2d-3b7c-9603-1d96247ae331",
                    "sense_definition": "Oppressively hot and humid; muggy or stuffy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oppressive, <w>smudgy</w> heat made it nearly impossible to sleep at night.",
                            "target_lang_translations": {
                                "de": "Die drückende, <w>schwüle</w> Hitze machte es fast unmöglich, nachts zu schlafen."
                            }
                        },
                        {
                            "text": "A blanket of <w>smudgy</w> air hung motionless over the entire valley all summer.",
                            "target_lang_translations": {
                                "de": "Eine Glocke aus <w>stickiger</w> Luft hing den ganzen Sommer über regungslos über dem gesamten Tal."
                            }
                        }
                    ],
                    "synonyms": [
                        "humid",
                        "muggy",
                        "stuffy",
                        "sweltering"
                    ],
                    "antonyms": [
                        "crisp",
                        "refreshing"
                    ],
                    "common_phrases": [
                        "smudgy heat"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used dialectally of oppressive heat."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Drückend heiß und feucht; schwül oder stickig."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schwül",
                                "target_lang_sense_clarification": "drückend heiß und feucht"
                            },
                            {
                                "target_lang_word": "drückend",
                                "target_lang_sense_clarification": "schwer erträglich heiß"
                            },
                            {
                                "target_lang_word": "stickig",
                                "target_lang_sense_clarification": "schlecht belüftet und warm"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}