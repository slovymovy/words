                "senses": [
                    {
                        "sense_id": "f89d1b1b-5e0b-314a-995e-3358cf407a33",
                        "entry_id": "3c6f18b6-c6ff-3af4-a478-6f0d25eb5eee",
                        "glosses": [
                            "稍微，微量"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dc91714-c9e0-4d04-8fc7-dcb0dc2b3169",
                                "sense_id": "f89d1b1b-5e0b-314a-995e-3358cf407a33",
                                "text": "Add a soupçon of red pepper.",
                                "translation": "加一點點紅辣椒。"
                            },
                            {
                                "example_id": "3848371c-0ded-4c3b-b852-96a6e8a7410f",
                                "sense_id": "f89d1b1b-5e0b-314a-995e-3358cf407a33",
                                "text": "coffee with a soupçon of cognac",
                                "translation": "配上一點點干邑的咖啡"
                            },
                            {
                                "example_id": "2daae11b-2543-4c4e-94ac-3bac7b808313",
                                "sense_id": "f89d1b1b-5e0b-314a-995e-3358cf407a33",
                                "text": "No one is so depraved that a soupçon of goodness cannot be found in them.",
                                "translation": "世上可没有恶到身上连一点点善都不存有的人。"
                            },
                            {
                                "example_id": "96ef5c42-c463-494b-8720-f89e97b91d70",
                                "sense_id": "f89d1b1b-5e0b-314a-995e-3358cf407a33",
                                "text": "Henrietta, her niece, looked much prettier than she really was; she had good dark eyes, to which a soupçon of rouge, put on with such skill that few suspected it, gave all possible brightness."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bf381b6-93df-313a-bdf9-426809115fbc",
