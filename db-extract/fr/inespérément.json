                "senses": [
                    {
                        "sense_id": "2ea7c684-fcfd-3491-a343-19fd87975779",
                        "entry_id": "c02ac415-66ad-326e-900c-c6eafb798070",
                        "glosses": [
                            "D’une manière inespérée, contre toute espérance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13da622e-caa9-4bdf-9627-fc6ba25e1e0c",
                                "sense_id": "2ea7c684-fcfd-3491-a343-19fd87975779",
                                "text": "Il était ruiné, il lui est survenu inespérément une succession qui a rétabli ses affaires."
                            },
                            {
                                "example_id": "108ea8d4-280c-4fc7-b4c9-ab4702f92140",
                                "sense_id": "2ea7c684-fcfd-3491-a343-19fd87975779",
                                "text": "Inespérément, il y avait eu deux jours d’intervalle entre le premier et le second cataclysme."
                            }
                        ]
                    },
                    {
                        "sense_id": "99ac74d3-899d-3d6a-882d-854be6a5385b",
                        "entry_id": "c02ac415-66ad-326e-900c-c6eafb798070",
                        "glosses": [
                            "En laissant peu ou pas d'espoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "157e1ac5-d9c2-40e2-bf65-385295e5e457",
                                "sense_id": "99ac74d3-899d-3d6a-882d-854be6a5385b",
                                "text": "L’été fuyait. Déjà la plupart des champs étaient vides, où la vue plus inespérément s’étendait."
                            }
                        ]
                    }
                ],
