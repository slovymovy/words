{
    "word_family": [
        "krapte"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bdf87354-9c0c-3130-b4db-78fea3153503",
                    "sense_definition": "Strak zittend en nauwsluitend om het lichaam, vaak gezegd van kleding of schoenen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tightness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe schoenen zitten nog een beetje <w>krap</w>.",
                            "target_lang_translations": {
                                "en": "These new shoes are still a bit <w>tight</w>.",
                                "ru": "Эти новые туфли всё ещё немного <w>жмут</w>.",
                                "fr": "Ces nouvelles chaussures sont encore un peu <w>serrées</w>."
                            }
                        },
                        {
                            "text": "Hij droeg een <w>krappe</w> broek die niet erg comfortabel leek.",
                            "target_lang_translations": {
                                "en": "He was wearing <w>tight</w> pants that didn't look very comfortable.",
                                "ru": "Он носил <w>тесные</w> брюки, которые казались не очень удобными.",
                                "fr": "Il portait un pantalon <w>serré</w> qui ne semblait pas très confortable."
                            }
                        }
                    ],
                    "synonyms": [
                        "strak",
                        "nauw"
                    ],
                    "antonyms": [
                        "wijd",
                        "ruim",
                        "los"
                    ],
                    "common_phrases": [
                        "krap zitten"
                    ],
                    "target_lang_definitions": {
                        "en": "Fitting closely to the body, often said of clothes or shoes.",
                        "ru": "Плотно сидящий, облегающий тело (часто об одежде или обуви).",
                        "fr": "Ajusté et serré contre le corps, souvent dit de vêtements ou de chaussures."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tight",
                                "target_lang_sense_clarification": "fitting closely, leaving little room"
                            },
                            {
                                "target_lang_word": "pinching",
                                "target_lang_sense_clarification": "painfully tight (especially shoes)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тесный",
                                "target_lang_sense_clarification": "об одежде"
                            },
                            {
                                "target_lang_word": "жмущий",
                                "target_lang_sense_clarification": "об обуви"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "serré",
                                "target_lang_sense_clarification": "vêtement ou chaussure qui serre"
                            },
                            {
                                "target_lang_word": "juste",
                                "target_lang_sense_clarification": "taille limite, un peu trop étroit"
                            },
                            {
                                "target_lang_word": "étroit",
                                "target_lang_sense_clarification": "qui manque d'ampleur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df185258-5dfd-37fe-9e8d-c49e5fae4c59",
                    "sense_definition": "Met weinig beschikbare ruimte; smal of beperkt in omvang.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tightness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gang is erg <w>krap</w>, dus we kunnen er niet met twee mensen tegelijk doorheen.",
                            "target_lang_translations": {
                                "en": "The hallway is very <w>narrow</w>, so we can't go through it with two people at the same time.",
                                "ru": "Коридор очень <w>тесный</w>, поэтому мы не можем пройти там вдвоем одновременно.",
                                "fr": "Le couloir est très <w>étroit</w>, donc nous ne pouvons pas y passer à deux en même temps."
                            }
                        },
                        {
                            "text": "We zaten met vijf personen nogal <w>krap</w> op de achterbank van de auto.",
                            "target_lang_translations": {
                                "en": "We were sitting rather <w>cramped</w> with five people on the back seat of the car.",
                                "ru": "Мы сидели впятером довольно <w>тесно</w> на заднем сиденье машины.",
                                "fr": "À cinq, nous étions plutôt <w>à l'étroit</w> sur la banquette arrière de la voiture."
                            }
                        }
                    ],
                    "synonyms": [
                        "nauw",
                        "smal"
                    ],
                    "antonyms": [
                        "ruim",
                        "breed",
                        "wijd"
                    ],
                    "common_phrases": [
                        "krap bij kas",
                        "krap aan",
                        "krap bemeten",
                        "krap behuisd"
                    ],
                    "target_lang_definitions": {
                        "en": "Having little available space; narrow or limited in extent.",
                        "ru": "С малым количеством свободного места; узкий или ограниченный в объеме.",
                        "fr": "Disposant de peu d'espace disponible ; étroit ou restreint en dimensions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cramped",
                                "target_lang_sense_clarification": "lacking sufficient space"
                            },
                            {
                                "target_lang_word": "tight",
                                "target_lang_sense_clarification": "limited in space or resources"
                            },
                            {
                                "target_lang_word": "narrow",
                                "target_lang_sense_clarification": "small width"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тесный",
                                "target_lang_sense_clarification": "о помещении"
                            },
                            {
                                "target_lang_word": "узкий",
                                "target_lang_sense_clarification": "о проходе"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "étroit",
                                "target_lang_sense_clarification": "qui a peu de largeur ou d'espace"
                            },
                            {
                                "target_lang_word": "exigu",
                                "target_lang_sense_clarification": "très petit, qui manque de place"
                            },
                            {
                                "target_lang_word": "à l'étroit",
                                "target_lang_sense_clarification": "manquant d'espace pour bouger"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4b45c12-12d0-37fa-bb73-d7a4b877c85b",
                    "sense_definition": "Een uitgebakken stukje spek (kaantje).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij de stamppot aten we een heerlijke, knapperige <w>krap</w>.",
                            "target_lang_translations": {
                                "en": "With the stew, we ate a delicious, crispy <w>piece of crackling</w>.",
                                "ru": "С картофельным пюре мы ели вкусную хрустящую <w>шкварку</w>.",
                                "fr": "Avec la potée, nous avons mangé un délicieux <w>gratton</w> croustillant."
                            }
                        },
                        {
                            "text": "De slager verkocht een zakje met zoute <w>krappen</w>.",
                            "target_lang_translations": {
                                "en": "The butcher sold a bag of salty <w>greaves</w>.",
                                "ru": "Мясник продал пакетик с солеными <w>шкварками</w>.",
                                "fr": "Le boucher vendait un sachet de <w>grattons</w> salés."
                            }
                        }
