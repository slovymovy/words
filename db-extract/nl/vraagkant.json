                        "examples": [
                            {
                                "example_id": "f0a72c49-6c50-4b01-80af-b030542393b2",
                                "sense_id": "246f7b0a-ef99-3836-b23a-cf49562a236d",
                                "text": "Wildlife crime kan alleen worden gestopt als de aanbod- en de vraagkant nauw samenwerken. De overheden van Vietnam en Zuid-Afrika voeren al wel overleg, maar dit zal geïntensiveerd moeten worden."
                            },
                            {
                                "example_id": "c7076afd-5d6e-4a6f-9ca3-ebbd2995b451",
                                "sense_id": "246f7b0a-ef99-3836-b23a-cf49562a236d",
                                "text": "Maar er is niet alleen meer aanbod, aan de vraagkant is een vergelijkbare stijging te zien."
                            },
                            {
                                "example_id": "2c025b5b-da91-4411-8315-86bf3760693c",
                                "sense_id": "246f7b0a-ef99-3836-b23a-cf49562a236d",
                                "text": "Dit jaar moeten er zeker 150 huisjes van de band rollen; dertig daarvan zijn er besteld door de gemeente Weert. Naar verwachting zullen vele gemeentes volgen. ,,Het gebrek zit eerder bij de capaciteit in de fabriek, dan aan de vraagkant,\" weet Timmermans-Dalhuisen van Heijmans."
                            }
                        ]
                    }
