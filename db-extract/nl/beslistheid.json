                                "target_senses": [
                                    {
                                        "sense_id": "ed6acb92-d354-3ebe-8b72-36f1d75814a4",
                                        "entry_id": "025066c8-1347-37a1-912f-49009a18d464",
                                        "glosses": [
                                            "The state of being firm",
                                            "security; steadfastness; good grip"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                        "entry_id": "025066c8-1347-37a1-912f-49009a18d464",
                                        "glosses": [
                                            "The state of being firm",
                                            "strictness; mental strength"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43f91b0-f6af-4c1b-a18b-7ff2a8580269",
                                                "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                                "text": "But many a man who would have stood within a home dismantled, strong in his passion and design of vengeance, has had the firmness of his nature conquered by the razing of an air–built castle."
                                            },
                                            {
                                                "example_id": "94e09148-1546-482f-9a7e-4e27affbba98",
                                                "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                                "text": "France, for the first time since the death of Charlemagne, was governed by a prince of great firmness and ability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4dec340-61d0-372c-b25b-15db254e1e26",
                                        "entry_id": "025066c8-1347-37a1-912f-49009a18d464",
                                        "glosses": [
                                            "The state of being firm",
                                            "physical durability; rigidness (of material)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a07848f-282e-496c-a277-16429adcfe24",
                        "source_entry_id": "a5e55f3d-0bb8-321b-a8b5-e702ed41b422",
                        "source_sense_id": "8a01ce35-78cb-3e3c-8762-dc4592fa4dfd",
                        "target_lang_word": "peremptoriness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peremptoriness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "546d020e-ea8e-3a98-9e01-30b6b2c5b8da",
                                        "entry_id": "4330ec01-ed99-336b-847a-7ea3007288e2",
                                        "glosses": [
                                            "The quality of being peremptory"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20893818-1acf-427f-8ab9-95bcc66e1dd0",
                                                "sense_id": "546d020e-ea8e-3a98-9e01-30b6b2c5b8da",
                                                "text": "Mrs. Stannidge thereupon said with a considerate peremptoriness that she and her mother had better take their own suppers if they meant to have any."
                                            },
                                            {
                                                "example_id": "eb8b0946-b976-4891-badf-37171222bfd3",
                                                "sense_id": "546d020e-ea8e-3a98-9e01-30b6b2c5b8da",
                                                "text": "For suddenly the drum beat to quarters, which familiar sound happening at least twice every day, had upon the present occasion a signal peremptoriness in it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
