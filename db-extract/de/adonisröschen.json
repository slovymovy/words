                    {
                        "translation_id": "efea2dd8-6e4e-4e9f-8cc3-2576f9354b6a",
                        "source_entry_id": "ba2989b9-a6c2-3b7a-a2a9-50a54be76313",
                        "source_sense_id": "f66cef2a-93b4-3b5c-ba41-4523e4603a89",
                        "source_sense_description": "Vertreter der Pflanzengattung Adonis aus der Familie der Hahnenfußgewächse",
