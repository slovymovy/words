                "senses": [
                    {
                        "sense_id": "d2e5b20a-626a-3cad-b911-462c1b51c477",
                        "entry_id": "17088c2c-6782-36d2-8886-4487affc963d",
                        "glosses": [
                            "Communiquer moins que la moyenne, ou de façon insuffisante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d7aa07-330d-4a93-8f25-7786f20599fb",
                                "sense_id": "d2e5b20a-626a-3cad-b911-462c1b51c477",
                                "text": "Les équipes me disaient qu’on sous-communiquait sur ces sujets alors qu’on faisait énormément de choses, mais j’avais un complexe : je ne voulais surtout pas faire du greenwashing ou qu’on nous accuse de faire du marketing."
                            },
                            {
                                "example_id": "9fa5c4f9-21f6-4f9c-b5d4-fbc7162a676e",
                                "sense_id": "d2e5b20a-626a-3cad-b911-462c1b51c477",
                                "text": "À l’inverse, Intermarché (indice 81), Leclerc (76), Auchan (78) sous-communiquent sur le bio, tout comme Lidl (82)."
                            },
                            {
                                "example_id": "667bb178-4211-4e24-97b9-386f3fef45ab",
                                "sense_id": "d2e5b20a-626a-3cad-b911-462c1b51c477",
                                "text": "La société moderne sur-informe mais sous-communique."
                            }
                        ]
                    },
                    {
                        "sense_id": "06c444a8-ca22-3356-afa3-8d64ab26478d",
                        "entry_id": "17088c2c-6782-36d2-8886-4487affc963d",
                        "glosses": [
                            "Communiquer de façon non explicite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e2e3cc-7458-49ca-8a92-bca8691f8e88",
                                "sense_id": "06c444a8-ca22-3356-afa3-8d64ab26478d",
                                "text": "Alors que lorsqu'on court après une fille, on sous-communique de la neediness et un manque d’amour propre !"
                            },
                            {
                                "example_id": "8c83a6de-4f8d-4aff-9dcf-7ba5539b3819",
                                "sense_id": "06c444a8-ca22-3356-afa3-8d64ab26478d",
                                "text": "Notre attitude, notre langage corporel ou encore le ton de notre voix sous-communiquent un tas de choses !"
                            }
                        ]
                    }
