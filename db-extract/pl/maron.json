                ],
                "translations": [
                    {
                        "translation_id": "408c2a0c-0222-4088-9663-032d111ea4b9",
                        "source_entry_id": "636854a7-043c-3cb1-b2c4-90d7a35682e4",
                        "source_sense_id": "5ee87f69-d980-3b97-9eaf-c87c6463db51",
                        "target_lang_word": "maroon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maroon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bff6a4-4dad-3277-b729-da5acf0dcacc",
                                        "entry_id": "cdb2cf90-095c-389e-b98d-7d34265492dd",
                                        "glosses": [
                                            "An escaped black slave of the Caribbean and the Americas or a descendant of such a person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8704345a-18d7-4d79-8608-8a60bf1a66c8",
                                                "sense_id": "f8bff6a4-4dad-3277-b729-da5acf0dcacc",
                                                "text": "Further north a Maroon community in the Bahoruco Mountains thrived for eighty-five years, until the French proposed a truce under the terms of which the Maroons would be permitted to form an independent clan."
                                            },
                                            {
                                                "example_id": "580d0db4-cfff-41b9-bf60-a2c98e425817",
                                                "sense_id": "f8bff6a4-4dad-3277-b729-da5acf0dcacc",
                                                "text": "Joining others who had escaped before them, they formed communities of Maroons in which many traditional African customs and social mores were preserved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a313fdbf-df55-3340-962f-44448d6cac71",
                                        "entry_id": "cdb2cf90-095c-389e-b98d-7d34265492dd",
                                        "glosses": [
                                            "A castaway; a person who has been marooned."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "maroon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b99dbe4c-a8dd-348b-8333-7f22aa22f945",
                                        "entry_id": "a15a87eb-bccc-38ed-82da-009dea3fc0e3",
                                        "glosses": [
                                            "Associated with Maroon culture, communities or peoples."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c92a91e-7d12-4bda-8402-5bd627ef747e",
                                                "sense_id": "b99dbe4c-a8dd-348b-8333-7f22aa22f945",
                                                "text": "In her discussion of Michelle Cliff's Abeng, a novel that historicizes maroon culture and the Jamaican warrior heroine Nanny of the Maroons, Francoise Lionnet examines linguistic “metissage” […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maroon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "971c3079-16f1-302c-a631-3180b49a7af2",
                                        "entry_id": "a3cdafbc-2432-3550-ab57-c96628a2a1b2",
                                        "glosses": [
                                            "To abandon in a remote, desolate place, as on a desert island."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2471f79f-ca87-4e68-87dd-15881e3fb7fb",
                                                "sense_id": "971c3079-16f1-302c-a631-3180b49a7af2",
                                                "text": "Hard-hit by the Arctic winter, the Waverley route was completely closed from January 6-9, when an avalanche between Whitrope and Riccarton marooned Class A2 4-6-2 No. 60535 Hornet's Beauty."
                                            },
                                            {
                                                "example_id": "07d2e68a-6a75-4614-a796-80fb634fd8b2",
                                                "sense_id": "971c3079-16f1-302c-a631-3180b49a7af2",
                                                "text": "After the harrowing stories of being marooned at sea and stranded in the frozen wastelands of Alaska and the Poles, one would think that survival on dry land would be easier […]"
                                            },
                                            {
                                                "example_id": "397e7a47-926d-4816-8ab4-98c55503803f",
                                                "sense_id": "971c3079-16f1-302c-a631-3180b49a7af2",
                                                "text": "The Trump administration’s argument, that no court could order it to retrieve Abrego Garcia despite his being deported by mistake, has broader implications: It means that the administration could similarly maroon U.S. citizens abroad “by mistake” and abandon them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maroon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04770e41-f1b1-33aa-90cd-228e0014ae6d",
                                        "entry_id": "98003be5-5376-3916-ae95-517f4ccf0b09",
                                        "glosses": [
                                            "A rich dark red, somewhat brownish, color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a487a7-31bb-4288-9ba6-1a42c270d8ff",
                                                "sense_id": "04770e41-f1b1-33aa-90cd-228e0014ae6d",
                                                "text": "Is it a really dark maroon or a lighter maroon or a maroon that leans toward the red side? Or the magenta side? To address this issue, scientists use something called a color space."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maroon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15277145-022f-3bac-b09c-435f85c2cc79",
                                        "entry_id": "28dcaf7a-8834-338e-88f7-cd9703143f9e",
                                        "glosses": [
                                            "Of a maroon color"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "maroon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6110118-723c-3c21-8906-4fd7fc5e99f1",
                                        "entry_id": "1caed12e-fa93-3d4d-ad55-36776f442d20",
                                        "glosses": [
                                            "A rocket-propelled firework or skyrocket, often one used as a signal (for example, to summon the crew of a lifeboat or warn of an air raid)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba54cd73-38b4-401a-a75a-5744027dfea0",
                                                "sense_id": "c6110118-723c-3c21-8906-4fd7fc5e99f1",
                                                "text": "On Sunday afternoon a serious firework explosion occurred in Lambeth, whereby three persons were seriously injured. Two lads […] purchased a firework called a “maroon”, which is a bomb consisting of a small ball of string covered with a red composition. It is loaded with gunpowder, and there is also a fuse attached."
                                            },
                                            {
                                                "example_id": "e2ab9a94-3da2-451d-92f7-7d9621c5238e",
                                                "sense_id": "c6110118-723c-3c21-8906-4fd7fc5e99f1",
                                                "text": "As the evening falls, colored lamps and Chinese lanterns are lighted around the venerable oak which stands in the middle of the fairground and boys climb about among its topmost branches with maroons and Bengal lights."
                                            },
                                            {
                                                "example_id": "04321602-7879-4a2b-8280-33cc5daf836b",
                                                "sense_id": "c6110118-723c-3c21-8906-4fd7fc5e99f1",
                                                "text": "Many a seaman’s life may have depended on equine speed and strength. Some of these ‘Lifeboat Horses’ used to recognise the maroon which was fired to summon the Lifeboat crew. Long after its retirement one of the horses which regularly helped to haul the Hoylake Lifeboat heard a maroon fired one day when it was working in the neighbouring fields. It immediately became very excited and made for the boathouse."
                                            },
                                            {
                                                "example_id": "ab712846-5437-4e84-b92a-46a8ba903de8",
                                                "sense_id": "c6110118-723c-3c21-8906-4fd7fc5e99f1",
                                                "text": "tallboys […] And now I am off to inspect stores. There is a shortage of maroons that I don't understand. / the countess. What a pity! I love maroons. They have such nice ones at that confectioner's near the Place Vendôme. / tallboys. Oh, youre thinking of marrons glacés. No: maroons are fireworks: things that go off with a bang. For signalling."
                                            },
                                            {
                                                "example_id": "c2b3ccb2-98e4-44c8-a334-501fe48e7704",
                                                "sense_id": "c6110118-723c-3c21-8906-4fd7fc5e99f1",
                                                "text": "The big air raids […] were much more dreadful than the air raids of the World War. They began with a nightmare of warning maroons, sirens, hooters and the shrill whistles of cyclist scouts, then swarms of frantic people running to and fro, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maroon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73fe547e-b3f8-333c-9cc7-61e7053ed3ef",
                                        "entry_id": "077d3e94-582a-3b52-9cf4-38eb1435c8d7",
                                        "glosses": [
                                            "An idiot; a fool."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a28ef1b6-d4f3-4b9e-848f-15d2801e4733",
                                                "sense_id": "73fe547e-b3f8-333c-9cc7-61e7053ed3ef",
                                                "text": "At least, I would not be sleeping that night. Why did I have that espresso? What a maroon!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
