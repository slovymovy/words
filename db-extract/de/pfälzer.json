                ],
                "senses": [
                    {
                        "sense_id": "68b43eb2-8f6b-34ce-b371-e7c96f106463",
                        "entry_id": "5a7445bf-c4c7-3b21-9a2d-e4a04a95207b",
                        "glosses": [
                            "Person, die aus der Pfalz stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fcd4173-4c43-42e5-bfa0-a8dd6e2c7753",
                                "sense_id": "68b43eb2-8f6b-34ce-b371-e7c96f106463",
                                "text": "Ein Bekannter von mir ist Pfälzer."
                            },
                            {
                                "example_id": "bbb0c9cc-2618-4a87-ade4-293c29789cba",
                                "sense_id": "68b43eb2-8f6b-34ce-b371-e7c96f106463",
                                "text": "„Ein Pfälzer Dorfbäcker trat mit seinem Team beim Wettbacken im Fernsehen auf.“"
                            },
                            {
                                "example_id": "192d6c35-f19d-4bec-8737-963ae93f7a4f",
                                "sense_id": "68b43eb2-8f6b-34ce-b371-e7c96f106463",
                                "text": "„Der 51 Jahre alte Pfälzer ist nicht nur Bauer, sondern Aufsichtsratschef der ‚Pfalzmarkt Obst und Gemüse Genossenschaft‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cb3999dd-b4df-3195-8d98-56503467d4e5",
                        "entry_id": "5a7445bf-c4c7-3b21-9a2d-e4a04a95207b",
                        "glosses": [
                            "Wein aus dem südwestdeutschen Weinbaugebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c9d2f2-7222-49b2-84cf-124b218c832c",
                                "sense_id": "cb3999dd-b4df-3195-8d98-56503467d4e5",
                                "text": "An seinem Geburtstag trank er einen Pfälzer, seinen Lieblingswein."
                            },
                            {
                                "example_id": "096e1462-55cb-4a91-94b9-d92270901582",
                                "sense_id": "cb3999dd-b4df-3195-8d98-56503467d4e5",
                                "text": "„Echte Pfälzer mit Patenonkeln aus der Loire und Südafrika sind hingegen die Sauvignons Blancs, die bis zu achtzehn Monate auf der Hefe liegen und zwei Jahre lang in der Flasche reifen, ein kommerzielles Kamikaze, das jeden Weinfanatiker adelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "50932e43-4c58-3e43-88a0-c36a571ca512",
                        "entry_id": "5a7445bf-c4c7-3b21-9a2d-e4a04a95207b",
                        "glosses": [
                            "mit etwas Majoran gefülltes Würstchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15395fa3-fc49-463b-931b-92f6c122ae46",
                                "sense_id": "50932e43-4c58-3e43-88a0-c36a571ca512",
                                "text": "Sie bestellte zwei Pfälzer an der Wurstbude."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
