                                    {
                                        "sense_id": "fbc41512-4136-3c08-9c45-979d9e4fdb2c",
                                        "entry_id": "b6eceef2-7711-3f63-9974-d08204130f7e",
                                        "glosses": [
                                            "Laut der Katze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6fa475e-408b-4cc9-9f97-a379c7a74c1b",
                                                "sense_id": "fbc41512-4136-3c08-9c45-979d9e4fdb2c",
                                                "text": "Unsere alte Katze ist so träge, sie liegt nur den ganzen Tag auf dem Sofa und macht nicht mal mehr miau."
                                            },
                                            {
                                                "example_id": "9b257692-74b8-4c75-826e-643b222ac4f7",
                                                "sense_id": "fbc41512-4136-3c08-9c45-979d9e4fdb2c",
                                                "text": "„Miau!“ rief die Mieze, was hieß: Ich habe Hunger!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
