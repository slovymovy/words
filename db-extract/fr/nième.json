                "senses": [
                    {
                        "sense_id": "61f68027-b9e3-3ece-a3d1-7f51c35fab08",
                        "entry_id": "0eacf62e-af94-32df-8083-8fcea7cf6500",
                        "glosses": [
                            "Variante orthographique de énième."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b349233a-21f7-44f4-b7d7-bbd8ef591459",
                                "sense_id": "61f68027-b9e3-3ece-a3d1-7f51c35fab08",
                                "text": "Le Havre, ville où pour la Nième fois je suis venu passer des vacances de quelques jours et où depuis longtemps j’ai diverses attaches."
                            },
                            {
                                "example_id": "fd0a42ff-31bb-41c2-89be-8f0390c63e07",
                                "sense_id": "61f68027-b9e3-3ece-a3d1-7f51c35fab08",
                                "text": "Aux États-Unis, tout se fait à la Nième puissance."
                            },
                            {
                                "example_id": "06309ce2-a9de-421d-a798-a1d1d578ae69",
                                "sense_id": "61f68027-b9e3-3ece-a3d1-7f51c35fab08",
                                "text": "Si la N^(ième) valeur demandée n’existe pas alors un message d’erreur est renvoyé."
                            },
                            {
                                "example_id": "025d32f4-1678-4038-869d-283d07c6cc7c",
                                "sense_id": "61f68027-b9e3-3ece-a3d1-7f51c35fab08",
                                "text": "Dans ce cas, le résultat de l’addition est l’adresse de la Nième variable pointée par le pointeur."
                            }
                        ]
                    }
                ],
