                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морской пехотинец",
                                "target_lang_sense_clarification": "военнослужащий морской пехоты"
                            },
                            {
                                "target_lang_word": "морпех",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            },
                            {
                                "target_lang_word": "солдат морской пехоты",
                                "target_lang_sense_clarification": "официальное описание"
                            }
