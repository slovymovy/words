            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ffeaaf21-ccae-3bab-8784-88023bfc66bd",
                    "sense_definition": "One’s father, used as a proper name.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Dad</w> told me to mow the lawn before dinner.",
                            "target_lang_translations": {
                                "ru": "<w>Папа</w> сказал мне подстричь газон перед ужином.",
                                "zh": "<w>爸爸</w>让我晚饭前去割草。"
                            }
                        },
                        {
                            "text": "I bought a nice birthday gift for <w>Dad</w>.",
                            "target_lang_translations": {
                                "ru": "Я купил хороший подарок <w>Папе</w> на день рождения.",
                                "zh": "我给<w>爸爸</w>买了一份很棒的生日礼物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Father",
                        "Daddy",
                        "Pa",
                        "Papa"
                    ],
                    "antonyms": [
                        "Mom",
                        "Mother"
                    ],
                    "common_phrases": [
                        "ask Dad",
                        "tell Dad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отец (используется как имя собственное, без артикля/притяжательного местоимения).",
                        "zh": "父亲，用作专有名词。"
                    },
                    "translations": {
                        "ru": [
