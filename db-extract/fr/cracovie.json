                                        "glosses": [
                                            "Stadt in Polen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a80f03e-b070-4364-8592-ed4fd383d546",
                                                "sense_id": "b481bb71-77c1-3caf-b5b2-9340e04dd38c",
                                                "text": "„Unterwegs durch die Gassen Krakaus fiel mir auf, was ich noch alles hätte erwähnen können.“"
                                            },
                                            {
                                                "example_id": "3df16746-70ec-4298-a4c0-5e2158f53508",
                                                "sense_id": "b481bb71-77c1-3caf-b5b2-9340e04dd38c",
                                                "text": "„Vom Palästina-Amt in Krakau bekommt er einen Schein zur Auswanderung nach Zion für den nächsten Transport.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e145ce6d-c669-3c81-baad-90ca06801fa5",
                                        "entry_id": "67b9c9fc-73d7-3c46-a896-76251f9126a2",
                                        "glosses": [
                                            "Tal in der Steiermark"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb68de0-9fbe-47f4-b90d-80b219bec58c",
                                                "sense_id": "e145ce6d-c669-3c81-baad-90ca06801fa5",
                                                "text": "Wir hatten einen wunderbarer Urlaub im Hochtal von Krakau."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
