                                "target_senses": [
                                    {
                                        "sense_id": "58703575-1429-3506-a64d-a098ef77d12e",
                                        "entry_id": "04baf221-55b2-37d1-8de4-33cf2b20d762",
                                        "glosses": [
                                            "Technique de sculpture où le sujet est en relief mais attaché au fond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b54b2c7-a103-4aee-b529-88e503417546",
                                                "sense_id": "58703575-1429-3506-a64d-a098ef77d12e",
                                                "text": "Les bas-reliefs et les statuettes sont remplacés par des figures en haut-relief ou en ronde bosse, placées dans des niches juxtaposées ou superposées et symétriques, formant un ensemble."
                                            },
                                            {
                                                "example_id": "e78af366-b739-4021-9346-ed46cb17235a",
                                                "sense_id": "58703575-1429-3506-a64d-a098ef77d12e",
                                                "text": "C’était un bâtiment funéraire en forme de temple grec avec fronton en triangle, crépi, deux marches menant à un stylobate à trois colonnes (à cannelures, avec volutes, feuilles d’acanthe, corniche, denticules au fronton, de la cimaise au rampant), pronaos, grille en fer forgé et, au tympan, sculptées en haut-relief, les lettres \"Famille Pelletier\" en grandes capitales."
                                            }
                                        ]
                                    }
