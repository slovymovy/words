                        "sense_id": "af6fd137-4e4e-3e95-8293-4df3dc4e58c9",
                        "entry_id": "62639dc4-7fd0-3a14-87b4-11f6e368f3d6",
                        "glosses": [
                            "Eliciting cosy feelings of tenderness and sympathy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e1124e-4a98-4202-a0e8-4b162e4ec113",
                                "sense_id": "af6fd137-4e4e-3e95-8293-4df3dc4e58c9",
                                "text": "It was a heart-warming movie about a child overcoming adversity."
                            },
                            {
                                "example_id": "affa885b-3061-4491-b5d8-ee31356c2b46",
                                "sense_id": "af6fd137-4e4e-3e95-8293-4df3dc4e58c9",
                                "text": "Every heartwarming human interest story in america is like \"he raised $20,000 to keep 200 orphans from being crushed in the orphan-crushing machine\" and then never asks why an orphan-crushing machine exists or why you'd need to pay to prevent it from being used."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a69d09e0-c769-460c-a84f-76139132fb26",
                        "source_entry_id": "62639dc4-7fd0-3a14-87b4-11f6e368f3d6",
                        "source_sense_id": "af6fd137-4e4e-3e95-8293-4df3dc4e58c9",
                        "source_sense_description": "eliciting tenderness and sympathy",
                        "target_lang_word": "hartverwarmend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hartverwarmend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "54301214-90ff-3a70-a269-aa7905ee2c87",
                                        "entry_id": "a2cc307c-f012-3580-ad58-ace7038ae845",
                                        "glosses": [
                                            "aangename saamhorigheid of vertedering oproepend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2041739-114a-41c4-b1a4-6e32bb7f8b3b",
                                                "sense_id": "54301214-90ff-3a70-a269-aa7905ee2c87",
                                                "text": "Haar omgang met de verschillende culturen was hartverwarmend en, beste collega's, ook zeer leerzaam."
                                            },
                                            {
                                                "example_id": "2d2ebd2d-cedd-4c6d-8ec9-3962d2c0c9cf",
                                                "sense_id": "54301214-90ff-3a70-a269-aa7905ee2c87",
                                                "text": "Zelfbeproeving, door ieder in werking gebragt, vertrouwen, door een ieder beoefend, geeft aan de gesprekken iets dat hartverwarmend en zielbekorend is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "251f76d3-a2bc-3336-bc26-5ea07f658640",
                                        "entry_id": "a2cc307c-f012-3580-ad58-ace7038ae845",
                                        "glosses": [
                                            "bemoedigend, van binnen een heel positief gevoel gevend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14b8f87-f777-420a-93f7-b4f417e00acf",
                                                "sense_id": "251f76d3-a2bc-3336-bc26-5ea07f658640",
                                                "text": "Ik dank de jury voor een zo mooie prijs, voor mijn stek op een zo roemrucht palmares, en voor een juryrapport dat mijn werk zo hartverwarmend juist naar zijn waarde schat."
                                            },
                                            {
                                                "example_id": "0c3f63a6-7dc6-435a-9ffa-398d3487ddcc",
                                                "sense_id": "251f76d3-a2bc-3336-bc26-5ea07f658640",
                                                "text": "Het is geene gerijmde zedekundige verhandeling of droog betoogend leerdicht, maar een hartverwarmend dichtstuk, vol leven en gevoel;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef1e4282-1720-4877-8cc6-b77e15c25c51",
                        "source_entry_id": "62639dc4-7fd0-3a14-87b4-11f6e368f3d6",
                        "source_sense_id": "af6fd137-4e4e-3e95-8293-4df3dc4e58c9",
