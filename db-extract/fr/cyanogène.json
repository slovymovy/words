                "senses": [
                    {
                        "sense_id": "293ee3a6-0cd5-3b0d-ab50-7c42e6f4ef05",
                        "entry_id": "65c63eff-ce0e-330a-b37a-2febb28c074a",
                        "glosses": [
                            "Gaz incolore, toxique, à odeur d'amande amère, composé d’azote et de carbone, de formule C₂N₂."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c86591-9031-4542-bc46-44c61f063d11",
                                "sense_id": "293ee3a6-0cd5-3b0d-ab50-7c42e6f4ef05",
                                "text": "Le cyanogène est un corps composé formé de carbone et d'azote, mais il joue le rôle d’un corps simple."
                            }
                        ]
                    },
                    {
                        "sense_id": "d11f6a4d-27fd-32ed-8401-7f50b125c6dd",
                        "entry_id": "65c63eff-ce0e-330a-b37a-2febb28c074a",
                        "glosses": [
                            "Nom désignant le radical –C≡N, aussi appelé groupement -cyano ou cyanure, que l’on retrouve dans un large éventail de composés organiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7253cc2-342f-4c9c-9733-fe78fcf8b254",
                                "sense_id": "d11f6a4d-27fd-32ed-8401-7f50b125c6dd",
                                "text": "Le bromure de cyanogène est un composé chimique de formule Br–C≡N."
                            }
                        ]
                    }
                ],
