                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a90ff63-dade-4c14-b092-805b3ae9b211",
                                                "sense_id": "f4c16476-fd34-3070-8384-fa189cfd86b8",
                                                "text": "transnational genocidal organization"
                                            },
                                            {
                                                "example_id": "b84b3a5e-dc99-44d1-98da-b84a9af34b56",
                                                "sense_id": "f4c16476-fd34-3070-8384-fa189cfd86b8",
                                                "text": "An ethnic civil war triggered the genocidal massacre of more than 500000 people in just a few short months. Hundreds of thousands of Rwandans fled..."
                                            }
