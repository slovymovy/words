                ],
                "senses": [
                    {
                        "sense_id": "198bb6eb-536b-365e-9a1d-197a2fcbe544",
                        "entry_id": "db2f5cbd-e7ff-3984-b4ed-2f5c8f3c1d9a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63f45bc5-efa7-417c-8b9e-16c155d4cbda",
                                "sense_id": "198bb6eb-536b-365e-9a1d-197a2fcbe544",
                                "text": "Frau Leibold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8a92adcc-415d-4871-b26a-eeb2626ca2ad",
                                "sense_id": "198bb6eb-536b-365e-9a1d-197a2fcbe544",
                                "text": "Herr Leibold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5ac1ab76-77b0-45b9-bdd6-70a72c8fa060",
                                "sense_id": "198bb6eb-536b-365e-9a1d-197a2fcbe544",
                                "text": "Die Leibolds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ea6e07b6-9fae-4d4c-84c2-b19b57005da0",
                                "sense_id": "198bb6eb-536b-365e-9a1d-197a2fcbe544",
                                "text": "Der Leibold trägt nie die Schals, die die Leibold ihm strickt."
                            },
                            {
                                "example_id": "c04f5a44-872f-4b7d-a52b-c324066e1c4a",
                                "sense_id": "198bb6eb-536b-365e-9a1d-197a2fcbe544",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leibold kommt, geht der Herr Leibold.“"
                            },
                            {
                                "example_id": "9c8b7c48-9c85-42c8-ac2a-8f2028e6847b",
                                "sense_id": "198bb6eb-536b-365e-9a1d-197a2fcbe544",
                                "text": "Leibold kommt und geht."
                            },
                            {
                                "example_id": "7a096a54-31bc-45b8-9fb7-648785a785da",
                                "sense_id": "198bb6eb-536b-365e-9a1d-197a2fcbe544",
                                "text": "Leibolds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
