                ],
                "senses": [
                    {
                        "sense_id": "dd8e9070-d2ab-3117-9e82-4fa8f3d37f6f",
                        "entry_id": "18ade80a-52a6-38fd-834d-adf0937d10c9",
                        "glosses": [
                            "Brand, der sich am Boden entlang flächenhaft oder linienhaft ausbreitet"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c6297952-5a66-483e-8176-b374f11386c8",
                                "sense_id": "dd8e9070-d2ab-3117-9e82-4fa8f3d37f6f",
                                "text": "Die in der Natur häufig vorkommenden Lauffeuer sind für die Ökosysteme weit weniger schädlich als Wipfelfeuer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d85b7e8f-5776-3b9c-938d-615111dba49e",
                        "entry_id": "18ade80a-52a6-38fd-834d-adf0937d10c9",
                        "glosses": [
                            "Strategie, bei dem in einer Reihe stehende Soldaten nacheinander schießen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "41dba69f-d983-4386-98b7-fbd3f31ccdff",
                                "sense_id": "d85b7e8f-5776-3b9c-938d-615111dba49e",
                                "text": "„Als i. J. 1619 Kaiser Ferdinand II. auf seiner Reise nach Frankfurt den Churfürsten in München besucht hatte, rückte das Bürger Militär dieser Stadt mit vier Fähnlein 14oo, und bei seiner Zurückkunft 3ooo Mann stark in Parade aus, und gab dabei Dechargen und Lauffeuer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                        "entry_id": "18ade80a-52a6-38fd-834d-adf0937d10c9",
                        "glosses": [
                            "siehe wie ein Lauffeuer"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "964c5b38-c962-4a8d-bcde-8bf9d9e8a9e0",
                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                "text": "„Die Nachricht von der britischen Kriegserklärung sorgte nicht nur in Berlin für Aufsehen und heftige Reaktionen, sie erreichte wie ein Lauffeuer rasch die letzten Winkel des Reiches.“"
                            },
                            {
                                "example_id": "e6a91f68-13ed-40da-aa37-226f090508af",
                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                "text": "„Bei einem Protest gegen Polizeigewalt in den USA stellt sich eine Frau der Polizei entgegen. Das Foto verbreitet sich wie ein Lauffeuer.“"
                            },
                            {
                                "example_id": "98337bc4-dfd9-4a9e-8a94-7d6754cd88e4",
                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                "text": "Im Zeitalter der neuen Medien, wo falsche Nachrichten sich wie ein Lauffeuer verbreiten, braucht man ein kritisches Bewusstsein."
                            },
                            {
                                "example_id": "17ccf19d-94a1-4701-9a95-08e38f47ef15",
                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                "text": "„Denn natürlich hatte sich die Nachricht von meiner Abreise im Dorf wie ein Lauffeuer verbreitet.“"
                            },
                            {
                                "example_id": "408d0225-955e-4306-b048-7e72b3f8e794",
                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                "text": "„Mit ihrem Sprung am Gummiseil war das Bungee-Jumping in Neuseeland geboren und verbreitete sich wie ein Lauffeuer auf der ganzen Welt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "183f9322-a40a-4413-bf1e-c245bbfb0afc",
                        "source_entry_id": "18ade80a-52a6-38fd-834d-adf0937d10c9",
                        "source_sense_id": "dd8e9070-d2ab-3117-9e82-4fa8f3d37f6f",
                        "source_sense_description": "veraltet, Brandlehre: Brand, der sich am Boden entlang flächenhaft oder linienhaft ausbreitet",
                        "target_lang_word": "spread like wildfire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spread like wildfire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "804403c9-581e-3307-ae72-1b8270968a73",
                                        "entry_id": "a6fa005c-a74d-3b0a-86b5-7bc26d243f68",
                                        "glosses": [
                                            "To spread or disseminate rapidly or uncontrollably."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5682671a-eb06-4bc4-977a-18538beb75b4",
                                                "sense_id": "804403c9-581e-3307-ae72-1b8270968a73",
                                                "text": "The virus spread like wildfire throughout the Internet."
                                            },
                                            {
                                                "example_id": "51d32dd7-3b44-44de-8805-ce19e7b4aad2",
                                                "sense_id": "804403c9-581e-3307-ae72-1b8270968a73",
                                                "text": "The propaganda of the rebels spread like wild-fire, and the hopes of the more daring Irish Catholics rose high."
                                            },
                                            {
                                                "example_id": "afaf5587-4720-4cf1-aa91-acf014c4d394",
                                                "sense_id": "804403c9-581e-3307-ae72-1b8270968a73",
                                                "text": "\"We can sense the tension in Perth,\" wrote the Scotsman, \"when the news spread like wildfire that a runaway engine of ancient vintage was heading north without a soul on the footplate."
                                            },
                                            {
                                                "example_id": "ecf33a72-282d-4d31-8b85-014cb24e28e4",
                                                "sense_id": "804403c9-581e-3307-ae72-1b8270968a73",
                                                "text": "Inspired by Edith Piaf’s 1951 song of the same name, Padam Padam is a reference to the sound of the human heartbeat, and has spread like wildfire thanks to its infectious nature and brevity (it clocks in at 2 mins, 46 seconds)."
                                            },
                                            {
                                                "example_id": "31419b59-fca9-4bd7-ba56-6e51e778ffc5",
                                                "sense_id": "804403c9-581e-3307-ae72-1b8270968a73",
                                                "text": "It became a popular garden plant in the 20th century, when a Chinese variant (Buddleia Davidii ^([sic])) was introduced. That's when the trouble started. The plant has spread like wildfire since. Its fast-growing invasive nature and survivability is a huge problem for the railways, as (left alone) it can cause serious, expensive damage to structures, block drivers sightlines, or pose a risk to lineside workers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
