                        "glosses": [
                            "Personne atteinte ou ayant été atteinte par le chikungunya."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894759d1-f068-4018-924e-d90077c766bd",
                                "sense_id": "9aaf83bb-7cfc-3644-8caa-60a835d0e705",
                                "text": "Il y a les \"chikungunyeux\", qui ont déjà eu la maladie, et sont donc susceptibles de rechuter. Et tous les autres, susceptibles de l'attraper."
                            },
                            {
                                "example_id": "bed0e247-8129-4e64-9262-15cf2dfb737b",
                                "sense_id": "9aaf83bb-7cfc-3644-8caa-60a835d0e705",
                                "text": "Ceci tient au souhait de l'Agence régionale de l'hospitalisation (ARH) de renforcer les services d'urgence et d'éventuellement ouvrir des lits spécialement dévolus à la prise en charge des chikungunyeux ( ou « chikungunyés » ) souvent âgés et polypathologiques. https://web.archive.org/web/20160304124650/http://www.ecole-valdegrace.sante.defense.gouv.fr/IMG/pdf/T35-N3_Medecine_et_armees_-_Juin_2007.pdf"
                            }
                        ]
