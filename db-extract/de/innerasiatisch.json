                ],
                "senses": [
                    {
                        "sense_id": "d656dc20-381a-3a08-a045-82003bced619",
                        "entry_id": "ec6162f9-becc-34ec-a533-76d55882f2c1",
                        "glosses": [
                            "im Inneren des asiatischen Kontinentes befindlich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02cf711b-62e9-43e6-be18-b34829ec0b50",
                                "sense_id": "d656dc20-381a-3a08-a045-82003bced619",
                                "text": "Die Schwerpunkte haben wir jedoch auf archäologisch-kulturgeschichtliche Themen gesetzt – von den Kaisergräbern bis zu den buddhistischen Grotten, von Peking bis an die innerasiatische Westgrenze."
                            },
                            {
                                "example_id": "4150715a-65e4-46f2-890c-145ccaeab85a",
                                "sense_id": "d656dc20-381a-3a08-a045-82003bced619",
                                "text": "Eins der ersten Zeugnisse fuer das Eindringen des innerasiatischen Stroms ist S. Salvatore in Spoleteo (um 400), das in der Fassadenbildung syrisch beeinflusst ist, in Grundrissbildung u. Kuppelgruppierung speziell an Kodja-Kalessi in Lykien erinnert."
                            },
                            {
                                "example_id": "342ee12c-a0cc-43b0-96ea-8c823e93e49f",
                                "sense_id": "d656dc20-381a-3a08-a045-82003bced619",
                                "text": "Die unbewohnten Gegenden des innerasiatischen Alpenzuges bilden die Heimat des Argali."
                            },
                            {
                                "example_id": "4743a352-c0f7-435a-baaa-e0b014107e10",
                                "sense_id": "d656dc20-381a-3a08-a045-82003bced619",
                                "text": "Wenn schon im Tertiär Tierwanderungen aus den einst fruchtbaren innerasiatischen Steppen in westlicher Richtung stattgefunden haben (Gemse und Murmeltier sind solche präglaziale Einwanderer), warum soll sich dann nicht der damals erst hominierende Mensch viele Jahrtausende später gleichfalls diesem ständigen Strom anvertraut haben?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
