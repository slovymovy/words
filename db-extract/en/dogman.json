                ],
                "senses": [
                    {
                        "sense_id": "a5ef1569-0ccc-3afb-b6d4-6564fb5573ce",
                        "entry_id": "a817f98d-1f62-30f3-b29e-3df142a33d5f",
                        "glosses": [
                            "An assistant to a crane operator, responsible for securing the crane's load and directing the operator."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "5b739a11-ce21-45ef-bc1c-d386133581b7",
                                "sense_id": "a5ef1569-0ccc-3afb-b6d4-6564fb5573ce",
                                "text": "Throughout 1970 there were repeated calls, particularly from Brian Hogan and Owens, for the banning of dogmen riding hooks, a demand firmly resisted by employers unwilling to hire the extra dogmen required. Accordingly, during 1972 the union embarked upon a concerted campaign to enforce the use of two dogmen on each crane."
                            },
                            {
                                "example_id": "a1b2fd49-abdb-49d9-8040-13094f5c0022",
                                "sense_id": "a5ef1569-0ccc-3afb-b6d4-6564fb5573ce",
                                "text": "The usual crane crew required for operation of the site was one crane driver and two dogmen, but the BLF insisted that the builder keep a relief crane driver and a relief dogman permanently on site."
                            },
                            {
                                "example_id": "51479c98-7e8a-47c2-ae3c-f7da1871f1fc",
                                "sense_id": "a5ef1569-0ccc-3afb-b6d4-6564fb5573ce",
                                "text": "The only work I had done as a dogman was to use a crane on the back of a truck ‘slinging loads’ and work the crane and truck myself."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
