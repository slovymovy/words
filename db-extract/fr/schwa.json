                                        "glosses": [
                                            "zentraler, mittelhoher Kurzvokal, der in der Lautschrift mit [ə] wiedergegeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7cc636b-b0b6-4e9d-b05b-75300f5a45d8",
                                                "sense_id": "66c281c7-779b-3a37-8e1c-8bcb7e9c50fd",
                                                "text": "Der letzte Laut in Wörtern wie ‚bitte, Tante‘ etc. ist ein Schwa."
                                            },
                                            {
                                                "example_id": "fe07e54a-9193-4e1f-90d9-25daecf420d9",
                                                "sense_id": "66c281c7-779b-3a37-8e1c-8bcb7e9c50fd",
                                                "text": "„Im isländischen Vokalsystem fällt das Fehlen reduzierter Kurzvokale (wie das deutsche Schwa [ə]) sehr auf.“"
                                            },
                                            {
                                                "example_id": "e06946f4-3423-4450-a6dd-f705b12356a8",
                                                "sense_id": "66c281c7-779b-3a37-8e1c-8bcb7e9c50fd",
                                                "text": "„Der häufigste Vokal im Deutschen ist das sogenannte Schwa.“"
                                            }
