                        "entry_id": "2b337208-7113-37a4-9b5a-705a15fe2b1e",
                        "glosses": [
                            "eine Klasse der Partikeln, die den Intensitätsgrad einer Eigenschaft oder eines Sachverhalts ausdrückt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b5334e-09a3-41d3-8192-bf5a8e00220a",
                                "sense_id": "56370420-3cad-3ed6-8988-8926e9584366",
                                "text": "Der Begriff Steigerungspartikel wird in Duden. Die Grammatik. (2005) als bedeutungsgleich mit Gradpartikel und Intensitätspartikel dargestellt."
                            },
                            {
                                "example_id": "84117cb6-8eee-4eb3-b410-39060c420483",
                                "sense_id": "56370420-3cad-3ed6-8988-8926e9584366",
                                "text": "Zu den Steigerungspartikeln gehören u.a. \"sehr\", \"wenig\", \"einigermaßen\", \"überaus\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
