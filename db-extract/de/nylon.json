                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nylon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da3fc15d-b17b-3c10-a6ed-f5ff84db4b84",
                                        "entry_id": "68055198-53c6-34e0-9399-51e461391478",
                                        "glosses": [
                                            "Originally, the DuPont company trade name for polyamide, a copolymer whose molecules consist of alternating diamine and dicarboxylic acid monomers bonded together; now generically used for this type of polymer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c17ae385-1dc8-3028-a23e-aa46adc32c5e",
                                        "entry_id": "68055198-53c6-34e0-9399-51e461391478",
                                        "glosses": [
                                            "A stocking originally fabricated from nylon; also used generically for any long, sheer stocking worn on a woman's legs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6d26353-c67c-4b46-a4b1-4a61dc5ea0f2",
                                                "sense_id": "c17ae385-1dc8-3028-a23e-aa46adc32c5e",
                                                "text": "I tore a hole in my nylons while walking home through the woods."
                                            },
                                            {
                                                "example_id": "1c6cf605-ead4-4858-a7dd-ceae54c39401",
                                                "sense_id": "c17ae385-1dc8-3028-a23e-aa46adc32c5e",
                                                "text": "1970-1975, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nHe put on make-up, nylons, panties, a dress."
                                            },
                                            {
                                                "example_id": "00f9869f-875b-4a26-ab22-6f6ebdac656f",
                                                "sense_id": "c17ae385-1dc8-3028-a23e-aa46adc32c5e",
                                                "text": "What you call love was invented by guys like me, to sell nylons. You're born alone and you die alone and this world just drops a bunch of rules on top of you to make you forget those facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90776faa-9fa6-3c79-b34b-b2f8b6fb4cdd",
                                        "entry_id": "68055198-53c6-34e0-9399-51e461391478",
                                        "glosses": [
                                            "A Queen's Counsel, King's Counsel or Senior Counsel who was appointed as a courtesy, rather than on merit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1db43ad3-79cd-434b-be9d-9647ebd54f66",
                        "source_entry_id": "bcff4bcb-864a-3bec-afef-c585416c3452",
                        "source_sense_id": "3b3b2f57-e001-395b-9ee4-6c32ff41c044",
                        "target_lang_word": "nylon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nylon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d14a2d9-d612-37b3-ad4a-bf3d087ad8e4",
                                        "entry_id": "0cd09199-b057-32ab-8821-ad26f28c5831",
                                        "glosses": [
                                            "Matière plastique de type polyamide inventée par Wallace Carothers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db12851b-c993-4f2e-9e85-ef97794161a1",
                                                "sense_id": "8d14a2d9-d612-37b3-ad4a-bf3d087ad8e4",
                                                "text": "La montre avait un boîtier en plastique et un bracelet en nylon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5574b9c3-232c-3798-a5bd-13c7014b8ad1",
                                        "entry_id": "0cd09199-b057-32ab-8821-ad26f28c5831",
                                        "glosses": [
                                            "Fibre textile de cette matière."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc08fc6b-cf75-4809-9653-a3e2391d382f",
                                                "sense_id": "5574b9c3-232c-3798-a5bd-13c7014b8ad1",
                                                "text": "La voici en combinaison, mais une combinaison d'un nylon si léger que j'aperçois, que je suis obligé d'apercevoir le slip blanc."
                                            },
                                            {
                                                "example_id": "5712d2a8-3ab8-4ba9-989c-6714d3892417",
                                                "sense_id": "5574b9c3-232c-3798-a5bd-13c7014b8ad1",
                                                "text": "En 2015, lors de la 56e édition de la Biennale, l'artiste japonaise Chiharu Shiota, alors âgée de 43 ans, installa dans le pavillon de son pays deux barques en bois prises dans un entrelacs de fils de nylon rouge auxquels étaient suspendues des milliers de clefs. L’oeuvre s’intitulait The Key in the hand. Malgré l’absence de récompense, elle marqua durablement les esprits."
                                            },
                                            {
                                                "example_id": "3760b617-7ce6-4b2e-ad9a-383a37f43cf9",
                                                "sense_id": "5574b9c3-232c-3798-a5bd-13c7014b8ad1",
                                                "text": "« Les prélèvements ont montrés des quantités significatives de fibres de polyester, d'acrylique, de nylon et de prolypropylène », écrit dans un communiqué Imogen Napper, chercheuse à l'université britannique de Plymouth et qui fait partie des explorateurs."
                                            },
                                            {
                                                "example_id": "1e789595-38fe-4385-8943-f291b028e952",
                                                "sense_id": "5574b9c3-232c-3798-a5bd-13c7014b8ad1",
                                                "text": "Sturmer était vêtu d’un slack gris, sorte de pyjama de nylon qu’il étrennait pour la circonstance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f01d1c3-3a25-3845-9e2b-48789234e802",
                                        "entry_id": "0cd09199-b057-32ab-8821-ad26f28c5831",
                                        "glosses": [
                                            "Chemisier nylon."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bd21393-c132-31cb-96a6-23a5dbbdf014",
