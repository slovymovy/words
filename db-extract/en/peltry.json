                        "glosses": [
                            "Pelts or skins, collectively; skins with the fur on them; furs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f074b834-97f8-4181-bcc2-e6695110905a",
                                "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                "text": "...those Indians informed him, that the war was not yet at an end, and that he would live better and with more safety among the French; who, in truth, do much indulge the Indians, and furnish them whatever they desire, because they employ those Indians to kill them beaver, and moose, and other peltry, whereby they gain much."
                            },
                            {
                                "example_id": "7e8883fb-2a35-4fa9-bbf7-c8447296162c",
                                "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                "text": "It has gray hair, and the fleece is sometimes sold with other peltries, but it is not worth much, although it has some odor."
                            },
                            {
                                "example_id": "205914b3-ef7d-4436-bf62-03dd43d668fd",
                                "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                "text": "We met with a party of three hunters from the Sioux river; they had been out for twelve months, and collected about nine hundred dollars worth of peltries and furs."
                            },
                            {
                                "example_id": "b749f8c8-4124-4f28-a2ab-371c4c9a98cb",
                                "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                "text": "Selling his glittering goods at a great advance, he received in exchange valuable peltries and furs at a corresponding reduction."
                            }
                        ]
                    }
