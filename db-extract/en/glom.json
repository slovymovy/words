                                    {
                                        "sense_id": "eb2f9030-db89-3326-a1e4-93278163e7cf",
                                        "entry_id": "464d6ea6-ba6c-3462-b884-00376272b8af",
                                        "glosses": [
                                            "быстро брать что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37002d98-d2f0-434b-9a06-7c8cf6640c87",
                                                "sense_id": "eb2f9030-db89-3326-a1e4-93278163e7cf",
                                                "text": "Мишель пришёл и сказал: «Будешь обега́ть камеру, по дороге хватать и надевать пиджак и шляпу, а на обратном пути снимать и отдавать ассистенту!?»"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "хвата́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff3966a-05c5-3565-86e6-d768d1b9ed67",
                                        "entry_id": "bd524bfc-87a2-3515-9de4-2eacd5712560",
                                        "glosses": [
                                            "быть достаточным"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b29048b-13fa-4f42-a538-dec0d5ace1bf",
                                                "sense_id": "6ff3966a-05c5-3565-86e6-d768d1b9ed67",
                                                "text": "Нефти пока хватает, однако цены на нее не упадут."
                                            }
                                        ]
