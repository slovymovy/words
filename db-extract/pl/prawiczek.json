                    {
                        "translation_id": "edd1aa3d-2b97-4af9-84d5-8e01d5da5ee5",
                        "source_entry_id": "115b71d9-88f9-3bbe-a7f6-4974d022a617",
                        "source_sense_id": "0c4101d5-8d1a-3d50-98a3-317593ec3adf",
                        "target_lang_word": "virgin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virgin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                        "entry_id": "b6ad13e8-c2ab-3520-aabb-06dcb778f629",
                                        "glosses": [
                                            "A person who has never had sexual intercourse, or (uncommonly) an animal that has never mated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c79b9ed3-521f-4da0-ae28-9ca73f963dcb",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "On the other hand, the daughter of a clergyman repeatedly performed fellatio instead of genital intercourse so that she could remain a virgin."
                                            },
                                            {
                                                "example_id": "cd038024-63dd-48de-aeb3-563156309335",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "Could I convert virgins to nymphomania? Masturbators to rakehood? Faithful wives to adulteresses? Seducers to ascetics? Very doubtful. But possible."
                                            },
                                            {
                                                "example_id": "e3f442da-8bb1-4996-8a57-9517051d6f89",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "As the years went on she became extraordinarily effective at fellatio but, despite the fact that she was Mrs James Baylor, age 32, she was still a virgin."
                                            },
                                            {
                                                "example_id": "eb2c1432-545e-43f2-bc0a-818341e6037a",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "among students we studied , 60 % of the virgin females had had oral sex experience"
                                            },
                                            {
                                                "example_id": "8f70c2e0-e44c-47a8-ac29-970b39d74820",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "A girl is a virgin until she experience penis-inside-vagina intercourse"
                                            },
                                            {
                                                "example_id": "cef77c24-7e1b-4d90-ac39-ebf873365ccb",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "26 percent of virgin females have performed fellatio while 87 percent of nonvirgins have done so ."
                                            },
                                            {
                                                "example_id": "5130a4bd-7931-4acb-8456-c211769dcce1",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "I was a virgin. In my senior year of high school, I had experienced one inchoate handjob"
                                            },
                                            {
                                                "example_id": "8485e85b-dd02-410e-81fd-cb774e18ddbf",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "adolescents often define themselves as still a virgin while experimenting with oral sex"
                                            },
                                            {
                                                "example_id": "4ac07850-fc27-4c9e-b291-35f04e736a2a",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "middle-school girls sometimes look at oral sex as an absolute bargain - you don't get pregnant, they think you don't get diseases, you're still a virgin and you're in control"
                                            },
                                            {
                                                "example_id": "3fc9ee07-bf62-4fe5-998a-6afceb246db3",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "Shepard: Are you telling me you're a virgin?\nLiara: \"Virgin\" does not have the same connotation in my culture as in yours. But is is true I have never done this before."
                                            },
                                            {
                                                "example_id": "bd855a10-e047-4b42-b347-dc800129f3a8",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "A Pike High School teen says most teens “think if you have oral sex you are still a virgin."
                                            },
                                            {
                                                "example_id": "136b2503-73c4-4890-bd8f-56b7db3aa9b2",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "she's never actually told the girls she's still a virgin—that the pinnacle of her sexual experience was giving a pretty cruddy handjob to Jared Wells"
                                            },
                                            {
                                                "example_id": "2b6d7cf5-24e8-4dd2-8b71-ee8c1bae73ee",
                                                "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                                                "text": "It's really a miracle I'm still a virgin at twenty-one in the first place. I guess my talent at blowjobs and handjobs paid off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d99e01b-9e2a-3379-80d2-e01baf82f5f1",
                                        "entry_id": "b6ad13e8-c2ab-3520-aabb-06dcb778f629",
                                        "glosses": [
                                            "A person who has never engaged in any sexual activity at all."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                                        "entry_id": "b6ad13e8-c2ab-3520-aabb-06dcb778f629",
                                        "glosses": [
                                            "Someone vowed to virginity (usually a woman and often a consecrated virgin), or someone who died in defense of their virginity; (especially) one venerated as a saint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f115d708-00ac-486a-96e4-093885ea7d6e",
                                                "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                                                "text": "In its list of saints, the Catholic Church classifies St. Agnes, St. Maria Goretti, and St. Thérèse of Lisieux as virgins."
                                            },
                                            {
                                                "example_id": "5eacbb93-ab4b-4c15-b340-b0829695e601",
                                                "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                                                "text": "This was the relation of the order of virgins to the Church from the latter part of the fourth to the beginning of the seventh century. The modern “sister” had no exact prototype in the Church of the first seven centuries."
                                            },
                                            {
                                                "example_id": "a62226e6-8a8c-4730-aee5-f39185eee417",
                                                "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                                                "text": "The list of saints' days and festivals includes a number of the Romish holidays, properly so called, viz.: Lucian, priest and martyr, Jan. 8 ; Hilary, bishop and confessor, Jan. 13 ; Prisca, virgin and martyr, Jan. 18 ; Fabian, bishop and martyr, Jan. 20 ; Agnes, virgin and martyr, Jan. 21 […]"
                                            },
                                            {
                                                "example_id": "2a0c26a8-9be4-406b-a787-10a5aee3cfc8",
                                                "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                                                "text": "It is evident that those from the priesthood are chiefly taken from the order of virgins, or if not from virgins, at least from monks; or if not from the order of monks, then they are wont to be made priests who keep themselves from their wives […]."
                                            },
                                            {
                                                "example_id": "675e0ec0-7de7-4421-b184-267a0ac5c5bc",
                                                "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                                                "text": "It ought to have become apparent, however, that the well-established order of widows was the model for the newly developing order of virgins. Both orders earned their legitimization from the way of life adopted by their members […]"
                                            },
                                            {
                                                "example_id": "ce54f2c5-44a6-426b-a47c-694deef32729",
                                                "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                                                "text": "According to Jerome's account, a young man, who desired to seduce a consecrated virgin of the church, at first attempted to do so through the standard means of seduction: namely, “with touching, jokes, nods, whistles, and the rest” (Vit. Hil. 21.2670–75)."
                                            },
                                            {
                                                "example_id": "0d8d1c8b-a268-4e1d-b92a-ee031bce9358",
                                                "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                                                "text": "Grant, O Lord, I beseech thee, that the Virgin and Martyr, St. Philomena, may solicit thy mercy for us. I implore her intercession, through the merits of her chastity, and by the glory that she gave to thy power, in dying for thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc57bba4-f1c9-32d8-b3f4-033cc1bff1e7",
                                        "entry_id": "b6ad13e8-c2ab-3520-aabb-06dcb778f629",
                                        "glosses": [
                                            "One who has never used or experienced a specified thing."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5882380d-444a-4fcb-abd5-526b8b956f2f",
                                                "sense_id": "fc57bba4-f1c9-32d8-b3f4-033cc1bff1e7",
                                                "text": "I've never eaten tofu before—you could say I'm a tofu virgin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81df151f-d7dd-30e4-b77d-1a44c41a2464",
                                        "entry_id": "b6ad13e8-c2ab-3520-aabb-06dcb778f629",
                                        "glosses": [
                                            "Any of several species of gossamer-winged butterflies of the family Lycaenidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e30f550e-2a1d-3f71-9d6b-271e9d43e5dc",
                                        "entry_id": "b6ad13e8-c2ab-3520-aabb-06dcb778f629",
                                        "glosses": [
                                            "A female insect producing eggs from which young are hatched, though there has been no fecundation by a male; a parthenogenetic insect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "virgin",
