                "senses": [
                    {
                        "sense_id": "8a9d4b41-8948-301e-a3b0-908d7eb57df1",
                        "entry_id": "f0490d80-ca3e-3133-84af-895af1be3600",
                        "glosses": [
                            "porcja nasienia wydzielanego przez osobnika męskiego podczas wytrysku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052b1fab-97ea-45f0-86e4-560fd373f4ab",
                                "sense_id": "8a9d4b41-8948-301e-a3b0-908d7eb57df1",
                                "text": "W jego ejakulacie znaleziono nieprawidłowe plemniki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25669e89-7331-48e3-9d48-f6895d8c62f5",
                        "source_entry_id": "f0490d80-ca3e-3133-84af-895af1be3600",
                        "source_sense_id": "8a9d4b41-8948-301e-a3b0-908d7eb57df1",
                        "target_lang_word": "ejaculate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ejaculate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe671737-f6d3-3895-ac14-ec9f46dbdb9d",
                                        "entry_id": "d577f88b-a14f-3409-9a99-3a14aa1642c1",
                                        "glosses": [
                                            "To eject abruptly; to throw out suddenly and swiftly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73a353cc-c88c-475b-933a-0ec3ddb27387",
                                                "sense_id": "fe671737-f6d3-3895-ac14-ec9f46dbdb9d",
                                                "text": "The mighty Magnet from the Center darts / This ſtrong, tho' ſubtile Force, thro' all the Parts: / Its active Rays ejaculated thence, / Irradiate all the wide Circumference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6de8fdd-9427-3f57-bb94-0518e4fd685e",
                                        "entry_id": "d577f88b-a14f-3409-9a99-3a14aa1642c1",
                                        "glosses": [
                                            "To say abruptly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd73c752-900c-4b63-88ff-4003c83a61e2",
                                                "sense_id": "a6de8fdd-9427-3f57-bb94-0518e4fd685e",
                                                "text": "Vigors almost bounded on the pavement at the mention of the name; and he ejaculated, \"It is he of whom I am in search ! But why do you ask? Is it possible that—\""
                                            },
                                            {
                                                "example_id": "76fd956a-ab36-4fc8-b93f-1dd6eb79f639",
                                                "sense_id": "a6de8fdd-9427-3f57-bb94-0518e4fd685e",
                                                "text": "Lady Feng was at the moment having a little goodhumoured raillery with Yüan Yang, and was taken so much off her guard, that she was quite startled out of her senses. \"Aiyah!\" she ejaculated."
                                            },
                                            {
                                                "example_id": "a6fbfbe6-b6a0-4ea7-8e67-578183ab8008",
                                                "sense_id": "a6de8fdd-9427-3f57-bb94-0518e4fd685e",
                                                "text": "—Half a crown, Stephen responded. I daresay he needs it to sleep somewhere.\n—Needs! Mr Bloom ejaculated, professing not the least surprise at the intelligence, I can quite credit the assertion and I guarantee he invariably does."
                                            },
                                            {
                                                "example_id": "eb178c2d-edc3-4f0d-8274-503b32e95575",
                                                "sense_id": "a6de8fdd-9427-3f57-bb94-0518e4fd685e",
                                                "text": "\"We're not going to use magic?\" Ron ejaculated loudly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb9c736-4d86-35f5-ab7e-3da575403dd5",
                                        "entry_id": "d577f88b-a14f-3409-9a99-3a14aa1642c1",
                                        "glosses": [
                                            "To eject or suddenly throw fluid or some other substance from a duct or other body structure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "242ba516-62b0-4fad-9897-a9b5a079ca35",
                                                "sense_id": "2eb9c736-4d86-35f5-ab7e-3da575403dd5",
                                                "text": "The spermatophores begin to ejaculate immediately after leaving the penis and the whole process is completed in a very few seconds. Pulling the filament attached to the ejaculatory end of a spermatophore is all that is needed to start its ejaculation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc19dbdf-993e-318e-85e2-82b7d3c97914",
                                        "entry_id": "d577f88b-a14f-3409-9a99-3a14aa1642c1",
                                        "glosses": [
                                            "Of a human being or other mammal: to forcibly eject from the urethra in response to sexual stimulation, in a male, semen; and, in a female, vaginal fluid."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "specifically",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aa3e77a-be32-4f03-8b5a-512533b20472",
                                                "sense_id": "fc19dbdf-993e-318e-85e2-82b7d3c97914",
                                                "text": "Men can ejaculate between 0.1 and 10 milliliters of semen on average."
                                            },
                                            {
                                                "example_id": "8d73c163-cd9f-4e4e-928b-23f2b93f45a7",
                                                "sense_id": "fc19dbdf-993e-318e-85e2-82b7d3c97914",
                                                "text": "With a groan, he ejaculated on his abdomen."
                                            },
                                            {
                                                "example_id": "10edbce3-30ee-4055-afca-a34ad490d015",
                                                "sense_id": "fc19dbdf-993e-318e-85e2-82b7d3c97914",
                                                "text": "[I]n controlled studies some men have been observed to ejaculate but not have orgasm or have orgasm but are unable to ejaculate."
                                            },
                                            {
                                                "example_id": "ef96d039-3d50-4610-a709-d607dab3d8f4",
                                                "sense_id": "fc19dbdf-993e-318e-85e2-82b7d3c97914",
                                                "text": "The knowledge that some women ejaculate at the moment of orgasm was, like many other important aspects of sexuality, buried by Puritanism and patriarchy."
                                            },
                                            {
                                                "example_id": "5f97e27c-73e8-420c-a004-c8832040db45",
                                                "sense_id": "fc19dbdf-993e-318e-85e2-82b7d3c97914",
                                                "text": "However, it would be highly useful if the ejaculated spermatozoa could be successfully cryopreserved and the frozen-thawed spermatozoa used for in vitro fertilization, since this would allow the genetically valuable rats to be maintained alive rather than sacrificed."
                                            },
                                            {
                                                "example_id": "fcd15bd8-44e6-4006-95af-756fd2775524",
                                                "sense_id": "fc19dbdf-993e-318e-85e2-82b7d3c97914",
                                                "text": "Bulls, rams and boars have the biggest testes among the larger domestic animals, so they would be expected to produce and ejaculate more sperms than others with smaller testes."
                                            },
                                            {
                                                "example_id": "c39a6f8b-8677-4e09-b73a-1ef7275dd69d",
                                                "sense_id": "fc19dbdf-993e-318e-85e2-82b7d3c97914",
                                                "text": "Rather, these men prefer an erotic exhibition – an uninhibited display of ejaculating semen onto themselves or someone else."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d81c9edd-41c3-3c23-9e34-eb42e89829e3",
                                        "entry_id": "d577f88b-a14f-3409-9a99-3a14aa1642c1",
                                        "glosses": [
                                            "To sexually stimulate (someone) so that they eject fluid from the urethra."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e33e73e3-f2d9-43c2-84e6-da0661fa0c43",
                                                "sense_id": "d81c9edd-41c3-3c23-9e34-eb42e89829e3",
                                                "text": "Porn teaches men that sex is a completely selfish act, where the other party has no humanity, she only exists to ejaculate him. The only pleasure she has is in pleasuring him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ejaculate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48076082-e1ca-3d62-9287-5d5217cbe6ad",
                                        "entry_id": "1011a2f4-9f52-3747-8fa8-f880399795b3",
                                        "glosses": [
                                            "Fluid or some other substance ejected or suddenly thrown from a duct or other body structure; specifically, semen or vaginal fluid ejected by a human being or other mammal during an ejaculation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7effd723-af71-4439-acd7-9a0e35f27a5e",
                                                "sense_id": "48076082-e1ca-3d62-9287-5d5217cbe6ad",
                                                "text": "If semen from two ejaculates obtained from one bull is mixed, and the conception rate for the mixed sample is compared with that obtained by the use of the two ejaculates independently, any tendency for the mixed sample's conception rate to be closer to that of either of the two individual ejaculates could be used as a sensitive measure of the relationship between the semen characteristics of the two ejaculates and conception rate."
                                            },
                                            {
                                                "example_id": "e39f7341-4975-405b-b2bf-a9e2e521e65a",
                                                "sense_id": "48076082-e1ca-3d62-9287-5d5217cbe6ad",
                                                "text": "The ejaculate usually spurts out as the prostate gland and surrounding muscles, as well as those at the base of the penis, contract at orgasm. In young males, the force of the spurt can be strong enough for the ejaculate to hit the upper chest; in older males, it may roll out or go an inch or two up the abdomen."
                                            },
                                            {
                                                "example_id": "a3dec0f9-26ed-40f3-b034-c94b9719621a",
                                                "sense_id": "48076082-e1ca-3d62-9287-5d5217cbe6ad",
                                                "text": "Female ejaculate is a clear liquid. Its consistency is akin to that of very light lubricant, but it is watery rather than slick. […] [B]oth women's and men's ejaculate is prostatic fluid (that is, both are created by the prostate)."
                                            },
                                            {
                                                "example_id": "30e69734-98fa-4fd6-9b88-cbf5e00f0b89",
                                                "sense_id": "48076082-e1ca-3d62-9287-5d5217cbe6ad",
                                                "text": "A smaller mammal such as a dog has a sperm concentration of 300 000 000 per millilitre in an ejaculate of 8 ml in volume. Thus, each ejaculate will contain only 2 400 000 000 (24 × 10⁸)."
                                            },
                                            {
                                                "example_id": "f9425f71-95b0-46c5-9a4c-c21ef2838b98",
                                                "sense_id": "48076082-e1ca-3d62-9287-5d5217cbe6ad",
                                                "text": "Ejaculates are costly to produce for human males. Frequent ejaculation, especially more frequent than every other day, results in decreased sperm counts […], suggesting limits to sperm production. Men hardly seem limited by sperm production, however, given the apparent wastage of sperm. Sperm are continuously lost in the urine, and entire ejaculates are lost during nocturnal emissions and masturbation, although masturbatory ejaculates contain fewer sperm than do copulatory ejaculates […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
