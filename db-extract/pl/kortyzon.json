                                "target_senses": [
                                    {
                                        "sense_id": "663ae2b7-da53-32af-b490-b332fdec6c17",
                                        "entry_id": "55f27422-cfce-36ac-8202-b4589cf763ec",
                                        "glosses": [
                                            "inaktivierte Form des Glucocorticoids Cortisol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b694ab1b-be29-4e3e-86f1-c3fcdda04649",
                                                "sense_id": "663ae2b7-da53-32af-b490-b332fdec6c17",
                                                "text": "„Lea Hallers Buch über den weltweiten Erfolg des Hormons Cortison ist mehr als die Wissenschaftsgeschichte eines Medikaments.“"
                                            },
                                            {
                                                "example_id": "1d3d412c-7442-49b3-ade4-f1e9566ffc23",
                                                "sense_id": "663ae2b7-da53-32af-b490-b332fdec6c17",
                                                "text": "„Bis dann die viel breiter wirksame, schließlich als Cortison bezeichnete Substanz von 1950 an ihre verblüffende Wirksamkeit unter Beweis stellen durfte, vergingen nicht nur Jahre der Forschung.“"
                                            },
                                            {
                                                "example_id": "4d7ea8e0-57a9-4d7f-89c7-3b144552f682",
                                                "sense_id": "663ae2b7-da53-32af-b490-b332fdec6c17",
                                                "text": "„Der geständige Dopingsünder Patrik Sinkewitz hat eingeräumt, noch in diesem Jahr mit Cortison behandelt worden zu sein.“"
                                            },
                                            {
                                                "example_id": "3f614e3e-e4ff-4986-bcd9-ff6d83c6032d",
                                                "sense_id": "663ae2b7-da53-32af-b490-b332fdec6c17",
                                                "text": "„Von dem kleinen Mann (er schrumpfte wegen der Nebenwirkungen des Cortisons im Laufe seines zweiten Lebens von 1,73 auf 1,55 Meter) gingen Zuversicht und Lebensfreude aus; ganz Marseille liebte ihn.“"
                                            },
                                            {
                                                "example_id": "879134ca-2bc7-488f-a183-9dc38ec85121",
                                                "sense_id": "663ae2b7-da53-32af-b490-b332fdec6c17",
                                                "text": "„Diese haben den unschätzbaren Vorteil, dass sich die anti-entzündliche Wirkung des Cortisons nahezu ausschließlich in der Schleimhaut der Atemwege abspielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
