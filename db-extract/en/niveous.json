                "senses": [
                    {
                        "sense_id": "fa4b344f-ef58-3a68-9b3c-51712521e571",
                        "entry_id": "1fcc97ff-a157-3836-80ff-4a335e7740e1",
                        "glosses": [
                            "Snowy; resembling snow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8533bb1-e623-4d98-9f41-32b8c11b6f4e",
                                "sense_id": "fa4b344f-ef58-3a68-9b3c-51712521e571",
                                "text": "So Cinabar becomes red by the acide exhalation of sulphur, which otherwise presents a pure and niveous white."
                            },
                            {
                                "example_id": "346f3356-b97a-42b5-8379-dfa43f3a7c24",
                                "sense_id": "fa4b344f-ef58-3a68-9b3c-51712521e571",
                                "text": "One solitary author, Beckman, declares that he saw niveous crystallizations in the form of hexangular pillars, that they occurred at Frankfort, upon the Oder, in 1667."
                            },
                            {
                                "example_id": "1726c8fb-67b8-4f8d-9816-deb57a389241",
                                "sense_id": "fa4b344f-ef58-3a68-9b3c-51712521e571",
                                "text": "Shining to polished with some metallic colors except the cinereous face which is more niveous on the parafacies, and is slightly dusted on the dorsal surfaces, excepting the two apical tergites."
                            }
                        ]
                    }
                ],
