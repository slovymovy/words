{
    "word_family": [
        "physically",
        "physicality",
        "physician",
        "physicist",
        "physics",
        "physique"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "88e0d1c0-434a-397f-8d82-8d7d90afdd79",
                    "sense_definition": "Having to do with the body as opposed to the mind.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "body_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise is essential for maintaining good <w>physical</w> health.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения необходимы для поддержания хорошего <w>физического</w> здоровья.",
                                "zh": "规律的锻炼对于保持良好的<w>身体</w>健康至关重要。"
                            }
                        },
                        {
                            "text": "She has great <w>physical</w> strength for someone her age.",
                            "target_lang_translations": {
                                "ru": "У неё большая <w>физическая</w> сила для её возраста.",
                                "zh": "以她的年纪来说，她拥有惊人的<w>体力</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "mental",
                        "psychological"
                    ],
                    "common_phrases": [
                        "physical health",
                        "physical education",
                        "physical strength",
                        "physical appearance",
                        "physical fitness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с телом, в отличие от разума или чувств.",
                        "zh": "与身体有关，而非与心理或情感有关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "физический",
                                "target_lang_sense_clarification": "относящийся к телу"
                            },
                            {
                                "target_lang_word": "телесный",
                                "target_lang_sense_clarification": "связанный с организмом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身体的",
                                "target_lang_sense_clarification": "指与身体相关的"
                            },
                            {
                                "target_lang_word": "生理的",
                                "target_lang_sense_clarification": "指生理机能方面的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16798d3c-4bd2-304f-8675-0818e9800068",
                    "sense_definition": "Pertaining to the material world as understood through the senses; tangible, concrete, and real.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "matter_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>physical</w> evidence to support the claim that he was there.",
                            "target_lang_translations": {
                                "ru": "Нет никаких <w>вещественных</w> доказательств, подтверждающих утверждение, что он был там.",
                                "zh": "没有<w>实物</w>证据支持他当时在场的说法。"
                            }
                        },
                        {
                            "text": "We live in a <w>physical</w> world governed by natural laws.",
                            "target_lang_translations": {
                                "ru": "Мы живем в <w>материальном</w> мире, управляемом законами природы.",
                                "zh": "我们生活在一个受自然规律支配的<w>物质</w>世界中。"
                            }
                        }
                    ],
                    "antonyms": [
                        "spiritual"
                    ],
                    "common_phrases": [
                        "physical world",
                        "physical evidence",
                        "physical object",
                        "physical presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к материальному миру; осязаемый, конкретный и реальный.",
                        "zh": "属于物质世界的；可感知的、具体的、真实的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материальный",
                                "target_lang_sense_clarification": "вещественный, не духовный"
                            },
                            {
                                "target_lang_word": "вещественный",
                                "target_lang_sense_clarification": "осязаемый, предметный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "物质的",
                                "target_lang_sense_clarification": "指客观存在的物质"
                            },
                            {
                                "target_lang_word": "实体的",
                                "target_lang_sense_clarification": "指有形可触的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d99235e3-1679-3726-9b6c-862d4b910745",
                    "sense_definition": "Relating to the natural sciences, especially physics and the laws of nature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matter_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gravity is a fundamental <w>physical</w> force that affects everything on Earth.",
                            "target_lang_translations": {
                                "ru": "Гравитация — это фундаментальная <w>физическая</w> сила, которая влияет на всё на Земле.",
                                "zh": "重力是一种影响地球上万物的基本<w>物理</w>力。"
                            }
                        },
                        {
                            "text": "The scientists studied the <w>physical</w> properties of the new metal alloy.",
                            "target_lang_translations": {
                                "ru": "Ученые изучали <w>физические</w> свойства нового металлического сплава.",
                                "zh": "科学家们研究了这种新型金属合金的<w>物理</w>特性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "physical properties",
                        "physical laws",
                        "physical science",
                        "physical change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к естественным наукам, особенно к физике и законам природы.",
                        "zh": "与自然科学，特别是物理学及自然规律相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "физический",
                                "target_lang_sense_clarification": "относящийся к физике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "物理的",
                                "target_lang_sense_clarification": "指物理学范畴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aba997c0-db83-315f-a51e-861cd6f72525",
                    "sense_definition": "Involving bodily force or contact; vigorous and aggressive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rugby is a very <w>physical</w> sport that requires toughness.",
                            "target_lang_translations": {
                                "ru": "Регби — это очень <w>контактный</w> вид спорта, требующий выносливости.",
                                "zh": "橄榄球是一项需要强硬素质的、对抗性很强的<w>身体接触</w>运动。"
                            }
                        },
                        {
                            "text": "The defenders played a <w>physical</w> game to stop the opposing team from scoring.",
                            "target_lang_translations": {
                                "ru": "Защитники вели <w>силовую</w> игру, чтобы не дать команде противника забить.",
                                "zh": "防守队员通过<w>身体对抗</w>来阻止对方球队得分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "physical game",
                        "physical contact",
                        "physical sport"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с применением физической силы или телесным контактом; энергичный.",
                        "zh": "涉及身体力量或肢体接触的；剧烈且具有攻击性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контактный",
                                "target_lang_sense_clarification": "о спорте"
                            },
                            {
                                "target_lang_word": "силовой",
                                "target_lang_sense_clarification": "с применением силы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身体接触的",
                                "target_lang_sense_clarification": "指运动中涉及肢体碰撞"
                            },
                            {
                                "target_lang_word": "对抗性的",
                                "target_lang_sense_clarification": "指比赛中强调力量对抗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6590cf77-534e-3a25-ad15-983a0220f396",
                    "sense_definition": "Relating to sexual or carnal interaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their relationship became <w>physical</w> after they had been dating for a month.",
                            "target_lang_translations": {
                                "ru": "Их отношения стали <w>интимными</w> через месяц свиданий.",
                                "zh": "他们约会一个月后，关系变得<w>亲密</w>起来。"
                            }
                        },
                        {
                            "text": "He wanted to get <w>physical</w>, but she preferred to take things slowly.",
                            "target_lang_translations": {
                                "ru": "Он хотел <w>физической</w> близости, но она предпочла не торопить события.",
                                "zh": "他想有进一步的<w>身体接触</w>，但她更希望慢慢来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get physical",
                        "physical relationship",
                        "physical attraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к сексуальному или плотскому взаимодействию.",
                        "zh": "与性或肉体互动相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интимный",
                                "target_lang_sense_clarification": "сексуальный"
                            },
                            {
                                "target_lang_word": "плотский",
                                "target_lang_sense_clarification": "чувственный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲密的",
                                "target_lang_sense_clarification": "指身体上的亲密关系"
                            },
                            {
                                "target_lang_word": "肉体的",
                                "target_lang_sense_clarification": "指涉及肉体接触的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d1b1198-d5c5-345f-ae44-9ca7f7ac3d96",
                    "sense_definition": "Denoting a map showing natural features of the landscape, such as mountains and rivers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "matter_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>physical</w> map helps you understand the terrain of the region.",
                            "target_lang_translations": {
                                "ru": "<w>Физическая</w> карта помогает понять рельеф региона.",
                                "zh": "<w>自然地理</w>图有助于你了解该地区的地形。"
                            }
                        },
                        {
                            "text": "In geography class, we compared a political map with a <w>physical</w> one.",
                            "target_lang_translations": {
                                "ru": "На уроке географии мы сравнивали политическую карту с <w>физической</w>.",
                                "zh": "在地理课上，我们对比了政区图和<w>自然地理</w>图。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "physical map",
                        "physical geography"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначающий карту, показывающую природные особенности ландшафта.",
                        "zh": "指显示山脉、河流等自然地貌的地图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "физический",
                                "target_lang_sense_clarification": "о географической карте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自然地理的",
                                "target_lang_sense_clarification": "指地图类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71637f95-ac16-3f0a-81cf-1137798325fc",
                    "sense_definition": "Pertaining to the field of medicine or medicinal remedies.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text described a <w>physical</w> remedy for the fever.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывал <w>лечебное</w> средство от лихорадки.",
                                "zh": "那本古籍记载了一种治疗发烧的<w>医疗</w>方法。"
                            }
                        },
                        {
                            "text": "He sought <w>physical</w> assistance from the local healer.",
                            "target_lang_translations": {
                                "ru": "Он искал <w>врачебной</w> помощи у местного целителя.",
                                "zh": "他向当地的治疗师寻求<w>医疗</w>援助。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "meaning related to medicine or doctors"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к области медицины или лечебных средств.",
                        "zh": "与医学或治疗手段相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечебный",
                                "target_lang_sense_clarification": "целебный"
                            },
                            {
                                "target_lang_word": "врачебный",
                                "target_lang_sense_clarification": "медицинский"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "医疗的",
                                "target_lang_sense_clarification": "指与治疗相关的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15687f3c-21ae-3c0d-8bcc-e9b09f150dc2",
                    "sense_definition": "A medical examination to determine a person's bodily health.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to schedule an appointment for my annual <w>physical</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужно записаться на ежегодный <w>медосмотр</w>.",
                                "zh": "我需要预约一次年度<w>体检</w>。"
                            }
                        },
                        {
                            "text": "The doctor gave him a complete <w>physical</w> before clearing him for the team.",
                            "target_lang_translations": {
                                "ru": "Врач провел полный <w>медицинский осмотр</w>, прежде чем допустить его в команду.",
                                "zh": "医生在批准他加入球队前，为他做了全面的<w>体检</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "checkup"
                    ],
                    "common_phrases": [
                        "annual physical",
                        "routine physical",
                        "sports physical",
                        "complete physical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский осмотр для определения состояния здоровья человека.",
                        "zh": "为确定个人身体健康状况而进行的医学检查。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медосмотр",
                                "target_lang_sense_clarification": "проверка здоровья"
                            },
                            {
                                "target_lang_word": "медицинский осмотр",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体检",
                                "target_lang_sense_clarification": "身体检查的简称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}