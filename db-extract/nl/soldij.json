                    {
                        "translation_id": "5df95b69-09cd-4bac-b3cd-c44f85596fe3",
                        "source_entry_id": "035ecbd3-4a2b-336c-a693-83b92ab2c61a",
                        "source_sense_id": "67a21c7b-a9f6-36ec-9b34-022b4d70ff62",
