        "fr-extract.jsonl": [
            {
                "entry_id": "d8e60a6d-8581-39b6-b7fa-6d5fa1e5cf98",
                "word": "extorsion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "442c40a5-5ff7-4345-bc3a-b9bdc55beab6",
                        "entry_id": "d8e60a6d-8581-39b6-b7fa-6d5fa1e5cf98",
                        "tags": [
                            "plural"
                        ],
                        "form": "extorsions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06d8fd00-08bf-3a05-9912-4aaf53f58fd1",
                        "entry_id": "d8e60a6d-8581-39b6-b7fa-6d5fa1e5cf98",
                        "glosses": [
                            "Action d’extorquer, d'obtenir par la force, le chantage, l'intimidation ou tout autre moyen de pression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bcf2a97-3165-4cd1-9b57-d0e096e21778",
                                "sense_id": "06d8fd00-08bf-3a05-9912-4aaf53f58fd1",
                                "text": "La cause de ces insurrections est presque toujours la même : les exactions, les extorsions et mille autres injustices commises par les caïds (gouverneurs) qui, ayant acheté leur poste, ne songent qu'à rentrer dans leurs fonds et à s'enrichir aux dépens de leurs administrés."
                            },
                            {
                                "example_id": "738259b3-b528-4d66-b3e4-42d42b665505",
                                "sense_id": "06d8fd00-08bf-3a05-9912-4aaf53f58fd1",
                                "text": "Et j’en passe. Le bouquet, c’est l’énumération de mes récentes tentatives d’extorsion de fonds."
                            },
                            {
                                "example_id": "3d37bba9-d191-4055-b667-c5b66d63c395",
                                "sense_id": "06d8fd00-08bf-3a05-9912-4aaf53f58fd1",
                                "text": "Père de trois enfants, dont une fillette, Frantz Louis était connu des autorités comme étant lié à la mafia, ayant notamment été accusé en juillet dans une affaire d’extorsion."
                            }
                        ]
                    },
                    {
                        "sense_id": "523136c5-632f-39ee-b9cc-d47552933380",
                        "entry_id": "d8e60a6d-8581-39b6-b7fa-6d5fa1e5cf98",
                        "glosses": [
                            "Rotation du globe oculaire vers la tempe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a03c6291-9a35-4074-9d90-d2899b722d14",
                                "sense_id": "523136c5-632f-39ee-b9cc-d47552933380",
                                "text": "Une telle atteinte provoque une extorsion du globe oculaire et diminue la capacité à porter le regard vers le bas. C'est la raison pour laquelle les patients , qui ont une atteinte du nerf pathétique, signalent leurs difficultés à descendre un escalier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11006231-f404-433e-bd13-cb471012216d",
                        "source_entry_id": "d8e60a6d-8581-39b6-b7fa-6d5fa1e5cf98",
                        "source_sense_id": "06d8fd00-08bf-3a05-9912-4aaf53f58fd1",
                        "source_sense_description": "Action d’extorquer",
                        "target_lang_word": "Erpressung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erpressung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                        "entry_id": "f1067bb8-0067-3af1-bf8d-9ceebfcfecef",
                                        "glosses": [
                                            "kriminelles, illegales Erzwingen eines Verhaltens oder einer Leistung durch Androhung negativer Konsequenzen bei Nichterfüllung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e4d06b-32aa-4961-96f5-fdbfb8626b4f",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Jeder Erpressung hat ihren Keim in krimineller Energie und persönlicher Vorteilnahme, und liegt im Glaube des Erpressten, diese anzunehmen oder gleichsam mit Nachdruck zu erwidern und gnadenlos zu ahnden."
                                            },
                                            {
                                                "example_id": "93fa96b9-4bb1-41cf-8c92-349d1f2cf532",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Es gibt viele Formen der Erpressung, jedoch haben alle einen gemeinsamen Charakter: „Tu dieses nicht, dann tue ich jenes nicht … also gehorche mir und es wird Dir nichts geschehen!“"
                                            },
                                            {
                                                "example_id": "5bd4ebd9-1512-49d4-9973-75c070dfb201",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Auch in einer freien Gesellschaft, ist die Erpressung ein probates Mittel, also die Fortführung einer Politik oder einer berechtigten/unberechtigten Forderung … nur mit anderen Mittel .. bis hin zum Totalverlust."
                                            },
                                            {
                                                "example_id": "20ba2dba-34e6-4446-82ac-92a74bbfff0f",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "„Ich helfe also dem indischen Staat, indem ich einen Akt von Erpressung und Korruption unterlaufe.“"
                                            },
                                            {
                                                "example_id": "48662c86-3342-42a0-b076-a81d24ad2371",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "„Er hatte sich schon an die Erpressungen gewöhnt, die alle halbe Stunde auf ihn niederprasselten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f393e71e-fad5-4e71-9d76-2a1b82a95c89",
                        "source_entry_id": "d8e60a6d-8581-39b6-b7fa-6d5fa1e5cf98",
