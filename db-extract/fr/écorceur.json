                "senses": [
                    {
                        "sense_id": "adf6c30b-980e-3ba8-a199-8bb1dce98dbf",
                        "entry_id": "4b2e2081-018f-37c4-974d-6bb6db4b2f66",
                        "glosses": [
                            "Personne dont le métier est d’enlever l’écorce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "224356e1-ed7e-4b6a-bb47-a41bb5548e3e",
                                "sense_id": "adf6c30b-980e-3ba8-a199-8bb1dce98dbf",
                                "text": "Il fut un paysan avisé, un berger compétent et exerça tous les métiers liés à la forêt : charbonnier, bûcheron, écorceur, plâtrier, il fut aussi fabricant de chaux et de colle."
                            },
                            {
                                "example_id": "091ee28a-883b-40a4-944f-320dbc273210",
                                "sense_id": "adf6c30b-980e-3ba8-a199-8bb1dce98dbf",
                                "text": "Le travail de l’historien peut alors se comparer à celui de l’écailleur de noix ou de l’écorceur de châtaignes ; il extrait le fruit, prêt à être consommé, de son enveloppe gênante ou désagréable."
                            }
                        ]
                    },
                    {
                        "sense_id": "da053321-8fdb-36b4-951e-eb729026b007",
                        "entry_id": "4b2e2081-018f-37c4-974d-6bb6db4b2f66",
                        "glosses": [
                            "Machine à écorcer, à enlever l’écorce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f56b532-6efb-41b8-b2f8-d83e881efab7",
                                "sense_id": "da053321-8fdb-36b4-951e-eb729026b007",
                                "text": "Cet instrument est un écorceur rotatif à cinq couteaux qui ont tôt fait de libérer leur invité de son manteau d’écorce."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3209baa-2e05-3d47-878f-7b2f3679fe63",
                        "entry_id": "4b2e2081-018f-37c4-974d-6bb6db4b2f66",
                        "glosses": [
                            "Dispositif auxiliaire d’un appareil thermonucléaire toroïdal destiné à dévier les particules chargées de la paroi de la chambre de décharge vers une chambre séparée où elles frappent une barrière, deviennent neutres et sont évacuées."
                        ],
