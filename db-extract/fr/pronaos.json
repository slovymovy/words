                "senses": [
                    {
                        "sense_id": "b3ffaa62-a677-3916-8a71-3bfeb98594cd",
                        "entry_id": "62b4878e-c3ec-3eac-9672-e5cef41f8f28",
                        "glosses": [
                            "Partie antérieure des temples anciens."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "9d39a2a9-80f6-4743-a382-9feab8aa7c12",
                                "sense_id": "b3ffaa62-a677-3916-8a71-3bfeb98594cd",
                                "text": "Le temple de Minerve, par exemple, est ou plutôt était un simple parallélogramme allongé, orné d’un péristyle, d’un pronaos ou portique."
                            },
                            {
                                "example_id": "c8da9f7d-e98e-4907-99e1-88e96f04776d",
                                "sense_id": "b3ffaa62-a677-3916-8a71-3bfeb98594cd",
                                "text": "On entre dans une salle (pronaos) appuyée sur huit piliers, contre chacun desquels s'adosse un colosse de trente pieds de haut, qui est encore un portrait de Ramsès-Sésostris."
                            },
                            {
                                "example_id": "aecdec58-88f7-43e3-b9cd-2e1c4478d923",
                                "sense_id": "b3ffaa62-a677-3916-8a71-3bfeb98594cd",
                                "text": "Les piliers verticaux et le fronton triangulaire du majestueux pronaos masquaient à ses yeux le grand dôme qui surplombe la rotonde."
                            }
                        ]
                    }
                ],
