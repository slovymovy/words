                                "sense_id": "b8d0c6ff-bf4a-3a08-916d-0a28a866df1b",
                                "text": "Als kind moest ik elke dag een lepel levertraan innemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b35d7aa-525e-4c16-ac25-0b456b3e20ed",
