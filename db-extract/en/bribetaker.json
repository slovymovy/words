                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c99f0605-85f9-4c22-ae9a-68f51d08b696",
                                                "sense_id": "dae81879-daec-3076-9f16-5cd6098653e0",
                                                "text": "Le parti adverse est un parti de concussionnaires, d’ennemis du peuple, traîtres à la patrie, vendus à l’ennemi, à quelque parti que tu appartiennes […]"
                                            },
                                            {
                                                "example_id": "ad4d580a-2ad6-4121-9010-f09dbbde2481",
                                                "sense_id": "dae81879-daec-3076-9f16-5cd6098653e0",
                                                "text": "— Un filou, qu’il est, une âme vénale, un concussionnaire, un gredin, il a pillé le Trésor !"
                                            }
                                        ]
                                    }
                                ]
                            },
