                    {
                        "translation_id": "ed0a10b8-f8d7-4d6c-b164-2f6b13ee8acf",
                        "source_entry_id": "3ca33500-05f0-381f-850a-c44190d82055",
                        "source_sense_id": "f50f0769-8f19-3824-92c3-aee34fa51d66",
