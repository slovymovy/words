                ],
                "senses": [
                    {
                        "sense_id": "d94b45eb-a247-33e0-9e18-2d9b3651dbfa",
                        "entry_id": "efc0fa52-5340-3a1d-8edd-e8b23d06704a",
                        "glosses": [
                            "бросившись, напасть на кого-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62d098d4-297a-46e8-9cbb-7e3107600c30",
                                "sense_id": "d94b45eb-a247-33e0-9e18-2d9b3651dbfa",
                                "text": "Собака набросилась на незнакомца."
                            },
                            {
                                "example_id": "98da4a49-9476-4cda-a893-74d222e8bdb7",
                                "sense_id": "d94b45eb-a247-33e0-9e18-2d9b3651dbfa",
                                "text": "И нашли они в горах терем Дыя. В этом тереме жили Дый и его слуги — дивы. Как они увидели Мана, так набросились на него."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f832ea6-0c3f-300b-98b1-c8b9f0d0abad",
                        "entry_id": "efc0fa52-5340-3a1d-8edd-e8b23d06704a",
                        "glosses": [
                            "с жадностью, со страстью сосредоточить внимание на ком-чем-нибудь, приняться за кого-что-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f914ddc7-858b-4281-bd8c-5b0ecda934c4",
                                "sense_id": "3f832ea6-0c3f-300b-98b1-c8b9f0d0abad",
                                "text": "Наброситься на еду. Наброситься на новую книгу."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f615eb0-6c1e-3e01-bbe9-6e84935e09b4",
                        "entry_id": "efc0fa52-5340-3a1d-8edd-e8b23d06704a",
                        "glosses": [
                            "вдруг или с жаром начать бранить, упрекать, преследовать кого-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bca9b15-2c23-4b2f-a72d-9d3b74dc17ab",
                                "sense_id": "6f615eb0-6c1e-3e01-bbe9-6e84935e09b4",
                                "text": "Какие вы мне вещи приносили? — набросилась на него Паша."
                            }
                        ]
                    }
                ],
