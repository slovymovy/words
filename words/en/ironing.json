{
    "word_family": [
        "iron",
        "ironer",
        "ironboard"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24e8d78b-55bb-3597-9973-7bb35e2edc4f",
                    "sense_definition": "The act of pressing clothes with an iron.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ironing_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually do the <w>ironing</w> on Sunday evenings while watching television.",
                            "target_lang_translations": {
                                "ru": "Обычно я занимаюсь <w>глажкой</w> по воскресным вечерам во время просмотра телевизора.",
                                "zh": "我通常在周日晚上边看电视边<w>熨烫</w>衣物。"
                            }
                        },
                        {
                            "text": "She finds doing the <w>ironing</w> to be a very relaxing household chore.",
                            "target_lang_translations": {
                                "ru": "Она считает <w>глажку</w> очень расслабляющей домашней обязанностью.",
                                "zh": "她觉得<w>熨烫</w>是一项非常放松的家务。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "do the ironing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс разглаживания одежды утюгом.",
                        "zh": "使用熨斗平整衣物的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глажка",
                                "target_lang_sense_clarification": "разговорное обозначение процесса"
                            },
                            {
                                "target_lang_word": "глажение",
                                "target_lang_sense_clarification": "официальное или нейтральное обозначение процесса"
                            },
                            {
                                "target_lang_word": "утюжка",
                                "target_lang_sense_clarification": "профессиональное или разговорное обозначение процесса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "熨烫",
                                "target_lang_sense_clarification": "指平整衣物的动作或过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc992696-fcca-39f6-9187-fd7992d2f4e6",
                    "sense_definition": "Laundry that needs to be ironed, or has recently been ironed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ironing_clothes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a huge pile of <w>ironing</w> waiting for me in the laundry room.",
                            "target_lang_translations": {
                                "ru": "В прачечной меня ждет огромная куча <w>белья для глажки</w>.",
                                "zh": "洗衣房里有一大堆<w>待熨衣物</w>等着我。"
                            }
                        },
                        {
                            "text": "Please help me put the <w>ironing</w> away in the wardrobe.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, помоги мне убрать <w>выглаженное бельё</w> в шкаф.",
                                "zh": "请帮我把<w>熨好的衣物</w>放进衣柜里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "laundry"
                    ],
                    "common_phrases": [
                        "pile of ironing",
                        "put the ironing away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Белье, которое необходимо погладить или которое было недавно выглажено.",
                        "zh": "需要熨烫或刚熨烫好的衣物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бельё для глажки",
                                "target_lang_sense_clarification": "вещи, которые нужно погладить"
                            },
                            {
                                "target_lang_word": "выглаженное бельё",
                                "target_lang_sense_clarification": "уже поглаженные вещи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "待熨衣物",
                                "target_lang_sense_clarification": "指需要进行熨烫的衣物"
                            },
                            {
                                "target_lang_word": "熨好的衣物",
                                "target_lang_sense_clarification": "指已经完成熨烫的衣物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f01ae9de-48f0-391f-833d-17a666230b37",
                    "sense_definition": "present participle and gerund of <w>iron</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>ironing</w> his shirt when the phone suddenly rang.",
                            "target_lang_translations": {
                                "ru": "Он <w>гладил</w> свою рубашку, когда вдруг зазвонил телефон.",
                                "zh": "他正在<w>熨</w>衬衫时，电话突然响了。"
                            }
                        },
                        {
                            "text": "I dislike <w>ironing</w> delicate silk fabrics because they burn easily.",
                            "target_lang_translations": {
                                "ru": "Я не люблю <w>гладить</w> деликатные шелковые ткани, потому что они легко прожигаются.",
                                "zh": "我不喜欢<w>熨</w>娇贵的丝绸面料，因为它们很容易被烫坏。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола iron (гладить).",
                        "zh": "动词 iron 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гладить",
                                "target_lang_sense_clarification": "действие по значению глагола"
                            },
                            {
                                "target_lang_word": "утюжить",
                                "target_lang_sense_clarification": "действие по значению глагола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "熨",
                                "target_lang_sense_clarification": "指用熨斗平整衣物"
                            },
                            {
                                "target_lang_word": "烫",
                                "target_lang_sense_clarification": "指用熨斗平整衣物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}