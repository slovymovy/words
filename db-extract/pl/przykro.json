                                                "example_id": "63c58e92-38c0-43ae-9a43-7439fac414f7",
                                                "sense_id": "d1d58d7d-4088-30aa-a4b9-12eecc196792",
                                                "text": "The President was sorry to hear that the Ambassador was leaving."
