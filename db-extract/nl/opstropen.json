                "senses": [
                    {
                        "sense_id": "38b335d0-8356-306c-b775-15f6de7d3776",
                        "entry_id": "7e459869-0c1f-37ab-ab56-4876fb333d2e",
                        "glosses": [
                            "de onderste rand van een mouw of broekspijp naar boven schuiven zodat de handen of de voeten onbedekt blijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faecc6c6-8a0a-4df1-bb8d-ce8549ec39d6",
                                "sense_id": "38b335d0-8356-306c-b775-15f6de7d3776",
                                "text": "Met die toga blijkt wat mis. Huisman moet tijdens zijn pleidooi continu de mouwen opstropen. „Dat kun je natuurlijk niet hebben in een zaak.” Reden genoeg voor de raadsman om naderhand zijn bevindingen op Twitter te plaatsen: ‘Toga’s moeten aan wettelijke eisen voldoen. Ook leentoga’s.’ Het wetsartikel luidt: ‘Aan de onderkant der mouwen behoort een voorziening te zijn getroffen, welke het terugvallen der mouwen verhindert.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d864d6f6-c8d1-4925-9df8-78dab0d82f1d",
                        "source_entry_id": "7e459869-0c1f-37ab-ab56-4876fb333d2e",
