                ],
                "senses": [
                    {
                        "sense_id": "4e81e724-0ddb-35f9-ac47-40556c7b8756",
                        "entry_id": "76950a76-f0c8-3f70-8757-9d84889efaa7",
                        "glosses": [
                            "Licht, das von der Seite kommt"
                        ],
                        "tags": [
                            "oft Film, Fotografie, Malerei"
                        ],
                        "examples": [
                            {
                                "example_id": "a691d4c3-6b61-415e-afbf-397f2bd33bcb",
                                "sense_id": "4e81e724-0ddb-35f9-ac47-40556c7b8756",
                                "text": "„Die Seitenlichter suchten ihr Gesicht und fingen sich in den Augen, die plötzlich sehr blau wurden.“"
                            },
                            {
                                "example_id": "b12d47f0-3959-4d05-90f3-3231af4a1a65",
                                "sense_id": "4e81e724-0ddb-35f9-ac47-40556c7b8756",
                                "text": "„Das Maleratelier braucht hohes Seitenlicht.“"
                            },
                            {
                                "example_id": "780b8fde-a13c-4204-94bd-a14520fac6c1",
                                "sense_id": "4e81e724-0ddb-35f9-ac47-40556c7b8756",
                                "text": "„Scharfes Seitenlicht von links ließ die berühmten Zinken besonders plastisch und markant erscheinen.“"
                            },
                            {
                                "example_id": "544aaa64-23ba-4c94-82eb-f4990bf57899",
                                "sense_id": "4e81e724-0ddb-35f9-ac47-40556c7b8756",
                                "text": "„Zusätzlich können die Photodioden und Phototransistoren in ein Seitenlicht ausblendendes zylindrisches Blechgehäuse montiert werden,“ […]."
                            },
                            {
                                "example_id": "4d34284f-1f16-4b96-a7ce-19b46f84ef72",
                                "sense_id": "4e81e724-0ddb-35f9-ac47-40556c7b8756",
                                "text": "„Unterschiedliche Sichten auf die historischen Blätter sind möglich. Auch mit Seitenlicht, um die Struktur des Pergaments zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                        "entry_id": "76950a76-f0c8-3f70-8757-9d84889efaa7",
                        "glosses": [
                            "Lampe, die rotes oder grünes Licht abstrahlt und (gesetzlich vorgeschrieben) auf einem Schiff Tag und Nacht geführt werden muss"
                        ],
                        "tags": [
                            "Schifffahrt",
                            "oft im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b1d30028-9b96-4546-876f-ce31d1945934",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "„Die Seitenlichter können bei Booten unter 20 Meter Länge in einer Zweifarbenlaterne zusammengefasst sein oder inklusive des Hecklichtes in einer Dreifarbenlaterne im Masttop geführt werden.“"
                            },
                            {
                                "example_id": "d7c33277-7643-491b-84b8-27651e865ee9",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "Farbblinde können auf See nachts nicht die roten von den grünen Seitenlichtern unterscheiden."
                            },
                            {
                                "example_id": "55365db3-54db-4227-a548-30c300ad6a87",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "Seitenlichter strahlen auf Schiffen in einem Winkel von 122,5°, also bis etwas weiter achterlich, als querab."
                            },
                            {
                                "example_id": "8a134754-209a-414f-9247-0bf23f438c36",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "„Das Stb-Seitenlicht ist immer grün, das Bb-Seitenlicht immer rot.“"
                            },
                            {
                                "example_id": "41152f4d-f987-488c-b7ed-b0fa9a84d18c",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "„Fahrzeuge unter 20 m dürfen die Seitenlichter in einer Zweifarbenlaterne über der Längsachse führen“"
                            },
                            {
                                "example_id": "6ebbb320-ba6d-4014-8d6d-ef722364d986",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "„Seitenlichter, Hecklicht und Topplicht werden zusammen auch als Positionslichter im engeren Sinne bezeichnet.“"
                            },
                            {
                                "example_id": "0a49f4bc-89e1-40b0-97ef-e4a25444af72",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "„Backbord querab kommt ein grünes Seitenlicht eines Bootes B immer näher, das kein Topplicht führt. Wer ist ausweichpflichtig?“"
                            },
                            {
                                "example_id": "35ae7d1e-9175-49fe-86f1-0d36b1179402",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "[Das Sortiment von LED-Navigationslichtern] „umfasst einfarbige und doppelfarbige Seitenlichter sowie Heck-, Topp- und Ankerlicht.“"
                            },
                            {
                                "example_id": "77a68d7a-2b7f-43e1-8436-1f1346d05990",
                                "sense_id": "e6b0f3be-e5d8-332d-bfe2-5de02897bac0",
                                "text": "„In den meisten Fällen benötigen Segelboote in Fahrt ein rotes und ein grünes Seitenlicht sowie ein weißes Hecklicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
