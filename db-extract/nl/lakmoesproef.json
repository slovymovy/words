                                        "entry_id": "d85e3f2d-dc34-32ef-b404-d0ce93255b7b",
                                        "glosses": [
                                            "Messung der Acidität bzw. Basizität einer Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9dc5c2-794f-46a3-9f92-f6c06fccba29",
                                                "sense_id": "339183f3-3255-37fd-90d9-254b6daf6712",
                                                "text": "„Der Begriff Lackmustest bezeichnete einen in der Chemie gebräuchlichen Test des pH-Werts einer Substanz mit Hilfe des Farbstoffs Lackmus …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b493dd8c-2ebe-3b34-8c2d-bd603a6cb3d5",
                                        "entry_id": "d85e3f2d-dc34-32ef-b404-d0ce93255b7b",
                                        "glosses": [
                                            "hartes Kriterium"
                                        ],
                                        "tags": [
