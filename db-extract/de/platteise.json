                        "examples": [
                            {
                                "example_id": "b22e2a4c-3c9a-4e36-9433-2e1c8ad8da00",
                                "sense_id": "6820ce4a-331c-36ad-8ea8-84dbda24c194",
                                "text": "Aber die überjährigen, die oft unter dem Namen der Platteise verkauft werden, haben allen Geschmack verloren, und sind so dürre, als ob man Stroh kauete. (1797)"
                            },
                            {
                                "example_id": "3188e2e5-b208-4417-9fdc-9ef0242339cd",
                                "sense_id": "6820ce4a-331c-36ad-8ea8-84dbda24c194",
                                "text": "Anfang des 17. Jahrhunderts lag die Einfuhr von Stockfisch, Hering und Platteisen in den Händen einer Gruppe von Kasseler Kaufleuten, die sich Bremerhändler nannten."
                            }
                        ],
