{
    "word_family": [
        "handcuff",
        "cufflink"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ce1710c-477e-3100-8657-5fc09c6bc352",
                    "sense_definition": "The end of a shirt sleeve that covers the wrist.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fastened the shiny silver <w>cuffs</w> of his dress shirt before putting on his suit jacket.",
                            "target_lang_translations": {
                                "ru": "Он застегнул блестящие серебряные <w>манжеты</w> своей парадной рубашки, прежде чем надеть пиджак."
                            }
                        },
                        {
                            "text": "She rolled up her shirt <w>cuffs</w> to keep them clean while washing the dishes.",
                            "target_lang_translations": {
                                "ru": "Она закатала <w>манжеты</w> рубашки, чтобы не испачкать их во время мытья посуды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shirt cuff",
                        "roll up cuffs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конец рукава рубашки, закрывающий запястье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манжета",
                                "target_lang_sense_clarification": "на рукаве рубашки"
                            },
                            {
                                "target_lang_word": "обшлаг",
                                "target_lang_sense_clarification": "отворот рукава"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17b50c36-e42e-3f2d-9a79-6f048f1cdabc",
                    "sense_definition": "The end of a pants leg when folded up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor suggested adding <w>cuffs</w> to the trousers to give them a more classic look.",
                            "target_lang_translations": {
                                "ru": "Портной предложил сделать <w>отвороты</w> на брюках, чтобы придать им более классический вид."
                            }
                        },
                        {
                            "text": "He shook out the sand that had gathered in the <w>cuffs</w> of his pants after walking on the beach.",
                            "target_lang_translations": {
                                "ru": "Он вытряхнул песок, скопившийся в <w>отворотах</w> брюк после прогулки по пляжу."
                            }
                        }
                    ],
                    "synonyms": [
                        "turn-up"
                    ],
                    "common_phrases": [
                        "pants cuff",
                        "trouser cuff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загнутый вверх нижний край брючины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отворот",
                                "target_lang_sense_clarification": "на брюках"
                            },
                            {
                                "target_lang_word": "манжета",
                                "target_lang_sense_clarification": "на брюках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d1ff0f6-149d-3ba0-a53e-66ab77e2ee28",
                    "sense_definition": "A handcuff.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restraints",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer clicked the metal <w>cuffs</w> shut around the suspect's wrists.",
                            "target_lang_translations": {
                                "ru": "Полицейский защелкнул металлические <w>наручники</w> на запястьях подозреваемого."
                            }
                        },
                        {
                            "text": "He sat quietly in the back of the patrol car with the <w>cuffs</w> tight behind his back.",
                            "target_lang_translations": {
                                "ru": "Он тихо сидел на заднем сиденье патрульной машины с туго затянутыми за спиной <w>наручниками</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "handcuff",
                        "manacle"
                    ],
                    "common_phrases": [
                        "put in cuffs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наручник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наручники",
                                "target_lang_sense_clarification": "средство ограничения свободы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7f9817c-c2d0-35eb-bf0e-a5cb8c3a2911",
                    "sense_definition": "A blow, especially with the open hand; a box; a slap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_blows",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naughty child received a light <w>cuff</w> on the ear from his frustrated grandfather.",
                            "target_lang_translations": {
                                "ru": "Непослушный ребенок получил легкий <w>подзатыльник</w> по уху от расстроенного дедушки."
                            }
                        },
                        {
                            "text": "He avoided the sudden <w>cuff</w> by ducking quickly to the side.",
                            "target_lang_translations": {
                                "ru": "Он уклонился от внезапного <w>удара</w>, быстро пригнувшись в сторону."
                            }
                        }
                    ],
                    "synonyms": [
                        "slap",
                        "box",
                        "blow",
                        "cuffing"
                    ],
                    "common_phrases": [
                        "kick and cuff"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly literary or historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар, особенно ладонью; подзатыльник; шлепок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подзатыльник",
                                "target_lang_sense_clarification": "удар по затылку или шее"
                            },
                            {
                                "target_lang_word": "шлепок",
                                "target_lang_sense_clarification": "удар открытой ладонью"
                            },
                            {
                                "target_lang_word": "манжет",
                                "target_lang_sense_clarification": "удар рукой (устаревшее)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bf728bb-4f2a-333e-a019-eb1b7f1ee5bd",
                    "sense_definition": "A glove or mitten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old dialect, they referred to the thick winter glove as a protective <w>cuff</w>.",
                            "target_lang_translations": {
                                "ru": "В старом диалекте толстую зимнюю перчатку называли защитной <w>рукавицей</w>."
                            }
                        },
                        {
                            "text": "He pulled the heavy leather <w>cuffs</w> over his hands before handling the thorny bushes.",
                            "target_lang_translations": {
                                "ru": "Он натянул на руки тяжелые кожаные <w>рукавицы</w>, прежде чем взяться за колючие кусты."
                            }
                        }
                    ],
                    "synonyms": [
                        "glove",
                        "mitten"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or archaic usage for handwear"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перчатка или рукавица."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рукавица",
                                "target_lang_sense_clarification": "плотная защитная перчатка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81ff0b85-8527-3928-90fc-1858a2fbccfd",
                    "sense_definition": "The scruff of the neck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother cat gently picked up her kitten by the <w>cuff</w> of its neck.",
                            "target_lang_translations": {
                                "ru": "Кошка-мать осторожно взяла котенка за <w>шкирку</w>."
                            }
                        },
                        {
                            "text": "He grabbed the thief by the <w>cuff</w> of his neck before he could run away.",
                            "target_lang_translations": {
                                "ru": "Он схватил вора за <w>шкирку</w>, прежде чем тот успел убежать."
                            }
                        }
                    ],
                    "synonyms": [
                        "scruff",
                        "nape"
                    ],
                    "common_phrases": [
                        "cuff of the neck"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in specific dialects to mean scruff"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Загривок, шкирка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкирка",
                                "target_lang_sense_clarification": "загривок"
                            },
                            {
                                "target_lang_word": "загривок",
                                "target_lang_sense_clarification": "задняя часть шеи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "883fbea3-24d7-31a8-bfa4-38d693aa1354",
                    "sense_definition": "A surgical procedure in which parts of the body that were not previously connected are stitched together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon carefully constructed a gastric <w>cuff</w> during the complex bariatric procedure.",
                            "target_lang_translations": {
                                "ru": "Хирург аккуратно сформировал желудочную <w>манжету</w> во время сложной бариатрической операции."
                            }
                        },
                        {
                            "text": "Post-operative imaging showed that the newly formed <w>cuff</w> was healing perfectly without leaks.",
                            "target_lang_translations": {
                                "ru": "Послеоперационная томография показала, что вновь сформированная <w>манжета</w> заживает отлично, без протеканий."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Medical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хирургическая процедура, при которой сшиваются ранее не соединенные части тела; манжета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манжета",
                                "target_lang_sense_clarification": "в хирургии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01ea5ebb-003d-309b-b477-c32d6fb24676",
                    "sense_definition": "To handcuff.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restraining_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officers had to <w>cuff</w> the suspect quickly to prevent him from escaping.",
                            "target_lang_translations": {
                                "ru": "Полицейским пришлось быстро <w>заковать в наручники</w> подозреваемого, чтобы не дать ему сбежать."
                            }
                        },
                        {
                            "text": "They will <w>cuff</w> him and lead him out of the courtroom in front of the cameras.",
                            "target_lang_translations": {
                                "ru": "На него <w>наденут наручники</w> и выведут из зала суда под прицелом телекамер."
                            }
                        }
                    ],
                    "synonyms": [
                        "handcuff",
                        "shackle",
                        "manacle"
                    ],
                    "antonyms": [
                        "uncuff"
                    ],
                    "common_phrases": [
                        "cuff the suspect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надеть наручники."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заковать в наручники",
                                "target_lang_sense_clarification": "надеть наручники"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11191cd2-49ef-3999-beeb-53e4c5dcb274",
                    "sense_definition": "To hit, as a reproach, particularly with the open palm to the head; to slap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hitting_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I swear I'll <w>cuff</w> you if you strike again, so keep your hands to yourself.",
                            "target_lang_translations": {
                                "ru": "Клянусь, я <w>дам тебе подзатыльник</w>, если ты еще раз ударишь, так что держи руки при себе."
                            }
                        },
                        {
                            "text": "The angry cook threatened to <w>cuff</w> the kitchen boy for dropping the expensive plates.",
                            "target_lang_translations": {
                                "ru": "Рассерженный повар пригрозил <w>отлупить</w> поваренка за то, что тот уронил дорогие тарелки."
                            }
                        }
                    ],
                    "synonyms": [
                        "slap",
                        "box",
                        "clout",
                        "smack"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly literary or historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить, дать подзатыльник или шлепок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дать подзатыльник",
                                "target_lang_sense_clarification": "ударить ладонью по голове"
                            },
                            {
                                "target_lang_word": "шлепнуть",
                                "target_lang_sense_clarification": "ударить открытой рукой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc3ff13e-f8b2-32a7-96bd-c099e09dca7a",
                    "sense_definition": "To enter into a committed romantic relationship with (someone).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "romantic_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As winter approached, he decided it was time to <w>cuff</w> someone and settle down for the season.",
                            "target_lang_translations": {
                                "ru": "С приближением зимы он решил, что пора <w>охомутать</w> кого-нибудь и остепениться на холодный сезон."
                            }
                        },
                        {
                            "text": "She was happy being single and had no desire to <w>cuff</w> anyone she met at the club.",
                            "target_lang_translations": {
                                "ru": "Она была счастлива в одиночестве и не испытывала желания <w>заводить серьезные отношения</w> ни с кем, кого встречала в клубе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cuffing season"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Modern relationship slang, often associated with 'cuffing season'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступить в серьезные романтические отношения с кем-либо (молодежный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охомутать",
                                "target_lang_sense_clarification": "привязать к себе, начать серьезные отношения"
                            },
                            {
                                "target_lang_word": "замутить",
                                "target_lang_sense_clarification": "начать встречаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f03535-b24a-30b9-803f-e1930d91b054",
                    "sense_definition": "To fight; to scuffle; to box.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hitting_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two boys began to <w>cuff</w> and wrestle in the dirt over the lost coin.",
                            "target_lang_translations": {
                                "ru": "Мальчишки начали <w>тузить друг друга</w> и бороться в грязи из-за потерянной монеты."
                            }
                        },
                        {
                            "text": "They would often <w>cuff</w> in the schoolyard until a teacher came to break them up.",
                            "target_lang_translations": {
                                "ru": "Они часто <w>дрались</w> на школьном дворе, пока не приходил учитель, чтобы разнять их."
                            }
                        }
                    ],
                    "synonyms": [
                        "scuffle",
                        "fight",
                        "box",
                        "tussle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Intransitive use meaning to fight"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Драться, тузить друг друга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тузить друг друга",
                                "target_lang_sense_clarification": "драться на кулаках"
                            },
                            {
                                "target_lang_word": "драться",
                                "target_lang_sense_clarification": "бороться, наносить удары"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "462f2ee0-859f-394f-8b6b-0542d2393f8d",
                    "sense_definition": "To buffet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hitting_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small sailboat was mercilessly <w>cuffed</w> by the gale as it tried to reach the harbor.",
                            "target_lang_translations": {
                                "ru": "Шторм нещадно <w>трепал</w> маленькую парусную лодку, когда она пыталась добраться до гавани."
                            }
                        },
                        {
                            "text": "Strong winds continue to <w>cuff</w> the coastal cliffs, eroding the rocks over centuries.",
                            "target_lang_translations": {
                                "ru": "Сильные ветры продолжают <w>биться</w> о прибрежные скалы, разрушая камни на протяжении веков."
                            }
                        }
                    ],
                    "synonyms": [
                        "buffet",
                        "batter",
                        "pummel"
                    ],
                    "common_phrases": [
                        "cuffed by the gale"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Literary or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить, трепать (о ветре, волнах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепать",
                                "target_lang_sense_clarification": "о ветре или шторме"
                            },
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "о волнах или ветре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "621b68e2-025c-3705-bbfc-3506edbb6ec3",
                    "sense_definition": "To furnish with cuffs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor will <w>cuff</w> the trousers to give them a more traditional finish.",
                            "target_lang_translations": {
                                "ru": "Портной <w>сделает отвороты</w> на брюках, чтобы придать им более традиционный вид."
                            }
                        },
                        {
                            "text": "She decided to <w>cuff</w> the sleeves of the jacket with a contrasting silk fabric.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>отделать манжеты</w> рукавов жакета контрастной шелковой тканью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать отвороты или манжеты на одежде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать отвороты",
                                "target_lang_sense_clarification": "на брюках"
                            },
                            {
                                "target_lang_word": "подшивать манжеты",
                                "target_lang_sense_clarification": "на рукавах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "03ed0f9b-6f2f-33cc-bb05-1586438f71ca",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Cuff</w> and his family to join us for the neighborhood block party.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Каффа</w> и его семью присоединиться к нашей соседской вечеринке."
                            }
                        },
                        {
                            "text": "The local library has a dedicated section for historical documents donated by the <w>Cuff</w> family.",
                            "target_lang_translations": {
                                "ru": "В местной библиотеке есть специальный отдел для исторических документов, подаренных семьей <w>Кафф</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия Кафф."
                    },
                    "translations": {
                        "ru": [
                            {
