                                        "examples": [
                                            {
                                                "example_id": "507ba89b-1463-40fa-aeae-4e1c335a9615",
                                                "sense_id": "f0f5204c-c47a-3b2d-9ef2-3160c530f74a",
                                                "text": "Er hat sich die wichtigen Stellen mit gelbem Marker markiert."
                                            },
                                            {
                                                "example_id": "e2f2ef8e-a5ce-4411-b1ad-5633a1eb2995",
                                                "sense_id": "f0f5204c-c47a-3b2d-9ef2-3160c530f74a",
                                                "text": "Die Wegpunkte der Tour wurden mit roten Fähnchen markiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5817fc15-7191-39d5-b13f-01eac884d135",
                                        "entry_id": "6967b9ab-c84a-310e-b31c-9f276495f144",
                                        "glosses": [
                                            "bei einer Kostümprobe in der Oper seinen Part mehr sprechen als singen, um den Mitspielern den Einsatz vorzugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2d1d70f-112e-46ad-9e75-05d07f79e422",
                                                "sense_id": "5817fc15-7191-39d5-b13f-01eac884d135",
                                                "text": "Der singt ja nicht richtig, der markiert nur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e5e19549-36ad-3def-8d1c-f71c0b3c3b13",
