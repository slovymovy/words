                                "example_id": "6b493e1e-4716-4cd2-a1bc-d886b1351b89",
                                "sense_id": "0fe7d78c-1258-3416-8662-c8194022c991",
                                "text": "Il faut être capoté pour faire des choses comme celles-là."
                            },
                            {
                                "example_id": "5600d233-632b-4e1e-9250-cd8134afabec",
                                "sense_id": "0fe7d78c-1258-3416-8662-c8194022c991",
                                "text": "Hé! C'est capoté, cette histoire-là !"
                            },
                            {
                                "example_id": "b02c5eca-9f02-4267-a922-68d9e5c15329",
                                "sense_id": "0fe7d78c-1258-3416-8662-c8194022c991",
                                "text": "À la fin, il a fait un numéro complètement capoté."
                            }
                        ]
