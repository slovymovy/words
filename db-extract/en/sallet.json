    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ccd0322f-0c99-3976-8da4-968452166882",
                "word": "sallet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "90b9b6e6-cfbd-4d52-800a-330a4bd2378f",
                        "entry_id": "ccd0322f-0c99-3976-8da4-968452166882",
                        "tags": [
                            "plural"
                        ],
                        "form": "sallets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b887ca3b-b2f8-3e30-af26-7e7740f85882",
                        "entry_id": "ccd0322f-0c99-3976-8da4-968452166882",
                        "glosses": [
                            "A type of light spherical combat helmet used in the 15th century."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ba255cb6-514a-47ca-b599-a0c332545a9f",
                                "sense_id": "b887ca3b-b2f8-3e30-af26-7e7740f85882",
                                "text": "At Hampton Court, sallets for archers on horseback, sallets with grates, and old sallets with vizards: At Windsor, salettes and skulls: At Calais, saletts with vysars and bevers, and salets with bevers."
                            },
                            {
                                "example_id": "d06ad9de-20ad-4a97-b39a-37b02b35ec4a",
                                "sense_id": "b887ca3b-b2f8-3e30-af26-7e7740f85882",
                                "text": "Ursula wore that day a hauberk under her gown, and was helmed with a sallet; and because of her armour she rode upon a little horse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5339e01-3147-4318-8a23-d31a320e6d55",
                        "source_entry_id": "ccd0322f-0c99-3976-8da4-968452166882",
                        "source_sense_id": "b887ca3b-b2f8-3e30-af26-7e7740f85882",
                        "source_sense_description": "type of light spherical helmet",
                        "target_lang_word": "šalíř",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6ad07df5-05bd-4a2c-b644-3e378958e708",
                        "source_entry_id": "ccd0322f-0c99-3976-8da4-968452166882",
                        "source_sense_id": "b887ca3b-b2f8-3e30-af26-7e7740f85882",
                        "source_sense_description": "type of light spherical helmet",
                        "target_lang_word": "salade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be03224a-2c7f-35bf-a519-e0dc8e181f61",
                                        "entry_id": "2263a8f9-66cc-30a4-98cb-499019c0c916",
                                        "glosses": [
                                            "Mets à base d’herbes potagères, ou de certains légumes, assaisonné d’une vinaigrette et parfois agrémenté d’autres ingrédients."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9ad135-3e00-4bd5-846c-d5637d2431c5",
                                                "sense_id": "be03224a-2c7f-35bf-a519-e0dc8e181f61",
                                                "text": "Il fut intéressé par la salade de carottes râpées en longues lamelles. Il en prit une fourchettée, mâcha. Le goût le surprit. Il n'appréciait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd219b6d-6b18-342b-9b60-190fb85292cf",
                                        "entry_id": "2263a8f9-66cc-30a4-98cb-499019c0c916",
                                        "glosses": [
                                            "Herbes potagères destinées à être ainsi assaisonnées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7393fb55-824a-4403-acb8-e974fbda8c20",
                                                "sense_id": "dd219b6d-6b18-342b-9b60-190fb85292cf",
                                                "text": "La solution se trouve dans les jardins disséminés çà et là. Beaucoup d’habitants y passent une partie de la journée, devisant joyeusement de parcelle à parcelle en plantant des salades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d40fc87-dfae-3925-b099-5cd62336af10",
                                        "entry_id": "2263a8f9-66cc-30a4-98cb-499019c0c916",
                                        "glosses": [
                                            "Mets composé de divers ingrédients mélangés dans un saladier, tel qu’un mélange de fruits et de sirop, de morceaux de viande assaisonnés, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d068db-3aad-4a6f-8886-e5ae58d0cd68",
                                                "sense_id": "1d40fc87-dfae-3925-b099-5cd62336af10",
                                                "text": "Notre dessert sera une salade de fruits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18ec46af-d871-37da-867c-b05a096e6a8e",
                                        "entry_id": "2263a8f9-66cc-30a4-98cb-499019c0c916",
                                        "glosses": [
                                            "Situation confuse et compliquée, brouillamini, pot-pourri, pastis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd23be7b-6c16-47dd-8e35-c7961721b247",
                                                "sense_id": "18ec46af-d871-37da-867c-b05a096e6a8e",
                                                "text": "Quelle salade !"
                                            },
                                            {
                                                "example_id": "a974ddaa-b802-446a-91b3-0ed17b526681",
                                                "sense_id": "18ec46af-d871-37da-867c-b05a096e6a8e",
                                                "text": "Il règne dans cet ouvrage une grande confusion : c’est une salade des idées et des sujets les plus disparates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e0c11a-b917-376d-8810-1551bad597c8",
                                        "entry_id": "2263a8f9-66cc-30a4-98cb-499019c0c916",
                                        "glosses": [
                                            "(généralement au pluriel) Discours mensonger, baratin, boniment."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c36a9f44-09ee-4e2f-ad3f-014c1060075c",
                                                "sense_id": "09e0c11a-b917-376d-8810-1551bad597c8",
                                                "text": "Il ignorait tout ce qui se passait dans le monde, sauf les choses du cyclisme, et quelques mots entendus presque malgré lui au cours des conversations à l’usine ou chez son père ; encore fermait-il volontairement les oreilles à ces mots-là, reflets des « salades » avec quoi, croyait-il, on essayait de l’empêcher de gérer à sa guise sa propre vie."
                                            },
                                            {
                                                "example_id": "4e38546b-afa6-482f-9040-56e2ae7a6fe2",
                                                "sense_id": "09e0c11a-b917-376d-8810-1551bad597c8",
                                                "text": "– Assez de salades ! dit-il d'une voix menaçante. Voilà l'argent ! prenez-le et fichez le camp ; il nous faut ce cheval."
                                            },
                                            {
                                                "example_id": "7cadc70d-6d8e-4aa5-9612-a3f6c4000847",
                                                "sense_id": "09e0c11a-b917-376d-8810-1551bad597c8",
                                                "text": "Vous devriez suivre l'exemple de ce monsieur et arrêter avec vos salades."
                                            },
                                            {
                                                "example_id": "4901c8e6-b1d0-4040-9236-10f9e95f1365",
                                                "sense_id": "09e0c11a-b917-376d-8810-1551bad597c8",
                                                "text": "Raconter des salades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "823f2aaf-4899-393c-9b4d-2274a909b505",
                                        "entry_id": "2263a8f9-66cc-30a4-98cb-499019c0c916",
                                        "glosses": [
                                            "Pièce de camouflage destinée à être posée sur un casque et ressemblant à de la végétation."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "salade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e45d72b-4ce1-3b25-9f3f-7cbf4d82f260",
                                        "entry_id": "d3e96075-b644-35a4-9b04-1ff656720e2f",
                                        "glosses": [
                                            "Casque de forme ronde, avec un couvre nuque, porté du XVᵉ au XVIᵉ siècle, utilisé par les cavaliers et les fantassins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "582219dd-efb6-4e48-8743-7d060235882d",
                                                "sense_id": "3e45d72b-4ce1-3b25-9f3f-7cbf4d82f260",
                                                "text": "Dès le matin, Riesencraft se vêtit de son costume d’archer. Il mit la salade à gorgerin, sans visière, et une chemise de mailles sans manches."
                                            },
                                            {
                                                "example_id": "4f837c00-dd23-431f-ae1d-6d26cdf5551f",
                                                "sense_id": "3e45d72b-4ce1-3b25-9f3f-7cbf4d82f260",
                                                "text": "Et moi, dit l’hôte, […], moi, je vais fourbir ma salade, emmêcher mon arquebuse et affiler ma pertuisane. On ne sait pas ce qui peut arriver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salade",
                                "target_lang_code": "fr",
                                "target_senses": [
