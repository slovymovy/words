                "senses": [
                    {
                        "sense_id": "fc0db131-2448-3542-98d7-778b7852d866",
                        "entry_id": "9a22b3c9-3c2e-30ab-8b49-ecb9adde3860",
                        "glosses": [
                            "истребительная война"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "addda87f-9c4f-4bf5-a5a9-16fdfa275cec",
                                "sense_id": "fc0db131-2448-3542-98d7-778b7852d866",
                                "text": "Der Krieg gegen die Sowjetunion wurde vom deutschen Heer, Waffen-SS und Luftwaffe als Vernichtungskrieg mit der Absicht geführt, Osteuropa bis zum Ural als (neuen) deutschen Siedlungsraum für ein künftiges „Großgermanisches Reich“ zu gewinnen.",
                                "translation": "Война против Советского Союза велась немецкой армией, войсками СС и люфтваффе как война на уничтожение с целью захватить Восточную Европу до Урала в качестве (новой) немецкой территории для будущего «Великого германского рейха»."
                            }
                        ]
                    }
                ],
