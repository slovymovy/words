                "senses": [
                    {
                        "sense_id": "0c2d3ae3-f142-3639-8dfe-26996f189f06",
                        "entry_id": "1ceeeda0-8f78-39a0-8a09-f2984f61e345",
                        "glosses": [
                            "The southern side of a building, street, area etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6f908f1-8556-4c9b-b8e8-67a7cacd1f33",
                                "sense_id": "0c2d3ae3-f142-3639-8dfe-26996f189f06",
                                "text": "The retail section had two divisions - the southside and the northside - with Grafton Street being the main shopping street of the southside, and Henry Street and Moore Street the flagships of the northside."
                            },
                            {
                                "example_id": "2d048837-f661-47ca-9e7c-8e6794dcb544",
                                "sense_id": "0c2d3ae3-f142-3639-8dfe-26996f189f06",
                                "text": "While certain details indicate that this is a black neighborhood up north in a Michigan city, quite possibly Detroit as some have guessed, Morrison is deliberately not specific, allowing us to imagine that the \"Southside\" in her story could be any of a number of southsides created by the Negro migrations, including the southsides we readers may have lived in."
                            },
                            {
                                "example_id": "1e546f15-5aef-45f5-9389-680c31839718",
                                "sense_id": "0c2d3ae3-f142-3639-8dfe-26996f189f06",
                                "text": "What is apparently most galling to everyone not directly involved in the dirty fight on the southside of the Perfume River is that rattyass NVA flag still flying defiantly over the Citadel on the northside."
                            }
                        ]
                    }
                ],
