                                    {
                                        "sense_id": "f9a84cb9-5f76-35a2-bdd0-bf94cd72dc3a",
                                        "entry_id": "5319e615-f218-3cd7-b431-9de645669def",
                                        "glosses": [
                                            "bóg pogodnego i pochmurnego nieba oraz piorunów i błyskawic, pan Olimpu, utożsamiany z rzymskim Jowiszem, najwyższe bóstwo greckiego panteonu"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efc08cfa-926c-41d5-8019-c9bb6e5e50cd",
                                                "sense_id": "f9a84cb9-5f76-35a2-bdd0-bf94cd72dc3a",
                                                "text": "Zeus bezlitośnie karał zbrodniarzy, a zwłaszcza krzywoprzysięzców i świętokradców, jak Syzyfa, Tantala lub Iksjona"
                                            },
                                            {
                                                "example_id": "3b237a1f-57ea-437a-acaf-cca8d81d4787",
                                                "sense_id": "f9a84cb9-5f76-35a2-bdd0-bf94cd72dc3a",
                                                "text": "Spartakus był rozgniewany jak Zeus, gdy ciska piorunami"
                                            },
                                            {
                                                "example_id": "e00c63d5-484e-4825-9117-21a9a3778979",
                                                "sense_id": "f9a84cb9-5f76-35a2-bdd0-bf94cd72dc3a",
                                                "text": "Atrybutami Zeusa były: pioruny, berło, egida, dąb i orzeł, a głównymi miejscami kultu – Olimpia i Dodona."
                                            },
                                            {
                                                "example_id": "b7178798-82b3-47b1-9646-adc4a48570c1",
                                                "sense_id": "f9a84cb9-5f76-35a2-bdd0-bf94cd72dc3a",
                                                "text": "Pierwszą z małżonek Zeusa była Metis, córka Okeanosa"
                                            },
                                            {
                                                "example_id": "793c03da-9d28-4bd1-a0ea-45549010b784",
                                                "sense_id": "f9a84cb9-5f76-35a2-bdd0-bf94cd72dc3a",
                                                "text": "Uwieńczano także posągi bogów, zwykle roślinami, jakie były im poświęcone, np. wawrzyn Apollinowi, dąb Zeusowi, mirt Afrodycie, winorośl albo platan Dionizosowi, kłosy zboża Demeter, oliwka Atenie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
