                        "glosses": [
                            "veronderstelde ontvoering van humanen door aliens met het doel ze aan verschrikkelijke experimenten bloot te stellen in hun ruimtevaartuigen en waar bij voorkeur ook nog vrouwen zwanger worden van buitenaardse wezens"
                        ],
                        "tags": [],
