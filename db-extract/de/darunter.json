                        ],
                        "examples": [
                            {
                                "example_id": "072cdc20-3f08-4278-85b2-f27656faf66e",
                                "sense_id": "927c095e-ef5d-315f-9038-607f7e3d2cbe",
                                "text": "Schau das Bild an, der Maler ist direkt darunter auf einem Metallschildchen verewigt."
                            },
                            {
                                "example_id": "3dfdd550-2422-4bed-bc3a-6132e048ad44",
                                "sense_id": "927c095e-ef5d-315f-9038-607f7e3d2cbe",
                                "text": "Das Tor war fast geschlossen, aber er schaffte es, darunter hindurchzukriechen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "67b69ff9-4753-3225-acab-06708a6d976e",
                        "entry_id": "16bbbcce-0c72-3777-86d7-16531a005705",
                        "glosses": [
                            "für/zu einem kleineren Wert als so"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "802b9f36-b78f-4847-a5b6-5ec98dd0ee35",
                                "sense_id": "67b69ff9-4753-3225-acab-06708a6d976e",
                                "text": "Der Preis war hoch, aber der Verkäufer war darunter zu keinem Handel zu bewegen."
                            },
                            {
                                "example_id": "aad95c1c-3a06-4601-bcef-e904e219b08a",
                                "sense_id": "67b69ff9-4753-3225-acab-06708a6d976e",
                                "text": "Nein, mein Angebot steht, darunter mach ich’s nicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b676946a-63a4-37a4-a4f6-a94e66dad105",
                        "entry_id": "16bbbcce-0c72-3777-86d7-16531a005705",
                        "glosses": [
                            "aus der Tätigkeit/des Zustandes resultierend"
                        ],
                        "tags": [
