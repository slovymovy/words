                                            {
                                                "example_id": "eac50cf3-e6b6-4d89-8ce2-c36238422759",
                                                "sense_id": "2414d093-e7b5-3c92-a30e-1444f63781bb",
                                                "text": "En avril 2013, l'ayran a été déclaré boisson nationale de la Turquie."
                                            },
                                            {
                                                "example_id": "6e19ce4e-9b21-48a2-90e3-f4330a65ce7e",
                                                "sense_id": "2414d093-e7b5-3c92-a30e-1444f63781bb",
                                                "text": "Avec le temps, la recette de l’ayran fut propagée par les Scythes, les pires ennemis des Grecs."
                                            }
                                        ]
                                    }
                                ]
                            }
