                        "entry_id": "89129d6f-d1b5-3b95-b5c3-c6cc159bd652",
                        "glosses": [
                            "die Wahrsagekunst, die Seherkunst; Praktiken und Methoden, die dazu dienen sollen, zukünftige Ereignisse vorherzusagen und gegenwärtige oder vergangene Ereignisse, die sich der Kenntnis des Fragenden entziehen, zu ermitteln"
                        ],
                        "tags": [
                            "Esoterik"
                        ],
                        "examples": [
                            {
                                "example_id": "0141b871-82a5-446c-a61d-0e8ad04216c8",
                                "sense_id": "160b901d-a7de-3002-91b1-6f7b14da22e7",
                                "text": "„Zu den bis in die jüngste Zeit zähe sich erhaltenden Volksbräuchen gehört auch die Mantik aller Art.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
