{
    "word_family": [
        "descendance",
        "descendant",
        "descente",
        "descendre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bbc9521-bf66-3506-bebc-4bde29c2d925",
                    "sense_definition": "Descendre d'un lieu après y être monté.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir admiré la vue au sommet, nous devons <w>redescendre</w> avant la tombée de la nuit."
                        },
                        {
                            "text": "Il est monté chercher son manteau et va bientôt <w>redescendre</w> dans le salon."
                        }
                    ],
                    "antonyms": [
                        "remonter"
                    ],
                    "common_phrases": [
                        "redescendre sur terre",
                        "redescendre au rez-de-chaussée"
                    ]
                },
                {
                    "sense_id": "60a0bab8-ab69-3190-98fe-16e0408a2ec9",
                    "sense_definition": "Descendre une nouvelle fois, répéter l'action de descendre.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai oublié mes clés dans la voiture, je dois <w>redescendre</w> les chercher immédiatement."
                        },
                        {
                            "text": "L'ascenseur vient de <w>redescendre</w> au sous-sol pour prendre d'autres passagers."
                        }
                    ],
                    "antonyms": [
                        "remonter"
                    ],
                    "common_phrases": [
                        "redescendre à la cave",
                        "redescendre dans la rue"
                    ]
                },
                {
                    "sense_id": "59741032-ad80-3fed-bd2c-0ed1d985b0b4",
                    "sense_definition": "Parcourir en descendant une pente, un chemin ou des escaliers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les cyclistes ont mis beaucoup moins de temps pour <w>redescendre</w> la côte que pour la gravir."
                        },
                        {
                            "text": "Elle a préféré <w>redescendre</w> les escaliers lentement pour éviter de glisser sur les marches."
                        }
                    ],
                    "synonyms": [
                        "dévaler"
                    ],
                    "common_phrases": [
                        "redescendre la côte",
                        "redescendre la pente",
                        "redescendre les escaliers"
                    ]
                },
                {
                    "sense_id": "47367570-8727-319f-9bb8-c25b22989200",
                    "sense_definition": "Transporter vers le bas un objet placé en hauteur, ou le placer plus bas.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons <w>redescendre</w> les cartons du grenier pour trier les vieux vêtements."
                        },
                        {
                            "text": "Il faut <w>redescendre</w> ce tableau de quelques centimètres pour qu'il soit bien droit."
                        }
                    ],
                    "synonyms": [
                        "abaisser",
                        "baisser"
                    ],
                    "antonyms": [
                        "remonter"
                    ],
                    "common_phrases": [
                        "redescendre les valises",
                        "redescendre les cartons"
                    ]
                },
                {
                    "sense_id": "487e2771-42d7-3ee6-8b7e-e1b8135488e1",
                    "sense_definition": "Au théâtre, se déplacer depuis le fond du plateau vers la rampe ou le public.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comédien doit <w>redescendre</w> vers le bord du plateau pendant son monologue dramatique."
                        },
                        {
                            "text": "Dans cette scène, l'actrice s'éloigne du décor puis <w>redescend</w> lentement face aux spectateurs."
                        }
                    ],
                    "antonyms": [
                        "remonter"
                    ],
                    "common_phrases": [
                        "redescendre vers la rampe",
                        "redescendre face au public"
                    ]
                }
            ]
        }
    ]
}