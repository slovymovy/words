            "senses": [
                {
                    "sense_id": "a2a9c91d-7131-38d0-802e-2fc91972f200",
                    "sense_definition": "Polite, well-mannered, and refined, characteristic of a gentleman.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered his coat to her in a very <w>gentlemanly</w> manner.",
                            "target_lang_translations": {
                                "ru": "Он предложил ей свое пальто в очень <w>джентльменской</w> манере."
                            }
                        },
                        {
                            "text": "Everyone respected the host for his quiet and <w>gentlemanly</w> conduct throughout the evening.",
                            "target_lang_translations": {
                                "ru": "Все уважали хозяина за его сдержанное и <w>джентльменское</w> поведение на протяжении всего вечера."
                            }
                        }
                    ],
                    "synonyms": [
                        "gentlemanlike"
                    ],
                    "antonyms": [
                        "ungentlemanly"
                    ],
                    "common_phrases": [
                        "gentlemanly conduct",
                        "gentlemanly behavior",
                        "gentlemanly manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый, благородный, воспитанный, присущий джентльмену."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джентльменский",
                                "target_lang_sense_clarification": "о поведении, манерах"
                            },
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "великодушный, достойный"
