                "translations": [
                    {
                        "translation_id": "ed33d0b6-b0a7-4381-b1da-439c83d99a6e",
                        "source_entry_id": "54dd975a-87d9-31ca-95bb-123d152d8dba",
                        "target_lang_word": "faineance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faineance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aab47595-ce61-3353-a053-c4e4abb91b73",
                                        "entry_id": "0b84ca07-4876-34ed-8069-957621153038",
                                        "glosses": [
                                            "The state or quality of being faineant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be38ca6d-799e-415d-b778-c76d6c7ec614",
                                                "sense_id": "aab47595-ce61-3353-a053-c4e4abb91b73",
                                                "text": "The mask of sneering faineance was gone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06670a50-3495-4b8f-9f7b-1549b12dfc17",
                        "source_entry_id": "54dd975a-87d9-31ca-95bb-123d152d8dba",
                        "target_lang_word": "leisure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leisure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e1867f-009a-3a75-aaff-786b5d67ff42",
                                        "entry_id": "54e9096e-ed09-34b4-a57f-5e1f34a0711d",
                                        "glosses": [
                                            "Freedom provided by the cessation of activities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6042f590-1141-333c-82dd-8d9542a27183",
                                        "entry_id": "54e9096e-ed09-34b4-a57f-5e1f34a0711d",
                                        "glosses": [
                                            "Free time, time free from work or duties."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1259eb71-bd1a-43c3-8453-76a942665d40",
                                                "sense_id": "6042f590-1141-333c-82dd-8d9542a27183",
                                                "text": "The desire of leisure is much more natural than of business and care."
                                            },
                                            {
                                                "example_id": "defc2967-643b-4e9c-a012-b0a087e33bc3",
                                                "sense_id": "6042f590-1141-333c-82dd-8d9542a27183",
                                                "text": "Little had Mrs. Dashwood or her daughters imagined when they first came into Devonshire, that so many engagements would arise to occupy their time as shortly presented themselves, or that they should have such frequent invitations and such constant visitors as to leave them little leisure for serious employment."
                                            },
                                            {
                                                "example_id": "3413c8c1-e57f-43cc-8d3b-34efc1bb3ad5",
                                                "sense_id": "6042f590-1141-333c-82dd-8d9542a27183",
                                                "text": "This is why the mathematical arts were founded in Egypt; for there the priestly caste was allowed to be at leisure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb3fd2d5-4cef-37e2-a3aa-0fdb76591d14",
                                        "entry_id": "54e9096e-ed09-34b4-a57f-5e1f34a0711d",
                                        "glosses": [
                                            "Time at one's command, free from engagement; convenient opportunity; hence, convenience; ease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccdc80e0-4477-4aab-8c3b-9a64625b7b37",
                                                "sense_id": "bb3fd2d5-4cef-37e2-a3aa-0fdb76591d14",
                                                "text": "He sigh'd, and had no leisure more to say."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e12c346-42d3-4c21-a7d7-ca5d2d1a4ee5",
                        "source_entry_id": "54dd975a-87d9-31ca-95bb-123d152d8dba",
                        "target_lang_word": "Müßiggang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müßiggang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                        "entry_id": "7733e183-599b-3535-95a7-7adbf71deb77",
                                        "glosses": [
                                            "dauerhafte Untätigkeit (in der Umgangssprache negativer besetzt als Muße)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db62650-4845-42dc-ab9a-fa863dbc87a8",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "Sein Leben bestand nur noch aus Müßiggang."
                                            },
                                            {
                                                "example_id": "af70ee62-7389-4b48-8231-984f9450662b",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Hui, der ehemals dem ehrbaren Handwerk des Schreibers obgelegen hatte, verdankte seinen Niedergang der südchinesischen Neigung zum Müßiggang.“"
                                            },
                                            {
                                                "example_id": "b6975227-8a6c-4138-93e8-527ad3be44a5",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Falls ihm an der Gunst des französischen Publikums liegt, dann hat Kravchenko – Müßiggang ist aller … Anfang! – in den Ruhetagen zwischen der letzten Sitzung der vergangenen und der ersten dieser Woche einen unfaßlichen Fehler begangen; und mancher, der da schwankte, wird jetzt überzeugt sein, daß der Held der Affäre, wie die Lettres Françaises behaupten, wirklich nicht klug genug ist, um „Ich wählte die Freiheit“ geschrieben zu haben.“"
                                            },
                                            {
                                                "example_id": "3d3be8ae-f6bf-4891-bd88-d794df7e8b28",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Wo Müßiggang und sein Genuß, aus der Öffentlichkeit verdrängt, zur Privatsache werden, hilft dem Flaneur die Maske des Begleiters.“"
                                            },
                                            {
                                                "example_id": "7db7d5d3-fab9-47cb-a7a4-2b840586c942",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Dieser Müßiggang schien mir der Gipfel menschlichen Glücks zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "046313d9-bad0-4a59-baef-7ff3503d92d3",
                        "source_entry_id": "54dd975a-87d9-31ca-95bb-123d152d8dba",
                        "target_lang_word": "Nichtstun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtstun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                        "entry_id": "2d9a7269-3493-3fcd-8624-5f7fb1707a96",
                                        "glosses": [
                                            "Verhalten ohne Aktivität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f08139e-3934-4e5f-a7eb-20e95c66a08e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "Das Unglück liegt in deinem Leben im Nichtstun."
                                            },
                                            {
                                                "example_id": "015af3da-ea34-4e25-8acd-312e47ac7dfa",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Nach drei Tagen Nichtstun und Langeweile wollte er bei den Segelmanövern mithelfen.“"
                                            },
                                            {
                                                "example_id": "9bc74844-1d7b-4aaf-9edd-53a97df6441e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Er legte sich auf eine Waldwiese und genoss das Nichtstun.“"
                                            },
                                            {
                                                "example_id": "a303774d-d915-4619-a8e7-2f8e255eccf7",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Ich blieb drei Wochen bei ihnen und war aufgrund der Prellungen, die ich erlitten hatte, zum Nichtstun verdammt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9865f407-04af-4c63-8a19-bfe9ce4ed811",
                        "source_entry_id": "54dd975a-87d9-31ca-95bb-123d152d8dba",
