                "senses": [
                    {
                        "sense_id": "f5a960f6-8624-33af-a39c-0530ffee8eec",
                        "entry_id": "6d705ba7-c1e1-354a-9dee-b9400271b852",
                        "glosses": [
                            "пустые бессодержательные разговоры, праздная болтовня"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d380e83f-f2ad-4ad6-9c03-c9b653f25b9b",
                                "sense_id": "f5a960f6-8624-33af-a39c-0530ffee8eec",
                                "text": "Короче, где радость по заказу, где купленный восторг, лесть, словоблудие, где пресыщение, тунеядство и свинство, там вы всегда найдете вдову Клико."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f04fcf1-1e6e-425b-83d6-62800cc736e8",
                        "source_entry_id": "6d705ba7-c1e1-354a-9dee-b9400271b852",
                        "source_sense_id": "f5a960f6-8624-33af-a39c-0530ffee8eec",
                        "target_lang_word": "verbiage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbiage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "844fc8e3-f123-3cc7-9121-945ee313b0ff",
                                        "entry_id": "d742aadf-b763-3811-8a65-e15e2039aba1",
                                        "glosses": [
                                            "Overabundance of words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32031b74-035d-4f7c-b468-5a69a0ec2518",
                                                "sense_id": "844fc8e3-f123-3cc7-9121-945ee313b0ff",
                                                "text": "bureaucratic verbiage"
                                            },
                                            {
                                                "example_id": "c63b9132-39bc-4263-aaab-511ede4a5fb5",
                                                "sense_id": "844fc8e3-f123-3cc7-9121-945ee313b0ff",
                                                "text": "We're done drafting our paper except for the final check to see whether any verbiage can be reduced."
                                            },
                                            {
                                                "example_id": "3d0e9524-9dee-43a5-b2d9-84b5a91bbb41",
                                                "sense_id": "844fc8e3-f123-3cc7-9121-945ee313b0ff",
                                                "text": "A very garrulous person, he approached the counter in a fog of verbiage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b399bb7-db7e-370b-9b12-a887abb3afd1",
                                        "entry_id": "d742aadf-b763-3811-8a65-e15e2039aba1",
                                        "glosses": [
                                            "The manner in which something is expressed in words; word choice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3636fcb6-238c-4473-963f-dd947ed084d1",
                                                "sense_id": "6b399bb7-db7e-370b-9b12-a887abb3afd1",
                                                "text": "Near-synonyms: phrasing; terminology; phraseology"
                                            },
                                            {
                                                "example_id": "94f94620-fc69-43f0-a057-0cff43257d44",
                                                "sense_id": "6b399bb7-db7e-370b-9b12-a887abb3afd1",
                                                "text": "In each article of this series, there is a paragraph on nutrition; the verbiage for it was developed by consensus among the section editors, and therefore no elective rewording should be done (by others) in any such paragraph."
                                            },
                                            {
                                                "example_id": "206da4fa-8c60-417d-b6f7-17a24ba72580",
                                                "sense_id": "6b399bb7-db7e-370b-9b12-a887abb3afd1",
                                                "text": "We're done drafting our paper except for the final verbiage on fire safety, which will be supplied by the safety engineers."
                                            },
                                            {
                                                "example_id": "00b5be41-04ba-4f08-aca6-a8d29777ec1f",
                                                "sense_id": "6b399bb7-db7e-370b-9b12-a887abb3afd1",
                                                "text": "The comparison of coincidences in the verbiage of different languages, and affinity of etymological formation, are interesting subjects of philological investigation."
                                            },
                                            {
                                                "example_id": "08fd4444-e720-49ae-8cad-e1e248cf7e32",
                                                "sense_id": "6b399bb7-db7e-370b-9b12-a887abb3afd1",
                                                "text": "Use concise military verbiage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
