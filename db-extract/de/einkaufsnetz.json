                ],
                "senses": [
                    {
                        "sense_id": "55809c4a-0636-33f1-b4f0-2f2693c92639",
                        "entry_id": "a72c998b-3382-3dc1-9063-e1b408076718",
                        "glosses": [
                            "Netz in der Form eines oben offenen Beutels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e13ca56b-ecff-40c0-b430-c659e4df2935",
                                "sense_id": "55809c4a-0636-33f1-b4f0-2f2693c92639",
                                "text": "„Das Gepäck meiner Mutter bestand aus drei Koffern, einem Rucksack, einem Einkaufsnetz und einem Regenschirm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7517bca4-a075-4a1a-a983-0359f4124b37",
                        "source_entry_id": "a72c998b-3382-3dc1-9063-e1b408076718",
                        "source_sense_id": "55809c4a-0636-33f1-b4f0-2f2693c92639",
                        "source_sense_description": "Netz in der Form eines oben offenen Beutels",
                        "target_lang_word": "filet à provisions",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filet à provisions",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1cb5e9c-0ebd-3421-83d0-6c9969e42ad7",
                                        "entry_id": "c56d5748-4565-3dad-a4f4-16f4cca180bb",
                                        "glosses": [
                                            "Filet extensible, avec deux anses, formant un sac que l'on utilise pour transporter ses achats alimentaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "024cbf21-0ed3-412b-ac46-cbd2728a196e",
                        "source_entry_id": "a72c998b-3382-3dc1-9063-e1b408076718",
                        "source_sense_id": "55809c4a-0636-33f1-b4f0-2f2693c92639",
                        "source_sense_description": "Netz in der Form eines oben offenen Beutels",
                        "target_lang_word": "авоська",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "авоська",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0973c73-4ce0-3c17-b7bf-62791a6ec081",
                                        "entry_id": "64d8b1c5-ed06-330f-9c11-db0825fa4059",
                                        "glosses": [
                                            "разг. сетчатая сумка для продуктов, мелких предметов и т. п.; сетка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8784a943-61c3-4d3c-a0ea-4fad93d8ab34",
                                                "sense_id": "b0973c73-4ce0-3c17-b7bf-62791a6ec081",
                                                "text": "На глазах у тысячи людей на него напали мальчишки и схватили 2 или 3 «авоськи» ― одну с мукой, другую с крупой и хлебом!"
                                            },
                                            {
                                                "example_id": "36087ebf-0851-4746-9221-b771bb6d9637",
                                                "sense_id": "b0973c73-4ce0-3c17-b7bf-62791a6ec081",
                                                "text": "На-ка тебе авоську и иди-ка ты, друг, в гастроном."
                                            },
                                            {
                                                "example_id": "14cd8f24-bd30-4586-968d-56ed4a874205",
                                                "sense_id": "b0973c73-4ce0-3c17-b7bf-62791a6ec081",
                                                "text": "В одной руке у него розовая гвоздичка, в другой плетёная авоська с какой-то баночкой, завёрнутой в плотную бумагу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "авоська",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "712c2623-5afb-3606-9b1d-6a9527191c72",
                                        "entry_id": "606672e8-bdd0-3bc5-809f-38fdcf9e2f03",
                                        "glosses": [
                                            "устар., разг. будущий желанный случай, счастье, удача; отвага [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2e52d37-4b1a-45b7-b13e-148bc9966d0b",
                                                "sense_id": "712c2623-5afb-3606-9b1d-6a9527191c72",
                                                "text": "А как работник-от делает как-нибудь да хоронится за небось, да как и хозяин-от на авоське в ярмарку выезжает ― добра не жди."
                                            },
                                            {
                                                "example_id": "47a9ecd0-d309-494b-970f-51221a12f8d3",
                                                "sense_id": "712c2623-5afb-3606-9b1d-6a9527191c72",
                                                "text": "― Полноте, пожалуйста, не так-то это просто нас вздуть. ― А отчего же не просто: не на союзы ли вы надеетесь? ― Кроме авоськи с небоськой, батюшка мой, не найдется союзов. ― Пускай и так, ― только опять: зачем же так пренебрегать авоськой с небоськой?"
                                            },
                                            {
                                                "example_id": "8121eb26-088c-46ec-b195-feae03177071",
                                                "sense_id": "712c2623-5afb-3606-9b1d-6a9527191c72",
                                                "text": "― А что же ещё делать? Играть на авоську не намерен. Вот и смотрю! ― Погляди там игру! Крупно играют, ― указал Бадейников на большой стол."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eec3061-7d3b-397e-a838-b5b5345abd89",
                                        "entry_id": "606672e8-bdd0-3bc5-809f-38fdcf9e2f03",
                                        "glosses": [
                                            "одуш., устар., разг. тот, кто всё делает на авось; ненадёжный человек [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86fa9d79-b363-4203-baf5-90d972889611",
                                                "sense_id": "8eec3061-7d3b-397e-a838-b5b5345abd89",
                                                "text": "Латышское общество, задумав перестраивать своё здание и в будущем его назначение и жизнь, нас выгнало. Разумеется, разговоры и предупреждения об этом шли давно. Но пока наши авоськи да небоськи скребли свои зады, мы очутились на улице."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
