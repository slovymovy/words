                ],
                "senses": [
                    {
                        "sense_id": "2bafef16-81c0-364a-961c-25b158a61bfd",
                        "entry_id": "0a887d6f-aadf-39fb-81ef-c1ecfd7629c0",
                        "glosses": [
                            "spannende, umkämpfte Wahl mit (zeitweise) knappen Hochrechnungen beziehungsweise Auszählergebnissen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c974c796-3e30-4f51-8c06-f3c5511b2a0b",
                                "sense_id": "2bafef16-81c0-364a-961c-25b158a61bfd",
                                "text": "„Als die meisten Meinungsforscher noch bis zur letzten Minute die Spannung auf einen Wahl-Krimi anheizten, war für die Allensbacher Experten das Rennen seit Wochen gelaufen: Die Union verliert dramatisch – glauben wollte die es nicht.“"
                            },
                            {
                                "example_id": "63ee410a-be4c-4ec2-b53e-2a109649b786",
                                "sense_id": "2bafef16-81c0-364a-961c-25b158a61bfd",
                                "text": "„Erhobenen Hauptes konnte der 61-Jährige am Abend des Wahl-Krimis vor seine Anhänger treten.“"
                            },
                            {
                                "example_id": "1e6f240f-2a8e-4c2d-b5a4-091f09f2a0f3",
                                "sense_id": "2bafef16-81c0-364a-961c-25b158a61bfd",
                                "text": "«Und damit begann der italienische Wahl-Krimi, bei dem es buchstäblich um jede Stimme ging.»"
                            },
                            {
                                "example_id": "16e73eb5-f75c-4484-a54f-cacfbc3cb878",
                                "sense_id": "2bafef16-81c0-364a-961c-25b158a61bfd",
                                "text": "«Genau wie am Wahlsonntag vor vier Jahren, als Zeller in einem spannenden Wahl-Krimi letztlich doch noch eher knapp Walter Müller (FDP; Azmoos) unterlag und erst später in den Nationalrat nachrutschte, reichte es auch gestern an der Wahlurne nicht: Weil in St. Gallen einer der FDP-Sitze weggefallen war, kams zum Kopf-an-Kopf-Rennen zwischen Müller und Zeller.»"
                            },
                            {
                                "example_id": "b1ee9b77-32f5-474f-9c71-ec40b0e6cd9c",
                                "sense_id": "2bafef16-81c0-364a-961c-25b158a61bfd",
                                "text": "„Das ist vielleicht ein bisschen hoch gegriffen, denn auch 2009 war es nicht gerade langweilig, ganz zu schweigen von den Wahl-Krimis 1975 (Patt zwischen der CDU und der SPD/FDP-Allianz) und 1999 (hauchdünne CDU-Mehrheit).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
