                                "target_senses": [
                                    {
                                        "sense_id": "9c0c2e44-ace8-3206-a252-4892bea3e92e",
                                        "entry_id": "dd9b180a-5abc-3fab-a17a-74125c1b19e1",
                                        "glosses": [
                                            "stoupenec anarchismu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf37f836-cc66-4e45-803c-5a88a62226b5",
                                                "sense_id": "9c0c2e44-ace8-3206-a252-4892bea3e92e",
                                                "text": "Když měli každý pátou čtvrtku, prohlásil se Bretschneider za anarchistu a ptal se Švejka, do které organizace se má dát zapsat. Švejk řekl, že si jednou jeden anarchista koupil od něho leonbergra za sto korun a že mu zůstal poslední splátku dlužen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
