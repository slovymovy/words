                        "source_entry_id": "a9517c92-aef9-30e1-b69f-ea800a438bcd",
                        "source_sense_description": "(botany) opening of an organ by its own means",
                        "target_lang_word": "déhiscence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déhiscence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d3b1295-801e-3023-97c3-baf27c352b74",
                                        "entry_id": "5059444e-368f-34bc-a0a2-6f0dc62082ea",
                                        "glosses": [
                                            "Ouverture et destruction de la zone pellucide qui permet la libération du blastocyte dans l’utérus et sa fixation à l’endomètre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6a4b6b4-8975-3f99-ac27-253cf2b7cd9b",
                                        "entry_id": "5059444e-368f-34bc-a0a2-6f0dc62082ea",
                                        "glosses": [
                                            "Ouverture qui se produit dans un organe clos le long de la suture d’union de ses parties distinctes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f4deb47-afd1-4ce1-9969-13232917bec9",
                                                "sense_id": "c6a4b6b4-8975-3f99-ac27-253cf2b7cd9b",
                                                "text": "La fleur s’était fendue le long de^([sic]) lignes de déhiscence, son corps lourd fracturé en morceaux qui étaient tombés sur l’herbe jaune, ne laissant plus au bout de la tige qu’un vulgaire et turgescent pistil."
                                            },
                                            {
                                                "example_id": "c4eb8b53-5574-44f3-b045-e926327aa6d5",
                                                "sense_id": "c6a4b6b4-8975-3f99-ac27-253cf2b7cd9b",
                                                "text": "C’est l’époque de la déhiscence, le fruit s’ouvre et les graines sautent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ec7f7e8-1c1e-35d6-be88-a7e4ccf2163a",
                                        "entry_id": "5059444e-368f-34bc-a0a2-6f0dc62082ea",
                                        "glosses": [
                                            "Ouverture spontanée des anthères pour laisser sortir le pollen, ou du péricarpe pour laisser échapper les graines, les semences."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ec7b61-e64e-4094-9203-af7189409eea",
                                                "sense_id": "8ec7f7e8-1c1e-35d6-be88-a7e4ccf2163a",
                                                "text": "Déhiscence de l’anthère d’une étamine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f1ab70-9fca-3c59-8029-747644b023eb",
                                        "entry_id": "5059444e-368f-34bc-a0a2-6f0dc62082ea",
                                        "glosses": [
                                            "Dissémination des membres d’une communauté."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e039aca-01a7-45bd-913d-f1baadbcd17d",
                                                "sense_id": "54f1ab70-9fca-3c59-8029-747644b023eb",
                                                "text": "À la fin de ces études, il fallait affronter le brevet supérieur, dont les résultats prouvaient que la « promotion » était parvenue à maturité.\nAlors, par une sorte de déhiscence, la bonne graine était projetée aux quatre coins du département, pour y lutter contre l'ignorance, glorifier la République, et garder le chapeau sur la tête au passage des processions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e0d7a12-10ae-3e19-8604-ebfba3ae69fd",
                                        "entry_id": "5059444e-368f-34bc-a0a2-6f0dc62082ea",
                                        "glosses": [
                                            "Séparation."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
