                                    {
                                        "sense_id": "4f7e3f2b-02b6-38c5-9363-dfe573ee5b90",
                                        "entry_id": "7406100c-5b43-38c3-9820-80352a9eb408",
                                        "glosses": [
                                            "der für die letzte Verteidigung gedachte innere Hauptturm einer mittelalterlichen Burg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab6f617-7594-4e51-9274-c7aa2d8046f0",
                                                "sense_id": "4f7e3f2b-02b6-38c5-9363-dfe573ee5b90",
                                                "text": "„Der Bergfried etablierte sich als ein neuer Bautyp im Verlauf des 12. Jahrhunderts und prägte von ungefähr 1180 bis in das 14. Jahrhundert hinein das Bild der mitteleuropäischen Burgenlandschaft.“"
                                            },
                                            {
                                                "example_id": "e60534fe-7295-4c3f-9713-cdbc796df60d",
                                                "sense_id": "4f7e3f2b-02b6-38c5-9363-dfe573ee5b90",
                                                "text": "„Nur der Bergfried war gut zu erkennen, denn der Bergfried stand noch in voller Größe da, die anderen Teile der Anlage aber hatten die Franzosen vor etwa dreihundert Jahren einfach zerstört.“"
                                            },
                                            {
                                                "example_id": "ada0f16d-6374-49c7-97fc-6d4cb8dc8ede",
                                                "sense_id": "4f7e3f2b-02b6-38c5-9363-dfe573ee5b90",
                                                "text": "„Die dicke Kette im Korridor stammte aus dem Verlies des Bergfrieds von Torteval.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
