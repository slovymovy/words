                    "sense_id": "2a8d226a-08b5-3e7d-963a-c0f42d397278",
                    "sense_definition": "Surface d'une montre ou d'une horloge où sont disposés les chiffres indiquant les heures et les minutes à l'aide d'aiguilles.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "horlogerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a regardé le <w>cadran</w> de sa montre pour vérifier l'heure exacte du départ."
                        },
                        {
                            "text": "Le grand <w>cadran</w> de l'horloge municipale illumine la place dès que la nuit tombe."
                        }
                    ],
                    "common_phrases": [
                        "cadran de montre",
                        "faire le tour du cadran"
                    ]
                },
                {
