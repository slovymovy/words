                                                "example_id": "3b9f1590-34ca-4331-b56c-99b826237c0e",
                                                "sense_id": "0144cb75-25d3-3e9f-9310-90a28ab80de1",
                                                "text": "Земной шар."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ddf4a9-284a-3576-8cba-c0c29c3c9c80",
                                        "entry_id": "4d4b45b7-24bd-3e10-a233-3596f93974c1",
                                        "glosses": [
                                            "относящийся к земле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceebbeca-506e-4aca-810f-62decd5bae74",
                                                "sense_id": "57ddf4a9-284a-3576-8cba-c0c29c3c9c80",
                                                "text": "Углублённый в размышление о превратности земного счастия, я и не приметил, как лошади домчали меня до первой станции."
                                            },
                                            {
                                                "example_id": "433c4cb7-de66-4e4e-b5dc-aa1807237fd3",
                                                "sense_id": "57ddf4a9-284a-3576-8cba-c0c29c3c9c80",
                                                "text": "Силы небесные соединили нас, и силы земные, и силы морские, магниты всего мира и те, что спрятаны в недрах Луны."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
