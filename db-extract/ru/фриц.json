                        ],
                        "form": "Фри́цах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f501dd90-1953-32e3-9bf6-f63cb8a13810",
                        "entry_id": "d4d6e4ee-18d9-317c-a8a9-5f43609d8820",
                        "glosses": [
                            "немецкое мужское имя; часто гипокор. к Фридрих"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b140bbd2-a514-4009-b8b0-ac39bf7d0dd2",
                        "source_entry_id": "d4d6e4ee-18d9-317c-a8a9-5f43609d8820",
                        "source_sense_id": "f501dd90-1953-32e3-9bf6-f63cb8a13810",
                        "target_lang_word": "Fritz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fritz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d63ed56-09ed-3af4-97dd-2e87750d9adf",
                                        "entry_id": "28de59a5-4efc-3da1-947f-6c0c925217ab",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c5e948-6d6a-440c-9b1a-08ea630f3b0d",
                                                "sense_id": "9d63ed56-09ed-3af4-97dd-2e87750d9adf",
                                                "text": "Fritz isst immer mein Pausenbrot."
                                            },
                                            {
                                                "example_id": "0718b9c1-7f14-4e7e-a0f1-766133c0cea6",
                                                "sense_id": "9d63ed56-09ed-3af4-97dd-2e87750d9adf",
                                                "text": "Louise ist auf dem dünnen Eis eingebrochen, heroisch eilt der junge Offizier zu ihrer Rettung. Der Erzähler gesteht den deutschen Soldaten, die schnell Louisens und Fritzens Rettung organisieren, Entschlossenheit und Tatkraft zu."
                                            },
                                            {
                                                "example_id": "a573f415-35a7-4fb6-ad10-d9bef3fe7486",
                                                "sense_id": "9d63ed56-09ed-3af4-97dd-2e87750d9adf",
                                                "text": "Wohl möglich wäre, daß zwei Fritze unterschieden werden müssen, Vater und Sohn, etwa Fritz I. 1400-1428 und Fritz II c. 1444."
                                            },
                                            {
                                                "example_id": "f5f18e67-4aff-4ca4-b952-318e09b9c327",
                                                "sense_id": "9d63ed56-09ed-3af4-97dd-2e87750d9adf",
                                                "text": "Eine besonders fruchtbare Tätigkeit haben zwei Fritze entfaltet: Fritz Diehm und Fritz Römhild, der sich als Schriftsteller Fritz Romeo nennt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fritz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b28fdb76-d397-371c-8b0f-5c723be10f2d",
                                        "entry_id": "dd31ce40-8c23-3b17-98e2-fffc1c7cca7a",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9828da4-7bc1-4470-a382-e815d644304e",
                                                "sense_id": "b28fdb76-d397-371c-8b0f-5c723be10f2d",
                                                "text": "Fräulein Fritz hört schon wieder so laut Grammophon."
                                            },
                                            {
                                                "example_id": "97379e46-c83b-4089-8186-7c0f7c9111d7",
                                                "sense_id": "b28fdb76-d397-371c-8b0f-5c723be10f2d",
                                                "text": "Herr Fritz wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "c4366ac4-770c-4741-a49a-2b478aedb8a9",
                                                "sense_id": "b28fdb76-d397-371c-8b0f-5c723be10f2d",
                                                "text": "Die Fritzens fliegen heute nach Paris."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fritz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4003a7a-08ff-30d2-9a2d-9a5371c0a19d",
                                        "entry_id": "e93dbf9e-ce20-3d4c-b905-04675a7b837e",
                                        "glosses": [
                                            "meist abwertend, von Nicht-Deutschen verwendet, die (Verkörperung der) Deutschen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a9a5837-e09d-4d6c-b170-ead163ccb074",
                                                "sense_id": "e4003a7a-08ff-30d2-9a2d-9a5371c0a19d",
                                                "text": "Drüben lag der deutsche „Fritz“, der Feind, der in ihr Land eingefallen war, der offen die Absicht aussprach, sie zu versklaven, wie er schon viele Völker versklavt hatte, und nun war einer zu ihnen gekommen, der auch aus Deutschland stammte und doch kein „Fritz“ war."
                                            },
                                            {
                                                "example_id": "7ff73c6c-552b-4736-bb64-db28659e7dc1",
                                                "sense_id": "e4003a7a-08ff-30d2-9a2d-9a5371c0a19d",
                                                "text": "Alle Anstrengungen der Deutschen bewirkten bei den Bewohnern das Hauses «sechs Strich eins» nicht Schrecken, sondern nur herablassenden Spott: «Ach, wie sich der Fritz heute wieder anstrengt!» «Schau, was diese Halunken sich da ausgedacht haben …»"
                                            },
                                            {
                                                "example_id": "685811da-26a7-4b7e-8115-b60b2bf0125b",
                                                "sense_id": "e4003a7a-08ff-30d2-9a2d-9a5371c0a19d",
                                                "text": "Gegenwärtig geht es uns nicht schlecht. Wir essen und trinken zur Genüge, was der verfluchte Fritz seinerzeit bei uns gestohlen hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                        "entry_id": "e93dbf9e-ce20-3d4c-b905-04675a7b837e",
                                        "glosses": [
                                            "ein Deutscher, besonders ein deutscher Soldat"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a0f098-0f5c-4d2c-a22c-084b9fc70e42",
                                                "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                                "text": "Eigentlich, denkt er, bist du das größte Rindvieh unter Rußlands Sonne, Fedor Tarkanow. Kaum hast du Sohn und Frau, stürzt du dich in das verrückteste aller Abenteuer und riskierst Kopf und Kragen für zwei Fritzen."
                                            },
                                            {
                                                "example_id": "59b16abd-e89e-450b-9b75-44a35e154074",
                                                "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                                "text": "„Wassilij allein“, der Major wies auf den schlafenden Offizier, „hat drei Fritze mit seinem Revolver niedergestreckt.\""
                                            },
                                            {
                                                "example_id": "453d37de-fbc5-47a1-9ba2-dd713ea9f4c5",
                                                "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                                "text": "Die sowjetischen Kameraden blickten schweigend auf die beiden Deutschen. Der eine, ihr Genosse, trug die Sowjetuniform, der andere, ihr Gefangener, die Wehrmachtsuniform. Jewgenij rief: „Professor, was ist das für ein Fritz? Kennst du ihn von früher?“ Viktor wandte sich an seine Sowjetgenossen, zeigte auf Herbert und sagte : „Genossen! Das ist ein Verwandter von mir. Herbert heißt er […]“"
                                            },
                                            {
                                                "example_id": "9124594e-f59c-4edb-8615-68f7cd4605ce",
                                                "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                                "text": "Wohin man den Blick auch immer wendete, überall lagen die Leichen der Fritzen herum."
                                            },
                                            {
                                                "example_id": "721878f7-087e-496a-a3a7-77de179bd13d",
                                                "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                                "text": "« […] seite heute Morgen habe ich fünf Fritzen umgelegt und dabei vier Granaten verbraucht.»"
                                            },
                                            {
                                                "example_id": "41d85599-e78b-4e55-bcbf-cf1455861aff",
                                                "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                                "text": "[…] Kommandeur des Trupps sich geweigert habe, einen Rechenschaftsbericht zu schreiben, mit der Begründung: «Ich hab keine Zeit, mich mit blödem Papierkram zu befassen. Wir legen nur vor den Fritzen Rechenschaft ab.»"
                                            },
                                            {
                                                "example_id": "4bf07f97-2c49-4d04-900f-6c44265059df",
                                                "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                                "text": "Nadja wußte, daß Serjoshka die Wahrheit sprach; er hatte zwei Fritze erschossen und würde noch mehr erschießen. „Sie werden dich erschießen“, befürchtete sie."
                                            },
                                            {
                                                "example_id": "40447ed4-886f-42cc-9390-746bdfaaec9a",
                                                "sense_id": "b713ade6-fddc-3a0e-9302-749880ba8b94",
                                                "text": "Ein Güterzug der Deutschen war entgleist, irgendwo im Wald waren zwei Fritze kaltgemacht und beide Taten den Kommunisten angelastet worden, […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
