                                    {
                                        "sense_id": "335ac296-7906-391c-85bb-2d448a42f488",
                                        "entry_id": "2b2b7442-e7d3-30c3-9f39-090ab5cc531b",
                                        "glosses": [
                                            "A motion or gesture that swats; a swat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1f027b8-a739-4ee9-b8a4-9854b2abf9ce",
                                                "sense_id": "335ac296-7906-391c-85bb-2d448a42f488",
                                                "text": "This […] evoked a new disorder — a tendency to sudden, tic-like jabbings and swattings in the air, as if she were fending off flies or mosquitoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c028771b-8094-3fc8-b2a5-15a5d19931d3",
                                        "entry_id": "2b2b7442-e7d3-30c3-9f39-090ab5cc531b",
                                        "glosses": [
                                            "The action of making an illegitimate call to the police so as to have a SWAT team dispatched to a location."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f28df2e2-fa13-4eb4-97ff-6ce8bda4cf8a",
                                                "sense_id": "c028771b-8094-3fc8-b2a5-15a5d19931d3",
                                                "text": "Swatting started in the combative world of online gaming. It was a way to terrorize someone more famous, get even with a rival or retaliate against someone with different political views."
                                            },
                                            {
                                                "example_id": "164c6a25-c0c6-464c-8857-ea45d78a8028",
                                                "sense_id": "c028771b-8094-3fc8-b2a5-15a5d19931d3",
                                                "text": "Mr. Herring’s relatives said they wanted tougher laws against swatting and more training for police agencies on how to recognize potential fake calls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
