                        "entry_id": "9c2e3e65-340c-3324-a0c3-f4aa7232a149",
                        "glosses": [
                            "regularne, obligatoryjne świadczenia, na ogół pieniężne, na rzecz osób fizycznych, do których zobowiązywane są na drodze prawnej inne osoby fizyczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c954de1-da58-4b47-bc56-0cf8fc89bff9",
                                "sense_id": "6d4f2344-1c0f-3cb8-aa42-f1efc5ba9aaa",
                                "text": "Joanna długo sądziła się z byłym mężem o alimenty."
                            },
                            {
                                "example_id": "83b8cb9d-7f70-4faf-b69c-4a225568a7b7",
                                "sense_id": "6d4f2344-1c0f-3cb8-aa42-f1efc5ba9aaa",
                                "text": "Udało się to Marlenie, która dziś w internecie radzi nie tylko, jak złapać na dziecko, ale jak potem wywalczyć wysokie alimenty"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1161204e-8f19-4a08-91e9-e740f7064e10",
                        "source_entry_id": "9c2e3e65-340c-3324-a0c3-f4aa7232a149",
                        "source_sense_id": "6d4f2344-1c0f-3cb8-aa42-f1efc5ba9aaa",
