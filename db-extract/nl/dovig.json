                                "example_id": "f0c4c940-ebab-4280-be1f-0a9422a81640",
                                "sense_id": "d6b99d9a-fad7-3491-ab61-39929ac9de17",
                                "text": "Aznavour was vrij dovig en droeg een gehoorapparaatje. Dan zei hij ineens: ’Why are you shouting?’"
                            }
                        ]
