                    {
                        "translation_id": "db05d74f-c71a-49e5-9301-c70a9537ad9c",
                        "source_entry_id": "f0cfe740-da4c-3700-b07e-7d57c9e44171",
                        "source_sense_id": "79274471-6d77-3f48-9a57-425ce3821ae4",
                        "target_lang_word": "maison de retraite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maison de retraite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96a15b06-2be3-3d7b-8d08-994d7081330d",
                                        "entry_id": "95120ba0-0647-3a9a-a8c3-06a19d1b141b",
                                        "glosses": [
                                            "Établissement public ou privé, où l’on reçoit les personnes âgées ou retraités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d943d08d-676b-4f99-9d1d-7388af1cdf14",
                                                "sense_id": "96a15b06-2be3-3d7b-8d08-994d7081330d",
                                                "text": "Plus de deux siècles plus tard, Constant Coquelin, ému par la déchéance de quelque ancienne gloire des tréteaux, crée une maison de retraite pour comédiens. Comme l’humour n'est jamais loin avec les histrions, il l'installe à Couilly-Pont-aux-Dames, en Seine-et-Marne..."
                                            },
                                            {
                                                "example_id": "cc6b56b8-b639-48d3-b3e0-4d24ddbc1ac9",
                                                "sense_id": "96a15b06-2be3-3d7b-8d08-994d7081330d",
                                                "text": "Quoique tous les habitants de la « petite Corse » fussent présents, cela composait un bien maigre cortège et les étrangers au quartier, regardant passer ce défilé de vieillards, pensaient à la disparition de pensionnaires d’une maison de retraite, mais il s’étonnaient qu’en en enterrât trois à la fois."
                                            },
                                            {
                                                "example_id": "364d8c97-a4fd-4835-96e6-3ca930fda3b4",
                                                "sense_id": "96a15b06-2be3-3d7b-8d08-994d7081330d",
                                                "text": "La maison de retraite, elle ne supporte pas. Elle veut rentrer chez elle, et je retourne à nouveau cette solution dans tous les sens. Il lui faudrait une aide à domicile à plein temps, sa retraite n’y suffirait pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
