                "senses": [
                    {
                        "sense_id": "c0d044f8-5397-338c-9c92-c423540cb5ab",
                        "entry_id": "33a495e2-f0b3-323d-8f8b-5315050717ec",
                        "glosses": [
                            "ein märchenhaftes paar Stiefel, welches seinem Träger die Fähigkeit verleiht, große Entfernungen in kurzer Zeit zurück zu legen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d9b110c-d4d1-43b1-8c53-f06d8fe7aba9",
                                "sense_id": "c0d044f8-5397-338c-9c92-c423540cb5ab",
                                "text": "„… Siebenmeilenstiefel sind zu schwer, für den weiten Weg durchs Sternenmeer …“"
                            },
                            {
                                "example_id": "2913ad8e-c54b-4896-ba47-949cc6f65566",
                                "sense_id": "c0d044f8-5397-338c-9c92-c423540cb5ab",
                                "text": "„Der Sage nach rastete einst ein vom weiten Weg ermüdeter Riese auf der Felskante des Sonnenstein und schüttete währenddessen den Sand aus seinen Siebenmeilenstiefeln.“"
                            },
                            {
                                "example_id": "2ac22a14-dc38-41d0-826a-f0872b7df7b1",
                                "sense_id": "c0d044f8-5397-338c-9c92-c423540cb5ab",
                                "text": "Jetzt geht es mit der Emanzipation in Siebenmeilenstiefeln voran!"
                            },
                            {
                                "example_id": "dc34335f-c0e8-4fa4-85a5-863df0571cbf",
                                "sense_id": "c0d044f8-5397-338c-9c92-c423540cb5ab",
                                "text": "Thomas schreitet wie mit Siebenmeilenstiefeln mächtig aus, damit er nicht zurückbleibt."
                            },
                            {
                                "example_id": "4a27aaa2-8097-4d3b-8be9-820afb34be1e",
                                "sense_id": "c0d044f8-5397-338c-9c92-c423540cb5ab",
                                "text": "Wenn man diese Entwicklungen innerhalb der letzten Jahrzehnte gewissermaßen mit Siebenmeilenstiefeln durchmißt, muß man feststellen, daß die Progression chirurgischer Behandlungsverfahren immer schneller vor sich geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "424b1179-dcf1-457c-980c-d1fc3366264b",
                        "source_entry_id": "33a495e2-f0b3-323d-8f8b-5315050717ec",
                        "source_sense_id": "c0d044f8-5397-338c-9c92-c423540cb5ab",
                        "target_lang_word": "seven-league boots",
