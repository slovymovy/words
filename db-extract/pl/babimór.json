                        "glosses": [
                            "Lycopodium clavatum, gatunek widłaka rosnącego w lasach sosnowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d92197b-66db-4522-92cf-e1f4c4b397fd",
