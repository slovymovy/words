                        "entry_id": "fff865f8-44e4-34cc-a790-092bc4971a99",
                        "glosses": [
                            "Celui qui joue de la vielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6752bdbe-64b6-469b-8119-143910576dd3",
                                "sense_id": "42fad968-ad2b-32cd-84d6-4dde84bc9e71",
                                "text": "Personne, le vielleur de Leigneux en était sûr, n’avait jamais parlé au Curé d’Ars de cette vielle de malheur."
                            },
                            {
                                "example_id": "1a527212-2143-45bb-8a50-6e15ab0d226e",
                                "sense_id": "42fad968-ad2b-32cd-84d6-4dde84bc9e71",
                                "text": "Il ne nous reste plus qu’à savourer le plaisir d’avoir pris Dieu en défaut, à l’instar de cet homme charitable qui tomba par la fenêtre en voulant aumôner le vielleur."
                            }
                        ]
                    }
