                ],
                "senses": [
                    {
                        "sense_id": "365d5277-52eb-3c78-9b70-7c519ba49677",
                        "entry_id": "ba68934d-81d5-3409-acd1-5a706f1bc434",
                        "glosses": [
                            "feste Seife ohne Zusätze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9750a9d1-783a-498f-94e0-dae39fd32052",
                                "sense_id": "365d5277-52eb-3c78-9b70-7c519ba49677",
                                "text": "Er wäscht sich seine Hände mit Kernseife."
                            },
                            {
                                "example_id": "40c65699-01f4-4d87-a400-a191377cac9f",
                                "sense_id": "365d5277-52eb-3c78-9b70-7c519ba49677",
                                "text": "„Als meine Großmutter starb, besaß sie nur eine Stange Kernseife, damals in Polen Gold wert bei entsprechender Armut, und zwei Gardinen am Fenster, handgenäht vor siebzig Jahren.“"
                            },
                            {
                                "example_id": "327d30a8-bd65-478a-baaf-3cebc757e900",
                                "sense_id": "365d5277-52eb-3c78-9b70-7c519ba49677",
                                "text": "„Zuerst roch er wie Kernseife, dann wie 4711, ein wenig kaschiert, und dann süß, je später es wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e6a0d61-b4d5-4424-b295-5fc757557266",
                        "source_entry_id": "ba68934d-81d5-3409-acd1-5a706f1bc434",
                        "source_sense_id": "365d5277-52eb-3c78-9b70-7c519ba49677",
                        "source_sense_description": "feste Seife ohne Zusätze",
                        "target_lang_word": "savon de Marseille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "savon de Marseille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1309dd60-c7e1-35dc-a48f-ac82cac24246",
                                        "entry_id": "51e20a1e-7565-31bf-a3d5-5fe7a45b5a18",
                                        "glosses": [
                                            "Savon fabriqué à partir d’huiles végétales ou animales et de soude caustique (hydroxyde de sodium)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17614380-77d0-4a69-930d-677f7987ab54",
                                                "sense_id": "1309dd60-c7e1-35dc-a48f-ac82cac24246",
                                                "text": "Elle me frottait à outrance, me faisait avaler par tous les pores, de la soude et du suif, que pleurait un savon de Marseille à deux sous le morceau, qui empestait comme une fabrique de chandelles. Elle m’en fourrait partout, les yeux m’en piquaient pendant une semaine, et ma bouche en bavait…\nJ’ai bien détesté la propreté, grâce à ce savon de Marseille !"
                                            },
                                            {
                                                "example_id": "5cab86e6-a20e-4fe7-adf8-c840c2f641e0",
                                                "sense_id": "1309dd60-c7e1-35dc-a48f-ac82cac24246",
                                                "text": "Du savon, aussi, du Marseille, en barres d’un mètre de long, très économiques, t’y gagnes vachement."
                                            },
                                            {
                                                "example_id": "ee444604-51de-4905-82b5-ed5fd6e6b276",
                                                "sense_id": "1309dd60-c7e1-35dc-a48f-ac82cac24246",
                                                "text": "Une lessive maison se compose principalement d’eau et de savon de Marseille, auxquels on ajoute de la soude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59b5cb8b-38ac-493d-9168-1bf009c571c8",
                        "source_entry_id": "ba68934d-81d5-3409-acd1-5a706f1bc434",
