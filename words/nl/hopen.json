                        ],
                        "tr": [
                            {
                                "target_lang_word": "ummak",
                                "target_lang_sense_clarification": "bir şeyin olmasını beklemek veya istemek"
                            },
                            {
                                "target_lang_word": "ümit etmek",
                                "target_lang_sense_clarification": "bir şeyin gerçekleşmesini dilemek"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "esperar",
                                "target_lang_sense_clarification": "tener la esperanza de conseguir algo que se desea"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希望",
                                "target_lang_sense_clarification": "想要某事发生"
                            }
                        ]
                    }
