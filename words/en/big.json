                {
                    "sense_id": "55fd535f-fc8d-39fd-bf0f-dc8ac100e8ce",
                    "sense_definition": "Operating on a very large scale, often implying powerful or sinister corporate influence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "corporate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are many ethical concerns regarding the power of <w>big</w> pharma.",
                            "target_lang_translations": {
                                "ru": "Существует много этических вопросов относительно власти <w>крупных</w> фармацевтических компаний."
                            }
                        },
                        {
                            "text": "The government is looking into new regulations for <w>big</w> tech companies.",
                            "target_lang_translations": {
                                "ru": "Правительство рассматривает новые правила для <w>крупных</w> технологических компаний."
                            }
