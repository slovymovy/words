                    {
                        "sense_id": "247aca04-acb3-3d06-9f17-a400991f6acc",
                        "entry_id": "94505060-1b82-3ae9-b313-bbbbfb71d478",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "95928f3e-af95-480d-afd9-f80a400a7a60",
                                "sense_id": "247aca04-acb3-3d06-9f17-a400991f6acc",
                                "text": "Frau Seipenbusch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "be1d637c-4995-4402-b4e2-4cdb234d5ff1",
                                "sense_id": "247aca04-acb3-3d06-9f17-a400991f6acc",
                                "text": "Herr Seipenbusch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "00783d88-e67e-4cea-8b1e-ae1503a7483b",
                                "sense_id": "247aca04-acb3-3d06-9f17-a400991f6acc",
                                "text": "Die Seipenbuschs fliegen heute nach Seattle."
                            },
                            {
                                "example_id": "34a281b4-9bac-4e76-b5af-bb3536bc5574",
                                "sense_id": "247aca04-acb3-3d06-9f17-a400991f6acc",
                                "text": "Der Seipenbusch trägt nie die Pullover, die die Seipenbusch ihm strickt."
                            },
                            {
                                "example_id": "3968c2d7-c81d-45c4-a8c5-f43b1e8f93bf",
                                "sense_id": "247aca04-acb3-3d06-9f17-a400991f6acc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Seipenbusch kommt, geht der Herr Seipenbusch.“"
                            },
                            {
                                "example_id": "1fb0dfe2-1e08-49f4-a447-875c06099b1e",
                                "sense_id": "247aca04-acb3-3d06-9f17-a400991f6acc",
                                "text": "Seipenbusch kommt und geht."
                            },
                            {
                                "example_id": "c3f4541f-1a21-4019-8702-d36a613ec288",
                                "sense_id": "247aca04-acb3-3d06-9f17-a400991f6acc",
                                "text": "Seipenbuschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
