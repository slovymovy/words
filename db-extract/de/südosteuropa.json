                        "entry_id": "5ff43171-eed0-3923-aed7-2a216bee8d3c",
                        "glosses": [
                            "Region in Europa, die aus den Ländern Albanien, Bosnien und Herzegowina, Bulgarien, Griechenland, Kroatien, Mazedonien, Moldau, Montenegro, Rumänien, Serbien, Slowenien, Ungarn und Türkei (nur Ost-Thrakien) besteht (kann variieren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c032fe-aa32-4383-87df-ab9c30e72f03",
                                "sense_id": "0c03b67a-e1e3-3460-8c3d-6798080067bb",
                                "text": "Auch Slowenien und Moldawien könnten in gewisser historischer Hinsicht und je nach Einteilung zu Südosteuropa gezählt werden."
                            },
                            {
                                "example_id": "01b1a531-e686-43cb-9f88-2c8f23587f29",
                                "sense_id": "0c03b67a-e1e3-3460-8c3d-6798080067bb",
                                "text": "Die Menschen in Südosteuropa stöhnen unter einer Hitzewelle."
                            }
                        ],
                        "sense_index_json": "\"1\""
