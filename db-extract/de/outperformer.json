                "senses": [
                    {
                        "sense_id": "1e35c67d-27bc-3411-a038-922a8459ad2f",
                        "entry_id": "49c849ba-2961-3b94-8d1b-972d79945781",
                        "glosses": [
                            "Aktie, deren Kurs sich überdurchschnittlich entwickelt hat, indem er stärker als die Märkte gestiegen oder weniger als diese gefallen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26496ec1-fab9-4681-b638-97ab3eaf580e",
                                "sense_id": "1e35c67d-27bc-3411-a038-922a8459ad2f",
                                "text": "„Zu MacKenzies Favoriten innerhalb des Sektors zählen Schlumberger und Halliburton - die Nummern eins und zwei unter den Öl-Dienstleistern. Beide Unternehmen stuft er als Outperformer ein.“"
                            },
                            {
                                "example_id": "e9415392-7fa4-43b5-beb7-2f54a87e91cf",
                                "sense_id": "1e35c67d-27bc-3411-a038-922a8459ad2f",
                                "text": "„Die Frage der Vorgehensweise ist zurzeit besonders aktuell, da einige der einstigen Outperformer mit quantitativem Ansatz hinter dem Markt liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
