                    {
                        "translation_id": "08640918-fce9-4253-833d-b4eaec15bd44",
                        "source_entry_id": "55cd455c-8ead-30f2-b697-63b6f06c0755",
                        "source_sense_id": "2e8daf7f-7f4d-309d-81ad-4418fdb37ce0",
                        "target_lang_word": "intern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3438cab5-3c60-3131-8ce8-fe8cfcf8cd5a",
                                        "entry_id": "eff1291a-e77d-31d4-b20c-ccddc8b8c60b",
                                        "glosses": [
                                            "A person who is interned, forcibly or voluntarily."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "intern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "032f9ab0-d892-35d4-b290-f5297ccbfa6c",
                                        "entry_id": "219fcb2c-ed6e-3746-9f7d-04934085b652",
                                        "glosses": [
                                            "To imprison somebody, usually without trial."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b2c3f9-2737-4734-a28e-aedea991337c",
                                                "sense_id": "032f9ab0-d892-35d4-b290-f5297ccbfa6c",
                                                "text": "The US government interned thousands of Japanese-Americans during World War II."
                                            },
                                            {
                                                "example_id": "d60ea0e8-796c-4c75-853c-0c3540425d97",
                                                "sense_id": "032f9ab0-d892-35d4-b290-f5297ccbfa6c",
                                                "text": "That description was of a camp at the Tanforan Racetrack near San Francisco, one of several centers in California where Japanese and Japanese-American residents (Issei and Nisei) were held before being interned in areas remote from the West Coast."
                                            },
                                            {
                                                "example_id": "e55d5615-332e-4170-8303-5a1b4714fbb4",
                                                "sense_id": "032f9ab0-d892-35d4-b290-f5297ccbfa6c",
                                                "text": "Cuba could take pride in its health system. It could, that is, if it weren't for the way it treats those who test positive [for HIV], whether sick or not, interning them in an isolation that has no medical justification, that is against all scientific direction and is a frontal assault on all human rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc339922-2091-353d-b46b-9d1019d50dd6",
                                        "entry_id": "219fcb2c-ed6e-3746-9f7d-04934085b652",
                                        "glosses": [
                                            "To imprison somebody, usually without trial.",
                                            "To confine or hold (foreign military personnel who stray into the state's territory) within prescribed limits during wartime."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd72bbc0-032c-43a7-bc68-f92389c36105",
                                                "sense_id": "fc339922-2091-353d-b46b-9d1019d50dd6",
                                                "text": "The Swiss government interned the Italian soldiers who had strayed onto Swiss territory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c726ee7-19fe-3107-8156-94ca90ec136d",
                                        "entry_id": "219fcb2c-ed6e-3746-9f7d-04934085b652",
                                        "glosses": [
                                            "To internalize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bea5d9dc-e69a-40a3-a5f1-dc371c45003a",
                                                "sense_id": "1c726ee7-19fe-3107-8156-94ca90ec136d",
                                                "text": "Strings are automatically interned if they are assigned to a literal string within code."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db023748-0c38-3c91-b1fb-2a99b53e14c0",
                                        "entry_id": "8312c55d-9680-3411-8850-0109a959aa95",
                                        "glosses": [
                                            "Internal."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4597ac-8c0c-44cc-8da4-4254623a679c",
                                                "sense_id": "db023748-0c38-3c91-b1fb-2a99b53e14c0",
                                                "text": "Man was made after Gods image, which must be understood of the intern graces of the Soule"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9744e0ab-e35a-38ea-ac6e-97144291beae",
                                        "entry_id": "04a1481d-c9e1-3538-968c-ca463c10d97b",
                                        "glosses": [
                                            "A student or recent graduate who works in order to gain experience in their chosen field."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "355bf99b-f0ff-43ce-b2ec-462786880e68",
                                                "sense_id": "9744e0ab-e35a-38ea-ac6e-97144291beae",
                                                "text": "Students know that working as an intern can provide contacts and all-important experience in their chosen fields. And last year, 26 percent of graduates hired by companies had worked as interns, compared with 9 percent the year before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e2b0ca-07b3-383b-bb95-9b47881be012",
                                        "entry_id": "04a1481d-c9e1-3538-968c-ca463c10d97b",
                                        "glosses": [
                                            "A medical student or recent graduate working in a hospital as a final part of medical training."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "intern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82469e4e-0f65-35f2-bf4e-f2e8bbd0bd12",
                                        "entry_id": "f4e0f89a-98df-3bd6-8880-e9fcecc663ce",
                                        "glosses": [
                                            "To work as an intern, usually with little or no pay or other legal prerogatives of employment, and for the purpose of furthering a program of education."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02d397f-8459-4fb3-ad1b-fd73eab8f6dc",
                                                "sense_id": "82469e4e-0f65-35f2-bf4e-f2e8bbd0bd12",
                                                "text": "I'll be interning at Universal Studios this summer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbb546b1-9050-4fd4-9f5e-1a8f8c3f840a",
                        "source_entry_id": "55cd455c-8ead-30f2-b697-63b6f06c0755",
