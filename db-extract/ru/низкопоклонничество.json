                "senses": [
                    {
                        "sense_id": "3f4eef45-76b0-31a4-a028-fa2605a32bd9",
                        "entry_id": "2152ce6c-f061-3fa9-93de-185908d59d50",
                        "glosses": [
                            "устар. рабское и льстивое преклонение перед кем чем-нибудь"
                        ],
                        "tags": [],
