                        "sense_id": "f65b56ec-d335-347f-b026-26356f1a830c",
                        "entry_id": "eab7d427-bfc7-3d9d-97c4-c6e743d8d72b",
                        "glosses": [
                            "To make, or treat as, gigantic."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3cec3b3f-0ff8-4403-bc73-f218c18a3f76",
                                "sense_id": "f65b56ec-d335-347f-b026-26356f1a830c",
                                "text": "Modern public life has seen the gigantizing and centralizing of economic and political developments."
                            },
                            {
                                "example_id": "27c56f6c-fe7a-4da8-9c87-f7961c2bef4d",
                                "sense_id": "f65b56ec-d335-347f-b026-26356f1a830c",
                                "text": "We gigantize the few “successful” public writers who avoid the degradations of trade publishing or the corporate university precisely because these figures are so exceptional."
                            }
                        ]
                    }
                ],
