                    {
                        "translation_id": "699ef5ee-a1e2-4650-a749-b9746bb4c1a2",
                        "source_entry_id": "092fe2c0-cc91-3030-a1a7-4dafeab7b907",
                        "source_sense_id": "7e81652e-b569-36d5-a73d-c475efb31207",
