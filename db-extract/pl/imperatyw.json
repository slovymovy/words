                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                                        "entry_id": "d57f3c15-b5a9-3a98-b21e-1961d60488d6",
                                        "glosses": [
                                            "Essential; crucial; extremely important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e04abe-83cb-4f4f-b19b-3c90d8ad0510",
                                                "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                                                "text": "That you come here right now is imperative."
                                            },
                                            {
                                                "example_id": "b098dacb-a84a-4816-91e2-cab92d21dfca",
                                                "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                                                "text": "Meantime, alterations at King William Street had become imperative, and by December 22, 1895, the station had been remodelled, as at Stockwell, to provide an island platform with lines each side, and a scissors crossing."
                                            },
                                            {
                                                "example_id": "5d862352-340c-4e0e-a13e-490d81f4cf8c",
                                                "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                                                "text": "Give this document to Ozzy. It's imperative that he reads and understands it. Got it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2f8a2a-6db1-332e-84de-7f895fe25c49",
                                        "entry_id": "d57f3c15-b5a9-3a98-b21e-1961d60488d6",
                                        "glosses": [
                                            "Of, or relating to the imperative mood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdc78d5f-f124-3277-911f-0756c25271b4",
                                        "entry_id": "d57f3c15-b5a9-3a98-b21e-1961d60488d6",
                                        "glosses": [
                                            "Having semantics that incorporates mutable variables."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8de83be-be28-3ca2-b1bf-6fa1a00ec872",
                                        "entry_id": "d57f3c15-b5a9-3a98-b21e-1961d60488d6",
                                        "glosses": [
                                            "Expressing a command; authoritatively or absolutely directive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cdb5d72-d28e-4da2-b83c-a1810d3f4575",
                                                "sense_id": "d8de83be-be28-3ca2-b1bf-6fa1a00ec872",
                                                "text": "imperative orders"
                                            },
                                            {
                                                "example_id": "bb7655b6-498e-455c-bf8d-97297128c388",
                                                "sense_id": "d8de83be-be28-3ca2-b1bf-6fa1a00ec872",
                                                "text": "The suits of kings are imperative."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imperative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64776650-b20e-3f01-94f7-a6742c64ab47",
                                        "entry_id": "6f40d7d5-f72b-32bd-bcaa-4f974b6c0aa4",
                                        "glosses": [
                                            "The grammatical mood expressing an order (see jussive). In English, the imperative form of a verb is the same as that of the bare infinitive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef05d3b-3bbc-472c-8fbc-5d041215e0a1",
                                                "sense_id": "64776650-b20e-3f01-94f7-a6742c64ab47",
                                                "text": "The verbs in sentences like \"Do it!\" and \"Say what you like!\" are in the imperative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6be7413-fa51-3bff-804e-d113803afca8",
                                        "entry_id": "6f40d7d5-f72b-32bd-bcaa-4f974b6c0aa4",
                                        "glosses": [
                                            "A verb in the imperative mood."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                                        "entry_id": "6f40d7d5-f72b-32bd-bcaa-4f974b6c0aa4",
                                        "glosses": [
                                            "An essential action, a must: something which is imperative."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97dd3542-1e1f-4ad4-87ad-c29bf223a78d",
                                                "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                                                "text": "Visiting Berlin is an imperative."
                                            },
                                            {
                                                "example_id": "8d93fcd6-6058-4c96-9322-0ad262a52c36",
                                                "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                                                "text": "Anything grandiose or historically based tends to sound flat and banal when it reaches English, partly because translators get stuck between contradictory imperatives: juggling fidelity to the original sense with what is vocally viable, they tend to resort to a genteel fustian which lacks either poetic resonance or demotic realism, adding to a sense of artificiality rather than enhancing credibility."
                                            },
                                            {
                                                "example_id": "26804bb8-5cac-4507-9f9c-b55f5badbbb6",
                                                "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                                                "text": "The new imperative for investment is the Government's objective to secure carbon-neutral transport emissions by 2040."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
