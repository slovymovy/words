                    {
                        "sense_id": "1e4dd183-c061-37e0-82a7-42f32ae68263",
                        "entry_id": "2302e0cd-411a-3545-b898-4313475831e4",
                        "glosses": [
                            "Jerry-built."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "add82519-3f41-4c96-9da4-d1fccbd9d6ed",
                                "sense_id": "1e4dd183-c061-37e0-82a7-42f32ae68263",
                                "text": "If a man builds a jerry-house, he has a jerry conscience; and there are a lot of consciences of that description going about."
