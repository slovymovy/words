                    {
                        "translation_id": "f7bffbbb-1d62-43c0-ac79-42252e6643d7",
                        "source_entry_id": "fa76917a-888b-36d9-af3c-72716bc2e78c",
                        "source_sense_id": "446a1021-c21a-33df-bac5-98c34323cd1c",
                        "source_sense_description": "Rebus",
                        "target_lang_word": "Rebus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rebus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e731735-494f-3c1e-b1c3-672b3bdf41f6",
                                        "entry_id": "2c8f46e8-aab8-3980-b34f-a9c6a0cbd8d9",
                                        "glosses": [
                                            "Rätsel aus aneinandergereihten Bildchen von Gegenständen mit einzelnen (zum Teil durchgestrichenen) Buchstaben, manchmal auch Ziffern, dazwischen; daraus soll ein Wort erraten werden, das mit den dargestellten Dingen inhaltlich nichts zu tun hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8bfe3c0-8d90-4d14-9a96-a8580372edf4",
                                                "sense_id": "5e731735-494f-3c1e-b1c3-672b3bdf41f6",
                                                "text": "Das ist ein Rebus."
                                            },
                                            {
                                                "example_id": "8326dda3-5153-4643-a051-bf90713679b0",
                                                "sense_id": "5e731735-494f-3c1e-b1c3-672b3bdf41f6",
                                                "text": "„Bei solch einem Rebus könnte etwa das Bild einer Mohnpflanze gefolgt von dem Buchstaben (Phonogramm) D das Wort Mond ergeben.“"
                                            },
                                            {
                                                "example_id": "4f544b9e-2f42-4d4a-8c04-204c9319e5c0",
                                                "sense_id": "5e731735-494f-3c1e-b1c3-672b3bdf41f6",
                                                "text": "„Diese Wortlautschrift erlaubt es nun auch, nach dem Prinzip des Bilderrätsels, des Rebus (…) aus ursprünglichen Bildzeichen neue Abstraktbegriffe zusammenzusetzen;…“"
                                            },
                                            {
                                                "example_id": "451840a6-e411-4513-a403-0d9037b36d34",
                                                "sense_id": "5e731735-494f-3c1e-b1c3-672b3bdf41f6",
                                                "text": "„Dies wird besonders im Fall der chinesischen Schrift mit ihrer langen, kontinuierlichen Tradition offensichtlich, wo die ursprüngliche Exklusivität der Logographie in späteren Entwicklungsphasen durch die Ergänzung des Rebus durchbrochen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
