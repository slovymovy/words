            {
                "entry_id": "c11acb23-9555-3b20-9f6f-c0efb72cdfb2",
                "word": "dactylogramme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3940ad7c-74c7-4176-8b69-b4c9e37aa783",
                        "entry_id": "c11acb23-9555-3b20-9f6f-c0efb72cdfb2",
                        "tags": [
                            "plural"
                        ],
                        "form": "dactylogrammes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "785d5e4d-d59e-378b-8eb0-af722a317cfc",
                        "entry_id": "c11acb23-9555-3b20-9f6f-c0efb72cdfb2",
                        "glosses": [
                            "Synonyme d’empreinte digitale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf1fa0a-5dd7-4e75-8d5a-47587f0b0355",
                                "sense_id": "785d5e4d-d59e-378b-8eb0-af722a317cfc",
                                "text": "Une empreinte digitale (ou dactylogramme) est le résultat de l’apposition d’un doigt sur un support après encrage de celui-ci."
                            },
                            {
                                "example_id": "60b29c77-5cf2-4be4-a2f0-7f7c604e754d",
                                "sense_id": "785d5e4d-d59e-378b-8eb0-af722a317cfc",
                                "text": "Une empreinte digitale ou dactylogramme est le dessin formé par les sillons des pulpes digitales. Ces sillons apparaissent sur la pulpe des doigts lors du développement embryonnaire et restent les mêmes tout au long de la vie, même si les cellules de la peau se renouvellent."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c9aae11-9f29-3472-beca-d49a6d24875a",
                        "entry_id": "c11acb23-9555-3b20-9f6f-c0efb72cdfb2",
                        "glosses": [
                            "Support (feuille de papier ou carton, par exemple) sur lequel sont conservées les empreintes digitales d’une personne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f4a07b7c-6421-3a66-926c-a6be010d8855",
                        "entry_id": "c11acb23-9555-3b20-9f6f-c0efb72cdfb2",
                        "glosses": [
                            "Manuscrit d’un auteur qu’il a lui-même dactylographié à l’aide d’un clavier (ordinateur ou machine à écrire). Synonyme de tapuscrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94843c8b-1f42-4204-9c4f-c6c323f63a18",
                                "sense_id": "f4a07b7c-6421-3a66-926c-a6be010d8855",
                                "text": "Quant aux éditions des romans publiés du vivant de Céline, elles ont été revues et enrichies d’appendices nouveaux. Du manuscrit et du dactylogramme de Voyage, qui n’étaient pas accessibles dans les années 1980, il a été tiré des transcriptions révélatrices."
                            }
                        ]
                    }
                ],
