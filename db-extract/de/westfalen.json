                        "examples": [
                            {
                                "example_id": "3ccb1d92-8ea3-4cca-807f-6d6e8001d97f",
                                "sense_id": "2ce74a2c-8bab-3a47-a3c8-f8dcee58c25a",
                                "text": "Die größte Stadt Westfalens ist Dortmund."
                            },
                            {
                                "example_id": "02e702e8-c922-494a-95f1-1335f705ef17",
                                "sense_id": "2ce74a2c-8bab-3a47-a3c8-f8dcee58c25a",
                                "text": "„Die weiter östlich und z. Z. auch höher gelegenen Gebiete des nördlichen rechtsrheinischen Schiefergebirges werden als Sauerland, d.h. Süderland (von Westfalen her gesehen), die rheinwärts gelegen Teile als Bergisches Land (nach dem ehemaligen Herzogtum Berg) bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
