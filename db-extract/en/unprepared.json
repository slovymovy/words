                        "entry_id": "4990de6d-88ca-395c-970c-f7f98321ab9e",
                        "glosses": [
                            "Not prepared; caught by surprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfbc2620-f7ad-410b-9e1d-6d44fe16daf2",
                                "sense_id": "8d04a47e-6d6e-39d3-82ea-90de30c05415",
                                "text": "The castle was unprepared for the assault."
                            },
                            {
                                "example_id": "b9a8ebfa-a605-49ad-9f38-0e04a3d0c156",
                                "sense_id": "8d04a47e-6d6e-39d3-82ea-90de30c05415",
                                "text": "I was unprepared for the change in attire and started slightly when the alectryomancer reappeared."
                            }
                        ]
                    }
