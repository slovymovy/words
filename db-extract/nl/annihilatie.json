                                "example_id": "13988047-3cba-42b8-b8bd-1c58ee2ffcac",
                                "sense_id": "432eea1d-046e-31ff-b0f6-0cd9b9c2ca36",
                                "text": "Door de explosie van annihilatie van materie en antimaterie zou de dunne schil van de stad op slag worden verscheurd alles daarbinnen veranderen in as."
                            },
                            {
                                "example_id": "71651f09-8b9e-4e11-a102-31ee8e64eb95",
                                "sense_id": "432eea1d-046e-31ff-b0f6-0cd9b9c2ca36",
                                "text": "Er waren verscheidene hypotheses over de manier waarop het druppeltje zichzelf kon vernietigen, maar de maximale hoeveelheid energie zou vrijkomen uit annihilatie via antimaterie."
                            }
                        ]
