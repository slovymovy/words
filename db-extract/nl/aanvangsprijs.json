                        "glosses": [
                            "de prijs die men in het begin van een periode moet betalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b78edc4-3eb0-466b-9a53-aff095dfbb50",
                                "sense_id": "bc74ce37-4e4f-3f8b-8629-ecaa52be7690",
                                "text": "Ondanks al dit heuglijke nieuws, lijken toch maar weinig mensen bij de Huurcommissie aan te kloppen. Het orgaan kreeg in 2017 in totaal 7.588 verzoeken, waarvan slechts 782 zaken gingen over de toetsing van de aanvangsprijs. Uit het verslag blijkt dat het aantal verzoeken van huurders ten opzichte van 2016 flink is gedaald."
                            }
