                ],
                "senses": [
                    {
                        "sense_id": "da169a94-a5a7-3e86-9991-ef72e56fd8d4",
                        "entry_id": "1e8efb0a-4bc2-3efd-ae28-6109a6629084",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4758bb98-72ba-450c-b0fa-87fdc41dc3d5",
                                "sense_id": "da169a94-a5a7-3e86-9991-ef72e56fd8d4",
                                "text": "Frau Knies ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "57f73986-a0f7-4096-9487-88fa08748778",
                                "sense_id": "da169a94-a5a7-3e86-9991-ef72e56fd8d4",
                                "text": "Herr Knies wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "18a3f4b8-9a07-422b-9748-ac03de90b6c2",
                                "sense_id": "da169a94-a5a7-3e86-9991-ef72e56fd8d4",
                                "text": "Die Kniess kommen heute von der Nordseeküste."
                            },
                            {
                                "example_id": "14e24120-09c0-465d-967c-2fa888902011",
                                "sense_id": "da169a94-a5a7-3e86-9991-ef72e56fd8d4",
                                "text": "Der Knies trägt nie die Schals, die die Knies ihm strickt."
                            },
                            {
                                "example_id": "3581f739-45dc-47cf-ac49-0d689be6129b",
                                "sense_id": "da169a94-a5a7-3e86-9991-ef72e56fd8d4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knies kommt, geht der Herr Knies.“"
                            },
                            {
                                "example_id": "10dcf8d9-c403-408d-8ab2-352430276f40",
                                "sense_id": "da169a94-a5a7-3e86-9991-ef72e56fd8d4",
                                "text": "Knies kommt und geht."
                            },
                            {
                                "example_id": "65bc4cf1-2a10-43ab-be9f-3ea07de2801a",
                                "sense_id": "da169a94-a5a7-3e86-9991-ef72e56fd8d4",
                                "text": "Kniess kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
