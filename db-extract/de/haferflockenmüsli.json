                "senses": [
                    {
                        "sense_id": "10f8e398-3465-33ee-bd69-387a771eaa3f",
                        "entry_id": "ad20e192-6ffd-3369-a1e6-7f056ecc726f",
                        "glosses": [
                            "Rohkostgericht, das (hauptsächlich) aus behandelten Haferkörnern besteht und mit Milch und/oder Joghurt vermischt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "228d59e3-8f2a-4059-b1e7-a9034127e4e4",
                                "sense_id": "10f8e398-3465-33ee-bd69-387a771eaa3f",
                                "text": "„Mein Frühstück war Haferflockenmüsli - das sind 240 Kilokalorien.“"
                            },
                            {
                                "example_id": "1e511bc0-4b9b-44ec-bf87-b5c613f54d71",
                                "sense_id": "10f8e398-3465-33ee-bd69-387a771eaa3f",
                                "text": "„Drei Stunden vorher esse ich unser ‚Haferflockenmüsli für Wettkampftage‘ und einen Toast mit selbstgemachter Nussbutter, und ich trinke einen Kaffee und ein Hydrierungsgetränk.“"
                            },
                            {
                                "example_id": "4263dc8a-5b58-42d3-a27e-30288700555c",
                                "sense_id": "10f8e398-3465-33ee-bd69-387a771eaa3f",
                                "text": "„Genauso ging es ihr mit dem Haferflockenmüsli, in dem sie lustlos herumstocherte, statt etwas davon zu essen.“"
                            },
                            {
                                "example_id": "82cab4a1-a08b-4b34-a2d4-ecb5c514e43b",
                                "sense_id": "10f8e398-3465-33ee-bd69-387a771eaa3f",
                                "text": "„Zur Auswahl stehen Haferflockenmüsli (am Vorabend vorgeweicht) und Obst, Kornflocken, Milch, Kartoffelpüree oder Reis.“"
                            },
                            {
                                "example_id": "f9dd61b4-acc6-4f4c-94d1-7f237f59391d",
                                "sense_id": "10f8e398-3465-33ee-bd69-387a771eaa3f",
                                "text": "„Diabetiker können ihre Lebensqualität somit durch den regelmäßigen Genuss eines Haferflockenmüslis verbessern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
