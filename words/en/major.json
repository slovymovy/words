{
    "word_family": [
        "majority",
        "majorly",
        "majorette"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2b86900a-84ed-34a2-98fd-e99a4d2bfada",
                    "sense_definition": "Very large, important, serious, or significant in size, extent, or degree.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pollution has become a <w>major</w> problem in many industrial cities.",
                            "target_lang_translations": {
                                "ru": "Загрязнение стало <w>серьёзной</w> проблемой во многих промышленных городах.",
                                "zh": "污染已经成为许多工业城市的<w>重大</w>问题。"
                            }
                        },
                        {
                            "text": "She played a <w>major</w> role in the success of the new project.",
                            "target_lang_translations": {
                                "ru": "Она сыграла <w>гла́вную</w> роль в успехе нового проекта.",
                                "zh": "她在这个新项目的成功中发挥了<w>重要</w>作用。"
                            }
                        },
                        {
                            "text": "The company announced a <w>major</w> change in its management structure.",
                            "target_lang_translations": {
                                "ru": "Компания объявила о <w>значи́тельном</w> изменении в структуре управления.",
                                "zh": "公司宣布其管理结构将发生<w>重大</w>变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "main",
                        "considerable",
                        "big",
                        "important"
                    ],
                    "antonyms": [
                        "minor"
                    ],
                    "common_phrases": [
                        "major role",
                        "major problem",
                        "major part",
                        "major change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой, важный, серьезный или значительный по размеру, масштабу или степени.",
                        "zh": "非常大、重要、严重或显著的；在规模、程度或影响上很突出的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кру́пный",
                                "target_lang_sense_clarification": "большой по масштабу или размеру"
                            },
                            {
                                "target_lang_word": "серьёзный",
                                "target_lang_sense_clarification": "важный, значительный (о проблемах, изменениях)"
                            },
                            {
                                "target_lang_word": "гла́вный",
                                "target_lang_sense_clarification": "основной, ведущий"
                            },
                            {
                                "target_lang_word": "значи́тельный",
                                "target_lang_sense_clarification": "существенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重大",
                                "target_lang_sense_clarification": "指问题、变化、影响等很大、很严重"
                            },
                            {
                                "target_lang_word": "重要",
                                "target_lang_sense_clarification": "指作用、意义、地位等很重要"
                            },
                            {
                                "target_lang_word": "主要",
                                "target_lang_sense_clarification": "指最主要、最核心的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd81dc0a-7369-3328-96f2-0c7c6fc62a29",
                    "sense_definition": "Involving great risk, danger, or serious consequences, often regarding health.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient requires <w>major</w> surgery to repair the damaged heart valve.",
                            "target_lang_translations": {
                                "ru": "Пациенту требуется <w>серьёзная</w> операция для восстановления поврежденного сердечного клапана.",
                                "zh": "这名病人需要做<w>大</w>手术来修复受损的心脏瓣膜。"
                            }
                        },
                        {
                            "text": "He recovered quickly despite suffering from a <w>major</w> illness last winter.",
                            "target_lang_translations": {
                                "ru": "Он быстро поправился, несмотря на то, что прошлой зимой перенес <w>тяжёлую</w> болезнь.",
                                "zh": "尽管他去年冬天得了一场<w>重</w>病，他还是很快康复了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "minor"
                    ],
                    "common_phrases": [
                        "major surgery",
                        "major illness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с большим риском, опасностью или серьезными последствиями, часто в отношении здоровья.",
                        "zh": "涉及很大风险、危险或严重后果的，常用于健康、疾病或医疗情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзный",
                                "target_lang_sense_clarification": "опасный или имеющий важные последствия"
                            },
                            {
                                "target_lang_word": "тяжёлый",
                                "target_lang_sense_clarification": "о болезни"
                            },
                            {
                                "target_lang_word": "сло́жный",
                                "target_lang_sense_clarification": "об операции или процедуре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严重的",
                                "target_lang_sense_clarification": "指疾病、后果等严重"
                            },
                            {
                                "target_lang_word": "大的",
                                "target_lang_sense_clarification": "常指大手术，与小手术相对"
                            },
                            {
                                "target_lang_word": "重的",
                                "target_lang_sense_clarification": "常指重病、病情重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33530e6c-eeb2-315b-a922-2f7e738e7746",
                    "sense_definition": "Relating to a musical key or scale that usually produces a bright or joyful sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The symphony is written in C <w>major</w> and sounds very triumphant.",
                            "target_lang_translations": {
                                "ru": "Симфония написана в до <w>мажо́ре</w> и звучит очень торжествующе.",
                                "zh": "这部交响曲是C<w>大调的</w>，听起来非常辉煌。"
                            }
                        },
                        {
                            "text": "Beginners usually learn the <w>major</w> scale before attempting more complex ones.",
                            "target_lang_translations": {
                                "ru": "Новички обычно учат <w>мажо́рную</w> гамму, прежде чем переходить к более сложным.",
                                "zh": "初学者通常先学习<w>大调的</w>音阶，然后再尝试更复杂的音阶。"
                            }
                        }
                    ],
                    "antonyms": [
                        "minor"
                    ],
                    "common_phrases": [
                        "major key",
                        "major scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к музыкальной тональности или гамме, которая обычно звучит светло или радостно.",
                        "zh": "与通常听起来较明亮或欢快的音乐调式或音阶有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мажо́рный",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大调的",
                                "target_lang_sense_clarification": "音乐术语，指明亮、开朗色彩的调式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "241d685b-3759-3e45-9890-bb2c4e296232",
                    "sense_definition": "An officer of middle rank in the army or air force, above a captain and below a lieutenant colonel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>major</w> gave strict orders to the soldiers under his command.",
                            "target_lang_translations": {
                                "ru": "<w>Майо́р</w> отдал строгие приказы солдатам, находящимся под его командованием.",
                                "zh": "这位<w>少校</w>向他指挥下的士兵下达了严格的命令。"
                            }
                        },
                        {
                            "text": "He served as a <w>major</w> in the army for over ten years.",
                            "target_lang_translations": {
                                "ru": "Он служил <w>майо́ром</w> в армии более десяти лет.",
                                "zh": "他在军队里担任<w>少校</w>超过十年。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Офицер среднего ранга в армии или ВВС, выше капитана и ниже подполковника.",
                        "zh": "军队或空军中的中级军官，军衔高于上尉，低于中校。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "майо́р",
                                "target_lang_sense_clarification": "воинское звание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少校",
                                "target_lang_sense_clarification": "军衔名称，位于上尉之上、中校之下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba753e69-5f31-36b5-908c-ad45a5d8afca",
                    "sense_definition": "The principal subject or course of study chosen by a student at a college or university.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to choose biology as her <w>major</w> during her second year.",
                            "target_lang_translations": {
                                "ru": "На втором курсе она решила выбрать биологию в качестве своей <w>специа́льности</w>.",
                                "zh": "她在大学二年级时决定选择生物学作为自己的<w>专业</w>。"
                            }
                        },
                        {
                            "text": "It is difficult to change your <w>major</w> once you have started the final courses.",
                            "target_lang_translations": {
                                "ru": "Трудно сменить <w>специа́льность</w>, когда вы уже начали проходить курсы последнего года обучения.",
                                "zh": "一旦开始上高年级的课程，想要更换<w>专业</w>就很难了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "course",
                        "subject",
                        "specialty"
                    ],
                    "common_phrases": [
                        "declare a major",
                        "double major"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основной предмет или курс обучения, выбранный студентом в колледже или университете.",
                        "zh": "大学或学院学生所选择的主要学习科目或专业方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "специа́льность",
                                "target_lang_sense_clarification": "основное направление обучения"
                            },
                            {
                                "target_lang_word": "профили́рующая дисципли́на",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "专业",
                                "target_lang_sense_clarification": "大学里主修的学科或方向"
                            },
                            {
                                "target_lang_word": "主修科目",
                                "target_lang_sense_clarification": "较正式地指学习方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3412f45f-15e5-317d-8898-2c0a3277a424",
                    "sense_definition": "A university student who is specializing in a specific subject.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a history <w>major</w>, he spends a lot of time in the library.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>студе́нтом</w> исторического факультета, он проводит много времени в библиотеке.",
                                "zh": "作为历史<w>专业的学生</w>，他花很多时间待在图书馆里。"
                            }
                        },
                        {
                            "text": "The physics <w>majors</w> are organizing a science fair this weekend.",
                            "target_lang_translations": {
                                "ru": "<w>Студе́нты</w>-физики организуют научную ярмарку в эти выходные.",
                                "zh": "物理<w>专业的学生</w>这周末要组织一场科学展。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "math major",
                        "English major"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Студент университета, специализирующийся на определенном предмете.",
                        "zh": "在大学中主修某一特定学科的学生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "студе́нт",
                                "target_lang_sense_clarification": "обучающийся по специальности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "……专业的学生",
                                "target_lang_sense_clarification": "指主修某一学科的大学生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55026d45-390e-39b1-bf7e-f4c5078dbf3c",
                    "sense_definition": "A person who has reached the age of full legal responsibility; an adult.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court treated him as a <w>major</w> because he had turned eighteen.",
                            "target_lang_translations": {
                                "ru": "Суд относился к нему как к <w>совершенноле́тнему</w>, потому что ему исполнилось восемнадцать.",
                                "zh": "因为他已经满十八岁，法院将他视为<w>成年人</w>。"
                            }
                        },
                        {
                            "text": "Only a <w>major</w> can sign this legal contract without parental consent.",
                            "target_lang_translations": {
                                "ru": "Только <w>совершенноле́тний</w> может подписать этот юридический договор без согласия родителей.",
                                "zh": "只有<w>成年人</w>才能在没有父母同意的情况下签署这份法律合同。"
                            }
                        }
                    ],
                    "antonyms": [
                        "minor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, достигший возраста полной юридической ответственности; взрослый.",
                        "zh": "已达到完全法律责任年龄的人；成年人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершенноле́тний",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成年人",
                                "target_lang_sense_clarification": "法律上已达到成年年龄的人"
                            },
                            {
                                "target_lang_word": "成年人",
                                "target_lang_sense_clarification": "强调法律意义上的成年"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db942c5a-248d-3a27-83ad-44f640c892bb",
                    "sense_definition": "To specialize in a specific subject as one's principal field of study at a college or university.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He plans to <w>major</w> in computer science when he goes to college.",
                            "target_lang_translations": {
                                "ru": "Он планирует <w>специализи́роваться</w> на информатике, когда поступит в колледж.",
                                "zh": "他打算上大学后<w>主修</w>计算机科学。"
                            }
                        },
                        {
                            "text": "She <w>majored</w> in economics and later found a job in banking.",
                            "target_lang_translations": {
                                "ru": "Она <w>специализи́ровалась</w> на экономике и позже нашла работу в банковской сфере.",
                                "zh": "她大学时<w>主修</w>经济学，后来在银行业找到了一份工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "major in"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специализироваться на определенном предмете как основной области изучения в колледже или университете.",
                        "zh": "在大学或学院中以某一学科作为自己的主要专业来学习。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "специализи́роваться",
                                "target_lang_sense_clarification": "изучать как основной предмет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主修",
                                "target_lang_sense_clarification": "在大学中把某学科作为主要学习方向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "52ab399d-077d-3a3d-8e14-5828935d8320",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Major</w> was elected as the chairman of the board.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Ме́йджор</w> был избран председателем совета директоров.",
                                "zh": "<w>梅杰</w>先生当选为董事会主席。"
                            }
                        },
                        {
                            "text": "We invited the <w>Major</w> family to dinner last Sunday.",
                            "target_lang_translations": {
                                "ru": "В прошлое воскресенье мы пригласили семью <w>Ме́йджор</w> на ужин.",
                                "zh": "上周日我们邀请了<w>梅杰</w>一家来吃晚饭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ме́йджор",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "梅杰",
                                "target_lang_sense_clarification": "姓氏的音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44240749-ff3d-3a17-8c3d-d912411eccc9",
                    "sense_definition": "A place name used for various locations.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small community of <w>Major</w> during their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они посетили небольшое поселение <w>Ме́йджор</w>.",
                                "zh": "他们在公路旅行期间造访了名叫<w>梅杰</w>的小社区。"
                            }
                        },
                        {
                            "text": "The village of <w>Major</w> is located in a rural area.",
                            "target_lang_translations": {
                                "ru": "Деревня <w>Ме́йджор</w> расположена в сельской местности.",
                                "zh": "名叫<w>梅杰</w>的村庄位于乡村地区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название, используемое для различных населенных пунктов.",
                        "zh": "用于不同地点的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ме́йджор",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "梅杰",
                                "target_lang_sense_clarification": "地名音译，用于不同地方名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}