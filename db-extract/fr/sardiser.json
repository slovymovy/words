                "senses": [
                    {
                        "sense_id": "f90ef9f8-a67a-3dcf-a2fa-cfb8d11a28c6",
                        "entry_id": "faf8fe96-88ac-3e2e-b196-d20b03d1edda",
                        "glosses": [
                            "Donner un caractère sarde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dafda0d-839e-4f1e-ac1d-a3b22e18e8c0",
                                "sense_id": "f90ef9f8-a67a-3dcf-a2fa-cfb8d11a28c6",
                                "text": "Anelka serait-il d'origine corse ? Si c'est le cas, je demande à ce que mon ADN soit sardisé."
                            },
                            {
                                "example_id": "f5d6d679-d725-45e9-add2-f57b2df70bde",
                                "sense_id": "f90ef9f8-a67a-3dcf-a2fa-cfb8d11a28c6",
                                "text": "25 % de la population serait locutrice de l'alguerois, une forme de catalan ancien sardisé."
                            },
                            {
                                "example_id": "49035463-ceed-4f2c-936a-746b5f14a66c",
                                "sense_id": "f90ef9f8-a67a-3dcf-a2fa-cfb8d11a28c6",
                                "text": "Mais en tout cas, une analyse plus approfondie révèle le désir du scribe sarde (ou «sardisé») de respecter les distinctions phonématiques de la langue parlée."
                            }
                        ]
                    }
