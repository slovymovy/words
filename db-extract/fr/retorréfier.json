                "senses": [
                    {
                        "sense_id": "6150a699-7f19-3069-91db-524e10d03b2f",
                        "entry_id": "f470eb7d-e1c7-3ae3-9e8c-b86aaa8777ee",
                        "glosses": [
                            "Torréfier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebea053e-349f-4b83-8d42-62bcc04862e0",
                                "sense_id": "6150a699-7f19-3069-91db-524e10d03b2f",
                                "text": "Taiwan est très humide et c'est pourquoi on (les marchands de thé, pas les consommateurs finaux) retorréfie relativement souvent ici. (retorrefie corrigé en retorréfie)"
                            },
                            {
                                "example_id": "1ef068eb-6951-48bb-b6b2-12e0c6010b94",
                                "sense_id": "6150a699-7f19-3069-91db-524e10d03b2f",
                                "text": "J'imagine qu'elle n'est pas comparable à celle d'un thé que l'on aura retorréfié tous les ans ou tous les 2 ans (d'ailleurs, peut-on retorréfier de la sorte un Gao Shan Cha --est-ce que ça a déjà été fait, ou bien la torréfaction des gao shan est-elle un truc trop nouveau et trop circonscrit pour l'instant ?)"
                            }
                        ]
                    }
