                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c584ff81-18c1-424b-998b-3013d2791cea",
                                "sense_id": "4cab2c2a-6710-3413-ace0-1086f9dbdc00",
                                "text": "Après l’annonce surprise du référendum grec : Le chœur des 26 Européens : « On s’est fait Papandréouter ! »"
                            },
                            {
                                "example_id": "8ed00dbd-5ecc-44ac-99af-8bf9c6ed4253",
                                "sense_id": "4cab2c2a-6710-3413-ace0-1086f9dbdc00",
                                "text": "De quelle étrange mortification masochiste, le social-démocrate souffre t’il à mettre tant d’énergie pugnace et d’opportunisme rhétorique pour mieux postuler à se faire papandréouter à l’issue du combat ?"
                            },
                            {
                                "example_id": "43a6896a-6fc9-49f6-86b0-8f7abbbfd90c",
                                "sense_id": "4cab2c2a-6710-3413-ace0-1086f9dbdc00",
                                "text": "Personnellement, je n’ai pas très envie de me faire papandréouter !"
                            }
                        ]
                    }
