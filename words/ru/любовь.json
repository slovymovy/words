                {
                    "sense_id": "3edc4136-a0fb-3629-bd50-8936d36a688b",
                    "sense_definition": "Сильный интерес, увлечённость или пристрастие к чему-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его <w>любовь</w> к музыке проявилась ещё в раннем детстве.",
                            "target_lang_translations": {
                                "en": "His <w>love</w> for music manifested early in childhood.",
                                "nl": "Zijn <w>liefde</w> voor muziek openbaarde zich al in zijn vroege jeugd.",
                                "pl": "Jego <w>miłość</w> do muzyki objawiła się już we wczesnym dzieciństwie.",
                                "fr": "Son <w>amour</w> pour la musique s'est manifesté dès sa tendre enfance.",
                                "de": "Seine <w>Liebe</w> zur Musik zeigte sich schon in der frühen Kindheit.",
                                "es": "Su <w>amor</w> por la música se manifestó ya en la primera infancia.",
                                "it": "Il suo <w>amore</w> per la musica si è manifestato fin dalla prima infanzia.",
                                "tr": "Müziğe olan <w>sevgisi</w> henüz küçük yaşlarda kendini gösterdi.",
                                "cs": "Jeho <w>láska</w> k hudbě se projevila už v raném dětství.",
                                "zh": "他对音乐的<w>热爱</w>在童年早期就显现出来了。"
                            }
                        },
                        {
                            "text": "У неё огромная <w>любовь</w> к чтению исторических романов.",
                            "target_lang_translations": {
                                "en": "She has a huge <w>love</w> for reading historical novels.",
                                "nl": "Ze heeft een enorme <w>liefde</w> voor het lezen van historische romans.",
                                "pl": "Ona ma ogromne <w>zamiłowanie</w> do czytania powieści historycznych.",
                                "fr": "Elle a une immense <w>passion</w> pour la lecture de romans historiques.",
                                "de": "Sie hat eine große <w>Vorliebe</w> für das Lesen historischer Romane.",
                                "es": "Ella tiene una gran <w>afición</w> por la lectura de novelas históricas.",
                                "it": "Ha una grandissima <w>passione</w> per la lettura di romanzi storici.",
                                "tr": "Tarihi romanlar okumaya karşı büyük bir <w>sevgisi</w> var.",
                                "cs": "Má obrovskou <w>lásku</w> ke čtení historických románů.",
                                "zh": "她对阅读历史小说有着极大的<w>爱好</w>。"
                            }
                        },
                        {
                            "text": "Мы разделяем вашу <w>любовь</w> к искусству и театру.",
                            "target_lang_translations": {
                                "en": "We share your <w>love</w> for art and theater.",
                                "nl": "Wij delen uw <w>liefde</w> voor kunst en theater.",
                                "pl": "Dzielimy Waszą <w>miłość</w> do sztuki i teatru.",
                                "fr": "Nous partageons votre <w>amour</w> pour l'art et le théâtre.",
                                "de": "Wir teilen Ihre <w>Leidenschaft</w> für Kunst und Theater.",
                                "es": "Compartimos su <w>amor</w> por el arte y el teatro.",
                                "it": "Condividiamo il vostro <w>amore</w> per l'arte e il teatro.",
                                "tr": "Sanata ve tiyatroya olan <w>sevginizi</w> paylaşıyoruz.",
                                "cs": "Sdílíme vaši <w>lásku</w> k umění a divadlu.",
                                "zh": "我们分享您对艺术和戏剧的<w>热爱</w>。"
                            }
                        }
