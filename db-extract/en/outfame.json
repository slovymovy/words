                        "glosses": [
                            "To become more famous than, particularly in a competitive sense."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e1a4acae-73ec-4f74-96da-2c5d7a03304f",
                                "sense_id": "5b158344-a720-3920-b0b2-09d2537d4565",
                                "text": "...those two great captains, (whom Alexander sought by all means to outfame,) when they endeavoured to subject unto them the Oxydracae"
                            },
                            {
                                "example_id": "3a9ff2ee-4deb-4e7f-89ea-5de78c758ebd",
                                "sense_id": "5b158344-a720-3920-b0b2-09d2537d4565",
                                "text": "... and the plebian Robin Hood mated with a simple Marian as his forest-queen was thus destined to outfame the noble but obscure Fitz-Ooth, and the Lady Maude Fitz-Walter."
                            },
                            {
                                "example_id": "75b298b1-199c-427b-b0fb-dc7eb4f7e989",
                                "sense_id": "5b158344-a720-3920-b0b2-09d2537d4565",
                                "text": "“I can't even.” Kara sniffed. “How the hell did she manage to outfame me?”"
                            }
                        ]
