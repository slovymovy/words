                        "source_entry_id": "f9ce49a9-fa4b-378d-b9c9-170d4e3640c1",
                        "source_sense_id": "9f5d3579-4204-39bb-9fde-4a8cde7bb31c",
                        "target_lang_word": "zemsta",
