                        "glosses": [
                            "To come apart into its component layers."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2e5b25e5-be9f-4d0f-bf93-cf3a83f0d18b",
                                "sense_id": "9aa6c938-0256-38c3-930c-0faf8e76f3ce",
                                "text": "Water damage caused the plywood of the floor to delaminate. The layers came apart and the whole piece had to be replaced."
                            },
                            {
                                "example_id": "523d91ce-521f-423d-b2f0-eec10a13b5f0",
                                "sense_id": "9aa6c938-0256-38c3-930c-0faf8e76f3ce",
                                "text": "The difference in the coefficient of thermal expansion between the film and the coating can cause the coating to delaminate."
                            }
                        ]
