                        "entry_id": "adf505c3-cbbb-3c3c-b830-a897a689d4a5",
                        "glosses": [
                            "Relatif à un ou des corps de métier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "978926ef-080e-4b8b-9458-45efdf00af23",
                                "sense_id": "16e47374-87e7-3c33-9c21-c674f38583dd",
                                "text": "Si vous flâniez, comme je le fais de temps en temps, dans le Banquet des savants, vaste anthologie établie par Monsieur Athénée, un Grec du IIIᵉ siècle, vous y trouveriez déjà un certain nombre de chansons corporatistes : celles des garçons de bains, des pétrisseuses de pâte, des nourrices, des tisserands, des fileurs de laine, des moissonneurs, des bouviers, des meuniers..."
                            }
                        ]
                    },
                    {
                        "sense_id": "9191d3ef-171c-34cf-8d2b-f310376c4555",
                        "entry_id": "adf505c3-cbbb-3c3c-b830-a897a689d4a5",
                        "glosses": [
                            "Relatif au corporatisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
