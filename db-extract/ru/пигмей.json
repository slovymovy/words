                        "form": "пигме́е"
                    },
                    {
                        "form_id": "43111943-f226-4ae5-984a-988f042c432f",
                        "entry_id": "99dc259c-a852-3bc0-ae65-ba73e1c51316",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "пигме́ях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6e8fcb1-af67-31cb-8363-69f74be8239a",
                        "entry_id": "99dc259c-a852-3bc0-ae65-ba73e1c51316",
                        "glosses": [
                            "этногр. представитель одного из низкорослых племён центральной Африки, Юго-восточной Азии и Океании"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "85e21640-e8cf-471c-8ba9-c53289f3b47b",
                                "sense_id": "c6e8fcb1-af67-31cb-8363-69f74be8239a",
                                "text": "Африканских пигмеев считают не только одними из лучших охотников земли, но и одними из лучших танцоров."
                            },
                            {
                                "example_id": "5c01bbf3-6f0d-4e6e-a3a3-870d39fadd4d",
                                "sense_id": "c6e8fcb1-af67-31cb-8363-69f74be8239a",
                                "text": "Объектом исследования (это почти всегда своеобразное открытие) могут быть .. кочевья пигмеев-охотников Африки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8aa9e11a-eb3c-4d0f-92e9-2a40b6c5a78b",
                        "source_entry_id": "99dc259c-a852-3bc0-ae65-ba73e1c51316",
                        "source_sense_id": "c6e8fcb1-af67-31cb-8363-69f74be8239a",
                        "target_lang_word": "pygmy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pygmy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fb7c5b4-045f-39cb-a6a0-8e53b079ad3c",
                                        "entry_id": "8db0fb54-e8c1-3aab-9124-0454b13bb298",
                                        "glosses": [
                                            "A member of one of various Ancient Equatorial African tribal peoples, notable for their very short stature."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ce87418-d719-4786-bd2c-b2d216f09c77",
                                                "sense_id": "1fb7c5b4-045f-39cb-a6a0-8e53b079ad3c",
                                                "text": "Although Pygmies are relatively protected against gene flow from other populations, many Pygmy tribes show extensive gene replacement and few have remained relatively unaltered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d34c4a1f-dab0-3d06-803a-31cb52156e13",
                                        "entry_id": "8db0fb54-e8c1-3aab-9124-0454b13bb298",
                                        "glosses": [
                                            "A member of a race of dwarfs."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d2af5d-389d-4d8b-89df-13d1a54a5db4",
                                                "sense_id": "d34c4a1f-dab0-3d06-803a-31cb52156e13",
                                                "text": "Ctesias lived in Persia for several years, as the personal physician of King Ataxerxes II, and would have had contact with travellers to India, and Indian visitors to Persia. He describes dog-headed humans, pygmy men who grow their beards so long that they can be used as clothes, and affirms that it never rains in India."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "572a14e6-aebb-3a63-9e1e-5fe1762b304a",
                                        "entry_id": "8db0fb54-e8c1-3aab-9124-0454b13bb298",
                                        "glosses": [
                                            "Any dwarfish person or thing."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27f1849e-b4ab-4f68-839b-ad3f19dae176",
                                                "sense_id": "572a14e6-aebb-3a63-9e1e-5fe1762b304a",
                                                "text": "It was so high up that the people walking about in the street below looked like pygmies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81786cd6-0d8f-3be9-ad1f-c44471486b76",
                                        "entry_id": "8db0fb54-e8c1-3aab-9124-0454b13bb298",
                                        "glosses": [
                                            "An insignificant person, at least in some respect."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "029be8e5-5aab-4504-ba59-18abc924c74e",
                                                "sense_id": "81786cd6-0d8f-3be9-ad1f-c44471486b76",
                                                "text": "On the world stage Germany is an economic giant but a political pygmy, Britain in comparison a political giant but an economic pygmy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pygmy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a58c58eb-bbb2-3319-86a6-28076976e69f",
                                        "entry_id": "f6442aea-b728-3f51-9358-498cc377b0b8",
                                        "glosses": [
                                            "Relating or belonging to the Pygmy people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88081bc8-6088-3939-802d-0f9878df250a",
                                        "entry_id": "f6442aea-b728-3f51-9358-498cc377b0b8",
                                        "glosses": [
                                            "Like a pygmy; unusually short or small for its kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216941ad-a86c-4766-ba69-5925952ab0f0",
                                                "sense_id": "88081bc8-6088-3939-802d-0f9878df250a",
                                                "text": "Amongst foodgrains, as we travelled from the green South and East towards the dry North and West, the pygmy crop of rice gave way to the tall bajra and jowar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
