                        "entry_id": "29e73da6-9fb0-3f27-b073-f49abd782dee",
                        "glosses": [
                            "alfabet będący odmianą cyrylicy, wprowadzony w Rosji na pocz. XVIII wieku, używany również przez inne narody słowiańskie posługujące się wcześniej cyrylicą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b3fe60-f20e-456e-ad71-c9058defed08",
                                "sense_id": "79ca78ef-b63e-30be-a3bd-0e27825ebf49",
                                "text": "Z początkiem XVIII wieku car rosyjski Piotr Wielki zreformował cyrylicę zbliżając ją do alfabetu łacińskiego i w ten sposób powstała grażdanka, używana do dziś w prawosławnych krajach słowiańskich"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
