                ],
                "senses": [
                    {
                        "sense_id": "7ad60b34-3acd-3a40-a826-0853d8eab5c2",
                        "entry_id": "c907d43c-5d41-3d21-8a7c-b4c64a003c6a",
                        "glosses": [
                            "Methode, wie etwas oder jemand behandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f156b698-74bc-4db9-beb9-d244143743c4",
                                "sense_id": "7ad60b34-3acd-3a40-a826-0853d8eab5c2",
                                "text": "„Natürlich sollte jeder die Freiheit haben, Mittelchen einzunehmen und Behandlungsmethoden auszuprobieren, von denen er glaubt, sie helfen.“"
                            },
                            {
                                "example_id": "1305ca01-3ac3-46e7-afb2-7b4a99d6a21d",
                                "sense_id": "7ad60b34-3acd-3a40-a826-0853d8eab5c2",
                                "text": "„Sie lasen die Verordnungen der Ärzte und waren sehr erstaunt, daß Beruhigungsmittel manchmal aufregend, daß Brechmittel zuweilen wie Abführmittel wirken, daß ein und dasselbe Heilmittel bei verschiedenen Krankheiten hilft und daß eine Krankheit durch einander entgegengesetzte Behandlungsmethoden verschwindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
