                        "sense_id": "af9e5138-233d-32ba-b6a6-2b09a21b6171",
                        "entry_id": "913dc0f8-8d58-3027-aed1-5aa25e8e7a0f",
                        "glosses": [
                            "radioaktives Wasserstoffisotop, dessen Atomkern aus einem Proton und zwei Neutronen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5c44cc1-8a1f-4183-9ef6-69491370c7db",
                                "sense_id": "af9e5138-233d-32ba-b6a6-2b09a21b6171",
                                "text": "Wird Tritium mit dem Trinkwasser aufgenommen, verteilt es sich im ganzen Körper und führt zu einer gleichmäßigen Strahlenbelastung aller Organe."
                            },
                            {
                                "example_id": "e9cd582f-4646-4e9f-bc36-187178213884",
                                "sense_id": "af9e5138-233d-32ba-b6a6-2b09a21b6171",
                                "text": "„Durch den illegalen Export von Tritium und Tritiumtechnologie haben sich seitdem die politischen Prioritäten in der Bundesrepublik in der Proliferationsfrage gewandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
