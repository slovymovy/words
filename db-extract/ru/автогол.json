                "senses": [
                    {
                        "sense_id": "bdc74a07-1350-393e-a68f-5ddd572d8b3d",
                        "entry_id": "fba2ee38-d53d-3583-8239-5e7228c1020d",
                        "glosses": [
                            "спорт. гол, забитый игроком в ворота своей команды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c3c32ed-1014-45f0-8e4a-311c0389f3f1",
                                "sense_id": "bdc74a07-1350-393e-a68f-5ddd572d8b3d",
                                "text": "Гол в свои ворота (автогол) — досадная и обидная случайность."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0912314-dd4c-455e-a9e5-595c87e075f8",
                        "source_entry_id": "fba2ee38-d53d-3583-8239-5e7228c1020d",
                        "source_sense_id": "bdc74a07-1350-393e-a68f-5ddd572d8b3d",
                        "target_lang_word": "own goal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "own goal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac736d01-1608-30ad-84b6-2efa5a2ea28b",
                                        "entry_id": "2bbbbaa3-8772-3fbe-946e-8c7e433aae0e",
                                        "glosses": [
                                            "A goal that results from a player putting the ball or puck into the goal of their own team; the resulting goal being scored for the opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c0e296-3529-4aef-99a8-7c2efb4fe206",
                                                "sense_id": "ac736d01-1608-30ad-84b6-2efa5a2ea28b",
                                                "text": "It is 20 years to the day since Escobar was shot dead after scoring the own goal that effectively sealed Colombia’s elimination from USA ’94."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd2a44b-7dca-3651-9287-c94ae9de6804",
                                        "entry_id": "2bbbbaa3-8772-3fbe-946e-8c7e433aae0e",
                                        "glosses": [
                                            "A blunder that damages one’s own prospects."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17163007-9e58-4780-806f-840eb6d633bf",
                                                "sense_id": "2fd2a44b-7dca-3651-9287-c94ae9de6804",
                                                "text": "In its penultimate year, for example, starting from when the Provos blew up Canary Wharf in February 1996, the IRA suffered its last 'own goal' when Wexford-born Ed O'Brien blew himself up on a London bus whilst transporting a bomb."
                                            },
                                            {
                                                "example_id": "58ba7ede-bde2-4cd1-a9d0-eb6a80bfa731",
                                                "sense_id": "2fd2a44b-7dca-3651-9287-c94ae9de6804",
                                                "text": "No doubt the buzz of army helicopters will sound again in the skies over Belfast tonight, as loyalists continue to score this series of bloody own goals."
                                            },
                                            {
                                                "example_id": "d614d3ea-6100-4934-a3b1-3641b0ef4999",
                                                "sense_id": "2fd2a44b-7dca-3651-9287-c94ae9de6804",
                                                "text": "These elections mark a personal humiliation for incumbent Ms. May, who ran a very personalized campaign as a “strong and stable” leader asking British voters to give her a clear mandate to negotiate Brexit. Ms. May scored an unforced own goal by reducing her party’s parliamentary seats and absolute majority."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "688a6889-be58-4d49-a314-d6f611aff0fb",
                        "source_entry_id": "fba2ee38-d53d-3583-8239-5e7228c1020d",
                        "source_sense_id": "bdc74a07-1350-393e-a68f-5ddd572d8b3d",
