                "senses": [
                    {
                        "sense_id": "723ccc58-52c2-38f4-bd7f-cba9753df996",
                        "entry_id": "0fc6edce-8e3a-3e1a-ab1b-19058ddfa964",
                        "glosses": [
                            "Treppe, die zum Eingang führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d3c45e-2000-40b7-9e8a-f70d2230ddfc",
                                "sense_id": "723ccc58-52c2-38f4-bd7f-cba9753df996",
                                "text": "„Jean lief seine Eingangstreppe herunter und uns entgegen, als er mich aus dem Auto steigen sah, seine Schritte etwas uneben und wankend durch seine O-Beine.“"
                            },
                            {
                                "example_id": "f9298d5a-1d44-4108-a936-58324e027edd",
                                "sense_id": "723ccc58-52c2-38f4-bd7f-cba9753df996",
                                "text": "„Jetzt wäre die Eingangstreppe fällig gewesen, aber es goß wie aus Eimern.“"
                            },
                            {
                                "example_id": "2f50cd57-42f8-4fac-894b-410bab5bb36e",
                                "sense_id": "723ccc58-52c2-38f4-bd7f-cba9753df996",
                                "text": "„Es ist wie jedes Jahr um diese Zeit in Puebla: Vor dem Werkstor von VW haben ein paar Männer ein Netz gespannt und entspannen sich beim Volleyball, auf der breiten Eingangstreppe spielt eine Gruppe Frauen Karten - Streikposten vor Volkswagen de Mexico.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
