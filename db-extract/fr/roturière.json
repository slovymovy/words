                        "sense_id": "ddc660f9-75f5-35bf-a5b0-1b20140d6c51",
                        "entry_id": "e84587cd-4f17-33c0-8824-e02b903324c1",
                        "glosses": [
                            "Femme qui, sous l’Ancien Régime, n’était ni aristocrate ni ecclésiastique et appartenait au tiers état."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a7b970-f59f-408c-ba87-cfb0234bc667",
                                "sense_id": "ddc660f9-75f5-35bf-a5b0-1b20140d6c51",
                                "text": "Lorsque la constitution française reconnaissait un ordre de noblesse privilégiée, la femme noble qui épousait un roturier dérogeait à la noblesse et devenait roturière."
                            },
                            {
                                "example_id": "033de5d6-ea19-48b7-a06a-503dd7ff5bc3",
                                "sense_id": "ddc660f9-75f5-35bf-a5b0-1b20140d6c51",
                                "text": "Quoique roturière, elle frayait avec la noblesse à laquelle elle s’était souvent alliée,"
                            }
                        ]
                    }
                ],
