                    },
                    {
                        "form_id": "249bd009-3030-4715-80da-eb0ae4e17443",
                        "entry_id": "9b64455f-c8c8-3241-a632-12750cd134b9",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… лепета́ть"
