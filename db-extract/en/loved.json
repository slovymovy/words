                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4674c6ad-99d9-4ce5-934a-6b0585f21e27",
                                                "sense_id": "af7f294a-c338-3b04-be3a-5bbd87949a10",
                                                "text": "Elle vous rasait alors avec son adoré Georges, tout comme elle vous avait rasé avant avec son adoré Édouard et comme elle devait vous raser après avec son adoré un tel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adoré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a706691-78e5-3be1-89b6-d11d23dd1281",
                                        "entry_id": "c6f48e27-a35c-362e-a613-ecea464e0d77",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe adorer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff2c8fa-29f4-4ac1-8a21-55dc27cb9c4d",
                                                "sense_id": "0a706691-78e5-3be1-89b6-d11d23dd1281",
                                                "text": "Actuellement, il se passionne pour le cinéaste Alex Garland dont il a adoré Men, sorti en juin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9349a590-e032-4995-964c-0f89c47a36e3",
                        "source_entry_id": "785f8936-7723-34fd-9ed5-f268f682c22c",
                        "source_sense_id": "4a9a0388-0737-3637-9e79-0e0acc705133",
