                "senses": [
                    {
                        "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                        "entry_id": "fe9b37e9-c088-38c2-bee2-7f61bb082d22",
                        "glosses": [
                            "ein Vertreter der Sophistik, einer Gruppe von griechischen Philosophen des 5. und 4. Jahrhunderts vor Christus, die als Wanderlehrer gegen Entgelt vor allem in Athen auftraten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58c8d318-d60a-43aa-86fb-47231b7b9a71",
                                "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                                "text": "„Da die Sophisten als einzelne Lehrer verschiedener Wissenschaften aufgetreten sind, kann man auch nicht von einer Schule im Sinne einer einheitlichen Lehrmeinung sprechen.“"
                            },
                            {
                                "example_id": "10c76859-40a9-4e93-9581-8e984b06b3e9",
                                "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                                "text": "„In Athen verdienten die Sophisten ihren Lebensunterhalt damit, die Bürger der Stadt zu unterrichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d1c73d1-aa55-33d4-af9a-27533652ce58",
