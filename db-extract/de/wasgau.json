                        "sense_id": "a6312f21-2cef-31df-a1cd-928a92e674b6",
                        "entry_id": "10d4de1c-da15-3d33-988e-c37aa9e43742",
                        "glosses": [
                            "Mittelgebirgslandschaft im Grenzgebiet von Rheinland-Pfalz in Deutschland und der Region Grand Est in Frankreich"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "0637d05e-fb2e-48df-b28e-c4fad7abad6b",
                                "sense_id": "a6312f21-2cef-31df-a1cd-928a92e674b6",
                                "text": "„Der jüdische Textilhändler aus Landau kam nicht mehr und nach und nach verschwanden die Juden aus dem Wasgau.“"
                            },
                            {
                                "example_id": "151ee514-92bf-43f6-b978-bfe4cdc86855",
                                "sense_id": "a6312f21-2cef-31df-a1cd-928a92e674b6",
                                "text": "„In nicht allzu weiter Entfernung sieht man die ehemalige lothringische Trutzburg Waldeck am Horizont, die den hügeligen Wasgau überragt.“"
                            },
                            {
                                "example_id": "a12d2264-aa43-4df1-bb8e-2b3f49dae5b8",
                                "sense_id": "a6312f21-2cef-31df-a1cd-928a92e674b6",
                                "text": "„Er wies auf den Magazinteil „Kunst und Künstler im Wasgau“ hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
