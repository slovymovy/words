                "senses": [
                    {
                        "sense_id": "a966bc37-d42d-398d-b71a-04c715ee0624",
                        "entry_id": "ff78fef9-df7a-3630-84ec-5c10725e2073",
                        "glosses": [
                            "Kleidungsstück eines Astronauten zum Schutz gegen Sonnenstrahlung und zum Aufrechterhalten der Vitalfunktionen"
                        ],
                        "tags": [
                            "Raumfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "2fac47dc-9b03-4e5b-b98a-0595570eeef4",
                                "sense_id": "a966bc37-d42d-398d-b71a-04c715ee0624",
                                "text": "„Im russischen Astronautenanzug, inklusive Helm, trat er auf und verkündete, nur dann in Graz bleiben zu wollen, \"wenn's bei Elevate richtig hergeht.“"
                            },
                            {
                                "example_id": "8ea945c4-1012-4d70-9481-7504c8a688de",
                                "sense_id": "a966bc37-d42d-398d-b71a-04c715ee0624",
                                "text": "„Seit den Kindertagen der Raumfahrt hat sich der Astronautenanzug stetig weiterentwickelt.“"
                            },
                            {
                                "example_id": "7da34eb3-95fe-47e1-b082-03ed748b4f59",
                                "sense_id": "a966bc37-d42d-398d-b71a-04c715ee0624",
                                "text": "„An der Wand eines mit riesigen Raumfahrt-Postern geschmückten Kellers in einem Gewerbegebäude in Regensdorf lehnt eine Puppe in einem Astronautenanzug aus der Zeit der amerikanischen Mercury-Missionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
