                    {
                        "sense_id": "ac1ad08e-b9ca-3bf8-9298-6f7dd95e76ac",
                        "entry_id": "b2c8b1d0-fe4f-3225-8db8-1259cbf00a66",
                        "glosses": [
                            "Sorte de lit composé d'un cadre de bois tendu de cordes ou de sangles tressées, en usage en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b10278-68d9-440b-ba6a-bc0c2c960432",
                                "sense_id": "ac1ad08e-b9ca-3bf8-9298-6f7dd95e76ac",
                                "text": "Les charpoys les plus communs et les plus durs, ou même un simple paillasson, remplacent les luxueux coussins et les matelas bien rembourrés sur lesquels les Luknois reposent ordinairement."
                            },
                            {
                                "example_id": "ff3c3697-2d63-4c5c-ab55-1301f0b86b1c",
                                "sense_id": "ac1ad08e-b9ca-3bf8-9298-6f7dd95e76ac",
                                "text": "Les chalands s'accroupissent en rond pour bavarder en fumant le chilam ; d'autres sont assis sur des charpoys, sommiers de cordes servant de lit la nuit."
                            },
                            {
                                "example_id": "eb633e78-ff9c-4ce3-9cf7-97baca1d1d95",
                                "sense_id": "ac1ad08e-b9ca-3bf8-9298-6f7dd95e76ac",
                                "text": "Léna s’avance pour s’asseoir sur les tapis, comme la fois précédente, mais Preeti attrape un charpoy rangé contre un mur et lui fait signe de s’y installer."
                            },
                            {
                                "example_id": "a82b7228-6fa2-4178-a6ca-5c6120795586",
                                "sense_id": "ac1ad08e-b9ca-3bf8-9298-6f7dd95e76ac",
                                "text": "Après avoir traversé une chambre fraîche et sombre meublée de deux charpoy et préservée de la fournaise caniculaire par la taille minuscule des fenêtres, ils pénétrèrent dans une deuxième pièce, plus lumineuse, où se trouvaient deux lits […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c9bd13f-2329-426f-8a21-0c7f7dab4256",
                        "source_entry_id": "b2c8b1d0-fe4f-3225-8db8-1259cbf00a66",
