                        "sense_id": "5e7d8b59-8922-3b8a-b1d7-2c1130d924a6",
                        "entry_id": "18e7002d-e396-35ba-b37e-15b3171e506c",
                        "glosses": [
                            "kaas gemaakt van schapenmelk"
