                "senses": [
                    {
                        "sense_id": "bd1b58dd-d6ea-3715-9e32-4d40ae617d84",
                        "entry_id": "69a8053c-e91a-3a2c-aabd-4821e0f6965d",
                        "glosses": [
                            "Donner un caractère présidentiable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c405d909-61ea-4c03-9893-e3235820201e",
                                "sense_id": "bd1b58dd-d6ea-3715-9e32-4d40ae617d84",
                                "text": "A l'heure où François Bayrou peine à se positionner et à se « présidentiabiliser », l'enjeu est donc de taille pour Hervé Morin et sa formation politique pour enfin exister et ne plus être « satellisé »."
                            },
                            {
                                "example_id": "8a990bd3-c868-43cc-bc99-905603cb57f2",
                                "sense_id": "bd1b58dd-d6ea-3715-9e32-4d40ae617d84",
                                "text": "Ils doivent donc faire un effort pour se présidentiabiliser, et donc prendre de la hauteur."
                            },
                            {
                                "example_id": "d4ec3558-1504-40cc-95fe-aa34e34ecf73",
                                "sense_id": "bd1b58dd-d6ea-3715-9e32-4d40ae617d84",
                                "text": "MAIS dans le fond, cette affaire joue pour lui. Car s'il parvient à \"présidentiabiliser\" les deux leaders extrêmistes, on peut imaginer des consignes de vote au second tour en sa faveur, par reconnaissance."
                            }
                        ]
                    }
