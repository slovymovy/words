                "senses": [
                    {
                        "sense_id": "07c8fbf5-9172-3cfa-9b15-f118c91f43b8",
                        "entry_id": "5d9a63cd-4157-3495-b8a1-657e1ec99779",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de resémiotiser (sémiotiser à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5945629-ec46-4bef-9cb0-93a10807e8a5",
                                "sense_id": "07c8fbf5-9172-3cfa-9b15-f118c91f43b8",
                                "text": "Rapprochement inédit, en effet, et invitation à re-phénoménologiser et re-sémiotiser la nature de l’homme."
                            },
                            {
                                "example_id": "57c128bb-4ae3-41d3-b496-2332d2cd1685",
                                "sense_id": "07c8fbf5-9172-3cfa-9b15-f118c91f43b8",
                                "text": "Des écritures mathématiques se font axiomatiser, c’est-à-dire re-stratifier, re-sémiotiser ; des flux matériels se font rephysicaliser."
                            }
                        ]
                    }
