                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The automated machine can <w>carton</w> hundreds of bottles every single hour.",
                            "target_lang_translations": {
