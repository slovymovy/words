                                    {
                                        "sense_id": "73791d3a-702f-3341-a668-6c9573c40a26",
                                        "entry_id": "01cac6b5-67c7-34ba-bf55-002df554d79c",
                                        "glosses": [
                                            "Condición de la persona, grupo o entidad capaz de generar o suministrarse todo aquello que necesita."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5eefc0af-4c41-3509-8398-09d62ea49a50",
                                        "entry_id": "01cac6b5-67c7-34ba-bf55-002df554d79c",
                                        "glosses": [
                                            "Política o condición de un gobierno que busca la autosuficiencia económica, depender de sus propios recursos y evitar importaciones, y con poco contacto con otros gobiernos o Estados."
                                        ],
                                        "tags": [
                                            "política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f58eada-9cc2-4b07-9922-2c70ba3c95b9",
                                                "sense_id": "5eefc0af-4c41-3509-8398-09d62ea49a50",
                                                "text": "La guerra reduce a Rusia a una autarquía obligada que pone al desnudo la enorme debilidad de su economía."
                                            }
