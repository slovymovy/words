                ],
                "senses": [
                    {
                        "sense_id": "4533e39f-8751-3d89-95a9-3cbf75de840c",
                        "entry_id": "d294e761-39d0-3e8b-8a7d-a2be611aec3a",
                        "glosses": [
                            "Dont on a coupé les branches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d57517-20f6-4333-a228-fc1e97072e7b",
                                "sense_id": "4533e39f-8751-3d89-95a9-3cbf75de840c",
                                "text": "Des ormeaux ébranchés."
                            },
                            {
                                "example_id": "1c6e2d60-7b87-4252-ba4d-fa149a9dd753",
                                "sense_id": "4533e39f-8751-3d89-95a9-3cbf75de840c",
                                "text": "Ébranchés jusqu’à la cime, ils ressemblent de loin à des palmiers, et quand ils sont balancés par la brise de la mer, ils font entendre une musique monotone, qu’ils chantent tristement comme s’ils se plaignaient de leurs blessures."
                            },
                            {
                                "example_id": "97b264d9-700d-4738-880a-25658688c327",
                                "sense_id": "4533e39f-8751-3d89-95a9-3cbf75de840c",
                                "text": "Ils se sont arrêtés devant quelque énorme pin demi-ébranché par la foudre, seul, debout sur le sommet d’un monticule nu."
                            },
                            {
                                "example_id": "d472368d-292c-45bb-90ad-7a383c8698a1",
                                "sense_id": "4533e39f-8751-3d89-95a9-3cbf75de840c",
                                "text": "Ils trouvèrent au bord du chemin quatre piquets ébranchés plantés en rectangle sur un emplacement où l’on avait dû entasser du petit bois de coupe."
                            },
                            {
                                "example_id": "00c8fff1-033c-4866-be12-0859208fc474",
                                "sense_id": "4533e39f-8751-3d89-95a9-3cbf75de840c",
                                "text": "Deux poutres ou plutôt deux troncs mal ébranchés, mal ajustés, à l’écorce humide, menaient selon une forte pente à la berge opposée, de beaucoup la plus basse."
                            }
                        ]
                    }
