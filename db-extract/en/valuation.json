                    {
                        "translation_id": "79369626-f65e-4deb-94a6-b5c101f050d9",
                        "source_entry_id": "cc53e694-5892-3ebc-86c4-74439bc51466",
                        "source_sense_id": "ff4f8310-9d73-399f-8e75-0b50f9a84246",
