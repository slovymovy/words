                        "entry_id": "a66c753d-949c-3cd1-9b2b-732c7f4346ab",
                        "glosses": [
                            "plaats waar misdadigers worden opgesloten, gevangenis"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "48d838bf-3399-471a-b4df-80ac8b394803",
                                "sense_id": "c5993a8a-95a3-3b27-b4ab-6ca60bcfb72f",
                                "text": "Hij zit al elf jaar in de nor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3edd6310-702c-4bf1-9c15-c761c1694d68",
                        "source_entry_id": "a66c753d-949c-3cd1-9b2b-732c7f4346ab",
                        "source_sense_id": "c5993a8a-95a3-3b27-b4ab-6ca60bcfb72f",
                        "source_sense_description": "gevangenis",
                        "target_lang_word": "Knast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e54f3c2d-bd28-33d7-931b-a1093e404064",
                                        "entry_id": "a8bd0529-687d-3989-9029-c3f5a2a5da8c",
                                        "glosses": [
                                            "gerichtlich verhängte Freiheitsstrafe"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "252e72bc-7250-4703-996c-cd6551d1ed0a",
                                                "sense_id": "e54f3c2d-bd28-33d7-931b-a1093e404064",
                                                "text": "„Auch er kenne einen, der nun - weil er rumballerte - fünf Jahre Knast bekommen habe.“"
                                            },
                                            {
                                                "example_id": "4dc87828-c8bd-45d2-9aca-eb469002ff0b",
                                                "sense_id": "e54f3c2d-bd28-33d7-931b-a1093e404064",
                                                "text": "„87,5 Prozent der Österreicher meinen, dass „Arbeit statt Knast“ unter bestimmten Bedingungen zulässig sein soll, sofern es dadurch auch zu einer Entlastung der Steuerzahler kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Knast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac82d165-9590-3dfe-81b1-8f2c9997c2e6",
                                        "entry_id": "65bcddae-a7b8-353b-9167-48cb6e569101",
                                        "glosses": [
                                            "Gefängnis"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f579e9bb-8f32-459c-8c81-859a650c47da",
                                                "sense_id": "ac82d165-9590-3dfe-81b1-8f2c9997c2e6",
                                                "text": "Er sitzt im Knast."
                                            },
                                            {
                                                "example_id": "08f7fe19-73ae-4e04-8dcc-457af75d82cb",
                                                "sense_id": "ac82d165-9590-3dfe-81b1-8f2c9997c2e6",
                                                "text": "„Unübersehbar ist ein weiteres Zeichen für den demokratischen Verfall: die amerikanische Leidenschaft für Knast und Todesstrafe.“"
                                            },
                                            {
                                                "example_id": "492793ac-70f7-4f6b-98b0-a2b715511c8c",
                                                "sense_id": "ac82d165-9590-3dfe-81b1-8f2c9997c2e6",
                                                "text": "„\"Im Knast bin ich fast irre geworden. Ich wollte nicht untätig rumsitzen und habe alle Hebel in Bewegung gesetzt, um rauszukommen\", erzählt der 44-Jährige.“"
                                            },
                                            {
                                                "example_id": "bd905d00-7ad3-4124-b92c-9bf4834d00ae",
                                                "sense_id": "ac82d165-9590-3dfe-81b1-8f2c9997c2e6",
                                                "text": "„ALLERDINGS geht auch der Vorwurf, mittels Hungerlöhnen würde im Knast Ausbeutung betrieben, an der Realität vorbei.“"
                                            },
                                            {
                                                "example_id": "a58ac2ac-ba89-4cb8-bd02-a3133001b3f5",
                                                "sense_id": "ac82d165-9590-3dfe-81b1-8f2c9997c2e6",
                                                "text": "„Kein Wunder also, dass die US-Streitkräfte im Knast von Bagram (Afghanistan) bereits seit Dezember 2002 systematisch foltern.“"
                                            },
                                            {
                                                "example_id": "eb329030-7945-4936-97fd-ddadf6a2507e",
                                                "sense_id": "ac82d165-9590-3dfe-81b1-8f2c9997c2e6",
                                                "text": "„Ein anderer Schauspieler, der großartige Thomas Thieme, hat in der DDR jahrelang im Knast gesessen.“"
                                            },
                                            {
                                                "example_id": "1c7f8697-69f3-4b2c-a331-2fab4a902644",
                                                "sense_id": "ac82d165-9590-3dfe-81b1-8f2c9997c2e6",
                                                "text": "„An einer Abendschule haben Jugendliche, die fast alle schon mal im Knast saßen, ihre Lehrerin massakriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Knast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52a1d1db-1d1a-3efa-aaea-68a7cded2e57",
                                        "entry_id": "f3793443-bc42-3ec6-a4c3-66fae1fb282d",
                                        "glosses": [
                                            "gekrümmter Teil eines Astes; Baumstamm mit Verdickungen; Baumstumpf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "462fe7a6-7061-4359-8de0-8a148d7baa97",
                                                "sense_id": "52a1d1db-1d1a-3efa-aaea-68a7cded2e57",
                                                "text": "„\"[…] Wenn bei einem 150 Kilo schweren Eichentisch im Gefüge etwas nicht stimmt, ist sein Ende vorprogrammiert.\" Zugleich verteidigt er kleine Fehler, ein Knast im Holz, eine leichte Asymmetrie: \"Coole Geschichten stelle ich nicht gern her.\"“"
                                            },
                                            {
                                                "example_id": "4b974b12-7f65-4883-bc4f-bccf315a6dee",
                                                "sense_id": "52a1d1db-1d1a-3efa-aaea-68a7cded2e57",
                                                "text": "Die Knoten am Holz bezeichnet man auch als Knast."
                                            },
                                            {
                                                "example_id": "921abb43-33b0-47dc-9b20-807ab1340ccc",
                                                "sense_id": "52a1d1db-1d1a-3efa-aaea-68a7cded2e57",
                                                "text": "Leider bleiben manche elektrischen Holzspalter bei einem kleinen Knast schon stehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Knast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb47ee1d-08d2-36dd-8057-0322321d23bd",
                                        "entry_id": "50d3f263-1b38-3974-b736-5f518e7ae2be",
                                        "glosses": [
                                            "großer Hunger"
                                        ],
                                        "tags": [
                                            "ostdeutsch umgangssprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5937dcf0-132b-440f-9aff-404d4fbcf8fc",
                                                "sense_id": "eb47ee1d-08d2-36dd-8057-0322321d23bd",
                                                "text": "„[…] Ich habe Knast.“ „Was hast du?“ „Knast, das ist so etwas wie Hunger, verstehst du, Kohldampf. Eben großer Hunger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6961823-b033-4fc2-b931-ff4e8d25c46a",
                        "source_entry_id": "a66c753d-949c-3cd1-9b2b-732c7f4346ab",
                        "source_sense_id": "c5993a8a-95a3-3b27-b4ab-6ca60bcfb72f",
                        "source_sense_description": "gevangenis",
                        "target_lang_word": "taule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f34e6af4-98fb-3dd9-b681-47f2f80928c6",
                                        "entry_id": "0e0574af-ee8e-3a82-8f70-986e9841a561",
                                        "glosses": [
                                            "Toute forme d’habitation : maison, chambre ou pièce."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c05fbe8-c23c-496d-9a9a-4da066ea4a2b",
                                                "sense_id": "f34e6af4-98fb-3dd9-b681-47f2f80928c6",
                                                "text": "Je te fais visiter ma taule, ce sera vite fait, c’est pas un palais !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41565c47-cf45-3b82-8e7d-5cde2707d156",
                                        "entry_id": "0e0574af-ee8e-3a82-8f70-986e9841a561",
                                        "glosses": [
                                            "Maison close."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca6aefc-511f-4826-9072-691556142472",
                                                "sense_id": "41565c47-cf45-3b82-8e7d-5cde2707d156",
                                                "text": "J’ai été en maison, répondit Véra, jusqu’à ce que Cramoisi, mon second homme, m’en ait sortie pour m’affranchir des taules et des taulières."
                                            },
                                            {
                                                "example_id": "4240651c-73f6-401f-ad2b-90921f1486fa",
                                                "sense_id": "41565c47-cf45-3b82-8e7d-5cde2707d156",
                                                "text": "Y a des jours où les clients, je me demande vraiment ce qu’ils viennent foutre dans ma taule […] Y seraient pas mieux […] à respirer le bon air ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c86208-8af3-3f5a-850b-3109bee44448",
                                        "entry_id": "0e0574af-ee8e-3a82-8f70-986e9841a561",
                                        "glosses": [
                                            "Prison ou simple cellule de prison."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41d19822-65a7-4581-9469-9726d85d7a00",
                                                "sense_id": "73c86208-8af3-3f5a-850b-3109bee44448",
                                                "text": "La faction séparatiste, compromise avec l’occupant au Conseil des Flandres, sortait à peine de taule et avait cessé d’être fréquentable."
                                            },
                                            {
                                                "example_id": "cca1da54-8bb1-4bab-a924-3545a38aba24",
                                                "sense_id": "73c86208-8af3-3f5a-850b-3109bee44448",
                                                "text": "Hafed a passé l’arme à (l’extrême) gauche en 2015, à 54 ans, le palpitant fragilisé par ses années de taule."
                                            },
                                            {
                                                "example_id": "f52fe803-8d22-4e28-9619-f2f9a895cf16",
                                                "sense_id": "73c86208-8af3-3f5a-850b-3109bee44448",
                                                "text": "J'ai même connu par la suite en cabane un mec qui avait été mis en taule parce qu'il faisait des sifflards avec des Allemands qu'il butait, se souvient Alphonse. On a mangé des nourritures tout à fait étranges."
                                            },
                                            {
                                                "example_id": "510695ee-106b-4773-9fa8-36dcc8e7c543",
                                                "sense_id": "73c86208-8af3-3f5a-850b-3109bee44448",
                                                "text": "L’usine ? « T’es comme en cellule répond encore un autre, – sauf qu’en taule, t’as davantage de temps libre »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12958ae2-c835-3e7a-9929-f8de3b5cdb4f",
                                        "entry_id": "0e0574af-ee8e-3a82-8f70-986e9841a561",
                                        "glosses": [
                                            "Lieu, entreprise où l’on travaille."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c24bf88d-c86b-42a8-95d6-e8cf04997f39",
                                                "sense_id": "12958ae2-c835-3e7a-9929-f8de3b5cdb4f",
                                                "text": "Tiens, un gars qui avait une petite taule où il faisait la réparation de bicyclettes, il est millionnaire, maintenant !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "353da21b-6ec4-3ddf-b981-6fd25491acb6",
                                        "entry_id": "e0770064-8b9f-3c56-ad19-a05c453f2d8c",
                                        "glosses": [
                                            "Table de l’enclume, partie plate de l’enclume."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "taule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c83f14a3-c19b-3d51-a92f-53294e2cdd19",
                                        "entry_id": "4eab213b-de94-3831-8f72-e2c4668cad84",
                                        "glosses": [
                                            "Exécuteur des hautes œuvres ; bourreau."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2e5892-9c31-4dcc-a88f-3fb8c48f5813",
                                                "sense_id": "c83f14a3-c19b-3d51-a92f-53294e2cdd19",
                                                "text": "— Qui êtes-vous ? lui ai-je dit enfin.\n— Drôle de demande ! a-t-il répondu. Un friauche.\n— Un friauche! Qu’est-ce que cela veut dire ?\nCette question a redoublé sa gaieté.\n— Cela veut dire, s’est-il écrié au milieu d’un éclat de rire, que le taule jouera au panier avec ma sorbonne dans six semaines, comme il va faire avec ta tronche dans six heures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50622d21-395e-4343-a3d2-067e42473b21",
                        "source_entry_id": "a66c753d-949c-3cd1-9b2b-732c7f4346ab",
                        "source_sense_id": "c5993a8a-95a3-3b27-b4ab-6ca60bcfb72f",
                        "source_sense_description": "gevangenis",
                        "target_lang_word": "tôle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tôle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67292847-bedc-3418-9e1d-3801a677bc8c",
                                        "entry_id": "7bcb9d47-072f-3288-a955-945ca00bc06b",
                                        "glosses": [
                                            "Plaque de métal laminé, de fine épaisseur utilisé pour la construction, l’automobile, l’aéronautique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d50a03-76dc-467a-8cc9-68fef1086116",
                                                "sense_id": "67292847-bedc-3418-9e1d-3801a677bc8c",
                                                "text": "J’avais laissé Reykjavik, un grand village ; les maisons en bois étaient toiturées de tôle ondulée."
                                            },
                                            {
                                                "example_id": "c9f54bc6-e97a-495a-b4c4-86033dba50cf",
                                                "sense_id": "67292847-bedc-3418-9e1d-3801a677bc8c",
                                                "text": "Parmi les quelque 5 000 blessés par le cyclone (une estimation, forcément approximative, du ministère de l’intérieur), nombreux sont ceux qui souffrent de plaies causées par la tôle ou les vis qui la fixaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d599577-f5ae-3575-86a2-68456e92e7e8",
                                        "entry_id": "7bcb9d47-072f-3288-a955-945ca00bc06b",
                                        "glosses": [
                                            "Voiture."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ead39945-e45a-30e5-9e09-597dbbb6387a",
                                        "entry_id": "7bcb9d47-072f-3288-a955-945ca00bc06b",
                                        "glosses": [
                                            "Mauvaise note ; faible score."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c8c3e7-cde8-4a15-beab-66ceca2ffb81",
                                                "sense_id": "ead39945-e45a-30e5-9e09-597dbbb6387a",
                                                "text": "Déjà mieux que le score humiliant de 1,53 %, obtenu par Yvon Berland à Marseille… « C’est une énorme tôle. On n’a pas su incarner une force d’alternance crédible au niveau local […] »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c01163e9-933c-3063-991d-184581e1db44",
                                        "entry_id": "7bcb9d47-072f-3288-a955-945ca00bc06b",
                                        "glosses": [
                                            "Prison."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d76762-f4c4-45ae-a937-df410c758797",
                                                "sense_id": "c01163e9-933c-3063-991d-184581e1db44",
                                                "text": "On l’a mis en tôle pour avoir volé un pain."
                                            },
                                            {
                                                "example_id": "3f36ca02-fb72-43a6-bd50-eaca50514c43",
                                                "sense_id": "c01163e9-933c-3063-991d-184581e1db44",
                                                "text": "— On l’a foutu en tôle, quand même ?\n— On lui a collé la rosette de la Légion d’honneur.\n— Je trouve ça léger, comme punition, bougonna Captain Beaujol qui, ancien sergent-chef, ne saisissait pas toujours au bond toutes les ironies."
                                            },
                                            {
                                                "example_id": "7a970884-985c-4fb1-a136-96b2d7259c27",
                                                "sense_id": "c01163e9-933c-3063-991d-184581e1db44",
                                                "text": "Eddy Chapelle moisit en tôle pour ce qu’il a fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608189cb-cba2-3935-8641-df682130d79d",
                                        "entry_id": "7bcb9d47-072f-3288-a955-945ca00bc06b",
                                        "glosses": [
                                            "Autre orthographe de taule : Toute forme d’habitation : maison, chambre ou pièce."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48193bdb-897e-4597-ac9b-7284e0ed1ebe",
                                                "sense_id": "608189cb-cba2-3935-8641-df682130d79d",
                                                "text": "Je te l’avais d’ailleurs déjà dit dans la tôle du bistro. Y a pas deux femmes au monde pour avoir cette façon de vous regarder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7515cf0f-a2d2-311f-bd8a-76adf785d4c8",
                                        "entry_id": "7bcb9d47-072f-3288-a955-945ca00bc06b",
                                        "glosses": [
                                            "Beuverie."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc1b9aa2-5b04-425d-96c3-87b1c0a3f570",
                                                "sense_id": "7515cf0f-a2d2-311f-bd8a-76adf785d4c8",
                                                "text": "Ce soir c’est la tôle."
                                            }
                                        ]
                                    }
                                ]
