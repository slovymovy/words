{
    "word_family": [
        "prune",
        "pruner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2f8d908-b170-3b57-add3-8b9c12da76ac",
                    "sense_definition": "present participle and gerund of <w>prune</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cut_trim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole afternoon <w>pruning</w> the rose bushes in the garden.",
                            "target_lang_translations": {
                                "zh": "他花了一整个下午在花园里<w>修剪</w>玫瑰花丛。"
                            }
                        },
                        {
                            "text": "She was busy <w>pruning</w> unnecessary paragraphs from her research paper.",
                            "target_lang_translations": {
                                "zh": "她正忙着从研究论文中<w>删减</w>不必要的段落。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trimming",
                        "clipping"
                    ],
                    "common_phrases": [
                        "pruning shears",
                        "pruning back"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词prune的现在分词和动名词形式；修剪、删减。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "修剪",
                                "target_lang_sense_clarification": "指修剪植物枝条"
                            },
                            {
                                "target_lang_word": "删减",
                                "target_lang_sense_clarification": "指删减冗余内容"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12abb2b4-95fc-3278-b0ea-50f01ab3ca6e",
                    "sense_definition": "The act of trimming or removing excess parts from a plant, tree, or bush to encourage growth or maintain shape.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cut_trim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular <w>pruning</w> helps fruit trees produce healthier and larger crops.",
                            "target_lang_translations": {
                                "zh": "定期<w>修剪</w>有助于果树结出更健康、更硕大的果实。"
                            }
                        },
                        {
                            "text": "The garden required extensive <w>pruning</w> after months of neglect.",
                            "target_lang_translations": {
                                "zh": "经过数月的荒废，花园需要进行大面积的<w>修剪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trimming"
                    ],
                    "common_phrases": [
                        "heavy pruning",
                        "winter pruning"
                    ],
                    "target_lang_definitions": {
                        "zh": "（对植物、树木或灌木的）修剪，整枝。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "修剪",
                                "target_lang_sense_clarification": "修整植物枝条的行为"
                            },
                            {
                                "target_lang_word": "整枝",
                                "target_lang_sense_clarification": "园艺学上的修整枝干"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f114ed0d-3358-36d1-8a89-0d3fc9bc369d",
                    "sense_definition": "Material, such as twigs or branches, that has been cut off from a plant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gathered the garden <w>prunings</w> and piled them near the compost bin.",
                            "target_lang_translations": {
                                "zh": "我们把花园里<w>剪下的枝条</w>收集起来，堆在堆肥箱旁。"
                            }
                        },
                        {
                            "text": "Dry <w>prunings</w> from the hedge can be used as kindling for the fire.",
                            "target_lang_translations": {
                                "zh": "从绿篱上<w>剪下的干燥枝条</w>可以当作生火用的引火柴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cuttings",
                        "trimmings"
                    ],
                    "common_phrases": [
                        "garden prunings"
                    ],
                    "target_lang_definitions": {
                        "zh": "修剪下来的树枝、杂草等剪除物（通常用复数形式prunings）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "剪下的枝条",
                                "target_lang_sense_clarification": "植物修剪下来的残枝"
                            },
                            {
                                "target_lang_word": "修剪残余物",
                                "target_lang_sense_clarification": "植物修剪下来的残料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44f48e54-9dfc-3c80-aff3-2a52c93110cc",
                    "sense_definition": "The removal of unnecessary branches or nodes from a decision tree or algorithm to simplify it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algorithm uses alpha-beta <w>pruning</w> to evaluate possible chess moves faster.",
                            "target_lang_translations": {
                                "zh": "该算法利用阿尔法-贝塔<w>剪枝</w>来更快地评估可能的棋局走法。"
                            }
                        },
                        {
                            "text": "Tree <w>pruning</w> reduces the risk of overfitting in machine learning models.",
                            "target_lang_translations": {
                                "zh": "决策树<w>剪枝</w>可以降低机器学习模型过拟合的风险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alpha-beta pruning",
                        "tree pruning"
                    ],
                    "target_lang_definitions": {
                        "zh": "（计算机科学中对决策树、神经网络等的）剪枝。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "剪枝",
                                "target_lang_sense_clarification": "算法或模型中的剪除无用节点"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}