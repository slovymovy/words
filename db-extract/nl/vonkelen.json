                            {
                                "example_id": "5b746f41-19f0-4743-bec5-9dc3b17ab9ad",
                                "sense_id": "a11668fb-94e5-3153-a1ff-453215a1238f",
                                "text": "En ik zal denken aan de stellen die het vuur weer hebben gevonden voor elkaar, waarvan ogen weer schitteren en vonkelen als ze naar elkaar kijken."
                            },
                            {
                                "example_id": "9b572c9d-ea70-4854-9f6e-0809b061ab81",
                                "sense_id": "a11668fb-94e5-3153-a1ff-453215a1238f",
                                "text": "Hij twijfelde lang over de rol. „Antony Hopkins heeft Hannibal Lecter perfect gespeeld, waarom zoiets nog een keer overdoen?” Tot hij inzag dat hij een andere Hannibal speelde. Niet met de van satanische spot vonkelende ogen van Hopkins, eerder met koele meren des doods."
                            }
                        ]
                    }
