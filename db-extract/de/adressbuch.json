                    {
                        "form_id": "3678cb64-dffb-4378-85d2-8f4d0213643b",
                        "entry_id": "63b9f5c0-5950-3d1b-a949-da8e537acb5b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Adressbücher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38c04400-9c4a-3c22-afa9-1e517c06b34a",
                        "entry_id": "63b9f5c0-5950-3d1b-a949-da8e537acb5b",
                        "glosses": [
                            "kleines Buch, das nur für die Aufnahme von Adressen gedacht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3decd8d-c212-4b26-865d-b0c3e0900e43",
                                "sense_id": "38c04400-9c4a-3c22-afa9-1e517c06b34a",
                                "text": "Ich habe Deine Adresse in mein Adressbuch aufgenommen."
                            },
                            {
                                "example_id": "179bd98c-a6e7-444e-bde4-815375fbca6a",
                                "sense_id": "38c04400-9c4a-3c22-afa9-1e517c06b34a",
                                "text": "„An diesem Tag wurde vor fünfzehn Jahren die Steppenstraße im Dorf Borodinowka gegründet, offiziell als Postadresse anerkannt und in was weiß ich welches Adressbuch eingetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96076251-6ba6-3535-8f38-503f4fb24152",
                        "entry_id": "63b9f5c0-5950-3d1b-a949-da8e537acb5b",
                        "glosses": [
                            "elektronisches Verzeichnis für E-Mail-Adressen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493c9ee2-520d-488e-94d5-d891dcddd4ae",
                                "sense_id": "96076251-6ba6-3535-8f38-503f4fb24152",
                                "text": "Ich habe Deine E-Mail-Adresse meinem Adressbuch hinzugefügt."
                            },
                            {
                                "example_id": "e3dc1c0c-e289-40b4-9432-45ccb273d005",
                                "sense_id": "96076251-6ba6-3535-8f38-503f4fb24152",
                                "text": "„MS Exchange ist ein sogenannte Groupware, mit deren Hilfe die Abgeordneten nicht nur Mails verschicken und empfangen können wie bisher, sondern auch ihre Adressbücher zentral verwalten und Termine miteinander abstimmen.“"
                            },
                            {
                                "example_id": "eb7337c8-b296-4b39-aa4f-3282619d39db",
                                "sense_id": "96076251-6ba6-3535-8f38-503f4fb24152",
                                "text": "„Die Adressbücher der Handys wuchsen rasant an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f66e9a7-4f0f-40d9-9a35-f4f26f1a08a6",
                        "source_entry_id": "63b9f5c0-5950-3d1b-a949-da8e537acb5b",
