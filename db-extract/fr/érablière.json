                "senses": [
                    {
                        "sense_id": "d331caf8-a5b8-3307-aa12-e161aa13dce8",
                        "entry_id": "ccd65104-0ffc-37ad-b223-459e488fb4eb",
                        "glosses": [
                            "Forêt ou plantation d’érable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf3b85b-d1b2-4c78-a0f6-382e700b2154",
                                "sense_id": "d331caf8-a5b8-3307-aa12-e161aa13dce8",
                                "text": "Au cœur de cette érablière à caryer, une hutte et un camp de pêche iroquoiens ont été reconstitués."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f07fdaa-0e50-3ef2-ae76-4416bd132f90",
                        "entry_id": "ccd65104-0ffc-37ad-b223-459e488fb4eb",
                        "glosses": [
                            "Plantation d'érable à sucre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c9255dda-16d0-4a38-af80-c805f6a4420d",
                                "sense_id": "1f07fdaa-0e50-3ef2-ae76-4416bd132f90",
                                "text": "« […] Si le prix n’est pas exorbitant, on va racheter la terre c’est sûr », a affirmé au Devoir Denis Aubin, qui tentera de racheter son érablière."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0f90425-0e43-3e6b-9743-a3ba54c65077",
                        "entry_id": "ccd65104-0ffc-37ad-b223-459e488fb4eb",
                        "glosses": [
                            "Établissement servant à exploiter une forêt ou une plantation d’érables à sucre dans le but d’en tirer des produits de l’érable, et recevant souvent des visiteurs en offrant des repas traditionnels et du divertissement."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b78e8268-9cde-4691-ba82-8335cb752bf6",
                                "sense_id": "b0f90425-0e43-3e6b-9743-a3ba54c65077",
                                "text": "Terminer la visite d’une érablière par une dégustation de tire d’érable."
                            },
                            {
                                "example_id": "0949f1be-11c4-4e3b-8699-6011792bd5a7",
                                "sense_id": "b0f90425-0e43-3e6b-9743-a3ba54c65077",
                                "text": "Même si elle n’a que quatre ans, Magalie participe déjà aux activités de l’érablière familiale."
                            },
                            {
                                "example_id": "d53fca4b-f22d-4e15-95a7-b3b43c263311",
                                "sense_id": "b0f90425-0e43-3e6b-9743-a3ba54c65077",
                                "text": "Une érablière a été la proie des flammes à Saint-Hyacinthe en Montérégie, mardi matin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
