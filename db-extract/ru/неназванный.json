                                        "entry_id": "ec59aece-11aa-3c64-8700-efe0d7436995",
                                        "glosses": [
                                            "Not disclosed.",
                                            "Kept secret."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "125f5640-8f9e-47b1-901b-87f33b1aab2d",
                                                "sense_id": "7a9640d2-5996-3de1-b5ae-06e2c432d273",
                                                "text": "an undisclosed location"
                                            },
                                            {
                                                "example_id": "caf678b7-36de-479a-8381-5bf5a860dbde",
                                                "sense_id": "7a9640d2-5996-3de1-b5ae-06e2c432d273",
                                                "text": "an undisclosed sum [amount of money]"
                                            },
                                            {
                                                "example_id": "e3ce1abd-b002-4650-9bbb-04768a0721d8",
                                                "sense_id": "7a9640d2-5996-3de1-b5ae-06e2c432d273",
                                                "text": "The line beyond which American pilots do not fly in the troubled Formosa Strait area is called the “Davis Line” in honor of Brig. Gen. Benjamin O. Davis Jr., former commander of the 13th Provisional Air Force, stationed on Formosa[.] The mythical line is an undisclosed number of miles off the coast of Red China."
                                            },
                                            {
                                                "example_id": "c8863451-4512-4565-9ede-c1f2e3571e31",
                                                "sense_id": "7a9640d2-5996-3de1-b5ae-06e2c432d273",
                                                "text": "Transport software company Tracsis has acquired smart ticketing provider iBlocks for an undisclosed sum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97f6922d-46a8-35b4-af57-c848fa77f220",
                                        "entry_id": "ec59aece-11aa-3c64-8700-efe0d7436995",
