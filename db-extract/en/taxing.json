                                        "sense_id": "3cef32bd-0065-3f08-9ff1-5088222bf846",
                                        "entry_id": "47088197-edcc-32c4-a77d-e14cdf472593",
                                        "glosses": [
                                            "Qui est propre à épuiser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b879e0-5f32-47a1-bdf2-467ebe6096f3",
                                                "sense_id": "3cef32bd-0065-3f08-9ff1-5088222bf846",
                                                "text": "Cultures épuisantes, cultures qui épuisent rapidement la terre."
                                            },
                                            {
                                                "example_id": "8f95a15b-a91a-4a33-88c6-db1e8a2d5906",
                                                "sense_id": "3cef32bd-0065-3f08-9ff1-5088222bf846",
                                                "text": "Si le vent est contraire, rien d'autre à faire que ramer, ce qui exige un effort épuisant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épuisant",
