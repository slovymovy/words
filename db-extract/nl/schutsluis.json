                                                "sense_id": "76595cc8-2f56-3e15-a62c-f641a8d92c02",
                                                "text": "Here the canal came to a check, ending abruptly with a large lock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dfd8fc3-7753-31a7-b8ac-71b38bbcea87",
                                        "entry_id": "386e2d44-f4e3-3624-9282-73cef9c6ba29",
                                        "glosses": [
                                            "The firing mechanism."
