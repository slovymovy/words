                                "target_senses": [
                                    {
                                        "sense_id": "e7af38de-e1ab-30c9-b0ea-f54b245096ea",
                                        "entry_id": "3fd74e47-1ba3-3395-be64-9c6dd2fc1731",
                                        "glosses": [
                                            "A place or location."
                                        ],
                                        "tags": [],
