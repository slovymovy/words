                                        "entry_id": "1661016d-007a-3019-a6d1-773f68cf1e27",
                                        "glosses": [
                                            "człowiek zawodowo trudniący się spławem rzecznymi tratwami drewna, zboża i innych towarów do portów morskich, zajmujący się flisactwem"
                                        ],
                                        "tags": [
                                            "professional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606f3c7a-ff79-4ee9-adde-1aa41f691675",
                                                "sense_id": "6a8f7abd-df86-3268-a8bf-a916331fdc4e",
                                                "text": "W Toruniu zmierzch purpurą niebo znaczy, / A Wisłą, co skryta już jest pośród mgieł, / Jak we śnie spływają widmowi flisacy"
                                            },
                                            {
                                                "example_id": "ec3a8c41-fe57-41d5-b99f-4d5ee3280107",
                                                "sense_id": "6a8f7abd-df86-3268-a8bf-a916331fdc4e",
                                                "text": "W dole przepływał galar; zniosło go bokiem. Flisak zgięty w łuk przebiegał bosymi nogami po desce, parł na drąg sterowy, by go znów z pluskiem przerzucić"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "cb6aa4c2-1721-3595-8453-e00377778062",
                                        "entry_id": "1661016d-007a-3019-a6d1-773f68cf1e27",
