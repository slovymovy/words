                                            {
                                                "example_id": "6cdf84d4-0cbb-4ebc-aa79-8c85856263a7",
                                                "sense_id": "2c261264-3f05-32ec-b08c-adc5b9674864",
                                                "text": "„… aber sie wär just recht so für unsern Geschmak; nicht gar zu groß, schöne Augen im Kopf, nicht zu dik und nicht zu mager; freilich eine böse Zunge, die haben zwar alle Weibsleute, das schadet aber nichts.“"
                                            }
                                        ],
