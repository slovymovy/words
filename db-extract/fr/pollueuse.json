                                        "glosses": [
                                            "A subject that pollutes, be it a person, company, country, factory or another subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cd10e45-d9c3-441b-9517-4d057fda6243",
                                                "sense_id": "0b65c87f-53ce-3062-ab09-df8544ea1670",
                                                "text": "During the last session of Parliament a Rivers' Pollution Prevention Act was passed, after it had been carefully divested of most of the provisions which could make it objectionable to polluters."
                                            },
                                            {
                                                "example_id": "8bbaf90e-3ca0-4837-add3-80bad7aff3aa",
                                                "sense_id": "0b65c87f-53ce-3062-ab09-df8544ea1670",
                                                "text": "The Environmental Protection Agency said it gets stuck with the bills because it often can't locate polluters or they are out of business or bankrupt."
                                            },
                                            {
                                                "example_id": "914781cf-8e78-4119-998e-63d7b54afe6d",
                                                "sense_id": "0b65c87f-53ce-3062-ab09-df8544ea1670",
                                                "text": "Goodbye from the world's biggest polluter."
