                "senses": [
                    {
                        "sense_id": "bc38de27-1665-3431-a8b2-571556c737c2",
                        "entry_id": "89a4564a-e847-394e-b47b-ec0380092e90",
                        "glosses": [
                            "von Amts wegen für das Jagdwesen zuständiger höherer Beamten beziehungsweise dessen Titel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c72fa94d-520f-4a88-8d30-0933341aa2cf",
                                "sense_id": "bc38de27-1665-3431-a8b2-571556c737c2",
                                "text": "Jagdjunker stellten die hohe Beamtenschaft für das Jagd- und Forstwesen bei Hofe und erhielten nach erfolgreichen Dienstjahren die Titel Jägermeister oder Forstmeister, einzelne stiegen zum Oberjägermeister oder Oberforstmeister auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e5540387-32dc-3c61-b50e-55e8b0dc750f",
                        "entry_id": "89a4564a-e847-394e-b47b-ec0380092e90",
                        "glosses": [
                            "Nach [1] benannter Markenname für einen Kräuterlikör des Unternehmens Mast-Jägermeister SE im niedersächsischen Wolfenbüttel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4ca45cf-d7b7-4b74-937f-ce1264633484",
                                "sense_id": "e5540387-32dc-3c61-b50e-55e8b0dc750f",
                                "text": "Herr Ober, bitte bringen sie mir zum Abschluss des vorzüglichen Menüs ein Gläschen Jägermeister."
                            },
                            {
                                "example_id": "1c2fb9ef-a07a-4492-b713-2b847382d383",
                                "sense_id": "e5540387-32dc-3c61-b50e-55e8b0dc750f",
                                "text": "„Zehn kleine Jägermeister“ thematisieren die Drogenproblematik, XTC als Opiat fürs Volk der Raver, Jägermeister für den Durchschnittsbürger."
                            },
                            {
                                "example_id": "8c010ad9-c95c-428a-bffb-710c943648ee",
                                "sense_id": "e5540387-32dc-3c61-b50e-55e8b0dc750f",
                                "text": "Beispielsweise hatte ein Satiremagazin vor Jahren eine gefälschte Jägermeister-Reklame mit dem Slogan „Ich trinke Jägermeister, weil mein Dealer zur Zeit im Knast sitzt“ abgedruckt und damit eine Schadenersatzforderung in Millionenhöhe provoziert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
