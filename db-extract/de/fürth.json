                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef09c3d0-58fc-4e6a-8f01-e54406913b9e",
                        "source_entry_id": "b1f8db6e-c003-3856-ac5e-14ce5baa879e",
                        "source_sense_id": "185cfadd-9d41-38b9-b3b6-1b9597c6bb43",
                        "source_sense_description": "Stadt in Bayern, Deutschland",
                        "target_lang_word": "Фюрт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Фюрт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "25aeabbb-7416-35a0-b23b-4b48cc4cd46e",
                                        "entry_id": "42c35d1d-e59e-3c70-8cab-2f0cd07daff5",
                                        "glosses": [
                                            "геогр. город в Германии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd1742f-c9bb-4c6e-9d17-ccba63a0c379",
                                                "sense_id": "25aeabbb-7416-35a0-b23b-4b48cc4cd46e",
                                                "text": "Но самыми приятными для него посетителями были слуга графини, механик, студент и извозчик. Последний, проезжая из Вюрцбурга в Фюрт, всегда навещал Феликса."
                                            },
                                            {
                                                "example_id": "a19f0be0-f46f-43ef-980f-acc29ef78e22",
                                                "sense_id": "25aeabbb-7416-35a0-b23b-4b48cc4cd46e",
                                                "text": "Нюрнбергские жители, искавшие, как потребители, конечно, своей выгоды, нашли благоразумным впредь делать свои закупки в Фюрте."
                                            },
                                            {
                                                "example_id": "d1176cd0-72f6-47d6-bee6-56f90ff0f666",
                                                "sense_id": "25aeabbb-7416-35a0-b23b-4b48cc4cd46e",
                                                "text": "Первою построена Царскосельская железная дорога, как кажется, третья, по времени, в Европе. Первая была между Нюрнбергом и Фюртом; вторая — между Парижем и Версалем .."
                                            },
                                            {
                                                "example_id": "f34fbd6e-3fcb-4fff-8794-c2424981da33",
                                                "sense_id": "25aeabbb-7416-35a0-b23b-4b48cc4cd46e",
                                                "text": "— Письмо на столе, — сказала она. // Хольт увидел печатный бланк: «Д-р Гейнц Гейнрихс, д-р Ганс Гомилка, нотариусы, адвокаты по уголовным делам. Адвокатская контора, город Фюрт»."
                                            },
                                            {
                                                "example_id": "602e460b-1aba-4744-b174-6b70ba40793d",
                                                "sense_id": "25aeabbb-7416-35a0-b23b-4b48cc4cd46e",
                                                "text": "Тридцатисемилетний немец Франц Байер открыл в своём родном городе Фюрте ресторанчик под нестандартным названием «?»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
