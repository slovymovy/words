                                        "entry_id": "2b7593b0-00ac-35bd-a9fa-4f8c7a9c24ad",
                                        "glosses": [
                                            "A continental region consisting of the portion of the Earth north of the Arctic Circle, containing the North Pole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ebc2b99-0692-4444-ae8f-5e946f38d766",
                                                "sense_id": "9eba4403-2f81-3b17-8ab7-11662bf1473a",
                                                "text": "I’ve visited the world from arctic to ecliptic, as a surgeon does a hospital, and find all men sick of some distemper […]"
                                            }
                                        ]
                                    }
                                ]
