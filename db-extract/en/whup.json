                    {
                        "sense_id": "f124f969-2aee-313f-a139-e79556756c60",
                        "entry_id": "955926ef-1b25-3acc-941f-f9e4c25d79a0",
                        "glosses": [
                            "Alternative form of whoop (“an exclamation, or representation of a shout or cry, expressing joy or surprise”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "0ac0701c-8b17-4a8c-bfef-d83f82ec05e4",
                                "sense_id": "f124f969-2aee-313f-a139-e79556756c60",
                                "text": "The ſcantlin won,the winners muſt cry whup,\nThe goale is got,and now the game is vp."
                            },
                            {
                                "example_id": "d02d5725-5dfa-4904-929f-cee3074bc0fc",
                                "sense_id": "f124f969-2aee-313f-a139-e79556756c60",
                                "text": "WHup^([sic]) (Fᴀᴜꜱᴛᴜʟᴜꜱ) all draw ny thee\nThat doe love thee, or lov'd by thee,\nJoying in thy ſafe returning!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
