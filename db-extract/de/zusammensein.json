                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "02cb555d-398c-4136-8138-841c4c7eee76",
                        "entry_id": "54c9af7d-0b81-3d15-b013-8e2ca6ccf0a5",
                        "tags": [
                            "nominative",
