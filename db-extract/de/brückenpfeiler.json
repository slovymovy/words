                "senses": [
                    {
                        "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                        "entry_id": "9ef1c9a2-753d-33d2-9a83-cb8ac9bcd1cb",
                        "glosses": [
                            "Pfeiler, der eine Brücke trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e52d40-3ae9-4a7f-b42d-7230b79cbb4d",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "Der 52-jährige Autofahrer fuhr eine Böschung hoch und prallte daraufhin gegen einen Brückenpfeiler."
                            },
                            {
                                "example_id": "a28b2d32-d1ed-4974-9210-b90e6a7e853f",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„Der Mann läuft einen abschüssigen Pfad herunter, steht wenig später unter den übrig gebliebenen Brückenpfeilern.“"
                            },
                            {
                                "example_id": "285c9b23-0965-4b50-b565-2f7a76c77a57",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„[…] das Fahrzeug [schleuderte] nach rechts über alle Fahrspuren und prallte gegen […] einen Brückenpfeiler.“"
                            },
                            {
                                "example_id": "46c92da7-c8a5-4de5-b4ce-17bbbe1d3d16",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„[ein mit hoher Geschwindigkeit herannahender Transporter] touchierte bei dem Ausweichmanöver einen Brückenpfeiler und überschlug sich.“"
                            },
                            {
                                "example_id": "70f725b4-796c-4c3f-b55d-13e163673ef0",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„Auf dem Rhein im deutschen Duisburg ist am Abend ein Hotelschiff gegen den Brückenpfeiler einer Autobahn geprallt.“"
                            },
                            {
                                "example_id": "1c453dfd-adb9-425d-a015-bf836df8075c",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„Erneut ist ein Passagierschiff auf der Donau gegen einen Brückenpfeiler gefahren - diesmal in der Nähe von Bad Abbach.“"
                            },
                            {
                                "example_id": "3a4d0a64-6eea-4388-bc9e-dd80bd2cb415",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„[…] an der A3 bei Würzburg Heidingsfeld […] fand jetzt der größte Brückenverschub dieser Art in Deutschland statt. 4.500 Tonnen Stahl wurden Stück für Stück auf den nächsten Brückenpfeiler geschoben.“"
                            },
                            {
                                "example_id": "e1e82202-637f-4807-b1d0-30ff415beab2",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„Mit 850 Metern Länge ist sie die längste Schrägseilbrücke der Schweiz, die Fahrbahn liegt 70 Meter über der Saane, die Brückenpfeiler ragen gar 110 Meter hoch; die Poyabrücke ist ein Freiburger Jahrhundertbauwerk.“"
                            },
                            {
                                "example_id": "5b05d5f3-62ba-496e-b803-a19707710c8d",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„Am Dienstag wollen die Gemeinden […] über die Zukunft des Reussübergangs informieren. Bereits im August wurde bekannt, dass die Brückenpfeiler massiv unterspült sind.“"
                            },
                            {
                                "example_id": "c6634b1c-88fb-48d5-b10b-914bc0e67f19",
                                "sense_id": "1b88d1b3-2f14-3121-8e32-6ae65f93bd6c",
                                "text": "„In Flüssen kann es an Brückenpfeilern zu Strudeln kommen, die selbst geübte Schwimmer unter Wasser ziehen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
