                "senses": [
                    {
                        "sense_id": "2bf2f561-4910-3e04-b436-f890028d4cd1",
                        "entry_id": "a7e60e34-9204-36e6-9e14-c5b92174db7e",
                        "glosses": [
                            "de verzameling vooroordelen die media, mensen en groepen gebruiken voor hun beeldvorming en communicatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77384363-b590-44e4-b919-f21e3b4a67aa",
                                "sense_id": "2bf2f561-4910-3e04-b436-f890028d4cd1",
                                "text": "Op 13 mei 2000 vond in de wijk Roombeek te Enschede een ramp plaats. Een brand bij vuurwerkfabriek SE Fireworks had een tweetal zeer zware explosies tot gevolg. Hierbij vielen 22 doden en 947 gewonden. Naar aanleiding van deze gebeurtenis is in Nederland het externe veiligheidsbeleid aangescherpt door de overheid. Een ramp van dergelijke omvang en impact heeft veel stof doen opwaaien in de media. Deze media (in de persoon van journalisten) moesten daarbij een selectie maken om te bepalen `wie of wat nieuws was (agenda setting) en `hoe dat nieuws te brengen (framing). Framing is dus een visie; een kader waarbinnen een onderwerp of persoon belicht wordt."
                            },
                            {
                                "example_id": "18cda5ca-9812-472e-96fd-a6fb759d5394",
                                "sense_id": "2bf2f561-4910-3e04-b436-f890028d4cd1",
                                "text": "Niet de historische context, maar de maatschappelijke framing van het thema is dus bepalend bij Bals culturele analyse."
                            }
                        ]
                    },
                    {
                        "sense_id": "627e265f-d7e4-31ec-9571-855dd7f53ff4",
                        "entry_id": "a7e60e34-9204-36e6-9e14-c5b92174db7e",
                        "glosses": [
                            "in een context plaatsen om een eigenschap te suggereren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7c6c29-ab2c-4f9e-bd67-6654c4670a2b",
                                "sense_id": "627e265f-d7e4-31ec-9571-855dd7f53ff4",
                                "text": "De reclamewereld maakt graag gebruik van framing om producten beter te laten lijken."
                            },
                            {
                                "example_id": "91b8e4f2-09a4-46d7-bc8e-12e3959b919e",
                                "sense_id": "627e265f-d7e4-31ec-9571-855dd7f53ff4",
                                "text": "Met framing kunnen volksmenners bevolkingsgroepen op slinkse wijze zwart maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c58a852e-764b-40f3-bedb-0a354118111d",
                        "source_entry_id": "a7e60e34-9204-36e6-9e14-c5b92174db7e",
                        "target_lang_word": "Framing",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Framing",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                        "entry_id": "dc56ecd4-8469-36d7-9347-8a148bfd1233",
                                        "glosses": [
                                            "Wortwahl, die der Beeinflussung eines (meist in den Medien diskutierten) Themas dient; dabei wird bewusst ein neutraler Standpunkt aufgegeben und es werden Signalwörter benutzt, die den Zuhörern/Lesern eine gewollte Assoziation aufdrängen"
                                        ],
                                        "tags": [
                                            "Soziologie",
                                            "Kommunikationswissenschaften",
                                            "negative Konnotation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51551ac1-8e1f-4dca-ac1c-0648d100ce53",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "Als Journalist ist man immer in der Gefahr, unbewusst ein Framing, an das man nicht denkt, zu transportieren."
                                            },
                                            {
                                                "example_id": "d020a2e2-767f-4d91-9495-2c0a7b62a2db",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„Verkürzt bedeutet Framing: Die Formulierung beeinflusst die Botschaft.“"
                                            },
                                            {
                                                "example_id": "a0514dc4-fde9-438a-abe5-afbd31d4495f",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„Im Asyldiskurs wird besonders deutlich, wie Framing als Instrument gebraucht und missbraucht werden kann.“"
                                            },
                                            {
                                                "example_id": "af817cda-c2d3-4690-853d-dd5d6d326ecc",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„»Allein durch das Framing, durch den Ausschnitt, den Kleist wählt, identifiziert man sich schon mit der unschuldigen weißen Figur.«“"
                                            },
                                            {
                                                "example_id": "272a1451-e37c-419f-a96a-a40cbe4ee4b8",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„Framing soll erklären, weshalb Donald Trump an die Macht kommen konnte.“"
                                            },
                                            {
                                                "example_id": "7d985339-0165-4d52-a6cc-4363c52dbf66",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„Manche Medien-Kritiker, darunter auch Journalisten, lehnen diese Wortwahl trotzdem strikt ab. Begründung: Damit werde das \"Framing\", also das Deutungsmuster der Rechten übernommen.“"
                                            },
                                            {
                                                "example_id": "f9242b9e-3f33-4bb7-99e6-b5fc98eb5fef",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„Framing heißt: durch bestimmte Worte den Deutungsrahmen vorgeben. Egal ob \"Kreuzzüge\" oder \"Endlösung\" - immer wieder hat der Einsatz von bestimmten Wörtern der Wirklichkeit eine Färbung gegeben. Die Geschichte vom Framing.“"
                                            },
                                            {
                                                "example_id": "afb01ce0-a313-4d27-b9fd-6759f5ba3fe0",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„Dazu analysierten die Forschenden mehr als sechs Millionen klinische und biowissenschaftliche Publikationen. Dabei sahen sie, dass männliche Hauptautoren mit einer um bis zu 21 Prozent höheren Wahrscheinlichkeit positives Framing in Überschriften und Zusammenfassungen verwenden. Mit positivem Framing wird eine Sprache bezeichnet, die die Ergebnisse als besonders wichtig einstuft.“"
                                            },
                                            {
                                                "example_id": "045ab519-c5ef-4d8d-8f02-be081239b8a0",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„An Beispielen wie Huawei und Hongkong entlarvt sie die Staatsmacht in Peking als Meisterin des politischen Framings.“"
                                            },
                                            {
                                                "example_id": "d8bfb5ee-719f-45b9-b2d9-f154d52773e0",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "[Der britischen Guardian] „hat seine Klimaberichterstattung stark ausgebaut und dabei unter anderem auch das eigene Framing geändert. Statt von Klimawandel schreiben die Guardian-JournalistInnen [sic] jetzt von Klimanotstand oder -krise, statt von globaler Erwärmung von globaler Erhitzung.“"
                                            },
                                            {
                                                "example_id": "457b1df0-c712-4969-92c9-acf28e677f7d",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "„»Nicht erst seit Donald Trump, aber vor allem seitdem es der Milliardär zum US-Präsidenten gebracht hat, reden wir über „Framing“. Wenn Trump sagt, dass die Flüchtlinge als „Karawane“ gen Norden ziehen, wenn er von „Fake News“ spricht oder davon, dass die Ermittlungen gegen ihn einer „Hexenjagd“ gleichen, dann setzt er etwas in den Gehirnen seiner Zuhörer frei. Einen Deutungsrahmen, nämlich, Englisch: einen frame. […]«“"
                                            },
                                            {
                                                "example_id": "da60b630-e934-4355-920f-e686b4df28a0",
                                                "sense_id": "2b1f2cb4-e6c0-3c61-b01c-981be50340dc",
                                                "text": "[„Anglizismus des Jahres“ 2018:] „Auf den Plätzen zwei und drei landeten die Begriffe \"Framing\" und \"nice\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b930f28-05a4-304c-a6b3-dfa21a7aeb6b",
                                        "entry_id": "dc56ecd4-8469-36d7-9347-8a148bfd1233",
                                        "glosses": [
                                            "Einbinden einer fremden Webseite auf der eigenen Webseite, sodass man deren Inhalte lesen kann (also nicht nur eine Verlinkung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d873fe6-a90b-4140-8afb-85898b0f37ca",
                                                "sense_id": "7b930f28-05a4-304c-a6b3-dfa21a7aeb6b",
                                                "text": "„Ob Framing zulässig ist oder nicht, ist für das Urheberrecht an Bildern im Internet eine entscheidende Frage.“"
                                            },
                                            {
                                                "example_id": "5c4e9b2b-c551-4413-a231-0391a5900b83",
                                                "sense_id": "7b930f28-05a4-304c-a6b3-dfa21a7aeb6b",
                                                "text": "„Hierzu gibt es bereits mehrere Gerichtsurteile, so sah das Landgericht Düsseldorf das Framing von fremden Seiten als zulässig an, das Landesgericht in Steyr (Österreich) wiederum das Einbinden fremder Seiten in das eigene Frameset als Wettbewerbswidrigkeit.“"
                                            },
                                            {
                                                "example_id": "5854c71b-336d-4c58-9808-60df4dcd10a3",
                                                "sense_id": "7b930f28-05a4-304c-a6b3-dfa21a7aeb6b",
                                                "text": "„Wer fremde Videos auf seiner eigenen Webseite einbettet, verletzt nicht grundsätzlich das Urheberrecht. Das hat der Bundesgerichtshof (BGH) am Donnerstag entschieden. Das sogenannte Framing ist aber nur gestattet, wenn der Rechteinhaber das Video selbst zuvor für Internetnutzer frei zugänglich gemacht hat. (Az.: I ZR 46/12)“"
                                            },
                                            {
                                                "example_id": "7e354ad5-cd20-4fa2-b837-1ee1b10d9f7d",
                                                "sense_id": "7b930f28-05a4-304c-a6b3-dfa21a7aeb6b",
                                                "text": "„An diesem Donnerstag (16.05.2013) sollten die Richter ein Urteil fällen. Doch sie haben den Fall nach Luxemburg durchgereicht, dort soll nun der Europäische Gerichtshof erst einmal entscheiden, ob das Einbinden von Online-Videos, das sogenannte \"Framing\", europäisches Urheberrecht verletzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "26fd8e11-4473-3b85-8fc2-ef3c956eb6c9",
                                        "entry_id": "dc56ecd4-8469-36d7-9347-8a148bfd1233",
                                        "glosses": [
                                            "in einem Bild den Fokus des Betrachters durch umschließende Elemente (beispielsweise Blätter, Fenster, Brücken, Türen) auf einen Bildgegenstand lenken (Anmerkung: nicht verwechseln mit der Tatsache, dass ein Bild häufig in einem (hölzernen, metallenen) Rahmen gezeigt wird)"
                                        ],
                                        "tags": [
                                            "Photographie",
                                            "Malerei",
                                            "Film",
                                            "Bildkomposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "570d4810-132e-42cc-8913-3d37d857ac16",
                                                "sense_id": "26fd8e11-4473-3b85-8fc2-ef3c956eb6c9",
                                                "text": "„Bei dieser Technik der Bildkomposition geht es nicht darum, ein Bild in einen Rahmen zu hängen; „Framing“ bedeutet in diesem Zusammenhang, die Elemente, die sich um dich herum befinden, als Rahmen für das im Zentrum des Fotos stehende Objekt zu benutzen.“"
                                            },
                                            {
                                                "example_id": "8dcd4b25-f375-4d5b-9545-f8274ec0e076",
                                                "sense_id": "26fd8e11-4473-3b85-8fc2-ef3c956eb6c9",
                                                "text": "„Die „Umrahmung“ – oder das „Framing“ wie es auch genannt wird – muss nicht unbedingt rund um das gesamte Motiv verlaufen, um effektiv zu sein.“"
                                            },
                                            {
                                                "example_id": "274de080-c722-4fe3-a226-8d0df3bb3a2f",
                                                "sense_id": "26fd8e11-4473-3b85-8fc2-ef3c956eb6c9",
                                                "text": "„In meiner Reihe „Tipps für kreative Fotos“ soll es heute um das Thema Framing gehen.“"
                                            },
                                            {
                                                "example_id": "f17eb00d-d56f-4478-8aa9-ea42d7feb525",
                                                "sense_id": "26fd8e11-4473-3b85-8fc2-ef3c956eb6c9",
                                                "text": "In großen Kinoepen von Vom Winde verweht (Gone with the wind, USA 1939) bis zu Star wars wird das Framing systematisch eingesetzt, um die Figuren zu betonen und sie auch zu erhöhen."
                                            },
                                            {
                                                "example_id": "9bb0f0a0-e74d-4a4c-a0bb-e6f6aa0dd164",
                                                "sense_id": "26fd8e11-4473-3b85-8fc2-ef3c956eb6c9",
                                                "text": "„Sehr subtil und hervorragend balanciert ist das Framing in Bild 1.53 aus Darren Aronofskys Psychothriller Black Swan (USA, 2010).“"
                                            },
                                            {
                                                "example_id": "fc137635-3412-4774-8171-3821e42f184a",
                                                "sense_id": "26fd8e11-4473-3b85-8fc2-ef3c956eb6c9",
                                                "text": "„Das Framing kann aber auch genutzt werden, um Figuren voneinander zu separieren und zu isolieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
