                                "target_lang_word": "жест",
                                "target_lang_sense_clarification": "приветственный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥手",
                                "target_lang_sense_clarification": "手部动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6a1e1ab-903b-39ac-a730-026b093dfb4f",
                    "sense_definition": "A curved shape or pattern, especially in hair.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hair had a natural <w>wave</w> to it.",
                            "target_lang_translations": {
                                "ru": "Её волосы вились естественной <w>волной</w>.",
                                "zh": "她的头发天生带点<w>波浪</w>。"
                            }
                        },
                        {
                            "text": "The pattern on the fabric consists of lines and <w>waves</w>.",
                            "target_lang_translations": {
                                "ru": "Узор на ткани состоит из линий и <w>волн</w>.",
                                "zh": "布料上的图案由线条和<w>波浪纹</w>组成。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "permanent wave",
                        "natural wave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изогнутая форма или узор, особенно на волосах.",
                        "zh": "弯曲的形状或图案，尤指头发的卷曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волна",
                                "target_lang_sense_clarification": "форма волос"
                            },
                            {
                                "target_lang_word": "локон",
                                "target_lang_sense_clarification": "завиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波浪形",
                                "target_lang_sense_clarification": "形状"
                            },
                            {
                                "target_lang_word": "卷曲",
                                "target_lang_sense_clarification": "头发的纹理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "605b71eb-f08d-31f5-a447-8781957db996",
                    "sense_definition": "A sudden increase in a feeling, activity, or number of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>wave</w> of shoppers rushed into the store when it opened.",
                            "target_lang_translations": {
                                "ru": "<w>Волна</w> покупателей хлынула в магазин при открытии.",
                                "zh": "商店开门时，一<w>波</w>顾客涌了进去。"
                            }
                        },
                        {
                            "text": "She felt a <w>wave</w> of sadness when she heard the news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>волну</w> грусти, когда услышала новости.",
                                "zh": "听到这个消息时，她感到一<w>阵</w>悲伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rush"
                    ],
                    "common_phrases": [
                        "wave of panic",
                        "heat wave",
                        "crime wave",
                        "wave of emotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный наплыв чувства, активности или увеличение количества людей.",
                        "zh": "某种情绪、活动或人群数量的突然增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волна",
                                "target_lang_sense_clarification": "метафорическое"
                            },
                            {
                                "target_lang_word": "наплыв",
                                "target_lang_sense_clarification": "массовое появление"
                            },
                            {
                                "target_lang_word": "прилив",
                                "target_lang_sense_clarification": "чувств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪潮",
                                "target_lang_sense_clarification": "比喻用法"
                            },
                            {
                                "target_lang_word": "热潮",
                                "target_lang_sense_clarification": "活动或情绪的高涨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d5d362c-221a-35f2-b4ee-e794b3b0056a",
                    "sense_definition": "A way in which energy, such as light, sound, or heat, travels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gravity <w>waves</w> are notoriously difficult to detect.",
                            "target_lang_translations": {
                                "ru": "Гравитационные <w>волны</w> чрезвычайно трудно обнаружить.",
                                "zh": "引力<w>波</w>以难以探测而闻名。"
                            }
                        },
                        {
                            "text": "The radio receives <w>waves</w> from the broadcasting station.",
                            "target_lang_translations": {
                                "ru": "Радиоприемник принимает <w>волны</w> от радиостанции.",
                                "zh": "收音机接收来自广播电台的<w>波</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sound wave",
                        "radio wave",
                        "light wave",
                        "shock wave"
                    ],
                    "traits": [
