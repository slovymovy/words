                                        "examples": [
                                            {
                                                "example_id": "28638dfa-39b7-4ddf-8d28-bff5fd6be0c3",
                                                "sense_id": "37177e08-d63e-3906-a6e0-8db22529f634",
                                                "text": "Both railway officers and railwayacs will find much useful information in Mr. Sekon's latest addition to his list of contributions to railway literature."
                                            },
                                            {
                                                "example_id": "1f51f355-fd92-4004-a6db-536d79c1aa2b",
                                                "sense_id": "37177e08-d63e-3906-a6e0-8db22529f634",
                                                "text": "Roger Lloyd's books on railways are an abiding delight to 'railwayacs' and the latest, 'Railwaymen's Gallery' (George Allen and Unwin), is well up to standard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
