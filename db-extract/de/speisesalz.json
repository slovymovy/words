                        ],
                        "form": "die Speisesalze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e4aa166-896d-3649-8a80-d593b0378798",
                        "entry_id": "f162bfbc-385c-35f4-8752-7e7a622c41fa",
                        "glosses": [
                            "Salz, welches als Nahrungsmittel vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad75f11c-3df4-4ac7-a323-595fa6a7d90e",
                                "sense_id": "3e4aa166-896d-3649-8a80-d593b0378798",
                                "text": "Für das heutige Mittagessen verwende ich Speisesalz."
                            },
                            {
                                "example_id": "e7d3b070-3a46-4e59-88af-e5e6de21e6c3",
                                "sense_id": "3e4aa166-896d-3649-8a80-d593b0378798",
                                "text": "„Natriumchlorid, besser bekannt als Speisesalz, ist ein lebenswichtiger Nährstoff, denn das darin enthaltene Natrium schützt die Zellen vor Austrocknung und ermöglicht den Nervenzellen erst die Weiterleitung elektrischer Signale.“"
                            },
                            {
                                "example_id": "69521599-851c-4827-8fd0-7839f8688242",
                                "sense_id": "3e4aa166-896d-3649-8a80-d593b0378798",
                                "text": "„Einfaches Speisesalz kann man für wenig Geld im Supermarkt kaufen, Gourmet-Salze wie Fleur de Sel oder Himalaya-Salz dagegen sind deutlich teurer.“"
                            },
                            {
                                "example_id": "13890177-9bad-4b82-90d1-03cbfb4e3565",
                                "sense_id": "3e4aa166-896d-3649-8a80-d593b0378798",
                                "text": "„Bereits [1823] wird mit dem Bau einer Saline begonnen. Die geförderte Sole wird in Siedepfannen zu Speisesalz verarbeitet, ab 1851 nutzt man sie für den Badebetrieb.“"
                            },
                            {
                                "example_id": "1e5d424b-ba00-4faf-9a68-9b223021c0f6",
                                "sense_id": "3e4aa166-896d-3649-8a80-d593b0378798",
                                "text": "„Über jodiertes und fluoriertes Speisesalz kann man einem Mangel dieser beiden wichtigen Mineralien vorbeugen.“"
                            },
                            {
                                "example_id": "b7966152-3b99-44af-9fae-3926b5e07d7b",
                                "sense_id": "3e4aa166-896d-3649-8a80-d593b0378798",
                                "text": "„Die über das Speisesalz zugeführten Mengen an Spurenelementen spielen also eigentlich keine Rolle, wenn man das von der Ernährung her sieht.“"
                            },
                            {
                                "example_id": "4a549daf-24df-435f-96bc-552fbceb41a6",
                                "sense_id": "3e4aa166-896d-3649-8a80-d593b0378798",
                                "text": "„'[Steinsalz ist] ziemlich grau, nicht so weiß und klar, wie man das von Speisesalz so kennt.'“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
