                                    {
                                        "sense_id": "ecaebc24-efa9-32db-a0a9-19b9cc5e8cf5",
                                        "entry_id": "08eebe20-dbaf-38bc-bd98-6e97a2ec3b32",
                                        "glosses": [
                                            "Given to fighting; disposed to engage in combat; pugnacious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514cef25-6a36-4468-8a30-513fce8835f1",
                                                "sense_id": "ecaebc24-efa9-32db-a0a9-19b9cc5e8cf5",
                                                "text": "Their combative conduct leads to many problems."
                                            },
                                            {
                                                "example_id": "eab74242-9cf2-4989-9733-d4bbe494ec08",
                                                "sense_id": "ecaebc24-efa9-32db-a0a9-19b9cc5e8cf5",
                                                "text": "He finds, not “demigods” but “a combative group of exhausted, drunken, broken, petty, partisan, scheming, squabbling, bloviating, sensory-deprived, underoxygenated, fed-up, talked-out, overheated delegates so distraught they threatened violence, secession."
                                            },
                                            {
                                                "example_id": "4ec12ef3-6dbd-4562-bee2-afdebfbd591f",
                                                "sense_id": "ecaebc24-efa9-32db-a0a9-19b9cc5e8cf5",
                                                "text": "Salvation arrived - as it so often has in this nerve-shredding campaign - through Dykes, the combative striker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
