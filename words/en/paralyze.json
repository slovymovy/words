    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13574c0e-1a04-398b-acf7-9941875888c9",
                    "sense_definition": "To make someone or something unable to move or act.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden shock seemed to <w>paralyze</w> him, leaving him unable to speak or move."
                        },
                        {
                            "text": "She was <w>paralyzed</w> with fear when she saw the large spider on the wall."
                        }
                    ],
                    "synonyms": [
                        "immobilize",
                        "freeze"
                    ],
                    "common_phrases": [
                        "paralyzed with fear"
                    ]
                },
                {
                    "sense_id": "3385c1b0-45c2-3bb4-9b21-ed6300072438",
                    "sense_definition": "To cause a system, organization, or process to stop functioning properly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy snowstorm managed to <w>paralyze</w> the entire city for two days."
                        },
                        {
                            "text": "A major computer failure <w>paralyzed</w> the company's operations during the busy morning hours."
                        }
                    ],
                    "synonyms": [
                        "cripple",
                        "disable",
                        "halt"
                    ],
                    "common_phrases": [
                        "paralyze the city",
                        "paralyze operations"
                    ]
                },
                {
                    "sense_id": "8c68b2e5-bacc-37f2-9160-c3eb97f1e03e",
                    "sense_definition": "To cause a loss of muscle function or sensation in a part of the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident was severe enough to <w>paralyze</w> his legs permanently."
                        },
                        {
                            "text": "The disease can <w>paralyze</w> the muscles if it is not treated quickly."
                        }
                    ]
                }
            ]
        }
    ]
