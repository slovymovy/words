                                    {
                                        "sense_id": "8ffe3fd5-43b4-3f90-bbdd-60c559576244",
                                        "entry_id": "7dcd660f-b016-3bbc-b6a7-98a38df8e243",
                                        "glosses": [
                                            "iets dat zich in twee richtingen uitstrekt maar in de derde een beperkte dikte heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e28054-ee17-4a0d-82fc-dad6e19d6b9f",
                                                "sense_id": "8ffe3fd5-43b4-3f90-bbdd-60c559576244",
                                                "text": "Deze laag bevat opvallend veel iridium, dankzij de meteorietinslag van 65 miljoen jaar geleden."
                                            },
                                            {
                                                "example_id": "59be2c42-88a2-4907-8729-f31e5c28d69b",
                                                "sense_id": "8ffe3fd5-43b4-3f90-bbdd-60c559576244",
                                                "text": "Het was een ijskoude nacht en ik werd meerdere malen bibberend wakker. Verbaasd zag ik de volgende ochtend dat er een dun laagje ijs op mijn tent lag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faa5f073-425e-3b3a-9330-318be405b73a",
                                        "entry_id": "7dcd660f-b016-3bbc-b6a7-98a38df8e243",
                                        "glosses": [
                                            "sociale klasse"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "laag",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4a2ba310-fb60-3437-82fb-df03e0274ac7",
                                        "entry_id": "0ab23546-fcfb-37b3-ad98-cd98e37d0fa3",
                                        "glosses": [
                                            "fysiek onder iets zijn; van geringe hoogte zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acfa0d48-74dd-4789-b355-56ed2a350bca",
                                                "sense_id": "4a2ba310-fb60-3437-82fb-df03e0274ac7",
                                                "text": "Ik was altijd gewend in de bergen hoge, leren bergschoenen te dragen maar ditmaal had ik gekozen voor lage trailrunner schoenen die erg licht waren en snel droogden."
                                            },
                                            {
                                                "example_id": "f38d24cd-f5db-48e7-b8c2-da6de72064af",
                                                "sense_id": "4a2ba310-fb60-3437-82fb-df03e0274ac7",
                                                "text": "Op het steile pad kwam ik nog altijd grote sneeuwvelden tegen en op een van de laatste hiervan zag ik in de verte opeens twee meisjes vlak achter elkaar de berg af glijden. Ik schrok me rot, ze kwamen pas 70 meter lager tot stilstand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b47dc22-c6cc-36df-ae76-185a9be7e039",
                                        "entry_id": "0ab23546-fcfb-37b3-ad98-cd98e37d0fa3",
                                        "glosses": [
                                            "niet vergevorderd zijn in een rangorde of volgorde"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e45c2d13-7ce7-3dd4-b9ec-662b7db2540f",
                                        "entry_id": "0ab23546-fcfb-37b3-ad98-cd98e37d0fa3",
                                        "glosses": [
                                            "met een klein aantal trillingen per tijdseenheid"
                                        ],
