                "senses": [
                    {
                        "sense_id": "5bd1ebd0-1ae1-3d48-ab3b-ced0269ed189",
                        "entry_id": "1712c4eb-3ea9-3b22-94e5-f719f8032fe0",
                        "glosses": [
                            "Une de certaines espèces d’euphorbes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28239f02-0424-4186-a2bc-eb06d5fd00ca",
                                "sense_id": "5bd1ebd0-1ae1-3d48-ab3b-ced0269ed189",
                                "text": "L’euphorbe ésule (Euphorbia esula)"
                            },
                            {
                                "example_id": "bc7c115c-cee8-4b67-ac21-3486b15584ac",
                                "sense_id": "5bd1ebd0-1ae1-3d48-ab3b-ced0269ed189",
                                "text": "La grande ésule, euphorbe des marais (Euphorbia palustris)"
                            },
                            {
                                "example_id": "150685e8-e34c-4c4d-8e20-e02351c00893",
                                "sense_id": "5bd1ebd0-1ae1-3d48-ab3b-ced0269ed189",
                                "text": "La petite ésule, euphorbe fluette, euphorbe exiguë, petite euphorbe (Euphorbia exigua)"
                            },
                            {
                                "example_id": "99bd6598-68ce-4b4f-8e51-82a249641f22",
                                "sense_id": "5bd1ebd0-1ae1-3d48-ab3b-ced0269ed189",
                                "text": "L’ésule ronde ou Euphorbia peplus"
                            },
                            {
                                "example_id": "d264f0cc-59b2-47bc-b869-29e9e1682a86",
                                "sense_id": "5bd1ebd0-1ae1-3d48-ab3b-ced0269ed189",
                                "text": "Par contre, on utilisait des variétés d'euphorbiacées appelées tithymales, ancien nom du type euphorbe et réservé aujourd'hui à quelques espèces de ce genre : l'euphorbe cyprès, l’euphorbe exiguë et l’euphorbe des marais ou grande ésule."
                            },
                            {
                                "example_id": "9865392a-d3bf-4974-876a-2375d7825fb4",
                                "sense_id": "5bd1ebd0-1ae1-3d48-ab3b-ced0269ed189",
                                "text": "Orge de muraille, ésule, nerprun alaterne, ivraie qu’on dit margrail en Provence, ce vocabulaire m’enchante. Me reviennent les propos du type du Café de l’Étape un peu plus tôt, il égrenait le nom des simples, je les découvre, tous rassemblées, tétragone, fruits rouges, lentilles, ciboulettes, orties, hysope et sarriette du pas gavot."
                            }
                        ]
                    }
