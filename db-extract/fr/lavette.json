        "fr-extract.jsonl": [
            {
                "entry_id": "d29e36c4-132e-3831-a6bd-523bdf1ecce6",
                "word": "lavette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "46e7a734-e0a7-479e-8d55-16d21b7e300f",
                        "entry_id": "d29e36c4-132e-3831-a6bd-523bdf1ecce6",
                        "tags": [
                            "plural"
                        ],
                        "form": "lavettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f847b0f-9ed0-353e-b0ca-068d04e51a4f",
                        "entry_id": "d29e36c4-132e-3831-a6bd-523bdf1ecce6",
                        "glosses": [
                            "Petit morceau de linge, torchon ou sorte de pinceau garni de gros fils dont on se sert pour laver la vaisselle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3980ad86-7a6f-4ac6-a331-cd85cb9e3e53",
                                "sense_id": "3f847b0f-9ed0-353e-b0ca-068d04e51a4f",
                                "text": "Ce disant, il m’a tendu quatre doigts, mous comme une vieille lavette."
                            }
                        ]
                    },
                    {
                        "sense_id": "f19a335f-7775-30b0-b971-cbe22dce60e3",
                        "entry_id": "d29e36c4-132e-3831-a6bd-523bdf1ecce6",
                        "glosses": [
                            "Individu sans énergie, sans courage."
                        ],
                        "tags": [
                            "figuratively",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "db642d9a-2700-4657-b99e-16749fb6b55c",
                                "sense_id": "f19a335f-7775-30b0-b971-cbe22dce60e3",
                                "text": "Ce garçon est une vraie lavette."
                            },
                            {
                                "example_id": "d7ba08ec-829f-4162-bc75-a93a0d48674d",
                                "sense_id": "f19a335f-7775-30b0-b971-cbe22dce60e3",
                                "text": "Vous ne ferez jamais rien au théâtre avec ce tempérament de lavette !"
                            },
                            {
                                "example_id": "3e3de83a-999a-4df5-bd79-1ee202fd3037",
                                "sense_id": "f19a335f-7775-30b0-b971-cbe22dce60e3",
                                "text": "Au moins, vous avez de la trempe. Pas comme votre prédécesseur. Je ne l’ai jamais dit mais c’était une lavette."
                            },
                            {
                                "example_id": "3309261d-96cf-4013-afb7-59c2285a448a",
                                "sense_id": "f19a335f-7775-30b0-b971-cbe22dce60e3",
                                "text": "Tu connais la différence entre une lavette et un type comme moi ? Ta maman !"
                            }
                        ]
                    },
                    {
                        "sense_id": "006babd4-f9ac-3286-b711-11c12b6c71f6",
                        "entry_id": "d29e36c4-132e-3831-a6bd-523bdf1ecce6",
                        "glosses": [
                            "Gant de toilette."
                        ],
                        "tags": [
                            "Suisse",
                            "Alsace",
                            "Franche-Comté",
                            "Ardèche"
                        ],
                        "examples": [
                            {
                                "example_id": "f5ca8432-eb99-495b-af0c-f45cbb204575",
                                "sense_id": "006babd4-f9ac-3286-b711-11c12b6c71f6",
                                "text": "Ah ces réveils, l’atroce migraine, la gueule pâteuse —j’avais presque toujours bu la veille— la chambre de bain inconnue aux odeurs fétides, la fausse familiarité de la lavette et de la brosse à dents de la dame, les quatre aspirines."
                            }
                        ]
                    },
                    {
                        "sense_id": "17374d0d-6b4a-3706-85c2-cee6d31a7334",
                        "entry_id": "d29e36c4-132e-3831-a6bd-523bdf1ecce6",
                        "glosses": [
                            "Langue."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b8e92d1-f4ef-41af-8730-c92d943dbc2f",
                        "source_entry_id": "d29e36c4-132e-3831-a6bd-523bdf1ecce6",
                        "source_sense_id": "3f847b0f-9ed0-353e-b0ca-068d04e51a4f",
