                        "form": "hydrophobies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac92fa55-97db-3519-8073-f215c2df65e3",
                        "entry_id": "8d728023-df2d-35be-b1b2-a0490f29d3b2",
                        "glosses": [
                            "Peur morbide de l'eau et des autres liquides, aquaphobie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e28ef97-9e1d-4685-acad-c5762c948050",
                                "sense_id": "ac92fa55-97db-3519-8073-f215c2df65e3",
                                "text": "L’hydrophobie avait sans doute atteint sa dernière période chez tous les Bretons venus à l’assemblée, car, malgré ses vertus mirifiques, ils laissaient le ruisseau désert entre les deux vieilles femmes qui le gardaient."
                            },
                            {
                                "example_id": "3b829660-ad91-4733-a223-b27c3211f7c0",
                                "sense_id": "ac92fa55-97db-3519-8073-f215c2df65e3",
                                "text": "L'hydrophobie est un symptôme de la rage."
                            }
                        ]
                    },
                    {
                        "sense_id": "72231301-7d51-3191-bc99-f8fdfb93f726",
                        "entry_id": "8d728023-df2d-35be-b1b2-a0490f29d3b2",
                        "glosses": [
                            "Maladie de la rage."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c0432820-5f39-4369-80ab-3c0d445fd956",
                                "sense_id": "72231301-7d51-3191-bc99-f8fdfb93f726",
                                "text": "Mais ces distinctions hypothétiques sont dépourvues de fondement solide, et après avoir beaucoup varié sur la classification de l’hydrophobie, presque tout restait encore à faire pour la bien connaître."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ab7a3b9-5d52-383a-b00a-6826018edeeb",
                        "entry_id": "8d728023-df2d-35be-b1b2-a0490f29d3b2",
                        "glosses": [
                            "Caractéristique de composants ne pouvant se lier aux molécules d’eau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5442009d-0cfe-378e-9c10-b1764c5a8f51",
                        "entry_id": "8d728023-df2d-35be-b1b2-a0490f29d3b2",
                        "glosses": [
                            "Caractéristique des matériaux qui semblent repousser l’eau, des matériaux non mouillables."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b0f0642-4e17-41c8-af66-e450fd28ddb4",
                        "source_entry_id": "8d728023-df2d-35be-b1b2-a0490f29d3b2",
                        "target_lang_word": "Wasserscheu",
