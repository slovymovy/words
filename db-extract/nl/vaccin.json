                                        "sense_id": "0f293822-1620-313a-8417-b48da1d2ce3d",
                                        "entry_id": "8dc41966-745d-3246-8a2a-b3cdc69c40e1",
                                        "glosses": [
                                            "Of, pertaining to, caused by, or characteristic of cowpox."
