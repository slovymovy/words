    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ecbdff4-0184-3d9c-b5b8-cca6ef610b1f",
                    "sense_definition": "Troubled or irritated by something unwanted or unliked.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Judy is <w>annoyed</w> at Jim because he forgot to put the bins out again.",
                            "target_lang_translations": {
                                "ru": "Джуди <w>раздражена</w> на Джима, потому что он снова забыл выставить мусорные баки.",
                                "nl": "Judy is <w>geïrriteerd</w> door Jim omdat hij weer vergeten is de vuilnisbakken buiten te zetten.",
                                "pl": "Judy jest <w>zirytowana</w> na Jima, ponieważ znowu zapomniał wystawić kosze na śmieci.",
                                "de": "Judy ist <w>verärgert</w> über Jim, weil er schon wieder vergessen hat, die Mülltonnen rauszustellen."
                            }
                        },
                        {
                            "text": "He gets <w>annoyed</w> when people talk loudly on the bus.",
                            "target_lang_translations": {
                                "ru": "Он <w>раздражается</w>, когда люди громко разговаривают в автобусе.",
                                "nl": "Hij wordt <w>geërgerd</w> als mensen hard praten in de bus.",
                                "pl": "On <w>irytuje się</w>, gdy ludzie głośno rozmawiają w autobusie.",
                                "de": "Er ist <w>genervt</w>, wenn Leute im Bus laut reden."
                            }
                        }
                    ],
                    "synonyms": [
                        "irritated",
                        "bothered",
                        "vexed",
                        "irked",
                        "upset",
                        "cross"
                    ],
                    "antonyms": [
                        "pleased"
                    ],
                    "common_phrases": [
                        "get annoyed",
                        "annoyed with someone",
                        "annoyed at something",
                        "look annoyed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий раздражение или недовольство чем-либо нежелательным.",
                        "nl": "Iemand die zich ergert of ontevreden is door iets ongewensts of vervelends.",
                        "pl": "Odczuwający irytację, zniecierpliwienie lub niezadowolenie z powodu czegoś niechcianego lub irytującego.",
                        "de": "Sich über etwas Unerwünschtes oder Unangenehmes ärgern oder irritiert fühlen."
                    },
                    "translations": {
                        "ru": [
                            {
