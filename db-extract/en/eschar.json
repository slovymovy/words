                    {
                        "translation_id": "4acab123-13b9-477f-b5cb-597601045e11",
                        "source_entry_id": "e0f22f66-dd2e-36b5-81f8-884e4d462006",
                        "source_sense_description": "dry dark scab or scar — see also scab",
                        "target_lang_word": "Kruste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kruste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3895b1bf-8fa4-349c-b6be-35cfb90a933a",
                                        "entry_id": "2dd8a635-aed2-3df2-b0be-a0f80079ad87",
                                        "glosses": [
                                            "feste, harte Schicht auf einem weichen Körper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d105160-a6c3-4320-baec-d95dd6f8abac",
                                                "sense_id": "3895b1bf-8fa4-349c-b6be-35cfb90a933a",
                                                "text": "Ein gutes Brot hat eine knusprige Kruste."
                                            },
                                            {
                                                "example_id": "7aab5f10-4603-4afd-9f9d-9f61b1fd9943",
                                                "sense_id": "3895b1bf-8fa4-349c-b6be-35cfb90a933a",
                                                "text": "„Außen eine knusprige Kruste, innen ein weicher Teig: So muss Brot für die meisten schmecken.“"
                                            },
                                            {
                                                "example_id": "e623ac5b-2418-4cd6-b455-533c74d709a0",
                                                "sense_id": "3895b1bf-8fa4-349c-b6be-35cfb90a933a",
                                                "text": "Über der Wunde hat sich eine Kruste aus Schorf gebildet."
                                            },
                                            {
                                                "example_id": "54c844a3-6b1f-4e0f-9bd9-e132ab9ea17d",
                                                "sense_id": "3895b1bf-8fa4-349c-b6be-35cfb90a933a",
                                                "text": "„Auf der Haut der Kinder hat Schmutz harte Krusten gebildet.“"
