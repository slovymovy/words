                "senses": [
                    {
                        "sense_id": "e077fcef-1191-32c9-8381-1c9d4f085666",
                        "entry_id": "179bde3c-9300-31b7-b85c-afb0dc8c5108",
                        "glosses": [
                            "Bundesland in Deutschland, das kein Stadtstaat ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e7202b-769f-4424-b2cf-733a84eacbfc",
                                "sense_id": "e077fcef-1191-32c9-8381-1c9d4f085666",
                                "text": "„In Brandenburg dürfen Jugendliche künftig schon mit 16 Jahren zur Wahl gehen. Einer Änderung des entsprechenden Gesetzes stimmten heute die Abgeordneten im Landtag mehrheitlich zu. […] Erstmals in einem Flächenland haben damit junge Leute ab 16 Wahlrecht auf Landesebene.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "878d7234-d5c8-3aba-a0ed-81d8ecf61e51",
                        "entry_id": "179bde3c-9300-31b7-b85c-afb0dc8c5108",
                        "glosses": [
                            "Staat mit einer sehr geringen Bevölkerungsdichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f23fc6fb-931d-4d28-ba91-f431ac102727",
                                "sense_id": "878d7234-d5c8-3aba-a0ed-81d8ecf61e51",
                                "text": "„In einem Flächenland, das die Freiheit der afrikanischen Weite feierte, war jedes größere Wohngebäude von Mauern umgeben, jedes Haus eine Festung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
