{
    "word_family": [
        "estompe",
        "estompage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a348241-774b-3063-a540-c4c24a95f34b",
                    "sense_definition": "Perdre de sa netteté, s'effacer ou diminuer progressivement en intensité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec les années qui passent, ses précieux souvenirs d'enfance commencent à s'<w>estomper</w>."
                        },
                        {
                            "text": "La douleur de cette blessure s'<w>estompe</w> enfin après plusieurs semaines de repos complet."
                        }
                    ],
                    "synonyms": [
                        "s'atténuer",
                        "s'effacer",
                        "faiblir"
                    ],
                    "common_phrases": [
                        "s'estomper avec le temps",
                        "souvenirs qui s'estompent"
                    ]
                },
                {
                    "sense_id": "31474eb1-0bf6-3d79-8f9d-add4024efdba",
                    "sense_definition": "Atténuer ou adoucir quelque chose afin d'en diminuer la rigueur ou l'effet marquant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attenuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a tenté d'<w>estomper</w> les désaccords lors de sa déclaration publique."
                        },
                        {
                            "text": "Ces mesures diplomatiques devraient permettre d'<w>estomper</w> les tensions entre les deux pays voisins."
                        }
                    ],
                    "synonyms": [
                        "atténuer",
                        "adoucir",
                        "tempérer"
                    ],
                    "antonyms": [
                        "accentuer",
                        "souligner",
                        "renforcer"
                    ],
                    "common_phrases": [
                        "estomper les différences",
                        "estomper les tensions"
                    ]
                },
                {
                    "sense_id": "7905d603-3ff2-3cfc-bbb6-e28c9700a349",
                    "sense_definition": "Rendre des formes ou des contours visuellement flous et imprécis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une brume matinale très dense est venue <w>estomper</w> les silhouettes des arbres au loin."
                        },
                        {
                            "text": "Cette crème hydratante promet d'<w>estomper</w> les petites rides autour des yeux dès la première semaine."
                        }
                    ],
                    "synonyms": [
                        "brouiller",
                        "voiler",
                        "flouter"
                    ],
                    "antonyms": [
                        "préciser"
                    ],
                    "common_phrases": [
                        "estomper les contours",
                        "estomper les rides"
                    ]
                },
                {
                    "sense_id": "59583ac6-ca17-3b9b-9675-8c5f87a92707",
                    "sense_definition": "Frotter et étaler les traits d'un dessin au fusain ou au pastel pour créer des dégradés fondus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dessin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste utilise un chiffon doux pour <w>estomper</w> le fusain et créer une ombre réaliste."
                        },
                        {
                            "text": "Il a appris à <w>estomper</w> les lignes au crayon afin d'obtenir un rendu velouté."
                        }
                    ],
                    "common_phrases": [
                        "estomper au doigt",
                        "estomper un trait"
                    ]
                }
            ]
        }
    ]
}