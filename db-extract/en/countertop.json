                                    {
                                        "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                        "entry_id": "7e560585-32a5-3b37-973d-67d2b5a11c5c",
                                        "glosses": [
                                            "werkblad van een keuken dat water-, hitte- en krasbestendig is en makkelijk schoon te maken is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16af972b-1167-4910-be5d-de8ac571457a",
                                                "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                                "text": "De keuken is niet groot: de met witte glasplaten afdekbare Smev-kookplaat en spoelbak nemen vrijwel het hele aanrecht in beslag. Een uitklapbare aanrechtverlenger biedt wat meer werkruimte, maar beperkt de doorstap naar buiten. Onder het aanrechtblad zijn drie grote treklades gemonteerd met soft-close."
                                            },
                                            {
                                                "example_id": "9a21b951-81c9-4ad0-89aa-9c44491bd5ee",
                                                "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                                "text": "Rudolph is naar eigen zeggen het gelukkigst als hij aan het koken is. Daarom heeft de zitkamer in zijn woning in Hilversum plaats moeten maken voor een enorme keuken, met een aanrechtblad van ruim tien meter."
                                            },
                                            {
                                                "example_id": "c7eeff6b-ce47-41da-acd3-b654636d28f0",
                                                "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                                "text": "Ik ga naar de keuken, leun tegen het aanrechtblad en adem een paar keer diep in en uit."
                                            },
                                            {
                                                "example_id": "ed63cb8f-72a6-4847-ab6a-72007d5b1f97",
                                                "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                                "text": "Vanuit mijn ooghoeken zie ik het halve aanrechtblad vol staan met vuile vaat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2455bb4-d469-4c23-b350-1ca2430b274f",
                        "source_entry_id": "13e9eca4-cb23-3dcd-9d85-804709497a8b",
                        "source_sense_id": "5c747314-a2e9-3c97-ad6a-73f9d9262d6f",
                        "source_sense_description": "The top surface of a counter, for preparation of food",
                        "target_lang_word": "aanrecht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aanrecht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                        "entry_id": "6aecea57-5ef2-328e-9e02-0cc9fa5dc5f2",
                                        "glosses": [
                                            "vaste tafel met kastjes langs keukenwand voorzien van een waterbestendig aanrechtblad"
                                        ],
                                        "tags": [
                                            "huishouden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a55ddd-338d-4679-87fa-64e6a79a2153",
                                                "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                                "text": "De afwas van gisteren stond nog op het aanrecht."
                                            },
                                            {
                                                "example_id": "7cf5a6c7-92c3-48ff-b9e4-b81f65ff4d35",
                                                "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                                "text": "Het enige recht van de huisvrouw was vroeger het aanrecht."
                                            },
                                            {
                                                "example_id": "6250eb79-d1ca-4758-bc99-20582480c7c4",
                                                "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                                "text": "‘Volgende ronde,’ zei ze met een scheve grijns op haar gezicht en ze zette beide borden op het aanrecht."
                                            },
                                            {
                                                "example_id": "0bf622f8-13bb-4d2c-8850-56d5fad36122",
                                                "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                                "text": "Hij staat zuchtend op en loopt naar de keuken die blauw ziet van de sigarettenrook. Meryem staat tegen het aanrecht en kijkt hem scherp aan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aanrecht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3dee3e26-ebcd-3e49-81c8-9428469fac55",
                                        "entry_id": "45697290-3d31-3596-a538-ef909016d123",
