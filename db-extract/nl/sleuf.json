                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3aefbfb1-9a15-3af8-b0a5-6c6ebeaf3690",
                                        "entry_id": "ce157ac3-9a1e-3e8e-a285-30261b0c8d41",
                                        "glosses": [
                                            "A fort or castle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f86285-6dcb-49a1-9dad-0d7ac495bd67",
                                                "sense_id": "3aefbfb1-9a15-3af8-b0a5-6c6ebeaf3690",
                                                "text": "Thou paydst for building of a slot,\nThat wrought thine own decay."
                                            }
                                        ]
                                    }
                                ]
