                                    {
                                        "sense_id": "bc4bb774-9a8a-320a-a08c-f56428b681aa",
                                        "entry_id": "9b4816d8-eb72-3420-ba64-24c907281469",
                                        "glosses": [
                                            "Placed higher than usual. (of a steam locomotive boiler)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c976049b-cda3-454b-83b3-d61434ca230e",
                                                "sense_id": "bc4bb774-9a8a-320a-a08c-f56428b681aa",
                                                "text": "The 2-6-2s have very high-pitched boilers in order that the grate shall clear the radial axle and also the trailing coupled wheels."
                                            }
                                        ]
