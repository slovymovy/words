                "senses": [
                    {
                        "sense_id": "45bd16f2-15cc-361c-9dd8-4c8f6be6247e",
                        "entry_id": "5dd0a525-d022-3e75-b8c6-adc9ac528236",
                        "glosses": [
                            "Enlever une carrosserie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b82d8c-a579-43a8-a5f9-ce042858e6c2",
                                "sense_id": "45bd16f2-15cc-361c-9dd8-4c8f6be6247e",
                                "text": "Notre intention est de décarrosser, de refaire toutes les stations souterraines en nouveau style céramique."
                            },
                            {
                                "example_id": "43ffd234-6635-4bd0-a660-927a5dcf6956",
                                "sense_id": "45bd16f2-15cc-361c-9dd8-4c8f6be6247e",
                                "text": "Vian est, en effet, un écrivain qui vous montre une Rolls Royce, puis qui soulève le capot et on découvre un moteur de 2 CV. Comme il veut décarrosser les choses, j’ai insisté sur la carrosserie."
                            }
                        ]
                    },
                    {
                        "sense_id": "e695e02b-8ec5-3087-a384-c91ec7698b03",
                        "entry_id": "5dd0a525-d022-3e75-b8c6-adc9ac528236",
                        "glosses": [
                            "Séparer les semences du coton, en faisant passer le coton brut entre deux cylindres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01e283c6-6856-47b8-bff2-1765bf7ad490",
                                "sense_id": "e695e02b-8ec5-3087-a384-c91ec7698b03",
                                "text": "Une personne décarrosse en un jour 4 arrobes de coton brut, qui rend environ 1 arrobe de coton."
                            }
                        ]
                    }
                ],
