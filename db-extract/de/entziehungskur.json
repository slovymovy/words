                "senses": [
                    {
                        "sense_id": "77c9b7c3-3281-3f59-aa44-69e487e6346b",
                        "entry_id": "d2fe2d78-ab7c-36a4-ab2c-9616bcce8f4b",
                        "glosses": [
                            "eine Therapie, um eine Person von einer Sucht zu heilen"
                        ],
                        "tags": [
                            "Behandlung"
                        ],
                        "examples": [
                            {
                                "example_id": "4f600dda-2eab-4508-8364-6dfe9a242a8d",
                                "sense_id": "77c9b7c3-3281-3f59-aa44-69e487e6346b",
                                "text": "„Wer wissentlich einem anderen, der auf Grund behördlicher Anordnung oder ohne seine Einwilligung zu einer Entziehungskur in einer Anstalt untergebracht ist, ohne Erlaubnis des Anstaltsleiters oder seines Beauftragten alkoholische Getränke oder andere berauschende Mittel verschafft oder überläßt oder ihn zum Genuß solcher Mittel verleitet, wird mit Freiheitsstrafe bis zu einem Jahr oder mit Geldstrafe bestraft.“"
                            },
                            {
                                "example_id": "d18283f5-7df1-4c61-ad74-e2ebe9e18e14",
                                "sense_id": "77c9b7c3-3281-3f59-aa44-69e487e6346b",
                                "text": "„Weil die erste Entziehungskur nichts genutzt hatte, sollte er eine zweite machen, aber dazu ist es nicht mehr gekommen.“"
                            },
                            {
                                "example_id": "d4da51d6-5719-40b6-ad87-2f349b5b6cf9",
                                "sense_id": "77c9b7c3-3281-3f59-aa44-69e487e6346b",
                                "text": "„Eine gemeinsame Entziehungskur ist geplant.“"
                            },
                            {
                                "example_id": "55011382-3220-418b-af02-9031f7bc6e68",
                                "sense_id": "77c9b7c3-3281-3f59-aa44-69e487e6346b",
                                "text": "„Manche haben mir gesagt, jetzt helfe nur noch eine Entziehungskur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
