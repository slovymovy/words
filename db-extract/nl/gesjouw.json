                        "examples": [
                            {
                                "example_id": "63e3200e-dfce-49e8-87a3-6d70394b1790",
                                "sense_id": "8fe12721-8088-3e2b-bb30-0841191bf114",
                                "text": "Je hoeft je buggy in de regel pas bij het aan boord gaan, dus bij de gate, af te geven. Dat scheelt natuurlijk veel onnodig gesjouw."
                            },
                            {
                                "example_id": "94695985-7ce4-49c7-abde-4f24407fcc7e",
                                "sense_id": "8fe12721-8088-3e2b-bb30-0841191bf114",
                                "text": "Dus mensen, dit jaar geen oorlogsstrepen op, geen pols, knie- of scheenbeschermers meer omdat we naar het winkelcentrum moeten, geen zweetdruppels meer op het voorhoofd, geen ongepaste woede en drift aanvallen of gesjouw met onnodig veel tassen. Lang leven het online winkelcirquit"
                            }
                        ]
                    }
