                        "entry_id": "7472b7f0-fbb3-386e-99db-a885bc82cd36",
                        "glosses": [
                            "Capture d’un objet spatial par un astre au cours de laquelle le freinage de l’objet par l’atmosphère de l’astre joue un rôle prépondérant."
                        ],
                        "tags": [
                            "Mécanique du vol-Mécanique spatiale"
                        ],
                        "examples": [
                            {
                                "example_id": "4025763b-5718-4def-8adc-40617fe5e29d",
                                "sense_id": "194ae90c-d11e-3b2a-862a-9f94937c58c7",
                                "text": "Pendant ce temps, l’orbiteur devra réaliser l’une des phases les plus critiques de sa mission : la mise en orbite par aérocapture."
                            },
                            {
                                "example_id": "e8ad1434-227a-4d36-94c3-deac582a4ccb",
                                "sense_id": "194ae90c-d11e-3b2a-862a-9f94937c58c7",
                                "text": "Les étapes critiques, comme l’entrée de la sonde dans l’atmosphère (aérocapture), le lancement de la précieuse cargaison depuis le sol martien et sa récupération par l’orbiteur, doivent être validées."
                            }
                        ]
                    }
