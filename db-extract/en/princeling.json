                "senses": [
                    {
                        "sense_id": "14922264-ea98-33a6-a5b5-48a17a2802da",
                        "entry_id": "3cb4715d-9095-3b03-8130-ec645d51fcf8",
                        "glosses": [
                            "A minor or less important prince."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4685b46-321e-436f-aa59-85d42c9f71e6",
                                "sense_id": "14922264-ea98-33a6-a5b5-48a17a2802da",
                                "text": "Spices reached Europe after being carried over the Asiatic caravan routes by the Radanite merchants, to be re-distributed among traders and apothecaries, pilgrims and princelings."
                            },
                            {
                                "example_id": "def94eb6-f970-4baa-8c33-3970808895bf",
                                "sense_id": "14922264-ea98-33a6-a5b5-48a17a2802da",
                                "text": "Speaking of the guest list, though, it is most disappointing to find some of the third tier European princelings unable to hide their bitterness at being NFI."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e239064-52f7-3c3a-8a9c-4c2a357816d3",
                        "entry_id": "3cb4715d-9095-3b03-8130-ec645d51fcf8",
                        "glosses": [
                            "A descendant of some prominent and influential senior communist official in the People's Republic of China."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af4c374f-2f77-408d-b1d4-7c94d0987be5",
                        "source_entry_id": "3cb4715d-9095-3b03-8130-ec645d51fcf8",
                        "source_sense_description": "a minor or unimportant prince",
                        "target_lang_word": "Fürstchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fürstchen",
