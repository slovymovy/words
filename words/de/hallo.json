                    "semantic_group_id": "begruessung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hallo</w>, bist du noch in der Leitung oder ist die Verbindung unterbrochen?"
                        },
                        {
                            "text": "Sie nahm den Hörer ab und sagte leise: „<w>Hallo</w>, wer spricht dort?“"
