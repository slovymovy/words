                        "glosses": [
                            "Temps qui s’écoule depuis le souper jusqu’au coucher."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f17b0775-6700-4075-84c2-97f02da8f18a",
                                "sense_id": "79b043b5-2d1d-3f36-9f4b-353fa4ad62ef",
                                "text": ".., trois fois de la semaine, les deux amis qui ne paraissaient jamais qu’alors, se réunissaient, soupaient avec nous, se livraient à leurs plaisirs, l’un devant l’autre, deux ou trois heures de l'après-souper, et allaient de-là finir le reste de la nuit chacun avec la sienne, dans son appartement, qui devenait le nôtre le reste du temps…."
                            },
                            {
                                "example_id": "306f5514-48d4-4c19-bfcb-cf753771d7ac",
                                "sense_id": "79b043b5-2d1d-3f36-9f4b-353fa4ad62ef",
                                "text": "Une foule de traits originaux qu'on dirait recueillis dans le cabinet du lieutenant de police Sartines ou Lenoir, pour amuser les après-soupers de Louis XV."
                            }
                        ]
                    }
