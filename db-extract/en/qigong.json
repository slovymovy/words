                "entry_id": "27201964-eaa0-3c5c-a12e-4c076f1b0321",
                "word": "qigong",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dba3830e-97b2-437c-a8a4-5f9a12285257",
