                        "sense_id": "13e16d4c-7c94-3430-a3c5-62a5ed4bdd08",
                        "entry_id": "9fb6b799-d930-32ab-9f2f-e18f8bfed9d0",
                        "glosses": [
                            "Compulsion à collectionner, à amasser des objets de collection."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2dd9f547-81b6-4193-87c2-08430773f021",
                                "sense_id": "13e16d4c-7c94-3430-a3c5-62a5ed4bdd08",
                                "text": "Les collectionneurs se répartissent entre ceux qui sont placard (amassant des objets d'art pour leur seul plaisir) et ceux qui sont vitrine (exhibant leurs trouvailles) mais tous ont la collectionnite aigüe."
                            },
                            {
                                "example_id": "4128b0cd-9df1-4d1d-b59f-7eabb8ca11e5",
                                "sense_id": "13e16d4c-7c94-3430-a3c5-62a5ed4bdd08",
                                "text": "A l’origine certains contractent cette maladie bénigne, assez commune chez les jeunes et même des moins jeunes, qu’on appelle familièrement la « collectionnite »."
                            }
                        ]
                    }
                ],
