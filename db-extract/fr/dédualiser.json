                "senses": [
                    {
                        "sense_id": "1cef1ef4-34e0-3abc-84b5-4622c1067bca",
                        "entry_id": "cb6b36b9-d11c-3a74-9810-185fad02b4e3",
                        "glosses": [
                            "Faire perdre son caractère dual à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970f77ad-f190-493d-b2af-8ec44fee3c9e",
                                "sense_id": "1cef1ef4-34e0-3abc-84b5-4622c1067bca",
                                "text": "On peut ainsi dire qu’à Thomas, l’augustinisme permet de dédualiser l’aristotélisme."
                            },
                            {
                                "example_id": "6261481a-cfcc-4668-b300-3eb0760f509c",
                                "sense_id": "1cef1ef4-34e0-3abc-84b5-4622c1067bca",
                                "text": "J’ai tout de même un petit faible pour le second qui réunit (j’ai presque envie de dire qui « dédualise ») les deux triangles isiaques en un seul rectangle."
                            },
                            {
                                "example_id": "0203b459-72c3-4ad7-845c-86d963adfd08",
                                "sense_id": "1cef1ef4-34e0-3abc-84b5-4622c1067bca",
                                "text": "La nécessité pour l'égo de rencontrer des barrières, déterminera sa capacité à les dédualiser."
                            }
                        ]
                    }
                ],
