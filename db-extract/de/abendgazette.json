                "senses": [
                    {
                        "sense_id": "6d8ab912-0210-3a98-81c0-04ee99a60c31",
                        "entry_id": "62862bb0-26d8-3c8b-8aeb-cd6f196309ef",
                        "glosses": [
                            "Zeitung, die vorwiegend über aktuelle Ereignisse berichtet und meist am späten Nachmittag oder Abend erscheint"
                        ],
                        "tags": [
                            "historical",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "642c65a6-0329-4946-9a5d-8659a4184f49",
                                "sense_id": "6d8ab912-0210-3a98-81c0-04ee99a60c31",
                                "text": "„Außerdem sind sie sensationslüstern wie Reporter bei einer gewissen Abendgazette.“"
                            },
                            {
                                "example_id": "ba680fbf-4b74-495f-8023-5094ff73b9ca",
                                "sense_id": "6d8ab912-0210-3a98-81c0-04ee99a60c31",
                                "text": "„In der Abendgazette rühmt der Musikkritiker sachverständig ihr perfekt synchrones Duette.“"
                            },
                            {
                                "example_id": "6e9c8804-c06c-433b-b871-075362320549",
                                "sense_id": "6d8ab912-0210-3a98-81c0-04ee99a60c31",
                                "text": "„[…] ist zusätzlich präsent durch ständiges Fotoblitzlicht und durch die Titelseiten der Abendgazette .“"
                            },
                            {
                                "example_id": "21820349-9dc6-4ac0-8c75-4599e3fd7dd1",
                                "sense_id": "6d8ab912-0210-3a98-81c0-04ee99a60c31",
                                "text": "„Die Zahl der Dampfboote, die an einem Tage des Juli 1839 in dem Hafen lagen, war nach der Abend-Gazette, nicht geringer als 46, und ihr Tonnengehalt nahe an 8000.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
