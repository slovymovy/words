                "senses": [
                    {
                        "sense_id": "c61345c9-61ee-3065-be70-b3d9d96e50cd",
                        "entry_id": "8dc8451d-1d97-3b55-92e4-ffa9bb304adb",
                        "glosses": [
                            "To accuse wrongly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd10406-79d0-4b53-b1a2-f5dcbbe438eb",
                                "sense_id": "c61345c9-61ee-3065-be70-b3d9d96e50cd",
                                "text": "I hold no brief for any disloyal person or persons that there is even any question about. but I say, let us be careful not to misaccuse or misjudge anyone."
                            },
                            {
                                "example_id": "3173ae51-34a2-41ff-9198-56f89264da78",
                                "sense_id": "c61345c9-61ee-3065-be70-b3d9d96e50cd",
                                "text": "Naipaul commits the very sin of which he misaccuses the Indian novelists: the form of his work entails the worth of human life, while the infused vision denies it."
                            },
                            {
                                "example_id": "0f1f59be-03bb-4fcf-b55a-09266556f302",
                                "sense_id": "c61345c9-61ee-3065-be70-b3d9d96e50cd",
                                "text": "To calumniate is to accuse falsely with the perlocutionary intention to mislead and \"misaccuse\""
                            },
                            {
                                "example_id": "397ad0cb-ae28-44ea-8b49-77400410c102",
                                "sense_id": "c61345c9-61ee-3065-be70-b3d9d96e50cd",
                                "text": "To misaccuse the Basques was something the Spanish people could not abide, and they switched their vote to the socialists."
                            }
                        ]
                    }
