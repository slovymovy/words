                                            {
                                                "example_id": "5d39e9f6-7928-4c23-a2fc-83b4754f1879",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "[…]the best thing to do is to curl up with a good goose-flesher and try to forget, and fortunately I had packed among my effects one called Murder at Greystone Grange."
                                            },
                                            {
                                                "example_id": "1037c556-c8bd-4cd6-bba2-8aa144f3081b",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Fortunately — very fortunately — the American people have a happy alternative to this bankrupt Republican campaign and its captive candidate."
                                            },
                                            {
                                                "example_id": "a93892a8-c294-43a4-a9d6-2ca40276299a",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Most pitchside medical staff fortunately will never have to treat a life threatening injury on the field of play."
                                            },
                                            {
                                                "example_id": "4c169188-4b0a-4a54-8ef8-0055e910f8da",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Fortunately for the noncampers, half of the hotel rooms overlook the seaside stage, making attendance almost automatic, and very convenient in bad weather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65988a84-a29c-4734-af27-2b7acfa0ac82",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "884c5e26-e52c-3063-9fa7-5a566f7e3fbb",
                        "target_lang_word": "luckily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luckily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4340cc60-1250-36ef-9cdd-c5b521f1985d",
                                        "entry_id": "684e9b28-c5f4-31b6-9afc-bc0d2405e891",
                                        "glosses": [
                                            "In a lucky manner; by good fortune; fortunately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3703a44-eba6-4f1f-8de0-f37f00190916",
                                                "sense_id": "4340cc60-1250-36ef-9cdd-c5b521f1985d",
                                                "text": "They luckily escaped injury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c81f0346-9791-493f-8e09-cb9bb70c7803",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "884c5e26-e52c-3063-9fa7-5a566f7e3fbb",
                        "target_lang_word": "mercifully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mercifully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f65340e-aa19-3cb7-bed5-05aecd924fd3",
                                        "entry_id": "8d316749-4df4-3824-b584-e2aa0afe70a2",
                                        "glosses": [
                                            "In a merciful manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94ba68ef-9627-3a68-a4f1-512343b235a6",
                                        "entry_id": "8d316749-4df4-3824-b584-e2aa0afe70a2",
                                        "glosses": [
                                            "Thankfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78de9eee-116e-4242-8801-98592187f055",
                                                "sense_id": "94ba68ef-9627-3a68-a4f1-512343b235a6",
                                                "text": "The whole Planet of the Apes set-up has been ripe for metaphor – from slavery and Afro-American revolution to European conquest of the Americas, even the war on terror. But mercifully, there's no big subtext being troweled on here."
                                            },
                                            {
                                                "example_id": "f070ecba-76de-4ac8-8d88-c1be919d3876",
                                                "sense_id": "94ba68ef-9627-3a68-a4f1-512343b235a6",
                                                "text": "The fruits of these kickstarted endeavors began to show in 1915, first in the deployment of a new range of depth charges. These were, mercifully, smaller than Jellicoe's \"crushing hand of God\" prototype, and, whilst practically just as lethal to submarines, they were significantly less risky to the launching ship, and could also be carried in larger numbers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec1225e9-a2c4-4d10-b124-40cb2ea90f8e",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "884c5e26-e52c-3063-9fa7-5a566f7e3fbb",
                        "target_lang_word": "thankfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thankfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                                        "entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                                        "glosses": [
                                            "In a thankful manner; giving thanks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ee3ae6-5930-4776-9f7c-d649897dc3f4",
                                                "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                                                "text": "Gratiano:\n[…]I owe you much, and, like a wilful youth\nThat which I owe is lost; but if you please\nTo shoot another arrow that self way\nWhich you did shoot the first, I do not doubt,\nAs I will watch the aim, or to find both,\nOr bring your latter hazard back again,\nAnd thankfully rest debtor for the first."
                                            },
                                            {
                                                "example_id": "2d3ae19a-58c4-44e6-873e-c3c57c5a86dc",
                                                "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                                                "text": "I immediately offered my assistance to the unhappy person, who thankfully accepted it, and, putting himself under my conduct, begged me to convey him to some tavern, where he might send for a surgeon […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97913b28-44e0-3898-8d38-aef72ba3163d",
                                        "entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                                        "glosses": [
                                            "fortunately, gratefully."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd82015e-a5ab-4260-aea1-42068d58f01d",
                                                "sense_id": "97913b28-44e0-3898-8d38-aef72ba3163d",
                                                "text": "I was almost late for work, but thankfully there wasn't much traffic on the roads."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f4e15b1-fcdb-4a98-9e28-d5e3e06daa79",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "f219dc1d-b729-3a8e-90be-9ac3663e676e",
                        "target_lang_word": "joyfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joyfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a0a871-1511-3856-94a9-aa2151b5cd38",
                                        "entry_id": "85e58e12-eba0-3248-ac65-ef6fd3a2b103",
                                        "glosses": [
                                            "In a joyful manner; joyously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a86700d2-d9ea-4b65-b251-8cb9780dc6ab",
                                                "sense_id": "f2a0a871-1511-3856-94a9-aa2151b5cd38",
                                                "text": "I ended my aimless-roaming-short-term-odd-jobs lifestyle and joyfully went to work at a local restaurant in Langley Park, Maryland, as a carhop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
