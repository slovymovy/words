                ],
                "senses": [
                    {
                        "sense_id": "966e36f7-1e8b-35b8-a8c2-466d2c0fdf48",
                        "entry_id": "dabf11f7-4dd8-3210-8a0e-6cbba6ec9352",
                        "glosses": [
                            "The role or status of an angel; the condition of being an angel."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a4cfd1e9-9c85-4e32-bd85-e84c27dcb7f8",
                                "sense_id": "966e36f7-1e8b-35b8-a8c2-466d2c0fdf48",
                                "text": "The essence of angelship or messengership is ministration to the service of mankind: 'Are they not all ministering spirits, sent forth to do service for the sake of them that shall inherit salvation?'"
                            },
                            {
                                "example_id": "2dc6d47a-5b11-42c9-9205-6b934deed926",
                                "sense_id": "966e36f7-1e8b-35b8-a8c2-466d2c0fdf48",
                                "text": "There is nothing training cannot do. Nothing is above its reach. It can turn bad morals to good; it can destroy bad principles and recreate good ones; it can lift men to angelship."
                            },
                            {
                                "example_id": "89d7c60a-5a4e-4662-8554-ec773fe9b102",
                                "sense_id": "966e36f7-1e8b-35b8-a8c2-466d2c0fdf48",
                                "text": "Overheard him and Petrus plotting to get rid of you. Had to let my contact know, 'specially as I was charged with angelship over you."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e6b1bf5-3d07-3811-b050-a6ae67e834ca",
                        "entry_id": "dabf11f7-4dd8-3210-8a0e-6cbba6ec9352",
                        "glosses": [
                            "Used as a title or term of address for an angel or virtuous person."
                        ],
                        "tags": [
                            "countable",
                            "ironic",
                            "often",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7359df38-2505-4d4c-9397-06612c94b200",
                                "sense_id": "1e6b1bf5-3d07-3811-b050-a6ae67e834ca",
                                "text": "\"His angelship was amazingly condescending,\" said Vargas, who could scarcely smother his laughter."
                            },
                            {
                                "example_id": "844f987a-17d3-484e-93dd-23cd957b0320",
                                "sense_id": "1e6b1bf5-3d07-3811-b050-a6ae67e834ca",
                                "text": "'Your angelship has only to speak, and I am at your feet,' said the smoker with a theatrical flourish, dimly seen, and scarcely appreciated."
                            },
                            {
                                "example_id": "67ba0d2b-d025-4c1a-a70c-992cc94fe62f",
                                "sense_id": "1e6b1bf5-3d07-3811-b050-a6ae67e834ca",
                                "text": "'Yes, your angelship, and if you don't take that bleedin' saucepan off the gas, you'll stink the place out,' Dolly said tartly, back on form almost instantly."
                            }
                        ]
                    }
                ],
