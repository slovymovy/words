                        "entry_id": "5439590d-1bce-3f8c-b2b3-70161b391f81",
                        "glosses": [
                            "свойство по значению прилагательного законный; соответствие закону"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8486a1d9-4b51-348e-869f-39db130fcb9b",
                        "entry_id": "5439590d-1bce-3f8c-b2b3-70161b391f81",
                        "glosses": [
                            "соблюдение законов; положение, при котором жизнь общества охраняется законами"
                        ],
                        "tags": [],
