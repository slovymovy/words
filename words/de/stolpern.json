                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er rannte die Treppe hinunter, <w>stolperte</w> über eine Stufe und fiel fast hin."
                        },
                        {
                            "text": "Pass auf den unebenen Waldweg auf, damit du nicht über einen Stein <w>stolperst</w>."
                        }
                    ],
                    "synonyms": [
