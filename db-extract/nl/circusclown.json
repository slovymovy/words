                        "examples": [
                            {
                                "example_id": "b066152b-b11b-434d-90e1-6a79ff5b8e02",
                                "sense_id": "aa5bdda3-aae3-3f41-953d-101f6b8a0c24",
                                "text": "Polen houdt Engeland die bewuste avond op Wembley op 1-1. Grote held bij de Polen wordt doelman Jan Tomaszewski. In aanloop naar het duel bestempelt Leeds-coach Brian Clough de Poolse keeper nog als 'een circusclown met handschoenen'."
                            },
                            {
                                "example_id": "0cc33be4-5c6a-4ca1-8353-71bee024db66",
                                "sense_id": "aa5bdda3-aae3-3f41-953d-101f6b8a0c24",
                                "text": "Circusclown Tiririca zegt de Braziliaanse politiek vaarwel. De bekende komiek gold als populair parlementariër uit de staat São Paulo. Toch stopt hij, naar eigen zeggen omdat hij zich schaamt voor zijn collega's."
                            }
                        ]
