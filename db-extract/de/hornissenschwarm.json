                "senses": [
                    {
                        "sense_id": "3332c231-a49b-3993-a3cb-379fbfc44e32",
                        "entry_id": "e9f74e8c-73d6-3478-a60a-fe51dc6fa23d",
                        "glosses": [
                            "größere Anzahl sich wild durcheinander fortbewegender Hornissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c037745-1b14-4939-b27b-61a6971d918c",
                                "sense_id": "3332c231-a49b-3993-a3cb-379fbfc44e32",
                                "text": "„Ein Landwirt wurde Samstag beim Rasenmähen von einem Hornissenschwarm angegriffen.“"
                            },
                            {
                                "example_id": "e0ff4116-a19a-468f-ac0f-1d98477b6dff",
                                "sense_id": "3332c231-a49b-3993-a3cb-379fbfc44e32",
                                "text": "„Einem Bienen- oder vielmehr einem Hornissenschwarm, dessen Korb der Bär umgekehrt hat, glich der wilde verworrene Haufen.“"
                            },
                            {
                                "example_id": "7b24dbd7-dfea-4149-abe2-7f489e718b70",
                                "sense_id": "3332c231-a49b-3993-a3cb-379fbfc44e32",
                                "text": "„Es verlassend, kamen wir in eine sehr fruchtbare Ebene, welche verschiedene Stämme der Turkomanen bewohnen, und in deren Mitte ein Hornissenschwarm unsere Pferde angriff und uns die größte Verlegenheit verursachte“"
                            },
                            {
                                "example_id": "d929ea9c-1e8c-403f-83d3-3cb2b77720db",
                                "sense_id": "3332c231-a49b-3993-a3cb-379fbfc44e32",
                                "text": "„Der ganze Hornissenschwarm fällt über ihn her, in seiner Qual will er sich im Sumpfe kühlen und versinkt dabei.“"
                            },
                            {
                                "example_id": "e4f275cb-3f88-4c73-8ee9-e67d280aa9f1",
                                "sense_id": "3332c231-a49b-3993-a3cb-379fbfc44e32",
                                "text": "„Hornissenschwarm greift Grundschüler an“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
