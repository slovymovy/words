                        "tags": [
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1372d47d-b529-3d88-97e0-f244ed9aaaf9",
                        "entry_id": "d25b244b-aa37-3711-8d77-b015e50ac9ed",
                        "glosses": [
                            "A spell checker."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72842356-27ee-453b-b78b-8bc560af81f1",
                                "sense_id": "1372d47d-b529-3d88-97e0-f244ed9aaaf9",
                                "text": "But Word's spelling program still isn't fully integrated into the word processor. For one thing, any changes and corrections you make from the speller's menus don't appear on-screen until you get back to your original file."
                            }
                        ]
                    }
                ],
