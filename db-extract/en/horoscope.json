                                    {
                                        "sense_id": "26a9ccca-b375-3786-bc96-d580c54ab5ed",
                                        "entry_id": "3c3df09e-d52d-35fc-ae9f-b4a31cb41ba8",
                                        "glosses": [
                                            "schematische Darstellung der Planetenkonstellation zu einem bestimmten Zeitpunkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416d69cd-9029-45e7-a435-a19a797eae40",
                                                "sense_id": "26a9ccca-b375-3786-bc96-d580c54ab5ed",
                                                "text": "Um sein eigenes Horoskop zu erstellen, kann man Vordrucke benutzen, in die die Konstellation zum Geburtstag eingezeichnet wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                        "entry_id": "3c3df09e-d52d-35fc-ae9f-b4a31cb41ba8",
                                        "glosses": [
                                            "Voraussage über die Zukunft aufgrund von Sternenkonstellationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1132e48-f891-4816-be0c-ca03d85535a2",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "Manche befragen jeden Tag ihr Horoskop."
                                            },
                                            {
                                                "example_id": "9ea8ed5b-f9d1-4c63-b42c-356cf690b124",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "„Sie erstellte Horoskope, las die Karten und nahm ab und zu illegale Abtreibungen vor.“"
                                            },
                                            {
                                                "example_id": "6d9cf105-9029-43ea-b4e9-043665a8ce91",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "„Die Horoskope für einzelne Tage sind so unterschiedlich wie die Zeitschriften, in denen sie abgedruckt sind - und selten hat man in der Bild dieselben Aussichten wie in der Brigitte.“"
                                            },
                                            {
                                                "example_id": "94877be0-cdd4-4ca4-a8d2-b38769787840",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "„Und mit dem täglichen Horoskop beginnt mein Tag.“"
                                            },
                                            {
                                                "example_id": "3b9db22d-909c-4825-b789-86ffed446f90",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "„Er hatte in seinem Horoskop gelesen, daß er an einem solchen Tag ermordet werden sollte, und als kluger Mann mußte er daher unerreichbar bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
