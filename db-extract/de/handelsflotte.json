                ],
                "senses": [
                    {
                        "sense_id": "096e471a-d1e3-3ca3-888b-a8ba68b6ea3b",
                        "entry_id": "ca6ac024-0a8a-3118-bae7-636253041a8b",
                        "glosses": [
                            "Gesamtheit der Handelsschiffe eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0016d9-ab61-4a9c-94f8-314e61ccaf6a",
                                "sense_id": "096e471a-d1e3-3ca3-888b-a8ba68b6ea3b",
                                "text": "Riga hatte schon früh in seiner Geschichte eine starke Handelsflotte."
                            },
                            {
                                "example_id": "0edbae34-8ae5-4378-97ee-740ff84ae06a",
                                "sense_id": "096e471a-d1e3-3ca3-888b-a8ba68b6ea3b",
                                "text": "„Um die Mitte des 17. Jahrhunderts war die niederländische Handelsflotte größer als die Englands, Frankreichs und Spaniens zusammen.“"
                            },
                            {
                                "example_id": "09e1525e-8aa5-4f65-af15-14080a267e19",
                                "sense_id": "096e471a-d1e3-3ca3-888b-a8ba68b6ea3b",
                                "text": "„Die »Bremen« galt als modernster Passagierdampfer der deutschen Handelsfotte und stellte schon bei ihrer Jungfernfahrt vor 90 Jahren einen Geschwindigkeitsrekord auf.“"
                            },
                            {
                                "example_id": "7d7c5462-a42d-4fb2-b321-a35036c1346b",
                                "sense_id": "096e471a-d1e3-3ca3-888b-a8ba68b6ea3b",
                                "text": "„Diese Zahlen umschließen auch die beschlagnahmten Auslandsguthaben und die unter den Verbündeten aufgeteilte deutsche Handelsflotte.“"
                            },
                            {
                                "example_id": "c0ffe0f1-017c-4a21-8445-d44594cde17a",
                                "sense_id": "096e471a-d1e3-3ca3-888b-a8ba68b6ea3b",
                                "text": "„Die Briten kalkulierten ihre Unternehmungen sorgfältiger als die Niederländer, die eine riesige Handelsflotte betrieben, deren Unterhaltung aufwendig und keiner Kosten-Nutzen-Analyse zugänglich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
