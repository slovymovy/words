                        "entry_id": "0bd6ca9c-2a06-37bd-bcb6-a8eaedac5e14",
                        "glosses": [
                            "Gelenk, zur Verbindung zweier nicht fluchtender Wellen (Kardanwellen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f4c9c13-df88-48ba-bbf4-6dcddac72f92",
                                "sense_id": "a15e1d2d-94ad-3c37-9585-fd50c48ef9f5",
                                "text": "„Diese ist mit der Ausgangswelle des Getriebes mit einem Kardangelenk verbunden.“"
                            },
                            {
                                "example_id": "fee8d8b9-7e26-4960-a914-09518250cb34",
                                "sense_id": "a15e1d2d-94ad-3c37-9585-fd50c48ef9f5",
                                "text": "„Wie das größte österreichische Unternehmen in der Weltraumtechnik am Dienstag mitteilte, erhielt es kürzlich einen Auftrag für die Entwicklung eines Kardangelenks zur beweglichen Aufhängung eines neu entwickelten Motors für die neue Oberstufe der Ariane-5.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
