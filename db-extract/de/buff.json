                        "sense_id": "ac626ae9-6f94-3b24-83a6-633b2cb0530c",
                        "entry_id": "e79c33d6-e45d-3a8c-945d-b6d823b1f538",
                        "glosses": [
                            "Verstärkungszauber, der die Attribute eines Spielers verbessert"
                        ],
                        "tags": [
                            "Computerspiel-Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "734819fd-69f8-4193-954d-67082a1277de",
                                "sense_id": "ac626ae9-6f94-3b24-83a6-633b2cb0530c",
                                "text": "„Einen echten Mitstreiter haben wir so aber nicht gewonnen, sondern lediglich eine Verstärkung unserer Werte – die Wache, links oder rechts neben den vier Hauptporträts angezeigt, ist also ein Buff, der etwas bessere Weitsicht gewährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bcc6e83-7e4a-400d-b7bd-06320b6a39fb",
                        "source_entry_id": "e79c33d6-e45d-3a8c-945d-b6d823b1f538",
                        "source_sense_id": "ac626ae9-6f94-3b24-83a6-633b2cb0530c",
                        "source_sense_description": "Computerspiel-Jargon: Verstärkungszauber, der die Attribute eines Spielers verbessert",
                        "target_lang_word": "buff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6721c26-eb49-37ef-ba4e-8ddb0e63372b",
                                        "entry_id": "10ad873d-7651-3ca4-83a9-efff62122eda",
                                        "glosses": [
                                            "A strike; a blow."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c1332f8-f792-4214-b3ee-9865b0c206eb",
                                                "sense_id": "b6721c26-eb49-37ef-ba4e-8ddb0e63372b",
                                                "text": "Nathless so sore a buff to him it lent / That made him reel."
                                            },
                                            {
                                                "example_id": "4f336ae6-a9a3-4be9-8d94-b23b258ec728",
                                                "sense_id": "b6721c26-eb49-37ef-ba4e-8ddb0e63372b",
                                                "text": "A man must consider what a blind-man’s-buff is this game of conformity. If I know your sect I anticipate your argument."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "buff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ef3e313-50ce-3579-8e87-0d57fbfb0f79",
                                        "entry_id": "42c7efe7-6823-35f4-a9b1-c3ae63356d89",
                                        "glosses": [
