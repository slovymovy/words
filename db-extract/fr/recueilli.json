                    {
                        "translation_id": "3bb352c5-c65e-4093-93cd-443aeb424892",
                        "source_entry_id": "5bf51a96-0b52-365d-bab9-bad0d6539998",
                        "source_sense_description": "Rassemblé",
                        "target_lang_word": "collected",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
