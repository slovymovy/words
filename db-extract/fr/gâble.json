                                                "example_id": "bd24e98a-fe57-4b52-8334-6dcde61b7000",
                                                "sense_id": "adeeb355-c99b-32f5-8a64-6ff62beee200",
                                                "text": "Palenie w łóżku jest szczytem głupoty."
