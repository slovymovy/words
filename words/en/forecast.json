{
    "word_family": [
        "forecaster",
        "forecasting",
        "unforecast"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d73bab1-ff1f-3973-bd89-c6e6560a079b",
                    "sense_definition": "A prediction or estimation of future conditions, especially regarding the weather or financial trends.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prediction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather <w>forecast</w> said it will be very windy tomorrow.",
                            "target_lang_translations": {
                                "ru": "В <w>прогнозе</w> погоды говорилось, что завтра будет очень ветрено.",
                                "zh": "天气<w>预报</w>说明天风会很大。"
                            }
                        },
                        {
                            "text": "It is a good idea to carry an umbrella in case the <w>forecasts</w> prove overly optimistic.",
                            "target_lang_translations": {
                                "ru": "Стоит взять с собой зонт на случай, если <w>прогнозы</w> окажутся слишком оптимистичными.",
                                "zh": "带把伞是个好主意，以防<w>预测</w>过于乐观。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prediction",
                        "prognosis",
                        "outlook"
                    ],
                    "common_phrases": [
                        "weather forecast",
                        "economic forecast",
                        "accurate forecast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предсказание или оценка будущих условий, особенно в отношении погоды или финансовых тенденций.",
                        "zh": "对未来情况的预测或估算，尤指天气或金融趋势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогноз",
                                "target_lang_sense_clarification": "научно обоснованное предсказание"
                            },
                            {
                                "target_lang_word": "предсказание",
                                "target_lang_sense_clarification": "сообщение о том, что произойдет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预报",
                                "target_lang_sense_clarification": "指对天气等自然现象的预先报告"
                            },
                            {
                                "target_lang_word": "预测",
                                "target_lang_sense_clarification": "指对未来趋势或结果的推测"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b6cabac-4d57-3e60-bae5-6b3b79128825",
                    "sense_definition": "To predict or estimate a future event or trend based on analysis of data.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "predicting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists <w>forecast</w> a rise in prices over the next six months.",
                            "target_lang_translations": {
                                "ru": "Экономисты <w>прогнозируют</w> рост цен в ближайшие шесть месяцев.",
                                "zh": "经济学家<w>预测</w>未来六个月价格会上涨。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>forecast</w> the weather accurately in this mountainous region.",
                            "target_lang_translations": {
                                "ru": "В этом горном регионе трудно точно <w>предсказать</w> погоду.",
                                "zh": "在这个山区很难准确地<w>预报</w>天气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "predict",
                        "foretell",
                        "project"
                    ],
                    "common_phrases": [
                        "forecast the weather",
                        "forecast a rise",
                        "forecast growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предсказывать или оценивать будущее событие или тенденцию на основе анализа данных.",
                        "zh": "基于数据分析对未来事件或趋势进行预测或估算。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогнозировать",
                                "target_lang_sense_clarification": "составлять научный или технический прогноз"
                            },
                            {
                                "target_lang_word": "предсказывать",
                                "target_lang_sense_clarification": "говорить заранее о будущем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预测",
                                "target_lang_sense_clarification": "根据已知信息推断未来"
                            },
                            {
                                "target_lang_word": "预估",
                                "target_lang_sense_clarification": "对未来数值或情况的预先估计"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69eb9db8-5ed2-330b-abb4-1a52a447c35f",
                    "sense_definition": "To foreshadow or suggest something that will happen in advance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "foreshadowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds <w>forecast</w> a heavy storm that would soon arrive.",
                            "target_lang_translations": {
                                "ru": "Темные тучи <w>предвещали</w> сильную бурю, которая вскоре должна была начаться.",
                                "zh": "乌云<w>预示</w>一场暴风雨即将来临。"
                            }
                        },
                        {
                            "text": "Early signs of tension <w>forecast</w> the conflict that broke out later that year.",
                            "target_lang_translations": {
                                "ru": "Первые признаки напряженности <w>предвещали</w> конфликт, вспыхнувший в конце того же года.",
                                "zh": "早期的紧张迹象<w>预示</w>了那年晚些时候爆发的冲突。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foreshadow",
                        "augur",
                        "portend"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предвещать или указывать на то, что произойдет в будущем.",
                        "zh": "预示或暗示某事即将发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвещать",
                                "target_lang_sense_clarification": "служить признаком чего-либо"
                            },
                            {
                                "target_lang_word": "пророчить",
                                "target_lang_sense_clarification": "предсказывать (часто о чем-то плохом)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预示",
                                "target_lang_sense_clarification": "指事物的发展迹象显示出未来结果"
                            },
                            {
                                "target_lang_word": "预兆",
                                "target_lang_sense_clarification": "指某种现象暗示了未来的发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3f6e65e-f316-37ff-ba21-7c005c3e06cc",
                    "sense_definition": "To plan or contrive something beforehand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>forecast</w> his moves carefully to ensure the success of the plan.",
                            "target_lang_translations": {
                                "ru": "Ему приходилось тщательно <w>продумывать</w> свои шаги, чтобы обеспечить успех плана.",
                                "zh": "他必须仔细<w>筹划</w>自己的每一步，以确保计划成功。"
                            }
                        },
                        {
                            "text": "The general sought to <w>forecast</w> every possible outcome of the battle.",
                            "target_lang_translations": {
                                "ru": "Генерал стремился <w>предусмотреть</w> каждый возможный исход сражения.",
                                "zh": "将军试图<w>预先考虑</w>战斗的每一种可能结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preplan",
                        "contrive"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Планировать или продумывать что-либо заранее.",
                        "zh": "预先计划或筹划某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предусматривать",
                                "target_lang_sense_clarification": "заранее учитывать возможности"
                            },
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "составлять план действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预先考虑",
                                "target_lang_sense_clarification": "在行动前进行周全的思考"
                            },
                            {
                                "target_lang_word": "筹划",
                                "target_lang_sense_clarification": "为实现目标而进行的预先安排"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}