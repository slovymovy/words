                "senses": [
                    {
                        "sense_id": "5955b019-f743-3608-bf1a-1c9ff85d7fdd",
                        "entry_id": "95ad6bf0-eabf-310d-ab24-6b5a4dd2a544",
                        "glosses": [
                            "Premier mois du calendrier musulman au cours duquel les chiites commémorent le martyr de Hasan et de Husayn."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "828e9997-487c-38d0-923d-057a0026dcad",
                        "entry_id": "95ad6bf0-eabf-310d-ab24-6b5a4dd2a544",
                        "glosses": [
                            "Festivités qui marquent cette commémoration."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f57a11b4-0f3d-4a45-84a8-6629824d0099",
                                "sense_id": "828e9997-487c-38d0-923d-057a0026dcad",
                                "text": "Ces derniers n'ayant pas entendu parler de collecteur-sahib depuis un certain temps, et méprisant de tout cœur le juge auxiliaire hindou, mirent sur pied une petite émeute du genre mouharram."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e685df15-9604-4634-8429-6cb6ebaa17b4",
                        "source_entry_id": "95ad6bf0-eabf-310d-ab24-6b5a4dd2a544",
                        "source_sense_description": "Mois du calendrier musulman",
                        "target_lang_word": "Muharram",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muharram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5b7c86a-6c9a-36d7-8bbd-173d98ae932a",
                                        "entry_id": "baab4053-c566-303a-8d5b-0488ef7357d1",
                                        "glosses": [
                                            "erster Monat im islamischen Kalender"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101e4d00-2703-48e7-9dd5-9c242017f4cf",
                                                "sense_id": "b5b7c86a-6c9a-36d7-8bbd-173d98ae932a",
                                                "text": "„Lediglich drei israelische Soldaten trugen leichte Verletzungen davon, aber der Aufwand für Dabbuqs Inszenierung war beträchtlich gewesen: Als Zeitpunkt hatte man den siebten Tag des islamischen Monats Muharram gewählt, also drei Tage vor dem Höhepunkt des Aschura-Festes, an dem mit Flagellanten-Prozessionen und Passionsspielen an das Martyrium des dritten Imams Husein erinnert wird.“"
                                            },
                                            {
                                                "example_id": "47cfa9e2-3555-4772-8487-43ba24ed45c0",
                                                "sense_id": "b5b7c86a-6c9a-36d7-8bbd-173d98ae932a",
                                                "text": "„Da es weder Ramadan noch Muharram war, blieb die Zahl der Pilger einigermaßen überschaubar, was für die Grenzpolizisten allerdings nur hieß, dass sie sich noch mehr Zeit lassen konnten als sonst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7034032d-f2ba-4101-9e18-ea2f722f02df",
                        "source_entry_id": "95ad6bf0-eabf-310d-ab24-6b5a4dd2a544",
                        "source_sense_description": "Mois du calendrier musulman",
                        "target_lang_word": "Muharram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muharram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3ad1f5-da40-3a20-93a2-7fa1ddd9f96c",
                                        "entry_id": "5ecebf38-6eaf-31c0-8537-1b9c9359903d",
                                        "glosses": [
                                            "The first month of the Islamic calendar, when many Islamic communities hold a festival commemorating the deaths of the grandsons of Mohammed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a15fe31-890f-4667-aad1-d66a37f05a4a",
                                                "sense_id": "8a3ad1f5-da40-3a20-93a2-7fa1ddd9f96c",
                                                "text": "These, hearing nothing of the Collector-Sahib for some time, and heartily despising the Hindu Sub-Judge, arranged to start a little Mohurrum riot of their own."
                                            },
                                            {
                                                "example_id": "2a0598ac-da43-42f6-b6c7-e555bbf0651a",
                                                "sense_id": "8a3ad1f5-da40-3a20-93a2-7fa1ddd9f96c",
                                                "text": "‘I don't much believe in this discussing – besides, I'm so dead with all the extra work Mohurram's bringing, if you'll excuse me.’"
                                            },
                                            {
                                                "example_id": "e616a3f5-4e54-4e15-87d1-8516fa28c6dc",
                                                "sense_id": "8a3ad1f5-da40-3a20-93a2-7fa1ddd9f96c",
                                                "text": "It was unfortunate, moreover, that he arrived in Teheran in January 1829 during the holy month of Muharram, when feelings run high and the faithful slash themselves with swords and pour glowing cinders on their heads."
                                            },
                                            {
                                                "example_id": "dc897843-e32e-4666-ba7a-20cdcaaaa342",
                                                "sense_id": "8a3ad1f5-da40-3a20-93a2-7fa1ddd9f96c",
                                                "text": "[…]were two Muharrams in the first year, the first being the beginning of the new year and the other the added month. The number of months was 13. After the passage of two or three years, when the period for the intercalated month had come to[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d911fcc2-8ded-3376-adad-0869f9b8593c",
                                        "entry_id": "5ecebf38-6eaf-31c0-8537-1b9c9359903d",
                                        "glosses": [
                                            "A Shiite festival held during its first ten days; Ashura."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e552d9e-1465-42c4-abc9-ba503ac5ec14",
                                                "sense_id": "d911fcc2-8ded-3376-adad-0869f9b8593c",
                                                "text": "It is now clear that the term Hobson-Jobson was originally a deprecating Anglo-Indian slang term for the Muharram used particularly in the army and merchant navy but also more widely."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
