    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "02b55d3d-0687-3f8c-bc3f-368fcc19abb8",
                    "sense_definition": "To leave hurriedly and secretly, typically to escape or to avoid detection.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "departure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt treasurer decided to <w>abscond</w> with millions of dollars from the charity account."
                        },
                        {
                            "text": "Several inmates managed to <w>abscond</w> from the facility before the guards noticed their absence."
                        }
                    ],
                    "synonyms": [
                        "flee",
                        "run away",
                        "steal away"
                    ],
                    "common_phrases": [
                        "abscond with"
                    ]
                },
                {
                    "sense_id": "de91117a-db9a-30d3-89a1-948479e34f4a",
                    "sense_definition": "To fail to surrender to custody or to depart secretly to avoid legal prosecution.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "departure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police issued an urgent warrant after the primary suspect chose to <w>abscond</w> before trial."
                        },
                        {
                            "text": "He decided to <w>abscond</w> while released on bail rather than face his impending sentence."
                        }
                    ],
                    "synonyms": [
                        "jump bail"
                    ],
                    "common_phrases": [
                        "abscond on bail"
                    ]
                },
                {
                    "sense_id": "661cd590-ce6e-3e19-9f67-28c1e8806767",
                    "sense_definition": "To evade or abandon a duty or responsibility.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "evasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was criticized for attempting to <w>abscond</w> his professional responsibilities during the crisis."
                        },
                        {
                            "text": "You cannot simply <w>abscond</w> your financial obligations when unexpected difficulties emerge."
                        }
                    ],
                    "common_phrases": [
                        "abscond responsibility"
                    ]
                },
                {
                    "sense_id": "3e5dbf9a-e1f7-3f25-9c82-fc31d3b786e3",
                    "sense_definition": "Of an entire colony of bees: to abandon a hive completely.",
