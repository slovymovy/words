                            "betonender oder verstärkender Hinweis"
                        ],
                        "examples": [
                            {
                                "example_id": "1dd20381-6778-475b-a3f3-d71485d791df",
                                "sense_id": "960ba7a9-5ed9-3d8e-b12e-c363b4822b17",
                                "text": "Wir sind hier wohlgemerkt im deutschen Wikiwörterbuch."
                            },
                            {
                                "example_id": "34484bce-9ea9-4290-bd64-fbc1dd1b4baa",
                                "sense_id": "960ba7a9-5ed9-3d8e-b12e-c363b4822b17",
                                "text": "Herr Richter, es handelt sich wohlgemerkt um den gleichen Täter, der auch die Straftaten in Frankfurt und Berlin beging."
                            },
                            {
                                "example_id": "7c236f1e-6da5-4d9a-8153-cefa2e63061c",
                                "sense_id": "960ba7a9-5ed9-3d8e-b12e-c363b4822b17",
                                "text": "„Robert Spaemann, der große Wertkonservative, der sich nicht nur gegen die moderne verbrauchende Embryonenforschung, sondern auch gegen jede Form von Euthanasie aussprach, wartete im Herbst 2006 mit einem neuen Gottesbeweis, dem wohlgemerkt letzten Gottesbeweis, auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df03bf29-c40a-4b78-809f-1950f401d976",
                        "source_entry_id": "c0fc2ef2-6544-3d89-8e6d-726ae3964dd5",
