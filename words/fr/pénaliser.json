                {
                    "sense_id": "e3049eae-1767-3881-8652-c0d64d585737",
                    "sense_definition": "Infliger une punition ou une sanction à quelqu'un en réponse à une infraction ou à une faute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre a décidé de <w>pénaliser</w> le joueur après cette faute dangereuse."
                        },
                        {
                            "text": "Le professeur va <w>pénaliser</w> les retards répétés lors de l'évaluation finale."
                        }
                    ],
                    "synonyms": [
                        "punir"
                    ],
                    "common_phrases": [
                        "pénaliser une faute"
                    ]
                },
                {
                    "sense_id": "086c6dd3-7058-38ff-b73d-f22b335e1461",
                    "sense_definition": "Placer dans une situation désavantageuse ou nuire au bon déroulement de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "desavantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La hausse des taxes risque de <w>pénaliser</w> lourdement les petites entreprises locales."
                        },
                        {
                            "text": "Son manque d'expérience risque de le <w>pénaliser</w> pendant cet entretien d'embauche."
                        }
                    ],
                    "antonyms": [
                        "favoriser"
                    ],
                    "common_phrases": [
