                "senses": [
                    {
                        "sense_id": "bc7f6fa0-b356-395b-9115-b11d08e12f99",
                        "entry_id": "2737a599-303e-3477-a917-db61472fcd61",
                        "glosses": [
                            "Graben, der das Hinterland mit der Frontlinie verbindet und so den gedeckten Zugang ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7533683c-b330-43ba-85f1-e20ca1fff646",
                                "sense_id": "bc7f6fa0-b356-395b-9115-b11d08e12f99",
                                "text": "Kaiser Wilhelm besichtigt einen Laufgraben an der Westfront."
                            },
                            {
                                "example_id": "8cd447ca-8efc-4700-a7d7-e6393ea78a17",
                                "sense_id": "bc7f6fa0-b356-395b-9115-b11d08e12f99",
                                "text": "Dort gab es eine 70 cm tiefe Rinne, die als Laufgraben diente, aber bald ebenfalls zerschossen wurde."
                            },
                            {
                                "example_id": "1f9f00f7-b922-4957-a2b5-4c4b1494c048",
                                "sense_id": "bc7f6fa0-b356-395b-9115-b11d08e12f99",
                                "text": "Endlich klappern die Kochgeschirre der zurückkommenden Kaffeeholer im Laufgraben: es ist 7 Uhr. Die Nachtwache ist beendet."
                            },
                            {
                                "example_id": "057c6e32-b698-44c7-a34d-c1cf9e7fc31b",
                                "sense_id": "bc7f6fa0-b356-395b-9115-b11d08e12f99",
                                "text": "„Wie oft sind wir durch diesen Laufgraben vorgegangen; wie oft mit wenigen durch ihn zurückgekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
