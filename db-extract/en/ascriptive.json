                    {
                        "translation_id": "ae24f011-0a27-4fb7-95d1-7836207d6061",
                        "source_entry_id": "42db2fc1-3f69-3337-893f-71ca2f99663b",
                        "source_sense_id": "ddea08a7-d96d-3199-837d-389d6beff16c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "askriptiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "askriptiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                        "entry_id": "d87de814-3f26-31aa-b55d-3258d1a476df",
                                        "glosses": [
                                            "(unveränderlich) zugeschrieben oder (nachdrücklich) zuschreibend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6bb688c-73d9-4a7b-993a-cdaefc58256b",
                                                "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                                "text": "„Mit dem Bedeutungsverlust askriptiver Bindungen entwickeln sich in der modernen Gesellschaft generalisiertere Kriterien für nunmehr „freie“ Entscheidungen für emotionale Bindungen und deren Auflösung.“"
                                            },
                                            {
                                                "example_id": "04894179-1894-4dd4-bd12-c5532630ae99",
                                                "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                                "text": "Askriptive Merkmale anstatt erbrachter Leistung bestimmten die Zugehörigkeit zur herrschenden Klasse."
                                            },
                                            {
                                                "example_id": "998f7b3d-2d2d-49c1-844c-7305cf7236a2",
                                                "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                                "text": "„Im Gegensatz zu dieser Vorstellung von askriptiv unaufhebbar an die Mutterrolle geknüpften Pflichten wählen die Jüngeren die gute Versorgung der Kinder als Bezugspunkt und für dieses Problem sehen sie funktional äquivalente Lösungen (z. B. der Ehemann, die Großeltern, eine Tagesmutter kann die Versorgung übernehmen).“"
                                            },
                                            {
                                                "example_id": "dd37a67f-165c-47c8-acf8-ea417245072f",
                                                "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                                "text": "„Es impliziert nicht die Gleichheit der Ergebnisse, sondern die Gleichbehandlung von Individuen im Sinne der Nichtbeachtung askriptiver Kriterien […].“"
                                            },
                                            {
                                                "example_id": "76747148-fd1b-4eb8-a244-5bac9ebd47e7",
                                                "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                                "text": "„Damit werden jedoch solche askriptiven Merkmale der Arbeitnehmer zu wichtigen Determinanten der Lohnfindung und der Karrieremobilität.“"
                                            },
                                            {
                                                "example_id": "a1b5cdd6-1106-4027-b305-f0d887c98c01",
                                                "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                                "text": "„So will Hruschka dem Umstand, daß mentale Dispositionen wie Absicht oder Wissen nicht beobachtbar sind, dadurch Rechnung tragen, daß er die Annahme des Tatvorsatzes nicht als deskriptives, sondern als askriptives Urteil charakterisiert, das nicht auf einer Feststellung, sondern auf einer Zurechnung beruhe.“"
                                            },
                                            {
                                                "example_id": "66c7e64f-0ee2-46c7-94e5-68b59d774792",
                                                "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                                "text": "„Eine askriptive Regelung dagegen bestimmt den Zugang nach formalen Regeln, die mit dem Thema und den Interessen der Teilnehmer nichts zu tun haben müssen.“"
                                            },
                                            {
                                                "example_id": "61e8b172-4f7b-4510-a6b3-39dc72d9cec5",
                                                "sense_id": "c953f4ed-2210-3941-ba7b-ffd8ffcb3aee",
                                                "text": "„Oder, wie es in der Sprache der Soziologen heißt, die soziale Position wird in der ständischen Gesellschaft auf askriptivem Wege bestimmt, d.h. sie wird zugeschrieben, nicht individuell erworben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
