                        "zh": "国家或公共生活的一种特殊法律制度。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "state",
                                "target_lang_sense_clarification": "in 'state of emergency'"
                            },
                            {
                                "target_lang_word": "law",
                                "target_lang_sense_clarification": "in 'martial law'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "状态",
                                "target_lang_sense_clarification": "用于“紧急状态”"
                            },
                            {
                                "target_lang_word": "戒严",
                                "target_lang_sense_clarification": "用于“军事管制”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "281e83f8-0975-3d3d-b635-81c3999426c8",
                    "sense_definition": "Официальный документ, свод правил или инструкций, регулирующих определённую сферу деятельности.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_rules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор подписал новое <w>положение</w> о премировании сотрудников нашего отдела.",
                            "target_lang_translations": {
                                "en": "The director signed a new <w>regulation</w> on employee bonuses for our department.",
                                "zh": "经理签署了关于我们部门员工奖金的最新<w>规定</w>。"
                            }
                        },
                        {
                            "text": "Все участники соревнования должны внимательно изучить <w>положение</w> о турнире перед регистрацией.",
                            "target_lang_translations": {
                                "en": "All tournament participants must carefully study the <w>regulations</w> of the tournament before registration.",
                                "zh": "所有参赛者在注册前都必须仔细研读比赛<w>章程</w>。"
                            }
