                        "source_entry_id": "a3c9ad60-800a-395d-ac9c-866edbc25061",
                        "source_sense_description": "unable to fly",
                        "target_lang_word": "flugunfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flugunfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                        "entry_id": "abe5f49c-4305-3e8a-a929-194d72411104",
                                        "glosses": [
                                            "nicht fähig zu fliegen oder zum Fliegen gebracht zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "917887e8-f91b-4f52-a0bb-2584019b0743",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "Die Anatomie und die Gehirnstruktur von flugunfähigen Vögeln deuten daraufhin, dass sie alle von Vorfahren abstammen, die fliegen konnten."
                                            },
                                            {
                                                "example_id": "7129fb53-9515-48d4-b157-0a3648504adb",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "Zunächst einmal ist er flugunfähig, wobei sich die straußenähnlichen Laufvögel auf der ganzen Welt darin unterscheiden, dass einige noch kleine Stummelflügelchen haben, mit denen sie in der Luft wedeln können, und andere haben nicht einmal das."
                                            },
                                            {
                                                "example_id": "749ae566-b119-401d-8428-81720c947328",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "Ein nicht fachmännisch behandelter Bruch heilt nicht richtig und der Vogel bleibt unter Umständen für den Rest seines Lebens flugunfähig."
                                            },
                                            {
                                                "example_id": "914ae002-c07b-4c83-bdfe-69fb510609f1",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "Jährlich werden mehr als 5 000 Jagdhunde an lebenden, vorher flugunfähig gemachten Enten ausgebildet."
                                            },
                                            {
                                                "example_id": "b589ee09-40a6-4c4e-ae58-a927f6f28c26",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "§ 186 Abs 2 Z 1 begeht, wer ein im Einsatz befindliches Luftfahrzeug zerstört, also gänzlich vernichtet, oder es auf eine Weise beschädigt, dass es flugunfähig wird."
                                            },
                                            {
                                                "example_id": "3e1c1466-595d-477a-9ef8-bd410ffa710f",
                                                "sense_id": "03621d16-6264-3228-85db-e944f1316ce1",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
