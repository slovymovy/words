                        "examples": [
                            {
                                "example_id": "4f4cf7aa-3288-4c4d-b172-9edef7471f56",
                                "sense_id": "7b843356-796d-321d-aff8-b918ba698ea3",
                                "text": "Ne voulant pas apparaître à l’agence de location avec mes coquards et mes bosses, je donnai les papiers à Chapuis et lui demandai de rendre la voiture."
                            },
                            {
                                "example_id": "22fd3576-3c9d-4d3b-b29b-7dbc3cceaccb",
                                "sense_id": "7b843356-796d-321d-aff8-b918ba698ea3",
                                "text": "Là apparemment il a dû se battre, t'as vu, il a un coquard."
                            },
                            {
                                "example_id": "f147108f-17f5-4594-8d98-276b6f2477f0",
                                "sense_id": "7b843356-796d-321d-aff8-b918ba698ea3",
                                "text": "Coquard, œil au beurre noir ou gnon, Box espérait en tout cas que son orbite n'était pas fracturée."
                            }
                        ]
                    }
                ],
