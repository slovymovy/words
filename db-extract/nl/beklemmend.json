                        "examples": [
                            {
                                "example_id": "0b606f6d-5b13-4fb5-b658-b33653d95bb8",
                                "sense_id": "b4cbbbe4-ee49-34f2-85fa-a4749d1e2c37",
                                "text": "Bij angina pectoris heeft een patiënt een beklemmend gevoel op de borst."
                            },
                            {
                                "example_id": "ae8271ea-1587-4903-9c0e-777c85e85bda",
                                "sense_id": "b4cbbbe4-ee49-34f2-85fa-a4749d1e2c37",
                                "text": "Terwijl hij de plek [des onheils] naderde, zwol een naar en beklemmend gevoel in zijn onderbuik op."
                            },
                            {
                                "example_id": "9fe10975-8736-4eb8-a78c-086f5e3a6395",
                                "sense_id": "b4cbbbe4-ee49-34f2-85fa-a4749d1e2c37",
                                "text": "De gruwelijke beelden en het beklemmende gevoel dat hiermee gepaard ging, verdwenen op slag."
                            }
                        ]
                    }
