                                "target_senses": [
                                    {
                                        "sense_id": "2f285bb2-f6ec-3c45-943e-f6e8ab9865fe",
                                        "entry_id": "247e1d98-d751-3966-aa8f-941121605f6b",
                                        "glosses": [
                                            "Bildung von Lauten mit Hilfe der Artikulationsorgane"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31482754-b753-48b2-a0e9-5f65d06a5334",
                                                "sense_id": "2f285bb2-f6ec-3c45-943e-f6e8ab9865fe",
                                                "text": "Die korrekte Artikulation von Nasalvokalen fällt manchem schwer."
                                            },
                                            {
                                                "example_id": "61360b75-72e7-498e-b87e-710160c705c1",
                                                "sense_id": "2f285bb2-f6ec-3c45-943e-f6e8ab9865fe",
                                                "text": "„Die Karten des Projekts belegten eindrucksvoll, wie viele Faktoren bei der Artikulation eine Rolle spielen: nationale Grenzen genauso wie regionale; aber auch der lautliche Kontext, die Häufigkeit eines Wortes, Wortartenunterschiede und die einzelnen Erhebungssituationen beeinflussen die Aussprache.“"
                                            },
                                            {
                                                "example_id": "f1befa7b-7a92-4d79-a297-c6477b48d054",
                                                "sense_id": "2f285bb2-f6ec-3c45-943e-f6e8ab9865fe",
                                                "text": "„Viele anscheinend ungewöhnliche Artikulationen können auf frühere Entwicklungsstufen rückverfolgt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "def8a5f5-b53a-3b54-bcf6-f983fc961312",
                                        "entry_id": "247e1d98-d751-3966-aa8f-941121605f6b",
                                        "glosses": [
                                            "die Differenzierung der Tonerzeugung beim Singen und Musizieren"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25eab67e-5334-44db-9fd2-81781260e578",
                                                "sense_id": "def8a5f5-b53a-3b54-bcf6-f983fc961312",
                                                "text": "Die musikalische Artikulation beschreibt, wie mehrere aufeinanderfolgende Töne phrasiert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "532646c8-8b13-3a8d-a805-3c416e60d3ae",
                                        "entry_id": "247e1d98-d751-3966-aa8f-941121605f6b",
                                        "glosses": [
                                            "ein Knoten eines Graphen mit bestimmten Eigenschaften"
                                        ],
                                        "tags": [
                                            "Graphentheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07de2f5f-178c-4b0c-a3e1-36ea65cc8db5",
                                                "sense_id": "532646c8-8b13-3a8d-a805-3c416e60d3ae",
                                                "text": "Eine Artikulation ist im mathematischen Sinne der Knoten eines Graphen, dessen Entfernen die Anzahl der zusammenhängenden Teilgraphen erhöhen würde."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8aca2995-856b-3d55-b499-59a851348f90",
                                        "entry_id": "247e1d98-d751-3966-aa8f-941121605f6b",
                                        "glosses": [
                                            "die zeitliche Gliederung von Unterrichtsstunden oder Lernprozessen"
                                        ],
                                        "tags": [
                                            "Didaktik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc4924d2-dd2b-4a3d-8f2e-31022f56e06f",
                                                "sense_id": "8aca2995-856b-3d55-b499-59a851348f90",
                                                "text": "Der Lehrer sollte nicht auf ein Artikulationsschema zurückgreifen, sondern seine eigene Artikulation vornehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "454e4bb7-b2c1-3c49-9b1f-9e9ab20d456d",
                                        "entry_id": "247e1d98-d751-3966-aa8f-941121605f6b",
                                        "glosses": [
                                            "die Kaubewegungen des Unterkiefers"
                                        ],
