                ],
                "senses": [
                    {
                        "sense_id": "71addc7e-bc66-3e3a-8eb4-b537ca66306a",
                        "entry_id": "a9e0f03e-c78d-3fc3-a167-7887f2f9eb67",
                        "glosses": [
                            "mehrfach im Johannes-Evangelium verwendeter Begriff, der in der christlichen Theologie gewöhnlich mit dem Heiligen Geist identifiziert wird"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fd9682a2-82ff-4275-bbf0-1c27db657261",
                                "sense_id": "71addc7e-bc66-3e3a-8eb4-b537ca66306a",
                                "text": "„Wimmernd und schluchzend heulte es seinen Fluch über den Pfuhl seiner Geburt; und er lag mit ohnmächtig klappernden Kiefern da und wehrte sich gegen die Nacht, wie ein verrückter, vom Wehklagen der Vorhölle umdrohter Paraklet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53a1f08c-9d60-448c-8b73-e28bfb5c1c9d",
                        "source_entry_id": "a9e0f03e-c78d-3fc3-a167-7887f2f9eb67",
                        "source_sense_id": "71addc7e-bc66-3e3a-8eb4-b537ca66306a",
                        "source_sense_description": "Begriff des Johannes-Evangeliums",
                        "target_lang_word": "Paraclete",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paraclete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                                        "entry_id": "28302e80-1aae-34e3-aeeb-1e5ea9752f79",
                                        "glosses": [
                                            "The Holy Spirit, the Holy Ghost, especially in its role as comforter of the faithful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db77be9-1bae-42a6-a5f4-3dde1a806add",
                                                "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                                                "text": "Apples of ashes, golden bright; / Waters of bitterness, how sweet! / O banquet of a foul delight, / Prepared by thee, dark Paraclete!"
                                            },
                                            {
                                                "example_id": "545bc7df-d8ce-45ae-9bc7-8e19676ce6d5",
                                                "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                                                "text": "The matter of a Paraclete’s coming, the comforter, the dove; the tongues of flame, the gift of tongues: Pentecost. Third Person of the Trinity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
