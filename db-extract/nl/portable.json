                                    },
                                    {
                                        "sense_id": "25dc7660-c5fc-3e65-a26c-70151e021d2e",
                                        "entry_id": "a2e7c99a-8e60-34dc-901d-18538aaca39d",
                                        "glosses": [
                                            "A portable building used for temporary purposes",
                                            "A trailer or other movable structure used for classes at a school."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54b5f49c-3143-33e2-9816-d345d84a9b2b",
                                        "entry_id": "a2e7c99a-8e60-34dc-901d-18538aaca39d",
                                        "glosses": [
                                            "Clipping of portable computer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d64ec9c-831c-4fd4-b98d-c866fc94547d",
                                                "sense_id": "54b5f49c-3143-33e2-9816-d345d84a9b2b",
                                                "text": "A few portables, particularly the small laphelds, go one step further and come with software built into the computer."
                                            },
                                            {
                                                "example_id": "96cacea2-5797-46f4-8fac-49d12662796c",
                                                "sense_id": "54b5f49c-3143-33e2-9816-d345d84a9b2b",
                                                "text": "Compaq portables have grown lighter and more powerful since then. Their newest luggable, the Compaq Portable III, is six times more powerful and 10 pounds lighter than the original model."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6550fd77-3651-34bd-80ce-9dc8952fe201",
                                        "entry_id": "a2e7c99a-8e60-34dc-901d-18538aaca39d",
                                        "glosses": [
                                            "A hand-held video gaming device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0a34169-ff60-4a20-a100-3addc66d87e8",
                        "source_entry_id": "7222f02d-61a0-31bc-bcb0-e7b7ed928e14",
