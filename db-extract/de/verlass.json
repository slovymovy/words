                "senses": [
                    {
                        "sense_id": "ced7a217-4060-37c6-9df5-dc0fd2f49463",
                        "entry_id": "e1d372a1-624c-33c6-a0fe-5338cc963834",
                        "glosses": [
                            "Confiance, conviction qu'on peut se fier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e6baa1-992b-42dc-86e9-e2a599e9f7ce",
                                "sense_id": "ced7a217-4060-37c6-9df5-dc0fd2f49463",
                                "text": "Hier ist wirklich auf nichts Verlass!",
                                "translation": "Ici, on ne peut vraiment faire confiance à rien !"
                            },
                            {
                                "example_id": "c9a38d94-3409-480b-a63d-e8b2ca4e4370",
                                "sense_id": "ced7a217-4060-37c6-9df5-dc0fd2f49463",
                                "text": "Auf uns ist Verlass: Wir sorgen für Ihr hochwertiges Trinkwasser!",
                                "translation": "Vous pouvez nous faire confiance : nous assurons votre eau potable de qualité !"
                            }
                        ]
                    },
                    {
                        "sense_id": "82002e26-60bc-3986-a437-2781a9de820a",
                        "entry_id": "e1d372a1-624c-33c6-a0fe-5338cc963834",
                        "glosses": [
                            "Héritage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "48488e36-0836-46c4-bb26-2244c025469e",
                                "sense_id": "82002e26-60bc-3986-a437-2781a9de820a",
                                "text": "Aus dem Verlasse des ersten ständig angestellten Missionars Albrecht Graf Meran (1902-1928) gelangte die Kirche in den Besitz seines Kelches und des sogenannten Froschfeldes.",
                                "translation": "De l'héritage du premier missionnaire permanent Albrecht, compte de Meran (1902-1928), l'église arriva en possession de son calice et du dénommé champ de grenouilles."
                            }
                        ]
                    }
