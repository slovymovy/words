                "senses": [
                    {
                        "sense_id": "5d7857d7-884b-3b0f-a1ff-e04a945e013d",
                        "entry_id": "6b97c110-72db-30ab-a73d-e32b08e12cf6",
                        "glosses": [
                            "fiktive, von der Wirklichkeit abweichende Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a14273-e3d6-483d-ac36-0ec4f44e0def",
                                "sense_id": "5d7857d7-884b-3b0f-a1ff-e04a945e013d",
                                "text": "„Träumen Sie konfuse Dinge, beispielsweise von fliegenden Elefanten, die Sie durch eine Fantasiewelt führen, in der Sie womöglich noch der Held sind?“"
                            },
                            {
                                "example_id": "dbeb11e1-aa66-4d4d-b92e-b8b9d84091bb",
                                "sense_id": "5d7857d7-884b-3b0f-a1ff-e04a945e013d",
                                "text": "„Du flüchtest wie meine Mutter in eine Fantasiewelt und verlierst jeden Sinn für die Realität.“"
                            },
                            {
                                "example_id": "55960e89-9e0e-4d28-897d-753577776f92",
                                "sense_id": "5d7857d7-884b-3b0f-a1ff-e04a945e013d",
                                "text": "„In meiner Fantasiewelt würde jeder Mensch auf der Welt gesund werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
