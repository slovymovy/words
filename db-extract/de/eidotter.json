                "senses": [
                    {
                        "sense_id": "a6bc78bc-f954-3c61-bf9b-c437c0202a23",
                        "entry_id": "4e21f050-94a6-3ae9-a297-e99d1003b8c9",
                        "glosses": [
                            "innerer gelbfarbener Bereich des Eis, der die eigentlichen Nährstoffe für den heranwachsenden Embryo beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "342863fd-62d5-425a-850a-ec6114b86c93",
                                "sense_id": "a6bc78bc-f954-3c61-bf9b-c437c0202a23",
                                "text": "„Im Eidotter finden sich besonders viele Antioxidantien in Form von Carotinoiden.“"
                            },
                            {
                                "example_id": "2a9de172-75e2-4ed5-893c-4950d78553cf",
                                "sense_id": "a6bc78bc-f954-3c61-bf9b-c437c0202a23",
                                "text": "„Ich konnte mich an dem Löffel festhalten, konnte die Bohnen erkennen, Spuren von Eiweiß und Eidotter darin, die Scheibe Brot, die immer kleiner wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "170974a9-adbc-4b3c-9b82-7362d2de4e03",
                        "source_entry_id": "4e21f050-94a6-3ae9-a297-e99d1003b8c9",
                        "source_sense_id": "a6bc78bc-f954-3c61-bf9b-c437c0202a23",
                        "source_sense_description": "innerer gelbfarbener Bereich des Eis",
                        "target_lang_word": "yolk",
