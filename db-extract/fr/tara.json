                "senses": [
                    {
                        "sense_id": "3e7a8639-e2a5-3e38-9e63-81d21194a771",
                        "entry_id": "9c69c938-8e02-3976-8de1-d20f220280a4",
                        "glosses": [
                            "Lit et siège bas africain fait de branches entrecroisées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14eb205a-bca2-4d9f-bbf0-6a68e5373aca",
                                "sense_id": "3e7a8639-e2a5-3e38-9e63-81d21194a771",
                                "text": "C’était une pièce étroite et obscure; la moitié à droite de la porte était occupée par un immense tara, lit soudanais, claie de bambou, garnie de nattes, de tapis d’agneau noir et d’une profusion de coussins en peau travaillée."
                            },
                            {
                                "example_id": "3433df34-415a-43d4-b4e8-58bec2cdf8c8",
                                "sense_id": "3e7a8639-e2a5-3e38-9e63-81d21194a771",
                                "text": "Alors il s’étendit sur un tara, sorte de sofa en lattes légères que fabriquent les nègres des bords de la Gambie ; puis il prit dans sa veste une lettre qu’il se mit à lire, après l’avoir baisée à l’endroit de la signature."
                            }
                        ]
                    }
