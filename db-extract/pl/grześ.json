                "senses": [
                    {
                        "sense_id": "3c863099-a493-35c8-95d0-b8e022489f6d",
                        "entry_id": "47af5bf3-9711-3461-b549-3c8ad8978b05",
                        "glosses": [
                            "poufała forma męskiego imienia Grzegorz"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "826fbf75-27f4-416e-9486-79ee270772c5",
                                "sense_id": "3c863099-a493-35c8-95d0-b8e022489f6d",
                                "text": "Grześ spadł z roweru i złamał szczękę."
                            },
                            {
                                "example_id": "17a76055-855f-4bee-9f67-346d513aab07",
                                "sense_id": "3c863099-a493-35c8-95d0-b8e022489f6d",
                                "text": "Mój syn Grześ na tegoroczny obóz harcerski pojedzie w Bieszczady."
                            },
                            {
                                "example_id": "7b140a07-42f2-4fc7-8b68-e40ab561b2dd",
                                "sense_id": "3c863099-a493-35c8-95d0-b8e022489f6d",
                                "text": "Idzie Grześ / Przez wieś, / Worek piasku niesie, / A przez dziurkę / Piasek ciurkiem / Sypie się za Grzesiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
