                        ]
                    },
                    {
                        "translation_id": "ec18f605-4cdb-4e65-904c-8f5c176becc8",
                        "source_entry_id": "a0ef7348-58a2-3712-9a30-1788d9d64e3e",
                        "source_sense_id": "d31e7605-952b-3ec2-846b-93fe7df341bf",
                        "source_sense_description": "in hogere mate",
                        "target_lang_word": "vornehmlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vornehmlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb04fed-432a-3730-9f46-db3ba84671d8",
                                        "entry_id": "1ef0b2f7-f5fb-343b-9e11-165b625f754f",
                                        "glosses": [
                                            "in besonderer Weise, vor allem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4805763-0cd5-4578-9c87-d55e4d4e1431",
                                                "sense_id": "6bb04fed-432a-3730-9f46-db3ba84671d8",
                                                "text": "„Entstanden in wundersamer Co-Evolution, hilft Musik dabei, uns in einer vornehmlich von Sprache und Verstand geprägten Welt mit uralten emotionalen Bedürfnissen zu versöhnen.“"
                                            },
                                            {
                                                "example_id": "80c7c60c-af1a-441c-b78f-fdd617d1dd01",
                                                "sense_id": "6bb04fed-432a-3730-9f46-db3ba84671d8",
                                                "text": "„Unterrichtet worden sei zudem vornehmlich im Stile des Frontalunterrichts.“"
                                            },
                                            {
                                                "example_id": "152f7fe0-09d4-4ff2-adb9-16e590175c29",
                                                "sense_id": "6bb04fed-432a-3730-9f46-db3ba84671d8",
                                                "text": "„Auch der Q8 ist ein Crossover, er wird vornehmlich elektrisch und per Plug-in-Hybrid angetrieben, Debüt wahrscheinlich nicht vor 2018.“"
                                            },
                                            {
                                                "example_id": "63069994-e56f-4b38-ae0f-8a0653dfaf48",
                                                "sense_id": "6bb04fed-432a-3730-9f46-db3ba84671d8",
                                                "text": "„Diese in erster Linie von Angst-Lust-Gefühlen geprägte Art, Fallen zu gustieren, ist jedoch nicht allein und durchgängig kennzeichnend für das Fallerleben. Sie ist vornehmlich für den Erstfaller und Neuling des Bungeejumping typisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4e7a179-21ee-456b-bd91-67363c17ce4d",
                        "source_entry_id": "a0ef7348-58a2-3712-9a30-1788d9d64e3e",
                        "source_sense_id": "d31e7605-952b-3ec2-846b-93fe7df341bf",
                        "source_sense_description": "in hogere mate",
