                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "880e58cd-7107-4ad8-9ec6-eb5f345b7820",
                                "sense_id": "99eca7a5-12d5-3258-af5e-437a1388c4b7",
                                "text": "Not satisfied with tomahawking our colleagues in the country, they ask the scanty remnant in the House to join in the scalp dance."
                            }
                        ]
                    },
                    {
                        "sense_id": "39b9e6b3-1690-37a3-b568-df5e1e396a97",
                        "entry_id": "705fc4d5-004c-31ee-8c28-59f77db35e1d",
                        "glosses": [
                            "环绕或砍倒（一块土地）周围的树木，以获得它的所有权。"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "bd57c719-636c-404d-a91f-595fd6d09fd0",
                                "sense_id": "39b9e6b3-1690-37a3-b568-df5e1e396a97",
                                "text": "Meantime, Silas Zane passed on and came to the forks, and admiring the locality, he tomahawked his right to it, securing one thousand acres."
                            }
                        ]
                    }
