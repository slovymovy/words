                    {
                        "translation_id": "a30b1294-b59c-4f88-98ee-17b202af95bd",
                        "source_entry_id": "cd097724-0d66-3a43-83f3-2136ea0d1b17",
                        "source_sense_id": "a28d0278-3f5c-31c3-9dd6-42e0b8abece3",
                        "target_lang_word": "Poster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88dafae5-5517-3c27-a14b-5a91481c1c14",
                                        "entry_id": "ba8e272d-dbc2-3503-b114-0c42540ba2fa",
                                        "glosses": [
                                            "Plakat mit künstlerischem oder provozierendem Anspruch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afc84aad-0981-4cc5-9403-d6e40bae85fb",
                                                "sense_id": "88dafae5-5517-3c27-a14b-5a91481c1c14",
                                                "text": "Das Poster meines Lieblingsschauspielers hängt an der Wand."
                                            },
                                            {
                                                "example_id": "bc255225-cc86-4265-90bd-d734be6e848c",
                                                "sense_id": "88dafae5-5517-3c27-a14b-5a91481c1c14",
                                                "text": "„Ich habe die Zeiten der strengen Rassentrennung in den Vereinigten Staaten nicht mehr erlebt, ich musste nie im Bus hinten stehen, doch als ich aus den tristen Fluren der Berliner Ausländerpolizei in ein frisch gestrichenes Zimmer mit Topfpflanzen und Postern gebeten wurde, konnte ich mich des Gefühls nicht erwehren, dass man mich durch den Eingang für Gewöhnliche gelassen hatte.'Buschgirl. Wie ich unter die Deutschen geriet, Bertelsmann, München 2010, Seite 68, ISBN 978-3-570-10042-4."
                                            },
                                            {
                                                "example_id": "2322a975-4488-4643-b8af-3f2728561136",
                                                "sense_id": "88dafae5-5517-3c27-a14b-5a91481c1c14",
                                                "text": "„Vorsorglich knipst Siegfried die großen Poster an den Wänden.“"
                                            },
                                            {
                                                "example_id": "0428310b-4522-4563-9cad-58db4f3facac",
                                                "sense_id": "88dafae5-5517-3c27-a14b-5a91481c1c14",
                                                "text": "„An den Wänden hingen zwei Poster.“"
                                            },
                                            {
                                                "example_id": "2a2227d9-0e57-4515-8b56-0091b68e4d39",
                                                "sense_id": "88dafae5-5517-3c27-a14b-5a91481c1c14",
                                                "text": "„Ich halte doch noch kurz inne und betrachte das Poster genauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25f6cbd9-2e8e-3fa0-a899-e3565c610a79",
                                        "entry_id": "ba8e272d-dbc2-3503-b114-0c42540ba2fa",
                                        "glosses": [
                                            "Schautafel bei einem wissenschaftlichen Kongress"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efbc796a-a11b-4dfe-a9f9-3980eea9dd1d",
                                                "sense_id": "25f6cbd9-2e8e-3fa0-a899-e3565c610a79",
                                                "text": "Professor Hartmann redet nicht, aber die Arbeitsgruppe ist mit einem Poster vertreten."
                                            },
                                            {
                                                "example_id": "1f8c8447-b84a-497b-bd1d-5889705af9b6",
                                                "sense_id": "25f6cbd9-2e8e-3fa0-a899-e3565c610a79",
                                                "text": "„An seinem Schreibtisch hingen ein Poster von Homer Simpson, ein Kalender der NASA, ein Poster mit dem Namen »Pale Blue Dot« und eine Kopie seiner Promotionsurkunde, die lediglich mit einer Heftzwecke an der Wand fixiert war.“"
                                            },
                                            {
                                                "example_id": "ccbb6ab4-5a57-4dfc-bfcc-a9f0f4495b09",
                                                "sense_id": "25f6cbd9-2e8e-3fa0-a899-e3565c610a79",
                                                "text": "„In einem iranischen Reisebüro hatte ich einmal ein Poster hängen sehen, lange vor dem Erdbeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Poster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "733b2319-3cef-33ac-8b8a-ce3a3b66c2dc",
                                        "entry_id": "9cd3d567-4437-30eb-9207-1f0f154e6966",
                                        "glosses": [
                                            "Verfasser eines Posts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d79a644b-8c45-4242-83b2-2ec9f635216c",
                                                "sense_id": "733b2319-3cef-33ac-8b8a-ce3a3b66c2dc",
                                                "text": "„Nun stellt sich die Frage: Werden anonyme Poster in Zeitungsforen auch vom Redaktionsgeheimnis geschützt?“"
                                            },
                                            {
                                                "example_id": "88c7444e-2b9f-44cd-8cf1-9ed4b013a5b5",
                                                "sense_id": "733b2319-3cef-33ac-8b8a-ce3a3b66c2dc",
                                                "text": "„Keiner der Poster reflektiert freilich etwa die kritische Perzeption von multiethnischen Teams des rechten Lagers in Frankreich.“"
                                            },
                                            {
                                                "example_id": "4acf48a8-f0a6-433d-9fb3-96de19d2009a",
                                                "sense_id": "733b2319-3cef-33ac-8b8a-ce3a3b66c2dc",
                                                "text": "„Machen Sie sich einmal den Spaß und lesen Sie im Internet einen beliebigen Diskussionsthread zu einem beliebigen Thema daraufhin durch, welches wohl das spezielle Fritzchenthema zumindest einiger der Poster ist.“"
                                            },
                                            {
                                                "example_id": "4b656e8d-8102-4f95-a24c-7620f2af03a7",
                                                "sense_id": "733b2319-3cef-33ac-8b8a-ce3a3b66c2dc",
                                                "text": "„Diese Kombination aus Formularskript und Anzeigeskript ist praktisch – so sieht der Poster auch die anderen Beiträge.“"
                                            },
                                            {
                                                "example_id": "c03c472d-9d51-45ad-ae4e-97336328e561",
                                                "sense_id": "733b2319-3cef-33ac-8b8a-ce3a3b66c2dc",
                                                "text": "„Ein Poster meinte etwa, ‚der ganze Muslime-Scheißhaufen‘ gehöre angezündet, berichtete die Presse und kommentierte dazu: ‚Die FPÖ profitiert normalerweise von negativen Schlagzeilen. […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
