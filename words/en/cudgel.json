                    "frequency": "Low",
                    "semantic_group_id": "weapon_club",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard hefted his <w>cudgel</w> menacingly and looked at the prisoners."
                        },
                        {
                            "text": "He grabbed a thick wooden <w>cudgel</w> to protect himself from the attackers."
                        }
                    ],
                    "synonyms": [
                        "bludgeon",
                        "club",
                        "truncheon"
                    ],
                    "common_phrases": [
