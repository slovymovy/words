                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611546ea-1b59-4e2b-a3fc-83ed1501cae8",
                                "sense_id": "ca05a307-2e59-3f47-898d-894835865fe8",
                                "text": "Het Oekraïense leger zegt steeds meer terrein te winnen op pro-Russische separatisten. Met het legeroffensief dat nu zijn derde dag ingaat, hoopt de Oekraïense regering het gezag in het oosten van het land weer te herstellen. Speciale eenheden van het leger zijn bezig met operaties bij Slavjansk, Kramatorsk, Konstantinovka en bij Loegansk, ten oosten van Donetsk."
                            },
                            {
                                "example_id": "7b317cf3-21e1-47c0-88f1-fff3fb8331ec",
                                "sense_id": "ca05a307-2e59-3f47-898d-894835865fe8",
                                "text": "Het Jemenitische ministerie van Defensie meldt dat de operatie werd uitgevoerd in het zuiden van het land, in de provincie Shebua. De aanval maakt deel uit van een legeroffensief in het gebied dat vorige week van start ging."
                            }
                        ]
                    }
