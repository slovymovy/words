                ],
                "senses": [
                    {
                        "sense_id": "de0bc1b3-4b1e-3216-be01-8555d34e3088",
                        "entry_id": "d13b6f0a-9144-3aae-b6e2-c43933b1579d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3a4740a-c291-429b-adbb-98752006dce9",
                                "sense_id": "de0bc1b3-4b1e-3216-be01-8555d34e3088",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lämmel kommt, geht der Herr Lämmel.“"
                            },
                            {
                                "example_id": "572809e9-766c-4764-9512-a5e2f72744b7",
                                "sense_id": "de0bc1b3-4b1e-3216-be01-8555d34e3088",
                                "text": "Lämmel kommt und geht."
                            },
                            {
                                "example_id": "1b7ed644-e2fc-4305-846e-2663e815637a",
                                "sense_id": "de0bc1b3-4b1e-3216-be01-8555d34e3088",
                                "text": "Lämmels kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d2a980c5-5f67-48a5-a453-9340a85e4562",
                                "sense_id": "de0bc1b3-4b1e-3216-be01-8555d34e3088",
                                "text": "Frau Lämmel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d0a7e517-5fe5-4ee6-94fa-cd916a3b968f",
                                "sense_id": "de0bc1b3-4b1e-3216-be01-8555d34e3088",
                                "text": "Herr Lämmel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "66aa0a79-a52b-454f-a6a8-f348a0ef9faa",
                                "sense_id": "de0bc1b3-4b1e-3216-be01-8555d34e3088",
                                "text": "Die Lämmels fahren heute nach Jena."
                            },
                            {
                                "example_id": "c27c95d0-ebbc-4b5f-a77b-8467ea09d708",
                                "sense_id": "de0bc1b3-4b1e-3216-be01-8555d34e3088",
                                "text": "Der Lämmel trägt nie die Schals, die die Lämmel ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
