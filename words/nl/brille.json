                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Brillanz",
                                "target_lang_sense_clarification": "Glanz, meisterhaftes Können"
                            },
                            {
                                "target_lang_word": "der Glanz",
                                "target_lang_sense_clarification": "hervorragende Leistung, Meisterschaft"
                            },
                            {
                                "target_lang_word": "die Verve",
                                "target_lang_sense_clarification": "Schwung, meisterhafte Begeisterung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2ecb545-a9ce-3960-83f6-04709df747c0",
                    "sense_definition": "Aanvoegende wijs van <w>brillen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men eiste dat de valkenier de jonge roofvogel voorzichtig <w>brille</w>.",
                            "target_lang_translations": {
                                "de": "Man forderte, dass der Falkner den jungen Greifvogel vorsichtig <w>verhaube</w>."
                            }
                        },
                        {
                            "text": "Het protocol schreef voor dat men de valk tijdig <w>brille</w>.",
                            "target_lang_translations": {
