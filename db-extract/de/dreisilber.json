                ],
                "senses": [
                    {
                        "sense_id": "79c5d69d-1a15-3f8d-b09f-82acd9982a5a",
                        "entry_id": "07c01540-0bac-38d4-9f89-d2c8f7ec659b",
                        "glosses": [
                            "Wort, das aus drei Silben besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404773f1-aba8-4a07-8121-476698339e93",
                                "sense_id": "79c5d69d-1a15-3f8d-b09f-82acd9982a5a",
                                "text": "„So beantwortet Abbildung 1 die Frage, mit wieviel Prozent die Einsilber, Zweisilber, Dreisilber undsoweiter in Werken von Goethe, Rilke, Cäsar und Sallust vorkommen.“"
                            },
                            {
                                "example_id": "173fd170-d1cd-4cfe-8d93-7295728f9487",
                                "sense_id": "79c5d69d-1a15-3f8d-b09f-82acd9982a5a",
                                "text": "„Der minimale Fuß ist der Zweisilber aus betonter und unbetonter Silbe, der maximale der Dreisilber.“"
                            },
                            {
                                "example_id": "c9be4a8f-9eb8-4af4-8fe0-a55e8c000044",
                                "sense_id": "79c5d69d-1a15-3f8d-b09f-82acd9982a5a",
                                "text": "„Bremen hatte es ihm ja auch nicht schwer gemacht; erstaunlich textsicher hatten die Fans beim Aufstellungsanbrüllen den brüllunfreundlichen Dreisilber La-ger-blom zu Gehör gebracht, und nach dem Spiel stand der Dreisilber heimatlich gestimmt im Regen. “"
                            },
                            {
                                "example_id": "6c23889a-ba57-4b59-89ea-e14d8222ed4d",
                                "sense_id": "79c5d69d-1a15-3f8d-b09f-82acd9982a5a",
                                "text": "„Bei Dreisilbern mit nur einer betonten Silbe, die die erste oder zweite Position einnimmt, wird die betonte sowie die unmittelbar darauffolgende unbetonte Silbe unter Weglassen der dritten Silbe realisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
