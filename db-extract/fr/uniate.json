                "forms": [
                    {
                        "form_id": "94c393ce-b541-476c-8179-ab3e1d7515e0",
                        "entry_id": "47fe2c0d-270a-3254-9c63-b85fa5536965",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
