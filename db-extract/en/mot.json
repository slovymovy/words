                "senses": [
                    {
                        "sense_id": "302f3bf8-90ec-3048-ad4b-59b1b0116e6a",
                        "entry_id": "54f25e80-b61a-3a95-9959-777d0f8e81ce",
                        "glosses": [
                            "A witty remark; a witticism; a bon mot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc058da-92c6-4df9-b875-81790e06ea4f",
                                "sense_id": "302f3bf8-90ec-3048-ad4b-59b1b0116e6a",
                                "text": "Here and there turns up a […] savage mot."
                            },
                            {
                                "example_id": "c5265167-68ad-4869-a233-aa13e848e3fc",
                                "sense_id": "302f3bf8-90ec-3048-ad4b-59b1b0116e6a",
                                "text": "‘He comes from Montreal, in Canada.’ ‘Why?’ she said, repeating Dr Johnson's mot with a forced sneer."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d71a8cd-e329-3bf2-844c-31f30c64d6fa",
                        "entry_id": "54f25e80-b61a-3a95-9959-777d0f8e81ce",
                        "glosses": [
                            "A word or a motto; a device."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3587b2c0-6016-4f15-b51f-ac8330afdadc",
                                "sense_id": "2d71a8cd-e329-3bf2-844c-31f30c64d6fa",
                                "text": "1597–1598, Joseph Hall, Virgidemiarum\nWith his big title, an Italian mot"
                            },
                            {
                                "example_id": "0fd12142-792c-40e7-a8d5-def80f51befb",
                                "sense_id": "2d71a8cd-e329-3bf2-844c-31f30c64d6fa",
                                "text": "Tarquin's eye may read the mot afar."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2148059-0048-3c5f-a442-af647ee2a8ac",
                        "entry_id": "54f25e80-b61a-3a95-9959-777d0f8e81ce",
                        "glosses": [
                            "A note or brief strain on a bugle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1fe45d05-b469-4d52-9d49-b42f86bac867",
                                "sense_id": "a2148059-0048-3c5f-a442-af647ee2a8ac",
                                "text": "Comrades, mark these three mots — it is the call of the Knight of the Fetterlock"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
