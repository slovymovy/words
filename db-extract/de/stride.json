                        "target_lang_word": "stride",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a62d09-075c-35bc-aa1d-2f96a8886aae",
                                        "entry_id": "967bd7e3-5f5d-3f17-a26a-605aca4bbad4",
                                        "glosses": [
                                            "To walk with long steps."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb710b6-cc4a-4253-a3bf-1810bf5de8a8",
                                                "sense_id": "c2a62d09-075c-35bc-aa1d-2f96a8886aae",
                                                "text": "Mars in the middle of the shining shield / Is grav'd, and strides along the liquid field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c878cd4-2ff3-313a-bf37-29a6455710e0",
                                        "entry_id": "967bd7e3-5f5d-3f17-a26a-605aca4bbad4",
                                        "glosses": [
                                            "To stand with the legs wide apart; to straddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30827fa6-00d0-3a74-843a-a1349dac1217",
                                        "entry_id": "967bd7e3-5f5d-3f17-a26a-605aca4bbad4",
                                        "glosses": [
                                            "To pass over at a step; to step over."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de81622f-9775-41dd-96fd-0ffbf4dd24c1",
                                                "sense_id": "30827fa6-00d0-3a74-843a-a1349dac1217",
                                                "text": "a debtor that not dares to stride a limit"
                                            },
                                            {
                                                "example_id": "0e862350-b02f-4da0-9c83-27156c5ae516",
                                                "sense_id": "30827fa6-00d0-3a74-843a-a1349dac1217",
                                                "text": "For SAC66 is better known as Batty Moss (or Ribblehead) Viaduct - the magnificent, Grade 2-listed, 24-arch structure that strides over the pockmarked ground between Ribblehead station and Blea Moor signal box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "028682d5-d23a-3dde-9742-e56f63f2fcd4",
                                        "entry_id": "967bd7e3-5f5d-3f17-a26a-605aca4bbad4",
                                        "glosses": [
                                            "To straddle; to bestride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7edc469a-dc0f-44ec-b199-2ba5999d2328",
                                                "sense_id": "028682d5-d23a-3dde-9742-e56f63f2fcd4",
                                                "text": "I mean to stride your steed."
                                            },
                                            {
                                                "example_id": "964facac-9403-412c-a86d-c38e7597f678",
                                                "sense_id": "028682d5-d23a-3dde-9742-e56f63f2fcd4",
                                                "text": "The air and manner of the horseman bespoke him of superior order;[…]. The rich housings of the beast he strode, proclaimed its owner of illustrious race; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffdb9cc9-1a81-393f-85c5-525723a21935",
                                        "entry_id": "ca6aa11d-56d3-31d9-8e06-e4503212ac98",
                                        "glosses": [
                                            "A long step in walking."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9009dfa6-b1fd-4956-9c23-d27a2879d651",
                                                "sense_id": "ffdb9cc9-1a81-393f-85c5-525723a21935",
                                                "text": "Still, a dozen men with rifles, and cartridges to match, stayed behind when they filed through a white aldea lying silent amid the cane, and the Sin Verguenza swung into slightly quicker stride."
                                            },
                                            {
                                                "example_id": "5ed4696a-594e-4f6b-868c-1528dbff5f95",
                                                "sense_id": "ffdb9cc9-1a81-393f-85c5-525723a21935",
                                                "text": "An utterly emphatic 5-0 victory was ultimately capped by two wonder strikes in the last two minutes from Aston Villa midfielder Gary Gardner. Before that, England had utterly dominated to take another purposeful stride towards the 2013 European Championship in Israel. They have already established a five-point buffer at the top of Group Eight."
                                            },
                                            {
                                                "example_id": "4796de8b-95e3-4ac1-a1f2-191b017f926c",
                                                "sense_id": "ffdb9cc9-1a81-393f-85c5-525723a21935",
                                                "text": "Rail technology advanced step by step - albeit electrification was a good stride, rather than a short step."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f82b18b8-f9aa-3a25-bee8-fbaa19a97f8b",
                                        "entry_id": "ca6aa11d-56d3-31d9-8e06-e4503212ac98",
                                        "glosses": [
                                            "The distance covered by a long step."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f2737b6-1377-332b-b862-8f0b6fa6c9c2",
                                        "entry_id": "ca6aa11d-56d3-31d9-8e06-e4503212ac98",
                                        "glosses": [
                                            "The number of memory locations between successive elements in an array, pixels in a bitmap, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed9deda-255b-4116-8f66-e559a9b3b5e9",
                                                "sense_id": "2f2737b6-1377-332b-b862-8f0b6fa6c9c2",
                                                "text": "This stride value is generally equal to the pixel width of the bitmap times the number of bytes per pixel, but for performance reasons it might be rounded […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5699ad4b-03ea-3713-bb1d-3d2252d1bfa6",
                                        "entry_id": "ca6aa11d-56d3-31d9-8e06-e4503212ac98",
                                        "glosses": [
                                            "A jazz piano style of the 1920s and 1930s. The left hand characteristically plays a four-beat pulse with a single bass note, octave, seventh or tenth interval on the first and third beats, and a chord on the second and fourth beats."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
