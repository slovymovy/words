                "senses": [
                    {
                        "sense_id": "1c04bac6-6bd0-3971-b64f-f78ca5334caa",
                        "entry_id": "be014298-ca3b-37e6-8912-5fec99f24007",
                        "glosses": [
                            "Genre de coléoptères à couleur métallique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8143e877-c5b3-42d6-bf60-cf67be66e2c7",
                                "sense_id": "1c04bac6-6bd0-3971-b64f-f78ca5334caa",
                                "text": "Une cétoine égarée traversa le faisceau, y jetant un bref éclair métallique."
                            },
                            {
                                "example_id": "8558a27f-b856-44b5-a295-81dd3f6f84e8",
                                "sense_id": "1c04bac6-6bd0-3971-b64f-f78ca5334caa",
                                "text": "Un bocal contenant la suite des métamorphoses du Cétoine doré — Cetonia aurata L."
                            },
                            {
                                "example_id": "42a1173a-2e05-4c4d-ac19-f76a79d49bd7",
                                "sense_id": "1c04bac6-6bd0-3971-b64f-f78ca5334caa",
                                "text": "Les fleurs sont parfois attaquées par le cétoine doré ; les fruits et les graines sont minés par les balanins (faîne, châtaigne et gland)."
                            },
                            {
                                "example_id": "d538ec2a-0e59-499f-8924-59441af7c702",
                                "sense_id": "1c04bac6-6bd0-3971-b64f-f78ca5334caa",
                                "text": "Que toute douleur soit en toi le passage d’un insecte qui va s’envoler. Ne te referme pas sur l’insecte rongeur. Ne deviens pas amoureux de ces carabes noirs.\nQue toute joie soit en toi le passage d’un insecte qui va s’envoler. Ne te referme pas sur l’insecte suceur. Ne deviens pas amoureux de ces cétoines dorées."
                            }
                        ]
                    }
                ],
