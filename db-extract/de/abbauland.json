                "senses": [
                    {
                        "sense_id": "47cd0c1c-b65a-3ba5-947e-6d34586cfa2f",
                        "entry_id": "a5026149-241d-33d6-a61d-712336524fba",
                        "glosses": [
                            "Staat, in dem bestimmte Rohstoffen abgebaut werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2803742-bcac-439e-954f-329f111a9456",
                                "sense_id": "47cd0c1c-b65a-3ba5-947e-6d34586cfa2f",
                                "text": "„2020 wurden weltweit 4,2 Millionen Tonnen Perlit abgebaut. Größte Abbauländer waren China gefolgt von der Türkei, Griechenland (auf der Insel Milos) und den USA, welche zusammen 92 % der globalen Abbaumengen stellten.“"
                            },
                            {
                                "example_id": "f5944cda-0444-4be9-98df-68572cda7976",
                                "sense_id": "47cd0c1c-b65a-3ba5-947e-6d34586cfa2f",
                                "text": "„Die größten Abbauländer von Feldspat waren im Jahr 2020 die Türkei, Italien, Indien, der Iran und China.“"
                            },
                            {
                                "example_id": "c546e0dc-8d9e-4a23-8b8b-f4369b0f64de",
                                "sense_id": "47cd0c1c-b65a-3ba5-947e-6d34586cfa2f",
                                "text": "„Hauptabbauland war China, weitere große Abbauländer waren Australien, Mosambik, Südafrika, Kanada und die Ukraine.“"
                            },
                            {
                                "example_id": "c0040352-62be-44f0-8f87-99962222867c",
                                "sense_id": "47cd0c1c-b65a-3ba5-947e-6d34586cfa2f",
                                "text": "„Größtes Abbauland war China, gefolgt von Marokko, den USA und Russland.“"
                            },
                            {
                                "example_id": "8006fe55-d3f6-42f1-be92-62ccdf936756",
                                "sense_id": "47cd0c1c-b65a-3ba5-947e-6d34586cfa2f",
                                "text": "„2020 wurden weltweit ca. 15,4 Millionen Tonnen Bims abgebaut. Die drei größten Abbauländer waren die Türkei, Griechenland und Uganda.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
