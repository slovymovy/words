                ],
                "translations": [
                    {
                        "translation_id": "5e8b037c-6e83-49a5-8433-2fc1397ce84e",
                        "source_entry_id": "2ba5f26a-4cba-3157-a63d-6b2ce2b63bf5",
                        "source_sense_id": "b29e2013-ece2-355a-ad66-2f2d3ae11dd8",
                        "source_sense_description": "sterkedrank op basis van anijs",
                        "target_lang_word": "Absinth",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absinth",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd5a2a88-31fd-32df-9f4c-e288eba45b2c",
                                        "entry_id": "c1a2f226-bd08-3777-b03d-d56984f42b87",
                                        "glosses": [
                                            "Spirituose, die traditionell aus Wermut, Anis, Fenchel und weiteren Kräutern hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d07efdf-6501-4cae-ab64-509d3cce39a7",
                                                "sense_id": "fd5a2a88-31fd-32df-9f4c-e288eba45b2c",
                                                "text": "Absinth kommt wieder in Mode."
                                            },
                                            {
                                                "example_id": "1724f703-8f27-45a5-a17d-6a9edd01444b",
                                                "sense_id": "fd5a2a88-31fd-32df-9f4c-e288eba45b2c",
                                                "text": "Der Verkauf und Ausschank von Absinth ist erst seit einigen Jahren wieder erlaubt."
                                            },
                                            {
                                                "example_id": "d91d6367-95c1-49f6-a020-ed5b7b940925",
                                                "sense_id": "fd5a2a88-31fd-32df-9f4c-e288eba45b2c",
                                                "text": "„Pernod schmeckt ähnlich wie Absinth.“"
                                            },
                                            {
                                                "example_id": "d3992cc6-109b-41df-be84-ab571595ea0e",
                                                "sense_id": "fd5a2a88-31fd-32df-9f4c-e288eba45b2c",
                                                "text": "„Dann gingen sie in ein Kabarett, wo die Belgier ihren Absinth zu trinken pflegten.“"
                                            },
                                            {
                                                "example_id": "60bd3f3f-fe37-4a58-982e-ecc121d56229",
                                                "sense_id": "fd5a2a88-31fd-32df-9f4c-e288eba45b2c",
                                                "text": "„Als er mit 20 Jahren zum ersten Mal in Paris war, hat sich Zweig sofort ins Café Vachette begeben und Verlaine zu Ehren einen Absinth getrunken, der ihm allerdings scheußlich schmeckte, ein völlig ungeeignetes Mittel, gute Verse zu schreiben.“"
                                            },
                                            {
                                                "example_id": "47980fce-4f0d-43d2-b30f-3232e38e901e",
                                                "sense_id": "fd5a2a88-31fd-32df-9f4c-e288eba45b2c",
                                                "text": "„Kanther fingerte aus seiner Manteltasche einen Flachmann hervor und nahm einen kräftigen Schluck von einem Gesöff, das verdächtig nach Absinth roch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "965c8ede-5fb4-3d3b-9a64-d92e0caee30d",
                                        "entry_id": "c1a2f226-bd08-3777-b03d-d56984f42b87",
                                        "glosses": [
                                            "Pflanze, deren Blätter magenstärkend wirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a04f9ec-bb31-4e4a-9d48-a7dd138905c7",
                                                "sense_id": "965c8ede-5fb4-3d3b-9a64-d92e0caee30d",
                                                "text": "Für die Herstellung der gleichnamigen Spirituose ist die Verwendung von Absinth (Artemisia absinthium) unentbehrlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0928872f-fd29-435d-abf2-3836537c6816",
                        "source_entry_id": "2ba5f26a-4cba-3157-a63d-6b2ce2b63bf5",
