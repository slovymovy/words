                        "glosses": [
                            "Produit qui n'est pas ou n'est plus affecté à une catégorie marchande."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "6606cf5c-7b5f-4a1e-87e2-ac55fb110d44",
                                "sense_id": "4c5cebef-ae0c-399b-9fcc-46bbb352329f",
                                "text": "Par exemple , un crible moderne travaillant dans des conditions normales ne laisse pas plus de 4 à 5 % de déclassés quand il traite des petites catégories du calibre supérieur à 8 mm."
                            }
                        ]
                    }
