                    {
                        "translation_id": "e55e2da2-cf5b-4b66-b9e3-36b17bc104de",
                        "source_entry_id": "62515254-bedf-3698-a8fc-6e85bf5110fe",
                        "source_sense_id": "3499ad98-2912-3cec-b249-a45903b00146",
                        "source_sense_description": "veraltet, poetisch: Lohn",
                        "target_lang_word": "Lohn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lohn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0adc50e-e349-38eb-b2a4-78a318d10851",
                                        "entry_id": "1e52158a-140c-302f-99fe-107b56d9fe73",
                                        "glosses": [
                                            "Vergütung für eine geleistete Arbeit der Arbeiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a84c9a-ed82-48bb-9170-3d37e2cee37e",
                                                "sense_id": "d0adc50e-e349-38eb-b2a4-78a318d10851",
                                                "text": "Die Gewerkschaften fordern höhere Löhne."
                                            },
                                            {
                                                "example_id": "13b9a944-b5fc-47d9-83e0-9232d444d123",
                                                "sense_id": "d0adc50e-e349-38eb-b2a4-78a318d10851",
                                                "text": "„Die Löhne der Arbeiter sind kaum mehr als Almosen.“"
                                            },
                                            {
                                                "example_id": "e54d5089-6678-4983-b5b4-c6e5753c7c40",
                                                "sense_id": "d0adc50e-e349-38eb-b2a4-78a318d10851",
                                                "text": "„Natürlich hatte ich nichts dagegen, und so bezahlte ich Kaba, Sékou und Kourou die ausstehende Hälfte ihres Lohns aus und gab jedem einen zusätzlichen Betrag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c079f61d-478a-3ccc-a5bd-d273fd17e6f2",
                                        "entry_id": "1e52158a-140c-302f-99fe-107b56d9fe73",
                                        "glosses": [
                                            "Konsequenz oder Resultat einer Handlung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4c77e84-7d24-4891-884f-8966151b8fca",
                                                "sense_id": "c079f61d-478a-3ccc-a5bd-d273fd17e6f2",
                                                "text": "Und was war der Lohn für all seine Mühe?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
