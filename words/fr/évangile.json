    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cc32d96-c13f-383d-a643-5d2c08f7456e",
                    "sense_definition": "Chacun des récits canoniques de la vie et des enseignements de Jésus-Christ qui forment la première partie du Nouveau Testament.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religion_texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre a lu un passage de l'<w>évangile</w> selon saint Matthieu avant son sermon."
                        },
                        {
                            "text": "Le Nouveau Testament s'ouvre traditionnellement sur les quatre <w>évangiles</w> canoniques."
                        }
                    ],
                    "common_phrases": [
                        "quatre évangiles",
                        "évangile selon saint Luc"
                    ]
                },
                {
                    "sense_id": "2c08b34f-1120-3587-90cb-b33036f9ea4d",
                    "sense_definition": "Ensemble des quatre textes sacrés de la tradition chrétienne, ou le livre liturgique qui les réunit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion_texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin s'est avancé vers la barre pour prêter serment et jurer sur l'<w>évangile</w>."
                        },
                        {
                            "text": "Ce livre ancien contient tout l'<w>évangile</w> relié dans un cuir magnifique."
                        }
                    ],
                    "common_phrases": [
                        "jurer sur l'évangile",
                        "livre de l'évangile"
                    ]
                },
                {
                    "sense_id": "ac3c45b6-f09d-3c34-a7cc-343aae264fee",
                    "sense_definition": "Vérité indiscutable, principe directeur ou ouvrage qui fait autorité absolue auprès d'un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas prendre chaque affirmation d'un collègue pour parole d'<w>évangile</w>."
                        },
                        {
                            "text": "Ce manuel d'économie est devenu le véritable <w>évangile</w> des jeunes entrepreneurs modernes."
                        }
                    ],
                    "synonyms": [
                        "dogme",
                        "vérité"
                    ],
                    "common_phrases": [
                        "parole d'évangile"
                    ]
                },
                {
                    "sense_id": "43e8189b-c2ff-3da9-8d71-787d6d6086a9",
                    "sense_definition": "Passage des textes sacrés lu ou chanté par le célébrant lors de la messe chrétienne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion_liturgie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les fidèles se sont levés avec respect pendant la proclamation de l'<w>évangile</w> du dimanche."
                        },
                        {
                            "text": "Après la lecture de l'<w>évangile</w>, l'officiant a entamé son homélie devant les fidèles."
                        }
                    ],
                    "common_phrases": [
                        "lecture de l'évangile"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0b54333a-dd38-374e-8865-07c0e22fe0df",
                    "sense_definition": "Message de salut et d'espérance proclamé par Jésus-Christ à l'humanité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion_doctrine",
                    "name_type": "religion_or_philosophy_name",
                    "examples": [
                        {
                            "text": "Les premiers apôtres ont parcouru le monde pour proclamer l'<w>Évangile</w> aux nations."
                        },
                        {
                            "text": "La diffusion de l'<w>Évangile</w> a profondément transformé la société méditerranéenne antique."
                        }
                    ],
                    "synonyms": [
                        "Bonne Nouvelle"
                    ],
                    "common_phrases": [
                        "annoncer l'Évangile",
                        "proclamer l'Évangile"
                    ]
                }
            ]
        }
    ]
}