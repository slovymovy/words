                        "tags": [
                            "Fromage"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b415b5bb-34c2-3cfa-afff-8fda56a5881e",
                        "entry_id": "2b323981-18f6-3f22-a924-02b9aafc601e",
