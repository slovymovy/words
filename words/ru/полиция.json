{
    "word_family": [
        "полицейский"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08c1a07f-cf57-34d5-af70-09987638666e",
                    "sense_definition": "Система государственных служб по охране общественного порядка и борьбе с преступностью",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если вы увидели преступление, нужно немедленно позвонить в <w>полицию</w>.",
                            "target_lang_translations": {
                                "en": "If you witness a crime, you need to call the <w>police</w> immediately.",
                                "zh": "如果你看到了犯罪行为，需要立即报警，联系<w>警察</w>。"
                            }
                        },
                        {
                            "text": "Мой старший брат уже пять лет служит в <w>полиции</w>.",
                            "target_lang_translations": {
                                "en": "My older brother has been serving in the <w>police</w> for five years.",
                                "zh": "我哥哥已经在<w>警察</w>部门工作五年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "милиция"
                    ],
                    "common_phrases": [
                        "вызвать полицию",
                        "работать в полиции",
                        "отделение полиции",
                        "сотрудник полиции"
                    ],
                    "target_lang_definitions": {
                        "en": "A government agency responsible for maintaining public order and preventing crime",
                        "zh": "负责维护公共秩序和预防犯罪的政府机构"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "police",
                                "target_lang_sense_clarification": "institution"
                            },
                            {
                                "target_lang_word": "police force",
                                "target_lang_sense_clarification": "organization"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "警察",
                                "target_lang_sense_clarification": "指警察机构或警察这一职业"
                            },
                            {
                                "target_lang_word": "警方",
                                "target_lang_sense_clarification": "指警察这一方，常用于新闻报道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcaae159-9576-379e-bc7c-8f6ac26ed6a3",
                    "sense_definition": "Сотрудники этой службы (собирательно)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Через десять минут приехала <w>полиция</w> и оцепила район.",
                            "target_lang_translations": {
                                "en": "Ten minutes later the <w>police</w> arrived and cordoned off the area.",
                                "zh": "十分钟后<w>警察</w>赶到并封锁了该区域。"
                            }
                        },
                        {
                            "text": "<w>Полиция</w> задержала хулиганов прямо на месте происшествия.",
                            "target_lang_translations": {
                                "en": "The <w>police</w> detained the hooligans right at the scene of the incident.",
                                "zh": "<w>警察</w>在案发现场直接拘捕了流氓。"
                            }
                        }
                    ],
                    "synonyms": [
                        "милиция"
                    ],
                    "common_phrases": [
                        "полиция приехала",
                        "бежать от полиции"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление в значении группы людей"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The members of the police force regarded collectively",
                        "zh": "警察机构的成员，集体称呼"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "police",
                                "target_lang_sense_clarification": "officers collectively"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "警察",
                                "target_lang_sense_clarification": "指警察人员"
                            },
                            {
                                "target_lang_word": "警员",
                                "target_lang_sense_clarification": "指具体的警察人员"
                            }
                        ]
                    }
                }
            ]
        }
    ]
