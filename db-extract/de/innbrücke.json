                        "examples": [
                            {
                                "example_id": "50da69f3-65b8-4870-b594-b836dee2fb11",
                                "sense_id": "537ecbe9-01d0-3cee-aa3e-6ce833c33677",
                                "text": "„Erst setzt er sich auf der Innbrücke unnötiger Gefahr aus, die Brücke von Saint-Esprit und die von Lauriol sprengt er in die Luft; in Lyon werden ihm zwei Brücken zum Verhängnis, und vor der Brücke von Sèvres endet sein Glück.“"
                            }
                        ],
