                "senses": [
                    {
                        "sense_id": "f284c6cb-459b-3cbe-acd3-42b98bf1f9e3",
                        "entry_id": "59948643-90cf-31da-89dd-c80d732b7496",
                        "glosses": [
                            "sweet (sugary confection)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "2479e970-d8a8-45d0-8a2a-a6fd0b6881ce",
                                "sense_id": "f284c6cb-459b-3cbe-acd3-42b98bf1f9e3",
                                "text": "Не успе́л э́тот покупа́тель удали́ться, как яви́лся друго́й, пото́м тре́тий … «А ви́дно, рука́ у меня́ лёгкая!» — поду́мал Са́нин. Второ́й потре́бовал стака́н орша́ду, тре́тий — полфу́нта конфе́кт.",
                                "translation": "Before the first customer had walked out, a second appeared, then a third. . . . 'I bring luck, it's clear!' thought Sanin. The second customer wanted a glass of orangeade, the third, half-a-pound of sweets.",
                                "english": "Before the first customer had walked out, a second appeared, then a third. . . . 'I bring luck, it's clear!' thought Sanin. The second customer wanted a glass of orangeade, the third, half-a-pound of sweets."
                            }
                        ]
                    }
