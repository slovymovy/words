    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7578399-8877-3176-897e-12e14fce0d8b",
                    "sense_definition": "De periodieke stijging van de zeespiegel als onderdeel van het getij.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "getijde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij <w>vloed</w> komt het water van de zee veel hoger op het strand te staan.",
                            "target_lang_translations": {
                                "en": "At <w>high tide</w>, the sea water reaches much higher up the beach."
                            }
                        },
                        {
                            "text": "De vissersboot wachtte op de <w>komende</w> <w>vloed</w> om de haven veilig te kunnen verlaten.",
                            "target_lang_translations": {
                                "en": "The fishing boat waited for the <w>incoming tide</w> to be able to leave the harbor safely."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoogwater",
                        "vloedgetij"
                    ],
                    "antonyms": [
                        "eb",
                        "laagtij"
                    ],
                    "common_phrases": [
                        "komende vloed",
                        "eb en vloed"
                    ],
                    "target_lang_definitions": {
                        "en": "The periodic rise of the sea level as part of the tide."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "high tide",
                                "target_lang_sense_clarification": "the highest level of the sea"
                            },
                            {
                                "target_lang_word": "flood tide",
                                "target_lang_sense_clarification": "the incoming tide"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57db173b-48a3-3aff-b6d7-9c4826b13ee3",
                    "sense_definition": "Een grote, stromende hoeveelheid vloeistof die vaak gepaard gaat met een stijging van het waterpeil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stroming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stortbui zorgde voor een <w>plotselinge</w> <w>vloed</w> die de rivier buiten zijn oevers deed treden.",
                            "target_lang_translations": {
                                "en": "The downpour caused a sudden <w>flood</w> that made the river burst its banks."
                            }
                        },
                        {
                            "text": "Na de zware regenval ontstond er een krachtige <w>vloed</w> in de smalle beek.",
                            "target_lang_translations": {
                                "en": "After the heavy rainfall, a powerful <w>surge</w> of water arose in the narrow stream."
                            }
                        }
                    ],
                    "synonyms": [
                        "stroom",
                        "watervloed"
                    ],
                    "common_phrases": [
                        "plotselinge vloed",
                        "vloed van water"
                    ],
                    "target_lang_definitions": {
                        "en": "A large, flowing amount of liquid often accompanied by a rise in water level."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flood",
                                "target_lang_sense_clarification": "an overflow of water"
                            },
                            {
                                "target_lang_word": "surge",
                                "target_lang_sense_clarification": "a sudden powerful forward or upward movement"
                            },
                            {
                                "target_lang_word": "torrent",
                                "target_lang_sense_clarification": "a fast-moving stream of water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79f16943-e158-35d8-967a-b5ee724d55a6",
                    "sense_definition": "Het uittreden of wegstromen van lichaamsvocht.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts probeerde de <w>vloed</w> van bloed uit de wond zo snel mogelijk te stelpen.",
                            "target_lang_translations": {
                                "en": "The doctor tried to stem the <w>flow</w> of blood from the wound as quickly as possible."
                            }
                        },
                        {
                            "text": "In oude medische teksten wordt vaak gesproken over een <w>vloed</w> van gal.",
                            "target_lang_translations": {
                                "en": "In old medical texts, there is often mention of a <w>flux</w> of bile."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstroming",
                        "lozing"
                    ],
                    "common_phrases": [
                        "vloed van bloed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in medische of formele context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The discharge or flowing out of bodily fluids."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flow",
                                "target_lang_sense_clarification": "the movement of bodily fluids"
                            },
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "the release of fluid from the body"
                            },
                            {
                                "target_lang_word": "flux",
                                "target_lang_sense_clarification": "an abnormal discharge of blood or other matter"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}