                        "se convertir à une religion"
                    ]
                },
                {
                    "sense_id": "145a351f-7988-3d0a-bd58-e96388710a67",
                    "sense_definition": "Échanger ou transformer des devises, des titres ou des actifs financiers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en voyage, nous devons <w>convertir</w> nos devises au bureau de change."
                        },
                        {
                            "text": "L'investisseur a préféré <w>convertir</w> ses obligations en actions pour accroître son capital."
                        }
                    ],
                    "synonyms": [
                        "changer",
                        "échanger"
                    ],
                    "common_phrases": [
