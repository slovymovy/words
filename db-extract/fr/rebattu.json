                "senses": [
                    {
                        "sense_id": "302a4681-9e3b-3c8d-beb0-43a2164dcf44",
                        "entry_id": "3457cb95-2249-30b2-9632-c3b32423a61c",
                        "glosses": [
                            "Usé, banal, trop entendu, cliché, se dit d’un lieu commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46e7bf5b-bed2-49a5-9bc5-17ca7bfe5ae3",
                                "sense_id": "302a4681-9e3b-3c8d-beb0-43a2164dcf44",
                                "text": "Son discours, plein d’idées rebattues, n’était qu’une mauvaise amplification."
                            },
                            {
                                "example_id": "bee85c57-2b9d-4d3c-ac14-6d29f31e3661",
                                "sense_id": "302a4681-9e3b-3c8d-beb0-43a2164dcf44",
                                "text": "Le chef d’orchestre a fait une relecture magistrale de partitions assez rebattues, dont la polyphonie est comme « dépliée » par le passage à l’interprétation collective."
                            }
                        ]
                    },
                    {
                        "sense_id": "f71ec7d1-5aee-3758-bab0-ca9f66534418",
                        "entry_id": "3457cb95-2249-30b2-9632-c3b32423a61c",
                        "glosses": [
                            "Qui présente un rebattement, la répétition de partitions simples ou de pièces simples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35870f1-4123-4f9f-9c3a-ed29ab2f8075",
                                "sense_id": "f71ec7d1-5aee-3758-bab0-ca9f66534418",
                                "text": "Dans les partitions rebattues, le nombre de pièces doit être équilibré de manière que chaque émail soit répété le même nombre de fois."
                            },
                            {
                                "example_id": "7dcdf44c-b20f-48c9-aa88-08c8296bdb4a",
                                "sense_id": "f71ec7d1-5aee-3758-bab0-ca9f66534418",
                                "text": "Le chevron peut être rebattu jusqu’à trois fois."
                            }
                        ]
                    }
                ],
