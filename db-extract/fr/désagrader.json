                ],
                "senses": [
                    {
                        "sense_id": "d93e77fa-7059-325b-aae6-6390137b2195",
                        "entry_id": "2cdfd7d3-1ddf-355b-9bf1-8f8aa1ae582c",
                        "glosses": [
                            "Dégrader."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf70440-5fb2-48d0-98f0-34eac0a3b1dd",
                                "sense_id": "d93e77fa-7059-325b-aae6-6390137b2195",
                                "text": "Ces vandalistes, ces délinquants juvéniles impénitents à sang-froid qui se font appeler Piranhas ont désagradé tous ceux qui sont ici dans leur chez eux."
                            },
                            {
                                "example_id": "3e0b1127-621e-46fa-af6a-c8e00d5fa2c7",
                                "sense_id": "d93e77fa-7059-325b-aae6-6390137b2195",
                                "text": "Je soupire doucement c’était vraiment honteux de la vie humaine et de ce qu’il font en désagradant la planète et les animaux"
                            },
                            {
                                "example_id": "e0ac81b7-f93f-45f4-82ea-3d1102ffd92b",
                                "sense_id": "d93e77fa-7059-325b-aae6-6390137b2195",
                                "text": "Ces comprimés se désagradent dans la bouche et se dissolvent complètement dans l’estomac"
                            },
                            {
                                "example_id": "862d45c9-fd27-42aa-b19f-4a62809e0052",
                                "sense_id": "d93e77fa-7059-325b-aae6-6390137b2195",
                                "text": "Celle-ci ne se désagrade pas au contact de l’eau, elle devient lourde et provoque des amas importants bloquant les conduites."
                            },
                            {
                                "example_id": "622624bf-de1d-49bb-a8b6-4127236d3ed2",
                                "sense_id": "d93e77fa-7059-325b-aae6-6390137b2195",
                                "text": "Avant de tomber pour la mue, les plumes peuvent désagrader et devenir ternes."
                            }
                        ]
                    }
                ],
