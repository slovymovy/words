                ],
                "senses": [
                    {
                        "sense_id": "7b9f8bbe-a13e-32e8-8557-896b96322939",
                        "entry_id": "5235af20-aded-3a9b-8ea5-3b69b3bcfa9c",
                        "glosses": [
                            "Behältnis zur Entsorgung von (medizinischen) Abfällen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62098240-f552-4197-a91b-d884e8d68076",
                                "sense_id": "7b9f8bbe-a13e-32e8-8557-896b96322939",
                                "text": "„Im Abwurfbehälter fanden sich zudem vier leere Ampullen des eigentlich nur höchst selten erforderlichen Gilurytmal.“"
                            },
                            {
                                "example_id": "ee0f4f6c-d6dc-41a8-b4ee-80cd613f9fd4",
                                "sense_id": "7b9f8bbe-a13e-32e8-8557-896b96322939",
                                "text": "„Kaum einer der Beschäftigten hat sich im Laufe seines Berufslebens nicht gestochen - trotz Maßnahmen wie Handschuhen oder Abwurfbehältern am Krankenbett.“"
                            },
                            {
                                "example_id": "d27406de-bcc4-4b18-9f4e-e6fa6f0052c9",
                                "sense_id": "7b9f8bbe-a13e-32e8-8557-896b96322939",
                                "text": "„In der Klinik sollte sich in jedem Patientenzimmer, in der ambulanten Pflege in jeder Patientenwohnung mindestens ein Abwurfbehälter für spitze und scharfe Gegenstände befinden.“"
                            },
                            {
                                "example_id": "0356361f-d5df-4b8d-b1c6-cce0af0fd488",
                                "sense_id": "7b9f8bbe-a13e-32e8-8557-896b96322939",
                                "text": "„Ein stabiler kleinflächiger Rollcontainer (=stumme Assistenz) für einen Stapel Abdecktücher (am besten kleine Frotteetücher), Abwurfbehälter und eine kleine Ablagefläche im Griffbereich des Untersuchers erleichtert die Routinearbeit.“"
                            },
                            {
                                "example_id": "6fa1a7b1-3181-4f17-9c08-95647612b83f",
                                "sense_id": "7b9f8bbe-a13e-32e8-8557-896b96322939",
                                "text": "„Kanülen, Skapelle usw. werden sofort nach Benutzung in stich- und schnittfesten Abwurfbehältern entsorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "282541c7-e312-383a-b1aa-6aa8ae607828",
                        "entry_id": "5235af20-aded-3a9b-8ea5-3b69b3bcfa9c",
                        "glosses": [
                            "Behältnis mit Gegenständen, die abgeworfen, hinuntergeworfen werden"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "99d49cc0-2357-43d8-9340-de7e3bacc2cf",
                                "sense_id": "282541c7-e312-383a-b1aa-6aa8ae607828",
                                "text": "„Nach der Order des Präsidenten wurde die ‚Bat Bomb‘ tatsächlich entwickelt. Ingenieure entwarfen geeignete Abwurfbehälter, Bombenexperten die notwendigen Brandsätze und Zünder.“"
                            },
                            {
                                "example_id": "9d04e622-b228-48c5-acd0-77415f8ed6c0",
                                "sense_id": "282541c7-e312-383a-b1aa-6aa8ae607828",
                                "text": "„Nach dem Abwurf springt die Submunition aus dem Abwurfbehälter und schwebt an Fallschirmen herab.“"
                            },
                            {
                                "example_id": "f4f383f0-5491-4fe1-8735-9acf023ac517",
                                "sense_id": "282541c7-e312-383a-b1aa-6aa8ae607828",
                                "text": "„Wir haben Funksprüche von General Ramckel bekommen, in denen er dringend um Abwurfbehälter bittet, um Material und ähnliche Sachen. Leider haben wir vom Heer die Abwurfbehälter noch nicht bekommen.“"
                            },
                            {
                                "example_id": "a8aaf2d2-8d2b-4717-a885-bf5bff95e0ad",
                                "sense_id": "282541c7-e312-383a-b1aa-6aa8ae607828",
                                "text": "„Für das Einsammeln der Abwurfbehälter im zivilen Bergungsgebiet sind die Ortsgruppen der NSDAP verantwortlich.“"
                            },
                            {
                                "example_id": "4ebe1028-cead-411c-8944-a99c9d89eaad",
                                "sense_id": "282541c7-e312-383a-b1aa-6aa8ae607828",
                                "text": "„Auf einem englischen Flugplatz werden Abwurfbehälter für Stabbrandbomben zur Beladung einer Lancaster bestückt; jeder Bomber konnte bis zu 20 Behälter mit je 90 Bomben tragen […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
