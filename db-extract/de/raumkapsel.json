                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974db73d-5a20-4c00-a70a-adb4a245f468",
                                "sense_id": "a302ee98-02a7-37b3-afea-d3abab2bb060",
                                "text": "„Um neunzehn Uhr Bordzeit stieg ich über die Metallsprossen hinunter zur Raumkapsel – vorbei an den Leuten, die am Zugang zum Schacht standen. Die Kapsel bot gerade so viel Platz, daß ich die Ellenbogen anheben konnte.“"
                            }
