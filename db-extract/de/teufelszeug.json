                "senses": [
                    {
                        "sense_id": "fa005495-93ba-31a2-80fa-a9d7d61145ea",
                        "entry_id": "37973705-9447-3288-9639-e453bd60b68e",
                        "glosses": [
                            "Gegenstand, Stoff oder Kollektiv von Gegenständen mit tückischen Eigenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b45f0914-6479-45e8-a503-b5d5e4c662d8",
                                "sense_id": "fa005495-93ba-31a2-80fa-a9d7d61145ea",
                                "text": "Plutonium ist ein Teufelszeug, bloß ein Flitterchen eingeatmet, und du bist erledigt!"
                            },
                            {
                                "example_id": "04fa5e7a-28df-424b-9d1a-d86170c58265",
                                "sense_id": "fa005495-93ba-31a2-80fa-a9d7d61145ea",
                                "text": "Cannabis ist weder ein Allheilmittel noch Teufelszeug."
                            },
                            {
                                "example_id": "cd2b7a78-ae16-4b44-9cf3-f5da8b19b44e",
                                "sense_id": "fa005495-93ba-31a2-80fa-a9d7d61145ea",
                                "text": "„Satan kreierte den Schokoladenkuchen und nannte ihn Teufelszeug.“"
                            },
                            {
                                "example_id": "721c369c-9d3e-4a95-8e4c-c591c89480bc",
                                "sense_id": "fa005495-93ba-31a2-80fa-a9d7d61145ea",
                                "text": "„Sie schenkte mir das Teufelszeug ein.“"
                            },
                            {
                                "example_id": "bfc0923d-7033-40cd-a71a-d209d564e9b1",
                                "sense_id": "fa005495-93ba-31a2-80fa-a9d7d61145ea",
                                "text": "„Sonnenbrillen und Fahrräder waren als westliches Teufelszeug verboten.“"
                            },
                            {
                                "example_id": "a986da85-1387-455e-8a5b-8c8c3aa7fc63",
                                "sense_id": "fa005495-93ba-31a2-80fa-a9d7d61145ea",
                                "text": "„Die beiden beschimpften sich wechselseitig als Teufel und waren doch untereinander so einig über das Teufelszeug der aufkommenden Geldwirtschaft wie mit vielen anderen Zeitgenossen.“"
                            }
                        ],
