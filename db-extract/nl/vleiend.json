                "forms": [],
                "senses": [
                    {
                        "sense_id": "46b2ef7f-44eb-360b-aa09-a8dc7e9814c8",
                        "entry_id": "0d6a368f-8989-32f1-825c-4d14d18485c7",
                        "glosses": [
                            "te vriendelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478a9575-b990-4d57-b480-2342291cf6f1",
                                "sense_id": "46b2ef7f-44eb-360b-aa09-a8dc7e9814c8",
                                "text": "Critici prezen het boek, maar sommigen binnen de Amerikaanse joodse gemeenschap hadden er bezwaar tegen dat Roth zich had geconcentreerd op minder vleiende kanten van het jodendom, zoals het materialisme."
                            },
                            {
                                "example_id": "939a7055-2a1a-4f10-8a02-279ff4be0a0f",
                                "sense_id": "46b2ef7f-44eb-360b-aa09-a8dc7e9814c8",
                                "text": "Omdat we ons zorgvuldig opgebouwde zakelijke netwerk in stand willen houden, communiceren we alleen vleiende complimentjes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d234afe7-d5f2-44fc-90df-9c5f64a06d1b",
                        "source_entry_id": "0d6a368f-8989-32f1-825c-4d14d18485c7",
                        "source_sense_id": "46b2ef7f-44eb-360b-aa09-a8dc7e9814c8",
                        "source_sense_description": "te vriendelijk",
                        "target_lang_word": "coaxingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
