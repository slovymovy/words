                "senses": [
                    {
                        "sense_id": "60920fd3-9ed0-3de3-9277-4bcf1787fe62",
                        "entry_id": "f741e70d-6b32-3330-889d-ffc714edb645",
                        "glosses": [
                            "Frucht einer Ölpalme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1a307bf-ff61-4d22-a9f0-f539eaf09bfd",
                                "sense_id": "60920fd3-9ed0-3de3-9277-4bcf1787fe62",
                                "text": "„Der Konzern spricht von schwierigen Verhandlungen und bezichtigt die Nomaden des Diebstahls von Palmfrüchten.“"
                            },
                            {
                                "example_id": "c13e5cdf-34a0-4657-a7e8-3d08a41f0a78",
                                "sense_id": "60920fd3-9ed0-3de3-9277-4bcf1787fe62",
                                "text": "„Zum einen kann man aus den Palmfrüchten eine große Menge an Öl gewinnen (verglichen mit Raps kann man pro Hektar ein deutlich höheren Ölertrag erzielen), zum anderen spart man mit Palmöldiesel verglichen mit der Verwendung von herkömmlichen Diesel Primärenergie und kann somit seinen CO2-Ausstoß reduzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
