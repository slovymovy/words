{
    "word_family": [
        "agility",
        "agilely",
        "agileness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97893f3c-7111-3351-9d98-b2bd008854b2",
                    "sense_definition": "Able to move quickly, easily, and with coordination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_mental_dexterity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>agile</w> monkey leaped effortlessly from one branch to another.",
                            "target_lang_translations": {
                                "fr": "Le singe <w>agile</w> sautait sans effort d'une branche à l'autre.",
                                "zh": "那只<w>敏捷的</w>猴子毫不费力地从一根树枝跳到另一根树枝上。"
                            }
                        },
                        {
                            "text": "Gymnasts must remain remarkably <w>agile</w> throughout their entire competitive careers.",
                            "target_lang_translations": {
                                "fr": "Les gymnastes doivent rester remarquablement <w>agiles</w> tout au long de leur carrière en compétition.",
                                "zh": "体操运动员在整个竞赛生涯中都必须保持极佳的<w>灵活</w>身手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nimble",
                        "active",
                        "quick",
                        "brisk",
                        "lively"
                    ],
                    "antonyms": [
                        "unagile"
                    ],
                    "common_phrases": [
                        "agile movements",
                        "agile dancer"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui a de la facilité à se déplacer rapidement, aisément et avec souplesse physique.",
                        "zh": "动作轻快、灵活敏捷的"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "mouvements rapides et aisés"
                            },
                            {
                                "target_lang_word": "leste",
                                "target_lang_sense_clarification": "rapide et souple physiquement"
                            },
                            {
                                "target_lang_word": "souple",
                                "target_lang_sense_clarification": "dextérité corporelle"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敏捷的",
                                "target_lang_sense_clarification": "指动作轻巧敏捷"
                            },
                            {
                                "target_lang_word": "灵活的",
                                "target_lang_sense_clarification": "指身体动作协调变通"
                            },
                            {
                                "target_lang_word": "矫健的",
                                "target_lang_sense_clarification": "常指动作强健轻捷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06239911-041e-39a0-8bdb-a88e5fd171a2",
                    "sense_definition": "Able to think, adapt, and comprehend very quickly; mentally acute.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_mental_dexterity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>agile</w> mind allowed her to find clever solutions under immense pressure.",
                            "target_lang_translations": {
                                "fr": "Son esprit <w>agile</w> lui a permis de trouver des solutions ingénieuses sous une pression immense.",
                                "zh": "她那<w>机敏的</w>头脑使她能够在巨大的压力下找到巧妙的解决方案。"
                            }
                        },
                        {
                            "text": "You need an <w>agile</w> brain to follow the fast-paced arguments in this debate.",
                            "target_lang_translations": {
                                "fr": "Il faut un cerveau <w>vif</w> pour suivre les arguments rythmés de ce débat.",
                                "zh": "你需要一个<w>敏捷的</w>头脑，才能跟上这场辩论中快节奏的交锋。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alert",
                        "quick"
                    ],
                    "common_phrases": [
                        "agile mind",
                        "agile wit"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui comprend, s'adapte et réfléchit avec rapidité et vivacité d'esprit.",
                        "zh": "思维活跃、反应机敏的"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "esprit vif et adaptable"
                            },
                            {
                                "target_lang_word": "vif",
                                "target_lang_sense_clarification": "rapidité intellectuelle"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机敏的",
                                "target_lang_sense_clarification": "指头脑思维或反应迅速"
                            },
                            {
                                "target_lang_word": "敏捷的",
                                "target_lang_sense_clarification": "指思维敏锐不迟钝"
                            },
                            {
                                "target_lang_word": "灵活的",
                                "target_lang_sense_clarification": "指头脑机巧不僵化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61531755-642f-3005-9bb7-9c6db6592028",
                    "sense_definition": "Relating to a method of project management and software development emphasizing collaboration and rapid, iterative delivery.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our engineering department switched to an <w>agile</w> framework last year.",
                            "target_lang_translations": {
                                "fr": "Notre département d'ingénierie est passé à un cadre <w>agile</w> l'année dernière.",
                                "zh": "我们的工程部门去年转向了<w>敏捷</w>架构。"
                            }
                        },
                        {
                            "text": "Many software teams rely on <w>agile</w> methods to respond quickly to client feedback.",
                            "target_lang_translations": {
                                "fr": "De nombreuses équipes logicielles s'appuient sur des méthodes <w>agiles</w> pour répondre rapidement aux retours des clients.",
                                "zh": "许多软件团队依靠<w>敏捷</w>方法来快速响应客户的反馈。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "agile methods",
                        "agile development",
                        "agile software development"
                    ],
                    "target_lang_definitions": {
                        "fr": "Relatif à une approche de gestion de projet et de développement informatique axée sur la collaboration, la flexibilité et des livraisons fréquentes et itératives.",
                        "zh": "（软件开发或项目管理）敏捷的，采用快速迭代与协作方式的"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "méthode ou gestion de projet"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敏捷的",
                                "target_lang_sense_clarification": "指敏捷项目管理或软件开发模式"
                            },
                            {
                                "target_lang_word": "敏捷式的",
                                "target_lang_sense_clarification": "用于修饰开发或管理流程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bfebd757-75b8-3e85-a175-d956c559b646",
                    "sense_definition": "A methodology for iterative project management and software development that promotes rapid adaptation to change.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Transitioning the company to <w>agile</w> required training all of our product managers.",
                            "target_lang_translations": {
                                "fr": "La transition de l'entreprise vers <w>l'agile</w> a nécessité de former tous nos chefs de produit.",
                                "zh": "让公司向<w>敏捷模式</w>转型需要对我们所有的产品经理进行培训。"
                            }
                        },
                        {
                            "text": "They successfully implemented <w>agile</w> to deliver product features in two-week cycles.",
                            "target_lang_translations": {
                                "fr": "Ils ont mis en œuvre avec succès la <w>méthode agile</w> pour livrer les fonctionnalités du produit par cycles de deux semaines.",
                                "zh": "他们成功推行了<w>敏捷开发</w>，以两周为周期交付产品功能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "implementing agile",
                        "principles of agile"
                    ],
                    "target_lang_definitions": {
                        "fr": "Méthode ou approche itérative de conduite de projet et de développement de logiciels favorisant l'adaptation au changement.",
                        "zh": "敏捷开发，敏捷项目管理方法"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "l'agile",
                                "target_lang_sense_clarification": "nom désignant la méthodologie"
                            },
                            {
                                "target_lang_word": "méthode agile",
                                "target_lang_sense_clarification": "démarche de gestion de projet"
                            },
                            {
                                "target_lang_word": "agilité",
                                "target_lang_sense_clarification": "pratique ou cadre méthodologique"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敏捷开发",
                                "target_lang_sense_clarification": "迭代式的软件工程管理模式"
                            },
                            {
                                "target_lang_word": "敏捷模式",
                                "target_lang_sense_clarification": "敏捷管理方式或方法论"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}