                "senses": [
                    {
                        "sense_id": "65139525-af2f-376a-aafe-be1985e216fa",
                        "entry_id": "7815a432-0e5c-3c05-b2c5-1a1c73b6d943",
                        "glosses": [
                            "uitgeschreven schema van de structuur van een organisatie; de inrichting van een organisatie"
                        ],
                        "tags": [
                            "organisatiekunde"
                        ],
                        "examples": [
                            {
                                "example_id": "83767e03-804b-47eb-9cc4-1c3388d812c0",
                                "sense_id": "65139525-af2f-376a-aafe-be1985e216fa",
                                "text": "„Beheersbaarheid zie ik meer als onderdeel van governance, bij ‘inrichting van de organisatie’ denk ik meer aan een organigram.”"
                            },
                            {
                                "example_id": "5610bf58-1bc9-4db9-b0a2-bcd81f968020",
                                "sense_id": "65139525-af2f-376a-aafe-be1985e216fa",
                                "text": "Heeft het FN het onheil over zichzelf afgeroepen? Twee weken geleden zette de partij een nieuw organigram op haar website dat suggereert dat tientallen door Europa betaalde assistenten hun werkadres in Nanterre hebben, op het hoofdkantoor van het FN."
                            },
                            {
                                "example_id": "d8b45f97-4a83-4404-98f0-82f171eab5f5",
                                "sense_id": "65139525-af2f-376a-aafe-be1985e216fa",
                                "text": "'Het organigram en de samenstelling van de ploeg zijn nog niet volledig op papier gezet, maar Trek gaat voort met een groot deel van de huidige ploeg. Trek is momenteel nog in gesprek met verschillende renners, waarvan de namen volgende week bekendgemaakt zullen worden. Trek zal ook nog op zoek gaan naar andere partners.'"
                            },
                            {
                                "example_id": "083e0d11-4b99-44ad-b00e-0b10090fd835",
                                "sense_id": "65139525-af2f-376a-aafe-be1985e216fa",
                                "text": "De bank is niet terug te vinden in het organigram van de Heilige Stoel, maar staat onder het kopje ”kerkelijke vormingsinstellingen” tussen de pauselijke universiteiten en academies en het charitatieve Fonds Johannes Paulus II voor de Sahel in. Hoeveel geld er omgaat is niet duidelijk. Schattingen lopen uiteen van 3,5 tot 5 miljard euro. Zo’n 30.000 rechtspersonen zouden er een rekening hebben."
                            }
                        ]
                    }
                ],
