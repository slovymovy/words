                ],
                "senses": [
                    {
                        "sense_id": "0f8f4bff-3a22-300f-a138-2bfab9be2a12",
                        "entry_id": "5e752c5a-11a3-32e2-96db-f4095148c06b",
                        "glosses": [
                            "die Gesamtheit der Namen einer Sprache oder Gruppe von Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1350da-2280-4d56-9c24-ac24564c3709",
                                "sense_id": "0f8f4bff-3a22-300f-a138-2bfab9be2a12",
                                "text": "„Das heißt, daß bei geringerer Mädchenzahl der Namenschatz bei diesen dennoch größer ist als bei den Jungen: ein durchaus typisches Bild ([…]).“"
                            },
                            {
                                "example_id": "fc1bf5ce-3074-4aa0-bdf0-5e746e0d6fc3",
                                "sense_id": "0f8f4bff-3a22-300f-a138-2bfab9be2a12",
                                "text": "„Im Zusammenhang mit dem Vorhergehenden bleibt ein anderes Merkmal des städtischen Namenschatzes, nämlich: der große Anteil und Einfluß des administrativen Faktors auf die Bildung dieses Namenbestandes.“"
                            },
                            {
                                "example_id": "6281ccbd-b9b8-40a5-ac19-2094a83ecdeb",
                                "sense_id": "0f8f4bff-3a22-300f-a138-2bfab9be2a12",
                                "text": "„Im Namenschatz ist *wiðu- ein häufiges Kompositionselement – und hier ist zunächst auch der Brakteatenbeleg zu verorten.“"
                            },
                            {
                                "example_id": "e09adefd-294a-48e5-8149-03a32232e8a6",
                                "sense_id": "0f8f4bff-3a22-300f-a138-2bfab9be2a12",
                                "text": "„Der mittelalterliche Namenschatz spiegelt nicht nur die Lesbarkeit der Stadt, sondern topographisch wie mentalitätsgeschichtlich spezifische Stadtlektüren wider.“"
                            },
                            {
                                "example_id": "01ee0cdb-9c4c-4ccf-9385-7c439d36592e",
                                "sense_id": "0f8f4bff-3a22-300f-a138-2bfab9be2a12",
                                "text": "„Zeitgenössische Namenschätze sind also eine miteinander in Beziehung befindliche Textur, ein Netzwerk aus Sprache, dessen Spuren.“"
                            },
                            {
                                "example_id": "2f15efa4-e437-4048-8d21-5692cb4b89e1",
                                "sense_id": "0f8f4bff-3a22-300f-a138-2bfab9be2a12",
                                "text": "„Wenn die Grundanlage der neuen Namenschätze erstaunlich ähnlich geblieben ist, dann beweist dies gerade nicht, wie bisher angenommen, dass sie alle aus ein und demselben Wurzelstock stammen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
