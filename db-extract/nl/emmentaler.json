                        "tags": [],
                        "examples": [
                            {
                                "example_id": "190ae50d-3c4f-4614-8c1b-6d0dfdfc6fe7",
                                "sense_id": "589d175b-fc88-374f-8c47-bce626fc7a1f",
                                "text": "Vervang de Gruyère en Emmentaler eens door gatenkaas en geitenkaas. Voeg bacon toe. Zo maak je van die klassieke kaasfondue een heerlijke, Hollandse kaasfondue."
                            },
                            {
                                "example_id": "57eef13f-808f-4f8d-bd1a-1ac07d390687",
                                "sense_id": "589d175b-fc88-374f-8c47-bce626fc7a1f",
                                "text": "Mozzarella is de beste kaassoort om pizza mee te maken. Dit blijkt uit vergelijkend wetenschappelijk onderzoek, zo meldde het Italiaanse persbureau ANSA. Bij de proeven zijn, naast andere Italiaanse kaassoorten zoals Provolone, ook onder meer de Nederlandse Edammer, de Engelse Cheddar en de Zwitserse Gruyère en Emmentaler gebruikt."
                            },
                            {
                                "example_id": "eb2dbc31-7b79-48c6-ac1b-2bb53d80a0cb",
                                "sense_id": "589d175b-fc88-374f-8c47-bce626fc7a1f",
                                "text": "Dit zijn de kazen die we veel op onze boterham eten, bijvoorbeeld Gouda kaas en Emmentaler. Is de kaas nog dicht? Dan gaat de kaas één tot twee maanden mee. Na opening is dit nog maar twee tot drie weken in de koelkast."
                            }
                        ]
