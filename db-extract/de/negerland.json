                ],
                "senses": [
                    {
                        "sense_id": "4a6e577a-a72b-3a1c-b182-203b0a9c4835",
                        "entry_id": "9c335633-d2eb-30e2-a845-12a17d7ad422",
                        "glosses": [
                            "Land, das überwiegend von Schwarzen bewohnt wird"
                        ],
                        "tags": [
                            "derogatory",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "80c766e6-d23f-4add-bcfc-f65551a22f46",
                                "sense_id": "4a6e577a-a72b-3a1c-b182-203b0a9c4835",
                                "text": "„Aber die Leute Ägyptens selbst hatten Kusch unterworfen und der Wissenschaft aufgetan, die Negerländer nilaufwärts gen Mittag.“"
                            },
                            {
                                "example_id": "48076e9d-4522-481e-9f7d-731ff7edf8f2",
                                "sense_id": "4a6e577a-a72b-3a1c-b182-203b0a9c4835",
                                "text": "„Denn in gerechten Urzeiten, die Mempi als Königsstadt hätten glänzen sehen, sei das Deltagebiet das eigentliche und wahre Ägyptenland gewesen, während man die oberen Strecken, Theben mit eingeschlossen, beinahe dem elenden Kusch und den Negerländern beigerechnet habe.“"
                            },
                            {
                                "example_id": "548ccaf9-4558-4e09-bc37-eb671d6d2540",
                                "sense_id": "4a6e577a-a72b-3a1c-b182-203b0a9c4835",
                                "text": "„Denn der thebanische Amun droben, nahe den Negerländern, werfe sich heutzutage zum Richter auf über das, was als ägyptisch zu gelten habe und was nicht, – so gewiß sei es ihm, daß sein Name gleichgälte dem Namen Ägyptens und dieser dem seinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
