                                                "sense_id": "7cb07483-3501-3630-b30a-2501c450ce7b",
                                                "text": "a stormy sound or stormy shocks"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9152f8d-3243-3967-b81f-a45fd8337460",
                                        "entry_id": "9b341463-d916-391f-b40b-a4ab2b777fe2",
                                        "glosses": [
                                            "Violent; passionate; rough."
                                        ],
                                        "tags": [],
                                        "examples": [
