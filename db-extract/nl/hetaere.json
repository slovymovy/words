                "senses": [
                    {
                        "sense_id": "f89d3edb-f47b-3440-be75-145a54869517",
                        "entry_id": "831b52da-d5bd-3a8f-a990-1a931b966b4f",
                        "glosses": [
                            "in het oude Athene een vrouw die heren van stand zowel geestelijk als lichamelijk bevredigend gezelschap bood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f2ae0bb-0b5d-463f-97e7-96c1fb33ca6b",
                                "sense_id": "f89d3edb-f47b-3440-be75-145a54869517",
                                "text": "Het antieke symposion was een mannenaangelegenheid, waar nette dames nog niet dood aangetroffen wilden worden. Alleen de aanwezigheid van hetaeren (prostituees) die voor seksueel en muzikaal genot zorgden, was toegestaan."
                            },
                            {
                                "example_id": "9e8b4715-ef0c-4a89-b5a7-df57d538fe4e",
                                "sense_id": "f89d3edb-f47b-3440-be75-145a54869517",
                                "text": "Gij, Aspasia! verhieft u, van eene Milesische Hetaere, tot den rang van Gemalin van een Pericles, en verdiende door uwen invloed op hem, in een zin, dien ik zelve had kunnen benijden, den naam van de Juno deezes Attischen Jupiters."
                            }
                        ]
                    },
                    {
                        "sense_id": "db90acbc-68e2-32cf-b783-9c7abe21a8f1",
                        "entry_id": "831b52da-d5bd-3a8f-a990-1a931b966b4f",
                        "glosses": [
                            "vrouw die met veel mannen verkeert om daar economische voordeel uit te halen"
                        ],
                        "tags": [
                            "euphemistic",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f6575478-2135-4cd6-8057-e811e89ad85c",
                                "sense_id": "db90acbc-68e2-32cf-b783-9c7abe21a8f1",
                                "text": "Hij weerstaat eerst nog met moeite de charmes van een jonge Française, maar tegen de bekoorlijkheden van een verleidelijke hetaere, van overigens Poolse nationaliteit, blijkt hij niet bestand."
                            },
                            {
                                "example_id": "9c8d2cbf-0065-4f3a-a9b3-e3aa916b0c29",
                                "sense_id": "db90acbc-68e2-32cf-b783-9c7abe21a8f1",
                                "text": "Hij meende, dat men ja in de Oost alles op grooter schaal vond, hij erkende het trotsche, het weelderige der keerkringslanden, maar noemde de natuur daar voor den zoon der westerstranden eene hetaere, terwijl zij hem hier eene vriendin en moeder was."
                            }
                        ]
                    }
