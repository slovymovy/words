                ],
                "senses": [
                    {
                        "sense_id": "fe4710a4-506e-3259-a42b-fa82c15ecf61",
                        "entry_id": "63bb28f8-3dc2-3be4-995a-916feaf8ecf3",
                        "glosses": [
                            "Zuwendung, Motivation zum Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86539f8a-bf7a-467e-90ab-4a4aa7c06a5f",
                                "sense_id": "fe4710a4-506e-3259-a42b-fa82c15ecf61",
                                "text": "„In die Lage der Partner müssen sich die Kinder versetzen können, einen von allen Beteiligten gebilligten Ausgleich zwischen den verschiedenen Spielinteressen herzustellen und aufrechtzuerhalten versuchen und vieles mehr.“"
                            },
                            {
                                "example_id": "dc7faf16-f339-45f2-ad2b-dff6cad5954f",
                                "sense_id": "fe4710a4-506e-3259-a42b-fa82c15ecf61",
                                "text": "„Henry Jenkins, ein amerikanischer Medienwissenschaftler vom MIT, hat die unterschiedlichen Spielinteressen von Frauen und Männern kategorisiert.“"
                            },
                            {
                                "example_id": "a61cd9d2-a997-4fed-af4d-9bc71cabdf97",
                                "sense_id": "fe4710a4-506e-3259-a42b-fa82c15ecf61",
                                "text": "„Seit dem vulkanartigen Ausbruch des Computerzeitalters in den neunziger Jahren wird das Spielinteresse und Spielgeschehen in beträchtlichem Maße von elektronischen Spielen geprägt.“"
                            },
                            {
                                "example_id": "d5eaa113-c7d2-4959-8027-c13dd0ea0efa",
                                "sense_id": "fe4710a4-506e-3259-a42b-fa82c15ecf61",
                                "text": "„Andere Feststellungen erstreckten sich auf moralische Eigenschaften wie Aufrichtigkeit, Neigung zu Betrug, Genauigkeit, sittliches Urteil, auf Lektüre- und Spielinteresse im Vergleich zu denen krimineller Kinder: überall waren die Begabten dem Durchschnitt moralisch überlegen.“"
                            },
                            {
                                "example_id": "c1f4688b-0a0f-42da-b1f8-e5399db3abd5",
                                "sense_id": "fe4710a4-506e-3259-a42b-fa82c15ecf61",
                                "text": "„Er habe immer ein großes Spielinteresse gehabt, als Korpsstudent sei ihm das Hasardspiel verboten gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
