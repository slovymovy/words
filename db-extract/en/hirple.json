                "senses": [
                    {
                        "sense_id": "65947da7-4b84-33db-97db-5d229343329f",
                        "entry_id": "1bdaa8f1-d368-3dda-8f67-80a26956c32a",
                        "glosses": [
                            "To walk with a limp, to drag a limb, to walk lamely; to move with a gait somewhere between walking and crawling."
                        ],
                        "tags": [
                            "Northern",
                            "Scotland",
                            "UK",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bbfc4862-6d72-4651-8b99-e69dbedf8623",
                                "sense_id": "65947da7-4b84-33db-97db-5d229343329f",
                                "text": "Get you on that bicycle and hurry on, and I'll hirple after you the best I can."
                            },
                            {
                                "example_id": "3cb2825a-2eb0-4f16-917d-2f0416114af7",
                                "sense_id": "65947da7-4b84-33db-97db-5d229343329f",
                                "text": "A woman hirpled along the corridor towards them with the aid of a walking frame."
                            },
                            {
                                "example_id": "97de622b-0c38-416e-8e05-a8f911190dd6",
                                "sense_id": "65947da7-4b84-33db-97db-5d229343329f",
                                "text": "Around lunchtime he hirpled down the corridor to the Gents."
                            },
                            {
                                "example_id": "36771328-e45d-4030-b0e2-c056081e6e52",
                                "sense_id": "65947da7-4b84-33db-97db-5d229343329f",
                                "text": "He is hasped and hooped and hirpling with pain,\nlimping and looped in it."
                            }
                        ]
                    }
                ],
