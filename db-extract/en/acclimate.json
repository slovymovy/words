                    },
                    {
                        "translation_id": "94bd6f3d-0c45-4ec6-b0ac-a0db3e870818",
                        "source_entry_id": "51614670-968f-31d8-9e35-d6d2a15df978",
                        "source_sense_description": "(transitive, mainly US) to habituate to a climate not native; to acclimatize",
                        "target_lang_word": "acclimater",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acclimater",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69261d9e-f4d5-392f-91bb-169dd192f01b",
                                        "entry_id": "a923f8be-4f76-3c17-983e-b618ce7ab125",
                                        "glosses": [
                                            "Habituer à un climat autre que celui du pays natal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d4f258-f907-4cfa-9000-9dd085462fc8",
                                                "sense_id": "69261d9e-f4d5-392f-91bb-169dd192f01b",
                                                "text": "La ramie jaune et la ramie rouge sont acclimatées en Indochine. Pourtant elles poussent moins vigoureusement ; elles ne périclitent pas, mais leurs tiges sont moins belles."
                                            },
                                            {
                                                "example_id": "31d11223-41cc-48ac-b7c0-d75fec0be0cb",
                                                "sense_id": "69261d9e-f4d5-392f-91bb-169dd192f01b",
                                                "text": "Il faut du temps pour acclimater une plante étrangère. Cette plante peine à s’acclimater dans nos régions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d125e2e-d6ce-3732-bae3-0981b2c41efe",
                                        "entry_id": "a923f8be-4f76-3c17-983e-b618ce7ab125",
                                        "glosses": [
                                            "S'habituer à un autre climat."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23d6f38f-23e4-49c5-995f-2923866827d6",
                                                "sense_id": "3d125e2e-d6ce-3732-bae3-0981b2c41efe",
                                                "text": "Je n’arrive pas à m’acclimater à ce temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4185dd4d-e525-30d7-a24d-c9f84a654d90",
                                        "entry_id": "a923f8be-4f76-3c17-983e-b618ce7ab125",
                                        "glosses": [
                                            "S'adapter à un nouvel environnement (social, culturel, moral, etc.)"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e62a794f-dc72-4336-a0df-e7466105aec4",
                                                "sense_id": "4185dd4d-e525-30d7-a24d-c9f84a654d90",
                                                "text": "En général, les Bas-Bretons ne s’acclimataient pas si facilement. On en voit qui, après leur service militaire, oublient en rentrant au pays tout ce qu’ils ont appris au régiment, y compris la langue française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16cb479e-ed01-439a-8e88-b26112159948",
                        "source_entry_id": "51614670-968f-31d8-9e35-d6d2a15df978",
                        "source_sense_description": "(transitive, mainly US) to habituate to a climate not native; to acclimatize",
                        "target_lang_word": "akklimatisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akklimatisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc1d61e-5f76-33ac-bc0f-7ea5114b5b49",
                                        "entry_id": "a4cf2c04-dbb2-3234-8c31-7f6ecb591c8e",
                                        "glosses": [
                                            "jemanden/sich oder etwas an fremde klimatische Verhältnisse gewöhnen, an veränderte Umweltbedingungen anpassen"
                                        ],
                                        "tags": [
                                            "jargon",
                                            "rare",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95686f4a-458b-4d40-ba66-e2887d2d12f9",
                                                "sense_id": "9bc1d61e-5f76-33ac-bc0f-7ea5114b5b49",
                                                "text": "„Beides, Puten und Hammel, gab es damals in Japan nicht, und alle Verſuche, ſie dort zu akklimatiſieren, mißlangen, wenigſtens bis 1875, da für die Hammel kein Futter vorhanden war und die jungen Puten das feuchte Klima nicht vertragen konnten.“"
                                            },
                                            {
                                                "example_id": "5f9f5a15-ea9a-4b8a-af94-67e764cd69ef",
                                                "sense_id": "9bc1d61e-5f76-33ac-bc0f-7ea5114b5b49",
                                                "text": "„Als sie an den Rand des Parks gelangt waren, deutete sie lächelnd auf einen Weg: Der führe über eine schöne ländliche Strecke ins nächste Dorf, erklärte sie, ein erquicklicher Spaziergang, den sie in den nächsten Tagen zusammen unternehmen könnten, sobald sie sich akklimatisiert hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7e5320e-ddc1-31e6-ab05-b75bb1ca880e",
                                        "entry_id": "a4cf2c04-dbb2-3234-8c31-7f6ecb591c8e",
                                        "glosses": [
                                            "jemanden/sich oder etwas an fremde, veränderte Lebensverhältnisse gewöhnen, auf eine fremdartige Atmosphäre oder fremdartiges Milieu einstellen; jemanden/sich oder etwas allmählich mit etwas vertraut machen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "rare",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d2195c-ba17-4499-8c8f-69a0ccf51c0c",
                                                "sense_id": "c7e5320e-ddc1-31e6-ab05-b75bb1ca880e",
                                                "text": "„Nein, bei Leuten ohne Würde, Moral, Ehrgeiz, Vornehmheit und Strenge, bei unſoignierten, unhöflichen und ſaloppen Leuten, bei Leuten, die zu gleicher Zeit träge und leichtſinnig, dickblütig und oberflächlich ſind … bei ſolchen Leuten kann ich mich nicht akklimatiſieren und würde es niemals können, ſo wahr ich deine Schwester bin!“"
                                            },
                                            {
                                                "example_id": "0b750b5b-cac2-425d-88de-8609af6c60cc",
                                                "sense_id": "c7e5320e-ddc1-31e6-ab05-b75bb1ca880e",
                                                "text": "„Da sieht man es, selbst eine welsche Familie akklimatisiert sich, wenn sie erst hundertfünfzig Jahre unter Deutschen gelebt hat.“"
                                            },
                                            {
                                                "example_id": "4278814f-ff8e-495a-a637-596255b7f6cc",
                                                "sense_id": "c7e5320e-ddc1-31e6-ab05-b75bb1ca880e",
                                                "text": "„Dann iſt er akklimatiſiert, und wir laſſen ihm ein Zimmer durch unſern Fürſorger, Herrn Peterſen, mieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
