                {
                    "sense_id": "6916f6f7-73c8-3721-aca5-cc982db9a183",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>horen</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>hoor</w> de vogels 's ochtends vroeg al fluiten.",
                            "target_lang_translations": {
                                "en": "I <w>hear</w> the birds singing early in the morning.",
                                "ru": "Я <w>слышу</w>, как рано утром поют птицы.",
                                "it": "<w>Sento</w> gli uccelli cantare già di prima mattina."
                            }
                        },
                        {
                            "text": "Als ik goed luister, <w>hoor</w> ik de zee ruisen.",
                            "target_lang_translations": {
                                "en": "If I listen carefully, I <w>hear</w> the sea murmuring.",
                                "ru": "Если я прислушаюсь, я <w>слышу</w> шум моря.",
                                "it": "Se ascolto bene, <w>sento</w> il rumore del mare."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'horen' (to hear)",
                        "ru": "Первое лицо единственного числа настоящего времени от глагола 'horen' (слышать)",
                        "it": "Prima persona singolare del presente indicativo del verbo 'horen' (sentire/udire)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hear",
                                "target_lang_sense_clarification": "perception of sound"
                            }
                        ],
