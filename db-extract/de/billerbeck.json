                ],
                "senses": [
                    {
                        "sense_id": "2543bf9d-3b1b-3604-9301-3af3ec12fd9c",
                        "entry_id": "e2a59155-03bc-3267-b5fd-af878af6ddfe",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ffb20a7-1d03-4cb6-a51a-e0e895634676",
                                "sense_id": "2543bf9d-3b1b-3604-9301-3af3ec12fd9c",
                                "text": "Frau Billerbeck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7d9bf5b4-b6e6-49ad-970e-37d608fbc847",
                                "sense_id": "2543bf9d-3b1b-3604-9301-3af3ec12fd9c",
                                "text": "Herr Billerbeck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7db4d380-eb9e-446a-8205-3c7ebfc7b63b",
                                "sense_id": "2543bf9d-3b1b-3604-9301-3af3ec12fd9c",
                                "text": "Die Billerbecks fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "7548f415-5dd7-4d81-9c14-003ac7a652fa",
                                "sense_id": "2543bf9d-3b1b-3604-9301-3af3ec12fd9c",
                                "text": "Der Billerbeck trägt nie die Pullover, die die Billerbeck ihm strickt."
                            },
                            {
                                "example_id": "ef70529e-a35e-4110-ab3a-547a4e7d3bda",
                                "sense_id": "2543bf9d-3b1b-3604-9301-3af3ec12fd9c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Billerbeck kommt, geht der Herr Billerbeck.“"
                            },
                            {
                                "example_id": "fa09c508-f8c2-4725-8d3a-ca860a832b68",
                                "sense_id": "2543bf9d-3b1b-3604-9301-3af3ec12fd9c",
                                "text": "Billerbeck kommt und geht."
                            },
                            {
                                "example_id": "5adc2b68-fc94-4816-82f5-6645c4bc5e41",
                                "sense_id": "2543bf9d-3b1b-3604-9301-3af3ec12fd9c",
                                "text": "Billerbecks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
