    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                "word": "instrumentality",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "855d9bb4-61c0-4366-89a4-7ffc20983cdf",
                        "entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                        "tags": [
                            "plural"
                        ],
                        "form": "instrumentalities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08523bb0-37e8-34cc-8a5d-a8284ed748ef",
                        "entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                        "glosses": [
                            "The condition or quality of being instrumental; being useful; serving a purpose."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c9750cbe-1588-40c4-98ee-9d53b507c8a5",
                                "sense_id": "08523bb0-37e8-34cc-8a5d-a8284ed748ef",
                                "text": "In a later vision the Saviour revealed to her in detail the 'great design' which he wished to establish through her instrumentality."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a7a9261-00f9-339e-b4df-d83447d48b8f",
                        "entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                        "glosses": [
                            "Something that is instrumental; an instrument."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b29a99a-4dd1-4233-b792-540079183f6e",
                                "sense_id": "6a7a9261-00f9-339e-b4df-d83447d48b8f",
                                "text": "Delays and failures will only set her to casting about for new instrumentalities."
                            },
                            {
                                "example_id": "0a5fc525-613a-4ec0-a5c5-13f3a98e858e",
                                "sense_id": "6a7a9261-00f9-339e-b4df-d83447d48b8f",
                                "text": "God works by instrumentalities, and he has wonderfully thus far interposed in keeping evils that I feared in abeyance."
                            },
                            {
                                "example_id": "03f59d76-e28d-4bc3-a494-398684b820ac",
                                "sense_id": "6a7a9261-00f9-339e-b4df-d83447d48b8f",
                                "text": "He spoke of the various instrumentalities which were now employed for the conversion of the world."
                            }
                        ]
                    },
                    {
                        "sense_id": "455880ab-0efd-3a3d-b8df-cc5edf4d0a90",
                        "entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                        "glosses": [
                            "A governmental organ with a specific purpose."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f98460-4bd7-49ad-ac08-c9be38e0bdda",
                                "sense_id": "455880ab-0efd-3a3d-b8df-cc5edf4d0a90",
                                "text": "Any work in which the copyright was ever owned or administered by the Alien Property Custodian and in which the restored copyright would be owned by a government or instrumentality thereof, is not a restored work."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7b23f22-c929-4751-b884-50593041adaa",
                        "source_entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                        "source_sense_description": "quality or condition of being instrumental",
                        "target_lang_word": "Hilfe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hilfe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "486621c5-baeb-3876-8e3b-e106ffdd4209",
                                        "entry_id": "b2fc31c1-f89e-3497-b62d-7df0fc5ac376",
                                        "glosses": [
                                            "aktive Unterstützung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8933cd12-f5e4-45ba-876e-994bd58a2f90",
                                                "sense_id": "486621c5-baeb-3876-8e3b-e106ffdd4209",
                                                "text": "Es war eine große Hilfe, dass wir seinen PKW vorübergehend nutzen konnten."
                                            },
                                            {
                                                "example_id": "e41b7de1-868d-42f0-96cb-8d66f697da0b",
                                                "sense_id": "486621c5-baeb-3876-8e3b-e106ffdd4209",
                                                "text": "Ich brauche dringend Hilfe!"
                                            },
                                            {
                                                "example_id": "fdca47ec-67b2-465c-a36d-202ac5be445a",
                                                "sense_id": "486621c5-baeb-3876-8e3b-e106ffdd4209",
                                                "text": "„Wir dankten ihm alle für seine Hilfe und die problemlose Einreise in sein Land.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e2f5d6b-2fb2-3584-bf40-56bbaaabf0c2",
                                        "entry_id": "b2fc31c1-f89e-3497-b62d-7df0fc5ac376",
                                        "glosses": [
                                            "finanzielle Hilfe, Unterstützung durch Geldmittel"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c6b8aa6-ee8b-4e6e-b4ac-7c5bca589142",
                                                "sense_id": "1e2f5d6b-2fb2-3584-bf40-56bbaaabf0c2",
                                                "text": "Als sein Konto überzogen war, bekam er eine Hilfe von seinen Eltern."
                                            },
                                            {
                                                "example_id": "af21329a-60d7-4d5e-9f35-cccdf2119b6f",
                                                "sense_id": "1e2f5d6b-2fb2-3584-bf40-56bbaaabf0c2",
                                                "text": "Das Land wird seine Hilfen an den Nachbarstaat einstellen müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41d9567b-1b3a-3e51-a6dc-b37fe6bd023b",
                                        "entry_id": "b2fc31c1-f89e-3497-b62d-7df0fc5ac376",
                                        "glosses": [
                                            "Hilfsmittel, um eine beeinträchtigte oder verlorene Funktion des Körpers ausführen zu können"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdfe26d7-fbcf-4083-b579-0788d34a67c0",
                                                "sense_id": "41d9567b-1b3a-3e51-a6dc-b37fe6bd023b",
                                                "text": "Sie bekommt für die Hilfen, auf die sie seit der Operation angewiesen ist, finanzielle Unterstützung von der Stiftung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ab38a23f-0a32-362f-a05a-31f88bbcbe05",
                                        "entry_id": "b2fc31c1-f89e-3497-b62d-7df0fc5ac376",
                                        "glosses": [
                                            "Hilfskraft, Person, die hilfreich tätig ist"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb442b8-644e-4616-9ccd-a9b0b5dc1dc7",
                                                "sense_id": "ab38a23f-0a32-362f-a05a-31f88bbcbe05",
                                                "text": "Ach, ich hätte so gerne eine Hilfe im Haushalt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "77bad61b-06b6-3c2e-8e4f-91500aa8497c",
                                        "entry_id": "b2fc31c1-f89e-3497-b62d-7df0fc5ac376",
                                        "glosses": [
                                            "Programm^([1]) oder Programmteil, in dem Erläuterungen zu einer bestimmten Sache oder dem Programm stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50022465-a294-4fce-843a-bac8de2aff4a",
                                                "sense_id": "77bad61b-06b6-3c2e-8e4f-91500aa8497c",
                                                "text": "Schau doch mal in der Hilfe nach, was da zu „error 101“ steht."
                                            },
                                            {
                                                "example_id": "27ab125d-93bd-40c0-a1ab-4519fc267809",
                                                "sense_id": "77bad61b-06b6-3c2e-8e4f-91500aa8497c",
                                                "text": "In vielen Situationen können Sie mit einem Tastendruck bereits die Hilfe zu einem speziellen Thema aufrufen, das zum Dialogfeld passt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "cdee490c-f6ee-3f82-acaf-8d943397b527",
                                        "entry_id": "b2fc31c1-f89e-3497-b62d-7df0fc5ac376",
                                        "glosses": [
                                            "Gewichtsverlagerung, Schenkeldruck und Zügelführung, die dazu dienen, einem Pferd mitzuteilen, was der Reiter von ihm will"
                                        ],
                                        "tags": [
                                            "Pferdesport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "830de169-8e86-4058-8b63-ca313a862e16",
                                                "sense_id": "cdee490c-f6ee-3f82-acaf-8d943397b527",
                                                "text": "Die Stute reagierte prompt auf die Hilfen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "128c4ad6-779c-4beb-ac51-3ffb64a5ab50",
                        "source_entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                        "source_sense_description": "quality or condition of being instrumental",
                        "target_lang_word": "Hilfestellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hilfestellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                        "entry_id": "342bb31f-99a1-39de-8313-90748c02b952",
                                        "glosses": [
                                            "aktive Hilfe, Unterstützung von jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e467fc-ef7d-43fd-a883-fe85efb9e3aa",
                                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                                "text": "„Die Aufgabe 3 wurde bereits in der Schule – also mit Hilfestellung der Lehrerin – begonnen.“"
                                            },
                                            {
                                                "example_id": "d0ed42fd-f5eb-441b-8c9d-29b8c4d22d12",
                                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                                "text": "„Sie soll nun ‚blind‘ über die Bank balancieren, wobei sie die sehende Partnerin begleitet und ihr Hilfestellung gibt.“"
                                            },
                                            {
                                                "example_id": "28cea554-ffbd-4c72-b8fd-fd4db38e168e",
                                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                                "text": "„Dieses Buch ist als praktische Hilfestellung für all jene gedacht, die sich als Entwickler, Manager oder Studierende mit der Fragestellung des effizienten Testens von Software auseinandersetzen.“"
                                            },
                                            {
                                                "example_id": "4464f4e3-05e6-489b-92b9-bcd68276bcc7",
                                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                                "text": "„Hier erhalten Sie konkrete Hilfestellung bei der Planung Ihres Gartens und der Wahl der für Sie und Ihr Stück Land passenden Pflanzen.“"
                                            },
                                            {
                                                "example_id": "58e75a55-bc49-4d38-82b0-4ab272ea7090",
                                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                                "text": "„Gerade bei jüngeren Kindern bis zu 10 Jahren geben Mütter vergleichsweise viel Hilfestellung und ignorieren kindliche Ansprüche selten.“"
                                            },
                                            {
                                                "example_id": "1f553bbb-6b8d-4988-8565-e3f0ce3a8dca",
                                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                                "text": "„Nur durch eine gute Aufklärung und eine Hilfestellung kommt es zum nachhaltigen Erfolg.“"
                                            },
                                            {
                                                "example_id": "c7107c64-03e4-4180-b15b-828385e9e1c2",
                                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                                "text": "„Die Hilfsperson stellt sich nun hinter den Patienten und gibt ihm Hilfestellung während des Hochstemmens in den aufrechten Stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d6e9a21-b984-3a9a-807d-69f8226b0631",
                                        "entry_id": "342bb31f-99a1-39de-8313-90748c02b952",
                                        "glosses": [
                                            "Person, die jemandem bei etwas behilflich ist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
