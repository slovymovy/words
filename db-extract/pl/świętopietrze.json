                "senses": [
                    {
                        "sense_id": "232e01fa-a3d3-3a60-baf8-287fb08217d7",
                        "entry_id": "5b39cab0-af77-31fa-af4b-72bad3ea9226",
                        "glosses": [
                            "katolicka opłata na rzecz papiestwa, wnoszona w średniowieczu przez kraje uznające zwierzchnictwo Kościoła katolickiego, a współcześnie dobrowolnie oddawana przez parafian w niedzielę najbliższą dniowi św. Piotra i Pawła (29 czerwca)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c3e3e2-f297-4cc3-9e85-c2daebd4a69a",
                                "sense_id": "232e01fa-a3d3-3a60-baf8-287fb08217d7",
                                "text": "A biskup Wawrzyniec był zdania nieco odmiennego, uważając mianowicie, iż książęce wolnizny bynajmniej nie obejmują należnego Kościołowi świętopietrza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
