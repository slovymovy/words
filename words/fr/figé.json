                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le froid intense a <w>figé</w> l'eau de la fontaine en quelques heures.",
                            "target_lang_translations": {
                                "en": "Intense cold <w>froze</w> the fountain's water within a few hours.",
                                "ru": "Вода в фонтане за несколько часов <w>застыла</w> от сильного мороза.",
                                "de": "Die strenge Kälte hat das Wasser im Brunnen innerhalb weniger Stunden <w>gefrieren</w> lassen.",
                                "es": "El frío intenso ha <w>congelado</w> el agua de la fuente en pocas horas.",
                                "zh": "严寒在几个小时内就把喷泉里的水<w>冻结</w>了。"
