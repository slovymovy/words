                "senses": [
                    {
                        "sense_id": "dd32ca98-44f7-3d50-815c-bd6bdacf3202",
                        "entry_id": "f608057e-4aff-3d1d-9f98-d1d91879af2a",
                        "glosses": [
                            "eine Familie, in der von unterschiedlichen Elternteilen stammende Kinder (aus der aktuellen oder aus vorangehenden Beziehungen) leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c3a3f87-ee7c-42bc-8054-a4439faf32ef",
                                "sense_id": "dd32ca98-44f7-3d50-815c-bd6bdacf3202",
                                "text": "Die Heilige Familie kann mit großem Recht als Patchworkfamilie bezeichnet werden."
                            },
                            {
                                "example_id": "c41688df-34f2-4b9c-89e1-7e0c8508d0ea",
                                "sense_id": "dd32ca98-44f7-3d50-815c-bd6bdacf3202",
                                "text": "Im 19. Jahrhundert entstanden Patchworkfamilien durch Tod einzelner Familienmitglieder; im 21. Jahrhundert liegt die Hauptursache für die Bildung von Patchworkfamilien in der Trennung von Ehepartnern."
                            },
                            {
                                "example_id": "9310d796-fd9b-47d3-b7df-29e1e4c66e30",
                                "sense_id": "dd32ca98-44f7-3d50-815c-bd6bdacf3202",
                                "text": "„Nirgendwo fällt dies schwerer als in Patchworkfamilien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b43ae0f9-87dd-4f88-a2f1-7b51cec15c01",
                        "source_entry_id": "f608057e-4aff-3d1d-9f98-d1d91879af2a",
                        "source_sense_id": "dd32ca98-44f7-3d50-815c-bd6bdacf3202",
                        "target_lang_word": "blended family",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blended family",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "506f14b0-ceb4-33c9-9c90-1a2fa7cee9c7",
                                        "entry_id": "bae0b682-615c-3af4-b66c-e6a08ea4aa67",
                                        "glosses": [
                                            "A stepfamily in which both new spouses have one or more living children from prior partners."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93e28ae0-fca7-4cfc-8028-298f8ed8304e",
                                                "sense_id": "506f14b0-ceb4-33c9-9c90-1a2fa7cee9c7",
                                                "text": "The new traditions established in a blended family are either a blend of traditions both mates have brought into the marriage or something completely new. Because of Adrienne's and my family backgrounds, the blend of most of our traditions […]"
                                            },
                                            {
                                                "example_id": "8bb47e03-7b29-4eb3-a01a-c904e6cf9811",
                                                "sense_id": "506f14b0-ceb4-33c9-9c90-1a2fa7cee9c7",
                                                "text": "In a blended family you may have a stepmother, a stepfather, stepbrothers, stepsisters, half brothers, half sisters, and even step-pets! You've got all sorts of stuff mixed into one new, blended family—a family that you are an important part of!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ff9109a-5f4b-4a78-83bb-0f04624fa60e",
                        "source_entry_id": "f608057e-4aff-3d1d-9f98-d1d91879af2a",
                        "source_sense_id": "dd32ca98-44f7-3d50-815c-bd6bdacf3202",
                        "target_lang_word": "famille recomposée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "famille recomposée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fbd660d-3c75-36fe-b492-f0423f3068cb",
                                        "entry_id": "7892c0dd-4293-3c5c-b81b-c0b104e33292",
                                        "glosses": [
                                            "Famille constituée à la suite d’une séparation, d’un divorce ou d’un veuvage, lorsqu’un nouveau couple se forme et qu’il élève au moins un enfant né d’une union antérieure de l’un des conjoints."
                                        ],
                                        "tags": [
                                            "Sociologie de la famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6811e5e9-10a6-4662-8d83-2ca3fff26955",
                                                "sense_id": "6fbd660d-3c75-36fe-b492-f0423f3068cb",
                                                "text": "La famille recomposée, proposant une multiplication des liens entre les individus, interroge directement la question de la parentalité : primauté du parent biologique ou du parent domestique ?"
                                            },
                                            {
                                                "example_id": "4d50da20-b76b-4995-8957-02f9c9b75eb1",
                                                "sense_id": "6fbd660d-3c75-36fe-b492-f0423f3068cb",
                                                "text": "Cette histoire de familles recomposées n’était à mon avis qu’une dégoûtante foutaise, quand bien même il ne s’agissait pas d’une propagande pure, optimiste et postmoderne, décalée, dédiée aux CSP+ et CSP++, inaudible au-delà de la porte de Charenton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
