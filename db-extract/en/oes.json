            {
                "entry_id": "19df2450-66b8-3116-84db-693479bf8a26",
                "word": "oes",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d4820195-6298-37f1-a333-9592c725a28f",
                        "entry_id": "19df2450-66b8-3116-84db-693479bf8a26",
                        "glosses": [
                            "plural of oe"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6cfd1aae-46c4-39b6-8918-6e05b8437b81",
                        "entry_id": "19df2450-66b8-3116-84db-693479bf8a26",
                        "glosses": [
                            "plural of o, the name of the letter O."
                        ],
                        "tags": [
                            "form-of",
                            "plural",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5ac27d1c-52d8-429f-990e-11d95f773906",
                                "sense_id": "6cfd1aae-46c4-39b6-8918-6e05b8437b81",
                                "text": "A, aes; Bee, Bees; Cee, Cees; Dee, Dees; E, Ees; Eff, Effs; Gee, Gees; Aitch, Aitches; I, Ies; Jay, Jays; [...] En, Ens; O, Oes; Pee, Pees; Kue, Kues; Ar, Ars; […] Wy, Wies; Zed, Zeds."
                            },
                            {
                                "example_id": "c149a7a8-d103-4fab-99de-11feaafd6b9a",
                                "sense_id": "6cfd1aae-46c4-39b6-8918-6e05b8437b81",
                                "text": "Mouthing out his hollow oes and aes, / Deep-chested music."
                            },
                            {
                                "example_id": "e1587ebe-bda2-40f7-b2f2-f05befc184b6",
                                "sense_id": "6cfd1aae-46c4-39b6-8918-6e05b8437b81",
                                "text": "These names […] may form regular plurals; thus, Aes, Bees, Cees, Dees, Ees, Effs, Gees, Aitches, Ies, Jays, Kays, Ells, Ems, Ens, Oes, Pees, Kues, Ars, Esses, Tees, Ues, Vees, Double-ues, Exes, Wies, Zees."
                            },
                            {
                                "example_id": "67eb73c6-26af-4dd5-8eac-d9ce9ed800f3",
                                "sense_id": "6cfd1aae-46c4-39b6-8918-6e05b8437b81",
                                "text": "[It] is desirable [...] that we may have a shorter and simpler term in stead of Double-u. [...] Dr. Webster [...] is not yet tired of his experiment with \"oo;\" but thinks still to make the vowel sound of this letter its name. Yet [...] If W is to be named as a vowel, it ought to name itself, as other vowels do, and not to take two Oes for its written name. Who that knows what it is, to name a letter, can think of naming w by double o?"
                            }
                        ]
                    }
