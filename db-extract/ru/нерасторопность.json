                "translations": [
                    {
                        "translation_id": "9d0ce267-8ee5-484a-bb28-a12d78b8926c",
                        "source_entry_id": "b7a7766e-4f76-3b6a-b1fc-72f29402495b",
                        "source_sense_id": "07a6731f-61d6-3ce0-adf6-574b01a07252",
                        "target_lang_word": "lenteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lenteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                        "entry_id": "f13021fb-626c-3a45-bcc3-3bf152738a43",
                                        "glosses": [
                                            "Manque de rapidité dans le mouvement et dans l’action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504d0991-e3a6-45b8-abe5-f719bedcaf5c",
                                                "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                                "text": "Leur procession par les rues se déroule avec la lenteur habituelle, sa psalmodie sourde, […]."
                                            },
                                            {
                                                "example_id": "73d4b9c7-f562-47c4-8cbe-568df80d81d1",
                                                "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                                "text": "Libre à d'autres de rire d'une lenteur apparente, d'une hésitation qui est scrupule, d'une méthode qu'on croit inhabile."
                                            },
                                            {
                                                "example_id": "8f7b46ed-4355-4ed5-928e-cca6a02a0141",
                                                "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                                "text": "Pendant ce temps, la mère, surprise de la lenteur de sa fille à se décider, étonnée de trouver ce jeune marchand si peu pratique, si peu désireux de vendre, s'impatientait."
                                            },
                                            {
                                                "example_id": "86c6b5ca-9153-4d1c-90e1-fe0009bd9075",
                                                "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                                "text": "Les trente dernières secondes avant onze heures lui parurent durer une éternité. La trotteuse du chronographe sautillait sur les points phosphorescents avec une horripilante lenteur. Elle finit tout de même par s'immobiliser au-dessus du chiffre douze , […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d968fed9-b71f-398d-a3ad-25d24017b310",
                                        "entry_id": "f13021fb-626c-3a45-bcc3-3bf152738a43",
                                        "glosses": [
                                            "Difficulté, peine, à imaginer, à concevoir."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76dcd4dc-dc58-4d6f-8a58-f0201bb686ea",
                                                "sense_id": "d968fed9-b71f-398d-a3ad-25d24017b310",
                                                "text": "Avoir une grande lenteur d’imagination, une grande lenteur d’esprit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "437ad6b1-fe38-3de0-a202-a482d87b10f0",
                                        "entry_id": "f13021fb-626c-3a45-bcc3-3bf152738a43",
                                        "glosses": [
                                            "Manque de tonus, d'action dans une pièce de théâtre, un roman, un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2f8bf1-644e-4ace-a148-3dc610c860f2",
                                                "sense_id": "437ad6b1-fe38-3de0-a202-a482d87b10f0",
                                                "text": "On a blâmé, dans cette pièce, dans ce roman la lenteur de l’action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "504d44c7-850b-4c94-8f2a-7d883a70a8f7",
                        "source_entry_id": "b7a7766e-4f76-3b6a-b1fc-72f29402495b",
                        "source_sense_id": "07a6731f-61d6-3ce0-adf6-574b01a07252",
                        "target_lang_word": "indolence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indolence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22512ef9-3fdd-3ebe-ba2a-c478d4978a7c",
                                        "entry_id": "466dd7e9-8930-3abd-b1bb-4c50cf0545d7",
                                        "glosses": [
                                            "Disposition à éviter tout effort, toute peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f81fb81-b5e4-47dc-a70a-17bad092f055",
                                                "sense_id": "22512ef9-3fdd-3ebe-ba2a-c478d4978a7c",
                                                "text": "Appuyée sur le dos du siège et légèrement inclinée, la tête de ce brave père restait dans une pose dont l’indolence peignait un calme parfait, un doux épanouissement de joie."
                                            },
                                            {
                                                "example_id": "02847878-7f63-4cf0-9711-00537e9af640",
                                                "sense_id": "22512ef9-3fdd-3ebe-ba2a-c478d4978a7c",
                                                "text": "Le ciel trop doux, le soleil trop resplendissant, l’air où traînait comme un souffle de langueur, qui invitait à l’indolence et à la volupté très lente, […]"
                                            },
                                            {
                                                "example_id": "0ff5e5db-e27a-42d5-87a8-171a0ce5b0fd",
                                                "sense_id": "22512ef9-3fdd-3ebe-ba2a-c478d4978a7c",
                                                "text": "On aurait pu se croire dans un fumoir anglais\nNous sirotions à deux un breuvage irlandais\nQui donnait à chacun une diction pâteuse\nUne douce apathie, une indolence heureuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
