                                    {
                                        "sense_id": "d82d0b88-3311-3921-99d4-1ef3e96bc2b2",
                                        "entry_id": "3643ac5a-37f8-3fdb-87ce-280b68f7448a",
                                        "glosses": [
                                            "een weg, bestaande uit één of meer sporen. Een spoor bestaat uit twee evenwijdige stalen staven, spoorstaaf of rail geheten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978505c5-532c-4f46-943c-6fb1b6c09ac4",
                                                "sense_id": "d82d0b88-3311-3921-99d4-1ef3e96bc2b2",
                                                "text": "In België ligt 3518 km spoorlijn met een spoorwijdte van 1435 mm, waarvan 2934 km geëlektrificeerd is."
                                            },
                                            {
                                                "example_id": "6b0af0a7-2541-4d5d-92a1-af505ef3469a",
                                                "sense_id": "d82d0b88-3311-3921-99d4-1ef3e96bc2b2",
                                                "text": "Uren en uren trok ik door het uitgestorven landschap toen ik plotseling een hele tijd moest wachten om een spoorlijn over te steken waar juist een lange goederentrein met een slakkengang langskwam."
                                            },
                                            {
                                                "example_id": "89f2b350-27bd-40b2-8e82-5a29e04e7352",
                                                "sense_id": "d82d0b88-3311-3921-99d4-1ef3e96bc2b2",
                                                "text": "Hardangervidda. De Spoorlijn Bergen. Daar was zijn ingenieursleven begonnen toen hij nog niet meer dan een groentje was en nu tegen het einde van dat beroepsleven was het alsof hij weer opnieuw moest beginnen."
                                            }
                                        ]
                                    }
                                ]
                            }
