                ],
                "senses": [
                    {
                        "sense_id": "fce4decf-2eac-35ec-824f-dee515d5edbd",
                        "entry_id": "b2e5fea4-c27d-33b5-8d03-9d4fc7ba4d95",
                        "glosses": [
                            "Qui suinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d3d8ce-5e3d-4e53-92b3-25ed18f8ac83",
                                "sense_id": "fce4decf-2eac-35ec-824f-dee515d5edbd",
                                "text": "Elle ne sortait jamais de sa maison, un ancien couvent, vaste et humide où elle devait se déplacer en plein jour le long des murs suintants de galeries interminables, une bougie à la main."
                            },
                            {
                                "example_id": "f996e1e0-dd9d-4df9-8653-ac8ecc3a1ed1",
                                "sense_id": "fce4decf-2eac-35ec-824f-dee515d5edbd",
                                "text": "Lo… installait maintenant sur le sol une planche noire, suintante d'humidité, souillée et gluante des vomissures laissées sans doute par d'autres « clients »."
                            },
                            {
                                "example_id": "b1a8a8f0-da42-4cf3-9c7c-5dd5cf0dfde5",
                                "sense_id": "fce4decf-2eac-35ec-824f-dee515d5edbd",
                                "text": "Elle en avait contracté l'eczéma de la face, une éruption suintante qui la dévorait de sa brûlure atroce."
                            },
                            {
                                "example_id": "2d6eba8a-e6be-4baa-bbf9-a57b860b4748",
                                "sense_id": "fce4decf-2eac-35ec-824f-dee515d5edbd",
                                "text": "Les couloirs et les escaliers étaient étroits et sales, suintants d’humidité, imprégnés de fumées graisseuses."
                            }
                        ]
                    }
                ],
