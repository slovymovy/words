                                    {
                                        "sense_id": "0ea72f4c-fd74-3780-92ae-6fb1460cd137",
                                        "entry_id": "1fb83022-8423-3b67-9fa4-43b5b06fa4d7",
                                        "glosses": [
                                            "atteggiamento caratteristico di chi nega ogni esistenza fuori della propria e pratica l'egoismo e l'amore esclusivo di sé stessi"
                                        ],
                                        "tags": [],
