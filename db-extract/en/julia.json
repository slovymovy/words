    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                "word": "Julia",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "55c44905-d27e-4301-b1b7-a3489eb9b056",
                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "Julias"
