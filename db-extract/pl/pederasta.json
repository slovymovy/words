                            {
                                "example_id": "ac92fb71-64c9-4c4b-91c3-2a7b30174d78",
                                "sense_id": "c270000f-7b31-315b-9e76-42e07bd7b363",
                                "text": "Z powodu poprawności politycznej nie wolno pisać „Cygan”, należy używać określenia „Rom”; nie należy mówić „homoseksualista”, a tym bardziej „pederasta”, tylko – „gej”; zabroniony też jest „Murzyn”, bo bardziej neutralny jest „czarnoskóry”, „Afroamerykanin” albo „czarny”."
                            }
                        ],
