            {
                "entry_id": "22b42395-18c4-3f1c-bfbd-9f3eeb76ad2a",
                "word": "guurheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d7431ec4-cfe4-44d1-8bee-205ecf364ee2",
                        "entry_id": "22b42395-18c4-3f1c-bfbd-9f3eeb76ad2a",
                        "tags": [
                            "plural"
                        ],
                        "form": "guurheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3c29314-dec1-37a2-95db-5c9bb023d688",
                        "entry_id": "22b42395-18c4-3f1c-bfbd-9f3eeb76ad2a",
                        "glosses": [
                            "van het weer dat het koud, winderig en vaak ook regenachtig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95899936-45a9-429e-86e6-660fc95e2b1b",
                                "sense_id": "e3c29314-dec1-37a2-95db-5c9bb023d688",
                                "text": "Misschien kwam het door de snerpende, maartse guurheid, misschien was het een toevallige botsing van twee slechte humeuren, misschien was het een combinatie van dergelijke factoren, hoe dan ook – er ging iets fout."
                            },
                            {
                                "example_id": "ae50dd0f-c431-4f66-92f3-9df752f8b42b",
                                "sense_id": "e3c29314-dec1-37a2-95db-5c9bb023d688",
                                "text": "Het lijkt wel alsof januari niet alleen een maand van kou en guurheid was, maar ook van ziekte en dood. Meteen op nieuwjaarsdag schoot een als kerstman verklede terrorist 39 mensen dood in een nachtclub in Istanbul. Op onze Driestar werden we evenzeer met de dood geconfronteerd. En in Sliedrecht overleed onze oud-predikant, ds. J. den Hoed. Het overlijden van de predikant bracht, wonderlijk en vreemd genoeg, in mijn somberheid toch weer een keer."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a509a14-9e2d-3f82-8436-eaf46b9842f6",
                        "entry_id": "22b42395-18c4-3f1c-bfbd-9f3eeb76ad2a",
                        "glosses": [
                            "kille onvriendelijkheid zonder enige menselijke warmte en genegenheid"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "25fe83e0-4dcb-49f6-817b-495cb7700ef9",
                                "sense_id": "6a509a14-9e2d-3f82-8436-eaf46b9842f6",
                                "text": "De guurheid van het seculiere Nederland is heidendom pur sang. De media overrompelen ons dag aan dag met het tot godheid verheven ”ik-gevoel”. Immers, ”ik” ben mijn eigen kleine ”godje”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75e776d5-ee90-4d31-b4fa-667e5b91e3eb",
                        "source_entry_id": "22b42395-18c4-3f1c-bfbd-9f3eeb76ad2a",
                        "source_sense_id": "e3c29314-dec1-37a2-95db-5c9bb023d688",
                        "source_sense_description": "koud, winderig en regenachtig",
                        "target_lang_word": "roughness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roughness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37dacd54-e63d-3ba4-95d3-53732b2a24b7",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "The property of being rough, coarseness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31aa7178-2c66-4b4e-86a4-f808dfad0bdc",
                                                "sense_id": "37dacd54-e63d-3ba4-95d3-53732b2a24b7",
                                                "text": "The roughness of the road made me wonder if my car would fall apart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58f632a3-d0c4-3395-9fa3-c41f67b791f1",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "Something that is rough; a rough spot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff92052-290f-4f19-8dc6-9a7e966492c9",
                                                "sense_id": "58f632a3-d0c4-3395-9fa3-c41f67b791f1",
                                                "text": "A variety of suitable methods for surface inspection are available to detect topographical defects induced by surface roughnesses such as scratches, digs, inclusions and spatters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5460a0e3-40f3-3920-a5f6-b82e29012200",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "Roughage; coarse fodder."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3759e737-3172-4c78-b0d6-deba80b6393f",
                                                "sense_id": "5460a0e3-40f3-3920-a5f6-b82e29012200",
                                                "text": "With this latter implement, the corn stalk fodder, shucks, oats, hay and other \"roughness\" may be finely cut up […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd32169-7d36-3a37-8856-9e2f14517d9e",
