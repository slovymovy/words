                                                "example_id": "0bfcdb7d-ffef-4401-8bb6-2eda1ec31cb3",
                                                "sense_id": "ae4ee672-42f2-370a-9cfb-dcde62f17fb8",
                                                "text": "„An griechischen Stränden gibt es keine Strandmuscheln und auch kein FKK.“"
                                            }
