                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Jargon in Kriminalität und Kriminalromanen"
                        }
                    ]
                },
                {
                    "sense_id": "20f292e0-b7d2-3c00-bb93-8dcd89ee790b",
                    "sense_definition": "Jemanden oder etwas aus einer Bindung, Gefangenschaft oder Verpflichtung befreien.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Gefangene hoffte vergebens darauf, dass man ihn aus seinen Banden <w>erledige</w>."
                        },
                        {
                            "text": "In den alten Urkunden heißt es, dass der Herrscher die Bürger von Abgaben <w>erledigte</w>."
                        }
                    ],
                    "synonyms": [
                        "befreien"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "im modernen Deutsch nicht mehr gebräuchlich"
