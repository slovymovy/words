                ],
                "senses": [
                    {
                        "sense_id": "68229864-7e9c-3962-a57a-edaa0d7c4fdf",
                        "entry_id": "0cdb1f9a-e87a-3eda-aad1-04ee14acad8f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43de16e8-63b8-48ef-9c0a-8998a7e64904",
                                "sense_id": "68229864-7e9c-3962-a57a-edaa0d7c4fdf",
                                "text": "Frau Mergele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0fd52b68-05a9-44b7-8777-6b676ab7e0ed",
                                "sense_id": "68229864-7e9c-3962-a57a-edaa0d7c4fdf",
                                "text": "Herr Mergele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "af6fb4e0-6078-40bd-affd-c5b581f5689e",
                                "sense_id": "68229864-7e9c-3962-a57a-edaa0d7c4fdf",
                                "text": "Die Mergeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "80ab9411-f0ad-4416-a7fb-3d5501c886d7",
                                "sense_id": "68229864-7e9c-3962-a57a-edaa0d7c4fdf",
                                "text": "Der Mergele trägt nie die Schals, die die Mergele ihm strickt."
                            },
                            {
                                "example_id": "83e4a992-04bf-4527-adea-cb1d5139f82d",
                                "sense_id": "68229864-7e9c-3962-a57a-edaa0d7c4fdf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mergele kommt, geht der Herr Mergele.“"
                            },
                            {
                                "example_id": "40a2cf4f-0c4d-4e7a-822e-d2fa3a1ba7e1",
                                "sense_id": "68229864-7e9c-3962-a57a-edaa0d7c4fdf",
                                "text": "Mergele kommt und geht."
                            },
                            {
                                "example_id": "11fd1136-c541-453e-ad60-ae807768d4b5",
                                "sense_id": "68229864-7e9c-3962-a57a-edaa0d7c4fdf",
                                "text": "Mergeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
