                "senses": [
                    {
                        "sense_id": "0de3de97-aa95-36a4-a177-7cdee4729007",
                        "entry_id": "47f055fd-dff7-3609-8dfd-15a4e7855024",
                        "glosses": [
                            "Genre botanique d’arbres et arbrisseaux regroupant environ 700 espèces et dont l’espèce câprier épineux (nom scientifique : Capparis spinosa) porte les câpres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d697c698-28c5-4a2a-b9fe-f6c0475661cd",
                                "sense_id": "0de3de97-aa95-36a4-a177-7cdee4729007",
                                "text": "C'est surtout entre Marseille et Toulon, dans les communes de Cujes, de Roquevaire et d’Ollioules, que la culture du câprier est devenue un objet de spéculations assez importantes."
                            },
                            {
                                "example_id": "f0f830b9-b1c2-4fc6-9fdf-cb3f37e2e4b4",
                                "sense_id": "0de3de97-aa95-36a4-a177-7cdee4729007",
                                "text": "La chaleur était déjà accablante, elle regarda de petits lézards qui fuyaient sur les dalles disjointes, entre des touffes chevelues de câpriers."
                            },
                            {
                                "example_id": "3afeb452-a6dd-4131-a13e-723dea10dadb",
                                "sense_id": "0de3de97-aa95-36a4-a177-7cdee4729007",
                                "text": "Des câpriers épineux dressaient au hasard leurs têtes vertes sur la brume fine des graminées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88710a2d-97a5-473a-8060-e637236ae0b2",
                        "source_entry_id": "47f055fd-dff7-3609-8dfd-15a4e7855024",
