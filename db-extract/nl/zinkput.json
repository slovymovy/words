                    {
                        "sense_id": "dc347591-8998-3dbb-b99d-0ca62ec4962d",
                        "entry_id": "79447724-7072-359c-b72e-3b69e9744eaa",
                        "glosses": [
                            "plaats waar afvalstoffen zich ophopen"
