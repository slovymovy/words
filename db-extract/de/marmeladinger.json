                        ],
                        "examples": [
                            {
                                "example_id": "1dddc972-f78a-432a-b07a-c1c39416f03a",
                                "sense_id": "6306af02-8b81-30a4-93e2-725afa3ac751",
                                "text": "„Ein Krügerl sind sechs Semmeln, würde er gleich sagen, aber als ich ihm einmal Butter und Marmelade ins Glas schmiss, wurde er wütend und brüllte mich an als Marmeladinger, ob ich sein Bier vergasen wolle, weil, das könnten wir ja so gut, das wär ja so ureigenurtypisch deutsch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e796900-d085-47ad-b231-0b89ccacfa81",
