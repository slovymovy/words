                        "sense_id": "06807067-8591-3619-a031-483a788f954b",
                        "entry_id": "78bb9ecb-388d-3e6e-8715-e6e77961026e",
                        "glosses": [
                            "In a stealthy manner, furtively."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "796ff500-915d-4a3d-be6e-a0bba09abe23",
                                "sense_id": "06807067-8591-3619-a031-483a788f954b",
                                "text": "The dog obeyed the significant beck of his finger, and they drew off, stealthily, together."
                            },
                            {
                                "example_id": "52d5ac8f-3791-483f-8436-773568419032",
                                "sense_id": "06807067-8591-3619-a031-483a788f954b",
                                "text": "So intent was he upon this personal appraisement of his features that he did not hear the parting of the tall grass behind him as a great body pushed itself stealthily through the jungle; nor did his companion, the ape, hear either, for he was drinking and the noise of his sucking lips and gurgles of satisfaction drowned the quiet approach of the intruder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5c8ea43-879f-4a5d-83e5-711cef60e495",
                        "source_entry_id": "78bb9ecb-388d-3e6e-8715-e6e77961026e",
                        "source_sense_id": "06807067-8591-3619-a031-483a788f954b",
                        "source_sense_description": "in a stealthy manner",
                        "target_lang_word": "kradmo",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kradmo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "32df9c1d-6120-38ec-91f3-0d29d334b73e",
                                        "entry_id": "f6540d3c-8588-3d98-b3b6-da12630175c9",
                                        "glosses": [
                                            "skrytě, nepozorovaně, nenápadně, potají"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "996c9ba4-591f-4df5-96d8-318294b83c8f",
                                                "sense_id": "32df9c1d-6120-38ec-91f3-0d29d334b73e",
                                                "text": "Kradmo se vloudila do spíže a začala si tiše pochutnávat na všech těch dobrotách."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49203bb5-4f22-4bdf-b0c1-08cd9387c414",
                        "source_entry_id": "78bb9ecb-388d-3e6e-8715-e6e77961026e",
                        "source_sense_id": "06807067-8591-3619-a031-483a788f954b",
                        "source_sense_description": "in a stealthy manner",
                        "target_lang_word": "stilletjes",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stilletjes",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b7bbb66e-f8de-3181-ae6f-aa09cc38d947",
                                        "entry_id": "2115159c-5b4d-30d0-aaaf-9ddec2b53884",
                                        "glosses": [
                                            "in stilte, in het geheim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b1de5b0-5a83-46d8-8e14-94c525046503",
                                                "sense_id": "b7bbb66e-f8de-3181-ae6f-aa09cc38d947",
                                                "text": "Ze vestigden zich in Haarlem of Leiden of keerden later stilletjes terug."
                                            },
                                            {
                                                "example_id": "28450481-30d9-49ed-ac5d-afc64eb2d778",
                                                "sense_id": "b7bbb66e-f8de-3181-ae6f-aa09cc38d947",
                                                "text": "Iedere avond sloop hij stilletjes naar de stal, rolde zich in een paardedeken en sliep lekker in het stro."
                                            },
                                            {
                                                "example_id": "207737d0-1806-4ebf-b8f9-d2aae9e797e7",
                                                "sense_id": "b7bbb66e-f8de-3181-ae6f-aa09cc38d947",
                                                "text": "Ik herhaalde mijn nieuwe naam een aantal keer stilletjes, ik was ‘Van Go’ geworden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stilletjes",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "deb72168-6042-3207-b6a6-b154c54a9ea1",
                                        "entry_id": "7f54ef10-cfd7-3859-aeeb-3f5ce73875bd",
                                        "glosses": [
                                            "verkleinwoord meervoud van het zelfstandig naamwoord stille"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "881ce159-59b2-45c0-9c07-802cb89a26e0",
                        "source_entry_id": "78bb9ecb-388d-3e6e-8715-e6e77961026e",
                        "source_sense_id": "06807067-8591-3619-a031-483a788f954b",
                        "source_sense_description": "in a stealthy manner",
                        "target_lang_word": "furtivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furtivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                        "entry_id": "a6825178-72da-39ae-86d6-145029f90bfc",
                                        "glosses": [
                                            "D’une manière furtive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692eb8d8-62bb-4d8d-b927-78f9f7e14852",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "La nouvelle d’une révolution en Macédoine lui fit prendre la résolution de sortir furtivement de Thèbes."
                                            },
                                            {
                                                "example_id": "b7565387-46af-4624-aa75-7ca238963e33",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Elles voudraient jouir furtivement du plaisir de vous aimer et d’être aimées sans que vous y prissiez garde."
                                            },
                                            {
                                                "example_id": "041cf9b5-a879-4430-9878-1966e27dbd65",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Anicet jette furtivement un poignard à ses pieds."
                                            },
                                            {
                                                "example_id": "72ef434e-a18c-4248-a346-d65d4e37d790",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Un coup d’œil caressant furtivement jeté."
                                            },
                                            {
                                                "example_id": "3b202553-6f99-49a6-b585-c0d483eb27ed",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Elle se savait belle et, lorsqu'elle était seule, il lui arrivait de tirer furtivement de sa poche un petit miroir pour s'y contempler."
                                            },
                                            {
                                                "example_id": "83e0f385-4c0a-468a-aa7d-1e7ae28e0d9c",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Une petite pluie froide faisait furtivement briller la couverture d'un appentis et tinter sur le zinc, à de rares intervalles, de pesantes gouttes d'eau qui s'échappaient d'une chanlatte percée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "194bac91-05d8-387a-8854-9f45fc9ec72a",
                                        "entry_id": "a6825178-72da-39ae-86d6-145029f90bfc",
                                        "glosses": [
                                            "D’une manière à échapper à la vigilance des radars des ennemis."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0268fd8-fccc-47a2-a094-61fc1c88a5f9",
                                                "sense_id": "194bac91-05d8-387a-8854-9f45fc9ec72a",
                                                "text": "Les éclaireurs volant furtivement ont pu photographier les installations nucléaires illicites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92bc3ce6-8b3b-4f7c-b169-f895676d5784",
                        "source_entry_id": "78bb9ecb-388d-3e6e-8715-e6e77961026e",
                        "source_sense_id": "06807067-8591-3619-a031-483a788f954b",
                        "source_sense_description": "in a stealthy manner",
                        "target_lang_word": "heimlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heimlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c86f1fc-fcda-3380-8f16-9bba71b80210",
                                        "entry_id": "4bf33485-e233-3f5b-adb8-86dd48386d49",
                                        "glosses": [
                                            "im Verborgenen, ohne das Wissen anderer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7066f53-c7fd-4a7c-83df-5e5a7aba75a0",
                                                "sense_id": "4c86f1fc-fcda-3380-8f16-9bba71b80210",
                                                "text": "Während der Arbeit benutzte Matthias heimlich das Internet."
                                            },
                                            {
                                                "example_id": "8b424dda-b40d-48f9-b1bb-8f0ac2d6fb09",
                                                "sense_id": "4c86f1fc-fcda-3380-8f16-9bba71b80210",
                                                "text": "Die heimliche Affäre des Präsidenten wurde nun doch öffentlich."
                                            },
                                            {
                                                "example_id": "fd81f389-93dd-440e-9dae-fff62e7cfbc7",
                                                "sense_id": "4c86f1fc-fcda-3380-8f16-9bba71b80210",
                                                "text": "„1933 setzt der Senat fünfzehn Jahren heimlicher Trinkerei ein Ende und legalisiert den Alkoholkonsum wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f1fb6fd-2b18-4621-afe0-4655f03f2832",
                        "source_entry_id": "78bb9ecb-388d-3e6e-8715-e6e77961026e",
                        "source_sense_id": "06807067-8591-3619-a031-483a788f954b",
