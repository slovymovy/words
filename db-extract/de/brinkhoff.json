                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7884099-c4ae-4311-8668-4a662bcdb5f1",
                                "sense_id": "1a06a227-6350-3245-8485-a142be127fff",
                                "text": "Frau Brinkhoff ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4c8e5bcc-9178-4fc2-a22e-1acbdc41beea",
                                "sense_id": "1a06a227-6350-3245-8485-a142be127fff",
                                "text": "Herr Brinkhoff wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8db18396-76f1-49c1-8da7-c9a5882bea74",
                                "sense_id": "1a06a227-6350-3245-8485-a142be127fff",
                                "text": "Die Brinkhoffs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "957ae349-3025-43cc-a807-de904e3f3bf3",
                                "sense_id": "1a06a227-6350-3245-8485-a142be127fff",
                                "text": "Der Brinkhoff trägt nie die Schals, die die Brinkhoff ihm strickt."
                            },
                            {
                                "example_id": "ed892367-bbf5-4bfb-91e5-f03cadf260ad",
                                "sense_id": "1a06a227-6350-3245-8485-a142be127fff",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brinkhoff kommt, geht der Herr Brinkhoff.“"
                            },
                            {
                                "example_id": "c0327e15-cbba-4ecc-901d-0a0ad62337ff",
                                "sense_id": "1a06a227-6350-3245-8485-a142be127fff",
                                "text": "Brinkhoff kommt und geht."
                            },
                            {
                                "example_id": "1751ffda-98ce-4ed1-95f0-7480b2bd1bf9",
                                "sense_id": "1a06a227-6350-3245-8485-a142be127fff",
                                "text": "Brinkhoffs kamen, sahen und siegten."
                            }
                        ],
