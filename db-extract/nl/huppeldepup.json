                    {
                        "sense_id": "cac808e3-9728-3800-9e14-12aa495781a5",
                        "entry_id": "e26b8827-f258-349c-b21b-80861375d691",
                        "glosses": [
                            "persoon waarvan je de naam niet meer precies weet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5657e285-f372-4edb-9f22-773ac033a982",
                                "sense_id": "cac808e3-9728-3800-9e14-12aa495781a5",
                                "text": "M. heeft u toegevoegd aan de groep huppeldepup. ‘Hoi allen, we vieren dan en dan de 43e verjaardag van Kees en we verwachten iedereen vanaf zo laat’."
                            },
                            {
                                "example_id": "1fdb81f8-33cb-4eca-ae58-bc34157570ce",
                                "sense_id": "cac808e3-9728-3800-9e14-12aa495781a5",
                                "text": "Zonder uitzondering is het personeel, van kamerjongen tot ober en van dekknecht tot eerste stuurman, vriendelijk. Zó vriendelijk zelfs dat je je als nuchtere Hollander afvraagt ,,of het misschien ook ietsje minder kan\". Dat begint al bij het applaus dat je krijgt van een aantal in onberispelijk wit gestoken scheepsmeisjes als je je eerste voet aan boord zet en je naam door het schip schalt, zodat alle andere gasten weten dat de familie Huppeldepup óók is ingescheept..."
                            },
                            {
                                "example_id": "91ab5100-4390-4df7-80bb-ee20073fb741",
                                "sense_id": "cac808e3-9728-3800-9e14-12aa495781a5",
                                "text": "De organisatie van dit nieuwe initiatief is in handen van drie lokale bedrijven: Huppeldepup & Co., De Fotoloods en Joliens Theaterhuis."
                            }
                        ]
                    }
