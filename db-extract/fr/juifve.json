                                        "sense_id": "5ca9f3e7-6ac6-325d-9fce-e2924c280cb7",
                                        "entry_id": "6bb0fd4f-819d-3153-875e-dc3ad6f44e15",
                                        "glosses": [
                                            "One who believes and practices Judaism."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae0538d-627e-4ac6-ac76-1c17081c80d0",
                                                "sense_id": "5ca9f3e7-6ac6-325d-9fce-e2924c280cb7",
                                                "text": "All Judaists — those who practice the religion, Judaism — are Jews, but not all Jews are Judaists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
