                ],
                "senses": [
                    {
                        "sense_id": "1aadac5f-66a1-3a0a-9786-47d8658843e1",
                        "entry_id": "ec282ba0-d1ce-3d0d-901d-ea10cdf8cc9b",
                        "glosses": [
                            "organische Stoffwechselverbindung, die beim Abbau der Purine im Körper von Hominiden entsteht und durch Oxidation zu Harnsäure umgewandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb5bc2da-248a-4a41-9378-3a9febcf4bc3",
                                "sense_id": "1aadac5f-66a1-3a0a-9786-47d8658843e1",
                                "text": "Martins und ihre Kollegen fanden unter anderem die Nukleobasen Uracil, ein Bestandteil der RNA, und Xanthin, eine Substanz, die innerhalb von Zellen eine wichtige Rolle bei chemischen Reaktionen der RNA spielt."
                            },
                            {
                                "example_id": "ab27be7b-e880-4a0f-94e8-5baf76f3db9a",
                                "sense_id": "1aadac5f-66a1-3a0a-9786-47d8658843e1",
                                "text": "Xanthin im Tee lässt das Fett ebenso dahinschmelzen wie Theobromin in Kakao."
                            },
                            {
                                "example_id": "78a2558b-fa07-43a1-b341-05457f2f8b87",
                                "sense_id": "1aadac5f-66a1-3a0a-9786-47d8658843e1",
                                "text": "Zu seiner Überraschung erhielt er bei seinen Versuchen neben Aminosäuren, den Bausteinen der Proteine, auch etliche Nucleinsäuren - so Cytosin, das seltenere Uracil sowie Xanthin."
                            },
                            {
                                "example_id": "35cf47e5-af36-4988-9d70-baba0af8bca1",
                                "sense_id": "1aadac5f-66a1-3a0a-9786-47d8658843e1",
                                "text": "„Xanthin findet sich im Blut, im Harn und in der Leber […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0df014f0-56bd-4d77-a54b-353d34e62d06",
                        "source_entry_id": "ec282ba0-d1ce-3d0d-901d-ea10cdf8cc9b",
