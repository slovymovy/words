            {
                "entry_id": "597ae0db-2f4c-315b-9f08-8c0732f221c3",
                "word": "Gila",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f627cd34-3378-353a-9227-991109d9cfb1",
                        "entry_id": "597ae0db-2f4c-315b-9f08-8c0732f221c3",
                        "glosses": [
                            "A 649-mile (1,044 km) tributary of the Colorado River which flows through New Mexico and Arizona in the United States."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007b70fa-2e7d-4479-9d96-bde5acd8d40f",
                                "sense_id": "f627cd34-3378-353a-9227-991109d9cfb1",
                                "text": "Some of its tributaries rise in the mountains to the south, in the territory belonging to the republic of Mexico, but the Gila gathers the greater part of its waters from a great plateau on the northeast."
                            },
                            {
                                "example_id": "bb74f372-ca99-4987-8c97-c7cbb4e82780",
                                "sense_id": "f627cd34-3378-353a-9227-991109d9cfb1",
                                "text": "On that map the Colorado River headed near the headwaters of the Del Norte (Rio Grande) and ran almost straight southwest to the Gulf of California. The Gila joined it at right angles, precisely at its mouth."
                            }
                        ]
                    },
                    {
                        "sense_id": "f803f2e2-dfa8-3a1a-a023-1c36d4931c86",
                        "entry_id": "597ae0db-2f4c-315b-9f08-8c0732f221c3",
                        "glosses": [
                            "A census-designated place in Grant County, New Mexico"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
