                "senses": [
                    {
                        "sense_id": "bc0f3bd8-4aaa-3994-807b-17e28a8d81bb",
                        "entry_id": "77799fb3-a91f-3dad-94d8-7be8e8e8feb6",
                        "glosses": [
                            "gewalttätige Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3b3745-2535-43b9-a7cc-5a0678b3a75f",
                                "sense_id": "bc0f3bd8-4aaa-3994-807b-17e28a8d81bb",
                                "text": "„Gewaltakte entstehen eher spontan, als dass sie von langer Hand geplant werden.“"
                            },
                            {
                                "example_id": "9bf77a06-229f-4756-bb74-7ffbd2804f2e",
                                "sense_id": "bc0f3bd8-4aaa-3994-807b-17e28a8d81bb",
                                "text": "„Der Umsturz hatte auch hier ohne größere Gewaltakte gesiegt.“"
                            },
                            {
                                "example_id": "28283e98-5d84-4ae0-91a2-3497bae21a33",
                                "sense_id": "bc0f3bd8-4aaa-3994-807b-17e28a8d81bb",
                                "text": "„Er hatte weiterhin den schauerlichen Gewaltakt im nächsten Waggon vor Augen.“"
                            },
                            {
                                "example_id": "51987b8f-914b-446a-88ab-fb8f14a332a3",
                                "sense_id": "bc0f3bd8-4aaa-3994-807b-17e28a8d81bb",
                                "text": "„Zwischen 2009 und 2011 gab es demnach 11789 Gewaltakte gegen Frauen, davon knapp drei Viertel im Punjab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
