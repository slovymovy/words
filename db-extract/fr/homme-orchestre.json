                                        "sense_id": "ba137629-4ede-31b2-912e-3fde03c48d6c",
                                        "entry_id": "1a3b38da-adf6-3c02-b59c-9243c0cbfa40",
                                        "glosses": [
                                            "A musician who plays several musical instruments at once."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35008158-9ec9-35c0-a883-97a55c7dcefa",
                                        "entry_id": "1a3b38da-adf6-3c02-b59c-9243c0cbfa40",
                                        "glosses": [
                                            "A musician who plays several musical instruments at once.",
                                            "A band in which the frontman does most of the work and is the spotlight or the center of attention, usually to the detriment of other band members."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c0637a5-2087-3749-a432-0cf71be2b480",
                                        "entry_id": "1a3b38da-adf6-3c02-b59c-9243c0cbfa40",
                                        "glosses": [
                                            "An organisation or business that is effectively run by only one person."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7be78119-4347-4524-96d2-ecf0deb91f9e",
                                                "sense_id": "4c0637a5-2087-3749-a432-0cf71be2b480",
                                                "text": "Near-synonym: one-man army"
                                            },
                                            {
                                                "example_id": "3bdd745f-60f4-492a-a04f-dba808c014dc",
                                                "sense_id": "4c0637a5-2087-3749-a432-0cf71be2b480",
                                                "text": "The corporation he will someday inherit—growing, churning—won't work as a one-man band."
                                            },
                                            {
                                                "example_id": "ef7ec76e-61f8-48a4-9ac8-eb41ceb98d5e",
                                                "sense_id": "4c0637a5-2087-3749-a432-0cf71be2b480",
                                                "text": "It goes on to argue that the Reform UK party is a “one-man band which at best can win only a handful of MPs”, while the Liberal Democrats are dismissed as “a joke”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
