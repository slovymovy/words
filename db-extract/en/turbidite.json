                    {
                        "sense_id": "04c4ac6c-1a74-3eee-b302-8eda9a3d85b8",
                        "entry_id": "bdee8a98-5279-36a5-8762-1e42cc62c111",
                        "glosses": [
                            "Any sedimentary deposit formed by a turbidity current."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7bf6f166-adea-4247-9fc9-658cf6e1ca1d",
                                "sense_id": "04c4ac6c-1a74-3eee-b302-8eda9a3d85b8",
                                "text": "As with siliciclastic turbidites, the maximum thickness of an individual bed is commonly not attained in the neighborhood of the source area, but at some distance downcurrent (Fig. 5.16b); then it decreases distally."
                            },
                            {
                                "example_id": "5b08f095-83e3-4a2f-bab1-05655a5a182f",
                                "sense_id": "04c4ac6c-1a74-3eee-b302-8eda9a3d85b8",
                                "text": "They are regarded as distal turbidites and are interbedded with bioclastic limestones and massive breccioid limestones containing blocks of coral colonies and intraclasts that are regarded as proximal turbidites."
                            }
                        ]
                    }
                ],
