                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d1f063c-71e7-35e6-bb05-01f29c7a0745",
                        "entry_id": "5aa13e16-588f-32e9-aa97-9367d8010d1b",
                        "glosses": [
                            "The study of the origin, and sometimes the development, of the universe or the solar system, in astrophysics, religion, and other fields."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5559362f-3b2d-4539-9f49-005ccc739066",
                                "sense_id": "1d1f063c-71e7-35e6-bb05-01f29c7a0745",
                                "text": "Mr. Lampredi divides his ſubject into ſeveral heads, viz. Natural Theology, Coſmogony, Ceraunoscopy, i.e. the judgments to be formed from thunder and lightning, Phyſic, Botany, Mechanics, and Politics."
                            }
                        ]
                    },
                    {
                        "sense_id": "12d218b0-07ed-3b71-9dbb-8d7f3647cc9a",
                        "entry_id": "5aa13e16-588f-32e9-aa97-9367d8010d1b",
                        "glosses": [
                            "Any specific theory, model, myth, or other account of the origin of the universe."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "09f28964-9ee9-38e6-be14-9437a66fd0b2",
                        "entry_id": "5aa13e16-588f-32e9-aa97-9367d8010d1b",
                        "glosses": [
                            "The creation of the universe."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b345769-48df-4e33-a37a-0e9ec6f9c69a",
                        "source_entry_id": "5aa13e16-588f-32e9-aa97-9367d8010d1b",
