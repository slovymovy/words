                        "entry_id": "21185d6d-19e1-3305-8ca5-d69ffa2329ab",
                        "glosses": [
                            "krachtige, maar gemakkelijk te leren programmeertaal, veel gebruikt voor webontwikkeling, data-analyse, kunstmatige intelligentie en automatisering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "265f68ce-f76b-4c16-8781-d29cda601873",
                                "sense_id": "aeb9165a-c2d1-3965-9eb0-e9f87f4ee8fb",
                                "text": "Veel moderne applicaties en scripts worden geschreven in Python."
                            },
                            {
                                "example_id": "0d2c325a-8e60-493f-a907-7b354a87f319",
                                "sense_id": "aeb9165a-c2d1-3965-9eb0-e9f87f4ee8fb",
                                "text": "In Python hoef je niet expliciet te zeggen welk type gegevens je opslaat – Python herkent dat automatisch!"
                            },
                            {
                                "example_id": "f96361cb-f643-4242-a423-c37ec4676af4",
                                "sense_id": "aeb9165a-c2d1-3965-9eb0-e9f87f4ee8fb",
                                "text": "Python is het geesteskind van de Nederlandse computerpionier Guido van Rossum."
                            }
                        ]
                    }
                ],
