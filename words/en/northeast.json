                        {
                            "text": "Travelers visited the <w>Northeast</w> to explore its biodiversity.",
                            "target_lang_translations": {
                                "ru": "Путешественники посетили <w>Северо-Восток</w>, чтобы изучить его биоразнообразие.",
                                "zh": "游客们前往<w>印度东北部</w>探索那里的生物多样性。"
                            }
