                    {
                        "sense_id": "7fe025f9-b99d-37d4-90e7-559d5b068148",
                        "entry_id": "c62bc5f5-1924-3d04-b8fd-537ec8482f6e",
                        "glosses": [
                            "(Lille, nord de la France) Activité de transformation du fil de lin par retordage, notamment en fil à coudre, à tisser ou fil de dentelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8dabca-d227-4c19-bea0-50a723ff3a15",
                                "sense_id": "7fe025f9-b99d-37d4-90e7-559d5b068148",
                                "text": "La filterie est un corps si considérable qu’il fournit à presque tout l’univers les fils à coudre, à ressarcir, à tricoter et à faire dentelles. Ces fils sont d’autant plus propres au pays que le lin est une production de son sol."
                            }
                        ]
                    },
                    {
                        "sense_id": "709e3e3c-ab1a-3b4f-9cc3-cdb49c518042",
                        "entry_id": "c62bc5f5-1924-3d04-b8fd-537ec8482f6e",
                        "glosses": [
                            "Fabrique opérant dans la filterie."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "6a1301af-9814-4727-bd91-2a8a62ae7a9a",
                                "sense_id": "709e3e3c-ab1a-3b4f-9cc3-cdb49c518042",
                                "text": "La première opération qui se fait dans les filteries, consiste à dévider les écheveaux sur des bobines, en réunissant deux, trois ou quatre brins simples. Ensuite on les retors au moyen d’une mécanique, qui les reporte des bobines sur les dévidoirs, pour en former de nouveaux écheveaux."
                            }
                        ]
                    }
