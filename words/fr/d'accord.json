        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b332db1a-1229-3dc0-9993-eebb0bacf62e",
                    "sense_definition": "Qui partage la même opinion, le même avis ou la même volonté qu'une autre personne.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "accord_opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue et moi sommes tout à fait <w>d'accord</w> sur cette proposition.",
                            "target_lang_translations": {
                                "en": "My colleague and I are completely <w>in agreement</w> on this proposal.",
                                "ru": "Мы с коллегой полностью <w>согласны</w> с этим предложением.",
                                "nl": "Mijn collega en ik zijn het volledig <w>eens</w> over dit voorstel.",
                                "de": "Mein Kollege und ich sind uns bei diesem Vorschlag völlig <w>einig</w>.",
                                "pl": "Mój kolega i ja jesteśmy całkowicie <w>zgodni</w> co do tej propozycji.",
                                "it": "Il mio collega e io siamo pienamente <w>d'accordo</w> su questa proposta.",
                                "cs": "Můj kolega a já jsme s tímto návrhem plně <w>zajedno</w>.",
                                "tr": "Meslektaşım ve ben bu öneri konusunda tamamen <w>hemfikiriz</w>.",
                                "es": "Mi colega y yo estamos completamente <w>de acuerdo</w> en esta propuesta.",
                                "zh": "我和同事对这项提议的看法完全<w>一致</w>。"
                            }
                        },
                        {
                            "text": "Après une longue discussion, ils ont enfin réussi à tomber <w>d'accord</w>.",
                            "target_lang_translations": {
                                "en": "After a long discussion, they finally managed to <w>agree</w>.",
                                "ru": "После долгого обсуждения им наконец удалось <w>договориться</w>.",
                                "nl": "Na een lange discussie zijn ze het eindelijk <w>eens</w> geworden.",
                                "de": "Nach einer langen Diskussion sind sie sich endlich <w>einig</w> geworden.",
                                "pl": "Po długiej dyskusji w końcu <w>zgodzili się</w>.",
                                "it": "Dopo una lunga discussione, alla fine sono riusciti a <w>mettersi d'accordo</w>.",
                                "cs": "Po dlouhé diskusi se jim konečně podařilo být <w>zajedno</w>.",
                                "tr": "Uzun bir tartışmanın ardından sonunda <w>hemfikir</w> olabildiler.",
                                "es": "Tras una larga discusión, por fin lograron <w>ponerse de acuerdo</w>.",
                                "zh": "经过长时间的讨论，他们终于意见<w>一致</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "être d'accord",
                        "tomber d'accord"
                    ],
                    "target_lang_definitions": {
                        "en": "Sharing the same opinion, view or will as another person.",
                        "ru": "Разделяет то же мнение, взгляд или волю, что и другой человек.",
                        "nl": "Die dezelfde mening, opvatting of wil deelt als een andere persoon.",
                        "de": "Mit einer anderen Person dieselbe Meinung, Ansicht oder Absicht teilend.",
                        "pl": "Mający tę samą opinię, zdanie lub wolę co inna osoba.",
                        "it": "Che condivide la stessa opinione, lo stesso parere o la stessa volontà di un'altra persona.",
                        "cs": "Který sdílí stejný názor, stanovisko nebo vůli jako jiný člověk.",
                        "tr": "Başka biriyle aynı görüşü, fikri ya da isteği paylaşan.",
                        "es": "Que tiene la misma opinión, parecer o voluntad que otra persona.",
                        "zh": "指与他人持相同的意见、看法或意愿。"
                    },
