                {
                    "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                    "sense_definition": "Happening quickly and with little or no warning; in a sudden manner.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suddenness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Suddenly</w>, the heavens opened and we all got drenched.",
                            "target_lang_translations": {
                                "ru": "<w>Вдруг</w> хлынул ливень, и мы все промокли до нитки.",
                                "nl": "<w>Plotseling</w> gingen de hemelsluizen open en werden we allemaal kletsnat.",
                                "pl": "<w>Nagle</w> otworzyły się niebiosa i wszyscy przemokliśmy do suchej nitki.",
                                "de": "<w>Plötzlich</w> öffnete der Himmel seine Schleusen und wir wurden alle klatschnass.",
                                "fr": "<w>Soudain</w>, le ciel s'est ouvert et nous avons tous été trempés.",
                                "it": "<w>All'improvviso</w> il cielo si è aperto e ci siamo bagnati tutti fino alle ossa.",
                                "cs": "<w>Najednou</w> se otevřelo nebe a všichni jsme promokli na kůži.",
                                "tr": "<w>Aniden</w> gökyüzü yarıldı ve hepimiz sırılsıklam olduk.",
                                "es": "<w>De repente</w>, el cielo se abrió y todos nos empapamos.",
                                "zh": "<w>突然</w>间大雨倾盆，我们都被淋透了。"
                            }
                        },
                        {
                            "text": "They have <w>suddenly</w> decided to sell the house without telling anyone.",
                            "target_lang_translations": {
                                "ru": "Они <w>внезапно</w> решили продать дом, никому не сказав.",
                                "nl": "Ze hebben <w>ineens</w> besloten om het huis te verkopen zonder het aan iemand te vertellen.",
                                "pl": "Oni <w>nagle</w> zdecydowali się sprzedać dom, nikomu nic nie mówiąc.",
                                "de": "Sie haben <w>plötzlich</w> beschlossen, das Haus zu verkaufen, ohne es jemandem zu sagen.",
                                "fr": "Ils ont <w>soudainement</w> décidé de vendre la maison sans le dire à personne.",
                                "it": "Hanno deciso <w>improvvisamente</w> di vendere la casa senza dirlo a nessuno.",
                                "cs": "Rozhodli se <w>náhle</w> prodat dům, aniž by to někomu řekli.",
                                "tr": "Kimseye haber vermeden <w>birdenbire</w> evi satmaya karar verdiler.",
                                "es": "Han decidido <w>repentinamente</w> vender la casa sin decírselo a nadie.",
                                "zh": "他们<w>突然</w>决定卖掉房子，没告诉任何人。"
                            }
                        },
                        {
                            "text": "The weather changed <w>suddenly</w> when the storm arrived.",
                            "target_lang_translations": {
                                "ru": "Погода <w>неожиданно</w> изменилась, когда начался шторм.",
                                "nl": "Het weer sloeg <w>plotseling</w> om toen de storm losbarstte.",
                                "pl": "Pogoda zmieniła się <w>nagle</w>, kiedy nadeszła burza.",
                                "de": "Das Wetter änderte sich <w>schlagartig</w>, als der Sturm aufzog.",
                                "fr": "Le temps a changé <w>brusquement</w> quand la tempête est arrivée.",
                                "it": "Il tempo è cambiato <w>all'improvviso</w> quando è arrivata la tempesta.",
                                "cs": "Když přišla bouřka, počasí se <w>neočekávaně</w> změnilo.",
                                "tr": "Fırtına çıktığında hava <w>aniden</w> değişti.",
                                "es": "El clima cambió <w>de pronto</w> cuando llegó la tormenta.",
                                "zh": "暴风雨来临时，天气<w>突然</w>变了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "all of a sudden"
                    ],
                    "antonyms": [
                        "unsuddenly"
                    ],
                    "common_phrases": [
                        "happened suddenly",
                        "changed suddenly",
                        "stopped suddenly",
                        "appeared suddenly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий быстро и без предупреждения; внезапным образом.",
                        "nl": "Snel en zonder waarschuwing gebeurend; op een onverwachte manier.",
                        "pl": "Dziejący się szybko i bez ostrzeżenia; w niespodziewany sposób.",
                        "de": "Schnell und ohne Vorwarnung geschehend; auf plötzliche Weise.",
                        "fr": "Qui se produit rapidement et sans avertissement ou presque ; d'une manière soudaine.",
                        "it": "Che accade rapidamente e con poco o nessun preavviso; in modo improvviso.",
                        "cs": "Dějící se rychle a s malým nebo žádným varováním; neočekávaným způsobem.",
                        "tr": "Hızlı bir şekilde ve çok az uyarıyla veya hiç uyarı olmadan gerçekleşen; aniden.",
                        "es": "Que ocurre de forma rápida y con poco o ningún aviso; de manera repentina.",
                        "zh": "指发生得很快，几乎没有或完全没有预兆；以突然的方式。"
