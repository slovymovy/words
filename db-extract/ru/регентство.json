                                            },
                                            {
                                                "example_id": "102a9e91-7ea1-4a24-a851-bd9aa7477f9e",
                                                "sense_id": "130f487a-2475-39bb-a531-5b5fe0fb25d9",
                                                "text": "Après la mort de Louis XIII, la régence fut donnée, déférée à la reine Anne d’Autriche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "881f869e-2e0b-3b69-a2b6-5645dfb9bb33",
                                        "entry_id": "5f79c662-2af0-3484-ac3f-cb906eb4eafe",
                                        "glosses": [
                                            "Temps que dure le mandat du régent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac85e289-0783-4872-82de-3dd1c86ba915",
                                                "sense_id": "881f869e-2e0b-3b69-a2b6-5645dfb9bb33",
                                                "text": "Au commencement de la régence."
                                            },
                                            {
                                                "example_id": "086c9ae1-07d1-48ce-aeef-636836443df3",
                                                "sense_id": "881f869e-2e0b-3b69-a2b6-5645dfb9bb33",
                                                "text": "Pendant la régence de Marie de Médicis."
                                            },
                                            {
                                                "example_id": "07230021-f211-4606-a1f0-e3abc49a8352",
                                                "sense_id": "881f869e-2e0b-3b69-a2b6-5645dfb9bb33",
                                                "text": "Les troubles d’une régence."
                                            },
                                            {
                                                "example_id": "708b8602-da60-477e-a93d-2ceab69ec0bb",
                                                "sense_id": "881f869e-2e0b-3b69-a2b6-5645dfb9bb33",
                                                "text": "La régence anglais durait de 1811 à 1820."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26a9602f-7693-313f-b040-30949a827382",
                                        "entry_id": "5f79c662-2af0-3484-ac3f-cb906eb4eafe",
                                        "glosses": [
                                            "Petit état musulmans situés sur la côte d’Afrique et qui était gouverné par délégation du sultan de Constantinople."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb4db58-2ab4-47a2-9fd6-0bc28c251417",
                                                "sense_id": "26a9602f-7693-313f-b040-30949a827382",
                                                "text": "Les régences barbaresques étaient au nombre de trois : Alger, Tunis et Tripoli."
                                            },
                                            {
                                                "example_id": "c2b9630b-ab2c-4d1c-87a4-bf3dcf71da40",
                                                "sense_id": "26a9602f-7693-313f-b040-30949a827382",
                                                "text": "La régence d’Alger."
                                            },
                                            {
                                                "example_id": "8f6bf72e-978d-4482-b6dc-6e9560b66f82",
                                                "sense_id": "26a9602f-7693-313f-b040-30949a827382",
                                                "text": "Les villes de la régence."
                                            },
                                            {
                                                "example_id": "0483ce59-6d7a-401a-a14e-eeb14c02391f",
                                                "sense_id": "26a9602f-7693-313f-b040-30949a827382",
                                                "text": "Dans toute l’étendue de la régence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc57755e-0921-3336-8bc6-c7accd42c73e",
                                        "entry_id": "5f79c662-2af0-3484-ac3f-cb906eb4eafe",
                                        "glosses": [
                                            "Petit pain."
                                        ],
                                        "tags": [
                                            "Normandie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52073ed1-3d42-4004-9060-a94ff0f8fc66",
                                                "sense_id": "dc57755e-0921-3336-8bc6-c7accd42c73e",
                                                "text": "Le soir, dès cinq à six heures, on ne trouve pas une régence, pas le moindre petit pain."
                                            },
                                            {
                                                "example_id": "9435db48-0606-4172-9bfd-ca41cbb0ca36",
                                                "sense_id": "dc57755e-0921-3336-8bc6-c7accd42c73e",
                                                "text": "Régence, petit pain léger au levain de bière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
