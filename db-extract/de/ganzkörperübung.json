                "senses": [
                    {
                        "sense_id": "5b5ffec8-5c74-3679-9dd9-ded22d86ae45",
                        "entry_id": "bbd7e192-8759-306b-9be6-ffa0eaad3200",
                        "glosses": [
                            "körperliche Aktivität (Übung), die den gesamten Körper oder mehrere Muskelgruppen gleichzeitig beansprucht"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "475933cd-388d-4c3b-9cf7-1c8b348d721e",
                                "sense_id": "5b5ffec8-5c74-3679-9dd9-ded22d86ae45",
                                "text": "„Diese Ganzkörperübung ist ideal für diejenigen, die nach einer sportlichen Aktivität mit geringer Belastung suchen.“"
                            },
                            {
                                "example_id": "8b8400ee-41ca-4492-a792-ba93cdc508ec",
                                "sense_id": "5b5ffec8-5c74-3679-9dd9-ded22d86ae45",
                                "text": "„Ganzkörperübungen wie Bankdrücken, Kniebeugen und Kreuzheben sind besonders effektiv für das Krafttraining und den Muskelaufbau.“"
                            },
                            {
                                "example_id": "76cbd1fb-5ad2-4e85-9f49-49752e8af0bb",
                                "sense_id": "5b5ffec8-5c74-3679-9dd9-ded22d86ae45",
                                "text": "„Das Rumänische Kreuzheben ist ein exzellentes Beispiel für eine Ganzkörperübung, die gezielt die Muskulatur der Körperrückseite trainiert.“"
                            },
                            {
                                "example_id": "2b4f17e8-530e-4ec3-af5b-42bf1dd5f3bb",
                                "sense_id": "5b5ffec8-5c74-3679-9dd9-ded22d86ae45",
                                "text": "„Liegestütze sind eine großartige Ganzkörperübung, die auch die Brust-, Arm- und Bauchmuskulatur anspricht und als Ergänzung zum Schultertraining dienen kann.“"
                            },
                            {
                                "example_id": "76d3e149-8fe8-4676-9916-aa5678583bee",
                                "sense_id": "5b5ffec8-5c74-3679-9dd9-ded22d86ae45",
                                "text": "„Die Kniebeuge (Squat) ist eine der besten Ganzkörperübungen überhaupt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
