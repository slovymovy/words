                "senses": [
                    {
                        "sense_id": "35b2c720-2983-34e0-a0f7-25a2bbd7a722",
                        "entry_id": "179f189f-9c8c-3b3e-b887-f35014348389",
                        "glosses": [
                            "jemand, der groß gewachsen und schlaksig ist; ein großer Kerl"
                        ],
                        "tags": [
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "36514c68-8f73-46a6-84a2-e22f9819d037",
                                "sense_id": "35b2c720-2983-34e0-a0f7-25a2bbd7a722",
                                "text": "Der Kerl, man könnte Lulatsch sagen, sieht aus wie ein Riese."
                            },
                            {
                                "example_id": "4bba53c1-1b13-4317-bdb9-04685e377863",
                                "sense_id": "35b2c720-2983-34e0-a0f7-25a2bbd7a722",
                                "text": "„Neben mir saß ein langer Lulatsch, der einen Kopf größer als Frau Weißpfennig war, aber sonst nichts konnte.“"
                            },
                            {
                                "example_id": "03f4a3bb-202d-443b-a9c8-bf335ad22b7a",
                                "sense_id": "35b2c720-2983-34e0-a0f7-25a2bbd7a722",
                                "text": "„Wir müssen einen merkwürdigen Anblick abgegeben haben: ein ordentlich rasierter Mann in weißem Hemd und Captain-Cook-Kravatte mit einer Bibel in der Hand; ein langer Lulatsch in Shorts und T-Shirt mit einer leeren Rumflasche im Arm; und ein dritter, der mit verwirrter Miene dastand und einen Plastikrevolver umklammerte.“"
                            },
                            {
                                "example_id": "5d832995-f408-462b-a7b4-5a64dece0336",
                                "sense_id": "35b2c720-2983-34e0-a0f7-25a2bbd7a722",
                                "text": "„Niemals hätte ich es für möglich gehalten, dass sich eine solche Frau für einen schleswig-holsteinischen Lulatsch interessieren könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e373190-90c2-4bb0-9649-a51d3dbcf8a4",
                        "source_entry_id": "179f189f-9c8c-3b3e-b887-f35014348389",
                        "source_sense_id": "35b2c720-2983-34e0-a0f7-25a2bbd7a722",
                        "source_sense_description": "umgangssprachlich, salopp: jemand, der groß gewachsen und schlaksig ist; ein großer Kerl",
                        "target_lang_word": "escogriffe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escogriffe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a46b26df-3632-343c-80bc-e1c880582cdb",
                                        "entry_id": "1cbd9262-d3ab-37fd-993d-61abe95b90b7",
                                        "glosses": [
                                            "Homme qui prend hardiment sans demander."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a51b9e5-e6d4-460d-9868-423d9a701e20",
                                                "sense_id": "a46b26df-3632-343c-80bc-e1c880582cdb",
                                                "text": "Écoutez bien, je dis pour changer : Ô bon peuple de Paris ! vous êtes un tas de niais, et vos seigneurs, vos nobles de robe et d’épée, ne sont que d’hypocrites fraudeurs et de fieffés escogriffes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4bc32d1-fea1-352b-b49a-9e712387e31a",
                                        "entry_id": "1cbd9262-d3ab-37fd-993d-61abe95b90b7",
                                        "glosses": [
                                            "Homme de grande taille et dégingandé."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbce0399-a29b-4878-85e3-0fc05bf94356",
                                                "sense_id": "e4bc32d1-fea1-352b-b49a-9e712387e31a",
                                                "text": "Et dire que ce grand escogriffe avait l’air d’aimer les chevaux ! C’était les palefreniers qu’il aimait."
                                            },
                                            {
                                                "example_id": "d5a60355-1989-4789-8a2b-580b0aaba158",
                                                "sense_id": "e4bc32d1-fea1-352b-b49a-9e712387e31a",
                                                "text": "Je m'étais laissé choir sur la boîte de pharmacie, j'attendais passivement de subir mon sort, quand un long escogriffe m'apostropha."
                                            },
                                            {
                                                "example_id": "dfa11d9f-6a8e-4d50-990f-cf8e44dcfa7f",
                                                "sense_id": "e4bc32d1-fea1-352b-b49a-9e712387e31a",
                                                "text": "Mais un grand escogriffe en smoking et coiffé d'une casquette à carreaux sortait de la limousine et accourait vers les trois femmes qui l'accueillirent fraîchement."
                                            },
                                            {
                                                "example_id": "9eb40c2b-3ac2-4ff7-9a42-38ce8ec72e17",
                                                "sense_id": "e4bc32d1-fea1-352b-b49a-9e712387e31a",
                                                "text": "Les dimensions des animaux antédiluviens et les grands escogriffes des temps préhistoriques ont toujours inspiré les humoristes et les beaux-pères que les familles de jeunes mariés traînent le dimanche dans leur sillage."
                                            },
                                            {
                                                "example_id": "ea89d960-42d7-4d31-84d2-172f83192efa",
                                                "sense_id": "e4bc32d1-fea1-352b-b49a-9e712387e31a",
                                                "text": "« L’escogriffe parle beaucoup ; il a des yeux noirs qui font illusion et doivent terrifier sa compagnie mais je ne voudrais pas de lui même pour garder les cuisines. »"
                                            },
                                            {
                                                "example_id": "c366f0f8-73c3-4064-8e4c-be393ac6b1db",
                                                "sense_id": "e4bc32d1-fea1-352b-b49a-9e712387e31a",
                                                "text": "\"Que veux-tu, s'écria Tavèn, long escogriffe, par ces balancements de tête pareils à ceux d'un peuplier ?...\" - (Frederic Mistral, Mirèio, 1859)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
