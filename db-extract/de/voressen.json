                ],
                "senses": [
                    {
                        "sense_id": "c7f58a09-967a-3064-9381-3066ea657665",
                        "entry_id": "137cbe1c-324a-3579-91e0-dbbd4951af69",
                        "glosses": [
                            "Ragout"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "6a9246b7-db2d-480b-8793-fafd9e068335",
                                "sense_id": "c7f58a09-967a-3064-9381-3066ea657665",
                                "text": "Das Voressen enthält immer Fleisch und Gemüse."
                            },
                            {
                                "example_id": "33082ba4-954a-4a04-b476-4d0cc900d1d9",
                                "sense_id": "c7f58a09-967a-3064-9381-3066ea657665",
                                "text": "„Wer als Schweizer in Deutschland lebt und kocht, eignet sich klugerweise die hier üblichen Bezeichnungen rasch an, ..., kauft Rouladen und Ragout, um sie daheim in Fleischvögel und Voressen zu verwandeln.“"
                            },
                            {
                                "example_id": "725f82d6-2fbe-44b6-98f4-3f58701961be",
                                "sense_id": "c7f58a09-967a-3064-9381-3066ea657665",
                                "text": "„Montag mittags: Leberknödl, Kraut, Fleisch und Voressen, abends: Eine geriebene oder andere Teigsuppe, Braten und Salat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02db3d7f-6a36-3b8e-84c9-accd715abe81",
                        "entry_id": "137cbe1c-324a-3579-91e0-dbbd4951af69",
                        "glosses": [
                            "Vorspeise"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "b95c5739-8ce7-44c8-ac56-852ee2ed5b92",
                                "sense_id": "02db3d7f-6a36-3b8e-84c9-accd715abe81",
                                "text": "„Ein römisches Diner bestand aus drei Theilen, aus einem Eingang oder Voressen, welches hauptsächlich kalte und Appetit reizende Speisen bot …“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
