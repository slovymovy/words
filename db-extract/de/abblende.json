                    {
                        "sense_id": "d2556499-b7c9-3fdb-90be-ed8592c5a858",
                        "entry_id": "15dd93e2-b5e9-314c-99ed-d9532195d784",
                        "glosses": [
                            "Übergang zu einem dunklem oder hellen Bild am Schluss einer Filmszene oder das Dunkelwerden der Theaterbühne am Schluss einer Theaterszene"
                        ],
                        "tags": [
                            "Film",
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "4f1d2f06-f33f-413f-998f-e47825286c4b",
                                "sense_id": "d2556499-b7c9-3fdb-90be-ed8592c5a858",
                                "text": "„Schon das Ende der vorangegangenen Folge hatte es in sich: Daryl wurde von hinten niedergeschossen, sein Blut spritzte als martialische Abblende über die Kameralinse.“"
                            },
                            {
                                "example_id": "a661e04c-3a09-4e2c-8325-3c66c8156e9b",
                                "sense_id": "d2556499-b7c9-3fdb-90be-ed8592c5a858",
                                "text": "„Als Frankie einmal mit Maggie, mittlerweile ist er längst ihr Trainer geworden, ihre kaputte Familie besucht, endet die Sequenz mit einer Abblende ins Schwarz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8daa41e-e8f4-3a62-9e7e-c9bbd8188a12",
                        "entry_id": "15dd93e2-b5e9-314c-99ed-d9532195d784",
                        "glosses": [
                            "(sanftes) Ende von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ca9adaf7-6682-4ec2-8983-70305140fe51",
                                "sense_id": "c8daa41e-e8f4-3a62-9e7e-c9bbd8188a12",
                                "text": "„Die hochsommerliche Abenddämmerung versank in einer lang hingezogenen Abblende des Lichts.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
