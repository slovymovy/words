                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e296e371-20a6-41dc-b788-5e935c43fd3d",
                        "source_entry_id": "b8ef79ce-5c74-3076-8a0b-1d4ab0630534",
                        "source_sense_id": "4191445d-e84a-3742-bd97-26464d744468",
                        "target_lang_word": "manga",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manga",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea381f8-6d5d-3cfa-a218-ddc9c9f74d8e",
                                        "entry_id": "4a62d4df-3809-387d-a721-219f431297ce",
                                        "glosses": [
                                            "A comic originating in Japan."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdc606d4-2ffa-4852-aa17-17c96d396457",
                                                "sense_id": "7ea381f8-6d5d-3cfa-a218-ddc9c9f74d8e",
                                                "text": "English speakers are quick to notice the at times incorrect use of English in anime and manga. Many English words are customarily used in standard Japanese speech, and sometimes they are pronounced and employed in a manner quite different from their native use."
                                            },
                                            {
                                                "example_id": "c76a64d1-35b0-4501-9d95-7445144daebe",
                                                "sense_id": "7ea381f8-6d5d-3cfa-a218-ddc9c9f74d8e",
                                                "text": "Manga (Japanese comics) are everywhere. Even here in Auckland. One can find various titles in their original versions as well as in Chinese, Korean and English translations."
                                            },
                                            {
                                                "example_id": "dbf186f5-ded5-46fc-a00d-0e6401503c30",
                                                "sense_id": "7ea381f8-6d5d-3cfa-a218-ddc9c9f74d8e",
                                                "text": "Manga-influenced comics by Western authors are frequently sold alongside manga, although in most bookstores the decision is primarily a matter of format and packaging (i.e., whether the book is printed in the compact manga size or the traditionally larger American comic book format)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcab3096-1694-3889-bdee-c79ccd9f8776",
                                        "entry_id": "4a62d4df-3809-387d-a721-219f431297ce",
                                        "glosses": [
                                            "An artistic style heavily used in, and associated with, Japanese comics, and that has also been adopted by a comparatively low number of comics from other countries."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97577c8e-7f4b-4897-b963-7e610fa6305c",
                                                "sense_id": "dcab3096-1694-3889-bdee-c79ccd9f8776",
                                                "text": "Touching on themes as disparate as sex, death, science fiction and romance, manga and anime catered to all ages and tastes. Commercial hits like “Pokémon” and “Dragon Ball Z,” meanwhile, projected a new image of Japan to the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e074e72-554d-31d2-a116-0411449f3170",
                                        "entry_id": "4a62d4df-3809-387d-a721-219f431297ce",
                                        "glosses": [
                                            "Any comic in such a style, regardless of the country of origin."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5cb7584-5197-47c4-b0be-9f85b8b87b55",
                                                "sense_id": "8e074e72-554d-31d2-a116-0411449f3170",
                                                "text": "Lately I've been reading a Brazilian manga."
                                            }
                                        ]
                                    }
                                ]
                            },
