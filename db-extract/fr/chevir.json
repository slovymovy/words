                "senses": [
                    {
                        "sense_id": "cdc78de1-7e70-3c4c-a95e-4e0a17552b64",
                        "entry_id": "97636e3b-f886-308c-ac0b-e3b8b0b78616",
                        "glosses": [
                            "Disposer de, venir à bout, dominer, devenir maître de, surmonter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8bc7d05-8a15-4bd4-a2be-5e6c3cc2043f",
                                "sense_id": "cdc78de1-7e70-3c4c-a95e-4e0a17552b64",
                                "text": "Cet enfant est si malin qu'on ne peut chevir de lui."
                            },
                            {
                                "example_id": "a591627b-2d4b-4ba1-ba65-9f5fd1698931",
                                "sense_id": "cdc78de1-7e70-3c4c-a95e-4e0a17552b64",
                                "text": "Qui veut chevir de ses facultés, il faut user d'industrie [de travail, d'efforts]."
                            },
                            {
                                "example_id": "4d475667-150c-426b-ac57-ed8d8e2920c0",
                                "sense_id": "cdc78de1-7e70-3c4c-a95e-4e0a17552b64",
                                "text": "M.Dimanche : Plus que jamais, Monsieur, et nous ne saurions en chevir [d'un chien]."
                            }
                        ]
                    }
