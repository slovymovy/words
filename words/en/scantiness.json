{
    "word_family": [
        "scant",
        "scantly",
        "scanty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c80f3c92-176a-3ec7-a8cc-cd78d7a5a622",
                    "sense_definition": "The quality or state of being inadequate, insufficient, or small in amount.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shortage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scantiness</w> of reliable information made it difficult to make an informed decision.",
                            "target_lang_translations": {
                                "ru": "<w>Скудость</w> достоверной информации затрудняла принятие взвешенного решения."
                            }
                        },
                        {
                            "text": "Critics complained about the <w>scantiness</w> of evidence supporting the researcher's bold claims.",
                            "target_lang_translations": {
                                "ru": "Критики жаловались на <w>недостаточность</w> доказательств, подтверждающих смелые заявления исследователя."
                            }
                        }
                    ],
                    "synonyms": [
                        "meagerness",
                        "scarcity",
                        "lack",
                        "fewness"
                    ],
                    "antonyms": [
                        "abundance",
                        "plenty"
                    ],
                    "common_phrases": [
                        "scantiness of evidence",
                        "scantiness of resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство или состояние недостаточности, скудости или ограниченности в количестве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скудость",
                                "target_lang_sense_clarification": "недостаточность или крайняя ограниченность объема или содержания"
                            },
                            {
                                "target_lang_word": "недостаточность",
                                "target_lang_sense_clarification": "нехватка нужного количества"
                            },
                            {
                                "target_lang_word": "ограниченность",
                                "target_lang_sense_clarification": "малое количество или объем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1517c16-f1d8-3741-87dc-073ec1ebfcf2",
                    "sense_definition": "An instance, condition, or result of being sparse or deficient in quantity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shortage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The severe drought caused an unavoidable <w>scantiness</w> of fresh produce in the region.",
                            "target_lang_translations": {
                                "ru": "Сильная засуха вызвала неизбежный <w>дефицит</w> свежих продуктов в регионе."
                            }
                        },
                        {
                            "text": "Local communities suffered from the <w>scantiness</w> of medical supplies following the storm.",
                            "target_lang_translations": {
                                "ru": "Местные сообщества пострадали от <w>нехватки</w> медикаментов после шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "dearth",
                        "lack",
                        "scarcity"
                    ],
                    "common_phrases": [
                        "scantiness of supplies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай, состояние или результат дефицита или нехватки ресурсов и припасов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефицит",
                                "target_lang_sense_clarification": "острая нехватка или недостаток материальных ресурсов"
                            },
                            {
                                "target_lang_word": "нехватка",
                                "target_lang_sense_clarification": "отсутствие необходимого количества припасов или продуктов"
                            },
                            {
                                "target_lang_word": "скудость",
                                "target_lang_sense_clarification": "крайне малое количество запасов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}