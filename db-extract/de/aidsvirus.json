                "senses": [
                    {
                        "sense_id": "6af02c13-8901-3c9a-97dd-9efc80cd8b60",
                        "entry_id": "ae6e225e-dec1-32ce-ba67-1c42a2807122",
                        "glosses": [
                            "Virus, das die Immunschwächekrankheit Aids verursachen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c8a5471-a387-40d2-a74e-2c341b72b6b3",
                                "sense_id": "6af02c13-8901-3c9a-97dd-9efc80cd8b60",
                                "text": "„Der ‚Therapie-Optimismus‘ verleite viele Menschen dazu, das Aidsvirus nicht mehr als gefährlich einzuschätzen und stattdessen auf die modernen Behandlungsmöglichkeiten zu setzen.“"
                            },
                            {
                                "example_id": "0243be70-4714-4b0b-91bd-f674d0c98e9f",
                                "sense_id": "6af02c13-8901-3c9a-97dd-9efc80cd8b60",
                                "text": "„Das größere Risiko dürfte aber von Viren ausgehen, die erst bekannt werden, wenn sie den Sprung vom Affen auf den Menschen geschafft haben und tödliche Krankheiten auslösen, wie dies dem Marburg- und Ebolavirus gelungen ist und wahrscheinlich auch dem Aidsvirus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35becd48-7ac9-4091-8243-d9fcb8fe957c",
                        "source_entry_id": "ae6e225e-dec1-32ce-ba67-1c42a2807122",
                        "source_sense_id": "6af02c13-8901-3c9a-97dd-9efc80cd8b60",
