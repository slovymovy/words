        "ru-extract.jsonl": [
            {
                "entry_id": "5239bab2-e591-3a41-8337-d5ddb59e7743",
                "word": "Лобков",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dfa4fc16-8b2a-3d86-9e39-2bd596ed4978",
                        "entry_id": "5239bab2-e591-3a41-8337-d5ddb59e7743",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edefcdd7-13c2-49ee-ab08-a191cfe9a060",
                                "sense_id": "dfa4fc16-8b2a-3d86-9e39-2bd596ed4978",
                                "text": "Фамилия Лобкова происходит от древнерусского имени Лобко. С пристрастием осматривая новорождённых младенцев, наши предки давали им имена по каким-то особенностям их строения. Имя Лобко мог получить ребёнок с очень большим или выпуклым лбом, имя Глазко — с особенно выразительными глазами, Нос или Носик — с большим или очень маленьким носом и т. д. ¶ Имя Лобко засвидетельствовано в ряде старинных документов: Андрей Лобко, крестьянин (1591 г.), Миско Лобко, крестьянин (1631 г.)."
                            },
                            {
                                "example_id": "b2f9fbc7-f112-40e3-bc81-aa8930ec4afd",
                                "sense_id": "dfa4fc16-8b2a-3d86-9e39-2bd596ed4978",
                                "text": "В действительности журналист Лобков выбрал единственно возможную форму участия нормального человека в этом адском действе."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
