                "forms": [
                    {
                        "form_id": "829ee9fc-6222-4cec-9e64-9a1a5bdf9760",
                        "entry_id": "3ac46970-eb1f-380c-97b9-584ef9b3cb69",
                        "tags": [
                            "plural"
                        ],
                        "form": "désunions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "203b954d-e2ff-39df-96bc-1595ab5c2b3f",
                        "entry_id": "3ac46970-eb1f-380c-97b9-584ef9b3cb69",
                        "glosses": [
                            "Action de désunir, en parlant d’une famille, d’un parti, etc. ; ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff72ede0-3287-4236-909c-42293acbb087",
                                "sense_id": "203b954d-e2ff-39df-96bc-1595ab5c2b3f",
                                "text": "La diversité d’intérêts cause la désunion."
                            },
                            {
                                "example_id": "fca24bfb-3d88-4d4e-88a0-f26ff64a5a1d",
                                "sense_id": "203b954d-e2ff-39df-96bc-1595ab5c2b3f",
                                "text": "C’est lui qui a mis la désunion dans cette famille."
                            },
                            {
                                "example_id": "569a63d3-1a79-4866-9e27-8381edd88847",
                                "sense_id": "203b954d-e2ff-39df-96bc-1595ab5c2b3f",
                                "text": "Cela ne peut manquer d’amener entre eux une complète désunion."
                            },
                            {
                                "example_id": "66a6eec3-9e86-4dae-b25f-b97e13aa3e3c",
                                "sense_id": "203b954d-e2ff-39df-96bc-1595ab5c2b3f",
                                "text": "Le prétexte commode et menteur de la paix et de l’union entre les catholiques a toujours été, en pareil cas, exploité par les véritables artisans de la désunion et de la guerre, c’est-à-dire de l’erreur et du mensonge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6eca21e1-3912-4f35-a834-5bc20df48e38",
                        "source_entry_id": "3ac46970-eb1f-380c-97b9-584ef9b3cb69",
                        "source_sense_id": "203b954d-e2ff-39df-96bc-1595ab5c2b3f",
                        "target_lang_word": "Uneinigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uneinigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                        "entry_id": "049d43de-819c-3c32-bc43-f196cfefe573",
                                        "glosses": [
                                            "keine Übereinstimmung in einer bestimmten Frage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1337a04a-8aa4-49f7-9602-5d8854a8520a",
                                                "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                                "text": "Zwischen den Sunniten und den Schiiten herrschten Uneinigkeiten."
                                            },
                                            {
                                                "example_id": "e8e2a783-7e1f-46b2-92a3-3c5b55acd055",
                                                "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                                "text": "„Der Speiseplan der Neandertaler sorgt schon seit längerem für Uneinigkeit und kontroverse Diskussionen unter Anthropologen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52ee6172-fa59-420d-8d12-14c43fa24d79",
                        "source_entry_id": "3ac46970-eb1f-380c-97b9-584ef9b3cb69",
