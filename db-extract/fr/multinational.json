                ],
                "senses": [
                    {
                        "sense_id": "10a9bdc2-93ab-3a66-a55b-43d303dc781a",
                        "entry_id": "3fb99e3b-d330-3fa0-9508-862e3fc5ecff",
                        "glosses": [
                            "Relatif à plus de deux nations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "275780bc-b41c-4505-91a8-069b95a870af",
                                "sense_id": "10a9bdc2-93ab-3a66-a55b-43d303dc781a",
                                "text": "La victoire de l’Entente envers les Pouvoirs Centraux représenta la dernière phase dans la désintégration des empires multinationaux européens et euro-asiatiques (Autriche-Hongrie, Empire Ottoman, Empire Tsariste) et aboutit à des traités de paix qui changèrent dramatiquement les frontières de l’Europe centrale et Orientale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac4d44f8-7166-4d45-91c8-e12bfab80e3f",
                        "source_entry_id": "3fb99e3b-d330-3fa0-9508-862e3fc5ecff",
                        "source_sense_id": "10a9bdc2-93ab-3a66-a55b-43d303dc781a",
                        "target_lang_word": "multinational",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multinational",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d564e7b-872f-37c0-a680-1252611ba39a",
                                        "entry_id": "473907f8-2784-3fff-ae6b-066343180432",
                                        "glosses": [
                                            "mehrere Nationen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17ca69ec-a03d-4175-8771-cdca423e8cae",
                                                "sense_id": "7d564e7b-872f-37c0-a680-1252611ba39a",
                                                "text": "Die Firma ist ein multinationaler Konzern."
                                            },
                                            {
                                                "example_id": "0acff559-fde7-45a3-97c7-004f1a413722",
                                                "sense_id": "7d564e7b-872f-37c0-a680-1252611ba39a",
                                                "text": "„Überhaupt waren viele imperialistische Aktivitäten vor 1914 finanzwirtschaftlich betrachtet multinationale Unternehmungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dff3818-d2f2-4be3-af28-dc1220d669d1",
                        "source_entry_id": "3fb99e3b-d330-3fa0-9508-862e3fc5ecff",
                        "source_sense_id": "10a9bdc2-93ab-3a66-a55b-43d303dc781a",
                        "target_lang_word": "multinational",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multinational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77feea03-fb94-33c4-a7d3-59facbf6f20f",
                                        "entry_id": "34809c2d-e9ae-3e59-b23c-e27361faf04f",
                                        "glosses": [
                                            "Of, or involving more than two nations (externally between countries or internally in a country)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8766383-9a2f-4485-98d0-3272094ceb76",
                                                "sense_id": "77feea03-fb94-33c4-a7d3-59facbf6f20f",
                                                "text": "AS a young student at the multinational Aramco school in Dhahran, Saudi Arabia, Fadi Jaber, a son of Palestinian refugees, always preferred his American classmates’ cupcakes, brownies and chocolate chip cookies to his mother’s pastries: knafah, qatayef and baklawah."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1319d236-30fa-378c-b70f-4973d9d6171c",
                                        "entry_id": "34809c2d-e9ae-3e59-b23c-e27361faf04f",
                                        "glosses": [
                                            "Operating, or having subsidiary companies in multiple countries (especially more than two)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c2c312-6a42-4305-99d3-44690400d801",
                                                "sense_id": "1319d236-30fa-378c-b70f-4973d9d6171c",
                                                "text": "By operating within many nations, but ouside them at the same time, multinational firms create possibilities of change even in the world political structure"
                                            },
                                            {
                                                "example_id": "19f82e6f-a730-4460-a0c0-a5497e776fcb",
                                                "sense_id": "1319d236-30fa-378c-b70f-4973d9d6171c",
                                                "text": "Some managers seemed sympathetic to the study, although they encouraged me to recast it as a technical issue, such as the \"problem of executive succession in multinationals.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "multinational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "224a40b6-8bec-3f64-b399-4b7c14f4da20",
                                        "entry_id": "eb9227d3-b17f-37f2-9c81-54ca112f4e92",
                                        "glosses": [
                                            "A multinational company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c968a4d-d4e4-495b-a8d3-84e35223e43a",
                                                "sense_id": "224a40b6-8bec-3f64-b399-4b7c14f4da20",
                                                "text": "The G8 leaders also called on multinationals to make a full disclosure to the taxman over how much tax they pay in different countries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
