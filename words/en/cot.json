                            "trait_type": "obsolete",
                            "comment": "historical derogatory term"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mężczyzna wykonujący prace domowe tradycyjnie kojarzone z kobietami.",
                        "zh": "旧时带贬义的说法，指从事传统上被视为女性家务的男人。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "baba",
                                "target_lang_sense_clarification": "pogardliwie o mężczyźnie zajmującym się domem"
