        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ee8f1363-335a-305f-a4a5-fc44f81747ee",
                "word": "MNH",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fdc38866-b797-3ba9-8c33-99dd9cb51d75",
                        "entry_id": "ee8f1363-335a-305f-a4a5-fc44f81747ee",
                        "glosses": [
                            "Initialism of mint, never hinged."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "42ae8e61-0dca-4fd8-bc13-449c4f8492e1",
                                "sense_id": "fdc38866-b797-3ba9-8c33-99dd9cb51d75",
                                "text": "Loose mixed lot, with duplication, of the Portugal & Colonies first decimal definitive designs. Very mixed condition, from VF to junk, all \"mint\" in some form or another, some MNH, some MH, some MHH, some MNG, etc."
                            },
                            {
                                "example_id": "a7271bbb-51c1-4a89-a8f0-81f93eefaae5",
                                "sense_id": "fdc38866-b797-3ba9-8c33-99dd9cb51d75",
                                "text": "All concentrate on pre-1930 items, and contain many better stamps not found in typical collections. The Netherlands starts with the first issues (imperf and perf, with shade varieties) and contains better later items, some MNH."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "17eb4617-ee16-3f01-b8f1-0d5be14b24ec",
                "word": "mnh",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d7fe024-f990-3e9c-a7f4-c570cd6f0540",
                        "entry_id": "17eb4617-ee16-3f01-b8f1-0d5be14b24ec",
                        "glosses": [
                            "Alternative form of mmm.",
                            "Expressing satisfaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c61ff7-43a8-4376-9891-15ed05740911",
                                "sense_id": "7d7fe024-f990-3e9c-a7f4-c570cd6f0540",
                                "text": "[A] man such as he was, old enough to know better, maybe, and yet still plenty young, head entirely emptied out and filled entirely up again with happiness and closeness and generosity and welcome, Kate Helen there with him at the end of the one true known way of his life. He thought, “Oh my! Old Marster come up with something good as that, maybe what they say about Him is right. Not all of it, maybe. A lot of it. Whoo! Who knows? But something so good.” He said aloud, “Mnh!” And then, “Mnh-mnh-mnh!”"
                            },
                            {
                                "example_id": "23a6ca87-b6f4-41c6-bf23-fee32e0941f1",
                                "sense_id": "7d7fe024-f990-3e9c-a7f4-c570cd6f0540",
                                "text": "He had thought his imitation of good appetite was successful. “Don’t worry,” he said, spearing some more. / There wasn’t much to finish. She looked at him tenderly when he glanced down to see, and said nothing more about it. / “Mnh,” he said, leaning back."
                            },
                            {
                                "example_id": "c5eb7d5f-870e-496c-9b88-a21ba2985c52",
                                "sense_id": "7d7fe024-f990-3e9c-a7f4-c570cd6f0540",
                                "text": "Michael peeled his potatoes, his wife rubbed her red seasonings. Druff sniffed at the neutral, still unroasted air. “Mnh,” he said, “mhnn. Something smells good. Company coming?”"
                            },
                            {
                                "example_id": "0dc10eb6-cd2f-44f1-a980-6ce2f24e92f4",
                                "sense_id": "7d7fe024-f990-3e9c-a7f4-c570cd6f0540",
                                "text": "Mnh, that hem is perfect. Those scallops took some time, but they were worth every minute."
                            },
                            {
                                "example_id": "057b74fd-db6d-4b99-87b3-a10f245a56f4",
                                "sense_id": "7d7fe024-f990-3e9c-a7f4-c570cd6f0540",
                                "text": "He sipped, touched the petal of a white poinsettia on the table, pressed the wax of a red candle, but mainly he watched me at the stove. “Mnh, mnh,” he finally said. “You should wear that dress every day.”"
                            },
                            {
                                "example_id": "97ee01fd-6300-4e3c-a279-cb5d7fb10ba3",
                                "sense_id": "7d7fe024-f990-3e9c-a7f4-c570cd6f0540",
                                "text": "panny: Isabel? I made mac and cheese. / isabel: Mnh."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5258932-45c0-3e06-91e8-861be1978eb4",
                        "entry_id": "17eb4617-ee16-3f01-b8f1-0d5be14b24ec",
                        "glosses": [
                            "Alternative form of mmm.",
                            "Showing thought, reflection, or confusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a9964d-ea4e-480d-8b9e-f768b79087aa",
                                "sense_id": "b5258932-45c0-3e06-91e8-861be1978eb4",
                                "text": "‘So long as I’m happy’, mnh?—what all the parents deprived of grandchildren swallow bravely and say."
                            },
                            {
                                "example_id": "b1615dc6-2f13-4cd6-af35-3033d0979e03",
                                "sense_id": "b5258932-45c0-3e06-91e8-861be1978eb4",
                                "text": "Mnh, what that devil do, made you do it?"
                            },
                            {
                                "example_id": "5294b5a9-5b3a-47dd-95e6-ff3c888853c8",
                                "sense_id": "b5258932-45c0-3e06-91e8-861be1978eb4",
                                "text": "“Mnh,\" I said pensively. “Actually I got sidetracked by a storybook I’m illustrating.”"
                            },
                            {
                                "example_id": "785e99ae-087b-41f9-bcd8-7cbf50a652e3",
                                "sense_id": "b5258932-45c0-3e06-91e8-861be1978eb4",
                                "text": "MNH? / GO BACK TO SLEEP. / THAT AN ORDER? / A SUGGESTION. YOU’VE NEVER BEEN BIG ON ORDERS, GAMORA. / IS SOMETHING WRONG?"
                            }
                        ]
                    },
                    {
                        "sense_id": "259018ba-44a3-3bdd-bb41-9b98104e3944",
                        "entry_id": "17eb4617-ee16-3f01-b8f1-0d5be14b24ec",
                        "glosses": [
                            "Alternative form of mmm.",
                            "Representing a sound produced with a closed mouth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f781c99-0e1f-4b17-a98e-5fd81a628a40",
                                "sense_id": "259018ba-44a3-3bdd-bb41-9b98104e3944",
                                "text": "And the first man struck his pickaxe down hard into the ground, and it made the ground grunt, Mnh! And the second man did the same, and the ground gave another grunt, Mnh!"
                            },
                            {
                                "example_id": "a7f3a643-4149-4cba-80fa-37f18517c4ba",
                                "sense_id": "259018ba-44a3-3bdd-bb41-9b98104e3944",
                                "text": "Only the slight furrow between his eyebrows suggested the agony of indecision he was in; only the faint ‘Mnh-mnh’ coming again from his throat as he cleared it."
                            },
                            {
                                "example_id": "2b87fb8a-4540-4d3a-a05e-95643a3a89a1",
                                "sense_id": "259018ba-44a3-3bdd-bb41-9b98104e3944",
                                "text": "He was singing—mnh, mnh, mnh, mnh—moving up and down again and again through just a few notes."
                            }
                        ]
                    }
