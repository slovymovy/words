                "senses": [
                    {
                        "sense_id": "667ab6ea-56e2-3f70-ba75-a8f2d5f71031",
                        "entry_id": "7450516b-aa6e-309c-b118-48299367d114",
                        "glosses": [
                            "Réduction de prix offerte ou obtenue en dédommagement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8fe887-363c-4814-b0a6-efae047e1c49",
                                "sense_id": "667ab6ea-56e2-3f70-ba75-a8f2d5f71031",
                                "text": "En effet, le titulaire s'engage à effectuer une prestation pour le forfait proposé, quelles que soient les quantités livrées ou exécutées. Dans ce cas, l’acheteur public ne peut pratiquer une réfaction sur le prix en cas de diminution des quantités mises en œuvre."
                            },
                            {
                                "example_id": "802307c6-0d12-4fb4-94a3-1f32ff869850",
                                "sense_id": "667ab6ea-56e2-3f70-ba75-a8f2d5f71031",
                                "text": "La réfaction est appliquée lors de la constatation d'une différence de qualité, de quantité, voire de délais, avec l'objet prévu initialement."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e72705c-0880-38fd-a88e-2d156ef3cf3d",
                        "entry_id": "7450516b-aa6e-309c-b118-48299367d114",
                        "glosses": [
                            "Maintien, dans une grume vendue, d’une section présentant un défaut, mais sans facturer le volume de ladite section."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "63ce7c7d-1193-4861-b668-ed6ab949e133",
                                "sense_id": "1e72705c-0880-38fd-a88e-2d156ef3cf3d",
                                "text": "Roulure partielle (< ½ circonférence) située dans le tiers central du rayon de la plus grande extrémité de la bille et n’apparaissant pas à la plus faible extrémité. Acceptation avec réfaction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbfea0f2-a309-4541-ab35-db82cf5ed9c4",
                        "source_entry_id": "7450516b-aa6e-309c-b118-48299367d114",
