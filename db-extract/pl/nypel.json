                                    },
                                    {
                                        "sense_id": "33d684f9-6fe9-30df-a7f5-91966ce36a71",
                                        "entry_id": "04c1936a-eed0-3ea3-b2aa-d1e9f8776a5c",
                                        "glosses": [
                                            "A mechanical device through which liquids or gases can be passed in a regulated manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f41f2bc-1d36-3846-9505-5cc2aabf0d93",
                                        "entry_id": "04c1936a-eed0-3ea3-b2aa-d1e9f8776a5c",
                                        "glosses": [
                                            "An artificial nipple (definition 1) used for bottle-feeding infants."
                                        ],
                                        "tags": [],
