                    {
                        "translation_id": "84914604-7e86-4189-8925-148fec1f9f31",
                        "source_entry_id": "7857d236-fb93-39bf-b56e-3d96dbdd08d2",
                        "source_sense_id": "dc01d484-3d95-3d98-8d09-7f504819f041",
                        "target_lang_word": "Kreuzworträtsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreuzworträtsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99355d63-7b7d-336d-b0d9-fda6beb4773a",
                                        "entry_id": "e1a7be88-06d4-3053-880b-01711409ae8a",
                                        "glosses": [
                                            "Buchstabenrätsel auf einer durch Spalten und Zeilen in Kästchen geteilten (meist rechteckigen) Fläche, bei der die gesuchten Wörter senkrecht und waagerecht in benachbarte Kästchen eingetragen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b4c0a17-8c4f-4d23-80ba-deb70720875b",
                                                "sense_id": "99355d63-7b7d-336d-b0d9-fda6beb4773a",
                                                "text": "Ich löse sehr gern Kreuzworträtsel."
                                            },
                                            {
                                                "example_id": "2142065f-25f3-45a3-936d-17f23320c5b3",
                                                "sense_id": "99355d63-7b7d-336d-b0d9-fda6beb4773a",
                                                "text": "Kreuzworträtsel gibt es in den unterschiedlichsten Formen."
                                            },
                                            {
                                                "example_id": "2655d90c-b57c-4b86-b8ca-df9756c3b268",
                                                "sense_id": "99355d63-7b7d-336d-b0d9-fda6beb4773a",
                                                "text": "„Der Kapitän und der Erste Offizier saßen auf der Brücke, in ein Kreuzworträtsel vertieft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ea621db-49a1-493b-a31f-c02c8b8590ae",
                        "source_entry_id": "7857d236-fb93-39bf-b56e-3d96dbdd08d2",
                        "source_sense_id": "dc01d484-3d95-3d98-8d09-7f504819f041",
                        "target_lang_word": "crossword",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crossword",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cde4a509-7d1e-3202-9b47-d572b1ed6111",
                                        "entry_id": "82e5b44d-b4f6-3ab1-afa5-0f1dd530d59e",
                                        "glosses": [
                                            "A word puzzle in which interlocking words are entered usually horizontally and vertically into a grid based on clues given for each word."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b2e445a-12d3-387b-91fe-96ab5df8cbcf",
                                        "entry_id": "82e5b44d-b4f6-3ab1-afa5-0f1dd530d59e",
                                        "glosses": [
                                            "The grid of such a puzzle."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfae30d6-0306-4987-b4e1-b0a8ab30747e",
                                                "sense_id": "4b2e445a-12d3-387b-91fe-96ab5df8cbcf",
                                                "text": "HOW TO ENTER::Fill in the crossword and send it to CROSSWORD No.54, DRUM, 176 Main Street, Johannesburg"
                                            },
                                            {
                                                "example_id": "1859aa92-44f3-45fd-be7e-e36182c09663",
                                                "sense_id": "4b2e445a-12d3-387b-91fe-96ab5df8cbcf",
                                                "text": "I sat on the bed and began to fill in the crossword."
                                            },
                                            {
                                                "example_id": "8806757a-52d1-4010-8281-b9afcdaf3546",
                                                "sense_id": "4b2e445a-12d3-387b-91fe-96ab5df8cbcf",
                                                "text": "All you have to do is fill in the crossword on this page and write your name and address on the coupon in Block Capitals (those written in longhand will not qualify)."
                                            },
                                            {
                                                "example_id": "3f9388eb-769b-4203-a36c-b9e5735e336d",
                                                "sense_id": "4b2e445a-12d3-387b-91fe-96ab5df8cbcf",
                                                "text": "They should be able to fill out the crossword using their knowledge from this chapter."
                                            },
                                            {
                                                "example_id": "bca8726c-ca20-4d5a-8e6a-051c6bd19f12",
                                                "sense_id": "4b2e445a-12d3-387b-91fe-96ab5df8cbcf",
                                                "text": "“You said you wanted me to fill out the crossword for you!”"
                                            },
                                            {
                                                "example_id": "7c2f9921-bf98-4e21-a34f-1c4f332581c2",
                                                "sense_id": "4b2e445a-12d3-387b-91fe-96ab5df8cbcf",
                                                "text": "Flair, the butler, drank.[…]On weekdays when we were alone, he would open The Times and fill in the crossword, each clue no sooner read than solved. At weekends he merely read the crossword, then ironed the paper before giving it to Herbie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b60844f3-98e6-49d6-9782-7549e7bcc588",
                        "source_entry_id": "7857d236-fb93-39bf-b56e-3d96dbdd08d2",
                        "source_sense_id": "dc01d484-3d95-3d98-8d09-7f504819f041",
                        "target_lang_word": "crossword puzzle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crossword puzzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "beb0bf06-bbe9-3f22-bbe7-4e7bc8bd6b17",
                                        "entry_id": "b10a9b52-b7aa-37f1-869c-9c75b8b6b042",
                                        "glosses": [
                                            "A crossword."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45115b4e-4764-456b-accf-7aec894c836f",
                                                "sense_id": "beb0bf06-bbe9-3f22-bbe7-4e7bc8bd6b17",
                                                "text": "Humans are not so different, she argues: “We have these incredibly huge brains but we use them to do crossword puzzles – that’s not something that is evolutionarily selected for.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cb5eeb0-ded8-4cf8-9dfe-12eb26bc3d63",
                        "source_entry_id": "7857d236-fb93-39bf-b56e-3d96dbdd08d2",
                        "source_sense_id": "dc01d484-3d95-3d98-8d09-7f504819f041",
                        "target_lang_word": "mots croisés",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mots croisés",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fd95403-4c7e-3ab8-abd1-e06fbc0d3b8e",
                                        "entry_id": "70323116-a238-3486-84da-f760a0a696ee",
                                        "glosses": [
                                            "Jeu qui consiste à remplir une grille où il faut rentrer des mots qui s’entrelacent horizontalement et verticalement, en s’aidant de la définition donnée pour chaque mot."
                                        ],
                                        "tags": [
                                            "Emploi au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf6935c-f145-4879-bd9b-cba958a583ea",
                                                "sense_id": "8fd95403-4c7e-3ab8-abd1-e06fbc0d3b8e",
                                                "text": "Les garçons sont syndiqués, les voyous suivent des problèmes de mots croisés et vont au café comme les rentiers vont aux courses."
                                            },
                                            {
                                                "example_id": "56d6112a-0c3f-4917-ab13-665a5fc76115",
                                                "sense_id": "8fd95403-4c7e-3ab8-abd1-e06fbc0d3b8e",
                                                "text": "J’ai montré à maman le livre de mots croisés apporté par Chantal. Elle a balbutié, en s’adressant à la garde : « J’ai un gros dictionnaire Larousse, le nouveau, je me le suis offert, pour les mots croisés. » Ce dictionnaire : une de ses dernières joies ; elle m’en avait parlé longtemps, avant de l’acheter ; elle s’illuminait chaque fois que je le consultais. « On te l’apportera », lui dis-je. « Oui. Et aussi Le Nouvel Œdipe, je n’ai pas tout trouvé... »"
                                            },
                                            {
                                                "example_id": "2c2572c7-8488-4e0b-810a-00932328340b",
                                                "sense_id": "8fd95403-4c7e-3ab8-abd1-e06fbc0d3b8e",
                                                "text": "Certains entretiennent leur orthographe en pratiquant des jeux de société comme le Scrabble, les mots croisés ou les mots fléchés."
                                            },
                                            {
                                                "example_id": "02044927-9348-4e02-bcb1-614955d4df01",
                                                "sense_id": "8fd95403-4c7e-3ab8-abd1-e06fbc0d3b8e",
                                                "text": "Alors on se contente de mots fléchés qui sont aux mots croisés ce que les œufs de lump sont au caviar."
                                            },
                                            {
                                                "example_id": "25e89df4-1b98-4f06-ac67-653adb5d34d9",
                                                "sense_id": "8fd95403-4c7e-3ab8-abd1-e06fbc0d3b8e",
                                                "text": "Il chercha la page des jeux, plus précisément celle où se trouvaient les mots fléchés qu'il préférait aux mots croisés, ces derniers comportaient parfois des définitions alambiquées, voire tarabiscotées et qui ne tenaient qu'à un fil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c54836d5-2659-304f-a311-64d9a5b84c04",
                                        "entry_id": "70323116-a238-3486-84da-f760a0a696ee",
                                        "glosses": [
                                            "Grille de mots croisés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832e8ac3-285b-49b3-980b-3fe2e7817bbd",
                                                "sense_id": "c54836d5-2659-304f-a311-64d9a5b84c04",
                                                "text": "Ce soir, elle n’avait pas eu son compte et elle s’était acharnée sur un mots croisés, au comptoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
