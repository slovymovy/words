                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d207c01-acc7-4ec5-9d64-674a99b2f13d",
                                                "sense_id": "e2f79af3-7c72-3f29-8995-1c4cb2ef7950",
                                                "text": "Au XIIIᵉ siècle, le chef tribal Osman Iᵉʳ fonde l’Empire ottoman à l’ouest de l’Asie mineure."
                                            }
                                        ]
                                    }
                                ]
                            },
