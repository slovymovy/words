    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "35648cb2-7448-35d3-bbf8-065eee65fa1a",
                "word": "slithy",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0bd03d7f-a890-30ac-8162-24b2318155b1",
                        "entry_id": "35648cb2-7448-35d3-bbf8-065eee65fa1a",
                        "glosses": [
                            "lithe and slimy or slithery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31b53cb1-50d1-44b9-8d68-79a0c3f32a5d",
                                "sense_id": "0bd03d7f-a890-30ac-8162-24b2318155b1",
                                "text": "The squid wrapped its slithy tentacles around its prey."
                            },
                            {
                                "example_id": "bb6db5d4-4ff9-45b8-a4ee-9d019717405d",
                                "sense_id": "0bd03d7f-a890-30ac-8162-24b2318155b1",
                                "text": "'Twas brillig, and the slithy toves / Did gyre and gimble in the wabe."
                            },
                            {
                                "example_id": "2f90b91e-82bd-4117-b219-9cad1365d7f3",
                                "sense_id": "0bd03d7f-a890-30ac-8162-24b2318155b1",
                                "text": "She wanted to wear these slithy, snaky gowns you see in the pictures in the hallways of the $3 photographers."
                            },
                            {
                                "example_id": "7bfa979f-5e9c-4763-a95e-09333d5088c3",
                                "sense_id": "0bd03d7f-a890-30ac-8162-24b2318155b1",
                                "text": "Such a carriage is known as “an araba,” or alternatively as an yaili—a name which is probably onomatopœic, for it is about the “slithiest” thing that runs on wheels."
                            },
                            {
                                "example_id": "74358cf6-ec5d-4b4c-b03f-d32d2b9e1961",
                                "sense_id": "0bd03d7f-a890-30ac-8162-24b2318155b1",
                                "text": "Falling roof, hidden shafts, slithiest snakes could not have stopped me after that. I arrived in the sparkling area."
                            },
                            {
                                "example_id": "f0382807-150b-487c-a4aa-7baadc28d89a",
                                "sense_id": "0bd03d7f-a890-30ac-8162-24b2318155b1",
                                "text": "He sweeps down; a frog is pinioned / Swift arrives his faithful soul-mate / True-loves share their slithy dinner."
                            },
                            {
                                "example_id": "1be0ff73-1ba5-400b-bebf-6a96df593896",
                                "sense_id": "0bd03d7f-a890-30ac-8162-24b2318155b1",
                                "text": "The Beast, slithier even than the Jabberwock and certainly a deal more manxsome as a foe, grips in its claws a dreaded P45 from Piers marking the end of employment at Gussage Court."
                            }
                        ]
                    }
                ],
