                "senses": [
                    {
                        "sense_id": "0d003817-6ecd-3c83-beba-baadfefd5d47",
                        "entry_id": "4ce49f37-fcde-3bd9-84bf-6997eb49cc0f",
                        "glosses": [
                            "To kill; to destroy; to deprive of existence; to annihilate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2bb92f15-3ab2-449f-b78c-5955cd657bea",
                                "sense_id": "0d003817-6ecd-3c83-beba-baadfefd5d47",
                                "text": "Who can uncreate thee, thou shalt know."
                            }
                        ]
                    },
                    {
                        "sense_id": "246a8752-50f7-39ce-94b1-884ed0d090ef",
                        "entry_id": "4ce49f37-fcde-3bd9-84bf-6997eb49cc0f",
                        "glosses": [
                            "To undo the act of creating."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "04bcecbd-4b19-4e6a-b2bb-2428ea0e79b4",
                                "sense_id": "246a8752-50f7-39ce-94b1-884ed0d090ef",
                                "text": "They at least had the immense and mighty imagination of which I speak; they could unthink the past. They could uncreate the Fall. With a reverence which moderns might think impudence, they could uncreate the Creation."
                            }
                        ]
                    }
                ],
