                "senses": [
                    {
                        "sense_id": "1f5d938f-9fb3-3348-9871-c9f0a02d30ed",
                        "entry_id": "8bf587df-e3ac-37f3-9581-cf7769d70cc0",
                        "glosses": [
                            "Handlung, mit der überprüft wird, ob die Luftzirkulation ordnungsgemäß funktioniert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e72285-7efb-4510-979f-298da8533540",
                                "sense_id": "1f5d938f-9fb3-3348-9871-c9f0a02d30ed",
                                "text": "„Sogenannte Haarhygrometer mit Zeiger eignen sich zur Lüftungskontrolle nicht, da diese nicht schnell genug reagieren und zudem immer wieder kalibriert werden müssen.“"
                            },
                            {
                                "example_id": "92b74582-5354-4658-960e-2b36c6ed86a8",
                                "sense_id": "1f5d938f-9fb3-3348-9871-c9f0a02d30ed",
                                "text": "„Übrigens: Familie M. erhält heute vom Vermieter einen Thermohygrografen in die Wohnung gestellt als Lüftungskontrolle.“"
                            },
                            {
                                "example_id": "35741eea-f777-4a57-ba9f-513e826f490d",
                                "sense_id": "1f5d938f-9fb3-3348-9871-c9f0a02d30ed",
                                "text": "„Die Übergabe endete mit einer detaillierten Mappe, mit den wichtigsten Infos zum Haus sowie dem Überreichen eines Hydrometers zur Lüftungskontrolle.“"
                            },
                            {
                                "example_id": "9654d260-7d33-40be-9a3b-7a18714bfe8a",
                                "sense_id": "1f5d938f-9fb3-3348-9871-c9f0a02d30ed",
                                "text": "„Denkbar sind in etwa drei Jahren erste Einsätze in Gebäuden mit zentraler Lüftungskontrolle oder in Flugzeugen, wo das Messsystem an nur einer Stelle aktiv ist.“"
                            },
                            {
                                "example_id": "cda3d65c-e087-460b-a738-513f9a27b2fe",
                                "sense_id": "1f5d938f-9fb3-3348-9871-c9f0a02d30ed",
                                "text": "„Alle erfassten Daten können bis zu zwei Jahren als Lüftungskontrolle gespeichert und bei Bedarf (z.B. Streit- oder Schadensfall) abgerufen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
