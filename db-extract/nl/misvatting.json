                    },
                    {
                        "sense_id": "91f06e1e-4aff-3835-8839-c3034e00a32f",
                        "entry_id": "e0030661-286f-3cfb-912d-0ab7d888a8f8",
                        "glosses": [
                            "figuurlijk: een verkeerd begrip over iets hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dea12acb-dbbf-4498-ae9f-34eca3c74421",
                                "sense_id": "91f06e1e-4aff-3835-8839-c3034e00a32f",
                                "text": "Het is een misvatting van je te denken dat ik die rommel van je opruim, dat doe je maar lekker zelf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c23139d-b5a9-4e0a-88dd-d6e850220e11",
                        "source_entry_id": "e0030661-286f-3cfb-912d-0ab7d888a8f8",
                        "source_sense_id": "7f9e52eb-9a5f-35b5-88c3-944e0c7cca9b",
                        "source_sense_description": "een verkeerde greep",
                        "target_lang_word": "Fehlgriff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fehlgriff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35bc67e1-03cf-3f5e-9b22-f2ec93814b1d",
                                        "entry_id": "fccb568e-2619-3eef-ad8d-69504ac74d99",
                                        "glosses": [
                                            "Handlung, die die gewünschte Wirkung verfehlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3f0c72e-84bc-4ad3-868e-2a8ffa858236",
                                                "sense_id": "35bc67e1-03cf-3f5e-9b22-f2ec93814b1d",
                                                "text": "„Ich brannte darauf, allein mit ihr am Gitter zu sein, und mir wäre es als der größte Fehlgriff erschienen, hätte ich ihr nicht bereits am nächsten Tag die Gewißheit gegeben, daß ich ihren Vorzügen alle geschuldete Gerechtigkeit widerfahren ließ.“"
                                            },
                                            {
                                                "example_id": "e94bb9ed-963c-4f86-988e-dd2a6a527489",
                                                "sense_id": "35bc67e1-03cf-3f5e-9b22-f2ec93814b1d",
                                                "text": "„Dieselbe Regel kann in ihrer aktuellen Anwendung, berücksichtigt man nicht die besonderen Bedingungen des jeweiligen Sprech- oder Schreibakts, einmal voll treffen, das andermal ein vernichtender Fehlgriff sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8eb54304-9a20-3269-aee7-5f73fb1387e6",
                                        "entry_id": "fccb568e-2619-3eef-ad8d-69504ac74d99",
                                        "glosses": [
                                            "Person oder Objekt, die nicht den Erfordernissen/Wünschen entsprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "582f276e-eaeb-48a1-a151-cb4ea5f2fd04",
                                                "sense_id": "8eb54304-9a20-3269-aee7-5f73fb1387e6",
                                                "text": "Der neu angeworbene Spieler erwies sich als Fehlgriff."
                                            },
                                            {
                                                "example_id": "5b99b880-b3fc-4c5c-9a58-3af3204bcc8b",
                                                "sense_id": "8eb54304-9a20-3269-aee7-5f73fb1387e6",
                                                "text": "„Lessing hielt vollkommene Tauglichkeit zum Ideal für einen dramatischen Fehlgriff, denn ein Mensch ohne Lebenswirklichkeit sei auf der Bühne zu nichts nütze, außer um uns zu langweilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
