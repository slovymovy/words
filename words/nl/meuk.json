                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>meuken</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>meuk</w> het eten altijd op een zacht vuurtje gaar.",
                            "target_lang_translations": {
