                "senses": [
                    {
                        "sense_id": "69d8feb5-7bbc-3d53-b519-e1d4051ee359",
                        "entry_id": "9d815d47-ca0e-3619-8e0b-115861b0958b",
                        "glosses": [
                            "Maßeinheit einer (physikalischen) Größe, auf deren Gesamtheit alle anderen Einheiten zurückgeführt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ced2baa-24c9-49ee-a239-abe9981315ba",
                                "sense_id": "69d8feb5-7bbc-3d53-b519-e1d4051ee359",
                                "text": "„Newton ist keine Grundeinheit. Um die Methode der Dimensionsanalyse benutzen zu können, muss man es in Grundeinheiten umwandeln.“"
                            },
                            {
                                "example_id": "ee9f48be-522a-42c7-a07e-bb997ad8ed25",
                                "sense_id": "69d8feb5-7bbc-3d53-b519-e1d4051ee359",
                                "text": "„Bei einem unterstellten Zinssatz von 5,6% entspricht dies im Basisszenario einer Darlehenshöhe von 4% des Kapitalbedarfs der Grundeinheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "76ab6ea3-8262-3b66-a38d-d1f5202b049a",
                        "entry_id": "9d815d47-ca0e-3619-8e0b-115861b0958b",
                        "glosses": [
                            "kleinste zusammengehörige Gruppe von Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a195d04-8d96-4abf-8de7-6c97ffcec598",
                                "sense_id": "76ab6ea3-8262-3b66-a38d-d1f5202b049a",
                                "text": "„Die Familie ist die natürliche Grundeinheit der Gesellschaft und hat Anspruch auf Schutz durch Gesellschaft und Staat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
