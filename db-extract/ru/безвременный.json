                                                "text": "Une sagesse prématurée."
                                            },
                                            {
                                                "example_id": "cafccf91-c40f-450b-9ce2-345c67fb4173",
                                                "sense_id": "030492c9-f224-358e-9edb-0c9953adbebe",
                                                "text": "Une raison prématurée."
                                            },
