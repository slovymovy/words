                },
                {
                    "sense_id": "0b2cc0e7-ba38-366b-92cd-212d1173f1d3",
                    "sense_definition": "Full of strong emotion or intense excitement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His eyes were <w>ablaze</w> with anger after he heard the unfair decision.",
                            "target_lang_translations": {
                                "ru": "Его глаза <w>пылали</w> от гнева, когда он услышал несправедливое решение."
                            }
                        },
                        {
                            "text": "She listened to the speaker with her face <w>ablaze</w> with enthusiasm.",
                            "target_lang_translations": {
                                "ru": "Она слушала оратора, а её лицо <w>горело</w> от энтузиазма."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflame"
                    ],
                    "common_phrases": [
                        "eyes ablaze",
                        "ablaze with passion",
                        "ablaze with anger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охваченный сильными эмоциями, волнением, страстью или гневом."
