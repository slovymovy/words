                        "entry_id": "e2577056-39ef-3007-92c8-20bd14f1b751",
                        "glosses": [
                            "Person, die nach Schlafmitteln oder Betäubungsmitteln süchtig ist, an Narkomanie leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f1cdf8-054c-4f04-8be4-d39d76ad029b",
                                "sense_id": "79c9c966-c4e1-3238-8d08-d8ae838d9978",
                                "text": "Er war ein Trinker, was vielleicht nicht besonders aufgefallen wäre, das waren viele, er war aber auch ein Narkomane, und dieses ohne Auswahl."
                            }
                        ],
                        "sense_index_json": "\"1\""
