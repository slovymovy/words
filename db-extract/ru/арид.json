                "senses": [
                    {
                        "sense_id": "69b735b2-ac3b-3414-8de2-c7d7970bc811",
                        "entry_id": "c5b3df4a-9cdb-3380-94cf-77f5b59f3d74",
                        "glosses": [
                            "метеорол. фаза иссушения климата в зонах пустынь и полупустынь"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "5653684e-0426-413a-9f8c-f95c1dd4eed7",
                                "sense_id": "69b735b2-ac3b-3414-8de2-c7d7970bc811",
                                "text": "Плювиалы и ариды «смещены» во времени по отношению к периодам ледниковий и межледниковий."
                            }
                        ]
                    }
