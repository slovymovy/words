            "senses": [
                {
                    "sense_id": "c4f5d3c1-c737-3953-922c-9cde1c67e944",
                    "sense_definition": "Exercer régulièrement une activité, un sport, un art ou un métier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>pratique</w> le tennis chaque samedi matin avec ses collègues de bureau."
                        },
                        {
                            "text": "Pour rester en forme, il est recommandé de <w>pratiquer</w> une activité sportive régulière."
                        }
                    ],
                    "synonyms": [
                        "exercer"
                    ],
                    "antonyms": [
                        "abandonner",
                        "délaisser"
                    ],
                    "common_phrases": [
                        "pratiquer un sport",
                        "pratiquer une activité"
                    ]
                },
                {
                    "sense_id": "d0065eff-7d69-3be4-bb34-131d0cc97cee",
                    "sense_definition": "Mettre en pratique, appliquer habituellement des règles, des méthodes ou des tarifs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magasin <w>pratique</w> des réductions importantes pendant les soldes d'hiver."
                        },
                        {
                            "text": "Il est parfois difficile de <w>pratiquer</w> ces principes théoriques dans la réalité."
                        }
                    ],
                    "synonyms": [
                        "appliquer"
                    ],
                    "antonyms": [
                        "négliger"
                    ],
                    "common_phrases": [
                        "pratiquer des prix",
                        "pratiquer une politique"
                    ]
                },
                {
                    "sense_id": "2006bf69-ae83-3464-ac7c-aee63f2da778",
                    "sense_definition": "Exécuter ou accomplir une opération chirurgicale ou un acte médical.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a décidé de <w>pratiquer</w> une opération chirurgicale en urgence."
                        },
                        {
                            "text": "L'infirmière <w>pratique</w> une injection pour soulager immédiatement la douleur du patient."
                        }
                    ],
                    "synonyms": [
                        "effectuer",
                        "réaliser"
                    ],
                    "common_phrases": [
                        "pratiquer une incision",
                        "pratiquer une intervention",
                        "pratiquer une opération"
                    ]
                },
                {
                    "sense_id": "dd096786-8136-3169-844b-d10990806a63",
                    "sense_definition": "Observer fidèlement les rites, les devoirs et les préceptes d'une religion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille continue de <w>pratiquer</w> sa religion avec beaucoup de ferveur."
                        },
                        {
                            "text": "Bien qu'il soit croyant, cet homme ne <w>pratique</w> plus depuis de nombreuses années."
                        }
                    ],
                    "synonyms": [
                        "observer"
                    ],
                    "common_phrases": [
                        "pratiquer le culte",
                        "pratiquer une religion"
                    ]
                },
                {
                    "sense_id": "61ace19c-7872-3814-aa19-5db573a9acf9",
                    "sense_definition": "Aménager ou ménager une ouverture, un passage ou un accès dans un espace clos.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers ont <w>pratiqué</w> une ouverture dans le mur pour installer une fenêtre."
                        },
                        {
                            "text": "Le maçon a <w>pratiqué</w> une brèche afin de faciliter l'accès au chantier."
                        }
                    ],
                    "synonyms": [
                        "ménager",
                        "percer"
                    ],
                    "antonyms": [
                        "reboucher"
                    ],
                    "common_phrases": [
                        "pratiquer une brèche",
                        "pratiquer une ouverture"
                    ]
                },
                {
                    "sense_id": "27028f50-6d54-3894-bc6f-84d52ea01f27",
                    "sense_definition": "Fréquenter assidûment quelqu'un ou entretenir des relations continues avec une personne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai longtemps <w>pratiqué</w> cette personne avant de comprendre ses véritables motivations."
                        },
                        {
                            "text": "Ce savant ne <w>pratiquait</w> que des collègues partageant sa passion pour l'histoire."
