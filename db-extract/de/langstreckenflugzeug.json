                "senses": [
                    {
                        "sense_id": "47ce3d97-a856-3a8b-8168-a14ab679b659",
                        "entry_id": "d67562fb-8298-39d6-9c20-0bf7f613549c",
                        "glosses": [
                            "Verkehrsflugzeug, das für große Flugstrecken (größer als 5000 km) ausgelegt ist"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "23f26b63-d583-47f6-8079-4367a52b3ccc",
                                "sense_id": "47ce3d97-a856-3a8b-8168-a14ab679b659",
                                "text": "„In Toulouse übergab Airbus am Montag etwas verspätet das erste A350-Langstreckenflugzeug an den Großkunden Qatar Airways.“"
                            },
                            {
                                "example_id": "bdc61ba6-68ac-428c-9185-059011692383",
                                "sense_id": "47ce3d97-a856-3a8b-8168-a14ab679b659",
                                "text": "„Am Ende musste Airbus ein Langstreckenflugzeug komplett neu entwickeln und neue Technologien einsetzen, die der Konzern zu Beginn noch nicht beherrschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
