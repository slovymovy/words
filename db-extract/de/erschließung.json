                "senses": [
                    {
                        "sense_id": "d77c0fc5-8701-37de-95a4-cea1b2ba095f",
                        "entry_id": "557ca570-6b2a-3be1-9fc5-4b73c6a91d37",
                        "glosses": [
                            "das Zugänglichmachen eines Geländes, einer Region oder eines Territoriums, damit es anschließend von Menschen genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e849f445-844a-4a23-9f2b-6f7ed15c5fb6",
                                "sense_id": "d77c0fc5-8701-37de-95a4-cea1b2ba095f",
                                "text": "Die Erschließung des Regenwaldes schneidet tiefe Schneisen in die Umwelt."
                            },
                            {
                                "example_id": "12e0cb79-7ce7-4987-b611-77c653534fb1",
                                "sense_id": "d77c0fc5-8701-37de-95a4-cea1b2ba095f",
                                "text": "„Ein Teil der Gruben war erschöpft, bei anderen stieß die Erschließung immer tieferer Lagerstätten an technische Grenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cde1e803-ac55-3e82-9e09-e6fd74377eb0",
                        "entry_id": "557ca570-6b2a-3be1-9fc5-4b73c6a91d37",
                        "glosses": [
                            "das Zugänglichmachen eines Gebäudes mittels vertikalen (Treppen, Aufzüge) und horizontalen (Korridor) Elementen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b3383e-5c98-439c-a9ea-3557d9d76c5d",
                                "sense_id": "cde1e803-ac55-3e82-9e09-e6fd74377eb0",
                                "text": "Die zwei Ebenen bekamen bei der Erschließung zwei Rolltreppen und einen Aufzug."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "03a351eb-b596-35aa-aacf-7148a9c56183",
                        "entry_id": "557ca570-6b2a-3be1-9fc5-4b73c6a91d37",
                        "glosses": [
                            "das Bauen von Wegen und den Anschluss an Ver- und Entsorgungsleitungen (Strom, Wasser, Abwasser) zu Grundstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7fe795d-98dc-4ec4-b373-9ed9e1103b4e",
                                "sense_id": "03a351eb-b596-35aa-aacf-7148a9c56183",
                                "text": "Das Gebiet unter dem Berg soll nach der Erschließung ein Gewerbegebiet werden."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "a668c3e0-ba33-3656-9357-7492fdc522c2",
                        "entry_id": "557ca570-6b2a-3be1-9fc5-4b73c6a91d37",
                        "glosses": [
                            "das Zugänglichmachen von Märkten in der Wirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaaf4802-8439-4835-9318-800140b9ea8b",
                                "sense_id": "a668c3e0-ba33-3656-9357-7492fdc522c2",
                                "text": "Mit der Erschließung der asiatischen Märkte gibt es für viele Firmen ganz neue Möglichkeiten."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "b17500ac-f9fb-3704-9ff2-049a330dc09d",
                        "entry_id": "557ca570-6b2a-3be1-9fc5-4b73c6a91d37",
