                ],
                "senses": [
                    {
                        "sense_id": "ac90a13a-217f-3b6b-8e00-3364b69bc3f0",
                        "entry_id": "591c17e3-e656-3b88-ae2f-5bbf2f90f52b",
                        "glosses": [
                            "Kot von Hühnern"
                        ],
                        "tags": [
                            "umgangssprachlich, derb"
                        ],
                        "examples": [
                            {
                                "example_id": "de789b5c-cc66-48a0-94f2-f74285a95c8b",
                                "sense_id": "ac90a13a-217f-3b6b-8e00-3364b69bc3f0",
                                "text": "Tritt nicht in die Hühnerkacke!"
                            },
                            {
                                "example_id": "1cf87308-1323-42c4-8326-5880ff488f00",
                                "sense_id": "ac90a13a-217f-3b6b-8e00-3364b69bc3f0",
                                "text": "„Wenn wir das Haus betraten, mussten wir höllisch aufpassen, nicht in Hühnerkacke zu treten.“"
                            },
                            {
                                "example_id": "8b7245c5-8e8a-46e2-887a-7daa2ab7ca9d",
                                "sense_id": "ac90a13a-217f-3b6b-8e00-3364b69bc3f0",
                                "text": "„Bestialischer Gestank von Hühnerkacke und lautes Gegacker schlug mir in dem Stall entgegen.“"
                            },
                            {
                                "example_id": "1d559ddd-95de-4d2a-8c3f-806808fd8e16",
                                "sense_id": "ac90a13a-217f-3b6b-8e00-3364b69bc3f0",
                                "text": "„Ein großer Hahn hockte in der Mitte des von Hühnerkacke bedeckten Küchentischs – desselben Tisches, auf dem Platzdecken lagen und Geschirr stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "884c9e53-1044-32e1-84e8-b43c4495f6a0",
                        "entry_id": "591c17e3-e656-3b88-ae2f-5bbf2f90f52b",
                        "glosses": [
                            "etwas, das nicht jemandes Vorstellung entspricht; etwas Unsinniges"
                        ],
                        "tags": [
                            "umgangssprachlich, derb"
                        ],
                        "examples": [
                            {
                                "example_id": "e6df29cd-6fa3-43ff-99bd-8f58b4669407",
                                "sense_id": "884c9e53-1044-32e1-84e8-b43c4495f6a0",
                                "text": "Das ist doch Hühnerkacke was ihr da macht, einerseits wollt ihr Helfer und anderseits wollt ihr Beiträge von mir löschen lassen, denkt ihr, das motiviert mich?"
                            },
                            {
                                "example_id": "e1136400-01f0-4841-88b3-9ff78479e027",
                                "sense_id": "884c9e53-1044-32e1-84e8-b43c4495f6a0",
                                "text": "„Es war einfach Hühnerkacke, was sie hier erleben mussten.“"
                            },
                            {
                                "example_id": "b4b33230-71aa-4c14-b142-b6c476cba729",
                                "sense_id": "884c9e53-1044-32e1-84e8-b43c4495f6a0",
                                "text": "„\"Woher sollte ich wissen\", entschuldigt er seine Fehlgriffe, \"was für Hühnerkacke Sauternes sein kann und daß der Name Beaune noch gar nichts sagt?\"“"
                            },
                            {
                                "example_id": "c615c7b4-741b-47fd-8cd3-5d5171da082f",
                                "sense_id": "884c9e53-1044-32e1-84e8-b43c4495f6a0",
                                "text": "„Aber das ist alles Hühnerkacke im Vergleich zu dem, was wir beide künftig verdienen könnten.“"
                            },
                            {
                                "example_id": "fe091aba-d7cf-49c9-b19c-c0e0dbcf0ab8",
                                "sense_id": "884c9e53-1044-32e1-84e8-b43c4495f6a0",
                                "text": "„Ach ihr redet ja alle Hühnerkacke. Ich will hier nicht bleiben, hau jetzt ab. !“"
                            },
                            {
                                "example_id": "ad47e2f9-06c9-4076-9371-11a912227c16",
                                "sense_id": "884c9e53-1044-32e1-84e8-b43c4495f6a0",
                                "text": "„\"Erst diese Hühnerkacke und jetzt hast du auch noch eine Uhr-o-phobie!\" rief Cornelia lachend und wischte sich eine Lachträne aus dem Augenwinkel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
