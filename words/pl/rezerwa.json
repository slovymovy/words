            "senses": [
                {
                    "sense_id": "9bb0a50f-6b00-3447-8dbf-b62c3e2f1cd4",
                    "sense_definition": "zapas czegoś odłożony na później lub na wypadek nieprzewidzianych okoliczności",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zasob",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warto mieć finansową <w>rezerwę</w> na wypadek nagłej utraty pracy.",
                            "target_lang_translations": {
                                "ru": "Стоит иметь финансовый <w>резерв</w> на случай внезапной потери работы."
                            }
                        },
                        {
                            "text": "Woda w zbiorniku szybko się kończy, więc musimy uruchomić żelazną <w>rezerwę</w>.",
                            "target_lang_translations": {
                                "ru": "Вода в резервуаре быстро заканчивается, поэтому нам придется задействовать неприкосновенный <w>запас</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zapas",
                        "zasób"
                    ],
                    "common_phrases": [
                        "żelazna rezerwa",
                        "finansowa rezerwa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запас чего-либо, отложенный на будущее или на случай непредвиденных обстоятельств"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резерв",
                                "target_lang_sense_clarification": "запас ресурсов, финансов или средств"
                            },
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "отложенное количество чего-либо на черный день или на будущее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5eecbcfb-c907-3b0b-96a8-de3bedb884c6",
                    "sense_definition": "powściągliwość, ostrożność lub dystans w sposobie bycia i kontaktach z innymi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postawa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor odnosił się do nowych pracowników z pewną <w>rezerwą</w>.",
                            "target_lang_translations": {
                                "ru": "Директор относился к новым сотрудникам с некоторой <w>сдержанностью</w>."
                            }
                        },
                        {
                            "text": "Początkowa <w>rezerwa</w> zniknęła po kilku minutach swobodnej rozmowy.",
                            "target_lang_translations": {
                                "ru": "Первоначальная <w>настороженность</w> исчезла после нескольких минут непринужденного разговора."
                            }
                        }
                    ],
                    "synonyms": [
                        "dystans",
                        "opanowanie",
                        "powściągliwość",
                        "umiar"
                    ],
                    "antonyms": [
                        "egzaltacja",
                        "wylewność",
                        "zaufanie"
                    ],
                    "common_phrases": [
