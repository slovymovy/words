{
    "word_family": [
        "ход",
        "ходить",
        "проход",
        "проходка",
        "прохожий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90744b74-d501-3bf3-879a-3f74555cdf13",
                    "sense_definition": "Передвигаться пешком через какое-либо пространство или мимо чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы <w>проходят</w> через густой лес к горному озеру.",
                            "target_lang_translations": {
                                "en": "Tourists <w>pass</w> through the dense forest to the mountain lake."
                            }
                        },
                        {
                            "text": "Каждое утро я <w>прохожу</w> мимо этого старого парка.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>pass</w> by this old park."
                            }
                        }
                    ],
                    "common_phrases": [
                        "проходить мимо",
                        "проходить через"
                    ],
                    "target_lang_definitions": {
                        "en": "To move on foot through a space or past something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to go past or by something"
                            },
                            {
                                "target_lang_word": "walk through",
                                "target_lang_sense_clarification": "to move on foot through a specific area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d0e35a9-9763-30a4-8d03-418329645560",
                    "sense_definition": "Войти внутрь какого-либо помещения или пространства.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, <w>проходите</w> в комнату и садитесь на диван.",
                            "target_lang_translations": {
                                "en": "Please <w>come in</w> to the room and sit on the sofa."
                            }
                        },
                        {
                            "text": "Гости <w>проходят</w> в зал для начала торжественного мероприятия.",
                            "target_lang_translations": {
                                "en": "The guests <w>are entering</w> the hall for the start of the ceremony."
                            }
                        }
                    ],
                    "common_phrases": [
                        "проходите в кабинет"
                    ],
                    "target_lang_definitions": {
                        "en": "To enter into a room or space."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come in",
                                "target_lang_sense_clarification": "to enter a room or building"
                            },
                            {
                                "target_lang_word": "go in",
                                "target_lang_sense_clarification": "to enter a room or building"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd7323c9-861d-39b6-b4c7-c364673f49b3",
                    "sense_definition": "Изучать какой-либо учебный материал или дисциплину.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "study",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом семестре студенты <w>проходят</w> сложную тему по физике.",
                            "target_lang_translations": {
                                "en": "This semester, students <w>are covering</w> a difficult topic in physics."
                            }
                        },
                        {
                            "text": "Мы <w>проходим</w> историю древнего мира на уроках в школе.",
                            "target_lang_translations": {
                                "en": "We <w>are studying</w> the history of the ancient world in school lessons."
                            }
                        }
                    ],
                    "common_phrases": [
                        "проходить тему"
                    ],
                    "target_lang_definitions": {
                        "en": "To study or cover a specific academic topic or subject."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "to study or deal with a subject"
                            },
                            {
                                "target_lang_word": "study",
                                "target_lang_sense_clarification": "to learn about a subject"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adfede59-5fda-3793-b471-2b2617e43b42",
                    "sense_definition": "Переставать ощущаться, прекращаться (о боли, чувстве, явлении).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После приема лекарства сильная головная боль постепенно <w>проходит</w>.",
                            "target_lang_translations": {
                                "en": "After taking the medicine, the severe headache gradually <w>passes</w>."
                            }
                        },
                        {
                            "text": "Страх перед экзаменом <w>проходит</w>, как только начинаешь отвечать.",
                            "target_lang_translations": {
                                "en": "The fear of the exam <w>goes away</w> as soon as you start answering."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cease to be felt; to fade away (of pain, feelings, or phenomena)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to come to an end or fade away"
                            },
                            {
                                "target_lang_word": "go away",
                                "target_lang_sense_clarification": "to disappear or cease"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "052f9054-4b50-3859-b4f9-0e6fd60a0aea",
                    "sense_definition": "О времени: течь, истекать, заканчиваться.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Годы <w>проходят</w> очень быстро, когда мы заняты любимым делом.",
                            "target_lang_translations": {
                                "en": "Years <w>pass</w> very quickly when we are busy with our favorite work."
                            }
                        },
                        {
                            "text": "Незаметно <w>проходит</w> лето, и скоро наступит золотая осень.",
                            "target_lang_translations": {
                                "en": "Summer <w>goes by</w> unnoticed, and soon golden autumn will arrive."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding time: to elapse, flow, or come to an end."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to elapse or go by"
                            },
                            {
                                "target_lang_word": "go by",
                                "target_lang_sense_clarification": "to elapse or pass"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a132132e-7fd5-3cfe-a847-642621f5a662",
                    "sense_definition": "Происходить, иметь место (о событии, мероприятии).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Конференция <w>проходит</w> в главном зале университета каждый год.",
                            "target_lang_translations": {
                                "en": "The conference <w>takes place</w> in the main hall of the university every year."
                            }
                        },
                        {
                            "text": "Фестиваль <w>проходит</w> успешно, несмотря на плохую погоду.",
                            "target_lang_translations": {
                                "en": "The festival <w>is happening</w> successfully, despite the bad weather."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To happen or take place (of an event or activity)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take place",
                                "target_lang_sense_clarification": "to happen or occur"
                            },
                            {
                                "target_lang_word": "happen",
                                "target_lang_sense_clarification": "to occur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5900746-8444-3075-863d-f4ee5d0b6bd0",
                    "sense_definition": "Провести некоторое время, совершая ходьбу.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>проходил</w> весь день по магазинам, но так ничего и не купил.",
                            "target_lang_translations": {
                                "en": "I <w>walked around</w> the shops all day, but didn't buy anything."
                            }
                        },
                        {
                            "text": "Он <w>проходил</w> в старых ботинках всю осень до самых морозов.",
                            "target_lang_translations": {
                                "en": "He <w>wore</w> his old boots all autumn until the very first frosts."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To spend time walking."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "walk around",
                                "target_lang_sense_clarification": "to spend time moving on foot"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}