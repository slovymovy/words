                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reformatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f7edb41-a3b2-32ae-a5e0-fdfbfd38efc5",
                                        "entry_id": "58eb1dd3-9a90-312e-9060-149a2030218c",
                                        "glosses": [
                                            "Of, pertaining to, or conducive to reform; reformative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "458b9557-becb-4dc2-a8dd-dcfb1d2729fc",
                                                "sense_id": "3f7edb41-a3b2-32ae-a5e0-fdfbfd38efc5",
                                                "text": "Other reformatory schools might not strike that balance between reform and education."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reformatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3805d644-e5f0-33a4-a022-1eac18303a82",
                                        "entry_id": "f0d2f5f9-fef4-307a-bbf1-386b34dd90ad",
                                        "glosses": [
                                            "A prison, especially one for juveniles; a reform school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21945ea9-6b60-47ff-83b2-579f214038ba",
                                                "sense_id": "3805d644-e5f0-33a4-a022-1eac18303a82",
                                                "text": "It was the nicest-looking property Elwood had ever seen—a real school, a good one, not the forbidding reformatory he’d conjured the last few weeks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20fe2c1d-8ee8-49df-8b8d-1b725e41016d",
                        "source_entry_id": "b06acb41-d0a9-3887-9b45-09e995b317fc",
                        "source_sense_id": "7478fb7c-44ef-3cf5-aaff-c4d98edb52c3",
