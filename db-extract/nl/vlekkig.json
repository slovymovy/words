                                                "text": "You need to tune that guitar: the G string sounds dirty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9be1f7a-d8d7-377f-a7f3-8ef9a6e88148",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
