                "senses": [
                    {
                        "sense_id": "0693c15a-115d-322c-a185-0aeb77700670",
                        "entry_id": "fb4e7072-2548-3dc7-a8be-23b1de346ded",
                        "glosses": [
                            "Couvrir à nouveau."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "c8001167-3083-4d0a-8bc1-ad1acd1c1249",
                                "sense_id": "0693c15a-115d-322c-a185-0aeb77700670",
                                "text": "J’ai pas envie, chéri. Tu me rabrilleras quand t'auras fini!"
                            },
                            {
                                "example_id": "88efc529-8a35-4ebf-a7d4-04dfa7bd7cab",
                                "sense_id": "0693c15a-115d-322c-a185-0aeb77700670",
                                "text": "Prends des bûches pis rabrille la corde pour pas que le bois vienne mouillé."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ee7b14a-3fbc-304a-ba0c-a7deaf1335b2",
                        "entry_id": "fb4e7072-2548-3dc7-a8be-23b1de346ded",
                        "glosses": [
                            "Se couvrir le corps de nouveau, principalement avec une couverture."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "02990ae7-6e80-43ca-bf41-ee7d4259129f",
                                "sense_id": "6ee7b14a-3fbc-304a-ba0c-a7deaf1335b2",
                                "text": "M’a m’rabriller si je veux. Là, j’ai chaud!"
                            }
                        ]
                    }
