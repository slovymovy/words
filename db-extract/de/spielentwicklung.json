                ],
                "senses": [
                    {
                        "sense_id": "1b954bff-5191-319a-9601-9e7758184a68",
                        "entry_id": "63918906-c628-3014-a75b-15f645099b0e",
                        "glosses": [
                            "Veränderungen im Verlauf der individuellen Spielfähigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4246b5-a90b-429a-8f1c-d8ed9992301b",
                                "sense_id": "1b954bff-5191-319a-9601-9e7758184a68",
                                "text": "„Die kindliche Spielentwicklung möglichst sich selber zu überlassen, die Kinder beim Spielen nicht zu stören und in ihr Spiel so wenig wie möglich, eigentlich nur bei unerträglichem Streit, einzugreifen, galt darum lange als die Hauptdevise für den Kindergarten und für die häusliche Erziehung.“"
                            },
                            {
                                "example_id": "62edf63c-c652-4e8b-ab74-a6a73d636af4",
                                "sense_id": "1b954bff-5191-319a-9601-9e7758184a68",
                                "text": "„Als Ergebnis unserer Analyse lassen sich in der kindlichen Spielentwicklung unter Verwendung beschreibender Kategorien vereinfachend drei Entwicklungsschritte ausmachen, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "19af0f5c-ecd5-3d9d-ae05-3756cba5747d",
                        "entry_id": "63918906-c628-3014-a75b-15f645099b0e",
                        "glosses": [
                            "Veränderungen im Verlauf eines Spielgeschehens, auch des Spielaufbaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a6f97db-63ff-4406-a688-f5cde6a88f11",
                                "sense_id": "19af0f5c-ecd5-3d9d-ae05-3756cba5747d",
                                "text": "„Er ist geschaffen gegen Teams, deren zentrale Schwächen im ersten Drittel der Spielentwicklung, insbesondere aber in der Rückwärtsbewegung nach Ballverlusten liegen.“"
                            },
                            {
                                "example_id": "0ae1055e-60b1-48b3-8746-1b4bd9ab74e1",
                                "sense_id": "19af0f5c-ecd5-3d9d-ae05-3756cba5747d",
                                "text": "„Seine Begabung, den Ball wie ein Billardspieler seine Kugel präzise zu adressieren, seine Virtuosität, seine Fähigkeit, den Ball in jeder Lage und Situation zu kontrollieren, erlaubten ihm, sich mit der Spielentwicklung zu befassen, wo Mitspieler weitgehend mit Gegenspieler und Ball beschäftigt wären.“"
                            },
                            {
                                "example_id": "fff8bd83-628f-4021-8791-9d26874ea1f8",
                                "sense_id": "19af0f5c-ecd5-3d9d-ae05-3756cba5747d",
                                "text": "„Die Gelegenheiten und Anreize zum Spielen sind umso vielfältiger, je weniger das Gelände für bestimmte Zwecke bereits vorstrukturiert ist: ein Platz, der nicht auf bestimmte Spielmöglichkeiten eingeengt ist, eine Straße, deren Verkehr nicht jede Spielentwicklung unterbindet, eine Wiese, ein Bach, ein Baggersee, ein Waldstück, die zum Spielen zur Verfügung stehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f82ffd84-3588-3396-bf36-616f1f8990dd",
                        "entry_id": "63918906-c628-3014-a75b-15f645099b0e",
                        "glosses": [
                            "strukturelle und didaktische Veränderungen von Spielen im Laufe der Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f3aa77c-fc27-42bc-a517-336eab0f2500",
                                "sense_id": "f82ffd84-3588-3396-bf36-616f1f8990dd",
                                "text": "„Der Gang durch die Spielentwicklung dokumentiert zunächst einmal, dass die Spielformen nicht einfach einander ablösen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
