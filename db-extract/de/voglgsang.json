                ],
                "senses": [
                    {
                        "sense_id": "fbdc7c92-87e6-3f88-85f6-e1eaea66b5a9",
                        "entry_id": "8f144a55-2687-3fd0-a6b4-6483f8421d19",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b8eed6b-037b-4ae0-86fc-e2832dfe41c1",
                                "sense_id": "fbdc7c92-87e6-3f88-85f6-e1eaea66b5a9",
                                "text": "Frau Voglgsang ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1b14ea70-030c-4fd3-9cb5-cfa8ef78bb38",
                                "sense_id": "fbdc7c92-87e6-3f88-85f6-e1eaea66b5a9",
                                "text": "Herr Voglgsang wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "42c068f3-2807-4267-9143-0ceb12ebcf4d",
                                "sense_id": "fbdc7c92-87e6-3f88-85f6-e1eaea66b5a9",
                                "text": "Die Voglgsangs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7cd23dca-bbab-45bf-b9d9-4289393eb8b2",
                                "sense_id": "fbdc7c92-87e6-3f88-85f6-e1eaea66b5a9",
                                "text": "Der Voglgsang trägt nie die Schals, die die Voglgsang ihm strickt."
                            },
                            {
                                "example_id": "f2387358-4cbd-4b04-bdd5-41ea684f4aa0",
                                "sense_id": "fbdc7c92-87e6-3f88-85f6-e1eaea66b5a9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Voglgsang kommt, geht der Herr Voglgsangs.“"
                            },
                            {
                                "example_id": "aaf69d77-efd9-4c0e-8eba-02eb18ec4058",
                                "sense_id": "fbdc7c92-87e6-3f88-85f6-e1eaea66b5a9",
                                "text": "Voglgsang kommt und geht."
                            },
                            {
                                "example_id": "43f7ce0a-74f4-4daa-9f0a-99cfed495aa5",
                                "sense_id": "fbdc7c92-87e6-3f88-85f6-e1eaea66b5a9",
                                "text": "Voglgsangs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
