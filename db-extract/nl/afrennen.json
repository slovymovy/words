                                    {
                                        "sense_id": "935ae2b3-59ec-30a4-99d9-6fe3c4b1dc29",
                                        "entry_id": "ee9e316c-4760-31cc-82fa-70978a0018ae",
                                        "glosses": [
                                            "To leave in a hurry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78366745-6925-3cea-91fb-0ff48cb88a33",
                                        "entry_id": "ee9e316c-4760-31cc-82fa-70978a0018ae",
                                        "glosses": [
                                            "To produce in great haste."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9812217-4877-40a1-878c-ec318d1f9b69",
                                                "sense_id": "78366745-6925-3cea-91fb-0ff48cb88a33",
                                                "text": "I rushed off a letter, warning them that I would be arriving the next day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "810f3735-0a1a-4bd8-b10a-0991e26de0ab",
                        "source_entry_id": "f5bb208f-caf9-3690-a62b-be5fe5fcb03b",
                        "source_sense_id": "4f02c85b-549c-361c-9b1f-7cbd961c661a",
                        "source_sense_description": "rennend verwijderen",
                        "target_lang_word": "run off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "run off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e87f771-31fc-336b-988c-064bb9a05c44",
                                        "entry_id": "0c1ae535-9681-39e8-a521-4ebb93522745",
                                        "glosses": [
                                            "To flee or depart quickly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22dc7f86-7537-414e-9325-f8e7da49f1a7",
                                                "sense_id": "1e87f771-31fc-336b-988c-064bb9a05c44",
                                                "text": "Don't run off before the end of the event."
                                            },
                                            {
                                                "example_id": "fea5d447-9098-4474-a225-aba7cfc85086",
                                                "sense_id": "1e87f771-31fc-336b-988c-064bb9a05c44",
                                                "text": "He ran off to France leaving her with all the debts and three children to bring up."
                                            },
                                            {
                                                "example_id": "9c69b281-8a48-4e23-a421-0f97a74ca053",
                                                "sense_id": "1e87f771-31fc-336b-988c-064bb9a05c44",
                                                "text": "My girlfriend's run off with my car\nAnd gone back to her ma and pa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d13a3a1-ee3c-32c8-a7b6-965db826c7b5",
                                        "entry_id": "0c1ae535-9681-39e8-a521-4ebb93522745",
                                        "glosses": [
                                            "To make photocopies, or print."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23d7317-b05f-4939-b744-987d9bec99b3",
                                                "sense_id": "5d13a3a1-ee3c-32c8-a7b6-965db826c7b5",
                                                "text": "Please run off a couple dozen more flyers to pass out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1f7911b-af6f-3f6f-9474-c9eca8b17402",
                                        "entry_id": "0c1ae535-9681-39e8-a521-4ebb93522745",
                                        "glosses": [
                                            "To write something quickly."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2725bba-f39a-4bc7-af34-be2eaa9dbd1a",
                                                "sense_id": "e1f7911b-af6f-3f6f-9474-c9eca8b17402",
                                                "text": "Shakespeare could run off a play in just a couple of days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf61ccff-5e36-3f31-b44f-05c43f1459be",
                                        "entry_id": "0c1ae535-9681-39e8-a521-4ebb93522745",
                                        "glosses": [
                                            "To pour or spill off or over."
                                        ],
                                        "tags": [
                                            "of a liquid"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58e4665d-0d72-4712-8d1e-b8107e3a1c05",
