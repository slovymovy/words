                                "target_senses": [
                                    {
                                        "sense_id": "c98605f6-c720-3f3b-b0c7-8be239d46584",
                                        "entry_id": "9667daba-88ad-3354-931a-512bc39c4fef",
                                        "glosses": [
                                            "nádoba či nádrž, odkud je možno čerpat kapalinu či plyn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38de9da-7352-44fd-9d64-9f21691902f8",
                                                "sense_id": "c98605f6-c720-3f3b-b0c7-8be239d46584",
                                                "text": "Společnost Česká voda, jejíž mateřskou firmou je vodohospodářský gigant Veolia, drží cenu dál pod náklady, jak tvrdí konkurenční firmy, podle nichž auta České vody nevyvážejí fekálie do oficiálních rezervoárů, ale vypouštějí je, kde se dá."
                                            },
                                            {
                                                "example_id": "e6a1ddc7-ef54-4d77-94d1-f6e1c69914e3",
                                                "sense_id": "c98605f6-c720-3f3b-b0c7-8be239d46584",
                                                "text": "Izolační obal na vodní rezervoár udrží v parném létě tekutinu příjemně chladnou a v zimě naopak zamezí jejímu rychlému ochlazení."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cb4806f-8f1a-3fb4-837a-0f6cc5e9cc9a",
                                        "entry_id": "9667daba-88ad-3354-931a-512bc39c4fef",
                                        "glosses": [
                                            "obdobné místo, odkud je možno čerpat; kde je potřebná věc (např. energie, nápady apod.) do zásoby"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d9a221-44b8-40e5-908c-b5926773c140",
                                                "sense_id": "5cb4806f-8f1a-3fb4-837a-0f6cc5e9cc9a",
                                                "text": "Je potom s podivem, že nesáhl do nepřeberného rezervoáru již existujících teorií kooperace (namátkou se nabízí teorie režimů, jejíž přehled je v současné době k dispozici i v českém jazyce)"
                                            },
                                            {
                                                "example_id": "00193eb4-0dd8-4b38-9c2d-0a7b28ff9eda",
                                                "sense_id": "5cb4806f-8f1a-3fb4-837a-0f6cc5e9cc9a",
                                                "text": "Podle ministra práce Petra Nečase (ODS) mohou být rezervoárem dalších pracovních sil například starší pracovníci či rodiče."
                                            },
                                            {
                                                "example_id": "0c574274-6c24-4027-822a-319c4ef621d5",
                                                "sense_id": "5cb4806f-8f1a-3fb4-837a-0f6cc5e9cc9a",
                                                "text": "Vzhledem k plánované neúčasti brankáře Martina Malitse jsme museli sáhnout do nepřeberného rezervoáru našich hráčů a oprášit další „ legendu“ a to brankáře Pavla Bezděka, který se postavil po téměř dvou letech opět mezi tyče a patřil k našim nejlepším hráčům."
                                            }
                                        ]
                                    }
                                ]
