                                                "sense_id": "21ddfff5-8181-3353-9f33-e0a494bddd6e",
                                                "text": "„Nur ihre Lenden heben sich so leuchtend vom Rest des Körpers ab, daß sie wie angekleidet wirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
