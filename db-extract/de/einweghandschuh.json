                "senses": [
                    {
                        "sense_id": "4d59a51f-6de3-3dd3-8abd-65b0ef2a40eb",
                        "entry_id": "676ee8e8-976f-3297-8c26-a8e95102433c",
                        "glosses": [
                            "Handschuh, der für einen einmaligen Gebrauch bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c4ace6a-e53f-404a-9313-659d90f9f29f",
                                "sense_id": "4d59a51f-6de3-3dd3-8abd-65b0ef2a40eb",
                                "text": "„Der Junge kommt wieder herein, gibt Spülmittel hinzu, streift sich ein Paar Einweghandschuhe über und beginnt, die Teegläschen einzuschäumen.“"
                            },
                            {
                                "example_id": "9f048e4a-ed0d-43c4-a4b3-8b20b6e3994f",
                                "sense_id": "4d59a51f-6de3-3dd3-8abd-65b0ef2a40eb",
                                "text": "„Ich hörte das Quietschen von Gummi und begriff, dass sich einer von ihnen einen Einweghandschuh überzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
