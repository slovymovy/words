                ],
                "senses": [
                    {
                        "sense_id": "9a2aa37c-6d4f-397d-9f4d-f34e13c4052a",
                        "entry_id": "26e44dc5-a76f-3fb2-8a9b-d0203aaba70f",
                        "glosses": [
                            "Qui est conforme à l’aristotélisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79bbf82-f2a1-4ba9-8095-301725d62dca",
                                "sense_id": "9a2aa37c-6d4f-397d-9f4d-f34e13c4052a",
                                "text": "L'Encyclopédie aristotélicienne apparut comme la somme de connaissances humaines auxquelles l'esprit humain peut accéder par ses propres forces."
                            },
                            {
                                "example_id": "c38eb52b-558f-40f2-8151-73be241f0998",
                                "sense_id": "9a2aa37c-6d4f-397d-9f4d-f34e13c4052a",
                                "text": "Loin de paraître comme inconciliables avec la piété, les commentaires nouveaux pouvaient sembler à certains mystiques parisiens un compromis heureux entre le néoplatonisme augustinien, l’abélardisme aristotélicien et l’esprit positif des savants ou des astrologues."
                            },
                            {
                                "example_id": "0f43d7a7-d45f-47d6-8e18-9ee44b620f23",
                                "sense_id": "9a2aa37c-6d4f-397d-9f4d-f34e13c4052a",
                                "text": "Bustamante balaya la remarque d'un revers de main de l'air de dire que la logique aristotélicienne ne s'appliquait pas dans cette affaire."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
