                                        "sense_id": "15e132a0-ec9e-3ff6-a6cb-adc6af49f642",
                                        "entry_id": "b7304192-275b-329d-82e9-5b6e4d3f69ad",
                                        "glosses": [
                                            "Fleisch der Schenkel von Schlachtvieh meist im engeren Sinne von Schweinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f5de90-429e-42fc-bac6-b69cb791ca07",
                                                "sense_id": "15e132a0-ec9e-3ff6-a6cb-adc6af49f642",
                                                "text": "Ich esse meinen Schinken nicht, nein, meinen Schinken ess' ich nicht."
                                            },
                                            {
                                                "example_id": "be1c9f8b-9992-4ba3-b9c4-2e3d98358086",
                                                "sense_id": "15e132a0-ec9e-3ff6-a6cb-adc6af49f642",
                                                "text": "„Auf einem breiten Tisch zeigen gewaltige Schinken ihr reiches Inneres, da sind Platten mit gebratenen Fischen, Pilze, der Schmuck der Früchte.“"
                                            },
                                            {
                                                "example_id": "6ea1806f-9dc4-41a8-8299-5d8820cd6a15",
                                                "sense_id": "15e132a0-ec9e-3ff6-a6cb-adc6af49f642",
                                                "text": "„Er bot dafür einen großen Schinken.“"
                                            },
                                            {
                                                "example_id": "6a8d73c1-f54c-4715-b0ca-b4f984af0b57",
                                                "sense_id": "15e132a0-ec9e-3ff6-a6cb-adc6af49f642",
                                                "text": "„Ein Abendessen aus Schinken, Kartoffeln und Whisky war auf einer der reichvergoldeten Konsolen vorbereitet worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24ae6367-4474-36c0-83c8-b9d72bf8d308",
                                        "entry_id": "b7304192-275b-329d-82e9-5b6e4d3f69ad",
                                        "glosses": [
                                            "Oberschenkel und Gesäßhälften"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f379a34-79e4-453e-a736-80a64dc3ef56",
                                                "sense_id": "24ae6367-4474-36c0-83c8-b9d72bf8d308",
                                                "text": "Der hat ja einen Schinken; er müsste mal fasten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "93b3f7d8-0987-35ec-a34a-d9f1878189cf",
                                        "entry_id": "b7304192-275b-329d-82e9-5b6e4d3f69ad",
                                        "glosses": [
                                            "schweres oder großes Buch"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a61888b-6353-41bb-90fa-e77c2a2898ac",
                                                "sense_id": "93b3f7d8-0987-35ec-a34a-d9f1878189cf",
                                                "text": "Diesen Schinken würde ich nicht lesen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "94574503-3b4f-3ab7-b876-33f76cb46046",
                                        "entry_id": "b7304192-275b-329d-82e9-5b6e4d3f69ad",
                                        "glosses": [
                                            "ein als minderwertig empfundenes oder auch großes Gemälde"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f7f93f-5a3b-4830-b5bc-2240698b9a91",
                                                "sense_id": "94574503-3b4f-3ab7-b876-33f76cb46046",
                                                "text": "Hast du den Schinken vom Flohmarkt geholt?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "592dddb4-cca0-3c47-aff7-9b1270fa413c",
                                        "entry_id": "b7304192-275b-329d-82e9-5b6e4d3f69ad",
                                        "glosses": [
                                            "Bühnenstück oder Film von großen Umfang"
                                        ],
