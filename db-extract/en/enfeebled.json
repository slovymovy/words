                        "glosses": [
                            "Weakened; reduced to a powerless state."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "813b9e8a-89e6-4b1f-ba4d-48a44d6ca456",
                                "sense_id": "886af683-c0fe-313f-90e9-2c868d7d38ab",
                                "text": "So enfeebled was resolution in him that he could only palter at a fatuous picture of himself carrying Podson bodily over the lagoon and dumping him on the sand dunes."
                            },
                            {
                                "example_id": "32a21de5-02d0-44a7-a399-3541336725f2",
                                "sense_id": "886af683-c0fe-313f-90e9-2c868d7d38ab",
                                "text": "In commercial after commercial, humans are oblivious, enfeebled, barely functioning idiots beset by more tasks, stimuli and demands on their time than anyone could reasonably handle."
                            }
                        ]
                    }
