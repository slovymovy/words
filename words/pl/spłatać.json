    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc09937b-33fb-35fc-ad97-5fa4c5dff771",
                    "sense_definition": "zrobić komuś niespodziewany, często kłopotliwy żart",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "żart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pogoda potrafi <w>spłatać</w> nam figla w najmniej oczekiwanym momencie.",
                            "target_lang_translations": {
                                "ru": "Погода может <w>сыграть</w> с нами злую шутку в самый неподходящий момент."
                            }
                        },
                        {
                            "text": "Mój stary samochód <w>spłatał</w> mi figla i nie chciał odpalić rano.",
                            "target_lang_translations": {
                                "ru": "Моя старая машина <w>выкинула</w> номер и не захотела заводиться утром."
                            }
                        }
                    ],
                    "synonyms": [
                        "wypłatać"
                    ],
                    "common_phrases": [
                        "spłatać figla"
                    ],
                    "target_lang_definitions": {
                        "ru": "сыграть с кем-то неожиданную, часто неприятную шутку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыграть",
                                "target_lang_sense_clarification": "в сочетании со словом 'шутка' или 'злую шутку'"
                            },
                            {
                                "target_lang_word": "выкинуть",
                                "target_lang_sense_clarification": "в значении совершить неожиданный, часто неприятный поступок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0738bf5d-ade1-3ccf-8b79-528a09fcf1cd",
                    "sense_definition": "rozciąć coś na kawałki lub płaty",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "krojenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharz musiał <w>spłatać</w> rybę na mniejsze kawałki przed smażeniem.",
                            "target_lang_translations": {
                                "ru": "Повар должен был <w>разделать</w> рыбу на более мелкие куски перед жаркой."
                            }
                        },
                        {
                            "text": "Właściciel restauracji kazał <w>spłatać</w> mięso na cienkie plastry.",
                            "target_lang_translations": {
                                "ru": "Владелец ресторана приказал <w>нарезать</w> мясо тонкими ломтиками."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разрезать что-либо на куски или пласты"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделать",
                                "target_lang_sense_clarification": "о рыбе или мясе"
                            },
                            {
                                "target_lang_word": "нарезать",
                                "target_lang_sense_clarification": "на куски или ломтики"
                            }
                        ]
                    }
                }
            ]
        }
    ]
