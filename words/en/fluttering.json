            "senses": [
                {
                    "sense_id": "6cb53bf4-c0ca-30fe-b92c-adab8fc93fe2",
                    "sense_definition": "A rapid back-and-forth waving, flapping, or trembling motion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>fluttering</w> of wings startled the sleeping cat.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>хлопанье</w> крыльев испугало спящую кошку."
                            }
                        },
                        {
                            "text": "He felt a faint <w>fluttering</w> in his chest as his heart skipped a beat.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал слабое <w>трепетание</w> в груди, когда его сердце замерло."
