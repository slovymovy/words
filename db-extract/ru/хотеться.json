                        "entry_id": "40f005d3-c358-31d8-a972-e1e516f660c1",
                        "glosses": [
                            "to want, to desire, to feel like (doing/having/etc.)"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "f13359e0-f5fe-4c47-807b-cb87937422f5",
                                "sense_id": "4133be7d-e862-3f10-9b47-13ba11f98264",
                                "text": "мне хо́чется ...",
                                "translation": "I’d like ...",
                                "english": "I’d like ..."
                            },
                            {
                                "example_id": "5775c578-ad12-4dab-a0bc-9ddb96d79ce1",
                                "sense_id": "4133be7d-e862-3f10-9b47-13ba11f98264",
                                "text": "Когда́ бе́гаешь и хо́дишь, спать уже́ не так хо́чется, как в сидя́чем положе́нии.",
                                "translation": "When you run and walk, you no longer want to sleep as much as when in a sitting position.",
                                "english": "When you run and walk, you no longer want to sleep as much as when in a sitting position."
                            },
                            {
                                "example_id": "0f19e483-e61b-4a82-801d-f0a999d2ff3c",
                                "sense_id": "4133be7d-e862-3f10-9b47-13ba11f98264",
                                "text": "Не хотелось ни есть, ни пить - ничего не хотелось.",
                                "translation": "He desired neither food nor drink - He desired nothing.",
                                "english": "He desired neither food nor drink - He desired nothing."
                            }
                        ]
                    },
