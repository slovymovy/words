                "senses": [
                    {
                        "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                        "entry_id": "532f7a96-66ab-3028-94cf-fd7ad7afed4f",
                        "glosses": [
                            "flüssige Substanz, die bewirkt, dass die Wärme von einem Gegenstand abtransportiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23a07d7-c61f-4b20-8df9-23a990739016",
                                "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                "text": "„Fehlt Kühlflüssigkeit, füllen Sie diese nach Angaben des Herstellers nach.“"
                            },
                            {
                                "example_id": "4968b8cf-e557-40ea-9512-a66705273101",
                                "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                "text": "Ein AKW muss gekühlt werden, dafür braucht man Kühlflüssigkeit."
                            },
                            {
                                "example_id": "36b6e69b-e42a-4039-8a62-4b1c21b3d859",
                                "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                "text": "„Das weltweit größte Rechenzentrum, das Lakeside Technology Center, braucht etwa 100 Megawatt elektrischen Strom, für die Kühlung der Server-Räume nutzt der Betreiber einen riesigen Tank mit über 32 Millionen Liter Kühlflüssigkeit.“"
                            },
                            {
                                "example_id": "1996e18c-425c-410a-9931-1e6adcff67dc",
                                "sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                                "text": "„Kühlflüssigkeit prüfen – Kühlflüssigkeit immer bei kaltem Motor prüfen. Bei warmem Motor kann Ihnen die Kühlflüssigkeit beim Öffnen entgegenspritzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d68d058d-b599-4780-b728-98f64c351bdd",
                        "source_entry_id": "532f7a96-66ab-3028-94cf-fd7ad7afed4f",
                        "source_sense_id": "70421c05-6469-3852-8ca4-cfeccb22063c",
                        "source_sense_description": "flüssige Substanz, die bewirkt, dass die Wärme von einem Gegenstand abtransportiert wird",
                        "target_lang_word": "coolant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coolant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                        "entry_id": "029bb350-e5e0-37c2-b0e7-e59bf6de9640",
                                        "glosses": [
                                            "A medium, usually fluid, used to draw heat from an object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d636eb25-3c91-43c6-8c15-3e190c3832af",
                                                "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                                "text": "Coolant is used in car engines and industrial processes, where excess heat could cause machine damage."
                                            },
                                            {
                                                "example_id": "b97c4eb3-45cc-4cf9-9f5e-02102b1eb0d8",
                                                "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                                "text": "Anti-freeze has not been found necessary, even in the most severe conditions, since the water is drained out if a locomotive spends any appreciable time out of service and in normal working conditions the coolant is always warm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
