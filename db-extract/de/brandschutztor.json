                "senses": [
                    {
                        "sense_id": "b17762c0-d29d-328b-b429-4799cc8bbe5b",
                        "entry_id": "f76d02e6-ce38-3576-8b66-ba69cfdf640e",
                        "glosses": [
                            "spezielles Tor, das im Brandfall (= Rauch + Feuer) selbsttätig schließt und das Durchlassen von Rauch und Feuer verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fa0a3fa-b1e6-4179-868a-b3b66a4d29f7",
                                "sense_id": "b17762c0-d29d-328b-b429-4799cc8bbe5b",
                                "text": "„Zeitgemässe Brandschutztore zeigen Charakter: Sie sind schützendes Trennelement respektive Brandabschnitt und fügen sich zugleich ästhetisch hervorragend in eine hochwertig gestaltete Umgebung ein.“"
                            },
                            {
                                "example_id": "1bc58baa-9ad1-48e9-94a0-8fd58670ac6e",
                                "sense_id": "b17762c0-d29d-328b-b429-4799cc8bbe5b",
                                "text": "„Die Brandschutztore sind mit einer praktisch wartungsfreien, mechanischen Gegengewichtsschliessung ausgestattet.“"
                            },
                            {
                                "example_id": "82d97a51-bcde-474a-95de-1cc41a6877d9",
                                "sense_id": "b17762c0-d29d-328b-b429-4799cc8bbe5b",
                                "text": "„Grundsätzlich dürfen nur geprüfte und zugelassene Brandschutztore, zum Beispiel gemäss VKF-Brandschutzanwendung, eingebaut werden.“"
                            },
                            {
                                "example_id": "ab6425a3-7a92-40d7-826b-610176f89b30",
                                "sense_id": "b17762c0-d29d-328b-b429-4799cc8bbe5b",
                                "text": "„Brandschutztore sind selbstschließende Tore, die Öffnungen in feuerhemmenden Wänden verschließen, um den Durchtritt von Rauch beziehungsweise Feuer zu verhindern.“"
                            },
                            {
                                "example_id": "20efc2af-c7a2-481b-b684-9eb145693d94",
                                "sense_id": "b17762c0-d29d-328b-b429-4799cc8bbe5b",
                                "text": "„Diese Steuerung EL0112 mit integriertem Frequenzumrichter, für die motorische Öffnungshilfe, gewährleistet durch die definierte Beschleunigungsrampe eine absolut sanfte und ruckfreieStartbewegung des Brandschutztores bis 3 Tonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
