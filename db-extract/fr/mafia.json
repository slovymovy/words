                "senses": [
                    {
                        "sense_id": "a0810362-cf8a-39ee-9816-9a927b27ad75",
                        "entry_id": "87550092-9b56-3368-8d0e-6f57ea6738dc",
                        "glosses": [
                            "Organisation criminelle sicilienne puis italo-américaine dont les activités sont soumises à une direction collégiale occulte et qui repose sur une stratégie d’infiltration de la société civile et des institutions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502f6509-2cf0-4382-b9f1-520a288a3727",
                                "sense_id": "a0810362-cf8a-39ee-9816-9a927b27ad75",
                                "text": "Durant toute la guerre froide, la mafia entretient des liens avec les partis politiques italiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "731e24fb-e8bd-33f9-975e-3898684e8419",
                        "entry_id": "87550092-9b56-3368-8d0e-6f57ea6738dc",
                        "glosses": [
                            "Toute organisation criminelle structurée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "27ad156b-e7c5-4425-9f33-35507e5f1fab",
                                "sense_id": "731e24fb-e8bd-33f9-975e-3898684e8419",
                                "text": "On ne s'improvise pas usurier, il faut parvenir d'abord à une méritoire insertion dans la mafia des gens bien placés pour exploiter leur prochain."
                            },
                            {
                                "example_id": "3252059e-85f3-4fdf-b8a2-62ac42148306",
                                "sense_id": "731e24fb-e8bd-33f9-975e-3898684e8419",
                                "text": "La mafia albanaise est spécialisée dans le trafic de cigarettes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c24bdfff-eb98-4114-a6a9-bd76b78dc61d",
                        "source_entry_id": "87550092-9b56-3368-8d0e-6f57ea6738dc",
                        "target_lang_word": "Mafia",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mafia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c589bf10-732f-306b-b262-a5b82dbf6526",
                                        "entry_id": "020241bd-91fd-3c8a-8c78-9c10118a6db9",
                                        "glosses": [
                                            "organisierte Verbrecherorganisationen"
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f5b8b3-efc6-40c3-ba24-d973845c33b0",
                                                "sense_id": "c589bf10-732f-306b-b262-a5b82dbf6526",
                                                "text": "„Heute wird sie geschunden von der ’Ndrangheta, der kalabresischen Mafia, und abgeschrieben von den Parlamentariern aus Rom.“"
                                            },
                                            {
                                                "example_id": "4482c319-dd41-4d59-9e92-35dd6d31dbc1",
                                                "sense_id": "c589bf10-732f-306b-b262-a5b82dbf6526",
                                                "text": "„Wer der italienischen Mafia die Stirn bietet, bekommt Silber, wer der russischen Mafia gewachsen ist, bekommt Gold.“"
                                            },
                                            {
                                                "example_id": "f96515d4-fc24-4e8b-be41-6de3cddb9586",
                                                "sense_id": "c589bf10-732f-306b-b262-a5b82dbf6526",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            },
                                            {
                                                "example_id": "71c5e33e-d479-4efb-8671-0d220d1d6c32",
                                                "sense_id": "c589bf10-732f-306b-b262-a5b82dbf6526",
                                                "text": "„Du kümmerst dich um sie, aber die Mafia nimmt dir sämtliche Milch weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "13c561a9-3997-316c-b2fc-3b53863e2690",
                                        "entry_id": "020241bd-91fd-3c8a-8c78-9c10118a6db9",
                                        "glosses": [
                                            "sizilianischer Geheimbund"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18f04cda-9453-42c5-ba31-bc5f67e57cae",
                                                "sense_id": "13c561a9-3997-316c-b2fc-3b53863e2690",
                                                "text": "„Mussolini entsandte den „eisernen Präfekten“ Cesare Mori nach Sizilien, der mit allen Mitteln des autoritären faschistischen Staates gegen die Mafia vorging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
