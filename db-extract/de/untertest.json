                "senses": [
                    {
                        "sense_id": "d374cb54-290b-3ee7-ba59-9bc63cafc8f7",
                        "entry_id": "a9176393-b28b-3df2-abf1-f4e95557c06b",
                        "glosses": [
                            "einer von mehreren, zu einem übergeordneten Test gehörender Test"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c41f244c-948c-4884-b347-dab70d2e3000",
                                "sense_id": "d374cb54-290b-3ee7-ba59-9bc63cafc8f7",
                                "text": "„Alle wichtigen Bereiche der Aufmerksamkeit werden in gesonderten Untertests erfasst, und die Leistungen werden im Anschluss an die Untersuchung anhand von Prozenträngen dargestellt.“"
                            },
                            {
                                "example_id": "ebe77aa8-5499-4e45-baa2-afff97a08726",
                                "sense_id": "d374cb54-290b-3ee7-ba59-9bc63cafc8f7",
                                "text": "„Ein letzter Untertest gilt der Integration von Regeln und Bedeutungszusammenhängen bei der Wiedergabe eines vorgelesenen Textes.“"
                            },
                            {
                                "example_id": "8f11f4cb-8d85-4b14-b979-0113eda9bc7b",
                                "sense_id": "d374cb54-290b-3ee7-ba59-9bc63cafc8f7",
                                "text": "„Der Untertest Sprache enthält insgesamt 76 Aufgaben zum Sprachverständnis, die auf neun Texte bezogen sind: drei Prosa-, zwei Sach- und vier Gebrauchstexte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
