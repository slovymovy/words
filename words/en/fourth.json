                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кварта",
                                "target_lang_sense_clarification": "музыкальный интервал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4d76f7f-fdf5-34de-900b-f25e41bcad9b",
                    "sense_definition": "A unit of time or angle equal to one sixtieth of a third.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient astronomers divided seconds into thirds and then into <w>fourths</w>.",
                            "target_lang_translations": {
                                "ru": "Древние астрономы делили секунды на терции, а затем на <w>четвёртые</w>."
                            }
                        },
                        {
                            "text": "The calculation was precise down to the last <w>fourth</w> of a degree.",
                            "target_lang_translations": {
                                "ru": "Расчет был точен до последней <w>четвёртой</w> градуса."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица времени или угла, равная одной шестидесятой части терции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "четвёртая",
                                "target_lang_sense_clarification": "устаревшая единица измерения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
