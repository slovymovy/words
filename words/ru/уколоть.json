{
    "word_family": [
        "укол",
        "уколка",
        "уколыш",
        "укольный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "086501a0-1d3f-34c3-ad47-2e66110c766c",
                    "sense_definition": "Вонзить острый предмет, обычно небольшой, в кожу или поверхность.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Медсестра попросила меня расслабиться, чтобы <w>уколоть</w> палец для анализа крови.",
                            "target_lang_translations": {
                                "en": "The nurse asked me to relax so she could <w>prick</w> my finger for a blood test."
                            }
                        },
                        {
                            "text": "Осторожно, не <w>уколите</w> руку об эту острую проволоку.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>prick</w> your hand on this sharp wire."
                            }
                        }
                    ],
                    "synonyms": [
                        "проткнуть",
                        "ужалить"
                    ],
                    "common_phrases": [
                        "уколоть палец",
                        "уколоть иголкой"
                    ],
                    "target_lang_definitions": {
                        "en": "To pierce the skin or a surface with a small, sharp object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prick",
                                "target_lang_sense_clarification": "to pierce slightly with a sharp point"
                            },
                            {
                                "target_lang_word": "stick",
                                "target_lang_sense_clarification": "informal, often used in medical contexts like giving an injection"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98cd0b10-81b4-3094-bf2d-70bc3262bbc9",
                    "sense_definition": "Обидеть, оскорбить или уязвить кого-либо резким замечанием.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он специально сказал это, чтобы <w>уколоть</w> её своим замечанием о работе.",
                            "target_lang_translations": {
                                "en": "He said that on purpose to <w>sting</w> her with his remark about her work."
                            }
                        },
                        {
                            "text": "Не стоит <w>укалывать</w> коллег по пустякам, это портит атмосферу в коллективе.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>take digs at</w> your colleagues over trifles; it ruins the office atmosphere."
                            }
                        }
                    ],
                    "synonyms": [
                        "задеть",
                        "уязвить"
                    ],
                    "common_phrases": [
                        "уколоть замечанием",
                        "уколоть словом"
                    ],
                    "target_lang_definitions": {
                        "en": "To offend, insult, or hurt someone's feelings with a sharp or biting remark."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sting",
                                "target_lang_sense_clarification": "to cause sharp emotional pain"
                            },
                            {
                                "target_lang_word": "hurt",
                                "target_lang_sense_clarification": "to cause emotional distress"
                            },
                            {
                                "target_lang_word": "dig at",
                                "target_lang_sense_clarification": "to make a critical or sarcastic remark"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}