                        ],
                        "examples": [
                            {
                                "example_id": "46c32775-a036-4aa2-8c33-da9b04e8db12",
                                "sense_id": "eea5505e-53be-3b5e-8f60-03d2ae5877e0",
                                "text": "De werkgever biedt uitstekende arbeidsvoorwaarden.",
                                "translation": "The employer offers excellent working conditions.",
                                "english": "The employer offers excellent working conditions."
                            },
                            {
                                "example_id": "7577ea11-2e51-41e4-a581-008c31e25ea2",
                                "sense_id": "eea5505e-53be-3b5e-8f60-03d2ae5877e0",
                                "text": "De werkgevers zijn verantwoordelijk voor de veiligheid van hun werknemers.",
                                "translation": "The employers are responsible for the safety of their employees.",
                                "english": "The employers are responsible for the safety of their employees."
                            },
                            {
                                "example_id": "194d4f24-2ca9-47d6-822f-52767f094ffe",
                                "sense_id": "eea5505e-53be-3b5e-8f60-03d2ae5877e0",
                                "text": "De werkgever is op zoek naar gemotiveerde medewerkers.",
                                "translation": "The employer is looking for motivated employees.",
                                "english": "The employer is looking for motivated employees."
                            }
                        ]
                    }
