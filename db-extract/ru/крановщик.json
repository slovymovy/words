                        "source_entry_id": "e3276784-0815-381f-9822-3676431b0198",
                        "source_sense_id": "e63be30f-804e-364a-ac3e-ac14c062d7db",
                        "target_lang_word": "Kranführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kranführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "550d5726-0aaa-31a1-b0b4-3d499c9aea55",
                                        "entry_id": "c65678be-f2d5-35c1-aa0f-5abeed03a0e3",
                                        "glosses": [
                                            "jemand, der beruflich einen Kran bedient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671da9cc-612f-4eac-9f18-e52109c091e7",
                                                "sense_id": "550d5726-0aaa-31a1-b0b4-3d499c9aea55",
                                                "text": "„Besonders gefordert sind Kranführer bei Einsatzorganisationen, wie bei der Feuerwehr.“"
                                            },
                                            {
                                                "example_id": "7a12aaba-8d3c-4fb7-8ed9-de856e364112",
                                                "sense_id": "550d5726-0aaa-31a1-b0b4-3d499c9aea55",
                                                "text": "„Der Kranführer (24) erlitt einen Nervenzusammenbruch und wurde ins Spital gebracht.“"
                                            },
                                            {
                                                "example_id": "e12e330b-a64a-4542-8c62-ebe390772d86",
                                                "sense_id": "550d5726-0aaa-31a1-b0b4-3d499c9aea55",
                                                "text": "„Auf der Fahrt zur Kneipe erzählte der Taxifahrer, dass sich die Kranführer morgens absprechen müssen, damit sich die Katzausleger nicht in die Quere kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f987e21a-353f-4199-94aa-623a9b0c60a2",
                        "source_entry_id": "e3276784-0815-381f-9822-3676431b0198",
                        "source_sense_id": "e63be30f-804e-364a-ac3e-ac14c062d7db",
                        "target_lang_word": "grutier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grutier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a849e4d-f684-3569-a96a-3117d367cbdd",
                                        "entry_id": "bc152a1b-5f09-3118-97fc-53e7b74196e0",
                                        "glosses": [
                                            "Ouvrier qui assemble et manœuvre une grue de chantier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebd47856-5965-4fc6-82ff-ded61b40781a",
                                                "sense_id": "1a849e4d-f684-3569-a96a-3117d367cbdd",
                                                "text": "Au début du chantier, le grutier procède au montage de la grue après avoir défini le tracé de la voie indispensable lorsque la grue devra se déplacer."
                                            },
                                            {
                                                "example_id": "7cf37156-3ea8-45af-8c75-936a704c0567",
                                                "sense_id": "1a849e4d-f684-3569-a96a-3117d367cbdd",
                                                "text": "Comme il restait immobile et silencieux, le grutier regagna sa cabine. Dès qu’il fut assis sur son siège, le moteur rugit, la petite cheminée qui montait le long de la cabine lâcha un nuage de fumée bleue, et les chenilles grincèrent tandis que le bras se levait, ouvrant sa mâchoire aux longues dents luisantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be833587-cc57-3570-823b-7cc91dce89d9",
                                        "entry_id": "bc152a1b-5f09-3118-97fc-53e7b74196e0",
                                        "glosses": [
                                            "Employé dont la charge est l’enlevage des véhicules mal garés ou délaissés, en direction de la fourrière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ad23fbe-9944-46f1-b7cf-2c7f1c552907",
                        "source_entry_id": "e3276784-0815-381f-9822-3676431b0198",
                        "source_sense_id": "e63be30f-804e-364a-ac3e-ac14c062d7db",
