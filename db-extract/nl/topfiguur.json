                "senses": [
                    {
                        "sense_id": "88b6025b-8234-38d7-ba1e-d7d4cdd36991",
                        "entry_id": "215c9023-bc9a-39a8-afaf-9951b8a21d92",
                        "glosses": [
                            "leidende persoon; heel belangrijke persoon binnen een groep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f92c24c-f37a-451e-bcdb-ffcda77200cd",
                                "sense_id": "88b6025b-8234-38d7-ba1e-d7d4cdd36991",
                                "text": "Van alle topfiguren van het Amerikaanse inlichtingenapparaat wordt de Republikein beschreven als degene met veruit de grootste loyaliteit aan Trump. Hij verdedigde Trump herhaaldelijk tegen kritiek. Naar verluidt had hij de president vooral tijdens de reguliere veiligheidsbriefings voor zich ingenomen."
                            },
                            {
                                "example_id": "aac73361-f2c5-4624-9bd7-e262e1689700",
                                "sense_id": "88b6025b-8234-38d7-ba1e-d7d4cdd36991",
                                "text": "Corbyn zelf en zijn buitenlandspecialist Keir Starner hebben bijvoorbeeld met EU-onderhandelaar Michel Barnier, de vicevoorzitter van de Europese Commissie Frans Timmermans en andere topfiguren in Brussel gesproken."
                            },
                            {
                                "example_id": "3badf6f7-9da9-4cc8-acfd-df481216a832",
                                "sense_id": "88b6025b-8234-38d7-ba1e-d7d4cdd36991",
                                "text": "Banken hebben volgens premier Rutte niet dezelfde vrijheid als andere bedrijven om de beloning van hun topfiguur vast te stellen, omdat het een soort „semi-overheidsinstellingen\" zijn. Hij zei dit naar aanleiding van de salarisverhoging van ING-topman Ralph Hamers."
                            }
                        ]
                    }
                ],
