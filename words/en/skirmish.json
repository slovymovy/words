{
    "word_family": [
        "skirmisher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                    "sense_definition": "A brief fight between small groups of soldiers, usually happening as part of a larger war.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers engaged in a brief <w>skirmish</w> near the border.",
                            "target_lang_translations": {
                                "ru": "Солдаты вступили в короткую <w>стычку</w> у границы.",
                                "de": "Die Soldaten lieferten sich ein kurzes <w>Scharmützel</w> nahe der Grenze."
                            }
                        },
                        {
                            "text": "Several guards were wounded during the <w>skirmish</w> with the enemy patrol.",
                            "target_lang_translations": {
                                "ru": "Несколько охранников были ранены во время <w>перестрелки</w> с вражеским патрулем.",
                                "de": "Mehrere Wachen wurden während des <w>Geplänkels</w> mit der feindlichen Patrouille verwundet."
                            }
                        }
                    ],
                    "synonyms": [
                        "clash",
                        "engagement",
                        "conflict",
                        "encounter"
                    ],
                    "antonyms": [
                        "truce",
                        "peace"
                    ],
                    "common_phrases": [
                        "border skirmish",
                        "brief skirmish",
                        "military skirmish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратковременный бой между небольшими группами солдат, обычно происходящий в рамках более крупной войны.",
                        "de": "Ein kurzes Gefecht zwischen kleinen Gruppen von Soldaten, das meist Teil eines größeren Krieges ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "небольшое боевое столкновение"
                            },
                            {
                                "target_lang_word": "перестрелка",
                                "target_lang_sense_clarification": "обмен выстрелами"
                            },
                            {
                                "target_lang_word": "схватка",
                                "target_lang_sense_clarification": "ожесточенное столкновение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Scharmützel",
                                "target_lang_sense_clarification": "kleines militärisches Gefecht"
                            },
                            {
                                "target_lang_word": "Geplänkel",
                                "target_lang_sense_clarification": "kleines Gefecht am Rande von Kampfhandlungen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                    "sense_definition": "A minor argument, disagreement, or short physical struggle between people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Three people were arrested after a violent <w>skirmish</w> in a bar.",
                            "target_lang_translations": {
                                "ru": "Трое человек были арестованы после жестокой <w>потасовки</w> в баре.",
                                "de": "Drei Personen wurden nach einer gewaltsamen <w>Auseinandersetzung</w> in einer Bar festgenommen."
                            }
                        },
                        {
                            "text": "The politicians had a verbal <w>skirmish</w> over the new tax policy.",
                            "target_lang_translations": {
                                "ru": "У политиков возникла словесная <w>перепалка</w> по поводу новой налоговой политики.",
                                "de": "Die Politiker lieferten sich ein <w>Wortgeplänkel</w> über die neue Steuerpolitik."
                            }
                        }
                    ],
                    "synonyms": [
                        "altercation",
                        "scuffle",
                        "tussle",
                        "dispute",
                        "argument"
                    ],
                    "antonyms": [
                        "agreement",
                        "accord"
                    ],
                    "common_phrases": [
                        "verbal skirmish",
                        "political skirmish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительный спор, разногласие или короткая потасовка между людьми.",
                        "de": "Ein kleiner Streit, eine Meinungsverschiedenheit oder eine kurze körperliche Auseinandersetzung zwischen Personen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "ссора или потасовка"
                            },
                            {
                                "target_lang_word": "перепалка",
                                "target_lang_sense_clarification": "словесная ссора"
                            },
                            {
                                "target_lang_word": "потасовка",
                                "target_lang_sense_clarification": "небольшая драка"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Auseinandersetzung",
                                "target_lang_sense_clarification": "heftiger Streit oder Konflikt"
                            },
                            {
                                "target_lang_word": "Wortgeplänkel",
                                "target_lang_sense_clarification": "wenig ernsthafte verbale Auseinandersetzung"
                            },
                            {
                                "target_lang_word": "Geplänkel",
                                "target_lang_sense_clarification": "kleines Wortgefecht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5390ec15-2f52-3d7e-942c-5f24b7cb3097",
                    "sense_definition": "A type of outdoor military-style game where players simulate combat using safe weapons like paintball guns.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We organized a weekend <w>skirmish</w> in the woods with our paintball team.",
                            "target_lang_translations": {
                                "ru": "Мы организовали <w>игровой бой</w> в лесу с нашей пейнтбольной командой.",
                                "de": "Wir organisierten mit unserem Paintball-Team ein <w>Geländespiel</w> am Wochenende im Wald."
                            }
                        },
                        {
                            "text": "Players must wear protective gear during the <w>skirmish</w> to avoid injury.",
                            "target_lang_translations": {
                                "ru": "Игроки должны носить защитное снаряжение во время <w>боя</w>, чтобы избежать травм.",
                                "de": "Die Spieler müssen während des <w>Wargames</w> Schutzausrüstung tragen, um Verletzungen zu vermeiden."
                            }
                        }
                    ],
                    "synonyms": [
                        "mock battle",
                        "wargame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность военно-спортивной игры на открытом воздухе, имитирующей боевые действия (например, пейнтбол).",
                        "de": "Eine Art militärisch angehauchtes Spiel im Freien, bei dem Kampfhandlungen mit sicheren Waffen wie Paintball-Markierern simuliert werden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игровой бой",
                                "target_lang_sense_clarification": "имитация сражения"
                            },
                            {
                                "target_lang_word": "сценарная игра",
                                "target_lang_sense_clarification": "мероприятие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Geländespiel",
                                "target_lang_sense_clarification": "taktisches Spiel im Freien"
                            },
                            {
                                "target_lang_word": "Wargame",
                                "target_lang_sense_clarification": "militärisches Simulationsspiel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                    "sense_definition": "To fight for a short time in a small group, or to engage in a minor argument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reconnaissance troops <w>skirmished</w> with the rebels for several hours.",
                            "target_lang_translations": {
                                "ru": "Разведывательные войска <w>вели перестрелку</w> с повстанцами в течение нескольких часов.",
                                "de": "Die Aufklärungstruppen <w>lieferten sich</w> mehrere Stunden lang <w>Scharmützel</w> mit den Rebellen."
                            }
                        },
                        {
                            "text": "They often <w>skirmish</w> about politics when they have too much to drink.",
                            "target_lang_translations": {
                                "ru": "Они часто <w>спорят</w> о политике, когда слишком много выпьют.",
                                "de": "Sie <w>zanken</w> sich oft über Politik, wenn sie zu viel getrunken haben."
                            }
                        }
                    ],
                    "synonyms": [
                        "clash",
                        "scuffle",
                        "fight",
                        "bicker"
                    ],
                    "common_phrases": [
                        "skirmish with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сражаться в течение короткого времени в небольшой группе или вступать в незначительный спор.",
                        "de": "Für kurze Zeit in einer kleinen Gruppe kämpfen oder in einen kleineren Streit verwickelt sein."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участвовать в стычке",
                                "target_lang_sense_clarification": "сражаться"
                            },
                            {
                                "target_lang_word": "перестреливаться",
                                "target_lang_sense_clarification": "обмениваться выстрелами"
                            },
                            {
                                "target_lang_word": "препираться",
                                "target_lang_sense_clarification": "спорить"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich ein Scharmützel liefern",
                                "target_lang_sense_clarification": "kurzzeitig kämpfen"
                            },
                            {
                                "target_lang_word": "sich zanken",
                                "target_lang_sense_clarification": "sich wegen Kleinigkeiten streiten"
                            },
                            {
                                "target_lang_word": "sich ein Wortgefecht liefern",
                                "target_lang_sense_clarification": "verbal streiten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}