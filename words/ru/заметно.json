{
    "word_family": [
        "заметный",
        "заметить",
        "заметка",
        "замечать"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fc1c9f69-52b0-3419-a9c1-b0e6aaadb195",
                    "sense_definition": "Явным, ощутимым образом; так, что это можно увидеть или заметить.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_perceptible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За последнее время он <w>заметно</w> похудел.",
                            "target_lang_translations": {
                                "en": "He has lost weight <w>noticeably</w> recently.",
                                "de": "In letzter Zeit hat er <w>merklich</w> abgenommen."
                            }
                        },
                        {
                            "text": "Качество нашей работы <w>заметно</w> улучшилось за этот год.",
                            "target_lang_translations": {
                                "en": "The quality of our work has improved <w>significantly</w> this year.",
                                "de": "Die Qualität unserer Arbeit hat sich in diesem Jahr <w>deutlich</w> verbessert."
                            }
                        }
                    ],
                    "synonyms": [
                        "явно",
                        "ощутимо",
                        "значительно",
                        "существенно"
                    ],
                    "antonyms": [
                        "незаметно"
                    ],
                    "common_phrases": [
                        "заметно лучше",
                        "заметно отличаться",
                        "заметно измениться",
                        "стало заметно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is easy to see, notice, or feel; to a significant degree.",
                        "de": "In einer Weise, die leicht zu sehen, zu bemerken oder zu spüren ist; in erheblichem Maße."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noticeably",
                                "target_lang_sense_clarification": "general sense"
                            },
                            {
                                "target_lang_word": "significantly",
                                "target_lang_sense_clarification": "regarding degree or amount"
                            },
                            {
                                "target_lang_word": "perceptibly",
                                "target_lang_sense_clarification": "formal; able to be perceived"
                            },
                            {
                                "target_lang_word": "visibly",
                                "target_lang_sense_clarification": "regarding physical appearance"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "merklich",
                                "target_lang_sense_clarification": "allgemeine Bedeutung; spürbar"
                            },
                            {
                                "target_lang_word": "deutlich",
                                "target_lang_sense_clarification": "klar erkennbar"
                            },
                            {
                                "target_lang_word": "sichtlich",
                                "target_lang_sense_clarification": "visuell wahrnehmbar"
                            },
                            {
                                "target_lang_word": "wesentlich",
                                "target_lang_sense_clarification": "in erheblichem Maße"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d7a6aa8-e2b7-36f0-b8f9-a92076a673f7",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>заметный</w>; используется для описания того, что очевидно или видно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_perceptible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По твоему лицу сразу <w>заметно</w>, что ты очень рад.",
                            "target_lang_translations": {
                                "en": "It is immediately <w>evident</w> from your face that you are very happy.",
                                "de": "An deinem Gesicht sieht man sofort, dass du dich sehr freust."
                            }
                        },
                        {
                            "text": "Это маленькое пятно на рубашке почти не <w>заметно</w>.",
                            "target_lang_translations": {
                                "en": "This small stain on the shirt is almost not <w>visible</w>.",
                                "de": "Dieser kleine Fleck auf dem Hemd ist fast nicht <w>sichtbar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "видно",
                        "очевидно",
                        "ясно",
                        "хорошо"
                    ],
                    "antonyms": [
                        "незаметно"
                    ],
                    "common_phrases": [
                        "сразу заметно",
                        "это заметно",
                        "едва заметно"
                    ],
                    "target_lang_definitions": {
                        "en": "Describes something that is obvious, clear, or able to be seen (used predicatively).",
                        "de": "Beschreibt etwas, das offensichtlich, klar oder sichtbar ist (prädikativ verwendet)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noticeable",
                                "target_lang_sense_clarification": "able to be noticed"
                            },
                            {
                                "target_lang_word": "evident",
                                "target_lang_sense_clarification": "clearly seen or understood"
                            },
                            {
                                "target_lang_word": "visible",
                                "target_lang_sense_clarification": "able to be seen by the eye"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bemerkbar",
                                "target_lang_sense_clarification": "wahrnehmbar"
                            },
                            {
                                "target_lang_word": "sichtbar",
                                "target_lang_sense_clarification": "mit den Augen zu sehen"
                            },
                            {
                                "target_lang_word": "offensichtlich",
                                "target_lang_sense_clarification": "klar auf der Hand liegend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}