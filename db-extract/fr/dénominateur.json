                                        "entry_id": "434eccc6-cad9-35b5-b928-32163b9e5546",
                                        "glosses": [
                                            "im gemeinen Bruch die Zahl (oder der algebraische Ausdruck) unter dem Bruchstrich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a3c1c8-e2a2-4a40-aad0-a554a7bdf511",
                                                "sense_id": "6fa3df1c-af8f-3d89-b6c0-8af1510538d2",
                                                "text": "Jede Bruchzahl besteht aus Zähler und Nenner."
                                            },
                                            {
                                                "example_id": "826ef7ed-9805-41cc-95e1-023d6790f629",
                                                "sense_id": "6fa3df1c-af8f-3d89-b6c0-8af1510538d2",
                                                "text": "„Man kann Brüche erweitern, indem man Zähler und Nenner mit der gleichen Zahl multipliziert – und die Bruchzahl verändert sich beim Erweitern nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
