        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b74a85b-6af9-3324-9e25-cff9f170fbe7",
                    "sense_definition": "To sing carols; especially to sing Christmas carols in a group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "christmas_music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We plan to go <w>caroling</w> around the neighborhood on Christmas Eve.",
                            "target_lang_translations": {
                                "ru": "Мы планируем пойти <w>колядовать</w> по району в канун Рождества.",
                                "zh": "我们打算在平安夜到附近挨家挨户<w>报佳音</w>。",
                                "es": "Planeamos ir a <w>cantar villancicos</w> por el vecindario en Nochebuena."
                            }
                        },
                        {
                            "text": "The children <w>caroled</w> happily outside the nursing home to cheer up the residents.",
                            "target_lang_translations": {
                                "ru": "Дети радостно <w>пели рождественские песни</w> возле дома престарелых, чтобы подбодрить постояльцев.",
                                "zh": "孩子们在养老院外开心地<w>唱圣诞颂歌</w>，想让居民们高兴起来。",
                                "es": "Los niños <w>cantaron villancicos</w> alegremente fuera de la residencia de ancianos para animar a los residentes."
                            }
                        }
                    ],
                    "synonyms": [
                        "sing",
                        "chant"
                    ],
                    "common_phrases": [
                        "go caroling",
                        "carol door to door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Петь рождественские гимны или колядки, особенно группой.",
                        "zh": "唱颂歌，尤指成群演唱圣诞颂歌。",
                        "es": "Cantar villancicos, especialmente en grupo durante la Navidad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колядовать",
                                "target_lang_sense_clarification": "ходить по домам с песнями"
                            },
                            {
                                "target_lang_word": "петь рождественские гимны",
                                "target_lang_sense_clarification": "исполнять песни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "报佳音",
                                "target_lang_sense_clarification": "尤指圣诞节时成群结队挨家挨户唱歌"
                            },
                            {
                                "target_lang_word": "唱圣诞颂歌",
                                "target_lang_sense_clarification": "一般说法"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cantar villancicos",
                                "target_lang_sense_clarification": "acción de interpretar canciones navideñas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "137f7f9f-8e29-34ff-ad51-34de7b9b4350",
                    "sense_definition": "To sing in a joyful or cheerful manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "joyful_song",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lark began to <w>carol</w> as the sun rose over the green hills.",
                            "target_lang_translations": {
                                "ru": "Жаворонок начал <w>заливаться песней</w>, когда солнце взошло над зелёными холмами.",
                                "zh": "当太阳从绿色山丘上升起时，云雀开始<w>欢唱</w>起来。",
                                "es": "La alondra comenzó a <w>gorjear</w> mientras el sol salía sobre las colinas verdes."
                            }
                        },
                        {
                            "text": "She <w>caroled</w> a happy tune while working in the garden.",
                            "target_lang_translations": {
                                "ru": "Она <w>напевала</w> весёлую мелодию, работая в саду.",
                                "zh": "她在花园里干活时轻轻<w>哼唱</w>着欢快的曲调。",
                                "es": "Ella <w>cantaba</w> una melodía alegre mientras trabajaba en el jardín."
                            }
                        }
                    ],
                    "synonyms": [
                        "warble",
                        "trill",
                        "croon"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Петь радостно или весело.",
                        "zh": "欢快地歌唱；属较旧或文学性的用法。",
                        "es": "Cantar de manera alegre o jovial."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распевать",
                                "target_lang_sense_clarification": "петь громко и весело"
                            },
                            {
                                "target_lang_word": "заливаться песней",
                                "target_lang_sense_clarification": "о птицах или людях"
                            },
                            {
                                "target_lang_word": "напевать",
                                "target_lang_sense_clarification": "тихо петь про себя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欢唱",
                                "target_lang_sense_clarification": "高兴地歌唱，较通用"
                            },
                            {
                                "target_lang_word": "哼唱",
                                "target_lang_sense_clarification": "轻声唱出，常指边做事边唱"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "gorjear",
                                "target_lang_sense_clarification": "cantar alegremente (especialmente aves)"
                            },
                            {
                                "target_lang_word": "cantar alegremente",
                                "target_lang_sense_clarification": "expresión de alegría al cantar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9d464123-be88-3fc3-9420-7f2327533629",
