                "senses": [
                    {
                        "sense_id": "8b946a8b-98fe-3c24-b89c-e9446908147d",
                        "entry_id": "4342c6d5-6e61-3ee0-b29f-0714c4399ad8",
                        "glosses": [
                            "Stelle, an der sich eine beim Nähen entstandene Linie befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48a65b78-389e-4dda-8c92-97f05e4ace76",
                                "sense_id": "8b946a8b-98fe-3c24-b89c-e9446908147d",
                                "text": "„Sollte die Beininnennaht der Hose starr sein, wie das bei stonewashed Jeans bisweilen der Fall ist, legen Sie die Jeans auf ein Holzbrett. Dann klopfen Sie mit einem Hammer solange auf die Nahtstelle, bis der Stoff nachgibt und sich wieder weich anfühlt.“"
                            },
                            {
                                "example_id": "fa266653-5e21-45e1-aacb-0dc5086ea255",
                                "sense_id": "8b946a8b-98fe-3c24-b89c-e9446908147d",
                                "text": "„Ist der Stoff an der Nahtstelle ausgefranst, schneid auch die ausgefransten Stellen ab, denn das Gewebe würde sich sonst immer weiter auflösen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2dd647f7-15af-3a0c-a43d-3276720ead0c",
                        "entry_id": "4342c6d5-6e61-3ee0-b29f-0714c4399ad8",
                        "glosses": [
                            "Stelle, an der sich eine beim Schweißen entstandene Naht befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "592c17c6-73e6-4213-812c-a434f7618b8a",
                                "sense_id": "2dd647f7-15af-3a0c-a43d-3276720ead0c",
                                "text": "„Die Stabelektrode wird in einen Elektrodenhalter eingespannt und vom Schweißer an der Nahtstelle geführt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c860a3cb-8a03-38cf-9c41-76375fb2b0d5",
                        "entry_id": "4342c6d5-6e61-3ee0-b29f-0714c4399ad8",
                        "glosses": [
                            "Stelle, an der zwei unterschiedliche Dinge, Bereiche oder Ähnliches aufeinandertreffen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "5020d914-a0b5-43bf-a4e0-e93bd488900f",
                                "sense_id": "c860a3cb-8a03-38cf-9c41-76375fb2b0d5",
                                "text": "„Besondere Bedeutung kam der Gründung eines neuen Regierungssitzes am Bosporus an der Nahtstelle zwischen Orient und Okzident zu.“"
                            },
                            {
                                "example_id": "c76f28e5-21b7-41b4-963e-ae9b0629fdef",
                                "sense_id": "c860a3cb-8a03-38cf-9c41-76375fb2b0d5",
                                "text": "„Die Bundesrepublik war die Nahtstelle zum zusammengebrochenen kommunistischen System.“"
                            },
                            {
                                "example_id": "7be813e3-6a14-4ab2-a51c-b68680b12faf",
                                "sense_id": "c860a3cb-8a03-38cf-9c41-76375fb2b0d5",
                                "text": "„An der Nahtstelle zwischen den beiden Bergen war eine wahrscheinlich ringförmige Stufe, auf der man den Berg umkreisen können mußte.“"
                            },
                            {
                                "example_id": "4032b453-6ddc-4150-8810-0c550b71d19d",
                                "sense_id": "c860a3cb-8a03-38cf-9c41-76375fb2b0d5",
                                "text": "„Zu dieser Kollision wird es mit Sicherheit an der Nahtstelle zwischen Nanotechnologie, Biotechnologie und Computertechnologie kommen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
