                "senses": [
                    {
                        "sense_id": "4c823c6b-2b3b-3341-8643-4c3619393590",
                        "entry_id": "7c1e5930-16ba-30fb-899c-43cb2814836e",
                        "glosses": [
                            "Schacht eines Brunnens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e43c92-96dc-4a45-8f9e-0600c2312b1f",
                                "sense_id": "4c823c6b-2b3b-3341-8643-4c3619393590",
                                "text": "„Inmitten des Fäulnisgeruchs und des verlorenen Winselns erkannte er lediglich das aus Ziegeln gemauerte obere Ende eines zylinderförmigen Brunnenschachtes von etwa anderthalb Metern Durchmesser ohne Leiter oder sonstige Möglichkeit zum Abstieg.“"
                            },
                            {
                                "example_id": "4aa04875-059a-4f38-b10e-c75bf8d50b82",
                                "sense_id": "4c823c6b-2b3b-3341-8643-4c3619393590",
                                "text": "„Wenn der Brunnenschacht die wasserführenden Sandsteinschichten erreicht hat, beginnt die Tunnelarbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
