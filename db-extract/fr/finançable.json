                        "glosses": [
                            "Qui peut être financé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3de0c19-6125-4f5d-bfd2-d19df85f0008",
                                "sense_id": "4457a996-33b1-3285-8cce-7f9e3491ee11",
                                "text": "Le coût (235 millions d'euros), plus de deux fois moindre que celui des trois autres projets, est finançable à 100% par la FFT."
                            }
                        ]
                    }
                ],
                "translations": [
