                        ],
                        "form": "die Geschäftstätigkeit"
                    },
                    {
                        "form_id": "c1b00e44-0403-4f31-a124-998b6cd53938",
                        "entry_id": "31688152-6974-3f53-9ad5-a5ae103dafc5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Geschäftstätigkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                        "entry_id": "31688152-6974-3f53-9ad5-a5ae103dafc5",
                        "glosses": [
                            "alle Aktivitäten eines oder mehrerer Unternehmen, die es/sie für den Erfolg tätigen, beispielsweise Leute einstellen, Anlagen kaufen, Produkte herstellen, Dienstleistungen erbringen, diese bewerben und verkaufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71df66c6-1962-4be1-a8e3-433e6e7182d5",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "IBM legt die Schwerpunkte seiner Geschäftstätigkeit künftig stärker auf den Verkauf von Servern, Software, Computerchips und Dienstleistungen."
                            },
                            {
                                "example_id": "7236c148-0110-4316-a4c2-9ceb9bbeab62",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "[…] die Maran Film GmbH [hat] zum 30. Juni ihre Geschäftstätigkeit schon eingestellt […]."
                            },
                            {
                                "example_id": "ac1b9649-767d-4201-95f5-0d0ac1ff68b3",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "Die Geschäftstätigkeit im verarbeitenden Gewerbe in Deutschland hat im März abgenommen."
                            },
                            {
                                "example_id": "20ba0dc7-4844-44e9-8567-58d7d0fbbe81",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "Die USA haben eigene Sanktionen gegen die Krim verhängt. Sie sind umfassender als die EU-Sanktionen und verbieten US-Bürgern und US-amerikanischen Unternehmen nahezu jede Geschäftstätigkeit auf der Krim."
                            },
                            {
                                "example_id": "8a413eda-bd37-4636-98d5-fe5067237a7c",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "Auch durch die Unterstützung von Micro Focus war die Geschäftstätigkeit von Suse von einem stetigen Wachstum in den letzten sieben Jahren geprägt."
                            },
                            {
                                "example_id": "ae0cff2e-93f2-4708-a72c-ca0379579f15",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "Mit Dienstleistungen rund um die Open-Source-Lösung OpenJustitia können Software-Firmen wiederum neue Geschäftstätigkeiten aufbauen."
                            },
                            {
                                "example_id": "97bda65b-038b-4439-869a-323fb68c1d1a",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "Die chinesische Regierung zwingt EU-Unternehmen geradezu, ihr Wissen nach China zu transferieren, indem sie etwa Partnerschaften mit chinesischen Unternehmen zur Voraussetzung für bestimmte Geschäftstätigkeiten im Land macht."
                            },
                            {
                                "example_id": "826bff0a-fc79-437b-b29d-461da673be4c",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "Nach HGB werden das „Ergebnis aus gewöhnlicher Geschäftstätigkeit“ und das „außerordentliche Ergebnis“ unterschieden."
                            },
                            {
                                "example_id": "8c699823-4a49-4d1f-ad8d-e6dd0b49ac80",
                                "sense_id": "bc8a2ccc-315d-3919-a92d-6bbdf742acad",
                                "text": "Ein sorgfältig handelnder Unternehmensinhaber muß sich über die für sein Geschäft einschlägigen Rechtsnormen vor Aufnahme der Geschäftstätigkeit informieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
