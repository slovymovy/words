                                "target_senses": [
                                    {
                                        "sense_id": "af7fe297-887d-326a-a266-283c1107d6d2",
                                        "entry_id": "779c20e7-55f7-327a-b171-c3e57f77d796",
                                        "glosses": [
                                            "het teloorgaan, het kwijtraken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c042bd-fca5-4d03-87b7-e666f67090ee",
                                                "sense_id": "af7fe297-887d-326a-a266-283c1107d6d2",
                                                "text": "Zijn vertrek naar Amerika is een groot verlies voor onze afdeling."
                                            },
                                            {
                                                "example_id": "85c79b2b-a137-415e-9657-db419d92ea2b",
                                                "sense_id": "af7fe297-887d-326a-a266-283c1107d6d2",
                                                "text": "Het bedrijf leed in dit kwartaal grote verliezen."
                                            },
                                            {
                                                "example_id": "02c35250-ef2b-4e28-ae24-6f14cfdef531",
                                                "sense_id": "af7fe297-887d-326a-a266-283c1107d6d2",
                                                "text": "Er is immers geen sprake van verlies, echtscheiding of overlijden en verder weten we allebei dat we elkaar na een x aantal maanden weer zullen zien."
                                            },
                                            {
                                                "example_id": "743edb6d-dca2-4f68-9e41-0ea9e1840143",
                                                "sense_id": "af7fe297-887d-326a-a266-283c1107d6d2",
                                                "text": "Die avond ontroerde Rufïna en de leeuw me op een transcendentale manier; het was een kanaal waardoor ik mijn gevoel van verlies kon leiden, kon accepteren dat ik de waarheid misschien nooit te weten zou komen, maar dat dat nu net het geheim was van kunst."
                                            },
                                            {
                                                "example_id": "83b76b22-19c8-4405-b286-78cfc6251595",
                                                "sense_id": "af7fe297-887d-326a-a266-283c1107d6d2",
                                                "text": "Wanneer ik al lopend de telefoon terug in mijn rugzak wil stoppen, struikel ik over een steen en verlies mijn evenwicht."
                                            }
                                        ]
                                    }
                                ]
                            },
