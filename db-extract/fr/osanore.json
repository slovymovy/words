                        "entry_id": "b1b1c9bb-5189-3c0c-b9f2-faa35bb64204",
                        "glosses": [
                            "Fausse dent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d76783-099f-41a8-b4ab-730a1cc6d592",
                                "sense_id": "48fcb24d-996b-369c-99d2-c4f9ef89bd6b",
                                "text": "Vous ignorez que osanore veut dire fausse dent."
                            },
                            {
                                "example_id": "dd4c10d6-df01-4b8f-9992-7a32175d1d62",
                                "sense_id": "48fcb24d-996b-369c-99d2-c4f9ef89bd6b",
                                "text": "Ainsi d’un dentiste anglais, illustre aux abords des Tuileries, à la façon des deux serruriers Huret et Fichet, pour ses disputes avec un autre faiseur d’osanores."
                            }
                        ]
                    }
