                ],
                "senses": [
                    {
                        "sense_id": "ae61a5ad-4dda-375f-b35f-da24fd3dd33b",
                        "entry_id": "1e96c7ff-fad4-395d-90a8-1fd22056503f",
                        "glosses": [
                            "предназначенный, служащий для изоляции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2ad69ed-cbb9-4e42-88d7-3ac4ef07310f",
                                "sense_id": "ae61a5ad-4dda-375f-b35f-da24fd3dd33b",
                                "text": "Я отворил дверь изоляционной комнаты, и больной устремил свой взор в коридор."
                            },
                            {
                                "example_id": "21d6bcb8-cbf9-45b2-9221-2a4b28fce8e9",
                                "sense_id": "ae61a5ad-4dda-375f-b35f-da24fd3dd33b",
                                "text": "У дверей стоял доктор Равино в халате, попыхивая папироской. ― В изоляционную камеру. Смирительную рубашку!"
                            },
                            {
                                "example_id": "8530a596-c641-4ede-bb88-2d7f92cbdf38",
                                "sense_id": "ae61a5ad-4dda-375f-b35f-da24fd3dd33b",
                                "text": "Концы сердечника загибаются, согласно чертежу, и закрепляются туго затянутой изоляционной лентой."
                            }
                        ]
                    }
