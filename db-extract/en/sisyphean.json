                        "source_entry_id": "d7cb3d42-b2d4-3f9c-9445-844bff07ecd7",
                        "source_sense_description": "incessant or incessantly recurring, but futile",
                        "target_lang_word": "sisyphéen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sisyphéen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81bddcde-bdf5-3dcc-afe2-03f0eefdb373",
                                        "entry_id": "cc1c2033-860e-387c-aff4-79f97eef4865",
                                        "glosses": [
                                            "Qualifie une action sans fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4264822a-ad4b-4c35-8f62-f39412f677e8",
                                                "sense_id": "81bddcde-bdf5-3dcc-afe2-03f0eefdb373",
                                                "text": "Toutes les tentatives (…) s'épuisent en vaines querelles tant la tâche semble sisyphéenne et les moyens trop chiches."
                                            },
                                            {
                                                "example_id": "3936faa4-3e58-44af-bcd4-3d8f405def53",
                                                "sense_id": "81bddcde-bdf5-3dcc-afe2-03f0eefdb373",
                                                "text": "Ils portent des vêtements de travail légers, de couleurs différentes selon les sections auxquelles ils appartiennent, mais uniformément blancs de plâtre car leur tâche commune est le déblaiement véritablement sisyphéen des ruines amoncelées là depuis la fin de la guerre."
                                            },
                                            {
                                                "example_id": "52332db2-738b-4292-b947-7a74f25e775e",
                                                "sense_id": "81bddcde-bdf5-3dcc-afe2-03f0eefdb373",
                                                "text": "Le consentement, récit finement ciselé, relate le trajet qui débute dans l'euphorie et se termine en un cauchemar sisyphéen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae6c50a4-3461-4a89-9b26-63c4689ee30c",
                        "source_entry_id": "d7cb3d42-b2d4-3f9c-9445-844bff07ecd7",
