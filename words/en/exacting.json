    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e6af6ac4-5d28-33d0-9666-b2567e8b74cf",
                    "sense_definition": "Making great demands and being difficult to satisfy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "demanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>exacting</w> boss expected every report to be finished perfectly before the deadline.",
                            "target_lang_translations": {
                                "de": "Der <w>anspruchsvolle</w> Chef erwartete, dass jeder Bericht vor Ablauf der Frist perfekt fertiggestellt wurde."
                            }
                        },
                        {
                            "text": "She is an <w>exacting</w> teacher who never accepts work that is less than excellent.",
                            "target_lang_translations": {
                                "de": "Sie ist eine <w>strenge</w> Lehrerin, die niemals Arbeiten akzeptiert, die weniger als exzellent sind."
                            }
                        }
                    ],
                    "synonyms": [
                        "demanding"
                    ],
                    "common_phrases": [
                        "exacting standards"
                    ],
                    "target_lang_definitions": {
                        "de": "Hohe Anforderungen stellend und schwer zufriedenzustellen; sehr streng."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anspruchsvoll",
                                "target_lang_sense_clarification": "hohe Erwartungen stellend"
                            },
                            {
                                "target_lang_word": "streng",
                                "target_lang_sense_clarification": "unerbittlich und fordernd"
                            },
                            {
                                "target_lang_word": "penibel",
                                "target_lang_sense_clarification": "übertrieben genau und schwer zu befriedigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "082866d0-5393-3df0-8216-f48edfcffc53",
                    "sense_definition": "Requiring precise accuracy, great care, or significant effort.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "demanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Restoring the old painting was an <w>exacting</w> task that took several months to complete.",
                            "target_lang_translations": {
                                "de": "Das alte Gemälde zu restaurieren war eine <w>anspruchsvolle</w> Aufgabe, die mehrere Monate in Anspruch nahm."
                            }
                        },
                        {
                            "text": "The surgeon performed the <w>exacting</w> procedure with steady hands and total concentration.",
                            "target_lang_translations": {
                                "de": "Der Chirurg führte den <w>präzisen</w> Eingriff mit ruhigen Händen und voller Konzentration durch."
                            }
                        }
                    ],
                    "synonyms": [
                        "niggly",
                        "pernickety"
                    ],
                    "common_phrases": [
                        "exacting work"
                    ],
                    "target_lang_definitions": {
                        "de": "Präzise Genauigkeit, große Sorgfalt oder erhebliche Anstrengung erfordernd."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anspruchsvoll",
                                "target_lang_sense_clarification": "viel Können oder Konzentration erfordernd"
                            },
                            {
                                "target_lang_word": "akribisch",
                                "target_lang_sense_clarification": "höchste Sorgfalt verlangend"
                            },
                            {
                                "target_lang_word": "mühsam",
                                "target_lang_sense_clarification": "anstrengend und detailreich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "304aaa58-807e-367b-a7b2-b956c3c90a66",
                    "sense_definition": "Characterized by the act of demanding or taking something by force or authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "greedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landlord was known for his <w>exacting</w> nature when collecting overdue rent payments.",
                            "target_lang_translations": {
                                "de": "Der Vermieter war für seine <w>unerbittliche</w> Art beim Eintreiben überfälliger Mietzahlungen bekannt."
                            }
                        },
                        {
                            "text": "He was described as a cold and <w>exacting</w> man who cared only about his own wealth.",
                            "target_lang_translations": {
                                "de": "Er wurde als ein kalter und <w>hartherziger</w> Mann beschrieben, dem nur sein eigener Wohlstand wichtig war."
                            }
                        }
                    ],
                    "synonyms": [
                        "acquisitive",
                        "extortionate",
                        "grasping",
                        "money-grubbing",
                        "rapacious"
                    ],
                    "target_lang_definitions": {
                        "de": "Darauf ausgerichtet, etwas mit Härte, Nachdruck oder Zwang einzufordern; erpresserisch oder unnachgiebig."
                    },
                    "translations": {
                        "de": [
