                        "target_lang_word": "Tarantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tarantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "694dff1b-40c2-3147-b908-51b91bd164a8",
                                        "entry_id": "5dfcc3cf-5168-36d5-ab96-70cc75be7aa1",
                                        "glosses": [
                                            "südeuropäische, hellbraune, auf dem Rücken schwarzgestreifte Wolfsspinne, deren Biss beim Menschen schmerzhafte Entzündungen verursachen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4568d07-911f-406b-bb53-329aaec38ca3",
                                                "sense_id": "694dff1b-40c2-3147-b908-51b91bd164a8",
                                                "text": "Taranteln wohnen in kleinen Erdhöhlen."
                                            },
                                            {
                                                "example_id": "009a5ffd-023a-4c80-bafa-615d89434d7f",
                                                "sense_id": "694dff1b-40c2-3147-b908-51b91bd164a8",
                                                "text": "Da kommt sie willig: willkommen, Tarantel!"
                                            },
                                            {
                                                "example_id": "dbbcb53d-9512-42fc-8639-535f20f5f0b3",
                                                "sense_id": "694dff1b-40c2-3147-b908-51b91bd164a8",
                                                "text": "„Die Füße eingegrabener Taranteln ragten aus dem Sand.“"
                                            },
                                            {
                                                "example_id": "89a7b90e-b909-4b76-a514-6f1bb823f499",
                                                "sense_id": "694dff1b-40c2-3147-b908-51b91bd164a8",
                                                "text": "„Die Priester, meine Reisegefährten, lachten, als ich ihnen meine Angst vor Taranteln und Schlangen gestand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89811990-c28d-463d-b252-a4d3681f60dc",
                        "source_entry_id": "a7e83a5a-a180-311b-bb0a-bf88ccfdcd12",
                        "source_sense_id": "c52150a2-6954-3a83-ae01-3dc79335d3c7",
