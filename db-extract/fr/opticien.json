                "senses": [
                    {
                        "sense_id": "2b080de4-d50c-31fd-bcb7-70635067b634",
                        "entry_id": "8bd8fc8b-402c-38a0-89b3-c57555babb29",
                        "glosses": [
                            "Personne qui fabrique ou qui vend des instruments d’optique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47554a70-d4e8-402b-ab6b-c472bafb9476",
                                "sense_id": "2b080de4-d50c-31fd-bcb7-70635067b634",
                                "text": "L’opticien demeure un professionnel guidant le client et le conseillant."
                            },
                            {
                                "example_id": "48cf68b2-b70e-432f-8413-c949c3675f0c",
                                "sense_id": "2b080de4-d50c-31fd-bcb7-70635067b634",
                                "text": "Les opticiens se sont acharnés pendant plus de 60 ans à corriger ces multiples aberrations avec plus ou moins de bonheur ; mais c'est seulement vers 1890, époque où apparurent les premiers anastigmats, qu'ils purent présenter une solution satisfaisante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3768aa2-263b-47cb-a70d-3a69c2937281",
                        "source_entry_id": "8bd8fc8b-402c-38a0-89b3-c57555babb29",
                        "source_sense_id": "2b080de4-d50c-31fd-bcb7-70635067b634",
                        "target_lang_word": "Optiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Optiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0406b80b-d88a-3099-9029-d4a3cb906cc7",
                                        "entry_id": "9b705268-fa8c-356b-b2c9-54c79afaafd5",
                                        "glosses": [
                                            "Handwerker, der optische Geräte herstellt, repariert und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55052b4-ab28-438e-b9ee-b3b0d7d731b5",
                                                "sense_id": "0406b80b-d88a-3099-9029-d4a3cb906cc7",
                                                "text": "„Der englische Optiker Edward Scarlett baute 1727 die erste Brillenfassung, deren Bügel über den Ohren verliefen.“"
                                            },
                                            {
                                                "example_id": "1db7e1b0-577a-403e-acbb-b46dc6fb5765",
                                                "sense_id": "0406b80b-d88a-3099-9029-d4a3cb906cc7",
                                                "text": "„Der Sohn des Optikers brauchte geraume Zeit, um den großen Schuttwall zu überwinden, und ebenso lange, um die kleine Treppe zum Souterrain zu bewältigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3ac3a7d-38bb-3248-b1ba-ab1cbcebdbde",
                                        "entry_id": "9b705268-fa8c-356b-b2c9-54c79afaafd5",
                                        "glosses": [
