                    {
                        "translation_id": "720dc736-70c4-4e8a-b0f4-6f23d8e1db31",
                        "source_entry_id": "6fafb8f8-db10-308a-8f8c-bd69cab743ae",
                        "source_sense_id": "d44030a8-1673-372d-a527-cb69b42a725d",
