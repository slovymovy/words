                ],
                "senses": [
                    {
                        "sense_id": "9037ab11-4f36-3b93-9e10-7ded42b89ecc",
                        "entry_id": "1afa03e2-1e35-3db2-ae6f-59ac31bfc4e7",
                        "glosses": [
                            "Rendre hystérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2886a302-6fd7-482e-89c8-c78c7793a4c2",
                                "sense_id": "9037ab11-4f36-3b93-9e10-7ded42b89ecc",
                                "text": "Le risque est grand de susciter chez les « lecteurs » du blog une attente de « gags » et d’« hystériciser » la pensée…"
                            },
                            {
                                "example_id": "bc1d2814-a0ed-4aae-9df0-db14237628f5",
                                "sense_id": "9037ab11-4f36-3b93-9e10-7ded42b89ecc",
                                "text": "L’un des rares à l’UMP à avoir compris les enjeux populaires de ce débat que le Président de la République a contribué grandement à hystériciser, c’est Henri Guaino."
                            },
                            {
                                "example_id": "f9a741dc-5441-4aa9-a930-b4795264e94e",
                                "sense_id": "9037ab11-4f36-3b93-9e10-7ded42b89ecc",
                                "text": "L’auteur va montrer, à partir d’un exemple clinique de spasme du sanglot survenu au deuxième jour de la vie, comment le symptôme « s’hystéricise » progressivement, à travers son utilisation répétitive par le bébé dans les situations déplaisantes de frustration ou de douleur, avec une fréquence et une intensité variables en fonction des réactions plus ou moins angoissées de l’entourage."
                            }
                        ]
                    }
                ],
