                                                "example_id": "3275e3c4-0c0b-4f71-86e8-e2ed474c7ef6",
                                                "sense_id": "025d5ccb-5d93-3104-80fa-1dc275819e8a",
                                                "text": "„Gegen Ende der Lehrzeit bekam ich einen Spind im Garderobenraum der Bühnentechniker des Großen Hauses.“"
                                            },
                                            {
                                                "example_id": "6ed3de3d-ee29-4fb6-9e6f-9dd12ed5b7f8",
                                                "sense_id": "025d5ccb-5d93-3104-80fa-1dc275819e8a",
                                                "text": "„Rechts führt ein Gang zu den Umkleidekabinen und Spinden für die Kleidung.“"
                                            },
                                            {
                                                "example_id": "2e749485-d292-4a81-8f0d-c8b3a224fa11",
                                                "sense_id": "025d5ccb-5d93-3104-80fa-1dc275819e8a",
                                                "text": "„Ich nahm die Tasche aus dem Spind, die mir Sophie mitgebracht hatte, und zog mir meine eigenen Sachen an.“"
                                            }
