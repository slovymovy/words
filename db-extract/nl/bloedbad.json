                ],
                "senses": [
                    {
                        "sense_id": "86811f75-63b8-32d1-b22a-a3037dac2abd",
                        "entry_id": "e79852b6-361a-3119-952e-9380c9688981",
                        "glosses": [
                            "een gebeurtenis waarbij op grote schaal bloed vergoten wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023caf30-d323-40eb-8564-7748082c2751",
                                "sense_id": "86811f75-63b8-32d1-b22a-a3037dac2abd",
                                "text": "In feite is dit misschien een pervers gevolg van de aankondiging van de wapenstilstand. Ze hadden zo veel te verduren gehad dat ze bij de gedachte dat de oorlog zo zou eindigen, met zo veel maten dood en zo veel vijanden in leven, bijna niet konden wachten om een bloedbad aan te richten en er eens en voor al een eind aan te maken. Ze zouden iedereen afslachten."
                            },
                            {
                                "example_id": "9555ba05-3808-447e-b97f-8f29ce7e69ca",
                                "sense_id": "86811f75-63b8-32d1-b22a-a3037dac2abd",
                                "text": "Zorgen blijven er vooral over de zogenoemde fan zones. Alle speelsteden hebben zo’n officieel terrein waar liefhebbers gratis op een groot scherm wedstrijden kunnen volgen. In Parijs, op de Champ-de-Mars, is plek voor 100.000 man. „Daarmee geef je terroristen een mogelijkheid om een bloedbad aan te richten”, zei voormalig politiechef Frédéric Péchenard (tegenwoordig oppositiepoliticus) onlangs. Hij vindt het onverantwoord."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fd9e9f7-3cc6-32bc-a292-37c6279ecce3",
                        "entry_id": "e79852b6-361a-3119-952e-9380c9688981",
                        "glosses": [
                            "in figuurlijke zin een gebeurtenis waar veel 'slachtoffers' bij vallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6deed6-1cde-4233-bb61-885ef5cc6680",
                                "sense_id": "8fd9e9f7-3cc6-32bc-a292-37c6279ecce3",
                                "text": "Het examen was een groot bloedbad."
                            },
                            {
                                "example_id": "601fbbae-284b-4aca-b3b5-e6783c624818",
                                "sense_id": "8fd9e9f7-3cc6-32bc-a292-37c6279ecce3",
                                "text": "Je moet als filmmaker stevig in je schoenen staan. Zondag kregen de makers van Hands of Stone, een boksdrama met Robert de Niro, de bibbers en besloten geen pers toe te laten bij de galavoorstelling. Na de eerste, afwijzende reacties vreesde men een bloedbad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bbc1028-a34f-45e7-af35-558041254941",
                        "source_entry_id": "e79852b6-361a-3119-952e-9380c9688981",
                        "source_sense_id": "86811f75-63b8-32d1-b22a-a3037dac2abd",
                        "source_sense_description": "een gebeurtenis waarbij op grote schaal bloed vergoten wordt",
                        "target_lang_word": "Massenmord",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massenmord",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                        "entry_id": "e92d5db6-662e-32e0-b14f-1825d9f6efdb",
                                        "glosses": [
                                            "Mord an vielen Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af3fba07-a3c1-4e61-8f37-700518e31985",
                                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                                "text": "„In den 16 Jahren seit dem Massenmord entwickelte sich der ostafrikanische Kleinstaat zu einem der Länder Afrikas mit den höchsten wirtschaftlichen Wachstumsraten.“"
                                            },
                                            {
                                                "example_id": "416334a1-f69f-4bb6-a3ca-d544712046ef",
                                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                                "text": "„Und heute drohen Unterseeboote mit Massenmord, unsere dumme, unsere einzige Art, vom Massenmord abzuschrecken.“"
                                            },
                                            {
                                                "example_id": "0467192d-080d-4c67-9ede-3a8fada21740",
                                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                                "text": "„Zeit seines Lebens hatte Elia geglaubt, den Massenmord als einziger dieser hundertsechzig überlebt zu haben, erst spät fand er die zweite Überlebende aus seiner Familie, seine Schwester, als alte Frau in Aleppo.“"
                                            },
                                            {
                                                "example_id": "e53cbef9-6290-4301-887e-09155ecadbbb",
                                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                                "text": "„Aus Gewohnheit lese ich zuerst Berichte über den Massenmord, schneide sie aus, bewahre sie auf, unterstreiche aber vorher, ehe ich sie ablege, die Namen der geschnappten Verbrecher, ebenso die noch gesuchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eb6d28b-b01c-47db-a4af-d5925829cbae",
                        "source_entry_id": "e79852b6-361a-3119-952e-9380c9688981",
                        "source_sense_id": "86811f75-63b8-32d1-b22a-a3037dac2abd",
                        "source_sense_description": "een gebeurtenis waarbij op grote schaal bloed vergoten wordt",
                        "target_lang_word": "Massaker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massaker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                        "entry_id": "2938efed-e8fb-3644-87fa-e761059d30f7",
                                        "glosses": [
                                            "die Ermordung vieler Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28731287-d0da-48d1-82a4-dceecaa0b187",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "Frauen und Kinder waren einem Massaker zum Opfer gefallen."
                                            },
                                            {
                                                "example_id": "ae678078-1349-44fe-b865-215d0a0cc0de",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Kaiser hält es für möglich, dass Grimmelshausen 1636 vor Ort war, als kaiserliche Truppen das von Schweden gehaltene Magdeburg zurückeroberten; fünf Jahre zuvor hatten sie, angeführt von Tilly, schon einmal die Stadt gestürmt und rund 20000 Menschen getötet - eines der schlimmsten Massaker des Kriegs.“"
                                            },
                                            {
                                                "example_id": "b019709f-a768-4c48-b216-e26bf20c1407",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen - steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                                            },
                                            {
                                                "example_id": "41cd8335-e7e8-48d1-98c5-2405744cd012",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Erst nach dem Ende der Volksrepublik Polen wagen die Überlebenden, an dieses Massaker zu erinnern.“"
                                            },
                                            {
                                                "example_id": "19817c0e-9afa-48fc-9b2b-45207b5e19d3",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Irgendwann kamen wir zum Monument, dem ersten und damals einzigen Denkmal, das 35 Jahre nach dem Massaker eingeweiht worden war, am falschen Ort und am falschen Tag.“"
                                            },
                                            {
                                                "example_id": "bdfc9994-1085-453b-be59-1acf33ba4809",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "Das Massaker von Babyn Jar vor 75 Jahren wurde nach der gleichnamigen Schlucht auf dem Stadtgebiet Kiews genannt, wo im Jahr 1941 die deutsche Wehrmacht, Sicherheitspolizei und Sicherheitsdienst mehr als 33.000 Juden ermordeten. \"Babyn Jar\" war die größte einzelne Mordaktion an jüdischen Männern, Frauen und Kindern im Zweiten Weltkrieg."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe2482b0-6ba7-40d5-84ad-0d406f29725e",
                        "source_entry_id": "e79852b6-361a-3119-952e-9380c9688981",
                        "source_sense_id": "86811f75-63b8-32d1-b22a-a3037dac2abd",
