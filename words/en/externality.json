{
    "word_family": [
        "external",
        "externally",
        "externalize",
        "externalization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17f5f16a-4c2f-3f39-bb30-83e32ce01365",
                    "sense_definition": "A side effect of an economic activity that affects other parties without being reflected in the cost of the goods or services involved.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pollution is a classic example of a negative <w>externality</w> caused by industrial production."
                        },
                        {
                            "text": "Governments often use taxes to address the <w>externality</w> created by harmful business practices."
                        }
                    ],
                    "synonyms": [
                        "spillover"
                    ],
                    "common_phrases": [
                        "negative externality",
                        "positive externality"
                    ]
                },
                {
                    "sense_id": "0524719a-2784-3172-909c-f80164a93a17",
                    "sense_definition": "The quality or state of being situated outside or apart from something else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher discussed the <w>externality</w> of objects in relation to the human mind."
                        },
                        {
                            "text": "He argued that the <w>externality</w> of the physical world is independent of our perception."
                        }
                    ],
                    "synonyms": [
                        "exteriority"
                    ],
                    "antonyms": [
                        "internality"
                    ]
                },
                {
                    "sense_id": "bb669f9e-1180-3bb6-b344-9b31560e3c10",
                    "sense_definition": "Something that exists outside of a particular system or entity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system was designed to ignore any <w>externality</w> that might disrupt its internal logic."
                        },
                        {
                            "text": "We must consider every <w>externality</w> that could influence the outcome of this experiment."
                        }
                    ],
                    "synonyms": [
                        "external factor"
                    ]
                }
            ]
        }
    ]
}