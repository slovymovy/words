                                "target_senses": [
                                    {
                                        "sense_id": "9d4b7383-06ae-3c01-af84-a6af97c7cce4",
                                        "entry_id": "ccee54e4-463f-3df4-a970-b8a9dd5cd5ce",
                                        "glosses": [
                                            "Marked with a date."
