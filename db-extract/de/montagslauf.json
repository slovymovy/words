                "senses": [
                    {
                        "sense_id": "f7787d24-ffbc-374d-929e-66ff4f13a7e9",
                        "entry_id": "5deb7453-7a92-37df-8bc8-86bb90dea774",
                        "glosses": [
                            "Laufen/Joggen an einem Montag"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "11540f7e-785b-4a6a-8d49-0d799b818216",
                                "sense_id": "f7787d24-ffbc-374d-929e-66ff4f13a7e9",
                                "text": "„Der Montagslauf war dann Nummer 2 für ihn, für mich Nummer 3 hinterenander.“"
                            },
                            {
                                "example_id": "aad4f774-27df-4b7c-bdfe-e497d47d31f7",
                                "sense_id": "f7787d24-ffbc-374d-929e-66ff4f13a7e9",
                                "text": "„Mit dem Montagslauf ist mir das dann doch auch schon gelungen🙂“"
                            },
                            {
                                "example_id": "0b161ac8-94d8-47aa-932d-1ed35d2dd6ff",
                                "sense_id": "f7787d24-ffbc-374d-929e-66ff4f13a7e9",
                                "text": "„Nachdem die Woche arbeits- und veranstaltungsbedingt mit lediglich zwei Sporteinheiten (Montagslauf in Ulm und Firmenlauf in Stuttgart) trotz Feiertag über die Bühne ging, musste ich natürlich heute wieder ran.“"
                            },
                            {
                                "example_id": "d1d20735-1ed1-49a4-a464-996fb1f8cd92",
                                "sense_id": "f7787d24-ffbc-374d-929e-66ff4f13a7e9",
                                "text": "„Der Montagslauf war eben ein richtiger Montagslauf... naja, es kommen wieder andere.;)“"
                            },
                            {
                                "example_id": "ebd760c8-401c-4363-8f61-960c3edacf03",
                                "sense_id": "f7787d24-ffbc-374d-929e-66ff4f13a7e9",
                                "text": "„Da Marius bei seinem zweiten Montagslauf nach seinem Wiedereinstieg noch guter Dinge war, veränderten wir kurzentschlossen auf dem Weg zu Meyer zu Jerrendorf unseren Plan und bogen bei Am Jeipohl in Richtung Brake ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
