    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d53ab51-d269-3475-8e14-abe0205955ec",
                    "sense_definition": "Ce qui est inexplicable, inconnu ou incompréhensible pour la raison humaine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "enigme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La disparition soudaine de cet avion reste un profond <w>mystère</w> pour les enquêteurs."
                        },
                        {
                            "text": "Les scientifiques tentent toujours de percer le <w>mystère</w> des origines de l'univers."
                        }
                    ],
                    "synonyms": [
                        "énigme",
                        "inconnu"
                    ],
                    "antonyms": [
                        "évidence",
                        "certitude"
                    ],
                    "common_phrases": [
                        "percer le mystère",
                        "entouré de mystère",
                        "rester un mystère"
                    ]
                },
                {
                    "sense_id": "a597985b-602c-3904-9925-3bed117de582",
                    "sense_definition": "Chose tenue secrète ou cachée dans les affaires personnelles ou politiques.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "secret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse de parler de son passé et garde un grand <w>mystère</w> sur sa vie."
                        },
                        {
                            "text": "Cette famille a de nombreux <w>mystères</w> qu'elle ne révèle jamais aux voisins."
                        }
                    ],
                    "synonyms": [
                        "secret"
                    ],
                    "antonyms": [
                        "transparence"
                    ],
                    "common_phrases": [
                        "faire un mystère",
                        "garder le mystère"
                    ]
                },
                {
                    "sense_id": "5ff7a3d9-d8fc-3608-afbf-743be54a5b7e",
                    "sense_definition": "Comportement secret, précautions ou attitude affectée pour dissimuler quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce n'est pas la peine de faire tant de <w>mystères</w> pour une simple surprise."
                        },
                        {
                            "text": "Elle nous a annoncé la nouvelle avec beaucoup de <w>mystère</w>."
                        }
                    ],
                    "synonyms": [
                        "dissimulation"
                    ],
                    "antonyms": [
                        "franchise"
                    ],
                    "common_phrases": [
                        "faire des mystères",
                        "avec mystère"
                    ]
                },
                {
                    "sense_id": "9eb52869-fba8-31ea-b661-a44fbc74af86",
                    "sense_definition": "Vérité de foi inaccessible à la seule raison et connue uniquement par révélation divine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Trinité est considérée comme un <w>mystère</w> fondamental par les théologiens chrétiens."
                        },
                        {
                            "text": "Ce prêtre a consacré son sermon au saint <w>mystère</w> de la Nativité."
                        }
                    ],
                    "common_phrases": [
                        "mystère de la foi"
                    ]
                },
                {
                    "sense_id": "ca42097d-e001-3c50-81c3-44d0374598d4",
                    "sense_definition": "Culte secret de l'Antiquité dont les rites n'étaient révélés qu'aux seuls initiés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens d'Athènes participaient chaque année aux <w>mystères</w> d'Éleusis."
                        },
                        {
                            "text": "Le culte de Mithra comportait plusieurs <w>mystères</w> réservés à une élite."
                        }
                    ],
                    "common_phrases": [
                        "mystères d'Éleusis"
                    ]
                },
                {
                    "sense_id": "29d9b756-bbd5-3ef8-b2fc-f1dd03893d57",
                    "sense_definition": "Genre théâtral du Moyen Âge mettant en scène des sujets religieux ou bibliques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le public s'était rassemblé sur le parvis pour assister au grand <w>mystère</w> de la Passion."
                        },
                        {
                            "text": "Ce <w>mystère</w> médiéval durait plusieurs jours et mobilisait toute la ville."
                        }
                    ],
                    "common_phrases": [
                        "mystère médiéval"
                    ]
                },
                {
                    "sense_id": "3d0649ea-74b1-3236-81a4-da7ebb226f8b",
                    "sense_definition": "Chacun des épisodes de la vie du Christ ou de la Vierge médités lors de la prière du rosaire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles ont récité une dizaine en méditant sur le premier <w>mystère</w> douloureux."
                        },
                        {
                            "text": "Chaque <w>mystère</w> du rosaire invite à contempler un événement sacré."
                        }
                    ],
                    "common_phrases": [
                        "mystères joyeux",
                        "mystères douloureux",
                        "mystères glorieux"
                    ]
