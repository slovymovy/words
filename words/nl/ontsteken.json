                },
                {
                    "sense_id": "ffa74050-2a8e-3b63-bf98-8769f69f8127",
                    "sense_definition": "plotseling heel erg boos worden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij de leugen hoorde, deed dat hem in woede <w>ontsteken</w>.",
                            "target_lang_translations": {
                                "en": "When he heard the lie, it made him <w>fly into</w> a rage."
                            }
                        },
                        {
                            "text": "Zij kan soms plotseling in hevige toorn <w>ontsteken</w> als iets niet lukt.",
                            "target_lang_translations": {
                                "en": "She can sometimes suddenly <w>flare up</w> in intense anger if something doesn't work out."
                            }
                        }
                    ],
                    "synonyms": [
