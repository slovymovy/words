                        "glosses": [
                            "Käse, der aus Kuhmilch hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4fb3269-abe4-4cc0-a994-190cc2184817",
                                "sense_id": "1bdb7449-dba6-36a2-8cb8-9e555cc25e30",
                                "text": "Montcerda ist ein Kuhmilchkäse der Pyrenäen."
                            },
                            {
                                "example_id": "ea2fbb98-ced6-43f3-ac7a-794e52a19250",
                                "sense_id": "1bdb7449-dba6-36a2-8cb8-9e555cc25e30",
                                "text": "„Zu dem Kuhmilchkäse zählt z.B. der milde Tetilla, der eher buttrig und elastisch ist, sowie der Mahon Balearenkäse, der sehr würzig und aromatisch schmeckt.“"
                            },
                            {
                                "example_id": "80a3345e-376e-4028-9410-68dc0a5547b4",
                                "sense_id": "1bdb7449-dba6-36a2-8cb8-9e555cc25e30",
                                "text": "„Taboulé, mtabal (Auberginenpüree mit Sesam und Zitrone) und labni (Kuhmilchkäse) sind köstliche Vorspeisen …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
