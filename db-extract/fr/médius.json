                "forms": [],
                "senses": [
                    {
                        "sense_id": "503c570e-7ab4-37ae-8501-b0bed96f0efc",
                        "entry_id": "505c4b37-4659-3958-99fb-8ea335526842",
                        "glosses": [
                            "Doigt du milieu de la main."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b1f283f-4c30-4718-aeb2-953906b13ba3",
                                "sense_id": "503c570e-7ab4-37ae-8501-b0bed96f0efc",
                                "text": "Le médius est le plus long des cinq doigts."
                            },
                            {
                                "example_id": "8a3c8d29-5d8a-4604-8aee-045da96dcc6c",
                                "sense_id": "503c570e-7ab4-37ae-8501-b0bed96f0efc",
                                "text": "Une statue d’abbé est appuyée contre le mur : un gros anneau au médius de la main droite."
                            },
                            {
                                "example_id": "a4384021-b0ad-4d71-9824-31b2e15008d4",
                                "sense_id": "503c570e-7ab4-37ae-8501-b0bed96f0efc",
                                "text": "Et Geo, reposant son verre, faisait signe au sommelier, l’index et le médius levés, pour demander une autre fine."
                            },
                            {
                                "example_id": "d282e481-95ea-455b-b54d-99b0d73934ef",
                                "sense_id": "503c570e-7ab4-37ae-8501-b0bed96f0efc",
                                "text": "Le médius gauche pendait, rattaché seulement par quelques filaments de chair à la première phalange."
                            }
                        ]
                    }
                ],
