                                    {
                                        "sense_id": "7f5805e2-90e4-3445-98d8-0f4dfcf4dc84",
                                        "entry_id": "dd8c06b8-a89b-34b6-bb94-ad7a00fa5233",
                                        "glosses": [
                                            "erdgebunden, zu dieser Welt gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7c12ed-5893-4488-b119-8578392e7e90",
                                                "sense_id": "7f5805e2-90e4-3445-98d8-0f4dfcf4dc84",
                                                "text": "Der Pharao soll sein irdisches Leben auch im Jenseits weiterleben können."
                                            },
                                            {
                                                "example_id": "65a2476b-64e5-4078-bc49-578fc81bb0d8",
                                                "sense_id": "7f5805e2-90e4-3445-98d8-0f4dfcf4dc84",
                                                "text": "„Insbesondere die Vorsehung eines Mediums zwischen Allah und dem Gläubigen im Sufismus hat eine umfangreiche Dichtung hervorgebracht, in der die Liebe zu Gott thematisiert wird, die von den jeweiligen Anhängern aber auch als irdische Liebe interpretiert werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c780484e-384a-3860-87d3-2694d1b8f042",
                                        "entry_id": "dd8c06b8-a89b-34b6-bb94-ad7a00fa5233",
                                        "glosses": [
                                            "zur Erde gehörig, auf der Erde befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eba75bd-a95a-4017-8488-bbd98209d146",
                                                "sense_id": "c780484e-384a-3860-87d3-2694d1b8f042",
                                                "text": "„Möglicherweise haben die Seleniten längst die Fahne auf ihren Polen aufgepflanzt, während die irdischen Polfahrten der Franklin, Ross, Kane, Dumont d'Urville und Lambert allesamt kläglich scheiterten.“"
                                            },
                                            {
                                                "example_id": "4ae8f086-bb3a-4766-bef6-59d0761c78a9",
                                                "sense_id": "c780484e-384a-3860-87d3-2694d1b8f042",
                                                "text": "„Jacobsen zieht daraus den Schluss, dass der irdische Wasserkreislauf bis tief in den Mantel reicht und dass der Wasservorrat der Erde insgesamt deutlich größer ist als bisher gedacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
