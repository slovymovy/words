                "senses": [
                    {
                        "sense_id": "0586cdf3-33fc-3463-8bd5-3dbc7cc4884d",
                        "entry_id": "aab7a238-7bd7-30e1-94fd-66ab9a513359",
                        "glosses": [
                            "Any of several grape varieties grown in Europe and North America."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "31977f7c-a750-44b5-adf9-221ea5184471",
                                "sense_id": "0586cdf3-33fc-3463-8bd5-3dbc7cc4884d",
                                "text": "You see, the reason that this region is so good for pinot, is that the cold air off the Pacific flows in at night and it just cools down the berries. Pinot's a very thin-skinned grape. It doesn't like constant heat or humidity. Very delicate."
                            },
                            {
                                "example_id": "3e1dcf83-4859-45eb-b65c-1257a07b8183",
                                "sense_id": "0586cdf3-33fc-3463-8bd5-3dbc7cc4884d",
                                "text": "“Grant, today you're going to crush the pinot grapes in the fermenters outside.” I clapped my hands together, excited to be really making wine and said, “Okay… show me what I have to do.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "8edcdf68-7650-394e-9382-8aa7c21b8bf9",
                        "entry_id": "aab7a238-7bd7-30e1-94fd-66ab9a513359",
                        "glosses": [
                            "Any of several wines made from these grapes, in particular pinot noir."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e9fede8b-aeb9-41ae-994a-aefa60f12869",
                                "sense_id": "8edcdf68-7650-394e-9382-8aa7c21b8bf9",
                                "text": "How much funkiness makes a pinot taste desirably complex, and how much more really is too much? Is a pinot good if it does not taste more like fruit than stones?"
                            },
                            {
                                "example_id": "9cf4d4b7-a055-4df5-8777-8a53bdc6c50a",
                                "sense_id": "8edcdf68-7650-394e-9382-8aa7c21b8bf9",
                                "text": "Most good pinot noir is not cheap, so it’s worth looking out for special offers, especially on New Zealand pinots, which are more widely stocked by supermarkets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2432fdb-6497-4b90-a1cb-b189c560835d",
                        "source_entry_id": "aab7a238-7bd7-30e1-94fd-66ab9a513359",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Burgunder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Burgunder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61064a91-0208-383f-9962-f9fd55c340d8",
                                        "entry_id": "a7343d1b-37d7-3af8-9793-271419bf7024",
                                        "glosses": [
                                            "Vertreter eines ostgermanischer Volksstammes; dieser wurde im 2. bis 4. Jahrhundert in der Lausitz und im östlichen Brandenburg nachgewiesen, im 4. Jahrhundert nach Mainfranken umgesiedelt und nach Auseinandersetzungen mit den Alemannen ins Rhonegebiet umgesiedelt"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe76c659-5289-478f-8b14-ae4b74154c05",
                                                "sense_id": "61064a91-0208-383f-9962-f9fd55c340d8",
                                                "text": "„Als die Burgunder unter Gundahar nach Westen ausgriffen, wurden sie 436 vom weströmischen Feldherrn Aetius und verbündeten Hunnen geschlagen […] und ins Rhônegebiet umgesiedelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0271eda3-40f6-3fb8-a345-e5ed6820dfbf",
                                        "entry_id": "a7343d1b-37d7-3af8-9793-271419bf7024",
                                        "glosses": [
                                            "Wein aus der Weinbauregion Burgund oder Bourgogne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b5b15d-c549-4761-9d2b-8650c24e3511",
                                                "sense_id": "0271eda3-40f6-3fb8-a345-e5ed6820dfbf",
                                                "text": "„[…] Die Phantasie trinkt mit: Die floralen Aromen im Burgunder – das ist wie ein Gartenspaziergang im Frühling wenn alles blüht und duftet, aber nichts wirklich dominant ist.“"
                                            },
                                            {
                                                "example_id": "1515f75b-601a-4592-8830-2fe0a1c8a3aa",
                                                "sense_id": "0271eda3-40f6-3fb8-a345-e5ed6820dfbf",
                                                "text": "„[…] Denn die Verbraucher – auch gerade die in Übersee – haben genug von der „simplen Allerweltsbotschaft“ des Chardonnay; sie wünschen sich intellektuellere Weine wie Riesling und Burgunder.“"
                                            },
                                            {
                                                "example_id": "089e9b73-8bb7-4005-a9c9-9f1d018deeba",
                                                "sense_id": "0271eda3-40f6-3fb8-a345-e5ed6820dfbf",
                                                "text": "„Zum Lendenbraten wurde Burgunder gereicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dd9a57f0-962d-396a-a0c4-8f3684ba5463",
                                        "entry_id": "a7343d1b-37d7-3af8-9793-271419bf7024",
                                        "glosses": [
                                            "Wein aus Burgunder Rebsorten wie der Graue oder Weiße Burgunder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dccf69f-7105-4830-8fc5-30abb15dd511",
                                                "sense_id": "dd9a57f0-962d-396a-a0c4-8f3684ba5463",
                                                "text": "Der Samtrot ist der schwäbische Vertreter unter den Burgundern."
                                            },
                                            {
                                                "example_id": "b917ba78-0750-4641-b4da-2f8b7429c661",
                                                "sense_id": "dd9a57f0-962d-396a-a0c4-8f3684ba5463",
                                                "text": "„Sophie biß sich auf die Lippen, als sie merkte, daß sie beim Füllen meines Glases ein wenig Burgunder vergossen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
