                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "7396dcb9-e03c-4485-91af-e3e742f4f7b0",
                                "sense_id": "f7a9b5b6-efb0-3d8d-bb84-6ee7b509c0bf",
                                "text": "Elle s’ennuyait dans la coiffure, alors on lui propose une formation de soudeuse."
                            },
                            {
                                "example_id": "c467a529-6b86-4a51-8623-2105462a0101",
                                "sense_id": "f7a9b5b6-efb0-3d8d-bb84-6ee7b509c0bf",
                                "text": "Soudeuses, sertisseuses, agrafeuses, apprenties… petites mains, manœuvres sont demandées."
                            },
                            {
                                "example_id": "9365a085-aaa7-4915-80fb-943f01737518",
                                "sense_id": "f7a9b5b6-efb0-3d8d-bb84-6ee7b509c0bf",
                                "text": "À 28 ans, Wendy Olivré travaille comme soudeuse aux Chantiers de l’Atlantique à Saint-Nazaire (Loire-Atlantique)."
                            }
                        ]
                    },
                    {
                        "sense_id": "161c2d12-d19d-377b-9c5d-0d4e714d1baf",
                        "entry_id": "4e594022-012a-3d8f-95f0-6554bffb2ceb",
                        "glosses": [
                            "Machine à souder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4438dc0d-a44b-4cd2-b3ab-a2f8747c5366",
                                "sense_id": "161c2d12-d19d-377b-9c5d-0d4e714d1baf",
                                "text": "Dotée de 6 modes de fonctionnement, cette soudeuse est capable de conserver n’importe quel aliment comme la viande, le bœuf, le saumon, les fruits, les légumes, les snacks et le vin (vous avez bien lu) !"
                            }
                        ]
                    }
