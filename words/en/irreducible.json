{
    "word_family": [
        "reduce",
        "reducible",
        "reduction",
        "reducibility",
        "irreducibility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "294b6e90-6ce3-3977-aa5a-db3b6fca6a84",
                    "sense_definition": "Not able to be reduced, lessened, or made smaller.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee reached an <w>irreducible</w> minimum of demands that they could not negotiate on.",
                            "target_lang_translations": {
                                "ru": "Комитет достиг <w>несократимого</w> минимума требований, по которым они не могли вести переговоры."
                            }
                        },
                        {
                            "text": "Despite all budget cuts, there remains an <w>irreducible</w> core of essential expenses.",
                            "target_lang_translations": {
                                "ru": "Несмотря на все сокращения бюджета, остается <w>неуменьшаемое</w> ядро основных расходов."
                            }
                        }
                    ],
                    "synonyms": [
                        "unreducible"
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "common_phrases": [
                        "irreducible minimum",
                        "irreducible core"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подлежащий сокращению, уменьшению или минимизации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несократимый",
                                "target_lang_sense_clarification": "о минимуме, расходах, требованиях"
                            },
                            {
                                "target_lang_word": "неуменьшаемый",
                                "target_lang_sense_clarification": "о величине, объеме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80eeede4-c727-31ef-8f5e-5fa817a44e92",
                    "sense_definition": "Not able to be brought to a simpler, more basic, or alternative form.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex philosophical argument was <w>irreducible</w> to a simple slogan.",
                            "target_lang_translations": {
                                "ru": "Сложный философский аргумент был <w>несводим</w> к простому лозунгу."
                            }
                        },
                        {
                            "text": "She argued that human consciousness is an <w>irreducible</w> phenomenon.",
                            "target_lang_translations": {
                                "ru": "Она утверждала, что человеческое сознание — это <w>несводимый</w> феномен."
                            }
                        }
                    ],
                    "synonyms": [
                        "indivisible",
                        "simplest"
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "common_phrases": [
                        "irreducible complexity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не поддающийся сведению к более простой, базовой или альтернативной форме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несводимый",
                                "target_lang_sense_clarification": "к более простому виду или понятию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ae86e6c-0199-3b9b-9652-38853c788ba4",
                    "sense_definition": "Unable to be factorized into polynomials of lower degree.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematical_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quadratic equation x squared plus one is <w>irreducible</w> over the field of real numbers.",
                            "target_lang_translations": {
                                "ru": "Квадратное уравнение x в квадрате плюс один является <w>неприводимым</w> над полем вещественных чисел."
                            }
                        },
                        {
                            "text": "We need to determine whether this polynomial is <w>irreducible</w> or can be factored further.",
                            "target_lang_translations": {
                                "ru": "Нам нужно определить, является ли этот многочлен <w>неприводимым</w> или его можно разложить дальше."
                            }
                        }
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "common_phrases": [
                        "irreducible polynomial"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не поддающийся разложению на многочлены меньшей степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприводимый",
                                "target_lang_sense_clarification": "о многочлене в математике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaebdae3-6826-3ae9-98f5-69c5da8ba646",
                    "sense_definition": "Describing a fraction whose numerator and denominator share no common factor greater than 1.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematical_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fraction three-fifths is in its <w>irreducible</w> form.",
                            "target_lang_translations": {
                                "ru": "Дробь три пятых находится в своей <w>несократимой</w> форме."
                            }
                        },
                        {
                            "text": "To simplify the final answer, make sure the fraction is completely <w>irreducible</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы упростить окончательный ответ, убедитесь, что дробь полностью <w>несократима</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "common_phrases": [
                        "irreducible fraction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий дробь, числитель и знаменатель которой не имеют общих делителей, кроме 1."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несократимый",
                                "target_lang_sense_clarification": "о математической дроби"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09dadd86-ea24-3810-ad61-dae7f324c9a2",
                    "sense_definition": "Unable to be factored into smaller integers; prime.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this algebraic ring, we must identify which elements are <w>irreducible</w>.",
                            "target_lang_translations": {
                                "ru": "В этом алгебраическом кольце мы должны определить, какие элементы являются <w>неприводимыми</w>."
                            }
                        },
                        {
                            "text": "Every prime number is an <w>irreducible</w> element in the ring of integers.",
                            "target_lang_translations": {
                                "ru": "Каждое простое число является <w>неприводимым</w> элементом в кольце целых чисел."
                            }
                        }
                    ],
                    "synonyms": [
                        "prime"
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "common_phrases": [
                        "irreducible element"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не поддающийся разложению на меньшие целые числа; простой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразложимый",
                                "target_lang_sense_clarification": "об элементе кольца"
                            },
                            {
                                "target_lang_word": "неприводимый",
                                "target_lang_sense_clarification": "в алгебре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d24675-8622-3fbc-8ef1-b62305066193",
                    "sense_definition": "Describing an element in an integral domain whose only divisors are units and associates.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We proved that the element is <w>irreducible</w> by analyzing its divisors in the domain.",
                            "target_lang_translations": {
                                "ru": "Мы доказали, что этот элемент является <w>неприводимым</w>, проанализировав его делители в области."
                            }
                        },
                        {
                            "text": "An <w>irreducible</w> element does not necessarily have to be prime in all rings.",
                            "target_lang_translations": {
                                "ru": "<w>Неприводимый</w> элемент не обязательно должен быть простым во всех кольцах."
                            }
                        }
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий элемент в области целостности, делителями которого являются только обратимые элементы и ассоциированные с ним элементы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприводимый",
                                "target_lang_sense_clarification": "об элементе в общей алгебре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06f7110e-8d98-3fa2-8db5-c7bb1b16795e",
                    "sense_definition": "Inexpressible as the union of two proper algebraic subvarieties.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algebraic set is <w>irreducible</w> because it cannot be decomposed into smaller closed sets.",
                            "target_lang_translations": {
                                "ru": "Алгебраическое множество является <w>неприводимым</w>, поскольку его нельзя разложить на меньшие замкнутые множества."
                            }
                        },
                        {
                            "text": "We studied the properties of an <w>irreducible</w> variety in projective space.",
                            "target_lang_translations": {
                                "ru": "Мы изучили свойства <w>неприводимого</w> многообразия в проективном пространстве."
                            }
                        }
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "common_phrases": [
                        "irreducible variety"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не выражаемый в виде объединения двух собственных алгебраических подмногообразий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприводимый",
                                "target_lang_sense_clarification": "об алгебраическом многообразии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "743e98fe-84f9-3a0d-847d-39a7ef0a94e7",
                    "sense_definition": "Not containing a sphere of codimension 1 that is not the boundary of a ball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician proved that the 3-manifold is <w>irreducible</w>.",
                            "target_lang_translations": {
                                "ru": "Математик доказал, что это трехмерное многообразие является <w>неприводимым</w>."
                            }
                        },
                        {
                            "text": "An <w>irreducible</w> manifold simplifies the topological classification process.",
                            "target_lang_translations": {
                                "ru": "<w>Неприводимое</w> многообразие упрощает процесс топологической классификации."
                            }
                        }
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "common_phrases": [
                        "irreducible manifold"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не содержащий сферы коразмерности 1, которая не является границей шара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприводимый",
                                "target_lang_sense_clarification": "о многообразии в топологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0427e543-22d2-3d04-9d41-b39cf83f430b",
                    "sense_definition": "Impossible to divide further into representations of lower dimension by means of any similarity transformation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_irreducibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character table lists all the <w>irreducible</w> representations of the finite group.",
                            "target_lang_translations": {
                                "ru": "Таблица характеров содержит список всех <w>неприводимых</w> представлений конечной группы."
                            }
                        },
                        {
                            "text": "We can decompose the group action into a direct sum of <w>irreducible</w> components.",
                            "target_lang_translations": {
                                "ru": "Мы можем разложить действие группы в прямую сумму <w>неприводимых</w> компонент."
                            }
                        }
                    ],
                    "antonyms": [
                        "reducible"
                    ],
                    "common_phrases": [
                        "irreducible representation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не поддающийся дальнейшему разбиению на представления меньшей размерности с помощью преобразования подобия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприводимый",
                                "target_lang_sense_clarification": "о представлении группы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48f4ca12-1688-3066-a2f8-99ede07438d5",
                    "sense_definition": "An <w>irreducible</w> polynomial, element, or entity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In advanced algebra, we often work with the set of all <w>irreducibles</w> over a field.",
                            "target_lang_translations": {
                                "ru": "В высшей алгебре мы часто работаем с множеством всех <w>неприводимых элементов</w> над полем."
                            }
                        },
                        {
                            "text": "The theorem states that any polynomial can be factored into a product of <w>irreducibles</w>.",
                            "target_lang_translations": {
                                "ru": "Теорема гласит, что любой многочлен может быть разложен в произведение <w>неприводимых многочленов</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприводимый многочлен, элемент или объект."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприводимый элемент",
                                "target_lang_sense_clarification": "в математике"
                            },
                            {
                                "target_lang_word": "несократимый элемент",
                                "target_lang_sense_clarification": "в алгебре"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}