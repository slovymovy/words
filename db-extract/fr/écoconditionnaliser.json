                        "sense_id": "da8f750b-4ff8-3aae-9d32-2918d9c5fe1f",
                        "entry_id": "634ed89c-fc7b-30af-9665-1d9e1c1baf4e",
                        "glosses": [
                            "Rendre conditionnel (sur des critères écologiques)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "808a5c36-8e65-4530-96bc-f9594dd6551d",
                                "sense_id": "da8f750b-4ff8-3aae-9d32-2918d9c5fe1f",
                                "text": "Mettre fin aux subventions nuisibles à l'environnement et écoconditionnaliser les aides est une priorité absolue."
                            },
                            {
                                "example_id": "eda5530a-f685-44b4-9c23-034b9c6d7dea",
                                "sense_id": "da8f750b-4ff8-3aae-9d32-2918d9c5fe1f",
                                "text": "Il existe ainsi une grande marge de manœuvre pour écoconditionnaliser les aides, autrement dit pour les attribuer uniquement si le bénéficiaire respecte certains principes écologiques."
                            }
                        ]
                    }
