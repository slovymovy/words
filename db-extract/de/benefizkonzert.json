                "senses": [
                    {
                        "sense_id": "1e2a634b-b691-37a6-997c-f08365513c85",
                        "entry_id": "5225e2d5-3032-361e-b8ff-047de173daa7",
                        "glosses": [
                            "Konzert, dessen Erlös zur Verbesserung der Situation von Bedürftigen oder Organisationen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41fa725-0b7a-4864-94d1-478603d56a23",
                                "sense_id": "1e2a634b-b691-37a6-997c-f08365513c85",
                                "text": "„Der britische Multimilliardär Richard Branson (Virgin Group) veranstaltet in Kolumbien ein Benefizkonzert für die notleidende Bevölkerung im benachbarten Venezuela.“"
                            },
                            {
                                "example_id": "2f8cbbae-2a07-493f-8852-8b375fdadefa",
                                "sense_id": "1e2a634b-b691-37a6-997c-f08365513c85",
                                "text": "„Am 10. Januar revanchiert sich die Künstlerin dann ihrerseits – eine schöne Geste – mit einem Benefizkonzert zugunsten der Nachwuchssängerinnen und -sänger des Internationalen Opernstudios.“"
                            }
                        ],
