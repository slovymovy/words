                {
                    "sense_id": "3b740792-68ed-3736-a856-a7bf4a72b78e",
                    "sense_definition": "z dużą prędkością, w sposób zajmujący mało czasu",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "prędkość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz musi <w>szybko</w> podejmować decyzje, aby uratować pacjenta.",
                            "target_lang_translations": {
                                "en": "A doctor must make decisions <w>quickly</w> to save the patient.",
                                "ru": "Врач должен <w>быстро</w> принимать решения, чтобы спасти пациента."
                            }
                        },
                        {
                            "text": "Musimy <w>szybko</w> biegać, żeby zdążyć na pociąg przed odjazdem.",
                            "target_lang_translations": {
                                "en": "We have to run <w>fast</w> to catch the train before it leaves.",
                                "ru": "Нам нужно <w>быстро</w> бежать, чтобы успеть на поезд до его отправления."
                            }
                        }
                    ],
                    "synonyms": [
                        "prędko",
                        "migiem"
                    ],
                    "antonyms": [
                        "powoli",
                        "wolno"
                    ],
                    "common_phrases": [
                        "szybko biegać",
                        "szybko mówić",
                        "szybko jechać"
                    ],
                    "target_lang_definitions": {
                        "en": "at high speed, in a way that takes little time",
                        "ru": "с большой скоростью, за короткий промежуток времени"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quickly",
                                "target_lang_sense_clarification": "rapidly, with speed"
                            },
                            {
                                "target_lang_word": "fast",
                                "target_lang_sense_clarification": "at high speed"
                            },
                            {
                                "target_lang_word": "rapidly",
                                "target_lang_sense_clarification": "at a high rate"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "быстро",
                                "target_lang_sense_clarification": "с большой скоростью"
                            },
                            {
                                "target_lang_word": "стремительно",
                                "target_lang_sense_clarification": "очень быстро, бурно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f813ca5d-16f5-30f4-8443-ec8564087b7e",
                    "sense_definition": "w niedługim czasie od teraz lub od konkretnego momentu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam nadzieję, że <w>szybko</w> wrócisz do zdrowia po tej chorobie.",
                            "target_lang_translations": {
                                "en": "I hope you recover <w>soon</w> after this illness.",
                                "ru": "Надеюсь, ты <w>быстро</w> поправишься после этой болезни."
                            }
                        },
                        {
                            "text": "Obiad będzie gotowy bardzo <w>szybko</w>, wystarczy tylko podgrzać zupę.",
                            "target_lang_translations": {
                                "en": "Dinner will be ready very <w>quickly</w>; you just need to heat up the soup.",
                                "ru": "Обед будет готов очень <w>быстро</w>, нужно только разогреть суп."
                            }
                        }
                    ],
                    "synonyms": [
                        "rychło",
                        "prędko"
                    ],
                    "antonyms": [
                        "powoli"
                    ],
                    "common_phrases": [
                        "szybko wrócić",
                        "bardzo szybko"
                    ],
                    "target_lang_definitions": {
                        "en": "in a short time from now or from a specific moment",
                        "ru": "через короткое время, вскоре"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soon",
                                "target_lang_sense_clarification": "in a short time"
                            },
                            {
