{
    "word_family": [
        "nepotism",
        "grandnephew"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88bdb8e3-5491-3e8b-9e72-1d6d4d554083",
                    "sense_definition": "A son of one's sibling, brother-in-law, or sister-in-law; either a son of one's brother (fraternal nephew) or a son of one's sister (sororal nephew).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family_relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>nephew</w> is coming to stay with us for the summer holidays.",
                            "target_lang_translations": {
                                "ru": "Мой <w>племянник</w> приезжает погостить к нам на летние каникулы.",
                                "zh": "我的<w>侄子</w>暑假要来我们这儿住。"
                            }
                        },
                        {
                            "text": "She bought a new toy for her favorite <w>nephew</w>.",
                            "target_lang_translations": {
                                "ru": "Она купила новую игрушку для своего любимого <w>племянника</w>.",
                                "zh": "她给最疼爱的<w>外甥</w>买了一个新玩具。"
                            }
                        }
                    ],
                    "antonyms": [
                        "niece"
                    ],
                    "common_phrases": [
                        "my nephew",
                        "favorite nephew",
                        "young nephew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сын брата или сестры",
                        "zh": "兄弟姐妹的儿子"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "племянник",
                                "target_lang_sense_clarification": "сын брата или сестры"
                            },
                            {
                                "target_lang_word": "племяш",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侄子",
                                "target_lang_sense_clarification": "兄弟的儿子"
                            },
                            {
                                "target_lang_word": "外甥",
                                "target_lang_sense_clarification": "姐妹的儿子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41c76790-9f70-3ba5-ba54-ff1c7e971838",
                    "sense_definition": "A son of one's cousin or cousin-in-law.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "family_relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older texts, he referred to his cousin's son as his <w>nephew</w>.",
                            "target_lang_translations": {
                                "ru": "В старых текстах он называл сына своего двоюродного брата <w>племянником</w>.",
                                "zh": "在古籍中，他把堂兄弟的儿子称为<w>堂侄</w>。"
                            }
                        },
                        {
                            "text": "The historical document lists the king's <w>nephew</w>, though he was actually a cousin's child.",
                            "target_lang_translations": {
                                "ru": "В историческом документе упоминается <w>племянник</w> короля, хотя на самом деле это был ребенок двоюродного брата.",
                                "zh": "这份历史文件记录了国王的<w>侄子</w>，尽管他实际上是国王堂兄弟的孩子。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "general usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сын двоюродного брата или сестры",
                        "zh": "堂兄弟姐妹或表兄弟姐妹的儿子"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двоюродный племянник",
                                "target_lang_sense_clarification": "сын кузена или кузины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堂侄",
                                "target_lang_sense_clarification": "堂兄弟的儿子"
                            },
                            {
                                "target_lang_word": "表侄",
                                "target_lang_sense_clarification": "表兄弟姐妹的儿子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0a34824-b554-3404-841c-cbf9de23d7a8",
                    "sense_definition": "A son of one's child.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "family_relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient poem describes a grandfather blessing his <w>nephew</w>.",
                            "target_lang_translations": {
                                "ru": "Древняя поэма описывает деда, благословляющего своего <w>внука</w>.",
                                "zh": "这首古诗描述了一位祖父在祝福他的<w>孙子</w>。"
                            }
                        },
                        {
                            "text": "Language has changed, and we no longer call a grandson a <w>nephew</w>.",
                            "target_lang_translations": {
                                "ru": "Язык изменился, и мы больше не называем внука <w>племянником</w>.",
                                "zh": "语言已经变了，我们不再把孙子称为<w>侄子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grandson"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "meaning grandson"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сын собственного ребенка (устаревшее значение)",
                        "zh": "子女的儿子（古语）"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внук",
                                "target_lang_sense_clarification": "устаревшее значение слова nephew"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孙子",
                                "target_lang_sense_clarification": "古语中指代孙子"
                            }
                        ]
                    }
                }
            ]
        },
        {
