                                "sense_id": "42cc9e08-94fa-32fe-8d2f-27c8eab0d4d0",
                                "text": "Die mangelnde Mitarbeit der Schüler kann für den Lehrer zum Problem werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
