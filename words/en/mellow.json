{
    "word_family": [
        "mellowness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "12cf0e20-55a6-37b0-b5be-0cc45039b13d",
                    "sense_definition": "Soft or tender due to being fully ripe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ripeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer picked the <w>mellow</w> peach from the tree.",
                            "target_lang_translations": {
                                "zh": "农夫从树上摘下了那颗<w>熟透的</w>桃子。",
                                "tr": "Çiftçi, ağaçtan <w>tam olgunlaşmış</w> şeftaliyi kopardı.",
                                "pl": "Rolnik zerwał z drzewa <w>dojrzałą</w> brzoskwinię.",
                                "it": "L'agricoltore colse dall'albero la pesca <w>matura</w>.",
                                "nl": "De boer plukte de <w>rijpe</w> perzik van de boom."
                            }
                        },
                        {
                            "text": "These pears are <w>mellow</w> enough to eat right now.",
                            "target_lang_translations": {
                                "zh": "这些梨子已经<w>熟透了</w>，现在就可以吃。",
                                "tr": "Bu armutlar hemen yenilebilecek kadar <w>olgun</w>.",
                                "pl": "Te gruszki są wystarczająco <w>dojrzałe</w>, by zjeść je już teraz.",
                                "it": "Queste pere sono abbastanza <w>mature</w> da poter essere mangiate subito.",
                                "nl": "Deze peren zijn <w>rijp</w> genoeg om meteen op te eten."
                            }
                        }
                    ],
                    "synonyms": [
                        "ripe",
                        "tender"
                    ],
                    "antonyms": [
                        "unripe",
                        "hard"
                    ],
                    "common_phrases": [
                        "mellow fruit"
                    ],
                    "target_lang_definitions": {
                        "zh": "指果实因完全成熟而变得柔软或鲜嫩。",
                        "tr": "Tamamen olgunlaştığı için yumuşak veya sulu, yemeye hazır (meyve vb.).",
                        "pl": "Miękki, soczysty lub dojrzały, gotowy do spożycia (o owocach).",
                        "it": "Morbido o tenero perché completamente maturo (di frutta).",
                        "nl": "Zacht of mals doordat het volkomen rijp is (van fruit)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "熟透的",
                                "target_lang_sense_clarification": "形容果实完全成熟，质地变软。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olgun",
                                "target_lang_sense_clarification": "meyveler için, yenecek kıvama gelmiş"
                            },
                            {
                                "target_lang_word": "tam olgunlaşmış",
                                "target_lang_sense_clarification": "yumuşamış ve tatlanmış meyve"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dojrzały",
                                "target_lang_sense_clarification": "o owocach w pełni wykształconych i gotowych do jedzenia"
                            },
                            {
                                "target_lang_word": "soczysty",
                                "target_lang_sense_clarification": "o miękkim i pełnym soku owocu"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "maturo",
                                "target_lang_sense_clarification": "di frutto pronto da mangiare, morbido e dolce"
                            },
                            {
                                "target_lang_word": "ben maturo",
                                "target_lang_sense_clarification": "completamente maturo al punto giusto"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "rijp",
                                "target_lang_sense_clarification": "volledig ontwikkeld en klaar om gegeten te worden"
                            },
                            {
                                "target_lang_word": "beurs",
                                "target_lang_sense_clarification": "zeer zacht geworden door overrijpheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f9d734d-3d82-3cd4-a27b-ba7f7038f7d0",
                    "sense_definition": "Pleasantly smooth, soft, or delicate in sound, color, or light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was filled with a <w>mellow</w> golden light at sunset.",
                            "target_lang_translations": {
                                "zh": "日落时分，房间里充满了<w>柔和的</w>金光。",
                                "tr": "Gün batımında oda <w>yumuşak</w> altın rengi bir ışıkla doldu.",
                                "pl": "O zachodzie słońca pokój napełnił się <w>ciepłym</w>, złotym światłem.",
                                "it": "Al tramonto la stanza si riempì di una <w>calda</w> luce dorata.",
                                "nl": "De kamer werd bij zonsondergang gevuld met een <w>zacht</w> gouden licht."
                            }
                        },
                        {
                            "text": "She enjoyed the <w>mellow</w> sound of the jazz saxophone.",
                            "target_lang_translations": {
                                "zh": "她很享受爵士萨克斯那<w>醇厚的</w>声音。",
                                "tr": "Caz saksafonunun <w>tatlı</w> sesinden keyif aldı.",
                                "pl": "Zachwycała się <w>aksamitnym</w> brzmieniem jazzowego saksofonu.",
                                "it": "Apprezzava il suono <w>morbido</w> del sassofono jazz.",
                                "nl": "Ze genoot van de <w>warme</w> klank van de jazzsaxofoon."
                            }
                        }
                    ],
                    "synonyms": [
                        "soft",
                        "subdued",
                        "rich"
                    ],
                    "antonyms": [
                        "harsh",
                        "sharp"
                    ],
                    "common_phrases": [
                        "mellow light",
                        "mellow sound"
                    ],
                    "target_lang_definitions": {
                        "zh": "指声音、颜色或光线柔和、悦耳或不刺眼。",
                        "tr": "Ses, renk veya ışık için göze veya kulağa hoş gelen, yumuşak, tatlı ve dinlendirici.",
                        "pl": "Przyjemnie łagodny, ciepły i stonowany (o dźwięku, świetle lub kolorze).",
                        "it": "Piacevolmente morbido, dolce o delicato, riferito a suoni, colori o luci.",
                        "nl": "Aangenaam zacht, warm of gedempt van klank, kleur of licht."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "柔和的",
                                "target_lang_sense_clarification": "形容光线或声音温和，不强烈。"
                            },
                            {
                                "target_lang_word": "醇厚的",
                                "target_lang_sense_clarification": "形容声音圆润、饱满。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yumuşak",
                                "target_lang_sense_clarification": "ışık veya ses için, rahatsız etmeyen"
                            },
                            {
                                "target_lang_word": "tatlı",
                                "target_lang_sense_clarification": "kulak veya göz tırmalamayan"
                            },
                            {
                                "target_lang_word": "buğulu",
                                "target_lang_sense_clarification": "özellikle ses veya ton için sıcak ve hoş"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "łagodny",
                                "target_lang_sense_clarification": "nierażący, niedrażniący zmysłów"
                            },
                            {
                                "target_lang_word": "ciepły",
                                "target_lang_sense_clarification": "o przyjemnej, miękkiej barwie światła lub tonu"
                            },
                            {
                                "target_lang_word": "aksamitny",
                                "target_lang_sense_clarification": "głęboki i miękki, zwłaszcza o dźwięku lub smaku"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "caldo",
                                "target_lang_sense_clarification": "di luce o colore accogliente e soffuso"
                            },
                            {
                                "target_lang_word": "morbido",
                                "target_lang_sense_clarification": "non stridente, delicato per gli occhi o le orecchie"
                            },
                            {
                                "target_lang_word": "suadente",
                                "target_lang_sense_clarification": "di suono o voce, piacevolmente vellutato e dolce"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zacht",
                                "target_lang_sense_clarification": "niet schel of fel; aangenaam voor de zintuigen"
                            },
                            {
                                "target_lang_word": "warm",
                                "target_lang_sense_clarification": "van licht of klank, met een aangename gloed of diepte"
                            },
                            {
                                "target_lang_word": "gedempt",
                                "target_lang_sense_clarification": "zacht en rustgevend, niet opdringerig"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e36bb982-f404-3e41-a738-ae5a6de2cbf7",
                    "sense_definition": "Calm, gentle, and wise due to age or experience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became much more <w>mellow</w> as he grew older.",
                            "target_lang_translations": {
                                "zh": "随着年龄增长，他变得<w>沉稳</w>多了。",
                                "tr": "Yaşlandıkça çok daha <w>mülayim</w> biri oldu.",
                                "pl": "Z wiekiem stał się o wiele bardziej <w>łagodny</w>.",
                                "it": "È diventato molto più <w>mite</w> invecchiando.",
                                "nl": "Hij werd veel <w>milder</w> naarmate hij ouder werd."
                            }
                        },
                        {
                            "text": "Her <w>mellow</w> personality makes her a great mentor.",
                            "target_lang_translations": {
                                "zh": "她那<w>温和的</w>性格使她成为了一位出色的导师。",
                                "tr": "<w>Sakin</w> kişiliği onu harika bir akıl hocası yapıyor.",
                                "pl": "Jej <w>zrównoważona</w> osobowość czyni z niej wspaniałą mentorkę.",
                                "it": "La sua personalità <w>pacata</w> la rende un'ottima mentore.",
                                "nl": "Haar <w>bedaarde</w> persoonlijkheid maakt haar een geweldige mentor."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "gentle",
                        "mature"
                    ],
                    "antonyms": [
                        "impetuous",
                        "harsh"
                    ],
                    "common_phrases": [
                        "mellow with age"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因年龄或阅历增长而变得沉稳、温和且睿智。",
                        "tr": "Yaş veya deneyim sayesinde sakin, hoşgörülü ve olgunlaşmış (kişi).",
                        "pl": "Spokojny, wyrozumiały i łagodny dzięki wiekowi lub nabranemu doświadczeniu.",
                        "it": "Calmo, mite e saggio grazie all'età o all'esperienza.",
                        "nl": "Rustig, mild en wijs geworden door leeftijd of levenservaring."
