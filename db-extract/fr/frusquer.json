                ],
                "senses": [
                    {
                        "sense_id": "98be6d4a-7fc6-3ae8-9747-35d1496802ae",
                        "entry_id": "d33234b2-bc55-3dfe-b6b4-a892f3d1ad34",
                        "glosses": [
                            "Habiller."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dd56f3ad-e0c1-47fe-8a4e-9a81e95f4bc4",
                                "sense_id": "98be6d4a-7fc6-3ae8-9747-35d1496802ae",
                                "text": "Mais leurs soldats étaient mal frusqués, preuve que je vendais à leurs officiers mes pantalons collection trois, des « frapouilles » dont je ne voulais plus."
                            },
                            {
                                "example_id": "cab0684f-3620-4dbb-b0a9-5f0875841d70",
                                "sense_id": "98be6d4a-7fc6-3ae8-9747-35d1496802ae",
                                "text": "Le frusquer le matin… le défrusquer le soir… et poireauter toute la nuit… J'en ai ma claque."
                            },
                            {
                                "example_id": "e3c7056d-9bea-4cd4-9f6a-4ef09806b227",
                                "sense_id": "98be6d4a-7fc6-3ae8-9747-35d1496802ae",
                                "text": "Elle est allée se frusquer, depuis tout à l’heure, s’arranger un peu la pêche, et elle est gironde tout plein, dans son petit tailleur gris sous son manteau rouge entrouvert."
                            }
                        ]
                    }
                ],
