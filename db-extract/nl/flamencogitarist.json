                        "examples": [
                            {
                                "example_id": "ef7b2ba9-9981-481f-8330-e435e80f3c30",
                                "sense_id": "b21fc08d-0208-33bf-928e-56933fc29e2a",
                                "text": "In een ziekenhuis in Montpellier is vannacht flamencogitarist Manitas de Plata op 93-jarige leeftijd overleden. Dat heeft zijn familie bekendgemaakt."
                            },
                            {
                                "example_id": "fd33082d-4ee6-4039-84cc-68214d79b78b",
                                "sense_id": "b21fc08d-0208-33bf-928e-56933fc29e2a",
                                "text": "Ze speelden in Spanje allebei met de bekende Flamencogitarist Paco de Lucia. Het bijzondere is dat ze elkaar pas onlangs weer hebben ontmoet bij Tobi's Jazzclub. Bij het hernieuwde muzikale contact zal op 21 juni het Latijns-Amerikaanse repertoire een groot deel van het programma vullen. Ook spelen gitarist Bill Arensma en bassist Michael Burger."
                            }
                        ]
