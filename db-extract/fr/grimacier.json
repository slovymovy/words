                        "entry_id": "f5528d99-b74d-30a6-ae60-5088452365d4",
                        "glosses": [
                            "Qui fait ordinairement des grimaces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f10fa9-839f-49a8-a729-e20755d53a78",
                                "sense_id": "2309d84f-8888-3ba8-9f41-602b1e46d641",
                                "text": "Cet enfant est grimacier."
                            }
                        ]
                    },
                    {
                        "sense_id": "eebf55c9-b079-3d47-9fdf-243787820db8",
                        "entry_id": "f5528d99-b74d-30a6-ae60-5088452365d4",
                        "glosses": [
                            "Qui minaude souvent."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0efedabf-1f1c-48ef-a7b3-57b600258063",
                                "sense_id": "eebf55c9-b079-3d47-9fdf-243787820db8",
                                "text": "Cette femme est fort grimacière."
                            },
                            {
                                "example_id": "d7e9e5f2-2423-47c4-ae6a-7d1754581d1d",
                                "sense_id": "eebf55c9-b079-3d47-9fdf-243787820db8",
                                "text": "Il était fasciné par cette intimité de femmes à l’état pur sans rien de grimacier, de sournois, de mondain."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac7488bf-deb9-36e6-bc9f-7bb039b7bf57",
                        "entry_id": "f5528d99-b74d-30a6-ae60-5088452365d4",
                        "glosses": [
                            "Hypocrite."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "738359fb-b72a-4740-ae86-e16f42d03a6e",
                                "sense_id": "ac7488bf-deb9-36e6-bc9f-7bb039b7bf57",
                                "text": "Il n’a qu’une dévotion grimacière."
                            }
                        ]
                    }
