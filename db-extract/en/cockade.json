    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f7fd83cc-2c9f-3f78-aa0f-0622bb065729",
                "word": "cockade",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f290fd04-8c32-4960-be18-8f48a3591726",
                        "entry_id": "f7fd83cc-2c9f-3f78-aa0f-0622bb065729",
