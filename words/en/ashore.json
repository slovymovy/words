{
    "word_family": [
        "shore",
        "shoreline"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3751bf7f-fe86-3487-9867-698e4bb0ab2d",
                    "sense_definition": "On, or towards the shore.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "towards_land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small wooden canoe sailed <w>ashore</w> after a long journey.",
                            "target_lang_translations": {
                                "ru": "Маленькое деревянное каноэ причалило <w>к берегу</w> после долгого путешествия.",
                                "zh": "经过漫长的航行，那艘小木独木舟<w>上岸</w>了。"
                            }
                        },
                        {
                            "text": "The strong waves washed the driftwood <w>ashore</w> during the storm.",
                            "target_lang_translations": {
                                "ru": "Сильные волны выбросили плавник <w>на берег</w> во время шторма.",
                                "zh": "暴风雨期间，大浪将浮木冲到了<w>岸上</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aland"
                    ],
                    "antonyms": [
                        "offshore",
                        "afloat"
                    ],
                    "common_phrases": [
                        "washed ashore",
                        "come ashore",
                        "drift ashore"
                    ],
                    "target_lang_definitions": {
                        "ru": "На берег или по направлению к берегу.",
                        "zh": "在岸上或向着岸边的方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на берег",
                                "target_lang_sense_clarification": "направление движения к суше"
                            },
                            {
                                "target_lang_word": "на берегу",
                                "target_lang_sense_clarification": "нахождение на суше у воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上岸",
                                "target_lang_sense_clarification": "指从水里或船上移动到陆地"
                            },
                            {
                                "target_lang_word": "向岸",
                                "target_lang_sense_clarification": "指朝向陆地的方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50d77fc0-4c45-393c-9b4f-058f4bb70823",
                    "sense_definition": "On the land as opposed to onboard a ship or boat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "on_land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors decided to spend their weekend <w>ashore</w> exploring the local town.",
                            "target_lang_translations": {
                                "ru": "Моряки решили провести выходные <w>на берегу</w>, исследуя местный городок.",
                                "zh": "水手们决定周末在<w>岸上</w>度过，去探索当地的小镇。"
                            }
                        },
                        {
                            "text": "After months at sea, the crew was finally allowed to go <w>ashore</w>.",
                            "target_lang_translations": {
                                "ru": "После месяцев в море экипажу наконец разрешили сойти <w>на берег</w>.",
                                "zh": "在海上漂泊数月后，船员们终于被允许<w>上岸</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aland"
                    ],
                    "antonyms": [
                        "onboard",
                        "aboard"
                    ],
                    "common_phrases": [
                        "go ashore",
                        "stay ashore"
                    ],
                    "target_lang_definitions": {
                        "ru": "На суше, в отличие от нахождения на борту корабля или лодки.",
                        "zh": "在陆地上，与在船上相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на суше",
                                "target_lang_sense_clarification": "на земле, не на корабле"
                            },
                            {
                                "target_lang_word": "на берег",
                                "target_lang_sense_clarification": "сойти с корабля на землю"
                            },
                            {
                                "target_lang_word": "на берегу",
                                "target_lang_sense_clarification": "находиться вне корабля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在岸上",
                                "target_lang_sense_clarification": "指身处陆地而非船上"
                            },
                            {
                                "target_lang_word": "上岸",
                                "target_lang_sense_clarification": "指离开船只到达陆地"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}