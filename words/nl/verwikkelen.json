                    "sense_id": "6dd1cb48-8b46-36c2-83fd-4dd7851cb2be",
                    "sense_definition": "Iemand betrekken bij een ingewikkelde of vervelende situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "betrokkenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde niemand <w>verwikkelen</w> in zijn persoonlijke problemen.",
                            "target_lang_translations": {
                                "pl": "Nie chciał nikogo <w>wplątywać</w> w swoje osobiste problemy."
                            }
                        },
                        {
                            "text": "Laat je niet <w>verwikkelen</w> in deze zinloze discussie.",
                            "target_lang_translations": {
