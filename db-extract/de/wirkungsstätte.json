                    {
                        "sense_id": "23c892d6-b506-38ca-b9d8-bd2457fd6f80",
                        "entry_id": "05f8cf99-50dc-3efd-b711-7bcd43f9bd29",
                        "glosses": [
                            "Ort, an dem jemand eine Tätigkeit ausgeübt hat"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "bd07b0a3-7b81-4021-8171-8443ac60404f",
                                "sense_id": "23c892d6-b506-38ca-b9d8-bd2457fd6f80",
                                "text": "„Man wähnte ihn in einer Mönchszelle der niederbayerischen Abtei Metten - doch in Wahrheit hält sich der suspendierte Limburger Bischof Franz-Peter Tebartz-van Elst inzwischen wieder an alter Wirkungsstätte auf, zumindest an mehreren Tagen im Monat.“"
                            },
                            {
                                "example_id": "98fcb1f2-8fd9-451a-a1f8-57d5316540c1",
                                "sense_id": "23c892d6-b506-38ca-b9d8-bd2457fd6f80",
                                "text": "„Thomas nahm an, dass Niklas ihnen seine Wirkungsstätte zeigen und einen kurzen Blick in die Arbeit seiner Zeitung geben wollte.“"
                            },
                            {
                                "example_id": "8c610963-5dd2-41d9-8763-d69396df2cc6",
                                "sense_id": "23c892d6-b506-38ca-b9d8-bd2457fd6f80",
                                "text": "„Seine neue Wirkungsstätte ähnelte in vielem dem Kaiser-Wilhelm-Institut in Berlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
