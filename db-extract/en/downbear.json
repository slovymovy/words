                "senses": [
                    {
                        "sense_id": "f6f5ebda-0e1b-343b-b508-9b1047b40b85",
                        "entry_id": "f7d0035e-d155-3f95-bc6a-310266d0bf4d",
                        "glosses": [
                            "To bear, bring or carry down."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8423f240-150e-4597-83e2-9f5eb7cf042c",
                                "sense_id": "f6f5ebda-0e1b-343b-b508-9b1047b40b85",
                                "text": "Immediately from the downborne elements sprung forth The Word of The God to the pure creation of all Nature, …"
                            }
                        ]
                    },
                    {
                        "sense_id": "ddcd9191-7570-3b67-914c-7c90aa1265ec",
                        "entry_id": "f7d0035e-d155-3f95-bc6a-310266d0bf4d",
                        "glosses": [
                            "To bear or press down (on); press upon; depress; subdue."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ac84fa2e-f806-4689-9491-eb1643ddfd5e",
                                "sense_id": "ddcd9191-7570-3b67-914c-7c90aa1265ec",
                                "text": "Further, Caulis Bambusae downbears the stomach, thus downbearing upwardly counterflowing depressive heat."
                            },
                            {
                                "example_id": "be6557cc-0e14-42da-b07a-b3fef9ccc1e3",
                                "sense_id": "ddcd9191-7570-3b67-914c-7c90aa1265ec",
                                "text": "Together, these points supplement the qi to help upbear the clear and downbear the turbid when needled with supplementing method."
                            },
                            {
                                "example_id": "c75899e6-2a47-4154-a9cd-0ff6dd2f8596",
                                "sense_id": "ddcd9191-7570-3b67-914c-7c90aa1265ec",
                                "text": "When one relaxes physically as well as mentally, whatever qi should be upborne is upborne and whatever qi should be downborne is downborne."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d91b5f6-d00a-3f61-80eb-4d5540029a05",
                        "entry_id": "f7d0035e-d155-3f95-bc6a-310266d0bf4d",
                        "glosses": [
                            "To lessen; reduce."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9147b61c-2808-4567-9711-be049f832298",
                                "sense_id": "9d91b5f6-d00a-3f61-80eb-4d5540029a05",
                                "text": "The stomach channel's uniting point, Zu San Li, is chosen in order to drain the stomach and downbear counterflow."
                            }
                        ]
                    }
