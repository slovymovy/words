                ],
                "senses": [
                    {
                        "sense_id": "a185eed8-746b-31f8-89e4-e21fa052e264",
                        "entry_id": "ff84cb87-f7fe-31a1-ba61-3f7fe7259b52",
                        "glosses": [
                            "Qui froufroute, au sens de faire un bruit de froufrou, bruisser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66cffe0b-6905-4127-8225-7ab84de01c35",
                                "sense_id": "a185eed8-746b-31f8-89e4-e21fa052e264",
                                "text": "On n’entend que le bruit de moteur rouillé captif dans la gorge du chat heureux, froufrouteur."
                            },
                            {
                                "example_id": "ca411e20-12eb-4745-bef4-0d823db9d0a0",
                                "sense_id": "a185eed8-746b-31f8-89e4-e21fa052e264",
                                "text": "Comme elle demeurait sans réaction, il franchit le rideau de perles séparant le magasin de l’appartement. Cela fit un bruit froufrouteur qui lui rappela son enfance."
                            }
                        ]
                    },
                    {
                        "sense_id": "96285e5c-6da8-32e3-8e2b-831065df56b3",
                        "entry_id": "ff84cb87-f7fe-31a1-ba61-3f7fe7259b52",
                        "glosses": [
                            "Qui porte des froufrous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de82d8bf-9188-4631-924d-ed8752875788",
                                "sense_id": "96285e5c-6da8-32e3-8e2b-831065df56b3",
                                "text": "Sachez seulement qu’il a des teintes languissantes de roses décolorées, que sa forme pincée au-dessous des genoux, s’évase vers le bas en volants froufrouteurs, et que sur son miroitement se balance le plus vert et le plus écourté des manteaux bordés de renard blanc."
                            },
                            {
                                "example_id": "7ee7b638-6702-4fdf-8e8d-5ffd3662beb7",
                                "sense_id": "96285e5c-6da8-32e3-8e2b-831065df56b3",
                                "text": "Elle portait une robe froufrouteuse, légère et courte, d’un vert pâle presque transparent, ornée de dentelles blanches et parsemée de petites étoiles brillantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e6a446d-e59e-3444-83e3-18cea60dfcb3",
                        "entry_id": "ff84cb87-f7fe-31a1-ba61-3f7fe7259b52",
                        "glosses": [
                            "Aguichant, qui étale un luxe ostentatoire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0e25e1af-81a3-4765-881d-a25952febe56",
                                "sense_id": "4e6a446d-e59e-3444-83e3-18cea60dfcb3",
                                "text": "Après quelques aventures avec de jeunes rapins de Greenwich-Village et des dames de Battery-Place, la froufrouteuse cocotte parisienne accepta les hommages plus sonnants et trébuchants d’un riche industriel d’origine allemande, Adolf Pawenstead, qui la couvrit de bijoux, de dollars et de fleurs."
                            }
                        ]
                    }
                ],
