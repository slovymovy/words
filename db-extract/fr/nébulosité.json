        "fr-extract.jsonl": [
            {
                "entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                "word": "nébulosité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "289ecba0-204d-4edb-929d-e002b7f7d570",
                        "entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                        "tags": [
                            "plural"
                        ],
                        "form": "nébulosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "615a89a6-4346-3e4c-98d1-333a49707663",
                        "entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                        "glosses": [
                            "Obscurité, nuages légers ^([1])."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4bc148b3-d1af-318d-93d0-e960c15bc96b",
                        "entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                        "glosses": [
                            "opacité, complexité,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05da4043-eb95-4b9a-ad45-7c34b05b6375",
                                "sense_id": "4bc148b3-d1af-318d-93d0-e960c15bc96b",
                                "text": "Heidegger avait parlé de la « nébulosité » de la vie en lieu et place du principe de perception claire et distincte de l’ego cogito"
                            }
                        ]
                    },
                    {
                        "sense_id": "0e2bcbc5-c36c-36a8-8418-0d9a688cb8fd",
                        "entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                        "glosses": [
                            "Halo lumineux qui entoure un astre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c73a8eb-f26c-4506-a0bf-ef7db1f4fa68",
                                "sense_id": "0e2bcbc5-c36c-36a8-8418-0d9a688cb8fd",
                                "text": "Ma chambre aussi profonde que déserte s’éclairait silencieusement des nébulosités de la lune."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dbe1650-bf09-31ef-9f17-ecef523c83c3",
                        "entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                        "glosses": [
                            "Ensemble de nuages visibles dans le ciel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f902c85-9879-47a6-9b1a-b310b8af2d2f",
                                "sense_id": "1dbe1650-bf09-31ef-9f17-ecef523c83c3",
                                "text": "La fraction de la voûte céleste occultée en un lieu et à un instant donnés par tout ou partie des nuages est une grandeur mesurable […] qui porte le nom de nébulosité. En l’absence de mention explicite, ce terme équivaut à la nébulosité totale, qui s’applique à l’ensemble des nuages présents dans le ciel au moment de l’évaluation."
                            },
                            {
                                "example_id": "e874c547-6ea7-40de-aff5-007f7d658595",
                                "sense_id": "1dbe1650-bf09-31ef-9f17-ecef523c83c3",
                                "text": "La nébulosité augmentera sensiblement lundi, et sera accompagnée d’averses."
                            },
                            {
                                "example_id": "7844ff42-0f33-4c08-a0e6-d226718c3445",
                                "sense_id": "1dbe1650-bf09-31ef-9f17-ecef523c83c3",
                                "text": "Scruter l’azur, afin d’y dégoter la moindre nébulosité : peine perdue. Dans un ciel immaculé, règne en maître un soleil implacable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "162d0a6c-d422-4b1f-8205-a9c75d999cc4",
                        "source_entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                        "target_lang_word": "nebulosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nebulosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f36b98e-c732-3d62-805b-8681c51cc7a7",
                                        "entry_id": "7a4b034a-23e1-3023-8e86-d81680104ef0",
                                        "glosses": [
                                            "The characteristic of being nebulous; cloudiness (measured in octas)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5dc8e04-ec17-4830-90e3-477ca4920f37",
                                                "sense_id": "8f36b98e-c732-3d62-805b-8681c51cc7a7",
                                                "text": "With higher powers the field does not appear to be sufficiently large to allow of each streak of nebulosity being compared with the surrounding parts where the nebulosity is not quite so bright."
                                            },
                                            {
                                                "example_id": "f804c3e8-970b-4571-947c-903d403637db",
                                                "sense_id": "8f36b98e-c732-3d62-805b-8681c51cc7a7",
                                                "text": "If one conceives by analogy all the stars formed in this manner, one can imagine their anterior state of nebulosity itself preceded by other stars in which the nebulous matter was more and more diffuse, the nucleus being less and less luminous and dense."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46bb0d01-96c3-4eab-bfd2-fdf62da821af",
                        "source_entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                        "target_lang_word": "mistiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mistiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "368dd009-0587-3bf4-b276-207bf5d8ebd6",
                                        "entry_id": "f78237b6-c069-362d-9899-1ce79d99c1cc",
                                        "glosses": [
                                            "The quality of being misty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd1a7167-7d56-42ab-a376-0ff53aab3d60",
                                                "sense_id": "368dd009-0587-3bf4-b276-207bf5d8ebd6",
                                                "text": "Her eyes feel dull, misty, as if floating in tears. Mistiness of sight. Sensation as if a veil were before the eyes, with blinking of the eyelids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a8e00b0-230e-4c7d-8c9a-a5c28b5ac91a",
                        "source_entry_id": "feaf8624-25a7-35e6-a36f-3d33c5f40a16",
                        "target_lang_word": "cloudiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloudiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d9a1197-7102-39c3-b744-e789acd709dd",
                                        "entry_id": "c5f1bb5c-d477-305c-afb8-36d98b07d3e7",
                                        "glosses": [
                                            "Of the sky, weather, etc.: the state of being cloudy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30519cbd-558e-41c5-b723-505740e0b417",
                                                "sense_id": "9d9a1197-7102-39c3-b744-e789acd709dd",
                                                "text": "Expect considerable cloudiness with occasional rain showers."
                                            },
                                            {
                                                "example_id": "d6a6ab87-f824-4a9a-9b0d-91b5342c1604",
                                                "sense_id": "9d9a1197-7102-39c3-b744-e789acd709dd",
                                                "text": "[W]hy vvhat's the matter? / That you haue ſuch a Februarie face, / So full of froſt, of ſtorme, and clovvdineſſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8cff1e9-8781-35e8-bf8e-2da0d051bb63",
                                        "entry_id": "c5f1bb5c-d477-305c-afb8-36d98b07d3e7",
                                        "glosses": [
                                            "Of a liquid: the property of being murky."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a84abc4-21a5-4cf0-a787-0847f938cdb4",
                                                "sense_id": "a8cff1e9-8781-35e8-bf8e-2da0d051bb63",
                                                "text": "Cloudiness in the water is most often caused in new aquariums by white bacteria."
                                            },
                                            {
                                                "example_id": "856f7b03-01fb-43de-859e-3ffa2fd77ba8",
                                                "sense_id": "a8cff1e9-8781-35e8-bf8e-2da0d051bb63",
                                                "text": "The cloudiness of the windows on the cars, caused by the degradation of the polycarbonate material of which they are made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c5aebc2-0322-336c-82d9-2f8af1017639",
                                        "entry_id": "c5f1bb5c-d477-305c-afb8-36d98b07d3e7",
                                        "glosses": [
                                            "Of information, a writing style, etc.: the property of being obscure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18a12635-fcac-41fa-9cea-03a7c14d441f",
                                                "sense_id": "7c5aebc2-0322-336c-82d9-2f8af1017639",
                                                "text": "Avoid cloudiness in your essay-writing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
