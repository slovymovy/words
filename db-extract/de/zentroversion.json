                ],
                "senses": [
                    {
                        "sense_id": "09e30170-f158-3719-8513-7ac5107cba4a",
                        "entry_id": "22979335-be3a-3fe5-b923-08de9a0a25d7",
                        "glosses": [
                            "Handlungsweise, Antriebskraft Entwicklung, Bewusstwerdung der eigenen Persönlichkeit, die auf das Selbst/Ich/Ego gegründet/bezogen ist"
                        ],
                        "tags": [
                            "und auch"
                        ],
                        "examples": [
                            {
                                "example_id": "c8fac582-8eb0-4065-bbaf-b1102f9a0222",
                                "sense_id": "09e30170-f158-3719-8513-7ac5107cba4a",
                                "text": "„Mit Zentroversion (lat. centro: mitten; lat. versari: sich irgendwo herumbewegen, sich aufhalten, sich beschäftigen) bezeichnet Erich Neumann die psychische Funktion der Ganzheit, Entwicklung und Selbstwerdung.“"
                            },
                            {
                                "example_id": "c40d5604-14d9-4512-b406-10f775b7dccc",
                                "sense_id": "09e30170-f158-3719-8513-7ac5107cba4a",
                                "text": "„Die Zentroversion drängt dahin, dass das Ich nicht dabei stehen bleibt, Organ des Unbewussten zu sein, sondern mehr und mehr Repräsentant der Ganzheit wird.“"
                            },
                            {
                                "example_id": "27a9e549-02b5-4740-a884-5005244721ee",
                                "sense_id": "09e30170-f158-3719-8513-7ac5107cba4a",
                                "text": "„Zentroversion ist also, im Gegensatz zu Intro- oder Extraversion die integrierende Kraft, welche das Selbst strukturiert und konstituiert.“"
                            },
                            {
                                "example_id": "8ed8e89e-e9d2-4d8a-9fef-8c7947bd79cc",
                                "sense_id": "09e30170-f158-3719-8513-7ac5107cba4a",
                                "text": "„Unter «Zentroversion» verstehen wir die psychische Funktion der Ganzheit, die dahin drängt und dazu führt, daß ein Bewußtseinszentrum gebildet wird, und daß der Ich-Komplex allmählich die Stellung dieses Bewußtseinszentrums einnimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
