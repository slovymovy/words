                ],
                "senses": [
                    {
                        "sense_id": "c8e84fa2-5646-34dd-a5a4-68cb06fea2ad",
                        "entry_id": "60af8195-1eab-33bc-9b2d-2e7017e1412d",
                        "glosses": [
                            "Farbe der Haare"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c433b564-b417-4ce0-a99f-74c8b689d1ad",
                                "sense_id": "c8e84fa2-5646-34dd-a5a4-68cb06fea2ad",
                                "text": "Er möchte seine Haarfarbe ändern."
                            },
                            {
                                "example_id": "c84f4cd5-5dd9-4217-88aa-3e839fe572b8",
                                "sense_id": "c8e84fa2-5646-34dd-a5a4-68cb06fea2ad",
                                "text": "Der Zeuge sagte aus, die Haarfarbe des Täters sei blond gewesen."
                            },
                            {
                                "example_id": "b459c7e6-0c26-4242-bc41-927604e0b104",
                                "sense_id": "c8e84fa2-5646-34dd-a5a4-68cb06fea2ad",
                                "text": "„Haarfarbe und Hautfarbe zählen zu den auffälligsten äußerlichen Merkmalen eines Menschen – vielleicht gehören diese Begriffe deshalb für die Ägypter so eng zusammen.“"
                            },
                            {
                                "example_id": "5bc47b5e-3c68-4ad8-951b-597c0625acfa",
                                "sense_id": "c8e84fa2-5646-34dd-a5a4-68cb06fea2ad",
                                "text": "„Ein sehr schönes Kind, und Ford erzählte mir, was Gesicht und Haarfarbe angehe, habe er in ihrem Alter fast genauso ausgesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eab9e02c-4f88-3ce1-98fd-1ecd69b014e3",
                        "entry_id": "60af8195-1eab-33bc-9b2d-2e7017e1412d",
                        "glosses": [
                            "Mittel zum Färben der Haare"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f608297-3451-4c6e-b146-1a239d06911c",
                                "sense_id": "eab9e02c-4f88-3ce1-98fd-1ecd69b014e3",
                                "text": "In der Drogerie kann man viele verschiedene Haarfarben zum Selberfärben kaufen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
