                        "sense_id": "dc22f62d-acd1-3e36-9dff-6c3a612e4736",
                        "entry_id": "1769624f-fdb3-3a22-aeb1-dc8f13f956bf",
                        "glosses": [
                            "Pumped up; excited."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "50277db2-0285-4b28-9a9c-ff8960b58fa7",
                                "sense_id": "dc22f62d-acd1-3e36-9dff-6c3a612e4736",
                                "text": "I'm feeling pumped for the game on Friday."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1aa7d5e-6620-3e75-9397-9e29a92c1f0c",
                        "entry_id": "1769624f-fdb3-3a22-aeb1-dc8f13f956bf",
                        "glosses": [
                            "Pumped up; having muscles in an engorged state following exercise."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5eaa7ab8-9304-3457-81df-7bfaec9cab68",
                        "entry_id": "1769624f-fdb3-3a22-aeb1-dc8f13f956bf",
                        "glosses": [
                            "Wearing pumps (the type of shoe)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6a498e96-1118-44e2-93e6-d50a644184bb",
                                "sense_id": "5eaa7ab8-9304-3457-81df-7bfaec9cab68",
                                "text": "All the young gentlemen, tightly cravatted, curled, and pumped, and with their best hats in their hands, having been at different times announced and introduced, Mr Baps, the dancing-master, came, accompanied by Mrs Baps, to whom Mrs Blimber was extremely kind and condescending."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6ba51c2-1225-3e0b-9bc0-470d7cdfb0b4",
                        "entry_id": "1769624f-fdb3-3a22-aeb1-dc8f13f956bf",
                        "glosses": [
                            "Very tired, especially when too fatigued to grip handholds well."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "928463ca-6827-4d18-9085-1424024e8b39",
                                "sense_id": "d6ba51c2-1225-3e0b-9bc0-470d7cdfb0b4",
                                "text": "I was so pumped by the end of the climb that I could barely hold onto the jugs."
                            }
                        ]
                    }
                ],
