                "translations": [
                    {
                        "translation_id": "1787152f-f5fa-44b9-a023-1a81816eeb56",
                        "source_entry_id": "2ee789b2-488b-30b8-8b40-c45a46d4b4c9",
                        "source_sense_id": "bb608edd-04f5-3e40-be3a-5e69bd6a2e7d",
                        "target_lang_word": "projector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "projector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "Someone who devises or suggests a project; a proposer or planner of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c75b1f3-653d-4099-a05f-e6928945aba6",
                                                "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                                                "text": "So far is it from the kenne of theſe wretched projectors of ours that beſcraull their Pamflets every day with new formes of government for our Church."
                                            },
                                            {
                                                "example_id": "d60094a0-4693-45c5-883a-f61be857f542",
                                                "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                                                "text": "[A]s the Doctor neither did this, nor yet sent him an answer, the projector wrote a second letter […]."
                                            },
                                            {
                                                "example_id": "f1f54323-df95-44f7-95cf-053960c9ed17",
                                                "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                                                "text": "[…] either the work of the winter storms, or perhaps the victims of some extensive but desultory scheme of denudation, which the projector had not capital or perseverance to carry into full effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b092993-e534-3336-931d-565ffa10ffb2",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "An optical device that projects a beam of light, especially one used to project an image (or moving images) onto a screen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "887a1d56-9078-3577-aed7-4dd986919744",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "That which projects or launches something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83fa86bf-3c15-4063-a109-88f11204c020",
                                                "sense_id": "887a1d56-9078-3577-aed7-4dd986919744",
                                                "text": "a depth charge projector"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0c78f2-3fa5-34f3-b6f7-fc79b1716337",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "One who projects, or ascribes his/her own feelings to others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0a8f18-e3c3-4aad-899f-dd28daa6c75c",
                                                "sense_id": "af0c78f2-3fa5-34f3-b6f7-fc79b1716337",
                                                "text": "Projectors attempt to get rid of unwanted feelings, only it does not work; they still experience the unwanted feelings […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e7ae89-1eee-33e7-b971-bd2da7b5439f",
                                        "entry_id": "53163ea1-f1ec-3ca3-8d5d-ea615bd0bd46",
                                        "glosses": [
                                            "An operator that forms a projection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
