                "senses": [
                    {
                        "sense_id": "2452e6cf-fec2-340d-b5eb-ca66ee7d5180",
                        "entry_id": "590c6ca1-41c4-3983-9453-da4c5f92459c",
                        "glosses": [
                            "Mètre cube."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9fbc0af-a624-484b-8546-d3ff4f2bbb12",
                                "sense_id": "2452e6cf-fec2-340d-b5eb-ca66ee7d5180",
                                "text": "2000 Kubikmeter Rhein pro Sekunde fließen an Köln vorbei."
                            },
                            {
                                "example_id": "4cd7e82b-6960-4302-9e11-e3198ac5e1f6",
                                "sense_id": "2452e6cf-fec2-340d-b5eb-ca66ee7d5180",
                                "text": "Auf dem Fabrikgelände sind Schmierstoffe ausgetreten, in der Folge mussten hunderte Kubikmeter kontaminiertes Erdreich abgetragen und entsorgt werden.",
                                "translation": "Des lubrifiants sont échappés sur le site de l’usine. Par la suite, des centaines de mètres cubes de terre contaminée ont dû être déblayés et éliminés."
                            }
                        ]
                    }
                ],
