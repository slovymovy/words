                "senses": [
                    {
                        "sense_id": "5b85258b-4222-3f1f-8aa9-5af1a382262b",
                        "entry_id": "582fe201-50fc-3863-ba66-8d1fd8c61c82",
                        "glosses": [
                            "истор., религ. человек, придерживающийся старообрядчества, то есть православных норм и обрядов, существовавших на Руси до церковного раскола XVII века."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad02838-4a1e-4b52-96f9-35f63ded01e3",
                                "sense_id": "5b85258b-4222-3f1f-8aa9-5af1a382262b",
                                "text": "Славянофилы эти наши, народники всякие ― старообрядцы всё!"
                            }
                        ]
                    }
                ],
