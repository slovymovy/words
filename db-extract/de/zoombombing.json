                        "entry_id": "ce9a2d87-0a7d-30de-8a92-9b674c0d24bd",
                        "glosses": [
                            "das Stören einer Videokonferenz, indem sich jemand unerlaubt in eine solche einwählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6218b8cf-4216-4cd3-a667-e0df0aa109cb",
                                "sense_id": "c650cdc7-2921-383a-9398-f0a17be6e02e",
                                "text": "„In den letzten Tagen häufen sich die Berichte über Zoombombing an Schulen.“"
                            },
                            {
                                "example_id": "61fe743d-345e-4e92-a129-ba619956fe97",
                                "sense_id": "c650cdc7-2921-383a-9398-f0a17be6e02e",
                                "text": "„Um Zoombombing zu verhindern, bietet Zoom mehrere Funktionen an, die aber offenbar nicht von allen Nutzerinnen und Nutzern berücksichtigt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
