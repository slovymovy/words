                {
                    "sense_id": "364725a2-c9db-3522-a5a4-434cb59493f1",
                    "sense_definition": "An animated film, television show, or work that originated in Japan.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother loves to watch <w>anime</w> every weekend.",
