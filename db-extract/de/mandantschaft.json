                ],
                "senses": [
                    {
                        "sense_id": "0aa5a9f7-7afc-3239-9ddc-37e61f63cf99",
                        "entry_id": "4baa7a7c-2618-3224-8268-65694e95425b",
                        "glosses": [
                            "Mandantin/Mandant/Mandanten aus einem bestimmten Mandatsverhältnis etwa eines Rechtsanwaltes oder Steuerberaters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a63c3f2-2299-4216-84ab-1176e3dfb6e1",
                                "sense_id": "0aa5a9f7-7afc-3239-9ddc-37e61f63cf99",
                                "text": "„Seine Mandantschaft wolle sicherstellen, dass sie die Belohnung auch in voller Höhe bekomme.“"
                            },
                            {
                                "example_id": "e6eb0949-f86f-45dc-a729-0cadf8a24317",
                                "sense_id": "0aa5a9f7-7afc-3239-9ddc-37e61f63cf99",
                                "text": "„Es war der Lebensgefährte meiner Mandantschaft, und es kam für sie völlig überraschend.“"
                            },
                            {
                                "example_id": "77d24e28-03eb-43fa-b42c-fab3ebb29e63",
                                "sense_id": "0aa5a9f7-7afc-3239-9ddc-37e61f63cf99",
                                "text": "„Mir wurden die Datensätze fertig übermittelt, ich hatte auf die Auswahl keinen Einfluss, diese wurde von der Mandantschaft getroffen.“"
                            },
                            {
                                "example_id": "c360cf9f-de25-4303-8a7c-7b8e6fdcb607",
                                "sense_id": "0aa5a9f7-7afc-3239-9ddc-37e61f63cf99",
                                "text": "„Der CSU-Politiker rechnet zwei seiner Mandantschaften dieser Stufe zu.“"
                            },
                            {
                                "example_id": "5993216b-8950-41d8-8914-b04338df6c00",
                                "sense_id": "0aa5a9f7-7afc-3239-9ddc-37e61f63cf99",
                                "text": "„Begleiter des Betreibers hätten durch aggressive körperliche Annäherung versucht, ihre Mandantschaft und sie selbst einzuschüchtern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ded6728e-3d0e-335f-a033-1bedc6548925",
                        "entry_id": "4baa7a7c-2618-3224-8268-65694e95425b",
                        "glosses": [
                            "Gesamtheit der Mandanten etwa eines Rechtsanwaltes, eines Steuerberaters oder einer Sozietät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea77079-e0a9-4b42-ba08-4d9bca7d6d30",
                                "sense_id": "ded6728e-3d0e-335f-a033-1bedc6548925",
                                "text": "„Der Profitgedanke ist dabei zweitrangig, aber natürlich beklagen wir uns auch nicht über die wachsende Mandantschaft.“"
                            },
                            {
                                "example_id": "d143167f-d2fb-4fad-a200-451df387c1ff",
                                "sense_id": "ded6728e-3d0e-335f-a033-1bedc6548925",
                                "text": "„Sobald man dort in den richtigen Zirkeln verkehrt, kommt die Mandantschaft von alleine, das hat auch nichts Anrüchiges.“"
                            },
                            {
                                "example_id": "c23468a2-36be-4ac0-9c94-e4479c1bbc59",
                                "sense_id": "ded6728e-3d0e-335f-a033-1bedc6548925",
                                "text": "„Bislang seien solche Anliegen in ihrer Mandantschaft jedoch noch eher selten.“"
                            },
                            {
                                "example_id": "da234fd4-ca78-4ded-85a6-d96355f8d860",
                                "sense_id": "ded6728e-3d0e-335f-a033-1bedc6548925",
                                "text": "„Das exklusive Ambiente scheint nicht zu seiner Mandantschaft zu passen: fast ausschließlich Studenten.“"
                            },
                            {
                                "example_id": "f51c7eee-b5e3-480a-8a1f-22663a3ffc1f",
                                "sense_id": "ded6728e-3d0e-335f-a033-1bedc6548925",
                                "text": "„Auf seine bunte Mandantschaft angesprochen, äußerte Höcker, dass ein Rechtsanwalt sogar bereit sein müsse, Hitler oder Stalin zu vertreten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
