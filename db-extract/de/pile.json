                "senses": [
                    {
                        "sense_id": "7a3c9898-db60-30d5-bb8f-f55cb3d3cd48",
                        "entry_id": "adfbbf23-63f0-3b7e-95e6-08be7f3b5d6d",
                        "glosses": [
                            "historischer Kernreaktor, der aus aufgestapelten Uran- und Graphitblöcken bestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4d412d1-7a9e-4b0a-a23e-6dc6e37fdcbf",
                                "sense_id": "7a3c9898-db60-30d5-bb8f-f55cb3d3cd48",
                                "text": "„Die Anlage enthielt rudimentäre Einrichtungen zur Schnellabschaltung. Dazu hätte ein dafür abgestellter Helfer das Befestigungsseil eines über dem Pile hängenden Regelelements mit einer Axt durchtrennt, das dann in den Reaktor gefallen wäre und ihn unterkritisch gemacht hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b14f8ff-e906-49a6-b58a-19e8cea89a62",
                        "source_entry_id": "adfbbf23-63f0-3b7e-95e6-08be7f3b5d6d",
                        "source_sense_id": "7a3c9898-db60-30d5-bb8f-f55cb3d3cd48",
                        "source_sense_description": "historischer Kernreaktor, der aus aufgestapelten Uran- und Graphitblöcken bestand",
                        "target_lang_word": "pile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6323675b-2716-3e1d-bcbd-51772ed4121e",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A mass of things heaped together; a heap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d2d7a4-a3ea-41c8-b06f-a2f8bb2fc3dd",
                                                "sense_id": "6323675b-2716-3e1d-bcbd-51772ed4121e",
                                                "text": "I climbed through, and, standing on a pile of stones, lifted and dragged Cleopatra after me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5272a77-4d0d-3cac-a3b3-8902517e301a",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A group or list of related items up for consideration, especially in some kind of selection process."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc5f9944-3d90-4824-82be-1fa423931a26",
                                                "sense_id": "c5272a77-4d0d-3cac-a3b3-8902517e301a",
                                                "text": "When we were looking for a new housemate, we put the nice woman on the \"maybe\" pile, and the annoying guy on the \"no\" pile"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d81632d7-9716-3d3a-ac95-5da888b26ab5",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A mass formed in layers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05023bb1-a248-459f-9bc6-54ecd7489d6e",
                                                "sense_id": "d81632d7-9716-3d3a-ac95-5da888b26ab5",
                                                "text": "a pile of shot"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287584bf-ce65-37eb-9879-5bc7db8c1440",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A funeral pile; a pyre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df925a4d-7dd8-4db4-8440-4cab0f303fd5",
                                                "sense_id": "287584bf-ce65-37eb-9879-5bc7db8c1440",
                                                "text": "Jove with a Nod, comply'd with her Deſire; / Around the Body flam'd the Funeral Fire; / The Pile decreas'd that lately ſeem'd ſo high, / And Sheets of Smoak roll'd upward to the Sky: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cb45c0f-e6ce-3acd-8c4c-f61c05cc3773",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A large amount of money."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59e4db1d-19e4-4eef-a0df-7329f3ab5e32",
                                                "sense_id": "4cb45c0f-e6ce-3acd-8c4c-f61c05cc3773",
                                                "text": "He made a pile from that invention of his."
                                            },
                                            {
                                                "example_id": "c436c380-cec5-4730-9c1a-98681adf331b",
                                                "sense_id": "4cb45c0f-e6ce-3acd-8c4c-f61c05cc3773",
                                                "text": "When they are at work they live most frugally, denying themselves every comfort and luxury till they have made a \"pile.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25ed3507-671d-3763-9b62-7df9df6be5ed",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A large building, or mass of buildings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a64785b9-9a5b-46a4-a9b1-cd125b7cd24e",
                                                "sense_id": "25ed3507-671d-3763-9b62-7df9df6be5ed",
                                                "text": "The pile is of a gloomy and massive, rather than of an elegant, style of Gothic architecture; […]"
                                            },
                                            {
                                                "example_id": "250fa791-32cf-499d-bd54-3d207d2f2c4e",
                                                "sense_id": "25ed3507-671d-3763-9b62-7df9df6be5ed",
                                                "text": "The pile o'erlooked the town and drew the fight."
                                            },
                                            {
                                                "example_id": "6e6b4e1b-d885-4e60-ade6-a6094eaadf92",
                                                "sense_id": "25ed3507-671d-3763-9b62-7df9df6be5ed",
                                                "text": "It was dark when the four-wheeled cab wherein he had brought Avice from the station stood at the entrance to the pile of flats of which Pierston occupied one floor[…]"
                                            },
                                            {
                                                "example_id": "f0128730-36af-48c6-98af-eeca38ab5184",
                                                "sense_id": "25ed3507-671d-3763-9b62-7df9df6be5ed",
                                                "text": "He [Winston Churchill] was born at Blenheim Palace, that Oxfordshire pile built for his ancestor John Churchill, 1st Duke of Marlborough, who also knew a thing or two about warfare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f76797d-d847-3c13-bb53-d9547e056a40",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A bundle of pieces of wrought iron to be worked over into bars or other shapes by rolling or hammering at a welding heat; a fagot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62036adc-fa5f-39ef-8dbc-0f618a5fe2c5",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A vertical series of alternate disks of two dissimilar metals (especially copper and zinc), laid up with disks of cloth or paper moistened with acid water between them, for producing a current of electricity; a voltaic pile, or galvanic pile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c563b0-f7a9-4334-91ae-d5d90e5aa081",
                                                "sense_id": "62036adc-fa5f-39ef-8dbc-0f618a5fe2c5",
                                                "text": "The word \"pile\" is used specifically to mean the column of superposed electrodes, such as that of Volta or Zamboni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c597542-0558-36e8-93cd-8f3784791b46",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A beam, pole, or pillar, driven completely into the ground, usually as one of a group that constitutes a foundation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f167a30-5907-374e-aad9-eda7a053b630",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "An atomic pile; an early form of nuclear reactor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d99bc2a5-4284-3b29-b29f-7b9d1c69e50f",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "The reverse (or tails) of a coin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "957b1ca1-81d3-39a6-ae38-b0727ee638d8",
                                        "entry_id": "20a84085-f81f-3000-9446-fd43a3ec82e6",
                                        "glosses": [
                                            "A list or league"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc5dd9c-f503-4800-bd2f-8a9ceae3114c",
                                                "sense_id": "957b1ca1-81d3-39a6-ae38-b0727ee638d8",
                                                "text": "And the moment it thumped into the net, Celtic’s march back to the top of the SPL pile also seemed unstoppable."
                                            },
                                            {
                                                "example_id": "3b855f93-61ec-40a8-9d3e-8fd69ed78fca",
                                                "sense_id": "957b1ca1-81d3-39a6-ae38-b0727ee638d8",
                                                "text": "Watch Harlequins train and you get some idea of why they are back on top of the pile going into Saturday's rerun of last season's grand final against Leicester."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "457b2000-2c30-3792-98fb-149930cdedc6",
                                        "entry_id": "2a5555eb-56ad-3345-bc54-b886b0f2e497",
                                        "glosses": [
                                            "To lay or throw into a pile or heap; to heap up; to collect into a mass; to accumulate"
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38c347d8-670e-4691-aa18-044db44a2672",
                                                "sense_id": "457b2000-2c30-3792-98fb-149930cdedc6",
                                                "text": "They were piling up wood on the wheelbarrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c7ceb5e-c111-3f07-8154-badf0641f05e",
                                        "entry_id": "2a5555eb-56ad-3345-bc54-b886b0f2e497",
                                        "glosses": [
                                            "To cover with heaps; or in great abundance; to fill or overfill; to load."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f28993d-5830-4735-93dc-9db923788dbd",
                                                "sense_id": "9c7ceb5e-c111-3f07-8154-badf0641f05e",
                                                "text": "We piled the camel with our loads."
                                            },
                                            {
                                                "example_id": "3704cc19-d2c9-4ec2-8c13-258433f8c94f",
                                                "sense_id": "9c7ceb5e-c111-3f07-8154-badf0641f05e",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e63b236-eabc-398f-b18a-fd82a72a3801",
                                        "entry_id": "2a5555eb-56ad-3345-bc54-b886b0f2e497",
                                        "glosses": [
                                            "To add something to a great number."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae126946-3db7-485d-a25f-463535d608d0",
                                                "sense_id": "3e63b236-eabc-398f-b18a-fd82a72a3801",
                                                "text": "But as the second half wore on, Sunderland piled forward at every opportunity and their relentless pressure looked certain to be rewarded in the closing stages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a7bedf0-3012-3151-8715-c5690f7e3e31",
                                        "entry_id": "2a5555eb-56ad-3345-bc54-b886b0f2e497",
                                        "glosses": [
                                            "(of vehicles) To create a hold-up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b451a0fd-58af-38f2-a531-87bc5c1f0ab0",
                                        "entry_id": "2a5555eb-56ad-3345-bc54-b886b0f2e497",
                                        "glosses": [
                                            "To place (guns, muskets, etc.) together in threes so that they can stand upright, supporting each other."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d68c4024-ebaf-3f24-81d7-135e8423bd89",
                                        "entry_id": "2a5555eb-56ad-3345-bc54-b886b0f2e497",
                                        "glosses": [
                                            "To form a pile or heap."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d01382ae-a515-4680-9ffa-f65fc97d6296",
                                                "sense_id": "d68c4024-ebaf-3f24-81d7-135e8423bd89",
                                                "text": "Junk piled on the floor as we searched the attic for the old photograph albums."
                                            },
                                            {
                                                "example_id": "823eae82-b471-46ef-86dd-a87664b24ed9",
                                                "sense_id": "d68c4024-ebaf-3f24-81d7-135e8423bd89",
                                                "text": "I darted from room to room as the see-through bagless dustbin piled high with shocking amounts of icky-poo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
