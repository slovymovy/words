                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "363db93e-ce3a-40c0-9533-c4e4b06d3c6d",
                        "source_entry_id": "f6d1ff68-15be-31e0-b5ea-1d9853053213",
                        "source_sense_description": "женский половой орган цветка",
                        "target_lang_word": "雌蕊",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "雌蕊",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "fea26ac6-5455-30a5-adc8-3db4d52b6712",
                                        "entry_id": "698d2d42-deed-3bfa-aa3b-a9332df66d0f",
                                        "glosses": [
                                            "被子植物花的雌性生殖器，能夠接受花粉並產生果實，當中又分為子房、花柱和柱頭"
                                        ],
                                        "tags": [],
