                        "entry_id": "70eb4c40-ebfd-3bb1-b012-8a37fd9fea6b",
                        "glosses": [
                            "Qui produit du sel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "622eefa6-a84b-4e22-a5e4-c08c7ab46ee4",
                                "sense_id": "b1022b80-79c3-3af4-82a3-ffe25d9fdf29",
                                "text": "Les tables salantes sont des bassins qui servent à la cristallisation du sel. Dotées d’un sol compacté, durci et plan comme un court de tennis, de formes géométriques, aux berges généralement garnies de planches, les tables salantes ont une surface au plus égale au dixième de celle du salin."
                            }
                        ]
                    }
                ],
