{
    "word_family": [
        "griping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "529bf7a3-e405-39a9-aa31-4eac6cf71573",
                    "sense_definition": "To complain or whine about something, often in a petty or annoying way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Employees often <w>gripe</w> about the office temperature during the summer months.",
                            "target_lang_translations": {
                                "cs": "Zaměstnanci si v letních měsících často <w>stěžují</w> na teplotu v kanceláři.",
                                "ru": "Сотрудники часто <w>жалуются</w> на температуру в офисе в летние месяцы.",
                                "de": "Mitarbeiter <w>meckern</w> in den Sommermonaten oft über die Temperatur im Büro."
                            }
                        },
                        {
                            "text": "Stop <w>griping</w> about the weather and let us enjoy our walk.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>remcat</w> kvůli počasí a pojďme si užít procházku.",
                                "ru": "Перестань <w>ворчать</w> из-за погоды, давай насладимся прогулкой.",
                                "de": "Hör auf, über das Wetter zu <w>nörgeln</w>, und lass uns den Spaziergang genießen."
                            }
                        }
                    ],
                    "synonyms": [
                        "bitch",
                        "complain",
                        "whine",
                        "whinge"
                    ],
                    "common_phrases": [
                        "gripe about"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stěžovat si nebo kňourat kvůli něčemu, často malicherným nebo otravným způsobem.",
                        "ru": "Жаловаться или ныть по поводу чего-либо, часто в раздражающей или мелочной манере.",
                        "de": "Sich über etwas beschweren oder nörgeln, oft auf kleinliche oder nervige Weise."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stěžovat si",
                                "target_lang_sense_clarification": "obecné vyjádření nespokojenosti"
                            },
                            {
                                "target_lang_word": "remcat",
                                "target_lang_sense_clarification": "neformální, vyjadřuje otravné stěžování"
                            },
                            {
                                "target_lang_word": "brblat",
                                "target_lang_sense_clarification": "vyjadřování nespokojenosti pod vousy"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жаловаться",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "выражать недовольство под нос"
                            },
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "назойливо жаловаться"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "meckern",
                                "target_lang_sense_clarification": "umgangssprachlich für unzufriedenes Bekritteln"
                            },
                            {
                                "target_lang_word": "nörgeln",
                                "target_lang_sense_clarification": "andauernd und störend Unmut äußern"
                            },
                            {
                                "target_lang_word": "maulen",
                                "target_lang_sense_clarification": "mürrisch oder trotzig seinen Unmut zeigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f77cec6-9cba-3a63-bb81-07ec7c801a78",
                    "sense_definition": "To annoy or bother someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the construction site really <w>gripes</w> me.",
                            "target_lang_translations": {
                                "cs": "Ten neustálý hluk ze staveniště mě opravdu <w>štve</w>.",
                                "ru": "Постоянный шум со стройки меня очень <w>раздражает</w>.",
                                "de": "Der ständige Lärm von der Baustelle <w>nervt</w> mich wirklich."
                            }
                        },
                        {
                            "text": "It <w>gripes</w> me when people do not return borrowed books on time.",
                            "target_lang_translations": {
                                "cs": "Opravdu mě <w>irituje</w>, když lidé nevracejí půjčené knihy včas.",
                                "ru": "Меня <w>бесит</w>, когда люди не возвращают взятые книги вовремя.",
                                "de": "Es <w>ärgert</w> mich, wenn Leute geliehene Bücher nicht pünktlich zurückgeben."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Někoho štvát, obtěžovat nebo iritovat.",
                        "ru": "Раздражать или беспокоить кого-либо.",
                        "de": "Jemanden nerven, ärgern oder stören."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "štvat",
                                "target_lang_sense_clarification": "vyvolávat v někom podráždění"
                            },
                            {
                                "target_lang_word": "iritovat",
                                "target_lang_sense_clarification": "způsobovat někomu nepříjemné pocity"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать чувство досады"
                            },
                            {
                                "target_lang_word": "бесить",
                                "target_lang_sense_clarification": "сильно раздражать (разговорное)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nerven",
                                "target_lang_sense_clarification": "jemandem auf die Nerven gehen"
                            },
                            {
                                "target_lang_word": "ärgern",
                                "target_lang_sense_clarification": "Verdruss oder Missfallen bereiten"
                            },
                            {
                                "target_lang_word": "wurmen",
                                "target_lang_sense_clarification": "jemanden innerlich ärgern oder kränken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30e67156-9fa6-3cea-bb23-0c47ff35ec97",
                    "sense_definition": "To seize or grasp something firmly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grasping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete had to <w>gripe</w> the rope tightly to climb the wall.",
                            "target_lang_translations": {
                                "cs": "Sportovec musel lano pevně <w>sevřít</w>, aby vyšplhal na zeď.",
                                "ru": "Спортсмену пришлось крепко <w>сжать</w> канат, чтобы взобраться на стену.",
                                "de": "Der Athlet musste das Seil fest <w>packen</w>, um die Wand hochzuklettern."
                            }
                        },
                        {
                            "text": "He <w>griped</w> the handle of the sword before stepping into the arena.",
                            "target_lang_translations": {
                                "cs": "Před vstupem do arény <w>sevřel</w> rukojeť meče.",
                                "ru": "Он <w>схватил</w> рукоять меча перед выходом на арену.",
                                "de": "Er <w>umklammerte</w> den Griff des Schwertes, bevor er die Arena betrat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pevně něco uchopit nebo sevřít.",
                        "ru": "Крепко схватить или сжать что-либо.",
                        "de": "Etwas fest anpacken oder greifen."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sevřít",
                                "target_lang_sense_clarification": "pevně uchopit rukou"
                            },
                            {
                                "target_lang_word": "chytit",
                                "target_lang_sense_clarification": "uchopit předmět"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сжать",
                                "target_lang_sense_clarification": "крепко обхватить рукой"
                            },
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "быстро взять в руки"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "packen",
                                "target_lang_sense_clarification": "mit festem Griff ergreifen"
                            },
                            {
                                "target_lang_word": "ergreifen",
                                "target_lang_sense_clarification": "in die Hand nehmen und festhalten"
                            },
                            {
                                "target_lang_word": "festhalten",
                                "target_lang_sense_clarification": "mit den Händen sichern"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21382f91-5841-3f27-9191-0eab41f25d40",
                    "sense_definition": "A complaint, especially one that is petty or trivial.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a minor <w>gripe</w> about the service at the restaurant.",
                            "target_lang_translations": {
                                "cs": "Měl drobnou <w>stížnost</w> na obsluhu v restauraci.",
                                "ru": "У него была мелкая <w>претензия</w> к обслуживанию в ресторане.",
                                "de": "Er hatte eine kleine <w>Beschwerde</w> über den Service im Restaurant."
                            }
                        },
                        {
                            "text": "The manager listened to every <w>gripe</w> from the staff during the meeting.",
                            "target_lang_translations": {
                                "cs": "Manažer si během schůzky vyslechl každou <w>stížnost</w> od zaměstnanců.",
                                "ru": "Менеджер выслушал каждую <w>жалобу</w> от персонала во время собрания.",
                                "de": "Die Leitung hörte sich während der Besprechung jede <w>Klage</w> der Belegschaft an."
                            }
                        }
                    ],
                    "synonyms": [
                        "complain"
                    ],
                    "common_phrases": [
                        "common gripe"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stížnost, zejména malicherná nebo triviální.",
                        "ru": "Жалоба, особенно мелочная или тривиальная.",
                        "de": "Eine Beschwerde oder Klage, insbesondere über belanglose Kleinigkeiten."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stížnost",
                                "target_lang_sense_clarification": "vyjádření nespokojenosti"
                            },
                            {
                                "target_lang_word": "výtka",
                                "target_lang_sense_clarification": "drobná kritika nebo připomínka"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "выражение недовольства"
                            },
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "выражение неудовлетворенности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Meckerei",
                                "target_lang_sense_clarification": "andauerndes oder kleinliches Klagen"
                            },
                            {
                                "target_lang_word": "Beschwerde",
                                "target_lang_sense_clarification": "Klage über einen Missstand"
                            },
                            {
                                "target_lang_word": "Klage",
                                "target_lang_sense_clarification": "Äußerung des Unmuts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecbc563c-e050-3673-9be6-9f3279c2c189",
                    "sense_definition": "A sharp, pinching pain in the stomach or intestines.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spoiled food caused a sudden <w>gripe</w> in his stomach.",
                            "target_lang_translations": {
                                "cs": "Zkažené jídlo mu způsobilo náhlé <w>křeče v břiše</w>.",
                                "ru": "Испорченная еда вызвала у него внезапную <w>резь</w> в животе.",
                                "de": "Das verdorbene Essen verursachte einen plötzlichen <w>Bauchkrampf</w> bei ihm."
                            }
                        },
                        {
                            "text": "She suffered from a severe <w>gripe</w> after eating the spicy meal.",
                            "target_lang_translations": {
                                "cs": "Po snědení pálivého jídla trpěla silnými <w>bolestmi v břiše</w>.",
                                "ru": "Она страдала от сильных <w>колик</w> после того, как съела острую пищу.",
                                "de": "Nachdem sie das scharfe Gericht gegessen hatte, litt sie an einer schweren <w>Kolik</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This medical usage is now rare."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ostrá, svíravá bolest v žaludku nebo střevech.",
                        "ru": "Острая, схваткообразная боль в желудке или кишечнике.",
                        "de": "Ein stechender, krampfartiger Schmerz im Magen oder im Darm."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bolesti v břiše",
                                "target_lang_sense_clarification": "obecné označení pro břišní potíže"
                            },
                            {
                                "target_lang_word": "křeče v břiše",
                                "target_lang_sense_clarification": "svíravá, ostrá bolest"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "резь",
                                "target_lang_sense_clarification": "острая режущая боль"
                            },
                            {
                                "target_lang_word": "колики",
                                "target_lang_sense_clarification": "приступообразная боль в животе"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kolik",
                                "target_lang_sense_clarification": "starker krampfartiger Bauchschmerz"
                            },
                            {
                                "target_lang_word": "Bauchkrampf",
                                "target_lang_sense_clarification": "schmerzhafte Muskelkontraktion im Bauchraum"
                            },
                            {
                                "target_lang_word": "Bauchweh",
                                "target_lang_sense_clarification": "allgemeine Schmerzen im Magen-Darm-Bereich"
                            }
                        ]
                    }
                }
            ]
        }
    ]
