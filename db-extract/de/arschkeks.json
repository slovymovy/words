                                "example_id": "4a42c798-ea05-43ee-a767-ccec4ae268cb",
                                "sense_id": "ce20edb0-799c-37c5-9877-151ed0400c19",
                                "text": "„So richtig schön geheult hat er, der kleine Arschkeks.“"
                            },
                            {
                                "example_id": "5c849684-adec-4965-9a12-530ca1961603",
                                "sense_id": "ce20edb0-799c-37c5-9877-151ed0400c19",
                                "text": "„Irgend so ein Arschkeks verstopft bei mir sämtliche WC-Schüsseln mit Toilettenpapier.“"
                            },
                            {
                                "example_id": "32849db7-93fa-40d7-9ace-45eaf9a3683b",
                                "sense_id": "ce20edb0-799c-37c5-9877-151ed0400c19",
                                "text": "„Der Arschkeks wußte doch genau, daß ich nicht aufgepaßt hatte.“"
                            },
                            {
                                "example_id": "03099db0-355a-462a-8e8a-2e7431ffa950",
                                "sense_id": "ce20edb0-799c-37c5-9877-151ed0400c19",
                                "text": "„‚[…] Du bist ein Arschkeks‘, wetterte er.“"
                            }
                        ],
