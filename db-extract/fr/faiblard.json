                ],
                "senses": [
                    {
                        "sense_id": "d3f73380-7b9c-3e8e-b810-4d0806344653",
                        "entry_id": "dfe0e12e-6ea7-3f43-9ae5-4f7cc382c615",
                        "glosses": [
                            "Qui est très faible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "744404ba-88e4-4328-aa02-2c8648bf9071",
                                "sense_id": "d3f73380-7b9c-3e8e-b810-4d0806344653",
                                "text": "Enfant faiblard."
                            },
                            {
                                "example_id": "a8f5f643-d493-4965-bd3e-675ecb0976ba",
                                "sense_id": "d3f73380-7b9c-3e8e-b810-4d0806344653",
                                "text": "Tatave, boiteux et faiblard, s'était esquivé avec les filles."
                            },
                            {
                                "example_id": "a2a97546-a32f-42e6-96d5-a6b4ea800839",
                                "sense_id": "d3f73380-7b9c-3e8e-b810-4d0806344653",
                                "text": "Et les articles des autres journaux paraissent faiblards à côté."
                            },
                            {
                                "example_id": "f43d136c-a115-4290-92c2-cc59331aa745",
                                "sense_id": "d3f73380-7b9c-3e8e-b810-4d0806344653",
                                "text": "Il appuya sur le bouton du poste, un petit transistor en plastique, un des premiers trucs qu’il ait piqués, une radio crachotante et faiblarde, sujette à de brusques accès de mutisme."
                            },
                            {
                                "example_id": "ca56f578-e0bd-4cd5-bfda-8e4017db2097",
                                "sense_id": "d3f73380-7b9c-3e8e-b810-4d0806344653",
                                "text": "À 14 % d’appuis dans l’ensemble du Québec, les appuis du PCQ pataugent encore dans les mêmes eaux faiblardes qu’eux."
                            },
                            {
                                "example_id": "a3b9037b-60db-4f02-99b8-15e61320c4e9",
                                "sense_id": "d3f73380-7b9c-3e8e-b810-4d0806344653",
                                "text": "Un soleil faiblard tiédissait le ciment."
                            }
                        ]
                    }
                ],
