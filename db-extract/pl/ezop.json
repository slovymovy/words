                "senses": [
                    {
                        "sense_id": "a0acd702-39e3-3f73-b57d-9c8c3fb3d354",
                        "entry_id": "fae059d9-c046-3826-aea0-4ad5e66f4c2f",
                        "glosses": [
                            "grecki bajkopisarz urodzony w VI w. p.n.e., pochodzący z miasta Mistra w Azji Mniejszej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8410333f-b2a8-4061-a377-2a15f9359848",
                                "sense_id": "a0acd702-39e3-3f73-b57d-9c8c3fb3d354",
                                "text": "Ezop jest postacią na wpół legendarną, a o jego życiu i twórczości bardzo mało wiemy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b5fd0af-1a92-41d0-b2b9-a53648c03ff5",
                        "source_entry_id": "fae059d9-c046-3826-aea0-4ad5e66f4c2f",
                        "source_sense_id": "a0acd702-39e3-3f73-b57d-9c8c3fb3d354",
                        "target_lang_word": "Aesop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aesop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "850b460b-3e48-3af3-a5e2-5221ca3fcc23",
                                        "entry_id": "71828f0b-0afe-3eee-8290-ed1d5a2cb4fd",
                                        "glosses": [
                                            "An Ancient Greek author, famous for the fables ascribed to him."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d5b39b-b1f2-4ad7-a1ed-19fa8388fd27",
                                                "sense_id": "850b460b-3e48-3af3-a5e2-5221ca3fcc23",
                                                "text": "I'll win them by politeness, and... and... show them that I've nothing to do with that Aesop, that buffoon, that Pierrot, and have merely been taken in over this affair, just as they have."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d21eaf6f-6141-4d28-b64b-389e8f835e34",
                        "source_entry_id": "fae059d9-c046-3826-aea0-4ad5e66f4c2f",
