                "senses": [
                    {
                        "sense_id": "8968da84-2c5c-38ea-b33b-bbb78ef620f8",
                        "entry_id": "0465f3c9-cd86-3265-8227-f6c640610b9a",
                        "glosses": [
                            "am Körper zu tragendes Gerät, das den Puls einer Person misst"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b5b452bb-8d85-4627-ba26-6d30da723175",
                                "sense_id": "8968da84-2c5c-38ea-b33b-bbb78ef620f8",
                                "text": "„Eine Pulsuhr kann Sie während des Trainings unterstützen. Diese Sportuhren können Sie motivieren und vor Unter- sowie Überlastungen schützen.“"
                            },
                            {
                                "example_id": "bd964b08-652a-439f-bb73-5171c6a9ddbb",
                                "sense_id": "8968da84-2c5c-38ea-b33b-bbb78ef620f8",
                                "text": "„Sie sind leidenschaftlicher Sportler und wollen Ihre Leistung auf das nächste Level heben? Vielleicht fangen Sie auch gerade erst mit dem Sport an und wünschen sich etwas zusätzliche Motivation. In beiden Fällen kann eine moderne Pulsuhr überaus nützlich sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
