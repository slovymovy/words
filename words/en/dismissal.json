{
    "word_family": [
        "dismiss",
        "dismissive",
        "dismissively"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b1a213d-cafe-3c87-b19c-3cb7879498c4",
                    "sense_definition": "The act of being fired from a job or removed from a position of authority.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager threatened the staff with instant <w>dismissal</w> if they were caught stealing from the store.",
                            "target_lang_translations": {
                                "ru": "Менеджер пригрозил сотрудникам немедленным <w>увольнением</w>, если их поймают на краже в магазине."
                            }
                        },
                        {
                            "text": "After the scandal, his unfair <w>dismissal</w> from the company was overturned by the court.",
                            "target_lang_translations": {
                                "ru": "После скандала его несправедливое <w>увольнение</w> из компании было отменено судом."
                            }
                        }
                    ],
                    "synonyms": [
                        "firing",
                        "termination",
                        "discharge"
                    ],
                    "antonyms": [
                        "hiring",
                        "appointment",
                        "recruitment"
                    ],
                    "common_phrases": [
                        "unfair dismissal",
                        "instant dismissal",
                        "wrongful dismissal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт увольнения с работы или отстранения от руководящей должности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увольнение",
                                "target_lang_sense_clarification": "прекращение трудового договора"
                            },
                            {
                                "target_lang_word": "отставка",
                                "target_lang_sense_clarification": "уход с высокого поста или военной службы"
                            },
                            {
                                "target_lang_word": "сокращение",
                                "target_lang_sense_clarification": "увольнение в связи с уменьшением штата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59f4bb8b-36ac-36ca-8412-98633ea6c386",
                    "sense_definition": "The act of treating something as unworthy of serious consideration or putting it out of one's mind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her casual <w>dismissal</w> of my concerns made me feel like I wasn't being heard.",
                            "target_lang_translations": {
                                "ru": "То, как небрежно она <w>отмахнулась</w> от моих опасений, заставило меня почувствовать, что меня не слышат."
                            }
                        },
                        {
                            "text": "The scientist's summary <w>dismissal</w> of the new theory surprised his colleagues.",
                            "target_lang_translations": {
                                "ru": "То, как быстро ученый <w>отверг</w> новую теорию, удивило его коллег."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejection",
                        "disregard",
                        "denial"
                    ],
                    "antonyms": [
                        "acceptance",
                        "consideration",
                        "recognition"
                    ],
                    "common_phrases": [
                        "summary dismissal",
                        "casual dismissal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт игнорирования чего-либо как недостойного серьезного рассмотрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "отказ рассматривать предложение или идею"
                            },
                            {
                                "target_lang_word": "неприятие",
                                "target_lang_sense_clarification": "отказ принимать во внимание"
                            },
                            {
                                "target_lang_word": "пренебрежение",
                                "target_lang_sense_clarification": "игнорирование как неважного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77e36633-f580-30a5-9da7-2755b6c74d53",
                    "sense_definition": "The act of officially sending someone away or allowing them to leave.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sending_away",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students waited for the bell to signal their <w>dismissal</w> from the classroom.",
                            "target_lang_translations": {
                                "ru": "Ученики ждали звонка, который должен был стать сигналом к тому, что их <w>отпускают</w> из класса."
                            }
                        },
                        {
                            "text": "The general gave the order for the <w>dismissal</w> of the troops after the parade.",
                            "target_lang_translations": {
                                "ru": "Генерал отдал приказ о <w>роспуске</w> войск после парада."
                            }
                        }
                    ],
                    "synonyms": [
                        "release",
                        "departure"
                    ],
                    "antonyms": [
                        "summons",
                        "assembly"
                    ],
                    "common_phrases": [
                        "early dismissal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное разрешение уйти или приказ разойтись."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роспуск",
                                "target_lang_sense_clarification": "прекращение деятельности собрания или группы"
                            },
                            {
                                "target_lang_word": "отпущение",
                                "target_lang_sense_clarification": "разрешение уйти (например, с занятий)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83d2baa5-2f5d-3e92-bf34-9747bb4bc907",
                    "sense_definition": "The formal rejection of a legal case, claim, or charge by a judge.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer moved for a <w>dismissal</w> of the charges due to a lack of evidence.",
                            "target_lang_translations": {
                                "ru": "Адвокат ходатайствовал о <w>снятии</w> обвинений из-за отсутствия доказательств."
                            }
                        },
                        {
                            "text": "The judge's <w>dismissal</w> of the lawsuit was a major victory for the defense team.",
                            "target_lang_translations": {
                                "ru": "<w>Отклонение</w> иска судьей стало крупной победой стороны защиты."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejection",
                        "annulment"
                    ],
                    "common_phrases": [
                        "dismissal of charges",
                        "motion for dismissal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное отклонение судебного дела, иска или обвинения судьей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "судебный отказ в иске"
                            },
                            {
                                "target_lang_word": "прекращение",
                                "target_lang_sense_clarification": "закрытие судебного дела или производства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fc837ef-7174-3f2f-9b77-bb4428e4c688",
                    "sense_definition": "In cricket, the event of a batsman being forced to leave the field because they are out.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bowler celebrated the <w>dismissal</w> of the star batsman early in the game.",
                            "target_lang_translations": {
                                "ru": "Боулер отпраздновал <w>вывод из игры</w> звездного бэтсмена в начале матча."
                            }
                        },
                        {
                            "text": "It was a controversial <w>dismissal</w> that changed the momentum of the match.",
                            "target_lang_translations": {
                                "ru": "Это был спорный <w>аут</w>, который изменил ход матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "wicket"
                    ],
                    "common_phrases": [
                        "mode of dismissal"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in cricket-playing nations"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: момент, когда бэтсмен вынужден покинуть поле, так как он выбыл из игры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вывод из игры",
                                "target_lang_sense_clarification": "удаление игрока с поля в крикете"
                            },
                            {
                                "target_lang_word": "аут",
                                "target_lang_sense_clarification": "ситуация, когда бэтсмен выбывает"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}