                "senses": [
                    {
                        "sense_id": "53cbf851-8fb1-3940-8f19-917436829442",
                        "entry_id": "50ba7087-026d-3aee-9ff6-2eecec7f3d1b",
                        "glosses": [
                            "Cibler très précisément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb626e6c-c13c-46c7-a0ce-bed46bfcfc8d",
                                "sense_id": "53cbf851-8fb1-3940-8f19-917436829442",
                                "text": "En effet, avec internet il est possible d’hypercibler ses consommateurs, c’est à dire de leur adresser le message le plus efficace au moment précis où ils en ont besoin."
                            },
                            {
                                "example_id": "8bf2f3d0-b1e5-41d8-a17e-da270de4da9b",
                                "sense_id": "53cbf851-8fb1-3940-8f19-917436829442",
                                "text": "Notre offre Mapp Cloud en les aidant dès les phases amont du parcours d’achat avec détection des « rêves » des futurs voyageurs, notamment grâce à la DMP, puis en se nourrissant de cette connaissance pour ensuite relancer et fidéliser sur le(s) bons(s) canaux fournit au secteur du tourisme les moyens de mieux automatiser, hypercibler et personnaliser l’engagement avec leurs cibles."
                            }
                        ]
                    }
