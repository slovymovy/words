{
    "word_family": [
        "embroider",
        "embroiderer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6691b9c3-fec5-34da-8dec-5878722f0e11",
                    "sense_definition": "The art or process of decorating fabric using needle and thread.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "needlework",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the afternoon practicing her <w>embroidery</w> on a piece of linen.",
                            "target_lang_translations": {
                                "tr": "Öğleden sonrasını bir parça keten üzerinde <w>nakış</w> çalışarak geçirdi."
                            }
                        },
                        {
                            "text": "Intricate <w>embroidery</w> patterns decorated the edges of the traditional wedding dress.",
                            "target_lang_translations": {
                                "tr": "Geleneksel gelinliğin kenarlarını karmaşık <w>nakış</w> desenleri süslüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "needlework",
                        "stitching"
                    ],
                    "common_phrases": [
                        "hand embroidery",
                        "machine embroidery"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kumaş üzerine iğne ve iplikle yapılan süsleme sanatı veya işlemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "nakış",
                                "target_lang_sense_clarification": "Kumaş üzerine iplikle yapılan geleneksel işleme sanatı."
                            },
                            {
                                "target_lang_word": "işleme",
                                "target_lang_sense_clarification": "Kumaş üzerine yapılan süsleme işi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76ce4268-a91a-3cb3-a5a1-4be73bb7bd5e",
                    "sense_definition": "A piece of fabric that has been decorated with needlework.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "needlework",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a beautiful antique <w>embroidery</w> from the eighteenth century.",
                            "target_lang_translations": {
                                "tr": "Müze, on sekizinci yüzyıldan kalma güzel bir antika <w>işlemeyi</w> sergiledi."
                            }
                        },
                        {
                            "text": "She framed the delicate <w>embroidery</w> to hang on her living room wall.",
                            "target_lang_translations": {
                                "tr": "Zarif <w>işlemeyi</w> oturma odasının duvarına asmak için çerçeveletti."
                            }
                        }
                    ],
                    "synonyms": [
                        "needlework"
                    ],
                    "common_phrases": [
                        "framed embroidery"
                    ],
                    "target_lang_definitions": {
                        "tr": "İğne işiyle süslenmiş kumaş parçası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "nakışlı kumaş",
                                "target_lang_sense_clarification": "Üzerinde nakış bulunan işlenmiş parça."
                            },
                            {
                                "target_lang_word": "işleme",
                                "target_lang_sense_clarification": "Nakışla süslenmiş nesne veya kumaş."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29bcd48b-0893-3bd0-91e7-d1483a7f3ca7",
                    "sense_definition": "The act of adding extra, often invented, details to a story or account.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exaggeration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His story was true, but it required some <w>embroidery</w> to make it sound more exciting.",
                            "target_lang_translations": {
                                "tr": "Hikayesi doğruydu ama daha heyecan verici duyulması için biraz <w>abartıya</w> ihtiyacı vardı."
                            }
                        },
                        {
                            "text": "The witness added unnecessary <w>embroidery</w> to her testimony, which made the judge suspicious.",
                            "target_lang_translations": {
                                "tr": "Tanık, ifadesine gereksiz <w>süslemeler</w> ekledi, bu da hakimi şüphelendirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "exaggeration",
                        "embellishment"
                    ],
                    "antonyms": [
                        "simplification"
                    ],
                    "common_phrases": [
                        "story embroidery"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir hikayeye veya anlatıma abartılı, genellikle uydurma detaylar ekleme eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "abartma",
                                "target_lang_sense_clarification": "Bir durumu olduğundan daha büyük veya farklı gösterme."
                            },
                            {
                                "target_lang_word": "süsleme",
                                "target_lang_sense_clarification": "Bir anlatımı daha etkileyici kılmak için eklenen detaylar."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}