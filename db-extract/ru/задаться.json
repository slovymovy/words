                        "glosses": [
                            "to set oneself"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f15078dc-d6f1-4e84-b59e-cfd734ae6481",
                                "sense_id": "86dc745c-3f75-3067-8a65-1d7e53a40d2c",
                                "text": "зада́ться це́лью/мы́слью",
                                "translation": "to set oneself to the task; make up one's mind",
                                "english": "to set oneself to the task; make up one's mind"
                            },
                            {
                                "example_id": "02b3ae2b-c2d4-4e59-8e40-537655fdcc78",
                                "sense_id": "86dc745c-3f75-3067-8a65-1d7e53a40d2c",
                                "text": "он зада́лся це́лью вы́учить англи́йский язы́к",
                                "translation": "he has set himself to the task of learning English",
                                "english": "he has set himself to the task of learning English"
                            },
                            {
                                "example_id": "79e19b0e-58b4-4f80-9b3c-ef1b1bc86ed2",
                                "sense_id": "86dc745c-3f75-3067-8a65-1d7e53a40d2c",
                                "text": "зада́ться вопро́сом",
                                "translation": "to ask oneself; wonder",
                                "english": "to ask oneself; wonder"
                            }
                        ]
                    },
                    {
                        "sense_id": "f3aca7f7-0703-3443-ae1e-66751c7c1a0f",
                        "entry_id": "8c464514-ad4a-3233-9def-4c1793402355",
                        "glosses": [
                            "of period, time to have"
                        ],
