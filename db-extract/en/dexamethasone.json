    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9e6ecb34-5480-3044-bfa3-e7822fc9fceb",
                "word": "dexamethasone",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bb1521ff-e593-4c1d-ba3b-be136e43b36b",
                        "entry_id": "9e6ecb34-5480-3044-bfa3-e7822fc9fceb",
                        "tags": [
                            "plural"
                        ],
                        "form": "dexamethasones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e3d243d-01fb-3277-b1f3-1eefeb083735",
                        "entry_id": "9e6ecb34-5480-3044-bfa3-e7822fc9fceb",
                        "glosses": [
                            "A synthetic member of the glucocorticoid-class of steroid hormones, having the chemical formula C₂₂H₂₉FO₅, and used especially as an anti-inflammatory agent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c9af572e-8d66-4b33-b387-414170f74d50",
                                "sense_id": "3e3d243d-01fb-3277-b1f3-1eefeb083735",
                                "text": "Many dexamethasones act as anti-inflammatory agents."
                            },
                            {
                                "example_id": "a47bbbba-4c27-49a4-b673-a7fa1ddbc64f",
                                "sense_id": "3e3d243d-01fb-3277-b1f3-1eefeb083735",
                                "text": "Lee showed her how to feed the baby with the dexamethasone syrup."
                            },
                            {
                                "example_id": "561f81a8-bd23-4e8f-b1db-42cab3a340b3",
                                "sense_id": "3e3d243d-01fb-3277-b1f3-1eefeb083735",
                                "text": "Dexamethasone, a widely available and affordable generic steroid, was shown to cut the risk of death by a third for Covid patients on ventilators, and by nearly a fifth for those on oxygen therapy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cae0fc8f-7f87-468c-92c7-e53cd342a6dc",
                        "source_entry_id": "9e6ecb34-5480-3044-bfa3-e7822fc9fceb",
                        "source_sense_id": "3e3d243d-01fb-3277-b1f3-1eefeb083735",
                        "source_sense_description": "Translations",
                        "target_lang_word": "dexaméthasone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dexaméthasone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
                                        "entry_id": "cc65ac08-aabb-3674-af44-b1777a384919",
                                        "glosses": [
                                            "Dénomination commune internationale (D.C.I.) d'un glucocorticoïde de synthèse ayant un effet anti-inflammatoire et immunosuppresseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da222be-dc57-4ad0-aeca-2b1b14ab4ed7",
                                                "sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
                                                "text": "Le freinage des surrénales est habituellement réalisé par la dexaméthasone."
                                            },
                                            {
                                                "example_id": "f08ee600-5df3-4530-8ad8-5baf35c6c98e",
                                                "sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
                                                "text": "L’administration dans ce cas de dexamétazone fait chuter la testostéronémie au taux du premier type."
                                            },
                                            {
                                                "example_id": "c6de549c-2c82-42de-9e9d-3031cf48bf14",
                                                "sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
                                                "text": "On a découvert un test dit à la dexamétazone, qui est positif si on est déprimé, en ce sens que l’hypophyse ne répond plus."
                                            }
                                        ]
                                    }
                                ]
                            }
