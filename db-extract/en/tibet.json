    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "31adeafd-be1e-3760-904f-5443affaecb9",
                "word": "Tibet",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f29acb48-3acd-3f3b-96c1-31f651d7b5d2",
                        "entry_id": "31adeafd-be1e-3760-904f-5443affaecb9",
                        "glosses": [
                            "A geographic region in Central Asia (mostly in China), the homeland of the Tibetan people, covering much of the Tibetan Plateau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef64b42-6d10-4648-a9a8-c6a7f4c46ae2",
                                "sense_id": "f29acb48-3acd-3f3b-96c1-31f651d7b5d2",
                                "text": "The Province of Xenſi extends to the Kingdom of Preſter John. Caſcar and Thebet, which the Chineſes in a general Name call Sifan it is a large Province, and is divided into eight Counties, having one hundred and eighty Cities: Sigan is the Metropolis of the whole, ſeated on the River Guei, in a moſt pleaſant and delightful place, of a noble Proſpect, and good Trade."
                            },
                            {
                                "example_id": "6b05e0ae-542a-4c01-84cb-18fb836c0c30",
                                "sense_id": "f29acb48-3acd-3f3b-96c1-31f651d7b5d2",
                                "text": "A giant rally on Formosa reflects the worldwide concern for Tibet's heroic rebels. Speaking to sixty-thousand people in Taipei, President Chiang Kai-shek says Tibet's resistance foreshadows a vast anti-communist uprising on the mainland of China."
                            }
                        ]
                    },
                    {
                        "sense_id": "61946ba9-70e8-3b7e-b5bb-5731328d401a",
                        "entry_id": "31adeafd-be1e-3760-904f-5443affaecb9",
                        "glosses": [
                            "A former country in East Asia that existed from 1912 until its annexation by China in 1951."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8e7a4096-2357-4128-822f-17b45ceb8f25",
                                "sense_id": "61946ba9-70e8-3b7e-b5bb-5731328d401a",
                                "text": "The estimated population of the Chinese Empire (exclusive of Tibet) is given, on the basis of this census, as 329,542,000, while the population of Tibet is estimated at 1,500,000."
                            },
                            {
                                "example_id": "4f23ae70-8b1b-4d63-a8a0-bcdfeeea2c15",
                                "sense_id": "61946ba9-70e8-3b7e-b5bb-5731328d401a",
                                "text": "Third, we should open up two new international broadcasting stations—Radio Free China and Radio Free Tibet— to provide these nations with independent information and commentary.[...]The people of Tibet represent a separate case. Conquered by the Chinese in 1950, occupied brutally by troops who killed thousands, desecrated local cultural and religious sites, and denied reasonable demands for autonomy, Tibetans have elicited much sympathy but little support from the outside world. The outrage over the brutal killings of peaceful demonstrators in Lhasa in March 1989 quickly faded after the massacres in Beijing in June. While there is a limit to what we can do, we should do more than we have done. In addition to raising the issue of Tibet in bilateral talks, we should establish Radio Free Tibet so that its people, though isolated, will no longer feel abandoned."
                            },
                            {
                                "example_id": "90550e3d-18f1-477b-951c-3d6a66363c6f",
                                "sense_id": "61946ba9-70e8-3b7e-b5bb-5731328d401a",
                                "text": "I also supported more political freedom in China, and had recently invited the Dalai Lama and Hong Kong human rights activist Martin Lee to the White House to highlight my support for the cultural and religious integrity of Tibet and for maintaining Hong Kong's democracy now that the UK had restored it to China."
                            }
                        ]
                    },
                    {
                        "sense_id": "54df383f-5941-3f11-9b1a-7ff6d322ecb3",
                        "entry_id": "31adeafd-be1e-3760-904f-5443affaecb9",
                        "glosses": [
                            "An autonomous region of China. Official name: Tibet Autonomous Region. Capital: Lhasa."
                        ],
                        "tags": [],
                        "examples": []
                    }
