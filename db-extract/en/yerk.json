    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "be1ab7eb-71e8-3530-982f-3c9fcadccb75",
                "word": "yerk",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7611ed49-0bcd-4e34-ac8b-0f38184db696",
                        "entry_id": "be1ab7eb-71e8-3530-982f-3c9fcadccb75",
                        "tags": [
                            "plural"
                        ],
                        "form": "yerks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6119f22-3fcd-3ba9-a877-7c118c2f82f6",
                        "entry_id": "be1ab7eb-71e8-3530-982f-3c9fcadccb75",
                        "glosses": [
                            "A sudden or quick thrust or motion; a jerk."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d478b977-4c0b-4a24-92b6-38653f782b73",
                                "sense_id": "e6119f22-3fcd-3ba9-a877-7c118c2f82f6",
                                "text": "Imagine twenty thouſand of them breaking into the midſt of an European Army, confounding the Ranks, overturning the Carriages, battering the Warriors Faces into Mummy, by terrible Yerks from their hinder Hoofs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e7a94bbd-ff1b-3849-ad9e-68d5a5134bc7",
