                    }
                ],
                "senses": [
                    {
                        "sense_id": "358b0a99-b300-30bc-a21b-4393300e9274",
                        "entry_id": "d276984d-90de-3bcd-b499-08214fd8db2f",
                        "glosses": [
                            "свойственный артисту, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914febca-6d1e-4930-98a9-26c4b8295c59",
                                "sense_id": "358b0a99-b300-30bc-a21b-4393300e9274",
                                "text": "Артистический псевдоним."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a9958d5-9557-44f6-8012-1395648e8da0",
                        "source_entry_id": "d276984d-90de-3bcd-b499-08214fd8db2f",
                        "source_sense_id": "358b0a99-b300-30bc-a21b-4393300e9274",
                        "target_lang_word": "artistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de59e5f2-4d9b-3cff-b8de-2fd00e69ed30",
                                        "entry_id": "f26bb8d5-4bb4-3175-b074-c60da59c98bc",
                                        "glosses": [
                                            "Having or revealing creative skill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f31aca-ebee-4bf8-ac9b-d14281f65501",
                                                "sense_id": "de59e5f2-4d9b-3cff-b8de-2fd00e69ed30",
                                                "text": "He [Abraham Lincoln] leaves for America’s history and biography, so far, not only its most dramatic reminiscence—he leaves, in my opinion, the greatest, best, most characteristic, artistic, moral personality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833de762-6964-3448-9459-cb80448fa28d",
                                        "entry_id": "f26bb8d5-4bb4-3175-b074-c60da59c98bc",
                                        "glosses": [
                                            "Relating to or characteristic of art or artists."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2add632e-443b-447e-ab6d-52bea1c839a5",
                                                "sense_id": "833de762-6964-3448-9459-cb80448fa28d",
                                                "text": "Art should be independent of all clap-trap—should stand alone, and appeal to the artistic sense of eye or ear, without confounding this with emotions entirely foreign to it, as devotion, pity, love, patriotism, and the like."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2274d33-b42f-33a0-bfdb-c244b342b3da",
                                        "entry_id": "f26bb8d5-4bb4-3175-b074-c60da59c98bc",
                                        "glosses": [
                                            "Aesthetically pleasing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ba0e6b-7acc-4229-bebe-ee461dd79687",
                                                "sense_id": "e2274d33-b42f-33a0-bfdb-c244b342b3da",
                                                "text": "To be artistic, that is, to excite the feeling of beauty effectually, the notes must not be all forte or all piano ; and the execution is the finer the more numerous the gradations—supposing these are such as to satisfy other requirements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6970c02c-4e09-34f7-9892-5a93e7b0e839",
