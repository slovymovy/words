                                                "example_id": "4b8f2de9-b9a6-40e7-a35b-df97722696c0",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "Ein depressiver Patient muss sein Antidepressivum auch dann einnehmen, wenn es ihm besser geht."
                                            },
