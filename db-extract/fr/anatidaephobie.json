                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f4cf4df-d08a-46a2-9afe-40fc9877c9d3",
                                "sense_id": "162f0274-d789-3989-9837-b1ff3f3dd3e3",
                                "text": "J’ai aussi appris que l’on pouvait être phobique des canards et que cela porte un nom : l’anatidaephobie !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d14123a-96ba-41cd-aedd-c0b35037db38",
                        "source_entry_id": "d2d82692-8803-30ca-9e79-fc9c173d9f4b",
