                                        "glosses": [
                                            "Deserving of damnation; very bad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad15155-604e-4254-9516-90a98e3ece5a",
                                                "sense_id": "a8600c00-2d36-3a93-81c6-ac8fa870388b",
                                                "text": "That damnable fridge has stopped working again."
                                            },
                                            {
                                                "example_id": "83a980b4-72d4-46b4-b3fc-a7b329d7ca55",
                                                "sense_id": "a8600c00-2d36-3a93-81c6-ac8fa870388b",
                                                "text": "Great God! They were moving! They were rushing swiftly and noiselessly downwards! Black, black as night, huge, ill-defined, semi-human and altogether evil and damnable."
