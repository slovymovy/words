                        "entry_id": "16a8e657-62eb-35aa-9ca9-ce1404eed16a",
                        "glosses": [
                            "Action de nébuliser, de pulvériser un liquide en un nuage de gouttelettes à l’aide d’un nébuliseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702ddf22-852c-44be-babd-03b42f570cca",
                                "sense_id": "da0071ed-116b-3c5e-aa34-594d4c682094",
                                "text": "La nébulisation est fréquemment prescrite aux malades consultant à l’urgence pour une aggravation de leur asthme ou de leur bronchopneumopathie obstructive chronique."
                            },
                            {
                                "example_id": "b40ddc81-2f88-4396-be9f-3bd483d4dccd",
                                "sense_id": "da0071ed-116b-3c5e-aa34-594d4c682094",
                                "text": "La nébulisation est une administration d’un nuage de principe actif dans les voies aériennes supérieures ou inférieures par un solvant liquide (ici le NaCl à 0,9 %) et d’un gaz (ici l’air comprimé ou l’oxygène) ayant respectivement une fonction de vecteur et force motrice"
                            }
                        ]
                    }
