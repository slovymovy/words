                        "sense_id": "cf19c7fd-d7e9-35e7-83e5-af17218c2dd8",
                        "entry_id": "f0e6684b-88a8-3de8-816c-adfd8d532e2a",
                        "glosses": [
                            "gezellig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdda4a23-c115-4dc1-91d4-e4547f3c185b",
                                "sense_id": "cf19c7fd-d7e9-35e7-83e5-af17218c2dd8",
                                "text": "\"Dit markeert einde van besluitvorming tussen Ministers in cosy onderonsjes en ondeugdelijke deals met VS. Voortaan besluiten i.h openbaar.\""
                            },
                            {
                                "example_id": "4f809a26-b4a3-4982-9b06-91a5379d380e",
                                "sense_id": "cf19c7fd-d7e9-35e7-83e5-af17218c2dd8",
                                "text": "In de intieme concertreeks Cosy Winter presenteert Theater De Storm een dubbelconcert met optredens van zanger/gitarist Dick van Altena in zaal 1 en jazzzanger Paul van Kessel, begeleid door pianist Charly Zastrau, in zaal 2. Na een uur wisselt het publiek van zaal. 20.15 uur."
                            }
                        ]
                    }
