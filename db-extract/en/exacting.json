                                        "entry_id": "1a4f3ee6-876e-3876-80d9-3b0b05ec3069",
                                        "glosses": [
                                            "kladoucí velké nároky, vyžadující mnoho úsilí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba45d4a0-c7f1-4e43-a48b-caaa1d12c49c",
                                                "sense_id": "033589cc-7516-3e0c-87a7-62a04c86da50",
                                                "text": "Vozidla postupovala náročným terénem jen těžko vpřed."
                                            },
                                            {
                                                "example_id": "c3d70ed4-bc0a-40cb-85fc-fa6e0b7cc9c7",
                                                "sense_id": "033589cc-7516-3e0c-87a7-62a04c86da50",
                                                "text": "Je dobře, že konečně zjistil, že premiérský post je náročný, ale měl by se naučit pracovat tak, aby mu žilky nepraskaly a neunavoval nás plačtivými vzkazy, které svědčí o neschopnosti delegovat práci a určovat si priority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e633429-4cbb-3455-9acf-f518ad852836",
                                        "entry_id": "1a4f3ee6-876e-3876-80d9-3b0b05ec3069",
                                        "glosses": [
                                            "(člověk) mající velké nároky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b57b746-d59d-4ea5-9fda-85bfaaa13126",
                                                "sense_id": "2e633429-4cbb-3455-9acf-f518ad852836",
                                                "text": "Naše výrobky uspokojí i nejnáročnější zákazníky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
