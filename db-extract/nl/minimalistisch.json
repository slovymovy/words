                ],
                "senses": [
                    {
                        "sense_id": "795c5c90-9ea5-3fa9-bd20-deb3d1aa397b",
                        "entry_id": "7d271903-0d11-3876-b335-06a4b3c2d129",
                        "glosses": [
                            "tot het uiterst minimale, tot het essentiële teruggebracht; van alle overbodigheid bevrijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9015208-f332-4970-a974-cfa0621ae2c3",
                                "sense_id": "795c5c90-9ea5-3fa9-bd20-deb3d1aa397b",
                                "text": "De Berlijnse producer Paul Kalkbrenner zal optreden op het hoofdpodium. Met zijn diepe, minimalistische sound wordt hij in de undergroundscene nog altijd gezien als één van de meest innovatieve elektronica-artiesten en kan hij zich meten aan de grote namen van het genre."
                            },
                            {
                                "example_id": "59b4c050-e9d4-40cc-9701-18a64121618c",
                                "sense_id": "795c5c90-9ea5-3fa9-bd20-deb3d1aa397b",
                                "text": "Onze kamer is minimalistisch ingericht. Zo is er geen bureau of stoel te vinden, al was het laatste fijn geweest. Maar het belangrijkste is natuurlijk een goed bed. Dat ligt helemaal goed. We hebben heerlijk geslapen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d39164ba-f55f-433b-9dd3-36a1e8c0b3d7",
                        "source_entry_id": "7d271903-0d11-3876-b335-06a4b3c2d129",
                        "source_sense_id": "795c5c90-9ea5-3fa9-bd20-deb3d1aa397b",
