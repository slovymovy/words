                "senses": [
                    {
                        "sense_id": "c9504de8-ae6e-3b4a-9815-07d9c00c4cce",
                        "entry_id": "62605fd3-036a-30d5-b74e-48435b7c56df",
                        "glosses": [
                            "chauffeur van een vrachtwagen"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "01d477ee-9fe4-4b36-93fa-b49576e9e68c",
                                "sense_id": "c9504de8-ae6e-3b4a-9815-07d9c00c4cce",
                                "text": "In het Zeeuwse Rilland heeft een vrachtwagenchauffeur zaterdagavond voor nogal wat onrust gezorgd. De Poolse bestuurder van de truck werd al slingerend op de A58 gesignaleerd, waarop de politie werd gealarmeerd. Nog voor de politie de trucker tot stilstand kon dwingen, raakte de man al van de weg."
                            },
                            {
                                "example_id": "53607b6f-fb42-4b61-8d6a-b122689ce5a2",
                                "sense_id": "c9504de8-ae6e-3b4a-9815-07d9c00c4cce",
                                "text": "Een vrachtwagenchauffeur heeft zijn dak eraf gereden bij de Stationstunnel in Den Bosch. De wagen was te hoog om door de tunnel te rijden, maar daar kwam de bestuurder te laat achter. Het zou om een jonge chauffeur gaan die pas net zijn vrachtwagenrijbewijs heeft, maar het bedrijf uit Elshout waar de vrachtwagen van is wil niet verder op details ingaan."
                            },
                            {
                                "example_id": "6f290244-f92a-4f7b-8038-c727e4f29bd5",
                                "sense_id": "c9504de8-ae6e-3b4a-9815-07d9c00c4cce",
                                "text": "Een 57-jarige vrachtwagenchauffeur is vanmorgen op de A12 bij de grens met Duitsland opgepakt, omdat hij een medeweggebruiker heeft bedreigd met een pistool."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce648745-d167-411d-b188-5e879a9c547e",
                        "source_entry_id": "62605fd3-036a-30d5-b74e-48435b7c56df",
                        "source_sense_id": "c9504de8-ae6e-3b4a-9815-07d9c00c4cce",
                        "target_lang_word": "Fernfahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernfahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c54bf5c4-3807-32e1-9ea9-4996d9c8b522",
                                        "entry_id": "0b7e8ee8-30bc-3176-876d-8cabc8ab5ac8",
                                        "glosses": [
                                            "LKW-Fahrer, der einen Fernlastwagen fährt, also Transporte über große Entfernungen durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f63b8fd-a088-49e0-a83c-0161c4bb7c6b",
                                                "sense_id": "c54bf5c4-3807-32e1-9ea9-4996d9c8b522",
                                                "text": "„Diese Berufsidentität mache es Fernfahrern möglich, die enormen Belastungen ihrer Arbeitsbedingungen auszuhalten, erläutert die Stiftung das Forschungsergebnis.“"
                                            },
                                            {
                                                "example_id": "94c15a4c-e379-41f6-9b71-0095df76ddd5",
                                                "sense_id": "c54bf5c4-3807-32e1-9ea9-4996d9c8b522",
                                                "text": "„Da die Fernfahrer eine Gruppe von Spezialisten sind, die ihr eigenes Leben führen und nur mit ihresgleichen verkehren, hätten diese Raststätten es mir möglich gemacht, das Land zu durchqueren, ohne ein einziges Mal mit einem Ortsansässigen zu sprechen.“"
                                            },
                                            {
                                                "example_id": "bfa5747f-6e2c-4bac-804c-d3b124544204",
                                                "sense_id": "c54bf5c4-3807-32e1-9ea9-4996d9c8b522",
                                                "text": "„Aber sie hatte nicht frei, als der Fernfahrer die Gaststube betrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80f17dda-199f-49a6-8ab3-cd51f6418bd8",
                        "source_entry_id": "62605fd3-036a-30d5-b74e-48435b7c56df",
                        "source_sense_id": "c9504de8-ae6e-3b4a-9815-07d9c00c4cce",
                        "target_lang_word": "LKW-Fahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "LKW-Fahrer",
                                "target_lang_code": "de",
