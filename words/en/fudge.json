{
    "word_family": [
        "fudger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c6bd1f0-1a53-3c3c-bb7e-674ae9bd9ad2",
                    "sense_definition": "A type of very sweet candy or confection, usually made from sugar, butter, and milk or cream.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you tried the vanilla <w>fudge</w>? It's delicious!",
                            "target_lang_translations": {
                                "tr": "Vanilyalı <w>fudge</w> denedin mi? Çok lezzetli!"
                            }
                        },
                        {
                            "text": "She made a batch of chocolate <w>fudge</w> for the party.",
                            "target_lang_translations": {
                                "tr": "Parti için bir tepsi çikolatalı <w>fudge</w> yaptı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chocolate fudge"
                    ],
                    "target_lang_definitions": {
                        "tr": "Şeker, tereyağı ve süt veya krema ile yapılan, oldukça tatlı bir şekerleme türü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "fudge",
                                "target_lang_sense_clarification": "Türkçede de genellikle orijinal ismiyle kullanılan, yoğun kıvamlı bir tür sütlü şekerleme."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42d7f344-588c-3296-8384-a91f20eb6271",
                    "sense_definition": "Light or frothy nonsense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not listen to his <w>fudge</w> about the project being finished.",
                            "target_lang_translations": {
                                "tr": "Projenin bittiğine dair <w>saçmalıklarını</w> dinleme."
                            }
                        },
                        {
                            "text": "The entire report was just pure <w>fudge</w>.",
                            "target_lang_translations": {
                                "tr": "Raporun tamamı tamamen <w>saçmalıktan</w> ibaretti."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsense",
                        "rubbish",
                        "baloney"
                    ],
                    "target_lang_definitions": {
                        "tr": "Anlamsız, boş veya saçma sözler."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saçmalık",
                                "target_lang_sense_clarification": "Mantıksız veya değeri olmayan sözler için kullanılır."
                            },
                            {
                                "target_lang_word": "abuk sabuk",
                                "target_lang_sense_clarification": "Anlamsız ve tutarsız konuşmalar için kullanılan bir ifade."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01d78159-765b-3772-a237-85785427b202",
                    "sense_definition": "To alter something from its true state, as to hide a flaw or uncertainty, deliberately but not necessarily dishonestly or immorally.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The results of the experiment looked impressive, but it turned out the numbers had been <w>fudged</w>.",
                            "target_lang_translations": {
                                "tr": "Deney sonuçları etkileyici görünüyordu ama rakamların <w>çarpıtıldığı</w> ortaya çıktı."
                            }
                        },
                        {
                            "text": "I had to <w>fudge</w> the lighting to get the color to look good.",
                            "target_lang_translations": {
                                "tr": "Rengin iyi görünmesini sağlamak için ışıklandırma <w>üzerinde oynamam</w> gerekti."
                            }
                        }
                    ],
                    "synonyms": [
                        "fake",
                        "manipulate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir kusuru veya belirsizliği gizlemek amacıyla bir şeyi gerçeğinden saptırmak veya üzerinde oynamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çarpıtmak",
                                "target_lang_sense_clarification": "Gerçekleri veya verileri kasıtlı olarak değiştirmek anlamında."
                            },
                            {
                                "target_lang_word": "üzerinde oynamak",
                                "target_lang_sense_clarification": "Bir sonucu veya veriyi gizlice değiştirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21ae96ae-6f31-3d7b-9046-2dd5eeddd4ff",
                    "sense_definition": "To try to avoid giving a direct answer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "evasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When I asked them if they had been at the party, they <w>fudged</w>.",
                            "target_lang_translations": {
                                "tr": "Onlara partide olup olmadıklarını sorduğumda, <w>geçiştirdiler</w>."
                            }
                        },
                        {
                            "text": "The politician <w>fudged</w> the question about taxes.",
                            "target_lang_translations": {
                                "tr": "Politikacı, vergilerle ilgili soruyu <w>yuvarlak cevaplarla geçiştirdi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "equivocate",
                        "hedge",
                        "waffle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Doğrudan cevap vermekten kaçınmaya çalışmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçiştirmek",
                                "target_lang_sense_clarification": "Net bir cevap vermekten kaçınarak konuyu savuşturmak."
                            },
                            {
                                "target_lang_word": "yuvarlak konuşmak",
                                "target_lang_sense_clarification": "Belirsiz ifadeler kullanarak net bir yanıt vermemek."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f08db841-5bf7-3ddc-9cec-bf2d0ff45521",
                    "sense_definition": "Nonsense; tommyrot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh, <w>fudge</w>! Don't lecture me.",
                            "target_lang_translations": {
                                "tr": "Ah, <w>saçmalama</w>! Bana nutuk çekme."
                            }
                        },
                        {
                            "text": "<w>Fudge</w>! I forgot my keys again.",
                            "target_lang_translations": {
                                "tr": "<w>Kahretsin</w>! Anahtarlarımı yine unuttum."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsense",
                        "rubbish"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a mild expletive."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Saçmalık; anlamsızlık. Hafif bir küfür veya ünlem olarak kullanılır."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hadi oradan",
                                "target_lang_sense_clarification": "İnanılmayan veya saçma bulunan bir duruma verilen tepki."
                            },
                            {
                                "target_lang_word": "saçmalama",
                                "target_lang_sense_clarification": "Söylenenlerin anlamsız olduğunu belirten bir ünlem."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bf5cb28f-cb0c-34c9-89ca-32b9ed03683c",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The book was written by Mr. <w>Fudge</w>.",
                            "target_lang_translations": {
                                "tr": "Kitap Bay <w>Fudge</w> tarafından yazılmış."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Fudge</w> yesterday.",
                            "target_lang_translations": {
                                "tr": "Dün Sarah <w>Fudge</w> adında bir kadınla tanıştım."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Fudge",
                                "target_lang_sense_clarification": "Özel isim olduğu için Türkçede de aynı şekilde yazılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}