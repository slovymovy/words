                    {
                        "translation_id": "88964e53-53e5-4a9d-a3fe-825ce7f100c8",
                        "source_entry_id": "80f60ba2-e6c4-3232-b3cb-6f350312fc5a",
                        "source_sense_id": "503b4216-0724-3ffa-8097-fa69ffa39f7e",
                        "target_lang_word": "Eisbrecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisbrecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80e61b94-ee55-393a-943d-9c76639206f1",
                                        "entry_id": "589a5c4c-045e-348b-a799-70824597fa9f",
                                        "glosses": [
                                            "Spezialschiff, das in der Lage ist Eis zu brechen und so das Zufrieren von Schifffahrtsrouten verhindert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0bed3f9-5893-408b-af20-4a7bd0a963a1",
                                                "sense_id": "80e61b94-ee55-393a-943d-9c76639206f1",
                                                "text": "Siehst Du, wie ein Eisbrecher arbeitet?"
                                            },
                                            {
                                                "example_id": "3901e9c9-68d7-49e7-9c30-d3a0433a04bd",
                                                "sense_id": "80e61b94-ee55-393a-943d-9c76639206f1",
                                                "text": "Eisbrecher haben eine speziell verstärkte Außenwand, um den gewaltigen Kräften des Eises zu widerstehen."
                                            },
                                            {
                                                "example_id": "e3e5bf06-9697-4984-9c73-c58ded9bb52e",
                                                "sense_id": "80e61b94-ee55-393a-943d-9c76639206f1",
                                                "text": "Eisbrecher sind für die Handelsschifffahrt von enormer Bedeutung."
                                            },
                                            {
                                                "example_id": "a37c991d-b6a6-437a-990c-888242c7bf8a",
                                                "sense_id": "80e61b94-ee55-393a-943d-9c76639206f1",
                                                "text": "„Eisbrecher gibt es hier nicht, jedes Schiff muss sich selbst eine Gasse bahnen.“"
                                            },
                                            {
                                                "example_id": "e57d736d-e15c-4c0b-a625-d120c31df0d2",
                                                "sense_id": "80e61b94-ee55-393a-943d-9c76639206f1",
                                                "text": "„Finnland ist vor allem bekannt für seine Eisbrecher und Kreuzfahrtschiffe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea5a0473-0cbc-3787-a7b9-d508b926432a",
                                        "entry_id": "589a5c4c-045e-348b-a799-70824597fa9f",
                                        "glosses": [
                                            "Schutzvorrichtung gegen Beschädigungen durch Eisgang (zum Beispiel bei Brücken)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3bc0b20-ab48-4035-9320-25e372b3ebca",
                        "source_entry_id": "80f60ba2-e6c4-3232-b3cb-6f350312fc5a",
                        "source_sense_id": "503b4216-0724-3ffa-8097-fa69ffa39f7e",
                        "target_lang_word": "ледокол",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ледокол",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bb7f7324-0943-3ea7-876d-b533ab1a649e",
                                        "entry_id": "fdeaade5-c9cf-3498-b8aa-c433f4568aa4",
                                        "glosses": [
                                            "самоходное специализированное судно, предназначенное для раскалывания льдов с целью поддержания навигации в замерзающих бассейнах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4914c7d0-62d4-4e81-8dae-c348d85c97e2",
                                                "sense_id": "bb7f7324-0943-3ea7-876d-b533ab1a649e",
                                                "text": "И вот линейный ледокол пятится кормой к маленькому лесовозу, а вдоль бортов у него встают на ребро двухметровые льдины."
                                            },
                                            {
                                                "example_id": "70029e15-6e90-4089-900c-01955e13e1f9",
                                                "sense_id": "bb7f7324-0943-3ea7-876d-b533ab1a649e",
                                                "text": "Пробиваясь через ледовую целину, через неделю ледокол прибыл на Гурьевский рейд к месту стоянки замёрзших судов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
