                {
                    "sense_id": "854b0efa-276b-3ad3-b2e3-a450b48e2f6b",
                    "sense_definition": "Передняя часть головы человека.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Холодный ветер дул нам прямо в <w>лицо</w>, заставляя щуриться от снега.",
                            "target_lang_translations": {
                                "en": "The cold wind blew right into our <w>faces</w>, making us squint from the snow.",
                                "zh": "冷风直吹我们的<w>脸</w>，让我们不得不因雪而眯起眼睛。"
                            }
                        },
                        {
                            "text": "Её красивое <w>лицо</w> озарилось радостной улыбкой при встрече с друзьями.",
                            "target_lang_translations": {
                                "en": "Her beautiful <w>face</w> lit up with a joyful smile when meeting friends.",
                                "zh": "见到朋友时，她美丽的<w>脸</w>上露出了灿烂的笑容。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "выражение лица",
                        "черты лица",
                        "знать в лицо",
                        "к лицу"
                    ],
                    "target_lang_definitions": {
                        "en": "The front part of a human head.",
                        "zh": "人头部的正面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "anatomy"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脸",
                                "target_lang_sense_clarification": "解剖学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4f40d04-1659-326a-8058-dfb787cd68c3",
                    "sense_definition": "Человек как член общества или отдельная личность (обычно в официальной речи).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personhood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вход в это здание разрешён только официальным <w>лицам</w> по специальным пропускам.",
                            "target_lang_translations": {
                                "en": "Entry to this building is permitted only to official <w>persons</w> with special passes.",
                                "zh": "该大楼仅允许持特别通行证的官方<w>人士</w>进入。"
                            }
                        },
                        {
                            "text": "Директор выступил с торжественной речью от <w>лица</w> всей нашей компании.",
                            "target_lang_translations": {
                                "en": "The director gave a solemn speech on <w>behalf</w> of our entire company.",
                                "zh": "经理代表我们整个公司发表了庄重的演讲。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "должностное лицо",
                        "частное лицо",
                        "доверенное лицо",
                        "от лица"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "official"
                        }
                    ],
                    "target_lang_definitions": {
