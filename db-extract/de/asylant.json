                "senses": [
                    {
                        "sense_id": "f6d23338-377f-380c-a0fd-92e14788782d",
                        "entry_id": "22917d06-3758-328b-8096-c4b96a3e7436",
                        "glosses": [
                            "Person, die um Asyl bittet oder ein Recht auf Asyl zuerkannt bekommen hat"
                        ],
                        "tags": [
                            "gelegentlich pejorativ"
                        ],
                        "examples": [
                            {
                                "example_id": "5d4f5237-1d26-48df-b7a4-a53fe2f571b7",
                                "sense_id": "f6d23338-377f-380c-a0fd-92e14788782d",
                                "text": "In Deutschland gibt es viele Asylanten aus Nahost."
                            },
                            {
                                "example_id": "bf5e8aca-c126-4e83-a605-07a11bc96503",
                                "sense_id": "f6d23338-377f-380c-a0fd-92e14788782d",
                                "text": "Im Sprechen über Flüchtlinge lässt sich die demagogische Macht von Sprache immer wieder nachweisen. Gerade in diesem Themenfeld gibt es viele Wörter, die mehr über den aussagen, der sie verwendet, als über den Menschen, den sie bezeichnen. Neger ist so ein Wort. Und Zigeuner. Oder Asylant."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c525613-bd54-479e-bb7d-0855e8e4a596",
                        "source_entry_id": "22917d06-3758-328b-8096-c4b96a3e7436",
                        "source_sense_id": "f6d23338-377f-380c-a0fd-92e14788782d",
                        "source_sense_description": "Person, die um Asyl bittet oder ein Recht auf Asyl zuerkannt bekommen hat",
                        "target_lang_word": "asylum seeker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asylum seeker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                        "entry_id": "c51220bb-dc53-3f98-a72e-1e933540d1d4",
                                        "glosses": [
                                            "A person who has applied for asylum in a foreign country but has not yet been granted refugee status by that country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d503a8e4-2404-4e00-9ea8-b9730bd7ea0d",
                                                "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                                "text": "He stayed with friends and even spent a few nights in a hotel when had nowhere else to go. In September 2019, he moved into a flat with three other gay asylum seekers through Le Refuge, an organisation supporting isolated LGBTQI+ youth."
                                            },
                                            {
                                                "example_id": "57913538-0703-4206-99d3-ef1d92b0c31d",
                                                "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                                "text": "In Manchester and in Aldershot in Hampshire, asylum seeker accommodation was targeted by demonstrators carrying placards that read “deport them, don’t support them” and “no apartments for illegals”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8da8d3b-b6b8-491e-8f4b-b4e318e80b03",
                        "source_entry_id": "22917d06-3758-328b-8096-c4b96a3e7436",
                        "source_sense_id": "f6d23338-377f-380c-a0fd-92e14788782d",
