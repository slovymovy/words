                        "examples": [
                            {
                                "example_id": "37786e9a-ed18-47ab-a737-c16db90557a2",
                                "sense_id": "fb2d46bc-7008-3b54-a800-c4aeed7122e5",
                                "text": "I told her that if she wanted to get rid of her depression she might have to “unforgive” for a while, to get in touch with her anger."
                            },
                            {
                                "example_id": "9f5c70ee-b442-40c4-ba5a-a905c06c3bee",
                                "sense_id": "fb2d46bc-7008-3b54-a800-c4aeed7122e5",
                                "text": "He called the “forgiven” servant back to him and confronted him with the ingratitude and inequity of his behavior, and then he unforgave his debt! He threw the man into prison, waiting to repay his formerly forgiven debt."
                            }
                        ]
