                    "sense_id": "47cc5fa6-95cf-300d-ab8e-389801b39a8a",
                    "sense_definition": "simple past and past participle of <w>acquit</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury <w>acquitted</w> the defendant after hearing all the evidence.",
                            "target_lang_translations": {
                                "nl": "De jury heeft de verdachte <w>vrijgesproken</w> na het horen van al het bewijsmateriaal."
                            }
                        },
                        {
                            "text": "He was <w>acquitted</w> of all charges due to a lack of proof.",
                            "target_lang_translations": {
                                "nl": "Hij werd van alle aanklachten <w>vrijgesproken</w> wegens gebrek aan bewijs."
                            }
                        }
                    ],
                    "synonyms": [
                        "exonerated",
                        "cleared"
                    ],
                    "antonyms": [
                        "convicted"
                    ],
                    "common_phrases": [
                        "acquitted of charges"
                    ],
                    "target_lang_definitions": {
                        "nl": "Vrijgesproken; officieel onschuldig bevonden door een rechtbank."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vrijgesproken",
                                "target_lang_sense_clarification": "juridische term voor onschuldig bevonden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5d23abf-d113-3d77-a273-4277bea1144b",
                    "sense_definition": "Having been found not guilty in a court of law.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>acquitted</w> man walked out of the courtroom a free person.",
                            "target_lang_translations": {
                                "nl": "De <w>vrijgesproken</w> man liep als een vrij persoon de rechtszaal uit."
                            }
                        },
                        {
                            "text": "The <w>acquitted</w> defendant returned to his family after the long trial.",
                            "target_lang_translations": {
                                "nl": "De <w>vrijgesproken</w> verdachte keerde na het lange proces terug naar zijn familie."
                            }
                        }
                    ],
                    "synonyms": [
                        "exonerated",
                        "innocent"
                    ],
                    "antonyms": [
                        "convicted",
                        "guilty"
                    ],
                    "common_phrases": [
