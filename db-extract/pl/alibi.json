                    {
                        "translation_id": "4d621adb-559a-425b-9f97-ed28e588447b",
                        "source_entry_id": "abdabba9-6932-372a-ae63-d186b7c76c43",
                        "source_sense_id": "69186041-50e4-3ad3-bafd-41b173601772",
                        "target_lang_word": "Alibi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
