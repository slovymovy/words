                "senses": [
                    {
                        "sense_id": "f3ae043e-cd22-327d-adb9-10edcf575e8d",
                        "entry_id": "5f8ff8f7-69f8-39b8-86dc-ac68d152608f",
                        "glosses": [
                            "Kalkablagerung mit knolligem oder schaligem Aufbau, die durch marine benthische Cyanobakterien gebildet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8020ee38-0835-4789-aee4-f65cd66059db",
                                "sense_id": "f3ae043e-cd22-327d-adb9-10edcf575e8d",
                                "text": "Auch heute kommen Stromatolithen noch vereinzelt vor."
                            },
                            {
                                "example_id": "95c6a66a-31ea-4e3d-ad11-0b89d3718dc6",
                                "sense_id": "f3ae043e-cd22-327d-adb9-10edcf575e8d",
                                "text": "Einige der gefundenen Moleküle seien typisch für Cyanobakterien - also genau die Organismen, die Stromatolithen bilden."
                            },
                            {
                                "example_id": "ea44c2f0-088e-4fc5-b6d6-0e32b1201ea1",
                                "sense_id": "f3ae043e-cd22-327d-adb9-10edcf575e8d",
                                "text": "Die Stromatolithen entstanden ab dem Präkambrium, durch das Anschwemmen der Kalziumkarbonat Teilchen im Meerwasser, welche sich an die Fäden der blau grünen Algen festsetzten."
                            },
                            {
                                "example_id": "5ae22ffa-4155-4c94-bbb3-578068279ad2",
                                "sense_id": "f3ae043e-cd22-327d-adb9-10edcf575e8d",
                                "text": "Der älteste bisher bekannte Stromatolith wurde in Australien gefunden, er ist fast 3,6 Milliarden Jahre alt."
                            },
                            {
                                "example_id": "30e9a46e-3f8c-4104-b7bf-438b83a90272",
                                "sense_id": "f3ae043e-cd22-327d-adb9-10edcf575e8d",
                                "text": "Etwa zeitgleich entstanden spongiostromate Stromatolithe in hyperhalinen, ephemeren Küstenplaya-Seen sowie in kleinen, wiederholt austrocknenden Seen. Im Obereozän sind Stromatolithe aus peritidalen Playa-Seen und Cyanoide/spongiostromate Onkoide aus rein lakustrinen Becken bekannt."
                            },
                            {
                                "example_id": "6964ba54-589d-4e6e-ade5-01dd6680ea11",
                                "sense_id": "f3ae043e-cd22-327d-adb9-10edcf575e8d",
                                "text": "„Lebende Stromatolithen säumen die australische Shark Bay.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "147a1c83-ac53-47e2-9072-b173f8568b64",
                        "source_entry_id": "5f8ff8f7-69f8-39b8-86dc-ac68d152608f",
                        "source_sense_id": "f3ae043e-cd22-327d-adb9-10edcf575e8d",
                        "source_sense_description": "Kalkablagerung, die durch marine benthische Cyanobakterien gebildet werden",
                        "target_lang_word": "stromatolite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stromatolite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11ea87e9-4d29-348a-a9de-ae9d2d69ee74",
                                        "entry_id": "e786180c-fe30-3d75-a70d-7cb815465fe1",
                                        "glosses": [
                                            "A laminated, columnar, rock-like structure constituting a large share of all fossils from 3.5 to 0.5 billion years ago, with some still being formed at present, some or all of which result from the deposit of minerals by microorganisms such as cyanobacteria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc4d2285-edb0-4997-a5e5-e1822ad720b0",
                                                "sense_id": "11ea87e9-4d29-348a-a9de-ae9d2d69ee74",
                                                "text": "Most modern and ancient stromatolites occur in carbonate sediments and sedimentary rocks, but they can form by trapping and binding of any sediment particles."
                                            },
                                            {
                                                "example_id": "37e9e6b9-62a3-476e-83d0-d73cd27bf3f9",
                                                "sense_id": "11ea87e9-4d29-348a-a9de-ae9d2d69ee74",
                                                "text": "2003, David M. Paterson, Rebecca J. Aspden, R. Pamela Reid, Biodynamics of Modern Marine Stromatolites, Andrew H. Knoll, Life on a Young Planet: The First Three Billion Years of Evolution on Earth, page 44,\nStromatolites are the predominant features of carbonate rocks formed in Precambrian oceans."
                                            },
                                            {
                                                "example_id": "3b2a1d9c-e5b8-4b35-9c9f-cb9c6bac5c74",
                                                "sense_id": "11ea87e9-4d29-348a-a9de-ae9d2d69ee74",
                                                "text": "The formation of modern stromatolites is highly dependent on sediment accretion rates and their associated microbial assemblages that trap and bind sediment particles that fall on the surface of the structures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
