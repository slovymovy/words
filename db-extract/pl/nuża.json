                    {
                        "form_id": "4b334fe9-9cff-49f9-93ab-1b84c1f6b605",
                        "entry_id": "e463c2e7-35ff-38c9-91f7-a8fbb65fec7a",
                        "tags": [
                            "plural",
                            "vocative"
                        ],
                        "form": "nuże"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0e10320-db86-3989-95fe-6bc85051f5bc",
                        "entry_id": "e463c2e7-35ff-38c9-91f7-a8fbb65fec7a",
                        "glosses": [
                            "weariness (exhaustion, fatigue, or tiredness)"
                        ],
                        "tags": [
                            "feminine",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bac79736-a9e7-477a-9c77-78affe29cd7d",
                                "sense_id": "f0e10320-db86-3989-95fe-6bc85051f5bc",
                                "text": "Gdy się miesiąc na niebie za dawnych ćmił czasów,\nDźwiękiem miednic i głosem hucznych tołombasów\nPomagali mu ludzie, żeby owym grzmotem\nMógł się swoim w tej nuży pokrzepić obrotem.",
                                "translation": "When the moon in the sky darkened in ancient times,\nWith the sound of basins and the voice of thunderous trumpets\nPeople helped it, so that with that thunder\nHe could refresh himself in his weariness by turning.",
                                "english": "When the moon in the sky darkened in ancient times,\nWith the sound of basins and the voice of thunderous trumpets\nPeople helped it, so that with that thunder\nHe could refresh himself in his weariness by turning."
                            },
                            {
                                "example_id": "0de42b5e-db29-47bf-b1ea-664e21d6f081",
                                "sense_id": "f0e10320-db86-3989-95fe-6bc85051f5bc",
                                "text": "[s. 208 w. 8]\nWyſpi śię na Kamieniu Pieſzczoch pod czas nuże.\n[s. 216 w. 17–18]\nFraſzka Łabędźie puchy, nuża rzecze z głodem\nTrawę mchem, cukrem rzepę wodę czyni miodem,",
                                "translation": "[p. 208 l. 8]\nThe cuddly one will sleep on a stone during weariness.\n[p. 216 l. 17–18]\nA trifle of swan fluff, weariness speaks with hunger\nThey turn grass into moss, turnips into sugar, water into honey,",
                                "english": "[p. 208 l. 8]\nThe cuddly one will sleep on a stone during weariness.\n[p. 216 l. 17–18]\nA trifle of swan fluff, weariness speaks with hunger\nThey turn grass into moss, turnips into sugar, water into honey,"
                            },
                            {
                                "example_id": "e428e004-b788-4903-ab2f-98d8b5b4a07c",
                                "sense_id": "f0e10320-db86-3989-95fe-6bc85051f5bc",
                                "text": "Tam nużą drogi strudzony,\nChciał zasnąć uspokojony.",
                                "translation": "There worn out from the weariness of the road,\nHe wanted to fall asleep calmed down.",
                                "english": "There worn out from the weariness of the road,\nHe wanted to fall asleep calmed down."
                            },
                            {
                                "example_id": "4f1234ed-eda1-4f31-9dbd-8213938effd4",
                                "sense_id": "f0e10320-db86-3989-95fe-6bc85051f5bc",
                                "text": "I miałem wytchnąć po wielu lat nuży,",
                                "translation": "And I was about to take a break after many years of weariness,",
                                "english": "And I was about to take a break after many years of weariness,"
                            },
                            {
                                "example_id": "7012659b-b8f8-4133-a149-460752ffdcb5",
                                "sense_id": "f0e10320-db86-3989-95fe-6bc85051f5bc",
                                "text": "Tak i ja w samym mego wieku kwiecie,\nGdy przykrość martwi, a szczęście nie służy,\nPrawie nie czułem, iżem żył na świecie,\nW tęskliwej nuży.",
                                "translation": "So too at my prime,\nWhen sorrow troubles me and happiness fails,\nI scarcely felt that I lived in the world,\nIn longing weariness.",
                                "english": "So too at my prime,\nWhen sorrow troubles me and happiness fails,\nI scarcely felt that I lived in the world,\nIn longing weariness."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b5b56fe-728e-3a23-8fa4-4862a9e7df07",
                        "entry_id": "e463c2e7-35ff-38c9-91f7-a8fbb65fec7a",
                        "glosses": [
                            "wearing thing"
                        ],
                        "tags": [
                            "countable",
                            "feminine",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0eab6d46-abab-46e3-92a5-e933b9682250",
                                "sense_id": "3b5b56fe-728e-3a23-8fa4-4862a9e7df07",
                                "text": "Umysł, y práwdziwy cel Monarchow iest ochraniáć, y utrzymywać polnych robotnikow, y wieśniákow, bo ći rzeczywiśćie dzienne upały, y nocne wytrzymuią nuże, wielką część włożonych ná Krolestwo ciężárow dźwigaią.",
                                "translation": "The mind, and the true purpose of the Monarchs is to protect, and support the field workers, and peasants, because they truly endure the heat of the day, and the wearing nights, and bear a large part of the burdens placed on the Kingdom.",
                                "english": "The mind, and the true purpose of the Monarchs is to protect, and support the field workers, and peasants, because they truly endure the heat of the day, and the wearing nights, and bear a large part of the burdens placed on the Kingdom."
                            },
                            {
                                "example_id": "fb105d04-a895-4128-bc9a-dc5d2111c6a0",
                                "sense_id": "3b5b56fe-728e-3a23-8fa4-4862a9e7df07",
                                "text": "Já zaś gdy dla mych dziatek wiek ciągnę w tey nuży,\nZyię bym ſię trapiła, bym konała dłuży.",
                                "translation": "As for me, when I endure in this wearing for my children,\nI live, so I can suffer, so I can die for longer.",
                                "english": "As for me, when I endure in this wearing for my children,\nI live, so I can suffer, so I can die for longer."
                            },
                            {
                                "example_id": "122faa58-574e-478e-9ba9-1c0310077e3c",
                                "sense_id": "3b5b56fe-728e-3a23-8fa4-4862a9e7df07",
                                "text": "D’un autre côté, on le voit couché\nlanguissamment sur un lit de roses.\n[…]\nNous tombâmes de lassitude,\net ce repos même nous parut insupportable.",
                                "translation": "In another place we see him laid\nlanguishingly on a bed of roses.\n[…]\nWe sunk down with lassitude,\nAnd even this repose appeared insupportable.",
                                "english": "In another place we see him laid\nlanguishingly on a bed of roses.\n[…]\nWe sunk down with lassitude,\nAnd even this repose appeared insupportable."
                            },
                            {
                                "example_id": "c8e1f8ef-8137-4f10-bdcf-56517e965309",
                                "sense_id": "3b5b56fe-728e-3a23-8fa4-4862a9e7df07",
                                "text": "Tāle tuum carmen nōbīs, dīvīne Poēta,\nQuāle sopor fessīs in grāmine, quāle per aestum",
                                "translation": "Such is thy song to me, divine poet,\nAs sleep to tired ones on the grass,",
                                "english": "Such is thy song to me, divine poet,\nAs sleep to tired ones on the grass,"
                            },
                            {
                                "example_id": "bf4af7e0-ac70-4d8a-89a5-13d4040be8a5",
                                "sense_id": "3b5b56fe-728e-3a23-8fa4-4862a9e7df07",
                                "text": "Po takiej deklamacji pobożnej też dzieci miewały inne oracje śmieszne: o poście, o śledziu, o kołaczach wielkanocnych, o nuży szkolnej[,] i inne tym podobne.",
                                "translation": "After such pious declamation the children also had other funny orations: about fasting, about herring, about Easter cakes, about school wearing[,] and other such things.",
                                "english": "After such pious declamation the children also had other funny orations: about fasting, about herring, about Easter cakes, about school wearing[,] and other such things."
                            }
                        ]
                    }
                ],
