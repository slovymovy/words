                                        "glosses": [
                                            "Phénomène de fissuration plus ou moins superficielle de corps rigides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa482922-2524-4ce2-a4cf-6e0f772f88bf",
                                                "sense_id": "02567e39-ae5f-3d07-bfa7-275f8e950b86",
                                                "text": "Elles sont aussi très vulnérables, car le faïençage qui se développe au cœur du béton facilite l’accès à l’oxygène et à l’eau."
                                            },
                                            {
                                                "example_id": "468d215d-3ec0-4b83-bff2-f0bd7397b09d",
                                                "sense_id": "02567e39-ae5f-3d07-bfa7-275f8e950b86",
                                                "text": "Dans 10 % des cas, la rupture a pour origine un faïençage par fatigue thermique, les autres cas de rupture étant dus à des surcharges, des défauts de solidification, etc."
                                            },
                                            {
                                                "example_id": "ff7add64-84ee-4fa1-8cc4-defdcd935e82",
                                                "sense_id": "02567e39-ae5f-3d07-bfa7-275f8e950b86",
                                                "text": "Il se forme alors une flache qui s'accompagne le plus souvent d'un faïençage, de remontées de fines et pouvant évoluer très rapidement vers le départ des matériaux (nid-de-poule)."
                                            }
                                        ]
                                    }
