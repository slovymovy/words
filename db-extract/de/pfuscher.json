                                "target_senses": [
                                    {
                                        "sense_id": "a94b0344-abf3-3f08-b526-5aff5ac91773",
                                        "entry_id": "556c0c06-8c33-3b77-a4fc-7e42191b7b18",
                                        "glosses": [
                                            "Someone who makes mistakes because of incompetence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71873a14-5708-4d52-9cd7-d51b9d26f797",
                                                "sense_id": "a94b0344-abf3-3f08-b526-5aff5ac91773",
                                                "text": "\"What you mean, comparing me to them botchers and bunglers? There ain't anybody but me in the furniture restoring line.\""
                                            },
                                            {
                                                "example_id": "ed7feec9-6714-4207-bebf-cbc9b6cc2146",
                                                "sense_id": "a94b0344-abf3-3f08-b526-5aff5ac91773",
                                                "text": "Noble Prophet of Truth, this has gone on long enough. Make an example of this bungler. The Council demands it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
