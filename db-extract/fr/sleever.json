                        "entry_id": "e30f84b9-e86e-3607-a52d-509d9e3fef7f",
                        "glosses": [
                            "Protéger une ou plusieurs cartes au moyen de pochettes plastiques transparentes et ajustées."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c0758903-c4d4-4f09-a88d-ef7a78501292",
                                "sense_id": "de4bd235-5505-3ea1-9316-af09042a20d1",
                                "text": "Sleever les cartes joueurs n'a pas d'intérêt dans la mesure où, certaines cartes étant beaucoup plus jouées que d'autres, il y aura, à long terme, des différences d'usure des protège cartes."
                            }
                        ]
                    }
