                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d4264c-435d-43c5-ac46-7fb85cf2259e",
                                                "sense_id": "ec0b1f64-3f3e-35fb-b842-2c7d13891814",
                                                "text": "Great! Thanks for the wonderful work."
                                            },
                                            {
                                                "example_id": "c5ede5f2-ca2a-4c27-afa5-47b5de70f5d6",
                                                "sense_id": "ec0b1f64-3f3e-35fb-b842-2c7d13891814",
