                "translations": [
                    {
                        "translation_id": "f58ed631-60a0-4971-9f15-22888bec4f2f",
                        "source_entry_id": "82a996ee-f0c1-38cd-a05e-bfbcb0bef267",
                        "source_sense_id": "15044367-13c9-3708-8940-4120e81c88e9",
                        "source_sense_description": "een spreuk waarnaar iemand zijn leven inricht",
                        "target_lang_word": "Wahlspruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "09dd2c26-6bc7-4070-9519-ac578189094f",
                        "source_entry_id": "82a996ee-f0c1-38cd-a05e-bfbcb0bef267",
                        "source_sense_id": "15044367-13c9-3708-8940-4120e81c88e9",
                        "source_sense_description": "een spreuk waarnaar iemand zijn leven inricht",
                        "target_lang_word": "motto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eeaa30af-f4b6-3bba-9366-63345a32b093",
                                        "entry_id": "b09378b1-3a29-33f8-b031-24b350cb9272",
                                        "glosses": [
                                            "A personal slogan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75140f05-c3a1-4f65-91c8-20616cc5b1b8",
                                                "sense_id": "eeaa30af-f4b6-3bba-9366-63345a32b093",
                                                "text": "You have to be in it to win it — that's my motto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33ea2d23-f5a4-39d2-a243-30114a42b8ca",
                                        "entry_id": "b09378b1-3a29-33f8-b031-24b350cb9272",
                                        "glosses": [
                                            "A sentence, phrase, or word, forming part of an heraldic achievement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b743a9e-0592-4981-872d-4dc9793b0750",
                                                "sense_id": "33ea2d23-f5a4-39d2-a243-30114a42b8ca",
                                                "text": "‘Gentlemen, I can tell you what the new queen will take as her motto. It is Bound to Obey and Serve.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5070fed2-c1a1-332c-a00c-490b3990f9bd",
                                        "entry_id": "b09378b1-3a29-33f8-b031-24b350cb9272",
                                        "glosses": [
                                            "A sentence, phrase, or word, prefixed to an essay, discourse, chapter, canto, or the like, suggestive of its subject matter; a short, suggestive expression of a guiding principle; a maxim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "527e794a-3e84-4694-aa16-7cd1496db7b4",
                                                "sense_id": "5070fed2-c1a1-332c-a00c-490b3990f9bd",
                                                "text": "It was the motto of a bishop eminent for his piety and good works, ... Serve God, and be cheerful."
                                            },
                                            {
                                                "example_id": "7ed110cd-50d4-45f3-9cbe-a49f86b69d9f",
                                                "sense_id": "5070fed2-c1a1-332c-a00c-490b3990f9bd",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes like\n Here's rattling good luck and roaring good cheer, / With lashings of food and great hogsheads of beer. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aabca997-a8ba-3578-ba54-32b48107c70e",
                                        "entry_id": "b09378b1-3a29-33f8-b031-24b350cb9272",
                                        "glosses": [
                                            "A paper packet containing a sweetmeat, cracker, etc., together with a scrap of paper bearing a motto."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "motto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f72bc62-6827-3e47-897e-713904f23590",
                                        "entry_id": "e425b599-6eef-322b-9a8e-6686d31b99c3",
                                        "glosses": [
                                            "To compose mottos."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7905f24-8ce6-4a85-8a6d-612e4af55be9",
                                                "sense_id": "3f72bc62-6827-3e47-897e-713904f23590",
                                                "text": "The singularity of his epigraphic strategy notwithstanding, Emerson does not draw attention to his own mottoing. One exchange suggests that his practice was a convention imposed from without."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7c26087-fb6d-4315-8a6d-eab81f918350",
                        "source_entry_id": "82a996ee-f0c1-38cd-a05e-bfbcb0bef267",
                        "source_sense_id": "15044367-13c9-3708-8940-4120e81c88e9",
                        "source_sense_description": "een spreuk waarnaar iemand zijn leven inricht",
                        "target_lang_word": "devise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "devise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1877e67-75b9-36c8-aa31-1bef91e0187c",
                                        "entry_id": "57a174d8-a4e5-378b-a1ea-3e924b2341f1",
                                        "glosses": [
                                            "Figure accompagnée d’une phrase exprimant d’une manière allégorique et brève quelque pensée, quelque sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6301015-0744-41a2-a1c4-e12ad308e6f7",
                                                "sense_id": "a1877e67-75b9-36c8-aa31-1bef91e0187c",
                                                "text": "La devise de Louis XIV était un soleil qui éclaire un monde, avec ces mots : Nec Pluribus Impar."
                                            },
                                            {
                                                "example_id": "db1e46ae-2a2a-416d-9ff8-24168c43f363",
                                                "sense_id": "a1877e67-75b9-36c8-aa31-1bef91e0187c",
                                                "text": "Choisir une devise."
                                            },
                                            {
                                                "example_id": "1a30ce88-5b8c-4109-965f-4038cad03bc9",
                                                "sense_id": "a1877e67-75b9-36c8-aa31-1bef91e0187c",
                                                "text": "On se répétait à Orsenna le défi de sa devise insolente : « Fines transcendant », et on ne manquait guère d’en nuancer l’énoncé d’ironie en se rappelant pour combien de ses membres exilés elle avait pris souvent un sens amèrement concret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "015d6fef-797b-3d55-b050-041d1f412bd5",
                                        "entry_id": "57a174d8-a4e5-378b-a1ea-3e924b2341f1",
                                        "glosses": [
                                            "Sentence qui accompagne les armoiries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3504d2c-182b-4297-a1cd-6b565e68df94",
                                                "sense_id": "015d6fef-797b-3d55-b050-041d1f412bd5",
                                                "text": "Il fit inscrire sa devise parmi celle des combattants, en cachant son visage et son nom, comme la loi l’ordonnait."
                                            },
                                            {
                                                "example_id": "8ecefc45-dc31-4521-a385-22c89125e5b6",
                                                "sense_id": "015d6fef-797b-3d55-b050-041d1f412bd5",
                                                "text": "\"Je charme tout\" ! murmura Capestang. La fameuse devise de Marie Touchet, maîtresse de Charles IX, mère du duc d’Angoulême !..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b0919d-d2ac-3172-81fe-2477a714b206",
                                        "entry_id": "57a174d8-a4e5-378b-a1ea-3e924b2341f1",
                                        "glosses": [
                                            "Fasce réduite posée en chef."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e38b9b0-69a8-43a5-9985-9874bca63dcd",
                                                "sense_id": "27b0919d-d2ac-3172-81fe-2477a714b206",
                                                "text": "Parti, au premier d’or au dauphin d’azur crêté, barbé, loré, peautré et oreillé de gueules ; au second de gueules aux deux chevrons d’argent surmontés d’une devise du même, qui est de Pusignan dans le Rhône. → voir illustration « armoiries avec devise »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ab17af8-7e6c-31f1-8b79-21873f190102",
                                        "entry_id": "57a174d8-a4e5-378b-a1ea-3e924b2341f1",
                                        "glosses": [
                                            "Un ou plusieurs mots exprimant la manière de penser, de sentir, d’agir de quelqu’un."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c105fe21-26c1-4ff5-a862-7da38d872ee5",
                                                "sense_id": "9ab17af8-7e6c-31f1-8b79-21873f190102",
                                                "text": "Selon Blanc (2005), la devise de la plante serait : «Je pousse donc je suis.»."
                                            },
                                            {
                                                "example_id": "999f8b48-e026-4374-a104-01729326c17d",
                                                "sense_id": "9ab17af8-7e6c-31f1-8b79-21873f190102",
                                                "text": "Je suis un spécimen athée, paresseux, assisté, profiteur et pourri, qui aime se reproduire comme des lapins. Je fais partie du Tiers-Con. Ma devise : Se lever pour une canette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c0158e5-2217-353f-89ea-6018bef8d835",
                                        "entry_id": "57a174d8-a4e5-378b-a1ea-3e924b2341f1",
                                        "glosses": [
                                            "Billets de banque de tel ou tel État."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9462dd10-cdca-4c59-afaf-cc86e61b9132",
                                                "sense_id": "4c0158e5-2217-353f-89ea-6018bef8d835",
                                                "text": "Acheter des devises étrangères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "345319c3-905c-3d1c-ad5a-b43341c93cfc",
                                        "entry_id": "57a174d8-a4e5-378b-a1ea-3e924b2341f1",
                                        "glosses": [
                                            "Monnaie d’un pays étranger ou non."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b478a1fd-4178-41d4-acf4-eeadb8cf979b",
                                                "sense_id": "345319c3-905c-3d1c-ad5a-b43341c93cfc",
                                                "text": "Une devise forte."
                                            },
                                            {
                                                "example_id": "98223fdb-cac5-4d71-812d-f7c4d2aa990c",
                                                "sense_id": "345319c3-905c-3d1c-ad5a-b43341c93cfc",
                                                "text": "Une obligation peut être émise par un État dans sa propre devise - on parle alors d’emprunt d’État - ou une autre devise que la sienne - on parle alors d’obligation souveraine. (Wikipédia, Obligation (finance))"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b53493df-8d55-3755-82c1-69366d4fd0c1",
                                        "entry_id": "57a174d8-a4e5-378b-a1ea-3e924b2341f1",
                                        "glosses": [
                                            "Actif financier dont le cours a valeur monétaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc3f4840-8076-433d-b58f-ecfba26222b3",
                                                "sense_id": "b53493df-8d55-3755-82c1-69366d4fd0c1",
                                                "text": "Une devise en or numérique est une monnaie privée utilisée dans des transactions électroniques, gagée sur une quantité équivalente en or conservée dans un endroit sûr. (Wikipédia, Devise en or numérique)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "918cbac4-48b1-307c-a110-139e33c95c7c",
                                        "entry_id": "57a174d8-a4e5-378b-a1ea-3e924b2341f1",
                                        "glosses": [
                                            "Ligne de démarcation entre propriétés."
                                        ],
                                        "tags": [
                                            "France",
                                            "Poitou"
                                        ],
                                        "examples": []
                                    }
                                ]
