                        "entry_id": "be274746-88cc-34a0-bde3-2d18c322b4d4",
                        "glosses": [
                            "A worker in a sheep-shearing shed."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "f25ce9e0-7bbb-429b-842b-0d7c69fc52e0",
                                "sense_id": "2442ffb9-3eb1-3299-8b7b-3917caadcbb5",
                                "text": "1950, Graziers' Association of New South Wales, The Graziers′ Annual, page 187,\nThus if an employee is engaged as a woolpresser and shedhand he must for the whole of his work be paid at the woolpressers′ weekly rate, since that is higher than the shedhands′ weekly rate."
                            },
                            {
                                "example_id": "55ccd040-78c5-454b-a1c5-de10a2bf9b15",
                                "sense_id": "2442ffb9-3eb1-3299-8b7b-3917caadcbb5",
                                "text": "1980 September 11, Paul Hudson, Technology brings home the wool harvest, New Scientist, page 768,\nThe sheep still have to be mustered and penned in a shed; the shearer still grabs sheep from the pen and shears them; the shedhands remove the fleece and pieces."
                            },
                            {
                                "example_id": "e803e39c-8a90-46fc-a50f-196721ba07ad",
                                "sense_id": "2442ffb9-3eb1-3299-8b7b-3917caadcbb5",
                                "text": "The Board can be kept much cleaner if two shedhands work together."
                            },
                            {
                                "example_id": "3617e60e-c095-4054-acd9-ec2c0e2ae420",
                                "sense_id": "2442ffb9-3eb1-3299-8b7b-3917caadcbb5",
                                "text": "Shearers took the best cook and accommodation, refusing to share either with the shedhand."
                            }
                        ]
                    }
