                ],
                "senses": [
                    {
                        "sense_id": "d95397d1-0185-3cf3-9d76-60669b2dfb7b",
                        "entry_id": "f448324a-ddd1-3319-80a0-af662a71d3c1",
                        "glosses": [
                            "handgriffartig geformter Teil eines Organs oder Knochens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65dd5c3-5bfd-4a0b-815c-d7b91112d044",
                                "sense_id": "d95397d1-0185-3cf3-9d76-60669b2dfb7b",
                                "text": "Anatomisch besteht der Hammer aus Caput (Kopf), Collum (Hals), Manubrium (Hammergriff) und zwei kleinen Fortsätzen am Oberende des Hammergriffes, …"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a6c5dc68-27e9-3f5b-a577-2133557d8495",
                        "entry_id": "f448324a-ddd1-3319-80a0-af662a71d3c1",
                        "glosses": [
                            "der Magenstiel bei Medusen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b512dd74-e428-42f5-a487-5502b50a77d9",
                                "sense_id": "a6c5dc68-27e9-3f5b-a577-2133557d8495",
                                "text": "Quallen sind abgeplattet schirmartig aufgebaut mit einem hängenden Magenstiel (Manubrium), an dessen Unterseite sich eine Mundöffnung befindet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7ee37321-ebd9-3433-8a4f-8d45ccb91f32",
                        "entry_id": "f448324a-ddd1-3319-80a0-af662a71d3c1",
                        "glosses": [
                            "Teil der Sprunggabel bei Springschwänzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b2d452-b678-4bef-8cc3-adbff806ab4c",
                                "sense_id": "7ee37321-ebd9-3433-8a4f-8d45ccb91f32",
                                "text": "Sie besteht aus drei Teilen: dem basalen Manubrium, den langen paarigen Dentes und terminal an diesen je einer kurzen Hakenstruktur, dem Mucro."
                            },
                            {
                                "example_id": "4c296a3a-778e-48dd-bd5a-ca7f99b7d771",
                                "sense_id": "7ee37321-ebd9-3433-8a4f-8d45ccb91f32",
                                "text": "Zwischen Manubrium und Dentes befinden sich cutinisierte „Zähne“, die genau in die Haken des Retinaculums, einer Struktur am dritten Abdominalsegment, hineinpassen und so die Furca ventral am Abdomen unter Spannung festhalten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "e8b4a0e5-4bca-320c-8965-404391d571ab",
                        "entry_id": "f448324a-ddd1-3319-80a0-af662a71d3c1",
                        "glosses": [
                            "Knopf oder Griff in den Registerzügen der Orgel"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "1bb46be8-3c5b-4c06-96f5-c01baf3c7853",
                                "sense_id": "e8b4a0e5-4bca-320c-8965-404391d571ab",
                                "text": "Da die Register in erster Linie von Hand bedient werden, wird der Bereich auch Manubrium (Lat. Manus = die Hand) genannt."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
