                                            {
                                                "example_id": "77a57614-bfeb-414b-b10d-727122af1f43",
                                                "sense_id": "138ac45e-c0fe-333c-962a-411f70db7860",
                                                "text": "The PM’s pet projects are budgeted rather generously"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a0f9710-11a0-32cb-8a88-8fcf09db6ebe",
                                        "entry_id": "93b2e147-7562-3980-9250-156632529d34",
                                        "glosses": [
                                            "To plan for the use of in a budget."
                                        ],
                                        "tags": [
