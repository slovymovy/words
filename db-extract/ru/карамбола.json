                                "target_senses": [
                                    {
                                        "sense_id": "2e64367d-2a15-3bce-87a7-35a03b2d87cd",
                                        "entry_id": "ec77a523-5e1e-3582-8478-9b744ee8998d",
                                        "glosses": [
                                            "A tree species native to southern Asia, Averrhoa carambola."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ad7a07-c5f5-4d5a-b99e-4173c0268fc5",
                                                "sense_id": "2e64367d-2a15-3bce-87a7-35a03b2d87cd",
                                                "text": "The carambola tree bears a sour fruit which makes a good tart, and there is a variety which bears a sweet fruit. The tree, though originally, it is said, from the Moluccas, flourishes well on this Coast, and is quite naturalized."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06699dd0-4ebb-3421-8e80-d8c8fbd64938",
                                        "entry_id": "ec77a523-5e1e-3582-8478-9b744ee8998d",
                                        "glosses": [
                                            "The fruit of this tree, commonly known as star fruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db06d76-4c6a-4518-b15f-45d91a5fdc2b",
                                                "sense_id": "06699dd0-4ebb-3421-8e80-d8c8fbd64938",
                                                "text": "She leans out of sight before coming back with a bowl of something—looks like sliced fresh carambola with salt and chili."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4ba6c6a-33ae-3a97-804b-c10dc4bb71ff",
                                        "entry_id": "ec77a523-5e1e-3582-8478-9b744ee8998d",
                                        "glosses": [
                                            "A yellow colour, like that of a carambola."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
