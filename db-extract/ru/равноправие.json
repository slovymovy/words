                                            {
                                                "example_id": "5c44f8f5-1f65-473b-af61-21c886e2fc7f",
                                                "sense_id": "e5de8c3d-28a9-33ce-86be-32d36b297753",
                                                "text": "Böyle bir eşitlik, ehliyeti olan herkesin en yüksek makamlara çıkabilmesi demek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e57cac2c-80ca-3022-8d28-747c790d189c",
