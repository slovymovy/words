                "forms": [],
                "senses": [
                    {
                        "sense_id": "38b669ec-6ffa-3f64-bf4c-b18e0a529750",
                        "entry_id": "d11a8022-958a-3510-a56c-f4b2f079e364",
                        "glosses": [
                            "ein Haus, in dem arme Leute gegen Arbeit Unterkunft und Essen gewährt wird; Armenhaus"
                        ],
                        "tags": [
                            "British",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "aee6d4a0-362a-4ebe-b6c8-dcabca82d027",
                                "sense_id": "38b669ec-6ffa-3f64-bf4c-b18e0a529750",
                                "text": "\"He was brought up by hand. The hungry and destitute situation of the infant orphan was duly reported by the workhouse authorities to the parish authorities.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0c575ec0-fcb9-30fb-a74c-2466b9106ad0",
                        "entry_id": "d11a8022-958a-3510-a56c-f4b2f079e364",
                        "glosses": [
                            "ein Gefängnis, in welchem die Insassen arbeiten müssen; Zuchthaus"
                        ],
                        "tags": [
                            "amerikanisch"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7ef90534-4fa9-351a-9f20-b8abbbf7052b",
                        "entry_id": "d11a8022-958a-3510-a56c-f4b2f079e364",
                        "glosses": [
                            "Werkstatt"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ad82253-dac3-4297-9ffa-2ebc487923e8",
                        "source_entry_id": "d11a8022-958a-3510-a56c-f4b2f079e364",
                        "source_sense_id": "38b669ec-6ffa-3f64-bf4c-b18e0a529750",
                        "source_sense_description": "Haus, in dem arme Leute gegen Arbeit Unterkunft und Essen gewährt wird",
                        "target_lang_word": "Armenhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armenhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32412dc8-206b-39ec-821f-afd3419ef757",
                                        "entry_id": "4f36232e-59e0-3cae-b44d-611c08f51fbc",
                                        "glosses": [
                                            "Unterkunft für Bedürftige"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4672b78b-e85f-4c42-9974-9da2cb51f8c5",
                                                "sense_id": "32412dc8-206b-39ec-821f-afd3419ef757",
                                                "text": "Sie brachten die Familie im Armenhaus unter."
                                            },
                                            {
                                                "example_id": "7eeaf40f-0fce-4378-af8e-4e4f5b1bf4d4",
                                                "sense_id": "32412dc8-206b-39ec-821f-afd3419ef757",
                                                "text": "„So als habe man sie gerade aus dem Kittchen oder dem Armenhaus entlassen.“"
                                            },
                                            {
                                                "example_id": "8340ff37-e88f-41cc-876a-52520c20604b",
                                                "sense_id": "32412dc8-206b-39ec-821f-afd3419ef757",
                                                "text": "„Nur an seinem Ende, beim Armenhause und der Irrenanstalt standen einige kleine Gruppen in weissen Kitteln herum, und einige ebenso gekleidete Leute gingen über das Feld, schrien und fuchtelten mit den Armen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                        "entry_id": "4f36232e-59e0-3cae-b44d-611c08f51fbc",
                                        "glosses": [
                                            "Gebiet eines Landes/Kontinents/einer Region, das/die sich wirtschaftlich unterdurchschnittlich entwickelt (beispielsweise könnte es ein geringes Wachstum/BIP haben)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "932d31a0-750a-4676-8e48-7a180d46ae99",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Trotzdem bleibt Süditalien lange Zeit das Armenhaus des Landes, und viele wandern nach Amerika aus.“"
                                            },
                                            {
                                                "example_id": "0c8c0b1d-0cda-4e3d-8b93-cd53c1624435",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Kaum eine Gegend in Europa hat in den vergangenen Jahrzehnten einen derartigen Aufstieg erlebt wie Südtirol - vom einstigen Armenhaus zur prosperierenden Region.“"
                                            },
                                            {
                                                "example_id": "30827b7b-b4ff-4916-8e5f-52398176038c",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "[Schlagzeile:] „Vietnam: Vom Armenhaus zum Wirtschaftswunder“"
                                            },
                                            {
                                                "example_id": "c02a5298-ed69-4b7f-b163-7644de9b3465",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Haiti ist ein Armenhaus.“"
                                            },
                                            {
                                                "example_id": "f8e6f6c2-47b2-4830-b176-51a413e2c2cd",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "Wenig Industrie, schlechte Böden: Der Landesteil [Anmerkung: Wales] mit seinen etwa drei Millionen Einwohnern wird auch Armenhaus des Vereinigten Königreichs genannt […]."
                                            },
                                            {
                                                "example_id": "2db11e1e-dce5-4438-8fc3-b2aea72da007",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„In Libyen droht der Staatszerfall, im Jemen, dem arabischen Armenhaus, sprechen die Vereinten Nationen heute von der größten humanitären Katastrophe der Welt.“"
                                            },
                                            {
                                                "example_id": "dfa496fe-eba5-4787-858c-7b579106db56",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Das von Maduro mit harter Hand regierte Venezuela hat zwar die größten Ölreserven der Welt, ist aber zum Armenhaus Südamerikas mutiert.“"
                                            },
                                            {
                                                "example_id": "2cd924b8-a936-41d3-8c0b-08d5bb833772",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "[Simbabwe und sein Ex-Staatschef Robert Mugabe:] „Unter seiner Führung war aus der einstigen Kornkammer der Region ein Armenhaus geworden.“"
                                            },
                                            {
                                                "example_id": "ac959c13-1de6-4353-8f7e-5864ac8a9a42",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Früher galt Puerto Rico als Juwel der Karibik, als Sehnsuchtsort. Diese Zeiten sind vorbei. Heute ist die Insel ein Armenhaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72eec7f9-5b42-45c3-ae4e-45bc698c13b1",
                        "source_entry_id": "d11a8022-958a-3510-a56c-f4b2f079e364",
