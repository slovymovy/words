                    {
                        "translation_id": "7b15903a-8f4f-409e-98a2-3bedc6289dcd",
                        "source_entry_id": "5014f113-cbbd-3561-9136-2e7bdefc39fd",
                        "source_sense_id": "6d478402-507b-303e-b4bf-2e5dd4af5985",
                        "source_sense_description": "Haut-parleur de sous-graves",
