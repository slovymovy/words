                "senses": [
                    {
                        "sense_id": "238d098d-3ec0-328a-90be-a7413a7c451b",
                        "entry_id": "26f347a0-d7b8-3036-aaad-2cd5054a2699",
                        "glosses": [
                            "Faire des graffs ou des graffitis sur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960654a5-d13d-4c3a-8bfd-be633e8bcfd5",
                                "sense_id": "238d098d-3ec0-328a-90be-a7413a7c451b",
                                "text": "Ouais mon vieux, un peu que je l'ai vue, même que je fais partie des petits enculés qu’ont graffé ces putains de métros et bien d'autres endroits encore. Waow, a fait la gueule d'ange. Moi aussi je fais des graffitis, mais je crois pas encore avoir trouvé mon style."
                            },
                            {
                                "example_id": "86cadcc3-e5d5-4d5e-abdf-5d0eab17f0dd",
                                "sense_id": "238d098d-3ec0-328a-90be-a7413a7c451b",
                                "text": "Petit à petit, ils graffaient toujours des mots et des personnages en remontant les quais vers le Trocadéro, où déjà des breakers s'exerçaient."
                            }
                        ]
                    }
                ],
