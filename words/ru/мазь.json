                    "frequency": "High",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач прописал мне специальную <w>мазь</w> от ожогов.",
                            "target_lang_translations": {
                                "en": "The doctor prescribed me a special <w>ointment</w> for burns."
                            }
                        },
                        {
                            "text": "Нанесите эту <w>мазь</w> тонким слоем на больное место.",
                            "target_lang_translations": {
                                "en": "Apply this <w>ointment</w> in a thin layer to the affected area."
                            }
                        }
                    ],
                    "synonyms": [
                        "крем"
                    ],
                    "common_phrases": [
                        "лечебная мазь"
                    ],
                    "target_lang_definitions": {
