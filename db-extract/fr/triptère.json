                        "examples": [
                            {
                                "example_id": "725cc0ae-48af-424a-813c-a1321ef37031",
                                "sense_id": "f11d8731-196f-3e01-9c55-c5beb5476dfa",
                                "text": "Légume long environ d’un pied, subulé, 3-gone, s’ouvrant en 3 valves distinctes et creusées alternativement, sur leur partie moyenne , d’une fossette dans laquelle sont reçues les semences tantôt aptères ou nues, tantôt triptères ou garnies de 3 ailes."
                            },
                            {
                                "example_id": "ee83000d-811c-4b8f-ba41-d3ae6d803dde",
                                "sense_id": "f11d8731-196f-3e01-9c55-c5beb5476dfa",
                                "text": "Tige subdressée, ailée ou triptère; rameaux grands, étendus, verts, rouges sur les bords, subronds ou allongés, atténués au sommet, avec nervures."
                            }
                        ]
