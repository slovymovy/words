                                    {
                                        "sense_id": "efb3a049-9ddb-3564-8589-3efd1278b801",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "An action which divides a thing into parts, or separates one thing from another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1b549f-d17c-4191-bf4e-0142559b381e",
                                                "sense_id": "efb3a049-9ddb-3564-8589-3efd1278b801",
                                                "text": "the partitions of Poland"
                                            },
                                            {
                                                "example_id": "a8bdc8df-4d3f-45bd-b28f-5a3fb535db33",
                                                "sense_id": "efb3a049-9ddb-3564-8589-3efd1278b801",
                                                "text": "And good from bad find no partition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787c57ce-a93f-33a9-9fdc-d0bbbec5c3bb",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "A part of something that has been divided."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3df37a5-7098-47d5-92d2-ca0937755752",
                                                "sense_id": "787c57ce-a93f-33a9-9fdc-d0bbbec5c3bb",
                                                "text": "the Russian Partition"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df1c7e57-9d75-3012-aee7-9abc3b103a58",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "An approach to division in which one asks what the size of each part is, rather than (as in quotition) how many parts there are."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3597ead-5428-359e-bee7-e5c32de62c05",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "The division of a territory into two or more autonomous ones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94d24c9f-37d3-4e48-acce-7e59b3b93366",
                                                "sense_id": "b3597ead-5428-359e-bee7-e5c32de62c05",
                                                "text": "Monarchies where partition isn't prohibited risk weakening through parcellation and civil wars between the heirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a10eda-8c41-345a-989a-12cf6c586730",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "A vertical structure that divides a room."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e90a07a8-a5ae-43d2-92f7-6cb58f03e1fb",
                                                "sense_id": "c7a10eda-8c41-345a-989a-12cf6c586730",
                                                "text": "a brick partition; lath and plaster partitions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be49e6be-0f08-395c-a2a0-a6ac5a0b1bd4",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "That which divides or separates; that by which different things, or distinct parts of the same thing, are separated; boundary; dividing line or space."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e542ec5-ce5d-492f-849d-17c9ad375f14",
                                                "sense_id": "be49e6be-0f08-395c-a2a0-a6ac5a0b1bd4",
                                                "text": "No sight could pass / Betwixt the nice partitions of the grass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d43a49-18ae-34b7-b45b-dbc0d9150ad3",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "A part divided off by walls; an apartment; a compartment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f154bc95-dcd4-4aab-a369-4a4669fc9c47",
                                                "sense_id": "08d43a49-18ae-34b7-b45b-dbc0d9150ad3",
                                                "text": "Lodged in a small partition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ad404e6-c5a0-3de4-833b-2634ad250606",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "The severance of common or undivided interests, particularly in real estate. It may be effected by consent of parties, or by compulsion of law."
