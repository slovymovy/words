                                            {
                                                "example_id": "99d13950-88c5-43a3-addc-87540fd862c6",
                                                "sense_id": "53b46d73-6c13-381a-84b9-5f723f85d340",
                                                "text": "Die neuen Gesetze stellen eine Verschlechterung unserer Situation dar."
                                            },
                                            {
                                                "example_id": "dd784cc9-cb15-4f66-9f48-ebec878c8fbc",
                                                "sense_id": "53b46d73-6c13-381a-84b9-5f723f85d340",
                                                "text": "„Beim Drachenflug ist es besonders wichtig, den Windeinfluss zu berücksichtigen, da schon relativ geringe Gegenwindgeschwindigkeiten zu einer drastischen Verschlechterung der Gleitzahl führen.“"
