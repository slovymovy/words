                "senses": [
                    {
                        "sense_id": "99652e00-ab46-3ec8-b439-73423f211d6f",
                        "entry_id": "04bd7a99-a5a5-31a5-a18e-3c09532c824c",
                        "glosses": [
                            "Fahrt mit einem Bus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073c925f-2008-47ef-95ab-0ac7878d4333",
                                "sense_id": "99652e00-ab46-3ec8-b439-73423f211d6f",
                                "text": "„Auf einer Busfahrt durch Marokko hatte ich meine Notapotheke mit einer Dose Antibiotika dabei.“"
                            },
                            {
                                "example_id": "33f64183-a347-499a-8303-6eee0b696d8b",
                                "sense_id": "99652e00-ab46-3ec8-b439-73423f211d6f",
                                "text": "„Nach sechs Stunden Busfahrt und zwei Stunden Besichtigung hängt ihnen der Magen in den Kniekehlen.“"
                            },
                            {
                                "example_id": "a3fec6cb-a823-41ae-9dad-988ef2055b11",
                                "sense_id": "99652e00-ab46-3ec8-b439-73423f211d6f",
                                "text": "„Während der Busfahrt hallten seine Fragen in ihrem Kopf wider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
