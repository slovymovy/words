                "senses": [
                    {
                        "sense_id": "8f88a666-9cee-3021-a5ad-5b98af2622c2",
                        "entry_id": "0380823e-6442-33f4-8217-9bc90e433c1f",
                        "glosses": [
                            "Gebäudeteil, in dem die Dienstboten untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07422275-f128-42ea-9969-a217257819c0",
                                "sense_id": "8f88a666-9cee-3021-a5ad-5b98af2622c2",
                                "text": "„Im Preis enthalten sind auch ein Hubschrauber – der aber laut Medienberichten nicht über Start- und Landeerlaubnis verfügt und daher als reines Statussymbol dienen soll – und sieben Bedienstete, die sich zwei Jahre lang um das Anwesen kümmern und in einem separaten Dienstbotentrakt leben.“"
                            },
                            {
                                "example_id": "0ebddb5a-0665-47e8-9979-a170b0e0d987",
                                "sense_id": "8f88a666-9cee-3021-a5ad-5b98af2622c2",
                                "text": "„Für kleinere Geldbeutel gibt es in einem umgebauten früheren Dienstbotentrakt angenehme Zimmer.“"
                            },
                            {
                                "example_id": "d909e8ce-652a-4af4-bbb3-2eb6083f2838",
                                "sense_id": "8f88a666-9cee-3021-a5ad-5b98af2622c2",
                                "text": "„Es war nicht nur eine lokale architektonische Besonderheit, sondern ein Scharnier zwischen den Welten des Industriezeitalters, ein Dekompressionsraum zwischen Mittelschicht und Arbeiterklasse, der Repräsentation vorn und dem Dienstbotentrakt hinten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
