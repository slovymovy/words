                "senses": [
                    {
                        "sense_id": "9b6c3fbb-9f96-3c90-a42b-39b32f6bcae3",
                        "entry_id": "baaf3ffb-6783-3424-a79b-dca5eeea6411",
                        "glosses": [
                            "Verwendung/Einsatz von Dünger zur Verbesserung des Pflanzenwachstums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c737b356-1025-4615-87d2-8c7974b3ea32",
                                "sense_id": "9b6c3fbb-9f96-3c90-a42b-39b32f6bcae3",
                                "text": "„Doch der flächenintensive, langwierige Anbau von Kokospalmen in Monokulturen mit hohem Düngemitteleinsatz zerstört außerdem die Natur.“"
                            },
                            {
                                "example_id": "b5b6c9aa-a7ae-41e7-a9de-ff4e71d99a87",
                                "sense_id": "9b6c3fbb-9f96-3c90-a42b-39b32f6bcae3",
                                "text": "„Dafür sorgt der meist energie-, wasser- und flächenintensive Anbau unter Pestizid- und Düngemitteleinsatz.“"
                            },
                            {
                                "example_id": "e247a878-f7c6-4d9b-8bc9-6f6846ea2ae9",
                                "sense_id": "9b6c3fbb-9f96-3c90-a42b-39b32f6bcae3",
                                "text": "„Baumwolle ist in der Regel mit hohem Pestizid- und Düngemitteleinsatz verbunden.“"
                            },
                            {
                                "example_id": "94748b7f-03c5-41e6-961b-ea395baae8ce",
                                "sense_id": "9b6c3fbb-9f96-3c90-a42b-39b32f6bcae3",
                                "text": "„Afrikas Düngemitteleinsatz pro Hektar beträgt nur 13 Prozent des weltweiten Durchschnitts.“"
                            }
                        ],
