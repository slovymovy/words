{
    "word_family": [
        "emerge",
        "emergent",
        "emergency"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5689b67-2b1a-3f44-8194-90c4db17e0df",
                    "sense_definition": "The process of becoming visible, known, or important.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>emergence</w> of the internet has transformed global communication.",
                            "target_lang_translations": {
                                "ru": "<w>Появление</w> интернета преобразило глобальную коммуникацию.",
                                "zh": "互联网的<w>出现</w>改变了全球的交流方式。"
                            }
                        },
                        {
                            "text": "We watched the sudden <w>emergence</w> of the sun from behind the dark clouds.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали внезапное <w>появление</w> солнца из-за темных туч.",
                                "zh": "我们看着太阳从乌云背后突然<w>显现</w>出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appearance",
                        "rise",
                        "arrival",
                        "surfacing"
                    ],
                    "antonyms": [
                        "disappearance",
                        "vanishing"
                    ],
                    "common_phrases": [
                        "emergence of new technology",
                        "sudden emergence",
                        "gradual emergence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, в ходе которого что-либо становится видимым, известным или важным.",
                        "zh": "事物显现、为人所知或变得重要的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появление",
                                "target_lang_sense_clarification": "общий смысл; становление видимым или известным"
                            },
                            {
                                "target_lang_word": "возникновение",
                                "target_lang_sense_clarification": "зарождение, начало существования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出现",
                                "target_lang_sense_clarification": "指事物显露出来或为人所知"
                            },
                            {
                                "target_lang_word": "兴起",
                                "target_lang_sense_clarification": "指事物开始流行或变得重要"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c7dff3a-ce93-3db1-9d0b-093c709be564",
                    "sense_definition": "The process where complex patterns or properties arise from relatively simple interactions within a system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>emergence</w> of consciousness is a major topic in modern philosophy and science.",
                            "target_lang_translations": {
                                "ru": "<w>Возникновение</w> сознания — важная тема в современной философии и науке.",
                                "zh": "意识的<w>涌现</w>是现代哲学和科学中的一个重要课题。"
                            }
                        },
                        {
                            "text": "This theory attempts to explain the <w>emergence</w> of order out of chaos.",
                            "target_lang_translations": {
                                "ru": "Эта теория пытается объяснить <w>возникновение</w> порядка из хаоса.",
                                "zh": "该理论试图解释秩序是如何从混乱中<w>产生</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "development",
                        "evolution"
                    ],
                    "common_phrases": [
                        "emergence of structure",
                        "emergence of complexity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс возникновения сложных структур или свойств из относительно простых взаимодействий внутри системы.",
                        "zh": "系统内部相对简单的相互作用产生复杂模式或属性的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возникновение",
                                "target_lang_sense_clarification": "процесс появления новых свойств"
                            },
                            {
                                "target_lang_word": "эмерджентность",
                                "target_lang_sense_clarification": "научный термин; свойство систем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涌现",
                                "target_lang_sense_clarification": "科学术语，指复杂系统中的整体性特征"
                            },
                            {
                                "target_lang_word": "产生",
                                "target_lang_sense_clarification": "指从简单基础中形成新事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "062e4d17-70f4-32a3-802e-090393fa31c1",
                    "sense_definition": "An outgrowth from the surface of a plant, such as a prickle or wart, formed from outer tissues.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharp <w>emergence</w> on the stem helps protect the plant from herbivores.",
                            "target_lang_translations": {
                                "ru": "Острый <w>вырост</w> на стебле помогает защитить растение от травоядных.",
                                "zh": "茎上尖锐的<w>突起</w>有助于保护植物免受食草动物的侵害。"
                            }
                        },
                        {
                            "text": "Botanists examined the small <w>emergence</w> on the leaf surface under a microscope.",
                            "target_lang_translations": {
                                "ru": "Ботаники рассматривали маленький <w>вырост</w> на поверхности листа под микроскопом.",
                                "zh": "植物学家在显微镜下观察了叶片表面微小的<w>突起</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outgrowth",
                        "prickle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарост на поверхности растения, такой как шип или бородавка, образованный из внешних тканей.",
                        "zh": "植物表面由外层组织形成的突起物，如刺或疣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырост",
                                "target_lang_sense_clarification": "ботаника; образование на поверхности"
                            },
                            {
                                "target_lang_word": "эмергенец",
                                "target_lang_sense_clarification": "специальный ботанический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突起",
                                "target_lang_sense_clarification": "植物学中指表面的凸起结构"
                            },
                            {
                                "target_lang_word": "赘生物",
                                "target_lang_sense_clarification": "指植物表面异常生长的组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe24c859-50f4-341a-9c13-911611d4f4bc",
                    "sense_definition": "An unforeseen occurrence or condition calling for immediate action; an emergency.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "obsolete_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this dire <w>emergence</w>, he sought immediate assistance from his allies.",
                            "target_lang_translations": {
                                "ru": "В этой страшной <w>критической ситуации</w> он искал немедленной помощи у своих союзников.",
                                "zh": "在这种危急的<w>紧急情况</w>下，他立即向盟友寻求了援助。"
                            }
                        },
                        {
                            "text": "She kept a small fund aside to handle any sudden <w>emergence</w>.",
                            "target_lang_translations": {
                                "ru": "Она откладывала небольшую сумму на случай любой внезапной <w>крайней необходимости</w>.",
                                "zh": "她留了一笔小额资金，以应对任何<w>突发事件</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "emergency",
                        "crisis"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "replaced by 'emergency'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непредвиденное событие или состояние, требующее немедленных действий; чрезвычайная ситуация.",
                        "zh": "需要立即采取行动的突发事件或状况（现多用 emergency）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезвычайная ситуация",
                                "target_lang_sense_clarification": "устаревшее значение слова emergence"
                            },
                            {
                                "target_lang_word": "непредвиденный случай",
                                "target_lang_sense_clarification": "внезапное происшествие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧急情况",
                                "target_lang_sense_clarification": "指需要立即处理的突发事件"
                            },
                            {
                                "target_lang_word": "突发事件",
                                "target_lang_sense_clarification": "指未预料到的紧急状况"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}