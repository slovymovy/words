                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6dab162-004e-3544-b5b6-aa073c640394",
                        "entry_id": "61b01cc2-2124-35a1-9fcc-550c5ac16cb6",
                        "glosses": [
                            "Sorte de viennoiserie faite de pâte feuilletée sucrée, d'abord importée d'Autriche par les pâtissiers danois, et qui est particulièrement populaire aux États-Unis."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "3fa62996-9b12-4fb6-ad98-d1e4025d620a",
                                "sense_id": "d6dab162-004e-3544-b5b6-aa073c640394",
                                "text": "Danoise crémeuse aux cerises: Il suffit de dérouler la pâte à croissants et de la garnir de deux ingrédients indispensables dans les danoises : le fromage à la crème et les cerises."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "361746da-a7f6-4078-b021-8be0657b599b",
                        "source_entry_id": "61b01cc2-2124-35a1-9fcc-550c5ac16cb6",
                        "source_sense_id": "d6dab162-004e-3544-b5b6-aa073c640394",
                        "target_lang_word": "danish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "danish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01332884-5b7a-34df-a1b5-21780c85f0d6",
                                        "entry_id": "c9a019ff-3492-3a05-9fc7-e484f1c3434a",
                                        "glosses": [
                                            "Danish pastry, light sweet yeast-raised roll usually filled with fruit or cheese."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64e77250-2195-4c82-a133-8c62f3bd0299",
                                                "sense_id": "01332884-5b7a-34df-a1b5-21780c85f0d6",
                                                "text": "Get me a coffee and a cheese danish."
                                            },
                                            {
                                                "example_id": "2d915db8-d402-4950-930b-08de2fcb8404",
                                                "sense_id": "01332884-5b7a-34df-a1b5-21780c85f0d6",
                                                "text": "Allen Gregory DeLongpre: Uh-oh, Principal Gottlieb. Looks like somebody forgot their danish, huh?\nJudith Gottlieb: Aw, crap.\nAllen Gregory: Three, two, one, and there's the money shot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
