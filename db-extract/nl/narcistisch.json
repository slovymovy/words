                                    },
                                    {
                                        "sense_id": "efd3655d-20c3-37bb-a5f9-e88e496d9954",
                                        "entry_id": "7c43ee16-ca87-34c5-8771-bc6a932b38cd",
                                        "glosses": [
                                            "Personne présentant les symptômes du narcissisme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dba6cc9-437e-4d9e-8dd5-12a6621187c3",
                                                "sense_id": "efd3655d-20c3-37bb-a5f9-e88e496d9954",
                                                "text": "Lorsque le narcissique finit par être confronté à la réalité, selon les cas, il peut adopter deux attitudes différentes : la colère envers lui-même ou envers les autres."
