                "senses": [
                    {
                        "sense_id": "37c3c041-ef7f-3760-885e-bd519128482f",
                        "entry_id": "5b501f91-544b-3b96-876c-05e48afedc37",
                        "glosses": [
                            "tekst die men hoort als men iemand belt die de telefoon laat opnemen door een antwoordapparaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec5a2e5-fa48-4714-a59e-11d02424b6d6",
                                "sense_id": "37c3c041-ef7f-3760-885e-bd519128482f",
                                "text": "Sinds zij allebei mobiel bereikbaar zijn, hebben ze thuis een antwoordapparaat. Hun meldtekst is een vriendelijke uitnodiging om toch vooral te communiceren. Iedereen die een boodschap achterlaat, wordt opgewekt teruggebeld. Radioprogramma's, rinkelende kopjes, schreeuwende kinderen, verkeerslawaai – het zijn vrolijke flarden van andere levens die na de pieptoon binnenwaaien."
                            },
                            {
                                "example_id": "e0bde218-ac5a-42a8-a284-a262cab924bb",
                                "sense_id": "37c3c041-ef7f-3760-885e-bd519128482f",
                                "text": "De storing ontstond omdat er twee essentiële glasvezelverbindingen niet werkten. Door de storing kreeg 50 procent van de 112-bellers een meldtekst te horen in plaats van een centralist aan de lijn. Bellers bleven daardoor in de wacht staan."
                            },
                            {
                                "example_id": "aef84006-b2da-44f5-a0a3-7919b97d0e41",
                                "sense_id": "37c3c041-ef7f-3760-885e-bd519128482f",
                                "text": "Bovendien belden aanvankelijk heel veel mensen tegelijk terug, ook als ze niets gezien hadden. Het is echter de bedoeling dat men alleen belt als men iets relevants heeft waargenomen; dit zal voortaan ook nadrukkelijk in de meldtekst vermeld worden. Door de aanloop moesten enkele bellers ‘in de wacht’ worden gezet."
                            }
                        ]
                    }
