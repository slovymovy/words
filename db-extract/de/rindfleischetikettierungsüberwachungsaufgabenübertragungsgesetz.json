                "senses": [
                    {
                        "sense_id": "7c49d8db-e244-357c-85b7-4df449b0e096",
                        "entry_id": "7086f070-b0a9-3f63-bcec-cc10310b218a",
                        "glosses": [
                            "Part of the official short title Rinderkennzeichnungs- und Rindfleischetikettierungsüberwachungsaufgabenübertragungsgesetz (law dealing with the supervision of the labeling of beef)."
                        ],
                        "tags": [
                            "neuter",
                            "proper-noun",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "da9f9fa5-a291-4091-9fe9-8aafc976f263",
                                "sense_id": "7c49d8db-e244-357c-85b7-4df449b0e096",
                                "text": "[Ein] Gesetz zur Übertragung der Aufgaben für die Überwachung der Rinderkennzeichnung und Rindfleischetikettierung (Rinderkennzeichnungs- und Rindfleischetikettierungsüberwachungsaufgabenübertragungsgesetz - RkReÜAÜG M-V) vom 19.1.2000",
                                "translation": "[A] law dealing with the transfer of tasks pertaining to the supervision of the tagging of cattle and the labeling of beef (cattle marking and beef labeling supervision task transfer law - RkReÜaÜG M-V [Mecklenburg-Vorpommern]) that was decreed on 19th January 2000",
                                "english": "[A] law dealing with the transfer of tasks pertaining to the supervision of the tagging of cattle and the labeling of beef (cattle marking and beef labeling supervision task transfer law - RkReÜaÜG M-V [Mecklenburg-Vorpommern]) that was decreed on 19th January 2000"
                            },
                            {
                                "example_id": "4d29fd1b-69d3-41b7-9c93-8b4ece7de4a8",
                                "sense_id": "7c49d8db-e244-357c-85b7-4df449b0e096",
                                "text": "[…] Trotz zahlreicher Maßnahmen (Rindfleischetikettierungsüberwachungsaufgabenübertragungsgesetz) und Untersuchungen mussten 2001 Gesundheitsministerin Fischer und Landwirtschaftsminister Funke wegen der BSE-Krise zurücktreten.",
                                "translation": "Despite numerous measures (beef labeling supervision task transfer law) and investigation [into the BSE crisis], Minister for Health Fischer and Minister for Agriculture Funke had to step down in 2001 because of the BSE crisis.",
                                "english": "Despite numerous measures (beef labeling supervision task transfer law) and investigation [into the BSE crisis], Minister for Health Fischer and Minister for Agriculture Funke had to step down in 2001 because of the BSE crisis."
                            },
                            {
                                "example_id": "741b12a2-25f5-4a72-a787-ea37b0b65d8b",
                                "sense_id": "7c49d8db-e244-357c-85b7-4df449b0e096",
                                "text": "Unerreicht ist allerdings ein Landesgesetz: „Rinderkennzeichnungs- und Rindfleischetikettierungsüberwachungsaufgabenübertragungsgesetz - RkReÜAÜG“.",
                                "translation": "However, a state law has yet to be achieved: \"Cattle tagging and beef labeling supervision task transfer law - RkReÜaÜG\".",
                                "english": "However, a state law has yet to be achieved: \"Cattle tagging and beef labeling supervision task transfer law - RkReÜaÜG\"."
                            },
                            {
                                "example_id": "4ddd6e4a-b9b3-4d64-8f88-4e62dd24157a",
                                "sense_id": "7c49d8db-e244-357c-85b7-4df449b0e096",
                                "text": "Diese Regelung gilt auch und insbesondere für das Rindfleischetikettierungsüberwachungsaufgabenübertragungsgesetz (RklEtt§A§G, Mecklenburg-Vorpommern) sowie das Rinderkennzeichnungs- und Rindfleischetikettierungsüberwachungsaufgabenübertragungsgesetz (RkRe§A§G).",
                                "translation": "This regulation applies additionally and especially to the beef labeling supervision task transfer law (RklEtt§a§G, Mecklenburg-Vorpommern) and the cattle tagging and beef labeling supervision task transfer law (RkRe§A§G).",
                                "english": "This regulation applies additionally and especially to the beef labeling supervision task transfer law (RklEtt§a§G, Mecklenburg-Vorpommern) and the cattle tagging and beef labeling supervision task transfer law (RkRe§A§G)."
                            }
                        ]
                    }
                ],
