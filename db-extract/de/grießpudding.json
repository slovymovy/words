                                "example_id": "8c58f988-f80d-4056-8576-a53227fbd7ea",
                                "sense_id": "d611e28e-e26c-3242-8be8-839cb34ada26",
                                "text": "„Obwohl Grießpudding schon seit Jahrhunderten einen festen Platz in unserer Küche hat, ist die Nachfrage in den vergangenen Jahren deutlich gestiegen.“"
                            },
                            {
                                "example_id": "ebcdabbf-f2ae-496c-9d4d-5f7ec8aea25f",
                                "sense_id": "d611e28e-e26c-3242-8be8-839cb34ada26",
                                "text": "„Zum Nachtisch gab es Grießpudding mit Himbeersoße.“"
                            }
