                    },
                    {
                        "translation_id": "f89f0ce0-e5c5-44da-aa73-f598abcaf38e",
                        "source_entry_id": "358e39f2-cc3e-3f5d-b17a-92379ef6508a",
                        "source_sense_description": "Titre d’honneur",
                        "target_lang_word": "паша",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "паша",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "51f089b4-6e7c-307d-af60-71344c480683",
                                        "entry_id": "24bc4605-4ba6-31c5-bc5d-e7895840239a",
                                        "glosses": [
                                            "титул высших сановников и генералов, а также лицо, носящее этот титул, в старой Турции и некоторых других мусульманских странах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c516726-d9fa-4184-aa71-2fcc87c92db0",
                                                "sense_id": "51f089b4-6e7c-307d-af60-71344c480683",
                                                "text": "Обедал у нас Али паша, бендерской комендант и прочие знатные турецкие чиновные люди."
                                            },
                                            {
                                                "example_id": "219bbda8-2f86-46f5-a5c7-a5ea1a756fcc",
                                                "sense_id": "51f089b4-6e7c-307d-af60-71344c480683",
                                                "text": "Поражён был пулею Фейзулла, командующий паша, предатель египетского Али-бея, и сколот Сенюткиными казаками."
                                            },
                                            {
                                                "example_id": "e41f1924-b292-4a0a-987f-06147c36b0f5",
                                                "sense_id": "51f089b4-6e7c-307d-af60-71344c480683",
                                                "text": "Паша взял дары, целовал грамоту Иоаннову, три дня честил гонцов московских, а на четвёртый заключил в темницу."
                                            },
                                            {
                                                "example_id": "623be4a9-8c65-405e-8c3a-076f391460d2",
                                                "sense_id": "51f089b4-6e7c-307d-af60-71344c480683",
                                                "text": "Забрал себе Петро всё добро и стал жить, как паша."
                                            },
                                            {
                                                "example_id": "bece8b94-3ea7-4865-84e3-a3a4b96b10a0",
                                                "sense_id": "51f089b4-6e7c-307d-af60-71344c480683",
                                                "text": "Дворец Сераскира представлял картину вечно оживлённую: там где угрюмый паша молчаливо курил посреди своих жён и бесчестных отроков, там его победитель получал донесения о победах своих генералов, раздавал пашалыки, разговаривал о новых романах."
                                            },
                                            {
                                                "example_id": "e3be58e0-1cc2-4a53-95fb-0640f7e17c20",
                                                "sense_id": "51f089b4-6e7c-307d-af60-71344c480683",
                                                "text": "В это время жил в Халафе паша, большой охотник до песельников: многих к нему приводили — ни один ему не понравился; его чауши измучились, бегая по городу; вдруг, проходя мимо кофейного дома, слышат удивительный голос; они туда: «Иди с нами к великому паше, — закричали они, — или ты отвечаешь нам головою». «Я человек вольный, странник из города Тифлиза, — говорит Ашик-Кериб; — хочу пойду, хочу нет; пою, когда придётся, и ваш паша мне не начальник»; однако несмотря на то его схватили и привели к паше. «Пой», — сказал паша, и он запел. И в этой песни он славил свою дорогую Магуль-Мегери; и эта песня так понравилась гордому паше, что он оставил у себя бедного Ашик-Кериба."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bd695b3-aebe-4b66-bf0e-f7b6a7b1a17e",
                        "source_entry_id": "358e39f2-cc3e-3f5d-b17a-92379ef6508a",
                        "source_sense_description": "Titre d’honneur",
                        "target_lang_word": "paša",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paša",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1b5f15f5-3505-3db3-b6f5-a8fd99e078a9",
                                        "entry_id": "6d9d053b-030c-36c4-9c24-3a28c6387ce4",
                                        "glosses": [
                                            "vysoký vojenský hodnostář v osmanské říši"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77dbf987-17c7-4d1d-9915-b4cf5ab333ae",
                                                "sense_id": "1b5f15f5-3505-3db3-b6f5-a8fd99e078a9",
                                                "text": "Konečně velí paša, by se přivedli koně, my sednem na ně a uháníme opět klusem k Prištině."
                                            },
                                            {
                                                "example_id": "94740521-ae65-4a48-aeba-e4c5b8a14339",
                                                "sense_id": "1b5f15f5-3505-3db3-b6f5-a8fd99e078a9",
                                                "text": "„Turci se drží dobře,“ odpověděl nadporučík, uváděje ho opět ke stolu, „předseda turecké sněmovny Hali bej a Ali bej přijeli do Vídně. Vrchním velitelem turecké armády dardanelské jmenován maršálek Liman šlechtic Sanders. Goltz paša přijel z Cařihradu do Berlína a naším císařem byli vyznamenáni Enver paša, viceadmirál Usedom paša a generál Dževad paša. Poměrně hodně vyznamenání za tak krátkou dobu.“"
                                            }
                                        ]
                                    }
                                ]
                            },
