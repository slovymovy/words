        "fr-extract.jsonl": [
            {
                "entry_id": "6f827b46-c21b-3e28-8985-777cf67dd100",
                "word": "escamotage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f2c5e898-9237-4228-82c1-ead935ff7873",
                        "entry_id": "6f827b46-c21b-3e28-8985-777cf67dd100",
                        "tags": [
                            "plural"
                        ],
                        "form": "escamotages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7fca02b-fedd-3bce-b792-ce5d13099c1b",
                        "entry_id": "6f827b46-c21b-3e28-8985-777cf67dd100",
                        "glosses": [
                            "Action d’escamoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf9516d-04a4-4bce-bc9b-c849d1ef227d",
                                "sense_id": "f7fca02b-fedd-3bce-b792-ce5d13099c1b",
                                "text": "…, j’ai toutes les chances d’aller en paradis. Mais le métier d’escamoteur n’y mène point directement, pas plus que celui de meunier. Je crains bien d’être forcé de gagner ma place par un dernier tour d’escamotage."
                            },
                            {
                                "example_id": "c79b4e9c-f556-4134-9b7a-b0ced1bedd70",
                                "sense_id": "f7fca02b-fedd-3bce-b792-ce5d13099c1b",
                                "text": "[…], il se laissa imposer le titre de roi des Français sous le nom de Louis-Philippe Iᵉʳ (7 août 1830). C'était une usurpation audacieuse de la souveraineté nationale; l'avènement de la branche cadette peut être qualifiée un escamotage."
                            },
                            {
                                "example_id": "ba3ac8f5-8383-4a26-b105-32cf284c5ac4",
                                "sense_id": "f7fca02b-fedd-3bce-b792-ce5d13099c1b",
                                "text": "Depuis cette soirée où il a eu son rôle, éclairé par toutes les bougies du sorcier, objet de l’attention de la foule, dévoré par les regards des grands et des moyens, depuis ce jour-là, la résolution de Vidaljan est prise, sa vocation est décidée : il va se mettre au travail tout de suite. Il a toujours eu un penchant pour l’escamotage !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a6510d8-99ee-45b0-8fab-c1e05b069761",
                        "source_entry_id": "6f827b46-c21b-3e28-8985-777cf67dd100",
                        "source_sense_id": "f7fca02b-fedd-3bce-b792-ce5d13099c1b",
                        "target_lang_word": "Betrügerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrügerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                                        "entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                                        "glosses": [
                                            "mehrere/viele Handlungen, bei denen jemand/andere hinters Licht geführt und um rechtmäßigen Besitz gebracht wird/werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da65e6a9-252d-4c33-9502-008cb3ddca8a",
                                                "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                                                "text": "„Er hatte viel mehr Glück als sein Bruder Ludwig, der wegen Betrügereien im Bergwerk ins Gefängnis kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                                        "entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                                        "glosses": [
                                            "Handlung, die Bedeutung [1] erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f04659-66d3-4866-9aaa-e3a61e9430a7",
                                                "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                                                "text": "„Ich hatte ein kleines Haus gemietet, wo ich eine Pharaobank unter Halbpart-Beteiligung eines Berufsspielers auflegte, der mich vor den Betrügereien gewisser überheblicher Aristokraten schützte, denen gegenüber ein einfacher Privatmann in meinem lieben Vaterland immer unrecht hat.“"
                                            },
                                            {
                                                "example_id": "9edff040-cd4a-41c6-b912-2ab1ffac4f22",
                                                "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                                                "text": "„Er wurde fälschlich aller möglichen Betrügereien angeklagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25d0774e-8bbc-4801-a3a8-162f3483925b",
                        "source_entry_id": "6f827b46-c21b-3e28-8985-777cf67dd100",
                        "source_sense_id": "f7fca02b-fedd-3bce-b792-ce5d13099c1b",
                        "target_lang_word": "Gaunerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaunerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9af95c4-56d3-394b-baa0-994da3100342",
                                        "entry_id": "41911532-5c27-3834-b25c-42ec54d76ef7",
                                        "glosses": [
                                            "eine von einem Gauner begangene Tat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f39bc618-0063-4495-9d47-2c5c26e33004",
                                                "sense_id": "e9af95c4-56d3-394b-baa0-994da3100342",
                                                "text": "Es ist schon eine Gaunerei mit den Öl- und Gas-Preisen."
                                            },
                                            {
                                                "example_id": "48994829-71c7-47db-9ec8-a5ebfd758754",
                                                "sense_id": "e9af95c4-56d3-394b-baa0-994da3100342",
                                                "text": "„Außer in solchen Gaunereien, auf die er sich viel zugute tat, besaß er eine umfassende Erfahrung in Dingen, wie sie die Stubenmädchen treiben oder wie sie in schlecht beleuchteten Hinterzimmern von kleinen Stundenhotels vor sich gehen.“"
                                            },
                                            {
                                                "example_id": "6107acb5-90a4-44fc-9747-98c2881fcfe5",
                                                "sense_id": "e9af95c4-56d3-394b-baa0-994da3100342",
                                                "text": "„Ein kluger Spieler kann das eine wie das andere tun, ohne sich dem Vorwurf der Gaunerei auszusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1aaeb42-2f16-4742-902b-3da2a86deb33",
