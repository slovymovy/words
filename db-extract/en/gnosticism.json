                ],
                "senses": [
                    {
                        "sense_id": "212791a1-dc87-3f98-899f-55be41557401",
                        "entry_id": "5464c113-dcad-3f41-8a9f-d718e2836347",
                        "glosses": [
                            "A wide variety of Jewish and early Christian sects having an interest in gnosis, or divine knowledge, and generally holding the belief that there is a god greater than the Demiurge, or the creator of the world."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "380bff23-aed2-4b2d-be16-add9afd221de",
                                "sense_id": "212791a1-dc87-3f98-899f-55be41557401",
                                "text": "Another contemporary scholar of Gnosticism, C. G. Jung, has taken this notion of the twin ray and applied it to his own model of the contrasexual nature of the self."
                            }
                        ]
                    }
                ],
