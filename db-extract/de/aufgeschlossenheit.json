                ],
                "senses": [
                    {
                        "sense_id": "ac918612-968e-3cb0-9250-de15444b818a",
                        "entry_id": "9ae5d262-3125-39e2-969b-b2db9fabee9d",
                        "glosses": [
                            "Eigenschaft, ohne Zurückhaltung für etwas zu sein; Bereitschaft, mit anderen über seine Gedanken und Gefühle zu sprechen oder Auskunft zu geben; persönliche Haltung, für Neues offen zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d646f32-68a6-46e5-8f6e-cd7b466d1446",
                                "sense_id": "ac918612-968e-3cb0-9250-de15444b818a",
                                "text": "„Die Aufgeschlossenheit in der Bevölkerung, die es bis dahin gab, ging durch die neuen Schwierigkeiten verloren.“"
                            },
                            {
                                "example_id": "f504a59b-a580-4656-8bcc-599722f52b05",
                                "sense_id": "ac918612-968e-3cb0-9250-de15444b818a",
                                "text": "„Wichtig für die Interpretation der Ergebnisse sind Aussagen über die Erfahrung und Aufgeschlossenheit gegenüber der Zusammenarbeit mit einem Roboter.“"
                            },
                            {
                                "example_id": "10975921-7966-4fae-9d68-94ff8f3f79e9",
                                "sense_id": "ac918612-968e-3cb0-9250-de15444b818a",
                                "text": "„Die Aufgeschlossenheit der Seelen füreinander und die Aufgeschlossenheit für Ideen sind die zwei sich ergänzenden Seiten dieses Vernunftlebens.“"
                            },
                            {
                                "example_id": "ca6a4ee9-e3df-43ce-ae96-9a9af42b20ef",
                                "sense_id": "ac918612-968e-3cb0-9250-de15444b818a",
                                "text": "„Das rote Kleid weist auf die Gedankentätigkeit hin, die zum Verständnis führt, der blaue Mantel auf empfangsbereite Aufgeschlossenheit.“"
                            },
                            {
                                "example_id": "34ef8047-30ee-43be-811d-dc61e2496236",
                                "sense_id": "ac918612-968e-3cb0-9250-de15444b818a",
                                "text": "„Innere Aufgeschlossenheit und ernsthafte Bereitschaft zur Veränderung wird uns näher an unsere Mitte führen, wird uns unser Sein und unseren Wesenskern spüren lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
