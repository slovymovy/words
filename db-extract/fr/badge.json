                            {
                                "example_id": "26f3f758-3e41-4057-9365-d9f1b7291b37",
                                "sense_id": "2466a512-1ec9-3352-ba71-15126456ff19",
                                "text": "Le badge cuisine-trappeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dd89dd0-0fd8-3b6b-9de6-f8ab054c2af5",
                        "entry_id": "bfae19fd-0f0f-3230-b3f3-18988f8e9fec",
                        "glosses": [
                            "Icône ou emblème remis à un utilisateur pour souligner un accomplissement."
                        ],
                        "tags": [
                            "Internet",
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "e6ec58b8-4cb5-4f43-8813-fc6137fcfd3b",
                                "sense_id": "9dd89dd0-0fd8-3b6b-9de6-f8ab054c2af5",
                                "text": "Les badges sont un moyen amusant de récompenser les joueurs pour leurs différentes réalisations dans l'expérience."
                            }
                        ]
                    }
