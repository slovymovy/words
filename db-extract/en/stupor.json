                                "target_senses": [
                                    {
                                        "sense_id": "f6c9f04d-a06b-39ae-838d-14a1481adfb8",
                                        "entry_id": "8ac6688b-89a0-330b-9f9b-5ed3357b63f5",
                                        "glosses": [
                                            "zo fanatiek, eenzijdig op één zaak gericht raken dat het gek of vreemd is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc86159-177d-4ad4-956e-7135856298cb",
                                                "sense_id": "f6c9f04d-a06b-39ae-838d-14a1481adfb8",
                                                "text": "Levin bevond zich nog steeds in die toestand van verdwazing, waarin het hem voorkwam of hij en zijn geluk het hoogste en het enige doel waren van al het bestaande, of hij nergens aan behoefde te denken en voor te zorgen, of alles door anderen voor hem gedaan werd en gedaan zou worden."
                                            },
                                            {
                                                "example_id": "5a802b84-bcb4-442a-a282-8965f070932e",
                                                "sense_id": "f6c9f04d-a06b-39ae-838d-14a1481adfb8",
                                                "text": "De Nationaal Coördinator Terrorismebestrijding en Veiligheid kent het videotestament van de Maastrichtse jihadist die eerder dit jaar een zelfmoordaanslag pleegde bij het hoofdbureau van de politie in Bagdad. \"Het toont de verdwazing van hoe jonge lieden worden misleid om zichzelf en onschuldigen de dood in te jagen\", aldus een woordvoerder van de NCTV."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4afbdb49-06c3-40e7-a447-f88195be401f",
                        "source_entry_id": "90c4b78c-3a2c-3803-baef-ce985718f148",
