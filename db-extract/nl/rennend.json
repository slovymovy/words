                        "examples": [
                            {
                                "example_id": "40f5e62d-1a6c-4717-ba50-ea4899589293",
                                "sense_id": "e732c500-d1a3-34fb-97cd-a5db90c9bce6",
                                "text": "Eerder hield de politie al een 30-jarige Nieuw-Amsterdammer aan op verdenking van betrokkenheid. De overvaller dacht kort nadat de winkel open ging zijn slag te kunnen slaan. Hij bedreigde het personeel met een mes en riep dat hij geld wilde. Waarschijnlijk ging het de man allemaal niet snel genoeg, want niet lang na binnenkomst ging hij er rennend vandoor."
                            }
                        ]
                    }
