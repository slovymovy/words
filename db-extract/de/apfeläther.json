                        "examples": [
                            {
                                "example_id": "f7ee2f44-68f2-4a06-b21a-f9d063097f62",
                                "sense_id": "68f4d1e7-c765-3721-a4de-5b129534cafd",
                                "text": "„Gewöhnlich wird ein Gemenge von 1/2 dunklen Malzbieres und 1/2 Sirup verwendet, dem man einige Tropfen Apfeläther zusetzt.“"
                            },
                            {
                                "example_id": "69b0731b-b1f0-4c02-919f-66d14ca24bf1",
                                "sense_id": "68f4d1e7-c765-3721-a4de-5b129534cafd",
                                "text": "„Die wichtigsten künstlichen Fruchtäther sind: Ananasäther, Apfeläther, Apfelsinenäther, Aprikosenäther, Bananenäther, Birnenäther, Erdbeeräther, Himbeeräther, […]“"
