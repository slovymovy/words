                                "sense_id": "e9007a78-874f-3222-995f-5c76cfa83b16",
                                "text": "Sie wickelt die Vase in Packpapier, damit sie beim Transport nicht zerkratzt."
                            },
                            {
                                "example_id": "81c0fce9-ed18-425f-b997-e27df59ea7fe",
                                "sense_id": "e9007a78-874f-3222-995f-5c76cfa83b16",
                                "text": "Der Metzger wickelt das verkaufte Fleisch in Packpapier."
                            }
                        ]
                    }
