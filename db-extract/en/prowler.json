                "senses": [
                    {
                        "sense_id": "55cf792f-a2e6-392f-8035-8eafc9f569dd",
                        "entry_id": "f0c53bb5-cc62-34c8-aa15-b91a331c20d9",
                        "glosses": [
                            "One who roves about for prey; one who prowls."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51160268-53b5-43bd-8e10-bc51a12b643c",
                                "sense_id": "55cf792f-a2e6-392f-8035-8eafc9f569dd",
                                "text": "House Prees and Bloods […] were everywhere to be seen in earnest colloquy. For the matter was, that there was some sort of night-prowler about the school grounds."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec265539-f5d1-3679-909d-30525226081c",
                        "entry_id": "f0c53bb5-cc62-34c8-aa15-b91a331c20d9",
                        "glosses": [
                            "A person who moves stealthily around a place with intention to commit a crime, especially burglary or theft."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d11e5c-ae9d-4611-b453-ccc05efbf4e4",
                                "sense_id": "ec265539-f5d1-3679-909d-30525226081c",
                                "text": "Discourage nighttime prowlers by installing motion-sensitive lights."
                            },
                            {
                                "example_id": "fab07124-067c-4c66-b2b0-221eb97440c5",
                                "sense_id": "ec265539-f5d1-3679-909d-30525226081c",
                                "text": "“I was under the impression that a prowler had broken in and killed my baby. Never did they say that it was a deputy-involved shooting until my brother read it on the internet,” Wilburn said."
                            }
                        ]
                    }
                ],
