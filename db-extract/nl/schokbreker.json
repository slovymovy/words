                        ],
                        "examples": [
                            {
                                "example_id": "8f4993cc-fbb5-4903-bbe0-007d5567f0c8",
                                "sense_id": "9c4e5ff1-2117-3a25-8e1a-dd81fc952ee9",
                                "text": "Door het referendum uit te roepen heeft voormalig premier David Cameron ­alle schokbrekers uitgeschakeld. Brexiteers konden bijgevolg op volle kracht vooruit, ongeremd door beoordelingen over de impact, analyses of trucjes die bedenktijd hadden toegestaan."
                            }
                        ]
                    }
