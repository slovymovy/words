{
    "word_family": [
        "issuance",
        "issuer",
        "reissue"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "001db123-5f63-35b8-b2ce-dbb397b2ab7d",
                    "sense_definition": "A problem, concern, or situation that needs to be thought about and settled.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "problem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team is working hard to resolve the technical <w>issue</w> with the website.",
                            "target_lang_translations": {
                                "ru": "Команда усердно работает над решением технической <w>проблемы</w> с сайтом."
                            }
                        },
                        {
                            "text": "We need to address the <w>issue</w> of climate change before it is too late.",
                            "target_lang_translations": {
                                "ru": "Нам нужно заняться <w>вопросом</w> изменения климата, пока не стало слишком поздно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "technical issue",
                        "address the issue",
                        "major issue",
                        "resolve an issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проблема, беспокойство или ситуация, требующая обдумывания и решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "сложный вопрос, требующий разрешения"
                            },
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "обстоятельство или дело, подлежащее обсуждению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "856d4f8f-5ded-3c6a-9214-db5bfc807c2c",
                    "sense_definition": "A single edition of a newspaper, magazine, or other regular publication.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I just bought the latest <w>issue</w> of the fashion magazine at the airport.",
                            "target_lang_translations": {
                                "ru": "Я только что купил в аэропорту свежий <w>номер</w> журнала о моде."
                            }
                        },
                        {
                            "text": "The current <w>issue</w> features an exclusive interview with the famous director.",
                            "target_lang_translations": {
                                "ru": "В текущем <w>выпуске</w> представлено эксклюзивное интервью с известным режиссером."
                            }
                        }
                    ],
                    "common_phrases": [
                        "current issue",
                        "latest issue",
                        "back issue",
                        "special issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный номер газеты, журнала или другого периодического издания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпуск",
                                "target_lang_sense_clarification": "отдельный номер периодического издания"
                            },
                            {
                                "target_lang_word": "номер",
                                "target_lang_sense_clarification": "экземпляр периодического издания"
                            },
                            {
                                "target_lang_word": "издание",
                                "target_lang_sense_clarification": "выпуск печатной продукции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "093c1ea8-c260-3e6d-8f71-ec3a0374f732",
                    "sense_definition": "A point of disagreement or a matter that is being debated.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not make an <w>issue</w> out of such a small mistake.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не делай <w>проблемы</w> из такой пустяковой ошибки."
                            }
                        },
                        {
                            "text": "The main <w>issue</w> between the two parties was the budget for the project.",
                            "target_lang_translations": {
                                "ru": "Главным <w>предметом спора</w> между двумя сторонами был бюджет проекта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make an issue",
                        "take issue with",
                        "central issue",
                        "contentious issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет разногласий или вопрос, являющийся предметом спора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спорный вопрос",
                                "target_lang_sense_clarification": "предмет дискуссии или дебатов"
                            },
                            {
                                "target_lang_word": "пункт",
                                "target_lang_sense_clarification": "тема или предмет суждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c119c932-b377-3748-8bcc-399375346662",
                    "sense_definition": "A personal psychological or emotional difficulty.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has some trust <w>issues</w> because of his past experiences in relationships.",
                            "target_lang_translations": {
                                "ru": "У него есть некоторые <w>проблемы</w> с доверием из-за прошлого опыта в отношениях."
                            }
                        },
                        {
                            "text": "She is seeing a therapist to help her deal with her family <w>issues</w>.",
                            "target_lang_translations": {
                                "ru": "Она посещает терапевта, чтобы справиться со своими семейными <w>проблемами</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trust issues",
                        "family issues",
                        "personal issues",
                        "have issues"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used informally to describe personal problems"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личные психологические или эмоциональные трудности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблемы",
                                "target_lang_sense_clarification": "психологические или эмоциональные трудности"
                            },
                            {
                                "target_lang_word": "комплексы",
                                "target_lang_sense_clarification": "внутренние психологические барьеры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9774a382-275f-3e32-8e5b-f5c499630174",
                    "sense_definition": "The act of officially producing or giving something out for use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government oversees the <w>issue</w> of new passports to its citizens.",
                            "target_lang_translations": {
                                "ru": "Правительство контролирует <w>выдачу</w> новых паспортов своим гражданам."
                            }
                        },
                        {
                            "text": "The <w>issue</w> of currency is a primary responsibility of the central bank.",
                            "target_lang_translations": {
                                "ru": "<w>Эмиссия</w> валюты является основной обязанностью центрального банка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "standard issue",
                        "government issue",
                        "issue of currency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт официального производства или выдачи чего-либо для использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдача",
                                "target_lang_sense_clarification": "официальное предоставление документов или вещей"
                            },
                            {
                                "target_lang_word": "эмиссия",
                                "target_lang_sense_clarification": "выпуск в обращение денег или ценных бумаг"
                            },
                            {
                                "target_lang_word": "выпуск",
                                "target_lang_sense_clarification": "производство и предоставление чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "900729d5-77ef-3d12-b3cd-1939302e0da6",
                    "sense_definition": "A person's children or descendants.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy businessman died without <w>issue</w>, leaving his fortune to charity.",
                            "target_lang_translations": {
                                "ru": "Богатый бизнесмен умер, не оставив <w>потомства</w>, и завещал свое состояние на благотворительность."
                            }
                        },
                        {
                            "text": "The royal line continued through his male <w>issue</w> for several centuries.",
                            "target_lang_translations": {
                                "ru": "Королевская линия продолжалась через его <w>потомков</w> мужского пола на протяжении нескольких веков."
                            }
                        }
                    ],
                    "synonyms": [
                        "offspring",
                        "descendant"
                    ],
                    "common_phrases": [
                        "die without issue",
                        "lawful issue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal or formal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дети или потомки человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потомство",
                                "target_lang_sense_clarification": "дети или последующие поколения"
                            },
                            {
                                "target_lang_word": "потомок",
                                "target_lang_sense_clarification": "лицо, происходящее от предка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8cc0f4a-d25a-3c85-a9fc-85d13d5e1fbc",
                    "sense_definition": "The act of flowing or coming out from a source.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>issue</w> of water from the pipe caused a flood in the basement.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>вытекание</w> воды из трубы вызвало затопление в подвале."
                            }
                        },
                        {
                            "text": "Scientists monitored the <w>issue</w> of gas from the volcanic vent.",
                            "target_lang_translations": {
                                "ru": "Ученые наблюдали за <w>выходом</w> газа из вулканического жерла."
                            }
                        }
                    ],
                    "common_phrases": [
                        "issue of blood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт вытекания или выхода из источника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытекание",
                                "target_lang_sense_clarification": "действие по значению глагола вытекать"
                            },
                            {
                                "target_lang_word": "излияние",
                                "target_lang_sense_clarification": "выход жидкости или газа из источника"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5915a95a-afdb-3964-8e9e-db4b36c5f71d",
                    "sense_definition": "To officially produce, publish, or give something to the public.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_distribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police <w>issued</w> a statement regarding the accident that happened yesterday.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>сделала</w> заявление относительно аварии, произошедшей вчера."
                            }
                        },
                        {
                            "text": "The bank will <w>issue</w> a new credit card to replace your lost one.",
                            "target_lang_translations": {
                                "ru": "Банк <w>выпустит</w> новую кредитную карту взамен утерянной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "issue a statement",
                        "issue a warning",
                        "issue a permit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально производить, публиковать или предоставлять что-либо общественности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "производить или издавать"
                            },
                            {
                                "target_lang_word": "издавать",
                                "target_lang_sense_clarification": "официально публиковать (указ, закон, заявление)"
                            },
                            {
                                "target_lang_word": "сделать",
                                "target_lang_sense_clarification": "в контексте 'сделать заявление'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f84c5a1-1fd6-3a9e-b4e5-5ae244194fb3",
                    "sense_definition": "To provide or distribute equipment or supplies to someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_distribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school will <w>issue</w> textbooks to all students at the start of the term.",
                            "target_lang_translations": {
                                "ru": "Школа <w>выдаст</w> учебники всем ученикам в начале семестра."
                            }
                        },
                        {
                            "text": "Soldiers were <w>issued</w> new boots before they began their long march.",
                            "target_lang_translations": {
                                "ru": "Солдатам <w>выдали</w> новые ботинки перед началом долгого марша."
                            }
                        }
                    ],
                    "common_phrases": [
                        "issue equipment",
                        "issue uniforms",
                        "be issued with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять или распределять оборудование или припасы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "распределять снаряжение или учебники"
                            },
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "обеспечивать необходимым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2c84678-53f5-33f9-b75a-b0535de7bc4f",
                    "sense_definition": "To give out something officially using legal or formal authority.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_distribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge <w>issued</w> a warrant for the suspect's arrest this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром судья <w>выписал</w> ордер на арест подозреваемого."
                            }
                        },
                        {
                            "text": "The referee decided to <w>issue</w> a yellow card after the foul.",
                            "target_lang_translations": {
                                "ru": "Судья решил <w>показать</w> желтую карточку после фола."
                            }
                        }
                    ],
                    "common_phrases": [
                        "issue a warrant",
                        "issue a summons",
                        "issue a decree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдавать что-либо официально, используя юридические или формальные полномочия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выписывать",
                                "target_lang_sense_clarification": "оформлять официальный документ (ордер, штраф)"
                            },
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "предъявлять официально (карточку в спорте)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3172a24b-ca21-39b0-95c7-1cdd4b6b25b2",
                    "sense_definition": "To flow or come out from a particular place or source.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thick cloud of smoke <w>issued</w> from the chimney of the old factory.",
                            "target_lang_translations": {
                                "ru": "Густое облако дыма <w>валило</w> из трубы старой фабрики."
                            }
                        },
                        {
                            "text": "Strange sounds <w>issued</w> from the dark cave, frightening the hikers.",
                            "target_lang_translations": {
                                "ru": "Из темной пещеры <w>исходили</w> странные звуки, пугавшие туристов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "issue forth",
                        "issue from"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вытекать или исходить из определенного места или источника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исходить",
                                "target_lang_sense_clarification": "распространяться из источника (о звуке, дыме)"
                            },
                            {
                                "target_lang_word": "вытекать",
                                "target_lang_sense_clarification": "литься наружу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}