                "senses": [
                    {
                        "sense_id": "7aa2ef7d-308d-3378-9755-edb98057ea15",
                        "entry_id": "43edc402-c29a-39e1-b3b7-cdf7e0b078dc",
                        "glosses": [
                            "Avoir des crampes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb011712-4ce0-40fd-8027-2ca884238fd2",
                                "sense_id": "7aa2ef7d-308d-3378-9755-edb98057ea15",
                                "text": "Il se consume mais demeure lucide ; il puise dans ses réserves mais il tient debout jusqu’à la balle de match du cinquième set qu’il remporte exténué, avant de s’effondrer dans les vestiaires, de cramper et de pratiquement s’évanouir !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b3f238fe-df6f-3b2f-b40e-8fe966332ef0",
                        "entry_id": "43edc402-c29a-39e1-b3b7-cdf7e0b078dc",
                        "glosses": [
                            "Avoir des crampes au visage à force de rire; être pris d'un fou rire incontrôlable."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3152430d-66f7-373d-b802-e9d2a4a8de77",
                        "entry_id": "43edc402-c29a-39e1-b3b7-cdf7e0b078dc",
                        "glosses": [
                            "Tourner le volant d'un véhicule vers la droite ou la gauche."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "37d1bf18-f116-447c-9c28-3e284b8485e4",
                                "sense_id": "3152430d-66f7-373d-b802-e9d2a4a8de77",
                                "text": "Crampe en masse, t'es beau!"
                            }
                        ]
                    },
                    {
                        "sense_id": "2e8c5945-63a9-31eb-b450-25d7ad333ca2",
                        "entry_id": "43edc402-c29a-39e1-b3b7-cdf7e0b078dc",
                        "glosses": [
                            "(Emploi littéraire ponctuel par un auteur) Tirer sa crampe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "282c9524-e4f8-4a58-b4c7-d7d47969250b",
                                "sense_id": "2e8c5945-63a9-31eb-b450-25d7ad333ca2",
                                "text": "Pourquoi ai—je pris tant de peine à cramper Christine alors que je pouvais chiffonner Chantal, à bistoquer Brigitte alors que je venais d’emmancher Emmanuelle, à pomper Pascale alors que je regrettais de ne pas rinauder Rolande, à fatrouiller Fabienne alors que j’aurais pu ratisser Raphaële, à margauder Marguerite alors que je rêvais de gribouiller Ghislaine ?"
                            },
                            {
                                "example_id": "69d85424-ada9-4202-95fb-e50a53925d2a",
                                "sense_id": "2e8c5945-63a9-31eb-b450-25d7ad333ca2",
                                "text": "Cramper un cable"
                            }
                        ]
                    }
