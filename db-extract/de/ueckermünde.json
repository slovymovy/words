                "senses": [
                    {
                        "sense_id": "6b17dcd5-c94e-3924-8091-f5df21a8acdc",
                        "entry_id": "afc4d182-afe2-3006-8318-613bd5cac966",
                        "glosses": [
                            "eine Stadt in Mecklenburg-Vorpommern, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c915a1-5929-4660-a0d5-bde7b883f910",
                                "sense_id": "6b17dcd5-c94e-3924-8091-f5df21a8acdc",
                                "text": "Die Hafenstadt Ueckermünde liegt am Stettiner Haff."
                            },
                            {
                                "example_id": "7efabf9e-5f1c-422e-87cb-dbb29ed66a46",
                                "sense_id": "6b17dcd5-c94e-3924-8091-f5df21a8acdc",
                                "text": "Die polnische Stadt Nowe Warpno (Neuwarp) ist eine Partnerstadt Ueckermündes."
                            },
                            {
                                "example_id": "b81ac333-53a2-4843-8e33-067bcb6d46ab",
                                "sense_id": "6b17dcd5-c94e-3924-8091-f5df21a8acdc",
                                "text": "Ich bin in Ueckermünde geboren."
                            },
                            {
                                "example_id": "580331d0-04c6-4d8f-8778-9194ade314f8",
                                "sense_id": "6b17dcd5-c94e-3924-8091-f5df21a8acdc",
                                "text": "Ich habe in Ueckermünde meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "65b12efc-d18c-42b9-8229-35479c5a8e93",
                                "sense_id": "6b17dcd5-c94e-3924-8091-f5df21a8acdc",
                                "text": "Nach Ueckermünde führen viele Wege."
                            },
                            {
                                "example_id": "12d3dc64-b0f9-4e73-9649-eb2b734ed62a",
                                "sense_id": "6b17dcd5-c94e-3924-8091-f5df21a8acdc",
                                "text": "„Die Abwicklung am Hafen von Ueckermünde war straff organisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
