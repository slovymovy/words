                "senses": [
                    {
                        "sense_id": "de91bfa3-fc66-32db-a491-d4d30f7539c0",
                        "entry_id": "03b8a9b6-7c49-3c53-9cd6-3473e7840c29",
                        "glosses": [
                            "Femme qui s’adonne au dévergondage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d87fd0-6bb2-4a76-b20f-a520224618d0",
                                "sense_id": "de91bfa3-fc66-32db-a491-d4d30f7539c0",
                                "text": "En fille de la campagne prématurément instruite des choses de l’amour par les conversations, elle savait qu’une telle conduite était permise aux garçons, qui prennent leur plaisir avec les dévergondées."
                            },
                            {
                                "example_id": "69a262f3-a6a6-477d-9642-dd7b63c75376",
                                "sense_id": "de91bfa3-fc66-32db-a491-d4d30f7539c0",
                                "text": "Pourtant la chose en soi était grave ; ce n’est pas tout que de dire : vos filles sont des dévergondées et vos garçons des chenapans ; mais… il n’y aurait pas que des vieillards et des adultes à l’église, il y aurait aussi des enfants."
                            },
                            {
                                "example_id": "5c3b1ffc-a2cf-4976-9ffb-f46b5134e1fc",
                                "sense_id": "de91bfa3-fc66-32db-a491-d4d30f7539c0",
                                "text": "On n’a pas de place pour une dévergondée de votre espèce."
                            }
                        ]
                    }
                ],
