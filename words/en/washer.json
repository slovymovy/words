    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2f9f539-32ec-3b63-ac8b-0189944a3d1c",
                    "sense_definition": "A machine or appliance used for cleaning things, especially a washing machine or a dishwasher.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>washer</w> in the laundry room is making a very loud noise during the spin cycle.",
                            "target_lang_translations": {
                                "ru": "Старая <w>стиральная машина</w> в прачечной издает очень громкий шум во время цикла отжима."
                            }
                        },
                        {
                            "text": "We need to buy a new automatic <w>washer</w> because the current one keeps leaking water on the floor.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить новую <w>стиральную машину-автомат</w>, потому что нынешняя постоянно протекает."
                            }
                        }
                    ],
                    "synonyms": [
                        "washing machine",
                        "dishwasher"
                    ],
                    "common_phrases": [
                        "automatic washer",
                        "clothes washer",
                        "stackable washer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машина или устройство для мытья вещей, особенно стиральная или посудомоечная машина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиральная машина",
                                "target_lang_sense_clarification": "для одежды"
                            },
                            {
                                "target_lang_word": "стиралка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "посудомоечная машина",
                                "target_lang_sense_clarification": "для посуды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b38f8bd7-b92d-33e9-ac8a-1991b643a378",
                    "sense_definition": "A thin, flat ring of metal, rubber, or plastic placed under a nut or bolt to spread the pressure or prevent leaking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_component",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to place a rubber <w>washer</w> inside the hose connection to prevent any water from dripping.",
                            "target_lang_translations": {
                                "ru": "Обязательно вставьте резиновую <w>шайбу</w> внутрь соединения шланга, чтобы вода не капала."
                            }
                        },
                        {
                            "text": "The mechanic tightened the bolt after inserting a small metal <w>washer</w> to distribute the pressure evenly.",
                            "target_lang_translations": {
                                "ru": "Механик затянул болт, вставив небольшую металлическую <w>шайбу</w> для равномерного распределения давления."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rubber washer",
                        "metal washer",
                        "lock washer",
                        "flat washer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкое плоское кольцо из металла, резины или пластика, помещаемое под гайку или болт для распределения давления или предотвращения протечек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шайба",
                                "target_lang_sense_clarification": "техническая деталь"
                            },
                            {
                                "target_lang_word": "прокладка",
                                "target_lang_sense_clarification": "уплотнительная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2149e253-9158-3241-9940-d3dd8146eadb",
                    "sense_definition": "A person whose job is to wash items, particularly clothes or dishes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "occupations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, the village <w>washer</w> would take all the linens down to the river every Monday morning.",
                            "target_lang_translations": {
                                "ru": "В прошлом деревенская <w>прачка</w> каждое утро понедельника относила всё белье к реке."
                            }
                        },
                        {
                            "text": "The restaurant hired a professional dish <w>washer</w> to help the kitchen staff during the busy weekend shifts.",
                            "target_lang_translations": {
                                "ru": "Ресторан нанял профессионального <w>посудомойщика</w>, чтобы помогать персоналу кухни во время загруженных смен по выходным."
                            }
                        }
                    ],
                    "synonyms": [
                        "washerman",
                        "washerwoman",
                        "laundryman"
                    ],
                    "common_phrases": [
                        "dish washer",
                        "window washer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чья работа заключается в мытье чего-либо, особенно одежды или посуды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мойщик",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "прачка",
                                "target_lang_sense_clarification": "стирающая белье"
                            },
                            {
                                "target_lang_word": "посудомойщик",
                                "target_lang_sense_clarification": "моющий посуду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfec33b5-988d-3335-871e-57e97794eb5d",
                    "sense_definition": "A small cloth used for washing the face or body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toiletries",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She grabbed a clean <w>washer</w> from the linen closet to scrub her face before going to bed.",
                            "target_lang_translations": {
                                "ru": "Она взяла чистую <w>салфетку</w> из шкафа с бельем, чтобы умыть лицо перед сном."
                            }
                        },
                        {
                            "text": "Please hang your wet <w>washer</w> on the rail so that it can dry properly before the next use.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, повесь свою мокрую <w>мочалку</w> на перекладину, чтобы она как следует высохла до следующего использования."
                            }
                        }
                    ],
                    "synonyms": [
                        "facecloth",
                        "washcloth",
                        "flannel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая тряпочка или салфетка, используемая для мытья лица или тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочалка",
                                "target_lang_sense_clarification": "для тела"
                            },
                            {
                                "target_lang_word": "салфетка для умывания",
                                "target_lang_sense_clarification": "для лица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd06b3c1-6c15-35e0-90b7-fd32fc7668c5",
                    "sense_definition": "A person who washes their hands or body compulsively, often as a symptom of a psychological condition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist worked with the compulsive <w>washer</w> to help reduce the frequency of their hand-cleaning rituals.",
                            "target_lang_translations": {
                                "ru": "Терапевт работал с человеком, страдающим <w>навязчивым мытьем рук</w>, чтобы помочь сократить частоту ритуалов очищения."
                            }
                        },
                        {
                            "text": "As a chronic <w>washer</w>, he found it difficult to leave the house without cleaning his hands multiple times.",
                            "target_lang_translations": {
                                "ru": "Как человек с <w>манией чистоты</w>, ему было трудно выйти из дома, не помыв руки несколько раз."
                            }
                        }
                    ],
                    "common_phrases": [
                        "compulsive washer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который навязчиво моет руки или тело, часто как симптом психологического расстройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистюля",
                                "target_lang_sense_clarification": "в контексте ОКР"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d71f6c58-ef8c-3dfb-84de-7864295d0e37",
                    "sense_definition": "To provide or equip a mechanical part or joint with a washer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician carefully <w>washered</w> the joint to ensure that the seal would remain airtight under high pressure.",
                            "target_lang_translations": {
                                "ru": "Техник тщательно <w>проложил шайбой</w> соединение, чтобы обеспечить герметичность уплотнения под высоким давлением."
                            }
                        },
                        {
                            "text": "You must <w>washer</w> the bolt properly before tightening it to avoid damaging the surface of the machine.",
                            "target_lang_translations": {
                                "ru": "Вы должны правильно <w>установить шайбу</w> на болт перед затягиванием, чтобы не повредить поверхность машины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать или оснащать механическую деталь или соединение шайбой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладывать шайбой",
                                "target_lang_sense_clarification": "техническое действие"
                            },
                            {
                                "target_lang_word": "уплотнять",
                                "target_lang_sense_clarification": "с помощью шайбы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d1f3b24f-54b7-3d46-ade9-4a1dbe184b15",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Washer</w> has been living in this neighborhood for over thirty years and is well-known by everyone.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уошер</w> живет в этом районе уже более тридцати лет, и его все знают."
                            }
                        },
                        {
                            "text": "The historical documents mention a family named <w>Washer</w> who owned a small farm in the valley.",
                            "target_lang_translations": {
                                "ru": "В исторических документах упоминается семья по фамилии <w>Уошер</w>, которая владела небольшой фермой в долине."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уошер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
