                "senses": [
                    {
                        "sense_id": "8f351dbc-14a9-3214-89fe-ed692ce4b3e5",
                        "entry_id": "6062872e-1042-3ddc-9958-5ca1c561ec0e",
                        "glosses": [
                            "Person, die Kindern auf einer Grundschule Wissen vermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23cbf3ea-51e2-4a42-99e4-d1be9f2893a6",
                                "sense_id": "8f351dbc-14a9-3214-89fe-ed692ce4b3e5",
                                "text": "Als Grundschullehrer sollte man gut mit Kindern umgehen können."
                            },
                            {
                                "example_id": "d9d61bd7-edf4-43a7-8760-c60f5fad46ef",
                                "sense_id": "8f351dbc-14a9-3214-89fe-ed692ce4b3e5",
                                "text": "Nicht mal Grundschullehrer kriegen mit, was im Kindergarten alles geleistet wird."
                            },
                            {
                                "example_id": "1e7836c4-3109-47ba-b690-5fab251a5daf",
                                "sense_id": "8f351dbc-14a9-3214-89fe-ed692ce4b3e5",
                                "text": "„Es fiel ihr aber schwer, sich Ingibjörn als Grundschullehrer vorzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
