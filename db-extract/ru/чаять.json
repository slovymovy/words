                "senses": [
                    {
                        "sense_id": "efb6cdb4-5f15-305e-87c3-a04b22479a39",
                        "entry_id": "812b9c6c-0511-3b3b-b6af-c62a7adceab7",
                        "glosses": [
                            "to expect, to hope"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d1a922d5-45af-4e9f-bf53-3fdfd369a1bb",
                                "sense_id": "efb6cdb4-5f15-305e-87c3-a04b22479a39",
                                "text": "души́ не ча́ять",
                                "translation": "to worship; dote",
                                "english": "to worship; dote"
                            },
                            {
                                "example_id": "1f2894b1-db1b-4ebf-94e7-0422a07b5465",
                                "sense_id": "efb6cdb4-5f15-305e-87c3-a04b22479a39",
                                "text": "Он был своего́ ро́да нова́тор и, ви́дя э́тот обветша́вший мир, стыди́лся его́ и ча́ял но́вого, по́лного ду́ха и и́стины.",
                                "translation": "He was in some ways an innovator, and seeing this antiquated world, was ashamed of it, and hoped for a new one full of spirit and truth.",
                                "english": "He was in some ways an innovator, and seeing this antiquated world, was ashamed of it, and hoped for a new one full of spirit and truth."
                            }
                        ]
                    }
                ],
