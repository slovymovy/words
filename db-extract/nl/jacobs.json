                        "examples": [
                            {
                                "example_id": "fe9bc12b-be43-4d6b-96f3-ff8bec98c00f",
                                "sense_id": "04f94057-40b4-38ba-832a-ef23973fbf2d",
                                "text": "Thea is een Amsterdamse die een toekomst nodig heeft, en dit huis vertegenwoordigt wat ze is! Overtuigend. Waardig. Rijk. Het huis trok Jacobs aandacht en hij zag Thea daarin zitten."
                            },
                            {
                                "example_id": "40dbabbc-db81-4aa9-a2ff-576d2e95016c",
                                "sense_id": "04f94057-40b4-38ba-832a-ef23973fbf2d",
                                "text": "Jacobs huis bezorgt haar een lichamelijke schok voordat ze opgaat in de rust en de schoonheid ervan. De geluiden van de gracht verflauwen als ze wordt omhuld door de symmetrie, de goede smaak, de fluwelen stoffen en de barnsteenkransen."
                            }
                        ]
                    }
