                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25e2d73e-8b0d-3dbd-876f-6c5664b76d5e",
                                        "entry_id": "a5ff5e8d-3e3c-32b4-9346-eb22b3f8fb1c",
                                        "glosses": [
                                            "Petite boule réalisée à partir des feuilles du pastel (Isatis tinctoria) dont on extrait une teinture de couleur bleue."
                                        ],
