                "senses": [
                    {
                        "sense_id": "051f3da8-d567-3a0c-b36d-a6d65d43bfe3",
                        "entry_id": "e00e75bd-a4aa-3aa2-896c-786fe411ca86",
                        "glosses": [
                            "Nahrungsmittel aus behandelten Körnern, das zum Frühstück gegessen wird"
                        ],
                        "tags": [
                            "Gebrauch meist im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ef1cc36a-0ba1-4eb8-81b1-dc670f2cfcc0",
                                "sense_id": "051f3da8-d567-3a0c-b36d-a6d65d43bfe3",
                                "text": "„Wenn man das zu weit trieb, konnte es in Paranoia ausarten, bis man sogar hinter der Art, wie die Schachteln mit Frühstücksflocken im Regal aufgereiht waren, eine Verschwörung witterte.“"
                            },
                            {
                                "example_id": "c947ce48-790a-4443-9090-cac4682d288e",
                                "sense_id": "051f3da8-d567-3a0c-b36d-a6d65d43bfe3",
                                "text": "„Er nimmt eine Schüssel Frühstücksflocken und ein Glas Orangensaft zu sich, und die ganze Zeit über bleiben seine Hände ruhig.“"
                            },
                            {
                                "example_id": "32b61d6f-1e5f-4bdb-9b47-a3382855abae",
                                "sense_id": "051f3da8-d567-3a0c-b36d-a6d65d43bfe3",
                                "text": "„Sie fanden ihn an seinem Arbeitsplatz, wo er stark zuckerhaltige Frühstücksflocken aß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
