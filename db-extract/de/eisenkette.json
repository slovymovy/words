                        "examples": [
                            {
                                "example_id": "07f1dcb5-4fb3-4146-9f1b-7a372deac031",
                                "sense_id": "70a9b739-f7b1-3e11-b1cc-47ee529ba079",
                                "text": "„Verrostete Eisenketten hatten sich aus ihrer Verankerung gelöst.“"
                            },
                            {
                                "example_id": "770bcbc3-8c08-40b9-b5c3-e5f94b8161d4",
                                "sense_id": "70a9b739-f7b1-3e11-b1cc-47ee529ba079",
                                "text": "„Eine Eisenkette hält die beiden Tore zusammen.“"
                            },
                            {
                                "example_id": "a72fa55b-1bf6-445e-9a44-20466cd26070",
                                "sense_id": "70a9b739-f7b1-3e11-b1cc-47ee529ba079",
                                "text": "„Die Eisenketten, die sich in niederem Boden von Steinpflock zu Steinpflock schwangen, klirrten mitunter auf, als wären sie von einer Erderschütterung angerührt.“"
                            }
                        ],
