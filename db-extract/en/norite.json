                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71188add-52ea-4097-8627-97b215851010",
                                                "sense_id": "61452169-a895-3bdd-8dab-3046874acfa1",
                                                "text": "La norite est beaucoup plus acide que le gabbro, plus riche en alcalis, plus alumineuse et également plus pauvre en chaux et en magnésie."
                                            }
