                "senses": [
                    {
                        "sense_id": "0b92dd77-0903-3401-ad60-25c22fa65623",
                        "entry_id": "d9f6700e-4683-3a9c-86f3-43ab4dcbfb48",
                        "glosses": [
                            "Animal monogastrique."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "0d6ffc5a-37b9-4b81-82d3-36451579b3b0",
                                "sense_id": "0b92dd77-0903-3401-ad60-25c22fa65623",
                                "text": "Les animaux qui se nourrissent principalement de viande, tels que les chiens, les chats et les lions, et ceux qui acceptent une alimentation variée tels que les porcs, et l’homme, possèdent un estomac composé d’une seule poche (ce sont des monogastriques)."
                            },
                            {
                                "example_id": "59b5ea1e-9263-43a9-af92-287e5b8a524f",
                                "sense_id": "0b92dd77-0903-3401-ad60-25c22fa65623",
                                "text": "Le comportement alimentaire du monogastrique existe afin de répondre à une volonté de l’organisme de réguler son énergie interne. Il se définit comme une organisation complexe mettant en jeu différents niveaux de régulation."
                            }
                        ]
                    },
