            {
                "entry_id": "95895033-5478-317e-9385-1e6ea589e63d",
                "word": "beschermd",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fb4e023b-2e2e-3cbe-ace1-33de128f6b44",
                        "entry_id": "95895033-5478-317e-9385-1e6ea589e63d",
                        "glosses": [
                            "voltooid deelwoord van beschermen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "457d974f-441b-4a75-adbd-e11d719e35df",
                                "sense_id": "fb4e023b-2e2e-3cbe-ace1-33de128f6b44",
                                "text": "De maatschappij moet tegen personen als u worden beschermd."
                            },
                            {
                                "example_id": "7f308416-d58f-435a-9b6e-cf063dd147b0",
                                "sense_id": "fb4e023b-2e2e-3cbe-ace1-33de128f6b44",
                                "text": "In de Tweede Kamer zette hij zich in voor natuur en milieu, zoals met zijn aanvankelijk eenzame verzet tegen de afsluiting van de Oosterschelde. Het leidde tot de Oosterscheldekering, een compromis waarmee Zeeland tegen de zee werd beschermd, maar de natuur toch vrij spel hield."
                            },
                            {
                                "example_id": "082b38d7-12e7-4597-a965-d54e8b497423",
                                "sense_id": "fb4e023b-2e2e-3cbe-ace1-33de128f6b44",
                                "text": "Al dat vet moest hem tegen onderkoeling beschermd hebben."
                            },
                            {
                                "example_id": "742405d4-2666-440b-ac0e-2f3505b864e7",
                                "sense_id": "fb4e023b-2e2e-3cbe-ace1-33de128f6b44",
                                "text": "De alleen door liefhebbers beschermde natuurgebieden waren uiterst kwetsbaar."
                            },
                            {
                                "example_id": "67bf4594-8c26-45dc-9b05-7e5245f35d59",
                                "sense_id": "fb4e023b-2e2e-3cbe-ace1-33de128f6b44",
                                "text": "Niet zo langgeleden was de vos nog beschermd in Nederland."
                            }
                        ]
                    }
                ],
