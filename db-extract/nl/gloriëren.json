                            {
                                "example_id": "f3ab3e9d-a1ab-44c1-8038-9e8e1c966107",
                                "sense_id": "651138ce-6e75-33cf-9216-69d74c4ae7a9",
                                "text": "Misschien zou de VVD-premier graag gloriëren tussen de groten der aarde, maar Nederland wordt niet meer uitgenodigd, hoewel het nog altijd de zestiende economie in de wereld is."
                            },
                            {
                                "example_id": "6c1f8179-da24-41dc-9e2c-5f2fd5bc8d9d",
                                "sense_id": "651138ce-6e75-33cf-9216-69d74c4ae7a9",
                                "text": "Natuurlijk, in dat hele sportjaar 2012 doen ook oneindig veel internationale toppers mee, bij wie we ook kunnen wegdromen. Mannen en vrouwen met gebeeldhouwde lijven, ongeëvenaarde artisticiteit en kolkende emoties. Maar tussen al die bedrijven door willen we ook zo graag Nederlanders zien gloriëren. Dat geeft zo'n jaar net dat extra beetje cachet."
                            }
                        ]
