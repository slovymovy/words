                    {
                        "sense_id": "1f7cac7a-5bf9-375e-b121-6cfca82e07d2",
                        "entry_id": "eaff2ded-9bef-3b78-923e-56d3a1a48766",
                        "glosses": [
                            "früher gegen jemanden verhängte Strafe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fb2e23-5184-4a8e-83ac-4aa4c582a2d3",
                                "sense_id": "1f7cac7a-5bf9-375e-b121-6cfca82e07d2",
                                "text": "Die Vorstrafen einer Person werden in deren polizeilichem Führungszeugnis aufgeführt."
                            },
                            {
                                "example_id": "57dcb107-2b38-4bab-b7d3-a97c5f06012e",
                                "sense_id": "1f7cac7a-5bf9-375e-b121-6cfca82e07d2",
                                "text": "„Ich sah auch hinter der Glastür den Burschen vorbeigehen, dem man seiner Vorstrafen halber das amerikanische Transit verweigert hatte.“"
                            }
                        ],
