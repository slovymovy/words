                "senses": [
                    {
                        "sense_id": "967a98fb-7a1a-3791-95b2-2fa57b7e22a3",
                        "entry_id": "70b54f9b-6078-3d80-9a74-5768f43d27ba",
                        "glosses": [
                            "Gegend, die hauptsächlich zum Wohnen genutzt wird, also nicht gewerblich oder industriell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "531cea09-e54f-4c71-90b2-1c812dc96808",
                                "sense_id": "967a98fb-7a1a-3791-95b2-2fa57b7e22a3",
                                "text": "„Wie hoch ist die ortsübliche Miete, was zahlen andere Mieter in ähnlichen Objekten, ist das Viertel eine beliebte Wohngegend oder wechseln die Mieter dort sehr häufig? All diese Fragen muss der Käufer beantworten können, um die Vermietbarkeit der Immobilie realistisch einschätzen zu können.“"
                            },
                            {
                                "example_id": "e28db95b-0cf8-4c9a-b07e-288a1a20a7ab",
                                "sense_id": "967a98fb-7a1a-3791-95b2-2fa57b7e22a3",
                                "text": "„Die eleganten Häuser in dieser Wohngegend lagen rechts und links jeweils etwa 100 Meter von der Anliegerstraße entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29d54422-0849-4d94-ae99-863641f3cd0a",
                        "source_entry_id": "70b54f9b-6078-3d80-9a74-5768f43d27ba",
                        "source_sense_id": "967a98fb-7a1a-3791-95b2-2fa57b7e22a3",
                        "source_sense_description": "Gegend, die hauptsächlich zum Wohnen genutzt wird, also nicht gewerblich oder industriell",
                        "target_lang_word": "neighborhood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neighborhood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba7c9f73-e866-302c-b332-40293d49a9b9",
                                        "entry_id": "a1c95588-9199-30b6-b12a-120ac6715385",
                                        "glosses": [
                                            "The residential area near one's home."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d37cdd-d7eb-4ba8-8f4e-1f241ed22741",
                                                "sense_id": "ba7c9f73-e866-302c-b332-40293d49a9b9",
                                                "text": "He lives in my neighborhood."
                                            },
                                            {
                                                "example_id": "5b0ab087-c980-4739-8cdd-157e97a14dfd",
                                                "sense_id": "ba7c9f73-e866-302c-b332-40293d49a9b9",
                                                "text": "I know the shadiest breeziest spots, hidden tables surrounded by trees that have lived longer than the neighborhoods around them. […] I simply remembered a great little park in a neighborhood where I used to teach at the elementary school up the road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "629cbfa4-403a-3608-8aa8-a3b314c77429",
                                        "entry_id": "a1c95588-9199-30b6-b12a-120ac6715385",
                                        "glosses": [
                                            "The inhabitants of a residential area."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc6a06ef-3458-4c1c-a92f-fab4a5dbde32",
                                                "sense_id": "629cbfa4-403a-3608-8aa8-a3b314c77429",
                                                "text": "The fire alarmed the neighborhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe4a1892-ab7c-3b68-a58f-4c0963ef50a4",
                                        "entry_id": "a1c95588-9199-30b6-b12a-120ac6715385",
                                        "glosses": [
                                            "A formal or informal division of a municipality or region."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02fc2a42-3e51-426f-b7c2-b5f9200ca1d6",
                                                "sense_id": "fe4a1892-ab7c-3b68-a58f-4c0963ef50a4",
                                                "text": "We have just moved to a pleasant neighborhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a3212a8-9a62-3b83-8632-12761348392c",
                                        "entry_id": "a1c95588-9199-30b6-b12a-120ac6715385",
                                        "glosses": [
                                            "An approximate amount."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a30c215-47f5-44df-acc0-436f79445e38",
                                                "sense_id": "5a3212a8-9a62-3b83-8632-12761348392c",
                                                "text": "He must be making in the neighborhood of $200,000 per year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd3343f5-8fbd-345c-a346-b8b739537007",
                                        "entry_id": "a1c95588-9199-30b6-b12a-120ac6715385",
                                        "glosses": [
                                            "The quality of physical proximity."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e50242e-72b8-4deb-b171-323ff7059135",
                                                "sense_id": "fd3343f5-8fbd-345c-a346-b8b739537007",
                                                "text": "The slums and the palace were in awful neighborhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02a82bab-ed02-3f02-88fd-e767d28f2169",
                                        "entry_id": "a1c95588-9199-30b6-b12a-120ac6715385",
                                        "glosses": [
                                            "The quality of being a neighbor, of living nearby, next to each other; proximity."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d0b233-801c-42ed-82c3-744c4a5319b9",
                                                "sense_id": "02a82bab-ed02-3f02-88fd-e767d28f2169",
                                                "text": "Our neighborhood was our only reason to exchange hollow greetings."
                                            },
                                            {
                                                "example_id": "6f7b0e2f-8c62-4187-9c74-9b0b616e0744",
                                                "sense_id": "02a82bab-ed02-3f02-88fd-e767d28f2169",
                                                "text": "1595, George Peele, The Old Wives’ Tale, The Malone Society Reprints, 1908, lines 243-245,\n[…] if you do any thing for charity, helpe me; if for neighborhood or brotherhood, helpe me […]"
                                            },
                                            {
                                                "example_id": "4d0afebc-70b2-46a9-b094-c28c7411b9c2",
                                                "sense_id": "02a82bab-ed02-3f02-88fd-e767d28f2169",
                                                "text": "Take her, fair son, and from her blood raise up\nIssue to me; that the contending kingdoms\nOf France and England, whose very shores look pale\nWith envy of each other’s happiness,\nMay cease their hatred; and this dear conjunction\nPlant neighbourhood and Christian-like accord\nIn their sweet bosoms […]"
                                            },
                                            {
                                                "example_id": "cbe8b9e6-0ffb-48fa-8b1c-d903b614af0d",
                                                "sense_id": "02a82bab-ed02-3f02-88fd-e767d28f2169",
                                                "text": "Nor content with such / Audacious neighbourhood, the wisest heart / Of Solomon he led by fraud to build / His Temple right against the Temple of God."
                                            },
                                            {
                                                "example_id": "d9b88832-8e35-4826-b03b-9cff5cc65cfb",
                                                "sense_id": "02a82bab-ed02-3f02-88fd-e767d28f2169",
                                                "text": "Then the prison and the palace were in awful neighbourhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "222d040b-0fbb-3a41-af62-55d05e0a7f7b",
                                        "entry_id": "a1c95588-9199-30b6-b12a-120ac6715385",
                                        "glosses": [
                                            "Close proximity; nearness."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea634cf3-8aef-497f-87da-73858882a37f",
                                                "sense_id": "222d040b-0fbb-3a41-af62-55d05e0a7f7b",
                                                "text": "At first he was partly hidden among the latschen, then his hind-quarters, quite black, emerged from the dark green bushes, as he slowly moved on, perfectly unconscious of our neighbourhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f33291-6ad9-32bc-a330-e096251cf70c",
                                        "entry_id": "a1c95588-9199-30b6-b12a-120ac6715385",
                                        "glosses": [
                                            "The disposition becoming a neighbor; neighborly kindness or good will."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
