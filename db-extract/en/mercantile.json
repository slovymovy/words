                        "translation_id": "6157f69d-a579-4e63-a7d0-e1aea584588a",
                        "source_entry_id": "7b90ab4f-cdc8-3d5d-8f87-9084b35b9ff5",
                        "source_sense_description": "related to the exchange of goods for profit",
                        "target_lang_word": "mercantile",
