                    ]
                },
                {
                    "sense_id": "98f5a241-263a-3c76-91fd-5661e9d98ef9",
                    "sense_definition": "eine Leistung oder ein Vorhaben zu einem besonders erfolgreichen Abschluss oder Höhepunkt führen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vollendung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit dem Gewinn der Goldmedaille <w>krönte</w> die Sportlerin ihre lange und erfolgreiche Karriere."
                        },
                        {
                            "text": "Nach monatelanger harter Arbeit waren ihre Bemühungen endlich von Erfolg <w>gekrönt</w>."
