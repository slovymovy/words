                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdb5ccc3-6cfd-4a04-867b-4537637d96c8",
                        "source_entry_id": "3c7c7acc-3c9d-39c4-8bdb-197e17972824",
                        "source_sense_id": "b24cd008-074e-3df6-a609-57054fb00f0f",
                        "target_lang_word": "zombie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zombie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b2b868d-7876-31ab-b0e8-af2e4da5e178",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "A person, usually undead, animated by unnatural forces (such as magic), with no soul or will of his or her own."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3592dd0f-3266-4efc-8f23-fc2f7712078c",
                                                "sense_id": "4b2b868d-7876-31ab-b0e8-af2e4da5e178",
                                                "text": "Betsy Connell: I don't know about zombies, doctor. Just what is a zombie? / Dr. Maxwell: A ghost. A living dead. It's also a drink."
                                            },
                                            {
                                                "example_id": "0c794445-2890-4ce5-891a-0d15c09ab3f3",
                                                "sense_id": "4b2b868d-7876-31ab-b0e8-af2e4da5e178",
                                                "text": "The zombies were having fun\nThe party had just begun\nThe guests included Wolf-Man, Dracula, and his son."
                                            },
                                            {
                                                "example_id": "fd57dd96-a133-4c3a-b9e9-6b6544dcbc9e",
                                                "sense_id": "4b2b868d-7876-31ab-b0e8-af2e4da5e178",
                                                "text": "Ashley: Dad passed on a few years back. He's probably still watching, though.\nShepard: He's not a zombie, is he?"
                                            },
                                            {
                                                "example_id": "3562bef7-f4d8-42dc-9fe6-3873949ad19d",
                                                "sense_id": "4b2b868d-7876-31ab-b0e8-af2e4da5e178",
                                                "text": "The zombies first show up 20 minutes in, after Melanie volunteers herself as the next child to mysteriously disappear in the middle of the night. That’s when we learn that Melanie and her classmates are all “hungries,” or people infected with a toxic fungus that turns them into mindless flesh-eating animals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e31225d-7bb5-33a8-bb04-8b356b9ea4c6",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "An apathetic or slow-witted person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7944533-21e5-33ed-9d7f-4bef9172e225",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "A human being in a state of extreme mental exhaustion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "720703b2-a830-418e-aca2-49079666102d",
                                                "sense_id": "b7944533-21e5-33ed-9d7f-4bef9172e225",
                                                "text": "After working for 18 hours on the computer, I was a zombie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4dfd6f3-7446-30d5-83f0-517c2e80772d",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "Someone or something that should be dead but is not."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add11cea-6233-4a94-85c5-cb06411445a5",
                                                "sense_id": "b4dfd6f3-7446-30d5-83f0-517c2e80772d",
                                                "text": "I would advise anyone who does not share its politics — surely the great majority of gay men and lesbians — to shun NOLAG for the anachronistic zombie it is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "961d7e35-bb41-3785-8798-69798ffe366c",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "An information worker who has signed a nondisclosure agreement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea55a397-8686-3ac8-a9a7-8d987a6a91e0",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "A process or task which has terminated but has not been removed from the list of processes, typically because it has an unresponsive parent process."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8c3355-a23d-46b1-8b61-385b52dfec65",
                                                "sense_id": "ea55a397-8686-3ac8-a9a7-8d987a6a91e0",
                                                "text": "1986, Maurice J. Bach, The Design of the Unix Operating System, Prentice-Hall, Englewood Cliffs, New Jersey, USA, See \"Process States and Transitions,\" p. 147.\n9. The process executed the exit system call and is in the zombie state. The process no longer exists, but it leaves a record containing an exit code and some timing statistics for its parent process to collect. The zombie state is the final state of a process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d169c7a7-bf05-3142-8c76-bc9d96bebc87",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "A computer affected by malware which causes it to do whatever the attacker wants it to do without the user's knowledge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8a9973d-d585-37d1-84f2-e31e6e3cf2c4",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "A cocktail of rum and fruit juices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6a7c993-38ca-42f7-885c-eb116f225d83",
                                                "sense_id": "b8a9973d-d585-37d1-84f2-e31e6e3cf2c4",
                                                "text": "She takes the taxi to the good hotel / Bon marché as far as she can tell / She drinks the zombie from the cocoa shell"
                                            },
                                            {
                                                "example_id": "a1568690-869a-458e-b68b-37d8cd1cd4f3",
                                                "sense_id": "b8a9973d-d585-37d1-84f2-e31e6e3cf2c4",
                                                "text": "The maitre d’ introduced us and I had a zombie with him. Those zombies are wicked.\n[…]\nI watched Mario and drank zombies out of a thermos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d136f4-055b-3e81-8133-cf4a823226f4",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "A conscripted member of the Canadian military during World War II who was assigned to home defence rather than to combat in Europe."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "derogatory",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81aa5f32-cedf-49dc-abf7-fd6e7b67eaba",
                                                "sense_id": "e3d136f4-055b-3e81-8133-cf4a823226f4",
                                                "text": "1944, \"Time for Decision,\" Time (US edition), 6 Nov.,\nHad the time come to order Canada's home defense draftees—some 70,000 zombies idling at home—to battle overseas?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc8cc1a8-5bc1-31b9-94de-5eb0ea2220b3",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "Marijuana, or similar drugs."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89fd1e6b-964b-44ae-9e91-5bda7983210b",
                                                "sense_id": "dc8cc1a8-5bc1-31b9-94de-5eb0ea2220b3",
                                                "text": "Traveling in a fried-out Kombi / On a hippie trail, head full of zombie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2cf7598-925d-38c1-8330-a2fd65edb901",
                                        "entry_id": "3a1047e7-a8d2-3811-9474-52573786da56",
                                        "glosses": [
                                            "A hypothetical being that is indistinguishable from a normal human being except in that it lacks conscious experience, qualia, or sentience."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
