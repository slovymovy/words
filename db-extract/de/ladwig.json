                "senses": [
                    {
                        "sense_id": "39d52979-3d36-3114-8a4d-87e87710ccac",
                        "entry_id": "201a54d2-96d6-3fc1-83f6-e0c6f71256f5",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fe4d0d-b908-4276-95db-c69f00a9e8fe",
                                "sense_id": "39d52979-3d36-3114-8a4d-87e87710ccac",
                                "text": "Frau Ladwig ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "52515a1e-e8cf-4bd6-9703-b3dfdbb894f2",
                                "sense_id": "39d52979-3d36-3114-8a4d-87e87710ccac",
                                "text": "Herr Ladwig wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0c694c31-ed15-4ce7-aaae-2d3b07f9235b",
                                "sense_id": "39d52979-3d36-3114-8a4d-87e87710ccac",
                                "text": "Die Ladwigs fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "4c377cdb-31bd-4225-9ab8-ee153919ce27",
                                "sense_id": "39d52979-3d36-3114-8a4d-87e87710ccac",
                                "text": "Der Ladwig trägt nie die Pullover, die die Ladwig ihm strickt."
                            },
                            {
                                "example_id": "0cdf7afa-4443-470b-b792-83fb9b307563",
                                "sense_id": "39d52979-3d36-3114-8a4d-87e87710ccac",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ladwig kommt, geht der Herr Ladwig.“"
                            },
                            {
                                "example_id": "0568fec9-7737-484e-80c7-9dbb06990944",
                                "sense_id": "39d52979-3d36-3114-8a4d-87e87710ccac",
                                "text": "Ladwig kommt und geht."
                            },
                            {
                                "example_id": "1b9fb71c-5f62-4757-ae9b-0ec9e755d360",
                                "sense_id": "39d52979-3d36-3114-8a4d-87e87710ccac",
                                "text": "Ladwigs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
