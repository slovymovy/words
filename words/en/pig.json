                    "sense_definition": "To give birth to piglets (used of a sow).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_birth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The black sow <w>pigged</w> early this morning in the barn.",
                            "target_lang_translations": {
                                "ru": "Черная свиноматка <w>опоросилась</w> сегодня рано утром в сарае.",
                                "zh": "那头黑母猪今天清晨在谷仓里<w>产仔</w>了。"
                            }
