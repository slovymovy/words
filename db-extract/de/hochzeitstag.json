                ],
                "senses": [
                    {
                        "sense_id": "00d72d8f-dd3c-3f8f-a70c-7e4598e28f41",
                        "entry_id": "92d5a928-fa43-362e-b20f-20872bf52f47",
                        "glosses": [
                            "Tag der Hochzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e461d1b5-1f9d-4617-a077-071cb0ecd80a",
                                "sense_id": "00d72d8f-dd3c-3f8f-a70c-7e4598e28f41",
                                "text": "Am Hochzeitstag stand eine blumengeschmückte Kutsche für das Brautpaar bereit."
                            },
                            {
                                "example_id": "ef3140a6-4679-4a1c-a5ea-4734853e0666",
                                "sense_id": "00d72d8f-dd3c-3f8f-a70c-7e4598e28f41",
                                "text": "„Ein älteres Paar, das sich seit frühester Jugend kannte, feiert seinen 50. Hochzeitstag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ae3b9b58-e105-394e-a2a5-f8b783480c7e",
                        "entry_id": "92d5a928-fa43-362e-b20f-20872bf52f47",
                        "glosses": [
                            "Tag, an dem sich die Eheschließung jährt, Jahrestag der Hochzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5dd6e6-ca88-4902-a92c-e44ed6d31359",
                                "sense_id": "ae3b9b58-e105-394e-a2a5-f8b783480c7e",
                                "text": "Zum Hochzeitstag schenkt er seiner Frau jedes Jahr rote Rosen."
                            },
                            {
                                "example_id": "e2edac8d-a304-42ae-bb26-f25957970e7f",
                                "sense_id": "ae3b9b58-e105-394e-a2a5-f8b783480c7e",
                                "text": "„Seit sie am Hochzeitstag den funkelnden Blick bemerkt hatte, den Titus ihrer Brautjungfer zuwarf, wusste sie, dass er ihr niemals treu sein würde.“"
                            },
                            {
                                "example_id": "07728980-da2f-4f0c-8899-2c0beefead67",
                                "sense_id": "ae3b9b58-e105-394e-a2a5-f8b783480c7e",
                                "text": "„Am folgenden Tage – Simen Tjing war ins Amt gegangen – begaben sich Frau Mondtraut und die anderen Frauen in fünf Sänften zur Feier des dritten Hochzeitstages der Schwägerin Wu.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
