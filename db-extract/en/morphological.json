                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "626f5e2d-3cb0-37c6-975f-2499aa77c2b7",
                                        "entry_id": "06bac396-a387-3e77-89b1-bfe0ea5fbb0b",
                                        "glosses": [
                                            "betrekking hebbend op de vorm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716ac435-e15f-4c9e-b23c-09cdfbe86d0e",
                                                "sense_id": "626f5e2d-3cb0-37c6-975f-2499aa77c2b7",
                                                "text": "Volgens Hoekstra levert hij een sterke aanwijzing voor het bestaan van ‘bursts of evolution’ op genetisch (en niet alleen morfologisch) niveau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52fd4a6b-87a9-3e64-9460-97f2db7dd64a",
                                        "entry_id": "06bac396-a387-3e77-89b1-bfe0ea5fbb0b",
                                        "glosses": [
                                            "partitief van de stellende trap van morfologisch"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a01f133e-6fd9-4999-97b1-530ebf2db623",
                                                "sense_id": "52fd4a6b-87a9-3e64-9460-97f2db7dd64a",
                                                "text": "Het morfeem is 1 keer meegeteld bij de analyse omdat het hier niet gaat om een fonologisch effect maar om iets morfologisch dat de fonologie beïnvloedt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
