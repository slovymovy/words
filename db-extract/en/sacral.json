                    {
                        "translation_id": "c1180401-16fc-4968-b533-a51d5bbff7c9",
                        "source_entry_id": "a9ce7587-63e2-3451-8391-79813c6d480a",
                        "source_sense_description": "(anatomy) of the sacrum",
                        "target_lang_word": "sacral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1196aaab-c27e-388d-b56a-856131ef9e6c",
                                        "entry_id": "d684ba8e-ca81-336f-8d4f-3b94ff3c5673",
                                        "glosses": [
                                            "Relatif au sacrum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88121d68-6fae-4b64-9e4d-99431184375e",
                                                "sense_id": "1196aaab-c27e-388d-b56a-856131ef9e6c",
                                                "text": "Le Tableau 9.1 récapitule les principales caractéristiques des vertèbres cervicales, thoraciques, lombales et sacrales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd45399f-740c-3fce-b65c-3939feee53b2",
                                        "entry_id": "d684ba8e-ca81-336f-8d4f-3b94ff3c5673",
                                        "glosses": [
                                            "Sacré, religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e64115a-d853-4603-bdd2-c1ce5c5bb714",
                                                "sense_id": "cd45399f-740c-3fce-b65c-3939feee53b2",
                                                "text": "Ceux-ci se perçoivent, en effet, comme membres d’une petite société politique qui se voit transformée, en vertu de la célébration liturgique, en une communauté sacrale réalisant la perfection islamique."
                                            },
                                            {
                                                "example_id": "458f02fb-acc3-4d13-88ff-0ca38d098e32",
                                                "sense_id": "cd45399f-740c-3fce-b65c-3939feee53b2",
                                                "text": "De toute façon, peuvent-ils dire : « La laïcité, c’est une affaire d’Occidentaux des sociétés sécularisées», ce qui ne tient pas compte des nombreuses sociétés sacrales qui existent encore aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
