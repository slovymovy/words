                "senses": [
                    {
                        "sense_id": "50f1b166-ab2a-3953-8354-7ac27e02133c",
                        "entry_id": "c2d59eae-fd58-3ade-bb30-3dd8cf8170a4",
                        "glosses": [
                            "Instrument zur Bestimmung des Luftdrucks beim Ein- und Ausatmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "259c6835-89d6-439a-9501-99a17da46aeb",
                                "sense_id": "50f1b166-ab2a-3953-8354-7ac27e02133c",
                                "text": "„Die pneumatometrische Messung erfolgt mittelst des Waldenburg'schen Pneumatometers.“"
                            },
                            {
                                "example_id": "a9f8e464-5898-47a4-bb18-36bdb2daecf5",
                                "sense_id": "50f1b166-ab2a-3953-8354-7ac27e02133c",
                                "text": "„Das Pneumatometer stellt eine U-förmige mit Quecksilber gefüllte Röhre dar, neben welcher sich eine Millimetereintheilung befindet […].“"
                            },
                            {
                                "example_id": "622bf10f-b712-4784-8273-bf2754ae5a2d",
                                "sense_id": "50f1b166-ab2a-3953-8354-7ac27e02133c",
                                "text": "„Als ein neues Hülfsmittel für die Diagnose des Emphysems sowie anderer Lungenkrankheiten hat Waldenburg das Pneumatometer (ein Quecksilber-Manometer) in die Praxis eingeführt.“"
                            },
                            {
                                "example_id": "ac706d70-e361-47c9-8afc-85927ac0b2e9",
                                "sense_id": "50f1b166-ab2a-3953-8354-7ac27e02133c",
                                "text": "„Das Hauptinteresse seiner Arbeit gipfelt in den Messungen der Lungencapacität, der Stärke der Exspiration und Inspiration (mit Hülfe des Pneumatometers) und endlich in der Kraft der oberen Extremitäten (mit dem Dynamometer).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
