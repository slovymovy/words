        "nl-extract.jsonl": [
            {
                "entry_id": "fa50c1d6-419b-3391-b2ba-93e7dc2429f9",
                "word": "aangewend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5a0fd4e-1f33-358d-9c75-049e93de38b3",
                        "entry_id": "fa50c1d6-419b-3391-b2ba-93e7dc2429f9",
                        "glosses": [
                            "voor een bepaald doel gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41409907-8072-49c4-97df-3dd1c25caf72",
                                "sense_id": "e5a0fd4e-1f33-358d-9c75-049e93de38b3",
                                "text": "Tot nu toe stond de rechter toe dat de politie panden 'strafrechtelijk ontruimde' na 'huisvredebreuk' door krakers. Nu hebben rechtbanken bepaald dat de aangewende wetsartikelen (138 en 429 Wetboek van Strafrecht) wél legitimeren dat krakers worden gearresteerd, maar níét dat de gekraakte panden worden teruggegeven aan de eigenaar."
                            },
                            {
                                "example_id": "4135cbaf-7882-447f-bade-6e64647fe2a7",
                                "sense_id": "e5a0fd4e-1f33-358d-9c75-049e93de38b3",
                                "text": "'Zoo geraakte het gebruik van een warm middagmaal in discrediet. De zakjes met brood verdreven in snel tempo het aangewende hulpmiddel van pannetjes en potjes, die naar fabriek of werkplaats gebracht werden en in den regel voor drievierde met aardappelen gevuld werden,' aldus Amsterdamse socialist Monne de Miranda in 1921."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08c438ce-86b4-43eb-8a0b-63354e9dc0d4",
                        "source_entry_id": "fa50c1d6-419b-3391-b2ba-93e7dc2429f9",
                        "source_sense_id": "e5a0fd4e-1f33-358d-9c75-049e93de38b3",
                        "source_sense_description": "voor een bepaald doel gebruikt",
                        "target_lang_word": "practical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "practical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c551fe6-13fb-36a6-a98f-a8a9f3b86995",
                                        "entry_id": "183fb42e-40c1-3636-80bb-721db786994e",
                                        "glosses": [
                                            "Relating to, or based on, practice or action rather than theory or hypothesis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2bffa1b-ad47-486c-9d6c-12a18b763dc8",
                                                "sense_id": "5c551fe6-13fb-36a6-a98f-a8a9f3b86995",
                                                "text": "Jack didn't get an engineering degree, but has practical knowledge of metalworking."
                                            },
                                            {
                                                "example_id": "a65aa014-2044-4034-850b-f8e6bacab9bb",
                                                "sense_id": "5c551fe6-13fb-36a6-a98f-a8a9f3b86995",
                                                "text": "Modern engineering applies science to practical problems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2919ea77-a083-3446-93d2-afef95713601",
                                        "entry_id": "183fb42e-40c1-3636-80bb-721db786994e",
                                        "glosses": [
                                            "Being likely to be effective and applicable to a real situation; able to be put to use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffa9958-961c-412e-bea5-6bada882ae92",
                                                "sense_id": "2919ea77-a083-3446-93d2-afef95713601",
                                                "text": "Jack's knowledge has the practical benefit of giving us useful prototype parts."
                                            },
                                            {
                                                "example_id": "e1242d0c-08d5-4691-9335-ffcb565f1cc0",
                                                "sense_id": "2919ea77-a083-3446-93d2-afef95713601",
                                                "text": "Recruits will be taught in-depth electrical and mechanical engineering as well as gaining practical experience in rail maintenance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7b0c9e-f728-35bf-9c07-9c8eaba6749e",
                                        "entry_id": "183fb42e-40c1-3636-80bb-721db786994e",
                                        "glosses": [
                                            "Of a person, having skills or knowledge that are practical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdaa40d5-0d8e-4ec0-9bba-fda4912d2f30",
                                                "sense_id": "1f7b0c9e-f728-35bf-9c07-9c8eaba6749e",
                                                "text": "All in all, Jack's a very practical chap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c16a1271-be34-3f42-ae80-b758e254c206",
                                        "entry_id": "183fb42e-40c1-3636-80bb-721db786994e",
                                        "glosses": [
                                            "Of a prop: having some degree of functionality, rather than being a mere imitation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1737447e-7d5a-3f33-983d-a1e2a57022cd",
                                        "entry_id": "183fb42e-40c1-3636-80bb-721db786994e",
                                        "glosses": [
                                            "Light fixtures used for set lighting and seen in the frame of a shot as part of the scenery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "902900aa-8f6e-4244-acb3-d3cdbad00592",
                                                "sense_id": "1737447e-7d5a-3f33-983d-a1e2a57022cd",
                                                "text": "Practical lighting can help sell the illusion that the film is a real situation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "practical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66e4d5ec-ee30-31cf-9904-2da8e22589f6",
                                        "entry_id": "61b06fec-b5d1-3cc7-9299-f1cc7d71a754",
                                        "glosses": [
                                            "A part of an exam or series of exams in which the candidate has to demonstrate their practical ability"
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9bef73e-aec1-3dcf-9f13-af6f76d5d635",
                                        "entry_id": "61b06fec-b5d1-3cc7-9299-f1cc7d71a754",
                                        "glosses": [
                                            "A prop that has some degree of functionality, rather than being a mere imitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "246e6b62-963f-43f5-ab31-e741f662f833",
                                                "sense_id": "d9bef73e-aec1-3dcf-9f13-af6f76d5d635",
                                                "text": "Practicals are used onstage as they would be used in real life. If the sound cue is to be from a radio or television, give qualities to the recording that will maintain the sense of the medium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42ce929d-8a36-3e09-acce-4cad03dc95e3",
                                        "entry_id": "61b06fec-b5d1-3cc7-9299-f1cc7d71a754",
                                        "glosses": [
                                            "A light fixture used for set lighting and seen in the frame of a shot as part of the scenery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65f996a0-f2f7-44c0-9719-940d6c83f885",
                                                "sense_id": "42ce929d-8a36-3e09-acce-4cad03dc95e3",
                                                "text": "A naturalistic set is normally dressed with all the furnishings and props to be found in a real room. This includes electric light fittings which, when they actually light, are known as practicals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28436a1a-635a-3b34-849c-5a7e1f963f15",
                                        "entry_id": "61b06fec-b5d1-3cc7-9299-f1cc7d71a754",
                                        "glosses": [
                                            "Laboratory experiment, test or investigation"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
