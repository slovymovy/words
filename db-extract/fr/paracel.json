                        "cross_references": [
                            {
                                "target_word": "Paracel Islands",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb0fa0c6-39ad-357b-81db-949782215d0a",
                                        "entry_id": "29a8be25-a688-38b4-a002-26cb3e4d4efd",
                                        "glosses": [
                                            "A group of South China Sea islands administered under Sansha, Hainan, China, as Xisha (claimed by Taiwan (ROC) and Vietnam)."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e275db7-b9f8-4adc-9ff1-5a0454293f61",
                                                "sense_id": "eb0fa0c6-39ad-357b-81db-949782215d0a",
                                                "text": "ABOUT the third day out we passed the dreaded Macclesfield Bank, which, with the adjacent Paracel Islands and reefs, forms a pretty trap for the careless or unskilful navigator."
                                            },
                                            {
                                                "example_id": "6b58a719-1fca-4b39-81bb-b45708195db8",
                                                "sense_id": "eb0fa0c6-39ad-357b-81db-949782215d0a",
                                                "text": "The Republic of China has reiterated its sovereignty over the Nansha and Hsisha Islands (Spratly and Paracel Islands)."
                                            },
                                            {
                                                "example_id": "a7c4ce9b-0411-458b-ab0a-438f214198fe",
                                                "sense_id": "eb0fa0c6-39ad-357b-81db-949782215d0a",
                                                "text": "Gales in the South China Sea, off Guangdong's east coast and near the Paracel Islands, were forecast to reach moderate magnitudes of 6-7 but the wind in some parts of the sea could be stronger, the forecasters said."
                                            }
                                        ]
                                    }
