                                            {
                                                "example_id": "0989db56-1bb1-4bfa-bff9-68cb18a79b48",
                                                "sense_id": "51390b5b-513f-32d0-969c-50e27f348af9",
                                                "text": "V polívce plovala nějaká muší rodina. Otce a matku jsem v roztržitosti spolk; pak tam ale plavalo ještě muší embryo a to jsem už nemoh."
                                            },
                                            {
                                                "example_id": "9df93154-2bb5-42ff-b847-84d5431db01d",
                                                "sense_id": "51390b5b-513f-32d0-969c-50e27f348af9",
                                                "text": "Kdo má nerad hudbu muší, ať si zacpe obě uši, ať si zavře dům."
                                            }
                                        ]
                                    }
