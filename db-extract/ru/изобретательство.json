                                    {
                                        "sense_id": "145ba69b-b855-30ed-b626-73dcc464c056",
                                        "entry_id": "0f630a63-aa90-3562-ab95-45f22d410b95",
                                        "glosses": [
                                            "Gesamtheit der staatlichen Maßnahmen zur Förderung von Erfindern"
                                        ],
                                        "tags": [
                                            "Institution",
                                            "vor allem ehemalige DDR"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a94e40-245c-492c-9c5c-27b39ba92c45",
                                                "sense_id": "145ba69b-b855-30ed-b626-73dcc464c056",
                                                "text": "„Sie heißt »Fliehkraftsedimentationsabscheider« und klemmt noch heute auf dem Dach von Elektrolokomotiven. Patent Nummer DD 221921 A1, einst eingereicht beim Amt für Erfindungswesen der DDR. Rößlers Konstruktion reinigt angesaugte Kühlluft.“"
                                            }
                                        ],
