                "senses": [
                    {
                        "sense_id": "3abc4bfa-100b-3ed4-b462-dac56d3e32db",
                        "entry_id": "4d9ceadd-5af4-38f3-b541-3efb4b8896c1",
                        "glosses": [
                            "Tanacetum L., roślina z rodziny astrowatych o dużych, pierzastych liściach i kwiatach zebranych w koszyczki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4999c7c2-2935-4c18-9004-f8bc54ae9626",
                                "sense_id": "3abc4bfa-100b-3ed4-b462-dac56d3e32db",
                                "text": "Wrotycz pospolity zyskał reputację jako środek odstraszający owady, szczególnie muchy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1126bcc4-1a09-4c22-b559-77ae47a6bf6b",
                        "source_entry_id": "4d9ceadd-5af4-38f3-b541-3efb4b8896c1",
                        "source_sense_id": "3abc4bfa-100b-3ed4-b462-dac56d3e32db",
                        "target_lang_word": "tansy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tansy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae2b65da-a97c-3343-b57d-921e9e9a5301",
                                        "entry_id": "e0863c11-d071-3ba6-bb5e-664e648f8445",
                                        "glosses": [
                                            "A herbaceous plant with yellow flowers, of the genus Tanacetum, especially Tanacetum vulgare."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5349570-5376-41aa-a882-87a30fab66b2",
                                                "sense_id": "ae2b65da-a97c-3343-b57d-921e9e9a5301",
                                                "text": "The sunny afternoon was there, like another land. By the path grew tansy and little trees."
                                            },
                                            {
                                                "example_id": "f9feb0f7-4e97-49f5-b6ff-d28a93f49695",
                                                "sense_id": "ae2b65da-a97c-3343-b57d-921e9e9a5301",
                                                "text": "Various measures were taken to avoid it, most popular being the suspension of certain herbs and tree branches over the doorways of dwellings and stables. Commonly used greenery were tansy, honesty, garlic, St. John's Wort, mountain ash, roadside verbena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7df7fae-a7ed-3d13-96e4-45e5a02bff8c",
                                        "entry_id": "e0863c11-d071-3ba6-bb5e-664e648f8445",
                                        "glosses": [
                                            "A dish common in the seventeenth century, made of eggs, sugar, rose water, cream, and the juice of herbs (including tansy), baked with butter in a shallow dish. \\\"Originally flavoured with tansy, but by Pepys's time generally having spinach as its predominant flavouring.\\"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5cee285-b7a2-4068-96b1-fe66fda55baf",
                                                "sense_id": "e7df7fae-a7ed-3d13-96e4-45e5a02bff8c",
                                                "text": "I had a pretty dinner for them; viz., a brace of stewed carps, six roasted chickens, and a jowle of salmon, hot, for the first course; a tanzy and two neats' tongues, and cheese the second; and were very merry all the afternoon, talking and singing and piping upon the flageolette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "941eb07b-8efe-45eb-a660-f83a9d0de2fd",
                        "source_entry_id": "4d9ceadd-5af4-38f3-b541-3efb4b8896c1",
                        "source_sense_id": "3abc4bfa-100b-3ed4-b462-dac56d3e32db",
                        "target_lang_word": "tanaisie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tanaisie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                        "entry_id": "81aec625-2c49-37db-91c7-3e4dbe42dd2e",
                                        "glosses": [
                                            "Astéracée à fleurs jaunes et flosculeuses, et qui a une odeur forte et une saveur amère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb6e5e89-cc78-4462-9ed7-fc65502b1d81",
                                                "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                                "text": "D’une cour où se trouvait Paša avec ses amies, une fleur de tanaisie avait été lancée, qui était tombée aux pieds du Borgne."
                                            },
                                            {
                                                "example_id": "b0928953-b531-4812-8126-78b75c038bd6",
                                                "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                                "text": "La tanaisie n’est pas adaptée aux petites surfaces car elle est envahissante."
                                            },
                                            {
                                                "example_id": "2a031d01-81ea-44af-8b4d-870aa4e4e1bf",
                                                "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                                "text": "La tanaisie a pu être utilisé autrefois comme vermifuge, elle contient une huile essentielle dont un constituant, la thujone, est très toxique à dose élevée."
                                            },
                                            {
                                                "example_id": "08535389-95aa-4a17-82c4-f7c6ca9f0dd3",
                                                "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                                "text": "Prenez des feuilles de Pervenche, de Tanaisie & d’Eupatoire d’Avicenne, de chacune deux poignées.\nPilez les un peu, & faites-les macérer pendant vingt-quatre heures dans six livres de lait de vache nouvellement trait.\nDistillez ensuite le tout […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56b92232-e6cb-4d7f-a2dc-ceb731f3d3b2",
                        "source_entry_id": "4d9ceadd-5af4-38f3-b541-3efb4b8896c1",
                        "source_sense_id": "3abc4bfa-100b-3ed4-b462-dac56d3e32db",
