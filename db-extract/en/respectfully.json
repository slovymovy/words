                                        "examples": [
                                            {
                                                "example_id": "cc27a234-dde5-430c-8fe1-872c65aafd4e",
                                                "sense_id": "f7953fa1-e068-3dba-8838-3ac96dc142da",
                                                "text": "Armin eut beau lui faire respectueusement remarquer que coupèle ne pouvait servir de troisième personne du présent de l'indicatif au verbe coupler, Beaujeux n'en fut pas démonté:\n— Pour les savants comme vous, je dirai qu'il s'agit du verbe coupeler : soumettre à l'épreuve de la coupelle."
                                            },
                                            {
                                                "example_id": "9ab02157-0b3c-483c-bccd-f4dd8cc95ca9",
                                                "sense_id": "f7953fa1-e068-3dba-8838-3ac96dc142da",
                                                "text": "Il refusa très respectueusement l’offre qu’on lui faisait,"
                                            },
                                            {
                                                "example_id": "75e2bcb0-ebe0-438d-badb-3d75060be1fc",
                                                "sense_id": "f7953fa1-e068-3dba-8838-3ac96dc142da",
                                                "text": "« Qu’est-ce que c’est que ce monsieur-là ? demanda Ambroise tout ahuri à Emmanuel qui avait ôté respectueusement son képi."
                                            },
                                            {
                                                "example_id": "620c9086-acee-4d36-b72d-4caa54d65418",
                                                "sense_id": "f7953fa1-e068-3dba-8838-3ac96dc142da",
                                                "text": "Au retour de la promenade, il fit quelques parties d’échecs avec M. Goulard, qui respectueusement le laissa gagner,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34d3ff3d-0d27-3f66-880c-63aea1677270",
                                        "entry_id": "3dad5724-8b93-3394-9b83-77e698057559",
                                        "glosses": [
                                            "Formule de politesse adressée, typiquement à la fin d'une lettre, à quelqu’un à qui l’on veut montrer du respect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
