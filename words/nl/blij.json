                },
                {
                    "sense_id": "6f36dc18-6ae0-3e96-9296-5235dbcd8e7c",
                    "sense_definition": "een gevoel van opluchting ervaren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben <w>blij</w> dat je er bent, want ik was even bang.",
