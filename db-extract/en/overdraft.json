                "translations": [
                    {
                        "translation_id": "a876717c-eb8d-4999-b07d-2df9ce528d59",
                        "source_entry_id": "f1ddb3e9-2965-391c-a787-859cbfed9bd8",
                        "source_sense_description": "act of overdrawing a bank account",
                        "target_lang_word": "découvert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "découvert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67ddac44-ab6e-3430-8db0-a3c4e7f8fc87",
                                        "entry_id": "453d05bb-3150-3085-9436-df0e8e64a344",
                                        "glosses": [
                                            "Qui n’est pas couvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a0b4a0-5703-42d7-8dab-eba08a5714e1",
                                                "sense_id": "67ddac44-ab6e-3430-8db0-a3c4e7f8fc87",
                                                "text": "Se montrer, sortir à visage découvert, Sans voile, en parlant des femmes musulmanes."
                                            },
                                            {
                                                "example_id": "62e088cd-bebd-4c69-9591-0caee89c6d58",
                                                "sense_id": "67ddac44-ab6e-3430-8db0-a3c4e7f8fc87",
                                                "text": "Allée découverte, Dont les arbres ne se rejoignent pas par le haut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d629c737-d6db-337d-8211-6b9d4550726c",
                                        "entry_id": "453d05bb-3150-3085-9436-df0e8e64a344",
                                        "glosses": [
                                            "Ouvert, exposé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ad26ecd-72c3-4ebe-be1b-76c34c857be9",
                                                "sense_id": "d629c737-d6db-337d-8211-6b9d4550726c",
                                                "text": "Place découverte."
                                            },
                                            {
                                                "example_id": "e1edeefa-7f96-4049-bca2-29bf70c925e3",
                                                "sense_id": "d629c737-d6db-337d-8211-6b9d4550726c",
                                                "text": "Le flanc du régiment est découvert, Exposé aux attaques de l’ennemi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "découvert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd20e54-aa83-340f-bc3d-d507154d9d0c",
                                        "entry_id": "f75614ef-f31d-39e3-8f8f-d143b16ea130",
                                        "glosses": [
                                            "Ensemble des avances consenties par un banquier à ses clients."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace8fde5-62ac-4e1b-8d4f-dd3be305c343",
                                                "sense_id": "dbd20e54-aa83-340f-bc3d-d507154d9d0c",
                                                "text": "Les découverts, le découvert d’une maison de banque,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354c630c-480a-3c60-9bef-05a9525c47f3",
                                        "entry_id": "f75614ef-f31d-39e3-8f8f-d143b16ea130",
                                        "glosses": [
                                            "Ensemble des ventes consenties par la Bourse d’une place, sans avoir les titres à livrer, ou bien sans aucune opération qui en fasse la contre-partie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f19ec80-b3df-3398-bb2f-700c23458975",
                                        "entry_id": "f75614ef-f31d-39e3-8f8f-d143b16ea130",
                                        "glosses": [
                                            "Terrain sans arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd3ef46-d73a-4c8e-aa3d-a749697f63dc",
                                                "sense_id": "8f19ec80-b3df-3398-bb2f-700c23458975",
                                                "text": "Voilà que je me mets à aimer ces grands découverts pâles où me mènent des chemins et des routes et des sentiers sans arbres, où l’on doit cuire en été […]"
                                            },
                                            {
                                                "example_id": "fb285024-944a-4346-9d99-fd3f01bc5772",
                                                "sense_id": "8f19ec80-b3df-3398-bb2f-700c23458975",
                                                "text": "C’est comme ici. Ailleurs aussi naturellement ; mais ailleurs, soit à l’est ou à l’ouest, il y a parfois un découvert, ou des bosquets, ou des croisements de routes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "découvert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d718371-af91-31cd-aa37-316fe06b38fd",
                                        "entry_id": "2749425b-ff6c-3d62-9b95-c1dd1b9c8f42",
                                        "glosses": [
                                            "Participe passé masculin singulier de découvrir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb6a9006-f1c7-45a7-9b2b-fd4de5a730f4",
                                                "sense_id": "1d718371-af91-31cd-aa37-316fe06b38fd",
                                                "text": "Eh bien ! récemment l’on a découvert que cette dernière arcature avait été désajourée par un remplissage de seconde main, et l’on s’est empressé de restituer l’ordonnance primitive."
                                            },
                                            {
                                                "example_id": "582c836e-85a2-4b8d-bac8-f8342b7ba7d2",
                                                "sense_id": "1d718371-af91-31cd-aa37-316fe06b38fd",
                                                "text": "Elle retourne sur la pointe des pieds border Lucien qui s’est découvert en dormant, puis se dirige à la lueur des appliques de la salle de bains jusqu’au semainier où elle range ses bijoux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
