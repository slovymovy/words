                        "entry_id": "736a6f97-2916-3684-a0c2-e70c3e864d52",
                        "glosses": [
                            "To keep under or in subjection; subdue; suppress."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4a0d1e42-6745-427c-8fa3-f3af95077ffb",
                                "sense_id": "8b7a835a-a38c-33c1-93b6-695ddfdb8ee1",
                                "text": "Like as a fire, the which in hollow caue / Hath long bene vnderkept, and downe supprest, / With murmurous disdaine doth inly raue […]"
                            },
                            {
                                "example_id": "c1c9f704-4aa7-4838-bb22-34a7af8ee5c0",
                                "sense_id": "8b7a835a-a38c-33c1-93b6-695ddfdb8ee1",
                                "text": "It is not economy to overwork or underkeep, or in any wise neglect the farm horse?"
                            },
                            {
                                "example_id": "47f75230-2132-4288-96a8-585bacda3f8c",
                                "sense_id": "8b7a835a-a38c-33c1-93b6-695ddfdb8ee1",
                                "text": "[...] how running himself our President underkeeps with such high animals how the british Queen in Her Majesty's own language."
                            }
                        ]
                    },
                    {
                        "sense_id": "a338459d-0fe4-3158-91b1-5b4a81be8d97",
                        "entry_id": "736a6f97-2916-3684-a0c2-e70c3e864d52",
                        "glosses": [
                            "To keep or maintain inadequately or below standard."
