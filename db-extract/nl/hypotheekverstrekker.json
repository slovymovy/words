                        "examples": [
                            {
                                "example_id": "6b9b6f55-0666-4663-954e-9db013c27f7e",
                                "sense_id": "3f00016b-597f-3d90-a67f-c7c35b865c92",
                                "text": "Een meerderheid van de Kamer heeft een voorstel van D66 en de ChristenUnie aangenomen, waarin minister Blok wordt gevraagd om de hypotheekregels aan te passen. Ze vinden dat de actuele schuld een realistischer beeld geeft van het risico voor de hypotheekverstrekker en mensen meer ruimte biedt om een huis te kopen."
                            },
                            {
                                "example_id": "bdc94ba8-8293-4c83-be9e-d3bb163dca11",
                                "sense_id": "3f00016b-597f-3d90-a67f-c7c35b865c92",
                                "text": "Ook bij de Rabobank, de grootste hypotheekverstrekker van ons land, maken klanten volgens een woordvoerder \"massaal\" gebruik van het online Hypotheekdossier."
                            }
                        ]
                    }
