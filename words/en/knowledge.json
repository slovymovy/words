{
    "word_family": [
        "know",
        "knowledgeable",
        "knowingly",
        "unknown",
        "acknowledge",
        "acknowledgment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81cf8837-b729-30c3-ae57-4a86de5eebd3",
                    "sense_definition": "The fact of knowing about something; general understanding or familiarity with a subject, place, or situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>knowledge</w> of local history is very impressive.",
                            "target_lang_translations": {
                                "ru": "Его <w>познания</w> в местной истории весьма впечатляют.",
                                "tr": "Yerel tarih hakkındaki <w>bilgisi</w> çok etkileyici."
                            }
                        },
                        {
                            "text": "A secretary should have a good <w>knowledge</w> of computer software.",
                            "target_lang_translations": {
                                "ru": "Секретарь должен обладать хорошим <w>знанием</w> компьютерного программного обеспечения.",
                                "tr": "Bir sekreterin bilgisayar yazılımları konusunda iyi <w>bilgisi</w> olmalıdır."
                            }
                        }
                    ],
                    "synonyms": [
                        "learning",
                        "awareness",
                        "understanding"
                    ],
                    "antonyms": [
                        "ignorance"
                    ],
                    "common_phrases": [
                        "general knowledge",
                        "common knowledge",
                        "acquire knowledge",
                        "thirst for knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факт обладания информацией о чем-либо; общее понимание или знакомство с предметом, местом или ситуацией.",
                        "tr": "Bir konu, yer veya durum hakkında bilgi sahibi olma; genel kavrayış veya aşinalık."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знание",
                                "target_lang_sense_clarification": "общее владение информацией"
                            },
                            {
                                "target_lang_word": "познания",
                                "target_lang_sense_clarification": "глубокие или обширные знания в области"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bilgi",
                                "target_lang_sense_clarification": "bir konu hakkındaki öğrenilmiş gerçekler"
                            },
                            {
                                "target_lang_word": "vukuf",
                                "target_lang_sense_clarification": "bir konuyu derinlemesine bilme, hakimiyet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e56cddd-e2a5-35a7-a47d-578d67e05052",
                    "sense_definition": "Awareness of a particular fact or situation; the state of having been informed about something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She left the party without my <w>knowledge</w>.",
                            "target_lang_translations": {
                                "ru": "Она ушла с вечеринки без моего <w>ведома</w>.",
                                "tr": "Partiden benim <w>haberim</w> olmadan ayrıldı."
                            }
                        },
                        {
                            "text": "They denied all <w>knowledge</w> of the missing documents.",
                            "target_lang_translations": {
                                "ru": "Они отрицали какую-либо <w>осведомлённость</w> о пропавших документах.",
                                "tr": "Kayıp belgeler hakkında hiçbir <w>bilgileri</w> olmadığını iddia ettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "awareness",
                        "cognizance",
                        "understanding"
                    ],
                    "antonyms": [
                        "ignorance"
                    ],
                    "common_phrases": [
                        "to my knowledge",
                        "without my knowledge",
                        "public knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осведомленность о конкретном факте или ситуации; состояние информированности о чем-либо.",
                        "tr": "Belli bir durum veya gerçekten haberdar olma durumu; bilgilendirilmiş olma hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осведомлённость",
                                "target_lang_sense_clarification": "информированность о факте"
                            },
                            {
                                "target_lang_word": "ведома",
                                "target_lang_sense_clarification": "в идиомах: без моего ведома"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haber",
                                "target_lang_sense_clarification": "bir durumdan haberdar olma (örn. haberim olmadan)"
                            },
                            {
                                "target_lang_word": "bilgi",
                                "target_lang_sense_clarification": "bir olay veya durum hakkında farkındalık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ce225ab-78e6-39dd-954d-8d4288845d4a",
                    "sense_definition": "The total of what is known; all information and products of learning accumulated by humanity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collective_info",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library contained the accumulated <w>knowledge</w> of the ancient world.",
                            "target_lang_translations": {
                                "ru": "Библиотека содержала накопленные <w>знания</w> древнего мира.",
                                "tr": "Kütüphane, antik dünyanın birikmiş <w>bilgisini</w> içeriyordu."
                            }
                        },
                        {
                            "text": "Scientific <w>knowledge</w> has expanded rapidly in the last century.",
                            "target_lang_translations": {
                                "ru": "Научное <w>знание</w> стремительно расширилось в прошлом столетии.",
                                "tr": "Bilimsel <w>bilgi</w> son yüzyılda hızla büyüdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "learning"
                    ],
                    "common_phrases": [
                        "body of knowledge",
                        "scientific knowledge",
                        "human knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность всего известного; вся информация и результаты обучения, накопленные человечеством.",
                        "tr": "İnsanlığın biriktirdiği tüm öğrenim ürünleri ve bilgilerin toplamı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знания",
                                "target_lang_sense_clarification": "накопленный опыт (мн. ч.)"
                            },
                            {
                                "target_lang_word": "знание",
                                "target_lang_sense_clarification": "как абстрактное понятие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bilgi",
                                "target_lang_sense_clarification": "insanlığın birikimi veya bilimsel gerçekler bütünü"
                            },
                            {
                                "target_lang_word": "bilim",
                                "target_lang_sense_clarification": "sistemli bilgi birikimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "310b349b-42b3-3fbc-a037-155142b44fee",
                    "sense_definition": "Sexual intimacy or intercourse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archaic legal term carnal <w>knowledge</w> refers to sexual intercourse.",
                            "target_lang_translations": {
                                "ru": "Устаревший юридический термин 'плотское <w>познание</w>' относится к половому сношению.",
                                "tr": "Eski bir hukuki terim olan bedensel <w>münasebet</w> cinsel ilişki anlamına gelir."
                            }
                        },
                        {
                            "text": "He was charged with unlawful carnal <w>knowledge</w> under the old statutes.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в незаконном плотском <w>познании</w> согласно старым законам.",
                                "tr": "Eski kanunlara göre hukuka aykırı cinsel <w>münasebetle</w> suçlandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "carnal knowledge"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in the phrase 'carnal knowledge'"
                        },
                        {
                            "trait_type": "form",
                            "comment": "legal or biblical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Половая близость или сношение (обычно в юридическом или устаревшем контексте).",
                        "tr": "Cinsel yakınlık veya ilişki (genellikle eski/hukuki bağlamda)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "познание",
                                "target_lang_sense_clarification": "библейское/устаревшее (плотское познание)"
                            },
                            {
                                "target_lang_word": "сношение",
                                "target_lang_sense_clarification": "юридическое (половое сношение)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "münasebet",
                                "target_lang_sense_clarification": "cinsel ilişki anlamında eski/hukuki terim"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9bcc48c3-14d1-35c3-83af-bbcc536f4db7",
                    "sense_definition": "A demanding course of study regarding routes and places of interest that must be completed by prospective London taxi drivers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "london_taxi",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "It takes years of study to master the <w>Knowledge</w> and become a licensed cab driver.",
                            "target_lang_translations": {
                                "ru": "Требуются годы учебы, чтобы освоить <w>Знание</w> и стать лицензированным водителем такси.",
                                "tr": "<w>Bilgi Sınavı</w>'nı geçmek ve lisanslı bir taksi şoförü olmak yıllarca çalışma gerektirir."
                            }
                        },
                        {
                            "text": "You often see people on scooters studying for the <w>Knowledge</w> in London.",
                            "target_lang_translations": {
                                "ru": "В Лондоне часто можно увидеть людей на скутерах, готовящихся к сдаче <w>Знания</w>.",
                                "tr": "Londra'da scooter üzerinde <w>Bilgi Sınavı</w>'na çalışan insanları sıkça görürsünüz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "do the Knowledge",
                        "on the Knowledge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "London"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложный экзамен на знание улиц и достопримечательностей Лондона, обязательный для будущих таксистов.",
                        "tr": "Londra'daki taksi şoförü adaylarının geçmek zorunda olduğu, rotalar ve önemli yerler hakkındaki zorlu eğitim ve sınav."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Знание",
                                "target_lang_sense_clarification": "название экзамена/курса"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Bilgi Sınavı",
                                "target_lang_sense_clarification": "Londra taksicilerinin geçmek zorunda olduğu özel sınav"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac12f406-deaf-3146-adc5-8941893ac4f0",
                    "sense_definition": "To confess as true; to acknowledge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acknowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In old texts, sinners would <w>knowledge</w> their faults before the congregation.",
                            "target_lang_translations": {
                                "ru": "В старых текстах грешники <w>признавали</w> свои проступки перед прихожанами.",
                                "tr": "Eski metinlerde günahkarlar, cemaatin önünde hatalarını <w>kabul ederlerdi</w>."
                            }
                        },
                        {
                            "text": "He did not <w>knowledge</w> the authority of the court.",
                            "target_lang_translations": {
                                "ru": "Он не <w>признал</w> власть суда.",
                                "tr": "Mahkemenin yetkisini <w>tanımadı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать истинным; подтверждать (устаревшее значение).",
                        "tr": "Doğru olduğunu kabul veya itiraf etmek (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "сознаваться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kabul etmek",
                                "target_lang_sense_clarification": "itiraf etmek, onaylamak"
                            },
                            {
                                "target_lang_word": "tanımak",
                                "target_lang_sense_clarification": "otoriteyi veya gerçeği kabul etmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}