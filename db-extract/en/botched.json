                        "target_lang_word": "stümperhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stümperhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8cd3a5-dc23-3f1e-b2c3-9ba7eb8a9267",
                                        "entry_id": "b4b30a65-808b-3995-9e94-324f8a28155f",
                                        "glosses": [
                                            "wegen mangelnder Sorgfalt oder Unkenntnis schlecht ausgeführt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85da97ad-ba02-4a9f-a8cd-a5aa91e6e9df",
                                                "sense_id": "ff8cd3a5-dc23-3f1e-b2c3-9ba7eb8a9267",
                                                "text": "„Das Gericht sah es als erwiesen an, dass er acht Patienten durch stümperhafte Operationen und Begleitumstände teilweise in Lebensgefahr gebracht hatte.“"
                                            },
                                            {
                                                "example_id": "50886b99-ff35-4c2b-818f-fa049835286e",
                                                "sense_id": "ff8cd3a5-dc23-3f1e-b2c3-9ba7eb8a9267",
                                                "text": "„Der erste Teil spielt 1960 in Great Falls und beschreibt, wie Dell Parsons’ Kleinbürgereltern […] dazu kamen, den stümperhaftesten Banküberfall der Literaturgeschichte zu begehen.“"
                                            },
                                            {
                                                "example_id": "b66ca995-23c7-4a13-a15a-50203aa40a10",
                                                "sense_id": "ff8cd3a5-dc23-3f1e-b2c3-9ba7eb8a9267",
                                                "text": "„Weder Christodulos noch seine Frau verstehen ein Wort Deutsch, während ihr Sohn Dimitri, der Fremdenführer ist, alle Mundarten Europas versteht und stümperhaft spricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
