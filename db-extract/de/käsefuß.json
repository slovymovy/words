                ],
                "senses": [
                    {
                        "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                        "entry_id": "48ebff39-f68c-3662-ab7b-4fe4112ecf4c",
                        "glosses": [
                            "übel riechender Fuß"
                        ],
                        "tags": [
                            "derogatory",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "25bf9cad-7003-4349-a81f-063dab8ec658",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "Erst wurde gepöbelt, dann gab es eine Ohrfeige: In einem ICE ist ein Streit um Käsefüße eskaliert. Zwei Männer mussten den Zug verlassen."
                            },
                            {
                                "example_id": "c89f5ab1-4dfd-4557-bf78-80255b870697",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "Mann, hast du Käsefüße, zieh schnell deine Socken wieder an!"
                            },
                            {
                                "example_id": "fc3486b2-2c84-4c07-811d-c812c5bc6be5",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "Der Gestank von Käsefüßen kann wirklich atemberaubend sein."
                            },
                            {
                                "example_id": "d13c797e-a71d-47e9-9df3-511179a084a2",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "In Turnschuhen habe ich früher immer Käsefüße bekommen."
                            },
                            {
                                "example_id": "5e35e2d2-f33f-49dd-93a2-718209329aae",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "Käsefüße entstehen, wenn die Füße schwitzen."
                            },
                            {
                                "example_id": "8758eb17-82cf-440e-84dd-2bed3bc6735f",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "Wer Käse im Magen hat, bekommt davon keine Käsefüße."
                            },
                            {
                                "example_id": "3aded2d1-14a7-4a88-bc2f-06c6befee3ba",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "[…] Schwitzen ist völlig in Ordnung. Aber bei Käsefüßen oder stinkenden T-Shirts muss ich mich [als Yogalehrerin] schon sehr überwinden, Euch [Männern] zu assistieren."
                            },
                            {
                                "example_id": "0e482c65-2ce5-43b0-a89a-5f32305090b5",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "Der Geruch des Lamms und Knoblauchs überdeckte jetzt die Käsefüße, aber ich mußte trotzdem darüber nachdenken, wessen es waren. „Einer von euch hat Käsefüße“, sagte ich."
                            },
                            {
                                "example_id": "e6b27cf8-53f1-4622-8ca2-c8fe1586ea40",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "[…] für Moskitos gibt es nichts Anziehenderes als Fußgeruch. Sie fliegen auf Käsefüße mit ihrem reichhaltigen und vielfältigen Bakterienzoo auf der Haut."
                            },
                            {
                                "example_id": "14270f4c-6364-4a82-9f35-c9443a7c1ee2",
                                "sense_id": "0ea236a2-f15b-3f23-a6ae-804e0723fe60",
                                "text": "In einem Fachmagazin beschreibt eine Gruppe von Insektenforschern, dass Malaria übertragende Mücken sich von Käsefüßen offenbar mehr angezogen fühlen als ihre Artgenossen, die das Tropenfieber nicht weitergeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
