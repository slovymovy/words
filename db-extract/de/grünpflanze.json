                "senses": [
                    {
                        "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                        "entry_id": "f24f2d8d-6ecc-3023-a3ad-d52d3f24624f",
                        "glosses": [
                            "Pflanze mit dekorativen Blättern, die deshalb gerne innerhalb des Hauses / der Wohnung gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c4a939f-faa9-4bfd-836d-76119441b929",
                                "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                                "text": "Ficus und Yuccapalme sind die klassischen Grünpflanzen für die Zimmerecke."
                            },
                            {
                                "example_id": "478d0d23-ecda-4a17-9258-66f683c41a96",
                                "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                                "text": "„Im Geschäftsraum stehen Grünpflanzen neben einer kleinen Wartebank.“"
                            },
                            {
                                "example_id": "178c56ec-bbf0-4e70-b24e-cad78a2afe59",
                                "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                                "text": "„Grünpflanzen in der Wohnung bringen die Natur qausi ins Haus und verbessern zugleich das Raumklima.“"
                            },
                            {
                                "example_id": "a2baa2c1-142d-4aea-8b33-4bf54f3b6594",
                                "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                                "text": "„Grünpflanzen wandeln über das Chlorophyll in ihren Blättern mithilfe von Sonnenlicht Kohlendioxid unter anderem in Sauerstoff um.“"
                            },
                            {
                                "example_id": "279e0a0d-281e-4394-bfa9-7897b55622e1",
                                "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                                "text": "„Vorbeugend, damit sich die Spinnmilbe erst gar nicht ausbreitet, […] können [Sie] die Grünpflanzen etwa besprühen […]“"
                            },
                            {
                                "example_id": "982748d3-a6f3-4d6b-b1b1-ea45b88b0555",
                                "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                                "text": "„Spätestens, wenn es draußen grau und kalt wird, ist es Zeit, in Wohnräumen für schöne Grünpflanzen und Blüten zu sorgen.“"
                            },
                            {
                                "example_id": "117db21d-65e6-4d9f-8c79-5763283fb110",
                                "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                                "text": "„Grünpflanzen mit viel Blattmasse sind bessere Raumbefeuchter und Staubfänger als blühende Pflanzen. Gut eignen sich zum Beispiel Philodendron und Drachenbaum oder auch der Ficus, die Birkenfeige.“"
                            },
                            {
                                "example_id": "a3e37322-b476-423c-85ab-47085dc9e34d",
                                "sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                                "text": "Grundsätzlich wachsen fast alle Pflanzen in Hydrokultur. Gerade für langlebige Zimmerpflanzen wie Gummibaum, Zimmerpalme, Drachenbaum oder Fensterblatt ist die Hydrokultur ideal. Diese Grünpflanzen können bei regelmäßiger Flüssigdüngung jahrelang prächtig gedeihen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2567e531-507c-4676-9a54-ec256f94d7df",
                        "source_entry_id": "f24f2d8d-6ecc-3023-a3ad-d52d3f24624f",
                        "source_sense_id": "85ec9906-bc57-3f03-917b-5c0e5849d397",
                        "source_sense_description": "Pflanze mit dekorativen Blättern",
                        "target_lang_word": "plante verte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plante verte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "422c8182-b859-316d-b9c7-d00f7fdb1833",
                                        "entry_id": "a55ebd0b-e05d-30a6-8723-79f4a8ca14dd",
                                        "glosses": [
                                            "Taxon d’eucaryotes (Eukaryota), qui comprend les végétaux pluricellulaires vivants, comme par exemple les Chlorophyta (algues vertes) ou les Streptophyta (streptophytes)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                        "entry_id": "a55ebd0b-e05d-30a6-8723-79f4a8ca14dd",
                                        "glosses": [
                                            "Plante herbacée cultivée pour son feuillage, généralement abondant, et dont la floraison n’est pas souhaitée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba6d178a-6d85-47ef-84f6-88d382a7f7e1",
                                                "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                                "text": "La porte s'ouvrit sur un corridor qui sentait le linoléum, avec un portemanteau en bambou à droite, des plantes vertes, dans des cache-pot de faïence."
                                            },
                                            {
                                                "example_id": "380dacf0-50c5-4503-8691-17e8a9bfce58",
                                                "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                                "text": "Le puits débouchait sur un vaste hall, peuplé des universelles plantes vertes qui contribuaient à régénérer l’atmosphère."
                                            },
                                            {
                                                "example_id": "7b5fb246-1204-439f-9f5c-c98e5dcffaa5",
                                                "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                                "text": "Des grosses plantes vertes dans des gros pots verts, très chic. Sur le comptoir, un vase avec des fleurs. Je sais que les plantes sont vertes parce que les plantes, on sait que c’est vert. En vrai, elles sont violet-vinasse, à cause de la lumière rose. Il y a une lampe avec un abat-jour rose et des perles en bois, ça donne pas beaucoup de lumière, une lumière rose. Tout est rose, sauf les plantes vertes, tellement vertes que ça fait comme je disais un mélange dégueulasse, mais je regarde pas spécialement les plantes vertes."
                                            },
                                            {
                                                "example_id": "eaa0cae0-9d5d-4cfa-9fa6-25bace6dffef",
                                                "sense_id": "ac254364-9c8d-3015-ac8b-853012b0e0e9",
                                                "text": "Elle partait pour un mois en Belgique voir sa mère et me demandait comme un service de bien vouloir occuper son appartement en son absence, afin d'arroser les plantes vertes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421878a9-0289-3a87-a9f7-21c5fc20e9fa",
                                        "entry_id": "a55ebd0b-e05d-30a6-8723-79f4a8ca14dd",
                                        "glosses": [
                                            "Personne réduite à un état végétatif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b5885f-4572-44e9-b637-111dea65b6f0",
                                                "sense_id": "421878a9-0289-3a87-a9f7-21c5fc20e9fa",
                                                "text": "Depuis son accident, ton malheureux oncle n’est plus qu’une plante verte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9263be61-e764-326d-b44c-260e1f2cda5b",
                                        "entry_id": "a55ebd0b-e05d-30a6-8723-79f4a8ca14dd",
                                        "glosses": [
                                            "Personne peu bavarde, inactive."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5584bbf8-7ec2-497e-a9ec-80cf791c07f0",
                                                "sense_id": "9263be61-e764-326d-b44c-260e1f2cda5b",
                                                "text": "Il n’a rien dit lors de la dernière soirée. C’est une vraie plante verte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
