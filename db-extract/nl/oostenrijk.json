                                        "glosses": [
                                            "A country in Central Europe. Official name: Republic of Austria. Capital and largest city: Vienna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82deebe6-5bc0-42e2-9d9f-0d3b4c64adb4",
