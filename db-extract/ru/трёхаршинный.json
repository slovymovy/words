                "senses": [
                    {
                        "sense_id": "bd5b31dd-ef03-395c-8562-52d0d799f169",
                        "entry_id": "755a5599-e366-398b-9c82-f40593612402",
                        "glosses": [
                            "разг., шутл. очень высокий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1aaa32-64ad-42ba-a85b-c8f0012803bd",
                                "sense_id": "bd5b31dd-ef03-395c-8562-52d0d799f169",
                                "text": "А фельдъегерь уж там, понимаете, и стоит: трёхаршинный мужичина какой-нибудь, ручища у него, можете вообразить, самой натурой устроена для ямщиков, ― словом, дантист эдакой…"
                            }
                        ]
                    },
                    {
                        "sense_id": "b03f74e4-b284-3bbc-a3d5-39ac3efd7cbb",
                        "entry_id": "755a5599-e366-398b-9c82-f40593612402",
                        "glosses": [
                            "устар. имеющий рост или размер в 3 аршина (2,1336 метра) ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad1b1f45-e70a-40b0-87ed-d79668dfd0b4",
                                "sense_id": "b03f74e4-b284-3bbc-a3d5-39ac3efd7cbb",
                                "text": "Я не птица, не могу перелететь через трёхаршинный частокол…"
                            }
                        ]
                    }
