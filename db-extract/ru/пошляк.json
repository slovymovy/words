                                        "glosses": [
                                            "świadczący o czyjejś ordynarności, nieprzyzwoitości, o czyimś grubiaństwie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64b67e9-f8a3-4952-8b28-f77749f747b9",
                                                "sense_id": "12148325-4d12-3072-96a1-7184d4717796",
                                                "text": "Nie znoszę sytuacji, gdy zaczyna opowiadać wulgarne dowcipy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
