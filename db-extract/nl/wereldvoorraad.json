                        "sense_id": "ac6cf9a1-7951-3f0c-a29d-9ce8050bb74d",
                        "entry_id": "8390d79b-5cb2-32f6-a8e4-84b5d866d8ad",
                        "glosses": [
                            "de hoeveelheid van een bepaalde stof die op de aarde beschikbaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0aed06c-8a98-4551-9ae2-35e398c7a361",
                                "sense_id": "ac6cf9a1-7951-3f0c-a29d-9ce8050bb74d",
                                "text": "Onder de grond in Bolivia zit eenderde tot de helft van de wereldvoorraad lithium. De grondstof wordt gebruikt in onder meer accu's van laptops, telefoons, auto's en in geneesmiddelen."
                            },
                            {
                                "example_id": "e1a779cb-9f40-4cb9-887a-0aad15716d59",
                                "sense_id": "ac6cf9a1-7951-3f0c-a29d-9ce8050bb74d",
                                "text": "Dat maakt ze toepasbaar in bijvoorbeeld elektrische auto's, ramen van huizen en zonweringen. Plastic zonnecellen kunnen daarnaast mogelijk een ander probleem oplossen: naar verwachting is de wereldvoorraad aan silicium rond 2025 uitgeput."
                            },
                            {
                                "example_id": "c8c5489f-0042-408b-bf2f-75e41bdbbb5b",
                                "sense_id": "ac6cf9a1-7951-3f0c-a29d-9ce8050bb74d",
                                "text": "Zelfs al zou dat de wereldvoorraad van amber en goud aanvullen."
                            }
                        ]
                    }
