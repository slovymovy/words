                                "target_senses": [
                                    {
                                        "sense_id": "021d5fe0-a7ce-3f82-9d62-322d33b2f5f2",
                                        "entry_id": "2789bc6a-36ea-3df2-971c-4fa81cd718b6",
                                        "glosses": [
                                            "Clôture, abri, plantation destinée à garantir arbres et plantes de l’action du vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f21c0018-b78f-4b6e-9203-342849121b31",
                                                "sense_id": "021d5fe0-a7ce-3f82-9d62-322d33b2f5f2",
                                                "text": "Des brise-vent."
                                            },
                                            {
                                                "example_id": "ba392a09-756b-49ba-8783-ba92eb81556e",
                                                "sense_id": "021d5fe0-a7ce-3f82-9d62-322d33b2f5f2",
                                                "text": "Mais à la différence de ce qui pourrait être observé avec un brise-vent isolé de même type, la vitesse du vent est beaucoup plus réduite et sa réduction se fait sentir sur des distances beaucoup plus grandes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c28fae57-ee67-4311-8cb6-d6afbd1d466c",
                        "source_entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                        "source_sense_description": "hedge, fence or row of trees to reduce wind damage",
