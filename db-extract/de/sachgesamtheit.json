                "senses": [
                    {
                        "sense_id": "c4cf7775-1a91-3a39-9832-2f154fd7bad9",
                        "entry_id": "1e570821-327c-3231-8329-104f4ad592e2",
                        "glosses": [
                            "Mehrheit von Einzelsachen, die aufgrund eines gemeinsamen Zweckes als Ganzes angesehen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a9d55e-ef57-47c1-8332-81c4d9aae142",
                                "sense_id": "c4cf7775-1a91-3a39-9832-2f154fd7bad9",
                                "text": "Zu den Sachgesamtheiten gehören beispielsweise Bibliotheken, Münzsammlungen oder Warenlager."
                            },
                            {
                                "example_id": "ee135737-5815-4fb6-a227-132bafc5f3c7",
                                "sense_id": "c4cf7775-1a91-3a39-9832-2f154fd7bad9",
                                "text": "„Den Begriff der Sachgesamtheiten (Erstausstattungen von Schulen, Kindergärten, Verwaltungsgebäuden usw.) kennt das neue doppische Haushalts- und Rechnungswesen nicht mehr.“"
                            },
                            {
                                "example_id": "02c4fbe7-d65b-4d41-9a61-4367b397d05f",
                                "sense_id": "c4cf7775-1a91-3a39-9832-2f154fd7bad9",
                                "text": "„Das Oberlandesgericht hat ausgeführt, zur Identifizierung der sicherungsübereigneten Gegenstände genüge bei Sachgesamtheiten die Verwendung der so genannten \"All-Formel\", wenn sämtliche Gegenstände des Sicherungsgebers übereignet werden sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
