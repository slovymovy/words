{
    "word_family": [
        "splice",
        "splicer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5270d99-57fe-37dd-bb48-3b6506e9d4c9",
                    "sense_definition": "The process of joining two things together, especially ropes, wires, or film, by interweaving or connecting their ends.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "joining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>splicing</w> of the two heavy ropes required great skill and patience.",
                            "target_lang_translations": {
                                "pl": "<w>Splatanie</w> dwóch ciężkich lin wymagało wielkich umiejętności i cierpliwości."
                            }
                        },
                        {
                            "text": "Modern film editing often involves digital <w>splicing</w> of different video clips.",
                            "target_lang_translations": {
                                "pl": "Współczesny montaż filmowy często obejmuje cyfrowe <w>łączenie</w> różnych klipów wideo."
                            }
                        }
                    ],
                    "synonyms": [
                        "joining",
                        "connection",
                        "fusing"
                    ],
                    "common_phrases": [
                        "rope splicing",
                        "film splicing"
                    ],
                    "target_lang_definitions": {
                        "pl": "Proces łączenia dwóch rzeczy, zwłaszcza lin, przewodów lub taśmy filmowej, poprzez przeplatanie lub łączenie ich końców."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "splatanie",
                                "target_lang_sense_clarification": "proces łączenia lin lub kabli"
                            },
                            {
                                "target_lang_word": "łączenie",
                                "target_lang_sense_clarification": "ogólny proces łączenia elementów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b61bc50-cf08-3c0c-9d6a-f98d173e6c9e",
                    "sense_definition": "The specific location or joint where two materials have been connected.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "joining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>splicing</w> on the cable was weak and eventually snapped under pressure.",
                            "target_lang_translations": {
                                "pl": "<w>Złącze</w> na kablu było słabe i ostatecznie pękło pod wpływem nacisku."
                            }
                        },
                        {
                            "text": "Inspect the <w>splicing</w> carefully to ensure the connection is secure.",
                            "target_lang_translations": {
                                "pl": "Sprawdź dokładnie <w>złącze</w>, aby upewnić się, że połączenie jest bezpieczne."
                            }
                        }
                    ],
                    "synonyms": [
                        "joint",
                        "junction",
                        "seam"
                    ],
                    "target_lang_definitions": {
                        "pl": "Konkretne miejsce lub złącze, w którym połączono dwa materiały."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "złącze",
                                "target_lang_sense_clarification": "miejsce połączenia dwóch elementów"
                            },
                            {
                                "target_lang_word": "spoina",
                                "target_lang_sense_clarification": "miejsce trwałego połączenia materiałów"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "652cec87-1fd8-3bf9-97fb-1d246ffb75a0",
                    "sense_definition": "The present participle and gerund of <w>splice</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "joining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>splicing</w> the electrical wires to restore power to the house.",
                            "target_lang_translations": {
                                "pl": "Obecnie <w>splata</w> przewody elektryczne, aby przywrócić zasilanie w domu."
                            }
                        },
                        {
                            "text": "The technician spent the afternoon <w>splicing</w> fiber optic cables for the new network.",
                            "target_lang_translations": {
                                "pl": "Technik spędził popołudnie <w>splatając</w> kable światłowodowe dla nowej sieci."
                            }
                        }
                    ],
                    "synonyms": [
                        "joining",
                        "connecting",
                        "fusing"
                    ],
                    "antonyms": [
                        "separating",
                        "disconnecting"
                    ],
                    "common_phrases": [
                        "splicing wires",
                        "splicing cables"
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od słowa 'splice' (łączyć, splatać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "splatanie",
                                "target_lang_sense_clarification": "czynność łączenia lin lub kabli"
                            },
                            {
                                "target_lang_word": "łączenie",
                                "target_lang_sense_clarification": "czynność łączenia różnych elementów"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}