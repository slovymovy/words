                "senses": [
                    {
                        "sense_id": "c869a24a-dbff-3161-9db4-3da644155559",
                        "entry_id": "31fb23e4-7884-3011-94ed-9d6f560fc121",
                        "glosses": [
                            "im Freien stehender Pfeiler mit eingravierten Heiligenbildern oder Heiligenfiguren"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "782bb6e2-c087-4674-98bb-4a0fa6ee30fd",
                                "sense_id": "c869a24a-dbff-3161-9db4-3da644155559",
                                "text": "„Im Ort stand ein Säulenbildstock aus Sandstein, der als Bekrönung einen Pyramidenschutz mit Kreuz trug, der aus etwa 1600 stammte.“"
                            },
                            {
                                "example_id": "ef5a0fdd-01ca-4168-bcde-105103126de8",
                                "sense_id": "c869a24a-dbff-3161-9db4-3da644155559",
                                "text": "„Im Garten des Grundstücks Turmstr. 14 steht ein hölzerner Säulenbildstock (Marter).“"
                            },
                            {
                                "example_id": "a066a234-7fec-4b80-ab9f-7ad4cad65fa9",
                                "sense_id": "c869a24a-dbff-3161-9db4-3da644155559",
                                "text": "„Ein Säulenbildstock aus weißem Marmor mit achteckigem Schaft und viereckigem Sockel steht vor dem St.-Salvator-Kreuzkirchl in Sterzing.“"
                            },
                            {
                                "example_id": "0d256b1b-faec-42f0-98bb-7f8c1f611f80",
                                "sense_id": "c869a24a-dbff-3161-9db4-3da644155559",
                                "text": "„Im Ortsgebiet wurde ein freistehender vierseitiger Säulenbildstock, der als Pestsäule anzusprechen ist, statisch gesichert.“"
                            },
                            {
                                "example_id": "eed876e5-62b2-40d9-9f3c-9d7114fd68c2",
                                "sense_id": "c869a24a-dbff-3161-9db4-3da644155559",
                                "text": "„Den an der Zufahrt zum Thannmayrgut befindlichen Säulenbildstock an der Haarstraße ließ der Besitzer, Franz Metz heuer restaurieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
