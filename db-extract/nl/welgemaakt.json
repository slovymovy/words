                    },
                    {
                        "sense_id": "b2da578b-7348-3110-a92a-6964cdc74709",
                        "entry_id": "12dd668a-fb8a-3900-9db0-f1f400aa8cd7",
                        "glosses": [
                            "van iets natuurlijks dat het goed en gezond van bouw is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ea25dc-382e-4e24-91f8-a52941034305",
                                "sense_id": "b2da578b-7348-3110-a92a-6964cdc74709",
                                "text": "Hij was vrij lang van gestalte en welgemaakt; zijn knieën staken ruim boven het dambord uit en zijn hoofd was niet veel lager dan dat van de boer op de hoge poepstoel."
                            },
                            {
                                "example_id": "17e887d7-962e-4db6-975c-bb27a5821e83",
                                "sense_id": "b2da578b-7348-3110-a92a-6964cdc74709",
                                "text": "„Rijzig, schoon en welgemaakt\" prijst de huispoëet de heer van Oostermeer bij alle voorkomende gelegenheden, en al bolt het zijden kamizool wat al te sterk tussen de wijduitstaande panden van de rok, al plooien zich drie zware onderkinnen boven de jabot, al zit het grote hoofd wat te kort op de brede nek, het grote zwaarbelijnde gezicht heeft welgevormde trekken, de forse rechte neus, de hoekige kin, de mond met de volrode lippen verraden koppigheid en trots, maar onmiskenbaar moed en geestkracht."
                            }
                        ]
                    }
