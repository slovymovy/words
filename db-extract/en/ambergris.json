                    {
                        "translation_id": "85d45704-7d7e-432f-a507-e3bb631233c5",
                        "source_entry_id": "b81fcde1-aaf6-3e2c-9756-3e886eee68ac",
                        "source_sense_id": "13a1a4b1-25dd-3a9d-95e5-6c95c7c90e2b",
