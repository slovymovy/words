                        ],
                        "form": "die Menschenfreunde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b4365a0-4f20-361c-9010-fbf9f5a42e04",
                        "entry_id": "f614f2cc-581c-38a7-9aad-9e7814ec6d0b",
                        "glosses": [
                            "jemand, der Menschen generell wohlwollend zugeneigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b416746-6b2d-4dce-aaaf-a9d7922458a4",
                                "sense_id": "7b4365a0-4f20-361c-9010-fbf9f5a42e04",
                                "text": "„Seine acht Kriminalromane um den Privatdetektiv Simon Brenner bestehen scheinbar aus bizarren Abschweifungen und Lebensweisheiten, die ein schwatzhafter Erzähler den Leserinnen und Lesern im Ton äußerster Vertraulichkeit zusteckt. Wer ein paar Seiten von Haas gelesen hat, begreift, dass da ein Menschenfreund und Humorist am Werk ist. Die Gemeinde seiner Leser wächst stetig, seine Sprache kann süchtig machen, auch die Literaturnobelpreisträgerin Elfriede Jelinek bekennt sich zu dieser Sucht.“"
                            },
                            {
                                "example_id": "684f9379-0b9f-4a4d-8569-3a3d2ecc9dfc",
                                "sense_id": "7b4365a0-4f20-361c-9010-fbf9f5a42e04",
                                "text": "„Im Herzen hatte er sich immer für einen Menschenfreund gehalten, und es quälte ihn, dass der Streik im August seinen Ruf unter dem Tórshavnern befleckt hatte.“"
                            },
                            {
                                "example_id": "bcd78c7a-cba4-4d64-af6d-37c3a0eb729c",
                                "sense_id": "7b4365a0-4f20-361c-9010-fbf9f5a42e04",
                                "text": "„Ein ungemein genauer Beobachter seiner Zeit wurde er, ein radikaler, aber unideologischer Deuter der Politik, ein Menschenfreund, der auf Distanz blieb.“"
                            },
                            {
                                "example_id": "241ed6d1-d8a6-4add-9448-52ed90fbee71",
                                "sense_id": "7b4365a0-4f20-361c-9010-fbf9f5a42e04",
                                "text": "„Nach dem stummen Gebet glitten die Äuglein des Menschenfreundes Rebhahn flink um den Tisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8a1fc35-2994-41bb-8936-92af23da3b3e",
                        "source_entry_id": "f614f2cc-581c-38a7-9aad-9e7814ec6d0b",
