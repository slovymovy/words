                "senses": [
                    {
                        "sense_id": "812176fb-d3f0-3af8-8fc5-7f0e47d8b093",
                        "entry_id": "c1502e9b-a882-307a-b12d-9e447cbc0e40",
                        "glosses": [
                            "Enlever son caractère misérable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4ac94a-7484-4878-aab0-09f41d13527a",
                                "sense_id": "812176fb-d3f0-3af8-8fc5-7f0e47d8b093",
                                "text": "L'un d'eux parle de démisérabiliser le handicap ; incite ses pairs à inventer d'autres outils de séduction."
                            },
                            {
                                "example_id": "5bd0357a-0c3b-4955-af47-1509dcd80aeb",
                                "sense_id": "812176fb-d3f0-3af8-8fc5-7f0e47d8b093",
                                "text": "Une relation sincère et vraie entre femelles et mâles est la fondation pour démisérabiliser le monde de nos sociétés."
                            },
                            {
                                "example_id": "871a40bb-6948-4b92-804a-75a8969fde48",
                                "sense_id": "812176fb-d3f0-3af8-8fc5-7f0e47d8b093",
                                "text": "Ce qui est en jeu, ce n'est plus de croire ou pas ce que ces médias professent, mais de reprendre pied dans la réalité de ce qui existe réellement : c'est-à-dire démisérabiliser sa condition de vie dans sa quotidienneté."
                            }
                        ]
                    }
