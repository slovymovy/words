                    }
                ],
                "senses": [
                    {
                        "sense_id": "99b9b333-0225-3d5f-9bae-8e2b2767c75b",
                        "entry_id": "e01052c9-c83c-32a6-badf-6c6eff4c96f6",
                        "glosses": [
                            "bycie ulotnym, nietrwałym, bezcelowym, bez wartości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "505e5e4a-3536-4876-954f-92a951e4a674",
                                "sense_id": "99b9b333-0225-3d5f-9bae-8e2b2767c75b",
                                "text": "W niczym więc człowiek nie przewyższa zwierząt, bo wszystko jest marnością. Wszystko idzie na jedno miejsce: powstało wszystko z prochu i wszystko do prochu znów wraca"
                            },
                            {
                                "example_id": "fd748aaf-4b9d-4304-afeb-5009ee86bdc7",
                                "sense_id": "99b9b333-0225-3d5f-9bae-8e2b2767c75b",
                                "text": "Pustelnik dniami i nocami rozmyślał nad marnością dóbr doczesnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5812910-905a-49d1-a396-f75f3bd8d29d",
                        "source_entry_id": "e01052c9-c83c-32a6-badf-6c6eff4c96f6",
                        "source_sense_id": "99b9b333-0225-3d5f-9bae-8e2b2767c75b",
                        "target_lang_word": "vanity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vanity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77127e3f-1c51-3a20-8236-513c0e9f85f3",
                                        "entry_id": "acf760de-c147-3b38-95ce-b69959e49a8a",
                                        "glosses": [
                                            "That which is vain, futile, or worthless; that which is of no value, use or profit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac089e99-db2a-4912-a499-1264791104f8",
                                                "sense_id": "77127e3f-1c51-3a20-8236-513c0e9f85f3",
                                                "text": "Then I said in my heart, As it happeneth to the fool, so it happeneth even to me and why then was I more wise? Then I said in my heart that this is also vanity. / For there is no more remembrance of the wise than the fool forever; seeing that which now is in the days to come shall all be forgotten. And how dieth the wise man? as the fool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d116d1d-cf5a-3fe7-a195-4612c1c1b23a",
                                        "entry_id": "acf760de-c147-3b38-95ce-b69959e49a8a",
                                        "glosses": [
                                            "Excessive pride in or admiration of one's own abilities, appearance, achievements, or possessions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f8a8e1e-9b42-4b93-8b4a-578066d65dfd",
                                                "sense_id": "4d116d1d-cf5a-3fe7-a195-4612c1c1b23a",
                                                "text": "To make a man in love with you gives an instant hold on his vanity; and with that, you can do any thing. Vanity is the real lever with which Archimedes said he could move the earth; so, try what you can effect with Sir Robert."
                                            },
                                            {
                                                "example_id": "59c0087b-6290-4216-b17e-6e66c0828f4b",
                                                "sense_id": "4d116d1d-cf5a-3fe7-a195-4612c1c1b23a",
                                                "text": "Try to second guess what people see / All the time it's just your vanity / No one's impressed and you wonder why / Well it is, it shows in the eyes"
                                            },
                                            {
                                                "example_id": "cbbc1834-0f3b-42cf-82ff-5955476db72f",
                                                "sense_id": "4d116d1d-cf5a-3fe7-a195-4612c1c1b23a",
                                                "text": "Social media hasn’t just weaponized our vanity—it’s transformed us from humans into curated digital performances. Our phones have become portable propaganda machines for our personal brands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73a024c-0f51-34f7-b642-8cfbcd2d9bdf",
                                        "entry_id": "acf760de-c147-3b38-95ce-b69959e49a8a",
                                        "glosses": [
                                            "A dressing table used to apply makeup, preen, and coif hair, in which the table is normally quite low and similar to a desk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "702d7038-e02d-4e0a-810b-6f1298d1675b",
                                                "sense_id": "c73a024c-0f51-34f7-b642-8cfbcd2d9bdf",
                                                "text": "She was sitting in front of her vanity, brushing out her hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3c2b165-927d-3189-a30d-7e011afbf0a4",
                                        "entry_id": "acf760de-c147-3b38-95ce-b69959e49a8a",
                                        "glosses": [
                                            "A washbasin installed into a permanently fixed storage unit, used as an item of bathroom furniture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03600e83-f7bf-3b9a-b401-a2db02631543",
                                        "entry_id": "acf760de-c147-3b38-95ce-b69959e49a8a",
                                        "glosses": [
                                            "Any idea, theory or statement that is without foundation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa610255-ef19-4df1-a6b2-93c5ea787f7f",
                                                "sense_id": "03600e83-f7bf-3b9a-b401-a2db02631543",
                                                "text": "It is a vanity to say that if two stones are dropped from a tower, the heavier will experience the greater acceleration."
                                            },
                                            {
                                                "example_id": "fe0d4f7f-3f05-4c08-b3bb-147f57e52604",
                                                "sense_id": "03600e83-f7bf-3b9a-b401-a2db02631543",
                                                "text": "To help the matter, the alchemists call in likewise many vanities out of astrology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8301dc5-b1d2-4161-abc2-de52bd1e8ba9",
                        "source_entry_id": "e01052c9-c83c-32a6-badf-6c6eff4c96f6",
                        "source_sense_id": "99b9b333-0225-3d5f-9bae-8e2b2767c75b",
                        "target_lang_word": "vanité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vanité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e87a025-66f2-349e-9344-ab1b660e4a54",
                                        "entry_id": "7caacc6b-89c2-35d6-8939-d52eb77aabdd",
                                        "glosses": [
                                            "Caractère de ce qui est vain, futile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e972c94-c37e-4091-8e95-d501da1d9f73",
                                                "sense_id": "8e87a025-66f2-349e-9344-ab1b660e4a54",
                                                "text": "L’abondante littérature idyllique des professeurs de rhétorique est évidem­ment une pure vanité."
                                            },
                                            {
                                                "example_id": "a989d321-8f2a-452b-8cd9-1a93fd1e90ac",
                                                "sense_id": "8e87a025-66f2-349e-9344-ab1b660e4a54",
                                                "text": "Mais les vanités de la douleur sont étrangères aux âmes fidèles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "291e2da6-69da-37cf-8b74-21ff9d557634",
                                        "entry_id": "7caacc6b-89c2-35d6-8939-d52eb77aabdd",
                                        "glosses": [
                                            "Inutilité, inconsistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832a7f9f-bc6f-4c34-8157-a35781680b18",
                                                "sense_id": "291e2da6-69da-37cf-8b74-21ff9d557634",
                                                "text": "Mais quand il s’aperçut de la vanité de ses efforts et que, d’autre part, il vit l’Église menacée dans son existence par le développement prodigieux pris par les sectes hérétiques, il changea brusquement d’attitude."
                                            },
                                            {
                                                "example_id": "ca578c66-7e08-410f-b190-9bebcaad00de",
                                                "sense_id": "291e2da6-69da-37cf-8b74-21ff9d557634",
                                                "text": "Deux ans chez les trappistes lui ont appris à la fois le poids des mots et leur vanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2727fd07-e223-3ad3-a282-c66179acdaa5",
                                        "entry_id": "7caacc6b-89c2-35d6-8939-d52eb77aabdd",
                                        "glosses": [
                                            "Désir de se faire valoir, fatuité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b55dca-91ea-4911-86d6-fd47fbee6d4c",
                                                "sense_id": "2727fd07-e223-3ad3-a282-c66179acdaa5",
                                                "text": "Il y a une différence entre l’orgueil et la vanité. L’orgueil est le désir d’être au-dessus des autres, c'est l’amour solitaire de soi-même. La vanité au contraire, c’est le désir d’être approuvé par les autres. Au fond de la vanité, il y a de l’humilité; une incertitude sur soi que les éloges guérissent"
                                            },
                                            {
                                                "example_id": "7aed498b-b95d-4292-acca-fa64284d33ad",
                                                "sense_id": "2727fd07-e223-3ad3-a282-c66179acdaa5",
                                                "text": "Tels sont surtout les comédiens, les musiciens, les orateurs et les poètes. Moins ils ont de talent, plus ils ont d’orgueil, de vanité, d’arrogance. Tous ces fous trouvent cependant d’autres fous qui les applaudissent;.."
                                            },
                                            {
                                                "example_id": "a0a170b0-92f7-4ea7-8efe-45ecf8bfad48",
                                                "sense_id": "2727fd07-e223-3ad3-a282-c66179acdaa5",
                                                "text": "Il avait endossé pour la circonstance un complet vert — peut-être un peu voyant — et orné sa cravate d'une perle qu'il reluquait sans fausse honte, ni, je dois bien le dire, une ombre de vanité."
                                            },
                                            {
                                                "example_id": "eacc7f56-1246-42d5-aba7-f7a00f89093c",
                                                "sense_id": "2727fd07-e223-3ad3-a282-c66179acdaa5",
                                                "text": "Et tous de le flatter, et de l’entourer d’une cour dont il ne peut être dupe, mais dont se gonfle sa vanité."
                                            },
                                            {
                                                "example_id": "ca043a22-86d3-45c9-a3ae-71b4bd5578a4",
                                                "sense_id": "2727fd07-e223-3ad3-a282-c66179acdaa5",
                                                "text": "La vanité et l’orgueil sont choses différentes, bien qu’on emploie souvent ces deux mots l’un pour l’autre ; on peut être orgueilleux sans être vaniteux. L’orgueil se rapporte plus à l’opinion que nous avons de nous-mêmes, la vanité à celle que nous voudrions que les autres aient de nous"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a86dd4cc-3377-3e27-b22c-42de2274194b",
                                        "entry_id": "7caacc6b-89c2-35d6-8939-d52eb77aabdd",
                                        "glosses": [
                                            "Fierté excessive, amour-propre frivole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb34fc4-33dc-4142-ba7a-2117ef79a1fe",
                                                "sense_id": "a86dd4cc-3377-3e27-b22c-42de2274194b",
                                                "text": "Eh ! bien, lui qui devait n’avoir que de l’orgueil était dévoré de vanités blessantes et maladives qui décourageaient l’amitié."
                                            },
                                            {
                                                "example_id": "250d6276-3390-4d87-810b-bc1c9c98842d",
                                                "sense_id": "a86dd4cc-3377-3e27-b22c-42de2274194b",
                                                "text": "[…]; et, sur ces sentiments de basse vanité, se greffait encore l’orgueil d’une vertu qu’il n’avait même pas conquise au prix d’efforts, […]."
                                            },
                                            {
                                                "example_id": "8a999c8e-def0-48a2-a1de-51f3f622276d",
                                                "sense_id": "a86dd4cc-3377-3e27-b22c-42de2274194b",
                                                "text": "Mais tout de même, procréer à son âge lui paraissait louche et, bien qu’un tel résultat flattât sa vanité de vieux coq, la crainte d’avoir été aidé dans cette œuvre par des collaborateurs bénévoles autant qu’inconnus le retenait hésitant au bord du fossé conjugal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c20d997-a8e2-3f74-91b8-1854dcb72e13",
                                        "entry_id": "7caacc6b-89c2-35d6-8939-d52eb77aabdd",
                                        "glosses": [
                                            "Peinture de genre signifiant le temps, la mort, l’instabilité des choses, à l’aide de composition d’objets périssables, tels que bougie, crâne, sablier, végétaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83c4218c-38b0-3ad8-bf31-05fd2780fb70",
                                        "entry_id": "7caacc6b-89c2-35d6-8939-d52eb77aabdd",
                                        "glosses": [
                                            "Bijou, bague, orné d’une tête de mort."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85c1fdf8-9837-43a1-ab44-70d8f9db975c",
                                                "sense_id": "83c4218c-38b0-3ad8-bf31-05fd2780fb70",
                                                "text": "Les voûtes de l’établissement devaient remonter aux catacombes, l’éclairage aurait convenu à un enterrement clandestin, les clients et les serveurs arboraient des vanités à chaque doigt – tout ici présageait la mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d264bcf-d1da-384f-9d8d-e81e0cc2c260",
                                        "entry_id": "7caacc6b-89c2-35d6-8939-d52eb77aabdd",
                                        "glosses": [
                                            "Mondanités, frivolités, futilités."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b14d9841-ecd7-4539-af1c-ae6de242eeb5",
                                                "sense_id": "1d264bcf-d1da-384f-9d8d-e81e0cc2c260",
                                                "text": "Je n’aime pas ces vanités, qui étaient inconnues à nos pères lorsque l’Angleterre était libre."
                                            },
                                            {
                                                "example_id": "dedcd73a-df6d-48df-9f74-c6926206d6ed",
                                                "sense_id": "1d264bcf-d1da-384f-9d8d-e81e0cc2c260",
                                                "text": "La lampe éteinte, Félicité ne put dormir. Les yeux fermés, elle faisait de merveilleux châteaux en Espagne. Les vingt mille francs de rente dansaient devant elle, dans l’ombre, une danse diabolique. Elle habitait un bel appartement de la ville neuve, avait le luxe de M. Peirotte, donnait des soirées, éclaboussait de sa fortune la ville entière. Ce qui chatouillait le plus ses vanités, c’était la belle position que son mari occuperait alors."
                                            },
                                            {
                                                "example_id": "8ffb15fd-f3a1-4841-911c-3cb97222c9a0",
                                                "sense_id": "1d264bcf-d1da-384f-9d8d-e81e0cc2c260",
                                                "text": "De toute évidence, hommes et femmes ne viennent ici que pour se faire admirer. C'est le rendez-vous des vanités élégantes, des rivalités paradeuses et des clins d'œil assassins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
