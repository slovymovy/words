                "senses": [
                    {
                        "sense_id": "6e13da48-4c1c-3a3d-af25-5446e0233d2d",
                        "entry_id": "a4603dd7-6fd2-3ed1-a082-6a33c430b8c0",
                        "glosses": [
                            "opzettelijk door inbinding misvormd onderste deel van het been voorbij de enkel, als resultaat van het vroegere Chinese schoonheidsideaal dat vrouwen zo klein mogelijke voeten voorschreef"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "bc13231e-b5ea-4827-93d1-3eb5f416d919",
                                "sense_id": "6e13da48-4c1c-3a3d-af25-5446e0233d2d",
                                "text": "„Ah, de lotusvoet is terug; schoonheid boven schoonheid.” Verlekkerde ik me bij de schitterende zoombeelden nog aan het geavanceerde, om de voet gezogen schaatsschoeisel, zag ik opeens de gruwelijke verminkingen voor me van een oud Chinees schoonheidsideaal zoals ooit vertoond in een documentaire op National Geographic Channel: de ingebonden voet."
                            }
                        ]
                    },
                    {
                        "sense_id": "81b4f590-27d6-3e17-a274-69d9263fd4e6",
                        "entry_id": "a4603dd7-6fd2-3ed1-a082-6a33c430b8c0",
                        "glosses": [
                            "respectvolle aanduiding voor de voeten van de god Krishna of iemand met spiritueel gezag"
                        ],
                        "tags": [
                            "hindoeïsme"
                        ],
                        "examples": [
                            {
                                "example_id": "ae1a5f03-d0a5-49fa-973c-3029d011762a",
                                "sense_id": "81b4f590-27d6-3e17-a274-69d9263fd4e6",
                                "text": "Toen Krishnadasa uit dankbaarheid en liefde voor God aan haar voeten viel, plaatste ze haar lotusvoet op zijn hoofd en vroeg hem welke zegen hij verlangde."
                            }
                        ]
                    },
                    {
                        "sense_id": "0459f22c-f26c-353f-8acb-eba0411adbff",
                        "entry_id": "a4603dd7-6fd2-3ed1-a082-6a33c430b8c0",
                        "glosses": [
                            "steun of drager uitgevoerd als een gestileerde weergave van de bloemkroon van een lotus Nelumbo nucifera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1233a00a-f910-43ce-9a79-dfd3189b5da2",
                                "sense_id": "0459f22c-f26c-353f-8acb-eba0411adbff",
                                "text": "Ze wordt weergegeven in een zittende positie op een prachtig versierde lotusvoet, met haar rechterhand omhoog en in haar linkerhand een schaal"
                            }
                        ]
                    }
