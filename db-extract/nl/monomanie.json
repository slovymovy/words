                                    {
                                        "sense_id": "0eba1c3e-f77a-3222-8669-8219a88bc103",
                                        "entry_id": "e2ccc31d-8269-3ac0-948d-96c4f24d48d6",
                                        "glosses": [
                                            "Excessive interest or concentration on a singular object or subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "942c032c-b47f-44b4-9208-052161bcb156",
                                                "sense_id": "0eba1c3e-f77a-3222-8669-8219a88bc103",
                                                "text": "It was apparent to all but himself that what was once idle curiosity had become a monomania."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63650cca-2728-3eaf-a0db-06f81400f64a",
                                        "entry_id": "e2ccc31d-8269-3ac0-948d-96c4f24d48d6",
                                        "glosses": [
                                            "A pathological obsession with one person, thing or idea."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28b95cd3-70d3-46c9-a462-a44a67315608",
                                                "sense_id": "63650cca-2728-3eaf-a0db-06f81400f64a",
                                                "text": "“There are no limits to the possibilities of monomania,” I answered. “There is the condition which the modern French psychologists have called the ‘idée fixe,’ which may be trifling in character, and accompanied by complete sanity in every other way. A man who had read deeply about Napoleon, or who had possibly received some hereditary family injury through the great war, might conceivably form such an ‘idée fixe’ and under its influence be capable of any fantastic outrage.”"
                                            }
                                        ]
                                    }
                                ]
                            }
