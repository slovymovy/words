                ],
                "translations": [
                    {
                        "translation_id": "ccb81b49-cb1b-4302-b7a3-7a54ef847327",
                        "source_entry_id": "40fcab2e-9226-3985-8514-4e21341832f2",
                        "source_sense_id": "524f7304-cbdb-32a4-bf7b-e2c13dc5c471",
