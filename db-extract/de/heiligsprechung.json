                    {
                        "translation_id": "3bc02bce-b03a-4c09-8c80-ef75517f734a",
                        "source_entry_id": "482e5568-5f0b-3a30-bd8b-cbf05780389d",
                        "source_sense_id": "42cdcb7a-2f37-3428-95b2-853e42b9cf18",
