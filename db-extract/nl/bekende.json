                "forms": [],
                "senses": [
                    {
                        "sense_id": "da9b1a50-325d-3802-b2ac-f20977395866",
                        "entry_id": "debfbe80-ab3a-327f-97c0-830dd366cf64",
                        "glosses": [
                            "verbogen vorm van de stellende trap van bekend"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "352f73d7-e76a-47fe-b3ba-46114bd809d3",
                                "sense_id": "da9b1a50-325d-3802-b2ac-f20977395866",
                                "text": "Tot mijn verbazing zie ik de naam van een bekende castingagente op het scherm staan."
                            },
                            {
                                "example_id": "7d73a1d2-43f3-4004-be5e-674e592fe275",
                                "sense_id": "da9b1a50-325d-3802-b2ac-f20977395866",
                                "text": "In de Nederlandse culinaire wereld wordt geschokt gereageerd op het onverwachtse overlijden van topchef Jonnie Boer, op 60-jarige leeftijd. Veel jonge koks met wie hij werkte, hebben nu hun eigen bekende restaurants. Voor hen was hij een grote inspiratie."
                            },
                            {
                                "example_id": "6d34f0de-b577-4803-9ff9-65dd61e22016",
                                "sense_id": "da9b1a50-325d-3802-b2ac-f20977395866",
                                "text": "Zeehonden voeren: \"Ik ben van 1971, net als de zeehondencrèche. Ik weet niet beter dan dat dit hier hoort\", zei Agnes Klont uit Pieterburen. \"We hebben hier zoveel meegemaakt. Bekende Nederlanders over de vloer, toeristen uit het buitenland. Vriendinnen van mij gingen 's nachts nog even zeehonden voeren tussen het stappen door. Het bracht leven in het dorp.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "67aad8ea-2a62-3ca0-a6a5-91ebca17c581",
