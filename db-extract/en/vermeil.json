                        "sense_id": "1f4c83ff-421a-3893-ba62-4602c8158496",
                        "entry_id": "0124685b-5ece-301c-aaa4-3f13bc0fce44",
                        "glosses": [
                            "Bright scarlet, vermilion."
                        ],
                        "tags": [
                            "archaic",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "06543098-736f-40e4-92d2-39925a4b5c7e",
                                "sense_id": "1f4c83ff-421a-3893-ba62-4602c8158496",
                                "text": "And in her cheekes the vermeill red did shew / Like roses in a bed of lillies shed[…]."
                            },
                            {
                                "example_id": "92e7bd1b-3198-4119-9bd3-38a2dfa69db9",
                                "sense_id": "1f4c83ff-421a-3893-ba62-4602c8158496",
                                "text": "Many and many a verse I hope to write,\nBefore the daisies, vermeil rimm’d and white,\nHide in deep herbage;"
                            }
                        ]
                    },
                    {
                        "sense_id": "f48816c5-0175-323d-98c0-c510dcca2710",
                        "entry_id": "0124685b-5ece-301c-aaa4-3f13bc0fce44",
                        "glosses": [
                            "Specifically of faces, lips etc.: red, ruddy, healthy-looking."
                        ],
                        "tags": [
                            "archaic",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "5b3965dc-eaa9-49c7-962c-a2bcbeee0fa7",
                                "sense_id": "f48816c5-0175-323d-98c0-c510dcca2710",
                                "text": "his carriage; demeanor, and venerable behaviour, in a face so young, vermeill, and heart enflaming[…]."
                            },
                            {
                                "example_id": "f8b4b4b5-7e03-45f3-b721-59f512d42c54",
                                "sense_id": "f48816c5-0175-323d-98c0-c510dcca2710",
                                "text": "a lip as vermeil as her own. (IV, xxx)"
                            }
                        ]
                    }
