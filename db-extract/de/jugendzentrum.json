                ],
                "senses": [
                    {
                        "sense_id": "8ed4efb0-6e3f-385e-87e4-65e745bf4a93",
                        "entry_id": "4ffc6c12-0fd0-32f2-9331-793a8fcca93c",
                        "glosses": [
                            "Einrichtung, die Jugendlichen ein vielfältiges Angebot zur Freizeitbeschäftigung bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16efac05-f2b1-41f0-8d67-8609f1eae997",
                                "sense_id": "8ed4efb0-6e3f-385e-87e4-65e745bf4a93",
                                "text": "„Sie wollte wohl doch etwas mit Kindern studieren, denn sie erzählte irgendwas von ihrer Arbeit in einem Jugendzentrum.“"
                            },
                            {
                                "example_id": "1171ae61-1867-4e0b-9912-9e58f91b3e80",
                                "sense_id": "8ed4efb0-6e3f-385e-87e4-65e745bf4a93",
                                "text": "„Die Gemeinde Vaduz hatte damals das Bedürfnis nach einem Jugendzentrum erkennen lassen.“"
                            },
                            {
                                "example_id": "149bd455-0e45-4677-9e29-1b496794818b",
                                "sense_id": "8ed4efb0-6e3f-385e-87e4-65e745bf4a93",
                                "text": "„Das Jugendzentrum veranstaltet ein Wochenendfestival, und wir binden praktisch die gesamte Stadt mit ein.“"
                            },
                            {
                                "example_id": "8f6564de-5a48-4d3d-8bd3-cf1130371fac",
                                "sense_id": "8ed4efb0-6e3f-385e-87e4-65e745bf4a93",
                                "text": "„Kochen bietet eine Möglichkeit, sich produktiv in das Jugendzentrum einzubringen – eine Form der Teilnahme, die von den Jugendarbeitenden geschätzt wird.“"
                            },
                            {
                                "example_id": "41904d78-a489-4007-9431-99f7626540fb",
                                "sense_id": "8ed4efb0-6e3f-385e-87e4-65e745bf4a93",
                                "text": "„Ein für unseren Kreisverband wesentliches lokales Konfliktfeld stellte der Kampf um ein selbstverwaltetes Jugendzentrum in Mülheim an der Ruhr dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
