                ],
                "senses": [
                    {
                        "sense_id": "d01e1a0b-8694-379f-b4d0-089a4db29109",
                        "entry_id": "ee3b76a8-0514-32de-b890-78b2a3fa4f90",
                        "glosses": [
                            "воен. сокр. от авиационный удар; бомбовый удар авиации по позициям противника"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "4f88eeb3-742b-44c8-9044-66848e28057d",
                                "sense_id": "d01e1a0b-8694-379f-b4d0-089a4db29109",
                                "text": "35 человек погибли и 134 получили ранения в результате российского авиаудара по Яворивскому военному полигону, в 25 километрах от границы с Польшей. Об этом 13 марта сообщила Львовская обладминистрация."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cac358d8-0448-4664-8ba2-37652089f845",
                        "source_entry_id": "ee3b76a8-0514-32de-b890-78b2a3fa4f90",
                        "source_sense_id": "d01e1a0b-8694-379f-b4d0-089a4db29109",
                        "target_lang_word": "air strike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "air strike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "634afdeb-a1c9-3bb7-a603-d8dea5916900",
                                        "entry_id": "ef3a566b-c324-3bff-bff5-34e9ed9b6126",
                                        "glosses": [
                                            "An attack on a ground or naval target by one or more aircraft or missiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75971c05-3b02-41a0-99ad-d10cd560b46e",
                                                "sense_id": "634afdeb-a1c9-3bb7-a603-d8dea5916900",
                                                "text": "Iran's known nuclear facilities that earned the country nearly two decades of US and international sanctions, with an estimated cost of hundreds of billions of dollars, are now damaged from the air strikes, although the full extent of this has been hard to assess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ae77436-b044-4ed5-837d-53d51404bee7",
                        "source_entry_id": "ee3b76a8-0514-32de-b890-78b2a3fa4f90",
                        "source_sense_id": "d01e1a0b-8694-379f-b4d0-089a4db29109",
                        "target_lang_word": "airstrike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airstrike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11fe7e27-59ac-368a-a0c3-34e008857c97",
                                        "entry_id": "c3c510c2-9a49-318a-a872-29489b5354cd",
                                        "glosses": [
                                            "Alternative form of air strike."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "356c6a31-4262-4eca-8251-f188f43bd560",
                                                "sense_id": "11fe7e27-59ac-368a-a0c3-34e008857c97",
                                                "text": "The US President himself accused Iran of being behind the provocation, threatening airstrikes on Iran last week – but calling them off just minutes before they were to begin."
                                            },
                                            {
                                                "example_id": "e47c081d-dcfa-463e-8467-1c3784c6f85d",
                                                "sense_id": "11fe7e27-59ac-368a-a0c3-34e008857c97",
                                                "text": "An Israeli airstrike rocked southern Beirut on Sunday soon after the military issued an evacuation warning for the Lebanese capital."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "airstrike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46ec4e37-a589-3fa6-a51c-e3344a0c8f67",
                                        "entry_id": "5efb38eb-9912-3cb5-8c51-ff551545cedf",
                                        "glosses": [
                                            "To attack a ground target through the use of aircraft or missiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf7e5117-c449-4ba6-8b1e-700daf3a3cad",
                        "source_entry_id": "ee3b76a8-0514-32de-b890-78b2a3fa4f90",
                        "source_sense_id": "d01e1a0b-8694-379f-b4d0-089a4db29109",
                        "target_lang_word": "Luftangriff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftangriff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a1b10c8-0c69-33ae-beba-8d7804a571f0",
                                        "entry_id": "b713125e-e974-3c8a-9d57-12f64822b8cd",
                                        "glosses": [
                                            "militärischer Gewaltakt aus der Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aceca581-95ae-4d5b-9d23-260990263307",
                                                "sense_id": "5a1b10c8-0c69-33ae-beba-8d7804a571f0",
                                                "text": "Bei einem mit Hubschraubern geführten Luftangriff sind fünfzehn Personen verletzt worden."
                                            },
                                            {
                                                "example_id": "1ae1417c-88d6-44ba-b25b-33918b817e32",
                                                "sense_id": "5a1b10c8-0c69-33ae-beba-8d7804a571f0",
                                                "text": "„Eines Nachts waren sie auf Deck zusammen gewesen, während ein Luftangriff tobte.“"
                                            },
                                            {
                                                "example_id": "a793cb8c-049c-49ab-86f0-6adcc6c1845d",
                                                "sense_id": "5a1b10c8-0c69-33ae-beba-8d7804a571f0",
                                                "text": "„Im April 1944 bediente sich Admiral Rolf Johannesson derselben Zeilen während eines Gedenkgottesdienstes für einhundert Seeleute, die bei einem britischen Luftangriff gegen das Schlachtschiff TIRPITZ ums Leben gekommen waren.“"
                                            },
                                            {
                                                "example_id": "545a4223-70fc-4386-9e71-bf5e68c36ff7",
                                                "sense_id": "5a1b10c8-0c69-33ae-beba-8d7804a571f0",
                                                "text": "„Die Briten flogen massive Luftangriffe, vor allem an Ruhr und Rhein…“"
                                            },
                                            {
                                                "example_id": "7a381c72-1b53-4bfd-a78c-7feadfd6d080",
                                                "sense_id": "5a1b10c8-0c69-33ae-beba-8d7804a571f0",
                                                "text": "„In Mannheim/Ludwigshafen war gerade der 100. Luftangriff vorüber.“"
                                            },
                                            {
                                                "example_id": "0120dafa-0148-4ab9-b063-c68383c571af",
                                                "sense_id": "5a1b10c8-0c69-33ae-beba-8d7804a571f0",
                                                "text": "„Etwa eine halbe Stunde später verkündete der Sirenenton das Ende des Luftangriffs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
