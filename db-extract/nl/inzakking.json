                        "examples": [
                            {
                                "example_id": "b7a7bb3a-6dd2-4395-8b75-8f5995e16932",
                                "sense_id": "1342dea7-e843-339d-8f3b-30dd9c617dd0",
                                "text": "Aruba heeft het tekort de afgelopen jaren laten oplopen in een poging de economie te beschermen tegen de gevolgen van de inzakking van het toerisme tijdens de internationale recessie van 2009 en van de sluiting van de olieraffinaderij in de jaren daarna."
                            },
                            {
                                "example_id": "dfa44a7c-7dc0-4f41-9df7-64a4f67ba3dc",
                                "sense_id": "1342dea7-e843-339d-8f3b-30dd9c617dd0",
                                "text": "De opening van het gespaard gebleven deel van 't Loon was ook rond deze tijd voorzien. Het winkelcentrum werd gesloten na de inzakking van een deel ervan eind november vorig jaar. Van de 50 winkels moesten er vervolgens 10 gesloopt worden."
                            }
                        ]
                    }
