                "senses": [
                    {
                        "sense_id": "4340335e-bbdf-37bf-af33-bb608069c0c8",
                        "entry_id": "b3c2831d-9790-330e-bded-93c589058965",
                        "glosses": [
                            "Action de chercher, trouver et retirer un bug d’un programme informatique, et par extension, d’un système, une banque de données, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58082c06-12d8-493b-9bbb-0bfcf8ba79f5",
                                "sense_id": "4340335e-bbdf-37bf-af33-bb608069c0c8",
                                "text": "On y met les dernières touches, on hésite sur un jaune, on bricole, on débeugue, on râle encore."
                            },
                            {
                                "example_id": "363c10ff-0667-47fc-ad5e-5ba9e1b37538",
                                "sense_id": "4340335e-bbdf-37bf-af33-bb608069c0c8",
                                "text": "Car qu’on se le dise, un informaticien n’est pas uniquement bon à coder et débeuguer un site, mais aussi à être hyper branché séries."
                            }
                        ]
                    }
