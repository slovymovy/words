                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b586d553-12c8-4d24-922c-170d25ef3062",
                                "sense_id": "4f0fa85c-7ccf-3cb1-8e86-b4f94d54944c",
                                "text": "De borden zijn uiteindelijk helemaal recyclebaar en zien er aan de voorkant precies zo uit als de exemplaren van aluminium."
                            },
                            {
                                "example_id": "fd75f6fc-5716-4704-b3d6-866b444b3b69",
                                "sense_id": "4f0fa85c-7ccf-3cb1-8e86-b4f94d54944c",
                                "text": "Onderzoekers hebben een elektronisch stukje huid ontwikkeld, dat zichzelf kan helen en volledig recyclebaar is. Social media-redacteur Jonna ter Veer vertelt waar dit voor gebruikt zou kunnen worden."
                            }
                        ]
                    }
