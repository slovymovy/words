{
    "word_family": [
        "irredeemability",
        "irredeemably",
        "redeem",
        "redeemable",
        "redemption"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7000bd5d-abe1-38b0-a2cd-5235482472d5",
                    "sense_definition": "Too bad to be corrected, improved, or saved; hopeless.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hopeless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided the old building was in an <w>irredeemable</w> state of decay.",
                            "target_lang_translations": {
                                "ru": "Комитет решил, что старое здание находится в <w>безнадёжном</w> состоянии упадка."
                            }
                        },
                        {
                            "text": "He worried that a single reckless mistake had caused <w>irredeemable</w> damage to his reputation.",
                            "target_lang_translations": {
                                "ru": "Он переживал, что одна опрометчивая ошибка нанесла <w>непоправимый</w> урон его репутации."
                            }
                        }
                    ],
                    "synonyms": [
                        "unredeemable"
                    ],
                    "antonyms": [
                        "redeemable"
                    ],
                    "common_phrases": [
                        "irredeemable error",
                        "irredeemable damage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слишком плохой, чтобы его можно было исправить, улучшить или спасти; безнадёжный или непоправимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непоправимый",
                                "target_lang_sense_clarification": "о вреде, ошибке или ущербе"
                            },
                            {
                                "target_lang_word": "безнадёжный",
                                "target_lang_sense_clarification": "о положении или ситуации, не поддающейся исправлению"
                            },
                            {
                                "target_lang_word": "неисправимый",
                                "target_lang_sense_clarification": "о недостатках или пороках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "678d4709-ea9b-36fc-b3e9-561b137a7a09",
                    "sense_definition": "Not convertible into cash, gold, or another underlying asset on demand.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most modern economies rely on <w>irredeemable</w> paper currency rather than gold-backed money.",
                            "target_lang_translations": {
                                "ru": "Большинство современных экономик опираются на <w>неразменные</w> бумажные деньги, а не на валюту, обеспеченную золотом."
                            }
                        },
                        {
                            "text": "The government issued an <w>irredeemable</w> bond that pays interest perpetually.",
                            "target_lang_translations": {
                                "ru": "Правительство выпустило <w>бессрочную</w> облигацию, проценты по которой выплачиваются бессрочно."
                            }
                        }
                    ],
                    "synonyms": [
                        "unredeemable"
                    ],
                    "antonyms": [
                        "redeemable"
                    ],
                    "common_phrases": [
                        "irredeemable paper currency",
                        "irredeemable bond"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подлежащий обмену на наличные деньги, золото или иной базовый актив по требованию; бессрочный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразменный",
                                "target_lang_sense_clarification": "о бумажных деньгах, не конвертируемых в золото"
                            },
                            {
                                "target_lang_word": "бессрочный",
                                "target_lang_sense_clarification": "об облигациях без фиксированного срока погашения"
                            },
                            {
                                "target_lang_word": "непогашаемый",
                                "target_lang_sense_clarification": "о ценных бумагах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff6ce6ee-aa41-3964-95f2-36edc91a39a3",
                    "sense_definition": "A security or financial instrument that cannot be redeemed or cashed in.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors preferred government gilts rather than holding high-risk <w>irredeemables</w> indefinitely.",
                            "target_lang_translations": {
                                "ru": "Инвесторы предпочитали государственные облигации бессрочному владению рискованными <w>непогашаемыми ценными бумагами</w>."
                            }
                        },
                        {
                            "text": "The institution held an <w>irredeemable</w> that produced a steady annual yield.",
                            "target_lang_translations": {
                                "ru": "Организация владела <w>бессрочной облигацией</w>, которая приносила стабильный ежегодный доход."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценная бумага или финансовый инструмент без фиксированного срока погашения, который нельзя выкупить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессрочная ценная бумага",
                                "target_lang_sense_clarification": "финансовый инструмент без срока погашения"
                            },
                            {
                                "target_lang_word": "непогашаемая облигация",
                                "target_lang_sense_clarification": "бессрочная облигация, приносящая постоянный доход"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}