                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2895c133-f2e4-4762-b30e-c21f33e0f51e",
                                                "sense_id": "b8bcdb67-97c1-3578-89f8-6e1bea404a93",
                                                "text": "In Jogjakarta bevindt zich het kraton Ngayogyakarta Hadiningrat."
                                            },
                                            {
                                                "example_id": "2846cce1-d2dc-4749-9547-a39fd26225d1",
                                                "sense_id": "b8bcdb67-97c1-3578-89f8-6e1bea404a93",
                                                "text": "In zijn kraton Kaspuhan geeft de jonge sultan Natadiningrat een rondleiding door de rijk ingerichte en gestoffeerde koninklijke zalen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b953390-94ba-3e19-bd5c-492c0b2df44f",
                                        "entry_id": "6ea381a6-fa79-31ff-81bd-37653f24a870",
                                        "glosses": [
                                            "elk van de stabiele stukken continentale aardkost welke vroeg in de aardgeschiedenis gevormd zijn en de harde kernen van de schuivende continenten vormen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97321ea3-393e-400e-9b40-8023ed26a4ea",
                                                "sense_id": "1b953390-94ba-3e19-bd5c-492c0b2df44f",
                                                "text": "Het Afrikaanse continent is uit verschillende kratons opgebouwd."
                                            }
