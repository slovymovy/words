                        "source_entry_id": "503ee846-81f7-3b19-9aca-312933d21bab",
                        "source_sense_id": "3606696f-b265-3958-bc03-779646ba7d67",
                        "source_sense_description": "reproductive particle released by an organism to propagate itself",
