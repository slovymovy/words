                "senses": [
                    {
                        "sense_id": "2e3f712b-de96-34b8-93d2-b7507527b1f7",
                        "entry_id": "9e912b6f-f7d1-3258-b056-65bbae8b8f70",
                        "glosses": [
                            "Bezeichner für die konkret verwendete Temperatur-Skala nach Celsius (Celsius-Skala); für sich allein keine Temperatureinheit; zur Temperatureinheit wird es erst in der Gestalt der richtigen Wortkombinationen Grad Celsius oder Celsiusgrade; die Temperatureinheit ist das Grad (°)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a43fb88-8d64-4087-b409-19b1b9ee3c4f",
                                "sense_id": "2e3f712b-de96-34b8-93d2-b7507527b1f7",
                                "text": "Man muss den Temperaturwert erst umrechnen, von Celsius in Fahrenheit."
                            },
                            {
                                "example_id": "af040745-f7c2-401f-bb87-d601f2f729d6",
                                "sense_id": "2e3f712b-de96-34b8-93d2-b7507527b1f7",
                                "text": "„Es friert, außerordentliche 18 Grad Celsius, und es schneit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33387620-216f-49bd-a219-cb983315d88a",
                        "source_entry_id": "9e912b6f-f7d1-3258-b056-65bbae8b8f70",
                        "source_sense_id": "2e3f712b-de96-34b8-93d2-b7507527b1f7",
                        "source_sense_description": "Bezeichner für die konkret verwendete Temperatur-Skala nach Celsius",
                        "target_lang_word": "Celsius",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Celsius",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35d6b6ff-bed7-35b6-8736-534be7ef0deb",
                                        "entry_id": "f7f0a0fd-af1c-3f45-88f8-37f3043ed038",
                                        "glosses": [
                                            "Related to a metric temperature scale, originally defined as having the freezing point of water as 0 degrees and its boiling point as 100 degrees, at standard atmospheric pressure. The standardized definition has 0.01 °C as the triple point of water, and a difference in temperature of 1 °C corresponds to ¹⁄_(273.16) of the difference in temperature between the triple point and the absolute zero."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "442ff68f-527f-4da7-a91f-d8f6d8d1b347",
                                                "sense_id": "35d6b6ff-bed7-35b6-8736-534be7ef0deb",
                                                "text": "Temperatures in Bangkok fell as low as 59.3 degrees Fahrenheit (15.2 degrees Celsius) on Monday, the lowest the capital has seen in years, as the country’s weather agency warned cool conditions could persist through mid-February."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
