                                    {
                                        "sense_id": "45d811ec-1301-3498-9a65-e50491b05cce",
                                        "entry_id": "c28797e1-0788-37b1-853d-6df554bd0635",
                                        "glosses": [
                                            "die Aufmerksamkeit stärker auf das Innenleben richtend, verschlossen, Kontakt mit der Außenwelt meidend"
