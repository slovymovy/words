                                                "example_id": "d4c1e6a7-fea4-4a46-933c-4fc07b529be7",
                                                "sense_id": "ca8347ad-4d12-312d-9378-3e6cb176fbef",
                                                "text": "Ces ressemblances entre les sociétés tupi et aztèque s'étendent à d'autres aspects de la vie religieuse."
                                            },
                                            {
                                                "example_id": "26f37ede-6e57-4d22-8408-06e2525ee422",
                                                "sense_id": "ca8347ad-4d12-312d-9378-3e6cb176fbef",
                                                "text": "Des guerriers tupi entraient et sortaient avec un air martial."
                                            }
