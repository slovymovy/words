                        "glosses": [
                            "Qui a été disposé d’une nouvelle façon."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "962deeca-9fe4-429c-89d6-72baecbadc4f",
                                "sense_id": "63b01dbf-2d5d-38f1-af78-d39abfde6e5d",
                                "text": "Au cours d’une vie où j’ai souvent essayé de mettre le doigt sur certains faits, petits ou grands, de l’histoire, j’ai trop acquis la solide conviction que tout ce qui se dit ou s’écrit sur les événements du passé est en partie faux, toujours incomplet et toujours réarrangé, pour avoir eu l’envie, dans ce cas particulier, de m’attarder plus longtemps."
                            }
                        ]
                    }
