                                                "sense_id": "308c2b1e-7812-3196-9ee5-738441fe6021",
                                                "text": "Syndrom se projevuje svalovými záškuby, ale i nekontrolovatelnými velmi hlasitými výkřiky, mručením a podobnými zvuky a asi v patnácti procentech případů ji doprovází koprolálie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c556699-5723-3ca3-89bf-1f8f1940056a",
                                        "entry_id": "839931f2-abc9-3618-9d45-3184694aaac8",
                                        "glosses": [
                                            "nechorobné nadměrné používání obscénních slov a výroků, vulgarita"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df4f0f6f-e233-46cb-a220-dec6988d446f",
                                                "sense_id": "8c556699-5723-3ca3-89bf-1f8f1940056a",
                                                "text": "Rozmach koprolálie? Je mi líto, že tak mluví také čím dál víc mladých dam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d24f5b65-59f4-3654-a033-066b8bc4a9ed",
                                        "entry_id": "839931f2-abc9-3618-9d45-3184694aaac8",
