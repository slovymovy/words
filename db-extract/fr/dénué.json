                "senses": [
                    {
                        "sense_id": "199b5269-824c-3682-8a2d-ae67ddb8d67e",
                        "entry_id": "1a7a97bd-9796-366e-b774-eb950b6fbc8f",
                        "glosses": [
                            "Qui est dépourvu du nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa85cea-8774-46d8-abb6-3f1dded8c89d",
                                "sense_id": "199b5269-824c-3682-8a2d-ae67ddb8d67e",
                                "text": "Il était très ennuyé car, pour lui, cette histoire était choquante au possible, dénuée de toute dignité."
                            },
                            {
                                "example_id": "6fc495a1-ce39-440e-8b58-3d892b8eb3c4",
                                "sense_id": "199b5269-824c-3682-8a2d-ae67ddb8d67e",
                                "text": "Il est dénué de tous biens."
                            },
                            {
                                "example_id": "7c562e77-5d8e-4e85-ae4e-75afd13c889d",
                                "sense_id": "199b5269-824c-3682-8a2d-ae67ddb8d67e",
                                "text": "— Dénué d’esprit, de bon sens. - Dénué de grâce, d’agrément."
                            },
                            {
                                "example_id": "26f5c7ec-3c65-401b-a85f-13d0e057ca72",
                                "sense_id": "199b5269-824c-3682-8a2d-ae67ddb8d67e",
                                "text": "Ce qu'il avait à le dire, ainsi que tu vas le voir, était loin d'être dénué d'intérêt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
