                        "translation_id": "b3583c2d-f690-4610-81e7-9de93112ffc8",
                        "source_entry_id": "20ea069c-0566-3ff5-a222-9b4c447825c5",
                        "source_sense_id": "bcd8066b-ce60-39a6-9f12-a234069e58c4",
                        "source_sense_description": "Provinz im Westen der Volksrepublik China",
                        "target_lang_word": "Qinghai",
