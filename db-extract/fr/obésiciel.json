                        "sense_id": "b071cda6-0229-3668-ac04-b5f970eb6813",
                        "entry_id": "de5e9d2f-66e9-3c88-872c-3554ca53748c",
                        "glosses": [
                            "Logiciel qui utilise beaucoup de mémoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35285a4-1f8e-4d59-83d3-9722d060cba0",
                                "sense_id": "b071cda6-0229-3668-ac04-b5f970eb6813",
                                "text": "Le phénomène d’« obésiciel » rend certains services numériques trop lents ou inutilisables, notamment sur de vieux équipements et dans les territoires où la connexion et le pouvoir d’achat sont faibles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ea032bc-1b4f-4101-872f-1b2db2c62738",
                        "source_entry_id": "de5e9d2f-66e9-3c88-872c-3554ca53748c",
                        "source_sense_id": "b071cda6-0229-3668-ac04-b5f970eb6813",
                        "target_lang_word": "bloatware",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloatware",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e4f900b-e4e7-3813-808f-fd97644fd5fd",
                                        "entry_id": "f60ca46e-24da-3806-933b-b480e940b2b3",
                                        "glosses": [
                                            "Software that is packed with too many features and therefore slow or unwieldy; software that is inefficiently designed and occupies an excessive amount of memory or disk space."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa8be246-831b-426f-88c7-7e4b0aa83b30",
                                                "sense_id": "2e4f900b-e4e7-3813-808f-fd97644fd5fd",
                                                "text": "Today’s software development cycle does not allow time to optimize and refine products, and that leads to bloatware."
                                            },
                                            {
                                                "example_id": "dcea4b2f-c3a3-4853-be4e-9b7184c45013",
                                                "sense_id": "2e4f900b-e4e7-3813-808f-fd97644fd5fd",
                                                "text": "That’s not really a surprise, considering that writing efficient software takes more time than writing wasteful code. “Bloatware” makes economic sense for software developers, if not for consumers!"
                                            },
                                            {
                                                "example_id": "71a4003c-3eb4-45b0-8064-e40c9e852f2c",
                                                "sense_id": "2e4f900b-e4e7-3813-808f-fd97644fd5fd",
                                                "text": "I’ll bet you think I’m going to write one of those boring articles you see all over the net bemoaning “bloatware.” Whine whine whine, this stuff is so bloated, oh woe is me, edlin and vi are so much better than Word and Emacs because they are svelte, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e293a8-4be0-3db5-b982-7478317af755",
                                        "entry_id": "f60ca46e-24da-3806-933b-b480e940b2b3",
                                        "glosses": [
                                            "Unwanted pre-installed software, especially on a smartphone."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "729ef195-224a-4648-86cf-d1d3ccb4504e",
                                                "sense_id": "39e293a8-4be0-3db5-b982-7478317af755",
                                                "text": "Bloatware has also introduced numerous security and trust issues in smartphones. […] OEMs, third-party app providers, telecommunication operators, and malicious parties have used bloatware apps to over-collect user data."
                                            },
                                            {
                                                "example_id": "89c3eab8-d0d3-4602-b5c0-b2bd720aad11",
                                                "sense_id": "39e293a8-4be0-3db5-b982-7478317af755",
                                                "text": "Most phones had preinstalled Android stores and bloatware built in by manufacturers, but workers would still choose to install third-party marketplaces like Tencent MyApp, Baidu 91 Mobile Assistance, and Qihoo 360 Mobile Assistants."
                                            },
                                            {
                                                "example_id": "e24aa749-298d-4700-9902-02382a90de70",
                                                "sense_id": "39e293a8-4be0-3db5-b982-7478317af755",
                                                "text": "“[…] samsung should stop adding crap bloatware […] i never use such app^([sic]) and i dont need it”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
