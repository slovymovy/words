                "senses": [
                    {
                        "sense_id": "e9476816-033f-3862-b169-a4ae4ebf6099",
                        "entry_id": "09fc1007-862d-3e82-9f06-62d587d1f327",
                        "glosses": [
                            "Sachverhalt (Faktor), der die Umwelt beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "977a89dd-ba97-449d-96fb-d3215c42bd13",
                                "sense_id": "e9476816-033f-3862-b169-a4ae4ebf6099",
                                "text": "„Wir finden hier eine befriedigende Übereinstimmung, wenn man bedenkt, daß die Bodenatmung nicht nur allein durch den Biofaktor Mikrobengehalt, sondern als physiologischer Verbrennungsprozeß auch von der jeweiligen Temperatur und auch von dem jeweiligen biologischen Zustande der organischen Substanzen in dem Boden noch beeinflußt werden kann.“"
                            },
                            {
                                "example_id": "7454ddaa-a3a0-40b8-86bd-3264356bfbb5",
                                "sense_id": "e9476816-033f-3862-b169-a4ae4ebf6099",
                                "text": "„Dieser Faktor ist an erster Stelle zu beachten, wenn Untersuchungen angestellt werden, bei denen ein weiterer, ein Biofaktor wie der Regenwurm, in Beziehung zur Wasserkapazität gesetzt werden soll.“"
                            },
                            {
                                "example_id": "56732719-0baa-4628-b997-8612bf0ac477",
                                "sense_id": "e9476816-033f-3862-b169-a4ae4ebf6099",
                                "text": "„Aus dem jetzt Gesagten erhellt es nur zur Genüge, daß die Lebenstätigkeit der Bodenprotozoen nicht von einem Biofaktor, sondern von einem vollen Komplexe dieser Faktoren beeinflußt und geregelt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
