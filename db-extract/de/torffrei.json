                    },
                    {
                        "form_id": "147e6721-2468-4c4d-be01-976477aeb32a",
                        "entry_id": "f75201dc-3e85-3904-8bf9-99f3e624bfca",
                        "tags": [
                            "positive",
                            "predicative",
                            "singular",
                            "neuter"
                        ],
                        "form": "es ist torffrei"
                    },
                    {
                        "form_id": "7cb0bd6b-c7c3-4938-8147-bcea8ce556ee",
                        "entry_id": "f75201dc-3e85-3904-8bf9-99f3e624bfca",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind torffrei"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                        "entry_id": "f75201dc-3e85-3904-8bf9-99f3e624bfca",
                        "glosses": [
                            "ohne Torf (= ein faseriges, trockenes Material aus Mooren, das oft im Gartenbau eingesetzt wird), keinen Torf enthaltend"
                        ],
                        "tags": [
                            "Böden",
                            "Gärtnern"
                        ],
                        "examples": [
                            {
                                "example_id": "3ae0ff58-766f-4bd5-a800-076485ea3329",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Da ein grosser Anteil des Konsums privat ist, ist es wichtig, in seinem Garten auf torffreie Erde zu setzen.“"
                            },
                            {
                                "example_id": "7122b05c-1856-4878-9568-8d41eca7b29c",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Holzhäcksel eignen sich als Zusatz für torffreie Substratmischungen.“"
                            },
                            {
                                "example_id": "db379443-7ca5-4230-9dc1-ec29fa42577e",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Für torffreie Erden wird sehr oft ein buntes Gemisch von verschiedenen organischen Stoffen verwendet.“"
                            },
                            {
                                "example_id": "e0aa5cb6-4241-4511-a4dd-26acc6856152",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Torffreie Erde eignet sich für alle möglichen Gartenprojekte.“"
                            },
                            {
                                "example_id": "aa2fb82c-ea9a-4062-a956-b9b3b58e00cb",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Gärtnern mit torffreier Erde kann etwas mehr Aufwand bedeuten.“"
                            },
                            {
                                "example_id": "5eacd777-15ed-4fe8-ab3a-bb360d48dd2f",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "Torffreie Erden können häufig das Wasser schlechter speichern, als herkömmliche Erde."
                            },
                            {
                                "example_id": "1d847665-9d19-410d-8a27-b6dd17c5f18a",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Flüssigdünger ist bei den eher trockenen, torffreien Erden eine gute Alternative und kann ein- bis zweimal pro Woche mit dem Gießwasser ausgebracht werden.“"
                            },
                            {
                                "example_id": "5be8f3fe-665a-4ade-b495-a2a03a379468",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "[Schlagzeile:] „Darum solltest du torffreie Blumenerde kaufen“"
                            },
                            {
                                "example_id": "581de7b2-4142-4935-aabf-f58c33970613",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "[Schlagzeile:] „Warum torffreie Erde gut für die Umwelt ist“"
                            },
                            {
                                "example_id": "2d341989-b236-4d2a-a6fe-9d67dd3fa99e",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„An private Gärtner appelliert Bongartz, nur torffreie Erde zu kaufen.“"
                            },
                            {
                                "example_id": "cd55630b-a960-4ad8-8d91-67d25d7c623e",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "Man kann torffreie Komposterde leicht beim örtlichen Recyclinghof oder der örtlichen Abfallwirtschaftsstadion kaufen."
                            },
                            {
                                "example_id": "32ed0206-e402-4107-a72c-50cc511f14af",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Leider sind torffreie Erden noch immer etwas teurer und manchmal etwas schwieriger in der Handhabung, doch dafür steckt kein Stück zerstörtes Moor im Sack.“"
                            },
                            {
                                "example_id": "3ab3ecf7-d9bd-4566-b20a-9fc87672eedb",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Torffreie Erden sind teurer als herkömmliche Gartenerden mit Torf.“"
                            },
                            {
                                "example_id": "af7cfc59-6e34-4000-89d6-becb9d3c254d",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Wichtig ist, beim Erden-Kauf auf die Kennzeichnung „torffrei\" oder „ohne Torf“ zu achten. Nur diese Erden sind in der Regel tatsächlich torffrei!“"
                            },
                            {
                                "example_id": "b3c6af2a-0cb4-4582-8e7b-f8310725fa89",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Mittlerweile wird selbst im Discounter bereits torffreie Gartenerde auch für den Hobbygärtner angeboten.“"
                            },
                            {
                                "example_id": "59611833-7a91-4a0d-a30e-bc9ded6aec14",
                                "sense_id": "dd94302c-8cdd-333e-82ce-f2e2f0e64c7a",
                                "text": "„Kokosfasern werden aufgrund ihrer Feuchtebeständigkeit auch als Geotextilien für den Erosionsschutz und als torffreies Pflanzsubstrat im Gartenbau, vor allem in der Hydroponik, verwendet,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
