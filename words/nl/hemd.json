            "senses": [
                {
                    "sense_id": "b7de3e4a-23fc-316d-885f-62a2bc58bac4",
                    "sense_definition": "Een kledingstuk voor het bovenlichaam, meestal met knopen en een kraag.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij draagt elke dag een schoon wit <w>hemd</w> naar zijn werk.",
                            "target_lang_translations": {
                                "en": "He wears a clean white <w>shirt</w> to work every day."
                            }
                        },
                        {
                            "text": "Vergeet niet om de strijken voordat je dat <w>hemd</w> aantrekt.",
                            "target_lang_translations": {
                                "en": "Don't forget to iron before you put on that <w>shirt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "overhemd"
                    ],
                    "common_phrases": [
                        "wit hemd",
                        "hemd met knopen"
                    ],
                    "target_lang_definitions": {
                        "en": "A garment for the upper body, usually with buttons and a collar."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shirt",
                                "target_lang_sense_clarification": "general upper body garment"
                            },
                            {
                                "target_lang_word": "dress shirt",
                                "target_lang_sense_clarification": "formal or button-down shirt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fcf8227-77f9-340e-a45e-e64353b3f284",
                    "sense_definition": "Een mouwloos kledingstuk dat direct op de huid onder andere kleding wordt gedragen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderkleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter draag ik altijd een extra <w>hemd</w> onder mijn trui.",
                            "target_lang_translations": {
                                "en": "In the winter I always wear an extra <w>undershirt</w> under my sweater."
                            }
                        },
                        {
                            "text": "Het kind liep alleen in zijn <w>hemd</w> door de tuin.",
                            "target_lang_translations": {
                                "en": "The child walked through the garden in only his <w>undershirt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderhemd",
                        "singlet"
                    ],
                    "common_phrases": [
                        "onder het hemd",
                        "katoenen hemd"
                    ],
                    "target_lang_definitions": {
                        "en": "A sleeveless garment worn directly on the skin under other clothing."
                    },
                    "translations": {
