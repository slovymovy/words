                ],
                "senses": [
                    {
                        "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                        "entry_id": "e0b4fbce-8af3-3210-a1a9-9edae7aff84d",
                        "glosses": [
                            "das Verbrennen (meist um Wärme, Dampf oder elektrische Energie zu erzeugen)"
                        ],
                        "tags": [
                            "meist im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "fa501627-12cf-4dcd-8342-6619024ff1bc",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Derzeit wird Fernwärme laut AGFW zwar noch zu 70 Prozent mit der Verfeuerung von Kohle oder Erdgas gewonnen, aber sie könnte deutlich klimafreundlicher werden.“"
                            },
                            {
                                "example_id": "f6fba604-3bb2-405a-887b-a0dc656095f3",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Die Klimaerwärmung ist vor allem eine Folge der Verfeuerung fossiler Energieträger zur Energiegewinnung.“heise.de"
                            },
                            {
                                "example_id": "766c028b-a53c-49d4-8f9d-ca67179ec7f6",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Irgendwann soll ja auch Wärme nicht mehr durch Verfeuerung fossiler Brennstoffe erzeugt werden,“ […]."
                            },
                            {
                                "example_id": "5136aaa9-c51e-4ca4-ac4e-71a1ebff1d94",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "[Kanonenofen:] „Aufgrund der Konstruktion sind solche Öfen meist für die Verfeuerung von Kohle ausgelegt, es können aber auch andere feste Stoffe wie Holz oder Torf verbrannt werden.“"
                            },
                            {
                                "example_id": "b33b3c23-f583-43b4-bdf3-5e4c1f8dace2",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Das Kraftwerk hat im April 2014 als letztes die Verfeuerung von Kohle zur Stromerzeugung eingestellt.“"
                            },
                            {
                                "example_id": "be59cc8e-23a7-41bc-b0cd-2d0d491ddf9c",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Das Heizkraftwerk Tiefstack soll durch verschiedene klimaneutrale Wärmelösungen ersetzt werden. Und auch die Verfeuerung von Erdgas und Holz gehören zum Konzept.“"
                            },
                            {
                                "example_id": "54a0f839-83f3-404d-bf76-a3e29a37c4a0",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Nach Daten des Bundes für Umwelt und Naturschutz (BUND) entsteht bei der Verfeuerung von einer Tonne Rohbraunkohle etwa eine Tonne CO2.“"
                            },
                            {
                                "example_id": "db1b5161-2fbf-4f0b-9f67-7e97b131a022",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Da anders als bei Verfeuerung von Holz oder Kohle keine Asche abtransportiert werden muss, galten Ölöfen vor allem in den 1950er und 60er Jahren als komfortable Alternative zu den bisher üblichen Öfen und wurden in vielen Gebäuden aufgestellt.“"
                            },
                            {
                                "example_id": "cd682621-ffa9-4eed-a562-062d00f1e0e6",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Ab 1985 wurden in Schweden getrocknete Holzpellets zur Befeuerung von Kraftwerken eingesetzt, weil Transport und Verfeuerung nasser Holzspäne zu teuer gekommen wäre.“"
                            },
                            {
                                "example_id": "4eacd659-260f-4143-a799-fd21cdd7c61c",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "[Wärmekraftwerke:] „Aufgrund der niedrigeren Beschaffungskosten ist die Verfeuerung von Braunkohle wirtschaftlich trotzdem konkurrenzfähig.“"
                            },
                            {
                                "example_id": "ab42bfb3-a6d1-4d6a-bf54-8cfc73d38224",
                                "sense_id": "e055bd16-d669-336c-92b3-0e13c03bda7b",
                                "text": "„Im Jahr 2017 beschloss das Land Berlin den Kohleausstieg und beendete im selben Jahr die Nutzung der als besonders klimaschädlich geltenden Braunkohle, indem das Heizkraftwerk Klingenberg und das Heizkraftwerk an der Markgrafenstraße auf die Verfeuerung von Erdgas umgestellt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
