                "senses": [
                    {
                        "sense_id": "4d36e498-0d7a-3466-bf6b-a70c07697ad9",
                        "entry_id": "ad40fecc-6d50-3c5c-b3d3-b234de9d18df",
                        "glosses": [
                            "Qui porte des veinules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a14ef76-167c-4c0e-9510-89c28fae1326",
                                "sense_id": "4d36e498-0d7a-3466-bf6b-a70c07697ad9",
                                "text": "Il ne s’effrayait ni des yeux révulsés dont n’apparaissait que le blanc veinulé, entre les paupières en sang, ni de la bouche tordue, ni, autour du menton, de l’étrange barbe adolescente."
                            },
                            {
                                "example_id": "fcf97e35-12ea-48cc-a303-8663d4f4f7e7",
                                "sense_id": "4d36e498-0d7a-3466-bf6b-a70c07697ad9",
                                "text": "Il trône debout, sa barbe s’allonge jusqu’au milieu de sa poitrine qu’enserre un corset moulant, sa tunique de bois veinulé s’évase, formant socle."
                            },
                            {
                                "example_id": "dbd8a773-b3ae-474f-a7b3-b0a7f6b3e7e5",
                                "sense_id": "4d36e498-0d7a-3466-bf6b-a70c07697ad9",
                                "text": "Les mains amaigries, veinulées, vieilles amies fidèles, désoeuvrées sur le tissu."
                            }
                        ]
                    }
                ],
