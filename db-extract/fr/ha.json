                ],
                "senses": [
                    {
                        "sense_id": "405d751e-94cd-3801-85d9-5ecc19e2537f",
                        "entry_id": "93e93632-2090-3a5f-9510-2c241317aba7",
                        "glosses": [
                            "Autre nom du requin perlon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4abc091e-5015-4ee4-ab8d-e3dc22d3de72",
                                "sense_id": "405d751e-94cd-3801-85d9-5ecc19e2537f",
                                "text": "Ha : requin comestible."
                            },
                            {
                                "example_id": "672027de-563b-4c60-bdd7-09b6949e4495",
                                "sense_id": "405d751e-94cd-3801-85d9-5ecc19e2537f",
                                "text": "Has ; espèce de chien de mer que les pauvres font sécher pour l'hiver."
                            },
                            {
                                "example_id": "6591c432-2dfb-4a6c-81ad-adc5f50cd2d5",
                                "sense_id": "405d751e-94cd-3801-85d9-5ecc19e2537f",
                                "text": "Selon les régions, les roussettes, les has (de petite taille), les émissoles et les aiguillats sont presque toujours après leur écorchage dénommés «saumonettes» dans les poissonneries. Les has de grande taille sont traités en tronçons."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a1bcb6e4-7a4c-3f44-9031-d53988348a9c",
                "word": "ha",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "81bcc76d-05b0-4420-a189-f639808a8103",
                        "entry_id": "a1bcb6e4-7a4c-3f44-9031-d53988348a9c",
                        "tags": [
                            "plural"
                        ],
                        "form": "has"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f86a827-6e11-318b-9b62-2fd0639874c3",
                        "entry_id": "a1bcb6e4-7a4c-3f44-9031-d53988348a9c",
                        "glosses": [
                            "Cri d'une syllabe qu'on fait la bouche ouverte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b3dde36-0a45-4caa-8cc1-21aba60950dd",
                                "sense_id": "9f86a827-6e11-318b-9b62-2fd0639874c3",
                                "text": "On s’écria, se récria, on fit des ho ! on fit des ha ! On pâma d’admiration."
                            },
                            {
                                "example_id": "da66f065-e96b-49ee-bf39-ffde74919fda",
                                "sense_id": "9f86a827-6e11-318b-9b62-2fd0639874c3",
                                "text": "Cauchemar d'où il se réveillera avec un « Ha » caverneux... Assis, les yeux comme des assiettes, la bouche ouverte, aveugle et muet, stupéfait de ce qu'il aura vu en rêve..."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b210c109-50ae-32a9-b8bf-2a0a230b7a3f",
                "word": "ha",
                "pos": "onomatopoeia",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1add5ba-9f8f-4194-8a7d-51a79d3b6a07",
                        "entry_id": "b210c109-50ae-32a9-b8bf-2a0a230b7a3f",
