                        "examples": [
                            {
                                "example_id": "6734b110-8ba7-484b-8f20-95037c6c67a0",
                                "sense_id": "0d79c423-16da-3110-8801-8d9b1cb1abdc",
                                "text": "Hitler overleefde de bomaanslag in München omdat hij enkele minuten voor de explosie uit de bierhal vertrok. Enkele andere mensen kwamen wel om het leven. Elser werd na jaren hechtenis in 1945 in een concentratiekamp vermoord."
                            },
                            {
                                "example_id": "3b2db5c8-b957-4604-a6f4-d55ab9d62b4d",
                                "sense_id": "0d79c423-16da-3110-8801-8d9b1cb1abdc",
                                "text": "Bezoekers kwamen traditioneel gekleed in dirndls en lederhosen op het evenement af. De hal was omgetoverd tot een bierhal in Beierse sferen. Alle duizend kaarten voor het feest waren uitverkocht. Bezoekers uit heel Twente en zelfs uit Duitsland kwamen op de Twentse versie van het bierfeest af."
                            }
                        ]
