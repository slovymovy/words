    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f502437c-a8ad-3d30-80b7-1d7850b8d28f",
                    "sense_definition": "Voorwerp in een halve cirkelvorm dat men met de hand beweegt om koele lucht toe te wuiven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waaier_voorwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op deze hete zomerdag gebruikt zij een prachtige <w>waaier</w> om wat verkoeling te krijgen.",
                            "target_lang_translations": {
                                "fr": "En cette chaude journée d'été, elle utilise un magnifique <w>éventail</w> pour se rafraîchir un peu."
                            }
                        },
                        {
                            "text": "Met dit warme weer worden veel <w>waaiers</w> op de markt verkocht.",
                            "target_lang_translations": {
                                "fr": "Par ce temps chaud, beaucoup d'<w>éventails</w> se vendent sur le marché."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Objet pliable ou rigide en demi-cercle que l'on agite à la main pour se rafraîchir."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "éventail",
                                "target_lang_sense_clarification": "accessoire pour s'éventer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9ed731b-f017-3c5a-a07e-9e0fd24b3772",
                    "sense_definition": "Iets wat de vorm of spreiding van een waaier heeft, vaak figuurlijk gebruikt voor een breed scala of aanbod.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waaier_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De universiteit biedt een brede <w>waaier</w> aan interessante opleidingen en cursussen aan.",
                            "target_lang_translations": {
                                "fr": "L'université propose un large <w>éventail</w> de formations et de cours intéressants."
                            }
                        },
                        {
                            "text": "De pauw toonde trots zijn prachtige staart in de vorm van een <w>waaier</w>.",
                            "target_lang_translations": {
                                "fr": "Le paon montrait fièrement sa queue magnifique en forme d'<w>éventail</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scala",
                        "spectrum"
                    ],
                    "common_phrases": [
                        "een brede waaier aan"
                    ],
                    "target_lang_definitions": {
                        "fr": "Chose ayant la disposition déployée d'un éventail, ou figurativement une large gamme, palette ou variété de choix."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "éventail",
                                "target_lang_sense_clarification": "large gamme ou forme déployée"
                            },
                            {
                                "target_lang_word": "gamme",
                                "target_lang_sense_clarification": "choix varié ou série"
                            },
                            {
                                "target_lang_word": "palette",
                                "target_lang_sense_clarification": "ensemble diversifié"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5e29e73-fe94-3574-a8f2-c30681c903c9",
                    "sense_definition": "Iemand die iemand anders wind toewaait.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning liet zich tijdens de plechtigheid vergezellen door een trouwe <w>waaier</w>.",
