                "senses": [
                    {
                        "sense_id": "5578d0bc-25f7-3dbf-b792-f014cc1097da",
                        "entry_id": "0c407db2-6172-3de8-b4c5-bcc5a5978183",
                        "glosses": [
                            "kürzeste festgelegte Zeitspanne, in der eine Arbeitskraft arbeiten muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd67dc0b-6d74-4184-b2d9-7fcb9c7a82af",
                                "sense_id": "5578d0bc-25f7-3dbf-b792-f014cc1097da",
                                "text": "„Es gibt eine Mindestarbeitszeit von 15 Wochenstunden, die für den Jahresdurchschnitt gelten und verhindern sollen, dass die Pflegenden ihre Arbeit vollständig niederlegen.“"
                            },
                            {
                                "example_id": "31058cdf-8e51-46ee-a5b4-286f3db32a66",
                                "sense_id": "5578d0bc-25f7-3dbf-b792-f014cc1097da",
                                "text": "„Die IG BAU wäre zwar grundsätzlich mit flexibleren Arbeitszeiten und Arbeitszeitkonten einverstanden, verlangt aber ‚klar definierte Höchst- und Mindestarbeitszeiten‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
