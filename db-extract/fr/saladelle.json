                "forms": [
                    {
                        "form_id": "acc7ba33-e755-4954-be71-050002ab8a9b",
                        "entry_id": "d708d531-eae0-302c-8702-ff17689f6516",
                        "tags": [
                            "plural"
                        ],
                        "form": "saladelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb869e30-44a1-3101-8ab8-6751b82fdf2e",
                        "entry_id": "d708d531-eae0-302c-8702-ff17689f6516",
                        "glosses": [
                            "Nom vernaculaire d'une cinquantaine de plantes du genre Limonium, comme par exemple:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beb3411b-93e5-41f4-83b7-27b677e82a2a",
                                "sense_id": "bb869e30-44a1-3101-8ab8-6751b82fdf2e",
                                "text": "Des bruyères poussent sur le talus, des saladelles, des limoniums et des lavandes de mer, d’un bleu magnifique."
                            },
                            {
                                "example_id": "c91199f7-637b-4c31-aac9-ceb823c9177f",
                                "sense_id": "bb869e30-44a1-3101-8ab8-6751b82fdf2e",
                                "text": "la saladelle commune (Limonium vulgare) ou lavande de mer, halophile (adaptée aux prés salés)"
                            },
                            {
                                "example_id": "3668ef06-828f-47e8-ad04-ab3f7e72bc79",
                                "sense_id": "bb869e30-44a1-3101-8ab8-6751b82fdf2e",
                                "text": "la saladelle de Narbonne ou statice de Narbonne (Limonium narbonense), autre halophile aux belles inflorescences bleu lavande"
                            },
                            {
                                "example_id": "d7091bca-c475-4656-a7bd-da5b0825b2f1",
                                "sense_id": "bb869e30-44a1-3101-8ab8-6751b82fdf2e",
                                "text": "la saladelle à rameaux raides (Limonium strictissimum), etc."
                            },
                            {
                                "example_id": "63a180d0-4f72-4a1a-87a4-796e78f6925c",
                                "sense_id": "bb869e30-44a1-3101-8ab8-6751b82fdf2e",
                                "text": "C'est une joie dont il veut mâcher toute l’odeur et saliver longtemps le jus comme un mouton qui mange la saladelle du soir sur les collines. Il va, comme ça, jusqu’au moment où le beau silence s’est épaissi en lui et autour de lui comme un pré."
                            },
                            {
                                "example_id": "48e539df-1b53-47d9-952a-53a57a954f9a",
                                "sense_id": "bb869e30-44a1-3101-8ab8-6751b82fdf2e",
                                "text": "Des centaurées, des trèfles d’eau, des gentianes, et ces jolies saladelles bleues en hiver, rouges en été, qui transforment leur couleur au changement d’atmosphère, et dans une floraison ininterrompue marquent les saisons de leurs tons divers."
                            }
                        ]
                    }
                ],
