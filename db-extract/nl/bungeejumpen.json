                "senses": [
                    {
                        "sense_id": "b9dcad28-c6ce-3fd8-9fd5-6cf049a187d3",
                        "entry_id": "29083f50-f0d6-3a70-a862-63c32e74acf5",
                        "glosses": [
                            "als vermaak van een hoog object springen, waarbij de voeten aan een elastisch koord vastzitten dat precies zo lang is, dat men de grond niet raakt"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "da757d2f-25a7-481b-86b6-2a186024ad64",
                                "sense_id": "b9dcad28-c6ce-3fd8-9fd5-6cf049a187d3",
                                "text": "Lotte van der Hout houdt het bij vakanties met haar vriend. „Sommige mensen vinden het heel raar dat ik niet wil reizen. Maar ik hoef niet per se op wereldreis of te bungeejumpen ‘omdat het kan’. Dat het kan betekent voor mij niet zoveel. Ik ben liever wat langer op één plek.”"
                            }
                        ]
                    }
                ],
