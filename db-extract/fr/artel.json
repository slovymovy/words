                                        "entry_id": "e8cf480f-f073-3de3-970e-43d51a26d19d",
                                        "glosses": [
                                            "A Russian or Soviet craftsmen's collective."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73f35005-a09e-43f7-a247-b2602784511e",
                                                "sense_id": "edad2f3c-7b3b-3e76-98b1-3774f14bb6ee",
                                                "text": "This essentially urban lifestyle, modelled on the factory artel, did much to alienate the local peasantry […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "835e390c-0c81-4a7c-8df3-ad6a62daabd9",
