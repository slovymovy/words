                "senses": [
                    {
                        "sense_id": "de0490db-b6e6-3a4e-b5e8-060b2d33b30c",
                        "entry_id": "84c36da4-1174-3f59-8003-a51295977f27",
                        "glosses": [
                            "Ausgangslage, bei der alle Beteiligten einen Vorteil erzielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31f0d124-a220-4d71-a1db-a05491830251",
                                "sense_id": "de0490db-b6e6-3a4e-b5e8-060b2d33b30c",
                                "text": "„Eine gemeinschaftliche öffentliche Wasser- und Abwasserversorgung ist eine Win-win-Situation für alle.“"
                            },
                            {
                                "example_id": "2db9601f-4ca0-4f1e-b665-f2d94bb2a488",
                                "sense_id": "de0490db-b6e6-3a4e-b5e8-060b2d33b30c",
                                "text": "„Das Ergebnis war die klassische Win-win-Situation.“"
                            },
                            {
                                "example_id": "5d4efaad-c5dc-4b24-9b8f-c7dc356c9f04",
                                "sense_id": "de0490db-b6e6-3a4e-b5e8-060b2d33b30c",
                                "text": "„Der Tausch war eine Win-win-Situation, wie man heute sagen würde: Er fand zur beiderseitigen Zufriedenheit statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
