                ],
                "senses": [
                    {
                        "sense_id": "907d8e90-8329-3162-93c1-45fba23fa317",
                        "entry_id": "a1070497-bd87-3328-8294-98ac8a7c1ae0",
                        "glosses": [
                            "Denken, Verstand"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9e47cffa-bddd-47f4-b22b-4e0e572c7183",
                                "sense_id": "907d8e90-8329-3162-93c1-45fba23fa317",
                                "text": "Dieses Rätsel ist nicht leicht zu lösen, man muss einiges an Gehirnschmalz reinstecken."
                            },
                            {
                                "example_id": "8f52409c-aec8-4f62-b6dd-ee2a2b9a5f44",
                                "sense_id": "907d8e90-8329-3162-93c1-45fba23fa317",
                                "text": "„Es wird auch in Deutschland viel Gehirnschmalz brauchen, um herauszufinden, wie man in Zukunft wettbewerbsfähig bleiben kann.“"
                            },
                            {
                                "example_id": "29f4808e-9b34-4f53-ae95-b8b864500562",
                                "sense_id": "907d8e90-8329-3162-93c1-45fba23fa317",
                                "text": "Die Idee, Lebensmittel lose zu verkaufen, brachte die Geografin [Hilke Deinet] vor ein paar Jahren aus Australien mit, wo es ähnliche Läden bereits gab. „Irgendwann hatten wir beide so viel Gehirnschmalz in die Umsetzung investiert, dass wir dachten, jetzt müssen wir es einfach ausprobieren.“"
                            },
                            {
                                "example_id": "56e9c751-863e-41aa-96b5-f8cb613f3b34",
                                "sense_id": "907d8e90-8329-3162-93c1-45fba23fa317",
                                "text": "[…] unsere ersten Vorfahren haben erst als Zweibeiner so richtig Gehirnschmalz bekommen. Geht Denken also eigentlich nur in Bewegung?"
                            },
                            {
                                "example_id": "bc9819f3-d526-4c15-be11-b23ca2ec66c2",
                                "sense_id": "907d8e90-8329-3162-93c1-45fba23fa317",
                                "text": "Es gebe Instrumente für den Ein- und Austritt von Ländern, da müsse es auch welche geben, um Autonomiebestrebungen zu ermöglichen. „Da müssen wir noch’n bisschen Gehirnschmalz reinstecken“, sagte Schulz im Deutschlandfunk."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
