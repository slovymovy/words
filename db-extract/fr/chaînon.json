                    },
                    {
                        "sense_id": "b8ed3d35-7308-3d89-956e-8e1460fe9b8c",
                        "entry_id": "b94e30b9-f46e-3e08-9e05-d174a962e73f",
                        "glosses": [
                            "Chaîne de basses montagnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d5bf793-5f21-4c3a-812e-c7135a75fbe8",
                                "sense_id": "b8ed3d35-7308-3d89-956e-8e1460fe9b8c",
                                "text": "Dans les Pyrénées, la présence de végétaux propéméditerranéens est très fréquente le long des chaînons calcaires du Planturel et vers les Petites Pyrénées."
                            }
                        ]
                    }
                ],
