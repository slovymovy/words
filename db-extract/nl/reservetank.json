                        "glosses": [
                            "vat waarin brandstof zit die men kan gebruiken als de hoofdtank (per ongeluk) leeg is geraakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0849b863-b2dc-4e6f-8720-cebd13ee241c",
                                "sense_id": "7f8a068b-9ef1-3a60-8127-1de073c47c77",
                                "text": "Een reservetank moet altijd vol zijn."
                            },
                            {
                                "example_id": "9eddd498-24a2-4a2c-8c7c-72f8907d6f9f",
                                "sense_id": "7f8a068b-9ef1-3a60-8127-1de073c47c77",
                                "text": "De brandstofpomp van de auto was kapot. De monteur had daarom van een handbediende hogedrukspuit een handpomp gemaakt met een reservetank. De brandstof liep via een slang door het portierraampje naar de motor. Zijn vrouw moest continu pompen zodat hij kon blijven rijden."
                            }
                        ]
                    }
