                    {
                        "translation_id": "3555e26f-80e2-49cf-be1b-3f2cb4cdef34",
                        "source_entry_id": "46b29e90-b5fd-3477-bdcb-283a78519c96",
                        "source_sense_id": "aa77bed6-fa6c-3fff-ab11-d7a2f16e0ff0",
                        "source_sense_description": "Gebirgskette in Süd- und Zentralfrankreich",
                        "target_lang_word": "Cévennes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cévennes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64536d52-f120-35c6-a819-2f182edfbc4b",
                                        "entry_id": "e8d372b4-724c-3694-901f-94e35c23b90e",
                                        "glosses": [
                                            "Région naturelle du sud-est de la France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb83427-a334-4307-8aed-cd3968f10218",
                                                "sense_id": "64536d52-f120-35c6-a819-2f182edfbc4b",
                                                "text": "Dans les Cévennes, la magnanerie est en général un bâtiment à deux étages."
                                            },
                                            {
                                                "example_id": "56dfe4b2-de82-4858-a7dc-58885790cda7",
                                                "sense_id": "64536d52-f120-35c6-a819-2f182edfbc4b",
                                                "text": "La famille de CALBIAC, originaire des Cévennes, et connue dans le pays d’Agénais depuis plus de deux cents ans, a fourni dans tous les temps des officiers aux armées de nos rois."
                                            },
                                            {
                                                "example_id": "4f4741e1-23b8-4b52-bdd6-3c40869b1fe9",
                                                "sense_id": "64536d52-f120-35c6-a819-2f182edfbc4b",
                                                "text": "Ces pelouses particulièrement riches en espèces méditerranéo-montagnardes constituent une magnifique parure de notre montagne. Elles font partie de l'alliance de l’Ononidion striatae connue surtout dans les Cévennes."
                                            },
                                            {
                                                "example_id": "e480ce8c-2f89-421d-ba58-85be24267034",
                                                "sense_id": "64536d52-f120-35c6-a819-2f182edfbc4b",
                                                "text": "En Cévennes, comme partout dans l’Hexagone, le repli des activités pastorales provoquera l’enfrichement et la dégradation des habitats d'une kyrielle d'autres espèces."
                                            }
                                        ]
                                    }
                                ]
                            }
