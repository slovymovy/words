                ],
                "senses": [
                    {
                        "sense_id": "d49b75bf-8286-37a8-9ecf-b842f329ff55",
                        "entry_id": "8a37d6ac-90f1-324e-8fa5-a4573a2022c7",
                        "glosses": [
                            "Person, die im Müll nach verwertbaren Stoffen sucht und davon ihren Lebensunterhalt bestreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be04934d-f952-4b10-8850-486bbe7e27ee",
                                "sense_id": "d49b75bf-8286-37a8-9ecf-b842f329ff55",
                                "text": "Mancher Müllsucher lebt am Müllberg und versorgt gar seine Familie mit gefunden Sachen oder verkauft diese um den Lebensunterhalt sicher zu stellen."
                            },
                            {
                                "example_id": "ad9d8a59-803c-46e8-b83c-066621e96b5c",
                                "sense_id": "d49b75bf-8286-37a8-9ecf-b842f329ff55",
                                "text": "„Das Phänomen des Müllsuchers beschränkt sich nicht auf Afrika allein, sondern ist überall in der Dritten (aber auch der Zweiten) Welt zu Hause.“"
                            },
                            {
                                "example_id": "9bdf619f-1e28-493c-b518-a52d40af637e",
                                "sense_id": "d49b75bf-8286-37a8-9ecf-b842f329ff55",
                                "text": "„Mit dem Ausdruck Müllsucher werden Menschen vor allem in der dritten Welt bezeichnet, die von, in und mit dem Müll leben, den sie sammeln, recyceln oder verkaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98feec53-168a-3e6b-8d1b-e1dc95365dc3",
                        "entry_id": "8a37d6ac-90f1-324e-8fa5-a4573a2022c7",
                        "glosses": [
                            "freiwilliger Helfer, der Müll aufspürt, birgt und zur ordentlichen Entsorgung bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b46a82da-c2a0-451b-aea8-420c65eee946",
                                "sense_id": "98feec53-168a-3e6b-8d1b-e1dc95365dc3",
                                "text": "„Ihre feuerroten Paddel fest im Griff, Müllbeutel zwischen den Knien und einen Holzpflock zum Aufspießen zogen am Sonnabend wieder die Müllsucher los, um den Landgraben von Unrat zu befreien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
