                "senses": [
                    {
                        "sense_id": "bb570e1e-3477-3125-a333-4da6ba3ccd26",
                        "entry_id": "093142f2-391c-3874-8224-ce8622985f34",
                        "glosses": [
                            "Einrichtung zum Befreien von Läusen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dfe72c7-366e-4563-bc0e-ecfc6f04d92c",
                                "sense_id": "bb570e1e-3477-3125-a333-4da6ba3ccd26",
                                "text": "„Altbekannte Orte tauchen auf. Brest-Litowsk, wo es hinter der Entlausungsanstalt wieder die ersten Läuse gibt.“"
                            },
                            {
                                "example_id": "7e563991-e7c8-401f-8444-839c384ad52e",
                                "sense_id": "bb570e1e-3477-3125-a333-4da6ba3ccd26",
                                "text": "„In der Folge der 1941 ausgebrochenen Epidemie wurde das gesamte Lager unter Quarantäne gestellt. In den ersten sechs Wochen wurden durch die Lagerverwaltung keine nennenswerten Schritte zur Überwindung der Epidemie unternommen. Später wurden der Duschraum und die Entlausungsanstalt fertig gestellt.“"
                            },
                            {
                                "example_id": "77e99a17-3000-4812-b762-7ed58b62f54f",
                                "sense_id": "bb570e1e-3477-3125-a333-4da6ba3ccd26",
                                "text": "„Anstatt zu den Kindern zu eilen, suchte sie erst die örtliche »Entlausungsanstalt« auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
