    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e25401fe-df52-307f-9cea-8973cfbbc300",
                    "sense_definition": "Слабо, без блеска, неярко.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В комнате <w>тускло</w> горела старая лампа.",
                            "target_lang_translations": {
                                "en": "An old lamp was burning <w>dimly</w> in the room."
                            }
                        },
                        {
                            "text": "Звёзды <w>тускло</w> мерцали в ночном небе.",
                            "target_lang_translations": {
                                "en": "The stars were <w>faintly</w> twinkling in the night sky."
                            }
                        }
                    ],
                    "synonyms": [
                        "неярко",
                        "слабо"
                    ],
                    "antonyms": [
                        "ярко"
                    ],
                    "common_phrases": [
                        "тускло светить",
                        "тускло гореть"
                    ],
                    "target_lang_definitions": {
                        "en": "Weakly, without shine, dimly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dimly",
                                "target_lang_sense_clarification": "describing light that is not bright"
                            },
                            {
                                "target_lang_word": "faintly",
                                "target_lang_sense_clarification": "describing light or appearance that is weak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "446af3af-3aae-3967-8a01-4a2af4b9bac6",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>тусклый</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Освещение в коридоре было <w>тускло</w>.",
                            "target_lang_translations": {
                                "en": "The lighting in the hallway was <w>dull</w>."
                            }
                        },
                        {
                            "text": "Небо сегодня выглядит <w>тускло</w> и серо.",
                            "target_lang_translations": {
                                "en": "The sky looks <w>dull</w> and gray today."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective 'dull' (neuter singular)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "lacking brightness or vividness"
                            },
                            {
                                "target_lang_word": "dim",
                                "target_lang_sense_clarification": "not shining brightly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
