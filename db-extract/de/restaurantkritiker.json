                "senses": [
                    {
                        "sense_id": "2c879a64-e3c5-359d-b7f9-e2cbf0a11e82",
                        "entry_id": "116e5c33-6791-336d-808a-4f0a5871625b",
                        "glosses": [
                            "Person, die Restaurants bewertet und rezensiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2510abb-092e-42fc-a1f4-ffdf2e307f09",
                                "sense_id": "2c879a64-e3c5-359d-b7f9-e2cbf0a11e82",
                                "text": "„Als Eli seiner Mutter während der Sommerferien sagte, er wolle Restaurantkritiker werden, riet sie ihm, es doch erstmal mit einem Blog zu versuchen.“"
                            },
                            {
                                "example_id": "9adb32af-9720-40c4-8521-d9f531172569",
                                "sense_id": "2c879a64-e3c5-359d-b7f9-e2cbf0a11e82",
                                "text": "„ Er hat das Bild an die Wand neben der Eingangstür gehängt, dort wo schon Rudolph Giuliani hing, die Jungs von den Sopranos, der Besitzer der New York Giants und die drei Sterne, die das Steakhouse vom Restaurantkritiker der \"New York Times\" bekommen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
