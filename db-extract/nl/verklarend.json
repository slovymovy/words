                                            {
                                                "example_id": "754cc751-4352-404c-b344-868223e7d580",
                                                "sense_id": "322563f2-7e4a-3fd7-b677-3fb91de23eeb",
                                                "text": "Then after that process which Culverwel describes as so many strainings, refinings, and clarifyings, the mind is prepared for a true insight into the real nature of the world by way of intuition."
                                            }
                                        ]
                                    }
                                ]
                            },
