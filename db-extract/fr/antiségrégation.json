                                "example_id": "6bccb092-121f-4792-baee-2e54739b07cc",
                                "sense_id": "d38a555b-f842-3c13-8940-f029145aa374",
                                "text": "Si la trémie comporte une échelle antiségrégation, elle freinera les mouvements et jouera aussi en diminuant la ségrégation à la vidange."
                            },
                            {
                                "example_id": "2da5ac02-7b23-46f2-aae4-daca3d823845",
                                "sense_id": "d38a555b-f842-3c13-8940-f029145aa374",
                                "text": "Toutes ces opérations anti-isolement, antihospice, antiségrégation se font dans un climat de gentillesse, mais Tabernacle ! — comme on dit ici — il ne s’agit plus de laisser les vieux s’encroûter ni se gaver de potions et de pilules."
                            },
                            {
                                "example_id": "57b4993e-ac7a-4851-9f4f-b85c3863f84b",
                                "sense_id": "d38a555b-f842-3c13-8940-f029145aa374",
                                "text": "La Californie abolit la loi antiségrégation."
                            }
                        ]
