                                "sense_id": "3b08e7f4-6566-3019-a7e2-272b87c75f49",
                                "text": "De uitbarsting heeft vulkanologen verrast."
                            },
                            {
                                "example_id": "1bd09e47-0a49-40f4-812f-274befe6701d",
                                "sense_id": "3b08e7f4-6566-3019-a7e2-272b87c75f49",
                                "text": "De politie houdt de groep in de gaten om niet verrast te worden door een gewelddadige actie."
                            },
                            {
                                "example_id": "d1794dfd-b3f4-4de3-888b-9713fa229e37",
                                "sense_id": "3b08e7f4-6566-3019-a7e2-272b87c75f49",
                                "text": "De minister is onaangenaam verrast door de cijfers"
                            },
                            {
                                "example_id": "fbaeb655-fe65-424a-a62a-9ad58c7a171f",
                                "sense_id": "3b08e7f4-6566-3019-a7e2-272b87c75f49",
                                "text": "Ik was verrast en blij om te zien hoeveel mensen hierop reageerden, waardoor binnen twee weken mijn streefdoel van 4.286 dollar was behaald."
                            },
                            {
                                "example_id": "a8af04c9-9f60-4352-a5f4-615af8f8ddae",
                                "sense_id": "3b08e7f4-6566-3019-a7e2-272b87c75f49",
                                "text": "Ze is niet verrast dat er al bezoekers op het eetterras zitten en zelfs niet dat ze vandaag blijkbaar hulp krijgt van een goedmoedige Nederlandse assistent, maar mijn tranen verbazen haar wel."
                            },
                            {
                                "example_id": "4fe540a6-2b6c-4bb2-b653-320a3e0ca39a",
                                "sense_id": "3b08e7f4-6566-3019-a7e2-272b87c75f49",
                                "text": "Lot was aangenaam verrast geweest."
                            }
                        ]
                    }
