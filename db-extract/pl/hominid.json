                    {
                        "translation_id": "009edf6f-8296-4572-b380-4ffc0de775ef",
                        "source_entry_id": "2c2da790-a108-3415-85ae-098239f742ca",
                        "source_sense_id": "33e54336-bcd1-328c-b455-2c99da8abcb9",
                        "target_lang_word": "hominid",
