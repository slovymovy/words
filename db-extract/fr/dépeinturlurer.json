                "senses": [
                    {
                        "sense_id": "636475e6-ceb0-3e79-9bc6-a70fc25261b4",
                        "entry_id": "cc0316da-25cc-3de4-8af9-1c636d1de36b",
                        "glosses": [
                            "Enlever ce qui peinturlurait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "028cd8d0-b626-4402-becd-b516d4cd9d87",
                                "sense_id": "636475e6-ceb0-3e79-9bc6-a70fc25261b4",
                                "text": "La nef de Saint- Germain-des-Prés, grâce aux fresques de Flandrin, ne fut pas dépeinturlurée comme le chœur."
                            },
                            {
                                "example_id": "e0e6aef6-1a50-4cba-8a3f-0b659d4d4d45",
                                "sense_id": "636475e6-ceb0-3e79-9bc6-a70fc25261b4",
                                "text": "(...) à dépeinturlurer les bric-à-brac que ton mari m'a achetés il ya trois ans et que j'ai sortis de l'ombre pour les montrer à MVH qui ne les connaissait pas."
                            },
                            {
                                "example_id": "36a9a476-bc92-485b-a848-3cf5a4b0fee6",
                                "sense_id": "636475e6-ceb0-3e79-9bc6-a70fc25261b4",
                                "text": "Tandis que l’eau coulait, je me suis dépeinturluré le visage."
                            }
                        ]
                    }
