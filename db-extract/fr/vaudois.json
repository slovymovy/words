                    {
                        "translation_id": "445eb786-d7a9-44a3-9ffd-2e0ac572729d",
                        "source_entry_id": "4773403a-2dc3-3e26-b1b7-9fcd5de50a77",
                        "source_sense_id": "ffeea40c-06ca-35c9-8a94-bc840d7a5c18",
