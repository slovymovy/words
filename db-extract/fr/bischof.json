                ],
                "senses": [
                    {
                        "sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
                        "entry_id": "41944b08-6c04-337a-a49b-37ac53a5ae3d",
                        "glosses": [
                            "Boisson chaude ou froide, obtenue en faisant macérer, avec ou sans épices, dans du vin sucré, du citron ou de l’orange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742a1a98-6693-4737-9318-794b5f0fd89c",
                                "sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
                                "text": "Après avoir passé successivement par la demi-tasse, le grog, le bischof, le vin chaud et même l’eau rougie, il était revenu à la bière."
                            },
                            {
                                "example_id": "09dda602-6901-45f9-959e-df7760417091",
                                "sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
                                "text": "Dis-donc, chérie, si nous lichions un petit bischof ? Qu’en penses-tu ? […] Non, tu n’as pas soif ? Oh ! n’aie pas peur, va, ce sera un vrai bischof que tu boiras, pas de ceux qu’on sert en bas."
                            },
                            {
                                "example_id": "9310f6fc-1e7c-4b17-8c3e-96521c557e1c",
                                "sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
                                "text": "De la gaieté, des rires comme je n’en ai jamais entendu de si francs ! On joue aux cartes, on allume des punchs, on boit des bishofs ; il y a une odeur de citron."
                            },
                            {
                                "example_id": "b212153d-cbb1-4ce9-8ea3-2700d8338a26",
                                "sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
                                "text": "On servit aux invités un bischof aux raisins secs et aux prunes, et, sur un grand plat, un gâteau."
                            },
                            {
                                "example_id": "55f869e1-0a27-4d40-bcf9-bea9284857aa",
                                "sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
                                "text": "Thérèse avait même préparé pour le souper un Bischof, sorte de punch rouge et sucré que l'on buvait froid et qu'elle confectionnait avec maîtrise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a84bc03b-2ab9-4a6d-a425-09fa0928cb22",
                        "source_entry_id": "41944b08-6c04-337a-a49b-37ac53a5ae3d",
                        "source_sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
                        "target_lang_word": "Bischof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bischof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "686d8fd4-cbb5-3de9-9e08-61991cac18c6",
                                        "entry_id": "6ccdc721-506c-3f62-a983-30a3e3cd388e",
                                        "glosses": [
                                            "kirchlicher Würdenträger in einigen Konfessionen, der meist die geistliche und administrative Leitung eines bestimmten Gebietes hat (seines Bistums)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c23e2e-5472-4257-b0f7-cd62829b22f3",
                                                "sense_id": "686d8fd4-cbb5-3de9-9e08-61991cac18c6",
                                                "text": "„Durch das Mittagessen an immer einem anderen Ort mit immer anderen Menschen könnte der Kardinal oder Bischof erfahren, was die Menschen über das Konzil denken und was sie als Nächstes von ihm erwarten und ob sie gute Vorschläge haben, worüber man während des Konzils alles reden sollte.“"
                                            },
                                            {
                                                "example_id": "5bd0889e-e1ab-4cd2-a2ad-0da566f99a88",
                                                "sense_id": "686d8fd4-cbb5-3de9-9e08-61991cac18c6",
                                                "text": "Heute wird der Gottesdienst vom Bischof gehalten."
                                            },
                                            {
                                                "example_id": "9248e877-5dbc-43da-92b6-1f0736b3a296",
                                                "sense_id": "686d8fd4-cbb5-3de9-9e08-61991cac18c6",
                                                "text": "„In der Stimme des Konservators schwingt echte Anerkennung für den mittelalterlichen Bischof Azelin mit.“"
                                            },
                                            {
                                                "example_id": "e6170b68-a5b6-4f92-bdda-019c9a620c9d",
                                                "sense_id": "686d8fd4-cbb5-3de9-9e08-61991cac18c6",
                                                "text": "„Nachdem hier Geistliche nicht mehr für das Kirchenamt geweiht wurden, empfahlen Kapitulare ausgewählte Geistliche Kapiteln oder Bischöfen zur Verleihung von Pfründen.“"
                                            },
                                            {
                                                "example_id": "346ae49b-88da-484e-85aa-9dfd9b5220a4",
                                                "sense_id": "686d8fd4-cbb5-3de9-9e08-61991cac18c6",
                                                "text": "„Um eine solche Erklärung herbeizuführen, richtete sie es so ein, dass die jungen Leute vor dem Hochamt beim Bischof zusammenkamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c8c5c0c-7724-4ae4-bc6a-b09eec9e4dd5",
                        "source_entry_id": "41944b08-6c04-337a-a49b-37ac53a5ae3d",
                        "source_sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
                        "target_lang_word": "bishop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bishop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc322a3e-02c5-31b7-b4d8-50ad849577cc",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "An overseer of congregations: either any such overseer, generally speaking, or (in Eastern Orthodoxy, Catholicism, Anglicanism, etc.) an official in the church hierarchy (actively or nominally) governing a diocese, supervising the church's priests, deacons, and property in its territory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d1caec4-6679-403f-ac79-120d3c876366",
                                                "sense_id": "dc322a3e-02c5-31b7-b4d8-50ad849577cc",
                                                "text": "King James of blessed memory said, no Bishop, no King: it was not he, but others that added, No Ceremony, no Bishop."
                                            },
                                            {
                                                "example_id": "0632e7bd-5b6a-49d2-aa8f-e72be9680046",
                                                "sense_id": "dc322a3e-02c5-31b7-b4d8-50ad849577cc",
                                                "text": "St. Ignatius... In his 'Epiſtle to the Magneſians,' he exhorts them to do all things in the love of God, telling them, the Biſhop preſides in the place of God..."
                                            },
                                            {
                                                "example_id": "dcb87f37-005f-4d06-9082-e35857f82295",
                                                "sense_id": "dc322a3e-02c5-31b7-b4d8-50ad849577cc",
                                                "text": "These ministers were at first confined to the three orders of bishops, priests, and deacons."
                                            },
                                            {
                                                "example_id": "ddc550c7-950e-4a86-89a4-ab121acc559c",
                                                "sense_id": "dc322a3e-02c5-31b7-b4d8-50ad849577cc",
                                                "text": "It is a fact now generally recognized by theologians of all shades of opinion, that in the language of the New Testament the same officer in the Church is called indifferently ‘bishop’ ἐπίσκοπος and ‘elder’ or ‘presbyter’ πρεσβύτερος."
                                            },
                                            {
                                                "example_id": "ae50efa1-6834-4764-888f-594f4035d2a2",
                                                "sense_id": "dc322a3e-02c5-31b7-b4d8-50ad849577cc",
                                                "text": "The Jubilee Mass had a special solemnity due to the presence of two exiled Chinese bishops—Thomas Cardinal Tien, Archbishop of Peking, and Bishop Joseph Yuen, of Chu-ma-tien, Honan—as well as the recently named bishop of Taichung, Formosa, Most Rev. William Kupfer, MM, who was in the United States to attend the Maryknoll General Chapter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2589bce7-ed2a-39e3-a61e-d790d9b97055",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "An overseer of congregations: either any such overseer, generally speaking, or (in Eastern Orthodoxy, Catholicism, Anglicanism, etc.) an official in the church hierarchy (actively or nominally) governing a diocese, supervising the church's priests, deacons, and property in its territory.",
                                            "A similar official or chief priest in another religion."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8794de78-992a-4442-8c70-975f94483763",
                                                "sense_id": "2589bce7-ed2a-39e3-a61e-d790d9b97055",
                                                "text": "The Caliphaes of the Sarasins were kings and chiefe bishops in their religion."
                                            },
                                            {
                                                "example_id": "ded9fd57-76ef-422f-af96-9ff32b38fbcf",
                                                "sense_id": "2589bce7-ed2a-39e3-a61e-d790d9b97055",
                                                "text": "The Byshop of Egypt is called the Souldan."
                                            },
                                            {
                                                "example_id": "efdba52f-cb36-4486-878e-574ffb1987fc",
                                                "sense_id": "2589bce7-ed2a-39e3-a61e-d790d9b97055",
                                                "text": "[…] which explains the beheading of the Muslim Bishop of Lisbon, soon after the Reconquista."
                                            },
                                            {
                                                "example_id": "fff025d6-21c7-407e-ac5c-772c975f6dfc",
                                                "sense_id": "2589bce7-ed2a-39e3-a61e-d790d9b97055",
                                                "text": "The [holder of the office of] Imam [of Monrovia] is commonly referred to, both in conversation and in the press, as ‘the Muslim Bishop’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36725e61-1bcb-3fa2-aebb-5cf19c9a8ac0",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "The holder of the Greek or Roman position of episcopus, supervisor over the public dole of grain, etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "686c92a3-55d9-4ada-843c-ac0d569c17d6",
                                                "sense_id": "36725e61-1bcb-3fa2-aebb-5cf19c9a8ac0",
                                                "text": "They gave away corn, not cash; and Cicero was made bishop, or overseer, of this public victualling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90396f9f-ea28-30ce-832e-9ff62e42ef70",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "Any watchman, inspector, or overlooker."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d6abc04-3d8b-43a3-9a67-de076db91388",
                                                "sense_id": "90396f9f-ea28-30ce-832e-9ff62e42ef70",
                                                "text": "There is no place we see privileged from temptations, no desert so solitary but the devil will seek it out; no pinnacle so high but the devil is a bishop over it, to visit and overlook it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3291447b-d574-3af8-9f61-e21e7773b163",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "A chief of the Festival of Fools or St. Nicholas Day."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e46097bd-e14c-3eb3-a20e-169522e49861",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "The chess piece denoted ♗ or ♝ which moves along diagonal lines and developed from the shatranj alfil (\\\"elephant\\\") and was originally known as the aufil or archer in English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a639bae7-9829-431e-aaf7-27d0b92d904a",
                                                "sense_id": "e46097bd-e14c-3eb3-a20e-169522e49861",
                                                "text": "The Bishoppes some name Alphins, some fooles, and some name them Princes; other some call them Archers."
                                            },
                                            {
                                                "example_id": "b3beb5b1-c255-4b2c-b001-b6c700c455f8",
                                                "sense_id": "e46097bd-e14c-3eb3-a20e-169522e49861",
                                                "text": "A Bishop or Archer, who is commonly figured with his head cloven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e807a84-232f-36c0-a06f-9726538d7064",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "Any of various African birds of the genus Euplectes; a kind of weaverbird closely related to the widowbirds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b43db370-ba09-3723-90dd-b92621e2e9c9",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "A ladybug or ladybird, beetles of the family Coccinellidae."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d85fd32-6c89-4216-bafd-effd373410dd",
                                                "sense_id": "b43db370-ba09-3723-90dd-b92621e2e9c9",
                                                "text": "‘Bishop, Bishop-Barnabee,\nTell me when my wedding shall be;\nIf it be to-morrow day,\nOpe your wings and fly away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3c1244-d977-3afe-9fd6-cfe6bc215400",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "A flowering plant of the genus Bifora."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af8a4eb6-20db-370d-beb2-e1d19ff298f5",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "A sweet drink made from wine, usually with oranges, lemons, and sugar; mulled and spiced port."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf83d5ea-f171-4978-9578-156e1f71f5b4",
                                                "sense_id": "af8a4eb6-20db-370d-beb2-e1d19ff298f5",
                                                "text": "Well roasted, with Sugar and Wine in a Cup,\nThey'll make a sweet Bishop."
                                            },
                                            {
                                                "example_id": "d3cbfe74-06d0-486c-96f5-7f08e6fe873c",
                                                "sense_id": "af8a4eb6-20db-370d-beb2-e1d19ff298f5",
                                                "text": "A bowl of that liquor called Bishop, which Johnson had always liked."
                                            },
                                            {
                                                "example_id": "a063f18a-5e1d-4be4-9839-b1e7735ac429",
                                                "sense_id": "af8a4eb6-20db-370d-beb2-e1d19ff298f5",
                                                "text": "Spicy bishop, drink divine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6ed3183-3d16-3d5c-8bd9-e1cbc040c06c",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "A bustle."
                                        ],
                                        "tags": [
                                            "US",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bfa0f5f-8395-4c6a-8ca1-e0a7b7cce9e8",
                                                "sense_id": "c6ed3183-3d16-3d5c-8bd9-e1cbc040c06c",
                                                "text": "If, by her bishop, or her 'grace' alone,\nA genuine lady, or a church, is known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcba6ed4-ca2f-3893-840f-f0b4ae083d72",
                                        "entry_id": "d5053a50-77ab-31a7-9b37-732f95f4ec58",
                                        "glosses": [
                                            "A children's smock or pinafore."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6beeea9b-951a-4cdd-818a-668663e850c1",
                                                "sense_id": "dcba6ed4-ca2f-3893-840f-f0b4ae083d72",
                                                "text": "Here; tak him, an wesh him; an' put him a clen bishop on."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bishop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1084782d-0b29-33f9-b71c-a2165e8c18ae",
                                        "entry_id": "0be27399-7be2-3b37-9bb6-541bfca66eb6",
                                        "glosses": [
                                            "To act as a bishop, to perform the duties of a bishop, especially to confirm another's membership in the church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "042f1d8b-5f37-4f4e-b490-9dd65be24c7a",
                                                "sense_id": "1084782d-0b29-33f9-b71c-a2165e8c18ae",
                                                "text": "Se bisceop biþ gesett... to bisceopgenne cild."
                                            },
                                            {
                                                "example_id": "23d606a2-1664-4e5b-a7bb-15813a5ce242",
                                                "sense_id": "1084782d-0b29-33f9-b71c-a2165e8c18ae",
                                                "text": "Wanne the bisschop, bisschopeth the\nTokene of marke he set on the."
                                            },
                                            {
                                                "example_id": "1de5db86-0f9f-4131-bbdb-1a93d6c08481",
                                                "sense_id": "1084782d-0b29-33f9-b71c-a2165e8c18ae",
                                                "text": "The Marquis of Buckingham and his wife were both bishopped, or confirmed by the Bishop of London."
                                            },
                                            {
                                                "example_id": "a423944d-ebdb-4f03-ada2-76f7ba9b8c2b",
                                                "sense_id": "1084782d-0b29-33f9-b71c-a2165e8c18ae",
                                                "text": "Harding and Saunders Bishop it in England."
                                            },
                                            {
                                                "example_id": "8f58d78b-72ea-40fd-871a-c6088fdc45b1",
                                                "sense_id": "1084782d-0b29-33f9-b71c-a2165e8c18ae",
                                                "text": "Here too physical effects were vulgarly attributed to the ceremony… as evidenced by the case of the old Norfolk woman who claimed to have been ‘bishopped’ seven times, because she found it helped her rheumatism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18aaf79b-bf90-30c2-9086-ac5d55bd115d",
                                        "entry_id": "0be27399-7be2-3b37-9bb6-541bfca66eb6",
                                        "glosses": [
                                            "To act as a bishop, to perform the duties of a bishop, especially to confirm another's membership in the church.",
                                            "To confirm (in its other senses)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb505d10-1291-4026-9c0a-f37b9fd5ddd9",
                                                "sense_id": "18aaf79b-bf90-30c2-9086-ac5d55bd115d",
                                                "text": "Why sent they it by Felton to be bishoped at Paules?"
                                            },
                                            {
                                                "example_id": "d38eefaa-f1a1-41e7-b9c6-ab0b69f4d689",
                                                "sense_id": "18aaf79b-bf90-30c2-9086-ac5d55bd115d",
                                                "text": "He... chose to bear The Name of Fool confirm'd, and Bishop'd by the Fair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8acb30bd-7143-3867-81d7-f26c6a4bc711",
                                        "entry_id": "0be27399-7be2-3b37-9bb6-541bfca66eb6",
                                        "glosses": [
                                            "To make a bishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ff8ec8-f30b-43dd-8eb1-9d4dacbd1051",
                                                "sense_id": "8acb30bd-7143-3867-81d7-f26c6a4bc711",
                                                "text": "1549, H. Latimer, 2nd Serm. before Kynges Maiestie, 5th Serm. sig. Pviv\nThys hathe bene often tymes... sene in preachers before they were byshoppyd or benificed."
                                            },
                                            {
                                                "example_id": "e7f47549-fa78-4488-98ee-23768721aac3",
                                                "sense_id": "8acb30bd-7143-3867-81d7-f26c6a4bc711",
                                                "text": "There may be other... matters to occupy the thoughts of one about to be bishopped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b1bba4f-563f-382d-b12f-b5c1aa06cf8a",
                                        "entry_id": "0be27399-7be2-3b37-9bb6-541bfca66eb6",
                                        "glosses": [
                                            "To provide with bishops."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2330fcd-2ff7-473e-abf1-500783db3de7",
                                                "sense_id": "3b1bba4f-563f-382d-b12f-b5c1aa06cf8a",
                                                "text": "Italy would be well bishoped if her episcopacy... did not exceed fifty-nine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3721c247-7d50-3598-84b8-927934224c49",
                                        "entry_id": "0be27399-7be2-3b37-9bb6-541bfca66eb6",
                                        "glosses": [
                                            "To permit food (especially milk) to burn while cooking (from bishops' role in the inquisition or as mentioned in the quotation below, of horses)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2439769c-7c9c-4054-ba03-80a74da19548",
                                                "sense_id": "3721c247-7d50-3598-84b8-927934224c49",
                                                "text": "If the porage be burned to, or the meate ouer rosted, we say the bishop hath put his foote in the potte or the bishop hath played the cooke, because the bishops burn who they lust and whosoever displeaseth them."
                                            },
                                            {
                                                "example_id": "2bc98cb0-94e3-4eb3-8e2a-4853dfc8c568",
                                                "sense_id": "3721c247-7d50-3598-84b8-927934224c49",
                                                "text": "It will be as bad as the Bishops foot in the broth."
                                            },
                                            {
                                                "example_id": "030f82a4-2049-4731-8b42-acb64fc4b603",
                                                "sense_id": "3721c247-7d50-3598-84b8-927934224c49",
                                                "text": "The Cream is burnt to.\nBetty. Why, Madam, the Bishop has set his Foot in it."
                                            },
                                            {
                                                "example_id": "e2b55e9b-b950-4d85-af23-ffa5e5d22df0",
                                                "sense_id": "3721c247-7d50-3598-84b8-927934224c49",
                                                "text": "She canna stomach it if it's bishopped e'er so little."
                                            },
                                            {
                                                "example_id": "4731408b-e8c0-4221-80f0-f62b670827b4",
                                                "sense_id": "3721c247-7d50-3598-84b8-927934224c49",
                                                "text": "Th' milk's bishopped again!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a35c473-473e-3ebe-843f-52f1cafc4fe2",
                                        "entry_id": "0be27399-7be2-3b37-9bb6-541bfca66eb6",
                                        "glosses": [
                                            "To make a horse seem younger, particularly by manipulation of its teeth."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92d50d7-8236-4ba3-a3cb-d65ae0f5cf08",
                                                "sense_id": "7a35c473-473e-3ebe-843f-52f1cafc4fe2",
                                                "text": "1727, R. Bradley, Family Dict. at \"Horse\"\nThis way of making a Horse look young is... called Bishoping."
                                            },
                                            {
                                                "example_id": "3fea30a5-d17a-4750-b97c-05450e0126b5",
                                                "sense_id": "7a35c473-473e-3ebe-843f-52f1cafc4fe2",
                                                "text": "Bishopped, or To bishop. A term among horſe dealers, for burning the mark into a horſe's tooth, after he has loſt it by age... It is a common ſaying of milk that is burnt to, that the biſhop has fet his foot in it. Formerly, when a biſhop paſſed through a village, all the inhabitants ran out of their houſes to ſolicit his bleſſing, even leaving their milk, &c. on the fire, to take its chance; which, when burnt to, was ſaid to be biſhopped."
                                            },
                                            {
                                                "example_id": "96d5b034-f885-4607-9af2-7dfb903b37a3",
                                                "sense_id": "7a35c473-473e-3ebe-843f-52f1cafc4fe2",
                                                "text": "I found his teeth had been filed down and bishoped with the greatest neatness and perfection."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bishop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bfff4ca-fe29-36b1-9676-9f63aa0f2ba6",
                                        "entry_id": "dfdb1e9a-4f50-37fa-b01c-e9e5e68cc631",
                                        "glosses": [
                                            "To murder by drowning."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e35921fe-3fb1-4b1f-80b8-158660151b72",
                                                "sense_id": "6bfff4ca-fe29-36b1-9676-9f63aa0f2ba6",
                                                "text": "I Burked the papa, now I'll Bishop the son."
                                            },
                                            {
                                                "example_id": "09689158-8357-451d-b338-78d711864a3d",
                                                "sense_id": "6bfff4ca-fe29-36b1-9676-9f63aa0f2ba6",
                                                "text": "There were no more Burking murders until 1831, when two men, named Bishop and Williams, drowned a poor [14-year-old] Italian boy in Bethnal Green, and sold his body to the surgeons."
                                            },
                                            {
                                                "example_id": "ddeccf5a-efef-47ce-813f-a9c0a24886ba",
                                                "sense_id": "6bfff4ca-fe29-36b1-9676-9f63aa0f2ba6",
                                                "text": "John Bishop and another grave-robber called Thomas Williams had drowned the boy, a woman and another boy in a well in John Bishop's garden in Bethnal Green... Bishop and Williams were hanged outside Newgate Prison in December 1831 in front of an angry crowd of 30,000."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97c09e3a-ff83-487f-9e30-74542345bc5f",
                        "source_entry_id": "41944b08-6c04-337a-a49b-37ac53a5ae3d",
                        "source_sense_id": "562c78b6-4cb2-3d68-81a4-c1636fc1d901",
