                        "glosses": [
                            "Qui parle le cantonais."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "15cb2a7a-a376-4d1d-98d5-8f59276172c3",
                                "sense_id": "6aac7ac5-1798-3339-9db7-0deae289bd2e",
                                "text": "On peut écouter les gongs et les tambours de cet opéra dans les salons de thé, les temples et les parcs des régions cantonophones."
                            },
                            {
                                "example_id": "9b961232-1e2c-4fdd-9396-9ea288f82e66",
                                "sense_id": "6aac7ac5-1798-3339-9db7-0deae289bd2e",
                                "text": "La langue pratiquée dans le Yunnan est un dialecte du mandarin, mais en partant de Kunming et en direction de Hong Kong on passe par Nanning où les gens parlent le Ping (qui ressemble au cantonais) puis rapidement on arrive dans la région cantonophone, avec cependant quelques «poches» de populations Hakka."
                            }
                        ]
                    }
