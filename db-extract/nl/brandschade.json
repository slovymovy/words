                        "examples": [
                            {
                                "example_id": "c460b101-90e3-46e5-8db4-57a07917dd28",
                                "sense_id": "1093af64-0a1c-328e-8e9d-4ea0d1b5cab0",
                                "text": "Er werd op de politie gescholden; ze werd omgekocht; er werden ramingen van de brandschade gemaakt die tien keer te hoog waren; men eiste ondersteuning."
                            },
                            {
                                "example_id": "c24c0d4d-1648-4ccf-b8fc-b16077017253",
                                "sense_id": "1093af64-0a1c-328e-8e9d-4ea0d1b5cab0",
                                "text": "Zo blijkt de kap nog redelijk intact, maar is het houtwerk ernstig beschadigd. \"Dit gaat zo veel werk kosten om alle brandschade weg te krijgen\", zegt hij tegen NH Nieuws."
                            }
                        ]
                    }
