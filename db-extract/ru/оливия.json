                "senses": [
                    {
                        "sense_id": "a8c3d1e8-330f-30cc-be9c-83c865e83bd1",
                        "entry_id": "7f39de7b-4a5b-3ae8-80f4-fe4a3407b3ca",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f278ddce-f51d-44a6-b579-5335ea313d81",
                                "sense_id": "a8c3d1e8-330f-30cc-be9c-83c865e83bd1",
                                "text": "Трёхлетняя Оливия Льюис-Брдун и двухлетняя Жасмин Эванс играют на побережье Ла-Манша в Английском городе Брайтон ― одном из самых популярных морских курортов Великобритании."
                            },
                            {
                                "example_id": "789b3419-9787-4351-a266-20a64562ef8c",
                                "sense_id": "a8c3d1e8-330f-30cc-be9c-83c865e83bd1",
                                "text": "Марстон не успел вкусить славы в кино ― он умер в 1947 году от рака, но Элизабет и Оливия продолжали жить вдвоём ещё 40 долгих лет после этого."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f1830b7-ab00-404c-b943-eeb7829b027d",
                        "source_entry_id": "7f39de7b-4a5b-3ae8-80f4-fe4a3407b3ca",
                        "source_sense_id": "a8c3d1e8-330f-30cc-be9c-83c865e83bd1",
                        "source_sense_description": "Оливия",
                        "target_lang_word": "Olivia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Olivia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69e5ff65-fc8d-3c01-a44c-dec7dbc61fbc",
                                        "entry_id": "5e2cba59-248f-3cb2-a744-ece19bfbaa69",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d96dd6-b6bd-4f05-a231-9c2592095615",
                                                "sense_id": "69e5ff65-fc8d-3c01-a44c-dec7dbc61fbc",
                                                "text": "O! when mine eyes did see Olivia first / Methought she purg’d the air of pestilence."
                                            },
                                            {
                                                "example_id": "96d5b361-f662-452d-b158-0a4e21c8fa9a",
                                                "sense_id": "69e5ff65-fc8d-3c01-a44c-dec7dbc61fbc",
                                                "text": "I intended to call her after Aunt Grizel, but my wife who, during pregnancy, had been reading romances, insisted upon her being called Olivia. In less than another year we had another daughter, and now I was determined that Grizel should be her name; but a rich relation taking a fancy to stand godmother, the girl was, by her directions, called Sophia, so that we had two romantic names in the family, but I solemnly protest I had no hand in it."
                                            },
                                            {
                                                "example_id": "a8c6b25a-9243-4d30-9f73-0fbccd56e245",
                                                "sense_id": "69e5ff65-fc8d-3c01-a44c-dec7dbc61fbc",
                                                "text": "‘Olivia, that's a fine posh name for Castlebay,’ he said approvingly. ‘Ah, they're sick of these Davids and Clares and Gerrys, the dull old names,’ Clare laughed. ‘I hope they won't call her Olly,’ David said. ‘Make your own nickname then,’ Gerry said. ‘Livy?’ Clare suggested. ‘Liffey even?’ Gerry said."
                                            },
                                            {
                                                "example_id": "765afbb7-7813-4dff-831f-e24c354a2e38",
                                                "sense_id": "69e5ff65-fc8d-3c01-a44c-dec7dbc61fbc",
                                                "text": "Olivia Nuzzi has parted ways with New York magazine, the publication said Monday, after the star Washington correspondent was placed on leave last month over a previously undisclosed “personal relationship” with Robert F. Kennedy, Jr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ccbb68c-3c95-3d22-899f-38c2d4af05be",
                                        "entry_id": "5e2cba59-248f-3cb2-a744-ece19bfbaa69",
                                        "glosses": [
                                            "A city, the county seat of Renville County, Minnesota, United States, named for a female station agent named Olive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7720b12b-424f-3354-b93f-0bfca5eb763c",
                                        "entry_id": "5e2cba59-248f-3cb2-a744-ece19bfbaa69",
                                        "glosses": [
                                            "An unincorporated community in North Carolina, United States; named for tobacco businessman W. J. Olive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
