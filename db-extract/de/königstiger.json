                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "459aa254-216d-399b-8726-267f662a15bf",
                                        "entry_id": "5f026bf1-5905-3c8c-abc9-7e2633796898",
                                        "glosses": [
                                            "Sous-espèce de tigre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af3d896f-fdb9-4230-a826-eb67452dc1f4",
                                                "sense_id": "459aa254-216d-399b-8726-267f662a15bf",
                                                "text": "Le Népal a commencé à recenser le nombre de ses tigres du Bengale, espèce menacée d'extinction vivant dans les vastes plaines forestières du sud, ont indiqué des responsables lundi."
