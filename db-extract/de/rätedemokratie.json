                "senses": [
                    {
                        "sense_id": "7d7822a1-8325-39b1-a1c9-5dbd67c2f210",
                        "entry_id": "b22803cc-796d-3460-a597-752ba4da584e",
                        "glosses": [
                            "Demokratie, in der die alleinige Macht von Räten (Gremien, welche aus direkt gewählten Vertretern besteht, die der Wählerschaft verantwortlich sind) ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9274be5-5f41-4fd7-aae0-10c0336b4469",
                                "sense_id": "7d7822a1-8325-39b1-a1c9-5dbd67c2f210",
                                "text": "„Liebknecht versuchte, die revolutionären Arbeiter und Soldaten für seine sozialistische Rätedemokratie nach sowjetischem Vorbild zu gewinnen.“"
                            },
                            {
                                "example_id": "711dc4d6-c682-4fc3-9d8b-0135fdac5ba4",
                                "sense_id": "7d7822a1-8325-39b1-a1c9-5dbd67c2f210",
                                "text": "„Nach der Niederlage Frankreichs und mehrwöchiger Internierung im berüchtigten Lager Gurs gelangte A. [Arendt], zu deren Freunden in Paris auch Walter Benjamin gehörte, zusammen mit ihrer Mutter und ihrem zweiten Ehemann Heinrich Blücher, einem ehemaligen Kommunisten, der ihr die Idee der Rätedemokratie vermittelte, im Mai 1941 nach New York.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
