                "senses": [
                    {
                        "sense_id": "e9026470-dbd7-3112-88ba-91f8fc120067",
                        "entry_id": "67118e5c-f0d6-3106-b075-8df9c2741069",
                        "glosses": [
                            "Geschwindigkeit des Windes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "891524ec-3406-43d5-bcc1-2730fa050fca",
                                "sense_id": "e9026470-dbd7-3112-88ba-91f8fc120067",
                                "text": "Auf dem Gipfel des Berges herrschen Windgeschwindigkeiten von bis zu achtzig Kilometern pro Stunde."
                            },
                            {
                                "example_id": "f91bcd93-0cd0-43be-b1ff-581e7da937ba",
                                "sense_id": "e9026470-dbd7-3112-88ba-91f8fc120067",
                                "text": "„Bei einer Windgeschwindigkeit von 100 Stundenkilometern wuchsen die Wellen zu 7 Metern Höhe an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31105349-fe12-4e30-98b2-9e3ccdb407fa",
                        "source_entry_id": "67118e5c-f0d6-3106-b075-8df9c2741069",
                        "source_sense_id": "e9026470-dbd7-3112-88ba-91f8fc120067",
                        "source_sense_description": "Geschwindigkeit des Windes",
                        "target_lang_word": "wind speed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wind speed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b2c17f-bdf0-3920-ae91-e4421003a073",
                                        "entry_id": "3cba1e51-7229-38da-8551-58814d6ced57",
                                        "glosses": [
                                            "The local speed of the wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6b2654-0bc5-4cfa-af9f-9021bdf1e3d2",
                                                "sense_id": "76b2c17f-bdf0-3920-ae91-e4421003a073",
                                                "text": "Wind speed is measured by the conventional arrangement of three hemispherical cups, mounted at 120 deg. on a shaft which is geared to a cam."
                                            },
                                            {
                                                "example_id": "6c40e1f5-b171-4977-88a9-458e70db612f",
                                                "sense_id": "76b2c17f-bdf0-3920-ae91-e4421003a073",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            },
                                            {
                                                "example_id": "a49a54c6-095b-4220-9b1e-772e077c29d1",
                                                "sense_id": "76b2c17f-bdf0-3920-ae91-e4421003a073",
                                                "text": "The climate testing ranged through temperatures of -15°C to 40°C, extreme warming from sunlight, ice, and wind speeds of up to 100kph (62mph) to check the train could still operate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
