                    {
                        "translation_id": "500e3b90-e139-4e78-9f1c-72ac66f1989c",
                        "source_entry_id": "f7c9c013-7943-3d62-9ba4-ceab21004e97",
                        "source_sense_id": "8f5d48a0-7b77-35aa-ba62-8edcbb159f88",
                        "source_sense_description": "Person, die für die Öffentlichkeit wichtige Informationen aus einem geheimen oder geschützten Zusammenhang veröffentlicht",
                        "target_lang_word": "lanceur d’alerte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lanceur d’alerte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3246fd49-e3a2-3e58-b918-a15c2884738a",
                                        "entry_id": "40061e34-4a0d-3684-a250-b9aa9e3d262b",
                                        "glosses": [
                                            "Personne ou entité qui révèle publiquement des faits dissimulés par leurs auteurs, souvent des grandes puissances, car nuisibles à la société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78329d8c-375a-49df-8eb2-bdb8803d9645",
                                                "sense_id": "3246fd49-e3a2-3e58-b918-a15c2884738a",
                                                "text": "Les députés ont voté dans la nuit de mercredi à jeudi 20 juin une mesure protégeant les lanceurs d'alerte signalant des conflits d’intérêt, dénoncée par la droite, mais aussi les radicaux de gauche, comme un encouragement à la délation."
                                            },
                                            {
                                                "example_id": "bd5862bc-3776-47ac-8f56-578693ef4101",
                                                "sense_id": "3246fd49-e3a2-3e58-b918-a15c2884738a",
                                                "text": "Le lanceur d’alerte prend des risques énormes au nom de la cause qu’il va défendre et divulguer, et met en danger sa réputation, sa santé, sa famille et sa liberté. Il va subir presque toujours des « poursuites-bâillons » : des procédures judiciaires dont le but réel est d’intimider, censurer et ruiner un détracteur. Edward Snowden est harcelé par l’administration Obama. Pire que sous Bush junior."
                                            },
                                            {
                                                "example_id": "dde9484b-b9c0-46cd-9411-dc58226bd6e5",
                                                "sense_id": "3246fd49-e3a2-3e58-b918-a15c2884738a",
                                                "text": "Une chose est sûre : la mise en garde des lanceurs d’alerte contre les dérèglements écologiques, elle, ne date pas d’hier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
