                ],
                "senses": [
                    {
                        "sense_id": "92d6a6d4-2a60-3231-b938-cc99821718d7",
                        "entry_id": "cfc812f5-7c1e-3568-9c13-7bc28d0dab15",
                        "glosses": [
                            "toeleiding van damp of uitwaseming van warme geneesmiddelen naar een ziekelijk deel van het lichaam voor inhalatie, huidbehandeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "560a4890-5633-4a1b-8bcc-ca7a08a0a94c",
                                "sense_id": "92d6a6d4-2a60-3231-b938-cc99821718d7",
                                "text": "Bij het dampbad worden Kruiden met veel etherische oliën (aromatische kruiden) toegevoegd aan kokend water in een open schaal (evt met toevoeging van etherische oliën uit een flesje, zie ‘Aromatherapie’), waarna, met een handdoek over het hoofd en de schaal, de dampen worden geïnhaleerd (fytotherapie)."
                            }
                        ]
                    },
                    {
                        "sense_id": "be9b48c2-d845-3391-90bc-f19fed9683b8",
                        "entry_id": "cfc812f5-7c1e-3568-9c13-7bc28d0dab15",
                        "glosses": [
                            "badkamer met dampontwikkeling voor een nog diepere reiniging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb41810f-d89e-4b04-ba70-184e15732dbb",
                                "sense_id": "be9b48c2-d845-3391-90bc-f19fed9683b8",
                                "text": "Daarnaast kunt u genieten van de gemeenschappelijke sauna of van het Turks dampbad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e18ff55f-6178-4697-b63a-b34d306d74a0",
