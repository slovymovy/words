                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "honorific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sługa ukłonił się nisko i powitał <w>jasnego</w> pana w progu dworu.",
                            "target_lang_translations": {
