                                    {
                                        "sense_id": "831d8f19-fef4-3608-9f79-e06f9a965746",
                                        "entry_id": "19e9520a-73b3-3f59-9d24-96c19be8decb",
                                        "glosses": [
                                            "preservation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcfe626b-f407-4190-baa6-6fc08524efdb",
                                                "sense_id": "831d8f19-fef4-3608-9f79-e06f9a965746",
                                                "text": "Some preservings of foods, indeed, can scarcely be done to advantage except on a large scale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3cc7a62-fb66-474d-8650-c215eed97d9a",
                        "source_entry_id": "0b3aecd7-b6df-3ae5-a5e4-b57b69f6c593",
                        "source_sense_id": "3e9e38c3-26f3-3a26-ae6a-2b7d36b53211",
                        "target_lang_word": "preservation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preservation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f075e87d-0221-38ee-8be1-b926727b00d0",
                                        "entry_id": "c987fc01-b071-3b73-a807-6876497b0e07",
                                        "glosses": [
                                            "The act of preserving; care to preserve; act of keeping from destruction, decay or any ill."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de29931b-b5f8-42cc-ae37-40c463f41cfa",
                                                "sense_id": "f075e87d-0221-38ee-8be1-b926727b00d0",
                                                "text": "Every seneseless thing by nature's light\nDoth preservation seek, destruction shun"
                                            },
                                            {
                                                "example_id": "91a64542-453b-41f8-a62d-e3dc03991844",
                                                "sense_id": "f075e87d-0221-38ee-8be1-b926727b00d0",
                                                "text": "The eyes of the Lord are upon them that love him, his is ther mighty protection, a preservation from stumbling, and a help from falling."
                                            },
                                            {
                                                "example_id": "dd776eea-f7fc-4325-80f5-b54663a1d359",
                                                "sense_id": "f075e87d-0221-38ee-8be1-b926727b00d0",
                                                "text": "Further, the Society pleads for the preservation of Sutton's Charity."
                                            },
                                            {
                                                "example_id": "8171b817-6887-44da-8fe6-028acf986d8d",
                                                "sense_id": "f075e87d-0221-38ee-8be1-b926727b00d0",
                                                "text": "Preservation of two railway routes between Belfast and Derry could no longer be justified and one of them must go."
                                            },
                                            {
                                                "example_id": "34c6801e-7816-4380-a5b6-4e74203f7703",
                                                "sense_id": "f075e87d-0221-38ee-8be1-b926727b00d0",
                                                "text": "When a language dies members of the culture of which that language was once a part may attempt to hold on to their linguistic heritage, if not by the use of the defunct language itself, at least by the preservation of its script."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598d6e97-1ed3-3781-977d-a16b12f55e74",
                                        "entry_id": "c987fc01-b071-3b73-a807-6876497b0e07",
                                        "glosses": [
                                            "The state of being preserved, how something has survived."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf33cfc1-b33d-49ea-99b7-b945217896de",
                                                "sense_id": "598d6e97-1ed3-3781-977d-a16b12f55e74",
                                                "text": "The canoe is of pure black oak, and is in excellent preservation."
                                            },
                                            {
                                                "example_id": "80f9bac7-7db8-4236-a717-9d48fd353e72",
                                                "sense_id": "598d6e97-1ed3-3781-977d-a16b12f55e74",
                                                "text": "Tons of engine sheds would bite the dust with the end of steam, and many would be demolished with their time in the spotlight over. We're lucky that the one at Didcot survived into preservation."
                                            },
                                            {
                                                "example_id": "e9340661-7e60-4429-9308-8ea5291e4ab1",
                                                "sense_id": "598d6e97-1ed3-3781-977d-a16b12f55e74",
                                                "text": "As Edwin Clark [...] wrote in 1850: \"[...] The lofty towers of the castle overhang the western approach to the Bridge, and the line passes into Conway through an opening pierced in the embattled wall, which entirely surrounds the town. These fortifications are in good preservation, and rank among the most perfect examples of the strongholds of the 13th century.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
