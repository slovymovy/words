                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0be57f8-50bc-4ca6-a883-1b8bce7fceb7",
                                "sense_id": "6727c9f6-e8f4-36f9-be25-dea56bfc0f09",
                                "text": "We cocreated this dress.",
                                "translation": "Wir erschufen dieses Kleid zusammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41b7adf7-952a-4946-81e0-30ceefc6bf6f",
                        "source_entry_id": "a89c5ebe-e127-3e82-9606-1be76550a36e",
                        "source_sense_id": "6727c9f6-e8f4-36f9-be25-dea56bfc0f09",
                        "source_sense_description": "etwas zusammen erschaffen",
                        "target_lang_word": "zusammen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zusammen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf7b1c7f-5cdf-3979-b52c-d9f1ec12dd3a",
                                        "entry_id": "736705e4-2e3e-3d3b-bf8d-cc5a180065b4",
                                        "glosses": [
                                            "gemeinschaftlich, miteinander; zum Beispiel etwas tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00dc938e-3457-4542-9294-60d22ae8f8e7",
                                                "sense_id": "bf7b1c7f-5cdf-3979-b52c-d9f1ec12dd3a",
                                                "text": "Die Nachbarskinder spielten zusammen."
                                            },
                                            {
                                                "example_id": "282a7aa0-e1fa-4b82-9100-70316f80e375",
                                                "sense_id": "bf7b1c7f-5cdf-3979-b52c-d9f1ec12dd3a",
                                                "text": "Zusammen schaffen wir das!"
                                            },
                                            {
                                                "example_id": "353c9f40-c184-42df-bc2a-0a6f2fc9c274",
                                                "sense_id": "bf7b1c7f-5cdf-3979-b52c-d9f1ec12dd3a",
                                                "text": "[Nobelpreis 2022:] „Der frühere US-Notenbankchef Ben Bernanke und die Ökonomen Douglas W. Diamond und Philip H. Dybvig werden zusammen \"für ihre Erforschung von Banken und Finanzkrisen\" ausgezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e02e2e6-28dc-3132-87e1-a76cf6eb147f",
                                        "entry_id": "736705e4-2e3e-3d3b-bf8d-cc5a180065b4",
                                        "glosses": [
                                            "zur gleichen Zeit am gleichen Ort; zum Beispiel sich aufhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60bddd05-01c6-41f7-bb00-c026b6857e6b",
                                                "sense_id": "7e02e2e6-28dc-3132-87e1-a76cf6eb147f",
                                                "text": "Um ein Uhr waren wir noch zusammen, danach hat sie den Zug nach München genommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4798a184-ea8d-3817-801e-329fbcf7b03d",
                                        "entry_id": "736705e4-2e3e-3d3b-bf8d-cc5a180065b4",
                                        "glosses": [
                                            "ein Liebespaar"
                                        ],
                                        "tags": [
                                            "in der Wendung „zusammen sein“ und ähnlichen",
                                            "untertreibend für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90b0f8fe-9f4b-4eb9-bbd4-6e4fe11fa75d",
                                                "sense_id": "4798a184-ea8d-3817-801e-329fbcf7b03d",
                                                "text": "Im Urlaub kamen sie zufällig zusammen, seitdem sind sie zusammen, hoffentlich bleiben sie noch lange zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "857840d8-5e9f-3f4b-9949-e592c94f4a64",
                                        "entry_id": "736705e4-2e3e-3d3b-bf8d-cc5a180065b4",
                                        "glosses": [
                                            "als Summe betrachtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163e2784-6f3c-49a9-b874-d896f5704a09",
                                                "sense_id": "857840d8-5e9f-3f4b-9949-e592c94f4a64",
                                                "text": "Die beiden sind zusammen 100 Jahre alt."
                                            },
                                            {
                                                "example_id": "780ecb7e-ed66-45b4-a2a7-4ed43e82da3d",
                                                "sense_id": "857840d8-5e9f-3f4b-9949-e592c94f4a64",
                                                "text": "Wir beide hätten ja schon zusammen 100€, da bekommen wir sicher den Rest auch noch zusammen."
                                            },
                                            {
                                                "example_id": "f835dcc7-be4e-4dcb-a570-e22b677e617c",
                                                "sense_id": "857840d8-5e9f-3f4b-9949-e592c94f4a64",
                                                "text": "„Derzeit fällt jährlich allein tropischer Regenwald auf einer Fläche, die so groß ist, wie Bayern und Niedersachsen zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "807b92ec-089e-457f-bf15-c3d531647a97",
                        "source_entry_id": "a89c5ebe-e127-3e82-9606-1be76550a36e",
                        "source_sense_id": "6727c9f6-e8f4-36f9-be25-dea56bfc0f09",
                        "source_sense_description": "etwas zusammen erschaffen",
                        "target_lang_word": "erschaffen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erschaffen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf5bdaa-b18f-3f86-a267-ae2d0ebf40bb",
                                        "entry_id": "5477232a-bc26-33ae-9e0b-fe66dae56608",
                                        "glosses": [
                                            "durch Herstellungsprozess/Akt der Schöpfung hervorgebracht"
                                        ],
                                        "tags": [
                                            "auch",
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06e0f81-e506-42fa-b6d9-b4c764640684",
                                                "sense_id": "7bf5bdaa-b18f-3f86-a267-ae2d0ebf40bb",
                                                "text": "„Ernst Bienzle […] ist eine von dem deutschen Schriftsteller Felix Huby erschaffene Romanfigur.“"
                                            },
                                            {
                                                "example_id": "54bd7bdd-a120-471e-9d97-68a48fd04d9f",
                                                "sense_id": "7bf5bdaa-b18f-3f86-a267-ae2d0ebf40bb",
                                                "text": "„Nach Böhme ist die erschaffene Natur ein derivatum der unerschaffenen; […]“"
                                            },
                                            {
                                                "example_id": "d3755837-d5cd-4120-8270-a3d4f28faada",
                                                "sense_id": "7bf5bdaa-b18f-3f86-a267-ae2d0ebf40bb",
                                                "text": "„Nach einer anderen Position gibt es keine zweite Erschaffung, sondern der erschaffene Koran ist lediglich das, was die Menschen rezitieren, schriftlich fixieren und memorieren, während der Koran auf der wohlverwahrten Tafel ein unerschaffenes Akzidens ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "erschaffen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34dc6353-c049-378e-a845-cbce3e978072",
                                        "entry_id": "f0cd0e23-bb8e-31cd-a324-24bd781f12b1",
                                        "glosses": [
                                            "durch eigene kreative Kraft entstehen lassen"
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b804b962-e823-46bc-af67-2870aff293ac",
                                                "sense_id": "34dc6353-c049-378e-a845-cbce3e978072",
                                                "text": "Er erschuf sein gesamtes literarisches Werk in 3 Jahren."
                                            },
                                            {
                                                "example_id": "5938e3ea-2a83-4781-9aa9-1240320cb778",
                                                "sense_id": "34dc6353-c049-378e-a845-cbce3e978072",
                                                "text": "Nach dem Schöpfungsmythos der Genesis hat Gott die Welt in sieben Tagen erschaffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
