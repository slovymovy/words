                "senses": [
                    {
                        "sense_id": "23599f67-0f02-3987-9618-532b2c27d00f",
                        "entry_id": "3d44f0ee-ea1c-354b-8ff8-582881229eeb",
                        "glosses": [
                            "der mittlere Vorhang der Bühne"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "d24eac19-a413-4341-94e0-4ea7df148970",
                                "sense_id": "23599f67-0f02-3987-9618-532b2c27d00f",
                                "text": "[Regieanweisung:] „Beim Aufrollen der Kurtine steht der Portier eine kleine Weile regungslos, mit dem großen Stock in der Hand, darauf kommt Leni aus dem Hause“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b6d1b782-e07a-35b9-b95c-88bf686552bd",
                        "entry_id": "3d44f0ee-ea1c-354b-8ff8-582881229eeb",
                        "glosses": [
                            "verbindender Wall oder Mauer zwischen zwei Verteidigungspunkten einer Festung (Bastionen, Türme oder Rondelle)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "188b4047-3a27-4247-85da-b498f886c968",
                                "sense_id": "b6d1b782-e07a-35b9-b95c-88bf686552bd",
                                "text": "„Um zehn Uhr hatte sich General Bosquet auf den gewählten Posten – in die am weitesten gegen die Kurtine vorgeschobene Parallele – begeben. Er ermöglichte einen vollständigen Überblick des Kampfplatzes.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "73c13e44-284a-3373-a8ba-b2368f39e67c",
                        "entry_id": "3d44f0ee-ea1c-354b-8ff8-582881229eeb",
                        "glosses": [
                            "ein Brand hemmender und rauchdichter Schutzvorhang zwischen Bühne und Zuschauerraum"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "38f17bfb-6226-4455-930c-fa896006dcf3",
                                "sense_id": "73c13e44-284a-3373-a8ba-b2368f39e67c",
                                "text": "„Die Kurtine, welche im Gefahrenfall die Bühnenöffnung gegen den Zuschauerraum brandhemmend und rauchdicht abzuschließen hat, darf keine Türen oder sonstigen Öffnungen haben und muß außerhalb der Zeit der Vorstellungen, der Proben und der zugehörigen Auf- und Umbauarbeiten geschlossen gehalten werden.“"
                            },
                            {
                                "example_id": "db6b8f1c-d0e2-4e1c-b80d-28e517987300",
                                "sense_id": "73c13e44-284a-3373-a8ba-b2368f39e67c",
                                "text": "„Das Triebwerk der Kurtine ist derart einzurichten, daß die Bühnenöffnung auch ohne motorischen Antrieb mit einer durchschnittlichen Geschwindigkeit von 1 m pro Sekunde abgeschlossen werden kann; […]“"
                            },
                            {
                                "example_id": "09db1327-224e-43cd-bdb7-bbd3f0b2997a",
                                "sense_id": "73c13e44-284a-3373-a8ba-b2368f39e67c",
                                "text": "„Bei einer Kurtine als Bühnenabschluss muss eine zweite Auslösemöglichkeit außerhalb der Bühne eingerichtet und entsprechend gekennzeichnet sein.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca2c331b-aa8d-4c67-83a3-0287005feb5c",
                        "source_entry_id": "3d44f0ee-ea1c-354b-8ff8-582881229eeb",
                        "source_sense_id": "b6d1b782-e07a-35b9-b95c-88bf686552bd",
                        "target_lang_word": "courtine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ef0de44-c0a2-3926-8ead-0a2a6e319075",
                                        "entry_id": "36c3f9a2-5656-308a-b865-ba751fd79693",
                                        "glosses": [
                                            "Rideau servant à dissimuler ou à décorer un lit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0de9288-4841-4103-b21d-95e2ef335582",
                                                "sense_id": "0ef0de44-c0a2-3926-8ead-0a2a6e319075",
                                                "text": "Et tout ce qu’il vit, c’est que les courtines de son lit étaient closes, et que, pour sûr, elle était dedans."
                                            },
                                            {
                                                "example_id": "f18c505c-3d64-425b-aa78-8b5c58ead77c",
                                                "sense_id": "0ef0de44-c0a2-3926-8ead-0a2a6e319075",
                                                "text": "Il ferait beau voir qu'un grand coquin comme moi se prélassât sous les courtines, tandis qu'une fillette comme vous dormirait sur la dure. Ce serait le monde renversé !"
                                            },
                                            {
                                                "example_id": "6a354b98-de99-4837-8d41-f42f50a914fb",
                                                "sense_id": "0ef0de44-c0a2-3926-8ead-0a2a6e319075",
                                                "text": "Il y avait du même côté un second lit un peu plus petit, lui aussi demi-clos de courtines."
                                            },
                                            {
                                                "example_id": "75f2236c-ecd7-4e59-b0be-d2aca568897b",
                                                "sense_id": "0ef0de44-c0a2-3926-8ead-0a2a6e319075",
                                                "text": "J’avais capturé de mon séant, dans l’ombre de mes courtines, ce furtif papillon […]"
                                            },
                                            {
                                                "example_id": "11af87b0-b289-4f18-8630-a24e1023422a",
                                                "sense_id": "0ef0de44-c0a2-3926-8ead-0a2a6e319075",
                                                "text": "Parce que j’avais trop chaud l’été sous les courtines de reps du grand lit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd8b47ca-881d-31a9-8089-1d4f8cedf022",
                                        "entry_id": "36c3f9a2-5656-308a-b865-ba751fd79693",
                                        "glosses": [
                                            "Tenture disposée derrière un autel."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e89410b3-56ac-3ed7-8f6c-e9be205eb43b",
                                        "entry_id": "36c3f9a2-5656-308a-b865-ba751fd79693",
                                        "glosses": [
                                            "Mur ordinairement rectiligne, reliant deux bastions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4502db52-d2d1-43ec-bed4-b2c71bb7a799",
                                                "sense_id": "e89410b3-56ac-3ed7-8f6c-e9be205eb43b",
                                                "text": "Ici, on eût dit les ruines blanchies d’une ville, avec ses monuments, ses colonnes, ses courtines abattues […]"
                                            },
                                            {
                                                "example_id": "84dbc7db-a15b-452a-a1e7-2b6c77f9c17a",
                                                "sense_id": "e89410b3-56ac-3ed7-8f6c-e9be205eb43b",
                                                "text": "L’archer qui tout le long du jour se promenait sur la courtine, dès que le soleil brillait trop fort, rentrait dans l’échauguette, et s’endormait comme un moine."
                                            },
                                            {
                                                "example_id": "8d7e9d0d-0d5e-4efe-9d93-2441beef1a73",
                                                "sense_id": "e89410b3-56ac-3ed7-8f6c-e9be205eb43b",
                                                "text": "Les tours, espacées entre elles de 25 à 30 mètres environ, sont cylindriques à l’extérieur, terminées carrément du côté de la ville et réunies entre elles par de hautes courtines […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8bbee2a-603e-3899-b0d6-395a41b220f8",
                                        "entry_id": "36c3f9a2-5656-308a-b865-ba751fd79693",
                                        "glosses": [
                                            "Courses hippiques."
                                        ],
                                        "tags": [
                                            "plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e389b579-6b2e-434d-b820-e459c1f24d4b",
                                                "sense_id": "f8bbee2a-603e-3899-b0d6-395a41b220f8",
                                                "text": "Pendant des années, j’ai fréquenté les courtines. Je ne suis pas un flambeur invétéré, mais tout de même, il ne me déplaît pas d’exercer ma sagacité à la recherche d’un outsider."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf3a5958-6d4e-3994-957c-3e79d044d1b8",
                                        "entry_id": "36c3f9a2-5656-308a-b865-ba751fd79693",
                                        "glosses": [
                                            "En Aunis et Saintonge, longs filets disposés verticalement sur des piquets de 2 mètres de haut, formant sur l’estran un V, angle aigu à la pointe duquel sont concentrées les captures poussées par le jusant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3471c444-2b71-42f8-9269-476c74c7e4f8",
                                                "sense_id": "cf3a5958-6d4e-3994-957c-3e79d044d1b8",
                                                "text": "Il nous reste encore à parler de la courtine, procédé spécial au littoral d’Aunis."
                                            },
                                            {
                                                "example_id": "21bc9e65-af7c-44b8-b458-4b4c86351667",
                                                "sense_id": "cf3a5958-6d4e-3994-957c-3e79d044d1b8",
                                                "text": "En Saintonge, la place des femmes dans les activités maritimes était loin d’être anecdotique. … Elles tendaient aussi des courtines sur les vasières du coureau d’Oléron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eda67b45-e1a6-38d8-b6c5-ff8dbc0a04f9",
                                        "entry_id": "36c3f9a2-5656-308a-b865-ba751fd79693",
                                        "glosses": [
                                            "Tas de fumier."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45d5bafd-e138-4e43-9d3d-7a9bc59ab2e7",
                                                "sense_id": "eda67b45-e1a6-38d8-b6c5-ff8dbc0a04f9",
                                                "text": "C'est faire une grande faute de français, que d'employer, comme synonyme de FUMIER, le mot courtine, qui n'a que deux sens …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
