                                        "sense_id": "7b87b231-4958-3a72-9467-b58e75595249",
                                        "entry_id": "219ebc22-48f8-3f3d-9f28-cc269ca2154c",
                                        "glosses": [
                                            "Used when finding what one has been looking for or trying to recall, or on successful completion of a task."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "337977c2-39db-4b14-abcf-9bbaab0aa158",
                                                "sense_id": "7b87b231-4958-3a72-9467-b58e75595249",
                                                "text": "‘Some big, hard-boiled egg meets up with a pretty face, and bingo! He cracks up and melts.’"
                                            },
                                            {
                                                "example_id": "c72a850d-46c3-4f89-b228-7209edd54dc0",
                                                "sense_id": "7b87b231-4958-3a72-9467-b58e75595249",
                                                "text": "Just have to pick the bfast, lunch and dinner I feel most like eating today and – bingo!"
                                            },
                                            {
                                                "example_id": "e58589c2-3a53-47de-af0a-bd248e15327d",
                                                "sense_id": "7b87b231-4958-3a72-9467-b58e75595249",
                                                "text": "Megamind: Boingo!\nMinion: I think you mean \"bingo\", sir.\nMegamind: That's what I said. Boingo!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c613d9-2f31-3ce4-a0a5-0ffca66b07a9",
                                        "entry_id": "219ebc22-48f8-3f3d-9f28-cc269ca2154c",
                                        "glosses": [
                                            "Used to enthusiastically confirm or validate another speaker's point."
                                        ],
