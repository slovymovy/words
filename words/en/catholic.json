                    "frequency": "High",
                    "semantic_group_id": "religious_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The majority of the population in that country are <w>Catholics</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство населения в этой стране — <w>католики</w>.",
                                "zh": "那个国家的大部分人口都是<w>天主教徒</w>。"
                            }
                        },
                        {
                            "text": "He was raised as a <w>Catholic</w> but does not go to mass very often anymore.",
                            "target_lang_translations": {
                                "ru": "Он был воспитан как <w>католик</w>, но теперь не очень часто ходит к мессе.",
                                "zh": "他从小被当作<w>天主教徒</w>抚养长大，但现在已经不常去参加弥撒了。"
                            }
