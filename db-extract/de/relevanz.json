                "senses": [
                    {
                        "sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                        "entry_id": "c0922544-f988-36a8-9b92-f48128909e44",
                        "glosses": [
                            "Eigenschaft (in einem bestimmten Zusammenhang) wichtig, bedeutsam zu sein"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "8363f89d-ef01-436a-aa7d-c46bb5b345f4",
                                "sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                                "text": "Ich bezweifle die Relevanz dieses Beitrags für unser Projekt."
                            },
                            {
                                "example_id": "4ca18ed4-f409-4386-970e-53b0a79e6a43",
                                "sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                                "text": "„Maßstäbe für eine Rechtfertigung sind die Wahrhaftigkeit, Relevanz und Verständlichkeit des Gesagten.“"
                            },
                            {
                                "example_id": "6c42ae2f-5e4a-4d35-9d0c-a5ce38668e9b",
                                "sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                                "text": "„Bereits 1891 untersuchte der Soziologe Herbert Spencer, welche Themen in den Medien besonders hysterisch und aufgeregt behandelt wurden und welche Relevanz sie nach dem damaligen Stand der Forschung tatsächlich hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "185bfd5a-af37-4680-bb9d-4c86a953c211",
                        "source_entry_id": "c0922544-f988-36a8-9b92-f48128909e44",
                        "source_sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                        "source_sense_description": "bildungssprachlich: Eigenschaft (in einem bestimmten Zusammenhang) wichtig, bedeutsam zu sein",
                        "target_lang_word": "relevance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
