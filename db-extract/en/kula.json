            {
                "entry_id": "f9108964-f09f-3536-afa0-a529496c5171",
                "word": "kula",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1556a01d-a217-4630-bdd3-7cbbc206e5cf",
                        "entry_id": "f9108964-f09f-3536-afa0-a529496c5171",
                        "tags": [
                            "plural"
                        ],
                        "form": "kulas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ae9f6c8-b773-3b23-ba85-dc28c7203e23",
                        "entry_id": "f9108964-f09f-3536-afa0-a529496c5171",
                        "glosses": [
                            "A tower, turret or steeple in Southeast Europe erected during the period of Ottoman domination on the area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f66d4c-0b2d-47da-9897-12ffdf673429",
                                "sense_id": "6ae9f6c8-b773-3b23-ba85-dc28c7203e23",
                                "text": "Instead of the haïdooks, their next of kin, the zaptiés now hold a kula on the highest point of the pass; here one pauses to rest after scrambling up the vile Turkish road on one side of the ravine, and before scrambling down the vile Turkish road on the other."
                            },
                            {
                                "example_id": "4c0efd41-a9e7-4551-9adf-0d2112f54b84",
                                "sense_id": "6ae9f6c8-b773-3b23-ba85-dc28c7203e23",
                                "text": "The most important kulas of the Čengić-begs are those in Zagorje, in Rataji and the River Odžak near Ustikolina."
                            },
                            {
                                "example_id": "48f5b85f-b156-44c9-b1da-cccbf89ad2fd",
                                "sense_id": "6ae9f6c8-b773-3b23-ba85-dc28c7203e23",
                                "text": "The kulas were indeed like fortresses, with as many as twenty 'guns', i.e. adult men ready to fight."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
