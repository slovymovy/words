                ],
                "senses": [
                    {
                        "sense_id": "fe885bcd-dcdc-345c-8640-95b3266d4b53",
                        "entry_id": "0327439d-f722-3e1a-beb5-cd832d3c5738",
                        "glosses": [
                            "Methode, um ohne Hilfe anderer Personen den eigenen Körper und Geist in einen ruhigen und entspannten Zustand zu versetzen"
                        ],
                        "tags": [
                            "Psychotherapie",
                            "Selbsthilfe"
                        ],
                        "examples": [
                            {
                                "example_id": "3ef22640-2efd-43cc-b31d-12c923c436ee",
                                "sense_id": "fe885bcd-dcdc-345c-8640-95b3266d4b53",
                                "text": "„Bei dieser Selbstentspannungstechnik wird das vegetative Nervensystem auf den Ruhezustand umgeschaltet.“"
                            },
                            {
                                "example_id": "9e59fb9b-1942-46eb-9d88-f9f70c0ad4a6",
                                "sense_id": "fe885bcd-dcdc-345c-8640-95b3266d4b53",
                                "text": "„Autogenes Training ist eine Selbstentspannungstechnik, die den Anwendern hilft, sich zu entspannen, Stress abzubauen oder besser einzuschlafen.“"
                            },
                            {
                                "example_id": "c084805c-bf6f-41b5-9d11-3a35dc8526ab",
                                "sense_id": "fe885bcd-dcdc-345c-8640-95b3266d4b53",
                                "text": "„Die psychotherapeutische Selbstentspannungstechnik wurde 1932 vom Berliner Nervenarzt Johannes H. Schultz entwickelt.“"
                            },
                            {
                                "example_id": "7ad547b2-b051-4437-8906-bee8a04411bb",
                                "sense_id": "fe885bcd-dcdc-345c-8640-95b3266d4b53",
                                "text": "„Neben dem Erlernen einer Selbstentspannungstechnik wird die Wahrnehmungsfähigkeit für die gelähmte Körperseite und deren Integration in das Körperschema und das Selbstbild des Patienten unterstützt.“"
                            },
                            {
                                "example_id": "1a72a47b-eb5e-4d89-bcb6-ffd24236965d",
                                "sense_id": "fe885bcd-dcdc-345c-8640-95b3266d4b53",
                                "text": "„Heute findet diese Selbstentspannungstechnik sowohl im Alltag als auch in der Psychotherapie, aber auch bei Asthma, bronchialen oder rheumatischen Erkrankungen und Schlafstörungen Anwendung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
