                        "entry_id": "c989e437-4ccd-3ada-9df3-953442d97d53",
                        "glosses": [
                            "A very large molecule, especially used in reference to large biological polymers (e.g. nucleic acids and proteins)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4414276e-2ef1-4230-8437-3f66133759f3",
                                "sense_id": "0d4ba576-b24e-30a2-84ff-a26eb553bace",
                                "text": "Beadle discovered that genes carried instructions to build proteins—complex, multidimensional macromolecules that were the workhorses of the cell."
                            }
                        ]
                    }
                ],
