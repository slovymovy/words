                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02fe0a36-cb52-4051-9964-615b96e41f4d",
                        "source_entry_id": "8920197f-8b7c-3fe5-af36-91222fb28de1",
                        "source_sense_id": "82e511fb-25c6-3876-8383-108f2f37d558",
                        "source_sense_description": "state of being subconscious",
                        "target_lang_word": "podświadomość",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "podświadomość",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "fef4f9ba-d547-391c-bdb5-afe7b4f3337b",
                                        "entry_id": "dbbb0278-0c3e-3093-ac7c-f0f0a970cf9d",
                                        "glosses": [
                                            "element życia psychicznego, który nie jest poddawany kontroli świadomości"
                                        ],
                                        "tags": [
                                            "psychology"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f15b718a-1704-413a-a08b-8ef77d7c8b28",
                                                "sense_id": "fef4f9ba-d547-391c-bdb5-afe7b4f3337b",
                                                "text": "(…) treść bajek bardzo mocno zapada w dziecięcą podświadomość i wpływa, niestety, na kształtowanie poglądów"
                                            },
                                            {
                                                "example_id": "b8f9d02f-b430-4855-a83a-8c173d792182",
                                                "sense_id": "fef4f9ba-d547-391c-bdb5-afe7b4f3337b",
                                                "text": "Mój pies, biały, biegnie, spokojnie radosny wolnością przeżywaną naprawdę zapewne tylko przez podświadomość zwierząt, wyciągnięty, wolny, biegnie drogą, między zielenią, takim go zapamiętam na zawsze, mój „amicus\""
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f19e2bb9-7599-46b3-a390-7a2b34921660",
                        "source_entry_id": "8920197f-8b7c-3fe5-af36-91222fb28de1",
                        "source_sense_id": "82e511fb-25c6-3876-8383-108f2f37d558",
                        "source_sense_description": "state of being subconscious",
                        "target_lang_word": "подсозна́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подсозна́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7c042fcf-1070-36ad-be72-57e24ab880f2",
                                        "entry_id": "57b500a5-a476-336e-9de5-0952006fe091",
                                        "glosses": [
                                            "психол. совокупность психических процессов и состояний, протекающих без отображения их в сознании и помимо сознательного управления; мысли, чувства, представления, не вполне осознанные; область неясных, не вполне осознанных мыслей, чувств, представлений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3e9351e-47b6-4840-bb0e-9986c5d5364d",
                                                "sense_id": "7c042fcf-1070-36ad-be72-57e24ab880f2",
                                                "text": "Но самую дневную нашу логику направляет самое глубинное подсознание."
                                            },
                                            {
                                                "example_id": "67b4053d-3553-42ef-b3a4-b501d4d47d8e",
                                                "sense_id": "7c042fcf-1070-36ad-be72-57e24ab880f2",
                                                "text": "Это подсознание возвратило мне сном слышанное мною много лет тому назад объяснение, и я поняла, проснувшись, что мной самой указывалась дорога (как бывало в жизни не раз), путь, как победить что-то, что даже, в сущности, не было моим."
                                            },
                                            {
                                                "example_id": "cdf7a8ab-f142-471b-824b-e2a0a7c382f9",
                                                "sense_id": "7c042fcf-1070-36ad-be72-57e24ab880f2",
                                                "text": "Когда проблема не решается в лоб, полезно «отправить» её в подсознание."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
