                "senses": [
                    {
                        "sense_id": "a0176db9-0433-329a-85e5-491c73743373",
                        "entry_id": "9d2a2e3a-416c-34e7-aa12-2e6de267a629",
                        "glosses": [
                            "To join (two or more things) by anastomosis, to interconnect forming a network."
                        ],
                        "tags": [
                            "transitive",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "333e9392-4843-4273-9d8c-b27b51e688b6",
                                "sense_id": "a0176db9-0433-329a-85e5-491c73743373",
                                "text": "Happisburgh's humans discarded their stone tools close to one of several anastomosing, slow-flowing low-energy rivers, all of which meandered across a floodplain into a large estuary."
                            }
                        ]
                    },
                    {
                        "sense_id": "63ec4c32-fef9-3520-9727-a01e8d0a4ef3",
                        "entry_id": "9d2a2e3a-416c-34e7-aa12-2e6de267a629",
                        "glosses": [
                            "To join by anastomosis."
                        ],
                        "tags": [
                            "intransitive",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8a13d28b-63be-4c99-9a9f-90a03c2c449e",
                                "sense_id": "63ec4c32-fef9-3520-9727-a01e8d0a4ef3",
                                "text": "Within eukaryotic cells, distant branches of the tree of life entwine and melt into an inseparable new lineage; they fuse, or anastomose, as fungal hyphae do."
                            }
                        ]
                    }
                ],
