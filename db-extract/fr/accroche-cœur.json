        "fr-extract.jsonl": [
            {
                "entry_id": "f38757cd-9746-3dda-854a-fc57345fb8b6",
                "word": "accroche-cœur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "56035fc0-b177-41bc-ae30-b6b1c3ac2c6a",
                        "entry_id": "f38757cd-9746-3dda-854a-fc57345fb8b6",
                        "tags": [
                            "plural"
                        ],
                        "form": "accroche-cœurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                        "entry_id": "f38757cd-9746-3dda-854a-fc57345fb8b6",
                        "glosses": [
                            "Petite mèche de cheveux en forme de boucle, collée sur la tempe."
                        ],
                        "tags": [
                            "Mode"
                        ],
                        "examples": [
                            {
                                "example_id": "218a6a63-47e9-4123-a2f6-92a770d8a450",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "Mais, elle, tranquille, se collait des accroche-cœur sur le front avec de l'eau sucrée, recousait les boutons de ses bottines ou faisait un point à sa robe, les jambes nues, la chemise glissée des épaules, dans le désordre de ses cheveux ébouriffés."
                            },
                            {
                                "example_id": "ba1c826c-276e-453b-91cd-de1f97ea9a94",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "C’était un garçon blond et rose, avec une figure joufflue, sous des accroche-cœur luisants de pommade."
                            },
                            {
                                "example_id": "8b9e4f24-ec39-4a10-bf88-8237df58348a",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "Le temps de monter mes six étages, mon dîner était figé ; et je ne m’habitue pas à ces gens à accroche-cœur attablés en bas dans la gargote, ni à leurs éclaboussures d’argot, ni à leurs bouchons, ni à leurs boulettes de pain."
                            },
                            {
                                "example_id": "3b7170ce-afe5-4baf-b2a8-ab3bb08bc7f0",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "C’est ça qui a fait le mal : sa langue, et parce qu’il se coiffait avec des accroche-cœur en trempant ses cheveux de la fontaine et qu’il se foutait du parfum sur la gueule comme une femme de peu."
                            },
                            {
                                "example_id": "248b0d7a-d61f-4ca8-9b4f-1d1e06f42535",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "Il avait d’adorables sourcils allongés sur les tempes et qui se rejoignaient au milieu de front, des yeux séducteurs qui ensorcelaient, des cils aussi majestueux que l'empennage de l'aigle, des dents comme autant de perles dans l'écrin de la bouche, un accroche-cœur qui retombait doucement sur son front, des tempes ornées de boucles harmonieusement étagées, une stature élancée, des hanches délicates et des extrémités pleines de finesse."
                            },
                            {
                                "example_id": "ac3e586b-fbbb-4aa5-8e2c-4fde4a968e89",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "En ce qui me concerne, je me revis tout seul en compagnie de Carmen sur la scène du théâtre de Lunéville. Debout les bras en croix près de cette femme dont quelques cheveux en accroche-cœur m’avaient bouleversé, je faisais de mon corps un rempart contre l’attaque d’un éléphant surgi des coulisses."
                            },
                            {
                                "example_id": "d34e7307-a693-46e9-86a1-07c9e102d660",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "On dirait une actrice du cinéma muet. Elle est très brune, avec le teint très pâle, des yeux délimités au crayon noir, de longs cils, des accroche-cœurs et un bandeau dans les cheveux."
                            },
                            {
                                "example_id": "29ee8932-ac5f-4c49-9941-82e95745e5db",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "Enfermés les gitans d'Europe centrale, disparues les gypsies avec leurs robes de brocart, leurs pieds noircis de crasse, leurs mains vives, leurs accroche-cœurs."
                            },
                            {
                                "example_id": "c44058b3-359c-40be-a0e0-4321d800bd27",
                                "sense_id": "ad130b46-7019-37f4-a406-83e5102d8de3",
                                "text": "Y'a Rita et ses accroche-cœurs\nÀ l'enseigne de la Fille-sans-cœur."
                            }
                        ]
                    }
