                                "example_id": "6359d74e-54c6-4915-aa74-58fea1d2f4b5",
                                "sense_id": "40f8d07b-7340-3931-8cb6-a20268381432",
                                "text": "De politieke partij voert een intensieve electorale campagne voor de komende verkiezingen.",
                                "translation": "The political party is conducting an intensive electoral campaign for the upcoming elections.",
                                "english": "The political party is conducting an intensive electoral campaign for the upcoming elections."
                            },
                            {
                                "example_id": "1957659e-d0e0-4153-9fd8-2664e82f3ddd",
                                "sense_id": "40f8d07b-7340-3931-8cb6-a20268381432",
                                "text": "De peilingen geven inzicht in het electorale gedrag van de kiezers.",
                                "translation": "The polls provide insight into the electoral behavior of the voters.",
                                "english": "The polls provide insight into the electoral behavior of the voters."
                            },
                            {
                                "example_id": "db67c08a-dd5e-4c61-9861-b8f2f72a5af8",
                                "sense_id": "40f8d07b-7340-3931-8cb6-a20268381432",
                                "text": "De partijleider hield een electorale toespraak om de steun van het volk te winnen.",
                                "translation": "The party leader delivered an electoral speech to gain the support of the people.",
                                "english": "The party leader delivered an electoral speech to gain the support of the people."
                            },
                            {
                                "example_id": "7ac1ae24-b0cc-45de-89c6-5e9a2a7183eb",
                                "sense_id": "40f8d07b-7340-3931-8cb6-a20268381432",
                                "text": "De regering neemt belangrijke beslissingen in het kader van hun electorale beloften.",
                                "translation": "The government is making important decisions in line with their electoral promises.",
                                "english": "The government is making important decisions in line with their electoral promises."
