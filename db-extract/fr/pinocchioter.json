                "senses": [
                    {
                        "sense_id": "349bdbc8-f653-3a38-b8e1-0a0a72bc2a78",
                        "entry_id": "4ac4c0e8-e798-30b3-9307-9dce29ad6e4e",
                        "glosses": [
                            "Mentir."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "24bb5dc9-94a5-4dea-8e56-ea292c0db007",
                                "sense_id": "349bdbc8-f653-3a38-b8e1-0a0a72bc2a78",
                                "text": "Pas la peine de me pinocchioter !!! :kaola: J’ai tout vu, tout lu, tout entendu... plus tout ce qu’on m’a raconté en privé !"
                            },
                            {
                                "example_id": "324bc25e-689a-4de4-b02d-cb9246820a5f",
                                "sense_id": "349bdbc8-f653-3a38-b8e1-0a0a72bc2a78",
                                "text": "Gros bug et ambiance des grands soirs pour cause de démission négociée en pinocchiotant, sans perspective d’autre boulot."
                            },
                            {
                                "example_id": "6125c1d1-350d-4aa1-b115-eab589b8eb9f",
                                "sense_id": "349bdbc8-f653-3a38-b8e1-0a0a72bc2a78",
                                "text": "J’ai eu honte de prendre un test pour moi et j’ai pinocchioté à mort,.... lamentable je suis."
                            },
                            {
                                "example_id": "a562e789-331b-44d2-8f3a-5686668df722",
                                "sense_id": "349bdbc8-f653-3a38-b8e1-0a0a72bc2a78",
                                "text": "Je me suis fait pinocchioter misérablement (ou magnifiquement) par Laura (Marc)"
                            }
                        ]
                    }
