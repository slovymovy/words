                                        "examples": [
                                            {
                                                "example_id": "197c7c45-7174-454b-8c95-a69de7bf9cd1",
                                                "sense_id": "17213959-72c8-38a5-bcfe-b44637eb7727",
                                                "text": "Het is afwachten wat het effect zal zijn."
                                            },
                                            {
                                                "example_id": "bb84ef69-571c-4cfb-ae26-f2ffd07540b8",
                                                "sense_id": "17213959-72c8-38a5-bcfe-b44637eb7727",
                                                "text": "De aanpassing bracht niet het gewenste effect."
                                            },
                                            {
                                                "example_id": "5ce822a1-5668-41a0-a81b-76c4abacf68f",
                                                "sense_id": "17213959-72c8-38a5-bcfe-b44637eb7727",
                                                "text": "Mijn conclusie was dat het kwartje twee kanten op kon vallen, met een negatief of een positief effect als gevolg. Ik hoopte en vertrouwde op het laatste."
                                            },
                                            {
                                                "example_id": "39b935ad-31bc-4e6b-8ebe-ab324f871505",
                                                "sense_id": "17213959-72c8-38a5-bcfe-b44637eb7727",
                                                "text": "\"Het is dit jaar voor eerst dat we het effect zo duidelijk zien\", zegt voorzitter Rachel Heijne van Kringloop Nederland. \"We zien ook dat de kwaliteit van spullen gewoon echt slecht is. Het is kleding die na een paar keer wassen kapot gaat. Die kun je niet in de kringloop verkopen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bab3554-6f68-3ff1-b436-f91321d261ee",
                                        "entry_id": "c1ab0069-2227-3aaf-8907-81ad76c24732",
                                        "glosses": [
                                            "een op de kapitaalmarkt verhandeld waardepapier, zoals een obligatie of een aandeel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ccbab6-628f-44be-b33b-0735eb73bc33",
                                                "sense_id": "1bab3554-6f68-3ff1-b436-f91321d261ee",
                                                "text": "De topman kreeg een boete voor het niet melden van handel in effecten van het bedrijf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc988c0-e6da-3514-8302-c52157ac4a9e",
                                        "entry_id": "c1ab0069-2227-3aaf-8907-81ad76c24732",
                                        "glosses": [
                                            "afwijking van een bal als gevolg van de draaiing om z'n eigen as"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dc175ce-49a8-4867-99e5-b728c97c4be3",
                                                "sense_id": "3dc988c0-e6da-3514-8302-c52157ac4a9e",
                                                "text": "De aanvaller haalde met effect uit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "630777ad-5d08-4d85-ad40-45a7fc4274b0",
                        "source_entry_id": "396d8a9c-6e84-3e35-a808-5f1af437b196",
                        "target_lang_word": "dopad",
