                                                "example_id": "fcbee8c8-4c7b-450b-b353-5713e6791cae",
                                                "sense_id": "e0377031-4053-3657-bf2b-f436a6ffea41",
                                                "text": "„Dann griff er nach einem Blatt Papier, tauchte die Feder ins Tintenfass und skizzierte die europäischen und nordamerikanischen Küsten.“"
                                            },
                                            {
                                                "example_id": "271bfa95-3f3f-446d-8a7e-9d0d59d21d8e",
                                                "sense_id": "e0377031-4053-3657-bf2b-f436a6ffea41",
                                                "text": "„Er hat seinen Platz wie früher neben dem Kompass und dem Tintenfass.“"
                                            }
