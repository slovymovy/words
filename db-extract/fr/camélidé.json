                        "glosses": [
                            "Qui concerne les Camelidae, ruminants des régions arides, tels que le chameau ou le lama."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c233cf2-3658-4c6b-84dd-b359cd2bc373",
                                "sense_id": "2787f449-2517-3d5c-b11b-b368eb13e53f",
                                "text": "Viande camélidée."
                            },
                            {
                                "example_id": "c970c5eb-9d0d-4ab4-bd1b-b385fd718596",
                                "sense_id": "2787f449-2517-3d5c-b11b-b368eb13e53f",
                                "text": "Nous avons roulé de nouveau, encadrés par notre escorte camélidée dont, tassés sur nos sièges, nous ne voyions que les jambes cagneuses et crottées."
                            }
                        ]
                    }
                ],
