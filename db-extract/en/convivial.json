                                "target_senses": [
                                    {
                                        "sense_id": "a60c3c77-e6b9-3d4c-9d14-57b7488fc14c",
                                        "entry_id": "255e652e-9eb5-3b64-a46c-9621c24b6afe",
                                        "glosses": [
                                            "de kenmerken hebbend van een groep gezellen of een gezelschap"
                                        ],
                                        "tags": [
                                            "oorspronkelijk"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b745c1b3-15cd-3f4e-9d96-b61ab7046a66",
                                        "entry_id": "255e652e-9eb5-3b64-a46c-9621c24b6afe",
                                        "glosses": [
                                            "de sfeer oproepend van een levendige groep mensen die genoegen scheppen in elkaars aanwezigheid"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f17455d5-27be-31c7-8d95-0cd8cd8a914b",
                                        "entry_id": "255e652e-9eb5-3b64-a46c-9621c24b6afe",
                                        "glosses": [
                                            "sociaal aangenaam (in een gezelschap)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d22776-75b0-4372-abfc-95e5b1d78aeb",
                                                "sense_id": "f17455d5-27be-31c7-8d95-0cd8cd8a914b",
                                                "text": "Wat een gezellig diner!"
                                            },
                                            {
                                                "example_id": "3dbf943a-1f10-41d7-abdb-562ff87ea92d",
                                                "sense_id": "f17455d5-27be-31c7-8d95-0cd8cd8a914b",
                                                "text": "Het is - natuurlijk een cliché te denken dat kerels lekker even bekvechten en daarna gezellig een biertje aan de bar drinken zonder het nog ergens over te hebben."
                                            },
                                            {
                                                "example_id": "e2e5fea9-8410-4f2b-9c92-c024c82dcba8",
                                                "sense_id": "f17455d5-27be-31c7-8d95-0cd8cd8a914b",
                                                "text": "Iedereen had duidelijke taken, ik moest altijd afwassen. Het afwaswater werd tijdens het eten op het vuur verwarmd waarmee ik na de maaltijd de aangekoekte pannen schoon schrobde. Er leek geen einde aan te komen, maar het was altijd gezellig om de avonturen van de dag te bespreken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "024974b8-dc72-3452-8b94-b8cd376c097d",
                                        "entry_id": "255e652e-9eb5-3b64-a46c-9621c24b6afe",
                                        "glosses": [
                                            "knus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0cfbe03-a961-4d14-b668-07e7ac4e3fe3",
                                                "sense_id": "024974b8-dc72-3452-8b94-b8cd376c097d",
                                                "text": "Dit is een gezellige kamer."
                                            },
                                            {
                                                "example_id": "f317a2b4-d83a-43e1-8387-9bbd3200b9a9",
                                                "sense_id": "024974b8-dc72-3452-8b94-b8cd376c097d",
                                                "text": "'Wat bedoel je, Joy?' 'Er is toch wel iéts te doen hier? Een gezellig koffietentje, wat leuke kledingwinkeltjes?' 'Laat die man met rust,' zegt Lot tegen me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "829a8d09-736d-39bb-9987-c2c7ca51f17a",
                                        "entry_id": "255e652e-9eb5-3b64-a46c-9621c24b6afe",
                                        "glosses": [
                                            "leuk, onderhoudend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d95a905-bc32-42d1-8b29-df18088da477",
                                                "sense_id": "829a8d09-736d-39bb-9987-c2c7ca51f17a",
                                                "text": "Dit is een gezellige brief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
