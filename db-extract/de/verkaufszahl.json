                "senses": [
                    {
                        "sense_id": "95efc4b0-01df-3f44-83be-fa04b9b92737",
                        "entry_id": "415e7c0f-d71a-3cb3-9e6f-fb8ece2c20d6",
                        "glosses": [
                            "Menge der verkauften Gegenstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "640bcdf5-a9b5-4650-a4b9-175d4ba590dc",
                                "sense_id": "95efc4b0-01df-3f44-83be-fa04b9b92737",
                                "text": "„Trotz des Boykotts durch die meisten Radiosender sind die Verkaufszahlen ausgezeichnet.“"
                            },
                            {
                                "example_id": "b111f620-1b0d-47c1-ba0f-7b07671ced61",
                                "sense_id": "95efc4b0-01df-3f44-83be-fa04b9b92737",
                                "text": "„Selbst sehr genau die Verkaufszahlen seiner Bücher verfolgend, sah er zudem mit Zorn, manche meinen sogar mit Haß, die Auflagen und mit prominenter Besetzung erfolgenden Verfilmungen der Romane dieses »minderwertigen« Schriftstellers.“"
                            },
                            {
                                "example_id": "c4b87884-05d5-463f-81a7-f2b584b8ec8d",
                                "sense_id": "95efc4b0-01df-3f44-83be-fa04b9b92737",
                                "text": "„Seine Verkaufszahlen sind vermutlich die höchsten aller im Land gebliebenen Autoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
