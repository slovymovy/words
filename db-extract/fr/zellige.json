                ],
                "senses": [
                    {
                        "sense_id": "d68a3826-fe15-343c-b40f-55f441b54b94",
                        "entry_id": "d6d88490-c03d-3854-8e24-317df09d6574",
                        "glosses": [
                            "Carreau de faïence émaillé utilisé dans l’art maghrébin de la mosaïque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e09e64-26c4-43f2-8d85-aa443b6ccc6f",
                                "sense_id": "d68a3826-fe15-343c-b40f-55f441b54b94",
                                "text": "Le zellige est une terre cuite émaillée dans différentes teintes et taillée à la main dans diverses formes qui sert à décorer les murs, les colonnes et, parfois, les pavements."
                            },
                            {
                                "example_id": "913b9015-811a-41d6-9d9a-e284d5c88ac2",
                                "sense_id": "d68a3826-fe15-343c-b40f-55f441b54b94",
                                "text": "Gwilen en fait des objets plutôt haut de gamme, de différentes couleurs (grâce à des pigments naturels), formes et tailles, au prix du zellige ou du carreau de ciment."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ab235af-8176-3b47-84b2-3481725655a9",
                        "entry_id": "d6d88490-c03d-3854-8e24-317df09d6574",
                        "glosses": [
                            "La mosaïque en elle-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bcd169-555d-48f4-8c16-ef3c80d2c18e",
                                "sense_id": "4ab235af-8176-3b47-84b2-3481725655a9",
                                "text": "… une cuisine dans laquelle on peut dîner, une chambre pour chaque enfant, les sols des salles de bains sont recouverts d’un zellige découvert lors d’un week-end à Marrakech, leurs robes de mariées rangées dans leurs housses …"
                            }
                        ]
                    }
                ],
