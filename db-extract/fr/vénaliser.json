                "senses": [
                    {
                        "sense_id": "d9b846db-e4a3-307e-886f-031a15bc1e47",
                        "entry_id": "9452cd04-0aa4-3797-97a5-3b1d18e1281c",
                        "glosses": [
                            "Donner un caractère vénal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0e1b33c-8f07-4571-b92c-54fc070fe531",
                                "sense_id": "d9b846db-e4a3-307e-886f-031a15bc1e47",
                                "text": "Gardons-nous de tout ce qui peut ternir et vénaliser une belle cause."
                            },
                            {
                                "example_id": "c2887533-ae7a-40f7-9bb3-64f49bb3d977",
                                "sense_id": "d9b846db-e4a3-307e-886f-031a15bc1e47",
                                "text": "Face au capitalisme qui est une machine à tout vénaliser, nous devons dévénaliser."
                            },
                            {
                                "example_id": "107d9bef-b0bd-4797-b896-349616b66e5f",
                                "sense_id": "d9b846db-e4a3-307e-886f-031a15bc1e47",
                                "text": "Pourquoi s’étonnerait-on de voir le sexe se dissiper dans les incitations publicitaires ou les circuits de consommation ? Ou se vénaliser, comme le reste."
                            }
                        ]
                    }
