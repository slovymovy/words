    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c5482f8-da94-34b7-9ce6-e3c150cebd45",
                    "sense_definition": "Множество элементов, находящихся в отношениях и связях друг с другом, которое образует определённую целостность и единство.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солнечная <w>система</w> состоит из звезды и вращающихся вокруг неё планет.",
                            "target_lang_translations": {
                                "en": "The solar <w>system</w> consists of a star and planets orbiting it.",
                                "zh": "太阳<w>系统</w>由一颗恒星及其周围旋转的行星组成。"
                            }
                        },
                        {
                            "text": "Государственная <w>система</w> образования нуждается в постоянном развитии.",
                            "target_lang_translations": {
                                "en": "The state education <w>system</w> needs constant development.",
                                "zh": "国家教育<w>系统</w>需要不断发展。"
                            }
                        }
                    ],
                    "antonyms": [
                        "антисистема"
                    ],
                    "common_phrases": [
                        "солнечная система",
                        "нервная система",
                        "система образования",
                        "политическая система",
                        "система ценностей"
                    ],
                    "target_lang_definitions": {
                        "en": "A set of connected things or parts forming a complex whole.",
                        "zh": "由相互关联的事物或部分组成的复杂整体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "system",
                                "target_lang_sense_clarification": "general structure or organization"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系统",
                                "target_lang_sense_clarification": "指整体结构或组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03440387-3ca5-3e7e-814e-1adf5a8f5dea",
                    "sense_definition": "Стандартизованное техническое устройство, комплекс оборудования или программного обеспечения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На моём компьютере установлена новая операционная <w>система</w>.",
                            "target_lang_translations": {
                                "en": "A new operating <w>system</w> is installed on my computer.",
                                "zh": "我的电脑上安装了新的操作<w>系统</w>。"
                            }
                        },
                        {
                            "text": "В здании сработала пожарная <w>система</w>, и всех попросили выйти.",
                            "target_lang_translations": {
                                "en": "The fire <w>system</w> went off in the building, and everyone was asked to leave.",
                                "zh": "大楼里的消防<w>系统</w>启动了，所有人都被要求撤离。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "операционная система",
                        "поисковая система",
                        "платежная система",
                        "охранная система"
                    ],
                    "target_lang_definitions": {
                        "en": "A set of computer equipment and software, or a specific technical setup.",
                        "zh": "一套计算机设备和软件，或特定的技术装置。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "system",
                                "target_lang_sense_clarification": "computing or technical"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系统",
                                "target_lang_sense_clarification": "指计算机或技术设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1026331c-2a8a-3bab-b7d4-3c57f798d1dd",
                    "sense_definition": "Порядок, обусловленный правильным, планомерным расположением или связью частей; устойчивая закономерность.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В его тренировках есть строгая <w>система</w>, которой он следует каждый день.",
                            "target_lang_translations": {
                                "en": "There is a strict <w>system</w> in his training that he follows every day.",
                                "zh": "他的训练有一套严格的<w>系统</w>，他每天都照此执行。"
                            }
                        },
                        {
                            "text": "Без чёткой <w>системы</w> в работе трудно добиться хороших результатов.",
                            "target_lang_translations": {
                                "en": "Without a clear <w>system</w> at work, it is difficult to achieve good results.",
                                "zh": "工作中如果没有明确的<w>系统</w>，就很难取得好成绩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "систематичность",
                        "закономерность"
                    ],
                    "common_phrases": [
                        "войти в систему",
                        "делать по системе",
                        "отсутствие системы"
                    ],
                    "target_lang_definitions": {
                        "en": "A method or set of principles for doing something; orderliness and regularity.",
                        "zh": "做事的方法或原则；有序性和规律性。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "system",
                                "target_lang_sense_clarification": "method or plan"
                            },
                            {
                                "target_lang_word": "method",
                                "target_lang_sense_clarification": "way of doing something"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系统",
                                "target_lang_sense_clarification": "指方法或计划"
                            },
                            {
                                "target_lang_word": "方法",
                                "target_lang_sense_clarification": "指做事的方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4434e1f7-ce22-3651-8a71-4dc93b1dee88",
                    "sense_definition": "Комплекс бытовой записывающей и воспроизводящей аппаратуры (аудиосистема).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У соседа громко играет музыкальная <w>система</w>, и это мешает спать.",
                            "target_lang_translations": {
                                "en": "The neighbor's music <w>system</w> is playing loudly, and it keeps me from sleeping.",
                                "zh": "邻居的音乐<w>音响系统</w>声音开得很大，吵得我睡不着。"
                            }
                        },
                        {
                            "text": "Мы купили в гостиную новую акустическую <w>систему</w> с отличным звуком.",
                            "target_lang_translations": {
                                "en": "We bought a new sound <w>system</w> for the living room with excellent sound.",
                                "zh": "我们给客厅买了一套音质极佳的新型<w>音响系统</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
