                        "sense_id": "a98ab50d-1c07-309c-aeb7-865d8c3599be",
                        "entry_id": "a2cfd4fa-8c71-3597-a459-19e39b9d0947",
                        "glosses": [
                            "An unfrequented path; an indirect route; a byway."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb901e54-8803-4742-a667-2f462aff9dce",
                                "sense_id": "a98ab50d-1c07-309c-aeb7-865d8c3599be",
                                "text": "Having gone to Chiang Chou from Chü-wo by the northern route through Hou-ma, we returned over a bypath through mountains in the south which has been gradually elevated from the Fêng River valley by loess deposit."
                            },
                            {
                                "example_id": "0994b75b-7cc4-45b5-954c-745b81abb48c",
                                "sense_id": "a98ab50d-1c07-309c-aeb7-865d8c3599be",
                                "text": "During these days, the boy rode Sir Mortimer abroad in many directions until he knew every bypath within a radius of fifty miles of Torn. Sometimes the old man accompanied him, but more often he rode alone."
                            }
                        ]
                    }
                ],
