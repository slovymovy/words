                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "потроха́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1bdf68ea-39ae-30a3-a7d3-e1325c4638ff",
                                        "entry_id": "299f5565-453a-3e90-921e-7a2a827aa904",
                                        "glosses": [
                                            "разг. употребляемая в пищу часть внутренностей животных (птицы и рыбы, редк. о других животных)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c676e2e-d212-430f-8915-90227438df22",
                                                "sense_id": "1bdf68ea-39ae-30a3-a7d3-e1325c4638ff",
                                                "text": "Когда Петр Иванович съел две ложки рассольника с гусиными потрохами, в передней тихо позвонили."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "201f316d-6f25-3fa0-94eb-5012b023e404",
                                        "entry_id": "299f5565-453a-3e90-921e-7a2a827aa904",
                                        "glosses": [
                                            "перен., разг. то же, что внутренности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d15d81f-6b6b-495b-8219-bac0332b4cfd",
                                                "sense_id": "201f316d-6f25-3fa0-94eb-5012b023e404",
                                                "text": "У голландского рефрижератора была разбита вся задняя стенка так, что виднелись все потроха до передней стены фургона."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
