                                                "sense_id": "576e8ef3-4fd4-3752-9903-8e8d4960ffad",
                                                "text": "Moja sąsiadka bardzo głośno krzyczy, gdy ma szczyt."
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "b012ef7d-587e-3bd1-b1a7-2d667ebd2261",
                                        "entry_id": "25d35ba7-72ca-3111-bc78-82e87dcc276e",
                                        "glosses": [
                                            "ogólne określenie średniowiecznej tarczy piechoty i jazdy"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bd8b662-ec7e-41bf-b7d2-b01e7983acea",
                                                "sense_id": "b012ef7d-587e-3bd1-b1a7-2d667ebd2261",
                                                "text": "Zwarte w szeregu wojska szczyty tworzyły jakby ścianę przeciw pociskom nieprzyjaciela, a podniesione w górę nad głowami wojska, jakby dach broniły od pocisków z wierzchu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.7\""
                                    },
                                    {
                                        "sense_id": "2054b8f5-8cb6-3472-a03e-9963e98f27f1",
                                        "entry_id": "25d35ba7-72ca-3111-bc78-82e87dcc276e",
                                        "glosses": [
                                            "rycerska tarcza bojowa i turniejowa, na której umieszczano herb rodowy"
                                        ],
                                        "tags": [
