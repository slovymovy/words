                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b687ad-1a97-45d0-8bd9-fb6d7822b8d9",
                                "sense_id": "2dd6f26e-aaf2-37a7-a36b-d0696260dc54",
                                "text": "Il s’agit d’être parfait le jour J, quand s’ouvrira l’iwaimaku, le rideau de scène conçu pour les événements importants de la carrière d’un acteur."
                            },
                            {
                                "example_id": "614df236-8170-4650-a3ab-58c1ac6dab62",
                                "sense_id": "2dd6f26e-aaf2-37a7-a36b-d0696260dc54",
                                "text": "Lorsque j’ai eu 60 ans, le théâtre Kabuki-za de Ginza, à Tokyo, m’a contacté pour discuter de la commande d’un iwaimaku, un rideau de scène."
                            }
