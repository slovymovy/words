                "senses": [
                    {
                        "sense_id": "98903133-fd74-3711-9d6f-d35ba459aeaf",
                        "entry_id": "c70e0238-0ba8-384f-a4f5-a056cf4b0153",
                        "glosses": [
                            "qualifizierte Zusammensetzung der Einwohnerschaft einer topographischen Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9667279-d576-422c-8e45-246dd871957f",
                                "sense_id": "98903133-fd74-3711-9d6f-d35ba459aeaf",
                                "text": "„Im Gegenteil, er führt sogar dazu, dass sich ohnehin vorhandenen regionalen Unterschiede in der Bevölkerungsstruktur weiter verschärfen.“"
                            },
                            {
                                "example_id": "47ea03cf-702e-492e-b5c0-3d9bc8fba63c",
                                "sense_id": "98903133-fd74-3711-9d6f-d35ba459aeaf",
                                "text": "„Kriege und Katastrophen, die zu einer starken Veränderung der Bevölkerungsstruktur führen, können nämlich durchaus auch einen Einfluss auf die Sprachentwicklung haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
