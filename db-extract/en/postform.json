                                "sense_id": "e7cd76b6-2a74-3bf6-b4d3-7f004d474c18",
                                "text": "If you'd like to comment on this piece please send your comments using the postform below."
                            },
                            {
                                "example_id": "a05e150e-672e-4195-b200-81028a5a566d",
                                "sense_id": "e7cd76b6-2a74-3bf6-b4d3-7f004d474c18",
                                "text": "Send us your reasons, views and experiences using the postform."
                            }
                        ]
                    }
                ],
