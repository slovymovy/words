                ],
                "senses": [
                    {
                        "sense_id": "303a618a-fb60-37bb-800b-e668d630bd2f",
                        "entry_id": "dd15c597-d172-3132-be7c-205a87e952a1",
                        "glosses": [
                            "die Art und Weise, wie ein Raum (bewusst oder unbewusst) üblicherweise gelüftet wird"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "64895597-8f00-4db3-af0c-53d0ccf048ae",
                                "sense_id": "303a618a-fb60-37bb-800b-e668d630bd2f",
                                "text": "„An erster Stelle steht die Überprüfung der Lüftungsgewohnheiten.“"
                            },
                            {
                                "example_id": "441fb41e-10ba-41c6-a7c1-410f508cea99",
                                "sense_id": "303a618a-fb60-37bb-800b-e668d630bd2f",
                                "text": "„Bei diesen vielen \"Unbekannten\" ist es zwar nicht möglich, genaue Lüftungsregeln aufzustellen, man kann jedoch Anregungen geben, die zu neuen Lüftungsgewohnheiten führen. “"
                            },
                            {
                                "example_id": "2d3b0ef1-1064-4c6f-a343-7276edd35015",
                                "sense_id": "303a618a-fb60-37bb-800b-e668d630bd2f",
                                "text": "„Besonders die Benutzer von Wohnungen, die neue Fenster erhalten haben, sollten darauf achten, ihre Lüftungsgewohnheiten den neuen Gegebenheiten anzupassen.“"
                            },
                            {
                                "example_id": "7c1d4011-2b6b-4e9a-b04f-94c90bd4f5cb",
                                "sense_id": "303a618a-fb60-37bb-800b-e668d630bd2f",
                                "text": "„Moderne Heizanlagen haben die traditionellen Lüftungsgewohnheiten verändert.“"
                            },
                            {
                                "example_id": "48f4496e-8fca-4b09-bbbf-a752b824aab2",
                                "sense_id": "303a618a-fb60-37bb-800b-e668d630bd2f",
                                "text": "Im Winter bei geöffnetem Fenster zu schlafen, ist reine Energieverschwendung und eine schlechte Lüftungsgewohnheit."
                            },
                            {
                                "example_id": "21dccd7a-ba8f-45b5-a4ac-148e3a2977e9",
                                "sense_id": "303a618a-fb60-37bb-800b-e668d630bd2f",
                                "text": "„Schuld daran sind nicht die Fenster, sondern die Lüftungsgewohnheiten der Bewohner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
