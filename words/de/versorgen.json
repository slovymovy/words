            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d0408df-951d-3221-ae47-e6dba45f3107",
                    "sense_definition": "jemandem oder einer Sache lebensnotwendige oder benötigte Güter wie Strom, Wasser oder Nahrung zuführen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beliefern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das neue Kraftwerk wird die gesamte Region zuverlässig mit Strom <w>versorgen</w>."
                        },
                        {
                            "text": "Hilfsorganisationen <w>versorgen</w> die Menschen im Katastrophengebiet mit Trinkwasser und Lebensmitteln."
                        }
                    ],
                    "synonyms": [
                        "beliefern"
                    ],
                    "common_phrases": [
                        "mit Strom versorgen",
                        "mit Wasser versorgen",
                        "mit Lebensmitteln versorgen"
                    ]
                },
                {
                    "sense_id": "8dfbfae4-c940-3776-b7fd-cd37f2093da0",
                    "sense_definition": "für das persönliche Wohl oder die medizinische Pflege von jemandem Sorge tragen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "betreuen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Ärztin <w>versorgte</w> die blutende Wunde des Verletzten schnell und professionell."
                        },
                        {
                            "text": "Wer wird die Haustiere <w>versorgen</w>, wenn du für eine Woche im Urlaub bist?"
                        }
                    ],
                    "common_phrases": [
                        "eine Wunde versorgen",
                        "die Tiere versorgen"
                    ]
                },
                {
                    "sense_id": "51773ece-0307-38d8-b625-93fdccccaeeb",
                    "sense_definition": "Gegenstände an ihren dafür vorgesehenen Platz wegräumen oder ordentlich verstauen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verstauen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Einkauf <w>versorgte</w> sie alle Einkäufe ordentlich im Vorratsschrank."
                        },
                        {
                            "text": "Der Handwerker <w>versorgt</w> seine Werkzeuge sorgfältig in der Werkzeugkiste."
                        }
                    ],
                    "synonyms": [
                        "unterbringen",
                        "wegräumen"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "die Einkäufe versorgen",
                        "die Werkzeuge versorgen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "besonders in der Schweiz und in Süddeutschland"
                        }
                    ]
                }
            ]
        },
