                                        "entry_id": "37b301c2-32ec-39eb-85f2-5eb739092dd6",
                                        "glosses": [
                                            "The attitude of seeing oneself as a victim, especially in a way that is self-absorbed or indulgent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
