                    "sense_id": "175ff869-2e08-3be2-84b6-75cdcdc52344",
                    "sense_definition": "Serving to connect other things together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Conjunctions frequently function as <w>linking</w> words in a sentence.",
                            "target_lang_translations": {
                                "ru": "Союзы часто функционируют как <w>связующие</w> слова в предложении.",
                                "es": "Las conjunciones funcionan con frecuencia como palabras <w>de enlace</w> en una oración.",
                                "fr": "Les conjonctions fonctionnent fréquemment comme mots <w>de liaison</w> dans une phrase."
                            }
                        },
                        {
                            "text": "There is no <w>linking</w> evidence to prove he was at the scene of the crime.",
                            "target_lang_translations": {
                                "ru": "Нет никаких <w>связывающих</w> доказательств, подтверждающих, что он был на месте преступления.",
                                "es": "No hay pruebas <w>concluyentes</w> que demuestren que estuvo en la escena del crimen.",
                                "fr": "Il n'y a aucune preuve <w>le reliant</w> pour démontrer qu'il était sur les lieux du crime."
                            }
                        }
                    ],
                    "synonyms": [
                        "connecting",
                        "joining"
                    ],
                    "antonyms": [
                        "separating",
                        "disconnecting"
                    ],
                    "common_phrases": [
                        "linking verb",
                        "linking word"
                    ],
                    "target_lang_definitions": {
