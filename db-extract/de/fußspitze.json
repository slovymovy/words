                ],
                "senses": [
                    {
                        "sense_id": "afe9b410-48ee-305b-9982-c7d8a5e079c2",
                        "entry_id": "265f504a-0e04-31db-83a2-fdb036362fd5",
                        "glosses": [
                            "der vordere Teil eines Fußes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c40db3d-a0f1-4f85-bfe2-bda835b3a59a",
                                "sense_id": "afe9b410-48ee-305b-9982-c7d8a5e079c2",
                                "text": "„Lamm begann es zu schwindeln, und mich strengte das Anziehen der Fußspitze immer mehr an, und ich fühlte das Blut an der Fußsohle klopfen.“"
                            },
                            {
                                "example_id": "7bf78832-1770-44e6-ad4b-f8d7bed00346",
                                "sense_id": "afe9b410-48ee-305b-9982-c7d8a5e079c2",
                                "text": "„Dr. Böttcher und Wiegand huschen auf Fußspitzen hinaus.“"
                            },
                            {
                                "example_id": "00938326-e42e-4d9c-8273-a251e6517dcc",
                                "sense_id": "afe9b410-48ee-305b-9982-c7d8a5e079c2",
                                "text": "„Sisi bemerkte, dass er beim Stottern mit der linken Fußspitze auf den Boden tippte und dabei die Hände knetete.“"
                            },
                            {
                                "example_id": "e9a95821-d792-45b0-8cfb-00d93c16129d",
                                "sense_id": "afe9b410-48ee-305b-9982-c7d8a5e079c2",
                                "text": "„Es waren sehr viele Gäste anwesend, und ich trat auf Fußspitzen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
