                "senses": [
                    {
                        "sense_id": "f200f927-2ee0-30f5-9428-7544ac1dac95",
                        "entry_id": "411c8a54-bd4a-3e71-926b-5bb4b2b4e692",
                        "glosses": [
                            "zanieczyszczenie powietrza zalegające nad terenami miejskimi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff512f89-729e-40d0-b13b-b000452b934a",
                                "sense_id": "f200f927-2ee0-30f5-9428-7544ac1dac95",
                                "text": "Światło gazowych latarń mazało listopadową mgłę w żółte plamy. Monachijska noc krztusiła się miejskim smogiem"
                            },
                            {
                                "example_id": "4d968ca3-5728-46f0-b69b-78ce70f78bd5",
                                "sense_id": "f200f927-2ee0-30f5-9428-7544ac1dac95",
                                "text": "Tylko kilka z dużych polskich miast nękanych motoryzacyjnymi smogami zdecydowało się obniżyć podatek drogowy na samochody z katalizatorami spalin"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8aa5ecd1-ca38-494e-b97f-e0771e3e6b3f",
                        "source_entry_id": "411c8a54-bd4a-3e71-926b-5bb4b2b4e692",
                        "source_sense_id": "f200f927-2ee0-30f5-9428-7544ac1dac95",
                        "target_lang_word": "smog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                        "entry_id": "0177898d-70d5-3832-8961-e978ba883546",
                                        "glosses": [
                                            "A noxious mixture of particulates and gases that is the result of urban air pollution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "474c21d9-2278-4acd-b839-e9ea5f2db1d7",
                                                "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                                "text": "A widow since 1967, she lives now in Honolulu because, she says, she can enjoy the Californialike climate without the smog."
                                            },
                                            {
                                                "example_id": "64bd860e-09c8-4e95-9377-2831f0343992",
                                                "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                                "text": "Everyone smoked so if the auditorium was full, the whole room would be filled with smoke in next to no time. It was like the legendary London smog of the 1950s in there sometimes. You took it in turn to “flash the ash” as it was called."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e06f842-e01a-3fe9-b553-5f4b1158d828",
                                        "entry_id": "e1e20b67-f4dd-3bc4-9a72-ecc39d68ad2b",
                                        "glosses": [
                                            "To get a smog check; to check a vehicle or have it checked for emissions."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d3d3f49-b7af-46b7-a68e-a1384035fe82",
                                                "sense_id": "1e06f842-e01a-3fe9-b553-5f4b1158d828",
                                                "text": "If the car is more than five years old, you'll have to have it smogged before you can register it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
