                        "source_sense_id": "103cd62f-5da0-352d-8fa7-18ff63c03104",
                        "target_lang_word": "kratzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kratzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9df2dc53-91f2-33ea-a07d-084dc131f041",
                                        "entry_id": "a8a4817b-ace0-31f9-8fbf-dad88f24c42f",
                                        "glosses": [
                                            "so rau beschaffen, dass es Abrieb verursacht, wenn es über etwas streift; beziehungsweise sich so anfühlt, als ob"
                                        ],
                                        "tags": [
                                            "besonders bezogen auf Kleidung auf der Haut und auf Speisen im Mund",
                                            "im Hals"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69770dd0-e847-4d6d-a9c9-16ae9ec95b27",
                                                "sense_id": "9df2dc53-91f2-33ea-a07d-084dc131f041",
                                                "text": "Vorbei [sind] die Zeiten, als Jugendherberge oft für kratzige Wolldecken, quietschende Stockwerkbetten und verzuckerten Pfefferminztee stand."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eaaab393-517d-3e1b-ae6b-85b3802570e4",
                                        "entry_id": "a8a4817b-ace0-31f9-8fbf-dad88f24c42f",
                                        "glosses": [
                                            "heiser"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8c92de8-cc9e-4649-8bea-82e7e891f1ed",
                                                "sense_id": "eaaab393-517d-3e1b-ae6b-85b3802570e4",
                                                "text": "Nach seiner Rehabilitation kehrte er [Jack Klugmann] aber 1993 erfolgreich auf die Theaterbühne zurück - nur seine durchdringende knurrige Stimme war fortan ein wenig schwächer und kratziger."
                                            },
                                            {
                                                "example_id": "eb4d2c2b-2d95-40ce-943e-9eb46f0cb4ac",
                                                "sense_id": "eaaab393-517d-3e1b-ae6b-85b3802570e4",
                                                "text": "An diesem Tag [14. Mai 1948] wurde in einem Museum in Tel Aviv der Staat Israel ausgerufen. Ein paar leicht verschwommene Schwarz-Weiß-Bilder, verwackelte Filmaufnahmen und eine kratzige Tonaufnahme zeugen von diesem Ereignis."
                                            }
                                        ],
