                        ],
                        "examples": [
                            {
                                "example_id": "f49754ac-5cf1-4318-b1ad-1e8356bc8188",
                                "sense_id": "b09d6092-dec0-3368-a8d3-581ffba028c7",
                                "text": "Een nieuwe fabriek op de Maasvlakte kan volgens de onderzoekers in een belangrijk deel van de toekomstige behoefte aan waterstof voorzien. Bedrijven in de Rotterdamse haven en het Havenbedrijf zijn enthousiast. \"Waterstof is een essentiële grondstof die de verduurzaming van het hele havencomplex kan bewerkstelligen\", zegt Allard Castelein van het Havenbedrijf Rotterdam."
                            },
                            {
                                "example_id": "c4d61cfe-0508-42ec-9f6f-b92e182007b9",
                                "sense_id": "b09d6092-dec0-3368-a8d3-581ffba028c7",
                                "text": "\"Het havencomplex stoot een kleine 20 procent van alle CO2 van Nederland uit\", zegt hij. \"Dus wil Nederland die reductie halen, dan zal de haven moeten meedoen.\""
                            },
                            {
                                "example_id": "c69d9285-6a0d-417b-b8d5-a4bf506bbefb",
                                "sense_id": "b09d6092-dec0-3368-a8d3-581ffba028c7",
                                "text": "In totaal zullen de baggeraars voor de 24 meter diepe vaargeul zo'n 250 miljoen kubieke meter zand moeten weghalen. Ter vergelijking: voor de aanleg van de Tweede Maasvlakte voor de haven van Rotterdam werd 240 miljoen kubieke meter zand verplaatst. Daarvoor had het baggerbedrijf toen drie jaar de tijd."
                            }
                        ]
                    }
