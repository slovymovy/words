                "senses": [
                    {
                        "sense_id": "a342e1a4-4e56-35af-b542-168d5450f226",
                        "entry_id": "3872c3cc-f0d2-3c38-a60a-5ed5ddccbeec",
                        "glosses": [
                            "Einrichtung, in der versucht wird, psychische Krankheiten zu heilen; Psychiatrie"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "11164189-0f97-4b20-8a20-64ae8255985a",
                                "sense_id": "a342e1a4-4e56-35af-b542-168d5450f226",
                                "text": "„In der Nervenheilanstalt Haar hinter München flattern zwei entflogene Wellensittiche durch die Büsche, ein kanariengelber und ein grüner."
                            },
                            {
                                "example_id": "8059c43d-8447-47dd-876d-b0baaad2d8c0",
                                "sense_id": "a342e1a4-4e56-35af-b542-168d5450f226",
                                "text": "Als sie eine Psychose erlitt, verbrachte sie mehrere Monate in einer Nervenheilanstalt."
                            },
                            {
                                "example_id": "890be060-0f59-481c-a5e5-a015f174f488",
                                "sense_id": "a342e1a4-4e56-35af-b542-168d5450f226",
                                "text": "„Am Abend des 26. Februar 1854 entschied Schumann in einem klaren Moment, sich in eine Nervenheilanstalt einweisen zu lassen.“"
                            },
                            {
                                "example_id": "4c6451b0-dfba-4bec-9e8e-771f87e44f5f",
                                "sense_id": "a342e1a4-4e56-35af-b542-168d5450f226",
                                "text": "„Doktor Gruber schlug vor, sie für ein paar Wochen in einer Nervenheilanstalt unterzubringen, dass sie dort zur Ruhe käme.“"
                            },
                            {
                                "example_id": "308c1f4f-b291-4cf9-af77-f1e3da8bbdc6",
                                "sense_id": "a342e1a4-4e56-35af-b542-168d5450f226",
                                "text": "„Das Ehepaar wurde in die Nervenheilanstalt Burghölzli gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
