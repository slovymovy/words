                    {
                        "translation_id": "b74dc60b-3f2f-4c3f-a2fd-2780f56acefd",
                        "source_entry_id": "ef7aa289-e4ba-3190-8d52-c0b254e06093",
                        "source_sense_description": "daughter of Tantalus",
                        "target_lang_word": "Niobe",
