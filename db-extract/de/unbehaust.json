                    },
                    {
                        "form_id": "167c09e8-afd5-41c0-ac4f-b4990337070c",
                        "entry_id": "e8dd6e32-2300-309e-a371-84363b97c5d2",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unbehaust"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e480e6a-2efd-32af-b1f6-30e6cbbd061d",
                        "entry_id": "e8dd6e32-2300-309e-a371-84363b97c5d2",
                        "glosses": [
                            "ohne eine Wohnung, Unterkunft; auf der Straße lebend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cacd4a76-9f03-487e-8eef-06d755f456c6",
                                "sense_id": "2e480e6a-2efd-32af-b1f6-30e6cbbd061d",
                                "text": "„Der Mensch ist aus dem Haus eines Systems geworfen worden und be:ndet sich nun unbehaust wie auf einem freien Feld und auf sich selbst zurückgeworfen.“"
                            },
                            {
                                "example_id": "f097ad80-77e4-438f-bf5b-47534384354e",
                                "sense_id": "2e480e6a-2efd-32af-b1f6-30e6cbbd061d",
                                "text": "„Ihre Helden wandeln unbehaust, meist von Leidenschaft und Todessehnsucht getrieben, durch eine unberechenbare Welt.“"
                            },
                            {
                                "example_id": "f8e45127-6648-4e93-b046-0b8e0de8ee23",
                                "sense_id": "2e480e6a-2efd-32af-b1f6-30e6cbbd061d",
                                "text": "„Der Mensch wurde aus dem Paradies verstoßen und lebt seither »unbehaust« als Wanderer und Fremder in dieser Welt.“"
                            },
                            {
                                "example_id": "eec2063d-cc1b-4e90-9e68-ffd5a205ac20",
                                "sense_id": "2e480e6a-2efd-32af-b1f6-30e6cbbd061d",
                                "text": "„Sie waren seit dem Frühstück unbehaust, da sie ihre Hotelzimmer und Ferienwohnungen für die nachfolgenden Gäste räumen mussten.“"
                            },
                            {
                                "example_id": "f5d27088-212c-4533-b1ab-b22b70d37479",
                                "sense_id": "2e480e6a-2efd-32af-b1f6-30e6cbbd061d",
                                "text": "„Der aufgeklärte Hölderlin findet sich in eine unbehauste Welt verstoßen, in der das innige Verhältnis zur Natur und Gesellschaft zerfallen ist; die Kunst wird zum Medium der Sehnsucht nach der verlorenen Einheit.“"
                            },
                            {
                                "example_id": "28ff7ea7-85be-4b24-bdc3-c8c806c3fa0a",
                                "sense_id": "2e480e6a-2efd-32af-b1f6-30e6cbbd061d",
                                "text": "„Wie ein ätherischer Engel wandert diese Prinzessin durch Paris, wo sich das Phantastische und das Reale kreuzen: Eine unbehauste Wanderin zwischen den Welten, fremd zieht sie ein, fremd zieht sie wieder aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00ba9cea-5731-315f-86f6-bcde1519b4da",
                        "entry_id": "e8dd6e32-2300-309e-a371-84363b97c5d2",
                        "glosses": [
                            "nicht bewohnt, besiedelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2bd0a4e-39f3-473a-b9fd-c2e2e1578b3a",
                                "sense_id": "00ba9cea-5731-315f-86f6-bcde1519b4da",
                                "text": "„Sie flohen in eine abgelegene, unbehauste Gegend: in die urwüchsigen Wälder des Harzes.“"
                            },
                            {
                                "example_id": "cf3b47de-0bb3-45b7-8835-b4e02f2d9fdf",
                                "sense_id": "00ba9cea-5731-315f-86f6-bcde1519b4da",
                                "text": "„Er tat kund, dass dies keine unbehauste Gegend war, sondern Menschen dieses Land für sich beanspruchten.“"
                            },
                            {
                                "example_id": "ed1b6e73-3d34-41ca-875c-47b211768b5c",
                                "sense_id": "00ba9cea-5731-315f-86f6-bcde1519b4da",
                                "text": "„Ich habe häufig geglaubt, nichts als eine unbehauste Landschaft zu durchreisen, bis ich plötzlich gewahr wurde, dass ich am Eingang eines Dorfes stand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
