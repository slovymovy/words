                ],
                "senses": [
                    {
                        "sense_id": "4a79cca6-725b-35f4-966c-07c21a48ac05",
                        "entry_id": "a4335167-5e3a-3924-b97a-200701417b56",
                        "glosses": [
                            "Vertreter der Gattung der Birken aus der Familie der Birkengewächse"
                        ],
                        "tags": [
                            "Betula",
                            "Betulaceae"
                        ],
                        "examples": [
                            {
                                "example_id": "cd1ed36f-3611-455d-ba57-817fbeeb7e16",
                                "sense_id": "4a79cca6-725b-35f4-966c-07c21a48ac05",
                                "text": "„Die Sand-Birke (Betula pendula) ist ein mittelgroßer Laubbaum und wird ca. 20 - 25 m hoch und bis zu 9 m breit.“"
                            },
                            {
                                "example_id": "aeb0ea4f-a067-44c6-84c5-cf2eef909f9c",
                                "sense_id": "4a79cca6-725b-35f4-966c-07c21a48ac05",
                                "text": "„Baumarten wie z.B. die Sand-Birke setzen vor allem auf eine Strategie, schnell überall zur Stelle zu sein, schnell zu wachsen und schnell Nachkommen zu erzeugen.“"
                            },
                            {
                                "example_id": "3f10b80f-ce99-4893-922b-3583ff272d74",
                                "sense_id": "4a79cca6-725b-35f4-966c-07c21a48ac05",
                                "text": "„In Mitteleuropa vom Tiefland bis in 1800 m Höhe verbreitet, in lichten Wäldern, auf Heiden und Mooren; nimmt mit fast jedem Boden vorlieb, selbst mit sandigem, nährstoffarmen Untergrund, deshalb auch der Name Sand-Birke; in Hänge- und Säulenform als Ziergehölz gepflanzt.“"
                            },
                            {
                                "example_id": "f23e4617-645b-40c2-8421-4bf2ee65c6c2",
                                "sense_id": "4a79cca6-725b-35f4-966c-07c21a48ac05",
                                "text": "„Neben der Rotbuche werden vermutlich auch Sand-Birke, Spitz- und Berg-Ahorn, Berg-Ulme und Winter-Linde von den Klimaänderungen in der Gesamtbilanz nur wenig betroffen sein.“"
                            },
                            {
                                "example_id": "e74ac465-a353-45f5-ac73-156c8270f7ca",
                                "sense_id": "4a79cca6-725b-35f4-966c-07c21a48ac05",
                                "text": "„Der verbreitestste Laubbaum ist heute die Sand-Birke (Betula pendula), die sowohl auf der Hochfläche als auch im Uferbereich zu schönen Exemplaren heranwächst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
