                "senses": [
                    {
                        "sense_id": "fe32ab79-c7ef-34e5-8fe1-ac701c1de9ed",
                        "entry_id": "a3c23706-ccbc-35d2-9744-5325a9b12df3",
                        "glosses": [
                            "von einer Organisation/Gemeinschaft ausgeschlossene Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "266649e0-a846-4b7d-a678-573ff04bb53b",
                                "sense_id": "fe32ab79-c7ef-34e5-8fe1-ac701c1de9ed",
                                "text": "„Ich würde mein Land verlassen und als einsamer Ausgestoßener, von meinem Volk abgeschnitten, durch die Städte ziehen müssen.“"
                            },
                            {
                                "example_id": "59dcb0d3-b0a5-4a57-8524-34e87ef55abe",
                                "sense_id": "fe32ab79-c7ef-34e5-8fe1-ac701c1de9ed",
                                "text": "„Jeder Daimyo, der sich gegen den Shogun stellte, stand in offener Rebellion gegen den Thron, galt als Ausgestoßener und ging seiner Lehen verlustig.“"
                            }
                        ],
