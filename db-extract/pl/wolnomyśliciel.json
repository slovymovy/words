                                                "example_id": "9bc06097-d2bd-4e9a-af5d-17687c8d249a",
                                                "sense_id": "4cfc9c64-9ecb-3e5d-8f98-2b24555906f4",
                                                "text": "The report projected that in the Asia-Pacific region, the proportion of freethinkers is projected to decline from 21 per cent in 2010 to 17 per cent in 2050."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
