                "translations": [
                    {
                        "translation_id": "4739c361-2e0c-4c92-903c-ca7df7ad4270",
                        "source_entry_id": "2bd0dfb1-3863-3766-b0f7-cf86d5af8220",
                        "source_sense_description": "слизь, выделившаяся из одной ноздри",
                        "target_lang_word": "snot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "994a3472-a298-3a9d-972d-5b01cc62ebec",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "Mucus, especially mucus from the nose."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa36b87-e889-4ac2-97cb-57ff89ff708a",
                                                "sense_id": "994a3472-a298-3a9d-972d-5b01cc62ebec",
                                                "text": "Once, I remember, the little fair-haired boy had a choking fit at dinner, and a stream of snot ran out of his nose on to his plate in a way horrible to see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca7ca02-069d-33db-b389-36ccda399252",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "A contemptible child."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e6c6859-c81b-49e7-8b44-d88430e60804",
                                                "sense_id": "5ca7ca02-069d-33db-b389-36ccda399252",
                                                "text": "With no warning a gang of little snots — none larger or older than I was — threw me to the ground, pulled my knickers below my knees — without any explanation, and allowed me to get up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d859a-ce0a-3909-acc2-1d2d73dad2e7",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "A mean fellow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2fc5f90-f2fb-3e97-83c7-aa2d1d7f65ad",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "The flamed out wick of a candle."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7f75154-92b1-3b6d-a5bd-5f0ba649121e",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "A blemish or encumbrance that one exercises out of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca331436-b716-49cd-b750-3267ae377286",
                                                "sense_id": "f7f75154-92b1-3b6d-a5bd-5f0ba649121e",
                                                "text": "Working the snot out of shoulders at full flexion and extension end ranges with isometrics can not only be the hidden key to creating more available range of motion for immobile, injury-prone shoulders, but also to help develop dormant muscle groups like the rear delts, which otherwise get little to no play in exercises intended for them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae055c02-d7da-3158-8756-7ea66ac38290",
                                        "entry_id": "41895e33-c06d-398b-8a0f-26b2da0ff4c5",
                                        "glosses": [
                                            "To blow, wipe, or clear (the nose)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1956f113-9824-39a7-b2b9-19e3346a16ff",
                                        "entry_id": "41895e33-c06d-398b-8a0f-26b2da0ff4c5",
                                        "glosses": [
                                            "To sniff or snivel; to produce snot, to have a runny nose."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a41d7b0e-9af0-45c9-91b8-c0f5170de786",
                                                "sense_id": "1956f113-9824-39a7-b2b9-19e3346a16ff",
                                                "text": "I was snotting all into my mouth and having to eat it, silently shuddering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3955921-6eac-4843-9f80-ceeed1f11cc0",
                        "source_entry_id": "2bd0dfb1-3863-3766-b0f7-cf86d5af8220",
                        "source_sense_description": "слизь, выделившаяся из одной ноздри",
                        "target_lang_word": "Rotz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rotz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                        "entry_id": "7d02b3db-5e43-31cc-9f67-0f0a1a0703e6",
                                        "glosses": [
                                            "schleimartiges Nasensekret"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbb4cb78-7d2e-49c2-a43f-e57bd6923a0d",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "Er putzte sich den Rotz mit einem Taschentuch von der Nase."
                                            },
                                            {
                                                "example_id": "5266e225-3c2c-44b6-929f-e4ada502f8e9",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "Ich war dermaßen erkältet, ich hatte hohes Fieber und der Rotz lief in Strömen."
                                            },
                                            {
                                                "example_id": "f1c858dd-45fa-41de-8c77-8a2d85af1dd0",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "„Da kommen üble Trollweiber vor, die rülpsen und furzen und ewig unbändigen Hunger haben auf Menschenfleisch. Oder Riesen, denen der Rotz nur so aus der Nase trieft.“"
                                            },
                                            {
                                                "example_id": "00b91bc5-616d-4638-b2fe-48a0cf0d13ca",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "„Das Taschentuch, vor dem er sich ekelte, hatte er weggeworfen, der verletzte Finger brannte, und die Nase lief so heftig, daß er angewidert dazu überging, den Rotz mit der bloßen Hand herauszuschneuzen.“"
                                            },
                                            {
                                                "example_id": "63176395-ea88-4da9-a59d-e554e9fd17be",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "„Aus der Nase lief ihm ständig der Rotz, uns so löste seine gesamte Erscheinung bei den anderen Kindern Ekel und Furcht aus.“"
                                            },
                                            {
                                                "example_id": "8154b5b9-5008-49ac-a656-883f00262b97",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "„Auch zieht er gern den Rotz durch die Nase.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                        "entry_id": "7d02b3db-5e43-31cc-9f67-0f0a1a0703e6",
                                        "glosses": [
                                            "bakterielle Infektion bei Unpaarhufern, vor allem bei Pferden"
                                        ],
                                        "tags": [
                                            "Veterinärmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "553d9ed9-b789-442e-810c-46f8df295339",
                                                "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                                "text": "Rotz kann auf den Menschen übergehen und dann auch tödlich sein."
                                            },
                                            {
                                                "example_id": "823540cf-7ecf-42b6-b638-b24ad0145a3f",
                                                "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                                "text": "Mein Pferd hatte Rotz, deshalb mussten wir es einschläfern lassen."
                                            },
                                            {
                                                "example_id": "8287da68-aa57-46de-95bd-ef623d505d17",
                                                "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                                "text": "Der Rotz ist hochgefährlich und kann auch auf den Menschen übergehen."
                                            },
                                            {
                                                "example_id": "bdbd4d4a-7eed-451a-a430-e22b271232ed",
                                                "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                                "text": "Die Behandlung von an Rotz erkrankten Tieren ist aussichtslos und verboten. Sie werden sofort getötet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9e2c10b4-d15f-37cb-a02c-68900e1f9dcb",
                                        "entry_id": "7d02b3db-5e43-31cc-9f67-0f0a1a0703e6",
                                        "glosses": [
                                            "Zeug, unleidige Sache"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3f528d0-1857-4d3e-923e-67881b0fb696",
                                                "sense_id": "9e2c10b4-d15f-37cb-a02c-68900e1f9dcb",
                                                "text": "Als es beim dritten Mal wieder nicht funktioniert hat, habe ich den ganzen Rotz einfach in die Tonne gehauen."
                                            },
                                            {
                                                "example_id": "0ba56da6-9a3f-498b-acfd-18adff1558cb",
                                                "sense_id": "9e2c10b4-d15f-37cb-a02c-68900e1f9dcb",
                                                "text": "Was ist denn das für ein Rotz?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
