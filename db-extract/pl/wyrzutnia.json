                                "target_senses": [
                                    {
                                        "sense_id": "4bff9f64-c01c-38cf-bafd-86dcd1e39274",
                                        "entry_id": "e5c3d78c-265c-3aab-9844-28457541123c",
                                        "glosses": [
                                            "One who or that which launches. A device that throws something or the person who initiates a launch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcb3e751-8d02-497a-aee6-08ed76f7587a",
                                                "sense_id": "4bff9f64-c01c-38cf-bafd-86dcd1e39274",
                                                "text": "The catapult made a good launcher for the small projectile."
                                            },
                                            {
                                                "example_id": "7fa97431-6e07-4004-a51d-b78b02a57341",
                                                "sense_id": "4bff9f64-c01c-38cf-bafd-86dcd1e39274",
                                                "text": "They shot down the helicopter with a rocket launcher."
                                            },
                                            {
                                                "example_id": "cb5edcf4-b62c-47eb-926e-e4e4cfcf88a9",
                                                "sense_id": "4bff9f64-c01c-38cf-bafd-86dcd1e39274",
                                                "text": "This actually occurs in perception of non-colliding Michotte displays: Even though there is a gap between the launcher stopping and the launchee starting, the launchee's motion appears to have been caused, at a distance, by the approach of the launcher […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd7b3fd-8575-37b1-91f5-7e33e5eeda6a",
                                        "entry_id": "e5c3d78c-265c-3aab-9844-28457541123c",
                                        "glosses": [
                                            "An application that launches another or others, often holding icons or menus for frequently used programs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab31a2c1-ffc6-4fe6-b817-de6f5f2a6cf8",
                        "source_entry_id": "30fa4e0c-d417-385d-acd6-c3d203518f9a",
                        "source_sense_id": "3a5e4cda-a946-32d7-9ae8-d9163d56a0c8",
