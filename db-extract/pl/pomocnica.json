                                    },
                                    {
                                        "sense_id": "5f59a401-4a15-345f-a4a4-c8bd798c974f",
                                        "entry_id": "3bdd989f-b932-3122-9fe4-d61439978fe5",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent du verbe aider."
                                        ],
