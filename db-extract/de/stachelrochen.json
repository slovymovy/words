                                        "glosses": [
                                            "A device that simulates a cell tower, used to intercept cell phone communications."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4068443-4491-4477-9d50-fd2f88fe08c3",
                                                "sense_id": "5cc9494b-5253-3362-a409-8084efe6d275",
                                                "text": "The device mimics a cell phone tower and gets the phone to connect to it. […] Once a signal is found, the stingray measures its strength and can provide a general location on the map."
                                            }
                                        ]
                                    }
