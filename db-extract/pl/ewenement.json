                    },
                    {
                        "sense_id": "e331de8f-16af-3512-a504-f316b4f210c8",
                        "entry_id": "33dee695-64e4-37bd-9059-1bebbac8cc43",
                        "glosses": [
                            "rzecz o nieoczekiwanych właściwościach lub sławie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ace67f5b-ffc3-4fdf-93d1-73a26ca1698f",
                                "sense_id": "e331de8f-16af-3512-a504-f316b4f210c8",
                                "text": "był ewenementem"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e77e9221-273e-3876-bee6-880002f71fbc",
                        "entry_id": "33dee695-64e4-37bd-9059-1bebbac8cc43",
                        "glosses": [
                            "praktyka odbiegająca (zazwyczaj, ale niekoniecznie, negatywnie) od normy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a657f217-fbc7-46d0-b3ee-7cab06c41c32",
                                "sense_id": "e77e9221-273e-3876-bee6-880002f71fbc",
                                "text": "Za sterami samolotów wożących nasze VIP-y już wkrótce mają zasiąść piloci cywilni. To ewenement na skalę światową – w innych krajach w kabinach takich maszyn zasiadają piloci wojskowi."
                            },
                            {
                                "example_id": "24ba67fd-13fa-4ba8-a330-d944ec34c049",
                                "sense_id": "e77e9221-273e-3876-bee6-880002f71fbc",
                                "text": "w Polsce urlop tacierzyński to ciągle ewenement"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1ca5e61-56c5-4c58-9447-c2866dc5d1a2",
                        "source_entry_id": "33dee695-64e4-37bd-9059-1bebbac8cc43",
                        "source_sense_id": "ffc8d78a-1980-3bdc-9d5c-be64cec34393",
                        "target_lang_word": "évènement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évènement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0f30a8b-bd97-31d6-954e-4b443ef983ac",
                                        "entry_id": "a01f7c4a-deff-3e0d-bc8d-aa3f8f7c360c",
                                        "glosses": [
                                            "Fait qui survient à un moment donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d3ae67c-3fb9-4054-903c-1a4bdf0dca8d",
                                                "sense_id": "f0f30a8b-bd97-31d6-954e-4b443ef983ac",
                                                "text": "Solange, jusqu’alors, avait toujours pris les événements de sa vie avec une certaine insouciance."
                                            },
                                            {
                                                "example_id": "b007a41b-9bc0-484a-9d33-a92540b4f6e1",
                                                "sense_id": "f0f30a8b-bd97-31d6-954e-4b443ef983ac",
                                                "text": "Rien n’est plus malaisé que l’exploitation méthodique d’un évènement du cœur, rien ne s’amortit plus vite que les ondes d’un coup de foudre."
                                            },
                                            {
                                                "example_id": "f639576e-d056-470c-8249-90c592c75326",
                                                "sense_id": "f0f30a8b-bd97-31d6-954e-4b443ef983ac",
                                                "text": "Tu me plais, quel évènement. Emmanuelle Riva [actrice du film Hiroshima mon amour] sépare le P et le L et dit : plais. Et le ai, puis le é et le è, et tout ça, tous ces sons ouverts, l’horizon s’ouvre."
                                            },
                                            {
                                                "example_id": "63c5c308-4f41-4a79-b64b-7a8b15e1ce85",
                                                "sense_id": "f0f30a8b-bd97-31d6-954e-4b443ef983ac",
                                                "text": "Tous les 52 ans, le calendrier sacré de 260 jours coïncidait avec le calendrier solaire de 365 jours. Cet événement était attendu dans la crainte ; […]."
                                            },
                                            {
                                                "example_id": "436fe5f2-2e84-40ce-a270-fbeb4ca03ac5",
                                                "sense_id": "f0f30a8b-bd97-31d6-954e-4b443ef983ac",
                                                "text": "Ensuite, la prise en charge des problématiques informationnelles et médiatiques ne saurait se limiter à la gestion d’un évènement en général tellement chargé émotionnellement (attentats, guerres) que la prise de distance nécessaire à la structuration de connaissances n’est pas possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fc7cc40-1a44-3a30-8adb-291e2766ffd1",
                                        "entry_id": "a01f7c4a-deff-3e0d-bc8d-aa3f8f7c360c",
                                        "glosses": [
                                            "Péripétie, fait raconté ou mis en action au théâtre, dans un roman, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f546e2f-2b35-45bd-9d42-55881e001205",
                                                "sense_id": "0fc7cc40-1a44-3a30-8adb-291e2766ffd1",
                                                "text": "Ah ! c’était curieux à voir, l’embarquement de Dieudonné pour Rio de Janeiro, c’est moi qui vous le dis ! Ce fut un évènement."
                                            },
                                            {
                                                "example_id": "274484bb-fe7e-4fa7-8964-4100e075b5bb",
                                                "sense_id": "0fc7cc40-1a44-3a30-8adb-291e2766ffd1",
                                                "text": "Les évènements se pressent, se multiplient dans cet acte."
                                            },
                                            {
                                                "example_id": "ae49e635-480a-4af5-878c-76e06cd44418",
                                                "sense_id": "0fc7cc40-1a44-3a30-8adb-291e2766ffd1",
                                                "text": "Ce roman est plein d’évènements inattendus qui excitent la curiosité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd3585be-9669-3657-8d1e-5d267629033a",
                                        "entry_id": "a01f7c4a-deff-3e0d-bc8d-aa3f8f7c360c",
                                        "glosses": [
                                            "Issue de quelque chose que ce soit un succès ou un échec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c442213-763d-4b8a-ac07-a645cb187ac5",
                                                "sense_id": "fd3585be-9669-3657-8d1e-5d267629033a",
                                                "text": "Les évènements lui donnèrent tort."
                                            },
                                            {
                                                "example_id": "b8407a03-0f3f-41d2-8f08-acbccb7b5501",
                                                "sense_id": "fd3585be-9669-3657-8d1e-5d267629033a",
                                                "text": "Se préparer à tout évènement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c568653d-9893-3fbb-a5e4-a08133dbbdba",
                                        "entry_id": "a01f7c4a-deff-3e0d-bc8d-aa3f8f7c360c",
                                        "glosses": [
                                            "Ensemble de résultats d’une épreuve aléatoire, partie de l’univers associé à cette dite épreuve."
                                        ],
                                        "tags": [
                                            "Probabilités"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5e0aa89-5268-46fb-a201-fb8f56608490",
                                                "sense_id": "c568653d-9893-3fbb-a5e4-a08133dbbdba",
                                                "text": "Pour un jet de dé à six faces, on peut considérer l’évènement {2 ; 4 ; 6}, c’est-à-dire l’obtention d’un chiffre pair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9a9d0b-e065-3e80-be15-dbe2182aa680",
                                        "entry_id": "a01f7c4a-deff-3e0d-bc8d-aa3f8f7c360c",
                                        "glosses": [
                                            "Désigne parfois la dernière phase d’une bataille, la manœuvre finale qui doit décider de la victoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcded53a-bc83-4d7b-8ff3-c9c13114e377",
                                                "sense_id": "7b9a9d0b-e065-3e80-be15-dbe2182aa680",
                                                "text": "L’entrée en ligne de la réserve produisit l’évènement de la journée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37048290-750f-3922-b090-dba65e8e8e3e",
                                        "entry_id": "a01f7c4a-deff-3e0d-bc8d-aa3f8f7c360c",
                                        "glosses": [
                                            "Action pouvant en déclencher d'autres qui écoutaient son apparition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f3d3a53-3371-4bc1-80d9-e14952649331",
                        "source_entry_id": "33dee695-64e4-37bd-9059-1bebbac8cc43",
                        "source_sense_id": "ffc8d78a-1980-3bdc-9d5c-be64cec34393",
                        "target_lang_word": "événement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "événement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                        "entry_id": "6478adb6-2c53-33fc-8d74-5d9f3501b4da",
                                        "glosses": [
                                            "Variante orthographique de évènement."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4695e5c6-4d00-4b25-b74b-97bbca8a4c2d",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "Une accusation de complot contre la vie de Napoléon III fut abandonnée par prudence ; l’idée était dans l’air, on craignait d’évoquer l’événement."
                                            },
                                            {
                                                "example_id": "86e1957a-2742-4e18-b33a-1283ae14c7fd",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "Ces légers événements s’évanouissent comme des scènes de comédie sur lesquelles le rideau tombe."
                                            },
                                            {
                                                "example_id": "0b14ee03-2c2c-4568-86da-a2d783e33b74",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "Cet événement a pour but de créer, en priorité chez les jeunes, une véritable culture de la sécurité routière en leur apportant les connaissances et les compétences nécessaires pour devenir des usagers de la route responsables et prudents."
                                            },
                                            {
                                                "example_id": "40bd5970-6246-4b06-801e-83e828a0fee6",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "Ce fut un événement parisien du plus haut chic."
                                            },
                                            {
                                                "example_id": "b17e4c83-78e9-471b-acb4-95ecf31415ba",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "Les événements où vous pourriez sombrer avant longtemps seront des événements européens."
                                            },
                                            {
                                                "example_id": "32b2454e-8e4e-49c6-a887-f6971cd74a93",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "Peut-être attendait-il que les événements se précisassent avant de sortir de son maintien."
                                            },
                                            {
                                                "example_id": "c647f2e0-f5ef-49dd-9170-99dda0f47ea7",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "[…] la comtesse fit incarcérer le meurtrier et, après jugement, celui-ci fut pendu. L’exécution eut lieu le jour de Pourim. Quand le roi, informé de l’événement, sut qu’un de ses sujets avait été hissé à la potence le jour où les juifs célébraient, par des réjouissances, le souvenir de la pendaison d’Aman, il entra en fureur."
                                            },
                                            {
                                                "example_id": "d5073927-1b4f-4a6d-b995-8953e0d188ab",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "Sans remonter à l’événement traumatique fondateur que furent les massacres de la Saint-Barthélemy, on rappellera que la minorité réformée fut l'objet, sous Louis XIV, d'un « mémoricide » sans précédent : […]."
                                            },
                                            {
                                                "example_id": "c26096a3-bd41-4aef-9e0d-9762245e8d28",
                                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                                "text": "Alain Badiou définit l'événement comme quelque chose qui sort de la loi immédiate des choses, qui vient remplir un vide dans une situation, mais sans faire partie de la situation même."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
