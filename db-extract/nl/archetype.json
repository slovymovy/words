                "senses": [
                    {
                        "sense_id": "4bd7e754-23e4-374e-976f-dd1e0d682d45",
                        "entry_id": "209b4049-a905-3344-b4fd-ce46d513f0ae",
                        "glosses": [
                            "oermodel dat ten grondslag ligt aan latere varianten"
                        ],
                        "tags": [],
