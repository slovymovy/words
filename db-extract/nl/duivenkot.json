                "senses": [
                    {
                        "sense_id": "fe9d90be-36cb-3dde-b9d7-3c734ff3309e",
                        "entry_id": "c2de49b5-d417-3efb-a580-85c1a1ffbb8b",
                        "glosses": [
                            "duivenhok voor meerdere duiven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c4394c-96cd-4e7e-90e0-616921713bbb",
                                "sense_id": "fe9d90be-36cb-3dde-b9d7-3c734ff3309e",
                                "text": "Samen met Stijn een pizzakoerier volgen naar Hanne in 'het duivenkot', het leek een eenvoudige opdracht tot er plots meerdere koeriers opdoken. Ík wist dat de rechtse de foute zou zijn, dus heb ik Stijn in die richting proberen leiden. Zodra hij me volgde, moest ik hem gewoon aanmoedigen.'"
                            },
                            {
                                "example_id": "5dd425ed-9039-40c0-a083-76b6b45db6cc",
                                "sense_id": "fe9d90be-36cb-3dde-b9d7-3c734ff3309e",
                                "text": "Bobbejaan Schoepen scoorde als artiest hits met nummers als \"Café zonder bier\"(1959), een cover van \"Pub without beer\"van Slim Dusty, \"De lichtjes van de Schelde\"(1952) en Ïk zien zo gere mijn duivenkot\"(1950). Andere bekende liedjes van hem zijn Äls mijn kanarievogel zingt\"(1952), Ïk heb eerbied voor jouw grijze haren\"(1960) en \"Twee ogen zo blauw\"(1965)."
                            },
                            {
                                "example_id": "f2b6042d-e48f-444d-887a-5bf5b388d80f",
                                "sense_id": "fe9d90be-36cb-3dde-b9d7-3c734ff3309e",
                                "text": "In het Kafka-rariteitenkabinet staan onder meer een opgezette duif, een mosselpot, een speelgoedvliegtuig en sabels. Die illustreren het afschaffen van onzinnige wetten zoals de verplichting voor burgemeesters om jaarlijks een inventaris van duivenkoten in hun gemeente te maken, het verbod op het plukken van mosselen aan onze kust, het verbod om te fotograferen uit vliegtuigen en de afschaffing van het duel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2054a9bf-fa2c-4ff9-bc74-d5b3990ef9bc",
                        "source_entry_id": "c2de49b5-d417-3efb-a580-85c1a1ffbb8b",
                        "source_sense_id": "fe9d90be-36cb-3dde-b9d7-3c734ff3309e",
                        "target_lang_word": "Taubenschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taubenschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                        "entry_id": "5823d365-4104-3c9d-83ff-745a05399f37",
                                        "glosses": [
                                            "Verschlag, der Haustauben Schutz vor Witterungseinflüssen und natürlichen Feinden bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d282d4b6-a3dc-468f-a7b8-756e77ec81d1",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "Auf der Flucht vor einem Habicht konnte sich die Taube in den Taubenschlag retten."
                                            },
                                            {
                                                "example_id": "69e584e9-96a8-4d01-8ab3-d14c3f2cbd37",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Er forderte von der Stadt eine vorübergehende Aufhebung des Fütterungsverbotes und neue Taubenschläge zur kontrollierten Haltung der Vögel, um deren \"Leid\" in den Griff zu bekommen.“"
                                            },
                                            {
                                                "example_id": "e39b3944-6a6c-431e-b908-04699a9a290d",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Kosole erzählt, dass er heute Nachmittag seinen Taubenschlag reparieren will.“"
                                            },
                                            {
                                                "example_id": "c384c44f-17c1-45ea-8945-0401cd51d066",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„In einer Ecke des Hühnerhofs wurde ein Taubenschlag aufgestellt.“"
                                            },
                                            {
                                                "example_id": "2c2ac939-ad5f-479a-a5f6-6e1ff14e3451",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Die Welle der Kelter erschien ihnen riesenhaft; dann stiegen sie in den Taubenschlag hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d837c703-d24b-4812-bda7-23e3715abf63",
                        "source_entry_id": "c2de49b5-d417-3efb-a580-85c1a1ffbb8b",
