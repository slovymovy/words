                        "entry_id": "e0ef18de-d499-3947-b39b-9ac27991669f",
                        "glosses": [
                            "brede, houten spaan met aangescherpte snijkant en een handvat, bestemd om de vlas- en hennepvezels te verwijderen van de scheven uit de gedroogde stengels"
                        ],
                        "tags": [
                            "vlasbewerking"
                        ],
                        "examples": [
                            {
                                "example_id": "63207af4-ab09-41a9-babd-79165ff3f9dd",
                                "sense_id": "e75f4e5a-4bb6-3fef-9313-90444c5f7021",
                                "text": "Daarna werd het vlas zorgvuldig binnenste buiten gekeerd en nog eens met de zwingel beslaan totdat alle lemen er uit waren."
                            }
                        ]
                    }
