                        "entry_id": "54fd201e-277a-3a2e-9597-6a8424152361",
                        "glosses": [
                            "die Zahnwurzel eines Zahnes bedeckende äußerste Schicht als Teil des Parodontiums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c81269-42ac-4560-9008-ace64c6a3257",
                                "sense_id": "1fa9371c-5613-378f-9e9f-20a3fca957f0",
                                "text": "„Die im Wurzelzement verankerten desmodontalen Kollagenfaserbündel dienen der Befestigung des Zahns in der knöchernen Alveole.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
