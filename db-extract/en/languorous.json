                        "form_id": "f2716b38-a059-4a6d-9e9d-2537599045d3",
                        "entry_id": "3ec8aa08-6994-3473-8a1a-8b27f07ac578",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more languorous"
                    },
                    {
                        "form_id": "03c3c485-cac4-40fa-b54d-c2c6b9c62a32",
                        "entry_id": "3ec8aa08-6994-3473-8a1a-8b27f07ac578",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most languorous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86b347a3-314b-35a7-8040-a61d2f9b429a",
                        "entry_id": "3ec8aa08-6994-3473-8a1a-8b27f07ac578",
                        "glosses": [
                            "lacking energy, spirit, liveliness or vitality; languid, lackadaisical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c01a364f-cbcc-4c59-ae4d-0b1a6a83937f",
                                "sense_id": "86b347a3-314b-35a7-8040-a61d2f9b429a",
                                "text": "The atmosphere beneath is languorous, and is so tinged with azure that what artists call the middle distance partakes also of that hue, while the horizon beyond is of the deepest ultramarine."
                            },
                            {
                                "example_id": "0178d880-1f03-4c24-b72b-a9b48f2786ce",
                                "sense_id": "86b347a3-314b-35a7-8040-a61d2f9b429a",
                                "text": "Warm as a Lesbian valley's afternoon Made langourous ^([sic]) with June"
                            },
                            {
                                "example_id": "ab4cd83a-06a3-4635-86c0-d62a1bcff8d4",
                                "sense_id": "86b347a3-314b-35a7-8040-a61d2f9b429a",
                                "text": "8 August 2018, Ignatiy Vishnevetsky in AV Club, Jason Statham fighting a giant shark should be a lot more fun than The Meg\nAfter a languorous stretch of exposition that introduces a lot of pseudoscientific mumbo-jumbo and enough supporting characters to fill a Dickens novel (played by the likes of Rainn Wilson, Cliff Curtis, and Ruby Rose), we follow a three-person submersible down to the ocean depths."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4407cf12-690c-496a-9327-044e45ac2951",
                        "source_entry_id": "3ec8aa08-6994-3473-8a1a-8b27f07ac578",
                        "source_sense_id": "86b347a3-314b-35a7-8040-a61d2f9b429a",
                        "source_sense_description": "lacking energy, spirit, liveliness or vitality; languid, lackadaisical",
                        "target_lang_word": "langoureux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "langoureux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc034e3-0623-390f-adf8-5618e257f635",
                                        "entry_id": "825d543c-6a75-3ede-9108-d5fd5d82dfdf",
                                        "glosses": [
                                            "Qui est en langueur."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9692cb67-7551-4ec2-8836-175644b36791",
                                                "sense_id": "7fc034e3-0623-390f-adf8-5618e257f635",
                                                "text": "Il a été longtemps malade, il est encore tout langoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4273b32-a9f7-33ab-b792-18ff1a0c4d6c",
                                        "entry_id": "825d543c-6a75-3ede-9108-d5fd5d82dfdf",
                                        "glosses": [
                                            "Qui est doucereux et fade dans ses manières de séduire."
                                        ],
                                        "tags": [
                                            "Par dérision"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e5dab9-6e88-4663-9b1d-4542c54acf2a",
                                                "sense_id": "f4273b32-a9f7-33ab-b792-18ff1a0c4d6c",
                                                "text": "Faire le langoureux auprès d’une femme."
                                            },
                                            {
                                                "example_id": "1267b0fd-104f-4544-ba15-32c32f85fbd5",
                                                "sense_id": "f4273b32-a9f7-33ab-b792-18ff1a0c4d6c",
                                                "text": "Aussi amoureusement que possible, avec des yeux langoureux, il lui répond :\n— Je vais bien. Je crois qu’il va pleuvoir…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cf7af56-c88f-3108-a868-ee6a6172b734",
                                        "entry_id": "825d543c-6a75-3ede-9108-d5fd5d82dfdf",
                                        "glosses": [
                                            "Qui rappelle la langueur du sentiment amoureux."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3a2ac51-a7bd-4f98-8e81-d669e3b3c850",
                                                "sense_id": "4cf7af56-c88f-3108-a868-ee6a6172b734",
                                                "text": "Des tangos langoureux, une mélodie, une valse gaie et pour finir « Jalousie », qui est un de mes gros succès."
                                            },
                                            {
                                                "example_id": "a38b0b48-c8bf-4913-b8b1-24029fe597a3",
                                                "sense_id": "4cf7af56-c88f-3108-a868-ee6a6172b734",
                                                "text": "Nous dansions sur les chansons yéyé et sur les slows langoureux avec les premiers tourne-disques à pile, une vraie révolution pour l’époque, de la musique sans électricité. Quel progrès !"
                                            },
                                            {
                                                "example_id": "1ad7b146-57e6-4fa0-914e-3e861c19dd44",
                                                "sense_id": "4cf7af56-c88f-3108-a868-ee6a6172b734",
                                                "text": "La rock star la bouffe du regard un moment puis l’attrape par la taille et se colle derrière elle pour suivre ses mouvements langoureux. Ils finissent par s'embrasser passionnément, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
