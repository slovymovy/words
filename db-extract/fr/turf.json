                                    {
                                        "sense_id": "0529ad6b-374e-3afa-a881-fc560209cc10",
                                        "entry_id": "1561764d-782d-3299-9ecc-49e6f878d25b",
                                        "glosses": [
                                            "To throw a frisbee well short of its intended target, usually causing it to hit the ground within 10 yards of its release."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5247495-cbbb-3eca-aed0-3e62ac05a993",
                                        "entry_id": "1561764d-782d-3299-9ecc-49e6f878d25b",
                                        "glosses": [
                                            "To fire from a job or dismiss from a task."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "386f7dda-8010-4603-9c38-1dd2dac06d9e",
                                                "sense_id": "a5247495-cbbb-3eca-aed0-3e62ac05a993",
                                                "text": "Eight managers were turfed after the merger of the two companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c2b3c8b-1e3c-3e80-922e-a319e47e02de",
                                        "entry_id": "1561764d-782d-3299-9ecc-49e6f878d25b",
                                        "glosses": [
                                            "To cancel a project or product."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce40458-ca05-40d0-ae76-0da8233ba053",
                                                "sense_id": "7c2b3c8b-1e3c-3e80-922e-a319e47e02de",
                                                "text": "The company turfed the concept car because the prototype performed poorly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7cfdf6b-3955-32d1-8456-dc71f29fd4cf",
                                        "entry_id": "1561764d-782d-3299-9ecc-49e6f878d25b",
                                        "glosses": [
                                            "To expel, eject, or throw out; to turf out."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "097b54f7-b146-4a13-bab5-28d056b16ac9",
                                                "sense_id": "c7cfdf6b-3955-32d1-8456-dc71f29fd4cf",
                                                "text": "He has the mistaken idea that he is a lap dog, and loves to be nursed, especially by ladies, but eighty-five pounds on your lap is no joke, and he can never understand why he gets turfed off."
                                            },
                                            {
                                                "example_id": "dea83484-7cbd-4a3f-9f6e-f552b9d4d9b8",
                                                "sense_id": "c7cfdf6b-3955-32d1-8456-dc71f29fd4cf",
                                                "text": "At the same time as College was being unceremoniously turfed from their premises, a similar process was affecting the Estcourt School."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e90f225a-15a4-3fe4-8965-d47a773699fe",
                                        "entry_id": "1561764d-782d-3299-9ecc-49e6f878d25b",
                                        "glosses": [
                                            "To transfer or attempt to transfer (a patient or case); to eschew or avoid responsibility for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb3217f1-37bd-4619-99be-2135487c3609",
                                                "sense_id": "e90f225a-15a4-3fe4-8965-d47a773699fe",
                                                "text": "\"Sure thing, I buffed her, and they turfed her to urology, but she bounced back to me!\" […] They want to transfer responsibility for her to another branch of the hospital (turf her)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd85e313-b850-4221-a1ad-971bd6717750",
                        "source_entry_id": "664f032a-680f-3bba-a1e8-3a43fc2c37c8",
                        "target_lang_word": "ипподром",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ипподром",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "768341fc-d3b5-3145-816e-e1e79159c3b0",
                                        "entry_id": "9a0dfb3f-90eb-37f6-91ea-22609489abec",
                                        "glosses": [
                                            "комплекс сооружений для испытаний рысистых и скаковых лошадей и соревнований по конному спорту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "992916f2-9d11-4a34-a078-4f423d14d895",
                                                "sense_id": "768341fc-d3b5-3145-816e-e1e79159c3b0",
                                                "text": "Мо́жет, он люби́л бы лошаде́й: неда́ром же с тако́й охо́той отправля́лся на дежу́рство на ипподро́м, когда́ там быва́ли ска́чки и́ли бега́; он да́же немно́го разбира́лся в то́нкостях э́того спо́рта, хотя́ никогда́ не увлека́лся тотализа́тором, он немно́го понима́л в лошадя́х и да́же оди́н раз зашёл на коню́шню…"
                                            }
                                        ]
