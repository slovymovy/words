                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "255631b8-cc11-36b1-a841-c48f821e9abf",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A small dwelling characteristic of the frontier, especially when built from logs with simple tools and not constructed by professional builders, but by those who meant to live in it."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17a6ac8-bdc0-4fdc-abdb-5d12ca2f6422",
                                                "sense_id": "255631b8-cc11-36b1-a841-c48f821e9abf",
                                                "text": "Abraham Lincoln was born in a log cabin."
                                            },
                                            {
                                                "example_id": "8d580f0b-2e7b-4a5b-aaac-56347ba05aec",
                                                "sense_id": "255631b8-cc11-36b1-a841-c48f821e9abf",
                                                "text": "And that was how long we stayed in the cabin, pressed together, pulling the future out of each other, sweating and groaning and making sure each of us remembered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69340de9-fe40-32b2-afc2-bcbd3117c386",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A chalet or lodge, especially one that can hold large groups of people."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43495088-b151-399d-8ff6-7cb6fedda7aa",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A private room on a ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af685093-1246-4e6c-82b3-b36b66f5ca47",
                                                "sense_id": "43495088-b151-399d-8ff6-7cb6fedda7aa",
                                                "text": "the captain’s cabin"
                                            },
                                            {
                                                "example_id": "123116f1-c3e4-4026-9d3e-9d19c32b0168",
                                                "sense_id": "43495088-b151-399d-8ff6-7cb6fedda7aa",
                                                "text": "Passengers shall remain in their cabins."
                                            },
                                            {
                                                "example_id": "61a194bb-ec3e-4750-aa2d-3570fd5aa53c",
                                                "sense_id": "43495088-b151-399d-8ff6-7cb6fedda7aa",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy. Mail bags, so I understand, are being put on board. Stewards, carrying cabin trunks, swarm in the corridors. Passengers wander restlessly about or hurry, with futile energy, from place to place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdbada18-f576-37cb-9865-b0ef8c2cca2b",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "The interior of a boat, enclosed to create a small room, particularly for sleeping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1032c2d-52c9-4bd9-ae7b-cca8afa40647",
                                                "sense_id": "bdbada18-f576-37cb-9865-b0ef8c2cca2b",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered. […] The Maria had a cabin, which was finished in hard wood and yellow plush, and accommodations for keeping things cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44fa17a8-c83c-3f82-a6ac-6acf51401694",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "The passenger area of an airplane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dbdf248-5df8-3936-8817-28594b0fe1af",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "The section of a passenger plane having the same class of service."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7113bf6f-19a6-36b5-9b95-edd3bdf77270",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A signal box."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "532e421c-dfdd-36ac-8b19-0ce44f33dabd",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A small room; an enclosed place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a00a9c0c-3db2-4b3d-8c8b-125dc4d31094",
                                                "sense_id": "532e421c-dfdd-36ac-8b19-0ce44f33dabd",
                                                "text": "So long in secret cabin there he held her captive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b01855-0af3-3b5a-a929-3a5b8497e136",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A private office; particularly of a doctor, businessman, lawyer, or other professional."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12f7097-6681-46d5-b8b4-66f3dac1a2ba",
                                                "sense_id": "47b01855-0af3-3b5a-a929-3a5b8497e136",
                                                "text": "There’s Kaul’s boss, the overweight owner of a pharmaceutical firm who spends his days wolfing down junk food in the privacy of his cabin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cabin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f565842-3cae-3d93-8f0a-5859d7a6d5e4",
                                        "entry_id": "58c4fcf3-451b-34b2-acc0-de8ba568f90f",
                                        "glosses": [
                                            "To place in a cabin or other small space."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "158a13cd-c8fc-39ee-a7ef-ea8f0cb86ce1",
                                        "entry_id": "58c4fcf3-451b-34b2-acc0-de8ba568f90f",
                                        "glosses": [
                                            "To limit the scope of."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a678e1c-f8ef-4b14-b1b3-45f2644501b3",
                                                "sense_id": "158a13cd-c8fc-39ee-a7ef-ea8f0cb86ce1",
                                                "text": "There was a time when this Court’s precedents may have portended the kind of First Amendment liability for purely private property owners that the majority spends so much time rejecting. […] But the Court soon stanched that trend. See Lloyd Corp. v. Tanner, 407 U. S. 551, 561–567 (1972) (cabining Marsh and refusing to extend Logan Valley); Hudgens v. NLRB, 424 U. S. 507, 518 (1976) (making clear that “the rationale of Logan Valley did not survive” Lloyd)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eba1fb2d-a12f-3b34-ae09-186ce231fea7",
                                        "entry_id": "58c4fcf3-451b-34b2-acc0-de8ba568f90f",
                                        "glosses": [
                                            "To live in, or as if in, a cabin; to lodge."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038683ec-0a95-4253-956d-a0b56c6181b1",
                                                "sense_id": "eba1fb2d-a12f-3b34-ae09-186ce231fea7",
                                                "text": "I'll make you […] cabin in a cave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7552a3c2-a9a1-412a-a85f-7512e08b4d76",
                        "source_entry_id": "4451c3bb-3b34-35ab-a192-e6b792ef79f7",
                        "source_sense_id": "9defa975-3a17-327c-8d2c-b168b5558568",
                        "source_sense_description": "overdekte gemeenschappelijke verblijfplaats op schepen",
                        "target_lang_word": "cabine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9773b69-23e0-36f5-a26f-aab927dd25b3",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Petite chambre à coucher, à bord d’un bateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488fb49f-4470-4cdf-b341-1ebf3b4fbf86",
                                                "sense_id": "f9773b69-23e0-36f5-a26f-aab927dd25b3",
                                                "text": "J’écris ces lignes dans la cabine du Firecrest. Le teck et le bois d’érable brillent."
                                            },
                                            {
                                                "example_id": "fec1bdc9-ea43-4b1c-849f-88cda8eef496",
                                                "sense_id": "f9773b69-23e0-36f5-a26f-aab927dd25b3",
                                                "text": "Elle était demeurée longtemps debout devant ces hautes coques dont les hublots laissaient voir l’intérieur des cabines éclairées."
                                            },
                                            {
                                                "example_id": "c441070b-6016-43e8-908e-d2ba54f6d265",
                                                "sense_id": "f9773b69-23e0-36f5-a26f-aab927dd25b3",
                                                "text": "Le bateau était un brick-goélette de quatre-vingts tonneaux à peu près, confortablement aménagé, avec, sur le pont, trois cabines spacieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95d2319-700d-35bb-9df8-131daa690d61",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Petite chambre, chambrette, petite pièce isolée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b039eff5-9cb7-4269-a836-f17090708b0b",
                                                "sense_id": "a95d2319-700d-35bb-9df8-131daa690d61",
                                                "text": "Enfin, la pendule-réclame Guérin-Boutron, fixée près d’une cabine de téléphone, marquait une fois pour toutes la demie de minuit, en cas de contestation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cd0f8d9-469d-37f7-a3ca-e386a9b4f63a",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Espace clos aménagé dans un camion, un véhicule tracteur de semi-remorque, un train, une locomotive ou autre engin de transport, où le conducteur dispose de tous les instruments nécessaires au maniement de l’engin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b345822-0855-46e2-9eeb-04362c55da81",
                                                "sense_id": "7cd0f8d9-469d-37f7-a3ca-e386a9b4f63a",
                                                "text": "Tzvetan la regardait d’en haut depuis la cabine de son camion comme elle s’éloignait légèrement voûtée, prends soin de toi, et il démarra le moteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c1b532e-e8ae-353c-b2f1-1ef6857dc437",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Sorte de cage close dans laquelle sont transportés les utilisateurs d’un ascenseur ou d’un téléphérique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be5c6796-522a-3943-9d03-33d094bd82a1",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Espace des passagers et des bagages à main dans un avion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "304c644e-359f-4a99-8aae-979ea29a110a",
                                                "sense_id": "be5c6796-522a-3943-9d03-33d094bd82a1",
                                                "text": "L’organisation à bord des avions de moyenne capacité fait que le chef de cabine se trouve aux avant-postes, à l’avant de l’appareil, à proximité de la porte d’embarquement et du cockpit. Pour ces vols, il est le lien privilégié entre la cabine et le commandant ; tous vos petits bobos lui seront répétés (ou presque, selon l’humeur)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf4227aa-ab33-3b51-b9e1-fc6f358806ab",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Petite chambre à coucher à bord d’un aéronat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e449bf11-059a-441a-850c-bc3becf27a05",
                                                "sense_id": "bf4227aa-ab33-3b51-b9e1-fc6f358806ab",
                                                "text": "La partie habitable mesurait deux cent cinquante pieds de long, et comprenait deux rangées de cabines superposées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4a33e2-60c9-3ab7-be80-40487b44d99c",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Blague reçue négativement par un groupe de plusieurs personnes."
                                        ],
                                        "tags": [
                                            "Jura"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f402b14-7345-4266-9a60-6e4558111073",
                                                "sense_id": "7a4a33e2-60c9-3ab7-be80-40487b44d99c",
                                                "text": "Cette blague n'a eu aucun effet. Ce n’est plus un bide, c’est une cabine!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cabine",
