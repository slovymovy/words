                    },
                    {
                        "translation_id": "c58514f2-51e0-40de-9eda-4b620d627818",
                        "source_entry_id": "4d74d4be-65c3-378e-9d0e-1fdc7d22e848",
                        "source_sense_id": "bd9cffcb-0f46-380f-8af5-dbbfb79d3c68",
                        "target_lang_word": "atrophy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atrophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee376679-8c1a-3910-9f0e-e4a47103f189",
                                        "entry_id": "632126c2-d724-3620-af3a-96b154950bd9",
                                        "glosses": [
                                            "A reduction in the functionality of an organ caused by disease, injury or lack of use."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ff434ec-e94e-4b7a-b1e6-8b27e44ab618",
                                                "sense_id": "ee376679-8c1a-3910-9f0e-e4a47103f189",
                                                "text": "Now that chatbots are going the way of Google—moving from the miraculous to the taken-for-granted—the anxiety has shifted, too, from apocalypse to atrophy. Teachers, especially, say they’re beginning to see the rot. The term for it is unlovely but not inapt: de-skilling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "atrophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca8184f-5e30-3c7f-a174-427c2454baaa",
                                        "entry_id": "2b9c2824-53e3-38ba-84e3-80ecf43aeaf1",
                                        "glosses": [
                                            "To wither or waste away."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db79984-06d8-450c-a2c5-8e11b332fd25",
                                                "sense_id": "1ca8184f-5e30-3c7f-a174-427c2454baaa",
                                                "text": "Boy. I love summer vacation. I can feel my brain beginning to atrophy already."
                                            },
                                            {
                                                "example_id": "1c74f4db-fcfd-4a80-8170-31cbbda62cce",
                                                "sense_id": "1ca8184f-5e30-3c7f-a174-427c2454baaa",
                                                "text": "The M10 highway looks normal enough at the southern limits of St. Petersburg, but then, with a jolt, it begins to atrophy. For the next 430 miles the surface of the highway, while paved, varies from corduroy to jaw-rattling patchwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bb014d-b227-3547-9553-3bfcbe60bd06",
                                        "entry_id": "2b9c2824-53e3-38ba-84e3-80ecf43aeaf1",
                                        "glosses": [
                                            "To cause to waste away or become abortive; to starve or weaken."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26dd690a-4c50-49c4-b5d6-e72100b33a34",
                                                "sense_id": "95bb014d-b227-3547-9553-3bfcbe60bd06",
                                                "text": "Cold silence has a tendency to atrophy any sense of compassion"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a34bc9a5-34b4-4704-9216-cd39884e0d2d",
                        "source_entry_id": "4d74d4be-65c3-378e-9d0e-1fdc7d22e848",
                        "source_sense_id": "bd9cffcb-0f46-380f-8af5-dbbfb79d3c68",
                        "target_lang_word": "dullness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dullness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a5ecf4-db3a-3891-92da-2fb80a2f9bf7",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The quality of being slow of understanding things; stupidity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "230fa280-ce7d-3cf5-943e-1446e12bd546",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The quality of being uninteresting; boring; humorless or irksome."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9eae842-3b2a-4dde-9451-0191c4d27b66",
                                                "sense_id": "230fa280-ce7d-3cf5-943e-1446e12bd546",
                                                "text": "If to raise malicious smiles at the infirmities or misfortunes of those who have never injured us be the province of wit or Humour, Heaven grant me a double Portion of Dullness—"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94769bf-51cb-3f2f-af31-15a21321f48c",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "Lack of interest or excitement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7f70f71-2bb7-392a-9ddb-1a273dbbf141",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The lack of visual brilliance; want of sheen."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ad8e207-7d45-47e3-8180-59e2a5d5e6eb",
                                                "sense_id": "a7f70f71-2bb7-392a-9ddb-1a273dbbf141",
                                                "text": "dullness of autumn"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d666009-b4a3-32a2-b985-e9eee4c3335a",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "bluntness."
