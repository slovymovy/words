                        ],
                        "examples": [
                            {
                                "example_id": "2f7e8c47-9384-43d6-bec6-41d32d35f8d5",
                                "sense_id": "42761e59-f309-3c5e-a0d0-f4e966e85ac5",
                                "text": "„Aranzini und Zitronat kommen in Früchtekuchen und Bischofsbrot, damit schöne Farbtupfer beim Aufschneiden zu sehen sind. “"
                            },
                            {
                                "example_id": "fd231a51-665e-4203-85eb-0f68e488f9ce",
                                "sense_id": "42761e59-f309-3c5e-a0d0-f4e966e85ac5",
                                "text": "„Dann Aranzini und die gehobelten Mandeln unterrühren, wenn die Masse gut vermischt ist, das Mehl einrühren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
