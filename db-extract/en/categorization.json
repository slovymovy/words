                                                "sense_id": "9b0599a3-3f7f-35ca-8289-02c42edb8e56",
                                                "text": "Der Bibliothekar wurde angestellt, um die Schlossbibliothek zu katalogisieren. Dazu musste er als erstes einmal den Bestand sichten und eine Kategorisierung vorschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3397c1d-b5a8-3192-94ab-9305e61d87d1",
                                        "entry_id": "bfd04f04-abb7-3d36-a956-f5b118ab521e",
                                        "glosses": [
                                            "Fähigkeit, unterschiedliche Entitäten nach bestimmten Kriterien Kategorien zuzuordnen"
                                        ],
                                        "tags": [
                                            "Kognitionswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06a569b4-4559-42e4-99e4-7feb2eec3772",
                                                "sense_id": "e3397c1d-b5a8-3192-94ab-9305e61d87d1",
                                                "text": "Beim Vorgang der Kategorisierung bildet der Einzeln unbewusst Klassen von ähnlichen Objekten, um sich die Komplexität der Welt zugänglicher zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
