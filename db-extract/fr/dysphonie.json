                "senses": [
                    {
                        "sense_id": "833a2544-6414-3df9-847b-3fcca1384766",
                        "entry_id": "6b000a22-1d54-34b9-a894-990acc20f4c2",
                        "glosses": [
                            "Altération du timbre ou de l'intensité de la voix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1dc84f3-4f8e-4a8c-bc9f-d9f7e249c54d",
                                "sense_id": "833a2544-6414-3df9-847b-3fcca1384766",
                                "text": "La dysphonie spasmodique (par adduction) se manifeste par une voix serrée, spasmée, saccadée et forcée."
                            },
                            {
                                "example_id": "3a9928bc-ac31-470c-b526-437351e75e40",
                                "sense_id": "833a2544-6414-3df9-847b-3fcca1384766",
                                "text": "– Qui sème le désir récolte l’oppression, suis-je tout près de murmurer comme si seul mon chat m’écoutait. […]\n– Direz bien le bonjour à votre maman, je marmonne en lui fermant la porte au nez et en espérant que la dysphonie des deux phrases sera recouverte par la force de préjugés millénaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f854832e-368c-41d9-b9ba-5d6803a8c990",
                        "source_entry_id": "6b000a22-1d54-34b9-a894-990acc20f4c2",
                        "source_sense_id": "833a2544-6414-3df9-847b-3fcca1384766",
                        "target_lang_word": "dysphonia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysphonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a19b94e1-02a0-3517-814d-591437b094b8",
                                        "entry_id": "be577a03-7ec6-3cd2-9d43-3c96d7713b3b",
                                        "glosses": [
                                            "A difficulty in producing vocal sounds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a9ffb02-ed33-4441-a4b6-3dd3308c8a01",
                                                "sense_id": "a19b94e1-02a0-3517-814d-591437b094b8",
                                                "text": "In patients with spasmodic dysphonia, the current treatment that is most commonly offered is by selective injection of botulinum toxin (BOTOX) into the most affected muscles."
                                            },
                                            {
                                                "example_id": "f4b5aa6a-51b8-4b4e-bbc5-2832b4428ef3",
                                                "sense_id": "a19b94e1-02a0-3517-814d-591437b094b8",
                                                "text": "Spasmodic dysphonia affects up to 50,000 people in North America, and is a subset of dystonia, a muscle contraction disorder that can affect many parts of the body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
