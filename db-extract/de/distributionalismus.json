                "senses": [
                    {
                        "sense_id": "697c53c6-d6c9-3523-bccb-513e5251bf8a",
                        "entry_id": "eafaa243-ad72-3a25-bc4b-564c1c9e49cd",
                        "glosses": [
                            "Bezeichnung für eine Phase des amerikanischen Strukturalismus um die Mitte des 20. Jahrhunderts, in der Sprachanalysen als Distributionsanalysen betrieben wurden. Das heißt, sprachliche Einheiten wurden dadurch gewonnen, dass man ihre gegenseitige Ersetzbarkeit in gleichen sprachlichen Umgebungen sowie ihre Kombinierbarkeit untersuchte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947fd77c-0fb0-4114-86cf-5eec7ba0dcf4",
                                "sense_id": "697c53c6-d6c9-3523-bccb-513e5251bf8a",
                                "text": "Der Distributionalismus ist eine besonders strenge Form des Strukturalismus."
                            },
                            {
                                "example_id": "0f80f979-2b4f-44a9-9bbe-7f4af0a0d0df",
                                "sense_id": "697c53c6-d6c9-3523-bccb-513e5251bf8a",
                                "text": "Der bekannteste Vertreter des Distributionalismus ist Zellig S. Harris, einer der bekanntesten Linguisten überhaupt."
                            },
                            {
                                "example_id": "7cf9a93b-2592-443f-9e8c-3669d70529b0",
                                "sense_id": "697c53c6-d6c9-3523-bccb-513e5251bf8a",
                                "text": "Der Distributionalismus versuchte, Grammatiken ohne jeden Rückgriff auf die Bedeutung sprachlicher Ausdrücke zu erstellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
