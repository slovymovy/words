                                "sense_id": "0c38d0fd-8b14-3c3a-b3ec-098e250adb2b",
                                "text": "Heute machen Altbaumodernisierungen mehr als die Hälfte des gesamten Bauvolumens einer Stadt aus."
                            },
                            {
                                "example_id": "f7b34a93-6460-442d-b79b-d1244e708051",
                                "sense_id": "0c38d0fd-8b14-3c3a-b3ec-098e250adb2b",
                                "text": "Die alte Kaserne bekam mit ihrer Altbaumodernisierungen Wärmedämmverglasungen und einen Fahrstuhl im Hinterhof."
                            }
                        ],
