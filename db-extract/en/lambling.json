                        "glosses": [
                            "A young or little lamb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960c4e27-b19f-4844-8e33-d0d53889f50d",
                                "sense_id": "599f36a5-1406-3b4d-937e-296700ee966d",
                                "text": "I have seen the lamblings skipping / In sunshine and in mist; […]"
                            },
                            {
                                "example_id": "a0f00107-8bed-4555-bba5-e87500c42da3",
                                "sense_id": "599f36a5-1406-3b4d-937e-296700ee966d",
                                "text": "These woolly lamblings were immensely affected by his exhortations, and when he gave out the hymn, there was such a negro chorus about the house as might be heard across the Potomac — such a chorus as would never have been heard […]"
                            },
                            {
                                "example_id": "b58c71d4-1692-4c8b-9fed-3e5ae6d387e0",
                                "sense_id": "599f36a5-1406-3b4d-937e-296700ee966d",
                                "text": "These two pivots of the Great Wheel, blended, had brought men, women and children in their thousands, to kill some miserable lambling . . . on the temple steps in stonement for their sins […]"
                            },
                            {
                                "example_id": "dcac7f2e-858c-4bec-91f1-66f67fd82441",
                                "sense_id": "599f36a5-1406-3b4d-937e-296700ee966d",
                                "text": "So tell me, lamblings, what's gonna keep a big bad supernatural predator from munching down on you succulent little morsels?” he asked, thoroughly creeping me out."
                            }
                        ]
                    }
