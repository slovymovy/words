                    {
                        "translation_id": "ce102102-de6e-4c73-8887-d048efe69994",
                        "source_entry_id": "720104d1-7c15-3eed-81ea-0d467cff7918",
                        "source_sense_id": "9771bd02-3d45-3fb6-9a6c-f9ce81fe2072",
