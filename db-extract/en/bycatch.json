                        "sense_id": "3b542dac-490d-3882-b9ab-d4253da8f2cb",
                        "entry_id": "fbed6aba-7ce5-3d01-9c10-59f5574cc0cd",
                        "glosses": [
                            "Any fish (or other creatures) that are not targeted as a catch but are unintentionally caught, and often discarded back into the sea."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2f305c8-238e-4968-b7bb-4287e83a1eb1",
                                "sense_id": "3b542dac-490d-3882-b9ab-d4253da8f2cb",
                                "text": "Some offer him bags of bycatch—fish too small or net-mangled to sell, rays and seahorses few will want, and so on."
                            }
                        ]
                    },
                    {
                        "sense_id": "24cf8727-21d0-3f27-b0bc-0fda1951eb06",
                        "entry_id": "fbed6aba-7ce5-3d01-9c10-59f5574cc0cd",
                        "glosses": [
                            "Any person, animal, or thing, captured unintentionally on camera or film."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
