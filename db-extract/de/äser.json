                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muzzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae19663e-0fd3-3a86-93e7-5c917a56aed8",
                                        "entry_id": "21fab165-55ec-3ca7-a4e8-2d2f2eff51f7",
                                        "glosses": [
                                            "The protruding part of an animal's head which includes the nose, mouth and jaws."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692b9473-df25-49eb-b104-48f56e5cd9f0",
                                                "sense_id": "ae19663e-0fd3-3a86-93e7-5c917a56aed8",
                                                "text": "The yellow fog that rubs its back upon the window-panes, / The yellow smoke that rubs its muzzle on the window-panes, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a41aaede-e66f-3bd0-8d3c-a571ba4b9dc8",
                                        "entry_id": "21fab165-55ec-3ca7-a4e8-2d2f2eff51f7",
                                        "glosses": [
                                            "A person's mouth."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64ba4225-ea99-34ca-b327-6e2eaf84d10d",
                                        "entry_id": "21fab165-55ec-3ca7-a4e8-2d2f2eff51f7",
                                        "glosses": [
                                            "A device used to prevent an animal from biting or eating, which is worn on its snout."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec4cf533-a142-34bf-beed-b758c3014085",
                                        "entry_id": "21fab165-55ec-3ca7-a4e8-2d2f2eff51f7",
                                        "glosses": [
                                            "The mouth or the end for entrance or discharge of a gun, pistol etc., that the bullet emerges from."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "495d129d-e926-3e91-91a3-aa656ed74285",
                                        "entry_id": "21fab165-55ec-3ca7-a4e8-2d2f2eff51f7",
                                        "glosses": [
                                            "A piece of the forward end of the plow-beam by which the traces are attached."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06adf9b7-1250-3764-8b87-2407b625fdd5",
                                        "entry_id": "21fab165-55ec-3ca7-a4e8-2d2f2eff51f7",
                                        "glosses": [
                                            "An openwork covering for the nose, used for the defense of the horse, and forming part of the bards in the 15th and 16th centuries."
                                        ],
                                        "tags": [
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "muzzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8bfaba0-a099-36c2-b9e1-9667534400db",
                                        "entry_id": "13daa643-3baf-38ce-b8f1-149a95e50025",
                                        "glosses": [
                                            "To bind or confine an animal's mouth by putting a muzzle, as to prevent it from eating or biting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58553f1a-8b16-4f63-8ba1-e4ccc90b23bf",
                                                "sense_id": "e8bfaba0-a099-36c2-b9e1-9667534400db",
                                                "text": "Thou shalt not muzzle the ox when he treadeth out the corn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39cbbea2-1aff-3b5f-9c1c-5f54532adbf3",
                                        "entry_id": "13daa643-3baf-38ce-b8f1-149a95e50025",
                                        "glosses": [
                                            "To restrain (from speaking, expressing opinion or acting); to gag; to silence; to censor."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fe6d35c-deb1-4843-849d-4ba95ba103f8",
                                                "sense_id": "39cbbea2-1aff-3b5f-9c1c-5f54532adbf3",
                                                "text": "Those who want to muzzle everyone else are likely nothing less than pseudovirtuous."
                                            },
                                            {
                                                "example_id": "c5a179bf-e3bf-4464-a5dd-c4236f2e2ac8",
                                                "sense_id": "39cbbea2-1aff-3b5f-9c1c-5f54532adbf3",
                                                "text": "Man is brow-beaten, leashed, muzzled, masked, and lashed by boards and councils, by leagues and societies, by church and state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ab241a-000a-310c-8387-de2fc33d5980",
                                        "entry_id": "13daa643-3baf-38ce-b8f1-149a95e50025",
                                        "glosses": [
                                            "To veil, mask, muffle."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "646daa3f-70b3-395a-8980-d0977238b1b7",
                                        "entry_id": "13daa643-3baf-38ce-b8f1-149a95e50025",
                                        "glosses": [
                                            "To fondle with the closed mouth; to nuzzle."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03ee79e-d7e8-4b5a-a547-6cfb0bd1078d",
                                                "sense_id": "646daa3f-70b3-395a-8980-d0977238b1b7",
                                                "text": "Venus her self would sit Muzzling and Gazing them in the Eyes"
                                            },
                                            {
                                                "example_id": "168b8a55-6df9-49d9-a891-bcfd15a5297c",
                                                "sense_id": "646daa3f-70b3-395a-8980-d0977238b1b7",
                                                "text": "And now, while they are climbing the pole in another part of the field, and muzzling in a flour-tub in another, the old farmer […] announces to all whom it may concern that a half-sovereign in money will be forthcoming to the old gamester who breaks most heads; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "015b265e-fe38-348d-90fb-3b3d83c86daa",
                                        "entry_id": "13daa643-3baf-38ce-b8f1-149a95e50025",
                                        "glosses": [
                                            "To bring the muzzle or mouth near."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f64d5ee1-a63f-4670-a06a-797375a3ea56",
                                                "sense_id": "015b265e-fe38-348d-90fb-3b3d83c86daa",
                                                "text": "The Bear comes directly up to him, Muzzles and Smells to him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2927ca69-878c-4df2-819f-e8aefa98a6c7",
                        "source_entry_id": "9c8a1bd7-9ec9-3238-a14e-393348093d43",
                        "source_sense_id": "369651f3-ce59-322d-98b2-524867a0a131",
                        "source_sense_description": "jägersprachlich: (vom Haarwild, abgesehen vom Raub- und Schwarzwild) Maul",
                        "target_lang_word": "snout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f306631e-9fba-3ba3-8d57-743f57c3262c",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
                                            "The long, projecting nose, mouth, and jaw of a beast, as of pigs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0409c720-cbc0-45cd-8b99-4f7e32efafb6",
                                                "sense_id": "f306631e-9fba-3ba3-8d57-743f57c3262c",
                                                "text": "The pig rooted around in the dirt with its snout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8332a8b4-d164-3426-ad48-dc207ed90ee1",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
                                            "The front of the prow of a ship or boat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8714daee-2d7d-4f7c-9049-f4e24147c62f",
                                                "sense_id": "8332a8b4-d164-3426-ad48-dc207ed90ee1",
                                                "text": "The dinghy was trailing astern at the end of its painter, and Merrion looked at it as he passed. He saw that it was a battered-looking affair of the prahm type, with a blunt snout, and like the parent ship, had recently been painted a vivid green."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "276b992d-c818-355b-9694-33c7a5ff2ee0",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
                                            "A person's nose."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec24464-757c-4c9b-be55-3bb722e4fe66",
                                                "sense_id": "276b992d-c818-355b-9694-33c7a5ff2ee0",
                                                "text": "His glasses kept slipping further down onto his prominent snout."
                                            },
                                            {
                                                "example_id": "1464204d-1e0a-482f-aa18-f24a767d5d9a",
                                                "sense_id": "276b992d-c818-355b-9694-33c7a5ff2ee0",
                                                "text": "Whether his snout a perfect nose is,\nAnd not an elephant's proboscis"
                                            },
                                            {
                                                "example_id": "1dc8fc4f-86d0-43a4-b47c-5458305eef0b",
                                                "sense_id": "276b992d-c818-355b-9694-33c7a5ff2ee0",
                                                "text": "The bitter laugh laughs at that which is not good, it is the ethical laugh. The hollow laugh laughs at that which is not true, it is the intellectual laugh. Not good! Not true! Well well. But the mirthless laugh is the dianoetic laugh, down the snout — Haw! — so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e94de11-f683-3ca4-9368-c42f942ee561",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
                                            "The nozzle of a pipe, hose, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b64adab-0313-4ef4-8af0-270f71fdf923",
                                                "sense_id": "9e94de11-f683-3ca4-9368-c42f942ee561",
                                                "text": "If you place the snout right into the bucket, it won't spray as much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67216095-a13a-341a-9298-8650bc903022",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
                                            "The anterior prolongation of the head of a gastropod; a rostrum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d22a0efc-ec97-3dc3-88a8-4b583483c536",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
                                            "The anterior prolongation of the head of weevils and allied beetles; a rostrum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fff9f7e-7a88-3505-898b-4cfc58ad1aba",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
                                            "Tobacco; cigarettes."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce334d11-a5b1-4a5c-9a07-78dbbcbdba11",
                                                "sense_id": "8fff9f7e-7a88-3505-898b-4cfc58ad1aba",
                                                "text": "(Bob, p. 55:) Charlie was the most vicious screw on the block ... He caught me with the two ounces of snout right in my hand, caught me by the hair, and swung me round in the exercise yard ...\n(Spider, p. 175:) She brings me snout and sweets, and sometimes a cake from Mum."
                                            },
                                            {
                                                "example_id": "ee4772d5-b79e-42a2-86fd-9e73565d660a",
                                                "sense_id": "8fff9f7e-7a88-3505-898b-4cfc58ad1aba",
                                                "text": "LIZ. I only got one left. / FRED (calls). Get us some snout. / MIKE. Five or ten?"
                                            },
                                            {
                                                "example_id": "cc373087-d07e-4172-951e-4ed0fe370ad8",
                                                "sense_id": "8fff9f7e-7a88-3505-898b-4cfc58ad1aba",
                                                "text": "Also he was \"doing his nut\" for some \"snout.\" I said I would provide cigarettes."
                                            },
                                            {
                                                "example_id": "a3a31331-8e21-4d29-92e0-309e7900384f",
                                                "sense_id": "8fff9f7e-7a88-3505-898b-4cfc58ad1aba",
                                                "text": "Raymond rolled a neat cigarette. \"What about some snout, then?\" \"No, thanks.\" He laughed. Smoke drifted from his open mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ab45b86-15c5-3788-a54c-58a6c16ce9d5",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
                                            "The terminus of a glacier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a746abf6-b3c9-36a6-b349-18117d80cc50",
                                        "entry_id": "33e92ff6-4183-3732-9d49-a62f942020e1",
                                        "glosses": [
