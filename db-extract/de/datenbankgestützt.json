                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8aced46-043e-4d3d-bc26-847ee14c90ad",
                                "sense_id": "9fb24bb5-243e-3e34-933c-b2b9ec8006b2",
                                "text": "Das System ist datenbankgestützt, zudem basiert die Kalibrierung und Überprüfung der Messinstrumente auf Echtzeitdaten."
                            },
                            {
                                "example_id": "708c934d-36ad-4bc1-8753-15f191ae076b",
                                "sense_id": "9fb24bb5-243e-3e34-933c-b2b9ec8006b2",
                                "text": "Die EU-Richtlinie sieht unter anderem eine eindeutige Sicherheitskennzeichnung jeder Verpackung zur datenbankgestützten Rückverfolgung – Stichwort Serialisierung – vor."
                            }
