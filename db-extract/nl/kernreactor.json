                "senses": [
                    {
                        "sense_id": "3bd3ea6b-d17d-30ef-b375-a99c6fe57791",
                        "entry_id": "462bb696-421f-3c7c-8745-61730303d17f",
                        "glosses": [
                            "installatie waarin een nucleair splijtingsprocess plaats vindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b0a562a-e849-405e-b79b-584b67fa40b2",
                                "sense_id": "3bd3ea6b-d17d-30ef-b375-a99c6fe57791",
                                "text": "Kernreactor: De plaats waar de kernsplijting plaatsvindt binnen een centrale en water tot stoom wordt verhit."
                            },
                            {
                                "example_id": "4f9d4de7-d499-4fae-afc6-c062388acaeb",
                                "sense_id": "3bd3ea6b-d17d-30ef-b375-a99c6fe57791",
                                "text": "De veiligheid van kernreactoren is al jaren een heet hangijzer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "496a8afd-df23-40de-8611-f5c816e519f9",
                        "source_entry_id": "462bb696-421f-3c7c-8745-61730303d17f",
                        "source_sense_id": "3bd3ea6b-d17d-30ef-b375-a99c6fe57791",
                        "target_lang_word": "Kernreaktor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kernreaktor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3984dd3-601a-3412-accf-b4ed5c0ec03c",
                                        "entry_id": "8107a841-2feb-385a-b1a7-e901b655b604",
                                        "glosses": [
                                            "Reaktor, in dem Atomkerne in einer Kettenreaktion immer wieder zur Spaltung gebracht werden und der oft zur Energiegewinnung eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713d3ae1-eed5-4e90-8092-9fa46aba7fe1",
                                                "sense_id": "d3984dd3-601a-3412-accf-b4ed5c0ec03c",
                                                "text": "„In erster Linie kommt es in einem Kernreaktor zur einer Kettenreaktion.“"
                                            },
                                            {
                                                "example_id": "cdf2b21a-aadd-4a24-a732-fcaf38b3e45e",
                                                "sense_id": "d3984dd3-601a-3412-accf-b4ed5c0ec03c",
                                                "text": "„Und die Bewohner der Gemeinden arbeiten in dem halben Dutzend Minen, entweder in der Verwaltung, oder sie holen als Minenarbeiter das Uranoxid aus der Erde, das gesiebt, aufbereitet, abtransportiert und in die Länder mit Kernreaktoren verkauft wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8aaac8a-8c18-45ae-98bd-6a00324566b4",
                        "source_entry_id": "462bb696-421f-3c7c-8745-61730303d17f",
                        "source_sense_id": "3bd3ea6b-d17d-30ef-b375-a99c6fe57791",
                        "target_lang_word": "nuclear reactor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclear reactor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "325f9ab4-1b97-3f95-8f98-36a8affa44f0",
                                        "entry_id": "e83191e4-659f-34fc-9f35-fe3fd398a1d3",
                                        "glosses": [
                                            "Any device in which a controlled chain reaction is maintained for the purpose of creating heat (for power generation) or for creating neutrons and other fission products for experimental, medical or other purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc982e8f-120f-42f7-aafa-6b049f4a71f9",
                                                "sense_id": "325f9ab4-1b97-3f95-8f98-36a8affa44f0",
                                                "text": "Meronym: control rod"
                                            },
                                            {
                                                "example_id": "f7e9c106-eba7-4576-acf7-edd3dd40e50f",
                                                "sense_id": "325f9ab4-1b97-3f95-8f98-36a8affa44f0",
                                                "text": "Near-synonym: atomic pile (dated)"
                                            },
                                            {
                                                "example_id": "b5ecb1e6-b220-4c96-ba8d-33da29f52c94",
                                                "sense_id": "325f9ab4-1b97-3f95-8f98-36a8affa44f0",
                                                "text": "Some newspapers in the United States, in Japan, and in South Korea printed photographs of North Korean nuclear reactors and nuclear plants, photos that were said to have been taken by U.S. military satellites. Most of the exposures were from a nuclear research establishment at Ninghian Chun in Pingan Beidao, only 80 km from Pyongyang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "451136a7-486c-4e4f-99c8-b54204cbb466",
                        "source_entry_id": "462bb696-421f-3c7c-8745-61730303d17f",
                        "source_sense_id": "3bd3ea6b-d17d-30ef-b375-a99c6fe57791",
