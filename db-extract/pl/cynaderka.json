                                        "examples": [
                                            {
                                                "example_id": "6362e542-53d9-4cfa-a923-86d41ace8d6e",
                                                "sense_id": "06700c33-4bb1-3e20-afdd-65340512497f",
                                                "text": "Kuchařům ledvinky a játra, mozeček a ovárek pánům rechnungsfeldvéblům, a písařům jen dvojité porce masa pro manšaft."
                                            }
