                    },
                    {
                        "translation_id": "bb577b29-ade9-420c-82af-514e8ff2ae95",
                        "source_entry_id": "d8ca8a82-24f8-3699-b8dd-6fc0fe7a56be",
                        "source_sense_id": "a5c22864-dad8-383b-874e-972d318b5f24",
                        "source_sense_description": "Qui concerne la poste",
                        "target_lang_word": "почтовый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "почтовый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f278ffe8-be80-3a17-9ce6-4683a01bd324",
                                        "entry_id": "af0c35f7-56bb-3ba7-886b-5abb3fc2e8f1",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным почта; свойственный, характерный для неё"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78928325-ee72-4209-9ba1-ee9ae5773a61",
                                                "sense_id": "f278ffe8-be80-3a17-9ce6-4683a01bd324",
                                                "text": "Похоже, что не все почтовые отделения осведомлены о его существовании."
                                            },
                                            {
                                                "example_id": "b20f15f3-6b7e-44de-9d52-7da5aa241af9",
                                                "sense_id": "f278ffe8-be80-3a17-9ce6-4683a01bd324",
                                                "text": "Не здороваясь, женщина полезла в висящую на плече почтовую сумку, протянула Девяткину сложенный вчетверо листок."
                                            },
                                            {
                                                "example_id": "76967ab3-c6ea-493c-bf49-717e3d9baff4",
                                                "sense_id": "f278ffe8-be80-3a17-9ce6-4683a01bd324",
                                                "text": "Я был им нужен только как передаточное звено, как провод, что ли… Или, если хотите, как почтовый голубь."
                                            },
                                            {
                                                "example_id": "0a245be2-4da0-497a-b2fa-fe914884bfc6",
                                                "sense_id": "f278ffe8-be80-3a17-9ce6-4683a01bd324",
                                                "text": "Всякий раз, когда я пишу тебе, мне больно, что я не могу просто поговорить с тобой, не прибегая к посредничеству почтовой бумаги."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3c9ad5c-eca9-3ddb-9297-e52144481ec2",
                                        "entry_id": "af0c35f7-56bb-3ba7-886b-5abb3fc2e8f1",
                                        "glosses": [
                                            "устар. связанный с перевозкой пассажиров в конных экипажах"
                                        ],
                                        "tags": [
                                            "в России до 1917 г."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd36d809-fc7b-4e16-ab72-7b87e7c369c5",
                                                "sense_id": "e3c9ad5c-eca9-3ddb-9297-e52144481ec2",
                                                "text": "Ещё несколько слов: в течении двадцати лет сряду, изъездил я Россию по всем направлениям; почти все почтовые тракты мне известны; несколько поколений ямщиков мне знакомы; редкого смотрителя не знаю я в лицо, с редким не имел я дела…"
                                            },
                                            {
                                                "example_id": "c1490da0-409d-4534-8445-81432657663c",
                                                "sense_id": "e3c9ad5c-eca9-3ddb-9297-e52144481ec2",
                                                "text": "― Зачем выдавать на почтовых лошадей, когда все знают, что везде теперь железные дороги?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
