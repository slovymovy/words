{
    "word_family": [
        "abseiler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7134bbdb-9caa-3abc-8e19-dea78756fd82",
                    "sense_definition": "To descend a steep cliff or vertical surface using a rope and a friction device.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abseil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team had to <w>abseil</w> down the cliff to reach the stranded climber.",
                            "target_lang_translations": {
                                "cs": "Záchranný tým musel <w>slanit</w> dolů ze skály, aby se dostal k uvízlému horolezci."
                            }
                        },
                        {
                            "text": "Contractors reached the site by cutting through thick brush and <w>abseiling</w> down the slope.",
                            "target_lang_translations": {
                                "cs": "Dodavatelé se na místo dostali prosekáním hustého křoví a <w>slaňováním</w> po svahu."
                            }
                        }
                    ],
                    "synonyms": [
                        "rappel"
                    ],
                    "common_phrases": [
                        "abseil down a cliff",
                        "abseil down ropes"
                    ],
                    "target_lang_definitions": {
                        "cs": "Sestoupit ze strmé skály nebo svislého povrchu pomocí lana a slaňovací pomůcky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "slanit",
                                "target_lang_sense_clarification": "dokonavý vid, sestoupit po laně"
                            },
                            {
                                "target_lang_word": "slaňovat",
                                "target_lang_sense_clarification": "nedokonavý vid, sestupovat po laně"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68f733bb-4054-3c60-8198-617315f1daaf",
                    "sense_definition": "A controlled descent down a steep face or vertical drop using a rope and friction device.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abseil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She completed a fifty-metre <w>abseil</w> from the top of the tower for charity.",
                            "target_lang_translations": {
                                "cs": "Pro charitu absolvovala padesátimetrové <w>slanění</w> z vrcholu věže."
                            }
                        },
                        {
                            "text": "Before starting the <w>abseil</w>, double-check that your harness is properly fastened.",
                            "target_lang_translations": {
                                "cs": "Před zahájením <w>slaňování</w> si dvakrát zkontrolujte, zda máte správně upevněný úvazek."
                            }
                        }
                    ],
                    "synonyms": [
                        "rappel"
                    ],
                    "common_phrases": [
                        "charity abseil"
                    ],
                    "target_lang_definitions": {
                        "cs": "Kontrolovaný sestup po strmé stěně nebo svislém srázu pomocí lana a slaňovací pomůcky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "slavění",
                                "target_lang_sense_clarification": "samotná činnost sestupu po laně"
                            },
                            {
                                "target_lang_word": "slanění",
                                "target_lang_sense_clarification": "akt sestupu po laně"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}