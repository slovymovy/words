                "senses": [
                    {
                        "sense_id": "d1c851d5-3c3a-303e-b675-9792d8f2831e",
                        "entry_id": "7d360baa-9e38-34b9-b221-a08394809656",
                        "glosses": [
                            "A person employed by an agent to transact the whole, or a part, of the business entrusted to the latter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b91b9b-032d-46b6-9dfa-21e8b37f3e7e",
                                "sense_id": "d1c851d5-3c3a-303e-b675-9792d8f2831e",
                                "text": "Where a subagent is appointed pursuant to actual or implied authority from the principal the principal is liable directly to the subagent for his compensation ."
                            },
                            {
                                "example_id": "4125760c-8c73-4fec-963c-716587834219",
                                "sense_id": "d1c851d5-3c3a-303e-b675-9792d8f2831e",
                                "text": "Where a subagent is appointed by authority of the principal, the subagent is, so far as relates to third persons, the agent of the principal, and the acts of the subagent are binding upon the principal;"
                            },
                            {
                                "example_id": "15047f28-0d23-4795-b329-100f10639f8b",
                                "sense_id": "d1c851d5-3c3a-303e-b675-9792d8f2831e",
                                "text": "Confusing relationships, disclosures, and conflicts arise if the licensee acts as subagent with one buyer and buyer's agent with another buyer on the same property."
                            }
                        ]
                    },
                    {
                        "sense_id": "d108f4b4-33de-312d-9426-b499d3b8e2fd",
                        "entry_id": "7d360baa-9e38-34b9-b221-a08394809656",
                        "glosses": [
                            "An autonomous process that is launched by and communicates with another agent in order to handle part of the task that is the objective of that other agent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1314e6aa-1b6f-4b7d-887c-5a2e4c5e8c6f",
                                "sense_id": "d108f4b4-33de-312d-9426-b499d3b8e2fd",
                                "text": "On a UNIX system, the coordinating agent and subagent processes will have different names."
                            },
                            {
                                "example_id": "02b3c764-2037-41f9-9ded-8acdda08d427",
                                "sense_id": "d108f4b4-33de-312d-9426-b499d3b8e2fd",
                                "text": "An SNMP subagent supports its own MIB, which might be an RFC-architected MIV, or might be a proprietary (referered to as enterprise-specific) MIB. For example, a TCP/IP subagent would most likely support the IP, ICMP, TCP, UDP, and Interface groups defined in RFC 1213."
                            },
                            {
                                "example_id": "a017bcb1-a95f-418a-a1b5-59317a1411d5",
                                "sense_id": "d108f4b4-33de-312d-9426-b499d3b8e2fd",
                                "text": "Originally, the purpose of creating an AI subagent will be to enhance new horizons in protocol and use it to help protect human agents in the field."
                            }
                        ]
                    }
                ],
