{
    "word_family": [
        "contemplate",
        "contemplation",
        "contemplator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3fcf16f9-ab09-3131-80c7-f97bc0359696",
                    "sense_definition": "Inclined to deep thought and quiet reflection.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thoughtful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent a <w>contemplative</w> afternoon sitting by the lake and watching the sunset.",
                            "target_lang_translations": {
                                "zh": "她度过了一个<w>沉思的</w>下午，坐在湖边看着日落。"
                            }
                        },
                        {
                            "text": "His <w>contemplative</w> nature made him a great listener who always considered his words carefully.",
                            "target_lang_translations": {
                                "zh": "他那<w>沉思的</w>性格使他成为一个很好的倾听者，总是仔细斟酌自己的话语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "introspective",
                        "meditative",
                        "pensive",
                        "reflective",
                        "thoughtful"
                    ],
                    "common_phrases": [
                        "contemplative mood",
                        "contemplative silence"
                    ],
                    "target_lang_definitions": {
                        "zh": "倾向于深思和安静反省的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉思的",
                                "target_lang_sense_clarification": "形容人处于深思或反省的状态。"
                            },
                            {
                                "target_lang_word": "冥想的",
                                "target_lang_sense_clarification": "形容带有冥想性质的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b64826fe-8035-3980-97fe-94ecf5be1111",
                    "sense_definition": "Relating to the ability or process of deep thinking.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "thoughtful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher explored the <w>contemplative</w> faculties of the human mind in his latest essay.",
                            "target_lang_translations": {
                                "zh": "这位哲学家在他最新的文章中探讨了人类心智的<w>沉思</w>能力。"
                            }
                        },
                        {
                            "text": "Meditation is often used to sharpen one's <w>contemplative</w> powers.",
                            "target_lang_translations": {
                                "zh": "冥想常被用来磨练一个人的<w>沉思</w>能力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "contemplative faculties"
                    ],
                    "target_lang_definitions": {
                        "zh": "与深层思考能力或过程相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉思的",
                                "target_lang_sense_clarification": "指与思考过程相关的属性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09578aac-0697-3b4b-a0d6-eaac73c9d337",
                    "sense_definition": "Relating to religious orders dedicated to prayer and meditation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks lived a strictly <w>contemplative</w> life within the walls of the monastery.",
                            "target_lang_translations": {
                                "zh": "僧侣们在修道院的围墙内过着严格的<w>静修</w>生活。"
                            }
                        },
                        {
                            "text": "She joined a <w>contemplative</w> order to focus entirely on her spiritual development.",
                            "target_lang_translations": {
                                "zh": "她加入了一个<w>静修</w>修会，以便全心全意专注于自己的精神成长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "contemplative order"
                    ],
                    "target_lang_definitions": {
                        "zh": "指致力于祈祷和冥想的宗教修会。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉思的",
                                "target_lang_sense_clarification": "指宗教中以静修为主的。"
                            },
                            {
                                "target_lang_word": "静修的",
                                "target_lang_sense_clarification": "指宗教生活中以静默修行为主的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "010ffd1e-a773-3a46-adca-d74e9d33c684",
                    "sense_definition": "In a stage of recognizing that a behavior or habit is harmful.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient is in a <w>contemplative</w> stage regarding his addiction and is finally considering treatment.",
                            "target_lang_translations": {
                                "zh": "患者正处于针对其成瘾问题的<w>反思</w>阶段，并最终开始考虑接受治疗。"
                            }
                        },
                        {
                            "text": "During the <w>contemplative</w> phase of recovery, individuals begin to weigh the pros and cons of changing their habits.",
                            "target_lang_translations": {
                                "zh": "在康复的<w>反思</w>阶段，个人开始权衡改变习惯的利弊。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "处于意识到某种行为或习惯有害的阶段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反思的",
                                "target_lang_sense_clarification": "指对自身行为进行审视和思考的阶段。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "abaed92b-13e2-3f0e-a261-d12a3d6b38eb",
                    "sense_definition": "A person who devotes their life to religious or philosophical meditation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>contemplative</w> spent hours in silence seeking a deeper understanding of existence.",
                            "target_lang_translations": {
                                "zh": "这位<w>静修者</w>在沉默中度过了数小时，寻求对存在的更深层理解。"
                            }
                        },
                        {
                            "text": "Many ancient traditions have produced a <w>contemplative</w> who seeks truth through inner stillness.",
                            "target_lang_translations": {
                                "zh": "许多古老的传统都曾产生过通过内心宁静来寻求真理的<w>沉思者</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "致力于宗教或哲学冥想的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉思者",
                                "target_lang_sense_clarification": "指进行深层思考或修行的人。"
                            },
                            {
                                "target_lang_word": "静修者",
                                "target_lang_sense_clarification": "指通过静默修行寻求真理的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}