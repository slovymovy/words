                "senses": [
                    {
                        "sense_id": "cf81dbe3-3f0a-3a51-96c0-f99028a9f656",
                        "entry_id": "1bac842a-2220-3592-a4b6-4e712e1be745",
                        "glosses": [
                            "Faire passer dans un état hypothermique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b6ea543-86cb-4cc2-a847-5942db701e25",
                                "sense_id": "cf81dbe3-3f0a-3a51-96c0-f99028a9f656",
                                "text": "Parce qu'il faut avouer que barboter tranquillement dans une eau qui est capable d'hypothermiser un ours polaire, on repassera pour le réalisme."
                            },
                            {
                                "example_id": "d5104519-8a82-456f-a37d-bec9b20bc479",
                                "sense_id": "cf81dbe3-3f0a-3a51-96c0-f99028a9f656",
                                "text": "ça caille! tu vas t'hypothermiser"
                            },
                            {
                                "example_id": "87de301d-b0cb-4b10-8561-3a5e33071743",
                                "sense_id": "cf81dbe3-3f0a-3a51-96c0-f99028a9f656",
                                "text": "Dans un pur esprit scientifique, j'ai donc laissé mon corps s'hypothermiser tel le hérisson pour conserver toute mon énergie pour la rentrée, comme c'était écrit dans la notice."
                            }
                        ]
                    }
