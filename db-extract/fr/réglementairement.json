                                "sense_id": "48a72bb9-4b89-394f-a477-2d02f58c7c16",
                                "text": "Il a fait tout cela réglementairement."
                            },
                            {
                                "example_id": "8eb4adf2-2aa6-452c-a237-bba52d3e4b01",
                                "sense_id": "48a72bb9-4b89-394f-a477-2d02f58c7c16",
                                "text": "Il faut procéder réglementairement."
                            },
