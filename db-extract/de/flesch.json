                ],
                "senses": [
                    {
                        "sense_id": "2067215e-eec4-35ea-a0a6-38c99f7b2bc1",
                        "entry_id": "09bde0fd-57f3-3ac3-aeef-d63c081b9197",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06ca7689-61b4-43ec-81a9-f35db2151ec7",
                                "sense_id": "2067215e-eec4-35ea-a0a6-38c99f7b2bc1",
                                "text": "Frau Flesch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "093f1acb-9609-4aa6-ac3b-1877dbbbb344",
                                "sense_id": "2067215e-eec4-35ea-a0a6-38c99f7b2bc1",
                                "text": "Herr Flesch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6ce70839-ee33-482b-9945-d360a8307654",
                                "sense_id": "2067215e-eec4-35ea-a0a6-38c99f7b2bc1",
                                "text": "Die Fleschs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a49d578b-8de6-4a57-b24c-8d3a09282490",
                                "sense_id": "2067215e-eec4-35ea-a0a6-38c99f7b2bc1",
                                "text": "Der Flesch trägt nie die Schals, die die Flesch ihm strickt."
                            },
                            {
                                "example_id": "e80ebbd3-d69c-460a-9bb2-e978802d0c49",
                                "sense_id": "2067215e-eec4-35ea-a0a6-38c99f7b2bc1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Flesch kommt, geht der Herr Flesch.“"
                            },
                            {
                                "example_id": "3086a157-7195-408e-be59-a7fb2f9450aa",
                                "sense_id": "2067215e-eec4-35ea-a0a6-38c99f7b2bc1",
                                "text": "Flesch kommt und geht."
                            },
                            {
                                "example_id": "92688bfe-7f0d-48bc-99af-32793472b9e9",
                                "sense_id": "2067215e-eec4-35ea-a0a6-38c99f7b2bc1",
                                "text": "Fleschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
