{
    "word_family": [
        "snatcher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b99b0714-5cfc-3335-a4b3-19df57abe85f",
                    "sense_definition": "To grasp and remove something quickly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grasping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child <w>snatched</w> the toy from his friend's hand.",
                            "target_lang_translations": {
                                "cs": "Dítě <w>vytrhlo</w> hračku z ruky svého kamaráda."
                            }
                        },
                        {
                            "text": "She <w>snatched</w> her bag and ran to catch the bus.",
                            "target_lang_translations": {
                                "cs": "Popadla <w>tašku</w> a běžela stihnout autobus."
                            }
                        }
                    ],
                    "synonyms": [
                        "grab"
                    ],
                    "common_phrases": [
                        "snatch up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle něco uchopit a vzít."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chňapnout",
                                "target_lang_sense_clarification": "rychlé, nečekané uchopení"
                            },
                            {
                                "target_lang_word": "vytrhnout",
                                "target_lang_sense_clarification": "uchopení a vytažení něčeho z něčí ruky nebo držení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc3aa120-d8a9-3433-afb2-14f4021849a9",
                    "sense_definition": "To steal something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thief <w>snatched</w> her purse while she was walking in the park.",
                            "target_lang_translations": {
                                "cs": "Zloděj jí <w>ukradl</w> kabelku, zatímco šla parkem."
                            }
                        },
                        {
                            "text": "Someone <w>snatched</w> his phone right out of his pocket.",
                            "target_lang_translations": {
                                "cs": "Někdo mu <w>vytrhl</w> telefon přímo z kapsy."
                            }
                        }
                    ],
                    "synonyms": [
                        "steal",
                        "pilfer",
                        "pinch"
                    ],
                    "target_lang_definitions": {
                        "cs": "Někomu něco ukrást."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ukrást",
                                "target_lang_sense_clarification": "obecný výraz pro krádež"
                            },
                            {
                                "target_lang_word": "sebrat",
                                "target_lang_sense_clarification": "neformální výraz pro krádež nebo vzítí něčeho bez dovolení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c81462af-e540-3868-bc1c-8cca9827bcd5",
                    "sense_definition": "To do something quickly in the limited time available.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>snatched</w> a quick lunch before the meeting started.",
                            "target_lang_translations": {
                                "cs": "Před začátkem schůzky <w>urval</w> rychlý oběd."
                            }
                        },
                        {
                            "text": "I managed to <w>snatch</w> a few minutes of sleep during the break.",
                            "target_lang_translations": {
                                "cs": "Během přestávky se mi podařilo <w>urvat</w> pár minut spánku."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snatch time"
                    ],
                    "target_lang_definitions": {
                        "cs": "Udělat něco rychle ve vymezeném čase."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "urvat",
                                "target_lang_sense_clarification": "neformální výraz pro získání času nebo příležitosti"
                            },
                            {
                                "target_lang_word": "vyšetřit",
                                "target_lang_sense_clarification": "najít si čas na něco"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1cd79168-3533-31af-8b41-49b97f2ae37c",
                    "sense_definition": "A quick grab or catch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grasping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper made a desperate <w>snatch</w> at the ball.",
                            "target_lang_translations": {
                                "cs": "Brankář se zoufale <w>chňapl</w> po míči."
                            }
                        },
                        {
                            "text": "With a quick <w>snatch</w>, he grabbed the falling glass.",
                            "target_lang_translations": {
                                "cs": "Rychlým <w>trhnutím</w> zachytil padající sklenici."
                            }
                        }
                    ],
                    "synonyms": [
                        "grab"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychlé uchopení nebo pokus o zachycení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chňapnutí",
                                "target_lang_sense_clarification": "akce rychlého uchopení"
                            },
                            {
                                "target_lang_word": "trhnutí",
                                "target_lang_sense_clarification": "prudký pohyb rukou při pokusu něco chytit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcd14018-afa4-3da0-baac-6e185d3e33e3",
                    "sense_definition": "A short, incomplete piece of sound, music, or conversation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a <w>snatch</w> of music coming from the open window.",
                            "target_lang_translations": {
                                "cs": "Z otevřeného okna jsem zaslechl <w>úryvek</w> hudby."
                            }
                        },
                        {
                            "text": "She caught a <w>snatch</w> of their conversation as they walked past.",
                            "target_lang_translations": {
                                "cs": "Když procházeli kolem, zaslechla <w>útržek</w> jejich rozhovoru."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátký, neúplný úsek zvuku, hudby nebo rozhovoru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "úryvek",
                                "target_lang_sense_clarification": "část hudby nebo textu"
                            },
                            {
                                "target_lang_word": "útržek",
                                "target_lang_sense_clarification": "fragment rozhovoru nebo zvuku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04c554d4-a73a-3575-81e1-ec0a7868a080",
                    "sense_definition": "A short, irregular period of activity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He only managed to get sleep in short <w>snatches</w> during the night.",
                            "target_lang_translations": {
                                "cs": "Během noci se mu podařilo spát jen v krátkých <w>úsecích</w>."
                            }
                        },
                        {
                            "text": "They worked in <w>snatches</w> whenever they had a free moment.",
                            "target_lang_translations": {
                                "cs": "Pracovali <w>nárazově</w>, kdykoliv měli volnou chvíli."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in snatches"
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátké, nepravidelné období aktivity."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "po částech",
                                "target_lang_sense_clarification": "vykonávání činnosti v krátkých intervalech"
                            },
                            {
                                "target_lang_word": "nárazově",
                                "target_lang_sense_clarification": "aktivita probíhající v krátkých, nesouvislých úsecích"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}