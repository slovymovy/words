                "senses": [
                    {
                        "sense_id": "e5b02f16-2425-321b-bff5-963924bc1562",
                        "entry_id": "9b6505d2-ae4a-345f-bd99-9fe822e8af6d",
                        "glosses": [
                            "Sprache, die in Karatschai-Tscherkessien und Dagestan (Russland) vom Volk der Nogaier gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "256f185b-2909-4f17-ab50-a4e59c27ab21",
                                "sense_id": "e5b02f16-2425-321b-bff5-963924bc1562",
                                "text": "„Für jeden, der noch keine nähere Bekanntschaft mit dem Nogaischen gemacht hat, präsentiert sich dadurch diese kaum bekannte Sprache angenehm und leichtgängig, besonders dann, wenn der Leser bereits auf Kenntnisse in einer anderen kiptschakischen Turksprache zurückgreifen kann.“"
                            },
                            {
                                "example_id": "fd2c0bbf-4d55-4795-bd65-861212c71ee4",
                                "sense_id": "e5b02f16-2425-321b-bff5-963924bc1562",
                                "text": "„Im Jahre 1928 wurde das Nogaische zur Schriftsprache deklariert und ein auf der Lateinschrift basierendes Alphabet entworfen[.]“"
                            },
                            {
                                "example_id": "130567c8-a27a-4a31-aeaa-d4a2676a0bc4",
                                "sense_id": "e5b02f16-2425-321b-bff5-963924bc1562",
                                "text": "„Zu den indogermanischen Sprachen gehören Russisch, Ukrainisch, Armenisch, Ossetisch, Kurdisch, Tātī, Tālyšī, zu den Turksprachen Azerbajdžanisch, Kumykisch, Karačajisch-Balkarisch und Nogaisch, zu den semitischen Sprachen das (neuostaramäische) Aysor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
