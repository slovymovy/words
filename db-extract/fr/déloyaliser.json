                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ffe8d34-1dc8-4fce-aad0-3821b18a385d",
                                "sense_id": "54016bd6-f522-37ec-b3d2-aec2374625be",
                                "text": "la lâcheté, ça à un nom et ça peut même se chiffrer : 45 centimes d’augmentation chez BP Total Fina Lagardère EADS Cie et les insurgés se rebellent pour se déloyaliser'…"
                            },
                            {
                                "example_id": "da4a5509-9c84-49e6-9bca-63fa09b88869",
                                "sense_id": "54016bd6-f522-37ec-b3d2-aec2374625be",
                                "text": "Les anciens chefs de confrérie ou de zaouïa, qui étaient des hommes de valeur, seront mort et remplacés par leur progéniture, que l'on a pris soin de déloyaliser."
                            },
                            {
                                "example_id": "6329163d-c586-4890-bdcd-96ca4cdbc8cd",
                                "sense_id": "54016bd6-f522-37ec-b3d2-aec2374625be",
                                "text": "Le sergent Chronus, gagné en tournoi, déloyalisé par mes soins en aspirant Kronar"
                            }
                        ]
