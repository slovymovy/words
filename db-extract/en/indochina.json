    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "64ee8923-d608-3528-a1f6-5f5929ec650e",
                "word": "Indochina",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ae608c0a-605c-34c3-8280-4afb9df9c2d4",
                        "entry_id": "64ee8923-d608-3528-a1f6-5f5929ec650e",
                        "glosses": [
                            "A peninsula and geographic region of Southeast Asia, consisting of the mainland portion, not including islands such as those of Indonesia."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b849680a-9941-393b-90b9-7db02d77a3a1",
                        "entry_id": "64ee8923-d608-3528-a1f6-5f5929ec650e",
                        "glosses": [
                            "A former French colony in Southeast Asia comprising the peninsula containing Vietnam, Cambodia and Laos; in full, French Indochina."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b0a6b06-ed2b-4d4e-8166-861051726bf1",
