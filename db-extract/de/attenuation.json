                "senses": [
                    {
                        "sense_id": "ba1d5228-056d-351c-b7de-ab1a2d0215bd",
                        "entry_id": "3a4674c3-c909-3741-866f-cd033496b90b",
                        "glosses": [
                            "Verdünnung, Abschwächung"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "155927bc-3cbb-424c-8275-7c065e4502eb",
                                "sense_id": "ba1d5228-056d-351c-b7de-ab1a2d0215bd",
                                "text": "„In der Folge der Zerlegung der Maltose in Alkohol und Kohlensäure verringert sich der Extractgehalt (e) der Stammwürze. Man bezeichnet diese Abnahme als Attenuation (Verdünnung).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8b2fad09-4707-321d-81d1-c3c3298c7e79",
                        "entry_id": "3a4674c3-c909-3741-866f-cd033496b90b",
                        "glosses": [
                            "Methode der Regulation der Genexpression durch Verzögerung bestimmter Prozesse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3e963a-69e7-401b-835e-e5666469bb36",
                                "sense_id": "8b2fad09-4707-321d-81d1-c3c3298c7e79",
                                "text": "„Unter Attenuation versteht man die Regulation der Genexpression durch vorzeitigen Abbruch der Transkription, weshalb durch sie eine Feinregulation der Transkription erfolgen kann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
