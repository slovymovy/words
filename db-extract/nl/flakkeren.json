        "nl-extract.jsonl": [
            {
                "entry_id": "58d2cae1-4377-39cb-b100-fff9684f40fb",
                "word": "flakkeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "64062552-7b2a-3ea0-97d8-4a1ff675c59f",
                        "entry_id": "58d2cae1-4377-39cb-b100-fff9684f40fb",
                        "glosses": [
                            "onrustig branden met grote en dan weer kleine vlammen en de vlammen zijn ook niet altijd op dezelfde plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d80620-c6ca-4d0f-87c7-ab5a063996fe",
                                "sense_id": "64062552-7b2a-3ea0-97d8-4a1ff675c59f",
                                "text": "Voor de woning aan de Zonnedauw in Reuver waar zich donderdag een dodelijk drama afspeelde, hebben kinderen en volwassenen bloemen neergelegd. Tussen de vele tulpen en veldboeketten flakkeren kaarsjes en liggen knuffels. 'Slaap zacht, kleine Engel', luidt een neergelegde tekst voor het 3-jarige meisje dat donderdag door haar vader werd vermoord."
                            }
                        ]
                    },
                    {
                        "sense_id": "d598ec62-8a2a-3acb-8b6b-300095bdd245",
                        "entry_id": "58d2cae1-4377-39cb-b100-fff9684f40fb",
                        "glosses": [
                            "zwakjes nog aanwezig zijn maar kan makkelijk gedoofd worden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b1a1dcb6-f893-4dd4-8678-f5744a5b2c68",
                                "sense_id": "d598ec62-8a2a-3acb-8b6b-300095bdd245",
                                "text": "De onderhandelaars in Den Haag zullen zelf ook heen en weer geslingerd worden tussen het spenderen of koesteren van het overschot. Spenderen is bovendien ‘pro-cyclisch’. Net als bezuinigen bij tegenslag doorgaans geen goed idee is - tenzij er nijpende andere overwegingen zijn - is uitgeven bij hoogconjunctuur dat ook niet. In het ene geval doof je het flakkerende vlammetje van de resterende bedrijvigheid, in het andere gooi je olie op een verzengend vuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "365e1149-b966-42f0-b7f2-6b3513b15e5c",
                        "source_entry_id": "58d2cae1-4377-39cb-b100-fff9684f40fb",
                        "source_sense_id": "64062552-7b2a-3ea0-97d8-4a1ff675c59f",
                        "source_sense_description": "onrustig branden met grote en dan weer kleine vlammen en de vlammen zijn ook niet altijd op dezelfde plaats",
                        "target_lang_word": "flame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cee8e264-04ec-37ca-9b5b-efa29eaf3db6",
                                        "entry_id": "9eb422bd-18a4-305e-ace1-cb6103d426c8",
                                        "glosses": [
                                            "The visible part of fire; a stream of burning vapour or gas, emitting light and heat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc8f5634-391b-4a1c-95d3-ea2eadc46c0d",
                                                "sense_id": "cee8e264-04ec-37ca-9b5b-efa29eaf3db6",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame."
                                            },
                                            {
                                                "example_id": "259af002-f4ce-450a-9acc-23912bb341e0",
                                                "sense_id": "cee8e264-04ec-37ca-9b5b-efa29eaf3db6",
                                                "text": "Long after his cigar burnt bitter, he sat with eyes fixed on the blaze. When the flames at last began to flicker and subside, his lids fluttered, then drooped; but he had lost all reckoning of time when he opened them again to find Miss Erroll in furs and ball-gown kneeling on the hearth[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "697ab9aa-8012-3bf1-88a3-aa22c1257065",
                                        "entry_id": "9eb422bd-18a4-305e-ace1-cb6103d426c8",
                                        "glosses": [
                                            "A romantic partner or lover in a usually short-lived but passionate affair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "351b61ba-8425-4009-80b7-9836f41a5f3f",
                                                "sense_id": "697ab9aa-8012-3bf1-88a3-aa22c1257065",
                                                "text": "I could copy out yards of rhapsody to Lord George Poynings, her old flame, in which she addressed him by the most affectionate names."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb6b5d1-0893-304a-88f3-a0cf80f09397",
                                        "entry_id": "9eb422bd-18a4-305e-ace1-cb6103d426c8",
                                        "glosses": [
                                            "An aggressively insulting criticism or remark."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1198984-cfc4-47b0-913e-3850b29253bd",
                                                "sense_id": "1cb6b5d1-0893-304a-88f3-a0cf80f09397",
                                                "text": "Flames are, unfortunately, a fact of USENET life. It's a rare USENET regular who hasn't been shaken to the foundations with anger at something some jerk has posted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d818028-126f-35c2-87a8-29ee813737cd",
                                        "entry_id": "9eb422bd-18a4-305e-ace1-cb6103d426c8",
                                        "glosses": [
                                            "A brilliant reddish orange-gold fiery colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ab9461-3c4f-4363-b399-91398579ee85",
                                                "sense_id": "6d818028-126f-35c2-87a8-29ee813737cd",
                                                "text": "[M]arked by myriad clouds of every sunset-colour - flame, purple, pink, green, violet, and all the tints of gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256464cf-0616-3b9a-a1d1-e518577bb79f",
                                        "entry_id": "9eb422bd-18a4-305e-ace1-cb6103d426c8",
                                        "glosses": [
                                            "A brilliant reddish orange-gold fiery colour.\\nflame:",
                                            "flame"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d59931d-4f0e-3e7b-ba41-b0f49d2128ce",
                                        "entry_id": "9eb422bd-18a4-305e-ace1-cb6103d426c8",
                                        "glosses": [
                                            "The contrasting light and dark figure seen in wood used for stringed instrument making; the curl."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ab230e-b333-41ea-bb45-28f6f96a5457",
                                                "sense_id": "4d59931d-4f0e-3e7b-ba41-b0f49d2128ce",
                                                "text": "The cello has a two-piece back with a beautiful narrow flame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b62a8a4-7b49-3fe8-af84-de4808feab32",
                                        "entry_id": "9eb422bd-18a4-305e-ace1-cb6103d426c8",
                                        "glosses": [
                                            "Burning zeal, passion, imagination, excitement, or anger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9c450d-5058-48f7-b998-5fa6425aaa6c",
                                                "sense_id": "9b62a8a4-7b49-3fe8-af84-de4808feab32",
                                                "text": "in a flame of zeal severe"
                                            },
                                            {
                                                "example_id": "8b3810c4-64a7-4502-af76-01a4f7e5a7f2",
                                                "sense_id": "9b62a8a4-7b49-3fe8-af84-de4808feab32",
                                                "text": "where flames refin'd in breasts seraphic glow"
                                            },
                                            {
                                                "example_id": "20c1be40-4825-4008-be2a-97547f271c00",
                                                "sense_id": "9b62a8a4-7b49-3fe8-af84-de4808feab32",
                                                "text": "Till charming Florio, born to conquer, came\nAnd touch'd the fair one with an equal flame"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "477013ae-3421-3357-a3f3-723161283c0e",
                                        "entry_id": "9eb422bd-18a4-305e-ace1-cb6103d426c8",
                                        "glosses": [
                                            "A variety of carnation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1659fcf-39bf-4faf-90ee-989f5fed23de",
                                                "sense_id": "477013ae-3421-3357-a3f3-723161283c0e",
                                                "text": "The Gardeners divide it into Five Claſſes, which they diſtinguiſh by the Name of Picketees, Painted Ladies, Beazarts, Flakes, and Flames: […] the Flames have a red Ground always ſtrip’d with black or very dark Colours."
                                            },
                                            {
                                                "example_id": "b96c4e04-4362-497c-aa0e-69369d4f6cfb",
                                                "sense_id": "477013ae-3421-3357-a3f3-723161283c0e",
                                                "text": "Sic flow’rs o’ sorts ane seldom sees, / Flecks, flames, bussards an’ picketees, / Wi’ strong carnations, like young trees, / To face the entry; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af7c327f-42a1-36a1-847c-66e402bfa9c2",
                                        "entry_id": "00b7ebab-c0f3-3db2-b3b6-643955093adc",
                                        "glosses": [
                                            "Of a brilliant reddish orange-gold colour, like that of a flame."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ac9274a-2f6d-3711-aa91-2b6beecbc82e",
                                        "entry_id": "9dad940c-eea3-3bba-a0e1-b7673d00ac3a",
                                        "glosses": [
                                            "To produce flames; to burn with a flame or blaze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191a75e1-ec3b-4aa9-8e37-f4bdfd6d6f6e",
                                                "sense_id": "5ac9274a-2f6d-3711-aa91-2b6beecbc82e",
                                                "text": "The main blaze of it is past, but a small thing would make it flame again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "316e2a1f-0ad3-33a8-aee8-746e2a5b87af",
                                        "entry_id": "9dad940c-eea3-3bba-a0e1-b7673d00ac3a",
                                        "glosses": [
                                            "To burst forth like flame; to break out in violence of passion; to be kindled with zeal or ardour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec3b60b-04d5-4a81-91ec-49e75f478c90",
                                                "sense_id": "316e2a1f-0ad3-33a8-aee8-746e2a5b87af",
                                                "text": "He flamed with indignation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792b362a-5622-3d17-a15a-dbd447cede7d",
                                        "entry_id": "9dad940c-eea3-3bba-a0e1-b7673d00ac3a",
                                        "glosses": [
                                            "To post a destructively critical or abusive message (to somebody)."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28190a4-5946-4ba3-a74f-c61bac67a10e",
                                                "sense_id": "792b362a-5622-3d17-a15a-dbd447cede7d",
                                                "text": "I flamed him for spamming in my favourite newsgroup."
                                            },
                                            {
                                                "example_id": "d54b6fea-e0c6-43ec-ab16-42ac6ca55f4d",
                                                "sense_id": "792b362a-5622-3d17-a15a-dbd447cede7d",
                                                "text": "I wish you had the nerve to put your own name on that article, rather than logging into a public account to do it. I would have prefered^([sic]) to respond to you personally, rather than burden the net with my flaming, particularly since opinions like yours are best left ignored. But I feel I must respond to this one."
                                            },
                                            {
                                                "example_id": "fa1faf1a-bd6c-4474-8dd9-42b893fe696c",
                                                "sense_id": "792b362a-5622-3d17-a15a-dbd447cede7d",
                                                "text": "This was one of the highest points of the show for me. Playin' followed, with a nice jam afterwards. After that, Jerry wandered into Crazy Fingers. (I had been hoping for Terrapin...oh well. Crazy Fingers seems to highlight Jerry's ability to come in late and tentative on lyrics. I'm sure I'll get flamed, since lots of folks seem to worship CF.)"
                                            },
                                            {
                                                "example_id": "7cc1a75a-7488-4e00-8102-77b8f49be6e4",
                                                "sense_id": "792b362a-5622-3d17-a15a-dbd447cede7d",
                                                "text": "If he got flamed for his lies or his ignorance, he simply moved to another chat room."
                                            },
                                            {
                                                "example_id": "4b9753de-4ce1-4d46-92f2-3b0ba9709f58",
                                                "sense_id": "792b362a-5622-3d17-a15a-dbd447cede7d",
                                                "text": "Because online communication makes it easy to flame, many of us impetuously fire off messages that we later regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
