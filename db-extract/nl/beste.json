            {
                "entry_id": "6f24a11c-847f-3ac5-986a-7b459d96a37f",
                "word": "beste",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a7d82b0-ee6c-3175-8ca7-c89f273f9d60",
                        "entry_id": "6f24a11c-847f-3ac5-986a-7b459d96a37f",
                        "glosses": [
                            "persoon die alle anderen in iets overtreft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99decc8e-6651-403b-8d5e-45d84c8b15a1",
                                "sense_id": "9a7d82b0-ee6c-3175-8ca7-c89f273f9d60",
                                "text": "Bedenk wel dat de mensen die van het all-inclusive systeem zo’n succes hebben gemaakt echte profs zijn. De besten op hun vakgebied."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e78fea8-590e-32cb-8f59-a1dbc57d9d8a",
                        "entry_id": "6f24a11c-847f-3ac5-986a-7b459d96a37f",
                        "glosses": [
                            "iets dat al het andere overtreft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c6b77bc-6563-4404-a1a5-e95d78706cbd",
                                "sense_id": "0e78fea8-590e-32cb-8f59-a1dbc57d9d8a",
                                "text": "Daarom gaat de gemeente bestaande maatregelen verstevigen. Zo gaat ze inwoners en horecaondernemers beter informeren over hoe ze afval het beste kunnen opruimen en komen er meer afvalbakken. Ook geeft de gemeente woningcorporaties en bewoners advies over kieren en gaten in huizen, en hoe deze gedicht kunnen worden."
                            }
                        ]
                    }
                ],
