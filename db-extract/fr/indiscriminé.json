                                "target_senses": [
                                    {
                                        "sense_id": "c2627999-3b75-3695-a925-b8426b5f0b9e",
                                        "entry_id": "fafbff0f-54a3-3c27-890a-01b244219fee",
                                        "glosses": [
                                            "Not marked by discrimination or discernment; (by extension) confused, promiscuous."
                                        ],
                                        "tags": [
                                            "of things"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65cf940f-a11f-4524-9776-e8cccc737e1d",
                                                "sense_id": "c2627999-3b75-3695-a925-b8426b5f0b9e",
                                                "text": "Otanes […] commanded an indiscriminate slaughter, without regard to age or to place."
                                            },
                                            {
                                                "example_id": "d663076a-db81-4e29-9ed4-dcfcd61c595b",
                                                "sense_id": "c2627999-3b75-3695-a925-b8426b5f0b9e",
                                                "text": "The UK's fishing industry has complained that Ocean is “indiscriminate” (arguably an ironic adjective for anyone involved in trawling)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6588dd93-dc81-3b8f-b069-ae71585307e3",
                                        "entry_id": "fafbff0f-54a3-3c27-890a-01b244219fee",
                                        "glosses": [
                                            "Without care in making distinctions, thoughtless."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b210654-9f54-4e6d-95e2-83307f46c4cb",
                                                "sense_id": "6588dd93-dc81-3b8f-b069-ae71585307e3",
                                                "text": "How can anyone be so indiscriminate in making friends as he is?"
                                            },
                                            {
                                                "example_id": "0f9b39cf-5087-46d3-97de-cabed0bf1ac2",
                                                "sense_id": "6588dd93-dc81-3b8f-b069-ae71585307e3",
                                                "text": "An animal so indiscriminate in its eating habits that it eats coal, boat cushions, and tomtoms, would be only too eager to taste a swimmer or a diver—which must look more edible than an unopened can of salmon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
