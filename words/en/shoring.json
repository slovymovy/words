    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f0f70ea-8b69-3098-a1b9-fc3d352a1db5",
                    "sense_definition": "Temporary bracing used to prevent a structure like a wall or trench from collapsing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers installed heavy <w>shoring</w> to keep the trench walls from falling in.",
                            "target_lang_translations": {
                                "ru": "Рабочие установили тяжелые <w>подпоры</w>, чтобы предотвратить обрушение стен траншеи."
                            }
                        },
                        {
                            "text": "Without proper <w>shoring</w>, the old building would be unsafe for the construction crew.",
                            "target_lang_translations": {
                                "ru": "Без надлежащего <w>крепления</w> старое здание было бы небезопасным для строительной бригады."
                            }
                        }
                    ],
                    "synonyms": [
                        "support",
                        "brace",
                        "prop"
                    ],
                    "common_phrases": [
                        "install shoring",
                        "temporary shoring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временные опорные конструкции, используемые для предотвращения обрушения стен, траншей или зданий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпоры",
                                "target_lang_sense_clarification": "временные конструкции для поддержки чего-либо"
                            },
                            {
                                "target_lang_word": "крепление",
                                "target_lang_sense_clarification": "укрепление стенок траншей или шахт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d6087b2-e0a9-3bef-bcf5-cd9e71e94cd9",
                    "sense_definition": "Present participle and gerund of <w>shore</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>shoring</w> up the foundation to prevent the house from sinking further.",
                            "target_lang_translations": {
                                "ru": "Они <w>укрепляют</w> фундамент, чтобы дом не просел еще сильнее."
                            }
                        },
                        {
                            "text": "The engineers spent the entire afternoon <w>shoring</w> the tunnel entrance against potential rockfalls.",
                            "target_lang_translations": {
                                "ru": "Инженеры провели весь день, <w>укрепляя</w> вход в туннель от возможных обвалов."
                            }
                        }
                    ],
                    "synonyms": [
                        "supporting",
                        "bracing",
                        "propping"
                    ],
                    "common_phrases": [
                        "shoring up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb shore."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс установки временных опор для укрепления чего-либо (обычно используется с предлогом 'up')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрепление",
                                "target_lang_sense_clarification": "процесс усиления конструкции"
                            },
                            {
                                "target_lang_word": "подпирание",
                                "target_lang_sense_clarification": "действие по установке подпорок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
