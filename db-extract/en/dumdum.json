            {
                "entry_id": "39af4bce-2d86-3a1d-8546-4d9b83c0ea23",
                "word": "dumdum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "db5c1138-c3d8-41a6-bdc4-90ace5f51518",
                        "entry_id": "39af4bce-2d86-3a1d-8546-4d9b83c0ea23",
                        "tags": [
