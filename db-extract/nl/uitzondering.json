                "senses": [
                    {
                        "sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                        "entry_id": "84de7532-2129-32b7-b069-ac2f9104fcf2",
                        "glosses": [
                            "een geval waarbij men iets niet onder een regel laat vallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c2b22b-466f-4291-ab7e-b3f01131f766",
                                "sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                                "text": "Hij maakte een uitzondering voor de zieke leerling die het proefwerk gemist had."
                            },
                            {
                                "example_id": "91fe5db5-240c-4389-84e3-b4dabd82f179",
                                "sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                                "text": "Mevrouw Maillard had alle directeuren in haar hart gesloten, zonder uitzondering."
                            },
                            {
                                "example_id": "bee1ebf3-ce9a-4202-b1bc-2044b9e46506",
                                "sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                                "text": "Velen van ons zijn slaaf van onze schulden geworden en ik was hierop geen uitzondering."
                            },
                            {
                                "example_id": "9d40f985-42d9-40f7-b2af-692a1d4a2b88",
                                "sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                                "text": "Omdat ik maar niet ophield ernaar te vragen, werd er een uitzondering gemaakt en mocht ik als vierjarige wel al mee naar de zondagsschool."
                            },
                            {
                                "example_id": "c4d97fdc-04f9-4db7-a4b9-ef41c8f262aa",
                                "sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                                "text": "De nationalisten hadden de controle gekregen over Oud-Castilië, Leon, Oviedo, Alava, Navarra, Galicië, Zaragoza, de Canarische Eilanden en alle Balearen, met uitzondering van Menorca."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a75c54f-1ca2-455e-8985-e71fbb89cb73",
                        "source_entry_id": "84de7532-2129-32b7-b069-ac2f9104fcf2",
                        "source_sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                        "source_sense_description": "een geval waarbij men iets niet onder een regel laat vallen",
                        "target_lang_word": "Ausnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42ed3dfa-f331-3859-baea-c0703cdabc7e",
                                        "entry_id": "e0712bb0-20ea-3a75-9288-041fb8192017",
                                        "glosses": [
                                            "Abweichung von einer Regel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17b52637-de47-473c-8732-9bb49ae0c44b",
                                                "sense_id": "42ed3dfa-f331-3859-baea-c0703cdabc7e",
                                                "text": "Manuel fährt meistens Taxi. Dass er den Bus nimmt, ist eher die Ausnahme."
                                            },
                                            {
                                                "example_id": "b36382a1-4454-4eea-8b98-db7d81ccedab",
                                                "sense_id": "42ed3dfa-f331-3859-baea-c0703cdabc7e",
                                                "text": "„Änderungsanträge für Ausnahmen zugunsten von Pubs, in denen kein Essen serviert wird, wurden abgelehnt.“"
                                            },
                                            {
                                                "example_id": "b38d5604-3d45-4341-b1b4-0511038b5721",
                                                "sense_id": "42ed3dfa-f331-3859-baea-c0703cdabc7e",
                                                "text": "„Die einzige Ausnahme scheint der Gouverneur selbst gewesen zu sein - doch das mag an Lücken in den Aufzeichnungen liegen, nicht daran, dass man im Gouverneurspalast der Keuschheit frönte.“"
                                            },
                                            {
                                                "example_id": "dd06f73f-6487-4336-bc71-48140561fcfc",
                                                "sense_id": "42ed3dfa-f331-3859-baea-c0703cdabc7e",
                                                "text": "„In Anbetracht des Eifers, der im Augenblick an den Tag gelegt wird, werde ich eine Ausnahme von meiner allgemeinen Regel machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea9c7b66-492b-401b-96e7-7e7c09a8a9fe",
                        "source_entry_id": "84de7532-2129-32b7-b069-ac2f9104fcf2",
                        "source_sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                        "source_sense_description": "een geval waarbij men iets niet onder een regel laat vallen",
                        "target_lang_word": "exception",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exception",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41d40f72-0825-3f01-bc0d-5a79b1371c40",
                                        "entry_id": "f17dba49-3630-3759-ac25-f5a296c2237d",
                                        "glosses": [
                                            "The act of excepting or excluding; exclusion; restriction by taking out something which would otherwise be included, as in a class, statement, rule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08164f97-52b3-4691-b300-c6af6093c7e8",
                                                "sense_id": "41d40f72-0825-3f01-bc0d-5a79b1371c40",
                                                "text": "the exception of a rule"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23d9cc6-b05d-3eab-8e29-c9ad1094cb3a",
                                        "entry_id": "f17dba49-3630-3759-ac25-f5a296c2237d",
                                        "glosses": [
                                            "That which is excluded from others; a person, thing, or case, specified as distinct, or not included."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eb635bb-e503-42d9-b0c0-fe393740c544",
                                                "sense_id": "c23d9cc6-b05d-3eab-8e29-c9ad1094cb3a",
                                                "text": "That rule is usually true, but there are a few exceptions."
                                            },
                                            {
                                                "example_id": "44e595f5-a5e4-4b53-bb65-1114067300f0",
                                                "sense_id": "c23d9cc6-b05d-3eab-8e29-c9ad1094cb3a",
                                                "text": "The Thirteenth Amendment to the U.S. Constitution had abolished slavery but allowed one major exception: slavery remained appropriate as punishment for a crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1829d40b-77b1-3f5c-8b62-ddfcd6c5aab8",
                                        "entry_id": "f17dba49-3630-3759-ac25-f5a296c2237d",
                                        "glosses": [
                                            "An objection, on legal grounds; also, as in conveyancing, a clause by which the grantor excepts or reserves something before the right is transferred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89221f28-736f-3f4b-9b5e-a122ed0e90cc",
                                        "entry_id": "f17dba49-3630-3759-ac25-f5a296c2237d",
                                        "glosses": [
                                            "An objection; cavil; dissent; disapprobation; offense; cause of offense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca55fe69-af33-3c7f-84a5-cbf74198031e",
                                        "entry_id": "f17dba49-3630-3759-ac25-f5a296c2237d",
                                        "glosses": [
                                            "An interruption in normal processing, typically caused by an error condition, that can be raised (\\\"thrown\\\") by one part of the program and handled (\\\"caught\\\") by another part."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e088834a-c110-4df8-a07c-9c7bfe7e1ca5",
                                                "sense_id": "ca55fe69-af33-3c7f-84a5-cbf74198031e",
                                                "text": "null pointer exception"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88c8ed17-2956-4303-8703-e22c26b19597",
                        "source_entry_id": "84de7532-2129-32b7-b069-ac2f9104fcf2",
                        "source_sense_id": "06759a14-9665-345d-a95f-8fed7a4f8591",
                        "source_sense_description": "een geval waarbij men iets niet onder een regel laat vallen",
                        "target_lang_word": "exception",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exception",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62d030e8-e764-3feb-8e3a-675970539019",
                                        "entry_id": "040332b6-cebf-3489-9864-76fea2e74cbf",
                                        "glosses": [
                                            "Action d’excepter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b811b4f-b0d2-4f08-9952-175f8ede1ac3",
                                                "sense_id": "62d030e8-e764-3feb-8e3a-675970539019",
                                                "text": "L’interdiction de fumer ne souffrait aucune exception, mais quelques officiers sortirent dans la galerie pour y chiquer à leur aise."
                                            },
                                            {
                                                "example_id": "635aa1d0-15bc-475d-9be4-bdf4dc70fcb4",
                                                "sense_id": "62d030e8-e764-3feb-8e3a-675970539019",
                                                "text": "[…] : sous l’ancien régime, en Gascogne, le droit d’aînesse ne souffrait jamais d’exception, et un bien de famille conservé intégralement, de génération en génération, n’était jamais divisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9447c770-b8de-338f-938d-53c66dea4862",
                                        "entry_id": "040332b6-cebf-3489-9864-76fea2e74cbf",
                                        "glosses": [
                                            "Ce qui est excepté."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7645d73-38b4-4cfd-926c-9627c8ee0f32",
                                                "sense_id": "9447c770-b8de-338f-938d-53c66dea4862",
                                                "text": "Manquerait plus que les autres pays se cultivent et pas nous. On y tient, à notre exception culturelle française ! On veut se culturer, comme dit la pub. Et pas que le physique."
                                            },
                                            {
                                                "example_id": "bf6dfb56-b70b-4a64-b6f1-e8268a451dee",
                                                "sense_id": "9447c770-b8de-338f-938d-53c66dea4862",
                                                "text": "Il n’y a règle si générale qui n’ait son exception."
                                            },
                                            {
                                                "example_id": "7cf0f531-7a38-43f1-81e2-61ffb614f687",
                                                "sense_id": "9447c770-b8de-338f-938d-53c66dea4862",
                                                "text": "Cela ne souffre point d’exception."
                                            },
                                            {
                                                "example_id": "da2625ff-8961-43b5-ba4c-88a2fa90b96d",
                                                "sense_id": "9447c770-b8de-338f-938d-53c66dea4862",
                                                "text": "L’exception confirme la règle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f08f76e1-0daf-3f58-9ca5-02c218bffc7b",
                                        "entry_id": "040332b6-cebf-3489-9864-76fea2e74cbf",
                                        "glosses": [
                                            "Moyen de défense, et particulièrement de celui à l’aide desquels on soutient qu’une demande doit être déclarée non recevable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f829d20-660f-4070-9a99-80fed6bc2eee",
                                                "sense_id": "f08f76e1-0daf-3f58-9ca5-02c218bffc7b",
                                                "text": "J’ai une exception toute prête contre cette demande."
                                            },
                                            {
                                                "example_id": "e56c097e-3215-4266-a334-2f6fb8427604",
                                                "sense_id": "f08f76e1-0daf-3f58-9ca5-02c218bffc7b",
                                                "text": "C’est là que j’en reviens à ces histoires d’exceptions prises par conclusions écrites. Une exception en droit est un argument juridique soulevé en défense (on utilise le verbe exciper) qui vise à faire échec à tout ou partie des prétentions adverses."
                                            },
                                            {
                                                "example_id": "3c54d827-4651-46c1-a0a9-7fb1fc61e73b",
                                                "sense_id": "f08f76e1-0daf-3f58-9ca5-02c218bffc7b",
                                                "text": "Mes lecteurs habitués connaissent un peu le droit de la diffamation, et se souviendront que le premier moyen de défense est l'exception de vérité : si la personne poursuivie pour diffamation prouve la vérité du fait, elle est immune et impune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "581898bf-443b-3256-88ad-c0b3c014b325",
                                        "entry_id": "040332b6-cebf-3489-9864-76fea2e74cbf",
                                        "glosses": [
                                            "Interruption de l’exécution normale d'un programme à cause d'une erreur dont la possibilité de survenance a été anticipée lors de la conception."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
