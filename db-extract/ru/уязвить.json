                "senses": [
                    {
                        "sense_id": "b884bd26-b15e-3db7-9918-2a932f8456f4",
                        "entry_id": "236591d6-e4c3-3301-a93f-2682c2e06887",
                        "glosses": [
                            "to sting, to wound"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae8fb9b-8139-4f35-91cc-df164bef6318",
                                "sense_id": "b884bd26-b15e-3db7-9918-2a932f8456f4",
                                "text": "уязви́ть чьё-либо самолю́бие",
                                "translation": "to hurt someone's pride",
                                "english": "to hurt someone's pride"
                            },
                            {
                                "example_id": "b61a58b2-fbef-4c3b-bc77-19da5432fa31",
                                "sense_id": "b884bd26-b15e-3db7-9918-2a932f8456f4",
                                "text": "уязви́ть са́мое больно́е ме́сто",
                                "translation": "to touch/cut/wound to the quick",
                                "english": "to touch/cut/wound to the quick"
                            },
                            {
                                "example_id": "1b05c657-31d1-4185-9c63-ea04abdbd1aa",
                                "sense_id": "b884bd26-b15e-3db7-9918-2a932f8456f4",
                                "text": "Одна́ко, сколь ни ничто́жным сего́ челове́ка и все его́ мне́ния почита́ю, но уязвлён его́ отве́том, как ядови́той осо́й.",
                                "translation": "Nevertheless, insignificant as I consider this man and all his opinions to be, yet I am stung by his answer, as by a poisonous wasp.",
                                "english": "Nevertheless, insignificant as I consider this man and all his opinions to be, yet I am stung by his answer, as by a poisonous wasp."
                            }
                        ]
                    }
                ],
                "translations": [],
