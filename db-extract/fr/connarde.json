                "senses": [
                    {
                        "sense_id": "b42fe11c-a874-3468-8a14-d34e645ab66e",
                        "entry_id": "4cfc6a14-77ea-3cc8-8add-79fc8740fd8a",
                        "glosses": [
                            "Femme insupportable, méprisable."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "070390fe-65b7-4610-9351-03098299f018",
                                "sense_id": "b42fe11c-a874-3468-8a14-d34e645ab66e",
                                "text": "Et l’autre connarde qui s’offre le haut mal. Il faut que tu la foutes à la porte et que tu trouves quelqu’un pour me soigner."
                            },
                            {
                                "example_id": "8d4f7773-4ab2-4efd-95ec-fc96066c3e05",
                                "sense_id": "b42fe11c-a874-3468-8a14-d34e645ab66e",
                                "text": "Vous serez abandonnée par tous, parce que vous êtes folle, intenable à vivre. Une connarde..."
                            },
                            {
                                "example_id": "71c6b5a3-2aa9-47ba-acf1-e9652faae7bf",
                                "sense_id": "b42fe11c-a874-3468-8a14-d34e645ab66e",
                                "text": "Connarde ! Que voudrait-elle qu'il en fit d’un morcif pareil, le malheureux ?"
                            }
                        ]
                    }
                ],
