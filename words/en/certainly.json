                {
                    "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                    "sense_definition": "Without any doubt; definitely or surely.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident was <w>certainly</w> caused by a mechanical failure rather than human error.",
                            "target_lang_translations": {
                                "ru": "Авария, <w>несомненно</w>, была вызвана механической поломкой, а не человеческой ошибкой.",
                                "nl": "Het ongeluk werd <w>beslist</w> veroorzaakt door een mechanisch defect in plaats van een menselijke fout.",
                                "pl": "Wypadek został <w>z pewnością</w> spowodowany awarią mechaniczną, a nie błędem ludzkim.",
                                "de": "Der Unfall wurde <w>sicherlich</w> eher durch ein mechanisches Versagen als durch menschliches Versagen verursacht.",
                                "fr": "L'accident a <w>certainement</w> été causé par une défaillance mécanique plutôt que par une erreur humaine.",
                                "it": "L'incidente è stato <w>sicuramente</w> causato da un guasto meccanico piuttosto che da un errore umano.",
                                "cs": "Nehoda byla <w>nepochybně</w> způsobena mechanickou závadou, nikoli lidskou chybou.",
                                "tr": "Kaza, insan hatasından ziyade <w>kesinlikle</w> mekanik bir arızadan kaynaklanmıştı.",
                                "es": "El accidente fue <w>sin duda</w> causado por un fallo mecánico más que por un error humano.",
                                "zh": "这次事故<w>肯定</w>是由机械故障而非人为失误引起的。"
                            }
                        },
                        {
                            "text": "It will <w>certainly</w> rain later today, so you should take an umbrella.",
                            "target_lang_translations": {
                                "ru": "Сегодня <w>наверняка</w> пойдет дождь, так что тебе стоит взять зонт.",
                                "nl": "Het gaat later vandaag <w>zeker</w> regenen, dus je kunt beter een paraplu meenemen.",
                                "pl": "Dzisiaj później <w>na pewno</w> będzie padać, więc powinieneś wziąć parasol.",
                                "de": "Es wird heute Später <w>bestimmt</w> regnen, also solltest du einen Regenschirm mitnehmen.",
                                "fr": "Il va <w>sûrement</w> pleuvoir plus tard aujourd'hui, vous devriez donc prendre un parapluie.",
                                "it": "Pioverà <w>sicuramente</w> più tardi oggi, quindi dovresti prendere un ombrello.",
                                "cs": "Dnes později bude <w>určitě</w> pršet, takže by sis měl vzít deštník.",
                                "tr": "Bugün ilerleyen saatlerde <w>muhakkak</w> yağmur yağacak, bu yüzden yanına bir şemsiye almalısın.",
                                "es": "<w>Seguramente</w> lloverá más tarde hoy, así que deberías llevar un paraguas.",
                                "zh": "今天晚些时候<w>一定</w>会下雨，所以你应该带把伞。"
                            }
                        },
                        {
                            "text": "I will <w>certainly</w> not allow such behavior in my classroom.",
                            "target_lang_translations": {
                                "ru": "Я, <w>безусловно</w>, не допущу такого поведения в моем классе.",
                                "nl": "Ik zal zulk gedrag in mijn klaslokaal <w>beslist</w> niet toestaan.",
                                "pl": "Zdecydowanie <w>nie pozwolę</w> na takie zachowanie w mojej klasie.",
                                "de": "Ich werde ein solches Verhalten in meinem Klassenzimmer <w>gewiss</w> nicht dulden.",
                                "fr": "Je ne permettrai <w>certainement</w> pas un tel comportement dans ma classe.",
                                "it": "Non permetterò <w>certamente</w> un simile comportamento nella mia classe.",
                                "cs": "Takové chování ve své třídě <w>rozhodně</w> nestrpím.",
                                "tr": "Sınıfımda böyle bir davranışa <w>kesinlikle</w> izin vermeyeceğim.",
                                "es": "<w>Definitivamente</w> no permitiré ese comportamiento en mi salón de clases.",
                                "zh": "我<w>绝对</w>不会允许这种行为在我的课堂上出现。"
                            }
                        }
                    ],
