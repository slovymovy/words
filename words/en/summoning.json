{
    "word_family": [
        "summon",
        "summons",
        "summoner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2f882b8-0fc1-3f76-b6f8-bf1aabcd554d",
                    "sense_definition": "The present participle and gerund of <w>summon</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king is <w>summoning</w> his advisors to the castle for an urgent meeting.",
                            "target_lang_translations": {
                                "pl": "Król <w>wzywa</w> swoich doradców do zamku na pilne spotkanie.",
                                "de": "Der König <w>ruft</w> seine Berater für eine dringende Besprechung im Schloss <w>zusammen</w>."
                            }
                        },
                        {
                            "text": "She spent the entire afternoon <w>summoning</w> the courage to speak to her boss.",
                            "target_lang_translations": {
                                "pl": "Spędziła całe popołudnie, <w>zbierając</w> odwagę, by porozmawiać ze swoim szefem.",
                                "de": "Sie verbrachte den ganzen Nachmittag damit, den Mut <w>aufzubringen</w>, mit ihrem Chef zu sprechen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "summoning courage",
                        "summoning help"
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma imiesłowu czasu teraźniejszego lub rzeczownik odczasownikowy od czasownika 'wzywać'.",
                        "de": "Partizip Präsens oder Gerundium von 'summon' (zusammenrufen, einberufen, aufbringen)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wzywanie",
                                "target_lang_sense_clarification": "ogólne określenie aktu wzywania kogoś"
                            },
                            {
                                "target_lang_word": "przywoływanie",
                                "target_lang_sense_clarification": "w kontekście zbierania sił lub przywoływania kogoś/czegoś"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "herbeirufen",
                                "target_lang_sense_clarification": "Personen zu sich rufen"
                            },
                            {
                                "target_lang_word": "einberufen",
                                "target_lang_sense_clarification": "zu einer Versammlung rufen"
                            },
                            {
                                "target_lang_word": "aufbringen",
                                "target_lang_sense_clarification": "im Sinne von Mut oder Kraft sammeln"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71b602e9-4aad-3798-980a-62f619f96a81",
                    "sense_definition": "The act of ordering someone to appear or be present.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>summoning</w> of witnesses began on the second day of the trial.",
                            "target_lang_translations": {
                                "pl": "<w>Wzywanie</w> świadków rozpoczęło się drugiego dnia procesu.",
                                "de": "Die <w>Vorladung</w> der Zeugen begann am zweiten Verhandlungstag."
                            }
                        },
                        {
                            "text": "The ritual involved the <w>summoning</w> of ancient spirits from the deep forest.",
                            "target_lang_translations": {
                                "pl": "Rytuał obejmował <w>przywołanie</w> starożytnych duchów z głębi lasu.",
                                "de": "Das Ritual beinhaltete die <w>Beschwörung</w> uralter Geister aus den Tiefen des Waldes."
                            }
                        }
                    ],
                    "synonyms": [
                        "call",
                        "citation"
                    ],
                    "common_phrases": [
                        "formal summoning"
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt nakazania komuś stawienia się w określonym miejscu lub wezwanie do obecności.",
                        "de": "Die Handlung, jemanden anzuweisen zu erscheinen oder anwesend zu sein; das Herbeirufen oder Vorladen."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wezwanie",
                                "target_lang_sense_clarification": "oficjalne lub prawne nakazanie stawiennictwa"
                            },
                            {
                                "target_lang_word": "przywołanie",
                                "target_lang_sense_clarification": "w kontekście rytualnym lub magicznym"
                            },
                            {
                                "target_lang_word": "wzywanie",
                                "target_lang_sense_clarification": "czynność wzywania (np. świadków)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "die Vorladung",
                                "target_lang_sense_clarification": "offizielles oder juristisches Rufen"
                            },
                            {
                                "target_lang_word": "das Herbeirufen",
                                "target_lang_sense_clarification": "allgemeiner Vorgang des Rufens"
                            },
                            {
                                "target_lang_word": "die Beschwörung",
                                "target_lang_sense_clarification": "im magischen oder rituellen Kontext"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}