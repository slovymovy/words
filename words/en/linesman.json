{
    "word_family": [
        "line",
        "lineman",
        "lineswoman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dfa6a803-0db8-35fa-86ab-867fe5d8a920",
                    "sense_definition": "An official who assists the referee in sports like football or rugby, primarily by indicating when the ball has gone out of play.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>linesman</w> raised his flag to signal that the player was offside.",
                            "target_lang_translations": {
                                "ru": "<w>Боковой судья</w> поднял флаг, сигнализируя о том, что игрок находится вне игры."
                            }
                        },
                        {
                            "text": "After the ball crossed the touchline, the <w>linesman</w> pointed his flag in the direction of the throw-in.",
                            "target_lang_translations": {
                                "ru": "После того как мяч пересек боковую линию, <w>лайнсмен</w> указал флагом направление вбрасывания."
                            }
                        }
                    ],
                    "synonyms": [
                        "assistant referee",
                        "line judge"
                    ],
                    "common_phrases": [
                        "raise the flag",
                        "signal offside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное лицо, помогающее главному судье в таких видах спорта, как футбол или регби, в основном указывая на выход мяча за пределы поля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боковой судья",
                                "target_lang_sense_clarification": "в командных видах спорта"
                            },
                            {
                                "target_lang_word": "лайнсмен",
                                "target_lang_sense_clarification": "спортивный термин"
                            },
                            {
                                "target_lang_word": "помощник судьи",
                                "target_lang_sense_clarification": "официальное наименование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9cd505f-6e55-3f4b-aac0-896e3bf7e38e",
                    "sense_definition": "A male official in sports like tennis who determines whether a ball has landed inside or outside the court boundaries.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player looked at the <w>linesman</w> in disbelief after the close call was ruled out.",
                            "target_lang_translations": {
                                "ru": "Игрок с недоверием посмотрел на <w>судью на линии</w> после того, как спорный мяч был засчитан как аут."
                            }
                        },
                        {
                            "text": "Every <w>linesman</w> on the court must stay focused during the entire match.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>линейный судья</w> на корте должен сохранять концентрацию на протяжении всего матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "line judge"
                    ],
                    "common_phrases": [
                        "call the ball out",
                        "court official"
                    ],
                    "target_lang_definitions": {
                        "ru": "Судья в таких видах спорта, как теннис, который определяет, попал ли мяч в пределы корта или за его границы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судья на линии",
                                "target_lang_sense_clarification": "в теннисе"
                            },
                            {
                                "target_lang_word": "линейный судья",
                                "target_lang_sense_clarification": "спортивный арбитр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d007450e-2cba-3aaf-83da-c014ce36f21b",
                    "sense_definition": "A person whose job is to install or repair electrical power or telephone lines.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_occupations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heavy storm, a <w>linesman</w> was sent to repair the damaged power cables.",
                            "target_lang_translations": {
                                "ru": "После сильного шторма для ремонта поврежденных силовых кабелей был направлен <w>линейный монтер</w>."
                            }
                        },
                        {
                            "text": "The <w>linesman</w> climbed the utility pole to fix the broken telephone connection.",
                            "target_lang_translations": {
                                "ru": "<w>Связист</w> залез на столб, чтобы починить оборванную телефонную линию."
                            }
                        }
                    ],
                    "synonyms": [
                        "lineman",
                        "wireman"
                    ],
                    "common_phrases": [
                        "repair power lines",
                        "utility worker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чья работа заключается в установке или ремонте линий электропередач или телефонных линий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линейный монтер",
                                "target_lang_sense_clarification": "специалист по сетям"
                            },
                            {
                                "target_lang_word": "электромонтер-линейщик",
                                "target_lang_sense_clarification": "профессиональное название"
                            },
                            {
                                "target_lang_word": "связист",
                                "target_lang_sense_clarification": "для телефонных линий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f810df98-f177-3b99-8f2e-2695ee8ebe57",
                    "sense_definition": "A soldier who serves in a regular infantry regiment, specifically a private.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_ranks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old records listed his great-grandfather as a <w>linesman</w> in the infantry.",
                            "target_lang_translations": {
                                "ru": "В старых записях его прадед значился как <w>солдат линейных войск</w> в пехоте."
                            }
                        },
                        {
                            "text": "Each <w>linesman</w> stood ready in the formation as the general inspected the troops.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>пехотинец</w> стоял в строю наготове, пока генерал проводил инспекцию войск."
                            }
                        }
                    ],
                    "synonyms": [
                        "infantryman",
                        "private"
                    ],
                    "common_phrases": [
                        "infantry regiment",
                        "line private"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical military contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Солдат, служащий в регулярном пехотном полку, обычно рядовой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солдат линейных войск",
                                "target_lang_sense_clarification": "исторический военный термин"
                            },
                            {
                                "target_lang_word": "пехотинец",
                                "target_lang_sense_clarification": "рядовой пехоты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}