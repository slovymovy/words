                                        "sense_id": "84c5bbdb-ca89-3df9-a4ff-b77f0281dbcf",
                                        "entry_id": "80e5e451-e583-361d-9c43-70f4d319aa26",
                                        "glosses": [
                                            "Élément ou personne qui a un rôle d’organisation capital."
