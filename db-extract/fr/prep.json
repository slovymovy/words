                                                "sense_id": "c354f282-822b-34da-803f-8a5216cd54ad",
                                                "text": "‘We talked about it at the beginning and said it would be fine. Are you on PrEP?’\n‘Of course, babes! I was first in the queue! So you both see other guys?’"
                                            },
                                            {
                                                "example_id": "ed31cd1d-8ad2-4d40-93e3-d6782b4247ad",
                                                "sense_id": "c354f282-822b-34da-803f-8a5216cd54ad",
                                                "text": "I was already on PrEP, but we were good about condoms."
                                            }
