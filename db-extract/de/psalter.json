                                "target_senses": [
                                    {
                                        "sense_id": "91660791-6f8c-3726-8d5b-692c00853fb3",
                                        "entry_id": "1655696b-e429-3197-ae79-57278f2b654e",
                                        "glosses": [
                                            "Synonym of Psalms, particularly when printed as a separate work from the Bible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dfeaed9-ea0b-3fc0-a397-975395c19bbf",
                                        "entry_id": "1655696b-e429-3197-ae79-57278f2b654e",
                                        "glosses": [
                                            "Synonym of breviary, which arranges the Psalms for devotional recitation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "761226d9-8e38-3239-a697-bd8be4718383",
                                        "entry_id": "1655696b-e429-3197-ae79-57278f2b654e",
                                        "glosses": [
                                            "Synonym of Book of Common Prayer, which prominently includes the Psalms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15c9cef4-25f6-3113-a7b1-30927d6dc9f8",
                                        "entry_id": "1655696b-e429-3197-ae79-57278f2b654e",
                                        "glosses": [
                                            "A rosary with 150 beads, used for reciting the Psalms in Catholic editions of the Bible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1f34806-e085-383f-b95b-46dbbfb264d1",
                                        "entry_id": "1655696b-e429-3197-ae79-57278f2b654e",
                                        "glosses": [
                                            "Alternative form of psaltery, a kind of zither as well as the King James translation of certain obscure musical terms in the Old Testament."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd59599-d9cf-49fb-821f-f4fb354be4b1",
                                                "sense_id": "a1f34806-e085-383f-b95b-46dbbfb264d1",
                                                "text": "Confesse ye to our Lord on the harpe: on a psalter of ten strings sing to him."
                                            },
                                            {
                                                "example_id": "db966cf3-a23f-4e31-b0ca-d01016e02f2f",
                                                "sense_id": "a1f34806-e085-383f-b95b-46dbbfb264d1",
                                                "text": "Perhaps the viol d'amour underwent several modifications, as its name was changed to psalter in the belief of its being the ancient instrument so denominated, which is quite different, according to most authorities — not belonging to the fidicinal tribe."
                                            },
                                            {
                                                "example_id": "b576b7b3-aa75-4b44-817c-8cdfee9fb2d5",
                                                "sense_id": "a1f34806-e085-383f-b95b-46dbbfb264d1",
                                                "text": "Some have supposed that the psalter was not in fact an instrument, but that the term was applied merely to harmony produced by the voice in conjunction with instruments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f19ba82b-e05b-44ee-bbc5-9dde7f373ede",
                        "source_entry_id": "36aa670f-835d-3f44-8933-b7a8b1b85f5e",
                        "target_lang_word": "psaltery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psaltery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd83d81-f5f9-32f1-91ac-c120a87ec1bc",
                                        "entry_id": "96bac0af-3c8c-3931-90e2-de0ad6b4c372",
                                        "glosses": [
                                            "A zither-like musical instrument consisting of a soundboard with multiple strings, played by plucking the strings with the fingers or a plectrum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1229a87-5065-4f34-bd68-ffd0bb4db67a",
                                                "sense_id": "9bd83d81-f5f9-32f1-91ac-c120a87ec1bc",
                                                "text": "And at the dedication of the wall of Ieruſalem, they ſought the Leuites out of all their places, to bꝛing them to Ieruſalem, to keepe the dedication with gladneſſe, both with thankeſgiuings and with ſinging, with cymbals, pſalteries, and with harpes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e966e165-5f20-4424-beb8-b8d67e7ce741",
                        "source_entry_id": "36aa670f-835d-3f44-8933-b7a8b1b85f5e",
                        "target_lang_word": "psautier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psautier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b86b7fd-60e1-38a8-8add-27fe174120d2",
                                        "entry_id": "7fc76234-6775-3590-9c2c-77672e27a340",
                                        "glosses": [
                                            "Recueil des psaumes composés par David ou qui lui sont communément attribués."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ca2156-4721-4504-9675-bdfcbb90e0b1",
                                                "sense_id": "2b86b7fd-60e1-38a8-8add-27fe174120d2",
                                                "text": "Savoir le psautier par cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7597fb77-7c1b-361c-a0b8-18408757a06b",
                                        "entry_id": "7fc76234-6775-3590-9c2c-77672e27a340",
                                        "glosses": [
                                            "Livre, manuscrit ou imprimé, qui contient les psaumes."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ce1ae9-4a40-4565-9ffa-4d2ac06d98ad",
                                                "sense_id": "7597fb77-7c1b-361c-a0b8-18408757a06b",
                                                "text": "D’abord, un vieux psautier, infiniment petit entre ses fermoirs d’argent, comme un livre de poupée, et qui avait dû être une merveille typographique à son époque."
                                            },
                                            {
                                                "example_id": "4bf3bc0b-e92c-41a3-8715-443cf1f125e0",
                                                "sense_id": "7597fb77-7c1b-361c-a0b8-18408757a06b",
                                                "text": "Trente moines, épluchant feuillet par feuillet des psautiers aussi crasseux que leurs barbes, louaient Dieu et chantaient pouilles au diable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "736040b0-b9a5-387c-8266-a6189200587f",
                                        "entry_id": "7fc76234-6775-3590-9c2c-77672e27a340",
                                        "glosses": [
                                            "Voile qui couvre la tête et les épaules, porté par quelques religieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c53c876b-2541-4fda-a814-acd4c91a2aa7",
                                                "sense_id": "736040b0-b9a5-387c-8266-a6189200587f",
                                                "text": "[…] A certain voile aux Nones familier, Nommé pour lors entre-elles leur Psautier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "281e2917-b225-3a78-846d-4fda62771b36",
                                        "entry_id": "7fc76234-6775-3590-9c2c-77672e27a340",
                                        "glosses": [
                                            "Chapelet monastique doté de 150 grains, autant qu’il y a de psaumes dans le psautier chrétien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ff5512-0c65-470a-bc9a-cc6001ddfd3b",
                                                "sense_id": "281e2917-b225-3a78-846d-4fda62771b36",
                                                "text": "La solennité que confère à ses gestes l’ampleur de ses manches, le silence où s’entrechoquent les grains du psautier ballotant sur sa robe, la tension du potentiel ambiant, tout contribue à donner à cette cérémonie la gravité d’un sacre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b29cc5a-52c4-36c6-8b03-bca5b41256eb",
                                        "entry_id": "7fc76234-6775-3590-9c2c-77672e27a340",
                                        "glosses": [
                                            "Se dit des abats formés par le feuillet des ruminants."
                                        ],
                                        "tags": [
                                            "Boucherie"
