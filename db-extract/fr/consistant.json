                        "examples": [
                            {
                                "example_id": "0bacb91f-3f46-499c-9d2f-454d2f252104",
                                "sense_id": "a7d05dc9-1148-341b-b4a3-736a733c46b9",
                                "text": "Un plat consistant."
                            },
                            {
                                "example_id": "0be5bdcf-0896-496d-8f8a-13dfefc65abc",
                                "sense_id": "a7d05dc9-1148-341b-b4a3-736a733c46b9",
                                "text": "Les autres fois, dès que le bateau était signalé, elles l’attendaient et préparaient un repas consistant."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ad550eb-ba05-34f6-9d80-1ee9b4d1ae3b",
                        "entry_id": "20ffc0e1-5942-382b-9163-10509a2f57fd",
                        "glosses": [
                            "Qui a de la consistance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf678c3-449e-435f-b6f8-16e0542c0dba",
                                "sense_id": "7ad550eb-ba05-34f6-9d80-1ee9b4d1ae3b",
                                "text": "Masse consistante, matière consistante."
                            },
                            {
                                "example_id": "4a57713a-e2e1-47c9-8c31-c5503f1bf24d",
                                "sense_id": "7ad550eb-ba05-34f6-9d80-1ee9b4d1ae3b",
                                "text": "Un caractère consistant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaac623c-31e7-4da0-8184-94e4d0b4e20b",
                        "source_entry_id": "20ffc0e1-5942-382b-9163-10509a2f57fd",
                        "target_lang_word": "widerspruchsfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widerspruchsfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbf856cd-c0cd-3028-b0d3-1184af552027",
                                        "entry_id": "a58a931c-8c06-3a82-ae6f-a3a622943698",
                                        "glosses": [
                                            "ohne Widersprüche; frei von Widersprüchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "524c9fb6-9a64-4620-9e8b-073e90878e07",
                                                "sense_id": "bbf856cd-c0cd-3028-b0d3-1184af552027",
                                                "text": "Der Richter konnte sich aufgrund der Zeugenaussagen ein widerspruchsfreies Bild über den Tathergang verschaffen."
                                            },
                                            {
                                                "example_id": "e8dbf7aa-3d86-41ce-829b-67da8068e6b5",
                                                "sense_id": "bbf856cd-c0cd-3028-b0d3-1184af552027",
                                                "text": "„Gödel zeigte, dass jede widerspruchsfreie mathematische Theorie, die reichhaltig genug ist, um die Arithmetik zu umfassen, die es also erlaubt, zu zählen und diese Zahlen zu addieren und zu multiplizieren, notwendigerweise unvollständig ist.“"
                                            },
                                            {
                                                "example_id": "6fdd71aa-aa7e-4f46-a1da-65dd3c97b118",
                                                "sense_id": "bbf856cd-c0cd-3028-b0d3-1184af552027",
                                                "text": "Die Bahn […] peilt [mit der Gewerkschaft GDL] Regelungen an, die widerspruchsfrei zu anderen Tarifverträgen sind, die mit der größeren Eisenbahn- und Verkehrsgewerkschaft (EVG) abgeschlossen wurden."
                                            },
                                            {
                                                "example_id": "020ad0b9-716d-476c-a058-d01979e5ef95",
                                                "sense_id": "bbf856cd-c0cd-3028-b0d3-1184af552027",
                                                "text": "Niemand hat nur eine Identität. \"Eine Person kann gänzlich widerspruchsfrei amerikanische Bürgerin, von karibischer Herkunft mit afrikanischen Vorfahren, Christin, Liberale, Frau, Vegetarierin, Langstreckenläuferin, Feministin, Heterosexuelle, Tennisfan\" etc. sein."
                                            },
                                            {
                                                "example_id": "e3ab56cb-78c0-4958-b76b-e26503688701",
                                                "sense_id": "bbf856cd-c0cd-3028-b0d3-1184af552027",
                                                "text": "Warum sind die Neger dunkelhäutig? Alles, was Anthropologen und Physiologen zu diesem Problem bisher ergründet haben, ist noch nicht widerspruchsfrei, die Meinungen sind geteilt."
                                            },
                                            {
                                                "example_id": "c5b86288-9d30-4907-87f7-c53c97ff3586",
                                                "sense_id": "bbf856cd-c0cd-3028-b0d3-1184af552027",
                                                "text": "Wer [bei seinem Asylantrag] stotternd und ungegliedert berichtet, kann glaubwürdiger sein, als jemand, der eloquent eine glatte und widerspruchsfreie Geschichte erzählt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a481181b-2174-43dc-bffb-f16b3a036064",
                        "source_entry_id": "20ffc0e1-5942-382b-9163-10509a2f57fd",
