                                            {
                                                "example_id": "1434f3d1-25ed-4de6-8bc3-ca5880f31086",
                                                "sense_id": "9731df47-47eb-3977-b342-dff474da57c0",
                                                "text": "El andar del cortejo se hace lento, difícil, toma por fin la cadencia de una marcha fúnebre."
                                            },
                                            {
                                                "example_id": "0d9a07c6-7f70-4538-bdbe-ff9ff9c52d9f",
                                                "sense_id": "9731df47-47eb-3977-b342-dff474da57c0",
                                                "text": "El cortejo ha echado a andar sobre el césped. Ella se siente impelida en un insólito vaivén; diríase que mecen blandamente el ataúd."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
