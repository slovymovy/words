                                        "entry_id": "ebb19786-7d4f-37aa-8594-b76558649fe2",
                                        "glosses": [
                                            "das sächliche oder neutrale Geschlecht oder Genus eines Substantivs oder einer Form des Adjektivs in einer Sprache"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce12576b-3036-493b-9aa2-aec494cd7e9d",
                                                "sense_id": "8ee82c76-0e0b-3847-96b8-97d528055353",
                                                "text": "Sowohl die deutsche als auch die lateinische Sprache kennen Substantive im Neutrum."
                                            },
                                            {
                                                "example_id": "c5836c98-dc4c-4686-ba60-27febc1d2c21",
                                                "sense_id": "8ee82c76-0e0b-3847-96b8-97d528055353",
                                                "text": "„Ebenso kennt das Zentral- und Südostjiddische drei Genera (männlich, weiblich und sächlich), während das Nordostjiddische kein Neutrum mehr besitzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7120e968-1300-3c22-94da-0db68437ceb0",
                                        "entry_id": "ebb19786-7d4f-37aa-8594-b76558649fe2",
                                        "glosses": [
                                            "ein Wort sächlichen Geschlechts, besonders ein Substantiv sächlichen Geschlechts"
                                        ],
                                        "tags": [],
