                        {
                            "text": "The advice he gave me was totally <w>garbage</w>.",
                            "target_lang_translations": {
                                "ru": "Совет, который он мне дал, был полной <w>чушью</w>.",
                                "tr": "Bana verdiği tavsiye tamamen <w>saçmalıktı</w>."
                            }
