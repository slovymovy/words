                    {
                        "translation_id": "34291170-9218-4d37-b589-304d17882e63",
                        "source_entry_id": "a9e67be7-9faf-3369-941d-fb93824a19ea",
                        "source_sense_id": "98017a61-ef24-3e41-8696-8920f957a4d8",
                        "source_sense_description": "break between stages of a journey",
                        "target_lang_word": "Aufenthalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufenthalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cface8f6-c112-3ff4-87fd-6bbc21b0e7dc",
                                        "entry_id": "9073f8d7-6ad4-3f8b-bf59-ae97e8d86c0d",
                                        "glosses": [
                                            "das Anwesendsein, das Verweilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf80b85f-67ce-479e-ae48-f5ef71e28534",
                                                "sense_id": "cface8f6-c112-3ff4-87fd-6bbc21b0e7dc",
                                                "text": "Der Aufenthalt in den Bergen oder am Meer hat mir gefallen."
                                            },
                                            {
                                                "example_id": "f0bf97b7-e0f2-4d54-b36a-5392f24d381d",
                                                "sense_id": "cface8f6-c112-3ff4-87fd-6bbc21b0e7dc",
                                                "text": "„Nach ihrem mehrmonatigen Aufenthalt in Lausanne macht sich die Familie auf nach Wien.“"
                                            },
                                            {
                                                "example_id": "f9d3eba0-ffb2-437e-933f-75c50ddbb0f9",
                                                "sense_id": "cface8f6-c112-3ff4-87fd-6bbc21b0e7dc",
                                                "text": "„Solche Betrachtungen begleiteten ihn und kamen ihm während seines Bremer Autenhalts allabendlich wieder, wenn er nach den Geschäften und Mühen des Tages seinen Spaziergang am Bollwerk hin machte.“"
                                            },
                                            {
                                                "example_id": "6207bbe1-4029-4b41-b288-f9aa1d40e874",
                                                "sense_id": "cface8f6-c112-3ff4-87fd-6bbc21b0e7dc",
                                                "text": "„Man wisse nie, meinte er grämlich, wie lange der Aufenthalt währe und in welchen Augenblick hinein das Horn ertöne und wem das Zeichen für den Abtransport gelte.“"
                                            },
                                            {
                                                "example_id": "04e57558-e971-4474-98bd-93f55a3787cd",
                                                "sense_id": "cface8f6-c112-3ff4-87fd-6bbc21b0e7dc",
                                                "text": "„So heilig waren die Bäume, dass sogar die Götter darin wohnten, so die Himmelsgöttin Nut, die einen Bergahorn als ihr Zuhause auserkoren hatte; daran erinnerte sich vielleicht später die Jungfrau Maria, als sie sich während ihres Aufenthalts in Ägypten in einem Baum versteckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cabb916-9c7d-36de-8401-77e4d8387e74",
                                        "entry_id": "9073f8d7-6ad4-3f8b-bf59-ae97e8d86c0d",
                                        "glosses": [
                                            "Ort, an dem man sich aufhält"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aef664e-3b67-46f0-911d-0b5555c6088f",
                                                "sense_id": "5cabb916-9c7d-36de-8401-77e4d8387e74",
                                                "text": "Es war ein idyllischer Aufenthalt, an dem sie verweilten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "94157aeb-d034-3e84-bcc4-bb87f4306e23",
                                        "entry_id": "9073f8d7-6ad4-3f8b-bf59-ae97e8d86c0d",
                                        "glosses": [
                                            "Halt"
                                        ],
                                        "tags": [
                                            "Eisenbahn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6527cdaf-4ac9-4329-8595-a3ebe712f558",
                                                "sense_id": "94157aeb-d034-3e84-bcc4-bb87f4306e23",
                                                "text": "Der Zug fährt ohne Aufenthalt nach München."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "564f209d-0f4a-367e-8914-6b29d4a4c792",
                                        "entry_id": "9073f8d7-6ad4-3f8b-bf59-ae97e8d86c0d",
                                        "glosses": [
                                            "Abwarten, Verzögerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a535516-367b-404e-9c10-1ce00f8a6716",
                                                "sense_id": "564f209d-0f4a-367e-8914-6b29d4a4c792",
                                                "text": "Ohne Aufenthalt ging die Frau an ihrem Mann vorbei."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
