                    {
                        "sense_id": "01a32a45-117e-3816-931b-6e4c2147d72c",
                        "entry_id": "edc6d802-daf6-3072-9ed3-86191750b128",
                        "glosses": [
                            "dalsze trwanie czegoś lub następna część czegoś albo jakiejś działalności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f25e0fbe-18fb-438a-bdb3-356cc0313196",
                                "sense_id": "01a32a45-117e-3816-931b-6e4c2147d72c",
                                "text": "W ramach projektu „Ptasie Wyspy – kontynuacja czynnej ochrony zagrożonych gatunków ptaków siewkowych” realizujemy ochronę jedynej, śródrzecznej kolonii mewy siwej na dolnej Wiśle."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fe46efa-0a39-4cf8-b74c-cd240aaec2d4",
                        "source_entry_id": "edc6d802-daf6-3072-9ed3-86191750b128",
                        "source_sense_id": "01a32a45-117e-3816-931b-6e4c2147d72c",
