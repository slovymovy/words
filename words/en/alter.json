{
    "word_family": [
        "alteration",
        "alterable",
        "unalterable",
        "alterant",
        "alterative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "545ca072-2dff-389f-bb99-55c15ed19504",
                    "sense_definition": "To change the form, structure, or character of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect had to <w>alter</w> the original plans to meet the new safety regulations.",
                            "target_lang_translations": {
                                "ru": "Архитектору пришлось <w>изменить</w> первоначальные планы, чтобы они соответствовали новым правилам техники безопасности."
                            }
                        },
                        {
                            "text": "Even a small mistake can significantly <w>alter</w> the outcome of the entire experiment.",
                            "target_lang_translations": {
                                "ru": "Даже небольшая ошибка может значительно <w>изменить</w> исход всего эксперимента."
                            }
                        }
                    ],
                    "synonyms": [
                        "change",
                        "modify",
                        "amend",
                        "vary"
                    ],
                    "antonyms": [
                        "preserve"
                    ],
                    "common_phrases": [
                        "alter the outcome",
                        "alter the course",
                        "alter the appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять форму, структуру или характер чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменять",
                                "target_lang_sense_clarification": "делать иным"
                            },
                            {
                                "target_lang_word": "вносить изменения",
                                "target_lang_sense_clarification": "корректировать"
                            },
                            {
                                "target_lang_word": "переделывать",
                                "target_lang_sense_clarification": "менять структуру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a15e53c-4c0f-3c96-ad1f-5bf088e0ea1c",
                    "sense_definition": "To become different or undergo a change.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the seasons <w>alter</w>, the landscape transforms into a beautiful palette of colors.",
                            "target_lang_translations": {
                                "ru": "Когда времена года <w>меняются</w>, пейзаж превращается в прекрасную палитру красок."
                            }
                        },
                        {
                            "text": "His perspective began to <w>alter</w> after he spent a year traveling around the world.",
                            "target_lang_translations": {
                                "ru": "Его мировоззрение начало <w>меняться</w> после того, как он провел год, путешествуя по миру."
                            }
                        }
                    ],
                    "synonyms": [
                        "change",
                        "vary"
                    ],
                    "common_phrases": [
                        "alter over time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться другим или подвергаться изменениям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меняться",
                                "target_lang_sense_clarification": "становиться иным"
                            },
                            {
                                "target_lang_word": "изменяться",
                                "target_lang_sense_clarification": "претерпевать изменения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "127d0b9d-d8fd-3919-8062-fc2cd90a302a",
                    "sense_definition": "To adjust or tailor clothing so that it fits a person better.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tailoring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to have this suit <w>altered</w> because the sleeves are much too long.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>перешить</w> этот костюм, потому что рукава слишком длинные."
                            }
                        },
                        {
                            "text": "The tailor can <w>alter</w> a dress to fit your specific measurements perfectly.",
                            "target_lang_translations": {
                                "ru": "Портной может <w>подогнать</w> платье точно по вашим меркам."
                            }
                        }
                    ],
                    "synonyms": [
                        "adapt",
                        "modify"
                    ],
                    "common_phrases": [
                        "alter a dress",
                        "have clothes altered"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подгонять или перешивать одежду, чтобы она лучше сидела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перешивать",
                                "target_lang_sense_clarification": "менять размер одежды"
                            },
                            {
                                "target_lang_word": "подгонять",
                                "target_lang_sense_clarification": "по фигуре"
                            },
                            {
                                "target_lang_word": "ушивать",
                                "target_lang_sense_clarification": "делать меньше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b08b38be-fd8d-3808-a26f-aa6ef36a1dcc",
                    "sense_definition": "To affect someone's mental state, often through the use of drugs or alcohol.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medication might <w>alter</w> your mood or make you feel slightly drowsy.",
                            "target_lang_translations": {
                                "ru": "Лекарство может <w>изменить</w> ваше настроение или вызвать легкую сонливость."
                            }
                        },
                        {
                            "text": "He was in an <w>altered</w> state of consciousness after the long meditation session.",
                            "target_lang_translations": {
                                "ru": "Он находился в <w>измененном</w> состоянии сознания после долгого сеанса медитации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "altered state",
                        "mind altering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влиять на психическое состояние человека, часто с помощью лекарств или алкоголя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменять",
                                "target_lang_sense_clarification": "о сознании или настроении"
                            },
                            {
                                "target_lang_word": "влиять",
                                "target_lang_sense_clarification": "на психику"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f203dc49-aa02-3fca-b975-3f220b17411d",
                    "sense_definition": "To surgically remove the reproductive organs of an animal; to spay or neuter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "veterinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animal shelter requires all owners to <w>alter</w> their pets before adoption.",
                            "target_lang_translations": {
                                "ru": "Приют для животных требует, чтобы все владельцы <w>стерилизовали</w> своих питомцев перед усыновлением."
                            }
                        },
                        {
                            "text": "It is often healthier for a male dog to be <w>altered</w> at a young age.",
                            "target_lang_translations": {
                                "ru": "Для кобеля часто полезнее быть <w>кастрированным</w> в молодом возрасте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alter a pet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хирургическим путем удалять репродуктивные органы животного; кастрировать или стерилизовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кастрировать",
                                "target_lang_sense_clarification": "самцов"
                            },
                            {
                                "target_lang_word": "стерилизовать",
                                "target_lang_sense_clarification": "самок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de16ad95-84b3-37bf-8378-840deda586aa",
                    "sense_definition": "One of the distinct personalities or identities within a person with dissociative identity disorder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist worked with each <w>alter</w> to help the patient achieve internal cooperation.",
                            "target_lang_translations": {
                                "ru": "Терапевт работал с каждой <w>субличностью</w>, чтобы помочь пациенту достичь внутреннего согласия."
                            }
                        },
                        {
                            "text": "Sometimes one <w>alter</w> is unaware of what the others have done during the day.",
                            "target_lang_translations": {
                                "ru": "Иногда одна <w>личность</w> не знает о том, что делали другие в течение дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "headmate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in psychology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из отдельных личностей или идентичностей у человека с диссоциативным расстройством идентичности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альтер-эго",
                                "target_lang_sense_clarification": "другая личность"
                            },
                            {
                                "target_lang_word": "субличность",
                                "target_lang_sense_clarification": "в психологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "408acdfe-d1c5-3d3b-9294-bf9ce2853a7a",
                    "sense_definition": "A common misspelling of the word <w>altar</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student mistakenly wrote <w>alter</w> instead of altar when describing the church ceremony.",
                            "target_lang_translations": {
                                "ru": "Студент ошибочно написал <w>alter</w> вместо altar, описывая церковную церемонию."
                            }
                        },
                        {
                            "text": "In many old manuscripts, you might find <w>alter</w> used incorrectly to refer to a religious table.",
                            "target_lang_translations": {
                                "ru": "Во многих старых рукописях можно встретить слово <w>alter</w>, неправильно используемое для обозначения церковного алтаря."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная орфографическая ошибка в слове «altar» (алтарь)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "вместо «altar»"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}