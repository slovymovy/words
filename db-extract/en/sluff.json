                        "examples": [
                            {
                                "example_id": "206b8663-ef0c-483d-a0f4-3dca80feb51f",
                                "sense_id": "a1c0928a-e808-3b66-8b34-f2eff3d4329f",
                                "text": "Sunshine for the Latter-Day Saint Mother's Soul\nBoth calls told her the same thing — that her son had been sluffing school. She felt betrayed. She had trusted this child."
                            }
                        ]
