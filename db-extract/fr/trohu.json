                                "example_id": "d8d1f5b2-a593-4b39-8561-8dc914056c7a",
                                "sense_id": "853b7bfa-4934-3e22-971c-275f51723204",
                                "text": "- Traces de balles. Et crois-moi, c’était pas du pruneau d’agent, mais du calibre de grande personne ! Vise-moi ces trohus !"
                            }
