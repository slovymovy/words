                ],
                "senses": [
                    {
                        "sense_id": "d4f8e880-e22c-3963-8b69-9d1be2866fab",
                        "entry_id": "f0ee5d1e-263a-301a-84e4-3c0c2cbeb49f",
                        "glosses": [
                            "Processus diachronique qui transforme un mot purement lexical en morphème ou structure grammaticale."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "79d9cb4c-60b9-4819-9a1c-463ac4d741ec",
                                "sense_id": "d4f8e880-e22c-3963-8b69-9d1be2866fab",
                                "text": "Conscients de ce problème, Heltoft et al. (2005 : 11) proposent une définition élargie selon laquelle la grammaticalisation est un processus qui accorde un statut grammatical à des éléments ou à des systèmes qui ne l'avaient pas autrefois ou qui changent les systèmes grammaticaux précédents."
                            },
                            {
                                "example_id": "70e95531-f61d-442d-a3e8-ca4b3a4b371c",
                                "sense_id": "d4f8e880-e22c-3963-8b69-9d1be2866fab",
                                "text": "Grâce à de nouveaux concepts, et en particulier à celui de \"grammaticalisation\", d'immenses progrès ont été faits depuis vingt ans dans la connaissance de la manière dont les langues évoluent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7613491c-c1fa-4b26-8ee3-51f62539ab28",
                        "source_entry_id": "f0ee5d1e-263a-301a-84e4-3c0c2cbeb49f",
                        "source_sense_id": "d4f8e880-e22c-3963-8b69-9d1be2866fab",
                        "source_sense_description": "(Linguistique) Transformation",
                        "target_lang_word": "Grammatikalisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grammatikalisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34f3a6da-0925-39e9-a059-ebf386be3240",
                                        "entry_id": "abdb1251-5947-3d26-b62d-cfd847e3cca3",
                                        "glosses": [
                                            "Verwendung eines sprachlichen Ausdrucks für grammatische Zwecke (Morphologie, Syntax), der zuvor keine derartigen Funktionen hatte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a0ed54a-d7b5-4a3a-b8fc-c4ca28dfac63",
                                                "sense_id": "34f3a6da-0925-39e9-a059-ebf386be3240",
                                                "text": "Ein Beispiel für Grammatikalisierung im Deutschen ist das Ableitungsmorphem -lich, das früher ein selbständiges Wort war (und heutzutage in dem Wort Leiche fortlebt)."
                                            },
                                            {
                                                "example_id": "26b4436f-5f27-4314-a4e4-2cac42dae155",
                                                "sense_id": "34f3a6da-0925-39e9-a059-ebf386be3240",
                                                "text": "Auch das heutige -sam (wie in: duldsam) war ursprünglich ein selbständiges Wort und wurde durch Grammatikalisierung zum Ableitungsmorphem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
