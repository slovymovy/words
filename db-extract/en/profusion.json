                                        "entry_id": "c629910d-2c37-346b-89d6-5b24200317af",
                                        "glosses": [
                                            "Gran abundancia o cantidad de algo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50567a49-5249-403e-84e8-f7f830e8e0a2",
                                                "sense_id": "df0da7f0-b01b-3a85-9cb6-f158e1a269b8",
                                                "text": "Se alinea delante de mí una profusión de alas muertas, de pobres cuerpos mutilados, embarrados."
                                            }
