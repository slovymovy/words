                    {
                        "translation_id": "2e2e5894-1fd0-4ba3-b1dd-b5e2328c1ad5",
                        "source_entry_id": "ef10b73c-0f8d-3f17-8124-6cd87d1d71c5",
                        "source_sense_id": "11fb6261-bc3e-3a41-99c5-7005e5847854",
                        "source_sense_description": "Musik, Vortragsanweisung: gedrungen, schwerfällig, schleppend, wuchtig",
                        "target_lang_word": "pesant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pesant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f716250a-f3b4-34ff-bb87-1ff118af385a",
                                        "entry_id": "1a18df2f-de49-3d30-80e3-9c90be822906",
                                        "glosses": [
                                            "Qui a du poids, qui est soumis à la force de la pesanteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2635229b-ca6a-4b61-b542-22b8ada4f3d3",
                                                "sense_id": "f716250a-f3b4-34ff-bb87-1ff118af385a",
                                                "text": "Tous les corps sont pesants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5da11a0-e6b4-3968-9ac8-e76d9baf455e",
                                        "entry_id": "1a18df2f-de49-3d30-80e3-9c90be822906",
                                        "glosses": [
                                            "Qui est lourd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b2cadbf-00ec-4689-bb32-67af4d1fa7ba",
                                                "sense_id": "f5da11a0-e6b4-3968-9ac8-e76d9baf455e",
                                                "text": "Les étriers, larges et pesants, sont attachés à des anneaux de fer au moyen d’étrivières très courtes en soie ou en lanières de cuir tressées."
                                            },
                                            {
                                                "example_id": "0ec0597e-9872-4fdb-b443-70fcd60a6a20",
                                                "sense_id": "f5da11a0-e6b4-3968-9ac8-e76d9baf455e",
                                                "text": "À ce signal, le portier vint, armé d’une lanterne, prendre Godefroid, le conduisit jusque dans la rue, et referma l’énorme porte jaunâtre, pesante comme celle d’une prison, et décorée de serrureries en arabesques, qui remontaient à une époque difficile à déterminer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba04f419-c267-378f-9366-c3ae25f9e1ae",
                                        "entry_id": "1a18df2f-de49-3d30-80e3-9c90be822906",
                                        "glosses": [
                                            "Où l’on éprouve un sentiment de pesanteur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7435f8bf-5585-4a45-bf61-13522c09eb50",
                                                "sense_id": "ba04f419-c267-378f-9366-c3ae25f9e1ae",
                                                "text": "— Cher de Thou, j’ai gardé de grands secrets sur mon cœur, et croyez qu’ils y ont été bien pesants."
                                            },
                                            {
                                                "example_id": "308eb3a3-fcfd-4a03-891a-e93935f10445",
                                                "sense_id": "ba04f419-c267-378f-9366-c3ae25f9e1ae",
                                                "text": "Une atmosphère pesante et troublante régnait encore entre les murs aux boiseries sévères, sous le plafond à écussons […]."
                                            },
                                            {
                                                "example_id": "bf15d65a-8455-48ee-a5eb-d51b17775fca",
                                                "sense_id": "ba04f419-c267-378f-9366-c3ae25f9e1ae",
                                                "text": "Un silence pesant envahit l’espace clos de la cuisine où une série d’ombres difformes continuaient à papillonner de-ci de-là, accompagnées du bruit tout à coup discret de la vaisselle et de cuillers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c468197c-9b85-3cd9-91c2-bbf3035e992e",
                                        "entry_id": "1a18df2f-de49-3d30-80e3-9c90be822906",
                                        "glosses": [
                                            "Ennuyeux, un peu bête. En parlant de l’esprit, du discours, du style, etc., Qui manque de vivacité, de légèreté, de grâce."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cca1bf92-4da7-4a65-a704-1cd645f1c2d4",
                                                "sense_id": "c468197c-9b85-3cd9-91c2-bbf3035e992e",
                                                "text": "Il a l’esprit pesant."
                                            },
                                            {
                                                "example_id": "6f270ae2-0403-46d4-9063-aae2ddb90109",
                                                "sense_id": "c468197c-9b85-3cd9-91c2-bbf3035e992e",
                                                "text": "Son style est pesant."
                                            },
                                            {
                                                "example_id": "c252d749-f7ee-4b46-a5fd-01853f3977bc",
                                                "sense_id": "c468197c-9b85-3cd9-91c2-bbf3035e992e",
                                                "text": "C’est un écrivain bien pesant."
                                            },
                                            {
                                                "example_id": "1d072f16-5292-493b-ab56-098dd2909e71",
                                                "sense_id": "c468197c-9b85-3cd9-91c2-bbf3035e992e",
                                                "text": "Cet homme est pesant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2ad7c3d-885b-398f-b385-11d09e146e29",
                                        "entry_id": "1a18df2f-de49-3d30-80e3-9c90be822906",
                                        "glosses": [
                                            "Qui est tardif, lent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04bb4f3d-77d9-41fd-b6dc-d1a6117226b8",
                                                "sense_id": "a2ad7c3d-885b-398f-b385-11d09e146e29",
                                                "text": "Le bœuf est un animal pesant."
                                            },
                                            {
                                                "example_id": "7ff46418-fb78-4d68-a551-16870671ebe4",
                                                "sense_id": "a2ad7c3d-885b-398f-b385-11d09e146e29",
                                                "text": "Une marche pesante."
                                            },
                                            {
                                                "example_id": "5300f62f-24a0-446a-864a-e7b979dc7a29",
                                                "sense_id": "a2ad7c3d-885b-398f-b385-11d09e146e29",
                                                "text": "Ce cheval est pesant à la main, il porte la tête basse et il s’appuie sur le mors."
                                            },
                                            {
                                                "example_id": "8cd45599-148e-4079-9db5-6a50e901fc51",
                                                "sense_id": "a2ad7c3d-885b-398f-b385-11d09e146e29",
                                                "text": "Cheval pesant, cheval qui ne s’enlève pas facilement du devant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e216cdc8-52d9-3e09-b3d6-874621714e0c",
                                        "entry_id": "1a18df2f-de49-3d30-80e3-9c90be822906",
                                        "glosses": [
                                            "Qui est onéreux, fâcheux, fatigant, incommode."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4fe8cc8-370f-4e7c-a2a1-fa803e8d5990",
                                                "sense_id": "e216cdc8-52d9-3e09-b3d6-874621714e0c",
                                                "text": "Dégagez-vous d’obligations pesantes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pesant",
                                "target_lang_code": "fr",
