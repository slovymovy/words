                "senses": [
                    {
                        "sense_id": "2ebce283-d5d2-3c38-ab85-7793708b01c8",
                        "entry_id": "c59c7a5f-e281-336a-b59e-4f35811c9da1",
                        "glosses": [
                            "Rendre un tissu moins raide, en lui enlevant son apprêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4974e122-1b7b-48df-8ecc-76634763e8f3",
                                "sense_id": "2ebce283-d5d2-3c38-ab85-7793708b01c8",
                                "text": "Les textiles utilisés sont préalablement désapprêtés par un ou plusieurs lavages."
                            },
                            {
                                "example_id": "a668490b-ffbb-443e-90f6-efc767b966cd",
                                "sense_id": "2ebce283-d5d2-3c38-ab85-7793708b01c8",
                                "text": "Au terme du processus de tissage, le tissu est désapprêté (lavé)."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e075829-7c9e-3bbc-83af-7fc82364d134",
                        "entry_id": "c59c7a5f-e281-336a-b59e-4f35811c9da1",
                        "glosses": [
                            "Faire perdre son caractère apprêté à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a34f3f-4917-4b31-ba8d-56773053bbe1",
                                "sense_id": "4e075829-7c9e-3bbc-83af-7fc82364d134",
                                "text": "Elle s’arrange le visage avec les doigts, joue par touches, pour se désapprêter, pour se sentir belle."
                            }
                        ]
                    }
