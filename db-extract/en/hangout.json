                ],
                "senses": [
                    {
                        "sense_id": "37d10fc7-07ee-398d-90b5-66996a633c54",
                        "entry_id": "893e205f-44f3-3a56-b3f5-b4f3b3de4641",
                        "glosses": [
                            "A place for hanging out; an informal meeting-place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "458bebae-1729-4d19-b177-13875a252013",
                                "sense_id": "37d10fc7-07ee-398d-90b5-66996a633c54",
                                "text": "Every Friday, Geoff and his group of friends all met at their favorite hangout to talk and have a good time."
                            },
                            {
                                "example_id": "6a9b8524-0019-437d-a08e-f2810558e8a8",
                                "sense_id": "37d10fc7-07ee-398d-90b5-66996a633c54",
                                "text": "My connection to gay men and lesbians in Cuba came about through the help of a straight man, Rafael, whom I'd met in old Havana. A day after I told him of my search, he came to me with names of three tea houses known to be gay/lesbian hang-outs. We went together and found a mix of gay and straight people."
                            }
                        ]
                    },
                    {
                        "sense_id": "03c254d2-56e3-3b9d-b505-bd1cae693342",
                        "entry_id": "893e205f-44f3-3a56-b3f5-b4f3b3de4641",
                        "glosses": [
                            "A casual meeting for informal chat."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bba4286d-9539-457a-952f-99f568702cda",
                        "source_entry_id": "893e205f-44f3-3a56-b3f5-b4f3b3de4641",
                        "source_sense_description": "place for hanging out; an informal meeting-place",
                        "target_lang_word": "Treffpunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treffpunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eaf7c931-e6f8-3342-a264-dd4c2ef6239a",
                                        "entry_id": "197f8b9d-6338-35c4-a49e-c3d6e1e26989",
                                        "glosses": [
                                            "ein zuvor vereinbarter Punkt oder Ort, an dem man sich treffen möchte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd6f5e85-6d14-4e41-97ee-4d7c42dddc0f",
                                                "sense_id": "eaf7c931-e6f8-3342-a264-dd4c2ef6239a",
                                                "text": "Er war bereits fünfzehn Minuten früher am verabredeten Treffpunkt."
                                            },
                                            {
                                                "example_id": "88a0a075-6d4f-471f-8bb7-738c4a7400f8",
                                                "sense_id": "eaf7c931-e6f8-3342-a264-dd4c2ef6239a",
                                                "text": "„Sogar einen Treffpunkt schlug er vor, ließ aber das Datum der erwünschten Begegnung offen.“"
                                            },
                                            {
                                                "example_id": "78646e09-2509-4a07-8704-9de4a736da51",
                                                "sense_id": "eaf7c931-e6f8-3342-a264-dd4c2ef6239a",
                                                "text": "„Von Kano aus zieht er weiter in Richtung des verabredeten Treffpunkts.“"
                                            },
                                            {
                                                "example_id": "19b750b8-080d-4e2f-b708-163800af4455",
                                                "sense_id": "eaf7c931-e6f8-3342-a264-dd4c2ef6239a",
                                                "text": "„Cooper wurde mit dem Schreibzeug und den Papieren des Kapitäns zum Treffpunkt geschickt, und Letzterer wurde freigelassen.“"
                                            },
                                            {
                                                "example_id": "bf9158e0-af4b-4720-9d51-5c2e14f45710",
                                                "sense_id": "eaf7c931-e6f8-3342-a264-dd4c2ef6239a",
                                                "text": "„Pünktlich zur verabredeten Zeit fand sie sich am Treffpunkt ein und staunte nicht schlecht, wen sie alles kannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21a7df92-b984-438f-a54a-70294e2c2339",
                        "source_entry_id": "893e205f-44f3-3a56-b3f5-b4f3b3de4641",
                        "source_sense_description": "place for hanging out; an informal meeting-place",
                        "target_lang_word": "Treff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
