{
    "word_family": [
        "assigner",
        "consigner",
        "résigner",
        "signal",
        "signaler",
        "signataire",
        "signature"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f3d35df-0e3a-3d32-beb3-c0789518c183",
                    "sense_definition": "Apposer sa signature sur un document écrit pour attester de son authenticité ou donner son accord.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "signature_document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de <w>signer</w> au bas du formulaire avant de le renvoyer."
                        },
                        {
                            "text": "Le directeur a pris son stylo pour <w>signer</w> ce document officiel hier matin."
                        }
                    ],
                    "synonyms": [
                        "parapher"
                    ],
                    "common_phrases": [
                        "signer un contrat",
                        "signer un document",
                        "signer le registre"
                    ]
                },
                {
                    "sense_id": "c7458640-941e-36bc-a1d1-5000e1d6c761",
                    "sense_definition": "S'engager formellement par contrat auprès d'une entreprise ou d'un club.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement_contractuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des semaines de négociations, l'attaquant a accepté de <w>signer</w> avec son nouveau club."
                        },
                        {
                            "text": "Elle vient enfin de <w>signer</w> pour un contrat à durée indéterminée."
                        }
                    ],
                    "common_phrases": [
                        "signer avec un club"
                    ]
                },
                {
                    "sense_id": "8930b97d-8823-37a9-bf17-00e9317bf28c",
                    "sense_definition": "Faire sur soi-même le signe de la croix en signe de dévotion religieuse.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fidèle s'est recueilli un instant pour se <w>signer</w> devant l'autel de la chapelle."
                        },
                        {
                            "text": "Elle se <w>signe</w> discrètement chaque fois qu'elle franchit la porte de l'église."
                        }
                    ],
                    "common_phrases": [
                        "se signer"
                    ]
                },
                {
                    "sense_id": "90140372-5b9a-399d-8b25-81abc37c1dcb",
                    "sense_definition": "Communiquer ou s'exprimer au moyen de la langue des signes.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une interprète est intervenue pour <w>signer</w> la totalité du discours en direct."
                        },
                        {
                            "text": "Ses deux parents étant sourds, elle a très vite appris à <w>signer</w>."
                        }
                    ],
                    "antonyms": [
                        "oraliser"
                    ],
                    "common_phrases": [
                        "apprendre à signer",
                        "signer en langue des signes"
                    ]
                },
                {
                    "sense_id": "5a5cc4bf-816c-356b-ab33-09ff3f11c0ac",
                    "sense_definition": "Être l'auteur ou le réalisateur d'une œuvre, d'un exploit ou d'un résultat remarquable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation_auteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce réalisateur réputé vient de <w>signer</w> un film magistral sur la guerre."
                        },
                        {
                            "text": "La jeune gymnaste a réussi à <w>signer</w> une superbe performance lors de la finale."
                        }
                    ],
                    "common_phrases": [
                        "signer une belle performance",
                        "signer un nouveau roman",
                        "signer une victoire"
                    ]
                },
                {
                    "sense_id": "67d86fa3-2776-350d-8377-1aa1f37464db",
                    "sense_definition": "Recruter ou faire signer un contrat professionnel à un sportif ou un artiste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement_contractuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le label de musique espère <w>signer</w> ce jeune chanteur dès le mois prochain."
                        },
                        {
                            "text": "L'entraîneur a tout fait pour <w>signer</w> ce joueur étranger durant l'été."
                        }
                    ],
                    "common_phrases": [
                        "signer un joueur",
                        "signer un artiste"
                    ]
                },
                {
                    "sense_id": "45b142e5-eb9a-3b94-a96a-e8c106219b31",
                    "sense_definition": "Revendiquer la responsabilité d'un acte ou y laisser une trace personnelle reconnaissable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "creation_auteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cambrioleur a <w>signé</w> chacun de ses vols en laissant une rose sur le coffre."
                        },
                        {
                            "text": "Malgré les nombreuses critiques reçues, le journaliste persiste et <w>signe</w> : il maintient ses accusations."
                        }
                    ],
                    "common_phrases": [
                        "persister et signer"
                    ]
                },
                {
                    "sense_id": "d94a25b5-8f8f-374f-bb3b-cbdfb71adabe",
                    "sense_definition": "Marquer de façon définitive le début, la fin ou la perte inévitable de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette lourde défaite électorale risque fort de <w>signer</w> la fin de sa carrière politique."
                        },
                        {
                            "text": "La faillite de cette banque pourrait bien <w>signer</w> l'arrêt de mort du projet."
                        }
                    ],
                    "common_phrases": [
                        "signer la fin de",
                        "signer l'arrêt de mort"
                    ]
                }
            ]
        }
    ]
}