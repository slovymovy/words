                    {
                        "sense_id": "90b5f5a2-2361-3713-87f8-f6f6a38e5152",
                        "entry_id": "adf11e99-8252-327e-ad87-37ed26e726ab",
                        "glosses": [
                            "feierliche Zusammenkunft von Gläubigen zum Dank an Gott nach Einfuhr der Ernte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f72362c-baf4-4c81-b6b6-b606e7b67e69",
                                "sense_id": "90b5f5a2-2361-3713-87f8-f6f6a38e5152",
                                "text": "„Drinnen wurde noch alles für den bevorstehenden Erntedankgottesdienst vorbereitet.“"
                            },
                            {
                                "example_id": "159b9626-f432-4ec9-a9db-da623bd42137",
                                "sense_id": "90b5f5a2-2361-3713-87f8-f6f6a38e5152",
                                "text": "„Vor dem Altar liegen noch Äpfel, Kürbisse und Kartoffeln vom Erntedankgottesdienst.“"
                            },
                            {
                                "example_id": "d462d3d3-d38f-42cf-82e0-0e4e46601e75",
                                "sense_id": "90b5f5a2-2361-3713-87f8-f6f6a38e5152",
                                "text": "„Am Morgen war der Erntedankgottesdienst in der Kapelle gefeiert worden, am Nachmittag trafen sich alle beim Kirchenvater, auch die Bauern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
