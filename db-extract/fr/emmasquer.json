                "senses": [
                    {
                        "sense_id": "1d0b11eb-f00e-377b-9a2a-c93b2e925b48",
                        "entry_id": "e7e6cadd-e629-3eda-9094-9c11198f42d7",
                        "glosses": [
                            "Envoûter par magie."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "16dd3314-7db8-4202-9f4c-33d79aa255f6",
                                "sense_id": "1d0b11eb-f00e-377b-9a2a-c93b2e925b48",
                                "text": "S’il y a des gens qui emmasquent, il y en a d’autres qui démasquent, et l’on doit penser si leur clientèle est nombreuse."
                            },
                            {
                                "example_id": "3fed4667-a130-4ac9-92ed-dc20929bd41a",
                                "sense_id": "1d0b11eb-f00e-377b-9a2a-c93b2e925b48",
                                "text": "Mémé a dit à papa que tu l’avais peut-être emmasqué pendant la partie, et qu’il devrait aller voir le vieux berger des collines de la Faralade pour le désemmasquer."
                            }
                        ]
                    }
