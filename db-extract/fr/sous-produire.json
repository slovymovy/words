                ],
                "senses": [
                    {
                        "sense_id": "90277fd8-c0f4-38a8-a08b-49a32ad5a33b",
                        "entry_id": "3adc7c34-525c-3f63-a142-416f7188e58b",
                        "glosses": [
                            "Produire en quantité insuffisante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3814d745-fbe5-4731-b0ac-b4b27a740462",
                                "sense_id": "90277fd8-c0f4-38a8-a08b-49a32ad5a33b",
                                "text": "Le marché privé a tendance à sous-produire des biens et des services qui ont des externalités bénéfiques; il ne peut en effet pas facturer tous les bénéfices pour être dédommagé de la totalité des coûts."
                            },
                            {
                                "example_id": "d1ffa808-b202-4cbe-b7ef-123d62718657",
                                "sense_id": "90277fd8-c0f4-38a8-a08b-49a32ad5a33b",
                                "text": "Au point de vue de la « rentabilité » capitaliste on peut donc avoir intérêt à sous-produire."
                            }
                        ]
                    },
                    {
                        "sense_id": "e67da431-d403-33c5-859a-75019edd5565",
                        "entry_id": "3adc7c34-525c-3f63-a142-416f7188e58b",
                        "glosses": [
                            "Créer des sous-produits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01dfbcfc-23da-49f1-a3c5-e7642519df05",
                                "sense_id": "e67da431-d403-33c5-859a-75019edd5565",
                                "text": "On ne peut produire sans sous-produire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c4dc4d9-ffa8-4270-9969-6f061e888562",
                        "source_entry_id": "3adc7c34-525c-3f63-a142-416f7188e58b",
                        "source_sense_description": "produire en quantité insuffisante",
                        "target_lang_word": "underproduce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underproduce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dac22a2-b5c2-35d2-bffb-6358a1c26d6c",
                                        "entry_id": "8c2c7856-46d0-383d-b195-041e574e5b4b",
                                        "glosses": [
                                            "To produce less than normal, or less than needed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62dfae2d-fc34-41e8-b97c-577431aed55f",
                                                "sense_id": "0dac22a2-b5c2-35d2-bffb-6358a1c26d6c",
                                                "text": "It misdesigned goods, adversely selected technologies, misallocated and misremunerated factors of production, encouraged work to rule, underproduced, misdistributed outputs and was subject to a myriad of moral hazards."
                                            }
                                        ]
