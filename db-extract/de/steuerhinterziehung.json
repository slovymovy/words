                    {
                        "sense_id": "a50cbb4a-02d2-38f5-b667-4bf5392fa692",
                        "entry_id": "a1b5b44a-0af8-33ac-9cec-6ed4f7bf50b9",
                        "glosses": [
                            "illegale Praxis, die zum Ziel hat keine oder weniger Steuern abzuführen, indem man seine tatsächlichen Einkommens- oder Vermögensverhältnisse verschleiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ca1991-f9f0-438a-bc86-10addb4b0536",
                                "sense_id": "a50cbb4a-02d2-38f5-b667-4bf5392fa692",
                                "text": "Jährlich gehen dem deutschen Fiskus mehrere Milliarden Euro durch Steuerhinterziehung verloren."
                            },
                            {
                                "example_id": "13827ae4-e147-4ec5-941d-9b4b71d316d9",
                                "sense_id": "a50cbb4a-02d2-38f5-b667-4bf5392fa692",
                                "text": "„Rund tausend Kunden einer kleinen, feinen Bank in Zürich müssen nun fürchten, wegen Steuerhinterziehung belangt zu werden.“"
                            },
                            {
                                "example_id": "38868f35-47ab-40bc-a57c-326fc113b7c3",
                                "sense_id": "a50cbb4a-02d2-38f5-b667-4bf5392fa692",
                                "text": "[Schlagzeile:] „Wirtschaft – Steuerhinterziehungen im großen Stil“"
                            }
                        ],
                        "sense_index_json": "\"1\""
