                "senses": [
                    {
                        "sense_id": "33975803-00b3-370a-aa3e-ce175a0d5d6f",
                        "entry_id": "d0415d13-2874-3090-b3a4-be5e3fe4ddd2",
                        "glosses": [
                            "iemand die eindverantwoordelijkheid draagt voor de inhoud van een krant of dergelijke publicatie"
                        ],
                        "tags": [
                            "beroep",
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "2d9225cc-cee3-4aee-9ac5-e963828d9023",
                                "sense_id": "33975803-00b3-370a-aa3e-ce175a0d5d6f",
                                "text": "Uiteindelijk greep de hoofdredacteur in en plaatste een retractie van het gewraakte artikel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "373992d3-3707-453b-bb0c-3e3f87f47418",
                        "source_entry_id": "d0415d13-2874-3090-b3a4-be5e3fe4ddd2",
                        "source_sense_id": "33975803-00b3-370a-aa3e-ce175a0d5d6f",
                        "source_sense_description": "iemand die eindverantwoordelijkheid draagt voor de inhoud van een krant of dergelijke publicatie",
                        "target_lang_word": "Chefredakteur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chefredakteur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "385cb8b7-449e-38e5-8df7-de1ce0154355",
                                        "entry_id": "29d34e91-eeac-3fc8-bb1a-45417fc41abd",
                                        "glosses": [
                                            "Leiter einer Redaktion bei einer Zeitung, Zeitschrift, beim Fernsehen oder Hörfunk, der die Beiträge aussucht und bearbeitet, bevor sie veröffentlicht werden"
                                        ],
                                        "tags": [
                                            "Journalistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b47e34c-0019-46dd-bacc-1f47b3ba6348",
                                                "sense_id": "385cb8b7-449e-38e5-8df7-de1ce0154355",
                                                "text": "Henri Nannen war jahrelang Chefredakteur und Herausgeber des Wochenmagazins Stern."
                                            },
                                            {
                                                "example_id": "1a675dd2-e091-4398-a2d5-d65c55a26837",
                                                "sense_id": "385cb8b7-449e-38e5-8df7-de1ce0154355",
                                                "text": "Die Chefredakteure glauben, die gegenwärtig schlechte wirtschaftliche Lage vieler Zeitungen und Zeitschriften in Deutschland habe die Unabhängigkeit der Presse bisher kaum beeinträchtigt."
                                            },
                                            {
                                                "example_id": "ffd1b0eb-10fe-4752-9231-ff995d7c8e2a",
                                                "sense_id": "385cb8b7-449e-38e5-8df7-de1ce0154355",
                                                "text": "„Er war Chefredakteur der Liberalen in Island.“"
                                            },
                                            {
                                                "example_id": "bc52f135-b34a-4211-9ac7-34804bb661c6",
                                                "sense_id": "385cb8b7-449e-38e5-8df7-de1ce0154355",
                                                "text": "„Offenbar hielt der politisch exzellent vernetzte Chefredakteur die Lage für nicht so dramatisch, dass er lieber in der Reichshauptstadt geblieben wäre.“"
                                            },
                                            {
                                                "example_id": "d26fcf6a-6350-4574-acaa-ec25ecba56ed",
                                                "sense_id": "385cb8b7-449e-38e5-8df7-de1ce0154355",
                                                "text": "„Roland Hilbert war dran gewesen, der stellvertretende Chefredakteur der überregionalen Tageszeitung, für die ich aus Köln berichtete.“"
                                            },
                                            {
                                                "example_id": "893ad1b5-6c94-4c96-9ebd-e88eb3045885",
                                                "sense_id": "385cb8b7-449e-38e5-8df7-de1ce0154355",
                                                "text": "„Dennoch sprach es sich schnell herum, dass ich für eine Art Zeitung gearbeitet hatte, und in meinem zweiten Jahr auf der Lisbon Highschool wurde ich Chefredakteur unserer Schülerzeitung ‚The Drum‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0528f211-348e-40f8-bc3e-f8d5db73c041",
                        "source_entry_id": "d0415d13-2874-3090-b3a4-be5e3fe4ddd2",
                        "source_sense_id": "33975803-00b3-370a-aa3e-ce175a0d5d6f",
                        "source_sense_description": "iemand die eindverantwoordelijkheid draagt voor de inhoud van een krant of dergelijke publicatie",
                        "target_lang_word": "Herausgeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herausgeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b549e6b-0e3c-3876-be16-173d118a2c4f",
                                        "entry_id": "5546d820-f3b3-3872-bda9-f3225e3877b1",
                                        "glosses": [
                                            "eine Person oder Personengruppe, die für die Veröffentlichung von künstlerischen oder wissenschaftlichen Werken in Wort, Schrift, Ton oder Bild rechtlich und publizistisch verantwortlich zeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c604b89d-2134-42ce-9f5f-64871590111e",
                                                "sense_id": "1b549e6b-0e3c-3876-be16-173d118a2c4f",
                                                "text": "Ist kein Herausgeber angegeben, so wird vermutet, daß der Verleger ermächtigt ist."
                                            },
                                            {
                                                "example_id": "8a29ef0a-2765-4a93-bf4b-c9b2c15aaceb",
                                                "sense_id": "1b549e6b-0e3c-3876-be16-173d118a2c4f",
                                                "text": "Ich halte es für ehrlicher, wenn sich von nun an die Verleger ›Herausgeber‹ nennen. Denn näher betrachtet sind sie es."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                        "entry_id": "5546d820-f3b3-3872-bda9-f3225e3877b1",
                                        "glosses": [
                                            "eine Person, die die journalistische Leitlinie eines periodischen Mediums (Zeitschrift etc.) bestimmt und deren Umsetzung überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df522d3f-e7a7-44f6-b7d9-323f1358155c",
                                                "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                                "text": "Im Sinn der Bestimmungen dieses Bundesgesetzes ist … 9. \"Herausgeber\": wer die grundlegende Richtung des periodischen Mediums bestimmt; …"
                                            },
                                            {
                                                "example_id": "7cec457e-289c-4464-8600-02b8b1630d9d",
                                                "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                                "text": "Auf jedem periodischen Medienwerk sind zusätzlich die Anschriften des Medieninhabers und der Redaktion des Medienunternehmens sowie Name und Anschrift des Herausgebers anzugeben."
                                            },
                                            {
                                                "example_id": "3ca04e3a-a314-4b25-9264-5f6042b97f79",
                                                "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                                "text": "„Ich betrat das Haus, und die Dienerin zeigte mir das Zimmer, in dem der Herausgeber Jacquet ganz allein an seiner Zeitung arbeitete; es lag im Erdgeschoß, und die Tür war wegen der Hitze offen.“"
                                            },
                                            {
                                                "example_id": "2bad2a6e-7faf-4fd0-a001-30378ae4137c",
                                                "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                                "text": "„Als Herausgeber eines populären Journals führt Wieland eine umfangreiche und vielfältige Korrespondenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "09bf987b-e408-3e83-b176-5eedd7688162",
                                        "entry_id": "5546d820-f3b3-3872-bda9-f3225e3877b1",
                                        "glosses": [
                                            "Emittent einer Wandelanleihe oder einer Umtauschanleihe"
                                        ],
                                        "tags": [
                                            "Wertpapierrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e370d53-8af1-4a5a-835a-0de749fdc064",
                                                "sense_id": "09bf987b-e408-3e83-b176-5eedd7688162",
                                                "text": "Der Herausgeber sichert dem Anleiheninhaber eine feste Laufzeit und einen festen Zinssatz zu, der deutlich unterhalb des Kapitalmarktzinses liegt."
                                            },
                                            {
                                                "example_id": "2a6a09ce-b2db-4ed1-a26f-58024902127e",
                                                "sense_id": "09bf987b-e408-3e83-b176-5eedd7688162",
                                                "text": "Die Ausfertigungen der Edikte und die Mitteilungen über Verlustanzeigen sind dem Herausgeber erst zu übersenden, wenn das Entgelt für die Einschaltung entrichtet worden ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fdd4392-24dd-41d6-b174-eb302585c2fc",
                        "source_entry_id": "d0415d13-2874-3090-b3a4-be5e3fe4ddd2",
                        "source_sense_id": "33975803-00b3-370a-aa3e-ce175a0d5d6f",
                        "source_sense_description": "iemand die eindverantwoordelijkheid draagt voor de inhoud van een krant of dergelijke publicatie",
                        "target_lang_word": "Verleger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verleger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                        "entry_id": "a6fc243d-9bdd-3260-96c8-50374c1237ae",
                                        "glosses": [
                                            "Person, die einen Verlag betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01beef55-e2e4-4181-9ae8-13cad25d0122",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "Viele Autoren haben Probleme, für ihre Werke einen Verleger zu finden."
                                            },
                                            {
                                                "example_id": "5818c9ef-f414-4f5b-af0d-46c09ff3658f",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "„Der Verleger entzog sich der Polizeibehörde und kehrte erst 1903 mit einer Zahlung von 30000 Goldmark Buße aus Paris zurück.“"
                                            },
                                            {
                                                "example_id": "57139c10-77a7-4485-a339-bf12f38f0b5b",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "„Der Verleger bestellte ein Glas Rum auf Eis.“"
                                            },
                                            {
                                                "example_id": "16aea986-ed04-410e-bda6-d1dbc61b6dd5",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "„Außerdem ist da Carl Friedrich Kunz, ein Weinhändler und Verleger, der als erster Hoffmanns Werke in Buchform veröffentlichen wird.“"
                                            },
                                            {
                                                "example_id": "94682147-5f6b-404c-9a93-f9e536fbe8d3",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "„Der starke Herr neben ihm war der Verleger seiner Schriften, Herr Daniel Sander, im übrigen aber sein vollkommener Widerpart, wenigstens in allem, was Erscheinung anging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
