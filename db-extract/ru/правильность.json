                "senses": [
                    {
                        "sense_id": "ecc357b4-aa05-38f5-84d5-63a323b46f08",
                        "entry_id": "f0fd2101-80b2-3d4b-a17e-ef942e9e60ab",
                        "glosses": [
                            "свойство или состояние по значению прилагательного правильный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4288bee8-05a0-4911-aa08-d2560fe87804",
                                "sense_id": "ecc357b4-aa05-38f5-84d5-63a323b46f08",
                                "text": "Всем видам кулонометрического метода свойственны высокие метрологические характеристики (малая погрешность анализа, высокая правильность, воспроизводимость, селективность)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db4cb324-f2a1-4668-b570-a532dcf52810",
                        "source_entry_id": "f0fd2101-80b2-3d4b-a17e-ef942e9e60ab",
                        "source_sense_id": "ecc357b4-aa05-38f5-84d5-63a323b46f08",
                        "target_lang_word": "correctness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correctness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbaf1183-5f0c-3f41-a81e-83f7fe50190e",
                                        "entry_id": "3b64b825-2e34-32ee-aadb-c3029d93f3fa",
                                        "glosses": [
                                            "Freedom from error."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "458b3f40-d5a4-487a-993a-428022766093",
                                                "sense_id": "dbaf1183-5f0c-3f41-a81e-83f7fe50190e",
                                                "text": "As a demonstration, we first establish the correctness of the Jacobian matrices for kinetic models of hydrogen, methane, ethylene, and isopentanol oxidation, then demonstrate the performance achievable on CPUs and GPUs using pyJac via matrix evaluation timing comparisons.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7999dcaa-c347-38ab-b1f9-dcf28a321efc",
                                        "entry_id": "3b64b825-2e34-32ee-aadb-c3029d93f3fa",
                                        "glosses": [
                                            "Conformity to the truth or to fact."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7b2c2c6-1e12-3780-948a-09e72ab87b3c",
                                        "entry_id": "3b64b825-2e34-32ee-aadb-c3029d93f3fa",
                                        "glosses": [
                                            "Conformity to recognized standards."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d4d214-ab41-4a3b-ba42-fda1c8c63ea8",
                                                "sense_id": "f7b2c2c6-1e12-3780-948a-09e72ab87b3c",
                                                "text": "I mean, people who talk about political correctness as being a kind of thought police have no idea of what a thought police is. But political correctness does have the same mentality. It means that intellectual argument is doomed. Objective truth simply becomes a thing to jeer at, because obviously there's no such thing as objectivity—unless of course you're politically okay, in which case you can be objective. Any child can see through that, but many adults can't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6bd05a7-1cf1-391d-bfc6-ef40e26cddcf",
                                        "entry_id": "3b64b825-2e34-32ee-aadb-c3029d93f3fa",
                                        "glosses": [
                                            "The state of an algorithm that correctly mirrors its specification."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39db498a-dd3c-47de-9e52-28988dd7cc72",
                        "source_entry_id": "f0fd2101-80b2-3d4b-a17e-ef942e9e60ab",
                        "source_sense_id": "ecc357b4-aa05-38f5-84d5-63a323b46f08",
                        "target_lang_word": "accuracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accuracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                        "entry_id": "f4264e93-673a-3b4e-bb7b-d219aeb4967d",
                                        "glosses": [
                                            "The state of being accurate; being free from error; exactness; correctness"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61723ab6-6994-4fa0-ba85-6c926e519377",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "Its professed end [of logic], is to teach men to think, to judge, and to reason, with precision and accuracy."
                                            },
                                            {
                                                "example_id": "b5182719-27e8-46c5-8da7-022f608c285a",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "The efficiency of the instrument will also depend upon the accuracy with which the piston fits the bottom and sides of the barrel. When the piston is depressed to the bottom, it is considered in theory to be in absolute contact, so as to exclude every particle of air from the space between it and the bottom."
                                            },
                                            {
                                                "example_id": "cf9817f6-b9d1-48f0-a856-4115b42e1d16",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b921362-6c4a-3de7-a632-fdfe2b4fdcd3",
                                        "entry_id": "f4264e93-673a-3b4e-bb7b-d219aeb4967d",
                                        "glosses": [
                                            "Exact conformity to truth, or to a rule or model; degree of conformity of a measure to a true or standard value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b336e89-43b9-46c0-a9a0-d5867d4adff8",
                                                "sense_id": "4b921362-6c4a-3de7-a632-fdfe2b4fdcd3",
                                                "text": "The jury doubted the accuracy of the witness' comments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
