                    },
                    {
                        "translation_id": "747d73d5-f8f2-4115-8360-8452b9aac0db",
                        "source_entry_id": "97e7237d-9eb2-3ac7-80cb-5bf099f99ebf",
                        "source_sense_id": "28e52319-15d0-328e-8c98-b84773cc5c03",
                        "source_sense_description": "Cantharellus cibarius, een eetbare paddenstoel met een lichte pepersmaak",
                        "target_lang_word": "chanterelle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanterelle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0666ec29-8b02-3d3d-b3ab-be49b5f2f679",
                                        "entry_id": "8c6ca2b1-5541-3e4f-9753-75fe5dce5cc8",
                                        "glosses": [
                                            "A widely distributed edible mushroom, Cantharellus cibarius, being yellow and trumpet-shaped; or any similar mushroom of the genera Cantharellus, Polyozellus or Gomphus, not all of which are edible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c067393d-aa1b-44de-9896-e732a3c48dd3",
                                                "sense_id": "0666ec29-8b02-3d3d-b3ab-be49b5f2f679",
                                                "text": "Even the homely wood blewits, that you cook like tripe, with milk and onions, and the egg-yolk yellow chanterelle with its fan-vaulting and faint smell of apricots, all spring up overnight like bubbles of earth, unsustained by nature, existing in a void."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda8136e-ad2c-320d-9d3b-6d930664f938",
                                        "entry_id": "8c6ca2b1-5541-3e4f-9753-75fe5dce5cc8",
                                        "glosses": [
                                            "The highest string of the violin or similar instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0768f14f-c155-4399-8752-a2cd14f45c6a",
                                                "sense_id": "bda8136e-ad2c-320d-9d3b-6d930664f938",
                                                "text": "There were hushed moments of complete beauty when the melody moved out and hung above the chanterelle like a hummingbird poised over a flower."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ebb3037-7cf8-45fa-980a-5822ba91fc52",
                        "source_entry_id": "97e7237d-9eb2-3ac7-80cb-5bf099f99ebf",
                        "source_sense_id": "28e52319-15d0-328e-8c98-b84773cc5c03",
                        "source_sense_description": "Cantharellus cibarius, een eetbare paddenstoel met een lichte pepersmaak",
                        "target_lang_word": "chanterelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanterelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "960bddc3-a30b-38e9-a742-fc16d4b21cba",
                                        "entry_id": "159fdc59-9b30-3c25-9e72-109bf8de0a01",
                                        "glosses": [
                                            "Corde d’un violon, d’une basse, etc., qui est la plus déliée et qui a le son le plus aigu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "431107e3-c770-4b10-9757-b6db354f937d",
                                                "sense_id": "960bddc3-a30b-38e9-a742-fc16d4b21cba",
                                                "text": "Appuyer sur la chanterelle, insister sur un point délicat, par exemple, pour convaincre des personnes qui résistent."
                                            },
                                            {
                                                "example_id": "853f9065-82a7-4ef3-9d52-a2d76a9f5bf4",
                                                "sense_id": "960bddc3-a30b-38e9-a742-fc16d4b21cba",
                                                "text": "La chanterelle de mon luth, appendu à la cloison, éclata."
                                            },
                                            {
                                                "example_id": "cf3401c8-1e11-47e4-aa3a-063deafae27e",
                                                "sense_id": "960bddc3-a30b-38e9-a742-fc16d4b21cba",
                                                "text": "— Pourquoi, demanda Mattia, accorde-t-on un violon sur certaines notes et pas sur d’autres ?\nJe crus que ce perruquier, qui précisément à ce moment même était en train de passer le peigne dans la longue chevelure de Mattia, allait faire une réponse dans le genre des miennes : et je riais déjà tout bas quand il prit la parole :— La seconde corde à gauche de l’instrument devant donner le la au diapason normal, les autres cordes doivent être accordées de façon à ce qu’elles donnent les notes de quinte en quinte, c’est-à-dire sol, quatrième corde ; ré, troisième corde ; la, deuxième corde ; mi, première corde ou chanterelle."
                                            },
                                            {
                                                "example_id": "1b919c04-cd2d-4930-aeb6-dec9f1eeac45",
                                                "sense_id": "960bddc3-a30b-38e9-a742-fc16d4b21cba",
                                                "text": "Nous vîmes apparaître […] deux ou trois camarades de l'autre batterie ; l'un portait un violon emprunté au 18ᵉ d'artillerie et dont la chanterelle était remplacée par un fil d'acier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f687f753-eb46-3f0a-81e8-22b7ecc4b9e9",
                                        "entry_id": "159fdc59-9b30-3c25-9e72-109bf8de0a01",
                                        "glosses": [
                                            "Bouteille de verre mince, dont on tire des sons en soufflant dessus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dc386b4-c97b-338a-ae16-bf5b19c12d41",
                                        "entry_id": "159fdc59-9b30-3c25-9e72-109bf8de0a01",
                                        "glosses": [
                                            "Son donné par cette corde ou cette bouteille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f58fd53-6239-42ae-83a8-a1f03152eb20",
                                                "sense_id": "1dc386b4-c97b-338a-ae16-bf5b19c12d41",
                                                "text": "Par intervalles, un hibou ricanait et, continus, en sourdine, susurraient le glouglou des ruisselets, la chanterelle des pisselottes, le chuchotis des goutelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2421b650-ab2e-32c2-83c2-be6409c4feda",
                                        "entry_id": "159fdc59-9b30-3c25-9e72-109bf8de0a01",
                                        "glosses": [
                                            "Oiselle que l’on met dans une cage au milieu d’un bois ou d’une campagne, afin que par son chant elle attire les autres oiseaux dans les filets tendus pour les prendre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38e866c5-b10d-3399-ab28-a97860e37206",
                                        "entry_id": "159fdc59-9b30-3c25-9e72-109bf8de0a01",
                                        "glosses": [
                                            "Partie de l’arçon du chapelier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32100d59-cff6-3ab3-8a47-622de61442f0",
                                        "entry_id": "159fdc59-9b30-3c25-9e72-109bf8de0a01",
                                        "glosses": [
                                            "Petite bobine des tireurs d’or que l’on nomme aussi chantarille ou chanterille"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chanterelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ee47698-4e1d-3b6c-9c1d-fd9e72f321ae",
                                        "entry_id": "38006b7d-9613-360b-a794-58b4a4c85b25",
                                        "glosses": [
                                            "Girolle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0eeade9-153b-465f-a912-d5ddecbead72",
                                                "sense_id": "4ee47698-4e1d-3b6c-9c1d-fd9e72f321ae",
                                                "text": "La chanterelle est un excellent champignon de couleur jaune d’œuf, à senteur forestière, qu'on se plaît d’ordinaire à consommer frais cueilli sauté à la poêle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9b8946-2ffe-3bb6-98ce-4a0f378b25bb",
                                        "entry_id": "38006b7d-9613-360b-a794-58b4a4c85b25",
                                        "glosses": [
                                            "Espèce de champignons à plis lamelliformes, au chapeau en forme de coupe ou d'entonnoir, et au pied sans anneau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dedf95c-4088-468b-b1de-74bed3f7a525",
                                                "sense_id": "5a9b8946-2ffe-3bb6-98ce-4a0f378b25bb",
                                                "text": "Les chanterelles sont souvent comestibles mais peuvent être indigestes."
                                            },
                                            {
                                                "example_id": "28577395-ffbb-4a5c-9a83-3c54f8386f37",
                                                "sense_id": "5a9b8946-2ffe-3bb6-98ce-4a0f378b25bb",
                                                "text": "Je vais communier avec les chanterelles qui naissent."
                                            },
                                            {
                                                "example_id": "69069d24-5ec6-4a59-8ebd-4f6f56a250d1",
                                                "sense_id": "5a9b8946-2ffe-3bb6-98ce-4a0f378b25bb",
                                                "text": "Tout ce que nous puissions espérer à cette époque, ce sont des chanterelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
