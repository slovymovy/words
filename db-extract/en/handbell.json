                    },
                    {
                        "translation_id": "9463a856-a5de-43d5-b2cd-997728abc202",
                        "source_entry_id": "d938c424-fe25-3714-a497-cda50d732884",
                        "source_sense_id": "eba3560b-462b-34cd-89b6-6143c511b8fb",
                        "source_sense_description": "small bell rung by hand",
                        "target_lang_word": "sonnette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonnette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34f7995c-b4ff-3133-8110-d38df11606a7",
                                        "entry_id": "b0b4bd8c-3bf5-3a25-af1f-525d263eb9c8",
                                        "glosses": [
                                            "Clochette dont on se sert pour appeler ou pour avertir de sa présence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72da2720-7042-4396-a449-dab6e6b3420e",
                                                "sense_id": "34f7995c-b4ff-3133-8110-d38df11606a7",
                                                "text": "Il est inutile de dire que, dès minuit, Peyrade cotonnait le battant de cette sonnette."
                                            },
                                            {
                                                "example_id": "9336366e-7d13-4947-86d4-4a235a712e9a",
                                                "sense_id": "34f7995c-b4ff-3133-8110-d38df11606a7",
                                                "text": "Il courut aux cordons des sonnettes, les tira de manière à les briser, après avoir fait retentir des tintements étranges."
                                            },
                                            {
                                                "example_id": "a9c496f3-1be4-4717-8632-104bf26787b6",
                                                "sense_id": "34f7995c-b4ff-3133-8110-d38df11606a7",
                                                "text": "L’abbé ne fut pas adroit ; il feignit de ne pas la voir. Pour comble de malchance, la sonnette qu’il avait tirée timidement tinta au moins une minute, si bien que, de l’intérieur, on pouvait le croire suspendu au cordon. Aussi, quand la Parisienne fut venue ouvrir, elle ne nous offrit pas d’entrer."
                                            },
                                            {
                                                "example_id": "49cbfffc-81dd-42a1-ac78-f58b33291329",
                                                "sense_id": "34f7995c-b4ff-3133-8110-d38df11606a7",
                                                "text": "À la quinzième ligne, j'allais m’assoupir, quand un minuscule martel de métal piqueta la sonnette aiguë."
                                            },
                                            {
                                                "example_id": "e2b0cc17-e268-446f-8ab7-652a0dd58390",
                                                "sense_id": "34f7995c-b4ff-3133-8110-d38df11606a7",
                                                "text": "À un appel de sonnette on plaçait les plats et tout ce qui était nécessaire sur un monte-charge qui s'élevait jusqu'à la salle à manger et redescendait aussitôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44b1a222-6ac4-3404-8336-ab67929c1ca5",
                                        "entry_id": "b0b4bd8c-3bf5-3a25-af1f-525d263eb9c8",
                                        "glosses": [
                                            "Grelot, petite boule de cuivre ou d’argent, creuse et fendue, dans laquelle il y a un petit morceau de métal qui sonne quand on l’agite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e21349bc-2def-4494-87c9-e804d0f5f631",
                                                "sense_id": "44b1a222-6ac4-3404-8336-ab67929c1ca5",
                                                "text": "Collier à sonnettes. - Sonnette de mulet."
                                            },
                                            {
                                                "example_id": "fb638e25-2809-4e76-945d-4eb4b525f777",
                                                "sense_id": "44b1a222-6ac4-3404-8336-ab67929c1ca5",
                                                "text": "Mme Blebé allait de groupe en groupe, laissant tinter à chaque pas son rire argentin, sans doute pour ne pas se perdre, ainsi qu’une vache qui promène sa sonnette."
                                            },
                                            {
                                                "example_id": "c4985c8b-d943-4256-9710-e1ec1a162a1f",
                                                "sense_id": "44b1a222-6ac4-3404-8336-ab67929c1ca5",
                                                "text": "Les cloches d’Hortes, on dirait des sonnettes pour les vaches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b92119-5b87-3f23-b3c8-47e0bcf3022a",
                                        "entry_id": "b0b4bd8c-3bf5-3a25-af1f-525d263eb9c8",
                                        "glosses": [
                                            "Avertisseur sonore placé à l’entrée d’une maison ou d’un magasin pour indiquer son arrivée."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "Aujourd'hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23146593-9a88-4344-befe-812307c1aeb7",
                                                "sense_id": "53b92119-5b87-3f23-b3c8-47e0bcf3022a",
                                                "text": "L'inventeur de la sonnette n'était pas propriétaire d'un chihuahua."
                                            },
                                            {
                                                "example_id": "1c87dbed-d7ba-45ef-ad48-d4e593eeb8d1",
                                                "sense_id": "53b92119-5b87-3f23-b3c8-47e0bcf3022a",
                                                "text": "Pour l’homme qui a presque tué Ralph Yarl – cet adolescent coupable d’avoir sonné à la mauvaise sonnette –, un acquittement semble probable, comme dans le cas du meurtrier de Trayvon Martin il y a dix ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a65ae4-5605-3c2e-b68c-376f026c1b5d",
                                        "entry_id": "b0b4bd8c-3bf5-3a25-af1f-525d263eb9c8",
                                        "glosses": [
                                            "Machine dont on se sert pour enfoncer des pilotis et des pieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "370a99d1-26bf-4fb4-a293-97336ee0ddbf",
                                                "sense_id": "f8a65ae4-5605-3c2e-b68c-376f026c1b5d",
                                                "text": "Lorsque, par l’effet de l’enfoncement du pieu, sa tête est parvenue un peu au-dessous du pied de la sonnette, le mouton ne peut plus l’atteindre, et alors on ne peut continuer le battage que par le moyen d’un faux pieu."
                                            },
                                            {
                                                "example_id": "21bfb895-a218-4276-9d82-d9baff42a304",
                                                "sense_id": "f8a65ae4-5605-3c2e-b68c-376f026c1b5d",
                                                "text": "Cela rappelle je ne sais quelle occupation paisible, la « sonnette » qui devant St-Florent enfonçait à coups de masse réguliers les pieux du barrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c21c922-a8ef-39de-8c1c-9acb758414f7",
                                        "entry_id": "b0b4bd8c-3bf5-3a25-af1f-525d263eb9c8",
                                        "glosses": [
                                            "Somme d'argent importante."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3601f5d-8e77-350e-8f22-7ed1fc5592ae",
                                        "entry_id": "b0b4bd8c-3bf5-3a25-af1f-525d263eb9c8",
                                        "glosses": [
                                            "Surnom donné au véhicule de surveillance situé au plus près de la cible à observer et devant donner l’alerte en cas de mouvement suspect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
