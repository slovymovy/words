                                        "examples": [
                                            {
                                                "example_id": "c2417798-de99-4fee-a578-55f9495f79f8",
                                                "sense_id": "a3c511cf-a9df-3406-9c8a-eebe4785209c",
                                                "text": "Die Absetzung von Maier-Lukenscheidt war unumgänglich, da er das Vertrauen der Mitglieder verloren hatte."
                                            },
                                            {
                                                "example_id": "3f69c4db-1fe8-498d-b572-2fa090b05ebe",
                                                "sense_id": "a3c511cf-a9df-3406-9c8a-eebe4785209c",
                                                "text": "„Die Rufe nach Absetzung des Kaisers werden lauter, Teile des Militärs stellen sich gegen ihn.“"
                                            }
                                        ],
