                "senses": [
                    {
                        "sense_id": "44a51f79-9079-348b-9dc3-a7b45de44068",
                        "entry_id": "d0e64bd4-8469-3391-933a-3c65eded3078",
                        "glosses": [
                            "Athlète courant le 100 mètres haies (pour les femmes), le 110 mètres haies (pour les hommes) ou le 400 mètres haies."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "eb52e20d-9437-4ae0-8f3a-189c4367943c",
                                "sense_id": "44a51f79-9079-348b-9dc3-a7b45de44068",
                                "text": "La hurdleuse, 25 ans, a pourtant réalisé une saison quasi parfaite."
                            },
                            {
                                "example_id": "3b915a34-a1a4-47c0-902c-785ae8210390",
                                "sense_id": "44a51f79-9079-348b-9dc3-a7b45de44068",
                                "text": "Ainsi la jambe d’attaque du hurdleur, la jambe libre du sauteur en hauteur, la jambe de frappe de balle en foot et rugby sera d’autant plus efficace qu’elle aura été puissante et dynamique en exécutant la prise d’avance."
                            },
                            {
                                "example_id": "c6f23b0a-ffa9-4d2f-8f0a-e9142962ae98",
                                "sense_id": "44a51f79-9079-348b-9dc3-a7b45de44068",
                                "text": "Je suis venu parce que j’avais envie de courir, envie de me dépouiller, envie d’aider mes autres potes hurdleurs. J’ai vraiment faim »"
                            },
                            {
                                "example_id": "b2f3f00b-942d-413a-af65-4b20f09eeea1",
                                "sense_id": "44a51f79-9079-348b-9dc3-a7b45de44068",
                                "text": "La hurdleuse Lisa Urech n’a pas tardé à trouver ses marques en salle."
                            },
                            {
                                "example_id": "ecd4f460-a882-4604-915d-d78ee722551a",
                                "sense_id": "44a51f79-9079-348b-9dc3-a7b45de44068",
                                "text": "« On a l’impression qu’il est né hurdleur », a dit Liu au sujet de son rival de 21 ans."
                            }
                        ]
                    }
                ],
