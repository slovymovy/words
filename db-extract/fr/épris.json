                    },
                    {
                        "translation_id": "c72d25e0-f999-4403-9a5d-b31232c4c916",
                        "source_entry_id": "290d8bc7-1236-37f1-a8a7-4ee0287ad5c1",
                        "source_sense_id": "7ecfb6bd-3d7c-3693-b301-9fa72b826729",
                        "target_lang_word": "verliefd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verliefd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
                                        "entry_id": "5201a039-3b4d-3e0e-afd2-222f4d6a40eb",
                                        "glosses": [
                                            "door sterke amoureuze gevoelens bevangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b74016d-3488-4f4d-b039-898e344dd674",
                                                "sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
                                                "text": "De verliefde jongen moest blozen toen hij het meisje van zijn dromen zag."
                                            },
                                            {
                                                "example_id": "6ebb90b6-f06e-4590-b080-c93599bc7f1b",
                                                "sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
                                                "text": "Niet dat ik daar nou zo op zat te wachten, ik houd helemaal niet van het podium pakken, maar toen het me werd aangeboden was er iets in mijn buik opgefladderd, zoals er dingen in je lijf kriebelen wanneer je verliefd bent, of - wanneer de lente door je dakraam fluit."
                                            },
                                            {
                                                "example_id": "3fd78343-fca1-4553-960b-48f5cf763c84",
                                                "sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
                                                "text": "Rookt sigaretten door een pijpje en is verliefd op een schaker, die zijn gereformeerde achtergrond niet kan verloochenen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verliefd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f5a02acd-075a-3bd6-b088-b156dc15bd42",
                                        "entry_id": "beffc8d0-d73d-3397-8bc7-b9dd4b038a7f",
                                        "glosses": [
                                            "voltooid deelwoord van verlieven"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eeacca3-dbce-4d88-bfda-788dedb77ca9",
                                                "sense_id": "f5a02acd-075a-3bd6-b088-b156dc15bd42",
                                                "text": "Maar Albert was geen vlug type, alles kostte bij hem tijd. En al heel snel was daar Cécile geweest, hij was meteen hartstochtelijk verliefd, de ogen van Cécile, de mond van Cécile, de glimlach van Cécile, en daarna uiteraard de borsten van Cécile, de kont van Cécile, hoe wil je dan aan iets anders denken."
                                            },
                                            {
                                                "example_id": "64569a58-48fb-4dbf-85ca-3b5c3cccd831",
                                                "sense_id": "f5a02acd-075a-3bd6-b088-b156dc15bd42",
                                                "text": "Hij bezwoer dat hij alleen maar verliefd was geraakt en dat dat helemaal losstond van de lengte van zijn verlof, maar dat er nieuwe verlofdagen kwamen, dat hij elke dag naar haar zou verlangen en zo verder. Toen hij eindelijk wegkwam, was hij even opgelucht als altijd."
                                            },
                                            {
                                                "example_id": "b3d5a4a6-b4a7-4541-9078-f7bb93c62083",
                                                "sense_id": "f5a02acd-075a-3bd6-b088-b156dc15bd42",
                                                "text": "Ik vertelde natuurlijk wat er gebeurd was, dat we de laatste tijd niet zoveel hadden geijshockeyd maar vooral meisjestikkertje hadden gespeeld, waarbij het risico op een blessure laag was. En dat ik zojuist meerdere koppen thee had gedronken in het huis van een meisje op wie ik waarschijnlijk verliefd was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
