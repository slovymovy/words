                ],
                "senses": [
                    {
                        "sense_id": "096c86ad-0582-3c5c-8b9c-53f579cc8230",
                        "entry_id": "9e5791c0-fc53-3424-b470-6e77aa381428",
                        "glosses": [
                            "Bakterie, Schizomycet"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "10f5199b-b7a1-450f-a1ad-56f99d0df70b",
                                "sense_id": "096c86ad-0582-3c5c-8b9c-53f579cc8230",
                                "text": "„Die Spaltpilze oder Schizomyceten, zu welchen die Bakterien (…) gehören, sind die kleinsten und niedrigsten Organismen, die man bis jetzt kennt. Sie bestehen ausnahmslos aus einzelnen Zellen.“ (1882)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "706e2b82-da63-3d10-b38b-317f7de88ff5",
                        "entry_id": "9e5791c0-fc53-3424-b470-6e77aa381428",
                        "glosses": [
                            "Exemplar einer Pilzart, die sich durch Spaltung vermehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc237d3-f71e-4cc4-9983-baa8cbf1bfcf",
                                "sense_id": "706e2b82-da63-3d10-b38b-317f7de88ff5",
                                "text": "„Um dies zu untersuchen, haben die Naturforscher die Vermehrung der Spaltpilze beobachtet. Die Pilzchen teilen sich, und zwar immer und immer wieder in zwei Teile.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e1a3ac0f-2683-38c8-93ff-ade5a8926c47",
                        "entry_id": "9e5791c0-fc53-3424-b470-6e77aa381428",
                        "glosses": [
                            "etwas, das einen möglichen Grund für die Spaltung einer Gruppe darstellt"
                        ],
                        "tags": [
                            "figurative",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "d9097914-3bf8-4c77-8bd9-36bf458110e1",
                                "sense_id": "e1a3ac0f-2683-38c8-93ff-ade5a8926c47",
                                "text": "„Der Spaltpilz geht um im blühendsten Teil der katholischen Kirche des indischen Subkontinents.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
