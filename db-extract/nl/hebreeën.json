                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hebräer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "007093e6-9655-3779-89f0-dc883372b144",
                                        "entry_id": "00ba8cf3-eb7b-33bc-8aff-1bed223092c1",
                                        "glosses": [
                                            "Angehöriger der Israeliten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f69061-3ab9-4b89-b879-26ef3d5d3bb3",
                                                "sense_id": "007093e6-9655-3779-89f0-dc883372b144",
                                                "text": "Abraham ist ein Hebräer."
                                            },
                                            {
                                                "example_id": "f03aee45-83e2-4b04-9359-bfa61ad08f61",
                                                "sense_id": "007093e6-9655-3779-89f0-dc883372b144",
                                                "text": "„In einem kleinen Winkel der Welt lebten Menschen, die sich selbst zunächst Hebräer, später nach ihrem Stammvater Israeliten oder Juden nannten und die sich zu einer neuartigen Schöpfungsgeschichte bekannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7dab0049-e75a-37c1-b2ab-b81fa85e64e2",
                                        "entry_id": "00ba8cf3-eb7b-33bc-8aff-1bed223092c1",
                                        "glosses": [
                                            "das Volk des jüdischen Stammvaters Abraham"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f1b5cf2-35c4-4565-959a-98cc1f15ff18",
                                                "sense_id": "7dab0049-e75a-37c1-b2ab-b81fa85e64e2",
                                                "text": "Im Buch Exodus wird der Auszug der Hebräer aus Ägypten beschrieben."
                                            },
                                            {
                                                "example_id": "7f598bcf-f635-4b14-9c97-84c9ce8d6c66",
                                                "sense_id": "7dab0049-e75a-37c1-b2ab-b81fa85e64e2",
                                                "text": "„In einem kleinen Winkel der Welt lebten Menschen, die sich selbst zunächst Hebräer, später nach ihrem Stammvater Israeliten oder Juden nannten und die sich zu einer neuartigen Schöpfungsgeschichte bekannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e9d0bcf8-e34e-3882-9041-b25591386661",
                                        "entry_id": "00ba8cf3-eb7b-33bc-8aff-1bed223092c1",
                                        "glosses": [
                                            "Brief an die Hebräer, einem Kapitel des Neuen Testaments der Bibel"
                                        ],
                                        "tags": [
                                            "no-plural",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7582cb05-407b-4421-9d44-dacf2c9dbc3e",
                                                "sense_id": "e9d0bcf8-e34e-3882-9041-b25591386661",
                                                "text": "Die Kanonizität des Hebräer war lange umstritten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6edb87bc-91e1-4329-b619-8527170911d3",
                        "source_entry_id": "e2579a3f-bb21-388c-b6be-ba7956efc938",
                        "source_sense_id": "f38e5462-6722-3f8f-a4d4-7c4b4a111988",
                        "target_lang_word": "Hebräerbrief",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hebräerbrief",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12fe4a66-ca28-3f2b-9957-1f1a6a6d1e5f",
                                        "entry_id": "ea4b80d2-2011-3e37-bb30-371e7dacd4fa",
                                        "glosses": [
                                            "eine in Briefform abgefasste Schrift des Neuen Testamentes, eine Predigt in Briefform, die sich primär an Judenchristen wendet, was auch den Namen nicht-ursprünglichen Namen „Hebräerbrief“ erhellt"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b8240ae-62fe-49cd-8449-8b0d4c47f3b2",
                                                "sense_id": "12fe4a66-ca28-3f2b-9957-1f1a6a6d1e5f",
                                                "text": "„Der sogenannte Hebräerbrief nennt sich in 13, 22 selbst eine Mahnrede.“"
                                            },
                                            {
                                                "example_id": "5ca485dd-a4fa-44c9-a0ee-3c212bdc5d6b",
                                                "sense_id": "12fe4a66-ca28-3f2b-9957-1f1a6a6d1e5f",
                                                "text": "„Für den Hebräerbrief ist das Mitleid, das Leiden mit den anderen, wesentliches Element unseres Menschseins: das ist die wahre Menschlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
