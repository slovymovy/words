                    }
                ],
                "translations": [
                    {
                        "translation_id": "1990824f-487d-4841-a8d8-d96bb6032b4d",
                        "source_entry_id": "61ce68de-3510-333e-9755-7a206b380534",
                        "source_sense_id": "b577f372-235f-348a-b585-c385fb87ff23",
                        "target_lang_word": "Jewess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jewess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f693b384-a18b-392e-8bbe-5c0b7dd5f840",
                                        "entry_id": "a3a0010c-c1a0-30ad-a8ed-8d6239008426",
                                        "glosses": [
                                            "A female Jew."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f78f1a-dd4d-41f7-9c0a-e2c6b1b6704b",
                                                "sense_id": "f693b384-a18b-392e-8bbe-5c0b7dd5f840",
                                                "text": "And the prominent, if not indeed the principal, part in the system of terrorism applied by the Extraordinary Commissions for Combating Counter-Revolution has been taken by Jews, and in some notable cases by Jewesses."
                                            },
                                            {
                                                "example_id": "6add02a0-21ed-4924-b1e3-45e2690ca7b7",
                                                "sense_id": "f693b384-a18b-392e-8bbe-5c0b7dd5f840",
                                                "text": "To whom did Ivanhoe tip his lance in gallantry today?\nTo a Jewess named Rebecca, daughter of Isaac, the banker of his tribe.\nWhat could he want of the Jews except money for the ransom?"
                                            },
                                            {
                                                "example_id": "8bf0b642-efac-4693-a55f-624c2122577e",
                                                "sense_id": "f693b384-a18b-392e-8bbe-5c0b7dd5f840",
                                                "text": "As for Wahram V (Gur), the Zoroastrian Persians could see him as a legitimate ruler and the Jews would see him as a Jewish king. After all, he was Jewish since his mother was a Jewess."
                                            },
                                            {
                                                "example_id": "910028fa-75b4-4115-a624-36fced926ffe",
                                                "sense_id": "f693b384-a18b-392e-8bbe-5c0b7dd5f840",
                                                "text": "You really are a high-class Jewess, lemme tell ya."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
