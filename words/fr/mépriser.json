                {
                    "sense_id": "11444a27-9948-3225-9792-052f5b16fe71",
                    "sense_definition": "Considérer une personne comme indigne d'estime ou d'attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est injuste de <w>mépriser</w> les autres simplement parce qu'ils ont des opinions différentes."
                        },
                        {
                            "text": "Elle craignait que ses anciens collègues ne finissent par la <w>mépriser</w> après cette erreur."
                        }
                    ],
                    "synonyms": [
