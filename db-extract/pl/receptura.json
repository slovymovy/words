                                    {
                                        "sense_id": "ff15ba77-fe47-3ce6-a655-57406087674a",
                                        "entry_id": "901bef9b-515f-3865-9c0e-03a41e955feb",
                                        "glosses": [
                                            "The act, process, or result of formulating or reducing to a formula.",
                                            "A particular linguistic construction; a turn of phrase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1801469-6d2b-4b3f-893e-0bfdfbe178b1",
                                                "sense_id": "ff15ba77-fe47-3ce6-a655-57406087674a",
                                                "text": "The formulation with the bare infinitive was somewhat less common."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9feff3f-3e53-3b4b-84ea-c958a22c69c1",
                                        "entry_id": "901bef9b-515f-3865-9c0e-03a41e955feb",
                                        "glosses": [
                                            "A medicinal preparation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d95c04-7a9b-4711-a554-b3bbaefeb350",
                                                "sense_id": "d9feff3f-3e53-3b4b-84ea-c958a22c69c1",
                                                "text": "If you liked our old shampoo, you'll love the new kinder, gentler formulation."
                                            }
                                        ]
                                    }
                                ]
