                        "cross_references": [
                            {
                                "target_word": "gymkhana",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7bacaff-ca25-3cee-8a8e-3f34f0d93219",
                                        "entry_id": "3a2a713d-a207-37b6-ae64-8718f85dfe72",
                                        "glosses": [
                                            "Fête de plein air, publique ou privée, organisée dans un parc ou un jardin, qui comprend des épreuves sportives, des jeux d’adresse, des courses d’animaux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e29c023-64ab-344a-9d0e-407d958cdaa7",
                                        "entry_id": "3a2a713d-a207-37b6-ae64-8718f85dfe72",
                                        "glosses": [
                                            "Épreuve réservée à des automobiles, motocyclettes, bicyclettes, etc., qui se déroule sur un parcours hérissé d’obstacles et de difficultés diverses, et dans laquelle l’adresse, la rapidité et le nombre de fautes commises contribuent à l’établissement du classement final."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d0c474-85a1-4962-9ecd-b1311e38ba1a",
                                                "sense_id": "4e29c023-64ab-344a-9d0e-407d958cdaa7",
                                                "text": "— Est-ce que ça vous intéresse beaucoup, Annie, d’apprendre que la tortue de la comtesse Machin vient d’arriver troisième dans un gymkhana ?…"
                                            },
                                            {
                                                "example_id": "f37ec852-17ee-4291-bdfa-9885ceb73ea8",
                                                "sense_id": "4e29c023-64ab-344a-9d0e-407d958cdaa7",
                                                "text": "Un gymkhana automobile a été disputé sur le quai de Bandol devant une foule considérable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6446c177-ac98-3b55-9b45-f15ced1d81a2",
                                        "entry_id": "3a2a713d-a207-37b6-ae64-8718f85dfe72",
                                        "glosses": [
                                            "Épreuve réservée à des automobiles, motocyclettes, bicyclettes, etc., qui se déroule sur un parcours hérissé d’obstacles et de difficultés diverses, et dans laquelle l’adresse, la rapidité et le nombre de fautes commises contribuent à l’établissement du classement final.",
                                            "Acrobatie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9912731c-cc3e-4da8-b7a7-01d161d07936",
                                                "sense_id": "6446c177-ac98-3b55-9b45-f15ced1d81a2",
                                                "text": "Le pilote, qui circulait sans casque, s’amusait à faire du gymkhana avec son engin dans le quartier du Grand Ensemble, grimpant de la route sur le trottoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebc44877-042a-3fd5-9552-4fb766996eff",
                                        "entry_id": "3a2a713d-a207-37b6-ae64-8718f85dfe72",
                                        "glosses": [
                                            "Discipline d’équitation dans laquelle l’agilité et la rapidité du cheval sont mises à l’épreuve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15a82c12-c63b-3695-98d2-8bcfa8c3f5ab",
                                        "entry_id": "3a2a713d-a207-37b6-ae64-8718f85dfe72",
                                        "glosses": [
                                            "Parcours semé d’embûches, de difficultés ou d’obstacles de natures diverses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46b8c272-01ef-4710-803e-905f5dd5bb6e",
                                                "sense_id": "15a82c12-c63b-3695-98d2-8bcfa8c3f5ab",
                                                "text": "Le gymkhana procédural de cette réforme n’est pas moins accidenté. Bon nombre de ces mesures nécessitent une révision de la Constitution, laquelle suppose avant son adoption le vote conforme des deux assemblées, donc l’accord du Sénat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
