                            "festliche Veranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79ae56e-ba07-4732-a628-1bbe7fd963cb",
                                "sense_id": "2e481af7-12c3-3e26-9a97-6308d70ad69b",
                                "text": "Als Festlichkeit würde ich das nicht bezeichnen; hier hat doch niemand Spaß."
                            },
                            {
                                "example_id": "f18b369b-8e7f-4963-b4ad-9da4d8e1c8dc",
                                "sense_id": "2e481af7-12c3-3e26-9a97-6308d70ad69b",
                                "text": "Die Festlichkeiten zu Ehren des 10-jährigen Bestehens der Schule waren ein voller Erfolg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3c047d27-ba5f-3b94-9bd9-fe8e421d6dd7",
                        "entry_id": "1769fc58-1d3b-39f4-ab82-c0bab8d97f52",
                        "glosses": [
                            "festliche Stimmung, Atmosphäre"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "73fa57ca-6097-4225-ba01-bd65e6f07467",
                                "sense_id": "3c047d27-ba5f-3b94-9bd9-fe8e421d6dd7",
                                "text": "Die Festlichkeit der Weihnachtstage wurde die letzten Jahre durch den geringen Schneefall geschmälert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14da085b-585f-4abc-ac23-8fd276d4cfee",
                        "source_entry_id": "1769fc58-1d3b-39f4-ab82-c0bab8d97f52",
                        "source_sense_id": "2e481af7-12c3-3e26-9a97-6308d70ad69b",
                        "source_sense_description": "festliche Veranstaltung",
                        "target_lang_word": "festivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "festivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                                        "entry_id": "1345fbcd-ab69-3b43-87ea-9a1a2d3cf99e",
                                        "glosses": [
                                            "Réjouissance qui se tient pour célébrer une fête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d01ebea7-38e7-449e-a076-36c6973bb868",
                                                "sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                                                "text": "Souvent les familles éprouvent le besoin de marquer néanmoins par des festivités l'existence de leur rejeton, et alors elles organisent ce que l'on appelle ici un baptême civil."
                                            },
                                            {
                                                "example_id": "58b4ff4f-0806-48fa-95e3-ee6a6d900115",
                                                "sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                                                "text": "On festoyait joyeusement en mangeant beaucoup et en buvant encore plus, comme si l'on n'allait plus manger de tout l'hiver. Ces festivités étaient nommées « Martinales », et tournaient aux Bacchanales, si bien que les évêques s'en offusquèrent vite."
                                            },
                                            {
                                                "example_id": "afae34a6-4c30-4825-b295-b67a78e86a5e",
                                                "sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                                                "text": "Pas la moindre festivité non plus, le 14 Juillet, à VIRIAT (Ain). Mais il ne faut pas y voir la moindre malveillance à l'égard de la République. On a l'habitude, ici, de célébrer le 14 Juillet... le 1ᵉʳ dimanche d'août !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
