                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed6b68d0-f209-32fd-a0be-dc02cb911a3d",
                        "entry_id": "469e9a83-4441-3c5d-a66e-cde0fafd4b5f",
                        "glosses": [
                            "op een niet-constructieve, niet-coöperatieve manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97014fe-ae2e-4c88-ac1f-12acb758d5c9",
                                "sense_id": "ed6b68d0-f209-32fd-a0be-dc02cb911a3d",
                                "text": "Wij hebben het conflict kwaadschiks op moeten lossen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecb420da-040b-496d-b977-8f7162663850",
                        "source_entry_id": "469e9a83-4441-3c5d-a66e-cde0fafd4b5f",
                        "source_sense_id": "ed6b68d0-f209-32fd-a0be-dc02cb911a3d",
                        "source_sense_description": "op een niet-constructieve, niet-coöperatieve manier",
                        "target_lang_word": "übel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "übel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45b5cae1-5f11-3d70-b8c5-c14d944560dd",
                                        "entry_id": "1356690a-8c8f-3a05-8b50-8c3716865ecd",
                                        "glosses": [
                                            "schlecht, krank, unwohl (seiend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ab2adf-f6f2-42ab-bc90-35680f037e26",
                                                "sense_id": "45b5cae1-5f11-3d70-b8c5-c14d944560dd",
                                                "text": "„Ist dir übel?“"
                                            },
                                            {
                                                "example_id": "413bd2fc-0ead-43b5-8c5f-1b56be5e16c2",
                                                "sense_id": "45b5cae1-5f11-3d70-b8c5-c14d944560dd",
                                                "text": "Sein übler Weisheitszahn machte ihm schwer zu schaffen und der Zahnarztbesuch war unvermeidlich."
                                            },
                                            {
                                                "example_id": "a5ed79f8-d33e-4c43-9e6a-040e802bb223",
                                                "sense_id": "45b5cae1-5f11-3d70-b8c5-c14d944560dd",
                                                "text": "„Wie ich zwei Akte treulich aushielt und mich rüstete zum dritten, wie du aber ungeduldig auffuhrst und schwurst, dir sei übel und weh, und den armen Leander sitzen ließest mitsamt seinen Speisen und seinem Wein.“"
                                            },
                                            {
                                                "example_id": "4fc2a911-26e1-4f4d-98c2-d8b59eac9cec",
                                                "sense_id": "45b5cae1-5f11-3d70-b8c5-c14d944560dd",
                                                "text": "„»Ach, Gott weiß es«, versetzte sie; »er ist schon um vier mit den Kühen heimgekommen, weil ihm so übel war. - Friedrich - Friedrich, antworte doch, soll ich zum Doktor?«“"
                                            },
                                            {
                                                "example_id": "a266d210-7a5a-48ae-8f7f-cd8d5aa750ee",
                                                "sense_id": "45b5cae1-5f11-3d70-b8c5-c14d944560dd",
                                                "text": "„Wenn es dir übel geht, nimm es für gut nur immer,",
                                                "translation": "Es ist ihm selbst nicht wohl, sonst thät' er dir nicht weh.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73a1ef34-31f5-3181-b6b1-63d23c5ec6d0",
                                        "entry_id": "1356690a-8c8f-3a05-8b50-8c3716865ecd",
                                        "glosses": [
                                            "schlecht, verdorben, faulig, unangenehm"
                                        ],
                                        "tags": [
                                            "Sinneseindruck/Wahrnehmung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8394a4c-737a-4706-ab20-a39218e5ac10",
                                                "sense_id": "73a1ef34-31f5-3181-b6b1-63d23c5ec6d0",
                                                "text": "Das Fleisch riecht aber übel. Es ist bestimmt nicht mehr frisch."
                                            },
                                            {
                                                "example_id": "2cfc954c-e93f-49e3-8eb6-b5e81988ec74",
                                                "sense_id": "73a1ef34-31f5-3181-b6b1-63d23c5ec6d0",
                                                "text": "In dem Klärbecken hatte sich ein übel riechender schwarzer Faulschlamm abgesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f3bdc2c-a03b-310a-a159-3182cf84720e",
                                        "entry_id": "1356690a-8c8f-3a05-8b50-8c3716865ecd",
                                        "glosses": [
                                            "unmoralisch, schlecht, verwerflich, verdorben"
                                        ],
                                        "tags": [
                                            "Moral/Ethik/abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3d9c64d-7c20-465a-9286-1fd8bd770477",
                                                "sense_id": "7f3bdc2c-a03b-310a-a159-3182cf84720e",
                                                "text": "Üble Zustände!"
                                            },
                                            {
                                                "example_id": "bfc3eec5-f675-4c1d-81f1-27efdd5463ca",
                                                "sense_id": "7f3bdc2c-a03b-310a-a159-3182cf84720e",
                                                "text": "„Der Kerl da drüben, ist ein ganz übler Hund. Nimm dich vor ihm in acht!“"
                                            },
                                            {
                                                "example_id": "2e8b4216-9133-4945-b753-56078678706f",
                                                "sense_id": "7f3bdc2c-a03b-310a-a159-3182cf84720e",
                                                "text": "„Judas der Erz-Schelm redet übel vom Tod der Magdalena; ich wollt wünschen, daß ich Magdalenam mit so vielen Lobsprüchen konnte verehren, wie viel Gräsel in den Feldern, wie viel Blättel in den Wäldern, wie viel Sand in dem Meer, wie viel Stern obenher, wie viel Tröpflein in dem Brunnen, wie viel Stäubl unter der Sonnen; ja wie viel Tröpflein Blut in mir, so viel Lob sprich ich dir!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "23aad840-0ac1-39da-a990-403aea38c756",
                                        "entry_id": "1356690a-8c8f-3a05-8b50-8c3716865ecd",
                                        "glosses": [
                                            "unangenehm, unerfreulich"
                                        ],
                                        "tags": [
                                            "situationsbedingt/umgangssprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7902326-12cc-460b-8b58-8b6cb6e00188",
                                                "sense_id": "23aad840-0ac1-39da-a990-403aea38c756",
                                                "text": "In dieser Wirtschaftslage musste er wohl oder übel die Entscheidung für eine Reduzierung des Personals treffen, wenn nicht noch ein Wunder geschehen würde."
                                            },
                                            {
                                                "example_id": "1c4be0eb-6e3c-44fc-98cd-ae77f1729132",
                                                "sense_id": "23aad840-0ac1-39da-a990-403aea38c756",
                                                "text": "Das war die bis dato übelste Situation, in die er jemals geraten war, und, so wie es jetzt aussah, würde es wohl noch viel schlimmer werden."
                                            },
                                            {
                                                "example_id": "715a7c86-8207-4338-a4c0-f93f2c3a945d",
                                                "sense_id": "23aad840-0ac1-39da-a990-403aea38c756",
                                                "text": "„Wie übel ist's auf dieser Welt",
                                                "translation": "Nicht dies noch das erwerben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
