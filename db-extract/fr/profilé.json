                                                "sense_id": "9e192647-116f-39b4-a0bd-0113a4b78efb",
                                                "text": "Acting is, by nature, profession in which one must keep a high profile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f21fd4cf-100f-39c0-8a3e-c975816a76c2",
                                        "entry_id": "c5bfb21f-ab7a-3756-b9e1-c0bca6a86a40",
                                        "glosses": [
