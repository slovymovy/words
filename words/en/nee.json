                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Nee</w> way are we going out in that terrible weather!",
                            "target_lang_translations": {
                                "cs": "V <w>žádném</w> případě v tomhle hrozném počasí nikam nejdeme!"
                            }
                        },
                        {
                            "text": "He shouted <w>nee</w> across the yard when they asked if there was any tea left.",
                            "target_lang_translations": {
                                "cs": "Když se zeptali, jestli ještě zbyl nějaký čaj, zakřičel přes dvůr <w>ne</w>."
