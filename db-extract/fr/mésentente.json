                ],
                "senses": [
                    {
                        "sense_id": "19130143-2cab-342f-91ae-563e434c22eb",
                        "entry_id": "b36a19df-e55d-3b15-b7f4-e82657916e4a",
                        "glosses": [
                            "Mauvaise entente, désaccord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a0913b-1c6c-473a-9210-5574a852a5f7",
                                "sense_id": "19130143-2cab-342f-91ae-563e434c22eb",
                                "text": "Avez-vous remarqué que la mésentente régnait dans le ménage Bodet ?"
                            },
                            {
                                "example_id": "b98ac0c7-40ca-4cb7-aa3c-dc78f7570e4f",
                                "sense_id": "19130143-2cab-342f-91ae-563e434c22eb",
                                "text": "J'ignorais quelle mésentente séparait mon père et ma mère, mais mon enfance en fut empoisonnée."
                            },
                            {
                                "example_id": "985b8f0b-0254-4930-a49e-6570192ff62c",
                                "sense_id": "19130143-2cab-342f-91ae-563e434c22eb",
                                "text": "Au contraire, chez des primates “plus évolués”, tout semble se désorganiser, se défonctionnaliser, devenir relatif à des apprentissages complexes, à des rituels plus ouverts au risque de quiproquo ou de mésentente."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a5d0483-806f-4418-b533-842c5a35e537",
                        "source_entry_id": "b36a19df-e55d-3b15-b7f4-e82657916e4a",
                        "source_sense_id": "19130143-2cab-342f-91ae-563e434c22eb",
                        "target_lang_word": "misunderstanding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misunderstanding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4251e7-53c2-39ad-a70f-d94cbfc8ca5a",
                                        "entry_id": "d6de9194-62a6-3eee-ba80-d2145de2114e",
                                        "glosses": [
                                            "A mistake as to the meaning of something or a specific point of view; erroneous interpretation or comprehension; misconception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f761263-29ff-4594-aa29-daca38fe9519",
                                                "sense_id": "4d4251e7-53c2-39ad-a70f-d94cbfc8ca5a",
                                                "text": "Because of misunderstandings among certain member states of the Organization of African Unity's voices have been occasionally raised recently against the convocation of the Assembly in Accra. Nonetheless, the regular Assembly of the Heads of State and Government was, in the first place, designed to find peaceful solutions, through deliberations and frank exchange of views to such misunderstandings among member-states."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dfd327c-994b-3240-9423-c6d934aae4ec",
                                        "entry_id": "d6de9194-62a6-3eee-ba80-d2145de2114e",
                                        "glosses": [
                                            "A disagreement; difference of opinion; dissension; quarrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b681e3d3-cf87-49d7-9908-9de6716b9051",
                                                "sense_id": "8dfd327c-994b-3240-9423-c6d934aae4ec",
                                                "text": "It was only months and months afterwards, when I made the attempt to recover what was left of the body, that I heard the original quarrel arose from a misunderstanding about some hens."
                                            }
                                        ]
                                    }
                                ]
                            },
