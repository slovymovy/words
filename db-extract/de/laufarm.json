                        "form": "es ist laufarm"
                    },
                    {
                        "form_id": "27671413-dd4f-4824-bfce-a72d6067f004",
                        "entry_id": "b19c5df9-6184-3396-8ab9-55b2dd010a44",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind laufarm"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd3d6506-ed5b-3225-82e6-2b06bd91322d",
                        "entry_id": "b19c5df9-6184-3396-8ab9-55b2dd010a44",
                        "glosses": [
                            "durch keine oder geringe Laufaktivität oder Bewegungsintensität gekennzeichnet"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f9948b5e-e211-411a-9e40-f48ce5e89ff9",
                                "sense_id": "fd3d6506-ed5b-3225-82e6-2b06bd91322d",
                                "text": "„Gerade in der ansonsten laufarmen Jahreszeit ist dieses Event mit dem Sechs- und Zehn-Kilometer- Lauf eine willkommene Abwechslung für die Laufbegeisterten.“"
                            },
                            {
                                "example_id": "9b1de070-0feb-4f6d-bd42-cda068ad1608",
                                "sense_id": "fd3d6506-ed5b-3225-82e6-2b06bd91322d",
                                "text": "„Nach den letzten eher laufarmen Wochen - 103 km im Juni, so wenig wie sonst im November - war der Schneekopflauf schon eine Herausforderung.“"
                            },
                            {
                                "example_id": "060e0fb6-b006-4492-abd9-e3c0c252fad7",
                                "sense_id": "fd3d6506-ed5b-3225-82e6-2b06bd91322d",
                                "text": "„Fünf Einheiten mit beinahe siebzig Kilometern sorgten dafür, dass ich die laufarme Osterurlaubswoche in Cuxhaven wieder aufholen konnte, um auch im April die 200 Kilometer-Marke zu knacken.“"
                            },
                            {
                                "example_id": "952dbc7e-fccf-400a-a76f-1929a4fc525a",
                                "sense_id": "fd3d6506-ed5b-3225-82e6-2b06bd91322d",
                                "text": "„In ebendieser Pause beklagte sich ein Bowiler Spieler bereits darüber, dass er sein Trikot vermutlich ungewaschen wieder im Schrank verstauen könne nach diesem statischen und laufarmen Spiel.“"
                            },
                            {
                                "example_id": "0cb69e1f-3942-4a83-abe5-e56d0096ace5",
                                "sense_id": "fd3d6506-ed5b-3225-82e6-2b06bd91322d",
                                "text": "„Ich hatte zusätzlich einige Zahnbehandlungen durchzustehen und startete sehr sport- und laufarm in das Jahr 2020.“"
                            },
                            {
                                "example_id": "d302a62b-eda2-4c3f-93f6-365b5405ad3a",
                                "sense_id": "fd3d6506-ed5b-3225-82e6-2b06bd91322d",
                                "text": "„Sogar Bohlmann schaffte es trotz laufarmen Spiels bei offener gegnerischer Deckung noch einen Ball im Tor unterzubringen und setzte zusammen mit Philipp Peich auf der anderen Seite den Endstand von 32:29 fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
