                ],
                "senses": [
                    {
                        "sense_id": "489a4f9b-0eb1-3a58-aee0-df95b35d90de",
                        "entry_id": "7b1197ef-730c-37b7-9c43-f7a147c68aa5",
                        "glosses": [
                            "потребовать отдать что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86059148-38c7-472d-ab62-118ca5c98891",
                                "sense_id": "489a4f9b-0eb1-3a58-aee0-df95b35d90de",
                                "text": "Деньги за каюту на «Торпеде» мистер Иеремия востребовать не успел."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1119f93-7d13-3a23-bd0a-122c11408036",
                        "entry_id": "7b1197ef-730c-37b7-9c43-f7a147c68aa5",
                        "glosses": [
                            "устар. распорядиться, потребовать исполнения чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc923803-1404-4551-b9fa-d9485dc3281d",
                                "sense_id": "f1119f93-7d13-3a23-bd0a-122c11408036",
                                "text": "Сохранялось право власти призывать дворян на службу, когда «особливая надобность востребует»."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e80ef99-8f0f-3257-9142-88ed6f340f0b",
                        "entry_id": "7b1197ef-730c-37b7-9c43-f7a147c68aa5",
                        "glosses": [
                            "устар. обязать кого-либо явиться куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c9fa64-debb-4063-a1f6-412fe4d2179c",
                                "sense_id": "2e80ef99-8f0f-3257-9142-88ed6f340f0b",
                                "text": "3 генерала разжалованы, и один из них востребован сюда для личного объяснения с императором — что-то будет!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "910ce23b-6c7e-4c2c-85dc-04032c3f2c7d",
                        "source_entry_id": "7b1197ef-730c-37b7-9c43-f7a147c68aa5",
                        "target_lang_word": "claim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claim",
