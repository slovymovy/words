                                                "example_id": "dc2565e8-da60-4011-a55f-66b5a383204b",
                                                "sense_id": "106ac9cb-f1b4-36bb-a2af-37482f0b898a",
                                                "text": "Der Rogen des Störs wird als Delikatesse gehandelt."
                                            },
                                            {
                                                "example_id": "00b57acc-9218-4ea7-bf7f-4bde62cc29f8",
                                                "sense_id": "106ac9cb-f1b4-36bb-a2af-37482f0b898a",
                                                "text": "„Dann erhielten wir eine große Schüssel mit Lachsrogen und noch eine andere Mahlzeit, deren Hauptbestandteil auch aus Rogen zu bestehen schien, jedoch mit Stachelbeeren und einer Art Sauerampfer vermischt war.“"
                                            },
                                            {
                                                "example_id": "446512e3-3a76-43c4-9008-ce29d9527771",
                                                "sense_id": "106ac9cb-f1b4-36bb-a2af-37482f0b898a",
                                                "text": "„In meiner Kindheit war es Rogen.“"
                                            }
                                        ],
