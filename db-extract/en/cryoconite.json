                        "glosses": [
                            "Dark silt accumulating mainly from airborne volcanic sediment or soot from artificial pollution, or detritus in water of ablation from ice sheets or glaciers. Cryoconite typically appears either as surface discoloration or in cryoconite holes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
