                        "sense_id": "ae23c66b-a970-394d-92c2-08530eaebbfc",
                        "entry_id": "2c166d39-a24a-3ba1-b60e-d235dc8a03e1",
                        "glosses": [
                            "An infarct (an area of ischemic necrosis)."
                        ],
                        "tags": [
