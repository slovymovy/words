                    "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                    "sense_definition": "A radio or television broadcast.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "broadcast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My favourite <w>programme</w> starts at seven o'clock.",
                            "target_lang_translations": {
                                "ru": "Моя любимая <w>передача</w> начинается в семь часов."
                            }
                        },
                        {
                            "text": "Did you watch that wildlife <w>programme</w> on TV last night?",
                            "target_lang_translations": {
                                "ru": "Ты смотрел ту <w>передачу</w> о дикой природе по телевизору вчера вечером?"
                            }
                        }
                    ],
                    "synonyms": [
                        "show",
                        "broadcast"
                    ],
