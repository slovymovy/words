                "senses": [
                    {
                        "sense_id": "c19f44ee-0893-3d16-bd16-da63e9475195",
                        "entry_id": "00ce04e2-73d1-3eab-851f-1c214e819d2a",
                        "glosses": [
                            "Person, die einen Schwimmer für Wettbewerbe oder Ähnliches trainiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "617223a5-8393-46a7-96e9-5c208d6de5b8",
                                "sense_id": "c19f44ee-0893-3d16-bd16-da63e9475195",
                                "text": "Mein Cousin ist Schwimmtrainer."
                            },
                            {
                                "example_id": "71b302cf-a686-4bac-9b10-6bab16e484b6",
                                "sense_id": "c19f44ee-0893-3d16-bd16-da63e9475195",
                                "text": "„Ich musste feststellen, dass ich – wie die meisten Leute – einen verheerenden Kraulstil hatte und ließ mir von einem Schwimmtrainer zeigen, wie es richtig ging.“"
                            },
                            {
                                "example_id": "cb06dddc-4ccb-40f0-850f-709a00c2bcf5",
                                "sense_id": "c19f44ee-0893-3d16-bd16-da63e9475195",
                                "text": "„Man könnte sich einen Schwimmtrainer vorstellen, der vorgibt: ‚Bewege deine Hände so, dass sie so wenig wie möglich Oberfläche bilden; lass sie so leicht wie möglich durch das Wasser gleiten! Minimiere die Kraft, die deine Hände ausüben!‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
