                                "target_senses": [
                                    {
                                        "sense_id": "0a1ee8a5-5256-3466-b514-f54c3a4d7727",
                                        "entry_id": "6fb97e75-72a1-31b4-b641-0fb93fcd9a9b",
                                        "glosses": [
                                            "część bielizny damskiej zakładana pod suknię lub spódnicę"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488afecb-85f2-4ddd-b0b0-0ab001ab763a",
                                                "sense_id": "0a1ee8a5-5256-3466-b514-f54c3a4d7727",
                                                "text": "Ewa nasrożyła się wnet kokieteryjnie, wysunęła pantofle, halkę i niemal całe pończochy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
