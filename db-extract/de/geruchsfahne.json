                "senses": [
                    {
                        "sense_id": "cf05e1ce-e869-3bea-9707-4cbd892c61b3",
                        "entry_id": "a6eb07da-b476-3398-b2e8-1b4a6a51a118",
                        "glosses": [
                            "geruchsbehaftete Wolke oder auch Schwade mit zuordenbarer Geruchsquelle; permanente Abgabe von Geruchsstoff in Strömungsrichtung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a48a4711-dba6-4fff-bd14-82a0911196fa",
                                "sense_id": "cf05e1ce-e869-3bea-9707-4cbd892c61b3",
                                "text": "„Dazu wird im Gelände die Geruchsfahne der Anlage abgegangen: Die Probanden zeichnen im Lee, also der vom Wind abgewandten Seite der Anlage in unterschiedlichen Entfernungen die Häufigkeit ihrer Geruchswahrnehmungen auf.“"
                            },
                            {
                                "example_id": "23ad106b-94ca-43b9-9db3-12223049df82",
                                "sense_id": "cf05e1ce-e869-3bea-9707-4cbd892c61b3",
                                "text": "„Die Geruchsfahne streicht in diesem Fall südlich am Wohngebiet vorbei.“"
                            },
                            {
                                "example_id": "f6c95175-fd97-4eec-bd18-360fea038750",
                                "sense_id": "cf05e1ce-e869-3bea-9707-4cbd892c61b3",
                                "text": "„Die maximale Ausdehnung der Geruchsfahne ist in Windrichtung, also in Lee des zu untersuchenden Emittenten, zu erwarten.“"
                            },
                            {
                                "example_id": "5ec6080e-0769-4eac-ae6b-a4a573aa2b9e",
                                "sense_id": "cf05e1ce-e869-3bea-9707-4cbd892c61b3",
                                "text": "„Dass die Geruchsfahne, wie die Fachleute die Auswirkungen bezeichnen, im Gewerbegebiet insgesamt nicht größer wird, sei darauf zurückzuführen, so Koegst, dass bei Erteilung einer Baugenehmigung für einen Stall Geruchsfilter zur Auflage gemacht würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
