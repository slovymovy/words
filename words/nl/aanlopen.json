{
    "word_family": [
        "aanloop",
        "lopen",
        "loper",
        "doorlopen",
        "meelopen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a44e268-add4-32db-96ce-9f3dbaa02bd8",
                    "sense_definition": "even terloops of informeel bij iemand op bezoek gaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bezoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je vanmiddag thuis bent, <w>loop</w> ik gezellig even bij je <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "If you are home this afternoon, I'll <w>drop by</w> for a bit."
                            }
                        },
                        {
                            "text": "Zij <w>liepen</w> gisteravond onaangekondigd bij hun buren <w>aan</w> voor een kop koffie.",
                            "target_lang_translations": {
                                "en": "They <w>popped in</w> unannounced on their neighbours last night for a cup of coffee."
                            }
                        }
                    ],
                    "synonyms": [
                        "langsgaan",
                        "binnenspringen"
                    ],
                    "common_phrases": [
                        "even aanlopen",
                        "bij iemand aanlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to pay someone a brief, casual or informal visit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drop by",
                                "target_lang_sense_clarification": "informal visit"
                            },
                            {
                                "target_lang_word": "pop in",
                                "target_lang_sense_clarification": "brief visit"
                            },
                            {
                                "target_lang_word": "stop by",
                                "target_lang_sense_clarification": "casual visit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de5fa37b-d49f-345e-a031-1626634fad54",
                    "sense_definition": "in het gezicht een bepaalde kleur krijgen door schaamte, woede of inspanning",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verkleuring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>liep</w> helemaal rood <w>aan</w> toen de leraar hem betrapte op spieken.",
                            "target_lang_translations": {
                                "en": "He <w>turned</w> completely red when the teacher caught him cheating."
                            }
                        },
                        {
                            "text": "Vanwege de zware inspanning <w>liepen</w> de renners vuurrood <w>aan</w> tijdens de finale.",
                            "target_lang_translations": {
                                "en": "Because of the heavy exertion, the riders <w>flushed</w> bright red during the final."
                            }
                        }
                    ],
                    "synonyms": [
                        "blozen"
                    ],
                    "common_phrases": [
                        "rood aanlopen",
                        "blauw aanlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to develop a specific facial color due to shame, anger, or exertion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "become red or flushed"
                            },
                            {
                                "target_lang_word": "flush",
                                "target_lang_sense_clarification": "become red in the face"
                            },
                            {
                                "target_lang_word": "blush",
                                "target_lang_sense_clarification": "redden from embarrassment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "020e4a5b-0488-3bda-8c1d-688aba729d0d",
                    "sense_definition": "te voet naderen of in een bepaalde richting wandelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zag in de verte een onbekende man rustig op ons <w>aanlopen</w>.",
                            "target_lang_translations": {
                                "en": "I saw an unknown man quietly <w>walking towards</w> us in the distance."
                            }
                        },
                        {
                            "text": "We moeten nu echt gaan <w>aanlopen</w>, anders halen we de laatste trein niet.",
                            "target_lang_translations": {
                                "en": "We really need to <w>get moving</w> now, otherwise we won't catch the last train."
                            }
                        }
                    ],
                    "synonyms": [
                        "toelopen",
                        "naderen"
                    ],
                    "common_phrases": [
                        "op iemand aanlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to approach on foot or walk towards a specific direction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "walk towards",
                                "target_lang_sense_clarification": "approach on foot"
                            },
                            {
                                "target_lang_word": "approach",
                                "target_lang_sense_clarification": "come closer on foot"
                            },
                            {
                                "target_lang_word": "head over",
                                "target_lang_sense_clarification": "start walking towards"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b5dea51-b340-353b-8845-61a3041a4e76",
                    "sense_definition": "botsen of fysiek in aanraking komen met iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het donker <w>liep</w> hij pijnlijk tegen de geopende keukendeur <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "In the dark, he painfully <w>bumped into</w> the open kitchen door."
                            }
                        },
                        {
                            "text": "Tijdens het project <w>liepen</w> we helaas tegen onverwachte problemen <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "During the project, we unfortunately <w>ran into</w> unexpected problems."
                            }
                        }
                    ],
                    "synonyms": [
                        "botsen",
                        "stoten"
                    ],
                    "common_phrases": [
                        "ergens tegenaan lopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to collide with something physically or run into obstacles"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run into",
                                "target_lang_sense_clarification": "collide or encounter difficulties"
                            },
                            {
                                "target_lang_word": "bump into",
                                "target_lang_sense_clarification": "physically hit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b074d72e-245f-37d0-a512-885de40613b0",
                    "sense_definition": "ongevraagd of als zwerfdier ergens arriveren en blijven",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aankomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die jonge kat is vorige week zomaar bij ons <w>aan</w> komen <w>lopen</w>.",
                            "target_lang_translations": {
                                "en": "That young cat just <w>turned up</w> as a stray at our place last week."
                            }
                        },
                        {
                            "text": "Er is een verhongerde hond op de boerderij <w>aangelopen</w>.",
                            "target_lang_translations": {
                                "en": "A starving stray dog <w>wandered into</w> the farm."
                            }
                        }
                    ],
                    "synonyms": [
                        "toelopen"
                    ],
                    "common_phrases": [
                        "aan komen lopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to arrive uninvited or as a stray animal and stay"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn up",
                                "target_lang_sense_clarification": "arrive unexpectedly as a stray"
                            },
                            {
                                "target_lang_word": "stray in",
                                "target_lang_sense_clarification": "arrive as a stray"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "767641b5-837d-3655-9880-ff865074ac3b",
                    "sense_definition": "onzuiver of met overmatige wrijving draaien en daardoor haperen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rem van mijn fiets <w>loopt</w> al de hele week zachtjes <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "My bicycle brake has been <w>rubbing</w> slightly all week."
                            }
                        },
                        {
                            "text": "De monteur merkte meteen dat een wiel van de machine erg <w>aanliep</w>.",
                            "target_lang_translations": {
                                "en": "The mechanic immediately noticed that a wheel on the machine was <w>dragging</w> badly."
                            }
                        }
                    ],
                    "synonyms": [
                        "schuren",
                        "slepen"
                    ],
                    "common_phrases": [
                        "het wiel loopt aan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to drag or rub with excessive friction, causing resistance or faltering"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rub",
                                "target_lang_sense_clarification": "cause friction while turning"
                            },
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "catch or create friction"
                            },
                            {
                                "target_lang_word": "catch",
                                "target_lang_sense_clarification": "snag or bind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38cb49fb-5cf7-3d18-80dd-17137058b837",
                    "sense_definition": "varend een haven of kust aandoen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bezoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het grote cruiseschip zal morgenochtend vroeg de haven van Rotterdam <w>aanlopen</w>.",
                            "target_lang_translations": {
                                "en": "The large cruise ship will <w>call at</w> the port of Rotterdam early tomorrow morning."
                            }
                        },
                        {
                            "text": "Vanwege de zware storm kon het vrachtschip de geplande haven niet <w>aanlopen</w>.",
                            "target_lang_translations": {
                                "en": "Because of the severe storm, the cargo ship could not <w>put into</w> the planned port."
                            }
                        }
                    ],
                    "synonyms": [
                        "aandoen"
                    ],
                    "common_phrases": [
                        "een haven aanlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to call at or put into a port or coast by ship"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "call at",
                                "target_lang_sense_clarification": "put into port"
                            },
                            {
                                "target_lang_word": "put into",
                                "target_lang_sense_clarification": "enter a harbour"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc656c8f-dfa7-3683-9a88-9555b833f29b",
                    "sense_definition": "een bepaalde tijd naderen of verstrijken",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was al tegen het einde van de avond <w>aangelopen</w> toen ze vertrokken.",
                            "target_lang_translations": {
                                "en": "It was already <w>getting towards</w> late in the evening when they left."
                            }
                        },
                        {
                            "text": "De tijd begon flink <w>aan</w> te <w>lopen</w> en iedereen werd nerveus.",
                            "target_lang_translations": {
                                "en": "Time was beginning to <w>run short</w> and everyone grew nervous."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstrijken",
                        "naderen"
                    ],
                    "common_phrases": [
                        "tegen de avond aanlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to approach a particular time or draw to a close"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "draw near",
                                "target_lang_sense_clarification": "approach in time"
                            },
                            {
                                "target_lang_word": "get late",
                                "target_lang_sense_clarification": "time running late"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eed6602c-9f93-3248-83dc-32e96fb0ab49",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>aanloop</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meervoud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De atleet probeerde verschillende <w>aanlopen</w> uit voor de hoogste sprong.",
                            "target_lang_translations": {
                                "en": "The athlete tried out different <w>run-ups</w> for the highest jump."
                            }
                        },
                        {
                            "text": "Na diverse mislukte <w>aanlopen</w> slaagde het team er eindelijk in het doel te bereiken.",
                            "target_lang_translations": {
                                "en": "After several failed <w>attempts</w>, the team finally succeeded in reaching the goal."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of the noun 'aanloop' (run-up, start)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run-ups",
                                "target_lang_sense_clarification": "approaches for jumping"
                            },
                            {
                                "target_lang_word": "attempts",
                                "target_lang_sense_clarification": "lead-ins or tries"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}