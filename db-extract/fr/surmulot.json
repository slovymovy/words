        "fr-extract.jsonl": [
            {
                "entry_id": "13f63a39-dd47-3a7c-a77c-503129f4195e",
                "word": "surmulot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "66213242-3203-42b2-8079-3ed02fedea4b",
                        "entry_id": "13f63a39-dd47-3a7c-a77c-503129f4195e",
                        "tags": [
                            "plural"
