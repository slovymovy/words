                        "sense_id": "2ffc4aab-58c2-3663-a814-08eaf9bea0f8",
                        "entry_id": "e11b8f27-786e-3d0d-a656-235b6c4e09c2",
                        "glosses": [
                            "Prunus dulcis een kleine loofboom uit de rozenfamilie met als steenvrucht de amandel"
