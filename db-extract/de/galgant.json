                "translations": [
                    {
                        "translation_id": "f684da50-4200-4e16-af2f-a33bd2ca629c",
                        "source_entry_id": "679bd59c-b11d-3130-b2dd-efcbfb09a7ed",
                        "source_sense_id": "ce2c757d-8287-3775-b390-a872b8f62a40",
