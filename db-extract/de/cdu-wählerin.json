                        "entry_id": "8704e7be-d776-3419-b392-6d00067bffd9",
                        "glosses": [
                            "weibliche Person, die bei einer Wahl für die Christlich Demokratische Union Deutschlands (CDU) gestimmt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72cd196-ce4c-42df-b5ea-b6beb962de65",
                                "sense_id": "6127455e-825f-338a-906f-d2f3cab3f287",
                                "text": "Sie war schon immer eine überzeugte CDU-Wählerin."
                            },
                            {
                                "example_id": "9e68ebd8-611d-46ed-b810-c8603edad2d5",
                                "sense_id": "6127455e-825f-338a-906f-d2f3cab3f287",
                                "text": "„Die 60-jährige Unternehmerin und treue CDU-Wählerin trotzt dem herben Wetter – und plauscht im dicken Mantel vor einem Café in Geras Altstadt mit einer Freundin.“"
                            },
                            {
                                "example_id": "307632f0-4321-4999-a9f9-96a3817716d4",
                                "sense_id": "6127455e-825f-338a-906f-d2f3cab3f287",
                                "text": "„Bis vor wenigen Jahren war sie CDU-Wählerin und geriet erst zu den Grünen, als Daimler-Benz bei ihrer Heimatstadt Boxberg eine Teststrecke mit einem rund elf Kilometer langen Rundkurs plante.“"
                            }
                        ],
