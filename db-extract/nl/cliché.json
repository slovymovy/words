                ],
                "senses": [
                    {
                        "sense_id": "a8f4f0bf-e373-30f1-b121-9d57b7dbcf2a",
                        "entry_id": "0ae152b9-cba2-38c3-9a3f-cb93a1934a53",
                        "glosses": [
                            "beschrijving, uitdrukking of stijlfiguur, die te veel of fout gebruikt is, zodat het aan betekenis verloren heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9042d5bd-47dd-4252-86ff-003ff2cb6d4e",
                                "sense_id": "a8f4f0bf-e373-30f1-b121-9d57b7dbcf2a",
                                "text": "Hoewel ik er vaak was geweest en de klinkende namen van Titiaan en Tintoretto achteloos door soireetjes had laten rollen, hoewel ik geroutineerd in mijn krant bleef lezen terwijl de vuurrode hogesnelheidstrein mij over de landverbinding van Mestre naar de oude stad bracht en veelbetekenend begon af te remmen, en hoewel ik mij had voorgenomen om mijn entree in de stad met een praktische instelling te benaderen en enige eventuele beroering van het gemoed uit te stellen totdat ik goed en wel was geïnstalleerd, moest ik even naar adem happen toen ik het station uit liep en het breekbare, pastelkleurige cliché van de stad aan het groene water zich onbekommerd en schijnbaar onschuldig voor mij ontvouwde."
                            },
                            {
                                "example_id": "8af2cd05-ecc6-4d6d-a4b7-8da604ab54ec",
                                "sense_id": "a8f4f0bf-e373-30f1-b121-9d57b7dbcf2a",
                                "text": "Het is een cliché, maar daarom niet minder waar."
                            },
                            {
                                "example_id": "7eb742e2-c251-4822-80c6-ec19e331923a",
                                "sense_id": "a8f4f0bf-e373-30f1-b121-9d57b7dbcf2a",
                                "text": "Wij weten inmiddels allemaal dat drank meer kapotmaakt dan je lief is, nietwaar? Een cliché, maar wel eentje met een hoog waarheidsgehalte."
                            }
                        ]
                    },
                    {
                        "sense_id": "450d1cf1-f95e-3ef8-a281-32c63c9c7060",
                        "entry_id": "0ae152b9-cba2-38c3-9a3f-cb93a1934a53",
                        "glosses": [
                            "drukvorm die gebruikt wordt bij het drukken van illustraties in hoogdruk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb389323-f68f-4109-8205-e5e18031f591",
                                "sense_id": "450d1cf1-f95e-3ef8-a281-32c63c9c7060",
                                "text": "De harde houten hoogdrukvormen waren veel slijtvaster dan koperplaten en wanneer er clichés van gegoten werden, wat vooral na 1830 gebruikelijk werd (we komen op deze techniek verderop terug), waren haast onbeperkte oplagen mogelijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e6abbcb-b916-41b6-9afd-802f47f63fa3",
                        "source_entry_id": "0ae152b9-cba2-38c3-9a3f-cb93a1934a53",
                        "source_sense_id": "a8f4f0bf-e373-30f1-b121-9d57b7dbcf2a",
                        "source_sense_description": "te veel gebruikte uitdrukking",
                        "target_lang_word": "Klischee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klischee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d84bf9f6-31c5-3723-b77e-f4e41184d9c9",
                                        "entry_id": "a9c3d74e-9362-37dd-ae1f-6d0f0aefbe3e",
                                        "glosses": [
                                            "„Druckstock aus Metall oder Kunststoff für die Bildwiedergabe im Buchdruck“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f4800b-4685-40ac-bf2a-894562171924",
                                                "sense_id": "d84bf9f6-31c5-3723-b77e-f4e41184d9c9",
                                                "text": "„Klischees werden benutzt um Verpackungsmaterialien wie Faltschachteln und Deckfolien von Tablettenblistern zu bedrucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f4f7953-6f7a-3ad8-9b70-475d89b388ed",
                                        "entry_id": "a9c3d74e-9362-37dd-ae1f-6d0f0aefbe3e",
                                        "glosses": [
                                            "Abklatsch, Imitat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec55b9f-94a8-4009-a830-ea0a6b37b41e",
                                                "sense_id": "3f4f7953-6f7a-3ad8-9b70-475d89b388ed",
                                                "text": "„Das erste Buch von Michael Düblin ist allerdings alles andere als Klischee, Abklatsch oder Aufguss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c739f9ad-5b29-3968-92af-1565e76c44f8",
                                        "entry_id": "a9c3d74e-9362-37dd-ae1f-6d0f0aefbe3e",
                                        "glosses": [
                                            "eingefahrene Vorstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd59dc42-16fc-486d-895e-1c7bdbb440fc",
                                                "sense_id": "c739f9ad-5b29-3968-92af-1565e76c44f8",
                                                "text": "„Aber erst die Gegenwart hat eine solche Fülle von Modewörtern bereitgestellt, daß man Abhandlungen in Klischees schreiben kann."
                                            },
                                            {
                                                "example_id": "64e21917-c81d-436c-bf40-c6db44b74044",
                                                "sense_id": "c739f9ad-5b29-3968-92af-1565e76c44f8",
                                                "text": "„In jedem Klischee, heißt es, liegt ein Körnchen Wahrheit.“"
                                            },
                                            {
                                                "example_id": "22f6144f-0203-4ec9-8e73-f41779337c3a",
                                                "sense_id": "c739f9ad-5b29-3968-92af-1565e76c44f8",
                                                "text": "„Auch Politiker haben die Vorteile des Klischees des ausländerfeindlichen Deutschen entdeckt.“"
                                            },
                                            {
                                                "example_id": "c23570cd-365c-4e06-81ac-fc94f8ef05ce",
                                                "sense_id": "c739f9ad-5b29-3968-92af-1565e76c44f8",
                                                "text": "„Wer sich mit nationalen Charaktereigenschaften beschäftigt, rührt an Stereotypen und Klischees.“"
                                            },
                                            {
                                                "example_id": "e261ae08-da45-45d2-82eb-559417f6172a",
                                                "sense_id": "c739f9ad-5b29-3968-92af-1565e76c44f8",
                                                "text": "In der Bevölkerung hält sich [über Kindergärtnerinnen] hartnäckig das Klischee von der \"Basteltante\", die mit den Kleinkindern spielt und eben auch bastelt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cae9059-f1ff-402e-8597-21ea82be2053",
                        "source_entry_id": "0ae152b9-cba2-38c3-9a3f-cb93a1934a53",
                        "source_sense_id": "a8f4f0bf-e373-30f1-b121-9d57b7dbcf2a",
