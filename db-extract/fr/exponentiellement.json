        "fr-extract.jsonl": [
            {
                "entry_id": "79e3e626-b21e-39e1-917e-e221144461e4",
                "word": "exponentiellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "346955aa-ace2-351d-86fb-3eed26b9fc4e",
                        "entry_id": "79e3e626-b21e-39e1-917e-e221144461e4",
                        "glosses": [
                            "D'une manière exponentielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8973d97-3acd-49b9-88c9-5b8fa3698c2d",
                                "sense_id": "346955aa-ace2-351d-86fb-3eed26b9fc4e",
                                "text": "Nous vivions à cinq dans la même grande chambre d’une pension douteuse, il nous restait juste de quoi payer les billets de train et la crainte des vols avait crû exponentiellement, superstitieusement, jusqu’à se changer en terreur."
                            },
                            {
                                "example_id": "b9ad9653-7c76-4423-89a5-406557f55a1a",
                                "sense_id": "346955aa-ace2-351d-86fb-3eed26b9fc4e",
                                "text": "Le logarithme discret est considéré comme un problème difficile, soluble en un temps qui varie exponentiellement avec la taille du problème (c'est-à-dire la taille des nombres impliqués)."
                            },
                            {
                                "example_id": "b8d3687c-fa48-4aeb-91d0-89e56afcc6a4",
                                "sense_id": "346955aa-ace2-351d-86fb-3eed26b9fc4e",
                                "text": "L’Irlande a annoncé durcir pour au moins un mois le confinement partiel instauré la semaine dernière, face au taux d’infection qui augmente « exponentiellement », selon le premier ministre, Micheal Martin."
                            },
                            {
                                "example_id": "354c1a12-4241-48f0-8546-5467d4ae94fa",
                                "sense_id": "346955aa-ace2-351d-86fb-3eed26b9fc4e",
                                "text": "« On se rend compte que [les algorithmes] apprennent exponentiellement plus lentement que les enfants », détaille Marvin Lavechin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "809468ea-f3d7-4852-90d9-cc64e5840a9a",
                        "source_entry_id": "79e3e626-b21e-39e1-917e-e221144461e4",
                        "source_sense_id": "346955aa-ace2-351d-86fb-3eed26b9fc4e",
                        "target_lang_word": "exponentially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exponentially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94a9e56c-33e4-3274-b94a-d336fe6a8997",
                                        "entry_id": "89250f2b-716b-3843-ac3c-155db90fc90b",
                                        "glosses": [
                                            "In an exponential manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7180be6-4e4c-4c94-b166-16ab6786c18e",
                                                "sense_id": "94a9e56c-33e4-3274-b94a-d336fe6a8997",
                                                "text": "But every known algorithm for this problem requires a number of steps that increases exponentially as n increases."
                                            },
                                            {
                                                "example_id": "e270b13c-380e-4c8e-993b-e9d23e12f991",
                                                "sense_id": "94a9e56c-33e4-3274-b94a-d336fe6a8997",
                                                "text": "Therefore, if absorption causes an attenuation of the oscillation amplitude, the temperature must decrease exponentially with increasing thickness."
                                            },
                                            {
                                                "example_id": "f1d011f6-21b7-48c6-be7e-5b7ee835f460",
                                                "sense_id": "94a9e56c-33e4-3274-b94a-d336fe6a8997",
                                                "text": "It can be readily derived from Eqs. 6.26 and 6.32 that the field generated by these incident evanescent waves inside the slab do ^([sic]) not decay away exponentially from the upper interface, but increases exponentially as y decreases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de1f4cc-db4d-32c5-b753-c7336138d3ad",
                                        "entry_id": "89250f2b-716b-3843-ac3c-155db90fc90b",
                                        "glosses": [
                                            "rapidly, greatly"
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb366db-e19b-4fec-8345-2992bfe1997a",
                                                "sense_id": "6de1f4cc-db4d-32c5-b753-c7336138d3ad",
                                                "text": "The more serious a Christian is about God's kingdom, the more exponentially complicating that venture is […]"
                                            },
                                            {
                                                "example_id": "e8f9b2ed-ac7e-441d-9085-695f96905abc",
                                                "sense_id": "6de1f4cc-db4d-32c5-b753-c7336138d3ad",
                                                "text": "He'd felt like Kathryn's soul was in her eyes as she'd regarded him for those precious few seconds... and her spirit was even more exponentially beautiful than […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59036af6-3006-494f-993c-0738a3231797",
                        "source_entry_id": "79e3e626-b21e-39e1-917e-e221144461e4",
