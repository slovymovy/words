                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fb9b9c57-1954-4219-97ea-4cd08d278b07",
                        "entry_id": "47b0cc55-0071-3938-9960-aa7d6d2137e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "putassiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26b62672-d862-30d9-ac5a-2edd036912cb",
                        "entry_id": "47b0cc55-0071-3938-9960-aa7d6d2137e7",
                        "glosses": [
                            "Celui qui est adonné aux prostituées."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "0d9d343b-c70d-4670-b827-a74513278c1a",
                                "sense_id": "26b62672-d862-30d9-ac5a-2edd036912cb",
                                "text": "C’est un grand putassier."
                            },
                            {
                                "example_id": "db678bb3-cd8d-4e68-a215-1b6b59bb7702",
                                "sense_id": "26b62672-d862-30d9-ac5a-2edd036912cb",
                                "text": "Putassier s. m. Homme qui aime & cherche les putains, qui fréquente les mauvais lieux"
                            },
                            {
                                "example_id": "75e85aa6-0799-4282-9a3b-f00c96e739cf",
                                "sense_id": "26b62672-d862-30d9-ac5a-2edd036912cb",
                                "text": "Je te l’avais dit que ton fils était un putassier, il est comme ton père, toujours avec ses putes, tu lui as laissé, il a pris exemple !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c9ff687-f877-4c4e-8cf5-30bf419ba6ce",
                        "source_entry_id": "47b0cc55-0071-3938-9960-aa7d6d2137e7",
                        "source_sense_id": "26b62672-d862-30d9-ac5a-2edd036912cb",
                        "target_lang_word": "Hurenbock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hurenbock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0295fa2-e93f-3a06-b71b-61186b8862af",
                                        "entry_id": "81ba0f06-8c3a-389f-919c-ba5aac9d74a1",
                                        "glosses": [
                                            "abwertend: Mann, der ein ausschweifendes sexuelles Leben führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84c6c440-27dd-4a2f-ba11-15519f58e661",
                                                "sense_id": "f0295fa2-e93f-3a06-b71b-61186b8862af",
                                                "text": "„Unterdessen sahen die drei Hurenböcke aus einer Nebenstraße ein verschleiertes junges Weib hervortreten, das sich gar anmutig gab und deren Gestalt zarteste Jugend verriet.“"
                                            },
                                            {
                                                "example_id": "ba205ff1-5522-4768-94a3-acf66838b7c9",
                                                "sense_id": "f0295fa2-e93f-3a06-b71b-61186b8862af",
                                                "text": "„Der Alte sagte, Rikard hätte im Alter von zwei Jahren seine Mutter verloren, und sein Vater wäre ein Hurenbock aus Skáli gewesen, der sein Kind nie anerkannt hatte.“"
                                            },
                                            {
                                                "example_id": "3398a8b8-1ebf-4119-8ddd-87ec3d6c0724",
                                                "sense_id": "f0295fa2-e93f-3a06-b71b-61186b8862af",
                                                "text": "„Schließlich kann man einer erregten Mutter einiges zubilligen und verzeihen, aber Karl wußte genau, daß ich kein Hurenbock war.“"
                                            },
                                            {
                                                "example_id": "bcf1ceee-a01c-442f-940f-cf7a8ad9fcc8",
                                                "sense_id": "f0295fa2-e93f-3a06-b71b-61186b8862af",
                                                "text": "„Sie hat mit dem Kerl geschlafen, ihn nach Hause geschickt und ist jetzt gekommen, um mich zu überraschen und um Kate Hegström, die sie hier glaubte, zu zeigen, daß ich ein verfluchter Hurenbock bin, bei dem die Frauen nachts aus und ein gehen und dem man ausweichen muß, dachte er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abf33ff9-b38d-453e-a0ec-9d36d90d2d92",
                        "source_entry_id": "47b0cc55-0071-3938-9960-aa7d6d2137e7",
