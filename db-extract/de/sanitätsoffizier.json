                "senses": [
                    {
                        "sense_id": "35056651-2d46-3acd-9a8c-55b8e26e9523",
                        "entry_id": "75959487-c0d1-32d4-9c4a-86f2aa4fa92b",
                        "glosses": [
                            "Offizier der Sanitätstruppe in der Bundeswehr Teil der Streitkräftebasis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f356fc6-ac24-4560-9194-70f85a04b38b",
                                "sense_id": "35056651-2d46-3acd-9a8c-55b8e26e9523",
                                "text": "Im April entschloss ich mich, Sanitätsoffizier zu werden."
                            },
                            {
                                "example_id": "e0f1ccfc-3358-437b-806c-67c8ed64de27",
                                "sense_id": "35056651-2d46-3acd-9a8c-55b8e26e9523",
                                "text": "„Nach Kriegsende druckte das »Berliner Tageblatt« einen offenen Brief Wegners an den US-Präsidenten Wilson, in dem der ehemalige Sanitätsoffizier ein Eingreifen zugunsten der Armenier verlangte.“"
                            }
                        ],
