                ],
                "senses": [
                    {
                        "sense_id": "14cd2b33-8d9c-3ff3-808e-f66d83e96e98",
                        "entry_id": "4832d912-153f-33db-85d5-f8220995e521",
                        "glosses": [
                            "микробиологический состав, вызывающий брожение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dbf26bf-c004-41c4-8982-f74dedcecc92",
                                "sense_id": "14cd2b33-8d9c-3ff3-808e-f66d83e96e98",
                                "text": "Созданы сорта изделий с применением новых отечественных улучшителей, симбиотических заквасок из пшеничной и ржаной муки, а также хлебобулочных изделий для профилактического и геродиетического питания."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7390bfe3-135c-4527-96ba-57f4bf368d15",
                        "source_entry_id": "4832d912-153f-33db-85d5-f8220995e521",
                        "source_sense_id": "14cd2b33-8d9c-3ff3-808e-f66d83e96e98",
                        "target_lang_word": "levain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "levain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df69582a-6685-37a6-819b-5be2934843d3",
                                        "entry_id": "90e1eb41-42b5-3857-b4ef-5f33bd8dd228",
                                        "glosses": [
                                            "Morceau de pâte aigrie qui, mêlée à la pâte dont on veut faire du pain, sert à la faire lever, à la faire fermenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696bfa76-4006-4cd4-95d1-4e8146c72659",
                                                "sense_id": "df69582a-6685-37a6-819b-5be2934843d3",
                                                "text": "Dans un coffre en bois de chêne, appelé pétrin, on introduit la quantité de farine que l’on veut convertir en pain, en l’écartant sur les bords, puis on délaye au milieu le levain avec de l’eau chaude et une partie de la farine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18e9d34b-11e6-3078-acd4-16479317ec6b",
                                        "entry_id": "90e1eb41-42b5-3857-b4ef-5f33bd8dd228",
                                        "glosses": [
                                            "Substance capable de produire une fermentation interne dans le corps avec lequel on l’a mêlé et d’y exciter un gonflement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac9c9dbd-ed67-41ab-b0b5-2e3998b2caa6",
                                                "sense_id": "18e9d34b-11e6-3078-acd4-16479317ec6b",
                                                "text": "Levain de bière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                        "entry_id": "90e1eb41-42b5-3857-b4ef-5f33bd8dd228",
                                        "glosses": [
                                            "Germes de certaines passions violentes."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90597481-a794-4b0f-869b-51853704258d",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Il avait dans le cœur un vieux levain de haine."
                                            },
                                            {
                                                "example_id": "c4c8047a-a083-4b0a-ae35-7fbc8d9d9806",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Leur haine n’est pas si bien apaisée qu’il n’en reste quelque levain."
                                            },
                                            {
                                                "example_id": "90c65559-cb25-4513-bc16-9e0c28a0025b",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Il y a chez ce peuple un levain de sédition."
                                            },
                                            {
                                                "example_id": "945e42aa-5191-4661-83d7-71c8317f4219",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Un levain de discorde, de révolte, d’inimitié, de division."
                                            },
                                            {
                                                "example_id": "b4eca63f-670a-4138-8dc2-323f9a7d9a5a",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Se défaire du vieux levain du péché."
                                            },
                                            {
                                                "example_id": "9196063a-a933-461f-b1ba-aa6ccb580de7",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Nourrir le levain de la vengance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb9573a1-9279-4e03-a877-e6b07b6493cf",
                        "source_entry_id": "4832d912-153f-33db-85d5-f8220995e521",
                        "source_sense_id": "14cd2b33-8d9c-3ff3-808e-f66d83e96e98",
                        "target_lang_word": "ferment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93afcacd-0760-38cf-a278-a0691858be32",
                                        "entry_id": "16cd29c9-38b7-3702-a879-bf79f63c8210",
                                        "glosses": [
                                            "Ensemble d’êtres microscopiques vivant et se développant aux dépens de certaines matières organiques dont ils provoquent la destruction moléculaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d911c07-3c06-4bf4-a316-bac15e6088bb",
                                                "sense_id": "93afcacd-0760-38cf-a278-a0691858be32",
                                                "text": "Les disaccharides sont invertis par les ferments invertissants, les monoses résultants subissent alors la fermentation alcoolique."
                                            },
                                            {
                                                "example_id": "a36555ce-111d-4e35-ad85-cd1bec397ab0",
                                                "sense_id": "93afcacd-0760-38cf-a278-a0691858be32",
                                                "text": "Les produits de sécrétion des ferments figurés sont eux-mêmes susceptibles de provoquer la fermentation, mais, contrairement aux ferments figurés, ce sont des substances chimiques (diastase, zymase, etc.)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7e11ec3-efe6-398a-929d-c226e1eb091b",
                                        "entry_id": "16cd29c9-38b7-3702-a879-bf79f63c8210",
                                        "glosses": [
                                            "Enzyme."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27eeea64-964c-4f4f-b565-a9f7c01e18e2",
                                                "sense_id": "b7e11ec3-efe6-398a-929d-c226e1eb091b",
                                                "text": "Les albumoses résultent de l’action des ferments digestifs sur les albumines vraies. Elles sont solubles dans l’eau, […], elles ne coagulent pas par la chaleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e292168-4487-32c2-8529-74e778b6dd4a",
                                        "entry_id": "16cd29c9-38b7-3702-a879-bf79f63c8210",
                                        "glosses": [
                                            "Ce qui fait naître ou entretient un sentiment ou un état."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba60f919-528e-4360-b08e-ec2e3255a492",
                                                "sense_id": "8e292168-4487-32c2-8529-74e778b6dd4a",
                                                "text": "À la regarder il lui venait des comparaisons qu’il n’osait formuler tant il redoutait qu’elles ne parussent exagérées et niaises. Pour cela et pour d’autres ferments d’enthousiasme qui le travaillaient, il devait se contraindre, par peur du ridicule, à une surveillance pénible sur lui-même."
                                            },
                                            {
                                                "example_id": "7e5abbe7-27c2-46dc-8683-e0c9103f0bba",
                                                "sense_id": "8e292168-4487-32c2-8529-74e778b6dd4a",
                                                "text": "Cependant le ferment qui a produit l’insurrection dans le Nord existe également dans le Sud : l’exaspération créée par la rapacité des Glaoua qui règnent aujourd'hui en maîtres incontestés sur le Maroc méridional."
                                            },
                                            {
                                                "example_id": "3e212c01-9672-460c-b4bb-de13b8f689be",
                                                "sense_id": "8e292168-4487-32c2-8529-74e778b6dd4a",
                                                "text": "Pour chaque être humain qui croise ta route, tu peux être un ferment de liberté."
                                            },
                                            {
                                                "example_id": "930e325b-3493-4739-a683-cc590f21b776",
                                                "sense_id": "8e292168-4487-32c2-8529-74e778b6dd4a",
                                                "text": "Le sang des martyrs était le ferment de l'Évangile."
                                            },
                                            {
                                                "example_id": "0ce92793-1bf7-47a7-b791-82e68d1023fe",
                                                "sense_id": "8e292168-4487-32c2-8529-74e778b6dd4a",
                                                "text": "Nous avons vu les mêmes semer dans nos démocraties, par les armes de la propagande, des ingérences et du mensonge, le ferment de la division et de la haine, espérant, ce faisant, affaiblir notre souveraineté et nos libertés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ferment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
