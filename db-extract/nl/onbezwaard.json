                "senses": [
                    {
                        "sense_id": "684dd242-836c-3f9c-92ac-dcc42b33314e",
                        "entry_id": "b833fb31-287a-3efe-b517-5453373d367c",
                        "glosses": [
                            "van bezittingen: zonder schulden, lasten of hypotheken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc40005-a2c3-4d42-aa20-a76067058e94",
                                "sense_id": "684dd242-836c-3f9c-92ac-dcc42b33314e",
                                "text": "Uw onbezwaarde huis, mits het uw hoofdwoning is, blijft in box 1 en daar geldt niet de 1,2 procent vermogensrendementsheffing van box 3. De vermogensbelasting bestaat sinds 1 januari 2001 niet meer. Door de aflossing, mits uw huis niet op erfpachtgrond staat, hoeft u vanaf 1 januari 2005 het eigenwoningforfait niet meer (of voor een deel) bij uw inkomen te tellen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8dcd283-582e-31a2-b6f9-e2520ec85dc0",
                        "entry_id": "b833fb31-287a-3efe-b517-5453373d367c",
                        "glosses": [
                            "vrij van zorgen en schuldgevoelens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d50a0fd7-5c7f-4c67-8867-b78e35cb5c08",
                                "sense_id": "a8dcd283-582e-31a2-b6f9-e2520ec85dc0",
                                "text": "Ah, het genot van de jacht. Sluipen, sporen zoeken, uren op de loer liggen aan de rand van het bos. En dan, wanneer de prooi niets­vermoedend in beeld komt: een shot gelukshormoon, een snelle foto. Jagen zonder schieten is het nieuwe fietsen zonder handen: zelden voelt een mens zich zo onbezwaard."
                            }
                        ]
                    }
                ],
