                                    {
                                        "sense_id": "b505495b-0424-3a01-aa35-ae52d42fa284",
                                        "entry_id": "9df8c9a3-bf58-3d64-969c-932fd079e81c",
                                        "glosses": [
                                            "\\\"dottore\\\" erudito nella legge ebraica"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0a4a1cf-4980-4139-9029-3d7e2dad0b49",
                                                "sense_id": "b505495b-0424-3a01-aa35-ae52d42fa284",
                                                "text": "nel 1500 circa, dopo la cacciata dalla Spagna, alcuni ebrei cercarono di re-istituire una piccola assemblea di rabbini sapienti proprio presso Safed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f493ec-6a60-3400-a665-bfea58455766",
                                        "entry_id": "9df8c9a3-bf58-3d64-969c-932fd079e81c",
                                        "glosses": [
                                            "ministro del culto ebraico, solitamente anche con il ruolo di rappresentanza di una o più comunità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c28826c-97fb-45cd-a391-7ee4586993c1",
                                                "sense_id": "f6f493ec-6a60-3400-a665-bfea58455766",
                                                "text": "un rabbino italiano può arrivare ad un salario di oltre 3.000,00 EURO mensili"
                                            },
                                            {
                                                "example_id": "5245f4b9-c52c-483e-9b2d-c55b83e00589",
                                                "sense_id": "f6f493ec-6a60-3400-a665-bfea58455766",
                                                "text": "nel dopoguerra Elio Toaff è stato il rabbino più famoso d'Italia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "355af89c-9282-38c8-bd76-7b280e286722",
                                        "entry_id": "9df8c9a3-bf58-3d64-969c-932fd079e81c",
                                        "glosses": [
                                            "rabbino capo: in Italia è il riferimento per tutte le comunità ebraiche e per gli altri rabbini ivi residenti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a1203a-38f8-47fc-9ed5-d99826c60d4b",
                                                "sense_id": "355af89c-9282-38c8-bd76-7b280e286722",
                                                "text": "cittadino in Roma, Riccardo Di Segni è il rabbino capo italiano"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0507cdd2-4636-3d6a-b616-10928d61d49d",
                                        "entry_id": "9df8c9a3-bf58-3d64-969c-932fd079e81c",
                                        "glosses": [
                                            "rabbino Maskil: grado precedente a quello di rabbino con Semikhah rabbinica, in Italia anche \\\"laurea rabbinica\\\", è infatti un livello meno importante ma con simili funzioni liturgiche e di insegnamento della Bibbia ebraica; non ha però ruoli di rappresentanza pubblica in modo costante né può esercitare il compimento di alcune \\\"pratiche strettamente legali religiose\\"
                                        ],
                                        "tags": [],
                                        "examples": []
