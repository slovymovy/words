                "senses": [
                    {
                        "sense_id": "3a52b7de-389b-33a8-8011-72644d0c6a61",
                        "entry_id": "7c01c629-36a5-3c73-a836-d51de5c61717",
                        "glosses": [
                            "Forderung, bei der man eine bestimmte Summe zu zahlen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a848338f-1bc4-4275-a80f-a3cff7681c4e",
                                "sense_id": "3a52b7de-389b-33a8-8011-72644d0c6a61",
                                "text": "„Die Verbraucherzentrale NRW hat eine einstweilige Verfügung erwirkt, weil die Nutzer nicht hinreichend über die Zahlungspflicht aufgeklärt worden seien.“"
                            },
                            {
                                "example_id": "624755e7-f7a6-48c5-b1ea-4ee0386bab21",
                                "sense_id": "3a52b7de-389b-33a8-8011-72644d0c6a61",
                                "text": "„Immer wieder gibt es Versuche, sich der Zahlungspflicht zu entziehen.“"
                            },
                            {
                                "example_id": "fc9dbc8f-7b76-4d2f-a0de-cab4b2b2a2d9",
                                "sense_id": "3a52b7de-389b-33a8-8011-72644d0c6a61",
                                "text": "„Für Betriebe, Firmen, Schulen und Verwaltungen sieht das Urheberrechtsgesetz dagegen ganz unterschiedliche Tarife mit Zahlungspflicht ab einer gewissen Anzahl Mitarbeiter vor.“"
                            },
                            {
                                "example_id": "6cb87244-1f8d-4ea3-9b23-9952bfae7f87",
                                "sense_id": "3a52b7de-389b-33a8-8011-72644d0c6a61",
                                "text": "„Durch die Klage beim Verwaltungsgericht wird die Zahlungspflicht zunächst ausgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
