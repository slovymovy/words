                ],
                "senses": [
                    {
                        "sense_id": "b4a9257f-3719-3eb6-899f-cb041f193bf8",
                        "entry_id": "7a8f40ed-4fe6-303d-a94d-67031812683b",
                        "glosses": [
                            "Einbeziehung von etwas in etwas anderes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "005ddb0f-13a9-470c-b17f-9d8798b39fdd",
                                "sense_id": "b4a9257f-3719-3eb6-899f-cb041f193bf8",
                                "text": "„Die Implikation ist eindeutig: In über zehn Jahren Champions League hat noch nie ein Trainer die Analyse nach dem Match verweigert, wenn es jetzt soweit kommt, muss etwas Dramatisches vorgefallen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cb8e93ab-ddcd-37b3-8f43-b7579d717f9b",
                        "entry_id": "7a8f40ed-4fe6-303d-a94d-67031812683b",
                        "glosses": [
                            "Verbindung von zwei Aussagen bzw. Aussageformen durch „wenn – dann“"
                        ],
                        "tags": [
                            "Logik"
                        ],
                        "examples": [
                            {
                                "example_id": "f49c83bd-80bb-44eb-9494-6bf9574c79f7",
                                "sense_id": "cb8e93ab-ddcd-37b3-8f43-b7579d717f9b",
                                "text": "„Es seien A₁ und A₂ zwei Aussagen. Die Implikation von A₁ und A₂ ist falsch genau dann, wenn A₁ wahr und A₂ falsch ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef746cd2-d385-4dea-a90e-10082d8c850b",
                        "source_entry_id": "7a8f40ed-4fe6-303d-a94d-67031812683b",
                        "source_sense_id": "b4a9257f-3719-3eb6-899f-cb041f193bf8",
                        "source_sense_description": "Einbeziehung von etwas in etwas anderes",
                        "target_lang_word": "implication",
