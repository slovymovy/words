                    "examples": [
                        {
                            "text": "Czy pójdziesz ze mną do kina? – <w>Jasne</w>, z przyjemnością.",
                            "target_lang_translations": {
                                "ru": "Ты пойдешь со мной в кино? – <w>Конечно</w>, с удовольствием.",
                                "en": "Will you go to the cinema with me? – <w>Sure</w>, with pleasure.",
                                "nl": "Ga je met me mee naar de bioscoop? – <w>Natuurlijk</w>, met plezier.",
                                "de": "Gehst du mit mir ins Kino? – <w>Klar</w>, sehr gerne.",
                                "fr": "Tu viens au cinéma avec moi ? – <w>Bien sûr</w>, avec plaisir.",
                                "it": "Verrai al cinema con me? – <w>Certo</w>, con piacere.",
                                "cs": "Půjdeš se mnou do kina? – <w>Jasně</w>, s radostí.",
                                "tr": "Benimle sinemaya gelir misin? – <w>Elbette</w>, memnuniyetle.",
                                "es": "¿Vendrás conmigo al cine? – <w>Claro</w>, con gusto.",
                                "zh": "你愿意跟我一起去看电影吗？——<w>当然</w>，我很乐意。"
                            }
                        },
                        {
                            "text": "No <w>jasne</w>, że ci pomogę w tej sprawie.",
                            "target_lang_translations": {
                                "ru": "Ну <w>конечно</w>, я помогу тебе в этом деле.",
                                "en": "<w>Of course</w> I'll help you with that matter.",
                                "nl": "Natuurlijk <w>natuurlijk</w> dat ik je help met deze zaak.",
                                "de": "Na <w>klar</w>, dass ich dir bei der Sache helfe.",
                                "fr": "Mais <w>bien sûr</w> que je t'aiderai pour cette affaire.",
                                "it": "Ma <w>certo</w> che ti aiuterò in questa faccenda.",
                                "cs": "No <w>jasně</w>, že ti v té věci pomůžu.",
                                "tr": "Bu konuda sana yardım edeceğim <w>tabii ki</w>.",
                                "es": "<w>Claro</w> que te ayudaré con este asunto.",
                                "zh": "那<w>当然</w>，我会在这件事上帮你的。"
                            }
