                                "target_senses": [
                                    {
                                        "sense_id": "83c70e93-7ebc-3829-8706-bf3bf16eaae6",
                                        "entry_id": "e8d4dff9-7256-3549-8e45-a466eb9d4659",
                                        "glosses": [
                                            "An antibody formed in response to an agent (autoantigen) produced by the organism itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753ca15b-4f91-4bd0-980a-d514cc856547",
                                                "sense_id": "83c70e93-7ebc-3829-8706-bf3bf16eaae6",
                                                "text": "In addition to having a relative with Type 1, people in that subgroup had insulin autoantibody levels equal to or greater than 80 milliunits per milliliter."
                                            },
                                            {
                                                "example_id": "4b0480ec-b65b-4d70-b4c9-fd2948456c9c",
                                                "sense_id": "83c70e93-7ebc-3829-8706-bf3bf16eaae6",
                                                "text": "The current study investigates autoantibodies against steroid synthesis enzymes in dogs with spontaneous hypoadrenocorticism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
