{
    "word_family": [
        "schromelijk",
        "onbeschroomd"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d1c62dd-18de-3f3d-b7f3-552fe0b52dd7",
                    "sense_definition": "Een gevoel van aarzeling of verlegenheid om iets te doen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij overwon zijn <w>schroom</w> en stapte op het podium om te spreken.",
                            "target_lang_translations": {
                                "pl": "Przezwyciężył swoje <w>skrępowanie</w> i wszedł na scenę, aby przemówić."
                            }
                        },
                        {
                            "text": "Zonder enige <w>schroom</w> vroeg zij om een salarisverhoging bij haar baas.",
                            "target_lang_translations": {
                                "pl": "Bez żadnego <w>wahania</w> poprosiła szefa o podwyżkę."
                            }
                        }
                    ],
                    "synonyms": [
                        "aarzeling",
                        "verlegenheid",
                        "gêne"
                    ],
                    "antonyms": [
                        "onbeschroomdheid"
                    ],
                    "common_phrases": [
                        "zonder schroom"
                    ],
                    "target_lang_definitions": {
                        "pl": "Uczucie wahania, onieśmielenia lub skrępowania przed zrobieniem czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skrępowanie",
                                "target_lang_sense_clarification": "uczucie nieśmiałości lub zakłopotania"
                            },
                            {
                                "target_lang_word": "onieśmielenie",
                                "target_lang_sense_clarification": "brak pewności siebie w jakiejś sytuacji"
                            },
                            {
                                "target_lang_word": "wahanie",
                                "target_lang_sense_clarification": "brak zdecydowania, opory"
                            },
                            {
                                "target_lang_word": "opory",
                                "target_lang_sense_clarification": "wewnętrzne opory, niechęć do podjęcia działania"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3f7b6c1-43d1-3124-a35f-43eff9a101d1",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>schromen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schroom</w> niet om mijn mening eerlijk te geven in deze vergadering.",
                            "target_lang_translations": {
                                "pl": "Nie <w>waham się</w> szczerze wyrazić swojej opinii na tym spotkaniu."
                            }
                        },
                        {
                            "text": "Ik <w>schroom</w> om hem om hulp te vragen bij dit moeilijke project.",
                            "target_lang_translations": {
                                "pl": "<w>Krępuję się</w> poprosić go o pomoc przy tym trudnym projekcie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pierwsza osoba liczby pojedynczej czasu teraźniejszego czasownika schromen (wahać się, krępować się)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "krępuję się",
                                "target_lang_sense_clarification": "odczuwać skrępowanie"
                            },
                            {
                                "target_lang_word": "waham się",
                                "target_lang_sense_clarification": "mieć wątpliwości przed działaniem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7fbb43e-c8b3-3ac1-9469-4855766dc064",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>schromen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>schroom</w> jij zo om je talenten aan de wereld te tonen?",
                            "target_lang_translations": {
                                "pl": "Dlaczego tak bardzo <w>wstydzisz się</w> pokazać światu swoje talenty?"
                            }
                        },
                        {
                            "text": "Als je <w>schroom</w> om te bellen, stuur dan gerust een e-mail.",
                            "target_lang_translations": {
                                "pl": "Jeśli <w>krępujesz się</w> zadzwonić, śmiało wyślij e-mail."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Druga osoba liczby pojedynczej czasu teraźniejszego czasownika schromen (w inwersji lub potocznie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "krępujesz się",
                                "target_lang_sense_clarification": "forma 2. os. lp czasownika krępować się"
                            },
                            {
                                "target_lang_word": "wahasz się",
                                "target_lang_sense_clarification": "forma 2. os. lp czasownika wahać się"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f495f57-817b-3dec-bced-fa4239558caa",
                    "sense_definition": "Gebiedende wijs van <w>schromen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schroom</w> niet om contact met ons op te nemen bij vragen.",
                            "target_lang_translations": {
                                "pl": "Nie <w>wahaj się</w> skontaktować z nami w razie pytań."
                            }
                        },
                        {
                            "text": "<w>Schroom</w> niet en kom gerust binnen voor een kopje koffie.",
                            "target_lang_translations": {
                                "pl": "Nie <w>krępuj się</w> i wejdź śmiało na filiżankę kawy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Tryb rozkazujący czasownika schromen."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "krępuj się",
                                "target_lang_sense_clarification": "forma trybu rozkazującego czasownika krępować się (zazwyczaj z negacją)"
                            },
                            {
                                "target_lang_word": "wahaj się",
                                "target_lang_sense_clarification": "forma trybu rozkazującego czasownika wahać się"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}