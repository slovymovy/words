                        "source_entry_id": "4ffde4ea-ac85-3431-8595-0db95928537a",
                        "source_sense_description": "any of several unrelated therapies that use natural biological processes",
                        "target_lang_word": "biothérapie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
