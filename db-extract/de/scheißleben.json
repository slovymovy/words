                        "examples": [
                            {
                                "example_id": "634d0184-2bae-48c7-996e-e2adbea0f865",
                                "sense_id": "6e900637-2ec3-3587-b0f1-16435f9c8ab2",
                                "text": "„Ein Scheißleben, aber echt, dachte er.“"
                            },
                            {
                                "example_id": "0e211091-61b0-4fb0-83cf-237957d4b555",
                                "sense_id": "6e900637-2ec3-3587-b0f1-16435f9c8ab2",
                                "text": "„Whitlocks Pläne bauten darauf, dass Gentrys Scheißleben wenigstens noch eine weitere Nacht andauerte.“"
                            },
                            {
                                "example_id": "06a6081f-b0f4-4fe2-a85f-82d7859eaad3",
                                "sense_id": "6e900637-2ec3-3587-b0f1-16435f9c8ab2",
                                "text": "„Und du läufst ins Leere, wie mein Scheißleben, mein armseliger Job oder die Tussis, die an meiner Zellenwand kleben--“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
