                "senses": [
                    {
                        "sense_id": "aa3230ac-61ac-3023-8fae-fe5ba2e1aaa3",
                        "entry_id": "06975b0a-5120-3154-941b-7bdd5fd09d04",
                        "glosses": [
                            "Opération consistant à enlever, sur une plante cultivée, les gourmands, les pousses dont la croissance ne contribuera pas à la future récolte."
                        ],
                        "tags": [
                            "Jardinage",
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "12687e17-dc33-4f8f-a010-e8c27fd82bbe",
                                "sense_id": "aa3230ac-61ac-3023-8fae-fe5ba2e1aaa3",
                                "text": "Il est une précaution qui s’indique tellement d’elle-même, que c’est à peine si j’ose la rappeler : l’égourmandage des tronçons greffés."
                            },
                            {
                                "example_id": "64a46913-8d4a-45d5-b350-7369ca07bd97",
                                "sense_id": "aa3230ac-61ac-3023-8fae-fe5ba2e1aaa3",
                                "text": "Il a expliqué à Apolline de Malherbe qu’il pourrait embaucher « 10 personnes » mais sur une période courte de 15 jours pour les travaux du moment dans les vignes, « l’égourmandage, le relevage, l’attachage »."
                            },
                            {
                                "example_id": "153f73d0-8b57-44ff-a2c5-b2cc7197fc48",
                                "sense_id": "aa3230ac-61ac-3023-8fae-fe5ba2e1aaa3",
                                "text": "L’égourmandage empêche la formation de pousses latérales superflues, afin que la plante mette son énergie dans la pousse principale et la formation de fleurs et de fruits."
                            }
                        ]
                    }
