    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5360fe3-1093-3bcf-93cc-25fd549f6668",
                    "sense_definition": "Sentiment de malaise, de trouble ou d'embarras ressenti dans une situation sociale ou devant quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inconfort_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa remarque déplacée, un lourd silence plein de <w>gêne</w> s'est installé dans la pièce."
                        },
                        {
                            "text": "Elle a accepté notre proposition mais semblait éprouver un sentiment de <w>gêne</w> involontaire."
                        }
                    ],
                    "synonyms": [
                        "embarras",
                        "malaise"
                    ],
                    "antonyms": [
                        "aisance",
                        "assurance"
                    ],
                    "common_phrases": [
                        "sentiment de gêne",
                        "moment de gêne",
                        "éprouver de la gêne"
                    ]
                },
                {
                    "sense_id": "8042a11e-1d8a-3e5a-b226-6315320745b0",
                    "sense_definition": "Sensation physique désagréable, douleur légère ou difficulté qui entrave un mouvement ou une fonction vitale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inconfort_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient ressent une vive <w>gêne</w> dans la poitrine dès qu'il fait un effort."
                        },
                        {
                            "text": "Cette veste trop étroite aux épaules provoque une forte sensation de <w>gêne</w> physique."
                        }
                    ],
                    "synonyms": [
                        "inconfort",
                        "tiraillement"
                    ],
                    "antonyms": [
                        "confort",
                        "soulagement"
                    ],
                    "common_phrases": [
                        "gêne respiratoire",
                        "sensation de gêne"
                    ]
                },
                {
                    "sense_id": "14a57717-f4d9-35dd-bd28-32571cd68594",
                    "sense_definition": "Manque important de ressources financières, situation précaire proche de la pauvreté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis la fermeture de son commerce, cette famille doit vivre dans une constante <w>gêne</w>."
                        },
                        {
                            "text": "Il refusait d'avouer qu'il était dans la <w>gêne</w> malgré des dettes de plus en plus lourdes."
                        }
                    ],
                    "synonyms": [
                        "besoin",
                        "précarité",
                        "pauvreté"
                    ],
                    "antonyms": [
                        "aisance",
                        "opulence",
                        "richesse"
                    ],
                    "common_phrases": [
                        "vivre dans la gêne",
                        "être dans la gêne"
                    ]
                },
                {
                    "sense_id": "47d1bad6-00dc-35db-89a2-465593b29d2e",
                    "sense_definition": "Ancienne peine judiciaire corporelle ou torture visant à contraindre un prévenu à avouer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "torture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a ordonné de soumettre le prisonnier à la <w>gêne</w> pour obtenir ses aveux complets."
                        },
                        {
                            "text": "Ce condamné n'a pas survécu aux tortures infligées par la <w>gêne</w> dans les cachots royaux."
                        }
                    ],
                    "synonyms": [
                        "question",
                        "torture"
                    ],
                    "common_phrases": [
                        "mettre à la gêne"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "ancien droit pénal"
                        }
                    ]
                }
            ]
        },
