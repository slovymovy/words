                        "entry_id": "1f3dae08-6e95-3f93-99d7-41eddf2d55c7",
                        "glosses": [
                            "Analogie à n dimensions du triangle, plus exactement, l’enveloppe convexe d’un ensemble de points formant un repère affine dans un espace euclidien de dimension n. C’est la configuration géométrique la plus simple en dimension quelconque."
                        ],
                        "tags": [
                            "n + 1"
                        ],
                        "examples": [
                            {
                                "example_id": "521a2ac3-cf44-4852-a257-f08b72c423af",
                                "sense_id": "e369a0a6-61c5-369a-ae3c-1fa8a7833eda",
                                "text": "Un simplexe de dimension n est un polytope de dimension n à n + 1 sommets, nombre minimal possible."
                            }
                        ]
                    }
                ],
