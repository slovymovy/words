                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8afcb41-4bca-4e5b-bfe4-71bbbbd83b47",
                        "source_entry_id": "5929ff0d-f9be-3284-9d72-f59005c5fa1c",
                        "source_sense_id": "34fe8cdc-2d84-32b7-96cc-b4d983a4a623",
