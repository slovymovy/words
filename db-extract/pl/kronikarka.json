                "senses": [
                    {
                        "sense_id": "4cef7bcd-1198-3158-8138-2c9e821f71e5",
                        "entry_id": "e4074dee-b03d-3b28-8160-a9183b3ee744",
                        "glosses": [
                            "kobieta, która napisała lub pisze kronikę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbc903e-83ac-45ec-b193-a0d2c0e26e7e",
                                "sense_id": "4cef7bcd-1198-3158-8138-2c9e821f71e5",
                                "text": "Było mi po prostu przykro, jak usłyszałam te słowa – przyznaje w rozmowie z nami kronikarka"
                            },
                            {
                                "example_id": "bbc1c72d-8cee-4836-9a8d-6336d193fa60",
                                "sense_id": "4cef7bcd-1198-3158-8138-2c9e821f71e5",
                                "text": "Mimo że jak za chwilę się dowiem, z wykształcenia jest przyrodoznawcą, to z duszy, zamiłowania, kronikarką i historykiem w jednej osobie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
