                ],
                "senses": [
                    {
                        "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                        "entry_id": "6e2ef933-8ab0-37ae-97f4-cd22c22a42a4",
                        "glosses": [
                            "Bestand an Vieh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9313a868-1e35-4a19-84ee-024759e61b4a",
                                "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                "text": "„Für gewöhnlich sorgt auf einem Hof der Viehbestand für einen zumindest gedämpften Geräuschpegel, aber hier fehlten alle Geräusche des Lebens.“"
                            },
                            {
                                "example_id": "4181f4d7-3ac7-4ee9-b8ec-68362acb270c",
                                "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                "text": "„Es hatte Missernten gegeben, und oft musste der Viehbestand vorzeitig geschlachtet werden, um zu verhindern, dass er an Unterernährung einging.“"
                            },
                            {
                                "example_id": "dd868456-25af-45e4-a409-78f46d08a699",
                                "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                "text": "„Mir wurde klar, dass die Liebe der Bauern zu ihren Kindern genauso unkontrollierbar war wie ein Ausbruch von Maul- und Klauenseuche im Viehbestand.“"
                            },
                            {
                                "example_id": "e546f6f5-140a-4eb9-939a-c714d8068faa",
                                "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                "text": "„Wir haben an die hundert Schafe, gibt sie Auskunft, als ich nach dem Viehbestand frage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
