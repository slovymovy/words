                        "target_lang_word": "acide carboxylique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acide carboxylique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "642d4b15-5a71-39d0-8f4f-7b6700d9fe52",
                                        "entry_id": "fe041f3d-1641-3a77-8998-8a998f7e80b8",
                                        "glosses": [
                                            "Composé organique qui comprend un groupe carboxyle, et de formule générale R-COOH."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900b626f-394a-4199-9ff6-df5bcc997505",
                                                "sense_id": "642d4b15-5a71-39d0-8f4f-7b6700d9fe52",
                                                "text": "Les acides carboxyliques sont des acides demi-faibles."
                                            },
                                            {
                                                "example_id": "f0292124-0374-4d57-b819-57b8e7dbcc0a",
                                                "sense_id": "642d4b15-5a71-39d0-8f4f-7b6700d9fe52",
                                                "text": "D’autres mélanges hydroorganiques sont aussi proposés pour doser certains acides carboxyliques peu solubles, par exemple : les mélanges eau/DMF et eau/acétone."
                                            },
                                            {
                                                "example_id": "6bd2011d-af46-49da-ace0-46f066feefd5",
                                                "sense_id": "642d4b15-5a71-39d0-8f4f-7b6700d9fe52",
                                                "text": "Beaucoup de molécules se retrouvent chez tous les êtres vivants, par exemple les acides carboxyliques jouent un rôle métabolique important, aussi bien chez des organismes unicellulaires que chez un éléphant."
                                            },
                                            {
                                                "example_id": "355c35d3-9da1-431e-8953-0510dd032a04",
                                                "sense_id": "642d4b15-5a71-39d0-8f4f-7b6700d9fe52",
                                                "text": "Les acides gras sont des acides carboxyliques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
