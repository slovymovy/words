                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87abb62c-16c6-45f9-a17e-66704bc64477",
                                "sense_id": "2cfe2de9-6aea-30c9-b2ba-8659c7461dc5",
                                "text": "Inmitten des Amazonasregenwaldes, fernab der Zivilisation, leben einige Indianerstämme noch wie vor der Entdeckung Amerikas."
                            },
                            {
                                "example_id": "371a5dc7-4a25-414f-99df-4a34154edbb5",
                                "sense_id": "2cfe2de9-6aea-30c9-b2ba-8659c7461dc5",
                                "text": "„Das Auto etablierte sich durch die explosionsartige Besiedlung von Gebieten fernab der Bahnen zum unverzichtbaren Verkehrsträger.“"
                            },
                            {
                                "example_id": "8c616ba1-016a-4789-82df-8425e422cc83",
                                "sense_id": "2cfe2de9-6aea-30c9-b2ba-8659c7461dc5",
                                "text": "„Die Erkenntnis der Grundbausteine des Rechts hat für sie – fernab jeder Streitentscheidung – einen Wert für sich.“"
                            },
                            {
                                "example_id": "cdc9a0cf-8174-481c-947d-be04b3627a6c",
                                "sense_id": "2cfe2de9-6aea-30c9-b2ba-8659c7461dc5",
                                "text": "„Gut zwei Drittel aller Chinesen leben fernab der Ballungsräume, meist in Regionen, die für ausländische Reisende nur schwer zu erreichen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
