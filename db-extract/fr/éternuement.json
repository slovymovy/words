        "fr-extract.jsonl": [
            {
                "entry_id": "948c0a8e-9954-3c9c-acb8-84934773e03a",
                "word": "éternuement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c792cd97-947e-45d0-9b11-d9206045ea1d",
                        "entry_id": "948c0a8e-9954-3c9c-acb8-84934773e03a",
                        "tags": [
                            "plural"
                        ],
                        "form": "éternuements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2dfe000e-9428-3f3e-b025-596a5d73b588",
                        "entry_id": "948c0a8e-9954-3c9c-acb8-84934773e03a",
                        "glosses": [
                            "Action d’éternuer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f48721-e974-4d80-98db-6aad3b3074fc",
                                "sense_id": "2dfe000e-9428-3f3e-b025-596a5d73b588",
                                "text": "Soudain, nouveau bruit… Cette fois, il n’y a pas à se tromper… Un éternuement à demi étouffé a fait trembler les parois de la caisse…"
                            },
                            {
                                "example_id": "9b09901a-1c3f-4d86-9f1e-f4544667fc81",
                                "sense_id": "2dfe000e-9428-3f3e-b025-596a5d73b588",
                                "text": "Longue marche dans le brouillard. Le régiment tousse, moins la compagnie du lieutenant Viard, où la toux est punie et où les soldats se rattrapent sur l’éternuement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87a4723b-5a54-4d88-a3f6-2f9b8e254adf",
                        "source_entry_id": "948c0a8e-9954-3c9c-acb8-84934773e03a",
                        "source_sense_id": "2dfe000e-9428-3f3e-b025-596a5d73b588",
                        "target_lang_word": "Niesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a458166b-5f45-34f8-aa54-824c82f7d4b5",
                                        "entry_id": "e49f433d-af61-3939-9ca8-e3f4dd129fd9",
                                        "glosses": [
                                            "das ruckartige und meistens laute Ausstoßen von Luft durch Nase und/oder Mund (als Reflex auf einen Reiz der Nasenschleimhaut), ohne darüber Kontrolle zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d48e935-eff3-433b-bcd0-864f0871b84d",
                                                "sense_id": "a458166b-5f45-34f8-aa54-824c82f7d4b5",
                                                "text": "Beim Niesen wird eine Geschwindigkeit von bis zu 160 km/h erreicht."
                                            },
                                            {
                                                "example_id": "ef60c016-96a8-4d47-878f-84bec8b06db8",
                                                "sense_id": "a458166b-5f45-34f8-aa54-824c82f7d4b5",
                                                "text": "Einmal Niesen setzt rund fünftausend Bakterien frei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6c6927e-7943-4e32-ad07-02ddebedc139",
                        "source_entry_id": "948c0a8e-9954-3c9c-acb8-84934773e03a",
                        "source_sense_id": "2dfe000e-9428-3f3e-b025-596a5d73b588",
                        "target_lang_word": "sneeze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sneeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd73396-e523-3104-a961-9aeb16270f4b",
                                        "entry_id": "ac6f62b4-9bd7-3c6e-b002-e313024312e3",
                                        "glosses": [
                                            "To expel air as a reflex induced by an irritation in the nose."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e507dd-52a7-4002-a91d-5816579dc332",
                                                "sense_id": "1bd73396-e523-3104-a961-9aeb16270f4b",
                                                "text": "To avoid passing on your illness, you should sneeze into your sleeve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0486bcfd-0b8d-3338-84c1-44d10f3d8cb1",
                                        "entry_id": "ac6f62b4-9bd7-3c6e-b002-e313024312e3",
                                        "glosses": [
                                            "To expel air as if the nose were irritated."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                        "entry_id": "ac6f62b4-9bd7-3c6e-b002-e313024312e3",
                                        "glosses": [
                                            "To expel or displace (air, snot, etc) from the nose or mouth by the process above."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8d6d4d2-3e17-4de0-8b0b-9a7655b9a5e2",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "Lily shook her head violently and sneezed a large blue-bottle fly from where that insect had perched itself on the tip of her nose."
                                            },
                                            {
                                                "example_id": "17199625-131f-41b9-a4bd-590c6990b7c1",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "When I crossed the road, I sneezed a big achoo! My nose started to feel itchy."
                                            },
                                            {
                                                "example_id": "136b966a-e22f-4beb-8d5d-6c03dc887b1e",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "I sneezed a big sneeze. It was so big I hit my nose on the sidewalk. Bow-ow. There was a smell in my snout that I wanted to get rid of. And it wasn't Muffet's rotten soup odor, either. That was actually kind of delicious."
                                            },
                                            {
                                                "example_id": "b60a29bc-4465-455f-b9bf-f916c83ccc6c",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "“Okay,”he said, and sneezed a large drop of pinkish goop. “But you better have a lot to eat! I'll race you upstairs!” Wilmer shook his head. Sherman's hyper energy level seemed to have increased, and that was saying a lot."
                                            },
                                            {
                                                "example_id": "a4e7d82c-ec41-4a68-8792-4b6e432e78d4",
                                                "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                                                "text": "Toothless sneezed a large amount of dragon snot right in Hiccup's face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sneeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5904bf2c-9f4c-3974-b188-26d4c07ef267",
                                        "entry_id": "a25a3129-a0c9-3740-8884-f031e6c2dfcc",
                                        "glosses": [
                                            "An act of sneezing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e097424-02ac-4795-a427-4c237289faad",
                                                "sense_id": "5904bf2c-9f4c-3974-b188-26d4c07ef267",
                                                "text": "Jared's hay fever gives him terrible sneezes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
