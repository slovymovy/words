                ],
                "senses": [
                    {
                        "sense_id": "b5686bd3-030b-3c6e-9ac5-11d78613f1b4",
                        "entry_id": "40e81dfb-13e2-3af9-9681-311ab9c1b316",
                        "glosses": [
                            "Femelle du sanglier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126a42e4-7bae-49fb-9975-b0425669a470",
                                "sense_id": "b5686bd3-030b-3c6e-9ac5-11d78613f1b4",
                                "text": "Ou bien il lui apprenait que la laie du Fond-de-Tambour, un vieux sanglier qu’on n’arrivait pas à cerner dans sa bauge, se promenait avec quatre marcassins qu’elle venait de mettre bas…"
                            },
                            {
                                "example_id": "946725ba-c3a6-4e9e-aa6c-c4009d60e300",
                                "sense_id": "b5686bd3-030b-3c6e-9ac5-11d78613f1b4",
                                "text": "Le sanglier et sa laie."
                            },
                            {
                                "example_id": "3762fc9d-b103-4bff-8a3c-a93c4d60fa3d",
                                "sense_id": "b5686bd3-030b-3c6e-9ac5-11d78613f1b4",
                                "text": "Laie meneuse : laie adulte dominante et ayant de l’expérience qui prend la tête de sa compagnie."
                            },
                            {
                                "example_id": "a5f5ec20-b13c-4552-bca4-2693f809552b",
                                "sense_id": "b5686bd3-030b-3c6e-9ac5-11d78613f1b4",
                                "text": "Laie suitée : laie accompagnée de ses marcassins encore dépendants d’elle."
                            },
                            {
                                "example_id": "6af21fed-8702-4ae2-9214-d97bec1e04a9",
                                "sense_id": "b5686bd3-030b-3c6e-9ac5-11d78613f1b4",
                                "text": "Laie ragote : jeune laie âgée de moins de 3 ans et de plus de 2 ans."
                            }
                        ]
                    }
                ],
