                ],
                "senses": [
                    {
                        "sense_id": "480af454-4e2e-3683-b654-71205892c6dc",
                        "entry_id": "77588ca9-bdd9-3e2d-9a36-8bb9e343699f",
                        "glosses": [
                            "okres pokrycia obszaru Ziemi lądolodem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "556e4b87-cbca-4694-9e18-f5c08a4aa11f",
                                "sense_id": "480af454-4e2e-3683-b654-71205892c6dc",
                                "text": "O zlodowaceniach przedczwartorzędowych, w prekambrze, karbonie i permie świadczą resztki utworów lodowcowych (np. tillity), zachowane w osadach w Afryce, Australii czy Ameryce Południowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a84af4f-2e54-4f21-bd17-f3186659a3ef",
                        "source_entry_id": "77588ca9-bdd9-3e2d-9a36-8bb9e343699f",
                        "source_sense_id": "480af454-4e2e-3683-b654-71205892c6dc",
                        "target_lang_word": "glaciation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaciation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "The process of covering with a glacier, or the state of being glaciated; the production of glacial phenomena; an ice age"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4afc0278-1b00-4935-bba1-2225eb9c36dc",
                                                "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                                "text": "That the habitability of our planet was severely endangered by the significant rise in oxygen levels and reduction in methane due to oxygen-producing bacteria combined with the low luminosity of the Sun in the Proterozoic era (2500– 542 million years ago) is suggested by geological evidence for severe global glaciations in this epoch."
                                            },
                                            {
                                                "example_id": "426b33a2-00e9-4c97-9ee9-ac231ef502b0",
                                                "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                                "text": "This simulation aims at describing the hydrological conditions at a Swedish deep repository of nuclear waste during a glaciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "A particular instance of glacier formation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6161c3f2-8ed0-4228-b8cb-a7e93ce7271f",
                                                "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                                "text": "Deposits of the Caribou Hills glaciation only locally retain a distinct hummocky morainal form, with filled kettle depressions and subdued knobs. Along the mountain fronts the marginal deposits of this glaciation reach an average altitude of slightly more than 3,000 feet."
                                            },
                                            {
                                                "example_id": "a25619c7-b15e-4680-a663-18086c0c86f3",
                                                "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                                "text": "Deposits from the glaciation are sparse, but glacial surfaces at 4150–4300 m in the Hunza area, above 2600 m in the Gilgit region, above 3200 m in the Haramosh region, above 4000 m on Deosai, and at 3200–3500 m in the Shigar valley area provide much evidence for this glaciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba8a5bc6-9ff9-3ae1-b9ea-a13f402e3936",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "The act of freezing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "048f8606-0605-4bb6-b974-0d20e4707d70",
                                                "sense_id": "ba8a5bc6-9ff9-3ae1-b9ea-a13f402e3936",
                                                "text": "For cave glaciation to occur it is necessary that the air temperature outside the caves be negative either for all or part of a year; such conditions exist in many regions of the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b7003f9-3c7d-4e1c-bdca-13012eed9b10",
                        "source_entry_id": "77588ca9-bdd9-3e2d-9a36-8bb9e343699f",
                        "source_sense_id": "480af454-4e2e-3683-b654-71205892c6dc",
                        "target_lang_word": "glaciación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaciación",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2e6a2c5c-3ea2-3d7f-b526-73e1a916de8d",
                                        "entry_id": "7f4d211b-4b1b-31aa-b269-1e1fd6b37bb7",
                                        "glosses": [
                                            "Periodo de tiempo relativamente extenso en el que las temperaturas en un lugar permanecen muy por debajo de su nivel normal, teniendo como consecuencia una invasión de hielo del hábitat."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48e5a12a-32f1-4701-99dc-9e2fa5916f41",
                        "source_entry_id": "77588ca9-bdd9-3e2d-9a36-8bb9e343699f",
                        "source_sense_id": "480af454-4e2e-3683-b654-71205892c6dc",
                        "target_lang_word": "оледенение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оледенение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c99b61ca-3077-37d7-9d61-f63dd0df7d9d",
                                        "entry_id": "40759c34-4929-3522-8351-dcb325f8b432",
                                        "glosses": [
                                            "действие по значению гл. оледеневать, оледенеть; покрывание льдом со всех сторон, по всей поверхности; превращение в лёд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd42437c-aeed-400b-8f13-939a8fb42d04",
                                                "sense_id": "c99b61ca-3077-37d7-9d61-f63dd0df7d9d",
                                                "text": "Самое раннее оледенение (Гуронское) было в нижнем протерозое 2.5-2.2 млрд."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74eda1b1-91fb-3a73-ba31-908229648c6f",
                                        "entry_id": "40759c34-4929-3522-8351-dcb325f8b432",
                                        "glosses": [
                                            "результат такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29d438ee-aed5-458a-a138-acff83f2d2f0",
                                                "sense_id": "74eda1b1-91fb-3a73-ba31-908229648c6f",
                                                "text": "Новые исследования показывают, что в последние годы наземное оледенение Арктики в целом уменьшается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69395387-2e74-3260-a98f-1a0d68133de9",
                                        "entry_id": "40759c34-4929-3522-8351-dcb325f8b432",
                                        "glosses": [
                                            "то же, что и обледенение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8e3076b-6968-42b4-8d9b-0eacdc2e4f49",
                                                "sense_id": "69395387-2e74-3260-a98f-1a0d68133de9",
                                                "text": "Чтобы уменьшить оледенение гермошлема, Евгений Андреев переворачивается на спину."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
