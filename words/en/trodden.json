            "senses": [
                {
                    "sense_id": "1c029cf5-366e-33e4-a617-8e1dacd89c21",
                    "sense_definition": "Flattened, crushed, or worn down by being walked on.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We followed a well <w>trodden</w> path through the dense forest.",
                            "target_lang_translations": {
                                "ru": "Мы шли по хорошо <w>протоптанной</w> тропе через густой лес."
                            }
                        },
                        {
                            "text": "The <w>trodden</w> grass showed where the animals had rested overnight.",
                            "target_lang_translations": {
                                "ru": "<w>Примятая</w> трава указывала на место, где животные ночевали."
                            }
                        }
