                        "examples": [
                            {
                                "example_id": "bb76d853-b386-4ace-aada-759e28c0e879",
                                "sense_id": "f9f458c1-808b-3821-9a42-639a5b20cd35",
                                "text": "„Ein US-Forscherteam um Ted Scambos (National Snow and Ice Data Center in Boulder) ist seit einigen Jahren auf der Jagd nach dem Kälterekord und analysierte Temperaturmessungen von Satelliten aus den vergangenen Jahrzehnten.“"
                            },
                            {
                                "example_id": "9c4ad3a9-11c3-4fdf-89e7-3e00cd204e2e",
                                "sense_id": "f9f458c1-808b-3821-9a42-639a5b20cd35",
                                "text": "„Über Weihnachten versanken einige US-Bundesstaaten bereits im Schnee, jetzt bricht Minnesota einen fast hundert Jahre alten Kälterekord: Im \"Eisschrank der Nation\" sind -38 Grad gemessen worden.“"
                            }
                        ],
