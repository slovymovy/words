                        "glosses": [
                            "Ensemble des techniques et des pratiques de la production d’une seule espèce d’animal."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "439f4076-058f-4b74-9f66-aa29925b0079",
                                "sense_id": "bb5afc4a-d763-39b2-8215-f22be5d97193",
                                "text": "Les exploitations se sont tournées vers le mono-élevage."
                            },
                            {
                                "example_id": "febd1790-c70c-44ad-b7ac-63f4bd3c7eae",
                                "sense_id": "bb5afc4a-d763-39b2-8215-f22be5d97193",
                                "text": "La monoculture, comme le monoélevage, qui se ramène à une simplification radicale d’un écosystème, favorise la prolifération des parasites de cette culture ou de cet élevage car plus on simplifie l’écosystème, plus il devient vulnérable."
                            }
                        ]
