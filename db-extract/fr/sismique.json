                                "target_senses": [
                                    {
                                        "sense_id": "278395c7-7d6e-35eb-94ae-e4bbb7800965",
                                        "entry_id": "2d89a0bd-ace4-3af1-ad56-0152b13bb04c",
                                        "glosses": [
                                            "Related to, or caused by an earthquake or other vibration of the Earth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
