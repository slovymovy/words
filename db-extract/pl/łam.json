                        "entry_id": "038a0043-88ec-3966-9343-8aa8665afffe",
                        "glosses": [
                            "teksty, tabele, ilustracje i inne elementy druku uformowane w kolumnę w układzie jednołamowym lub stanowiące część kolumny w układzie wielołamowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67c51d7b-be39-4913-977c-ce91e3f80ed6",
                                "sense_id": "bde2e7ba-591e-3b54-a784-af5180cdd40f",
                                "text": "Kolumny wielołamowe czasopism mogą posiadać zróżnicowane szerokości łamów, przy czym łamy mogą być oddzielane odstępami lub linią z odstępami"
                            },
                            {
                                "example_id": "87f5c7e8-e13c-47ec-867e-e5ec81668c96",
                                "sense_id": "bde2e7ba-591e-3b54-a784-af5180cdd40f",
                                "text": "Zależnie od stopnia pisma, wielkości kolumny i liczby łamów na kolumnie odstęp oddzielający łamy powinien wynosić od 4,5 do 9 mm"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
