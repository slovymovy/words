                ],
                "senses": [
                    {
                        "sense_id": "93048929-00a6-3c7b-a5ce-ecbe3e671e70",
                        "entry_id": "d695a3dc-2ccc-32bf-b258-97c640c36d49",
                        "glosses": [
                            "Relatif à la muqueuse, aux mucosités qu'elle produit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c07d56d-af28-43b3-9787-80aa39f9b9ee",
                                "sense_id": "93048929-00a6-3c7b-a5ce-ecbe3e671e70",
                                "text": "Aujourd’hui, j’ai couramment tendance à regarder l’organe féminin comme une chose sale ou comme une blessure, pas moins attirante en cela, mais dangereuse par elle-même comme tout ce qui est sanglant, muqueux, contaminé."
                            }
                        ]
                    },
                    {
                        "sense_id": "f45f4265-2158-3bc0-a6f4-8dc15cb4cd71",
                        "entry_id": "d695a3dc-2ccc-32bf-b258-97c640c36d49",
                        "glosses": [
                            "Qualifie les glandes qui sécrètent des mucosités."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a1e50fde-c20b-3c90-aca4-98e7f9f6b9e6",
                        "entry_id": "d695a3dc-2ccc-32bf-b258-97c640c36d49",
                        "glosses": [
                            "Qualifie une membrane humectée de mucosités."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0e5aac52-390c-4563-a4f3-4fd7811cb344",
                                "sense_id": "a1e50fde-c20b-3c90-aca4-98e7f9f6b9e6",
                                "text": "L’auscultation révèle à gauche des râles crépitants nombreux au centre, muqueux en dessous, gros et gargouillants au bas. À droite des râles crépitants fins dans la moitié inférieure. Jusqu’ici les mouvements respiratoires ont été normaux. Je diagnostique avec assurance une bronchite double sans miliaires et sans hépatisation ; l’expectoration abondante est visqueuse et muqueuse. — Le 14, la malade crache toujours plus ; mais le bas du poumon gauche devient mat, et ses râles consonnants avec résonnance de la voix. Le soir un second frisson. Le 15, la bronchorrhée est purulente et les crachats gros et nummulaires. Abondante transpiration. Dès ce moment, la bronchite entre dans une période de résolution apparente et il se fait un temps d’arrêt. Vers le 26, la fièvre se relève plus vive encore, et la colliquation commence avec les sueurs, la diarrhée et le marasme rapide."
                            },
                            {
                                "example_id": "e7b83686-1576-4edd-b14a-b0162a17e02c",
                                "sense_id": "a1e50fde-c20b-3c90-aca4-98e7f9f6b9e6",
                                "text": "L’hydrosalpinx est la dilatation de la trompe de Fallope par un liquide séreux, clair qui comprime l’épithélium muqueux. Il représente une séquelle d’inflammation tubaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "f21d72b4-d864-3c36-b51f-1b1fe7ace3fa",
                        "entry_id": "d695a3dc-2ccc-32bf-b258-97c640c36d49",
                        "glosses": [
                            "Qualifiait la fièvre typhoïde dans sa forme légère."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21666ce6-000c-4c11-b20c-f9d1cc547285",
                        "source_entry_id": "d695a3dc-2ccc-32bf-b258-97c640c36d49",
                        "target_lang_word": "mukös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mukös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cdf27df-7a82-3d5e-814c-e15a2fbac03f",
                                        "entry_id": "ca740b4e-c6dc-30c4-9e26-c0556cf43f2b",
                                        "glosses": [
                                            "in der Schleimhaut, schleimig, schleimbildend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be1abc0c-467e-4c4b-9cc7-4ed5ad78a278",
                                                "sense_id": "1cdf27df-7a82-3d5e-814c-e15a2fbac03f",
                                                "text": "Hierbei sollte darauf geachtet werden, ob der Schleim nur mukös oder durch einen Infekt stark purulent ist."
                                            },
                                            {
                                                "example_id": "41823b8a-5ffd-4980-bb2c-c129b7edf1be",
                                                "sense_id": "1cdf27df-7a82-3d5e-814c-e15a2fbac03f",
                                                "text": "Je nach sezernierender Drüse ist der dort gebildete Speichel eher serös (wässrig) oder eher mukös (schleimig)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76fcc8d9-f69c-4d6a-b480-31d9eaa648ac",
                        "source_entry_id": "d695a3dc-2ccc-32bf-b258-97c640c36d49",
                        "target_lang_word": "schleimig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schleimig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76a6e220-ee60-3760-a1a6-7683a577f7a2",
                                        "entry_id": "1acf8873-0906-33e6-8ec0-5a100b02ed5a",
                                        "glosses": [
                                            "glitschig feucht, aus Schleim bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ee9d67-d83b-4981-bf80-f65d8a239a17",
                                                "sense_id": "76a6e220-ee60-3760-a1a6-7683a577f7a2",
                                                "text": "Diese Hafergrütze ist ja ganz eklig schleimig geworden. Die mag ich nicht essen."
                                            },
                                            {
                                                "example_id": "1fe81e76-f6e0-4344-8cdf-3b48a1117de8",
                                                "sense_id": "76a6e220-ee60-3760-a1a6-7683a577f7a2",
                                                "text": "„Wir erinnern auch daran, dass Kolonien auf dünn besiedelten Platten schleimiger sind als auf dichten Platten, junge Kolonien schleimiger als ältere, Bohnenagarkulturen schleimiger als Fleischagarkulturen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "daef5447-a198-3a43-8142-210dc18e4228",
                                        "entry_id": "1acf8873-0906-33e6-8ec0-5a100b02ed5a",
                                        "glosses": [
                                            "falsch, nur übertrieben freundlich tuend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b68f840-0499-4881-b081-a83929e33e2d",
                                                "sense_id": "daef5447-a198-3a43-8142-210dc18e4228",
                                                "text": "Und dann da der schleimige Typ mit den gegeelten Haaren, der, der links vom Klavier saß, der passte ja überhaupt nicht hierher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
