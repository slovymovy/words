                    "target_lang_definitions": {
                        "ru": "Ряд населенных пунктов в США, например, город в Арканзасе или общины в Джорджии и Техасе.",
                        "zh": "美国的一些地名，如阿肯色州的城市或佐治亚州和得克萨斯州的社区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кэш",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡什",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "27cee34e-8365-30ca-925f-15eac062070c",
                    "sense_definition": "Great; excellent; cool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new jacket you bought is very <w>cash</w>.",
                            "target_lang_translations": {
                                "ru": "Та новая куртка, которую ты купил, очень <w>крутая</w>.",
                                "zh": "你买的那件新夹克真<w>酷</w>。"
                            }
                        },
                        {
                            "text": "It wasn't very <w>cash</w> of him to leave us with all the work.",
                            "target_lang_translations": {
                                "ru": "Было не очень <w>круто</w> с его стороны оставить нас со всей работой.",
                                "zh": "他把所有工作都留给我们做，这可一点都不<w>酷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cool",
                        "awesome",
                        "excellent"
                    ],
                    "antonyms": [
                        "uncool",
                        "lame"
                    ],
                    "traits": [
