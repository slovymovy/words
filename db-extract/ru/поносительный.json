                        "source_sense_id": "cc967eb0-6f53-39c4-994e-13dcd87cf9fa",
                        "target_lang_word": "insulting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insulting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7feeaf9e-1958-376c-96c7-28d742966173",
                                        "entry_id": "9aa1dd60-525b-392a-aa19-1706a1a05265",
                                        "glosses": [
                                            "Containing insult, or having the intention of insulting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6002c4e4-133e-4000-b9c6-618a5c6fdcc5",
                                                "sense_id": "7feeaf9e-1958-376c-96c7-28d742966173",
                                                "text": "He received an insulting letter."
                                            },
                                            {
                                                "example_id": "47264f05-76e6-4738-8fb3-93db47146735",
                                                "sense_id": "7feeaf9e-1958-376c-96c7-28d742966173",
                                                "text": "Musk’s Israel tour was transparently transactional and frankly insulting. The antisemitic sentiment Musk endorsed had nothing to do with Israel; “replacement theory” is generally an unsupported allegation that Jews and other immigrants in the US and Europe are destroying Western civilization."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insulting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9d9d50-ce38-3d69-9901-25292742034a",
