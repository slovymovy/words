                                                "sense_id": "98c6ec1a-1649-339b-b606-71a5b9d2e614",
                                                "text": "Shrouded in cloth of state, balmed and entreasured / With full bags of spices!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeb9c116-f211-3dba-a5a5-8b4c971aa171",
                                        "entry_id": "d56a3104-8b11-3c2a-bde6-3fdfb220bac0",
                                        "glosses": [
                                            "To soothe; to mitigate."
                                        ],
                                        "tags": [
