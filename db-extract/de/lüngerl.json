                    {
                        "sense_id": "0d2acbca-20be-3c2b-a292-fbb5d33f3b08",
                        "entry_id": "204ebb46-c4c1-3999-b05f-8aa0af95a7c5",
                        "glosses": [
                            "Ragout aus der Lunge (und manchmal auch anderen Zutaten wie zum Beispiel Herz und Zunge) vom Kalb oder anderen Schlachttieren, oft in einer sauren Soße mit Semmelknödel serviert"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "b7e9b49a-3759-456a-876a-7a600c867505",
                                "sense_id": "0d2acbca-20be-3c2b-a292-fbb5d33f3b08",
                                "text": "„Wie war das noch mit jenem Glasmacher, dem die wohlmeinenden Kollegen heimlich das als Brotzeit mitgebrachte Lüngerl ‚streckten‘, indem sie eine gekochte, kleingeschnittene Schuhsohle untermischten?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
