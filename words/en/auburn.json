                    "sense_id": "4b126f33-61dd-3684-9f17-b5f979546fc9",
                    "sense_definition": "Of a reddish-brown colour, typically used to describe hair.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to dye her hair a deep <w>auburn</w> shade for the autumn season.",
                            "target_lang_translations": {
                                "ru": "Она решила покрасить волосы в глубокий <w>тёмно-рыжий</w> оттенок к осеннему сезону.",
                                "de": "Sie entschied sich, ihr Haar für die Herbstsaison in einem tiefen <w>kastanienbraunen</w> Ton zu färben."
                            }
                        },
                        {
                            "text": "The sunlight caught the <w>auburn</w> hair of the girl sitting by the window.",
                            "target_lang_translations": {
                                "ru": "Солнечный свет заиграл в <w>каштановых</w> волосах девушки, сидевшей у окна.",
                                "de": "Das Sonnenlicht fing sich im <w>kastanienbraunen</w> Haar des Mädchens, das am Fenster saß."
                            }
                        }
                    ],
                    "synonyms": [
                        "cupreous"
                    ],
                    "common_phrases": [
                        "auburn hair",
                        "deep auburn",
                        "auburn tresses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красновато-коричневый цвет, обычно используемый для описания волос.",
                        "de": "Eine rötlich-braune Farbe, die typischerweise zur Beschreibung von Haar verwendet wird."
                    },
