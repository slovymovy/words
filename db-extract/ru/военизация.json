                                "target_senses": [
                                    {
                                        "sense_id": "bb82a56d-7556-3b7d-b7dd-36e667ac3dae",
                                        "entry_id": "268ba235-e370-3d0c-8ef0-5b701744d7ef",
                                        "glosses": [
                                            "The process whereby some area, procedure, aspect of culture, etc., becomes controlled by the military or administered in a military fashion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2f6b46-7c00-4e85-a48f-5d9f16b42381",
                                                "sense_id": "bb82a56d-7556-3b7d-b7dd-36e667ac3dae",
                                                "text": "The masculine militarization of culture has led to a feminine eroticization."
                                            },
                                            {
                                                "example_id": "dc8846ed-5ac0-4404-92c2-ddfb1142287d",
                                                "sense_id": "bb82a56d-7556-3b7d-b7dd-36e667ac3dae",
                                                "text": "The 1990s saw a massive militarization of US police."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
