                                    {
                                        "sense_id": "3f64d5b3-7e7b-3295-9b76-7740a1b9d0a3",
                                        "entry_id": "4c699cf2-73b8-38d5-86fa-27891bb2147b",
                                        "glosses": [
                                            "fyzická láska, smyslnost"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c0920ba-9d98-485b-9f70-b54b86800193",
                                                "sense_id": "3f64d5b3-7e7b-3295-9b76-7740a1b9d0a3",
                                                "text": "Láska je základem života a erotika je jádrem lásky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c674ed85-9fae-477a-aeff-d018a0b39fbf",
                        "source_entry_id": "bf42a74a-8425-3233-bbe4-87efff1b4879",
                        "source_sense_description": "erotic literature or art",
                        "target_lang_word": "erotica",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erotica",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "076ef7c4-a772-33eb-8d73-cdb790d7609b",
                                        "entry_id": "2145a7a8-7e8c-3b6b-98e1-64181893240c",
                                        "glosses": [
                                            "erotisch kunstwerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "539bdbc3-d338-4ca1-9bfd-d99192296772",
                                                "sense_id": "076ef7c4-a772-33eb-8d73-cdb790d7609b",
                                                "text": "De Koninklijke Bibliotheek (KB) in Den Haag krijgt een heleboel vieze boekjes. Een particulier draagt zijn verzameling van ruim 1500 stukken erotica en pornografie vrijdagmiddag over."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86e67a63-235d-39ba-87a9-1ef5d74c7623",
                                        "entry_id": "2145a7a8-7e8c-3b6b-98e1-64181893240c",
                                        "glosses": [
                                            "erotische voorwerpen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2cbc23d-14fb-4494-b731-749f86950693",
                                                "sense_id": "86e67a63-235d-39ba-87a9-1ef5d74c7623",
                                                "text": "De bemoeienis van de dienstbode heeft onverwachte gevolgen. Ook blijkt de ogenschijnlijk zo naïeve Hideko geen onbeschreven blad, mede door toedoen van haar geperverteerde oom en voogd die handelt in geschreven erotica. Park Chan-wooks drievoudige vertelling plaatst dezelfde gebeurtenissen daarbij steeds in een ander perspectief, zoals in Akira Kurosawa’s klassieker Rashomon. Dat maakt zijn film, waarin subtiel wordt geacteerd, tot een sensueel schaduwspel dat grossiert in verrassingen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebb896f1-3b54-4240-aea1-4ed1caa09c5c",
                        "source_entry_id": "bf42a74a-8425-3233-bbe4-87efff1b4879",
                        "source_sense_description": "erotic literature or art",
                        "target_lang_word": "érotisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "érotisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5105782-0b7d-36c8-9750-b674ac8e4270",
                                        "entry_id": "aea0dff2-bfe2-3f06-8bb0-ee9c401f234e",
                                        "glosses": [
                                            "Propriété de dires, gestes, comportements ou tenues qui suggèrent l’amour physique afin de susciter, accompagner ou augmenter le désir sexuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1244c50d-6af6-460a-8530-28adbeefef16",
                                                "sense_id": "c5105782-0b7d-36c8-9750-b674ac8e4270",
                                                "text": "Il était la proie de Carmen […]. Et non seulement il la subissait, mais encore il la recherchait, épris de sa chair de grande amoureuse lascive et insatisfaite, parfois ruée dans des débordements insensés, de quoi combler l’imagination la plus follement macérée dans les laves de l’érotisme épuisant."
                                            },
                                            {
                                                "example_id": "1a2f7e8b-7f94-4c10-8bd5-c1dc8c34437a",
                                                "sense_id": "c5105782-0b7d-36c8-9750-b674ac8e4270",
                                                "text": "[Ils] s’émoustillaient tout en pérorant d’un érotisme curieusement élégant et cynique."
                                            },
                                            {
                                                "example_id": "9ad7809f-6b2c-4f2d-b4d1-6278e11ec183",
                                                "sense_id": "c5105782-0b7d-36c8-9750-b674ac8e4270",
                                                "text": "D’une manière générale, la densification des sentiments familiaux et l’assujettissement indolore de la sexualité qui caractérisent la conjugalité et l’intimité bourgeoises, en se diffusant dans l’ensemble du corps social, aboutissaient à faire de l’érotisme une spécialité."
                                            },
                                            {
                                                "example_id": "752d66c0-8256-4420-9b62-8c408b866c81",
                                                "sense_id": "c5105782-0b7d-36c8-9750-b674ac8e4270",
                                                "text": "Elle livrait un culte magnifique à l’érotisme, dans une sexualité débordante qui constituait pour elle la vraie musique de l'être, la fureur et l'enchantement pour \" inouïr \" la vie. Géraldine B. aimait les hommes et ceux-ci le lui rendaient à merveille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "317b3844-c37b-3860-8516-536192f36c78",
                                        "entry_id": "aea0dff2-bfe2-3f06-8bb0-ee9c401f234e",
                                        "glosses": [
                                            "Forme d'art exploitant le plaisir sensuel sans tomber dans la vulgarité."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "977673f9-e32a-4094-9c7b-d1967292aece",
                                                "sense_id": "317b3844-c37b-3860-8516-536192f36c78",
                                                "text": "J’ai contre l’érotisme que c’est avant tout la facilité. Ce n’est plus l’audace, c’est même une sorte de poncif, et il me suffit que la mode d’en soit emparée pour que je le déteste."
                                            },
                                            {
                                                "example_id": "7dc0187a-a865-4147-84bb-edeafe5b5d02",
                                                "sense_id": "317b3844-c37b-3860-8516-536192f36c78",
                                                "text": "Le discours en vigueur dans les allées du pouvoir consiste alors à opérer une dichotomie entre le noble et l'ignoble, entre l'érotisme dont Françoise Giroud dit volontiers qu'il est « chaste et cérébral » et la pornographie forcément « écœurante, déprimante et même au-delà »."
                                            },
                                            {
                                                "example_id": "eeccf5aa-b701-4640-ad0e-ea9925588704",
                                                "sense_id": "317b3844-c37b-3860-8516-536192f36c78",
                                                "text": "Des estampes japonaises d’un érotisme orthodoxe."
                                            },
                                            {
                                                "example_id": "7e6861c6-d247-4024-83a0-7b7f6474c7be",
                                                "sense_id": "317b3844-c37b-3860-8516-536192f36c78",
                                                "text": "L’érotisme de Sade est un érotisme de rêve, puisqu’il ne se réalise la plupart du temps que dans la fiction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3e533d3-f952-3c64-8cab-6349d53c279e",
                                        "entry_id": "aea0dff2-bfe2-3f06-8bb0-ee9c401f234e",
                                        "glosses": [
                                            "Propriété de certaines zones corporelles à susciter le désir sexuel."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "629030bb-6bc5-4700-be8a-623bbda61801",
                                                "sense_id": "d3e533d3-f952-3c64-8cab-6349d53c279e",
                                                "text": "Un érotisme de la peau dans le même sens qu’un érotisme des organes génitaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d06a45b2-a6c7-3bc1-92bd-256d3a86b539",
                                        "entry_id": "aea0dff2-bfe2-3f06-8bb0-ee9c401f234e",
                                        "glosses": [
                                            "Inclination au plaisir physique lié à certaines parties du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8ca1fa9-85c0-4922-a0cb-05ae1b037abc",
                                                "sense_id": "d06a45b2-a6c7-3bc1-92bd-256d3a86b539",
                                                "text": "Érotisme anal, buccal, mammaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ddf9347-6c68-41bf-8b83-31f480e35662",
                        "source_entry_id": "bf42a74a-8425-3233-bbe4-87efff1b4879",
                        "source_sense_description": "erotic literature or art",
                        "target_lang_word": "Erotik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erotik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1500a15b-4f32-34cc-a9cf-15c5a2beb490",
                                        "entry_id": "f0099ef9-3316-3a33-8860-d6126c83fb7d",
                                        "glosses": [
                                            "physische und zugleich psychische Anziehungskraft zwischen Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe395d93-b92c-49c5-b738-e9ed76f437e1",
                                                "sense_id": "1500a15b-4f32-34cc-a9cf-15c5a2beb490",
                                                "text": "„Aber wie in einem Gegensatz hierzu empfindet man Goethes Erotik als ein rein immanentes Ereignis und als habe seine Innerlichkeit dessen Kosten gleichsam allein zu tragen; und es ist wundervoll, wie das Reservierte, Selbstsüchtige, ja Rücksichtslose, das mit solchem solipsistischen Erleben der Liebe sich zu verbinden pflegt, bei ihm nie spürbar wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                        "entry_id": "f0099ef9-3316-3a33-8860-d6126c83fb7d",
                                        "glosses": [
                                            "oft nur euphemistisch für: Sex, Sexualität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee21c44-d6a9-4340-93d5-b5216cf9c540",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "In Anzeigen wird Erotik oft nur als Stichwort für alles Mögliche, was mit Sexualität zu tun hat, verwendet."
                                            },
                                            {
                                                "example_id": "2ac74348-afe0-492c-b167-2bfe16c29330",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "„Erotik war ein Gesellschaftsspiel.“"
                                            },
                                            {
                                                "example_id": "210a5384-69c2-4695-a73c-e7cdb1110003",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "„Er habe nichts gegen Erotik im Fernsehen, sagt der Mann, der jahrzehntelang Dozent am Germanistischen Institut der Universität Krakau war und sogar schon für polnische Präsidenten gedolmetscht hat.“"
                                            },
                                            {
                                                "example_id": "b6b70a38-9f15-4a27-b60e-b2aad1f2c9f9",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "„Immerhin hatte er Zeit für die Mitteilung, die azraëlistische Kirche wolle die sakrale Erotik, die im Okzident seit mehreren tausend Jahren verloren gegangen sei, neu begründen.“"
                                            },
                                            {
                                                "example_id": "3df40568-503b-4800-b276-6d3e7603ae81",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "„Sie bekam in wenigen Minuten einen kurzen, aber intensiven Lehrkurs in geflüsterter, einfachster Erotik, gegen die ein paar Straßenhunde ein ideales Liebespaar waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
