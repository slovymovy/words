                                "example_id": "8cdb0064-83bc-47f8-9e94-741e96b48cbd",
                                "sense_id": "06ccdede-c509-3851-9810-312765c4faaf",
                                "text": "„Der Radverkehr kann vorerst weiter über die Düsseldorfer Einkaufsmeile Schadowstraße in der Innenstadt fahren.“"
                            },
                            {
                                "example_id": "ade255bd-a5a8-4bef-9846-a163e41b971d",
                                "sense_id": "06ccdede-c509-3851-9810-312765c4faaf",
                                "text": "„In der wichtigen Einkaufsmeile sollen bald neue Baum- und Blumenbeete sowie ein Spielbereich und Sitzplätze entstehen.“"
                            },
                            {
                                "example_id": "58b53ec5-a808-4890-a904-f3161bc4da1d",
                                "sense_id": "06ccdede-c509-3851-9810-312765c4faaf",
                                "text": "„Durmersheim verwandelt am 30. März seine Hauptstraße in eine pulsierende Einkaufsmeile.“"
                            }
