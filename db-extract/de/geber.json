                "translations": [
                    {
                        "translation_id": "a5986e89-2d8d-45b3-b6c5-637b41d67fcf",
                        "source_entry_id": "8ccbce74-1695-33f3-b824-f94e15948c92",
                        "source_sense_id": "2077440e-a223-3284-a15a-283e4f737686",
                        "source_sense_description": "jemand, der etwas gibt",
                        "target_lang_word": "податель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "податель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "380c2024-5d7f-3c75-947c-d609be6d3261",
                                        "entry_id": "91e44e0e-2ce6-3433-8461-a11f9d2cb5d8",
                                        "glosses": [
                                            "разг. тот, кто дает, жертвует, преподносит что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea589dd-4f3c-48b3-8f31-6cffc50f4d47",
                                                "sense_id": "380c2024-5d7f-3c75-947c-d609be6d3261",
                                                "text": "Они друг друга ненавидят и властию господина своего влекутся на казнь, к алтарю отца всех благ, подателя нежных чувствований и веселий, зиждителя истинного блаженства, творца вселенный."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf86b02-3e8a-3bbf-b911-56862615b858",
                                        "entry_id": "91e44e0e-2ce6-3433-8461-a11f9d2cb5d8",
                                        "glosses": [
                                            "разг. тот, кто собственноручно предъявляет по назначению письмо, документ и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a727eb7-d3a8-4485-b6c4-709d3c2ca0c7",
                                                "sense_id": "bdf86b02-3e8a-3bbf-b911-56862615b858",
                                                "text": "Англичане сначала не поняли, в чём дело, но, увидев потом, что это был вексель на значительную сумму, адресованный к их банкиру в Севилье, с требованием немедленно заплатить по нём подателю его, они рассердились и вздумали угрозами запугать разбойника."
                                            },
                                            {
                                                "example_id": "c5479c14-ce27-4d79-baa5-5e6ef3888d2d",
                                                "sense_id": "bdf86b02-3e8a-3bbf-b911-56862615b858",
                                                "text": "Посылаю тебе подателя сей записки для принятия твоего чемодана и ожидаю вас для распития русского чаю."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
