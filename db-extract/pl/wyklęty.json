                ],
                "senses": [
                    {
                        "sense_id": "e4b8643f-e2f6-3806-a37d-5365b7b600bf",
                        "entry_id": "8705dac2-bac1-314c-8512-fa5fcbeead04",
                        "glosses": [
                            "taki, który przez swoją niezgodność z jakim wzorcem albo jaką normą został potępiony i usunięty z określonej dziedziny życia społecznego"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "64c756db-277f-4da9-9970-82723cd41672",
                                "sense_id": "e4b8643f-e2f6-3806-a37d-5365b7b600bf",
                                "text": "Już dawno nie kojarzono go z wyklętym poetą, kochankiem z tonącego okrętu, młodym gangsterem podróżującym między metropoliami. Ale był wciąż rozpoznawalny"
                            },
                            {
                                "example_id": "8c97d983-6c5a-40ff-87d0-20b8965fcd5a",
                                "sense_id": "e4b8643f-e2f6-3806-a37d-5365b7b600bf",
                                "text": "Jakże daleko jesteśmy od malarzy wyklętych XIX wieku — to prędzej rubensowska tradycja"
                            },
                            {
                                "example_id": "9106ea13-e596-45cd-9162-0e84aa811876",
                                "sense_id": "e4b8643f-e2f6-3806-a37d-5365b7b600bf",
                                "text": "W zamkniętym świecie, w którym tradycyjne role społeczne są ściśle określone i jednoznacznie przypisane płci, na ich wyklętą miłość nie ma miejsca"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
