                ],
                "senses": [
                    {
                        "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                        "entry_id": "c6c9a21f-6611-3cf2-926e-63ceddff3eca",
                        "glosses": [
                            "grundlegende Umstellung der Produktion von Lebensmitteln durch scharfe Vorgaben für Bauern (beispielsweise für den Pestizid- und Düngemitteleinsatz, die Gülleausbringung, Tierhaltungsvorschriften)"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "969e054d-c4a3-421a-8c26-3986435a0794",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "[Schlagzeile:] „Agrarwende – Wie geht Landwirtschaft besser?“"
                            },
                            {
                                "example_id": "bd9c8357-9705-4539-99e6-1b7800c51b75",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Hofreiter setzt sich stark für eine Agrarwende ein.“"
                            },
                            {
                                "example_id": "75211ad1-9716-4791-9980-af1ae645424c",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Die Agrarwende, vor mehr als 20 Jahren von der damaligen Landwirtschaftsministerin Renate Künast ausgerufen, zieht sich zäher in die Länge als von vielen erhofft.“"
                            },
                            {
                                "example_id": "6268805d-d99f-4b7d-afe2-4aa0346a84ba",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Dabei ist allen klar: Eine Agrarwende ist dringend notwendig, um Natur zu erhalten und auf lange Sicht die Nahrungsmittelproduktion zu sichern.“"
                            },
                            {
                                "example_id": "b4dbc984-9b57-44c9-a4e4-887aaf360e3e",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "[Artenschutz:] „Eine Agrarwende fordern Wissenschaftler jetzt immer dringlicher, um zu retten, was noch zu retten ist.“"
                            },
                            {
                                "example_id": "6fe71064-f41e-4f26-b5ba-70007c0c89f6",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "[Klimaschutz:] „Und drittens brauchen wir natürlich auch eine Agrarwende, weil auch durch die industrielle Landwirtschaft viele Treibhausgase in die Atmosphäre kommen.“"
                            },
                            {
                                "example_id": "7213ab38-58c1-4eee-9448-c06ae2ece324",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Weltweit werden immer mehr Pestizide gespritzt mit verheerenden Folgen für Mensch und Natur. Der Druck für eine Agrarwende wächst.“"
                            },
                            {
                                "example_id": "da267320-2728-4a33-9674-63d49591f2db",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Solange dort Tierschutzreferenten arbeiten, die behaupten, die Legebatterien bereiteten den Hennen \"keine erheblichen Leiden\", wird die Agrarwende kaum im Sinne artgerechterer Tierhaltung zu bewerkstelligen sein.“"
                            },
                            {
                                "example_id": "86e57dfd-d7d5-46d8-85da-fc6d2ecf0cad",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Mehr Platz für Nutztiere, mehr Bio soll die Agrarwende bringen: Doch bei Norddeutschlands Bauern stoßen die Agrarminister damit auf taube Ohren, werden sogar vom Podium gepfiffen...“"
                            },
                            {
                                "example_id": "5eda3a6e-8259-462e-8465-453a87256aed",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Kurz vor den Regionalwahlen kocht in der französischen Bretagne der Streit um die Agrarwende hoch. Während Umweltschützer das Ende der intensiven Landwirtschaft fordern, sehen Tierzüchter ihre Betriebe wegen zu hoher Auflagen in Gefahr.“"
                            },
                            {
                                "example_id": "60803ee5-d279-477a-b144-89af866e45d4",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„An diesem Samstag (16.01.2016) findet die sechste Großdemonstration für eine Agrarwende in Deutschland statt.“"
                            },
                            {
                                "example_id": "3b88ccaf-0585-4592-853a-ddadb3ed454a",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Wie aber soll eine Agrarwende ohne die Bauern gelingen?“"
                            },
                            {
                                "example_id": "65519893-90be-44d8-b176-c7880f637375",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "[Schlagzeile:] „Agrar-Atlas 2019: Keine Agrarwende in der EU“"
                            },
                            {
                                "example_id": "c052911c-4789-44f7-a6be-b57d7879071c",
                                "sense_id": "f1f3da2f-e119-316b-9d72-b94a40b37169",
                                "text": "„Die von Klimaaktivisten geforderten Maßnahmen von der Agrarwende bis zur Verkehrswende sind allesamt gut zu begründen und bei entsprechend veränderter Prioritätensetzung technisch wie finanziell machbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
