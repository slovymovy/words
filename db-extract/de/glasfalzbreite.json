                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8f228f0-75f6-4e53-aa11-4e89882b3413",
                                "sense_id": "809e7929-cc01-35bc-928e-77d9eb522ae8",
                                "text": "„Entsprechend der Glasgröße und Glasstärke werden die Glasfalzhöhe und Glasfalzbreite ermittelt.“"
                            },
                            {
                                "example_id": "9cd29abc-ed0b-4d08-aabe-995243b9256f",
                                "sense_id": "809e7929-cc01-35bc-928e-77d9eb522ae8",
                                "text": "„Diese 22,5 mm breite Leiste ist für die Verglasung in Flügelprofilen bei einer Glasfalzbreite von 28 mm vorgesehen.“"
                            },
                            {
                                "example_id": "452d06ce-bb20-4095-97bb-c6c7cc738915",
                                "sense_id": "809e7929-cc01-35bc-928e-77d9eb522ae8",
                                "text": "„Die Lüftungsglasleiste ist 25,5 mm breit und vorgesehen für die Verglasung in Flügelprofilen bei einer Glasfalzbreite von 28 mm, d. h. für circa 20 mm dickes Isolierglas.“"
                            }
                        ],
