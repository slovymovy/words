{
    "word_family": [
        "compassion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4175d86f-70f8-35b4-af0f-976ad34efb31",
                    "sense_definition": "Feeling or showing sympathy and concern for others who are suffering or in distress.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "compassion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>compassionate</w> nurse stayed by the patient's side throughout the entire night.",
                            "target_lang_translations": {
                                "ru": "<w>Сострадательная</w> медсестра оставалась рядом с пациентом всю ночь."
                            }
                        },
                        {
                            "text": "She is a <w>compassionate</w> person who always tries to help those in need.",
                            "target_lang_translations": {
                                "ru": "Она <w>сострадательный</w> человек, который всегда старается помочь нуждающимся."
                            }
                        }
                    ],
                    "synonyms": [
                        "empathetic",
                        "sympathetic"
                    ],
                    "common_phrases": [
                        "compassionate person",
                        "compassionate heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или проявляющий сострадание и заботу о тех, кто страдает или находится в беде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сострада́тельный",
                                "target_lang_sense_clarification": "склонный к состраданию, жалостливый"
                            },
                            {
                                "target_lang_word": "сочу́вствующий",
                                "target_lang_sense_clarification": "выражающий сочувствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42dbb587-9d9e-3740-a816-afd417ee3278",
                    "sense_definition": "Granted as an exception due to urgent personal or family circumstances.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "compassion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was granted <w>compassionate</w> leave to attend his father's funeral.",
                            "target_lang_translations": {
                                "ru": "Ему предоставили отпуск <w>по семейным обстоятельствам</w>, чтобы он мог присутствовать на похоронах отца."
                            }
                        },
                        {
                            "text": "The government issued a <w>compassionate</w> visa for the family to reunite during the crisis.",
                            "target_lang_translations": {
                                "ru": "Правительство выдало семье <w>гуманитарную</w> визу для воссоединения во время кризиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "compassionate leave",
                        "compassionate visa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставляемый в качестве исключения из-за неотложных личных или семейных обстоятельств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по семейным обстоятельствам",
                                "target_lang_sense_clarification": "устойчивое выражение для отпуска или освобождения от обязанностей"
                            },
                            {
                                "target_lang_word": "гуманитарный",
                                "target_lang_sense_clarification": "связанный с гуманитарными причинами (например, о визе)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed093179-1e73-303a-adb0-3482766f0d2f",
                    "sense_definition": "Arousing or deserving of pity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beggar presented a <w>compassionate</w> sight to all who passed by.",
                            "target_lang_translations": {
                                "ru": "Нищий представлял собой <w>жалкое</w> зрелище для всех проходящих мимо."
                            }
                        },
                        {
                            "text": "It was a <w>compassionate</w> situation that moved the entire town to action.",
                            "target_lang_translations": {
                                "ru": "Это была <w>трогательная</w> ситуация, которая побудила весь город к действиям."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitiable"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий жалость или сострадание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "вызывающий жалость"
                            },
                            {
                                "target_lang_word": "достойный сострадания",
                                "target_lang_sense_clarification": "тот, кому следует сочувствовать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c580bab9-a2fc-3a11-8bf6-c77fd05e7ea1",
                    "sense_definition": "To feel or express sympathy for someone's suffering.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "compassion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge could not help but <w>compassionate</w> the defendant's difficult upbringing.",
                            "target_lang_translations": {
                                "ru": "Судья не мог не <w>сострадать</w> подсудимому из-за его тяжелого детства."
                            }
                        },
                        {
                            "text": "Friends gathered to <w>compassionate</w> his loss after the tragic accident.",
                            "target_lang_translations": {
                                "ru": "Друзья собрались, чтобы <w>выразить сочувствие</w> в связи с его утратой после трагического происшествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "pity",
                        "commiserate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is rarely encountered in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать или выражать сочувствие к чьим-либо страданиям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сострада́ть",
                                "target_lang_sense_clarification": "разделять чье-то горе или страдание"
                            },
                            {
                                "target_lang_word": "сочу́вствовать",
                                "target_lang_sense_clarification": "относиться с состраданием к переживаниям другого"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}