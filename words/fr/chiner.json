                    "frequency": "Middle",
                    "semantic_group_id": "brocante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dimanche matin, nous adorons <w>chiner</w> dans les brocantes pour trouver des livres anciens."
                        },
                        {
                            "text": "Elle a réussi à <w>chiner</w> un joli meuble en bois pour son salon."
                        }
                    ],
                    "synonyms": [
