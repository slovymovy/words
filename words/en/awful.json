                {
                    "sense_id": "c513e569-484d-3339-a59c-08b3981dd16c",
                    "sense_definition": "Very large or great; used to emphasize an amount.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It costs an <w>awful</w> lot of money to buy a house in this city.",
                            "target_lang_translations": {
                                "ru": "Покупка дома в этом городе стоит <w>ужасно</w> много денег.",
                                "tr": "Bu şehirde bir ev satın almak <w>korkunç</w> miktarda para tutuyor.",
                                "zh": "在这个城市买房需要花费<w>大量</w>的钱。"
                            }
                        },
                        {
                            "text": "She has been making an <w>awful</w> amount of noise since she arrived.",
                            "target_lang_translations": {
                                "ru": "Она производит <w>ужасное</w> количество шума с тех пор, как приехала.",
