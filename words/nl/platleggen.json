                    "common_phrases": [
                        "het verkeer platleggen",
                        "een systeem platleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause a system, network, or process to stop functioning",
                        "ru": "вызывать остановку работы системы, сети или процесса"
