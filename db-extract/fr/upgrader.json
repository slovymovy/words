                    {
                        "sense_id": "a3e3770e-70ef-3b07-a03a-4ce44526dc97",
                        "entry_id": "2f347dd7-7a7d-3c1b-a357-37916d676400",
                        "glosses": [
                            "Unité de traitement du pétrole brut lourd, pour le transformer en brut synthétique léger."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "bcc49791-2eed-4c46-8911-1ef4f1404914",
                                "sense_id": "a3e3770e-70ef-3b07-a03a-4ce44526dc97",
                                "text": "Le brut lourd est transformé en un brut plus léger, (brut dit synthétique), facilement utilisable, dans un upgrader, sorte de raffinerie complexe où les molécules lourdes sont transformées en molécules plus légères et où le brut est débarrassé d'une bonne partie de ses impuretés."
                            }
                        ]
                    }
                ],
