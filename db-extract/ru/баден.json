                        "cross_references": [
                            {
                                "target_word": "Bade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6efabe68-bc68-3cd1-a797-5f49affe4fff",
                                        "entry_id": "abd424c1-a023-367e-884d-cd7e3fb0b2d0",
                                        "glosses": [
                                            "Région du sud-ouest de l'Allemagne faisant partie du Land de Bade-Wurtemberg qui forme un couloir occupant une partie de la plaine du Rhin et de la Forêt-Noire."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f918b544-58f7-4a9e-a0dd-1ace3a6ee20b",
                                                "sense_id": "6efabe68-bc68-3cd1-a797-5f49affe4fff",
                                                "text": "Le margraviat de Bade est divisé en deux parties, le haut & le bas margraviat ; il est borné au septentrion par le Palatinat & l’évêché de Spire ; à l’orient, par le duché de Wirtemberg & la principauté de Furstemberg ; au midi, par le Brisgaw ; à l’occident, par le Rhin."
                                            },
                                            {
                                                "example_id": "31f1d9b5-3171-4d69-a0f9-4130a6cc023d",
                                                "sense_id": "6efabe68-bc68-3cd1-a797-5f49affe4fff",
                                                "text": "Plus que le pays de Bade, l’Alsace montre des friches ou de semi-abandons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bade",
                                "target_lang_code": "fr",
                                "target_senses": [
