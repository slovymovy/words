                ],
                "senses": [
                    {
                        "sense_id": "ef3ad533-781f-3285-979d-ea75b3d74c65",
                        "entry_id": "c7409b38-6740-3d5e-bb17-9f7a27fdac12",
                        "glosses": [
                            "Person, die nicht dem Militär angehört und kein Mitglied einer anderen Kampforganisation ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bafc967c-cd81-468c-8683-7ea4c335a4f1",
                                "sense_id": "ef3ad533-781f-3285-979d-ea75b3d74c65",
                                "text": "„Bei der zertrümmerten Barrikade fanden sie mehrere tote Zivilpersonen, unter ihnen auch kahlgeschorene Häftlinge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d379660d-b791-4461-aed4-f152392dec5a",
                        "source_entry_id": "c7409b38-6740-3d5e-bb17-9f7a27fdac12",
                        "source_sense_id": "ef3ad533-781f-3285-979d-ea75b3d74c65",
                        "source_sense_description": "Person, die nicht dem Militär angehört und kein Mitglied einer anderen Kampforganisation ist",
                        "target_lang_word": "civilian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civilian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c97a97ae-2bee-3a48-a9de-e9da68e1b3ad",
                                        "entry_id": "cefc4b97-a1ef-3c07-bb68-d07e825c2278",
                                        "glosses": [
                                            "A person following the pursuits of civil life, especially one who is not an active member of the armed forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb02b879-3990-41a4-96ee-bbeede25740a",
                                                "sense_id": "c97a97ae-2bee-3a48-a9de-e9da68e1b3ad",
                                                "text": "An army never can be commanded or controlled by civilians."
                                            },
                                            {
                                                "example_id": "b3cdd749-f704-4eaf-ae6a-8e5bd7ec5d7b",
                                                "sense_id": "c97a97ae-2bee-3a48-a9de-e9da68e1b3ad",
                                                "text": "Three civilians were apprehended by the soldiers and taken away in a military vehicle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b50d186-7938-3cf5-9a0a-28f9fbc423c9",
                                        "entry_id": "cefc4b97-a1ef-3c07-bb68-d07e825c2278",
                                        "glosses": [
                                            "A person who does not belong to a particular group or engage in a particular activity, an outsider."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805b70da-d383-4594-83ab-84c2f754fe15",
                                                "sense_id": "4b50d186-7938-3cf5-9a0a-28f9fbc423c9",
                                                "text": "I have this vision one day that I'll walk amongst you a regular civilian."
                                            },
                                            {
                                                "example_id": "d6196db9-70ab-48de-bcad-58d568d1c53e",
                                                "sense_id": "4b50d186-7938-3cf5-9a0a-28f9fbc423c9",
                                                "text": "The bathroom was for employees only, so civilians weren't allowed to use it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f7dc37-3422-3e7e-b0b0-e157fa088d67",
                                        "entry_id": "cefc4b97-a1ef-3c07-bb68-d07e825c2278",
                                        "glosses": [
                                            "One skilled in civil law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f97601-1a75-4ae9-a2b4-c26de9251ed2",
                                                "sense_id": "f5f7dc37-3422-3e7e-b0b0-e157fa088d67",
                                                "text": "Ancient civilians and writers upon government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87f60a22-5e22-3196-8fb1-2728a2ccfd6a",
                                        "entry_id": "cefc4b97-a1ef-3c07-bb68-d07e825c2278",
                                        "glosses": [
                                            "A student of civil law at a university or college."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26442761-ee38-408c-97de-15aae0e88f08",
                                                "sense_id": "87f60a22-5e22-3196-8fb1-2728a2ccfd6a",
                                                "text": "although he kept his name in the college books, and changed his commoner gown to that of a civilian, yet he had now, I believe, no thoughts of proceeding to any degree; and seldom resided in college any more"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c480ed4a-a563-324f-b226-b16f7c0bf378",
                                        "entry_id": "cefc4b97-a1ef-3c07-bb68-d07e825c2278",
                                        "glosses": [
                                            "An employee of the civil service."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "civilian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7040aad4-08dd-3015-a347-6c617fd64dcc",
                                        "entry_id": "339c3337-7589-3331-a396-9709b94cf7b7",
                                        "glosses": [
                                            "Not related to the military, police or other governmental professions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11738b98-32e1-413e-9d65-798f3455cc15",
                                                "sense_id": "7040aad4-08dd-3015-a347-6c617fd64dcc",
                                                "text": "The three detainees were actually army defectors wearing civilian clothing."
                                            },
                                            {
                                                "example_id": "6951ddad-102f-4585-99d7-378741a83dd4",
                                                "sense_id": "7040aad4-08dd-3015-a347-6c617fd64dcc",
                                                "text": "He worked as a civilian journalist for ten years before being employed by the public broadcaster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd378da9-85c7-4e15-9125-e2d1a2452c88",
                        "source_entry_id": "c7409b38-6740-3d5e-bb17-9f7a27fdac12",
                        "source_sense_id": "ef3ad533-781f-3285-979d-ea75b3d74c65",
                        "source_sense_description": "Person, die nicht dem Militär angehört und kein Mitglied einer anderen Kampforganisation ist",
                        "target_lang_word": "civil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddb49eb9-fea8-3977-96bb-24b4099eae6a",
                                        "entry_id": "47f4ddbd-cbf1-34ff-80bf-9dd081a85a4c",
                                        "glosses": [
                                            "Citoyen ; relatif aux citoyens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a12bf8-86e5-4406-b4ac-b14e022e3f1b",
                                                "sense_id": "ddb49eb9-fea8-3977-96bb-24b4099eae6a",
                                                "text": "La vie, la société civile."
                                            },
                                            {
                                                "example_id": "671a2eb3-cbe8-4ad2-b5c8-783eecaa6523",
                                                "sense_id": "ddb49eb9-fea8-3977-96bb-24b4099eae6a",
                                                "text": "La vigueur qui, durant cinq ans, lui fit dévouer sa tête aux fureurs civiles,"
                                            },
                                            {
                                                "example_id": "73b988ff-81f0-4b53-93f0-a56012662b5e",
                                                "sense_id": "ddb49eb9-fea8-3977-96bb-24b4099eae6a",
                                                "text": "Un parti qui causa quelque émeute civile,"
                                            },
                                            {
                                                "example_id": "350c3078-5cbf-4723-b553-6e02b51641f3",
                                                "sense_id": "ddb49eb9-fea8-3977-96bb-24b4099eae6a",
                                                "text": "Soit qu’en sa dernière tête L'hydre civile t’arrête,"
                                            },
                                            {
                                                "example_id": "a10eccf0-e60c-4694-b9ec-d8f04cfb36d1",
                                                "sense_id": "ddb49eb9-fea8-3977-96bb-24b4099eae6a",
                                                "text": "Les vertus civiles, qui font toute la douceur et toute l’harmonie de la société,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdc019f5-a9b4-3e88-ae12-0799a954ffde",
                                        "entry_id": "47f4ddbd-cbf1-34ff-80bf-9dd081a85a4c",
                                        "glosses": [
                                            "Relatif à l’état civil des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dc894ac-19a2-4d7e-865c-89d6c5c5a174",
                                                "sense_id": "bdc019f5-a9b4-3e88-ae12-0799a954ffde",
                                                "text": "Actes civils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d03da461-78fe-341d-b15b-0c2050c683ba",
                                        "entry_id": "47f4ddbd-cbf1-34ff-80bf-9dd081a85a4c",
                                        "glosses": [
                                            "Qualifie le droit relatif à la personne physique, c’est-à-dire l'ensemble des règles qui déterminent le statut des personnes, aux relations juridiques entre elles, et aux biens. → voir droit civil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63a2768-6d40-4b1d-baca-a17c51857088",
                                                "sense_id": "d03da461-78fe-341d-b15b-0c2050c683ba",
                                                "text": "Le droit de justice des seigneurs hauts justiciers était absolu. Il emportait la plénitude de la juridiction civile et criminelle, limitée seulement par les cas royaux."
                                            },
                                            {
                                                "example_id": "4f9bfcf0-8702-4fa7-9453-37222378982b",
                                                "sense_id": "d03da461-78fe-341d-b15b-0c2050c683ba",
                                                "text": "Intérêts civils, le dédommagement dû sur les biens d’un criminel à celui qui a souffert du crime."
                                            },
                                            {
                                                "example_id": "7161c478-8ffa-43f1-94ce-3a8be51a5509",
                                                "sense_id": "d03da461-78fe-341d-b15b-0c2050c683ba",
                                                "text": "Les effets civils d’un jugement criminel."
                                            },
                                            {
                                                "example_id": "958a1003-fba8-4eb1-8caa-abf0af8527c9",
                                                "sense_id": "d03da461-78fe-341d-b15b-0c2050c683ba",
                                                "text": "Requête civile, voie extraordinaire admise par la loi en certain cas pour faire rétracter un jugement ou arrêt rendu en dernier ressort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b41635-bdc2-374f-b720-eaf2da1cc4d1",
                                        "entry_id": "47f4ddbd-cbf1-34ff-80bf-9dd081a85a4c",
                                        "glosses": [
                                            "Qui n'est ni militaire, ni religieux, ni politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536f3860-1816-4ab6-9b78-10bf5d6029f5",
                                                "sense_id": "e8b41635-bdc2-374f-b720-eaf2da1cc4d1",
                                                "text": "Car loin d'être uniquement des victimes civiles collatérales, les envahis et occupés deviennent des cibles pour l’occupant."
                                            },
                                            {
                                                "example_id": "189752e0-4e78-4cef-a606-8dca379ac7ac",
                                                "sense_id": "e8b41635-bdc2-374f-b720-eaf2da1cc4d1",
                                                "text": "Cette partie, appelée passementerie d’or et d’argent, comprenait les épaulettes, les dragonnes, les aiguillettes, enfin cette immense quantité de choses brillantes qui scintillaient sur les riches uniformes de l’armée française et sur les habits civils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39970ba2-78d9-34a1-a0fc-3336dc11eaa2",
                                        "entry_id": "47f4ddbd-cbf1-34ff-80bf-9dd081a85a4c",
                                        "glosses": [
                                            "Qualifie le mariage contracté devant un officier d’état-civil"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc962eec-9941-3789-a4e6-ea22be55190b",
                                        "entry_id": "47f4ddbd-cbf1-34ff-80bf-9dd081a85a4c",
                                        "glosses": [
                                            "Qualifie les obsèques faites sans aucune cérémonie religieuse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f24a558b-931a-3927-a073-cc5a19762bed",
                                        "entry_id": "47f4ddbd-cbf1-34ff-80bf-9dd081a85a4c",
                                        "glosses": [
                                            "Qui appartient à la société, par opposition à sauvage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d78a26f-53eb-4915-8f70-add032ec0e39",
                                                "sense_id": "f24a558b-931a-3927-a073-cc5a19762bed",
                                                "text": "Ces peuples ne se sont point formés eux-mêmes par degrés ; ils ont été transportés du fond des forêts et de l’état sauvage au milieu des cités et de l’état civil,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a942caa5-2573-3785-83be-d683afc7e05b",
                                        "entry_id": "47f4ddbd-cbf1-34ff-80bf-9dd081a85a4c",
                                        "glosses": [
                                            "Affable ; poli ; courtois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9878d1b-f961-4f65-a388-70f2eaed1e46",
                                                "sense_id": "a942caa5-2573-3785-83be-d683afc7e05b",
                                                "text": "C'est une loûable adresse de faire recevoir doucement un refus par des paroles civiles qui réparent le défaut du bien que l'on ne peut accorder."
                                            },
                                            {
                                                "example_id": "76a79330-e422-46a7-8e05-f88e075b5ad7",
                                                "sense_id": "a942caa5-2573-3785-83be-d683afc7e05b",
                                                "text": "Il me semble que ce maraud nous écoute, dit Coconnas, qui, en sa qualité de Piémontais, était fort rancunier, et qui ne pouvait passer au maître de la Belle-Étoile la façon peu civile dont il recevait les voyageurs."
                                            },
                                            {
                                                "example_id": "aa4a58ac-ceb9-4bb5-9d6a-9b1b64031f21",
                                                "sense_id": "a942caa5-2573-3785-83be-d683afc7e05b",
                                                "text": "Reconnaissez le héros qui, toujours égal à lui-même, sans se hausser pour paraître grand, sans s’abaisser pour être civil et obligeant, se trouve naturellement tout ce qu’il doit être en vers tous les hommes,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "civil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87179499-f9b2-391f-aa54-916ee75c3ba6",
                                        "entry_id": "66a4397c-46b2-3bb3-89bb-a4fb7976e85b",
                                        "glosses": [
                                            "Statut des citoyens qui ne sont pas militaires"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f52e13-57c2-4597-951e-45e8aa4d5cf9",
                                                "sense_id": "87179499-f9b2-391f-aa54-916ee75c3ba6",
                                                "text": "J'ai rencontré, parmi mes camarades de réserve, de hauts fonctionnaires, des chefs de grandes entreprises privées. Tous , comme moi, s'effaraient d'être contraints à des besognes paperassières que, dans le civil, ils auraient abandonnées aux plus modestes de leurs sous-ordres."
                                            },
                                            {
                                                "example_id": "ed3a1006-2d9e-4c8c-a250-f9ae8ea26d95",
                                                "sense_id": "87179499-f9b2-391f-aa54-916ee75c3ba6",
                                                "text": "Et son cousin, c'est pas un con, puisqu'il est facteur dans le civil et qu'il a fait son sapin dans la colo avec de vrais durs qui n'entamaient jamais une belote sans avoir à portée de main leur carton de douze bières chacun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ef950a-afca-35ea-9e62-60f9801f881d",
                                        "entry_id": "66a4397c-46b2-3bb3-89bb-a4fb7976e85b",
                                        "glosses": [
                                            "Personne de la population qui n'a pas le statut de combattant et qui n'est ni un prisonnier de guerre, ni un combattant ne prenant plus part aux hostilités (blessé, naufragé, malade, etc)."
                                        ],
                                        "tags": [],
                                        "note": "un civil qui prend les armes, en droit international des conflits armés, perd la protection qui lui est offerte en tant que civil jusqu'à ce qu'il dépose à nouveau les armes",
                                        "examples": [
                                            {
                                                "example_id": "238e32eb-4e5c-45fe-b6a3-e63c98da344b",
                                                "sense_id": "b1ef950a-afca-35ea-9e62-60f9801f881d",
                                                "text": "Obsédées par la crainte des « francs-tireurs », les troupes d'invasion ont déjà, le 24 août, incendié Haybes et mis à mort soixante civils du lieu, avec une grande cruauté […]"
                                            },
                                            {
                                                "example_id": "f92ecf97-dc25-42cf-8eca-499ccb9f54ba",
                                                "sense_id": "b1ef950a-afca-35ea-9e62-60f9801f881d",
                                                "text": "8 novembre : Nous allons à Villers-le-Tilleul. Il y a 1 000 civils, nous sommes les premiers cavaliers qu'ils voient. Nous sommes une dizaine avec le commandant. Les civils nous embrassent, ils pleurent de joie."
                                            },
                                            {
                                                "example_id": "96790f6e-f563-4773-b846-a1504a0d761b",
                                                "sense_id": "b1ef950a-afca-35ea-9e62-60f9801f881d",
                                                "text": "Loin des réalités du front, les civils se laissaient plus facilement bourrer le crâne, selon l'expression familière aux combattants. À moins qu'ils n'aient adopté, par conformisme, le langage imposé par la société."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ae26cb6-e980-35fc-853a-981389b3954b",
                                        "entry_id": "66a4397c-46b2-3bb3-89bb-a4fb7976e85b",
                                        "glosses": [
                                            "Partie de la justice qui ressortit du code civil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cee76c9-ed02-46e0-9e5c-99f95a8c75aa",
                                                "sense_id": "3ae26cb6-e980-35fc-853a-981389b3954b",
                                                "text": "Vous pouvez le poursuivre au civil, mais non au criminel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
