                    "frequency": "Low",
                    "semantic_group_id": "timid_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee criticized the politician for offering a <w>milquetoast</w> response to the crisis."
                        },
                        {
                            "text": "His <w>milquetoast</w> attitude made it impossible for him to negotiate a better salary."
                        }
                    ],
                    "synonyms": [
                        "feeble",
                        "ineffectual",
                        "insipid"
                    ],
                    "common_phrases": [
                        "milquetoast response",
                        "milquetoast approach"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f5e6331-3ab1-339a-83fa-3e08c29a626e",
                    "sense_definition": "A meek, submissive, or timid person who lacks character, spine, or resolve.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "timid_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was such a <w>milquetoast</w> that he apologized even when other people bumped into him."
                        },
                        {
                            "text": "The company needed a decisive executive, not another <w>milquetoast</w> who yielded to every demand."
                        }
                    ],
