                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5bcd031-7548-34ba-b3dd-b55928714a86",
                        "entry_id": "34da471b-c22e-3cf9-b520-26b133385b6c",
                        "glosses": [
                            "bijzonder mooi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1da46de-009c-44bd-8661-9291ebfff3a0",
                                "sense_id": "a5bcd031-7548-34ba-b3dd-b55928714a86",
                                "text": "Hij maakte de prachtigste tekeningen."
                            },
                            {
                                "example_id": "dc59f6bd-0139-4527-a797-2fcd0df62ed6",
                                "sense_id": "a5bcd031-7548-34ba-b3dd-b55928714a86",
                                "text": "En over zijn graf werd een prachtige kerk gebouwd, die het middelpunt werd van de Nicolaasverering."
                            },
                            {
                                "example_id": "d4e65255-b39c-474e-bb15-48ea2b092424",
                                "sense_id": "a5bcd031-7548-34ba-b3dd-b55928714a86",
                                "text": "Helaas was er geen tijd om te genieten van het prachtige uitzicht want we moesten zo snel mogelijk de berg af zien te komen: het weer zou zo weer kunnen omslaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be097590-84c2-4f74-adc0-af47e19693e4",
                        "source_entry_id": "34da471b-c22e-3cf9-b520-26b133385b6c",
                        "source_sense_id": "a5bcd031-7548-34ba-b3dd-b55928714a86",
                        "source_sense_description": "bijzonder mooi",
                        "target_lang_word": "beautiful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beautiful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "Possessing beauty, impressing the eye; attractive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7660656-96d7-4fe3-ba44-761534bc1048",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "Anyone who has ever met her thought she was absolutely beautiful."
                                            },
                                            {
                                                "example_id": "025f4c93-7484-4ab0-9e5f-48b2eef399c0",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "There's a beautiful lake by the town."
                                            },
                                            {
                                                "example_id": "afb8746d-45e5-48fa-9bca-c470eca5e72c",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "“Is Olga de Coude very beautiful?” she asked. And Tarzan laughed and kissed her again. “Not one-tenth so beautiful as you, dear,” he said."
                                            },
                                            {
                                                "example_id": "e90beb53-d43f-4be0-b1ee-5c8d618ebab1",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion."
                                            },
                                            {
                                                "example_id": "142b8518-087a-4bd1-98c1-1f3974e356d0",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "It is a beautiful kitchen! — It is beautiful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be27594f-d02e-3f3b-91b8-82d865f2fd21",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "Possessing beauty, impressing the eye; attractive.",
                                            "Used emphatically or ironically, after the noun it qualifies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8be6dd6f-d54b-4f51-8574-a33ed5551764",
                                                "sense_id": "be27594f-d02e-3f3b-91b8-82d865f2fd21",
                                                "text": "the house beautiful"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c5df40-ae28-3d9d-8746-b5db355e021e",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "That one likes very much."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e86672b-9b77-4a9e-9fd4-22bd509ec015",
                                                "sense_id": "56c5df40-ae28-3d9d-8746-b5db355e021e",
                                                "text": "He was a beautiful person; he would drop everything to help you."
                                            },
                                            {
                                                "example_id": "2c0dcfb3-5c40-45b2-8e4b-2bfe034430b4",
                                                "sense_id": "56c5df40-ae28-3d9d-8746-b5db355e021e",
                                                "text": "You've done a beautiful thing today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "335fbc71-e26f-3b28-ba73-c7726575aa79",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "Affording pleasure to any of the senses, especially that of hearing; delightful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29be4c44-20e7-43dd-b9b9-cd439119fa13",
                                                "sense_id": "335fbc71-e26f-3b28-ba73-c7726575aa79",
                                                "text": "Beethoven's most beautiful sonata"
                                            },
                                            {
                                                "example_id": "e564c1a9-e540-498c-b6fd-4a2b7f11462c",
                                                "sense_id": "335fbc71-e26f-3b28-ba73-c7726575aa79",
                                                "text": "It's beautiful outside, let's go for a walk."
                                            },
                                            {
                                                "example_id": "606e1104-b9e5-459e-9f5e-3ac8757fb634",
                                                "sense_id": "335fbc71-e26f-3b28-ba73-c7726575aa79",
                                                "text": "These carnations smell beautiful but those daffodils smell funny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91ee0786-c66d-374a-b0fc-c39124dce714",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "Impressing with charm in an intellectual or moral way, through inherent suitability or elegance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db427e1c-79fd-44b2-8eef-9b85e89dc8f4",
                                                "sense_id": "91ee0786-c66d-374a-b0fc-c39124dce714",
                                                "text": "The skater performed a beautiful axel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beautiful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34c53754-179b-3856-8c97-4d82b1fa06f2",
                                        "entry_id": "85c64f0a-a954-3d5b-9790-d42e2404a38b",
                                        "glosses": [
                                            "Someone who is beautiful. Can be used as a term of address."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "495d6ce2-709e-4bb1-9d08-4ddb59fddec6",
                                                "sense_id": "34c53754-179b-3856-8c97-4d82b1fa06f2",
                                                "text": "The man was faithful to his wife, ignoring the many blonde beautifuls who surrounded him wherever he went."
                                            },
                                            {
                                                "example_id": "380f70b2-4444-45dc-a83e-33d8450155f4",
                                                "sense_id": "34c53754-179b-3856-8c97-4d82b1fa06f2",
                                                "text": "Hey, beautiful!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34ca2e97-7289-4e6f-bdee-ae3a116671ed",
                        "source_entry_id": "34da471b-c22e-3cf9-b520-26b133385b6c",
                        "source_sense_id": "a5bcd031-7548-34ba-b3dd-b55928714a86",
                        "source_sense_description": "bijzonder mooi",
