                "senses": [
                    {
                        "sense_id": "3b8ba13e-4ada-3765-a405-37d0b730d64c",
                        "entry_id": "a6c14773-ebc0-3a7b-9a13-51667834d337",
                        "glosses": [
                            "het aanbrengen van grote schade, tot een woestenij terugbrengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b755bd1-41b1-4697-b119-c159029b6c28",
                                "sense_id": "3b8ba13e-4ada-3765-a405-37d0b730d64c",
                                "text": "De inname van de stad leidde tot de volledige verwoesting ervan."
                            },
                            {
                                "example_id": "7e272f4f-87bf-4f95-90c3-9eba301aa521",
                                "sense_id": "3b8ba13e-4ada-3765-a405-37d0b730d64c",
                                "text": "Russisch leger laat spoor van dood en verwoesting na rond Kiev."
                            },
                            {
                                "example_id": "3ce3b719-baca-4c09-aa88-0fa652ef6916",
                                "sense_id": "3b8ba13e-4ada-3765-a405-37d0b730d64c",
                                "text": "Ze giechelde een beetje over de 'terreuradvocaat'toen hij zich voorstelde, maar verontschuldigde zich meteen en zei dat ze zijn antifeministische verwoestingen aandachtig, maar met gemengde gevoelens, volgde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91df0452-cbe1-415a-b386-2029bc06e8e0",
                        "source_entry_id": "a6c14773-ebc0-3a7b-9a13-51667834d337",
                        "source_sense_id": "3b8ba13e-4ada-3765-a405-37d0b730d64c",
                        "source_sense_description": "het aanbrengen van grote schade, tot een woestenij terugbrengen",
                        "target_lang_word": "Verwüstung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwüstung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                        "entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                                        "glosses": [
                                            "Zustand vollkommener Zerstörung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaacf8cf-9082-47f2-8536-11bb5e9ed009",
                                                "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                                "text": "„Die sichtbare Verwüstung schließe die Opfer der radioaktiven Verstrahlung nicht ein.“"
                                            },
                                            {
                                                "example_id": "27afe531-63a8-44d0-b6b9-80c784e1f86e",
                                                "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                                "text": "„Bei den Verwüstungen wurde unter anderem auch die Kastorkirche fast ganz zerstört und erst in den Jahren danach in der heutigen Form wiederaufgebaut.“"
                                            },
                                            {
                                                "example_id": "6b70c514-9870-4bc6-866f-1fc29053dc14",
                                                "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                                "text": "„Die Verwüstungen, nach denen Robert Franke im September 1914 noch meist vergeblich gesucht hatte, waren nun im ganzen östlichen Ostpreußen unübersehbar.“"
                                            },
                                            {
                                                "example_id": "3389c7e9-6c55-480f-b321-04a476ad920b",
                                                "sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                                                "text": "„Das Erdreich rings um die Bäume, deren kahle, im blassen Mondlichte zum Himmel emporstrebende Äste die Verwüstung anzuklagen schienen, war durch den Pflug aufgerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6256285-1a6c-3542-8929-3656200d25cd",
                                        "entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                                        "glosses": [
                                            "natürliche oder menschengemachte Austrocknung und somit Verschlechterung des Bodens in relativ trockenen Gebieten"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338fb4f8-bc27-4272-86f0-df56d99c5834",
                                                "sense_id": "a6256285-1a6c-3542-8929-3656200d25cd",
                                                "text": "Die Verwüstung ist ein globales Problem."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d219218-5f70-311a-a977-af6d79f3f6a4",
                                        "entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                                        "glosses": [
                                            "chaotischer Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c56d28-7355-4a1c-81c8-4f58a17ad8de",
                                                "sense_id": "1d219218-5f70-311a-a977-af6d79f3f6a4",
                                                "text": "In Kinderzimmer herrscht totale Verwüstung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "320c81cf-8140-3a4c-a822-61e54c5fc41b",
                                        "entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                                        "glosses": [
                                            "Zustand der Verstörung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9365f26c-6150-4c24-8ccc-bc10c94746c4",
                                                "sense_id": "320c81cf-8140-3a4c-a822-61e54c5fc41b",
                                                "text": "Nach dem Krieg war die Verwüstung der Wirtschaft zu spüren."
                                            },
                                            {
                                                "example_id": "b17877a7-fac7-4ced-83f7-f7fb1a146cf6",
                                                "sense_id": "320c81cf-8140-3a4c-a822-61e54c5fc41b",
                                                "text": "Er litt lange unter seiner seelischen Verwüstung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4c8ea20-aef6-4ee1-b491-410e8d915926",
                        "source_entry_id": "a6c14773-ebc0-3a7b-9a13-51667834d337",
                        "source_sense_id": "3b8ba13e-4ada-3765-a405-37d0b730d64c",
                        "source_sense_description": "het aanbrengen van grote schade, tot een woestenij terugbrengen",
                        "target_lang_word": "destruction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destruction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "The act of destroying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2840b9-f2af-4db7-9ced-a7d5699dc729",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "The destruction of the condemned building will take place at noon."
                                            },
                                            {
                                                "example_id": "aa3fc8a7-592f-4aa6-971b-02f7ed67f191",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "It may be that a free society as we have known it carries in itself the forces of its own destruction, that once freedom has been achieved it is taken for granted and ceases to be valued, and that the free growth of ideas which is the essence of a free society will bring about the destruction of the foundations on which it depends."
                                            },
                                            {
                                                "example_id": "919585b2-bf88-4745-91ca-c6a9ed067ab1",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "About 1500 B.C., however, a powerful earthquake caused widespread destruction, and thereafter there were major changes. An earlier script, undeciphered, but known as Linear A, was replaced by the Greek Linear B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "The results of a destructive event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78fd7c37-1092-48a2-b733-b4ce19fe90f7",
                                                "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                                "text": "Amid the seemingly endless destruction, a single flower bloomed."
                                            },
                                            {
                                                "example_id": "68cf2d12-32a8-44fe-956d-2fc339b69457",
                                                "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                                "text": "If destruction be our lot we must ourselves be its author and finisher. As a nation of freemen we must live through all time or die by suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f064b243-3a36-3f7d-87f9-e688d741fc2a",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "A group of feral cats."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb69c659-442b-40db-b854-1989f309279f",
                                                "sense_id": "f064b243-3a36-3f7d-87f9-e688d741fc2a",
                                                "text": "A group of wild cats is called a destruction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c590a381-5b64-4c41-b282-1f881db2520b",
                        "source_entry_id": "a6c14773-ebc0-3a7b-9a13-51667834d337",
                        "source_sense_id": "3b8ba13e-4ada-3765-a405-37d0b730d64c",
                        "source_sense_description": "het aanbrengen van grote schade, tot een woestenij terugbrengen",
                        "target_lang_word": "obliteration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obliteration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1259a1f3-ab45-37dd-987f-105bc7a630e4",
                                        "entry_id": "430aba37-5369-3e00-8bce-571f0c81eec6",
                                        "glosses": [
                                            "The total destruction of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97267824-f48a-4c9c-9a5f-f6db0ca21b2e",
                                                "sense_id": "1259a1f3-ab45-37dd-987f-105bc7a630e4",
                                                "text": "This illustration depicts exoplanet Kepler-1658b (left), doomed to eventual obliteration by its aging host star."
                                            },
                                            {
                                                "example_id": "164d8276-2c92-4465-9502-a60963a55b0f",
                                                "sense_id": "1259a1f3-ab45-37dd-987f-105bc7a630e4",
                                                "text": "Stark before-and-after images reveal the obliteration of Bakhmut [title]"
                                            },
                                            {
                                                "example_id": "e63756a1-ffab-46c3-8a0a-516fee7b4841",
                                                "sense_id": "1259a1f3-ab45-37dd-987f-105bc7a630e4",
                                                "text": "“Everyone knows what happens when you drop 14 30,000-pound bombs perfectly on their targets: total obliteration.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e0b8bed-f111-3fd5-b7c0-e266442de883",
                                        "entry_id": "430aba37-5369-3e00-8bce-571f0c81eec6",
                                        "glosses": [
                                            "The concealing or covering of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da5ed1be-0bcb-497f-b65d-8932d36da347",
                                                "sense_id": "9e0b8bed-f111-3fd5-b7c0-e266442de883",
                                                "text": "Winter, in coming to the country hereabout, advanced in well-marked stages, wherein might have been successively observed the retreat of the snakes, the transformation of the ferns, the filling of the pools, a rising of fogs, the embrowning by frost, the collapse of the fungi, and an obliteration by snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "015becc1-d989-3791-8130-7a036b0a01be",
                                        "entry_id": "430aba37-5369-3e00-8bce-571f0c81eec6",
                                        "glosses": [
                                            "The cancellation, erasure or deletion of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96334016-221a-4bab-a4fe-1f2f9e97bd49",
                                                "sense_id": "015becc1-d989-3791-8130-7a036b0a01be",
                                                "text": "Whitman did censor himself often enough, changing pronouns in some passages, excising others, learning, in short, the \"strategies of concealment\" forced on him by the nineteenth century. None of these obliterations, however, can excuse the endeavors of literary critics, who have tried to deny the importance of \"sexuality\" in the poetry by focusing on its \"mystical\" or its \"universal\" aspects."
                                            },
                                            {
                                                "example_id": "643ccd7b-07f9-43cb-88db-dcdcf2b084ec",
                                                "sense_id": "015becc1-d989-3791-8130-7a036b0a01be",
                                                "text": "Because he refused to protect his brother's name from obliteration, he acquires a derogatory nickname."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00485a0-8349-3cc2-9908-cefe8208e743",
                                        "entry_id": "430aba37-5369-3e00-8bce-571f0c81eec6",
                                        "glosses": [
                                            "The cancellation of the function, structure, or both of a vessel or organ; for example, the occlusion of the lumen of a duct, blood vessel, or lymphatic vessel, be it solely functional (as when squeezed by nearby mass effect or inflammation) or both structural and functional (as when clogged with thrombus, embolus, or fibrosis)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
