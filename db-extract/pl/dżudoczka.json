                                                "example_id": "966b75ac-5a65-4e5e-9f92-3e6edb00480d",
                                                "sense_id": "fa8cfe2d-c679-3f84-938e-15932724c2ca",
                                                "text": "Bei den letzten Olympischen Spielen haben die Judokas viele Medaillen gewonnen."
                                            },
