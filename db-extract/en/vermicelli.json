                                        "sense_id": "e617367a-3d07-3d0b-ac60-374b48951082",
                                        "entry_id": "70e25dfe-f68a-3c2b-b941-426e78892388",
                                        "glosses": [
                                            "Dessert à base de purée de châtaignes pressée sur un biscuit croquant, servi dans un petit pot."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65fbda08-d25c-316f-a93f-d2d95b7687e7",
                                        "entry_id": "70e25dfe-f68a-3c2b-b941-426e78892388",
                                        "glosses": [
                                            "Toutes sortes de choses ayant une forme fine et courte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5eaaa3d-274c-4f84-8b0e-3a9af531296a",
                                                "sense_id": "65fbda08-d25c-316f-a93f-d2d95b7687e7",
                                                "text": "… au milieu placer une boule de glace vanille, une de fraise, une de chocolat, napper de chocolat fondu, décorer de chantilly, parsemer de vermicelle de chocolat servir aussitôt."
