                                    }
                                ]
                            },
                            {
                                "target_word": "cease fire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb0f802d-c1bd-3778-9573-480500842c5f",
                                        "entry_id": "ddc1ef4a-4c80-37fe-8b7a-30e5a931859e",
                                        "glosses": [
                                            "Alternative spelling of ceasefire."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aacf3b8-229d-4a94-9d36-1659cc26c2c1",
                                                "sense_id": "bb0f802d-c1bd-3778-9573-480500842c5f",
                                                "text": "I also encourage all of us to begin the cease fire in America's culture war by taking the initiative of inviting someone from the other camp to lunch."
                                            },
                                            {
                                                "example_id": "3d6dd8b2-60c2-49ae-a09d-0c8cc2e28d71",
                                                "sense_id": "bb0f802d-c1bd-3778-9573-480500842c5f",
                                                "text": "in El Salvador, they declared a cease fire after ten years. Why didn't they think of that at the beginning?"
                                            },
                                            {
                                                "example_id": "ba3296bd-ef47-40e5-91c8-fe68a8991a93",
                                                "sense_id": "bb0f802d-c1bd-3778-9573-480500842c5f",
                                                "text": "On August 4 there was a cease fire in Java, the battle had lasted all of two weeks."
                                            },
                                            {
                                                "example_id": "df9137ed-4a81-4c8d-96f8-7e35a6cfd7f8",
                                                "sense_id": "bb0f802d-c1bd-3778-9573-480500842c5f",
                                                "text": "To date around eighteen armed cease fires have been agreed between the army and armed groups of the following ethnicities..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
