                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anxiolytic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33809598-815c-3cd5-846a-c3a6562e9f34",
