                    {
                        "sense_id": "9601fe37-b7ca-360f-a186-2d71601f80bb",
                        "entry_id": "71672ecd-12d8-3535-8cd0-b456034351f2",
                        "glosses": [
                            "Attitude branchée."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b7b57aa5-02f8-4547-9715-3422d600a18b",
                                "sense_id": "9601fe37-b7ca-360f-a186-2d71601f80bb",
                                "text": "D’ailleurs, à propos de style, le branchouille se mélange au old school, comme en témoignent ces ballerines colorées et surtout ces mocassins qu’on croyait réservés au lycée Henri IV de Paris."
                            },
                            {
                                "example_id": "efa0cef0-6b10-4454-9919-807f4f574d7b",
                                "sense_id": "9601fe37-b7ca-360f-a186-2d71601f80bb",
                                "text": "Un hebdomadaire dit culturel, qui fait davantage dans le branchouille en circuit fermé que dans l’information des classes moyennes supposées progressistes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
