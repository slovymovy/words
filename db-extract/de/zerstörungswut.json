                "senses": [
                    {
                        "sense_id": "9141f221-4d54-342d-b1fd-4a8714a8f0cb",
                        "entry_id": "978ffb80-fade-3630-a499-1fe1811e0178",
                        "glosses": [
                            "unbeherrschter innerer Drang, zu zerstören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34a5aecd-e64c-473c-82f4-5c06e99e0d11",
                                "sense_id": "9141f221-4d54-342d-b1fd-4a8714a8f0cb",
                                "text": "„Dazu kamen die Herzlosigkeit, Zerstörungswut und Mordlust der Sieger im Siegesrausch, im Blutrausch oder einfach im Rausch.“"
                            },
                            {
                                "example_id": "5fec5248-eb98-4a8f-958e-0546627f8f08",
                                "sense_id": "9141f221-4d54-342d-b1fd-4a8714a8f0cb",
                                "text": "„Ganze Regionen benötigten Jahrhunderte, um sich von der mongolischen Zerstörungswut wieder zu erholen.“"
                            },
                            {
                                "example_id": "875a7040-81af-4d66-8971-5e9be103f5b0",
                                "sense_id": "9141f221-4d54-342d-b1fd-4a8714a8f0cb",
                                "text": "„Bei solchen Anlässen hält ihn keine Uferböschung, dann fließt er voller Zerstörungswut über Wiesen, Weiden, Kiesbänke und Buschwald.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
