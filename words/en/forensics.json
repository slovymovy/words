{
    "word_family": [
        "forensic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e07acb8-bc5e-3373-964b-4af519fb4f83",
                    "sense_definition": "The application of scientific methods and techniques to the investigation of crime.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police relied on <w>forensics</w> to identify the suspect from the evidence found at the scene.",
                            "target_lang_translations": {
                                "zh": "警方依靠<w>刑事科学技术</w>，通过现场发现的证据锁定了嫌疑人。"
                            }
                        },
                        {
                            "text": "Modern <w>forensics</w> has revolutionized how investigators solve complex criminal cases.",
                            "target_lang_translations": {
                                "zh": "现代<w>刑事科学技术</w>彻底改变了调查人员侦破复杂刑事案件的方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forensic science"
                    ],
                    "common_phrases": [
                        "digital forensics",
                        "forensics team"
                    ],
                    "target_lang_definitions": {
                        "zh": "应用科学方法和技术进行犯罪调查的学科。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "法医鉴定",
                                "target_lang_sense_clarification": "侧重于医学和生物学证据的鉴定。"
                            },
                            {
                                "target_lang_word": "刑事科学技术",
                                "target_lang_sense_clarification": "指利用科学手段侦破刑事案件的综合技术。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65c0d3c0-6f1c-343c-b336-bf83a0b9f6b1",
                    "sense_definition": "The art or study of formal debate and public speaking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent years studying <w>forensics</w> to improve her ability to argue effectively in public.",
                            "target_lang_translations": {
                                "zh": "她花了多年时间学习<w>辩论术</w>，以提高自己在公开场合有效论证的能力。"
                            }
                        },
                        {
                            "text": "The university offers a course in <w>forensics</w> for students interested in competitive debate.",
                            "target_lang_translations": {
                                "zh": "大学为对竞技辩论感兴趣的学生开设了<w>演讲与辩论</w>课程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rhetoric",
                        "debate"
                    ],
                    "target_lang_definitions": {
                        "zh": "关于正式辩论和公开演讲的艺术或研究。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辩论术",
                                "target_lang_sense_clarification": "指辩论的技巧与理论。"
                            },
                            {
                                "target_lang_word": "演讲与辩论",
                                "target_lang_sense_clarification": "指作为学术研究或训练的演讲与辩论活动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16cabcb9-7c3c-3fa9-891e-60375a56949d",
                    "sense_definition": "A school club or society dedicated to competitive debate and public speaking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He joined the high school <w>forensics</w> to practice his presentation skills.",
                            "target_lang_translations": {
                                "zh": "他加入了高中的<w>辩论社</w>来练习演讲技巧。"
                            }
                        },
                        {
                            "text": "The <w>forensics</w> team traveled to the state championship to compete against other schools.",
                            "target_lang_translations": {
                                "zh": "<w>辩论队</w>前往参加州锦标赛，与其他学校进行角逐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "debate club"
                    ],
                    "common_phrases": [
                        "forensics team"
                    ],
                    "target_lang_definitions": {
                        "zh": "学校中专门从事竞技辩论和公开演讲的社团。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辩论社",
                                "target_lang_sense_clarification": "学校内进行辩论训练的组织。"
                            },
                            {
                                "target_lang_word": "辩论队",
                                "target_lang_sense_clarification": "代表学校参加比赛的辩论团队。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}