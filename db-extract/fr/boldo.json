                                        "glosses": [
                                            "The leaves of this tree, used in traditional medicine for hepatic troubles and genitourinary inflammation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac94f35b-ed17-4b5f-86c7-3cbc58633a3d",
                                                "sense_id": "9bb1fddb-621c-3e6f-af70-1534e55359f0",
                                                "text": "Fossilized boldo leaves more than 13,000 years old with human teeth imprints have been found in Chile. Perhaps they were used medicinally by ancient Chileans or chewed simply for their pleasant, refreshing taste."
                                            }
                                        ]
                                    }
                                ]
