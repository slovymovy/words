                    {
                        "sense_id": "18c9930f-26ac-3694-97d0-c85ec0f43690",
                        "entry_id": "14a85543-9e82-3277-a68f-583a79f56c93",
                        "glosses": [
                            "As much as an oven will hold."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8e5d37-d049-472c-9840-0d3ca0b30f0d",
                                "sense_id": "18c9930f-26ac-3694-97d0-c85ec0f43690",
                                "text": "Cesar Delmarre baked ten ovenfuls a day, maintaining an athletic cadence, but kept a surprisingly small stock, because he had nowhere to put it, his landlady refusing to rent him a room on the second floor next to where she slept for fear that his activities would disturb her peace."
                            },
                            {
                                "example_id": "36394243-932e-405f-a40c-3393b82566dd",
                                "sense_id": "18c9930f-26ac-3694-97d0-c85ec0f43690",
                                "text": "They used up their reserves of flour at a prodigious rate to bake ovenful after ovenful of bread loaves, and then they loaded the small hand-cart and trundled it down the lane to the main road."
                            },
                            {
                                "example_id": "744af4d0-ed71-4da1-9c3c-0b07df6501c2",
                                "sense_id": "18c9930f-26ac-3694-97d0-c85ec0f43690",
                                "text": "In between looking after Damp and producing ovensful of delicious food, Mrs McLachlan would spend approximately one hour each week attempting to tidy up the mess, but so far had made little impression."
                            },
                            {
                                "example_id": "d5a92b11-c10e-4bb2-a0fd-763711f6c08d",
                                "sense_id": "18c9930f-26ac-3694-97d0-c85ec0f43690",
                                "text": "I always bake an ovenful and then stock the freezer with mashed sweet potatoes for use in other recipes down the road."
                            }
                        ]
                    }
                ],
