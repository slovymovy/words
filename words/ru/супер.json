                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Обычные клиенты у нас на мотоциклах в <w>суперы</w> не ездят!",
                            "target_lang_translations": {
                                "en": "Our usual clients don't ride motorcycles into <w>supermarkets</w>!",
                                "fr": "D'habitude, nos clients ne vont pas au <w>supermarché</w> à moto !"
                            }
                        },
                        {
                            "text": "По дороге домой я зашёл в <w>супер</w>, чтобы купить хлеба и молока.",
                            "target_lang_translations": {
                                "en": "On the way home I stopped at the <w>supermarket</w> to buy bread and milk.",
                                "fr": "En rentrant chez moi, je suis passé au <w>supermarché</w> pour acheter du pain et du lait."
                            }
                        }
