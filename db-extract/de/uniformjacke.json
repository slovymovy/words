                "senses": [
                    {
                        "sense_id": "2a45f334-55e2-3b2d-9a28-390b20919df1",
                        "entry_id": "866636c1-e7ec-34db-9ae3-986b8b7296be",
                        "glosses": [
                            "Jacke, die Bestandteil einer Uniform ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7101eb79-e585-4f6b-aaf6-43c33855837c",
                                "sense_id": "2a45f334-55e2-3b2d-9a28-390b20919df1",
                                "text": "„In einem Musikvideo trat er in einer an die SS erinnernde Uniformjacke mit einem goldenen Garuda, dem mythischen Wappenvogel Indonesiens, auf.“"
                            },
                            {
                                "example_id": "2f405b9b-c345-4737-a3ba-2fc2b5002745",
                                "sense_id": "2a45f334-55e2-3b2d-9a28-390b20919df1",
                                "text": "„Die Uniformjacke des Mannes lag bei den andern auf dem Boden neben der Frau.“"
                            },
                            {
                                "example_id": "85253342-12fc-46ce-866b-aab5f0a3752f",
                                "sense_id": "2a45f334-55e2-3b2d-9a28-390b20919df1",
                                "text": "„Das farblose Haar hatte sie zu einem Knoten hochgenommen, an der Uniformjacke saß das goldene Parteiabzeichen, am Verschluß der Bluse saß eine schwarze, gehämmerte Brosche.“"
                            },
                            {
                                "example_id": "e3cf6fbd-7d63-4f81-ba2c-471da543c0c7",
                                "sense_id": "2a45f334-55e2-3b2d-9a28-390b20919df1",
                                "text": "„Er untersuchte die Abzeichen an seiner Uniformjacke. Er war ein Uschatskowry. Ein Nichts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
