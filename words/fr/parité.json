    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25bb4b60-326f-39c1-b0b5-4ed1e811d72e",
                    "sense_definition": "Égalité de représentation, de traitement ou de statut entre personnes ou groupes, en particulier entre les femmes et les hommes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "egalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle loi impose la <w>parité</w> sur les listes électorales municipales."
                        },
                        {
                            "text": "L'entreprise s'efforce de garantir la <w>parité</w> des salaires entre ses employés."
                        }
                    ],
                    "synonyms": [
                        "égalité"
                    ],
                    "common_phrases": [
                        "parité hommes-femmes",
                        "parité des salaires",
                        "respecter la parité"
                    ]
                },
                {
                    "sense_id": "00466dd4-2f37-35dc-a9ba-4f4fcf6b7895",
                    "sense_definition": "Rapport d'équivalence ou égalité de valeur entre deux devises monétaires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'euro a temporairement atteint la <w>parité</w> avec le dollar américain sur les marchés."
                        },
                        {
                            "text": "Les économistes calculent souvent la <w>parité</w> de pouvoir d'achat pour comparer les pays."
                        }
                    ],
                    "common_phrases": [
                        "parité de pouvoir d'achat",
                        "parité avec le dollar",
                        "parité monétaire"
                    ]
                },
                {
                    "sense_id": "bf9bc8b3-afd1-36f9-8cb6-9ce3ae23e7a9",
                    "sense_definition": "Propriété d'un nombre entier d'être pair ou impair, ou d'une fonction mathématique d'être paire ou impaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur demande de vérifier la <w>parité</w> de cette fonction avant de tracer la courbe."
                        },
                        {
                            "text": "Un bit supplémentaire permet de contrôler la <w>parité</w> des données transmises."
                        }
                    ],
                    "common_phrases": [
                        "parité d'un nombre",
                        "bit de parité"
                    ]
                },
                {
                    "sense_id": "aea8beca-7445-3692-adfa-9cc97b9e387f",
                    "sense_definition": "Similitude ou équivalence générale entre des faits, des objets ou des situations de même nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "egalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ne peut pas établir une réelle <w>parité</w> entre ces deux événements historiques distincts."
                        },
                        {
                            "text": "Le juriste a souligné la <w>parité</w> des situations pour justifier une même décision."
                        }
                    ],
                    "synonyms": [
                        "égalité"
                    ],
                    "common_phrases": [
                        "parité de situation"
                    ]
                }
            ]
        }
    ]
