                ],
                "senses": [
                    {
                        "sense_id": "08bdf3c2-f495-38da-825c-c09b0bcdaef0",
                        "entry_id": "6b9ce770-065e-36b8-a23d-6dd39b68a1a9",
                        "glosses": [
                            "niewielki, pulchny placek z ciasta drożdżowego na zsiadłym mleku, smażony na tłuszczu, jadany na słodko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1952aa56-20ca-47ce-9f8f-8c2fec87646b",
                                "sense_id": "08bdf3c2-f495-38da-825c-c09b0bcdaef0",
                                "text": "Często proszę babcię, by mi usmażyła racuchy z jabłkami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46109890-9370-4633-a854-081039fff1e2",
                        "source_entry_id": "6b9ce770-065e-36b8-a23d-6dd39b68a1a9",
                        "source_sense_id": "08bdf3c2-f495-38da-825c-c09b0bcdaef0",
                        "target_lang_word": "crumpet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crumpet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65d3e6af-cd06-30c8-99b9-438ba2d35ba2",
                                        "entry_id": "ddbfbca6-b8fb-37f7-a8f6-bdec91dc4f49",
                                        "glosses": [
                                            "A type of savoury cake, typically flat and round, made from batter and yeast, containing many small holes and served toasted, usually with butter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa09e80-b1c7-4985-95cf-408703337306",
                                                "sense_id": "65d3e6af-cd06-30c8-99b9-438ba2d35ba2",
                                                "text": "T-Saint: I say we kill 'em!\nDonner: I say we hump 'em.\nBooga: I say we eat crumpets and tea.\nDeetee: Tasty! Crumpets and tea. All in favor of crumpets and tea, say \"I.\"\nAll: I!\nT-Saint: Shut up! Ain't gonna be no crumpets and tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4ed5dd5-5e79-33f2-b883-78ec0bc9cb75",
                                        "entry_id": "ddbfbca6-b8fb-37f7-a8f6-bdec91dc4f49",
                                        "glosses": [
                                            "A sexually attractive person or, collectively, people; usually referring to women."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b14f73d9-235a-4149-9c4b-5036f005b783",
                                                "sense_id": "a4ed5dd5-5e79-33f2-b883-78ec0bc9cb75",
                                                "text": "Joan Bakewell was famously described as \"the thinking man's crumpet\"."
                                            },
                                            {
                                                "example_id": "580c8717-2197-4ae5-a9c7-90a95d03e418",
                                                "sense_id": "a4ed5dd5-5e79-33f2-b883-78ec0bc9cb75",
                                                "text": "John and his mates have gone out to find themselves some crumpet."
                                            },
                                            {
                                                "example_id": "d282f615-d6dc-431d-b8d8-f4fd790072ba",
                                                "sense_id": "a4ed5dd5-5e79-33f2-b883-78ec0bc9cb75",
                                                "text": "The regulars are all guys, a varied selection, my friends. There's Sammy—small, wiry, dark-haired. A hat manufacturer, crumpet mad—always chatting up different birds."
                                            },
                                            {
                                                "example_id": "bf7c33b6-43b7-4427-aa29-6d55ec7322b9",
                                                "sense_id": "a4ed5dd5-5e79-33f2-b883-78ec0bc9cb75",
                                                "text": "Our lives are saturated with middle-class crumpet Benedict Cumberbatch - but does he deserve the attention, asks Michael Hogan"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f827cda3-f895-3b49-ae77-6de14bd02228",
                                        "entry_id": "ddbfbca6-b8fb-37f7-a8f6-bdec91dc4f49",
                                        "glosses": [
                                            "The head."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00d7300a-c6e2-4beb-b8fe-4cf82ad9f9cd",
                                                "sense_id": "f827cda3-f895-3b49-ae77-6de14bd02228",
                                                "text": "He bad been worried off his crumpet all day, making arrangements on her behalf."
                                            },
                                            {
                                                "example_id": "420bce7c-172d-4fe3-85a4-98e7a219b566",
                                                "sense_id": "f827cda3-f895-3b49-ae77-6de14bd02228",
                                                "text": "\"If I don't get down them stairs soon I'll go off my crumpet, sittin' about up here all day with the jumps on me.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35c5035c-3c0f-49b3-98ee-d88fb46c5e87",
                        "source_entry_id": "6b9ce770-065e-36b8-a23d-6dd39b68a1a9",
                        "source_sense_id": "08bdf3c2-f495-38da-825c-c09b0bcdaef0",
                        "target_lang_word": "lívanec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lívanec",
