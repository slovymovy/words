                                        "sense_id": "1b53d628-3a7e-3b90-99a0-5479bc322e28",
                                        "entry_id": "8e4c1d7b-650d-32db-b83f-d7a13f718923",
                                        "glosses": [
                                            "A person, especially a large male, who is clumsy or a simpleton."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20db674b-ada5-4b59-b9eb-4fcd3391750e",
                                                "sense_id": "1b53d628-3a7e-3b90-99a0-5479bc322e28",
                                                "text": "Ouch! You dropped that box on my feet, you lumbering oaf!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01373a1c-5e36-318d-b1a5-dfd69078cfed",
