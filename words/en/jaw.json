{
    "word_family": [
        "jawbone",
        "jawline",
        "jawbreaker",
        "jaw-dropping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0154d2f2-0f35-32f1-80cc-a9d1b32b6ca0",
                    "sense_definition": "One of the two bones that form the framework of the mouth and hold the teeth.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer suffered a broken <w>jaw</w> during the match.",
                            "target_lang_translations": {
                                "ru": "Боксер получил перелом <w>челюсти</w> во время матча.",
                                "zh": "那名拳击手在比赛中<w>颌骨</w>骨折了。"
                            }
                        },
                        {
                            "text": "Sharks have incredibly powerful <w>jaws</w> that can crush bones.",
                            "target_lang_translations": {
                                "ru": "У акул невероятно мощные <w>челюсти</w>, способные дробить кости.",
                                "zh": "鲨鱼的<w>颌骨</w>非常有力，能咬碎骨头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mandible",
                        "jawbone"
                    ],
                    "common_phrases": [
                        "upper jaw",
                        "lower jaw",
                        "broken jaw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из двух костей, образующих каркас рта и удерживающих зубы.",
                        "zh": "构成口部并支撑牙齿的两块骨头之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "челюсть",
                                "target_lang_sense_clarification": "анатомическая кость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颌骨",
                                "target_lang_sense_clarification": "口部的骨头，可指上颌或下颌"
                            },
                            {
                                "target_lang_word": "颚骨",
                                "target_lang_sense_clarification": "较书面语的解剖学说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13c97f8f-76cc-30e0-848b-3a67b41cdad6",
                    "sense_definition": "The lower part of the face, including the chin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rubbed his unshaven <w>jaw</w> while thinking about the answer.",
                            "target_lang_translations": {
                                "ru": "Он потер свой небритый <w>подбородок</w>, обдумывая ответ.",
                                "zh": "他一边思考答案，一边摸着自己没刮胡子的<w>下巴</w>。"
                            }
                        },
                        {
                            "text": "Her <w>jaw</w> dropped in amazement when she saw the surprise.",
                            "target_lang_translations": {
                                "ru": "У нее отвисла <w>челюсть</w> от изумления, когда она увидела сюрприз.",
                                "zh": "她看到这个惊喜时，惊得<w>下巴</w>都要掉下来了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jaw dropped",
                        "square jaw",
                        "set one's jaw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть лица, включая подбородок.",
                        "zh": "脸的下部，包括下巴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "челюсть",
                                "target_lang_sense_clarification": "часть лица"
                            },
                            {
                                "target_lang_word": "подбородок",
                                "target_lang_sense_clarification": "нижняя часть лица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下巴",
                                "target_lang_sense_clarification": "脸的下部，口语最常用"
                            },
                            {
                                "target_lang_word": "下颌",
                                "target_lang_sense_clarification": "较正式，可指下脸部轮廓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "504ca8d5-9689-3c9b-a0a4-f3cf6a8ea224",
                    "sense_definition": "One of the two movable parts of a tool or machine that hold, grip, or crush an object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must clamp the wood tightly between the <w>jaws</w> of the vice.",
                            "target_lang_translations": {
                                "ru": "Вы должны крепко зажать дерево между <w>губками</w> тисков.",
                                "zh": "你必须把木头牢牢夹在虎钳的<w>钳口</w>之间。"
                            }
                        },
                        {
                            "text": "The metal was bent out of shape by the <w>jaws</w> of the machine.",
                            "target_lang_translations": {
                                "ru": "Металл был деформирован <w>челюстями</w> машины.",
                                "zh": "金属被机器的<w>夹爪</w>压得变了形。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clamp",
                        "grip"
                    ],
                    "common_phrases": [
                        "jaws of a vice",
                        "jaws of life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из двух подвижных частей инструмента или машины, которые удерживают, зажимают или раздавливают предмет.",
                        "zh": "工具或机器上两块可活动的部件之一，用来夹住、抓住或压碎物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губка",
                                "target_lang_sense_clarification": "деталь тисков или инструмента"
                            },
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "деталь механизма"
                            },
                            {
                                "target_lang_word": "челюсть",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钳口",
                                "target_lang_sense_clarification": "虎钳等工具上用来夹紧物体的两部分之一"
                            },
                            {
                                "target_lang_word": "夹爪",
                                "target_lang_sense_clarification": "机械上用于抓取、夹持的部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95563dc1-39d9-37b4-9171-0cca7238328e",
                    "sense_definition": "The mouth or opening of something, often used metaphorically to represent a dangerous situation or entrance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphor_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave firefighters snatched the family from the <w>jaws</w> of death.",
                            "target_lang_translations": {
                                "ru": "Отважные пожарные вырвали семью из <w>лап</w> смерти.",
                                "zh": "勇敢的消防员把这一家人从死神的<w>魔掌</w>中救了出来。"
                            }
                        },
                        {
                            "text": "The small boat sailed straight into the <w>jaws</w> of the storm.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка поплыла прямо в <w>пасть</w> шторма.",
                                "zh": "这只小船径直驶进了暴风雨的<w>虎口</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jaws of death",
                        "jaws of defeat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in idioms"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рот или отверстие чего-либо, часто используется метафорически для обозначения опасной ситуации или входа.",
                        "zh": "某物的口部或入口，也常比喻危险的处境或险境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пасть",
                                "target_lang_sense_clarification": "метафорически: опасное место"
                            },
                            {
                                "target_lang_word": "лапы",
                                "target_lang_sense_clarification": "в идиомах об опасности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虎口",
                                "target_lang_sense_clarification": "比喻危险处境，常见于固定说法"
                            },
                            {
                                "target_lang_word": "魔掌",
                                "target_lang_sense_clarification": "多用于“从……中救出”这类表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a19d941d-8d02-3689-bfe2-31c6037971eb",
                    "sense_definition": "Talk or conversation, especially when regarded as tedious, abusive, or worthless.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have heard enough of your <w>jaw</w>, so please be quiet.",
                            "target_lang_translations": {
                                "ru": "Я наслушался твоей <w>болтовни</w>, так что, пожалуйста, помолчи.",
                                "zh": "你的<w>废话</w>我已经听够了，请安静一点。"
                            }
                        },
                        {
                            "text": "He ignored their angry <w>jaw</w> and continued with his work.",
                            "target_lang_translations": {
                                "ru": "Он проигнорировал их злобный <w>треп</w> и продолжил работу.",
                                "zh": "他没有理会他们愤怒的<w>唠叨</w>，继续干自己的活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chatter",
                        "gab"
                    ],
                    "common_phrases": [
                        "hold your jaw"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated or informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговор или беседа, особенно если они считаются утомительными, оскорбительными или бесполезными.",
                        "zh": "说话或谈话，尤指被认为无聊、惹人烦或毫无价值的话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтовня",
                                "target_lang_sense_clarification": "пустые разговоры"
                            },
                            {
                                "target_lang_word": "треп",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废话",
                                "target_lang_sense_clarification": "无聊、没价值的话"
                            },
                            {
                                "target_lang_word": "唠叨",
                                "target_lang_sense_clarification": "啰唆而烦人的说话"
                            },
                            {
                                "target_lang_word": "胡扯",
                                "target_lang_sense_clarification": "随便乱说、不值得听的话"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "841d0c0a-e01b-3389-aa53-c59aa9f6ac98",
                    "sense_definition": "To talk at length, often in a casual, tedious, or gossiping manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat in the corner <w>jawing</w> about old times for hours.",
                            "target_lang_translations": {
                                "ru": "Они сидели в углу, <w>болтая</w> о былых временах часами.",
                                "zh": "他们坐在角落里<w>闲聊</w>过去的事，一聊就是好几个小时。"
                            }
                        },
                        {
                            "text": "Stop <w>jawing</w> and help me finish this project.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>трепаться</w> и помоги мне закончить этот проект.",
                                "zh": "别再<w>瞎扯</w>了，快来帮我把这个项目做完。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chat",
                        "gossip",
                        "natter",
                        "chatter"
                    ],
                    "common_phrases": [
                        "jaw away"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить долго, часто в непринужденной, утомительной или сплетничающей манере.",
                        "zh": "长时间说话，常带有随便、啰唆或聊闲天的意味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "разговаривать"
                            },
                            {
                                "target_lang_word": "трепаться",
                                "target_lang_sense_clarification": "разг. долго говорить"
                            },
                            {
                                "target_lang_word": "чесать языком",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲聊",
                                "target_lang_sense_clarification": "轻松随意地说个不停"
                            },
                            {
                                "target_lang_word": "瞎扯",
                                "target_lang_sense_clarification": "口语，带有说得太多、没完没了的感觉"
                            },
                            {
                                "target_lang_word": "唠个不停",
                                "target_lang_sense_clarification": "偏口语，指一直说个不停"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e708aac9-0a1c-3ac6-b8ad-4edf940e321e",
                    "sense_definition": "To scold or criticize someone angrily and at length.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was always <w>jawing</w> him about his messy room.",
                            "target_lang_translations": {
                                "ru": "Она вечно <w>пилила</w> его по поводу неубранной комнаты.",
                                "zh": "她老是因为他那间乱糟糟的房间而<w>数落</w>他。"
                            }
                        },
                        {
                            "text": "The captain <w>jawed</w> the crew for their laziness on deck.",
                            "target_lang_translations": {
                                "ru": "Капитан <w>отчитал</w> команду за лень на палубе.",
                                "zh": "船长因为船员在甲板上偷懒而<w>训斥</w>了他们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scold",
                        "berate",
                        "tell off"
                    ],
                    "antonyms": [
                        "praise"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сердито и долго ругать или критиковать кого-либо.",
                        "zh": "生气而且没完没了地责骂或批评某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчитывать",
                                "target_lang_sense_clarification": "ругать"
                            },
                            {
                                "target_lang_word": "пилить",
                                "target_lang_sense_clarification": "постоянно упрекать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数落",
                                "target_lang_sense_clarification": "反复责备、埋怨"
                            },
                            {
                                "target_lang_word": "训斥",
                                "target_lang_sense_clarification": "生气地责骂"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}