                    {
                        "sense_id": "26800be0-1828-36da-a970-779482d8c59f",
                        "entry_id": "8217f31b-5f53-32ce-a2b4-df3245e944c5",
                        "glosses": [
                            "de verhouding en verbinding tussen de vier landen van het Koninkrijk der Nederlanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2050e3a-a78d-401f-8d76-752d2af3850b",
                                "sense_id": "26800be0-1828-36da-a970-779482d8c59f",
                                "text": "De briefschrijvers begrijpen dat de Rijksministerraad voorwaarden stelt, maar willen dat de hulp zo wordt ingericht dat de kansarmen de \"meerwaarde van de Koninkrijksrelatie\" ervaren en tegelijkertijd de economische structuur van de eilanden wordt versterkt."
                            },
                            {
                                "example_id": "705d58ed-7485-4caf-b5b7-4e5266aed87c",
                                "sense_id": "26800be0-1828-36da-a970-779482d8c59f",
                                "text": "\"Er is zo veel meer mogelijk\", besluit de brief, \"met van twee kanten in de Koninkrijksrelatie de combinatie van zakelijkheid en een warm hart\"."
                            },
                            {
                                "example_id": "ea8a8a8e-59db-453d-a331-d445e1e22201",
                                "sense_id": "26800be0-1828-36da-a970-779482d8c59f",
                                "text": "Zelfs bij de departementen en directies die zich (nagenoeg) volledig met een Koninkrijksaangelegenheid bezighouden – zoals Buitenlandse zaken, Defensie of de directie Koninkrijksrelaties – werken geen ambtenaren namens de eilanden."
                            }
                        ]
                    }
