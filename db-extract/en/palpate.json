                                "target_senses": [
                                    {
                                        "sense_id": "58f08084-db2b-3c40-8b05-a58bd9eb21d5",
                                        "entry_id": "61944f35-0e15-377c-9251-39dab60f6e87",
                                        "glosses": [
                                            "Toucher avec la main doucement, à plusieurs reprises et en pressant légèrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29b5e993-2d1d-4d6f-9984-e6f08280bfce",
                                                "sense_id": "58f08084-db2b-3c40-8b05-a58bd9eb21d5",
                                                "text": "Il essayait de la palper comme pâte à pain dans la huche."
                                            },
                                            {
                                                "example_id": "872eac17-2bb2-451d-b17b-d37c7ed3074e",
                                                "sense_id": "58f08084-db2b-3c40-8b05-a58bd9eb21d5",
                                                "text": "Un service est tout d’abord intangible, pas directement observable, par rapport à un produit qui a une forme, est visible, solide, peut être palpé et a fait l'objet d'une série de transformations physiques."
                                            },
                                            {
                                                "example_id": "44f6be3b-4ab2-4fd7-b0b2-95ac70f39844",
                                                "sense_id": "58f08084-db2b-3c40-8b05-a58bd9eb21d5",
                                                "text": "Les aveugles palpent les objets pour en reconnaître les formes."
                                            },
                                            {
                                                "example_id": "019285e7-908b-4579-bdce-ac7cee2a45b5",
                                                "sense_id": "58f08084-db2b-3c40-8b05-a58bd9eb21d5",
                                                "text": "Le médecin a palpé le ventre du malade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e39d5ab0-0aec-36a2-8d79-37078bd5ae3e",
                                        "entry_id": "61944f35-0e15-377c-9251-39dab60f6e87",
                                        "glosses": [
                                            "Toucher."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d30afa8f-7fcc-4ad4-a181-aa5c40c04a3d",
                                                "sense_id": "e39d5ab0-0aec-36a2-8d79-37078bd5ae3e",
                                                "text": "Palper de l’argent : Le toucher, le recevoir."
                                            },
                                            {
                                                "example_id": "5fda5be1-d4cd-4f1d-880a-893aa61a40e4",
                                                "sense_id": "e39d5ab0-0aec-36a2-8d79-37078bd5ae3e",
                                                "text": "Elle palpe ses trente mille francs, et a pour ami fidèle un pair de France très-influent à la Chambre."
                                            },
                                            {
                                                "example_id": "eb6520d1-ffa6-4938-9598-b945f0accd0d",
                                                "sense_id": "e39d5ab0-0aec-36a2-8d79-37078bd5ae3e",
                                                "text": "Se destiner à la carrière honteuse des courtisanes, avec l’intention d’en palper les avantages, tout en gardant la robe d’une honnête bourgeoise mariée, ne suffit pas."
                                            },
                                            {
                                                "example_id": "61d9f956-e784-4004-a328-e0200d1c6fe7",
                                                "sense_id": "e39d5ab0-0aec-36a2-8d79-37078bd5ae3e",
                                                "text": "Alain sauta dans un taxi et courut à la Bankers Trust où il palpa dix beaux billets neufs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b9e93b-4900-3efe-99b9-e2407b3eeeed",
                                        "entry_id": "61944f35-0e15-377c-9251-39dab60f6e87",
                                        "glosses": [
                                            "Masser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc70dc4a-098e-4b9f-ab2d-698b7a69fbfe",
                                                "sense_id": "33b9e93b-4900-3efe-99b9-e2407b3eeeed",
                                                "text": "Le kinésithérapeute doit se mettre du côté du muscle à palper, maintenant la jambe du patient, le genou à 90°."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d646f5-a9fe-3edd-a41a-33acba3cffbf",
                                        "entry_id": "61944f35-0e15-377c-9251-39dab60f6e87",
                                        "glosses": [
                                            "Sentir très nettement (une ambiance, une émotion)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec4ac2fb-667c-4ff3-bf4e-6763bcbdfcc4",
                                                "sense_id": "20d646f5-a9fe-3edd-a41a-33acba3cffbf",
                                                "text": "À l'intérieur des murs, je peux facilement palper la tristesse des détenus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
