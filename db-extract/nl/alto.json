        "nl-extract.jsonl": [
            {
                "entry_id": "a08e56db-eac7-3b20-b46f-f1c6c70510d9",
                "word": "alto",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3d24be53-723f-44f8-a691-82234bac2605",
                        "entry_id": "a08e56db-eac7-3b20-b46f-f1c6c70510d9",
                        "tags": [
                            "plural"
                        ],
                        "form": "alto's"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7a3c46d-e3e2-320f-b56f-2d5c11ccf21b",
                        "entry_id": "a08e56db-eac7-3b20-b46f-f1c6c70510d9",
                        "glosses": [
                            "iemand met een meer op duurzaamheid gerichte levensstijl die zich zichtbaar niets aantrekt van mode en merken"
                        ],
                        "tags": [
                            "vaak gebruikt als aanduiding voor jongere uit de tegencultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "8e7022a7-777f-468e-b6ee-7f0ba0b22871",
                                "sense_id": "e7a3c46d-e3e2-320f-b56f-2d5c11ccf21b",
                                "text": "Marco Keelen, Stephan Haenen en Bianca ter Horst vielen, net als hun klasgenoten van havo 5, over de vierde tekst over de milieubeweging. \"Lastig, oninteressante tekst, al die politieke en economische termen, daar is toch niets aan\", klinkt het eenstemmig, over het verhaal 'De milieubeweging moet in de politieke arena' uit het tijdschrift Hervormd Nederland. \"Laat ze normaal Nederlands gebruiken\", klinkt het boos uit de opgewonden groep examenkandidaten. Eén alto, oorbellletje mooi door de wenkbrauw gepierced, is het daar niet mee eens. \"Dat soort stukken lees je iedere dag in de krant, joh.\""
                            },
                            {
                                "example_id": "5ed10e14-a06b-45a4-b7a8-6274a05e8d68",
                                "sense_id": "e7a3c46d-e3e2-320f-b56f-2d5c11ccf21b",
                                "text": "Een alto met een Jip-en-Janneke-broodtrommel maalt nergens om, geelt niet om kleren en heeft aan niemand een hekel. Alleen draagt hij zelf toevallig nooit een paars trainingsjack en vindt een sportschoen an sich niet erg, maar dat de Air Max-dragers nooit aan sport doen, dat is zo erg."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeba99a3-a9e5-3b8f-9d67-d7d511ab08af",
                        "entry_id": "a08e56db-eac7-3b20-b46f-f1c6c70510d9",
                        "glosses": [
                            "blaasinstrument met drie of vier ventielen en het mondstuk van een trompet, veel gebruikt in militaire muziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "168d77c7-88b2-4d73-a538-ba2af124e096",
                                "sense_id": "eeba99a3-a9e5-3b8f-9d67-d7d511ab08af",
                                "text": "Mijn maat. Van vroeger bij de Harmonie. Hij speelde alto. Of bariton. Ik wil ervan af. Ik heb die dingen nooit uit elkaar kunnen houden."
                            }
                        ]
                    },
                    {
                        "sense_id": "6689493a-5fb1-3586-b3d2-1f582117993a",
                        "entry_id": "a08e56db-eac7-3b20-b46f-f1c6c70510d9",
                        "glosses": [
                            "blaasinstrument in de vorm van een S-vormige, breder wordende buis met kleppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "845e5439-2b4a-4b90-ae55-ebe819d32ac1",
                                "sense_id": "6689493a-5fb1-3586-b3d2-1f582117993a",
                                "text": "Rob Brown is één van die New Yorkse saxofonisten die losbandige freejazz toeterfeesten toch combineerde met melodie, ritme en gevoel, maar op deze cd lijkt hij wel tot rust en beheersing te zijn gekomen, begeleid door Daniel Levin op cello en Satoshi Takeishi op percussie. (…) Toegegeven, zijn alto kan ook hier nog huilen en krijsen en janken, maar dan op een ritmische en harmonische basis, met een herkenbare melodische structuur."
                            }
                        ]
                    }
