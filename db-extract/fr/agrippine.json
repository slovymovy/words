            {
                "entry_id": "ea024827-ece3-3901-9aa2-e10c3b03ec6e",
                "word": "Agrippine",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                        "entry_id": "ea024827-ece3-3901-9aa2-e10c3b03ec6e",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b59b8b-d852-4456-bd9f-3102dcd3799a",
                                "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                "text": "Agrippine l’Aînée, fille d’Agrippa, petite-fille d’Auguste et mère de Caligula."
                            },
                            {
                                "example_id": "cb4c83ec-99fe-4c2a-984a-03b87a5d326d",
                                "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                "text": "Agrippine la Jeune, fille de la précédente et de Germanicus, femme de Claude et mère de Néron (15 - †59)."
                            },
                            {
                                "example_id": "3dbc0810-80b5-4ba8-97c2-4fe9cf63ba58",
                                "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                "text": "Et qui s’honorerait de l’appui d’Agrippine,\nLorsque Néron lui−même annonce ma ruine ?"
                            },
                            {
                                "example_id": "615cebfc-0d4f-468d-b8d2-210075ea4c27",
                                "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                "text": "Sainte Agrippine, martyre romaine sous Valérien († vers 256 ou 257)."
                            }
                        ]
                    }
                ],
