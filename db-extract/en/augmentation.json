                                                "sense_id": "5c9103bc-72ca-357f-9fbe-1bbef4984cc8",
                                                "text": "Die Vermehrung des Eigenkapitals ist oberstes Gebot."
                                            },
                                            {
                                                "example_id": "ba606496-ed3f-46a0-9d88-c3756a14642b",
                                                "sense_id": "5c9103bc-72ca-357f-9fbe-1bbef4984cc8",
                                                "text": "Leider hat die Entscheidung des Gerichts zu einer Vermehrung des Leides bei den Betroffenen geführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                        "entry_id": "153da013-1c74-3b47-9a79-8d8199b6fc8e",
                                        "glosses": [
                                            "Fortpflanzung der Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9920fc-176c-43d1-b8b1-210468fe5c7f",
                                                "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                                "text": "In der Biologie unterscheidet man zwischen ungeschlechtlicher Vermehrung und geschlechtlicher Fortpflanzung."
                                            },
                                            {
                                                "example_id": "baf05eac-597a-49fd-b0d1-10f9ba17d43b",
                                                "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                                "text": "Die vegetative und generative Vermehrung von Pflanzen, ist das Ziel vieler Gärtner."
                                            },
                                            {
                                                "example_id": "90fb8ee6-6228-4303-b92b-ecb430932d41",
                                                "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                                "text": "Die Vermehrung von Kaninchen ist sehr einfach."
                                            },
                                            {
                                                "example_id": "b72c5a44-80fc-4222-ab1d-f57160810b5f",
                                                "sense_id": "df056277-6e4f-330c-895d-8dd5bd9b909a",
                                                "text": "„Fest steht nun jedoch, dass die Vermehrung der Menschheit durch den Vorstoß ins All nicht gehemmt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
