                        ],
                        "examples": [
                            {
                                "example_id": "f49fc857-731a-4e2d-ab10-9d3f54f59365",
                                "sense_id": "9ee60373-eb29-3ab9-ad9e-8fe90043c7e1",
                                "text": "„Die Zähne sind leider sehr schlecht, schwarz und unregelmäßig, eine Unzierde in dem schönen Gesicht.“"
                            },
                            {
                                "example_id": "940f3152-d756-4de4-8254-131c57099cc5",
                                "sense_id": "9ee60373-eb29-3ab9-ad9e-8fe90043c7e1",
                                "text": "„Er wies zuerst darauf hin, daß der frühere alte Thurm eine Unzierde der Gegend war, und daß der neue […] eine Zierde des Dorfes und der ganzen Gegend sei […].“"
                            }
                        ],
