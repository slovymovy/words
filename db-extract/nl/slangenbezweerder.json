                            {
                                "example_id": "f51a951a-0e88-4d27-8b52-6aa1524cbbf7",
                                "sense_id": "59a4abbd-1a27-3054-9841-0ec16bb9eb0f",
                                "text": "Cobra's worden vaak gebruikt bij slangenbezweerders, vooral soorten met een brilcobra-achtige halsvlek zijn populair."
