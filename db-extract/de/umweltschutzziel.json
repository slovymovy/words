                "senses": [
                    {
                        "sense_id": "a7edb968-acd8-3e74-a478-2db068e2825a",
                        "entry_id": "853fdc33-ad0f-3788-b60f-6b66adde1e0f",
                        "glosses": [
                            "klar umrissene Ausrichtung oder gedanklicher Endpunkt einer umweltschutztechnischen Bestrebung, etwas oder jemanden bei Umweltbelastungen zu sichern oder zu entlasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406635e6-d450-489b-bd9a-d24654ef3ca7",
                                "sense_id": "a7edb968-acd8-3e74-a478-2db068e2825a",
                                "text": "„Nach dem Wortsinn ist der Begriff der Umweltschutzziele weit zu verstehen.“"
                            },
                            {
                                "example_id": "dd2e26db-2135-4cec-b580-2ba698ee5af6",
                                "sense_id": "a7edb968-acd8-3e74-a478-2db068e2825a",
                                "text": "„Bei der Erarbeitung von Zielen zum Umweltschutz können sich selbst kleine und mittlere Betriebe an den nationalen und internationalen Umweltschutzzielen orientieren.“"
                            },
                            {
                                "example_id": "af793c61-0ff2-41f8-be15-bea4f05b3146",
                                "sense_id": "a7edb968-acd8-3e74-a478-2db068e2825a",
                                "text": "„Die Welt hat nach Einschätzung der Vereinten Nationen bei fast keinem ihrer Umweltschutzziele nennenswerte Fortschritte gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
