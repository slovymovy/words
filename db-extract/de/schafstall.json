                                        "entry_id": "b9170d56-0901-30c4-a73b-9e2fe58b11eb",
                                        "glosses": [
                                            "An enclosure for keeping sheep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae0d02a-e79e-4cb3-b5c3-0ebbf48dd6f6",
                                                "sense_id": "78d51184-717d-3f56-b54a-eb3a1dd649e7",
                                                "text": "If civilized life had covered over the ancient verities, Dumuzi learns in his tragic death that the sheepfold is still there to reclaim him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "904024ad-3ea7-3f5f-9c1a-dcee6d2fb245",
