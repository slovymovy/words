                "senses": [
                    {
                        "sense_id": "ca7ccd8c-f037-3d7a-a046-5a2b77da0bc6",
                        "entry_id": "56c65fb2-6050-3224-8212-109739e130fc",
                        "glosses": [
                            "Québéciser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37bb1f7-f168-4a4a-bc1d-96796dce7a5c",
                                "sense_id": "ca7ccd8c-f037-3d7a-a046-5a2b77da0bc6",
                                "text": "Les coûts de la chaîne seraient liés surtout à la production de téléjournaux couvrant toutes les régions mais disons particulièrement Montréal, Québec et aussi Gatineau qui colonisée par Ottawa a besoin de se \"requébéciser\" davantage."
                            },
                            {
                                "example_id": "193ac9b2-4648-461d-bdb3-83d6902e8214",
                                "sense_id": "ca7ccd8c-f037-3d7a-a046-5a2b77da0bc6",
                                "text": "Fiscalité : «Le Québec s’est beaucoup américanisé sous Charest. Il est temps de le requébéciser.»"
                            },
                            {
                                "example_id": "a67a066e-ef27-4abe-a648-d26402ffc09e",
                                "sense_id": "ca7ccd8c-f037-3d7a-a046-5a2b77da0bc6",
                                "text": "Selon moi, il importe de tout faire pour «requébéciser» Montréal en lui redonnant des références identitaires, culturelles et historiques qui s’y rattachent."
                            }
                        ]
                    }
