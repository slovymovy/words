                            {
                                "example_id": "a2d61738-d6bd-45f1-b3a5-02f0b60b2b2f",
                                "sense_id": "52fbc3a5-1fbd-39f8-99d2-fb427aa1fcfb",
                                "text": "Der Körper wies mehrere Perforationen auf."
                            },
                            {
                                "example_id": "189138a8-38d1-46be-828d-1abc6df2ceb4",
                                "sense_id": "52fbc3a5-1fbd-39f8-99d2-fb427aa1fcfb",
                                "text": "„Wie bei den Marken aus Obock ist die Perforation nur angedeutet, hier jedoch so schief, dass sie nicht einmal zum Ausschneiden taugt – eine klare Distanzierung von Prahlerei und Materialismus ganz im Sinne der Bairagi.“"
                            }
                        ],
