            {
                "entry_id": "a18767b3-cb52-3da8-ab4f-9f0b3140e14a",
                "word": "non-fumeurs",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee0305d2-9442-38ec-af56-54637338592f",
                        "entry_id": "a18767b3-cb52-3da8-ab4f-9f0b3140e14a",
                        "glosses": [
                            "Se dit d’un endroit réservé aux non-fumeurs, où il est interdit de fumer du tabac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f9b82e-1f6f-4ee3-8ee3-74c91b74ceb0",
                                "sense_id": "ee0305d2-9442-38ec-af56-54637338592f",
                                "text": "Une zone non-fumeurs."
                            },
                            {
                                "example_id": "80e2a48a-924f-4819-a208-9a21fb3cb5ff",
                                "sense_id": "ee0305d2-9442-38ec-af56-54637338592f",
                                "text": "Un restaurant non-fumeurs."
                            },
                            {
                                "example_id": "b82b1682-02a5-40c6-8e19-af85a01da6de",
                                "sense_id": "ee0305d2-9442-38ec-af56-54637338592f",
                                "text": "Veuillez éteindre votre cigarette, madame. Ici, c’est non-fumeurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94cb1861-6a34-4552-9a5d-c53101df6a9b",
                        "source_entry_id": "a18767b3-cb52-3da8-ab4f-9f0b3140e14a",
                        "source_sense_id": "ee0305d2-9442-38ec-af56-54637338592f",
                        "target_lang_word": "non-smoking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-smoking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea4b6f5b-4256-3997-a62a-438985c12967",
                                        "entry_id": "74edaebf-191b-3dde-b31b-6cb62cb32eee",
                                        "glosses": [
                                            "Having restrictions on smoking."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0453d89f-b949-42cb-aa99-7ace45685ef8",
                                                "sense_id": "ea4b6f5b-4256-3997-a62a-438985c12967",
                                                "text": "We want a table in the non-smoking section."
                                            },
                                            {
                                                "example_id": "0d622447-62bc-4872-8f33-d6de4a7f853b",
                                                "sense_id": "ea4b6f5b-4256-3997-a62a-438985c12967",
                                                "text": "The practice of labelling non-smoking compartments originated in Great Britain on the South Eastern & Chatham Railway, which made the innovation on March 1, 1920. Compartments so labelled had been a familiar feature on Continental railways for many years before that time."
                                            },
                                            {
                                                "example_id": "74d41d37-9121-4ab1-9a73-956ae17fd292",
                                                "sense_id": "ea4b6f5b-4256-3997-a62a-438985c12967",
                                                "text": "A recent public-opinion poll in local trains to and from representative large cities showed 52 per cent of passengers to prefer travel in non-smoking and 38 per cent in smoking accommodation, whilst 10 per cent expressed indifference. The percentage varied considerably according to the region; in the Karlsruhe area 60 per cent preferred non-smoking accommodation and only 27 per cent preferred to smoke."
                                            },
                                            {
                                                "example_id": "1eeccd9c-7c5d-4784-ae0b-35d91734278e",
                                                "sense_id": "ea4b6f5b-4256-3997-a62a-438985c12967",
                                                "text": "It amused me, by the way, when I was told on the Jacobite steam service in Scotland that \"this is a non-smoking train\". I was looking up at the sky and saw a quarter-mile-long duvet of steam and smoke that the locomotive had laid there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33025516-f427-39e8-b712-032c4e576c15",
                                        "entry_id": "74edaebf-191b-3dde-b31b-6cb62cb32eee",
                                        "glosses": [
                                            "Using no tobacco products."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "469f0d36-f154-4da1-add5-d95b7e990e73",
                                                "sense_id": "33025516-f427-39e8-b712-032c4e576c15",
                                                "text": "We have a room for a non-smoking tenant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "non-smoking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9daf5e04-783a-3d81-8f68-44507ad6cd8a",
                                        "entry_id": "3858793a-ec9c-39b5-a2d8-cd08e3d868f3",
                                        "glosses": [
                                            "The act of abstaining from smoking; a policy of doing so."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aca4343-14a3-48ac-b643-7dc15f12e3ce",
                                                "sense_id": "9daf5e04-783a-3d81-8f68-44507ad6cd8a",
                                                "text": "Yes, your Honor: non-smoking has been our policy in all of our hotel rooms for at least twenty years, and Mr Jones clearly knew that."
                                            },
                                            {
                                                "example_id": "b575774c-d084-44b0-968f-7724767a5b88",
                                                "sense_id": "9daf5e04-783a-3d81-8f68-44507ad6cd8a",
                                                "text": "Regular exercise, a healthy diet, moderation of alcohol use, non-smoking, and annual checkups can all reduce the risk of atherosclerotic cardiovascular disease."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
