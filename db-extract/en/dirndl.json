                        "entry_id": "dbb6e19d-6275-32ff-a16a-2d5062ea2716",
                        "glosses": [
                            "A traditional Alpine woman's dress having a tight bodice and full skirt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e2f58b-e379-42b1-9f38-4db9e18573c8",
                                "sense_id": "d17b463d-4904-320e-8de3-7468394af057",
                                "text": "For a change, Selina was not in slacks, but in a simple dirndl and sandals."
                            }
                        ]
                    },
                    {
                        "sense_id": "4500c34b-44ca-3245-8afd-1093a5dd6014",
                        "entry_id": "dbb6e19d-6275-32ff-a16a-2d5062ea2716",
                        "glosses": [
                            "In full dirndl skirt: a full skirt with a tight waistband resembling one which is part of a traditional Alpine woman's dress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c97e95b-5ce6-4f8d-9b1a-f94eb39b0b5c",
                                "sense_id": "4500c34b-44ca-3245-8afd-1093a5dd6014",
                                "text": "On the cover of the leaflet advertising the Alpenrose Gasthof in Zirl am Gurgl […] there is a decorative picture of a young woman. She is wearing Tyrolese costume: the low-cut white bodice with cross-laced velvet waistcoat, the floral apron and dirndl skirt."
                            }
                        ]
                    }
