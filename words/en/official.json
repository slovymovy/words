{
    "word_family": [
        "office",
        "officer",
        "officiate",
        "officially",
        "unofficial",
        "officialdom"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a78e594-6a69-326e-90ca-836adce09f01",
                    "sense_definition": "Approved by authority; authorized or confirmed by a person or organization in power.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>official</w> report states that the accident was caused by bad weather.",
                            "target_lang_translations": {
                                "ru": "В <w>официальном</w> отчете говорится, что авария была вызвана плохой погодой.",
                                "tr": "<w>Resmî</w> raporda kazanın kötü hava koşullarından kaynaklandığı belirtiliyor."
                            }
                        },
                        {
                            "text": "English is an <w>official</w> language in many countries around the world.",
                            "target_lang_translations": {
                                "ru": "Английский является <w>официальным</w> языком во многих странах мира.",
                                "tr": "İngilizce, dünyadaki birçok ülkede <w>resmî</w> dildir."
                            }
                        }
                    ],
                    "synonyms": [
                        "approved",
                        "recognized",
                        "sanctioned",
                        "authorized",
                        "formal"
                    ],
                    "antonyms": [
                        "unofficial"
                    ],
                    "common_phrases": [
                        "official language",
                        "official website",
                        "official announcement",
                        "official rules"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одобренный властями; разрешенный или подтвержденный лицом или организацией, имеющими власть.",
                        "tr": "Yetkili makamlarca onaylanmış; yetkili bir kişi veya kurum tarafından izin verilmiş veya doğrulanmış."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "официа́льный",
                                "target_lang_sense_clarification": "утвержденный правительством или властью"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "resmî",
                                "target_lang_sense_clarification": "yetkili makamlarca onaylanmış veya kabul edilmiş"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "def7ec4b-8798-3efc-9f70-b84148434673",
                    "sense_definition": "Relating to a job, position of authority, or public work.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She visited the school in her <w>official</w> capacity as the mayor.",
                            "target_lang_translations": {
                                "ru": "Она посетила школу в своем <w>официальном</w> качестве мэра.",
                                "tr": "Okulu belediye başkanı sıfatıyla <w>resmî</w> olarak ziyaret etti."
                            }
                        },
                        {
                            "text": "The president has many <w>official</w> duties to perform during the visit.",
                            "target_lang_translations": {
                                "ru": "У президента много <w>служебных</w> обязанностей, которые нужно выполнить во время визита.",
                                "tr": "Cumhurbaşkanının ziyaret sırasında yerine getirmesi gereken birçok <w>resmî</w> görevi var."
                            }
                        }
                    ],
                    "common_phrases": [
                        "official duties",
                        "official capacity",
                        "official business",
                        "official visit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к работе, должности или государственной службе.",
                        "tr": "Bir işle, yetkili bir pozisyonla veya kamu göreviyle ilgili olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служе́бный",
                                "target_lang_sense_clarification": "относящийся к исполнению обязанностей"
                            },
                            {
                                "target_lang_word": "должностно́й",
                                "target_lang_sense_clarification": "связанный с занимаемой должностью"
                            },
                            {
                                "target_lang_word": "официа́льный",
                                "target_lang_sense_clarification": "формальный, деловой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "resmî",
                                "target_lang_sense_clarification": "görev veya makamla ilgili"
                            },
                            {
                                "target_lang_word": "mesleki",
                                "target_lang_sense_clarification": "göreviyle veya işiyle ilgili"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a77b262f-3c62-34a1-82bc-550ffd1e6c38",
                    "sense_definition": "True, real, or publicly confirmed; often used to emphasize that something has finally happened.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>official</w>: we are moving to a new house next month!",
                            "target_lang_translations": {
                                "ru": "Теперь это <w>официально</w>: мы переезжаем в новый дом в следующем месяце!",
                                "tr": "Bu artık <w>kesinleşti</w>: önümüzdeki ay yeni bir eve taşınıyoruz!"
                            }
                        },
                        {
                            "text": "They finally made their relationship <w>official</w> after dating for a year.",
                            "target_lang_translations": {
                                "ru": "Они наконец сделали свои отношения <w>официальными</w> после года свиданий.",
                                "tr": "Bir yıl çıktıktan sonra nihayet ilişkilerini <w>resmîleştirdiler</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make it official",
                        "it is official"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to announce news"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подлинный или публично подтвержденный; часто используется для подчеркивания того, что событие окончательно утверждено.",
                        "tr": "Gerçek, kesinleşmiş veya kamuoyuna açıklanmış; genellikle bir durumun sonunda gerçekleştiğini vurgulamak için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "официа́льный",
                                "target_lang_sense_clarification": "публично объявленный или подтвержденный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "resmî",
                                "target_lang_sense_clarification": "kesinleşmiş veya duyurulmuş"
                            },
                            {
                                "target_lang_word": "kesin",
                                "target_lang_sense_clarification": "netleşmiş, net"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8067fb2f-0fd6-3b14-86a2-181a05ccc5ed",
                    "sense_definition": "A person holding a position of authority in an organization, government, or sports game.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several government <w>officials</w> attended the meeting to discuss the new law.",
                            "target_lang_translations": {
                                "ru": "На встрече для обсуждения нового закона присутствовали несколько правительственных <w>чиновников</w>.",
                                "tr": "Yeni yasayı görüşmek üzere toplantıya birkaç hükümet <w>yetkilisi</w> katıldı."
                            }
                        },
                        {
                            "text": "The match <w>official</w> blew the whistle to stop the game.",
                            "target_lang_translations": {
                                "ru": "<w>Судья</w> матча дал свисток, чтобы остановить игру.",
                                "tr": "Maçın <w>hakemi</w> oyunu durdurmak için düdüğünü çaldı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "government official",
                        "senior official",
                        "elected official",
                        "sports official"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, занимающее руководящую должность в организации, правительстве или ответственное за соблюдение правил в спорте.",
                        "tr": "Bir kurumda, devlette veya spor müsabakasında yetkili pozisyonda bulunan kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чино́вник",
                                "target_lang_sense_clarification": "государственный служащий"
                            },
                            {
                                "target_lang_word": "должностно́е лицо́",
                                "target_lang_sense_clarification": "формальное название представителя власти"
                            },
                            {
                                "target_lang_word": "судья́",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yetkili",
                                "target_lang_sense_clarification": "karar verme gücü olan görevli"
                            },
                            {
                                "target_lang_word": "memur",
                                "target_lang_sense_clarification": "devlet veya kamu hizmetinde çalışan görevli"
                            },
                            {
                                "target_lang_word": "görevli",
                                "target_lang_sense_clarification": "belirli bir işte yetkisi veya sorumluluğu olan kimse"
                            },
                            {
                                "target_lang_word": "hakem",
                                "target_lang_sense_clarification": "spor müsabakalarında yetkili olan kişi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}