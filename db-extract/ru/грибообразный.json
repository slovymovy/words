                "senses": [
                    {
                        "sense_id": "73f63a5a-202c-3b04-9bc0-d19978b34ae2",
                        "entry_id": "5eba0016-9e37-3218-b5fa-82679bc90d27",
                        "glosses": [
                            "формой напоминающий гриб, имеющий форму гриба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f202b8c-6373-40a0-b720-1ab1d41c889d",
                                "sense_id": "73f63a5a-202c-3b04-9bc0-d19978b34ae2",
                                "text": "Женщины ходят с непокрытой головой, а мужчины обвивают вокруг нее квадратный кусок полотна, в виде тюрбана, а сверху надевают широкую грибообразную шляпу, сплетенную из соломы и затем выкрашенную и лакированную."
                            }
                        ]
                    }
                ],
