                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a3c9963-1f02-48a3-84c9-11bcf4c700de",
                                "sense_id": "cc027259-21df-315c-9c6e-7f3397ab20f5",
                                "text": "De afgelopen week presenteerden speelsters van clubs uit de Liga Iberdrola hun eisen aan de bond. Ze willen onder anderen een minimum brutosalaris van 16.000 euro en een financiële regeling voor speelsters die met zwangerschapsverlof gaan."
                            },
                            {
                                "example_id": "fac6b626-bf06-4d09-bd29-72a236d00c2b",
                                "sense_id": "cc027259-21df-315c-9c6e-7f3397ab20f5",
                                "text": "Het brutosalaris - zonder vakantiegeld en toeslagen - van een verpleegkundige in het ziekenhuis ligt tussen 2600 euro en 4100 euro per maand."
                            },
                            {
                                "example_id": "c173a90c-40ac-4f29-a304-cf12129c7c08",
                                "sense_id": "cc027259-21df-315c-9c6e-7f3397ab20f5",
                                "text": "Die kloof berekent het CBS door het brutosalaris van de vijf topverdieners van een bedrijf te vergelijken met het doorsnee loon bij hetzelfde bedrijf."
                            }
                        ]
                    }
