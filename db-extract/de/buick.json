                                "target_senses": [
                                    {
                                        "sense_id": "1d2dcd14-13a4-3a40-8e31-7873fe09675f",
                                        "entry_id": "28b1f201-4cc0-39e9-956a-54feaaf78e11",
                                        "glosses": [
                                            "A car of this make."
