                            {
                                "example_id": "17aa87a9-91ea-44dc-b1cf-f9d9aa4ec7c8",
                                "sense_id": "598169aa-6e9f-3f76-9a9a-43c9c7a34d2e",
                                "text": "La culture Chipaya, aujourd’hui menacée, est l’une des plus anciennes du continent sud-américain"
                            },
