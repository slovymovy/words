                ],
                "senses": [
                    {
                        "sense_id": "7ee37109-c2b3-3d48-96cf-58c82c1512bc",
                        "entry_id": "4c629f36-3752-390d-8376-f4b904770926",
                        "glosses": [
                            "przyrząd do wskazywania kierunku wiatru"
                        ],
                        "tags": [],
