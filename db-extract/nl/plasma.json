                        "cross_references": [
                            {
                                "target_word": "plasma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b9075f6-474c-3d4c-87d7-497c78f16733",
                                        "entry_id": "cadc5899-996e-3e07-84c2-de915de45c9b",
                                        "glosses": [
                                            "A state of matter consisting of partially ionized gas and electrons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a277d229-cdff-4ed4-bb6c-f62e44dc4f85",
                                                "sense_id": "3b9075f6-474c-3d4c-87d7-497c78f16733",
                                                "text": "plasma arc cutter"
                                            },
                                            {
                                                "example_id": "88057b19-0cc7-4130-8e19-18f20a172af2",
                                                "sense_id": "3b9075f6-474c-3d4c-87d7-497c78f16733",
                                                "text": "plasma cutter"
                                            },
                                            {
                                                "example_id": "9fadf572-3914-460a-aab3-8ec9d7bb8118",
                                                "sense_id": "3b9075f6-474c-3d4c-87d7-497c78f16733",
                                                "text": "Oxygen and hydrogen nuclei are intermixed with free electrons. The whole mix is electrically neutral. This is actually considered a new stage of matter called a plasma. You can see an example of an electrically produced plasma in a fluorescent light bulb or in a plasma television."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc041571-1bbf-3184-bb9d-868f58bf2a4d",
                                        "entry_id": "cadc5899-996e-3e07-84c2-de915de45c9b",
                                        "glosses": [
                                            "A clear component of blood or lymph containing fibrin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8160398-2e9f-45f9-a631-2865787765c5",
                                                "sense_id": "cc041571-1bbf-3184-bb9d-868f58bf2a4d",
                                                "text": "blood plasma"
                                            },
                                            {
                                                "example_id": "6ed25380-799d-4679-ab57-27e2a7c43567",
                                                "sense_id": "cc041571-1bbf-3184-bb9d-868f58bf2a4d",
                                                "text": "lymph plasma"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e47879-eae3-3df1-b487-2275f261ebf6",
                                        "entry_id": "cadc5899-996e-3e07-84c2-de915de45c9b",
                                        "glosses": [
                                            "A variety of green quartz, used in ancient times for making engraved ornaments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39eb631e-fdfb-37cc-8926-624d768648cc",
                                        "entry_id": "cadc5899-996e-3e07-84c2-de915de45c9b",
                                        "glosses": [
                                            "A mixture of starch and glycerin, used as a substitute for ointments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94b14ab3-69e5-3089-b472-2f282bbb5a5a",
                                        "entry_id": "cadc5899-996e-3e07-84c2-de915de45c9b",
                                        "glosses": [
                                            "Protoplasm."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b2a604f-5993-3e7a-826a-4231f24c1d1c",
                                        "entry_id": "cadc5899-996e-3e07-84c2-de915de45c9b",
                                        "glosses": [
                                            "A visual effect in which cycles of changing colours are warped in various ways to give the illusion of liquid organic movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c045fbbb-31f6-4a86-aa0b-d6a010c2eb83",
                                                "sense_id": "7b2a604f-5993-3e7a-826a-4231f24c1d1c",
                                                "text": "Has anyone here written a plasma demo in C/C++ who would be willing to explain to me exactly how it works?"
                                            },
                                            {
                                                "example_id": "91f4b39d-16a5-406d-8239-6c61ca84d7bd",
                                                "sense_id": "7b2a604f-5993-3e7a-826a-4231f24c1d1c",
                                                "text": "However, it displayed some unique copper magic routines and plasma effects."
                                            },
                                            {
                                                "example_id": "523ecc19-1ec2-49d7-b246-6c365d5c77ca",
                                                "sense_id": "7b2a604f-5993-3e7a-826a-4231f24c1d1c",
                                                "text": "This creates the classic 'plasma' effect seen in many demoscene videos."
                                            }
                                        ]
                                    }
                                ]
                            },
