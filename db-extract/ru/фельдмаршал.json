                    {
                        "translation_id": "fbb97445-bbeb-4cae-a77b-d25fbc16836f",
                        "source_entry_id": "32075594-9b25-3cd7-9290-49eda444cf57",
                        "target_lang_word": "Feldmarschall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldmarschall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b758cd9b-bfad-32dd-a17f-2a9030849e99",
                                        "entry_id": "46f13732-e1e0-3140-9c01-810af92aaee8",
                                        "glosses": [
                                            "Offiziersdienstgrad, ursprünglich Befehlshaber der Reiterei mit richterlichen Vollmachten, später verliert er diese und entspricht einem General der Kavallerie, bald darauf überhaupt einem General. Im 18. Jahrhundert erlangt der Feldmarschall den höchsten militärischen Grad."
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef943c0-0dbb-4186-b367-65e6c7a397f2",
                                                "sense_id": "b758cd9b-bfad-32dd-a17f-2a9030849e99",
                                                "text": "„Im Jahre 1572 besuchte er, als kaiserlicher Feldmarschall, seinen Bruder Zacharias von Röbel, der damals in der Festung Spandau kommandierte.“"
                                            },
                                            {
                                                "example_id": "590c3c27-d333-45f2-bb8e-9e7f2301c398",
                                                "sense_id": "b758cd9b-bfad-32dd-a17f-2a9030849e99",
                                                "text": "„Es heißt, daß der Feldmarschall von Mackensen das durchgesetzt habe; er ist der Ehrenkommandeur des Stolper Regiments, das leider von Pferden auf Fahrräder umsteigen mußte.“"
                                            },
                                            {
                                                "example_id": "a4ff735b-ba48-4398-bf53-56dc6f7dd382",
                                                "sense_id": "b758cd9b-bfad-32dd-a17f-2a9030849e99",
                                                "text": "„Als Jermolow, von Kutusow zur Besichtigung der Position ausgeschickt, dem Feldmarschall sagte, an eine Schlacht unter den Mauern von Moskau sei in dieser Position nicht zu denken und man müsse über Moskau hinaus zurückgehen, da sah Kutusow ihn eine Weile schweigend an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "087d7f8b-2c75-31aa-987b-c5b2c9dbb005",
                                        "entry_id": "46f13732-e1e0-3140-9c01-810af92aaee8",
                                        "glosses": [
                                            "Offizier im Range eines Feldmarschalls"
                                        ],
                                        "tags": [
                                            "Heer"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
