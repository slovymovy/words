                "senses": [
                    {
                        "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                        "entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                        "glosses": [
                            "mehrere/viele Handlungen, bei denen jemand/andere hinters Licht geführt und um rechtmäßigen Besitz gebracht wird/werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da65e6a9-252d-4c33-9502-008cb3ddca8a",
                                "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                                "text": "„Er hatte viel mehr Glück als sein Bruder Ludwig, der wegen Betrügereien im Bergwerk ins Gefängnis kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                        "entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                        "glosses": [
                            "Handlung, die Bedeutung [1] erfüllt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f04659-66d3-4866-9aaa-e3a61e9430a7",
                                "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                                "text": "„Ich hatte ein kleines Haus gemietet, wo ich eine Pharaobank unter Halbpart-Beteiligung eines Berufsspielers auflegte, der mich vor den Betrügereien gewisser überheblicher Aristokraten schützte, denen gegenüber ein einfacher Privatmann in meinem lieben Vaterland immer unrecht hat.“"
                            },
                            {
                                "example_id": "9edff040-cd4a-41c6-b912-2ab1ffac4f22",
                                "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                                "text": "„Er wurde fälschlich aller möglichen Betrügereien angeklagt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0faee880-bbb5-41ef-b59f-b44e34124612",
                        "source_entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                        "source_sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                        "source_sense_description": "Handlungen, bei denen jemand hinters Licht geführt und um rechtmäßigen Besitz gebracht wird",
                        "target_lang_word": "fraudulence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fraudulence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff67509-d8bb-3c9d-96a1-7bf29f5e17b9",
                                        "entry_id": "d3c679e6-9816-3bfc-8008-4b8f86049aff",
                                        "glosses": [
                                            "The condition of being fraudulent; deceitfulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a15e24ec-dc9b-4b44-b14d-53000fa1c614",
                                                "sense_id": "8ff67509-d8bb-3c9d-96a1-7bf29f5e17b9",
                                                "text": "I ſuppoſe ſome of my friends, to whom I read the firſt part, gave notice of my deſign, and, perhaps, ſold the treacherous intelligence at a higher price than the fraudulence of trade will now allow me for my book."
                                            },
                                            {
                                                "example_id": "9bec04e5-4c71-44a2-a1dd-4e1016a2240d",
                                                "sense_id": "8ff67509-d8bb-3c9d-96a1-7bf29f5e17b9",
                                                "text": "We should therefore not make too much of the fraudulence of all that on-screen wailing. Just because North Korean TV never films anything before rehearsing all spontaneity out of it does not mean the average citizen was unmoved."
                                            },
                                            {
                                                "example_id": "d1a6e989-73b6-4cee-8cf7-15ddad55d2bc",
                                                "sense_id": "8ff67509-d8bb-3c9d-96a1-7bf29f5e17b9",
                                                "text": "Among other fraudulences, Enron perfected the art of “mark to market” accounting, tagging mere estimates of future profits as actual on-the-books assets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a30a9c0d-4681-4a15-8985-71249b883388",
                        "source_entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                        "source_sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
