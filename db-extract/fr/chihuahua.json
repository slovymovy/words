                "senses": [
                    {
                        "sense_id": "16d5435f-7c1a-3290-a1d3-9470a23f4341",
                        "entry_id": "5c5ed190-1815-36f1-a4a3-e4e4ab328287",
                        "glosses": [
                            "État du Nord-Ouest du Mexique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d74feb-398d-4689-98a7-ba240f9ed009",
                                "sense_id": "16d5435f-7c1a-3290-a1d3-9470a23f4341",
                                "text": "Victorio et ses hommes, éreintés par une série d’escarmouches avec la cavalerie et les milices, s’étaient arrêtés pour une courte halte. Une longue chevauchée les avait conduits jusqu’ici, dans l’état de Chihuahua, un coin réputé sûr, de l’autre côté de la frontière."
                            }
                        ]
                    },
