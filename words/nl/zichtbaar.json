                    "sense_definition": "Waarneembaar voor het oog; iets dat je kunt zien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De maan is vanavond heel goed <w>zichtbaar</w> aan de hemel.",
                            "target_lang_translations": {
                                "en": "The moon is very clearly <w>visible</w> in the sky tonight.",
                                "ru": "Луна сегодня вечером очень хорошо <w>видна</w> на небе.",
                                "pl": "Księżyc jest dziś wieczorem bardzo dobrze <w>widoczny</w> na niebie.",
                                "de": "Der Mond ist heute Abend am Himmel sehr gut <w>sichtbar</w>.",
                                "fr": "La lune est très bien <w>visible</w> dans le ciel ce soir.",
                                "it": "La luna stasera è molto ben <w>visibile</w> nel cielo.",
                                "cs": "Měsíc je dnes večer na obloze velmi dobře <w>viditelný</w>.",
                                "tr": "Ay bu akşam gökyüzünde çok iyi <w>görünür</w> durumda.",
                                "es": "La luna está muy bien <w>visible</w> en el cielo esta noche.",
                                "zh": "今晚月亮在天空中非常<w>可见</w>。"
                            }
                        },
                        {
                            "text": "Zonder mist is de hoge toren duidelijk <w>zichtbaar</w>.",
