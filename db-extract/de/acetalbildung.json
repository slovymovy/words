                "senses": [
                    {
                        "sense_id": "ffcbe31b-98b0-30a6-82f9-11b5613523e9",
                        "entry_id": "4eefce2d-450a-3846-897b-efc422059c09",
                        "glosses": [
                            "chemische Reaktion, bei der ein Acetal entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1bd85a6-881a-42d9-b53a-d4f5ce57b0dc",
                                "sense_id": "ffcbe31b-98b0-30a6-82f9-11b5613523e9",
                                "text": "„Da die Acetalbildung reversibel ist, macht man sich dies in Synthesen zu Nutze, um Carbonylgruppen vor Umsetzungen zu schützen.“"
                            },
                            {
                                "example_id": "57fcaa25-e7e0-4215-8ed0-bbc80c6a7ee4",
                                "sense_id": "ffcbe31b-98b0-30a6-82f9-11b5613523e9",
                                "text": "„Acetalbildung und -spaltung werden nur von Säuren (besser: durch Protonen) katalysiert.“"
                            },
                            {
                                "example_id": "9a423c7c-f893-41e6-809b-34a4449c3d41",
                                "sense_id": "ffcbe31b-98b0-30a6-82f9-11b5613523e9",
                                "text": "„Die Acetalbildung (Acetalisierung) ist eine chemische Reaktion bei der Acetal entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
