                "senses": [
                    {
                        "sense_id": "70475bb5-480c-318a-bc75-fddcf2ec0a5c",
                        "entry_id": "b969378d-3333-3f85-8832-1d99ec19f38e",
                        "glosses": [
                            "die schnellste in einem bestimmten Kontext (zum Beispiel persönliche, nationale oder in einer Altersklasse) erzielte Zeit auf der Marathondistanz (42,195 km)"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "f09ca0ea-8460-40d3-b4cf-695778f8793f",
                                "sense_id": "70475bb5-480c-318a-bc75-fddcf2ec0a5c",
                                "text": "„Zusammen mit ihrer Tochter Sabrina Mockenhaupt, deren Marathonbestzeit 2:26:21 h beträgt, bildet sie das schnellste Mutter-Tochter-Paar weltweit auf der Marathondistanz.“"
                            },
                            {
                                "example_id": "c3e51afa-3aa6-4059-b474-6cc3b95fd38f",
                                "sense_id": "70475bb5-480c-318a-bc75-fddcf2ec0a5c",
                                "text": "„Das gefiel mir gut und ich konnte streckenweise schön Druck machen und mit 3:24h eine neue persönliche Marathonbestzeit aufstellen.“"
                            },
                            {
                                "example_id": "8563bd3f-819b-4055-8058-6a58fae7bffa",
                                "sense_id": "70475bb5-480c-318a-bc75-fddcf2ec0a5c",
                                "text": "„Monica und Jill sind nicht nur schnelle Läuferinnen mit Marathonbestzeiten von 2:57 und 2:48, sie haben auch ein sicheres Händchen bewiesen, was Produktentwicklung anbelangt.“"
                            },
                            {
                                "example_id": "3717c588-8108-4ef9-9638-17b4f6afc354",
                                "sense_id": "70475bb5-480c-318a-bc75-fddcf2ec0a5c",
                                "text": "„Weitere beeindruckende Leistungen sind z.B. die Marathonbestzeiten von Hermann Achmüller (2h18’56’’), Georg Brunner (2h23’45’’) und Nino La Marchina (2h26’56’’) sowie die Halbmarathonbestzeiten von Hermann Achmüller (1h05’31’’), Georg Brunner (1h06’28’’) und Martin Plankensteiner (1h08’30’’).“"
                            },
                            {
                                "example_id": "5a093ae8-b442-4876-bf6c-53ca3284cc15",
                                "sense_id": "70475bb5-480c-318a-bc75-fddcf2ec0a5c",
                                "text": "„Evas Marathonbestzeit steht, ebenfalls vom Frankfurt Marathon 2019, bei 2:56:10 – Kudos!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
