                "senses": [
                    {
                        "sense_id": "ed8bd5da-35d9-358f-a1d4-3c80a11157a3",
                        "entry_id": "ddf442cb-2a74-31bd-a504-4f5a616d853f",
                        "glosses": [
                            "Witterungslage mit sehr viel Sonnenschein; Bilderbuchwetter kann in allen vier Jahreszeiten vorkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6554691-438d-4bea-9ee2-779f895905a2",
                                "sense_id": "ed8bd5da-35d9-358f-a1d4-3c80a11157a3",
                                "text": "Bilderbuchwetter in Berlin: Der Himmel ist strahlend blau, es ist angenehm warm."
                            },
                            {
                                "example_id": "d6bc4d35-71be-4a0c-9b91-32df1e510d45",
                                "sense_id": "ed8bd5da-35d9-358f-a1d4-3c80a11157a3",
                                "text": "Bei Bilderbuchwetter wurde am letzten Sonntag die Skisaison auf der Zugspitze eröffnet."
                            },
                            {
                                "example_id": "223552e8-f551-4d9e-9b8c-7fa6472a5175",
                                "sense_id": "ed8bd5da-35d9-358f-a1d4-3c80a11157a3",
                                "text": "Bürgerfest im Schlosspark: […] Bei Bilderbuchwetter kommen mehr als 10.000 Besucher zum Amtssitz."
                            },
                            {
                                "example_id": "e47f3066-50cb-4103-9bc9-ca7106e159fd",
                                "sense_id": "ed8bd5da-35d9-358f-a1d4-3c80a11157a3",
                                "text": "So schön ist der Harz bei Bilderbuchwetter: […] Knackiger Frost, blauer Himmel und viel Schnee locken dann Hunderte Wintersportler in die Natur."
                            },
                            {
                                "example_id": "15f708bd-834f-4799-8f43-c01c006a3ac3",
                                "sense_id": "ed8bd5da-35d9-358f-a1d4-3c80a11157a3",
                                "text": "Bilderbuchwetter wird es wohl nicht geben - der ohnehin karge Schnee am Chiemsee taut vor sich hin, für die kommenden Tage sind Wind, Regen und Plusgrade vorhergesagt."
                            },
                            {
                                "example_id": "640034a3-583e-409d-b589-cb8660aaa758",
                                "sense_id": "ed8bd5da-35d9-358f-a1d4-3c80a11157a3",
                                "text": "Die Bilderbuchwetter der letzten Sommer sind bestenfalls ein Indiz für den Klimawandel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
