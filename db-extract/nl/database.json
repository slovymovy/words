                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b9f8503-908b-3dc8-bb25-451c284e6682",
                        "entry_id": "0c82e45e-95da-3eae-8f1a-dc837b97cfab",
                        "glosses": [
                            "een plaats waar informatie over bepaalde onderwerpen in digitale vorm verzameld, opgeslagen en geconsulteerd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738d3d34-926c-4cd1-8971-593758399c6d",
                                "sense_id": "4b9f8503-908b-3dc8-bb25-451c284e6682",
                                "text": "Dit beheersysteem zit gekoppeld aan een database met MySQL."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "489f94f4-1e0b-43c5-bb3c-95b87d3b580b",
                        "source_entry_id": "0c82e45e-95da-3eae-8f1a-dc837b97cfab",
                        "source_sense_id": "4b9f8503-908b-3dc8-bb25-451c284e6682",
                        "source_sense_description": "een plaats waar informatie over bepaalde onderwerpen in digitale vorm verzameld,...",
                        "target_lang_word": "Datenbank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Datenbank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c3ecba3-021c-3cd1-9787-9c1eed3a420f",
                                        "entry_id": "cae46301-6daa-3541-b223-6b047dc823c1",
                                        "glosses": [
                                            "große Menge von Daten, die in einem Rechner nach bestimmten Kriterien organisiert komplexe Abfragen zulassen"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9b58250-97c4-47d3-82f9-667d59d6b5ec",
                                                "sense_id": "9c3ecba3-021c-3cd1-9787-9c1eed3a420f",
                                                "text": "Die Einträge der Wikipedia werden in einer Datenbank gehalten."
                                            },
                                            {
                                                "example_id": "e843c461-b472-4172-9329-8d400dd5fc2c",
                                                "sense_id": "9c3ecba3-021c-3cd1-9787-9c1eed3a420f",
                                                "text": "„Im großen Speicher der Datenbank wird diese Kunstkammer gesichert versinken und auf Zuruf wieder auftauchen, nicht nur in Berlin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5684f9b3-1623-38e2-874e-fbe3399313d1",
                                        "entry_id": "cae46301-6daa-3541-b223-6b047dc823c1",
                                        "glosses": [
                                            "organisierte Sammlung von Daten, die nach verschiedenen Kriterien organisiert sind und abgerufen werden können"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34af0301-a4be-4921-b967-d32d2bef75e4",
                                                "sense_id": "5684f9b3-1623-38e2-874e-fbe3399313d1",
                                                "text": "„Bei der Vornamenberatung in einer Zeit, in der ungewöhnliche, seltene oder unbekannte Vornamen immer beliebter werden und die Vornamenvielfalt stetig zunimmt, können wir mit der neuen Datenbank nun schneller und verlässlicher als zuvor reagieren, die Bearbeitungsprozesse können künftig vereinfacht und beschleunigt werden.“"
                                            },
                                            {
                                                "example_id": "021a3743-118b-420f-a821-a2b55ebb62c3",
                                                "sense_id": "5684f9b3-1623-38e2-874e-fbe3399313d1",
                                                "text": "„Eines davon war, das Erzählgut in einer Datenbank zu sammeln und die Texte zu vereinheitlichen, indem man eine leserfreundliche Orthographie für diese phonetisch komplexe Sprache entwickelte.“"
                                            },
                                            {
                                                "example_id": "13c4d3c1-ec92-4e1f-8979-90cb627a116f",
                                                "sense_id": "5684f9b3-1623-38e2-874e-fbe3399313d1",
                                                "text": "„Und schließlich sind in Datenbanken verankerte Texte nicht Teil eines Kommunikationsprozesses, sondern so etwas wie leblose Archivalien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5b3711b-5357-49ca-8bb2-a21f14c6e459",
                        "source_entry_id": "0c82e45e-95da-3eae-8f1a-dc837b97cfab",
                        "source_sense_id": "4b9f8503-908b-3dc8-bb25-451c284e6682",
                        "source_sense_description": "een plaats waar informatie over bepaalde onderwerpen in digitale vorm verzameld,...",
