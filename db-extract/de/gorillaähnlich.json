                "senses": [
                    {
                        "sense_id": "e1e73735-2d18-36ac-92cd-a8d2fc02eea1",
                        "entry_id": "dcbcc1d8-c8ae-3dc3-8efc-fb87bca5d56e",
                        "glosses": [
                            "einem Gorilla ähnelnd, an einen Gorilla erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae6d6595-35b5-4442-8db1-25f64b7df542",
                                "sense_id": "e1e73735-2d18-36ac-92cd-a8d2fc02eea1",
                                "text": "„Das Ding war ekelhaft - eine schmutzige, blasse, gorillaähnliche Kreatur mit spitzen gelben Reißzähnen und verfilzter Behaarung.“"
                            },
                            {
                                "example_id": "b2ef5a87-d121-4d2a-9f82-21ff8eaf55a3",
                                "sense_id": "e1e73735-2d18-36ac-92cd-a8d2fc02eea1",
                                "text": "„Es wirkte, als bestehe das Ding aus Stein oder Holz, vervollständigt durch gorillaähnliche Augen mit den böswilligen Zügen einer untermenschlichen Rasse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
