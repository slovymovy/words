                                "target_senses": [
                                    {
                                        "sense_id": "9d95eb6d-fc68-3490-b89f-e3e9b3d71be2",
                                        "entry_id": "c804f2ad-d0f8-3ed0-909d-9776ed1eb616",
                                        "glosses": [
                                            "Any mammal in the genus Babyrousa in the pig family Suidae, in which the upper tusk grows upward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b372b23-1c07-43f3-8a78-11b6fabc1dea",
                                                "sense_id": "9d95eb6d-fc68-3490-b89f-e3e9b3d71be2",
                                                "text": "And there are wild pigs, babirusas, with wrinkled skin and impressive upper tusks that instead of growing down, grow up and backwards toward the skull."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b1bb9b9-83c4-4327-8d20-488433022326",
                        "source_entry_id": "0bce16e8-e9f0-3ace-bcd0-1389b5b4cc61",
                        "source_sense_id": "086628cd-063f-35e4-b7cc-97541678f240",
                        "source_sense_description": "Zoologie: Säugetier aus der Familie der Schweine mit mächtigen Hauern",
                        "target_lang_word": "babiroussa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babiroussa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa8f9d20-8de4-3ad5-8a6f-bd8e61d5fa1a",
                                        "entry_id": "a64f5a21-f809-30f9-b59d-2e0a16e0db76",
                                        "glosses": [
                                            "Suidé sauvage, en voie de disparition, vivant en Indonésie et en Papouasie-Nouvelle-Guinée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1542fe-23e0-4d16-8df7-6009268799e5",
                                                "sense_id": "aa8f9d20-8de4-3ad5-8a6f-bd8e61d5fa1a",
                                                "text": "Pour achever de me déterminer, M. Merkus ajouta qu'on lui gardait à Manado deux beaux babiroussas adultes, et qu'il les remettrait à ma disposition si je voulais l'accompagner à Célèbes... De telles offres étaient bien séduisantes ; jamais babiroussa vivant n'avait encore paru en Europe et l'on ne possédait même au Museum aucune dépouille complète de ce curieux animal."
                                            },
                                            {
                                                "example_id": "a2053e7c-1cba-43c4-a215-039f8379e921",
                                                "sense_id": "aa8f9d20-8de4-3ad5-8a6f-bd8e61d5fa1a",
                                                "text": "Le babiroussa est un animal discret et timide, diurne, actif surtout le matin, et qui passe environ la moitié de sa vie à dormir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
