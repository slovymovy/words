                "senses": [
                    {
                        "sense_id": "8d67e172-6235-3cc9-8f5f-a257f45298de",
                        "entry_id": "44454b9a-3c05-3f41-9d29-ab2bc6ee827e",
                        "glosses": [
                            "Jagd auf Robben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ee6555-4d46-4f98-abb8-786cdb2def3d",
                                "sense_id": "8d67e172-6235-3cc9-8f5f-a257f45298de",
                                "text": "„Trotz internationaler Proteste hat die kommerzielle Robbenjagd an Kanadas Ostküste wieder begonnen.“"
                            },
                            {
                                "example_id": "03934288-c380-480c-bdd8-80ddac4ad3dc",
                                "sense_id": "8d67e172-6235-3cc9-8f5f-a257f45298de",
                                "text": "„Zwei der Eisbärinnen begnügten sich mit Kadavern, die erheblich weniger Energie liefern, die anderen beiden Tiere bekamen in dem Zeitraum gar nichts zu kauen. Schrumpft die Eisdecke also weiter, dürfte die Robbenjagd noch seltener Erfolg versprechen als bisher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
