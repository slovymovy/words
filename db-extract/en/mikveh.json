                        "entry_id": "e3cfbc9e-762d-3ecd-9bb8-4ffe8440bdd6",
                        "glosses": [
                            "A ritual bath in which various Jewish purifications are performed."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "6df8374b-52e3-47af-a64f-42a2c70bc151",
                                "sense_id": "0d9636ba-272e-3900-8a79-72d504b3ad22",
                                "text": "On the night before her wedding Channa Washinsky would certainly have immersed herself in the ritually cleansing waters of the mikveh."
                            },
                            {
                                "example_id": "f602d30e-09a9-4c62-b212-d1c01ed1a286",
                                "sense_id": "0d9636ba-272e-3900-8a79-72d504b3ad22",
                                "text": "Adjacent were the remains of a mikvah bath for the ritual purification of women, and a kosher abattoir for the ritual slaughter of beasts [...]."
                            }
                        ]
                    }
