{
    "word_family": [
        "revision",
        "reviser",
        "revising",
        "revised",
        "revisional",
        "revisionism",
        "revisionist"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d60e2b22-57fe-3f56-9b23-4e3c2bd078c5",
                    "sense_definition": "To change or improve a piece of writing, a law, or a plan.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "edit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author had to <w>revise</w> the final chapter after receiving feedback from the editor.",
                            "target_lang_translations": {
                                "ru": "Автору пришлось <w>переработать</w> последнюю главу после получения отзывов от редактора."
                            }
                        },
                        {
                            "text": "The government decided to <w>revise</w> the budget to allocate more funds to education.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>пересмотреть</w> бюджет, чтобы выделить больше средств на образование."
                            }
                        }
                    ],
                    "synonyms": [
                        "overhaul"
                    ],
                    "common_phrases": [
                        "revise a draft",
                        "revise the plan",
                        "revise the law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять или улучшать текст, закон или план."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересматривать",
                                "target_lang_sense_clarification": "план или закон"
                            },
                            {
                                "target_lang_word": "редактировать",
                                "target_lang_sense_clarification": "текст"
                            },
                            {
                                "target_lang_word": "перерабатывать",
                                "target_lang_sense_clarification": "вносить изменения в работу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13625858-50ba-3c0c-8cfb-4c8414252900",
                    "sense_definition": "To study information again, especially to prepare for an exam.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "study",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>revise</w> for my history exam because there are many dates to remember.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>повторить</w> материал к экзамену по истории, потому что нужно запомнить много дат."
                            }
                        },
                        {
                            "text": "It is better to <w>revise</w> notes regularly rather than cramming everything in one night.",
                            "target_lang_translations": {
                                "ru": "Лучше регулярно <w>повторять</w> конспекты, чем зубрить всё в последнюю ночь."
                            }
                        }
                    ],
                    "synonyms": [
                        "review"
                    ],
                    "common_phrases": [
                        "revise for exams",
                        "revise notes",
                        "revise vocabulary"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторно изучать информацию, особенно при подготовке к экзамену."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторять",
                                "target_lang_sense_clarification": "материал перед экзаменом"
                            },
                            {
                                "target_lang_word": "готовиться",
                                "target_lang_sense_clarification": "к тесту или экзамену"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "236c9fce-c007-3720-b352-0440091056ae",
                    "sense_definition": "To think about something again in order to change your opinion or judgment of it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rethink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New evidence has forced the scientists to <w>revise</w> their initial theory about the discovery.",
                            "target_lang_translations": {
                                "ru": "Новые доказательства заставили ученых <w>пересмотреть</w> свою первоначальную теорию об открытии."
                            }
                        },
                        {
                            "text": "After seeing his hard work, I had to <w>revise</w> my opinion of his abilities.",
                            "target_lang_translations": {
                                "ru": "Увидев его усердную работу, мне пришлось <w>изменить</w> свое мнение о его способностях."
                            }
                        }
                    ],
                    "synonyms": [
                        "review"
                    ],
                    "common_phrases": [
                        "revise an opinion",
                        "revise a judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обдумывать что-либо заново, чтобы изменить свое мнение или оценку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересматривать",
                                "target_lang_sense_clarification": "мнение или взгляды"
                            },
                            {
                                "target_lang_word": "изменять",
                                "target_lang_sense_clarification": "свое суждение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12f198ee-83db-3c3c-b3e4-0b994d19c05e",
                    "sense_definition": "An instance of reviewing or the result of a revision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "revision_instance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor sent back the manuscript with several <w>revises</w> marked in red ink.",
                            "target_lang_translations": {
                                "ru": "Редактор вернул рукопись с несколькими <w>правками</w>, отмеченными красными чернилами."
                            }
                        },
                        {
                            "text": "We need to perform a quick <w>revise</w> of the document before the meeting starts.",
                            "target_lang_translations": {
                                "ru": "Нам нужно быстро <w>просмотреть</w> документ перед началом встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "review"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс проверки или результат внесения изменений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правка",
                                "target_lang_sense_clarification": "в тексте"
                            },
                            {
                                "target_lang_word": "пересмотр",
                                "target_lang_sense_clarification": "результат изменения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "369a9e31-be73-38ac-96d8-00165e85bb14",
                    "sense_definition": "A second or subsequent proof sheet used in printing to check corrections.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer provided the <w>revises</w> to ensure all the previous errors were fixed.",
                            "target_lang_translations": {
                                "ru": "Типография предоставила <w>сверки</w>, чтобы убедиться, что все предыдущие ошибки исправлены."
                            }
                        },
                        {
                            "text": "I spent the afternoon checking the <w>revises</w> of the catalogue for any remaining typos.",
                            "target_lang_translations": {
                                "ru": "Я провел вторую половину дня, проверяя <w>корректурные листы</w> каталога на наличие оставшихся опечаток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "page revises"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in printing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Второй или последующий корректурный оттиск в полиграфии для проверки исправлений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверка",
                                "target_lang_sense_clarification": "корректурный лист"
                            },
                            {
                                "target_lang_word": "вторая корректура",
                                "target_lang_sense_clarification": "в печати"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}