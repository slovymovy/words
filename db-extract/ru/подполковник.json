                                "target_senses": [
                                    {
                                        "sense_id": "795e8ed1-b276-326c-8691-6b35b1ac0ecd",
                                        "entry_id": "0eeaf5fc-fa1a-32e0-8f2d-0a908812e4ff",
                                        "glosses": [
                                            "An army officer in many countries, ranking below a colonel and above a major. Often the commander of a battalion or the executive officer of a regiment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f225ff67-90f5-3e0c-8607-f3be34261fdb",
                                        "entry_id": "0eeaf5fc-fa1a-32e0-8f2d-0a908812e4ff",
                                        "glosses": [
                                            "An English-language term used as a general categorization for military officer ranks that are the equivalent of lieutenant colonel, the relative rank level is found in most countries."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23419783-5690-344a-8939-f64e73b7f373",
                                        "entry_id": "0eeaf5fc-fa1a-32e0-8f2d-0a908812e4ff",
                                        "glosses": [
                                            "An officer in the United States Marine Corps or Royal Marines, of equivalent rank to their counterparts in the army."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "945cce13-7c67-3317-9f05-4113112deb91",
                                        "entry_id": "0eeaf5fc-fa1a-32e0-8f2d-0a908812e4ff",
                                        "glosses": [
                                            "An officer in the United States Air Force, Air Force Reserve, or Air National Guard, ranking below colonel and above major. Often the commander of a squadron or the executive officer of a wing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83ab4c16-8ad2-4122-b901-93fc8485e97a",
                        "source_entry_id": "048cae4b-410e-3339-8d17-64801b767af1",
                        "source_sense_id": "d8d6291a-a927-300c-bbd5-e7b3b3dad992",
                        "target_lang_word": "teniente coronel",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6e28d7ce-6c27-4fc9-9f38-921836f5736a",
                        "source_entry_id": "048cae4b-410e-3339-8d17-64801b767af1",
                        "source_sense_id": "d8d6291a-a927-300c-bbd5-e7b3b3dad992",
                        "target_lang_word": "tenente colonnello",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5a2dcaae-f7c2-45d1-bd4c-ca82685340f7",
                        "source_entry_id": "048cae4b-410e-3339-8d17-64801b767af1",
                        "source_sense_id": "d8d6291a-a927-300c-bbd5-e7b3b3dad992",
                        "target_lang_word": "Oberstleutnant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oberstleutnant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad5966a-d14d-3169-a46d-e0cd7c2904a5",
                                        "entry_id": "7bf85338-007b-3e17-8220-69ec412ea771",
                                        "glosses": [
                                            "Stabsoffiziersdienstgrad zwischen dem Major und dem Oberst"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04241834-1018-4bc3-880f-c14e64aa858b",
                                                "sense_id": "2ad5966a-d14d-3169-a46d-e0cd7c2904a5",
                                                "text": "„Er wurde zu Gneisenau geführt und übergab ihm zwei Ordres des Königs: die Mitteilung über den Waffenstillstand und die Beförderung zum Oberstleutnant.“"
                                            },
                                            {
                                                "example_id": "5a308682-2be5-4442-beeb-e55747fa7f14",
                                                "sense_id": "2ad5966a-d14d-3169-a46d-e0cd7c2904a5",
                                                "text": "„Er kehrte im Rang eines Oberstleutnants aus Israel und Angola zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fc459f0-e8f7-3a4c-b5d4-37e1c36483e7",
                                        "entry_id": "7bf85338-007b-3e17-8220-69ec412ea771",
                                        "glosses": [
                                            "Offizier, der den Dienstgrad eines Oberstleutnants innehat"
                                        ],
                                        "tags": [
                                            "Heer",
                                            "Luftwaffe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28853851-15c8-4df9-9c5f-029fc3abedc6",
                                                "sense_id": "4fc459f0-e8f7-3a4c-b5d4-37e1c36483e7",
                                                "text": "Der Oberstleutnant befahl ihm, zehn Liegestütze zu machen."
                                            },
                                            {
                                                "example_id": "2b766f93-5348-405e-abd1-1e62cfccd8ba",
                                                "sense_id": "4fc459f0-e8f7-3a4c-b5d4-37e1c36483e7",
                                                "text": "„[Ferdinand Käs] leitete bis 1963 als Oberstleutnant die Gendarmerieschule und war 1963-1979 im Innenministerium tätig (ging als Sektionschef in Pension).“"
                                            },
                                            {
                                                "example_id": "aa5350f5-b247-4c32-8c76-eb5aa095321e",
                                                "sense_id": "4fc459f0-e8f7-3a4c-b5d4-37e1c36483e7",
                                                "text": "„General sei er nicht, aber Oberstleutnant, sagt mir Willi Rom, als ich anrufe – und hängt nicht ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
