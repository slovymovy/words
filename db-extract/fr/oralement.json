                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852d524d-6ff7-40f2-a05d-ddcc5be47791",
                                                "sense_id": "2d0aca7c-b861-315f-8412-24d9437a1a50",
                                                "text": "This medicine is taken orally. Swallowing a pill sure beats getting a shot every day."
                                            },
                                            {
                                                "example_id": "79237cae-5d66-42f1-81f2-7bb6398bf816",
                                                "sense_id": "2d0aca7c-b861-315f-8412-24d9437a1a50",
                                                "text": "Pleasure your partner orally and manually."
                                            },
                                            {
                                                "example_id": "1116e761-6ca9-4071-86f5-9e4cfaaef40b",
                                                "sense_id": "2d0aca7c-b861-315f-8412-24d9437a1a50",
                                                "text": "But methadone is a dangerous drug. If taken orally by a nonaddict, it can cause euphoria or even death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2d03665-ff52-3d5d-8e10-6fbe177dd9c1",
                                        "entry_id": "997d1728-90fb-3733-907b-a18e1ba0f50f",
                                        "glosses": [
                                            "Spoken as opposed to written."
                                        ],
                                        "tags": [
