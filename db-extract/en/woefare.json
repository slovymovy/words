                        "glosses": [
                            "Discontentment; sorrow; unhappiness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce8f2753-26f9-4a91-b3b5-adfeedf3f134",
                                "sense_id": "37c450cd-45a5-3a19-ba6e-de88ded6de8e",
                                "text": "[...] alone thy food was laughing delight, for feeling's blind and fathomless bliss thy lips were deep in the drink of love — while mine winced at the gall mixed with the woefare of gods? — Thy fooling thought freely then follow ; aloof thou hast left me far."
                            },
                            {
                                "example_id": "21529a34-5864-4eee-8285-a96df7a13bdd",
                                "sense_id": "37c450cd-45a5-3a19-ba6e-de88ded6de8e",
                                "text": "Quoth Abd al-Rahman, \"I fear strangerhood for him, inasmuch as wayfare is the worst of woefare;\" but she said, \"There is no harm in strangerhood for him when it leadeth to gaining good; [...]"
                            }
                        ]
                    }
