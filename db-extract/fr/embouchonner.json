                "senses": [
                    {
                        "sense_id": "0cbcad85-b0b4-3937-86de-ca19e4726621",
                        "entry_id": "ecc791c6-aefb-3382-81a1-a432b40e880b",
                        "glosses": [
                            "Au jeu provençal et à la pétanque, pointer une boule en la collant au but."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9394548-9f35-4f30-9c44-485e31a51ef2",
                                "sense_id": "0cbcad85-b0b4-3937-86de-ca19e4726621",
                                "text": "Cinquième mène : Benson envoie le but à 20 mètres et met un point à deux mètres du bouchon. Bambou pointe et embouchonne ; Charlot tire, frappe et noie le but. La partie recommence."
                            },
                            {
                                "example_id": "3cae7918-7476-4e80-ae64-0be0eca35508",
                                "sense_id": "0cbcad85-b0b4-3937-86de-ca19e4726621",
                                "text": "Il y a des malins qui savent attirer le pigeon et le plumer jusqu'au croupion. Ils commencent par jouer comme des pieds, perdent les premières parties à petites mises et puis quand les paris deviennent intéressants, ils sortent le grand jeu, se mettent à tirer comme des champions, à embouchonner à chaque point et le gogo repart lessivé, parfois, jusqu’à sa montre."
                            }
                        ]
                    }
