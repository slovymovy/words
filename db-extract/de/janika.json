                            {
                                "example_id": "5e569d7c-40c5-4669-a239-7d81277360f4",
                                "sense_id": "a3ac5c3a-9445-3701-a88e-9f98e482d783",
                                "text": "„Nach ihrem Abitur in Tuttlingen studierte Janika Radio- und Fernsehjournalismus im Bachelor.“"
                            },
                            {
                                "example_id": "0d08e47e-7c1a-4f6f-91c9-37e652e06aaa",
                                "sense_id": "a3ac5c3a-9445-3701-a88e-9f98e482d783",
                                "text": "„«Ein Sieg in Janikas Heimat wäre besonders schön», sagt der Weltranglisten-Erste.“"
                            },
                            {
                                "example_id": "fa61dfc8-3b9e-46fb-b43b-f388dcadd7f0",
                                "sense_id": "a3ac5c3a-9445-3701-a88e-9f98e482d783",
                                "text": "„«Seit einem Jahr tanzen die 15-jährige Janika und der 16-jährige Leon zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
