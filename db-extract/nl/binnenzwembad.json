                "senses": [
                    {
                        "sense_id": "6a9f99a1-9628-349b-aafd-373f8580db8c",
                        "entry_id": "08a18502-7e06-340b-8f66-7b20a07bbf40",
                        "glosses": [
                            "zwembad in een gebouw; overdekt zwembad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b381d4c2-c4e2-49b0-8766-b1ec9f4bd7b9",
                                "sense_id": "6a9f99a1-9628-349b-aafd-373f8580db8c",
                                "text": "Twintig kinderen voelden zich gisteren niet lekker nadat ze hadden gezwommen in het binnenzwembad van recreatiepark Droomgaard in Kaatsheuvel. Sommige kinderen hadden last van rode ogen, een droge keel en een paar kregen diarree."
                            },
                            {
                                "example_id": "6cefee85-46c5-4e43-9443-c06f2f269142",
                                "sense_id": "6a9f99a1-9628-349b-aafd-373f8580db8c",
                                "text": "Het Primaverii Paleis, waar de Roemeense ex-dictator Nicolae Ceausescu jarenlang woonde, is na 26 jaar opengesteld voor publiek. Het paleis is een van de grootste gebouwen ter wereld. Het is 270 bij 240 meter, heeft twaalf verdiepingen en acht ondergrondse niveaus. Bezoekers kunnen zich onder meer vergapen aan kristallen kroonluchters, een binnenzwembad en een bioscoop."
                            },
                            {
                                "example_id": "5cecf125-5ec8-4bc6-905f-04913429b5f5",
                                "sense_id": "6a9f99a1-9628-349b-aafd-373f8580db8c",
                                "text": "Op foto's die gedeeld zijn via een Russische Facebook-variant is te zien hoe de jongens vrolijk dobberen in hun provisorisch gemaakte 'binnenzwembad'. Helaas zijn er geen foto's van de woonkamer ná het zwembad-experiment."
                            }
                        ]
                    }
