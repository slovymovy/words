                "senses": [
                    {
                        "sense_id": "25c84a41-244d-3ba9-856a-244433985c6f",
                        "entry_id": "3c2ca72d-b8ef-3692-90a7-c7977c74c33c",
                        "glosses": [
                            "Ouvrir et nettoyer (de la laine, etc.) grâce à un tambour muni de pointes, appelé diable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e9717d-3406-41a1-9d7b-4bf724c2faf3",
                                "sense_id": "25c84a41-244d-3ba9-856a-244433985c6f",
                                "text": "Tout cela a été réformé par l’invention des mécaniques à diabler, drousser et filer la laine."
                            },
                            {
                                "example_id": "ea06db6e-5f0d-466f-b98f-7ecc7312ed19",
                                "sense_id": "25c84a41-244d-3ba9-856a-244433985c6f",
                                "text": "Il est pourvu de machines à battre, à diabler, à drosser, à carder, à filer la laine; de celles à fouler, à lainer et tondre le drap."
                            },
                            {
                                "example_id": "e5b6a1e9-913e-4546-b278-4e0331d9bf45",
                                "sense_id": "25c84a41-244d-3ba9-856a-244433985c6f",
                                "text": "Appelée diable ou loup, machine à diabler, en anglais willow."
                            }
                        ]
                    }
