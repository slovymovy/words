                        "cross_references": [
                            {
                                "target_word": "gout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09e18707-0f59-30f7-863a-4ef62550e6cd",
                                        "entry_id": "b749c29b-38a3-3987-a621-964dadcd1add",
                                        "glosses": [
                                            "An extremely painful inflammation of joints, especially of the big toe, caused by a metabolic defect resulting in the accumulation of uric acid in the blood and the deposition of urates around the joints."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df2a6fa-b209-475b-9b44-d425eaf09312",
                                                "sense_id": "09e18707-0f59-30f7-863a-4ef62550e6cd",
                                                "text": "Once gout was confined largely to Western civilization (with some outliers, like the Mongol ruler Kublai Khan); now its ravages are global."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                        "entry_id": "b749c29b-38a3-3987-a621-964dadcd1add",
                                        "glosses": [
                                            "A drop; a spurt or splotch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95a4788-afb5-48ca-b7db-f02b6039d1cb",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "Alternative forms: gut, gutt"
                                            },
                                            {
                                                "example_id": "9c53b8fc-b86a-4406-9fa9-a9a8970e54c1",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "I see thee still, / And on thy blade and dudgeon gouts of blood."
                                            },
                                            {
                                                "example_id": "d5bf4269-e565-4e79-849d-1018e67bf177",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "... of whose wounds were undefined - and every throb of the veins added length to some of the red streams, that wound down the hollows of the indrawn cheeks - some of them ending in half-clotted gouts or drops."
                                            },
                                            {
                                                "example_id": "219d373d-6cf5-45dd-94ab-1e718effd726",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "... there sprang a gout of black and oozy blood. Whereat a great cry went up and James Mure fell forward on the sand as one suddenly stricken dead."
                                            },
                                            {
                                                "example_id": "5dca2c58-2b04-4508-970a-775c3d58d4f2",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "... gouts or drops from the hand of Zeus."
                                            },
                                            {
                                                "example_id": "024de701-002e-4f96-89db-0b54421810c1",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "... gouts or drops of water on their shield,[…]"
                                            },
                                            {
                                                "example_id": "d18fe2fd-4639-4712-a005-25a3d8103a75",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "[S]mall chunks of rubble and gouts of soot had fallen from the chimney, and were ground into the rug under his unwary feet."
                                            },
                                            {
                                                "example_id": "75bdfd63-ca26-491a-89ca-4baf56708034",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "Another blow sent gouts of blood flying, along with gobbets of flesh."
                                            },
                                            {
                                                "example_id": "645dffdd-0302-4e11-bf0c-462f401d4ab6",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "McInnis staggered back and to his feet, the chair flying aside, as a gout of blood spurted from the open wound. Veiksaar screamed, and reached up to claw at her husband's face with her fingernails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4efb4b-df93-389c-a83c-d9d35ce7cf30",
                                        "entry_id": "b749c29b-38a3-3987-a621-964dadcd1add",
                                        "glosses": [
                                            "A disease of wheat and cornstalks, caused by insect larvae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
