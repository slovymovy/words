                            {
                                "example_id": "e8b4c1af-501e-467a-91e4-b5b118db73a0",
                                "sense_id": "d4ef911f-3940-3a69-9f77-21c259edbd79",
                                "text": "„Herbert Prohaska (* 8. August 1955 in Wien), genannt „Schneckerl“ (wienerisch für seine in der Jugendzeit üppige Lockenpracht), …“"
                            },
                            {
                                "example_id": "ca30804d-e50f-4607-9ec5-f029d4e7dfc6",
                                "sense_id": "d4ef911f-3940-3a69-9f77-21c259edbd79",
                                "text": "„Da kam einmal der Herr Kooperator auf Besuch, und als er Mutter mit den Schneckerln sah, griff er fest in ihr Haar und zog daran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
