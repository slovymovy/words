                "translations": [
                    {
                        "translation_id": "1c62ba78-4d8b-40b5-8af8-f233bd5da7ef",
                        "source_entry_id": "475146f3-b1e3-3b99-ba7d-d4490713813f",
                        "source_sense_description": "covering of tiles",
                        "target_lang_word": "carrelage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carrelage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87d495d9-b052-3b4d-9a22-75bad6f73390",
                                        "entry_id": "3ab57f23-3cc3-3459-ae63-c8072569ac85",
                                        "glosses": [
                                            "Action de carreler, résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "757c0b75-7809-4388-94c8-52172e922bfc",
                                                "sense_id": "87d495d9-b052-3b4d-9a22-75bad6f73390",
                                                "text": "Il m’en a coûté tant pour le carrelage de ma chambre, pour chaque mètre carré de carrelage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dffbaaec-63b0-3f2f-8b0d-5fae0ea7e3eb",
                                        "entry_id": "3ab57f23-3cc3-3459-ae63-c8072569ac85",
                                        "glosses": [
                                            "Type de revêtement de sol des immeubles, à base de carreaux collés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3454c02e-72ea-4461-9781-3372c3cd7525",
                                                "sense_id": "dffbaaec-63b0-3f2f-8b0d-5fae0ea7e3eb",
                                                "text": "Pas de nuit qui ne s’achevât sans esclandre et c’est là qu’un matin, dépêché par le journal où je gagnais ma vie, j’aperçus sur un froid carrelage une fille assassinée."
                                            },
                                            {
                                                "example_id": "65385b17-7705-4e85-a88f-6b778fc07372",
                                                "sense_id": "dffbaaec-63b0-3f2f-8b0d-5fae0ea7e3eb",
                                                "text": "Georges poussa la porte, ouverte comme d’habitude. Il traversa à pas comptés le hall au carrelage glissant, trop bien astiqué, et commença de monter l'escalier."
                                            },
                                            {
                                                "example_id": "f2dcf304-c682-4147-8dfa-9cd07d7785ee",
                                                "sense_id": "dffbaaec-63b0-3f2f-8b0d-5fae0ea7e3eb",
                                                "text": "Sharon laissa tomber son parka sur le carrelage."
                                            },
                                            {
                                                "example_id": "95dcf3eb-4ac5-4f8f-9226-fd218be9d35e",
                                                "sense_id": "dffbaaec-63b0-3f2f-8b0d-5fae0ea7e3eb",
                                                "text": "Il était parti, la laissant seule, dans la chambre quarante-sept du Novotel, la main droite sur la paroi de douche, la main gauche posée sur un grand carrelage beige et les fesses reposant sur le bac de douche blanc où dégoulinaient vers le sterput eau et mousse, se mélangeant en un onctueux panachage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08c82b4e-f20e-30d3-8a66-de2bdc785dbc",
                                        "entry_id": "3ab57f23-3cc3-3459-ae63-c8072569ac85",
                                        "glosses": [
                                            "Théorème du carrelage : Théorème où l’on démontre que les seuls polygones réguliers qui permettent de paver le plan sont le triangle équilatéral, le carré et l’hexagone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a43ef977-ef4d-4745-be87-a6c6d9f87b10",
                        "source_entry_id": "475146f3-b1e3-3b99-ba7d-d4490713813f",
                        "source_sense_description": "covering of tiles",
                        "target_lang_word": "Fliese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fliese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9828dcd-4e64-3108-9011-eaef0aeec2dc",
                                        "entry_id": "bbae9d26-242b-32db-a924-440646a68e2c",
                                        "glosses": [
                                            "dünne Platte aus Keramik, Naturstein oder Glas, die als Belag für Böden oder Verkleidung für Wände dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514a64f6-ea91-413e-84a1-26ce8bfa15f7",
                                                "sense_id": "d9828dcd-4e64-3108-9011-eaef0aeec2dc",
                                                "text": "Die Polizei, davon benachrichtigt, ließ am 17. eine genaue Haussuchung halten, und unter den Fliesen der Küche fand man alsbald den Leichnam des Vermißten in einer frischen Grube, nackend, die Beine rückwärts gegen die Hüften gebunden."
                                            },
                                            {
                                                "example_id": "217f4bf0-bfba-4bee-848f-1912677c235d",
                                                "sense_id": "d9828dcd-4e64-3108-9011-eaef0aeec2dc",
                                                "text": "„Eine große, etwas schadhafte Marquise war hier herabgelassen und gab Schutz gegen die Sonne, deren Lichter durch die schadhaften Stellen hindurchschienen und auf den Fliesen ein Schattenspiel aufführten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c73de25c-470f-3ba1-b847-ddacc7621d21",
                                        "entry_id": "bbae9d26-242b-32db-a924-440646a68e2c",
                                        "glosses": [
                                            "kurz für: Blaue Fliesen, Geld insbesondere Westgeld von blauen 100-DM-Scheinen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06bd624d-af1b-4c31-b9d9-51d51c3386b9",
                        "source_entry_id": "475146f3-b1e3-3b99-ba7d-d4490713813f",
                        "source_sense_description": "covering of tiles",
                        "target_lang_word": "Kachel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kachel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c876ab3-8f6d-3a6a-b190-73ebb58cd9fa",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Ofenkachel; Keramikplatte als Verkleidung und Wärmespeicher für Kachelöfen"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a5c26dd-3a4a-4d50-8a25-a1756bce0d46",
                                                "sense_id": "3c876ab3-8f6d-3a6a-b190-73ebb58cd9fa",
                                                "text": "„Der Unmut des Märchenkönigs bezog sich wohl nicht nur auf die zu grelle Farbe, sondern auch auf die Qualität der Kacheln. Diese wiesen Risse auf, vermutlich wäre der gigantische Ofen gar nicht funktionstüchtig gewesen.“"
                                            },
                                            {
                                                "example_id": "0c61ff7f-a963-4b46-9d68-2685390b35c5",
                                                "sense_id": "3c876ab3-8f6d-3a6a-b190-73ebb58cd9fa",
                                                "text": "„Die Ukrainer zerschlugen diese Öfen, Kachel um Kachel, vermutlich auf der Suche nach Gold.“"
                                            },
                                            {
                                                "example_id": "90462943-e400-4452-a34d-85e7baaa898b",
                                                "sense_id": "3c876ab3-8f6d-3a6a-b190-73ebb58cd9fa",
                                                "text": "„Sie sehen Hamann die Kachel in beide Hände nehmen, um sie mit einem kurzen, aber kräftigen Druck durchzubrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8a737a6-e102-37ff-9278-f1effcc702d8",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Keramikplatte als Belag für Wände und Fußböden"
                                        ],
                                        "tags": [
                                            "besonders süddeutsch und österreichisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108e9d5d-f25e-4129-ad24-7e5a33c7a386",
                                                "sense_id": "f8a737a6-e102-37ff-9278-f1effcc702d8",
                                                "text": "„Das Esszimmer im einstigen Refektorium sieht aus, als würde die königliche Familie minütlich zum Lunch erwartet […]. Der Saal ist bis unter die Decke mit portugiesischen Kacheln ausgekleidet. Die Königskinder konnten missliebige Speisen an die Wand katapultieren, ohne Schaden anzurichten.“"
                                            },
                                            {
                                                "example_id": "8f172d74-674a-40ce-ae0d-3164903612db",
                                                "sense_id": "f8a737a6-e102-37ff-9278-f1effcc702d8",
                                                "text": "„Er fängt an, die Bissen, die er mit der Gabel zu sich nimmt, zu zählen, dann die Kacheln an der Wand.“"
                                            },
                                            {
                                                "example_id": "aa8c6fa3-6976-449b-a415-182bc9ce7375",
                                                "sense_id": "f8a737a6-e102-37ff-9278-f1effcc702d8",
                                                "text": "„Das Dach ist eingestürzt, die schweren Balken liegen kreuz und quer, aber an den Wänden erkennt man noch die Kacheln, wo die Käse- oder die Fleischtheke war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "046bb0ef-23a3-3199-b7fb-fbbac8088730",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Gefäß aus Steingut (kleiner Topf, große Tasse)"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8e5c4cc-d07a-43b4-aa12-f46dcfe3e0bb",
                                                "sense_id": "046bb0ef-23a3-3199-b7fb-fbbac8088730",
                                                "text": "„Er saß noch nicht lange am Tische, so ließ er ein mächtiges halbes Brot in eine Milchkachel fallen, daß die Kachel in Scherben ging und rings am Tische alles mit Milch überspritzt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b2258d1b-f472-3393-8b07-49eadd4f9182",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Nachttopf, Nachtgeschirr"
                                        ],
                                        "tags": [
                                            "Bavarian"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7abfa7d5-a69a-3ec6-9bae-7483ece4e8a0",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Vulva"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e3c6f959-6fda-3d0d-8bc4-e7d369b9ffe5",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "bairisch und schwäbisch, abwertend: Schimpfwort für eine (alte) Frau"
                                        ],
                                        "tags": [],
