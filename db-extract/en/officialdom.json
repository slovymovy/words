                        "examples": [
                            {
                                "example_id": "3e2165d9-b325-4ff4-8362-64d3ac7eacae",
                                "sense_id": "cb453239-e71e-3e58-a7c6-417b6cb7eb34",
                                "text": "This was largely due to its widespread use in the army and officialdom in the Ottoman Empire."
