                                            {
                                                "example_id": "1e62e08d-500d-4ecc-a7dd-976f725f0b9c",
                                                "sense_id": "bb6930dc-66d3-3a88-a5dd-9430e8ff746f",
                                                "text": "Já nic, já muzikant, to ono samo - na mou duši, úplně samo od sebe..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45e04cf6-d7da-36bb-8b59-2922a86475c0",
