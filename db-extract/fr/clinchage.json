                        "entry_id": "46b9eec2-dd29-3863-bae4-cf7a59a3e577",
                        "glosses": [
                            "Procédé d’assemblage de deux tôles minces consistant à les emboutir simultanément entre un poinçon et une matrice pour former un point de jonction par déformation plastique."
                        ],
                        "tags": [
                            "Matériau"
                        ],
                        "examples": [
                            {
                                "example_id": "59fd5b07-6d4b-410b-8d6a-fc0199f4be0b",
                                "sense_id": "c8c2e8e3-d8a5-3423-b90d-7a6310f411d7",
                                "text": "Un assemblage permanent utilise des techniques d’insertion, de soudure, de clinchage (emboutissage), de frettage (dilatation par chauffage) par exemple pour le cerclage des tonneaux ou le bandage des roues, de scellement, de collage."
                            }
                        ]
                    },
