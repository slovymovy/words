                "senses": [
                    {
                        "sense_id": "bbae339e-522b-3b16-854f-bf5391a5d1ec",
                        "entry_id": "11b0a77d-df37-3e72-ae8f-a440e8122fc4",
                        "glosses": [
                            "Gesamtheit der geltenden Gesetze, die den Umgang mit Abfall regeln, insbesondere die Abfallentsorgung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2d904fd-513c-42a7-90dc-c70f0b8f98ef",
                                "sense_id": "bbae339e-522b-3b16-854f-bf5391a5d1ec",
                                "text": "„Beispielsweise hängen Landwirtschaft und Wasser zusammen, denn Düngungen und Pflanzenschutzmittel haben Auswirkungen auf die Wassergüte; oder auch Abfallgesetzgebung und Wasserwirtschaft, weil genauso Stoffe aus Klärschlämmen oder Mülldeponien in den Wasserkreislauf gelangen können […]“"
                            },
                            {
                                "example_id": "adb30cf8-1d97-4fa1-99bc-063c50b8485d",
                                "sense_id": "bbae339e-522b-3b16-854f-bf5391a5d1ec",
                                "text": "„Bei der Abfallgesetzgebung wolle die Kommission jedoch einen neuen, „stärkeren“ Vorschlag vorlegen.“"
                            }
                        ],
