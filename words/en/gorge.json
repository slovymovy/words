{
    "word_family": [
        "gorgeous",
        "gorgerin",
        "gorget",
        "disgorge",
        "engorge",
        "regorge"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02625df2-9b06-3eaa-8965-f9d21ffafaa6",
                    "sense_definition": "A deep, narrow valley with steep, rocky sides, often having a stream or river running through it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A narrow wooden bridge hangs across the rocky <w>gorge</w>, connecting the two cliff paths.",
                            "target_lang_translations": {
                                "de": "Eine schmale Holzbrücke hängt über der felsigen <w>Schlucht</w> und verbindet die beiden Klippenpfade."
                            }
                        },
                        {
                            "text": "The swift river carved a deep <w>gorge</w> through the limestone mountains over millions of years.",
                            "target_lang_translations": {
                                "de": "Der reißende Fluss grub im Laufe von Jahrmillionen eine tiefe <w>Schlucht</w> in das Kalksteingebirge."
                            }
                        }
                    ],
                    "synonyms": [
                        "canyon"
                    ],
                    "common_phrases": [
                        "deep gorge",
                        "narrow gorge",
                        "river gorge"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein tiefes, schmales Tal mit steilen Felswänden, durch das oft ein Fluss oder Bach fließt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schlucht",
                                "target_lang_sense_clarification": "enger, steiler Taleinschnitt"
                            },
                            {
                                "target_lang_word": "Klamm",
                                "target_lang_sense_clarification": "besonders enge Schlucht mit reißendem Wasser"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aef9cd2f-0611-3c59-a6df-b4680e1b7e3b",
                    "sense_definition": "Contents of the stomach that rise into the throat; used especially in figurative expressions of intense disgust.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "throat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>gorge</w> rose in disgust when he saw the horrifying scene before him.",
                            "target_lang_translations": {
                                "de": "Ihm <w>kam die Galle hoch</w> vor Ekel, als er die schreckliche Szene vor sich sah."
                            }
                        },
                        {
                            "text": "The vile smell of decaying food made her <w>gorge</w> rise immediately.",
                            "target_lang_translations": {
                                "de": "Der widerliche Geruch verfaulter Lebensmittel ließ ihr sofort <w>den Magen umdrehen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gorge rises",
                        "make one's gorge rise"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly surviving in the idiom 'make one's gorge rise'"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Aufsteigender Mageninhalt bei Ekelgefühl; meist in Redewendungen für intensiven Abscheu oder Übelkeit verwendet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Galle",
                                "target_lang_sense_clarification": "bildlich, wie in: einem kommt die Galle hoch"
                            },
                            {
                                "target_lang_word": "Mageninhalt",
                                "target_lang_sense_clarification": "aufsteigender Speisebrei bei Brechreiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f5037c1-603e-3607-9f6f-0413ad323ef6",
                    "sense_definition": "The throat, gullet, or esophagus; in falconry, the crop of a hawk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "throat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hawk held the meat firmly inside its <w>gorge</w> before swallowing it completely.",
                            "target_lang_translations": {
                                "de": "Der Falke hielt das Fleisch fest in seinem <w>Kropf</w>, bevor er es ganz herunterschluckte."
                            }
                        },
                        {
                            "text": "The sharp hook had lodged deep in the fish's <w>gorge</w>, making removal impossible.",
                            "target_lang_translations": {
                                "de": "Der scharfe Haken hatte sich tief im <w>Schlund</w> des Fisches festgesetzt, sodass eine Entfernung unmöglich war."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Kehle, Speiseröhre oder der Schlund; in der Falknerei auch der Kropf eines Greifvogels."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kehle",
                                "target_lang_sense_clarification": "vorderer Teil des Halses"
                            },
                            {
                                "target_lang_word": "Schlund",
                                "target_lang_sense_clarification": "Rachenraum, weiter Hals"
                            },
                            {
                                "target_lang_word": "Gurgel",
                                "target_lang_sense_clarification": "Hals, Kehle (umgangssprachlich)"
                            },
                            {
                                "target_lang_word": "Speiseröhre",
                                "target_lang_sense_clarification": "Nahrungsrohr"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1741e59-9f8f-3915-8f3b-852d064c04f5",
                    "sense_definition": "An episode of greedy, excessive eating; a feast or bout of overindulgence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a massive <w>gorge</w> of sweets, the children fell asleep on the living room rug.",
                            "target_lang_translations": {
                                "de": "Nach einer gewaltigen <w>Fressorgie</w> mit Süßigkeiten schliefen die Kinder auf dem Wohnzimmerteppich ein."
                            }
                        },
                        {
                            "text": "The trainer allowed the bird a large <w>gorge</w> every few days to maintain strength.",
                            "target_lang_translations": {
                                "de": "Der Trainer gönnte dem Vogel alle paar Tage ein großes <w>Fressen</w>, um seine Kraft zu erhalten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Anfall von maßlosem, gierigem Essen; eine Fressorgie oder Schlemmerphase."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fressgelage",
                                "target_lang_sense_clarification": "ausgiebiges, maßloses Essen"
                            },
                            {
                                "target_lang_word": "Fressorgie",
                                "target_lang_sense_clarification": "übermäßiges Verschlingen von Nahrung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed26112d-756d-372a-bfd8-eca30c6d9a88",
                    "sense_definition": "A blockage or obstruction of a narrow channel, especially an accumulation of ice in a river.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An enormous ice <w>gorge</w> completely blocked the flow of the thawing river.",
                            "target_lang_translations": {
                                "de": "Ein gewaltiger <w>Eisstau</w> blockierte den Flusslauf des tauenden Flusses vollständig."
                            }
                        },
                        {
                            "text": "Workers used explosives to clear the dangerous <w>gorge</w> before water flooded nearby homes.",
                            "target_lang_translations": {
                                "de": "Arbeiter setzten Sprengstoff ein, um die gefährliche <w>Verstopfung</w> zu beseitigen, bevor Wasser die nahegelegenen Häuser überflutete."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ice gorge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly North American usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Blockade oder Verstopfung eines engen Durchgangs, insbesondere eine Anhäufung von Eis in einem Fluss."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Eisstau",
                                "target_lang_sense_clarification": "Blockade eines Flusses durch Treibeis"
                            },
                            {
                                "target_lang_word": "Verstopfung",
                                "target_lang_sense_clarification": "Blockade eines Durchflusses"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f30d250d-2bc7-3b19-b974-f426b7882bc6",
                    "sense_definition": "To eat greedily and to excess until completely full.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eat_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>gorged</w> themselves on cake and ice cream during the party.",
                            "target_lang_translations": {
                                "de": "Die Kinder <w>stopften sich</w> während der Feier mit Kuchen und Eis <w>voll</w>."
                            }
                        },
                        {
                            "text": "He warned them not to <w>gorge</w> on heavy snacks right before dinner.",
                            "target_lang_translations": {
                                "de": "Er warnte sie davor, sich direkt vor dem Abendessen mit schweren Snacks <w>vollzustopfen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sate",
                        "stuff"
                    ],
                    "common_phrases": [
                        "gorge on",
                        "gorge oneself"
                    ],
                    "target_lang_definitions": {
                        "de": "Gierig und im Übermaß essen, bis man völlig satt ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich vollstopfen",
                                "target_lang_sense_clarification": "sehr viel und hastig essen"
                            },
                            {
                                "target_lang_word": "sich vollfressen",
                                "target_lang_sense_clarification": "gierig essen bis zur Völle (derb)"
                            },
                            {
                                "target_lang_word": "schlemmen",
                                "target_lang_sense_clarification": "reichlich und genussvoll essen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5a9dc83-30d7-36fd-895c-7010df1d4187",
                    "sense_definition": "To swallow food hastily, in large mouthfuls, or with intense greed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eat_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The starving dog quickly <w>gorged</w> the chunk of raw meat without chewing.",
                            "target_lang_translations": {
                                "de": "Der hungernde Hund <w>verschlang</w> den Brocken rohen Fleisches hastig, ohne zu kauen."
                            }
                        },
                        {
                            "text": "Anglers wait patiently until the predatory fish completely <w>gorges</w> the live bait.",
                            "target_lang_translations": {
                                "de": "Angler warten geduldig, bis der Raubfisch den lebenden Köder vollständig <w>verschlingt</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Nahrung hastig, in großen Bissen oder mit übermäßiger Gier hinunterschlingen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschlingen",
                                "target_lang_sense_clarification": "gierig hinunterschlucken"
                            },
                            {
                                "target_lang_word": "hinunterschlingen",
                                "target_lang_sense_clarification": "hastig schlucken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "011ca805-483e-3e31-9fe4-4b068ac0efa1",
                    "sense_definition": "To swell, distend, or obstruct with fluid or solid matter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient's veins were visibly <w>gorged</w> with dark venous blood.",
                            "target_lang_translations": {
                                "de": "Die Venen des Patienten waren sichtbar von dunklem venösem Blut <w>geschwollen</w>."
                            }
                        },
                        {
                            "text": "Broken ice sheets quickly <w>gorged</w> the narrow canal, stopping all boat traffic.",
                            "target_lang_translations": {
                                "de": "Geborstene Eisschollen <w>verstopften</w> rasch den engen Kanal und brachten jeglichen Bootsverkehr zum Erliegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "engorge"
                    ],
                    "target_lang_definitions": {
                        "de": "Durch Flüssigkeit oder feste Stoffe anschwellen, sich stauen oder blockieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anschwellen",
                                "target_lang_sense_clarification": "durch Flüssigkeit dick werden"
                            },
                            {
                                "target_lang_word": "verstopfen",
                                "target_lang_sense_clarification": "eine Passage blockieren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f0de61b-5098-3f1d-9842-edceb507b0a0",
                    "sense_definition": "Extremely attractive or pleasing to look at; <w>gorgeous</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore an absolutely <w>gorge</w> dress to the awards ceremony last night.",
                            "target_lang_translations": {
                                "de": "Sie trug gestern Abend bei der Preisverleihung ein absolut <w>traumhaftes</w> Kleid."
                            }
                        },
                        {
                            "text": "Look at that sunset over the ocean, it is totally <w>gorge</w>.",
                            "target_lang_translations": {
                                "de": "Schau dir diesen Sonnenuntergang über dem Meer an, er ist einfach <w>umwerfend</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "totally gorge"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Äußerst attraktiv, wunderschön oder herrlich anzusehen (umgangssprachliche Kurzform von »gorgeous«)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "traumhaft",
                                "target_lang_sense_clarification": "umwerfend schön"
                            },
                            {
                                "target_lang_word": "umwerfend",
                                "target_lang_sense_clarification": "äußerst attraktiv"
                            },
                            {
                                "target_lang_word": "wunderschön",
                                "target_lang_sense_clarification": "sehr schön"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5c0c44e2-1cd0-3ad1-bfee-8872a42480ee",
                    "sense_definition": "A male given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The birth certificate recorded his first name simply as <w>Gorge</w>.",
                            "target_lang_translations": {
                                "de": "In der Geburtsurkunde war sein Vorname einfach als <w>Gorge</w> eingetragen."
                            }
                        },
                        {
                            "text": "They decided to name their newborn son <w>Gorge</w> after an ancestor.",
                            "target_lang_translations": {
                                "de": "Sie beschlossen, ihren neugeborenen Sohn nach einem Vorfahren <w>Gorge</w> zu nennen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Männlicher Vorname."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gorge",
                                "target_lang_sense_clarification": "männlicher Vorname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}