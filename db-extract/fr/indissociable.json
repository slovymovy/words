        "fr-extract.jsonl": [
            {
                "entry_id": "57be4005-de67-3022-8097-1ed563d20cde",
                "word": "indissociable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b7cf5c79-4667-44fe-b8b8-e5b22fed23fc",
                        "entry_id": "57be4005-de67-3022-8097-1ed563d20cde",
                        "tags": [
                            "plural"
                        ],
                        "form": "indissociables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                        "entry_id": "57be4005-de67-3022-8097-1ed563d20cde",
                        "glosses": [
                            "Que l’on ne peut pas dissocier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053d4fbc-3e33-4a68-a910-0d98d3f324e3",
                                "sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                                "text": "Méthodique, ce connaisseur des métiers d'art, ne s’intéressait pas moins à l’architecture qu'au mobilier domestique, indissociable de celle-ci, et dont il avait commencé une étude inachevée."
                            },
                            {
                                "example_id": "3575eca8-8e64-46a2-941a-3866c247e0c6",
                                "sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                                "text": "Le but du socialisme, c’est la recherche du progrès et la concrétisation de l’aspiration égalitaire dont les composantes - égalité juridique, égalité politique et égalité sociale - sont indissociables et inopposables."
                            },
                            {
                                "example_id": "9fb32085-83b9-4175-aabc-1e843329d0b6",
                                "sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                                "text": "La partie qui s'use le plus rapidement est souvent le silentbloc. Il peut être possible de remplacer ce dernier sans changer le triangle de suspension, sauf lorsque les deux sont indissociables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22e77ba3-0edb-48a1-87cb-a3ef3548b3b2",
                        "source_entry_id": "57be4005-de67-3022-8097-1ed563d20cde",
                        "source_sense_id": "b66cd09f-8c29-3470-8a1f-77e35083d3b4",
                        "target_lang_word": "untrennbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untrennbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eafd4676-f17a-30c2-b270-06ebd76f3bd4",
                                        "entry_id": "717b2547-d753-31f2-acf5-eaa3f231d82c",
                                        "glosses": [
                                            "nicht voneinander zu trennen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64e468c5-4f4b-4ec2-ae6c-dcbb9247a06f",
                                                "sense_id": "eafd4676-f17a-30c2-b270-06ebd76f3bd4",
                                                "text": "Sie bilden eine untrennbare Einheit."
                                            },
                                            {
                                                "example_id": "74e8808e-275e-4f27-bbad-886c644b56b7",
                                                "sense_id": "eafd4676-f17a-30c2-b270-06ebd76f3bd4",
                                                "text": "„Gegen Ende des 19. Jahrhunderts war die Degenerationslehre in Westeuropa (und teilweise in Nordamerika) untrennbar verknüpft mit dem Sozialdarwinismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
