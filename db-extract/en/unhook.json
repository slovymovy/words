                    {
                        "translation_id": "ce04070a-079d-4368-855b-f85bcf430841",
                        "source_entry_id": "8b11f8dd-5d08-3ffd-9e93-b9c87a9e5b64",
                        "source_sense_id": "8194d273-e581-3a92-b5e4-c68d4270d186",
