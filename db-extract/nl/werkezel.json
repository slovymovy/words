                "senses": [
                    {
                        "sense_id": "d1d92ae1-7378-320b-a3a8-36de901dc30c",
                        "entry_id": "c98d9c98-1332-3543-80f2-7a41d0cad7fe",
                        "glosses": [
                            "een ezel die als lastdier of rijdier wordt gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fb2be4-db8a-4f62-a21b-20113b232785",
                                "sense_id": "d1d92ae1-7378-320b-a3a8-36de901dc30c",
                                "text": "Marjo Bruijnes emigreerde acht jaar geleden naar Hongarije. Zij trok zich het lot aan van Tök, een werkezeltje dat kreupel was geslagen."
                            }
                        ]
                    },
                    {
                        "sense_id": "207fcac9-ef4b-3450-8620-9798877309e7",
                        "entry_id": "c98d9c98-1332-3543-80f2-7a41d0cad7fe",
                        "glosses": [
                            "iemand die hard werkt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4cbb7a36-f49a-4012-b3ac-3e3d3356c349",
                                "sense_id": "207fcac9-ef4b-3450-8620-9798877309e7",
                                "text": "Wij spotten wel met hem, we vonden hem wel een werkezel. Als hij even weg geweest was, zeiden we: ‘Wim, ben je wezen wandelen of heb je je proefschrift afgemaakt?’ Daar kon hij goed tegen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b641eba-4b1b-41b2-a8c4-89f294e8bbbf",
                        "source_entry_id": "c98d9c98-1332-3543-80f2-7a41d0cad7fe",
                        "source_sense_id": "d1d92ae1-7378-320b-a3a8-36de901dc30c",
                        "target_lang_word": "wage slave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wage slave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00cd3265-a5c0-3cc4-a24f-5b46ae92248c",
                                        "entry_id": "bda46a51-c005-361b-a1e3-0963eb2baa6f",
                                        "glosses": [
                                            "Someone who works for wages and has little to no professional autonomy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "835a0c04-de78-4a52-bbe5-9ae45cf247c7",
                                                "sense_id": "00cd3265-a5c0-3cc4-a24f-5b46ae92248c",
                                                "text": "The catch is that you have to be invested in order to gnaw on it. The superwealthy will do fine buying and selling things. But many wage slaves just don't have the cash."
                                            },
                                            {
                                                "example_id": "aaa0a9ea-e1ba-4912-b3e5-11c821e4163a",
                                                "sense_id": "00cd3265-a5c0-3cc4-a24f-5b46ae92248c",
                                                "text": "Yankovic stars as George Newman, a daydreaming wage slave whose overactive imagination keeps standing between him and a steady paycheck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd71ff3-4be5-35a1-a90e-3373e7cabcff",
                                        "entry_id": "bda46a51-c005-361b-a1e3-0963eb2baa6f",
                                        "glosses": [
                                            "Someone who does very unpleasant or drudging work for a wage."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edee41b3-52a3-4363-8591-09b0acf3f021",
                        "source_entry_id": "c98d9c98-1332-3543-80f2-7a41d0cad7fe",
                        "source_sense_id": "d1d92ae1-7378-320b-a3a8-36de901dc30c",
                        "target_lang_word": "workhorse",
