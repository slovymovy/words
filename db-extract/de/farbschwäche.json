                "senses": [
                    {
                        "sense_id": "bad00c50-b68d-385e-b745-8641561bf364",
                        "entry_id": "a697d6f4-27d9-3f66-b664-163a3d345513",
                        "glosses": [
                            "angeborene oder erworbene Störung der Wahrnehmung von Farben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e46dc89-0a92-41f6-b4ea-3ab7e511be11",
                                "sense_id": "bad00c50-b68d-385e-b745-8641561bf364",
                                "text": "„Es gibt Menschen, die bestimmte Farben intensiver wahrnehmen, auch Menschen mit einer Farbschwäche.“"
                            },
                            {
                                "example_id": "e77d91d1-8d49-4bdb-ad16-473d775a02e8",
                                "sense_id": "bad00c50-b68d-385e-b745-8641561bf364",
                                "text": "„Obwohl Thryker gut sehen konnten, hatten sie eine evolutionsbedingte Farbschwäche.“"
                            },
                            {
                                "example_id": "d7ef65b7-172a-432b-8e43-d0ea3595488f",
                                "sense_id": "bad00c50-b68d-385e-b745-8641561bf364",
                                "text": "„Hat Ihr Kind im Schulalter mit den Farben immer noch Schwierigkeiten, dann hat es wahrscheinlich eine Farbschwäche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
