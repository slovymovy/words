{
    "word_family": [
        "aanhankelijkheid",
        "aanhangen",
        "aanhanger"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "126f8985-94b6-3213-ba39-38cfa1eaf09d",
                    "sense_definition": "trouw en toegenegen, vaak met de behoefte om dicht bij iemand te zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affectie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat was erg <w>aanhankelijk</w> en wilde de hele avond op schoot liggen.",
                            "target_lang_translations": {
                                "en": "The cat was very <w>affectionate</w> and wanted to lie on my lap all evening."
                            }
                        },
                        {
                            "text": "Onze hond is een <w>aanhankelijk</w> huisdier dat ons overal in huis volgt.",
                            "target_lang_translations": {
                                "en": "Our dog is an <w>attached</w> pet that follows us everywhere in the house."
                            }
                        }
                    ],
                    "synonyms": [
                        "gehecht"
                    ],
                    "antonyms": [
                        "afstandelijk"
                    ],
                    "common_phrases": [
                        "aanhankelijk huisdier",
                        "erg aanhankelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "loyal and affectionate, often with a need to be close to someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "affectionate",
                                "target_lang_sense_clarification": "showing love and fondness"
                            },
                            {
                                "target_lang_word": "attached",
                                "target_lang_sense_clarification": "emotionally connected to someone"
                            },
                            {
                                "target_lang_word": "devoted",
                                "target_lang_sense_clarification": "very loyal and loving"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1f33bd6-7200-3446-8c49-dd38839b427a",
                    "sense_definition": "niet zelfstandig en emotioneel te veel steun zoekend bij anderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afhankelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het onzekere meisje was heel <w>aanhankelijk</w> naar haar vriend en kon geen dag zonder hem.",
                            "target_lang_translations": {
                                "en": "The insecure girl was very <w>clingy</w> toward her boyfriend and couldn't go a day without him."
                            }
                        },
                        {
                            "text": "Zijn gedrag was <w>aanhankelijk</w> als een kind dat zijn moeder nooit loslaat.",
                            "target_lang_translations": {
                                "en": "His behavior was <w>clingy</w> like a child who never lets go of his mother."
                            }
                        }
                    ],
                    "synonyms": [
                        "gehecht"
                    ],
                    "antonyms": [
                        "zelfstandig",
                        "onafhankelijk"
                    ],
                    "common_phrases": [
                        "aanhankelijk gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "not independent and seeking too much emotional support from others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clingy",
                                "target_lang_sense_clarification": "excessively needing to be near someone"
                            },
                            {
                                "target_lang_word": "dependent",
                                "target_lang_sense_clarification": "relying on others for emotional support"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}