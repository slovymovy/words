                                        "sense_id": "a615229e-3667-3473-b206-9d449e3ac562",
                                        "entry_id": "228cc12e-a5fe-3fad-bbba-995cd418f0e0",
                                        "glosses": [
                                            "The leader of a work crew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a762bc-ad9f-44cd-b26b-2fe84d8b0c6f",
                                                "sense_id": "a615229e-3667-3473-b206-9d449e3ac562",
                                                "text": "Since we’re getting too friendly, Ephraim Winslow, tell me, what’s a timber man want with being a wickie? Not enough quiet for ye up north? Sawdust itching yer nethers? Foreman found ye too high-tempered for carrying an axe?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc766d3f-d0d5-32d5-bf72-b2ab10171e42",
                                        "entry_id": "228cc12e-a5fe-3fad-bbba-995cd418f0e0",
                                        "glosses": [
                                            "The member of a jury who presides over it and speaks on its behalf."
                                        ],
