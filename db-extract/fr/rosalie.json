        "fr-extract.jsonl": [
            {
                "entry_id": "929854b1-8775-3637-b9ae-b478f99874c4",
                "word": "Rosalie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "23cee881-37d9-43aa-95fa-eb1b0616d755",
                        "entry_id": "929854b1-8775-3637-b9ae-b478f99874c4",
                        "tags": [],
                        "form": "Rosaly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2227b7f4-89df-3ca0-84fa-0932e678fc2b",
                        "entry_id": "929854b1-8775-3637-b9ae-b478f99874c4",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57046e35-b23e-4805-9d36-63052531a98a",
                                "sense_id": "2227b7f4-89df-3ca0-84fa-0932e678fc2b",
                                "text": "Dis-donc, Rosalie, s’écrie-t-il en s’adressant à sa femme, grosse personne blonde, molle et tavelée."
                            },
                            {
                                "example_id": "a66c87c6-5eef-446d-9e36-12dc3ef2915d",
                                "sense_id": "2227b7f4-89df-3ca0-84fa-0932e678fc2b",
                                "text": "Une chance qu'y a toi qui m'aimes assez pour m'endurer\n C'est comme pendant l' carême, quand j' volais des candy\n J' me considère lucky d'avoir ma Rosalie\n La ville est polluée, l'air est pur dans mon lit."
                            },
                            {
                                "example_id": "08ba8d15-cfee-41da-aed8-8c2efefcd0ce",
                                "sense_id": "2227b7f4-89df-3ca0-84fa-0932e678fc2b",
                                "text": "S’exécutant avec trop de zèle, des agents de la brigade des mœurs embarquent Rosalie Dantremont, prostituée et fille mère, dont le nourrisson, laissé seul et malade dans son berceau durant la garde à vue, meurt."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2a7e589-ff8c-3820-85bd-58d4f42a056f",
                        "entry_id": "929854b1-8775-3637-b9ae-b478f99874c4",
                        "glosses": [
                            "Surnom donné à la baïonnette du fusil Lebel durant la première guerre mondiale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba1e1a9-2f3d-425a-92bb-5d4f906c6a82",
                                "sense_id": "d2a7e589-ff8c-3820-85bd-58d4f42a056f",
                                "text": "L’objet de la vitrine est une baïonnette française, surnommée « Rosalie »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "021d1c62-c207-49b2-acb0-25eabfae3dcb",
                        "source_entry_id": "929854b1-8775-3637-b9ae-b478f99874c4",
