                            {
                                "target_lang_word": "nebula",
                                "target_lang_sense_clarification": "astronomy"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "nébuleuse",
                                "target_lang_sense_clarification": "astronomie"
                            }
                        ]
                    }
                }
