                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9fccd25-d808-3292-9bd1-8e925ea6f4db",
                        "entry_id": "28bbf94c-6ca2-399d-912a-18079c216c5b",
                        "glosses": [
                            "Muskel der Bauchdecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8636972d-0231-40e3-bc9d-4f346a19888f",
                                "sense_id": "b9fccd25-d808-3292-9bd1-8e925ea6f4db",
                                "text": "Um seine Bauchmuskeln zu trainieren, machte er jeden Abend Sit-ups."
                            },
                            {
                                "example_id": "693b7b72-150e-4702-ad0c-584322f45d8f",
                                "sense_id": "b9fccd25-d808-3292-9bd1-8e925ea6f4db",
                                "text": "Diese Übung macht deine Bauchmuskeln hart wie Stahl."
                            },
                            {
                                "example_id": "519cca4c-c12d-42be-8b37-201cd49d1ab5",
                                "sense_id": "b9fccd25-d808-3292-9bd1-8e925ea6f4db",
                                "text": "„Die Zähne klapperten ihm, und die Bauchmuskeln krampften sich zusammen, so daß sein Kopf unter die Oberfläche geriet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2159eb1-b5fa-43c5-9bd2-4304dbd95d12",
                        "source_entry_id": "28bbf94c-6ca2-399d-912a-18079c216c5b",
                        "source_sense_id": "b9fccd25-d808-3292-9bd1-8e925ea6f4db",
