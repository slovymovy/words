                        "sense_id": "3cd7c892-91dc-388e-9ed9-0b395c6ed76e",
                        "entry_id": "6b3f9c20-3461-3720-a2fa-0e63cc2a6b97",
                        "glosses": [
                            "Producing or causing strong feelings and emotions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f92f790-9b9f-4237-b5f2-d9af4a586d2a",
                                "sense_id": "3cd7c892-91dc-388e-9ed9-0b395c6ed76e",
                                "text": "Within this sphere, then, the reader is allowed to follow Hull's growth both as an individual and as a poet. She moves from pieces that are affecting, though merely descriptive, to \"conversations,\" and finally, to strong affirmations spoken in the first person."
                            },
                            {
                                "example_id": "56f46137-b3ae-4491-b7ba-fe4e00b4e47d",
                                "sense_id": "3cd7c892-91dc-388e-9ed9-0b395c6ed76e",
                                "text": "The moment when Tyrion firmly grabs his friend’s arm just before Dany utters the cue for Drogon to burn the eunuch alive is affecting, because it conveys both how much Tyrion cares for his friend, and also how much this is costing him."
                            }
                        ]
                    }
