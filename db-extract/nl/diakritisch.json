                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3607178b-9962-3118-b583-29de6fad92f9",
                                        "entry_id": "a4a6e145-be04-32da-b830-ea89b0a50aaf",
                                        "glosses": [
                                            "Of, pertaining to, or serving as a diacritic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c14d604-676f-42c1-8458-8089b0202703",
                                                "sense_id": "3607178b-9962-3118-b583-29de6fad92f9",
                                                "text": "The reduplicated forms and the fineness of the diacritical strokes, render his book troublesome to the reader"
                                            },
                                            {
                                                "example_id": "a041825d-4e3d-478b-af0a-5c10e48b7fb9",
                                                "sense_id": "3607178b-9962-3118-b583-29de6fad92f9",
                                                "text": "California, like several other states, prohibits the use of diacritical marks or accents on official documents. That means no tilde (~), no accent grave (`), no umlaut (¨) and certainly no cedilla (¸)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diacritical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2c816a-6407-3af8-9d50-996b6d1b706f",
                                        "entry_id": "efee248b-902c-3c04-87c8-0e7d5ba1b1e5",
                                        "glosses": [
                                            "Synonym of diacritical mark (adnoun equivalent)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e04705-2bff-4fae-836f-7f5836285564",
                                                "sense_id": "6f2c816a-6407-3af8-9d50-996b6d1b706f",
                                                "text": "This is often the case when diacriticals are written at the end of the word - the last character ends, but there is still some ink in the original writing order that should have been used up in the course of processing the various t's, i's, and apostrophes in the body of the word."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
