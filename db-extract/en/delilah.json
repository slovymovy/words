            {
                "entry_id": "9461570f-3bdd-3513-9cf3-6731b2c7fa9b",
                "word": "Delilah",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4fc4a6bd-fe59-4fc2-972e-eea36986ff8c",
                        "entry_id": "9461570f-3bdd-3513-9cf3-6731b2c7fa9b",
                        "tags": [
                            "plural"
                        ],
                        "form": "Delilahs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cb09749-0f4a-3921-b0ad-271d407ce3de",
                        "entry_id": "9461570f-3bdd-3513-9cf3-6731b2c7fa9b",
                        "glosses": [
                            "A beautiful, cunning and treacherous woman; a femme fatale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c84642e0-d043-40d0-a8fc-0ecefa1dd5b6",
                                "sense_id": "1cb09749-0f4a-3921-b0ad-271d407ce3de",
                                "text": "He shall burst the bands of this Delilah, as Sampson burst the two new cords with which the Philistines had bound him, and shall slaughter the infidels, even heaps upon heaps. But concerning this foul witch, who hath flung her enchantments over a brother of the Holy Temple, assuredly she shall die the death."
                            },
                            {
                                "example_id": "5ea24998-0f10-4f37-a31d-e08e6ceedc6a",
                                "sense_id": "1cb09749-0f4a-3921-b0ad-271d407ce3de",
                                "text": "Down with this Delilah! Avaunt, O Circe, giver of poisonous feeds. To your natural haunts, ye gentlemen of the press! if bachelors, frequent your taverns, and be content."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a5b2281-586e-30be-9fcb-2ddb51cf77eb",
                        "entry_id": "9461570f-3bdd-3513-9cf3-6731b2c7fa9b",
                        "glosses": [
                            "A libertine; a harlot; a woman of loose morals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f8b533d-db01-438e-bbf5-85e668076deb",
                                "sense_id": "7a5b2281-586e-30be-9fcb-2ddb51cf77eb",
                                "text": "About twenty-three years ago the town talked about Richepin having deserted hearth and home, wife and child, to devote himself to a Delilah in the person of a famous actress."
                            }
                        ]
                    }
                ],
