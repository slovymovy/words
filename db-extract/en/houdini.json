                "senses": [
                    {
                        "sense_id": "070910f0-909a-3f9e-a5ec-f9d314387d29",
                        "entry_id": "4a7875c9-3a0d-3d23-9242-c6e53c153392",
                        "glosses": [
                            "To escape a difficult situation quickly."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7a2cec2f-8eeb-4e54-a088-7ddbfd4b48dd",
                                "sense_id": "070910f0-909a-3f9e-a5ec-f9d314387d29",
                                "text": "“Hey! Let’s go see what the others are up too,” he suggested and Houdinied his way out from between the counter and Lorilei before fleeing to the hallway."
                            },
                            {
                                "example_id": "369704bf-d77a-4741-8293-cf31086555fc",
                                "sense_id": "070910f0-909a-3f9e-a5ec-f9d314387d29",
                                "text": "While she Houdinied out of the sheets she seesawed upright to a sitting position, then, free, she sprang to her feet, her spiffy breasts not the least bit fazed by her thunky dismount."
                            },
                            {
                                "example_id": "571efd80-dada-4622-b622-33a470f453b3",
                                "sense_id": "070910f0-909a-3f9e-a5ec-f9d314387d29",
                                "text": "Friends: to those I Houdini-ed, those I ran away from, those I lied to, took advantage of, or abused in any sort of way, I am sorry."
                            }
                        ]
                    }
