                "senses": [
                    {
                        "sense_id": "e82c040f-b3ef-3e9a-96f5-4a9034c64eb0",
                        "entry_id": "c8f59067-0f5a-3709-b2ec-c87758d287c4",
                        "glosses": [
                            "Transformer en faisant en sorte que ce soit basé sur l’argent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13fb1be3-2e37-45d0-8f16-1225a9f9cd98",
                                "sense_id": "e82c040f-b3ef-3e9a-96f5-4a9034c64eb0",
                                "text": "Ces exigences financières coloniales avaient contribué dans une large mesure à monétariser l'économie et élargir la sphère des échanges marchands."
                            },
                            {
                                "example_id": "1d7645c6-61dd-4ffb-bfa4-f083fd5cf64b",
                                "sense_id": "e82c040f-b3ef-3e9a-96f5-4a9034c64eb0",
                                "text": "Ce n'est pas avant les années 20 que l'administration du royaume a tenté de monétariser le revenu d'une manière significative."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e15fc70-3090-3e26-9779-ad4f8be2be5d",
                        "entry_id": "c8f59067-0f5a-3709-b2ec-c87758d287c4",
                        "glosses": [
                            "Transformer en valeur monétaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ecd16f-e0bc-4d1f-8564-e16287b36b90",
                                "sense_id": "7e15fc70-3090-3e26-9779-ad4f8be2be5d",
                                "text": "Le problème majeur pour ces indicateurs est d’appliquer une méthodologie pertinente pour \"monétariser\" les valeurs non monétaires."
                            }
                        ]
                    }
                ],
