                    },
                    {
                        "translation_id": "6bcf418c-a09d-416d-bdfa-e7644ccc9b2b",
                        "source_entry_id": "6313ea4d-1d05-3671-90b8-acaa322132bd",
                        "source_sense_description": "without pain or trouble",
                        "target_lang_word": "pijnloos",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pijnloos",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "72c1e01b-1001-376d-aade-fca8750e46dd",
                                        "entry_id": "c804f303-a0f7-3ac9-897a-7189e06d70c0",
                                        "glosses": [
                                            "zonder pijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a1b588b-865e-4158-99bb-55cb26ba2c42",
                                                "sense_id": "72c1e01b-1001-376d-aade-fca8750e46dd",
                                                "text": "De dokter zei dat het een pijnloze ingreep zou worden, maar de patiënt gilde het uit van de pijn."
                                            },
                                            {
                                                "example_id": "ae498457-9959-4434-b1df-532ed6f05044",
                                                "sense_id": "72c1e01b-1001-376d-aade-fca8750e46dd",
                                                "text": "Een week van tevoren had ik veel hardgelopen en ik slaagde erin redelijk pijnloos mijn eerste marathon in 4 uur en 18 minuten uit te lopen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea913eca-54da-3aa3-be5b-427b81b80a14",
                                        "entry_id": "c804f303-a0f7-3ac9-897a-7189e06d70c0",
                                        "glosses": [
                                            "zonder vervelende consequenties; zonder moeite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30cfe482-4e48-4dea-b4bd-11d9442bff9e",
                                                "sense_id": "ea913eca-54da-3aa3-be5b-427b81b80a14",
                                                "text": "Wel benadrukt hij dat zo'n stap niet pijnloos is. \"Stel, je doet dat op je huidige land. Dan gaan er minder koeien in de stal, maar die is nog even groot en even duur (die worden vaak gefinancierd door een bank, red.). Hoe los je die kapitaallasten op?\", vraagt Migchels zich hardop af."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf23d031-8c10-4fdf-81ec-a6c09f09b1b1",
                        "source_entry_id": "6313ea4d-1d05-3671-90b8-acaa322132bd",
                        "source_sense_description": "without pain or trouble",
                        "target_lang_word": "indolore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indolore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d68b8a82-1263-3683-8c0f-7890dab1ea87",
                                        "entry_id": "f2fd0468-fdfc-321d-a8c5-ae81eda3bfe2",
                                        "glosses": [
                                            "Qui ne fait pas mal, qui ne cause pas de souffrance, sans douleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88d561e9-1fd4-4159-9a7d-c356836e0375",
                                                "sense_id": "d68b8a82-1263-3683-8c0f-7890dab1ea87",
                                                "text": "Cet examen simple, indolore et faiblement irradiant permet d’analyser la solidité de l’os en mesurant la masse de calcium, la densité minérale osseuse (DMO), donnée en g/cm³. Plus la DMO est faible, plus le risque de fracture est élevé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e466d62c-3aee-3601-9666-323fa32d4581",
                                        "entry_id": "f2fd0468-fdfc-321d-a8c5-ae81eda3bfe2",
                                        "glosses": [
                                            "Qui est le siège d’aucune souffrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b69ae1d-3ad5-46ab-a240-ca9689abe650",
                                                "sense_id": "e466d62c-3aee-3601-9666-323fa32d4581",
                                                "text": "Elle n’avait plus une partie du corps qui fût indolore et cependant il découvrit des places de douleurs presque vides et il les emplit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef81d746-3a0a-4f63-8c87-b8e7b77b347c",
                        "source_entry_id": "6313ea4d-1d05-3671-90b8-acaa322132bd",
                        "source_sense_description": "without pain or trouble",
                        "target_lang_word": "schmerzlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "751470cd-0c93-4ed6-a433-347b9586845b",
                        "source_entry_id": "6313ea4d-1d05-3671-90b8-acaa322132bd",
                        "source_sense_description": "without pain or trouble",
                        "target_lang_word": "schmerzfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schmerzfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eed00c22-4860-3b2a-8946-8fc12f93eed1",
                                        "entry_id": "e7bb7d57-223f-3d95-9449-43ef4b7ebb45",
                                        "glosses": [
                                            "keine Schmerzen verspürend, ohne Schmerzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190145c9-097d-40bb-9956-6b6b99e2a0ef",
                                                "sense_id": "eed00c22-4860-3b2a-8946-8fc12f93eed1",
                                                "text": "„Die Spritzenkur hat angeschlagen, ‚im Alltag bin ich schmerzfrei‘, sagt der Kapitän.“"
                                            },
                                            {
                                                "example_id": "befafb77-253e-450e-80e7-135da1705346",
                                                "sense_id": "eed00c22-4860-3b2a-8946-8fc12f93eed1",
                                                "text": "„Eine milde Mutation, und dein Nachbar ist ein bisschen schmerzfreier als du.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b09c715-be6d-3975-abfa-4d3794b25b83",
                                        "entry_id": "e7bb7d57-223f-3d95-9449-43ef4b7ebb45",
                                        "glosses": [
                                            "keine Schmerzen hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a3f8311-9e19-4ef7-9377-066328e38de8",
                                                "sense_id": "8b09c715-be6d-3975-abfa-4d3794b25b83",
                                                "text": "„Mediziner sind sich einig, dass die Giftspritze noch am ehesten geeignet ist, einen Menschen schmerzfrei zu töten.“"
                                            },
                                            {
                                                "example_id": "e1897332-609c-46ef-b1ff-180057327cde",
                                                "sense_id": "8b09c715-be6d-3975-abfa-4d3794b25b83",
                                                "text": "„Mit vorsichtigen, routinierten Handgriffen führte er das Endstück in Brittas Unterleib ein. Eine schmerzfreie Prozedur, nach zehn Minuten vorbei.“"
                                            },
                                            {
                                                "example_id": "9f1354a8-ebbf-44ee-8695-433af05424e4",
                                                "sense_id": "8b09c715-be6d-3975-abfa-4d3794b25b83",
                                                "text": "„Am wichtigsten sei die Möglichkeit einer schmerzfreien Operation, ohne diese bewusst miterleben zu müssen – die Narkose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8f55959e-1a90-3fd8-9fc6-b02edfbcfbc6",
                                        "entry_id": "e7bb7d57-223f-3d95-9449-43ef4b7ebb45",
                                        "glosses": [
                                            "beim eigenen Handeln unempfindlich/gleichgültig hinsichtlich Peinlichkeit oder Erwartungshaltung/Geschmack"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba5ea9e6-0c3d-44a5-910f-a3aa43739c21",
                                                "sense_id": "8f55959e-1a90-3fd8-9fc6-b02edfbcfbc6",
                                                "text": "„Es gibt allerdings auch die gleichermaßen angst- wie schmerzfreien Kandidaten. Ich erinnere mich […] an einen Generalmusiktirektor […], der […] am zweiten Probentag mit der Frage beeindruckte, was man denn nun noch arbeiten könne? Das ist für ein Orchester […] die Höchststrafe.“"
                                            },
                                            {
                                                "example_id": "3493a7ee-3147-4902-b186-43a1e6b690cc",
                                                "sense_id": "8f55959e-1a90-3fd8-9fc6-b02edfbcfbc6",
                                                "text": "„Die Welt: War es Ihnen nicht unangenehm zu betteln? / Frentzen: Nein. Also, ich bin da absolut schmerzfrei.“"
                                            },
                                            {
                                                "example_id": "abf891c8-942f-4992-b599-343796e7eef7",
                                                "sense_id": "8f55959e-1a90-3fd8-9fc6-b02edfbcfbc6",
                                                "text": "„Aber wie gesagt, die Italiener sind da schmerzfrei. Wer ins Krankenhaus geht, gibt an der Eingangstür seine Intimsphäre und seine Scham ab.“"
                                            },
                                            {
                                                "example_id": "ae6357c4-3150-4e51-bdfe-9e7c8bf3c6f0",
                                                "sense_id": "8f55959e-1a90-3fd8-9fc6-b02edfbcfbc6",
                                                "text": "„›Das ganze ist einfach peinlich‹, sagte sie dann. ›Ist doch kein Problem. Ich bin da völlig schmerzfrei.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
