                "senses": [
                    {
                        "sense_id": "4a84af76-08be-32a5-af2e-3c8b7a84cb30",
                        "entry_id": "33215fa7-ad7c-33df-a457-075455f85562",
                        "glosses": [
                            "Postkutsche für Eilpost, mit der auch Personen befördert werden"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c8f5bdc9-3841-403f-808b-1f8344340237",
                                "sense_id": "4a84af76-08be-32a5-af2e-3c8b7a84cb30",
                                "text": "„Am 29. October ſahen wir die niederen Gebirge Dalmatien’s, und am 30. October mit Tagesanbruch betrat ich Trieſt, von wo ich am folgenden Tage mit dem Eilwagen nach Wien eilte.“"
                            },
                            {
                                "example_id": "7e029a49-2abd-49a0-895b-55bee8403d66",
                                "sense_id": "4a84af76-08be-32a5-af2e-3c8b7a84cb30",
                                "text": "„Senden Sie mir postwendend Ihre Einwilligung und die der Mutter; fahren Sie mit Eilwagen nach Laon, wegen des Dispenses, damit nur ein Aufgebot gleichzeitig in Guise wie in Paris nötig sei.“"
                            },
                            {
                                "example_id": "3e0216ab-3d29-4050-a387-9bff6c892283",
                                "sense_id": "4a84af76-08be-32a5-af2e-3c8b7a84cb30",
                                "text": "„Mit dem Eilwagen ging es dorthin.“"
                            },
                            {
                                "example_id": "85199a03-d5f2-4cce-8ac0-0ad96a10a8b5",
                                "sense_id": "4a84af76-08be-32a5-af2e-3c8b7a84cb30",
                                "text": "„Der Bau dieser Eilwagen wurde in wenige Hände gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
