                                "target_senses": [
                                    {
                                        "sense_id": "9c9a4364-a78e-3c51-86b6-4f9e572c3bdb",
                                        "entry_id": "33f6dd9a-7dce-34ab-ae6c-e9ca60e0d674",
                                        "glosses": [
                                            "Absence, rejet de toute hiérarchie tonale, de toute tonalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c014d453-fdb4-4f7c-9a75-85aa830ff218",
                                                "sense_id": "9c9a4364-a78e-3c51-86b6-4f9e572c3bdb",
                                                "text": "La musique atonale est une musique qui résulte de l’emploi de l’atonalité comme élément de composition."
                                            },
                                            {
                                                "example_id": "7de873a0-bbe3-4e2d-9953-d68f08994fae",
                                                "sense_id": "9c9a4364-a78e-3c51-86b6-4f9e572c3bdb",
                                                "text": "S’agissant de ce passage de la tonalité à l’atonalité, on serait tenté de décrire une opposition entre l’idée d’une rupture, côté Forte, et l’idée d'une continuité, côté Frisch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a385a7e-d5b4-4816-afde-ea698a0c20b1",
                        "source_entry_id": "59ea4ad7-6551-3f30-943d-3292bdf0a3bf",
                        "source_sense_description": "a style of music",
                        "target_lang_word": "Atonalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atonalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee0b9a5-4578-362b-b4fd-4daba532f7b2",
                                        "entry_id": "f11f42c3-583a-3041-b039-c002fdbcf066",
                                        "glosses": [
                                            "Eigenschaft/Kompositionstechnik, die die harmonische, herkömmliche Bezogenheit der Töne zueinander, die Gesetze der Tonalität, meidet und stattdessen atonales Vorgehen zeigt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75ca99a9-f424-4e1c-89d6-d1c638fab5d7",
                                                "sense_id": "8ee0b9a5-4578-362b-b4fd-4daba532f7b2",
                                                "text": "„Arnold Schönbergs (1874–1951) Form von neuer Musik – Atonalität und daraus folgend die Zwölftontechnik – zerbricht jede Harmonie, löst jede tonale Bindung auf, so wie sich in der Malerei das Gegenständliche auflöst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8358ba0-3153-357b-9a64-acbe649696c1",
                                        "entry_id": "f11f42c3-583a-3041-b039-c002fdbcf066",
                                        "glosses": [
                                            "Sequenzen/Passagen/Teile eines Musikstückes, die sich nicht harmonisch anhören"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "mit Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dd68613-3cee-4fb1-8056-705ff2822942",
                                                "sense_id": "d8358ba0-3153-357b-9a64-acbe649696c1",
                                                "text": "„Der Ton wird ‚schriller‘, Themen werden ‚greller‘, die ‚Harmonie‘ nimmt ab, aus Unverbindlichkeit wird Verbindlichkeit. Synkopen, Tempowechsel, Risse, Sprünge, Atonalitäten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
