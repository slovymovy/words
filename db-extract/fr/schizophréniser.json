                "senses": [
                    {
                        "sense_id": "7d30dfda-7b90-3606-9428-4d408c43d9fe",
                        "entry_id": "92bb7989-c800-3274-90eb-1d7f26f61b4f",
                        "glosses": [
                            "Donner un caractère schizophrénique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58163d53-1407-4995-bc58-cd1082fce4ef",
                                "sense_id": "7d30dfda-7b90-3606-9428-4d408c43d9fe",
                                "text": "Schizophréniser, schizophréniser le champ de l’inconscient, et aussi le champ social historique, de manière à faire sauter le carcan d’Œdipe et retrouver partout la force des productions désirantes, renouer à même le Réel le lien de la machine analytique, du désir et de la production ?"
                            },
                            {
                                "example_id": "687a3197-7380-4402-bc8c-236f60dbf267",
                                "sense_id": "7d30dfda-7b90-3606-9428-4d408c43d9fe",
                                "text": "Mais les membres de la tribu des Katos ne se laissent pas schizophréniser."
                            },
                            {
                                "example_id": "547eb7d9-cbcd-487b-85dc-cf794ab17dbb",
                                "sense_id": "7d30dfda-7b90-3606-9428-4d408c43d9fe",
                                "text": "Schizophréniser, c'est couper les codes qui restreignent le désir."
                            },
                            {
                                "example_id": "91288299-ac15-4c49-b46f-a8eb76f03524",
                                "sense_id": "7d30dfda-7b90-3606-9428-4d408c43d9fe",
                                "text": "C'est à force de schizophréniser ces indigents qu'on arrive à les exploser \"à l'insu de leur plein gré\"."
                            },
                            {
                                "example_id": "4be61d90-cea1-4ce1-8ef1-a16b8e5aaf17",
                                "sense_id": "7d30dfda-7b90-3606-9428-4d408c43d9fe",
                                "text": "Et enfin, on schizophrénise la société."
                            }
                        ]
                    }
