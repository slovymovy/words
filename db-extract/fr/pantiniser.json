                        "entry_id": "05990006-3fb4-3a44-8de8-86852246c604",
                        "glosses": [
                            "Donner un caractère de pantin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a887db-d9e2-4ef5-90f5-80c2156b5d5c",
                                "sense_id": "b5ba61bc-0257-34ea-970f-140525e5cf05",
                                "text": "Cette variation permet de pantiniser la proie et la faire glisser insidieusement dans une posture de chasseur."
                            },
                            {
                                "example_id": "67f6d39e-442e-42c3-bb62-47d3a26310d7",
                                "sense_id": "b5ba61bc-0257-34ea-970f-140525e5cf05",
                                "text": "Ah nan mais tu vas pas pantiniser Angie ?"
                            },
                            {
                                "example_id": "ce4f5959-d7d4-4c69-99a6-ea5087933cf9",
                                "sense_id": "b5ba61bc-0257-34ea-970f-140525e5cf05",
                                "text": "Il doit se pantiniser, être parlé, soufflé. Devenir un instrument de musique. Donc en bois – comme le sont souvent les instruments."
                            }
                        ]
                    }
