{
    "word_family": [
        "raad",
        "radeloosheid",
        "beraden",
        "beraad",
        "raadplegen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "63d46469-e4eb-361d-886b-fcda77fdcacd",
                    "sense_definition": "Volledig ten einde raad zijn en niet meer weten hoe men een situatie moet oplossen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wanhoop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de ouders hun zoontje in het drukke winkelcentrum kwijtraakten, waren ze volkomen <w>radeloos</w>.",
                            "target_lang_translations": {
                                "ru": "Когда родители потеряли сына в оживлённом торговом центре, они были в полном <w>отчаянии</w>."
                            }
                        },
                        {
                            "text": "De artsen stonden <w>radeloos</w> aan het bed omdat de oorzaak van de plotselinge ziekte onbekend bleef.",
                            "target_lang_translations": {
                                "ru": "Врачи <w>беспомощно</w> стояли у постели, потому что причина внезапной болезни оставалась неизвестной."
                            }
                        }
                    ],
                    "synonyms": [
                        "[1] wanhopig"
                    ],
                    "antonyms": [
                        "hoopvol"
                    ],
                    "common_phrases": [
                        "volkomen radeloos",
                        "radeloos van verdriet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полное ощущение безысходности, когда человек находится в отчаянии и не знает, как разрешить ситуацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчаявшийся",
                                "target_lang_sense_clarification": "потерявший всякую надежду"
                            },
                            {
                                "target_lang_word": "в отчаянии",
                                "target_lang_sense_clarification": "в состоянии безысходности"
                            },
                            {
                                "target_lang_word": "беспомощный",
                                "target_lang_sense_clarification": "не знающий, что делать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b2c70aa-4cc1-36a2-85ff-f92c7f1b324d",
                    "sense_definition": "Uit diepe wanhoop bereid zijn tot het nemen van uiterste of gevaarlijke maatregelen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wanhoop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>radeloze</w> vluchtelingen waagden ondanks de storm de gevaarlijke oversteek in een klein rubberbootje.",
                            "target_lang_translations": {
                                "ru": "<w>Доведённые до отчаяния</w> беженцы, несмотря на шторм, решились на опасную переправу на небольшой резиновой лодке."
                            }
                        },
                        {
                            "text": "Uit het raam sprong de man in een <w>radeloze</w> poging om aan het vuur te ontsnappen.",
                            "target_lang_translations": {
                                "ru": "Мужчина выпрыгнул из окна в <w>отчаянной</w> попытке спастись от огня."
                            }
                        }
                    ],
                    "synonyms": [
                        "[1] wanhopig"
                    ],
                    "common_phrases": [
                        "een radeloze poging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый из-за глубокого отчаяния пойти на крайние или опасные меры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчаянный",
                                "target_lang_sense_clarification": "совершаемый от безысходности, безудержный"
                            },
                            {
                                "target_lang_word": "доведённый до отчаяния",
                                "target_lang_sense_clarification": "готовый на крайности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55d3032d-b7c2-383d-9642-d2c6f439c6e7",
                    "sense_definition": "Zonder ideeën, richting of antwoord verkeren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onzekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De student staarde naar het examenblad en voelde zich even volkomen <w>radeloos</w> door de moeilijke vragen.",
                            "target_lang_translations": {
                                "ru": "Студент уставился в экзаменационный лист и на мгновение почувствовал полную <w>растерянность</w> из-за трудных вопросов."
                            }
                        },
                        {
                            "text": "Zonder kaart of navigatie dwaalden we urenlang rond en waren we volstrekt <w>radeloos</w> in het bos.",
                            "target_lang_translations": {
                                "ru": "Без карты и навигатора мы часами блуждали и были совершенно <w>беспомощны</w> в лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "[2] ideeëloos",
                        "richtingloos"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказавшийся в растерянности, без идей, решений или направления действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растерянный",
                                "target_lang_sense_clarification": "не знающий выхода или ответа"
                            },
                            {
                                "target_lang_word": "в тупике",
                                "target_lang_sense_clarification": "не находящий решения"
                            },
                            {
                                "target_lang_word": "озадаченный",
                                "target_lang_sense_clarification": "сбитый с толку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}