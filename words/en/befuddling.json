    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b380ad2-ef64-32b3-a940-8022d5fbad7b",
                    "sense_definition": "Causing confusion or perplexity; puzzling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "confusing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions were completely <w>befuddling</w>, leaving everyone unsure of what to do next.",
                            "target_lang_translations": {
                                "es": "Las instrucciones eran completamente <w>desconcertantes</w>, dejando a todos sin saber qué hacer después."
                            }
                        },
                        {
                            "text": "He found the financial contract's legal jargon deeply <w>befuddling</w>.",
                            "target_lang_translations": {
                                "es": "La jerga legal del contrato financiero le pareció profundamente <w>confusa</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "confusing",
                        "puzzling",
                        "perplexing",
                        "baffling",
                        "mystifying"
                    ],
                    "antonyms": [
                        "clear",
                        "straightforward",
                        "clarifying"
                    ],
                    "common_phrases": [
                        "befuddling array",
                        "befuddling question",
                        "befuddling problem"
                    ],
                    "target_lang_definitions": {
                        "es": "Que causa confusión o perplejidad; desconcertante."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desconcertante",
                                "target_lang_sense_clarification": "que confunde o desorienta"
                            },
                            {
                                "target_lang_word": "confuso",
                                "target_lang_sense_clarification": "difícil de comprender"
                            },
                            {
                                "target_lang_word": "perplejo",
                                "target_lang_sense_clarification": "en sentido figurado, que aturde o deja sin saber qué hacer"
                            }
                        ]
                    }
                }
            ]
        },
        {
