                "senses": [
                    {
                        "sense_id": "ee92c523-be7a-32da-9e17-59df2f8425fa",
                        "entry_id": "d288e127-9515-3639-b70b-820f8e0f95fd",
                        "glosses": [
                            "wichtiges islamisches Heiligtum auf dem Tempelberg in Jerusalem mit einem Felsen in der Mitte, unweit von der Al-Aqsa-Moschee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad2d05c-53e2-4b4f-ba96-846f9411ee62",
                                "sense_id": "ee92c523-be7a-32da-9e17-59df2f8425fa",
                                "text": "Der Felsendom wurde zwischen 687 und 691 errichtet und im Lauf der Jahrhunderte vielfach restauriert und verändert, zuletzt durch die äußere Vergoldung der Kuppel."
                            },
                            {
                                "example_id": "d47932ec-45aa-446b-86e3-717e7d4d86db",
                                "sense_id": "ee92c523-be7a-32da-9e17-59df2f8425fa",
                                "text": "Der Felsendom ist eines der häufigsten Fotomotive in Jerusalem."
                            },
                            {
                                "example_id": "75c7f798-109f-4133-8d05-6f17b911bb83",
                                "sense_id": "ee92c523-be7a-32da-9e17-59df2f8425fa",
                                "text": "Der Fels im Felsendom ist nach jüdischer Tradition der Ort der Gründung der Welt, der Ort, wo Abraham den Isaak opfern wollte, der Ort der Bundeslande und das Allerheiligste im Tempel."
                            },
                            {
                                "example_id": "dcc33a1d-a3b0-4b9e-a3b4-eee02af2a464",
                                "sense_id": "ee92c523-be7a-32da-9e17-59df2f8425fa",
                                "text": "Der Fels im Felsendom ist nach islamischer Tradition der Ort, von wo aus Mohammed die Himmelfahrt und seine Begegnung mit den früheren Propheten des Judentums und Jesus angetreten haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
