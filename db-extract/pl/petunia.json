                                        "glosses": [
                                            "Plante du genre Petunia de la famille des solanacées, originaire d’Amérique du Sud, et qu’on cultive en Europe pour l’ornement des jardins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9abae4c-f79e-411d-850e-8e13e9d19e85",
                                                "sense_id": "90e03234-8f12-37ae-9981-65aa108a230b",
                                                "text": "Le pétunia accumule ainsi différents dérivés glycosylés de la cyanidine, de la delphinidine, de la péonidine, de la pétunidine et de la malvidine."
                                            }
                                        ]
                                    }
