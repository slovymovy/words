                        ]
                    },
                    {
                        "translation_id": "5291abb5-3ba2-438d-8f37-17ced24f667a",
                        "source_entry_id": "a8dad1de-547f-359b-ace3-acdf8bbf4864",
                        "target_lang_word": "Lehrende",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ac6a07b3-2439-4bd9-b62a-7b780d853d21",
                        "source_entry_id": "a8dad1de-547f-359b-ace3-acdf8bbf4864",
                        "target_lang_word": "Lehrerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehrerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                        "entry_id": "a4980a55-6d47-3309-aef8-2c34003bf9ca",
                                        "glosses": [
                                            "Vermittlerin von Wissen, die im Allgemeinen auch mit einem Erziehungsauftrag ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d7fb83-d550-4497-90ac-bddf10ba550e",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "Die Lehrerin erklärt mir die Grundrechenarten."
                                            },
                                            {
                                                "example_id": "48b9274f-400d-4fc7-9b05-558e848ba3e7",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Ihre jungen Lehrerinnen mit ihren Kopftüchern und fußlangen Mänteln versuchten kichernd, die Lage zu beruhigen, halb gerührt, halb verschämt, halb stolz auf ihre Schüler, halb entschuldigend.“"
                                            },
                                            {
                                                "example_id": "df4a19c1-c098-480a-898b-76058037951e",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Lehrerin war sie, im Osten Deutschlands.“"
                                            },
                                            {
                                                "example_id": "3cb55f61-32bb-427e-b4b1-a93f047a0e94",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Die Lehrerinnen schauten ihre neue Kollegin nur an – resigniert und ein bisschen mitleidig.“"
                                            },
                                            {
                                                "example_id": "eafbf4fd-0f89-48cd-ae0b-2ab270beef39",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Das fand meine Lehrerin weniger lustig.“"
                                            },
                                            {
                                                "example_id": "9711f425-2aab-427c-8772-3d752df2d7f7",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Die Kirche sei unser Verein, unsere Lehrerin und Lenkerin[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf395633-4c70-4d07-9aea-99b5c8b95fd8",
                        "source_entry_id": "a8dad1de-547f-359b-ace3-acdf8bbf4864",
                        "target_lang_word": "Dozentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dozentin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ddb21e7-9cf6-3d50-ae4f-6d207dc38c9e",
                                        "entry_id": "9d87c1b0-81f7-31ed-bb25-53702410de70",
                                        "glosses": [
                                            "Lehrende (vor allem) an Hochschulen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73940581-4f0f-4ce9-8c98-8336393f4fa7",
                                                "sense_id": "6ddb21e7-9cf6-3d50-ae4f-6d207dc38c9e",
                                                "text": "„Der Lehrstuhl hat im sprachwissenschaftlichen Teil zwei Professorinnen, eine Dozentin, zwei Assistentinnen und vier einheimische Lektoren.“"
                                            },
                                            {
                                                "example_id": "f2f03762-36dd-47dd-bdf7-8df07bebdee6",
                                                "sense_id": "6ddb21e7-9cf6-3d50-ae4f-6d207dc38c9e",
                                                "text": "„Bei der anderen Frau hatte es sich um Marianne Bøge gehandelt, einer Dozentin für Nordische Literatur.“"
                                            },
                                            {
                                                "example_id": "25056a0e-878c-4139-a192-ff2c97f67b43",
                                                "sense_id": "6ddb21e7-9cf6-3d50-ae4f-6d207dc38c9e",
                                                "text": "„Doch auch dies hält ihre Dozentin für falsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a81529a7-5c23-4d11-8d19-9f6c6cb48a51",
                        "source_entry_id": "a8dad1de-547f-359b-ace3-acdf8bbf4864",
                        "target_lang_word": "instructor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instructor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9e8972-2ad2-3993-a43e-e2c34e1d2a9a",
                                        "entry_id": "813696e8-f160-34bf-926a-edaa9be7cf8d",
                                        "glosses": [
                                            "One who instructs; a teacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d2f97e1-ec06-475b-8669-7e47bad89401",
                                                "sense_id": "4f9e8972-2ad2-3993-a43e-e2c34e1d2a9a",
                                                "text": "According to the National Centre for Education Statistics' most recent numbers (2012), 50% of instructors at degree-granting institutions in the US are part-time. […] Through teaching as an adjunct instructor while still a graduate student, I've had the luxury of developing my career: testing out teaching strategies, exploring innovative courses, and developing relationships with students – all while working on my dissertation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bf10e05-46c5-4422-ac97-3513ae1523eb",
                        "source_entry_id": "a8dad1de-547f-359b-ace3-acdf8bbf4864",
                        "target_lang_word": "instructress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instructress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f69977-e203-3dec-8515-83025d02d76e",
                                        "entry_id": "ecbafc23-1dc1-3ad3-8724-efdac2cc3071",
                                        "glosses": [
                                            "A female instructor."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2795e011-8ce6-4917-a9f3-fab37af535cb",
                                                "sense_id": "a4f69977-e203-3dec-8515-83025d02d76e",
                                                "text": "[…] you must allow me to look upon you as my Scholar, in one Sense; as my Companion, in another; and as my Instructress, in a third."
                                            },
                                            {
                                                "example_id": "cdb4e52c-e1b5-428c-a0b7-a0348e663674",
                                                "sense_id": "a4f69977-e203-3dec-8515-83025d02d76e",
                                                "text": "After a short pause Sir Thomas added with dignity, \"Yes, let her home be in this house. We will endeavour to do our duty by her, and she will at least have the advantage of companions of her own age, and of a regular instructress.\""
                                            },
                                            {
                                                "example_id": "8182eb3b-0941-4431-a4fe-4407e725759e",
                                                "sense_id": "a4f69977-e203-3dec-8515-83025d02d76e",
                                                "text": "If she knew her instructress was poor and queer she also knew she was not nearly so ‘qualified’ as Miss Overmore, who could say lots of dates straight off […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
