        "fr-extract.jsonl": [
            {
                "entry_id": "4ca5eba4-dcdb-3a12-b3dc-8faeca6f03ab",
                "word": "courtisanerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4863a131-cb67-43de-bd24-6cef63f2ba32",
                        "entry_id": "4ca5eba4-dcdb-3a12-b3dc-8faeca6f03ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "courtisaneries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24dad633-8b33-3d2e-beda-9d9945c2b464",
                        "entry_id": "4ca5eba4-dcdb-3a12-b3dc-8faeca6f03ab",
                        "glosses": [
                            "Caractère de basse adulation dans les actes ou dans les paroles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e384d1-481f-45d3-8624-0643dbb09f2a",
                                "sense_id": "24dad633-8b33-3d2e-beda-9d9945c2b464",
                                "text": "Il en fut assez de la sorte, et la légende infâme de la courtisanerie française serait aussi longue et aussi touffue que l’épopée même des gloires de la France."
                            },
                            {
                                "example_id": "769619ac-fd9b-4712-b6b8-8b3bb2349358",
                                "sense_id": "24dad633-8b33-3d2e-beda-9d9945c2b464",
                                "text": "Nous allons emplir un bol de lait pour Sa Majesté qui a soif et un pour moi qui l’imite par esprit de courtisanerie."
                            },
                            {
                                "example_id": "78fdacb3-090f-4b16-83d6-5836f61f54b6",
                                "sense_id": "24dad633-8b33-3d2e-beda-9d9945c2b464",
                                "text": "Six mois de nervosité dans les ministères, d’intrigues, de courtisaneries, de petites phrases et de dénégations indignées."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4f754ee-fc6b-30bf-9d28-1393bbbf0ae8",
                        "entry_id": "4ca5eba4-dcdb-3a12-b3dc-8faeca6f03ab",
                        "glosses": [
                            "Pratique de courtisane, de femme du demi-monde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49be48d-3be3-4674-8a2c-85bbf08085b3",
                                "sense_id": "c4f754ee-fc6b-30bf-9d28-1393bbbf0ae8",
                                "text": "Lorenzo. – Jamais arbuste en fleurs n’a promis de fruits plus rares, jamais je n’ai humé dans une atmosphère enfantine plus exquise odeur de courtisanerie."
                            },
                            {
                                "example_id": "30f3d4ef-b29a-4060-8a15-3bbbee554c96",
                                "sense_id": "c4f754ee-fc6b-30bf-9d28-1393bbbf0ae8",
                                "text": "Là, quelle ne fut point ma stupeur en rencontrant, entourée des signes extérieurs les moins contestables de la courtisanerie professionnelle, une jeune fille, si j’ose profaner ce doux terme, que j’avais connue, voilà fort peu d’années, aussi charmante que “sérieuse”."
                            }
                        ]
                    }
                ],
