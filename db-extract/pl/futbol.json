                                        "entry_id": "59e16a03-fdc0-3d21-bc7c-b535bf17591f",
                                        "glosses": [
                                            "Oberbegriff für Mannschaftssportarten, bei denen der Ball mit dem Fuß gespielt wird"
                                        ],
