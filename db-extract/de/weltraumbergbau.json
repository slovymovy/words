                "senses": [
                    {
                        "sense_id": "34488f85-43da-3662-b6e7-3a632c878f40",
                        "entry_id": "9249665b-ac8d-3129-ae27-814bc5a292f5",
                        "glosses": [
                            "Abbau von Rohstoffen auf extraterrestrischen Himmelskörpern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d753e1-d84d-469b-bc2f-8d9ea608aded",
                                "sense_id": "34488f85-43da-3662-b6e7-3a632c878f40",
                                "text": "„Luxemburg will ein Gesetz zum Weltraumbergbau verabschieden, noch bevor das erste Raumschiff abgehoben ist.“"
                            },
                            {
                                "example_id": "88bf414b-e6fa-4498-ab92-cd29766bcaf4",
                                "sense_id": "34488f85-43da-3662-b6e7-3a632c878f40",
                                "text": "„Luxemburg arbeitet an einem Gesetz, das den Weltraumbergbau regelt.“"
                            },
                            {
                                "example_id": "b308de79-ad7b-4627-b58f-a4e767b0fd5e",
                                "sense_id": "34488f85-43da-3662-b6e7-3a632c878f40",
                                "text": "„Schon im kommenden Jahr werde man mit einem speziellen Gesetz die juristischen Grundlagen für den Weltraumbergbau legen, hieß es auf einer Pressekonferenz unter Leitung von Premierminister Xavier Bettel.“"
                            }
                        ],
