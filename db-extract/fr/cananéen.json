                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5815e520-ac50-377d-a384-3d5fe62fd781",
                                        "entry_id": "283c2055-dd2e-3b77-a3da-cdeb278c544a",
                                        "glosses": [
                                            "A subfamily of the Semitic languages, which were spoken by the ancient peoples of the Canaan region, including Canaanites, Israelites and Phoenicians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "904e2118-ea19-434d-93b7-b32eb74b80be",
                                                "sense_id": "5815e520-ac50-377d-a384-3d5fe62fd781",
                                                "text": "An affricated realization of *-z, as well as of voiceless *-s and emphatic *-ṣ-, is in any case reconstructed for Proto-Semitic, Northwest Semitic, and Canaanite, to which Phoenician belongs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Canaanite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "413ecf3d-2fe2-30d0-acb4-7c2ced40b004",
                                        "entry_id": "23f4ca9e-ed25-31f6-b276-c0f392df7d56",
                                        "glosses": [
                                            "A member of the ancient Semitic people who occupied Canaan before its conquest by Israelites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f103283a-2f5e-4188-b36a-efe04c289bf7",
                                                "sense_id": "413ecf3d-2fe2-30d0-acb4-7c2ced40b004",
                                                "text": "Among the ancient Canaanites it was considered a divine honor to perform the sexual act."
                                            },
                                            {
                                                "example_id": "983b8ca4-ad52-4e0e-801c-26ad497a4f67",
                                                "sense_id": "413ecf3d-2fe2-30d0-acb4-7c2ced40b004",
                                                "text": "It’s a simple sentence that captures the hopes and fears of modern-day parents as much as the bronze age Canaanite who owned the doubled-edged ivory comb on which the words appear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65cda339-691a-381e-80b9-78060dad2e98",
                                        "entry_id": "23f4ca9e-ed25-31f6-b276-c0f392df7d56",
                                        "glosses": [
                                            "A zealot or fanatic."
