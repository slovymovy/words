                        "entry_id": "17fe31d0-4cd1-34a9-9b40-3a5a0ba1a88f",
                        "glosses": [
                            "Qui rend perméable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e38cf3b0-049e-478a-9faf-9840d6c8cb04",
                                "sense_id": "c94e962e-19a5-32c3-920c-f630f3ecfc85",
                                "text": "Chez 6 rats sur 10, un oedème est apparu, caractéristique de l’action perméabilisante du dextran au niveau des vaisseaux tégumentaires."
                            },
                            {
                                "example_id": "3607cf0b-d6d4-4cbd-afb6-71c346c3b380",
                                "sense_id": "c94e962e-19a5-32c3-920c-f630f3ecfc85",
                                "text": "Ainsi, seules les manifestations perméabilisantes objectivées par le Bleu sont supprimées par l’action immédiate des rutosides."
                            },
                            {
                                "example_id": "d1bc4d40-8e41-4444-b92e-4c9d15d0125c",
                                "sense_id": "c94e962e-19a5-32c3-920c-f630f3ecfc85",
                                "text": "Les effets perméabilisants qui accompagnent les réactions anaphylactiques cutanées ne sont pas modifiés par l’héparine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
