                                "example_id": "c369e0b5-bc18-4667-9490-0692402a355b",
                                "sense_id": "ecd4f144-6396-3a96-b721-a7986a725a99",
                                "text": "Jaap stak zijn handen in zijn zakken, teutte bij het grondstuk van de Kleine Houtpoort, waar anders het water spoelde."
                            }
                        ]
                    },
                    {
                        "sense_id": "dffb80e4-3bc9-3ef1-bf21-7c056b4f4cd5",
