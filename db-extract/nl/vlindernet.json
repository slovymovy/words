                "senses": [
                    {
                        "sense_id": "1876ffcd-e0b8-3f31-8b04-2167e5123941",
                        "entry_id": "aaaa279f-eb69-322a-a90e-d782e09701f1",
                        "glosses": [
                            "een groot net waarmee men vlinders kan vangen zonder ze te beschadigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99504fff-0fda-41d6-8c77-de2e1afec3b6",
                                "sense_id": "1876ffcd-e0b8-3f31-8b04-2167e5123941",
                                "text": "‘Wat is ’t? Gaat ge vlinders vangen?’ Een vrouw stapt met een hijgende Franse buldog op een onverharde weg achter het station van Herentals en stoot op een volwassen man met een opvouwbaar vlindernet, een miniverrekijker en een tas vol plastic potjes. Hij, de bekende bioloog Hans Van Dyck, antwoordt, met een geruststellend Kempisch accent: ‘Ja, maar we laten ze wel weer los.’"
                            },
                            {
                                "example_id": "6feffabb-3e8f-42d6-aa93-4dce48601690",
                                "sense_id": "1876ffcd-e0b8-3f31-8b04-2167e5123941",
                                "text": "Een briefschrijver ziet geen verschil tussen Pokémon en het vangen van vlinders vroeger (WUZ 14/07). Henk Batelaan uit Leiden wel. „Waarschijnlijk bedoelt hij het kinderboek van Mijnheer Prikkebeen. Welnu, die liep in de natuur met zijn vlindernetje.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "ea463fa5-7aa1-35e8-87c8-e5ec66c0f67c",
                        "entry_id": "aaaa279f-eb69-322a-a90e-d782e09701f1",
                        "glosses": [
                            "Belgisch spel dat dient om cyberpesten te voorkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b80f7c-1a71-40ee-a45c-770833ca3b0e",
                                "sense_id": "ea463fa5-7aa1-35e8-87c8-e5ec66c0f67c",
                                "text": "De middenschool van het Vrij Katholiek Onderwijs (VKO) riep gisteren op om cyberpesten een halt toe te roepen met het VlinderNET-spel naar aanleiding van de Week Tegen Pesten van 10 tot 17februari. VlinderNET is het eerste informatief spel in Vlaanderen over cyberpesten en veilig internet voor jongeren en tien tot vijftien jaar."
                            }
                        ]
                    }
