                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "12eeb4bf-c1d4-3504-b939-3814f3754a5a",
                        "entry_id": "86cc4813-8051-34d7-8f93-de17033dd51f",
                        "glosses": [
                            "iemand hoop, vertrouwen en troost geven bij moeilijkheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf36f3d8-87c8-4213-921b-db15cb629843",
                                "sense_id": "12eeb4bf-c1d4-3504-b939-3814f3754a5a",
                                "text": "Calvijn geeft eerder blijk van een pastorale theologie, die de jonge predikanten en de vervolgde gelovigen in een bange tijd wil vertroosten en behoedzaam bewaren bij het Woord van de volharding."
                            },
                            {
                                "example_id": "f6f3607f-8f94-45d8-9512-0f359dace791",
                                "sense_id": "12eeb4bf-c1d4-3504-b939-3814f3754a5a",
                                "text": "De herinnering is vertroostend, maar roept ook een kinderlijk ongeduld en een afkeer van meegevend vlees in me op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c88936bc-7328-4a84-ba22-8b2e774ad2bb",
                        "source_entry_id": "86cc4813-8051-34d7-8f93-de17033dd51f",
                        "source_sense_id": "12eeb4bf-c1d4-3504-b939-3814f3754a5a",
                        "source_sense_description": "iemand hoop, vertrouwen en troost geven bij moeilijkheden",
                        "target_lang_word": "console",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "console",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95e3ce54-222e-3a3e-92ba-95e586259280",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "A stand-alone cabinet designed to stand on the floor; especially, one integrated with home entertainment equipment, such as a TV or stereo system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9aa189-ae78-4b68-ace9-52b8515e763a",
                                                "sense_id": "95e3ce54-222e-3a3e-92ba-95e586259280",
                                                "text": "The film's music blared from the console."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1b7fe6-4de1-38f2-81d0-d80bb8970570",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "A desk-like cabinet, table, or stand upon which controls, instruments, and displays are mounted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dc79659-b5fa-3e15-a122-40c31206b12f",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "An instrument with displays and an input device that is used to monitor and control an electronic system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d60058a-4818-46d5-970b-1c5fc1c98dd0",
                                                "sense_id": "7dc79659-b5fa-3e15-a122-40c31206b12f",
                                                "text": "The operating console of the new Glasgow Central cabin is divided into four sections, each at an angle to each other and each of which is normally under one signalman's control; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56b48b9-faad-3eaf-bfd2-0197ac46e7cd",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "An instrument with displays and an input device that is used to monitor and control an electronic system.",
                                            "The keyboard and screen of a computer or other electronic device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "418f0d04-9154-3f23-9b7c-60d5c9347c7c",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "An instrument with displays and an input device that is used to monitor and control an electronic system.",
                                            "Abbreviation of video game console."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8623aac6-e02f-465d-9c74-71fc80e99191",
                                                "sense_id": "418f0d04-9154-3f23-9b7c-60d5c9347c7c",
                                                "text": "Consoles continue to gain traction in the video game market."
                                            },
                                            {
                                                "example_id": "8d133d89-e37a-46d5-9a21-871e8cd2db85",
                                                "sense_id": "418f0d04-9154-3f23-9b7c-60d5c9347c7c",
                                                "text": "I rarely play FPS on a PC these days. I'm lazy and it's just so much easier to stick on Halo or Modern Warfare 2 on a console. Plus after a day in front of a PC I don't necessarily want to spend an evening in front of one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d30f7e1-7569-3590-b0e2-89e4c76ea602",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "A storage tray or container mounted between the seats of an automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf75d353-cddc-4784-87f8-e392ddd0251c",
                                                "sense_id": "4d30f7e1-7569-3590-b0e2-89e4c76ea602",
                                                "text": "Could you put my phone in the centre console?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c20eb349-ff73-3b5c-b061-0e0c7d6f83a7",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "An ornamental member jutting out of a wall to carry a superincumbent weight, often S-shaped."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84e95294-5f7c-3668-97dc-912513f1f69b",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "cantilever"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f2642da-e4fe-39a4-af1e-8fbd7b801664",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "A decorative frame or support (in architecture, drawings, etc) around a heraldic shield."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83957be2-10f9-4e33-8c1e-e83ae103946d",
                                                "sense_id": "3f2642da-e4fe-39a4-af1e-8fbd7b801664",
                                                "text": "On an attractive console with two winged putti as supporters [...] is a marriage coat of arms : Dexter, the Paoli arms : Gules (base), a bend azure charged with five lilies gules, and or (chief); Sinister, the[…]"
                                            },
                                            {
                                                "example_id": "757ece74-4ed2-4aa3-b22a-5d516cc94637",
                                                "sense_id": "3f2642da-e4fe-39a4-af1e-8fbd7b801664",
                                                "text": "The only authentic reference for the tincture of the shield still in existence is the armorial console in Jacques Coeur's chapel[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "console",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09453b1d-428b-3e3e-a632-3e97a5736db9",
                                        "entry_id": "a66d0bd1-16a9-3631-a33f-7e628ab68334",
                                        "glosses": [
                                            "To comfort (someone) in a time of grief, disappointment, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8bf12ca-01bf-4078-9258-ca9c6d7682d8",
                                                "sense_id": "09453b1d-428b-3e3e-a632-3e97a5736db9",
                                                "text": "However, she contained herself as best she might, consoled by the reflection that her reasoning had been justified by events."
                                            },
                                            {
                                                "example_id": "6d7fb05d-f4a4-4127-9a4a-1fc743634b9f",
                                                "sense_id": "09453b1d-428b-3e3e-a632-3e97a5736db9",
                                                "text": "1856: Gustave Flaubert, Madame Bovary, Part III Chapter X, translated by Eleanor Marx-Aveling\n\"Do you remember, my friend, that I went to Tostes once when you had just lost your first deceased? I consoled you at that time. I thought of something to say then, but now—\" Then, with a loud groan that shook his whole chest, \"Ah! this is the end for me, do you see! I saw my wife go, then my son, and now to-day it's my daughter.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6eaaec6-cee9-4629-bf42-a792ab1f0371",
                        "source_entry_id": "86cc4813-8051-34d7-8f93-de17033dd51f",
                        "source_sense_id": "12eeb4bf-c1d4-3504-b939-3814f3754a5a",
                        "source_sense_description": "iemand hoop, vertrouwen en troost geven bij moeilijkheden",
                        "target_lang_word": "comfort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comfort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "Contentment, ease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ba6da0-9cdf-4454-afb1-08ce9af2a8f6",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "Sleep in comfort with our new mattress."
                                            },
                                            {
                                                "example_id": "f096a95f-a91f-43c4-a221-4478e96b25db",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "But all was in vain: For having ranged up and down the Woods for ſome days, without finding the leaſt comfort to their hungry deſires, they were forced to return again unto the River. […] At laſt they arrived at the Coaſt of the Sea, where they found ſome comfort and relief to their former miſeries, and alſo means to ſeek more."
                                            },
                                            {
                                                "example_id": "b12b7759-1c30-40b4-b2a2-e203c3f37f1c",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "How often is the comfort of a whole family abridged by some trifling circumstance, that ought not to have made a visible impression!"
                                            },
                                            {
                                                "example_id": "6277940d-74d4-4d2b-a02d-cc5d1ee23bfd",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "In a hole in the ground there lived a hobbit. Not a nasty, dirty, wet hole, filled with the ends of worms and an oozy smell, nor yet a dry, bare, sandy hole with nothing in it to sit down on or to eat: it was a hobbit-hole, and that means comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f578e6e7-61cf-32a1-98de-b35ad9726c04",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "Something that offers comfort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec5c482-f43b-4576-b4c9-5b21d542a44f",
                                                "sense_id": "f578e6e7-61cf-32a1-98de-b35ad9726c04",
                                                "text": "the comforts of home"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fff75c8-aad7-339a-8a89-7abdd8d5f16c",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "A consolation; something relieving suffering or worry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b6956d-da19-41c3-bca1-1511d36523e3",
                                                "sense_id": "3fff75c8-aad7-339a-8a89-7abdd8d5f16c",
                                                "text": "We still have the spare tire? That's a comfort at least."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457a5416-6c79-36ee-b4f3-96d6b028b9da",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "A cause of relief or satisfaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec34e29-0375-4ca6-8c7f-06b6a0a5fdf9",
                                                "sense_id": "457a5416-6c79-36ee-b4f3-96d6b028b9da",
                                                "text": "The outcome of the peace negotiations in Moscow in 1940 was a heavy blow to the young nation, but in the same time a great comfort: at least the independency was preserved."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comfort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                        "entry_id": "f34c54e9-9dc1-35d3-82dd-eb47633965e5",
                                        "glosses": [
                                            "To relieve the distress or suffering of; to provide comfort to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "723626b3-f0f5-413f-8f66-7f61a4088b44",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Rob comforted Aaron because he was lost and very sad."
                                            },
                                            {
                                                "example_id": "5fdf40ef-9d60-4817-bf92-ec5e7f482c5f",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Shew me a token foꝛ good, that they which hate me may ſee it, and bee aſhamed: becauſe thou, Lord, hast holpen me, and comfoꝛted me."
                                            },
                                            {
                                                "example_id": "dbd77268-90e0-4d48-91fa-4ed4fc71306d",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Light, above all things, excelleth in comforting the spirits of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d41f1b2e-7dd0-3657-93bc-7bc1465e07d0",
                                        "entry_id": "f34c54e9-9dc1-35d3-82dd-eb47633965e5",
                                        "glosses": [
                                            "To make strong; to invigorate; to fortify; to corroborate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620e1633-f609-4162-861a-db2383c7afd2",
                                                "sense_id": "d41f1b2e-7dd0-3657-93bc-7bc1465e07d0",
                                                "text": "God's own testimony […] doth not a little comfort and confirm the same."
                                            }
                                        ]
                                    },
