                        ],
                        "examples": [
                            {
                                "example_id": "76e64612-0e98-4fc9-bc27-fc57982f8143",
                                "sense_id": "b3b5015b-2e38-37e2-b90c-39215dd05acf",
                                "text": "Zij heeft lang aan deze ziekte gelaboreerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "76aa5bc9-5f7f-3c50-a231-c3f93e3daa02",
                        "entry_id": "a8f4427c-4160-3ec8-9b6a-b4c33d091529",
                        "glosses": [
                            "met grote moeite ergens aan werken"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "5ed4355a-5258-4e1b-871f-02deacd34751",
                                "sense_id": "76aa5bc9-5f7f-3c50-a231-c3f93e3daa02",
                                "text": "Daaraan is jaren lang gelaboreerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00c8dc3a-a91f-4dfc-8399-646f192c84a2",
                        "source_entry_id": "a8f4427c-4160-3ec8-9b6a-b4c33d091529",
                        "target_lang_word": "labourer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labourer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "534d48c3-cbc2-3cf4-91c6-6268d1cb6373",
                                        "entry_id": "431d95a0-b722-3875-b80e-800e75b43e99",
                                        "glosses": [
                                            "Remuer, retourner la terre en formant des sillons avec la charrue, la houe, et autres instruments aratoires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e25bf4f6-2245-414f-bc66-1cc1d3dbb095",
                                                "sense_id": "534d48c3-cbc2-3cf4-91c6-6268d1cb6373",
                                                "text": "Des closiers labourent des champs perpendiculaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                        "entry_id": "431d95a0-b722-3875-b80e-800e75b43e99",
                                        "glosses": [
                                            "Faire, sur le sol, ou par analogie sur une autre surface, à peu près le même effet que la charrue, la bêche, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "924503e5-ce56-449e-a420-0ee93779edca",
                                                "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                                "text": "Les sangliers ont labouré ce pré."
                                            },
                                            {
                                                "example_id": "dbe92bc7-3b86-409e-840d-4e9e49c61d9e",
                                                "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                                "text": "Les taupes ont labouré tout mon jardin."
                                            },
                                            {
                                                "example_id": "c42579e0-8e47-4989-a7bc-0070e28834d8",
                                                "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                                "text": "Il put donc reconnaître que, s'il avait de-ci de-là, un peu partout, les chairs labourées, aucune de ses blessures ne l'avait atteint en profondeur."
                                            },
                                            {
                                                "example_id": "38ac6cfd-b1e4-4dd2-8ee5-8fc450160709",
                                                "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                                "text": "[…] la mer est devant moi, immense et glauque, rayée de larges ombres violettes, labourée par des vagues profondes, dont les crêtes, balancées çà et là, blanchissent."
                                            },
                                            {
                                                "example_id": "3c40ee56-b7fb-48fa-a806-1f3672f4148c",
                                                "sense_id": "5ee11f09-5189-31ca-bee7-eeaaa818bf59",
                                                "text": "Cheval qui laboure le terrain, se dit d’un cheval qui butte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "196999f7-d763-3f29-8e5f-797f92577312",
                                        "entry_id": "431d95a0-b722-3875-b80e-800e75b43e99",
                                        "glosses": [
                                            "Blesser moralement en profondeur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc5271ea-aa1c-4edc-bce9-e9352551d0de",
                                                "sense_id": "196999f7-d763-3f29-8e5f-797f92577312",
                                                "text": "Nous fûmes, cet été-là, soumis à la plus dangereuse des tentations. Je dis nous… oh! je n'étais alors qu'un frêle petit garçon ; mais je ressentais nos épreuves avec une passion toute fraîche et les misères de mon clan me labouraient jusqu'au fond de l'âme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb1f893-c4d3-3cef-bf2b-6928e9e9752d",
                                        "entry_id": "431d95a0-b722-3875-b80e-800e75b43e99",
                                        "glosses": [
                                            "Se dit d’une ancre qui ne tient pas sur le fond où on l’a jetée, ou d’un navire qui passe et touche le fond sans être arrêté."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d4bb942-e09f-488e-baf4-beb4ba5bd649",
                                                "sense_id": "7eb1f893-c4d3-3cef-bf2b-6928e9e9752d",
                                                "text": "Cette ancre laboure le fond, ou simplement laboure."
                                            },
                                            {
                                                "example_id": "8769ed0e-5cbb-4157-9008-bd55dd391e95",
                                                "sense_id": "7eb1f893-c4d3-3cef-bf2b-6928e9e9752d",
                                                "text": "Notre vaisseau labourait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
