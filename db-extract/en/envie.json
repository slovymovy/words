                        "sense_id": "6f37be85-6d20-39e6-bbec-d03a83faf4af",
                        "entry_id": "bf1314f4-cda3-3256-8667-889fdf311abc",
                        "glosses": [
                            "A strong desire or craving, especially for (a particular kind of) food."
                        ],
                        "tags": [
                            "Louisiana",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "51928bd8-58fb-44b6-b8d0-e0a69aeb5bda",
                                "sense_id": "6f37be85-6d20-39e6-bbec-d03a83faf4af",
                                "text": "\"Oooo, yum.\" Linda licked her lips. \"I had an envie for that.\" An envie is an urge. She walked to the oven, opened it, and looked in."
                            },
                            {
                                "example_id": "5adafc3a-8802-41d9-82d7-4774ed19eb15",
                                "sense_id": "6f37be85-6d20-39e6-bbec-d03a83faf4af",
                                "text": "2018, Mark Vaughan, The Beacon 2: Battle of Nuclear Creek, self-published, unnumbered page,\n\"I had an envie for something sweet so picked up King cakes for dessert. Bit of a lagniappe too, she gave us a dozen not ten.\""
                            },
                            {
                                "example_id": "996d801f-636c-44dc-adb8-0e7bbb81a150",
                                "sense_id": "6f37be85-6d20-39e6-bbec-d03a83faf4af",
                                "text": "\"Sorry about that,\" he said to the man. \"I'm by myself here these days. I had an envie for some Popeye's fried chicken, and dammit if you can't get that kinda thing off your mind until you just get up and go get it.\""
                            }
                        ]
                    }
