                "senses": [
                    {
                        "sense_id": "ea8f2f74-79fd-3fd4-a19e-9eefb8c6c24c",
                        "entry_id": "b59a6a40-a979-3a38-919f-780a0a3fccd7",
                        "glosses": [
                            "niet-eetbare harde kern in de vrucht van een boom uit het ondergeslacht Prunus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0248761-e800-4bf2-b142-3bf590cdfd3f",
                                "sense_id": "ea8f2f74-79fd-3fd4-a19e-9eefb8c6c24c",
                                "text": "Hij spuugt de woorden uit als pruimenpitten, in mitrailleurtempo, tak-tak-tak, zonder enige variatie of ontwikkeling."
                            },
                            {
                                "example_id": "587e6f98-2767-41c2-bb97-fa1b151416d4",
                                "sense_id": "ea8f2f74-79fd-3fd4-a19e-9eefb8c6c24c",
                                "text": "In dit deel heeft Suleiman een aantal fantasieën vormgegeven. Zo blaast hij met een pruimenpit die hij uit het raam gooit een tank op, en verbeeldt hij dat zijn vriendin in slow motion de bewakers met haar schoonheid zo verblindt dat ze gewoon voorbij de grenspost kan lopen, daarna stort deze in; alles met op de soundtrack een stevige technobeat."
                            },
                            {
                                "example_id": "eeb08f06-436f-4a38-ab7e-5613911cdc23",
                                "sense_id": "ea8f2f74-79fd-3fd4-a19e-9eefb8c6c24c",
                                "text": "Alleen, opeengepakt tussen radeloze mensen in een beestenwagon was ze maanden geleden de stad uitgevoerd, en nu zat ze zogenaamd verdiept in een tijdschrift met foto's van filmsterren dat iemand had achtergelaten tegenover Rob - wiens foto ze in Westerbork al had verscheurd en verbrand - op een harde maar riante derdeklasbank, met een zorgvuldig afgekloven pruimenpitje in haar mond."
                            }
                        ]
                    }
