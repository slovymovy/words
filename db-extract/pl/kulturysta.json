                "senses": [
                    {
                        "sense_id": "70e887aa-34d2-3e3d-9ec6-2193b49a31db",
                        "entry_id": "438c2c6a-026f-3615-86c5-6c41323ff85e",
                        "glosses": [
                            "mężczyzna uprawiająca kulturystykę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ee78f8b-83af-4f46-92b8-2f7d407d3797",
                                "sense_id": "70e887aa-34d2-3e3d-9ec6-2193b49a31db",
                                "text": "Kilku bytomskich kulturystów wystąpiło w reklamie maszynki do golenia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "04ccad81-877d-3073-98d1-f0173a89dc44",
                        "entry_id": "438c2c6a-026f-3615-86c5-6c41323ff85e",
                        "glosses": [
                            "człowiek dobrze zbudowany"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bc4d9e2-c00a-4602-80f9-afe367e403e6",
                        "source_entry_id": "438c2c6a-026f-3615-86c5-6c41323ff85e",
                        "source_sense_id": "70e887aa-34d2-3e3d-9ec6-2193b49a31db",
                        "target_lang_word": "bodybuilder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bodybuilder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fed20376-7a1d-370d-8971-79d4701eb705",
                                        "entry_id": "d2487d9f-42f9-32e1-aeff-262e96980ee4",
                                        "glosses": [
                                            "A person who uses diet and exercise to build an aesthetically muscular physique, in order to compete in bodybuilding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b13adf-af12-4e81-94ac-4dc7cf2fb2dd",
                                                "sense_id": "fed20376-7a1d-370d-8971-79d4701eb705",
                                                "text": "Physique of powerful bodybuilder (below) is like piece of sculpture. Buffs strive for the well-rounded body, disdain the professional weightlifter, who merely develops a number of very specialized muscles."
                                            },
                                            {
                                                "example_id": "73675f66-0042-42c1-8a9f-77e6692950a7",
                                                "sense_id": "fed20376-7a1d-370d-8971-79d4701eb705",
                                                "text": "Because it is necessary for a muscle to rest while it grows and because of the importance of balanced development, most competitive bodybuilders train on a split routine; they work certain parts of the body one day and rest those muscles the next while they work the others, alternating like that six days a week."
                                            },
                                            {
                                                "example_id": "4e981e60-6f7b-4b7b-a5bc-ddd5e7704e89",
                                                "sense_id": "fed20376-7a1d-370d-8971-79d4701eb705",
                                                "text": "In the competitions, bodybuilders go through \"mandatories\"—a set of mandatory poses—in the morning, where the judges compare the body parts of the builders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                        "entry_id": "d2487d9f-42f9-32e1-aeff-262e96980ee4",
                                        "glosses": [
                                            "Rare form of body-builder (“one who builds vehicle bodies”)."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e044390-8406-42ea-b012-d68ca1148629",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "COACH BODYBUILDER wanted. Apply omnibus stables, Camberwell."
                                            },
                                            {
                                                "example_id": "b7c63897-cf3f-4374-8c4a-913b2d4435b7",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "COACHMAKERS.—Wanted, three IMPROVERS to the bodymaking, all new work. Greenfield and Callaway, bodybuilders to the trade, Milson’s Steam Works, 121, Liverpool-street."
                                            },
                                            {
                                                "example_id": "4eb86071-8936-4fb7-8330-81d5bd5fd9d6",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, First-class Coachsmith and Bodybuilder.—Apply to M. Bohan, Wellington Coach Factory, Wellington."
                                            },
                                            {
                                                "example_id": "e8545c3b-3746-4026-bfa4-fa0c5d32b866",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, a first-class Wheelwright and Bodybuilder; state where last employed. Apply to A. Gilmore, Tauranga."
                                            },
                                            {
                                                "example_id": "2b10faea-9c0f-4a13-bc45-5f49b5464788",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, BODYBUILDER to repair Cabs. 39 Turner-street. Redfern."
                                            },
                                            {
                                                "example_id": "e2f1e11f-a014-4ced-a49e-0c81c52f4dd9",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, a good Wheelwright and Bodybuilder: a constant job. Apply to M. Bohan, Wellington Coach Factory, Victoria-street."
                                            },
                                            {
                                                "example_id": "3549545e-a9d3-4b15-bd6d-362f251ed7f1",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "BODYBUILDERS.—Ted., Redfern,—Go to shop where you met me with bicycle,—a chance."
                                            },
                                            {
                                                "example_id": "a9339c88-5c6e-42a7-a641-4c9a77aea756",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "WANTED, first-class BODYBUILDER. Apply W. Brett, Rozelle, Balmain."
                                            },
                                            {
                                                "example_id": "551334ab-859d-467b-88a2-0a7bc24dc136",
                                                "sense_id": "cba8b59c-6339-3631-9892-992007854c75",
                                                "text": "BLACKSMITHS and bodybuilders. Fulton & Walker Co., 20th and Filbert."
                                            }
