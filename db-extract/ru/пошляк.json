                                        "examples": [
                                            {
                                                "example_id": "35572d21-e8ed-43e8-8bdc-6b2109b838c4",
                                                "sense_id": "a0efaddf-a2f0-37ea-9d97-b5627ddc3a59",
                                                "text": "Weź mi nie mów, że rap to wulgarna muzyka, bez przesłania"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
