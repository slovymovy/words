                        "examples": [
                            {
                                "example_id": "54aa7922-c84d-46d5-9838-8e24e273a7ba",
                                "sense_id": "9adb02a0-f087-3323-b64b-95baf6d36df6",
                                "text": "Ukiland is een speelparadijs voor de allerkleinsten in Kinderland, de overdekte speelzone van Bobbejaanland. Deze indoor speeltuin is de uitvalbasis van het vrolijke figuurtje Uki, die nu samen met zijn vriendjes in Bobbejaanland woont om de kleinste telgen te vermaken."
                            },
                            {
                                "example_id": "492d8b02-9f89-46ff-ac4e-6d2d918f915e",
                                "sense_id": "9adb02a0-f087-3323-b64b-95baf6d36df6",
                                "text": "Een ruimte van 220 vierkante meter is tijdelijk praktisch ingericht om vermoeide of wachtende reizigers op te vangen, zo meldt hln.be. Naast slaapruimtes voor powernaps, is er ook aan de jeugdige luchthavenbezoekerjes gedacht. Kinderen kunnen kunnen hun lol op in de 'bewaakte' speelzone. Tot 5 augustus kunnen de passerende reizigers voor een powernap neerstrijken bij de pop-up lounge in terminal 3."
                            }
                        ]
                    }
