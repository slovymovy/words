                                        "examples": [
                                            {
                                                "example_id": "c08bc3e9-8595-4124-992e-4ad9db1377bd",
                                                "sense_id": "07971c72-7a5e-3522-a8cf-7fc77d4dbf64",
                                                "text": "Les amygdales sont des glandules."
                                            },
                                            {
                                                "example_id": "05022783-019e-4322-aef8-1abf4017abd3",
                                                "sense_id": "07971c72-7a5e-3522-a8cf-7fc77d4dbf64",
                                                "text": "Ses traits étaient d'une grande régularité ; seulement, ses yeux étaient trop rapprochés, et il me sembla que, d'une glandule lacrymale à l'autre, il n'y avait pas la place d'un œil, comme l'exige le canon des sculpteurs grecs."
                                            },
                                            {
                                                "example_id": "e00b69cc-3aaa-4144-95ce-e7bb901fdc5b",
                                                "sense_id": "07971c72-7a5e-3522-a8cf-7fc77d4dbf64",
                                                "text": "La glandule interne, de dimensions généralement moindres que l’externe, siège assez constamment soit dans le nodule fibro-vasculaire qui forme le centre du lobe latéral, soit au voisinage de la face interne de celui-ci."
                                            }
                                        ]
                                    }
