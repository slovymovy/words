                            },
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "внезапное сильное проявление чувства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb541a12-0482-30aa-b426-991605aa6491",
                    "sense_definition": "A bite or sting, especially from a gadfly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse bolted across the field after suffering a sharp <w>oestrus</w> from a fly.",
                            "target_lang_translations": {
                                "ru": "Лошадь рванула через поле, почувствовав резкий <w>укус</w> овода."
                            }
                        },
                        {
                            "text": "She applied a soothing herbal ointment to the painful <w>oestrus</w> on her arm.",
                            "target_lang_translations": {
