                ],
                "senses": [
                    {
                        "sense_id": "1afa50d2-22e1-3812-8b54-722cd35d4bca",
                        "entry_id": "31705fff-1ab0-3d36-8eb7-c065b50c351a",
                        "glosses": [
                            "уменьш. к мешок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db7c99fc-be92-43ab-9d90-91ffd68b3563",
                                "sense_id": "1afa50d2-22e1-3812-8b54-722cd35d4bca",
                                "text": "Он был без шапки и в мелких калошах на босую ногу и в руках держал небольшой мешочек с милостыней."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6ff4d78-a8e2-43fe-9cfb-03af587ecff9",
                        "source_entry_id": "31705fff-1ab0-3d36-8eb7-c065b50c351a",
                        "source_sense_id": "1afa50d2-22e1-3812-8b54-722cd35d4bca",
                        "target_lang_word": "Säckchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Säckchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76f9bcc2-0bb6-3a93-8ae6-b247b01b4227",
                                        "entry_id": "d0aa3944-f18a-337a-8fba-1cc7d2bdd374",
                                        "glosses": [
                                            "kleiner Sack im Sinne von Behälter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5b8aeb-9dbf-4cb0-87ee-78766e82bee4",
                                                "sense_id": "76f9bcc2-0bb6-3a93-8ae6-b247b01b4227",
                                                "text": "In dem Säckchen an meiner Hose ist mein ganzes Kleingeld."
                                            },
                                            {
                                                "example_id": "3ed3a8fd-4bcd-4577-b84a-9aefc1b30372",
                                                "sense_id": "76f9bcc2-0bb6-3a93-8ae6-b247b01b4227",
                                                "text": "„Und nie tun wir es vergeblich, stets füllen sich unsere Säckchen mit Mehl und mit Grieß.“"
                                            },
                                            {
                                                "example_id": "6dddc9f2-30ba-42f1-9bca-8f0a2b548120",
                                                "sense_id": "76f9bcc2-0bb6-3a93-8ae6-b247b01b4227",
                                                "text": "„Nun sagte ich zur Marquise, ich wisse zwar nicht, was das Säckchen enthalte, aber wenn es sich um Magie handle, hätte ich keinerlei Vertrauen, denn sie habe ihm keine Vorschrift wegen der Zeit gegeben.“"
                                            },
                                            {
                                                "example_id": "832fcee8-1f92-41c5-9c5e-25ff920d2101",
                                                "sense_id": "76f9bcc2-0bb6-3a93-8ae6-b247b01b4227",
                                                "text": "„In der Speisekammer, die vom Feuer verschont geblieben war, fand ich ein Säckchen mit Zwieback.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
