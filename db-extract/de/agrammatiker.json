                "senses": [
                    {
                        "sense_id": "8d72bcd8-a79e-3e02-a4e7-2c13f5e1d059",
                        "entry_id": "61520be5-c620-37ad-913c-0e80dd85d503",
                        "glosses": [
                            "Person, die unter Agrammatismus leidet, also nicht in der Lage ist, Sätze grammatisch korrekt zu bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd962270-1fdd-4987-a6de-8c6d48649098",
                                "sense_id": "8d72bcd8-a79e-3e02-a4e7-2c13f5e1d059",
                                "text": "„Agrammatiker lassen also gebundene Morpheme aus, aber der Bedeutungskern der Wörter bleibt erhalten.“"
                            },
                            {
                                "example_id": "6fd49306-b1fe-4aa9-bc65-52e2fb6a8de0",
                                "sense_id": "8d72bcd8-a79e-3e02-a4e7-2c13f5e1d059",
                                "text": "„Der Agrammatiker ist fähig, all jene Elemente zu prodizieren, die lexikalisch spezifiziert sind.“"
                            },
                            {
                                "example_id": "8127038c-f104-408c-b151-32055bbfa481",
                                "sense_id": "8d72bcd8-a79e-3e02-a4e7-2c13f5e1d059",
                                "text": "„Der Anstoß zu den Untersuchungen wurde bereits vor Jahren gegeben durch Heeschens Behauptung, daß Agrammatiker diejenigen Äußerungen, die sie hervorbringen, in der Regel wohl strukturieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
