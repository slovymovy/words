                        "entry_id": "43bb73be-7285-3088-9e52-192d80990526",
                        "glosses": [
                            "Appareil utilisant les propriétés particulières de la propagation du son dans l’eau pour détecter et situer les objets sous l’eau par écholocation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c111fb01-2347-4c4c-94e6-76682fa445bd",
                                "sense_id": "3303e841-1938-38eb-b66e-6164529337f1",
                                "text": "Un sonar émet une impulsion sonore et écoute son écho sur les obstacles qu’elle rencontre."
                            }
                        ]
                    }
                ],
