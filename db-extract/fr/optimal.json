                        "entry_id": "d538a264-1948-3067-99af-8aefe2c200d8",
                        "glosses": [
                            "Relatif à un optimum, meilleur, favorable, désirable; en particulier sous contraintes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7995503-f9c5-4377-9e6b-8b44b181193d",
                                "sense_id": "ff091d78-50e6-3b48-8054-655f598ae560",
                                "text": "Pour une qualité optimale de l’épandage, le régime de rotation de la prise de force doit être maintenu à la valeur préconisée par le constructeur (généralement 540 tr/min) pendant tout l’épandage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f692fd4-e0e3-42b4-8278-d820bcd7e583",
                        "source_entry_id": "d538a264-1948-3067-99af-8aefe2c200d8",
                        "source_sense_id": "ff091d78-50e6-3b48-8054-655f598ae560",
