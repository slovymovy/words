                    "frequency": "Middle",
                    "semantic_group_id": "entlastung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die digitale Einreichung der Formulare stellt eine enorme <w>Erleichterung</w> für alle Bürger dar."
