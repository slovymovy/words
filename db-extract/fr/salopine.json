                                "example_id": "638e797d-31f1-4451-be43-71b1e334fbec",
                                "sense_id": "7d1849f3-3300-30bb-bd57-30f5ae294f78",
                                "text": "Il avait épousé une salopine, il aimait et rendait heureuse une crottée que le plus bas des tâcherons n’aurait pas subie longtemps pour maîtresse."
                            },
                            {
                                "example_id": "9a77b5a6-c203-4c75-a61b-3d2e71c5579a",
                                "sense_id": "7d1849f3-3300-30bb-bd57-30f5ae294f78",
                                "text": "Il croyait sans doute qu’elle avait pris plaisir à entendre tous ces trucs sur Philip Mullaly traînant en quête de prostituées et sur Olive Gramsmith qui était une salopine - allez savoir ce qu’il entendait là."
                            }
                        ]
                    }
