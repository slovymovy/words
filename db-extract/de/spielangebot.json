                "senses": [
                    {
                        "sense_id": "b5096540-9e77-3cda-a74b-eb1da08cdfc2",
                        "entry_id": "3c14a8d0-81fb-3943-8e54-c00a3b5124e5",
                        "glosses": [
                            "Vorschläge und Bereitstellung von Spielmöglichkeiten und Spielmaterialien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b06d95f-c5e2-44ab-b8de-d2e8ec7d7cb3",
                                "sense_id": "b5096540-9e77-3cda-a74b-eb1da08cdfc2",
                                "text": "„Spielangebote werden bei Spielfesten oft wie Konsumartikel in einer jahrmarkts- oder volksfestähnlichen Situation verkauft.“"
                            },
                            {
                                "example_id": "420c79ad-eb9f-4f96-97d5-4ce7f97ee2dc",
                                "sense_id": "b5096540-9e77-3cda-a74b-eb1da08cdfc2",
                                "text": "„Kommerzielle Spielangebote suchen sich an die Stelle des spontanen, gar nichts kostenden Spielens zu setzen.“"
                            },
                            {
                                "example_id": "3227b27a-8600-4fe0-8dc9-0f6ada60931b",
                                "sense_id": "b5096540-9e77-3cda-a74b-eb1da08cdfc2",
                                "text": "„Durch spannende Spielangebote gelingt es meist, die Spiellaune wiederzugewinnen.“"
                            },
                            {
                                "example_id": "bb51bb10-1b8b-4f87-9c65-55153e4324ca",
                                "sense_id": "b5096540-9e77-3cda-a74b-eb1da08cdfc2",
                                "text": "„Ob die Kinder unserer Zeit, inmitten einer nahezu grenzenlosen Fülle an Spielangeboten, wirklich glücklicher sind?"
                            },
                            {
                                "example_id": "722e1732-7409-4ce4-ac84-b4248af00749",
                                "sense_id": "b5096540-9e77-3cda-a74b-eb1da08cdfc2",
                                "text": "„Benötigt würden gut ausgestattete Spielzimmer, Spielplätze und Spielangebote.“"
                            },
                            {
                                "example_id": "2b686fe6-97ef-4361-8b3f-28dfb2ff35d4",
                                "sense_id": "b5096540-9e77-3cda-a74b-eb1da08cdfc2",
                                "text": "„Die Schülerinnen und Schüler […] berechnen die charakteristischen Maßzahlen (Erwartungswert, Varianz und Standardabweichung) von Zufallsgrößen und interpretieren diese in Bezug auf den Sachkontext, um z. B. zu beurteilen, ob Spielangebote fair, günstig oder ungünstig sind, oder um über die Vergleichbarkeit zweier Wahrscheinlichkeitsverteilungen zu entscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
