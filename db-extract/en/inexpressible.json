                        "entry_id": "fc171b20-36d9-3187-9cda-67fcf35a5a1e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more inexpressible"
                    },
                    {
                        "form_id": "21e9ec4a-fd24-4e78-87ab-98db19676775",
                        "entry_id": "fc171b20-36d9-3187-9cda-67fcf35a5a1e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most inexpressible"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                        "entry_id": "fc171b20-36d9-3187-9cda-67fcf35a5a1e",
                        "glosses": [
                            "Unable to be expressed; not able to be put into words."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a2c4a89-519c-4d93-beea-bed13ef49157",
                                "sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                                "text": "She felt inexpressible contempt for her attackers."
                            },
                            {
                                "example_id": "bdd055fe-f449-4509-95d0-b868e02295eb",
                                "sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                                "text": "That noise, that awful clamour of uncouthness inexpressible, is the love-call of the storm bird!"
                            },
                            {
                                "example_id": "0bf222ba-5ff4-42a7-b3a1-de524819222e",
                                "sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca146633-f4ba-47b3-8e97-ce1343914835",
                        "source_entry_id": "fc171b20-36d9-3187-9cda-67fcf35a5a1e",
                        "source_sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                        "source_sense_description": "unable to be expressed",
                        "target_lang_word": "onuitsprekelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onuitsprekelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3c120d-c832-35d6-8935-0c2aa2f42ff3",
                                        "entry_id": "3be2833f-292d-3546-921b-6ad40cfc5ca1",
                                        "glosses": [
                                            "zo groot of sterk dat er geen woorden voor zijn; zeer, heel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a71454b8-c91c-46b6-808a-07834eadfb76",
                                                "sense_id": "bc3c120d-c832-35d6-8935-0c2aa2f42ff3",
                                                "text": "‘Maar die ensembles vind ik gewoon heel vaak niet goed, sorry! Neem nu de muziek van Gesualdo: daar heb je sterke stemmen voor nodig met een enorm dramatisch potentieel. Geniale muziek moet geniaal gezongen worden. Uit die muziek spreekt een onuitsprekelijk lijden. Dan heb je zangers nodig die geleefd hebben, die weten wat afzien is. Niet van die oudemuziektypes op geitenwollen sokken. Of om voor één keer met Schopenhauer te spreken: de eerste premisse van stijl is iets te vertellen hebben.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9bd2eb-7d0f-3e9b-9871-a4c585672ca5",
                                        "entry_id": "3be2833f-292d-3546-921b-6ad40cfc5ca1",
                                        "glosses": [
                                            "dat de klanken zo moeilijk zijn dat je een woord of zin niet kunt uitspreken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77eed35-d5b9-475f-ae50-0e0da8816f91",
                                                "sense_id": "8a9bd2eb-7d0f-3e9b-9871-a4c585672ca5",
                                                "text": "Het Italiaanse publiek had geen oog voor de verliezers, voor die Nederlander met die onuitsprekelijke naam. Nibali, die toch lang een allesbehalve sterke indruk maakte, werd opeens weer vergeleken met Fausto Coppi, met name door diens laatste Girozege in 1953 toen hij Hugo Koblet in het slotweekeinde uit het roze reed. Voor Nibali was het een emotionele machtsgreep die met tranen gepaard ging. 'Dit is misschien wel de mooiste zege uit mijn carrière', zei de Siciliaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4fb9507-1327-3c00-b164-06c32d1a9b1d",
                                        "entry_id": "3be2833f-292d-3546-921b-6ad40cfc5ca1",
                                        "glosses": [
                                            "dat wat je niet in woorden kunt uitdrukken omdat het een gevoelszaak is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def139d6-67d1-4aba-a9a2-8e380299152b",
                                                "sense_id": "d4fb9507-1327-3c00-b164-06c32d1a9b1d",
                                                "text": "In poëzie zit ruimte voor het onuitsprekelijke, een lastig maar belangrijk gebied, waar de wetenschap niet kan komen. Zoals Katznelson zegt: „Als je werkelijk alles wat je weet van een onderwerp (-) in woorden kunt vangen, dan betekent dat simpelweg dat je er niet genoeg van weet.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "070066f8-68bb-475a-b73e-ed32190acf9c",
                        "source_entry_id": "fc171b20-36d9-3187-9cda-67fcf35a5a1e",
                        "source_sense_id": "a72c03bb-4c8a-3c80-8c29-47148c7901b8",
                        "source_sense_description": "unable to be expressed",
                        "target_lang_word": "inexprimable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexprimable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                        "entry_id": "db19f719-b0fd-3e0c-9870-a1a5ca8e405d",
                                        "glosses": [
                                            "Qu’on ne peut exprimer par des paroles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5d4823b-b739-444a-a9ca-e3cbeeafc27d",
                                                "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                                "text": "Une rage inexprimable rendit le capitaine plus blanc que ses voiles."
                                            },
                                            {
                                                "example_id": "6f37c09c-ae55-4082-8dc2-9b661a36fab6",
                                                "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                                "text": "Celui de Laifour, qui est dans un véritable désert, nous peint en mots bien sentis la monotonie de son existence. En hiver, quand la neige couvre la montagne, la solitude est inexprimable."
                                            },
                                            {
                                                "example_id": "2e04bb74-446b-45fc-82a4-50282b8d50b8",
                                                "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                                "text": "Il reprit vaguement son chemin vers la ville, baissant le front sous une inexprimable honte."
                                            },
                                            {
                                                "example_id": "1a245169-5d72-442f-ac93-5e9e981a76cc",
                                                "sense_id": "f64f2db7-1d01-3c03-bdcc-9d58ad3eaf24",
                                                "text": "Au carré, dans les cabines et les laboratoires, le désordre est inexprimable ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
