                "senses": [
                    {
                        "sense_id": "64dd13c0-9131-32a6-b575-dff55852a057",
                        "entry_id": "d6bfd909-ecad-3747-a614-c8d292375879",
                        "glosses": [
                            "Not perishable; not subject to decay; enduring permanently."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c418a29e-b51f-4ba1-936c-2650d0baf495",
                                "sense_id": "64dd13c0-9131-32a6-b575-dff55852a057",
                                "text": "an imperishable monument"
                            },
                            {
                                "example_id": "5c72cd4b-6995-457b-8060-c1c3a8a26688",
                                "sense_id": "64dd13c0-9131-32a6-b575-dff55852a057",
                                "text": "The child was to be a prophet, unrivalled among men, and the parent of an imperishable race."
                            },
                            {
                                "example_id": "e2a6be52-edcd-4d78-9e51-0fa3200d3ebf",
                                "sense_id": "64dd13c0-9131-32a6-b575-dff55852a057",
                                "text": "Sir Philip Sidney, soldier, courtier, statesman and poet, was born at Penshurst in 1554. He won imperishable fame 32 years later at the Battle of Zutphen in Holland when, mortally wounded, he refused a drink of water and passed his flask to a wounded soldier, with the words: 'Thy necessity is yet greater than mine.'"
                            }
                        ]
                    }
                ],
                "translations": [
