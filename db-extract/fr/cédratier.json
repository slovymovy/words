                "senses": [
                    {
                        "sense_id": "627d3f42-e3ab-3069-8c7a-dd3c8cec645a",
                        "entry_id": "bc2a433e-cd47-3180-b70c-208cc3dad96d",
                        "glosses": [
                            "Petit arbre fruitier de la famille des rutacées, ancêtre du citronnier, originaire d’Asie du Sud et plus précisément d’Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62e5af24-7216-4ed9-a01d-ad208ca12f61",
                                "sense_id": "627d3f42-e3ab-3069-8c7a-dd3c8cec645a",
                                "text": "Le cédratier est un petit arbre aux tiges épineuses. Il produit de gros fruits de forme ovale, à l’épaisse écorce jaune et à la chair acide."
                            },
                            {
                                "example_id": "5c3a3300-c9a5-441c-9409-996096470f74",
                                "sense_id": "627d3f42-e3ab-3069-8c7a-dd3c8cec645a",
                                "text": "Partout dans le monde, les variétés domestiquées (combava, kumquat, lime, cédratier, bergamote, main de Bouddha, chinotto, etc.) enrichissent un étonnant répertoire de saveurs, mais aussi de bienfaits pour la santé."
                            }
                        ]
                    }
                ],
