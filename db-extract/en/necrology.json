                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15107bcb-82ca-43ec-8d5c-461a003ccb99",
                                                "sense_id": "3368f995-1dbe-3e02-8944-b19768616e37",
                                                "text": "Les communautés religieuses ont chacune leur nécrologe."
                                            },
                                            {
                                                "example_id": "0c9b98f0-b816-42a3-86ec-e2d1b4713b4d",
                                                "sense_id": "3368f995-1dbe-3e02-8944-b19768616e37",
                                                "text": "Je cherchai pourtant avec soin le fameux nécrologe des prêtresses d’Amyclée, que l’abbé Fourmont copia en 1731 ou 1732, et qui donne une série de près de mille années avant Jésus-Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cf5492f-a9bc-3c42-b481-280b4b8c11da",
                                        "entry_id": "e7280bf9-5ab5-3dda-8c98-3104c990d6be",
                                        "glosses": [
                                            "Liste des personnes mortes dans une catastrophe ou lors d’un événement particulier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45db6836-a1b8-35fe-ac99-d291053804f3",
                                        "entry_id": "e7280bf9-5ab5-3dda-8c98-3104c990d6be",
                                        "glosses": [
                                            "Nécrologie, ouvrage consacré à la mémoire des personnes célèbres mortes récemment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebcdad0-2738-4184-ab24-a3cef464b858",
                                                "sense_id": "45db6836-a1b8-35fe-ac99-d291053804f3",
                                                "text": "Le nécrologe des hommes illustres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "206a6589-71ec-42c5-abaf-f8cdba76f1b5",
                        "source_entry_id": "525282e2-c38a-3ba6-8f92-02e4a713ab67",
                        "source_sense_description": "listing of people who have died",
                        "target_lang_word": "Nekrolog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nekrolog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdba2123-6d45-3659-b54c-0f942e685dfe",
                                        "entry_id": "6140fa9d-da49-3239-b172-b86a3664b2fc",
                                        "glosses": [
                                            "Würdigung eines Verstorbenen"
                                        ],
                                        "tags": [
                                            "bildungsspr."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2bfac0a-b6af-4383-9e93-fbdefb83ec5a",
                                                "sense_id": "fdba2123-6d45-3659-b54c-0f942e685dfe",
                                                "text": "Berühmte Leute werden oft nach ihrem Tod mit einem Nekrolog geehrt."
                                            },
                                            {
                                                "example_id": "e054196e-64cf-4cef-89ba-f9d15d74817b",
                                                "sense_id": "fdba2123-6d45-3659-b54c-0f942e685dfe",
                                                "text": "„Alles, was er mit seinen Tiraden, Monologen und Nekrologen bei Alf Bertini erreichte, war dieses dünne Lächeln ungeheurer Überlegenheit, was Eitel-Fritz Hattenroth in der Erregung allerdings als diskrete Zustimmung mißdeutete.“"
                                            },
                                            {
                                                "example_id": "58b04483-ae37-48ec-a194-5b3903501015",
                                                "sense_id": "fdba2123-6d45-3659-b54c-0f942e685dfe",
                                                "text": "„Nur selten wurde allerdings mitgeteilt, wer diese Nekrologe schrieb, und auch unter den meisten Leserbriefen fand sich keine Unterschrift.“"
                                            },
                                            {
                                                "example_id": "ef2ee5d0-8a7b-4750-9aa9-4b751e15cdea",
                                                "sense_id": "fdba2123-6d45-3659-b54c-0f942e685dfe",
                                                "text": "„Selbst den Lesern dieser Zeitung, fürchte ich, bliebe ein Nekrolog, wie er dem Lear unter den deutschen Autoren der Jahrhundert-Mitte gebührte, unverständlich, wenn ihm nicht eine Vita vorangestellt würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c68772b6-392c-498f-9570-79ef9e6c176b",
                        "source_entry_id": "525282e2-c38a-3ba6-8f92-02e4a713ab67",
