                "senses": [
                    {
                        "sense_id": "36915f43-c2d9-39fe-86f8-ecdc6ef6cc03",
                        "entry_id": "ae4230a0-0c0e-3fa3-8570-84f558c6d9a6",
                        "glosses": [
                            "Perdre son statut de célibataire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac77fc4-65b4-49f7-995f-aea9ad0ec5da",
                                "sense_id": "36915f43-c2d9-39fe-86f8-ecdc6ef6cc03",
                                "text": "Si vous aviez une solution miracle pour me décélibatairiser rapidement, je vous serais très reconnaissant!"
                            },
                            {
                                "example_id": "d081844f-e717-4a2f-9ff2-fd5ce310e0c2",
                                "sense_id": "36915f43-c2d9-39fe-86f8-ecdc6ef6cc03",
                                "text": "Pis d'abord, si tu passais moins de temps sur l'Asphalte (dans tous les sens du terme), tu aurais plus de chances de te décélibatairiser!"
                            },
                            {
                                "example_id": "98a21de2-6a18-4309-9445-2b9d422c96d4",
                                "sense_id": "36915f43-c2d9-39fe-86f8-ecdc6ef6cc03",
                                "text": "Bref : pas simple de se décélibatairiser, c'est le fruit de moults efforts, bien sur imperceptible à la gent masculine qui n'a surement aucune idée de toutes ces techniques (et qui doit à peine remarquer le coup du panda le matin) (parce qu'il te trouve belle quand même, c'est le principe du type bien, sinon, c'est un blaireau, non?)."
                            }
                        ]
                    }
                ],
