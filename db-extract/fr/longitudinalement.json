                                        "sense_id": "c9c4e20c-152d-3931-a50b-7b0bc1f4b97e",
                                        "entry_id": "79ce8775-0dfd-3f1c-bac9-76912c75dd8e",
                                        "glosses": [
                                            "in der Längsachse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3040c4-1c50-4e56-9124-ec88ce481438",
                                                "sense_id": "c9c4e20c-152d-3931-a50b-7b0bc1f4b97e",
                                                "text": "Eine Ananas quer teilen, eine Hälfte im Kühlschrank in Folie verpackt aufheben. Restliche Teile längs vierteln, Kernbereich längs abschneiden, klein schneiden und entsaften […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "längs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f0ba4fa-7872-3bc0-9bb8-14385d18a738",
                                        "entry_id": "791b4a55-ea15-3a3d-8041-7b0bdab81951",
                                        "glosses": [
                                            "seitlich (an etwas) entlang"
                                        ],
                                        "tags": [
                                            "mit Genitiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b5c2a88-6803-4dc9-b4b8-89e2296c7e6c",
                                                "sense_id": "0f0ba4fa-7872-3bc0-9bb8-14385d18a738",
                                                "text": "Längs des Flusses erstrecken sich undurchdringliche Auwälder."
                                            },
                                            {
                                                "example_id": "36af2793-e0c1-4553-88ca-95215e756a8f",
                                                "sense_id": "0f0ba4fa-7872-3bc0-9bb8-14385d18a738",
                                                "text": "„Längs der Ufer lagen viele Biberburgen, und unmittelbar dahinter stiegen hohe Berge empor, deren Gipfel mit Schnee bedeckt waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1706c450-d95a-4ec4-9823-36493ebc5011",
                        "source_entry_id": "1ffa9146-57df-371b-9eb7-9cc7b544c325",
                        "target_lang_word": "längst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "längst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1ef023-2eb4-391a-9932-8ff54281b68e",
                                        "entry_id": "1b09a0eb-9aa6-352e-8d24-82e7e94a8882",
                                        "glosses": [
                                            "schon lange, seit langem, seit langer/längerer Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "797fcf8a-08c5-46f5-9c63-0b6d8a402049",
                                                "sense_id": "ce1ef023-2eb4-391a-9932-8ff54281b68e",
                                                "text": "Da erzählst du mir nichts Neues, das weiß ich längst."
                                            },
                                            {
                                                "example_id": "c472c8f5-2d17-444e-a4cd-261df2595a53",
                                                "sense_id": "ce1ef023-2eb4-391a-9932-8ff54281b68e",
                                                "text": "„Der etwa vierzigjährige Herrscher schien jedoch Orgien jeder Art längst nicht mehr gewachsen.“"
                                            },
                                            {
                                                "example_id": "86f9477d-9a7f-4d62-8c20-8a0d4f537e5f",
                                                "sense_id": "ce1ef023-2eb4-391a-9932-8ff54281b68e",
                                                "text": "„Penibel ausgearbeitete Pläne für Internierungslager und Listen mit Namen der zur Internierung vorgesehenen Systemkritiker lagen tatsächlich längst vor.“"
                                            },
                                            {
                                                "example_id": "f2643130-ab9b-4564-8fc7-b80c93882e0d",
                                                "sense_id": "ce1ef023-2eb4-391a-9932-8ff54281b68e",
                                                "text": "„Der Bauträger hat längst neue Interessenten für das Reihenhaus gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7f5f884-207e-338f-b941-ad1c2e509167",
                                        "entry_id": "1b09a0eb-9aa6-352e-8d24-82e7e94a8882",
                                        "glosses": [
                                            "bei weitem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7b334b8-2c32-466a-a70f-bda25f7e5048",
                                                "sense_id": "f7f5f884-207e-338f-b941-ad1c2e509167",
                                                "text": "Als Rentner geht es ihm längst nicht so gut wie alle glauben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
