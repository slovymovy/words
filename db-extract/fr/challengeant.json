                "senses": [
                    {
                        "sense_id": "603071d9-d5a9-38e8-ba1b-b13a365ddc0e",
                        "entry_id": "a84179ad-8bb3-3cb2-9930-4a09eb61b29f",
                        "glosses": [
                            "Qui propose un challenge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ac45608-e719-4930-b57f-6e2d027240f2",
                                "sense_id": "603071d9-d5a9-38e8-ba1b-b13a365ddc0e",
                                "text": "Le directeur de la haute performance à la FFA, Romain Barras, a qualifié de son côté la réunion de « très challengeante »."
                            },
                            {
                                "example_id": "277a29a4-41b4-4df5-8f95-89ad8b6a0f8c",
                                "sense_id": "603071d9-d5a9-38e8-ba1b-b13a365ddc0e",
                                "text": "Il s’agissait principalement de proposer un environnement offrant des activités plus « ambitieuses », plus réelles et plus challengeantes, et de passer d’un fonctionnement pédagogique vertical à un fonctionnement horizontal."
                            },
                            {
                                "example_id": "ea5fe429-9886-4fd3-9482-16cc86b9b7e6",
                                "sense_id": "603071d9-d5a9-38e8-ba1b-b13a365ddc0e",
                                "text": "Un asana ne se pratique jamais dans la force ou dans la douleur, même s’ils sont parfois challengeants."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
