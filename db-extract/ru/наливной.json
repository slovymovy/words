                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10f7bbf-efb5-4221-90d1-563a2f8a6d55",
                                "sense_id": "fd968508-d488-3b2b-86e6-558d23e1da28",
                                "text": "Наливной каток (для катанья на коньках). Наливной бак."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9ce27fa-32be-393b-86e8-6686b280d245",
