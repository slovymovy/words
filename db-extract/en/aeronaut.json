                "senses": [
                    {
                        "sense_id": "8b5e25e7-a173-3b6b-a83f-514b6e796d26",
                        "entry_id": "9f19bf47-b210-3a01-aff8-8e5e54745b19",
                        "glosses": [
                            "A person who travels through the air in an airship or balloon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6867b3-3546-4aaa-a052-4ad7e4c1e96b",
                                "sense_id": "8b5e25e7-a173-3b6b-a83f-514b6e796d26",
                                "text": "\"Well, what is it that he does that I don't do? Just say the word, - teetotal, vegetarian, aeronaut, theosophist, superman.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3772b228-881c-4d2e-9b40-0925b4d699e6",
                        "source_entry_id": "9f19bf47-b210-3a01-aff8-8e5e54745b19",
                        "source_sense_id": "8b5e25e7-a173-3b6b-a83f-514b6e796d26",
                        "source_sense_description": "one who glides through the air in an airship",
                        "target_lang_word": "aéronaute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aéronaute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b7f355-f00a-36f3-98db-cffa05f820e2",
                                        "entry_id": "c76870fc-d90a-3024-b31d-4f0488e76803",
                                        "glosses": [
                                            "Personne qui voyage en aérostat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219577fe-67e2-4760-9afb-6d40b8eff82c",
                                                "sense_id": "f7b7f355-f00a-36f3-98db-cffa05f820e2",
                                                "text": "[…], et la première phase de la plupart de ces luttes offrira le spectacle d’aéronautes tentant, parachutes en main, un saut désespéré, pour arriver à terre sans être tués par le choc ni broyés par les débris de leur engin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5493b13-ba8b-3c8e-8eb8-1d1ad46a4199",
                                        "entry_id": "c76870fc-d90a-3024-b31d-4f0488e76803",
                                        "glosses": [
                                            "Le pilote de ce véhicule."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52b50e91-f0e1-409a-a669-0d31cd9dcb84",
                                                "sense_id": "e5493b13-ba8b-3c8e-8eb8-1d1ad46a4199",
                                                "text": "MM. Deschamps et Crémieux s'étaient couchés dans la nacelle par le conseil de M. Godard, qui restait debout, cherchant à manœuvrer de manière à arrêter la marche de l’aérostat. Un choc lance l’aéronaute en avant de la nacelle et le fait tomber à terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf49fbf-ecab-392e-9e1c-9682f30fa041",
                                        "entry_id": "c76870fc-d90a-3024-b31d-4f0488e76803",
                                        "glosses": [
                                            "Pilote d’un avion ; aviateur."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc8aec6-4d9b-4ff2-a53b-a713005b5599",
                                                "sense_id": "adf49fbf-ecab-392e-9e1c-9682f30fa041",
                                                "text": "On volait certes, et dans des machines plus lourdes que l’air, mais il y avait aussi les chutes où parfois le moteur se brisait et parfois l’aéronaute, souvent les deux à la fois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
