                        ],
                        "examples": [
                            {
                                "example_id": "a87f55b5-3594-4096-b178-dc9898b0143a",
                                "sense_id": "d8d279f4-4781-3032-9d74-a9e867785224",
                                "text": "' 'Weeën zijn toch weeën, of niet soms?' 'Klempje, als het om zwangere vrouwen gaat, ben je een groentje."
                            },
                            {
                                "example_id": "02151143-c21b-46c8-8a94-79919efd77ab",
                                "sense_id": "d8d279f4-4781-3032-9d74-a9e867785224",
                                "text": "Hij voelde hoe zijn natte kleding tegen zijn lijf plakte en zag een zwangere vrouw die met haar bleke gezicht naar hem opkeek en vroeg: 'Waar ben je geweest?' Of ze die zin echt tegen hem had uitgesproken of dat het verbeelding was, kon hij niet zeggen."
                            }
                        ]
                    }
                ],
