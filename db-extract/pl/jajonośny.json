                        "source_sense_id": "d1e98b74-eb72-34bc-8be5-ed78ddb47e55",
                        "target_lang_word": "oviparous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oviparous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "411be668-982c-327e-b19b-2475c24268ec",
                                        "entry_id": "9a153979-8cae-33d6-992c-49d078b1297f",
                                        "glosses": [
                                            "Depositing eggs that develop and hatch outside the body as a reproductive strategy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aef8cc5-2f24-4d06-8e26-df7421eea342",
                                                "sense_id": "411be668-982c-327e-b19b-2475c24268ec",
                                                "text": "The echidna is a monotreme, which is the extremely small subset of oviparous mammals."
                                            },
                                            {
                                                "example_id": "a8317b2a-7d90-4566-9edd-ec9b1e888b79",
                                                "sense_id": "411be668-982c-327e-b19b-2475c24268ec",
                                                "text": "And though it might be thought that all animals who have lungs do cough; yet in cataceous fishes, who have large and strong lungs, the same is not observed; nor yet in oviparous quadrupeds: and in the greatest thereof, the crocodile, although we read much of their tears, we find nothing of that motion."
                                            },
                                            {
                                                "example_id": "a9d50180-35f1-4287-a33b-237e111bbb70",
                                                "sense_id": "411be668-982c-327e-b19b-2475c24268ec",
                                                "text": "Until fairly recently, no female Somniosus had been observed to be carrying embryos, so it was assumed that this was an oviparous species."
                                            }
                                        ]
                                    }
                                ]
                            }
