                "senses": [
                    {
                        "sense_id": "f58d1585-640a-365a-8ab5-95ee05aa6e9d",
                        "entry_id": "ac65fe23-3ac1-33a1-9528-0b66bec8d5ca",
                        "glosses": [
                            "Centre de collecte, de traitement et de distribution de lait maternel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07ecd3f-9d80-4c32-9a77-6a74bd2edeff",
                                "sense_id": "f58d1585-640a-365a-8ab5-95ee05aa6e9d",
                                "text": "Ces règles de conservation du lait sont fournies par écrit par le lactarium."
                            },
                            {
                                "example_id": "eab2d92e-591e-47e5-86f3-ff9795476252",
                                "sense_id": "f58d1585-640a-365a-8ab5-95ee05aa6e9d",
                                "text": "On ne le sait pas toujours, mais toute maman qui allaite (et qui le souhaite) peut faire don de son lait maternel excédentaire à un lactarium pour aider d'autres nouveaux-nés, prématurés ou fragiles."
                            },
                            {
                                "example_id": "60b62d55-05ce-4682-bf5a-0764643fbb89",
                                "sense_id": "f58d1585-640a-365a-8ab5-95ee05aa6e9d",
                                "text": "Confrontée à cette situation inquiétante, l’Assistance publique-hôpitaux de Paris (AP-HP) a décidé de lancer un appel aux donneuses potentielles : « Jeunes mamans, donnez-votre lait ! » Car il s’agit d’un produit rare, collecté par les lactariums, mais d’une importance capitale."
                            }
                        ]
                    }
                ],
