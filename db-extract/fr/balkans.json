                                        "entry_id": "ae8cd469-ec53-3afb-b99b-b94d23fdbb5d",
                                        "glosses": [
                                            "A cultural region and peninsula in Southeast Europe, roughly equivalent to the area covered by Albania, Bosnia and Herzegovina, Bulgaria, Croatia, Greece, Kosovo, North Macedonia, Montenegro and Serbia, sometimes including Romania, Slovenia, and European Turkey."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff22e460-fd59-459d-b0b7-787af09c43b1",
                                                "sense_id": "dc202734-bad4-39d8-99ec-7b416881b53a",
                                                "text": "As the Ottomans' victories in the Balkans multiplied, increasing numbers of Anatolian warriors flocked to their ranks, and their territorial conquests grew."
                                            },
                                            {
                                                "example_id": "120df5ce-f012-4033-96a4-264420fc35c4",
                                                "sense_id": "dc202734-bad4-39d8-99ec-7b416881b53a",
                                                "text": "The Balkans is still comparatively less attractive than other post-communist countries in Europe [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
