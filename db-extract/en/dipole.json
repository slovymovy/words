                                        "glosses": [
                                            "Dipolmolekül"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58ab3ac-2ed0-427d-82e6-32b74fc68379",
                                                "sense_id": "18dbd22d-ce05-3ab3-8765-cf7c422b4719",
                                                "text": "„In der Chemie werden Moleküle, bei denen die Schwerpunkte der negativen und der positiven Ladungsträger nicht zusammenfallen, als Dipole bezeichnet“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e1d3815e-bacd-34fb-8f35-cad447e38864",
                                        "entry_id": "036311ab-943d-3374-a703-07bd0425ad2d",
                                        "glosses": [
                                            "Temperatur- oder Druckunterschied zwischen zwei verschiedenen Bereichen oder Regionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e7109fb-d4a6-49aa-b405-ebb36b881cbd",
                                                "sense_id": "e1d3815e-bacd-34fb-8f35-cad447e38864",
                                                "text": "„Ist dieser Dipol [Indian Ocean Dipole] in einer positiven Phase, liegen Wassertemperaturen und Niederschläge im Westen des Indischen Ozeans höher und im Osten niedriger als normal.“"
