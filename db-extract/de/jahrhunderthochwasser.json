                "senses": [
                    {
                        "sense_id": "39662540-cc00-3862-85b0-909018b5fdfe",
                        "entry_id": "34734ab1-f36f-350c-af09-25c8dc8e3c7e",
                        "glosses": [
                            "Situation, in der bei einem Gewässer so hohe Pegelstände erreicht werden, wie es sie im statistischen Mittel nur einmal in hundert Jahren gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4d51d5-09e2-4df1-911d-7d6654e98ef7",
                                "sense_id": "39662540-cc00-3862-85b0-909018b5fdfe",
                                "text": "„Zumindest, was die Einsatz- und Hilfskräfte betrifft, sind die richtigen Lehren aus dem Jahrhunderthochwasser 2002 für das derzeitige Jahrhunderthochwasser gezogen worden.“"
                            },
                            {
                                "example_id": "3fee05d8-33e7-4941-bfb9-4ebb3d71eb70",
                                "sense_id": "39662540-cc00-3862-85b0-909018b5fdfe",
                                "text": "„Neben den brandenburgischen bereiten sich auch die niedersächsischen Gemeinden an der Elbe mit Hochdruck auf das erwartete Jahrhunderthochwasser vor.“"
                            },
                            {
                                "example_id": "c6dec7e4-816c-4669-bfe9-427ae79927c2",
                                "sense_id": "39662540-cc00-3862-85b0-909018b5fdfe",
                                "text": "[2024:] „Jahrhunderthochwasser: Diesen Begriff hört man in Passau bereits zum dritten Mal in 20 Jahren“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
