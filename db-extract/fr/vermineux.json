                "forms": [
                    {
                        "form_id": "188c99bf-4ecc-43c5-b8d6-a7a703dcc8b4",
                        "entry_id": "49df6cb7-4b2d-3206-8462-9a246d63093e",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "vermineuse"
                    },
                    {
                        "form_id": "8beec193-aa7e-4616-b552-77fb35cfa2f5",
                        "entry_id": "49df6cb7-4b2d-3206-8462-9a246d63093e",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "vermineuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41cb01f6-89fa-30c7-ab56-e6b925b1c74e",
                        "entry_id": "49df6cb7-4b2d-3206-8462-9a246d63093e",
                        "glosses": [
                            "Qui est causé, entretenu par des vers intestinaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83f0781-94bd-4282-87d1-0e10437eb0ce",
                                "sense_id": "41cb01f6-89fa-30c7-ab56-e6b925b1c74e",
                                "text": "Maladies vermineuses. Fièvres vermineuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fce2951-a395-34da-82bd-e612f7b449ef",
                        "entry_id": "49df6cb7-4b2d-3206-8462-9a246d63093e",
                        "glosses": [
                            "Qui est atteint par la vermine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cc6ca68-db19-4d6c-969a-c3f6f4091a45",
                                "sense_id": "6fce2951-a395-34da-82bd-e612f7b449ef",
                                "text": "L’amour, mais il est dans la cruche de terre, dans la guenille vermineuse que je peins…"
                            },
                            {
                                "example_id": "ddf917f1-cad4-460c-8aa8-9f73a5e5f3ac",
                                "sense_id": "6fce2951-a395-34da-82bd-e612f7b449ef",
                                "text": "Des chairs flasques, couturées, usées à force d'être pétries par des mains brutales, aux vermineux matelas de laine, et, pour quelques sous, une étreinte souvent lasse, subie par nécessité, sans aucun écho, sans une vibration de chair amie…"
                            },
                            {
                                "example_id": "c9b2eea5-e969-45ac-9563-babc2e3431a8",
                                "sense_id": "6fce2951-a395-34da-82bd-e612f7b449ef",
                                "text": "Vous croyez donc que les bandits se tiennent à plaisir dans ces caves vermineuses et dans ces pièces ouvertes à la pluie et au vent ? Soyez certain qu'ils préfèrent quelque chaude taverne, avec de bonnes banquettes de moleskine."
                            }
                        ]
                    },
                    {
                        "sense_id": "b34adc1c-48dd-34b9-a603-48c01a3e6084",
                        "entry_id": "49df6cb7-4b2d-3206-8462-9a246d63093e",
                        "glosses": [
                            "Qui est de la nature de la vermine."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9eaeffc5-3ce0-40af-8c2d-e4202bd8f664",
                                "sense_id": "b34adc1c-48dd-34b9-a603-48c01a3e6084",
                                "text": "La boîte de Nine, c'est une matière d'éventaire où s'étalent et resplendissent tous les échantillons de notre douce et vermineuse humanité : barbots […] ; tribades […], nymphes […], mondaines […], tapettes […] — tendres et pitoyables canailles, toute une faune redoutable et correcte, au repos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2d4faea-6ffb-45da-9ac9-9edf229008f7",
                        "source_entry_id": "49df6cb7-4b2d-3206-8462-9a246d63093e",
                        "target_lang_word": "verminous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verminous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e47af4a-d4a0-3d9e-ac18-e6979e01d9cf",
                                        "entry_id": "b5283b98-e406-30ba-b3d3-23fab1660a9b",
                                        "glosses": [
                                            "Infested with vermin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6faa703e-1c44-4989-9514-4fa85994e6f4",
                                                "sense_id": "4e47af4a-d4a0-3d9e-ac18-e6979e01d9cf",
                                                "text": "The old beggar kept a verminous mongrel dog for a pet."
                                            },
                                            {
                                                "example_id": "318c2e75-dd3d-4f3a-be85-6b68b1cad39f",
                                                "sense_id": "4e47af4a-d4a0-3d9e-ac18-e6979e01d9cf",
                                                "text": "The dog was constantly scratching his many verminous sores and welts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af75e9a7-fe43-3a24-87e6-e4eef8bf4004",
                                        "entry_id": "b5283b98-e406-30ba-b3d3-23fab1660a9b",
                                        "glosses": [
                                            "Actively unpleasant, contemptible, or otherwise reminiscent of vermin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6643d663-d7f7-452c-b6ab-ad474e751399",
                                                "sense_id": "af75e9a7-fe43-3a24-87e6-e4eef8bf4004",
                                                "text": "They had brought all their own equipment with them, trade by trade, tongue by tongue; they travelled in ancient lorries or in slower carts with their verminous armfuls of keen-eyed children."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
