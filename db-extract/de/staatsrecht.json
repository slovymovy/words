                    }
                ],
                "senses": [
                    {
                        "sense_id": "8159f4fe-0340-302e-88d8-58156a43c104",
                        "entry_id": "c2288b29-d420-359f-abe5-8c7014a1a748",
                        "glosses": [
                            "Gesamtheit der Rechtsnormen eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88cb7da7-e47c-4b09-b1dc-8eb15f6838bd",
                                "sense_id": "8159f4fe-0340-302e-88d8-58156a43c104",
                                "text": "„Das Staatsrecht lehrt, wie eine ordentliche Verfassung zustande kommt - durch eine verfassunggebende Versammlung aus der Mitte des Volkes oder wenigstens durch einen Verfassungsrat, dem die besten Köpfe der Nation angehören.“"
                            },
                            {
                                "example_id": "88a33945-fdd7-48f4-8d74-73abae20ea6c",
                                "sense_id": "8159f4fe-0340-302e-88d8-58156a43c104",
                                "text": "„Im Staatsrecht bedeutet Zentralismus Unitarismus, jedenfalls Ablehnung des Föderalismus, vielfach auch das Streben nach Beseitigung der kommunalen oder sonstigen Selbstverwaltung zugunsten der rein staatlichen Verwaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "191aa034-2ee4-302f-a948-f8ec100b0d60",
                        "entry_id": "c2288b29-d420-359f-abe5-8c7014a1a748",
                        "glosses": [
                            "bestimmte Berechtigung eines Staates"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fafcd4fc-7722-4072-a824-11141258a8f1",
                                "sense_id": "191aa034-2ee4-302f-a948-f8ec100b0d60",
                                "text": "„Weiter darf er nicht gehen, stattdessen verweist Schäuble auf jüngste Veröffentlichungen von Staatsrechtlern, die ganz offen den Bruch des Grundgesetzes, nämlich ein übergesetzliches Staatsrecht des Ausnahmezustands, propagieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
