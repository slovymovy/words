                        "target_lang_word": "grawerunek",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c89228c2-396c-4827-8753-b052eea8bfa0",
                        "source_entry_id": "7257a13e-31e3-3404-b066-5fac9e1847df",
                        "source_sense_id": "cef85947-3eb1-3d85-8fb0-782dc0ac3f3a",
                        "source_sense_description": "Kunst, Grafik: Erzeugnis der Gravierkunst",
                        "target_lang_word": "gravure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd630464-1dd3-3ff1-92bb-3dfc64ec8a84",
                                        "entry_id": "2e5d6c9a-b910-3123-a5b2-f4a2c5323709",
                                        "glosses": [
                                            "L’art ou la manière de graver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d248064-6cd2-4ae1-85b5-3cb3d65ace2c",
                                                "sense_id": "fd630464-1dd3-3ff1-92bb-3dfc64ec8a84",
                                                "text": "Gravure en pierres fines."
                                            },
                                            {
                                                "example_id": "e88da2d4-c5da-4376-a867-521b7508dc0e",
                                                "sense_id": "fd630464-1dd3-3ff1-92bb-3dfc64ec8a84",
                                                "text": "Gravure en taille douce, à la manière noire, etc."
                                            },
                                            {
                                                "example_id": "3646b99a-bc7f-457f-b09f-2a413840150c",
                                                "sense_id": "fd630464-1dd3-3ff1-92bb-3dfc64ec8a84",
                                                "text": "Gravure en criblé."
                                            },
                                            {
                                                "example_id": "edfcadd1-f0fa-4af3-8759-54d2a0ea4c94",
                                                "sense_id": "fd630464-1dd3-3ff1-92bb-3dfc64ec8a84",
                                                "text": "Un art gardait le privilège de la sincérité dans le détail des figures nues : la gravure. On peut affirmer que depuis l'invention de l'estampe jusqu'au XIXᵉ siècle la majorité des graveurs fut hostile à toute suppression."
                                            },
                                            {
                                                "example_id": "4a7b421f-d0d2-4a64-a346-174a6caf8c19",
                                                "sense_id": "fd630464-1dd3-3ff1-92bb-3dfc64ec8a84",
                                                "text": "S’adonner à la gravure."
                                            },
                                            {
                                                "example_id": "0991322f-1f0d-4663-8d2d-b98cf686ef9d",
                                                "sense_id": "fd630464-1dd3-3ff1-92bb-3dfc64ec8a84",
                                                "text": "Gravure sur cuivre, sur acier, sur bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcca145d-0e2e-329a-bf90-f4cc92ad127c",
                                        "entry_id": "2e5d6c9a-b910-3123-a5b2-f4a2c5323709",
                                        "glosses": [
                                            "Ouvrage du graveur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef86be1b-e8f4-4fa6-98fe-3fe91a6ad524",
                                                "sense_id": "fcca145d-0e2e-329a-bf90-f4cc92ad127c",
                                                "text": "Aussi la duchesse avait-elle conservé ces lettres émouvantes, comme certains vieillards ont des \"\"\"gravures\"\"\" obscènes, à cause des éloges hyperboliques donnés à ce qu’elle avait de moins duchesse en elle."
                                            },
                                            {
                                                "example_id": "0dd0d0b5-a40e-4000-8b88-4f1c5e9d70da",
                                                "sense_id": "fcca145d-0e2e-329a-bf90-f4cc92ad127c",
                                                "text": "Puis la gravure de cette dalle, l’inscription, sont tracées par un faussaire ignorant et inhabile."
                                            },
                                            {
                                                "example_id": "774e9e95-9fda-4bb2-b484-d2e1118044fb",
                                                "sense_id": "fcca145d-0e2e-329a-bf90-f4cc92ad127c",
                                                "text": "En général, la vue se heurte à des rochers serrés, à des amoncellements de prisons. Cette concentration trahit un désespoir paralysant comme une crampe : une sorte d’agoraphobie caractérise ces gravures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bfd7f05-087a-363a-81de-11809352d3a3",
                                        "entry_id": "2e5d6c9a-b910-3123-a5b2-f4a2c5323709",
                                        "glosses": [
                                            "Reproduction par l’imprimerie, la photographie, la photogravure, de l’ouvrage du graveur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e29d80e-2381-405b-8ef3-509e06ef622a",
                                                "sense_id": "7bfd7f05-087a-363a-81de-11809352d3a3",
                                                "text": "C'est pour cela que les catalogues illustrés sur les expositions ont toujours été des entreprises sans lendemain, malgré la perfection des gravures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0aba8ed-7fb5-3850-ad9f-3290e5619e65",
                                        "entry_id": "2e5d6c9a-b910-3123-a5b2-f4a2c5323709",
                                        "glosses": [
                                            "Opération qui consiste à enlever, selon un dessin donné, une couche de matériau sur un substrat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3983819c-7786-31dd-b1e3-55e94087d37c",
                                        "entry_id": "2e5d6c9a-b910-3123-a5b2-f4a2c5323709",
                                        "glosses": [
                                            "Action de graver un CD, ou un DVD pour y stocker des données."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
