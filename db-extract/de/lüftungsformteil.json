                "senses": [
                    {
                        "sense_id": "a02109ce-17ba-3919-a128-8ec4f4436ced",
                        "entry_id": "7f740635-ba54-32ec-a041-43b7e4c97c21",
                        "glosses": [
                            "spezieller Gegenstand von besonderer Gestalt, der in eine Lüftungsanlage eingebaut wird und durch den Luft strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0195f26-4c8a-4c73-b376-a5123cff0beb",
                                "sense_id": "a02109ce-17ba-3919-a128-8ec4f4436ced",
                                "text": "„Heute ist das Unternehmen mit modernster Technologie ausgestattet und vertreibt weltweit Lüftungsformteile aus Kunststoff.“"
                            },
                            {
                                "example_id": "76799f2a-0db1-4bef-8c3b-840caea432d4",
                                "sense_id": "a02109ce-17ba-3919-a128-8ec4f4436ced",
                                "text": "„Diese Lüftungsformteile aus Kunststoff, finden insbesondere Ihre Verwendung in korrosionsbeständigen Absauganlagen in der Chemischen Industrie allgemein, der Galvanischen Industrie, Papier-und Nahrungsmittelindustrie und Laboreinrichtungen.“"
                            },
                            {
                                "example_id": "1d77e64e-7da1-4aea-a4c0-79a6500d5c73",
                                "sense_id": "a02109ce-17ba-3919-a128-8ec4f4436ced",
                                "text": "„Nun müssen Sie lediglich auf den Knopf Wahl klicken, ein Lüftungsformteil in der Zeichnung wählen und Anschließend die Eingabetaste drücken.“"
                            },
                            {
                                "example_id": "16848014-a8c7-48ce-808f-ba84a4086b52",
                                "sense_id": "a02109ce-17ba-3919-a128-8ec4f4436ced",
                                "text": "„Unsere Kunden schätzen hierbei vor allem unsere handgeschweißten Lüftungsformteile, die den Vorteil einer höheren mechanischen und chemischen Belastbarkeit mit sich bringen.“"
                            },
                            {
                                "example_id": "c5e668e7-c8c3-4928-b3b5-9be6b5e57f8b",
                                "sense_id": "a02109ce-17ba-3919-a128-8ec4f4436ced",
                                "text": "„Bei den Lüftungsformteilen unterscheiden wir zwischen Rohrbogen, T-Stück, Doppelmuffe, Reduzierung, Flansche, Sattelstutzen, Hosen T-Stück, Wanddurchführung, Endboden und einer Reinigungsöffnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
