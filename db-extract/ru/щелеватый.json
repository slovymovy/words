                ],
                "senses": [
                    {
                        "sense_id": "ad5aa22e-0ed5-325e-bbad-90a85bf23412",
                        "entry_id": "72e88eb8-9c32-3ba5-a9a4-5a3df0550f6c",
                        "glosses": [
                            "имеющий щели, щелистый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49df409a-fd76-46a9-9f00-7220f7476b1d",
                                "sense_id": "ad5aa22e-0ed5-325e-bbad-90a85bf23412",
                                "text": "В светце горела лучина, слегка потрескивая и роняя искры на щелеватый пол."
                            },
                            {
                                "example_id": "54348f51-07b9-4b28-9497-023241cd2eb3",
                                "sense_id": "ad5aa22e-0ed5-325e-bbad-90a85bf23412",
                                "text": "Она была сложена из толстых лиственниц, а так как лиственница очень щелевата, то в каждом бревне были широкие щели, за которые легко было цепляться концами пальцев."
                            }
                        ]
                    }
                ],
