                    {
                        "sense_id": "960c4d80-8a54-3e2f-847e-0009c24270ac",
                        "entry_id": "81f0eb3f-afcf-36c5-9170-47ef2a29fd9b",
                        "glosses": [
                            "Agent chargé de la surveillance d’un secteur de la voie ferrée."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "c955d69e-a8ae-4f9d-baed-90827aed112d",
                                "sense_id": "960c4d80-8a54-3e2f-847e-0009c24270ac",
                                "text": "Le plus souvent l’imprimeur, le coiffeur, le teinturier foudres de guerre, déjà un peu atteints par l’âge échouaient comme gardes-voie et coulaient des jours tranquilles."
                            },
                            {
                                "example_id": "25d3acca-aca2-4706-aa8a-a7fbb0f188bf",
                                "sense_id": "960c4d80-8a54-3e2f-847e-0009c24270ac",
                                "text": "Elie confia sa motocyclette à un vieux garde-voie, qui aussitôt l’enchaîna derrière des bidons vides dans le réduit aux lampes."
                            }
                        ]
                    }
