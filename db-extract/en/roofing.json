                ],
                "senses": [
                    {
                        "sense_id": "3b05a4ad-a877-349a-b10e-7c69dc6064b6",
                        "entry_id": "b6d572b0-4c29-3f56-868a-dfb9b753cb4a",
                        "glosses": [
                            "Material used on the outside of a roof, such as shingles."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ebd68b56-2f13-4e84-acbe-6455e88d73fb",
                                "sense_id": "3b05a4ad-a877-349a-b10e-7c69dc6064b6",
                                "text": "As towns continue to grow, replanting vegetation has become a form of urban utopia and green roofs are spreading fast. Last year 1m square metres of plant-covered roofing was built in France, as much as in the US, and 10 times more than in Germany, the pioneer in this field."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbf9d39a-7761-3ca7-9dec-bef39f66cbe3",
                        "entry_id": "b6d572b0-4c29-3f56-868a-dfb9b753cb4a",
                        "glosses": [
                            "The process of constructing a roof or roofs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bbf77d24-eb58-3e95-8111-2e127be252ad",
                        "entry_id": "b6d572b0-4c29-3f56-868a-dfb9b753cb4a",
                        "glosses": [
                            "A way of travel which consists in clambering over the roofs of skyscrapers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bfd2ece-de5c-4126-86ca-0c67e966303d",
                        "source_entry_id": "b6d572b0-4c29-3f56-868a-dfb9b753cb4a",
                        "source_sense_description": "material used on the outside of a roof",
                        "target_lang_word": "Bedachungsmaterial",
