                "senses": [
                    {
                        "sense_id": "285adce3-fcb3-339e-b2c6-3601cd784634",
                        "entry_id": "628ade9e-7130-3a35-a32d-2091d25a0c1c",
                        "glosses": [
                            "Kochtopf, der fast dampfdicht verschlossen wird, wodurch sich innen ein Überdruck bildet, der durch die Erhöhung des Siedepunktes eine höhere Kochtemperatur bewirkt und damit die Garzeit verkürzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3ba10c-6c6e-4b13-b29b-3f89987f2f4a",
                                "sense_id": "285adce3-fcb3-339e-b2c6-3601cd784634",
                                "text": "„Die Hühnerschenkel mit Salz und Pfeffer einreiben, dann zusammen mit zerkleinerten Tomaten und einer entkernten, klein gewürfelten Jalapeño in einen Druckkochtopf füllen.“"
                            },
                            {
                                "example_id": "767d4a97-7bae-44d7-be9a-e892bf8efb51",
                                "sense_id": "285adce3-fcb3-339e-b2c6-3601cd784634",
                                "text": "„Der Druckkochtopf war die einzige Möglichkeit, das Getreide rasch weich zu bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
