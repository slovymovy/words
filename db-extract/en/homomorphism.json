                ],
                "senses": [
                    {
                        "sense_id": "083f5e05-73f4-3326-957f-f502ccc92637",
                        "entry_id": "130d664e-0ad0-38b5-83ea-6f7283b1029c",
                        "glosses": [
                            "A structure-preserving map between two algebraic structures of the same type, such as groups, rings, or vector spaces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "593cb1f8-336d-419d-a55a-3124d003223b",
                                "sense_id": "083f5e05-73f4-3326-957f-f502ccc92637",
                                "text": "A field homomorphism is a map from one field to another one which is additive, multiplicative, zero-preserving, and unit-preserving."
                            },
                            {
                                "example_id": "90011ca0-52ef-432f-9fea-12b8d2f2c92c",
                                "sense_id": "083f5e05-73f4-3326-957f-f502ccc92637",
                                "text": "1954, Kuo-Tsai Chen, Iterated Integrals and Exponential Homomorphisms, Proceedings of the London Mathematical Society, Reprinted in 2001, Philippe Tondeur (editor), Collected Papers of K.-T. Chen, Birkhäuser, page 54,\nThis motivates a generalization, and exponential homomorphisms are now defined, in an algebraic fashion, from certain free products to formal power series rings with non-commutative indeterminates."
                            },
                            {
                                "example_id": "71e38b14-c1be-4e9b-bd7c-a0c292758b52",
                                "sense_id": "083f5e05-73f4-3326-957f-f502ccc92637",
                                "text": "A homomorphism of presheaves h#58;A#92;rightarrowB is a collection of homomorphisms h#95;U#58;A(U)#92;rightarrowB(U) commuting with restrictions."
                            },
                            {
                                "example_id": "df41c5eb-af24-4d5e-9ef5-923778051e45",
                                "sense_id": "083f5e05-73f4-3326-957f-f502ccc92637",
                                "text": "Definition 1.15. Let G and H be matrix Lie groups. A map #92;Phi from G to H is called a Lie group homomorphism if (1) #92;Phi is a group homomorphism and (2) #92;Phi is continuous."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6b243f0-a198-3177-a706-13caf814a38f",
                        "entry_id": "130d664e-0ad0-38b5-83ea-6f7283b1029c",
                        "glosses": [
                            "A similar appearance of two unrelated organisms or structures, as for example with fish and whales."
                        ],
                        "tags": [],
                        "examples": []
                    }
