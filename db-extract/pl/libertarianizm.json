                "senses": [
                    {
                        "sense_id": "2aa36e86-6345-3d09-8f67-749c37e09661",
                        "entry_id": "84b52589-4a89-3dbc-8e7c-629cde805c9d",
                        "glosses": [
                            "doktryna uznająca wolność osobistą i wolność ekonomiczną za najwyższe wartości w polityce"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3e325532-a997-3e63-a6a3-66ca3c967227",
                        "entry_id": "84b52589-4a89-3dbc-8e7c-629cde805c9d",
                        "glosses": [
                            "koncepcja wolnej woli zakładająca możliwość podjęcia przez osobę różnych ścieżek działania w tych samych okolicznościach"
                        ],
                        "tags": [],
