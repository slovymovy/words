                        "glosses": [
                            "Qui effraie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "38a31d74-67be-40ba-a76c-321a83312c05",
                                "sense_id": "541a0528-34c4-3265-98c7-fc1256c7ee6f",
                                "text": "Il recula de l’autel en tremblant, & une voix terrible qui sortit de l’obscurité effrayable de la nuit, lui dit : Pourquoi trembles-tu, & pourquoi la terreur est-elle peinte sur ton visage ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "62a2dbd2-179b-3ea1-aea9-db747ab30fc6",
                        "entry_id": "f4150b5d-b23c-3ca1-8941-2201a98be35a",
                        "glosses": [
                            "Qu’on peut effrayer ; qui s’effraie facilement."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "87c2e097-bcef-4736-a131-85eeea0602ad",
                                "sense_id": "62a2dbd2-179b-3ea1-aea9-db747ab30fc6",
                                "text": "On frémit en songeant que, dans la province surtout, avec un jury campagnard, un jury simple, illettré, effrayable, le résumé artificieux et passionné d’un président d'assises peut déterminer seul, tout seul, un verdict de mort."
                            },
                            {
                                "example_id": "54d63f46-0ad5-4e2c-9bfd-5383954f8740",
                                "sense_id": "62a2dbd2-179b-3ea1-aea9-db747ab30fc6",
                                "text": "Même si je suis facilement effrayable au cinéma, je reste très fan du genre parce qu’il se rapproche du grand frisson érotique."
                            }
                        ]
                    }
