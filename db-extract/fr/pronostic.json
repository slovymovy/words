        "fr-extract.jsonl": [
            {
                "entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                "word": "pronostic",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aed1978b-8325-475e-b921-1542a25f4cb2",
                        "entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                        "tags": [
                            "plural"
                        ],
                        "form": "pronostics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                        "entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                        "glosses": [
                            "Jugement conjectural sur ce qui doit arriver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a837c4-440e-4575-a379-86439ec3c82f",
                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                "text": "Plus la situation sera critique, plus le pronostic devra être positif pour profiter d’un respirateur. Et il ne s’agit pas d’un choix entre deux personnes."
                            },
                            {
                                "example_id": "b82289d4-2dd4-43f8-991b-29e063a3be25",
                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                "text": "Son expérience des affaires donne une particulière autorité à ses pronostics."
                            },
                            {
                                "example_id": "7cb3906d-8f03-4c5c-9362-966ea54b72fa",
                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                "text": "Il n’est généralement pas heureux dans ses pronostics."
                            },
                            {
                                "example_id": "7316bdd6-20e0-478e-9f29-b44835eff160",
                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                "text": "Le pronostic des médecins a été peu rassurant."
                            },
                            {
                                "example_id": "30db0830-71dc-4f36-a331-8fc8c1dd8ded",
                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                "text": "Les hommes politiques se trompent souvent dans leurs pronostics."
                            },
                            {
                                "example_id": "b739ff64-2d50-4a4f-b788-f68fae1a2899",
                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                "text": "Il m’a donné ses pronostics pour cette course."
                            }
                        ]
                    },
                    {
                        "sense_id": "de5085e2-f64f-3415-9fae-b10797a1f924",
                        "entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                        "glosses": [
                            "Signe par lequel on conjecture ce qui doit arriver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc186b4-34c9-4d9f-ab08-a11e63aa48bf",
                                "sense_id": "de5085e2-f64f-3415-9fae-b10797a1f924",
                                "text": "Ce revers fut le pronostic de sa chute."
                            },
                            {
                                "example_id": "94b7c2cb-e0af-4617-b919-72d7a38c807c",
                                "sense_id": "de5085e2-f64f-3415-9fae-b10797a1f924",
                                "text": "Cela me paraît être d’un heureux pronostic."
                            },
                            {
                                "example_id": "ea80d3a1-3636-46d9-b357-48c3439e7b9d",
                                "sense_id": "de5085e2-f64f-3415-9fae-b10797a1f924",
                                "text": "Je regarde ce petit événement comme un pronostic favorable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "297095a9-f010-4d3d-ae7d-808b723b3f59",
                        "source_entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                        "target_lang_word": "Prognose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prognose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb78057a-7e6b-355d-8862-06c1366960ba",
                                        "entry_id": "8b5f5fa0-dd92-34f9-9961-cc67fdc70dd9",
                                        "glosses": [
                                            "Vorhersage zukünftiger Ereignisse oder der voraussichtlichen Entwicklung mit wissenschaftlichen Methoden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e5ca183-e3c7-4744-afcb-8e0ec37358ad",
                                                "sense_id": "cb78057a-7e6b-355d-8862-06c1366960ba",
                                                "text": "Sein momentaner Zustand war zwar sehr schlecht, aber die gute Prognose des Arztes gab ihm Mut, gegen die Krankheit anzukämpfen."
                                            },
                                            {
                                                "example_id": "6374e39e-7ff7-4822-b088-fffbb14951f9",
                                                "sense_id": "cb78057a-7e6b-355d-8862-06c1366960ba",
                                                "text": "„Und gerade Frauen speichern positive oder negative Prognosen in Bezug auf Partnerschaft, Flirt oder Sexleben nicht ausnahmslos unter ‚Quatsch‘ ab.“"
                                            },
                                            {
                                                "example_id": "4d461a87-2fb6-499b-ab5f-c82d1c72a78d",
                                                "sense_id": "cb78057a-7e6b-355d-8862-06c1366960ba",
                                                "text": "„[…] meine Prognose ist, dass Tesla schon sehr bald seine Marktkapitalisierung verdoppeln wird und Volkswagen und BMW bedeutungslos werden.“"
                                            },
                                            {
                                                "example_id": "1dad822c-c69f-48a2-9b53-bc0cd684c31a",
                                                "sense_id": "cb78057a-7e6b-355d-8862-06c1366960ba",
                                                "text": "„Ich erkenne mich ja selbst nicht wieder, wenn ich aus der Türkei nach Berlin zurückkehre und schlaflose Nächte verbringe, weil mir Prognosen aus meiner Mokkatasse gelesen wurden.“"
                                            },
                                            {
                                                "example_id": "ae88141d-6d90-4d60-aeba-5cd9b277e9c5",
                                                "sense_id": "cb78057a-7e6b-355d-8862-06c1366960ba",
                                                "text": "„Vielleicht haben Prognosen für uns den gleichen Stellenwert wie bei den alten Griechen das Orakel von Delphi.“"
                                            },
                                            {
                                                "example_id": "5b981191-775e-427b-9e19-28194b82f802",
                                                "sense_id": "cb78057a-7e6b-355d-8862-06c1366960ba",
                                                "text": "„Es gibt keine exakten Prognosen über den Klimawandel. In einer Studie bleibt etwas mehr, in einer anderen Studie etwas weniger Zeit, um die Klimaziele doch noch zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3320df8-0857-4637-8d1f-c9b38349604f",
                        "source_entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                        "target_lang_word": "Vorhersage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorhersage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "252459ae-cb84-3b5c-80e4-ce6367602eac",
                                        "entry_id": "1dc11eea-8c8f-336f-b669-532daa9fd22f",
                                        "glosses": [
                                            "eine Aussage über etwas, das in Zukunft sein wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdbd09da-bd73-4a9b-9dca-f008123d0127",
                                                "sense_id": "252459ae-cb84-3b5c-80e4-ce6367602eac",
                                                "text": "Eine Vorhersage darüber, wie sich die Verhältnisse langfristig entwickeln werden, erscheint sehr gewagt."
                                            },
                                            {
                                                "example_id": "576c2493-ff44-4e56-a922-28dbc8817c98",
                                                "sense_id": "252459ae-cb84-3b5c-80e4-ce6367602eac",
                                                "text": "„Zu glauben, die Lehren der Vergangenheit zur Vorhersage der Zukunft nutzen zu können, ist genauso falsch, wie zu glauben, sie nicht zur Vorsorge nutzen zu müssen.“"
                                            },
                                            {
                                                "example_id": "f5d868cf-56ad-4748-be35-e13085bd7b69",
                                                "sense_id": "252459ae-cb84-3b5c-80e4-ce6367602eac",
                                                "text": "„Von den Vorhersagen der Energieexperten, die bereits in wenigen Jahren mit einem Absinken der Ölnachfrage rechnen, zeigen sich die US-Konzerne dagegen unbeeindruckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c983e153-251c-4447-b19d-55a40c837f8f",
                        "source_entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                        "target_lang_word": "prognosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prognosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6df69a74-53b3-3da4-9b68-5eb3cdb44174",
                                        "entry_id": "e7cebf15-cf9e-3e8d-8299-9d6f0028f127",
                                        "glosses": [
                                            "A forecast of the future course or outcome of a situation based on what is presently known; a prediction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b18428b2-6214-4d5a-a38a-8cef09e55be2",
                                                "sense_id": "6df69a74-53b3-3da4-9b68-5eb3cdb44174",
                                                "text": "I may say here that it is one of the evidences of original character, that it is apt to baffle all prognosis from a mere observer's standpoint."
                                            },
                                            {
                                                "example_id": "25717ed0-9095-4011-b580-b04a5402a6c4",
                                                "sense_id": "6df69a74-53b3-3da4-9b68-5eb3cdb44174",
                                                "text": "Despite the positive, constructive aspects of the Beeching Report, the gloomy prognoses on B.R. which issued from so many commentators prior to its publication have left a widespread impression that the railway is an outdated concept."
                                            },
                                            {
                                                "example_id": "7f0ef602-7237-4949-8579-449d1e13f65d",
                                                "sense_id": "6df69a74-53b3-3da4-9b68-5eb3cdb44174",
                                                "text": "The prognosis was made by taking into consideration the facts that the analog concrete had already achieved its ultimate strength by the period of 1500 days while concrete being predicted was to gain its strength limit by 1.25 time faster, that is by the period of 100 days."
                                            },
                                            {
                                                "example_id": "4f55d2e8-6b2e-49ea-98f7-68a2d3154456",
                                                "sense_id": "6df69a74-53b3-3da4-9b68-5eb3cdb44174",
                                                "text": "If free speech is the lifeblood of democracy then the fate and the prognosis of the latter are that of the former."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5015698c-c0c2-3f07-a260-ad6670278778",
                                        "entry_id": "e7cebf15-cf9e-3e8d-8299-9d6f0028f127",
                                        "glosses": [
                                            "A forecast of the future course or outcome of a disease or disorder based on current medical knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d27352-b3c7-4bff-91c8-85beca0a3137",
                                                "sense_id": "5015698c-c0c2-3f07-a260-ad6670278778",
                                                "text": "Hovvbeit it is to be noted (vvhich vve hinted in the prognoſis) that the ſvvelling doth often appear critically and profitably, and thereby the ſick are recovered of their diſeaſes; […]"
                                            },
                                            {
                                                "example_id": "13942569-5331-43c0-a8c6-5f8c549ad4c6",
                                                "sense_id": "5015698c-c0c2-3f07-a260-ad6670278778",
                                                "text": "The prognosis [of measles] is unfavourable when the child is very young, when the eruption appears before the third day, or when it suddenly disappears. […] The prognosis is favourable when the gastro-pulmonary symptoms are slight, the progress of the disease is regular, and when the skin is moist after the appearance of the exanthema."
                                            },
                                            {
                                                "example_id": "6ac9cf25-5b75-4afd-89dd-ab47e24935e7",
                                                "sense_id": "5015698c-c0c2-3f07-a260-ad6670278778",
                                                "text": "Once the patient has worked through the stage of grieving at diagnosis, adjustment may be successful as therapy is begun and a prognosis is determined."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f86ca59e-8e7e-40c3-8b60-5065c1683607",
                        "source_entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                        "target_lang_word": "prognostic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prognostic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdec17ad-09c2-385e-a412-dfd981b635a6",
                                        "entry_id": "2bcef614-5098-3076-a2b9-fa5cf0cc9851",
                                        "glosses": [
                                            "prognosis"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fae10be-9e95-4b57-b251-bdf7062ae9ef",
                                                "sense_id": "bdec17ad-09c2-385e-a412-dfd981b635a6",
                                                "text": "There are several opinions as to what he meant\n But no one considers it a happy prognostic."
                                            },
                                            {
                                                "example_id": "3f927513-5455-4a74-a0d2-9667b10940fc",
                                                "sense_id": "bdec17ad-09c2-385e-a412-dfd981b635a6",
                                                "text": "The appearance of the tongue is closely connected with the sense of thirst, and is of considerable importance as a prognostic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f0a5c42-9588-39c5-945a-17a1f0cd33ec",
                                        "entry_id": "2bcef614-5098-3076-a2b9-fa5cf0cc9851",
                                        "glosses": [
                                            "A sign by which a future event may be known or foretold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34b964f1-0a34-4de4-9330-35989a842ebc",
                                                "sense_id": "9f0a5c42-9588-39c5-945a-17a1f0cd33ec",
                                                "text": "Careful observers may foretell the hour\n (By sure prognostics) when to dread a show’r.\n While rain depends, the pensive cat gives o’er\n Her frolics, and pursues her tail no more."
                                            },
                                            {
                                                "example_id": "ea66e94f-aae0-42ab-b520-ca51cee273f9",
                                                "sense_id": "9f0a5c42-9588-39c5-945a-17a1f0cd33ec",
                                                "text": "It was even later than usual when the Comtesse quitted a brilliant réunion of all that was gayest in the royal circle, elate with the glittering triumph of gratified vanity, and reading in such success the sure prognostic of more solidly successful ambition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca3f8f55-7366-3ed3-99d8-eb592e91ac7b",
                                        "entry_id": "2bcef614-5098-3076-a2b9-fa5cf0cc9851",
                                        "glosses": [
                                            "A prediction of the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f34c372-c80b-448e-9a4a-bcae116a9788",
                                                "sense_id": "ca3f8f55-7366-3ed3-99d8-eb592e91ac7b",
                                                "text": "The choice of a successor was no light matter. That choice would inevitably be considered by the country as a prognostic of the highest import."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00bbe606-24b8-39de-92dc-fe94529aba5f",
                                        "entry_id": "2bcef614-5098-3076-a2b9-fa5cf0cc9851",
                                        "glosses": [
                                            "One who predicts the future."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
