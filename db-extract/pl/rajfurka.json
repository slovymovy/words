                "translations": [
                    {
                        "translation_id": "13b12ccf-86ee-4ecc-bac0-c29528024aa6",
                        "source_entry_id": "9ce124b7-3b29-3fc9-b677-e17f33457cc3",
                        "source_sense_id": "5261cb3c-a727-3a5a-9a0b-8228d00d350e",
                        "target_lang_word": "bawd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bawd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad728d1-ba57-3696-978a-608c845534a4",
                                        "entry_id": "882e72aa-c4c2-3a0d-bccc-f6c4c6e538c1",
                                        "glosses": [
                                            "One who keeps a brothel, or procures women for prostitution; a procurer or madam."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b533504-6a5e-4784-99f6-9cb82f69fffa",
                                                "sense_id": "8ad728d1-ba57-3696-978a-608c845534a4",
                                                "text": "Of late in the Park, a fair fancy was seen / Betwixt an old Baud and a lusty young Quean, / Their parting of Money began the uproar, / I'll have half says the Baud, but you shan't says the Whore"
                                            },
                                            {
                                                "example_id": "b41498f0-1175-4ba9-bc65-47727e7a56fe",
                                                "sense_id": "8ad728d1-ba57-3696-978a-608c845534a4",
                                                "text": "As Whores decay'd and past their Labours, / Turn Bawds, and so assist their Neighbours."
                                            },
                                            {
                                                "example_id": "fef6fb04-ba95-44d9-8567-c0ee6d1883a2",
                                                "sense_id": "8ad728d1-ba57-3696-978a-608c845534a4",
                                                "text": "[…] here were no Gibers, Cenſurers, Backbiters, Pick-pockets, Highwaymen, Houſebreakers, Attorneys, Bawds, Buffoons, Gameſters, Politicians, Wits, ſplenetick tedious Talkers, Controvertiſts, Raviſhers, Murderers, Robbers, Virtuoſo's; […]"
                                            },
                                            {
                                                "example_id": "c978e026-3878-4f3d-b833-d14ceb6c8f2c",
                                                "sense_id": "8ad728d1-ba57-3696-978a-608c845534a4",
                                                "text": "Compared with their opponents, bawds and their associates increasingly had deeper pockets and greater confidence in manipulating the law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f085840-b796-387d-8436-db4c9e9a4e09",
                                        "entry_id": "882e72aa-c4c2-3a0d-bccc-f6c4c6e538c1",
                                        "glosses": [
                                            "A person who facilitates an immoral act, especially one of a sexual nature."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45898192-9e1b-49aa-9659-e1af39289ef1",
                                                "sense_id": "2f085840-b796-387d-8436-db4c9e9a4e09",
                                                "text": "In ſaying this thou wrongſt me Gaueſton, / Iſt not enough that thou corrupts my Lord, / And art a Bawd to his affections, / But thou muſt call mine honour thus in queſtion?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77fd6f59-82ab-3c05-a939-0bbf87a9eafa",
                                        "entry_id": "882e72aa-c4c2-3a0d-bccc-f6c4c6e538c1",
                                        "glosses": [
                                            "A lewd person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bawd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a7823a7-98bc-3c2b-80aa-825365789589",
                                        "entry_id": "5d6a6864-141c-3cf1-9306-b77423696a8c",
                                        "glosses": [
                                            "Joyous; riotously gay."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bawd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "429e2092-bbcd-38f4-92b1-21d2e82f788c",
                                        "entry_id": "90dc145a-34a2-370a-9bd1-d7767d342172",
                                        "glosses": [
                                            "To procure women for lewd purposes."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
