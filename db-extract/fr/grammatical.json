                "senses": [
                    {
                        "sense_id": "b67753b5-6e0f-3cb4-8164-494474e62c74",
                        "entry_id": "f76128f8-497a-3215-8682-d35884f6d514",
                        "glosses": [
                            "Qui a rapport à la grammaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd0ee66-4a21-41a2-b072-3711a188c393",
                                "sense_id": "b67753b5-6e0f-3cb4-8164-494474e62c74",
                                "text": "Discussion grammaticale."
                            },
                            {
                                "example_id": "d93f1357-33d3-4ca7-aaa5-4d74de69a37b",
                                "sense_id": "b67753b5-6e0f-3cb4-8164-494474e62c74",
                                "text": "Journal grammatical."
                            },
                            {
                                "example_id": "918ddb1c-a948-4f3b-9852-b1aa59a964c7",
                                "sense_id": "b67753b5-6e0f-3cb4-8164-494474e62c74",
                                "text": "Notes grammaticales."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f09cd47-56ac-3eff-932b-5d236ad9e28e",
                        "entry_id": "f76128f8-497a-3215-8682-d35884f6d514",
                        "glosses": [
                            "Qui est selon les règles de la grammaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63835150-2b34-483f-be00-b2a808173086",
                                "sense_id": "7f09cd47-56ac-3eff-932b-5d236ad9e28e",
                                "text": "Pas question de féminiser les dénominations professionnelles. […]. Pendant quelques années encore, on peut écrire sans rire que «le ministre est enceinte», c’est ce qu’on appelle une syllepse, le sens l’emportant sur l’accord grammatical."
                            },
                            {
                                "example_id": "8ff28df8-5fa8-4f16-8013-cf7a5f11d49c",
                                "sense_id": "7f09cd47-56ac-3eff-932b-5d236ad9e28e",
                                "text": "Exactitude, correction grammaticale. — Construction grammaticale."
                            }
                        ]
                    },
                    {
                        "sense_id": "64c51fc5-312b-3aa6-bedf-87f5a923d30a",
                        "entry_id": "f76128f8-497a-3215-8682-d35884f6d514",
                        "glosses": [
                            "Qui respecte les règles de production d’un énoncé propres à une langue donnée. Noam Chomsky a montré que la phrase « d’incolores idées vertes dorment furieusement » est grammaticale mais non pas acceptable."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e47d3be-43f9-4729-97a5-de716d83d253",
                        "source_entry_id": "f76128f8-497a-3215-8682-d35884f6d514",
                        "source_sense_id": "b67753b5-6e0f-3cb4-8164-494474e62c74",
                        "source_sense_description": "relatif à la grammaire",
                        "target_lang_word": "grammatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grammatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                        "entry_id": "5e06cf61-ae76-3a1d-8f81-4941419040d5",
                                        "glosses": [
                                            "die Grammatik betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54379b2-db94-44d9-988c-13b07622468e",
                                                "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                                "text": "Man sollte versuchen, grammatische Fehler zu vermeiden."
                                            },
                                            {
                                                "example_id": "16e14e46-5eee-447f-bc33-dbd403586fe2",
                                                "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                                "text": "„Auf der morphologischen, grammatischen und orthographischen Ebene ist die Einheitlichkeit der deutschen Standardsprache stets voll gewahrt geblieben…“"
                                            },
                                            {
                                                "example_id": "021b410e-cb81-4567-93e9-1c2df85292e8",
                                                "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                                "text": "„Das zeigt sich sowohl auf der grammatischen als auch auf der lexikalischen Ebene.“"
                                            },
                                            {
                                                "example_id": "7ead5004-e400-4365-8b12-56a6e62766c7",
                                                "sense_id": "84d98cc8-c9fe-381c-8cb4-8f7536571c44",
                                                "text": "„Es handelt sich vielmehr um ein lexikalisches Merkmal prosodischer Art mit grammatischer Funktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebe9f819-c718-3870-9929-08437cd6c605",
                                        "entry_id": "5e06cf61-ae76-3a1d-8f81-4941419040d5",
                                        "glosses": [
                                            "die Regeln der Grammatik befolgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c07407-e39c-4e95-8ca5-9baf1652be29",
                                                "sense_id": "ebe9f819-c718-3870-9929-08437cd6c605",
                                                "text": "Der Satz „Hans ist groß.“ ist grammatisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
