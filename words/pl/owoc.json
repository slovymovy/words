                            {
                                "target_lang_word": "Frucht",
                                "target_lang_sense_clarification": "einzelne Frucht oder botanischer Begriff"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fbe2045-20e7-3ef1-a4d7-c35b9aad913a",
                    "sense_definition": "Pozytywny wynik lub efekt jakiejś pracy, działania lub wysiłku.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten sukces to zasłużony <w>owoc</w> wielu lat nauki i wyrzeczeń.",
                            "target_lang_translations": {
                                "ru": "Этот успех — заслуженный <w>плод</w> многих лет учёбы и самопожертвования.",
                                "en": "This success is the well-deserved <w>fruit</w> of many years of study and sacrifice.",
                                "de": "Dieser Erfolg ist die wohlverdiente <w>Frucht</w> langjähriger Studien und Entbehrungen."
                            }
                        },
                        {
                            "text": "W końcu możemy zbierać <w>owoce</w> naszej ciężkiej pracy.",
                            "target_lang_translations": {
                                "ru": "Наконец мы можем пожинать <w>плоды</w> нашего тяжёлого труда.",
                                "en": "We can finally reap the <w>fruits</w> of our hard work.",
                                "de": "Endlich können wir die <w>Früchte</w> unserer harten Arbeit ernten."
                            }
                        }
                    ],
                    "synonyms": [
                        "rezultat",
                        "skutek",
                        "plon",
                        "efekt"
                    ],
                    "common_phrases": [
                        "owoc pracy",
                        "zakazany owoc",
                        "zbierać owoce",
                        "przynosić owoce"
                    ],
                    "target_lang_definitions": {
