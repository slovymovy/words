                "senses": [
                    {
                        "sense_id": "0dd5e96c-e699-3a9f-9828-ec6e90b329cb",
                        "entry_id": "7e5b8f45-9a2b-367a-9ca0-1354f07410ad",
                        "glosses": [
                            "A magistrate who served as a consul and then as the governor of a province."
                        ],
