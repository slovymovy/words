                                        "entry_id": "7b1cfe71-b2ca-3e0c-9191-c48ec9e5a4b9",
                                        "glosses": [
                                            "Quantité d’ions hydronium dissoute dans l'unité de volume de solution aqueuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624421bc-aef6-4ba4-944b-ed2ddce65db6",
                                                "sense_id": "0a497689-387f-301f-828b-4b6c1c510edc",
                                                "text": "Cet échantillon sera utilisé pour la détermination de l'acidité du lait et de sa matière grasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623fb2e3-069b-3235-8ef5-80d505ab29c0",
                                        "entry_id": "7b1cfe71-b2ca-3e0c-9191-c48ec9e5a4b9",
                                        "glosses": [
                                            "Propriété d’un corps pouvant délivrer des protons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da5e0268-e94c-4c56-9fd8-bd539428c1f5",
                                                "sense_id": "623fb2e3-069b-3235-8ef5-80d505ab29c0",
                                                "text": "Mais la terre jaunâtre et glaiseuse du Perche, désignée dans le pays sous le nom de gruette ou de bournais, exige périodiquement des marnages, en raison de son acidité."
                                            }
                                        ]
                                    },
