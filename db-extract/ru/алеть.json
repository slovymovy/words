                ],
                "senses": [
                    {
                        "sense_id": "84113ede-585a-3091-87e0-699d1c6a8e42",
                        "entry_id": "bf101c82-39b7-3677-b362-288cd1fd3c9c",
                        "glosses": [
                            "to become crimson, scarlet, vermilion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac967452-a86d-4286-9716-8dd7d406a418",
                                "sense_id": "84113ede-585a-3091-87e0-699d1c6a8e42",
                                "text": "Она́ шла по са́ду не́сколько уста́лою похо́дкой; щёки её але́ли и глаза́ свети́лись я́рче обыкнове́нного под соло́менною кру́глою шля́пой.",
                                "translation": "She walked through the garden with a rather tired step, her cheeks were burning and her eyes shone more brightly than usual under her round straw hat.",
                                "english": "She walked through the garden with a rather tired step, her cheeks were burning and her eyes shone more brightly than usual under her round straw hat."
                            },
                            {
                                "example_id": "81e57fcc-9020-4c4d-a176-63f83f887bc0",
                                "sense_id": "84113ede-585a-3091-87e0-699d1c6a8e42",
                                "text": "На за́паде ночь ухо́дит за далё́кие го́ры. Уже́ але́ет восто́к.",
                                "translation": "Alexander Belyaev",
                                "english": "Alexander Belyaev"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
