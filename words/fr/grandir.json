                        {
                            "text": "Les enfants peuvent <w>grandir</w> très vite pendant les vacances d'été.",
                            "target_lang_translations": {
                                "en": "Children can <w>grow</w> very fast during the summer holidays.",
                                "ru": "Дети могут очень быстро <w>расти</w> во время летних каникул.",
                                "nl": "Kinderen kunnen tijdens de zomervakantie heel snel <w>groeien</w>.",
                                "de": "Kinder können in den Sommerferien sehr schnell <w>wachsen</w>.",
                                "pl": "Dzieci mogą bardzo szybko <w>rosnąć</w> podczas letnich wakacji.",
                                "it": "I bambini possono <w>crescere</w> molto in fretta durante le vacanze estive.",
                                "cs": "Děti mohou o letních prázdninách velmi rychle <w>růst</w>.",
                                "tr": "Yaz tatilinde çocuklar çok çabuk <w>büyüyebilir</w>.",
                                "es": "Los niños pueden <w>crecer</w> muy rápido durante las vacaciones de verano.",
                                "zh": "孩子们在暑假里可能会<w>长高</w>得很快。"
                            }
                        },
                        {
                            "text": "Mon petit frère a beaucoup <w>grandi</w> depuis l'année dernière.",
                            "target_lang_translations": {
                                "en": "My little brother has <w>grown</w> a lot since last year.",
                                "ru": "Мой младший брат сильно <w>вырос</w> с прошлого года.",
                                "nl": "Mijn kleine broertje is sinds vorig jaar flink <w>gegroeid</w>.",
                                "de": "Mein kleiner Bruder ist seit dem letzten Jahr stark <w>gewachsen</w>.",
                                "pl": "Mój młodszy brat sporo <w>urósł</w> od zeszłego roku.",
                                "it": "Mio fratellino è <w>cresciuto</w> molto dall'anno scorso.",
                                "cs": "Můj mladší bratr od loňska hodně <w>vyrostl</w>.",
                                "tr": "Küçük kardeşim geçen yıldan beri epey <w>boy attı</w>.",
                                "es": "Mi hermanito ha <w>crecido</w> mucho desde el año pasado.",
                                "zh": "我弟弟从去年到现在<w>长高</w>了很多。"
                            }
                        }
