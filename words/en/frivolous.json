{
    "word_family": [
        "frivolity",
        "frivolously",
        "frivolousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1388c2bd-59e6-389f-97bd-8bb588b40568",
                    "sense_definition": "Silly, especially at an inappropriate time; lacking serious purpose or value; carefree and superficial.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "silly_or_superficial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent her entire inheritance on <w>frivolous</w> purchases like designer shoes and expensive parties.",
                            "target_lang_translations": {
                                "tr": "Bütün mirasını tasarım ayakkabılar ve pahalı partiler gibi <w>boş</w> harcamalarla tüketti."
                            }
                        },
                        {
                            "text": "Making <w>frivolous</w> remarks during a serious business meeting is highly unprofessional.",
                            "target_lang_translations": {
                                "tr": "Ciddi bir iş toplantısında <w>ciddiyetsiz</w> sözler sarf etmek son derece profesyonellik dışıdır."
                            }
                        }
                    ],
                    "synonyms": [
                        "foolish",
                        "silly",
                        "idle"
                    ],
                    "antonyms": [
                        "serious",
                        "solemn"
                    ],
                    "common_phrases": [
                        "frivolous behavior",
                        "frivolous spending"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle uygunsuz zamanlarda yapılan, ciddiyetten veya amaçtan yoksun, saçma, havai veya yüzeysel."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "havai",
                                "target_lang_sense_clarification": "ciddi olmayan, uçarı"
                            },
                            {
                                "target_lang_word": "hoppa",
                                "target_lang_sense_clarification": "davranışlarında ciddiyetsiz ve hafifmeşrep"
                            },
                            {
                                "target_lang_word": "ciddiyetsiz",
                                "target_lang_sense_clarification": "ağırbaşlı olmayan, sorumsuz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "060aa8b1-f6ec-39af-aa15-e7fdd672068b",
                    "sense_definition": "Of little weight or importance; not worth serious notice; trivial.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unimportant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee refused to waste time discussing such <w>frivolous</w> matters when major issues remained unresolved.",
                            "target_lang_translations": {
                                "tr": "Komite, önemli meseleler henüz çözülmemişken böyle <w>önemsiz</w> konuları tartışarak vakit kaybetmeyi reddetti."
                            }
                        },
                        {
                            "text": "They argued over <w>frivolous</w> details instead of focusing on the main goals of the project.",
                            "target_lang_translations": {
                                "tr": "Projenin ana hedeflerine odaklanmak yerine <w>incir çekirdeğini doldurmayan</w> ayrıntılar üzerine tartıştılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "trivial",
                        "insignificant",
                        "unimportant",
                        "paltry",
                        "trifling"
                    ],
                    "antonyms": [
                        "important",
                        "significant",
                        "weighty"
                    ],
                    "common_phrases": [
                        "frivolous matters",
                        "frivolous details"
                    ],
                    "target_lang_definitions": {
                        "tr": "Az öneme sahip olan, dikkate değmeyen, boş ve önemsiz (ayrıntı veya mesele)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "önemsiz",
                                "target_lang_sense_clarification": "kayda değer olmayan"
                            },
                            {
                                "target_lang_word": "boş",
                                "target_lang_sense_clarification": "faydasız, anlamsız"
                            },
                            {
                                "target_lang_word": "incir çekirdeğini doldurmayan",
                                "target_lang_sense_clarification": "son derece ehemmiyetsiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "267f972f-3add-39a1-937f-bd0554845e68",
                    "sense_definition": "Having no reasonable prospect of success because the claim lacks a supporting legal or factual basis.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_meritless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge dismissed the case, declaring it a <w>frivolous</w> lawsuit designed only to harass the defendant.",
                            "target_lang_translations": {
                                "tr": "Yargıç, davanın yalnızca davalıyı taciz etmek amacıyla açılmış <w>mesnetsiz</w> bir dava olduğunu belirterek davayı reddetti."
                            }
                        },
                        {
                            "text": "The company had to spend thousands of dollars defending itself against <w>frivolous</w> claims.",
                            "target_lang_translations": {
                                "tr": "Şirket, <w>dayanaksız</w> iddialara karşı kendini savunmak için binlerce dolar harcamak zorunda kaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "pointless",
                        "futile"
                    ],
                    "antonyms": [
                        "valid",
                        "meritorious"
                    ],
                    "common_phrases": [
                        "frivolous lawsuit",
                        "frivolous claims"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used in legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Hukuki veya olgusal bir temeli olmadığı için başarı şansı bulunmayan, dayanaksız veya yersiz (iddia veya dava)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "mesnetsiz",
                                "target_lang_sense_clarification": "hukuki dayanağı olmayan"
                            },
                            {
                                "target_lang_word": "dayanaksız",
                                "target_lang_sense_clarification": "temelsiz, boş"
                            },
                            {
                                "target_lang_word": "yersiz",
                                "target_lang_sense_clarification": "haksız veya lüzumsuz dava veya iddia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}