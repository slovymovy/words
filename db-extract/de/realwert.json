                "senses": [
                    {
                        "sense_id": "51b576e7-8620-3863-b782-9b7b397ec19e",
                        "entry_id": "77f271fc-baf3-3872-8b52-80d1024c18b1",
                        "glosses": [
                            "der wirkliche materielle Wert eines Gutes, der beispielsweise bei Zahlungsmitteln (Münzen, Geldscheine, Briefmarken) in der Regel von dem Nennwert dieses Gutes deutlich abweicht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea7979e-9c58-46bd-aa38-599e00da8c22",
                                "sense_id": "51b576e7-8620-3863-b782-9b7b397ec19e",
                                "text": "„Im Jahre 1991 war der Preis mit umgerechnet etwa 1,2 Millionen Mark dotiert. Seit dieser Zeit ist die Stiftung bemüht, den Realwert des Preises durch Ausgleich der schwedischen Inflation zu halten.“"
                            }
                        ],
