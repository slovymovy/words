                "senses": [
                    {
                        "sense_id": "4878a211-b3dd-3406-83c9-14c21b926b07",
                        "entry_id": "f5f4a85a-d45b-3672-b244-0c8bc268388d",
                        "glosses": [
                            "bogini wojny, utożsamiana z grecką Enyo"
                        ],
                        "tags": [
                            "Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "36cba111-5d88-4da3-b614-afbcd78aba5e",
                                "sense_id": "4878a211-b3dd-3406-83c9-14c21b926b07",
                                "text": "Bellona uchodziła niekiedy za siostrę albo żonę Marsa."
                            },
                            {
                                "example_id": "00251d3c-c6d2-4643-9064-f222c849c0f8",
                                "sense_id": "4878a211-b3dd-3406-83c9-14c21b926b07",
                                "text": "Przed świątynią Bellony na Polu Marsowym w Rzymie przyjmowano wodzów powracających ze zwycięskiej wojny oraz dokonywano aktu wypowiedzenia wojny ludom niegraniczącym z rzymskim państwem"
                            },
                            {
                                "example_id": "1088f3a7-1a0c-4573-8fe2-2dce43f497f9",
                                "sense_id": "4878a211-b3dd-3406-83c9-14c21b926b07",
                                "text": "Atrybutami Bellony były: pochodnia, miecz lub włócznia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "eedd74ea-fddf-3bbe-8fbb-315b01fd7ade",
                        "entry_id": "f5f4a85a-d45b-3672-b244-0c8bc268388d",
                        "glosses": [
                            "planetoida o numerze katalogowym 28"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b64c38d3-0233-4a45-ac8d-3749cdc6cdd2",
                                "sense_id": "eedd74ea-fddf-3bbe-8fbb-315b01fd7ade",
                                "text": "Bellona porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
