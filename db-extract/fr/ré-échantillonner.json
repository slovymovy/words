                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a4d190-21bb-467a-85ae-88cd07269e54",
                                "sense_id": "84f5f885-3391-3c9a-b1ef-416e2d8a8bca",
                                "text": "Ré-échantillonner le son à l’aide du logiciel en 8 kHz."
                            },
                            {
                                "example_id": "9264e2d4-80e9-470c-b168-70a664adb4ca",
                                "sense_id": "84f5f885-3391-3c9a-b1ef-416e2d8a8bca",
                                "text": "Pour éviter absolument ces difficultés, il est d’usage de linéariser le spectre, c’est-à-dire de le ré-échantillonner avec un pas constant."
                            },
                            {
                                "example_id": "afcdfca0-e483-4489-b167-86c88e27f162",
                                "sense_id": "84f5f885-3391-3c9a-b1ef-416e2d8a8bca",
                                "text": "Quoiqu’il soit tentant de les ré-échantillonner à la taille correspondant au plein écran du terminal ciblé, n’oubliez pas que plus la taille d’affichage est grande, plus la taille du fichier l’est aussi."
                            }
                        ]
