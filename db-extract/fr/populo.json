        "fr-extract.jsonl": [
            {
                "entry_id": "9bc32e1b-4fb2-3ff7-b4d0-ba10829297dd",
                "word": "populo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5e96cd6d-4072-4c89-960a-5aba34127372",
                        "entry_id": "9bc32e1b-4fb2-3ff7-b4d0-ba10829297dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "populos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                        "entry_id": "9bc32e1b-4fb2-3ff7-b4d0-ba10829297dd",
                        "glosses": [
                            "Peuple, en particulier en tant que classe sociale, classes populaires, classes laborieuses ; populace, foule, multitude."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d456e24d-5745-4aa0-b17d-0b3fc57e2971",
                                "sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                                "text": "Le doux caboulot perdu sous les branches est tous les dimanches plein de populo"
                            },
                            {
                                "example_id": "8c76bb25-8d31-405f-b31b-d3139ec69169",
                                "sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                                "text": "Un salaire aussi misérable, c’est se foutre du populo."
                            },
                            {
                                "example_id": "76feb6af-ba9d-4e76-9612-a7fc0e752c2c",
                                "sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                                "text": "Les vociférations crapuleuses de cette chamelle en délire emplissaient maintenant la rue, inondaient la place voisine, montaient jusqu’aux toits, faisaient tressaillir profondément le populo."
                            },
                            {
                                "example_id": "f90f4fd4-e61f-48f0-aa65-bc68c4f3314d",
                                "sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                                "text": "Forcément ! disait Gaby à ses camarades, cent millions, vous pensez ! ça intéresse le populo…"
                            },
                            {
                                "example_id": "836a13c3-91e9-4c22-878c-d5b913fa8de1",
                                "sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                                "text": "Ces mecs-là ne reculent devant rien, pour impressionner le populo."
                            },
                            {
                                "example_id": "2cb98f09-998e-4ffd-b3f8-2be09b32c225",
                                "sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                                "text": "On va leur montrer, à ces bourgeois mais aussi à ces populos lyonnais, de quel bois l’on se chauffe, nous qui sommes tellement à l’aise avec les mots, avec la culture, nous les gagnants de la mondialisation à qui rien ne fait peur…"
                            },
                            {
                                "example_id": "a50b37f6-247f-43b1-8dfe-759350c3884d",
                                "sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                                "text": "La populo demande pas l’opulence sans souffrance, juste représenter, faire acte de présence […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "249949e1-0aff-46b4-a910-1b4113e53165",
                        "source_entry_id": "9bc32e1b-4fb2-3ff7-b4d0-ba10829297dd",
                        "source_sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                        "target_lang_word": "Volk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4221057f-1585-3937-9d40-57c2dd95b55e",
                                        "entry_id": "11d35e6f-e7ba-3bea-9786-ced84d0f9afa",
                                        "glosses": [
                                            "viele gleichartige Leute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2564f181-1a48-41e7-85f1-a64e5609f8a8",
                                                "sense_id": "4221057f-1585-3937-9d40-57c2dd95b55e",
                                                "text": "Nein danke, mit so einem Volk will ich nichts zu tun haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10df3fcc-d924-378a-befc-26d434b6411e",
                                        "entry_id": "11d35e6f-e7ba-3bea-9786-ced84d0f9afa",
                                        "glosses": [
                                            "Gruppe von Menschen mit einer gemeinsamen Kultur, Sprache und Geschichte oder derselben Abstammung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0e0cc3-5179-4ea1-af05-49911c4ae188",
                                                "sense_id": "10df3fcc-d924-378a-befc-26d434b6411e",
                                                "text": "Der ehemalige Politiker behauptete, dass er sich lediglich für sein Volk eingesetzt hat."
                                            },
                                            {
                                                "example_id": "1bebc7d4-52de-482a-809e-3dda4bd20fdb",
                                                "sense_id": "10df3fcc-d924-378a-befc-26d434b6411e",
                                                "text": "Für das jüdische Volk ist Israel das „Heilige Land“."
                                            },
                                            {
                                                "example_id": "49ecadb8-9a93-4058-9f8f-872dacfddf79",
                                                "sense_id": "10df3fcc-d924-378a-befc-26d434b6411e",
                                                "text": "Das Volk der Indianer ist noch nicht ausgestorben."
                                            },
                                            {
                                                "example_id": "242b02f4-88ef-4a58-af42-0b24e50a21c8",
                                                "sense_id": "10df3fcc-d924-378a-befc-26d434b6411e",
                                                "text": "„Diese Täler bewohnte damals ein Volk, Turduler oder Turdetaner genannt.“"
                                            },
                                            {
                                                "example_id": "5106e5a8-905f-4f31-82ae-330029dffb5e",
                                                "sense_id": "10df3fcc-d924-378a-befc-26d434b6411e",
                                                "text": "„Um 1500 bewohnten rund tausend kleine Völker das heutige Staatsgebiet.“"
                                            },
                                            {
                                                "example_id": "a5a23a6b-71ba-4bbd-921d-b1e6400843d1",
                                                "sense_id": "10df3fcc-d924-378a-befc-26d434b6411e",
                                                "text": "„In dem Land zwischen Victoriasee und Indischem Ozean, mehr als zweimal so groß wie das Vereinigte Königreich, gibt es fruchtbare Böden, auf denen Völker wie die Kikuyu, Kamba oder Massai seit Jahrhunderten Ackerbau und Viehzucht betreiben.“"
                                            },
                                            {
                                                "example_id": "76fb58d8-b42b-4f8c-8a00-df0736827096",
                                                "sense_id": "10df3fcc-d924-378a-befc-26d434b6411e",
                                                "text": "„Die Streitkräfte von zwölf Völkern mit verschiedener Muttersprache sind in Russland eingedrungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "afb15a29-856a-3adc-9ded-5451fa85a937",
                                        "entry_id": "11d35e6f-e7ba-3bea-9786-ced84d0f9afa",
                                        "glosses": [
                                            "die unteren und mittleren Schichten der Bevölkerung"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6abfec4c-ebd3-47ab-917c-2c864135c5b7",
                                                "sense_id": "afb15a29-856a-3adc-9ded-5451fa85a937",
                                                "text": "Nicht die höheren Schichten der Bevölkerung, sondern das normale Volk wurde getroffen."
                                            },
                                            {
                                                "example_id": "3d60bc35-6802-4e18-9d85-0b73f1f7730c",
                                                "sense_id": "afb15a29-856a-3adc-9ded-5451fa85a937",
                                                "text": "„Sie wird durch die Inflation ihre Schulden los; daß sie gleichzeitig das Volk verliert, sieht niemand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ac067c32-f347-3bac-b71c-c4dd5bd17119",
                                        "entry_id": "11d35e6f-e7ba-3bea-9786-ced84d0f9afa",
                                        "glosses": [
                                            "Leute desselben Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db694765-8478-4467-a14e-0291d8ccf1bf",
                                                "sense_id": "ac067c32-f347-3bac-b71c-c4dd5bd17119",
                                                "text": "Das Belgische Volk hat mehr als eine Landessprache."
                                            },
                                            {
                                                "example_id": "a99f48fc-ded9-4af0-8809-574cd53d4d03",
                                                "sense_id": "ac067c32-f347-3bac-b71c-c4dd5bd17119",
                                                "text": "„Wir hätten das Volk früher über die wahren Machtverhältnisse in Deutschland aufklären müssen, daß wir es nicht taten, war unsere Schuld.“"
                                            },
                                            {
                                                "example_id": "9b99affc-f25c-43db-93c9-e2f1e6aefb80",
                                                "sense_id": "ac067c32-f347-3bac-b71c-c4dd5bd17119",
                                                "text": "„Das Volk des Pharaos behielt also die Gesundheit im Auge; sie war den Ägyptern so teuer wie ihr Augapfel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "208891af-82b5-315d-932c-435f017fc214",
                                        "entry_id": "11d35e6f-e7ba-3bea-9786-ced84d0f9afa",
                                        "glosses": [
                                            "zusammenlebende Gruppe gleichartiger Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f6de9aa-d24f-40c5-8687-27b575165b69",
                                                "sense_id": "208891af-82b5-315d-932c-435f017fc214",
                                                "text": "„Das Volk der Gräser“ ist ein Dokumentarfilm über Insekten."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42f85554-70cd-46ae-9346-62c1dd78c7d1",
                        "source_entry_id": "9bc32e1b-4fb2-3ff7-b4d0-ba10829297dd",
                        "source_sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                        "target_lang_word": "Menschenmasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenmasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ccbbac5-2411-3dfb-8b00-e57a2d24aeb4",
                                        "entry_id": "a0458e90-6085-3b72-9398-70aa0cde4ca4",
                                        "glosses": [
                                            "sehr große, anonyme Menge von Menschen auf relativ engem Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94562c39-774b-47f0-817f-1e11c4931f30",
                                                "sense_id": "1ccbbac5-2411-3dfb-8b00-e57a2d24aeb4",
                                                "text": "Nach Ende des Spieles strömte die Menschenmasse aus dem Stadion."
                                            },
                                            {
                                                "example_id": "14891769-0f84-414e-a2c0-b4635c72d56e",
                                                "sense_id": "1ccbbac5-2411-3dfb-8b00-e57a2d24aeb4",
                                                "text": "„Ich hatte Angst vor Menschenmassen, aber ausgerechnet hier, in diesem entfesselten, mir fremden Getümmel, spürte ich sie nicht.“"
                                            },
                                            {
                                                "example_id": "d7ccd37f-8498-4f58-ba92-0db7e9c6336e",
                                                "sense_id": "1ccbbac5-2411-3dfb-8b00-e57a2d24aeb4",
                                                "text": "„Große Menschenmassen waren in Bewegung: Fremdarbeiter, Soldaten, Flüchtlinge.“"
                                            },
                                            {
                                                "example_id": "0e8d95e8-ffeb-4ade-9ae2-1f7316ca86b7",
                                                "sense_id": "1ccbbac5-2411-3dfb-8b00-e57a2d24aeb4",
                                                "text": "„Tagsüber ist es hier ziemlich voll, aber morgens und abends halten sich die Menschenmassen in Grenzen.“"
                                            },
                                            {
                                                "example_id": "5756fbd4-357f-466d-8a3d-1006bd077d20",
                                                "sense_id": "1ccbbac5-2411-3dfb-8b00-e57a2d24aeb4",
                                                "text": "„Dazu muss man sich Menschenmassen vorstellen, die die Giraffe berühren wollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e09c28c3-66f3-460a-a1ef-01102f485443",
                        "source_entry_id": "9bc32e1b-4fb2-3ff7-b4d0-ba10829297dd",
                        "source_sense_id": "b6ab2459-1ef6-349b-b7f1-be79aa193f09",
                        "target_lang_word": "Menschenmenge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenmenge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                        "entry_id": "6daf9fb7-d188-32ae-8238-c0cceb0ebad9",
                                        "glosses": [
                                            "größere Ansammlung von Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26e0550b-14ce-498a-9e84-8fbcb9cd6a2a",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "Zur Kundgebung fand sich eine große Menschenmenge ein."
                                            },
                                            {
                                                "example_id": "812de76e-e2a0-4b6e-a32a-0fcb50692ce5",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Plötzlich wurde das Bolzenschloß des Gittertors, das in die Zelle führte, aufgesperrt und wir befanden uns im Innern, wurden von der Menschenmenge verschluckt.“"
                                            },
                                            {
                                                "example_id": "5c699a40-1159-477c-b3e6-b4ef474aa0e2",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Offenen Mundes bestaunte er die schönen Häuser und Kirchen von Nantes wie auch die Menschenmenge und die Kleider der Damen.“"
                                            },
                                            {
                                                "example_id": "056c9c58-b086-4d34-8e8b-e76741b08779",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Noch ein letzter Blick, ein Winken, und die Vohryzeks verschwinden in der Menschenmenge.“"
                                            },
                                            {
                                                "example_id": "3e0dd094-cab5-43f6-9c1e-8dc69ab335b9",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Eine große Menschenmenge drängte in die Kirche.“"
                                            },
                                            {
                                                "example_id": "2f50dfcc-e7f1-42b0-82b7-ea1811377486",
                                                "sense_id": "23a7748a-f322-313a-847d-6d27687b1fa4",
                                                "text": "„Die Menschenmenge schwoll auf etwa 30 000 an, von denen sich 7000 zu einem Protestmarsch formierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
