                ],
                "senses": [
                    {
                        "sense_id": "920fd0ab-629b-300e-b217-b512d0ce54d8",
                        "entry_id": "12158851-7cd0-35c2-92bc-fc4f96c1263b",
                        "glosses": [
                            "техн. устройство для защиты от ударных нагрузок, сотрясений в различного рода машинах (автомобилях, самолетах, локомотивах и пр.), а также для гашения колебаний и смягчения ударов сооружений использующее в качестве основных элементов пружины, торсионы, упругие неметаллические элементы, а также жидкости и газы"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2be4a570-b225-30f6-aef4-34bebab9c794",
                        "entry_id": "12158851-7cd0-35c2-92bc-fc4f96c1263b",
                        "glosses": [
                            "перен. о том, что смягчает нагрузку, давление, помогает справиться с трудностями"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d16f2c62-e3e7-49fa-92f0-4c7c57d38f75",
                        "source_entry_id": "12158851-7cd0-35c2-92bc-fc4f96c1263b",
                        "target_lang_word": "shock absorber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shock absorber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "806c5776-6be9-3e09-aed6-3f75eef0e22f",
                                        "entry_id": "4b1f5b0c-af04-375b-a081-e073813e95ba",
                                        "glosses": [
                                            "A mechanical device designed to smooth out or damp any sudden shock impulse and dissipate kinetic energy; usually consists of a combination of a spring and a dashpot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899fe391-9a04-4364-abdb-0ba0c12c4096",
                                                "sense_id": "806c5776-6be9-3e09-aed6-3f75eef0e22f",
                                                "text": "Hydraulic shock absorbers are used to damp out vertical and lateral oscillations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5aad87ff-8743-4331-9087-e7fa721d6a78",
                        "source_entry_id": "12158851-7cd0-35c2-92bc-fc4f96c1263b",
                        "target_lang_word": "amortisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amortisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ffa03f2-1476-31e3-94ab-08d3b9235db8",
                                        "entry_id": "10a1c45e-cf40-3c22-87c7-88f7e631a6fc",
                                        "glosses": [
                                            "Dispositif mécanique, électrique, hydraulique ou pneumatique destiné à atténuer des chocs, des vibrations, un bruit, etc."
                                        ],
                                        "tags": [
                                            "Tous domaines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "654b5f04-37f9-46a1-a063-e1d2140d5050",
                                                "sense_id": "5ffa03f2-1476-31e3-94ab-08d3b9235db8",
                                                "text": "On peut sortir de ces situations délicates en installant un amortisseur dynamique, appelé aussi absorbeur dynamique, batteur ou damper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26eff0b4-a310-3829-bd3d-2eb1ec75de54",
                                        "entry_id": "10a1c45e-cf40-3c22-87c7-88f7e631a6fc",
                                        "glosses": [
                                            "Ensemble des organes qui servent, sur un véhicule (voiture, camion, moto, bicyclette, etc.) à amortir les chocs et à améliorer la tenue de route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "192a3363-fe78-42fc-be20-a225ac00ce4d",
                                                "sense_id": "26eff0b4-a310-3829-bd3d-2eb1ec75de54",
                                                "text": "Les amortisseurs de cette voiture sont en mauvais état."
                                            },
                                            {
                                                "example_id": "64ab0e2a-a035-450b-bb65-f2aa595f043d",
                                                "sense_id": "26eff0b4-a310-3829-bd3d-2eb1ec75de54",
                                                "text": "Les premiers amortisseurs apparurent sur les bicyclettes en 1990."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
