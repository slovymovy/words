                        "buveur de thé"
                    ]
                },
                {
                    "sense_id": "f9c98576-37d3-3709-9281-03db8b79a7eb",
                    "sense_definition": "Personne qui a un penchant marqué pour les boissons alcoolisées ou qui boit avec excès.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alcool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux <w>buveur</w> passait la plupart de ses soirées accoudé au comptoir du café."
                        },
                        {
                            "text": "Mon oncle est un grand <w>buveur</w> qui apprécie particulièrement les vins de sa région."
                        }
                    ],
                    "synonyms": [
