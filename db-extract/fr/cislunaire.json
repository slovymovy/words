                        "glosses": [
                            "Qui se situe entre la Terre et la Lune, qui ne va pas au-delà de l’orbite lunaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11fa5184-4899-47cf-b681-5f5573355f53",
                                "sense_id": "9b9c04a3-46f9-31bf-9d91-dd15cb7c8a4d",
                                "text": "Les deux véhicules, placés sur trajectoire cislunaire, étaient alors solidement accrochés l’un à l’autre."
                            },
                            {
                                "example_id": "c979e850-154f-41b9-954b-8ce76f678959",
                                "sense_id": "9b9c04a3-46f9-31bf-9d91-dd15cb7c8a4d",
                                "text": "Cette démarche inédite permettra ainsi d’optimiser les conditions d’accueil et de vie des futurs usagers de l’habitat cislunaire international."
                            }
                        ]
                    }
