{
    "word_family": [
        "beznadziejny",
        "beznadzieja",
        "beznadziejność"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b838f6c6-7b63-3742-9ec0-227be6a0a6e6",
                    "sense_definition": "Uczucie oczekiwania na to, że wydarzy się coś pożądanego; ufność w pomyślny rezultat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hope_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam wielką <w>nadzieję</w>, że jutro będzie słoneczna pogoda.",
                            "target_lang_translations": {
                                "ru": "Я очень <w>надеюсь</w>, что завтра будет солнечная погода.",
                                "en": "I have great <w>hope</w> that the weather will be sunny tomorrow."
                            }
                        },
                        {
                            "text": "Jego słowa obudziły w niej <w>nadzieję</w> na lepszą przyszłość.",
                            "target_lang_translations": {
                                "ru": "Его слова пробудили в ней <w>надежду</w> на лучшее будущее.",
                                "en": "His words awakened in her <w>hope</w> for a better future."
                            }
                        }
                    ],
                    "synonyms": [
                        "otucha",
                        "wiara",
                        "ufność"
                    ],
                    "antonyms": [
                        "rezygnacja",
                        "zwątpienie",
                        "beznadzieja"
                    ],
                    "common_phrases": [
                        "mieć nadzieję",
                        "stracić nadzieję",
                        "promyk nadziei",
                        "wbrew nadziei",
                        "robić sobie nadzieję"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство ожидания чего-то желаемого; уверенность в благоприятном исходе.",
                        "en": "The feeling of trust, confidence, or expectation that something desired will happen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надежда",
                                "target_lang_sense_clarification": "чувство"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "hope",
                                "target_lang_sense_clarification": "the feeling of expectation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b09375fb-3db4-3ac2-b937-1a7e3fb35d6d",
                    "sense_definition": "Osoba, rzecz lub sytuacja, z którą wiąże się oczekiwania na pomyślny obrót spraw.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hope_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten nowy lek to ostatnia <w>nadzieja</w> dla ciężko chorych pacjentów.",
                            "target_lang_translations": {
                                "ru": "Это новое лекарство — последняя <w>надежда</w> для тяжелобольных пациентов.",
                                "en": "This new medicine is the last <w>hope</w> for critically ill patients."
                            }
                        },
                        {
                            "text": "Naszą <w>nadzieją</w> na rozwój firmy są młodzi i zdolni pracownicy.",
                            "target_lang_translations": {
                                "ru": "Нашей <w>надеждой</w> на развитие компании являются молодые и способные сотрудники.",
                                "en": "Our <w>hope</w> for the company's development lies in young and talented employees."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jedyna nadzieja",
                        "ostatnia nadzieja",
                        "pokładać nadzieję"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, вещь или ситуация, с которыми связаны ожидания благоприятного исхода.",
                        "en": "A person, thing, or situation that is a source of expectation for a positive outcome."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надежда",
                                "target_lang_sense_clarification": "опора"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "hope",
                                "target_lang_sense_clarification": "a source of expectation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17bbc71c-ebb7-360e-aae1-e7270624e21f",
                    "sense_definition": "Opinia, sąd lub zdanie na jakiś temat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opinion_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Według mojej <w>nadziei</w>, sprawa ta zakończy się pomyślnie dla wszystkich.",
                            "target_lang_translations": {
                                "ru": "По моему <w>мнению</w>, это дело закончится благополучно для всех.",
                                "en": "In my <w>view</w>, this matter will end successfully for everyone."
                            }
                        },
                        {
                            "text": "Wyraził swoją <w>nadzieję</w> w tej kwestii, nie zważając na sprzeciw innych.",
                            "target_lang_translations": {
                                "ru": "Он выразил свое <w>мнение</w> по этому вопросу, не обращая внимания на возражения других.",
                                "en": "He expressed his <w>opinion</w> on this matter, regardless of the opposition of others."
                            }
                        }
                    ],
                    "synonyms": [
                        "opinia",
                        "sąd",
                        "zdanie"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "współcześnie rzadko używane w tym znaczeniu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мнение, суждение или взгляд на какую-либо тему.",
                        "en": "An opinion, judgment, or view on a particular subject."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мнение",
                                "target_lang_sense_clarification": "взгляд"
                            },
                            {
                                "target_lang_word": "суждение",
                                "target_lang_sense_clarification": "точка зрения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "opinion",
                                "target_lang_sense_clarification": "a view or judgment"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "a personal perspective"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "14fcff1f-736f-3195-84e3-9e4b0f21c5c0",
                    "sense_definition": "Żeńskie imię własne.",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "name_entity",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Moja przyjaciółka <w>Nadzieja</w> mieszka w bloku obok.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Надежда</w> живет в соседнем доме.",
                                "en": "My friend <w>Hope</w> lives in the building next door."
                            }
                        },
                        {
                            "text": "Wszystkie <w>Nadzieje</w> obchodzą swoje imieniny we wrześniu.",
                            "target_lang_translations": {
                                "ru": "Все <w>Надежды</w> отмечают свои именины в сентябре.",
                                "en": "All people named <w>Hope</w> celebrate their name day in September."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "en": "A female given name."
                    },
                    "translations": {
