                                    {
                                        "sense_id": "d042d0ab-fea6-3bdd-8cce-1ae2b20ee6ac",
                                        "entry_id": "8e247446-e7af-3339-936e-3707cb14f2da",
                                        "glosses": [
                                            "having or maintaining a consistent temperature"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d41522b-f0aa-4111-a01c-032ffa1e3906",
                                                "sense_id": "d042d0ab-fea6-3bdd-8cce-1ae2b20ee6ac",
                                                "text": "The shower has a thermostatic water-mixing valve."
                                            },
                                            {
                                                "example_id": "12b49483-2608-4453-b399-5c8cac062d64",
                                                "sense_id": "d042d0ab-fea6-3bdd-8cce-1ae2b20ee6ac",
                                                "text": "Another source of discontent with the Phase I stock has been obviated by relocation of the interior heating elements and the introduction of thermostatic control; this has eradicated the searing blasts of hot air passengers used to feel about their calves [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dac324cc-d56b-3566-8864-d5ed8b12dd48",
                                        "entry_id": "8e247446-e7af-3339-936e-3707cb14f2da",
                                        "glosses": [
                                            "Relating to thermostasis"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27ba97b5-6f65-32f8-be07-89c33199aaf5",
                                        "entry_id": "8e247446-e7af-3339-936e-3707cb14f2da",
                                        "glosses": [
                                            "Reacting to change by attempting to move in the opposite direction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2237b2d-7fb3-4def-8c3e-5eb705a6d571",
                                                "sense_id": "27ba97b5-6f65-32f8-be07-89c33199aaf5",
                                                "text": "Most importantly, Wlezien's results revealed thermostatic responsiveness. That is, when spending increases (decreases), the public's support for more spending decreases (increases), other things being equal."
                                            }
                                        ]
                                    }
                                ]
