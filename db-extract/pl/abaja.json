                "senses": [
                    {
                        "sense_id": "4dbd2a27-4f2b-3975-8e92-28217310a4e5",
                        "entry_id": "bd9bbade-a81a-314a-8558-de25039793e5",
                        "glosses": [
                            "aba, abaya"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ac9b4e38-ea7d-44c6-8c02-1a3b692b6f98",
                                "sense_id": "4dbd2a27-4f2b-3975-8e92-28217310a4e5",
                                "text": "Jeśli chodzi o strój to początkowo ograniczony był do czarnej abaji i chusty, […]",
                                "translation": "When it comes to the outfite then initially he was limited to a black abaya and a headscarf, […]",
                                "english": "When it comes to the outfite then initially he was limited to a black abaya and a headscarf, […]"
                            },
                            {
                                "example_id": "5a09c19d-d07e-4bbb-aa75-2ca9879127da",
                                "sense_id": "4dbd2a27-4f2b-3975-8e92-28217310a4e5",
                                "text": "Często pod abają kobiety noszą markową odzież uznanych kreatorów mody, którą ze względów obyczajowych na leży ^([sic]) zakryć.",
                                "translation": "Women often wear brand clothes recognized by fashion designers under an abaya, that they need to cover due to custom reasons.",
                                "english": "Women often wear brand clothes recognized by fashion designers under an abaya, that they need to cover due to custom reasons."
                            },
                            {
                                "example_id": "f498ae0d-1e53-441f-af25-4edf33c3baee",
                                "sense_id": "4dbd2a27-4f2b-3975-8e92-28217310a4e5",
                                "text": "Evelyn Cobbold nie ubiera się do zdjęcia w męską abaję, ale nadal jest traktowana raczej jak mężczyzna niż jak kobieta.",
                                "translation": "Evelyn Cobbold does not dress up for the picture in a men's abaya, but is still treated more like a man than a woman.",
                                "english": "Evelyn Cobbold does not dress up for the picture in a men's abaya, but is still treated more like a man than a woman."
                            }
                        ]
                    }
