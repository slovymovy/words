                "senses": [
                    {
                        "sense_id": "20f83fa7-1044-341b-9e65-e1bce527373f",
                        "entry_id": "69b3bba5-e15a-3cb6-af49-a885926bf0ed",
                        "glosses": [
                            "Quelltyp, dessen Austritt an einer Mulde liegt und dort ein Stillgewässer bildet, bevor dieses abfließt"
                        ],
                        "tags": [
                            "Hydrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "656a7974-ad01-4810-89ac-1ab417128835",
                                "sense_id": "20f83fa7-1044-341b-9e65-e1bce527373f",
                                "text": "„Bei einer beckenartigen Quellaustrittsstelle spricht man von einer Tümpelquelle (Limnokrene).“"
                            },
                            {
                                "example_id": "8c7fbc6a-7b9b-4dbc-a819-16f15a38a14a",
                                "sense_id": "20f83fa7-1044-341b-9e65-e1bce527373f",
                                "text": "„Bei der Limnokrene oder Tümpelquelle tritt das Wasser am Grunde oder Rande einer Mulde an die Oberfläche und bildet einen Quelltümpel (vergleiche THIENEMANN 1924).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
