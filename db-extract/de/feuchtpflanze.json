                "senses": [
                    {
                        "sense_id": "ec75a40f-ab49-3a93-bae7-5db9c43739c0",
                        "entry_id": "45f7380e-439d-3e81-b251-01f076b952b9",
                        "glosses": [
                            "Pflanze, die an sehr feuchte Standorte angepasst ist, vornehmlich oder ausschließlich dort vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d5c639d-4422-4cac-b7a7-25bee17f907e",
                                "sense_id": "ec75a40f-ab49-3a93-bae7-5db9c43739c0",
                                "text": "„Eine Stunde reicht aus, um einen See zu umrunden, ein Biotop für seltene Ried- und Feuchtpflanzen am Ufer und unzähligen Seeroseninseln auf seinem Wasserspiegel.“"
                            },
                            {
                                "example_id": "da09c049-ef48-4549-9f31-6ce569b258b7",
                                "sense_id": "ec75a40f-ab49-3a93-bae7-5db9c43739c0",
                                "text": "„Eine Sickermulde bietet auch in Gärten ohne Teich einen Standort für Feuchtpflanzen wie Mädesüß (Filipendula ulmaria), Blutweiderich (Lythrum salicaria) und Wasserdost (Eupatorium cannabium).“"
                            },
                            {
                                "example_id": "cc31ad3a-f8ce-478a-89c2-097d3eb29591",
                                "sense_id": "ec75a40f-ab49-3a93-bae7-5db9c43739c0",
                                "text": "„Flechten, Gräser, Farne, rankende Feuchtpflanzen in allen Grünschattierungen und feine Luftwurzeln ziehen sich über die rauen, von dünnen Rinnsalen zerfurchten Kalksteinwände.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
