                                "example_id": "286e869e-259e-4e45-bc3d-b98d630fd168",
                                "sense_id": "3656792e-56e2-3e3a-8bd6-a520251cecda",
                                "text": "Hij volgt een studie over astrologie, zijn grootste hobby."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc0c0408-379d-4333-91e3-688f9d69783e",
                        "source_entry_id": "a6a532a9-143e-354d-9389-b12fd13a0e90",
                        "source_sense_id": "3656792e-56e2-3e3a-8bd6-a520251cecda",
                        "source_sense_description": "de leer die gebeurtenissen aan het hemelgewelf in verband brengt met gebeurtenissen op aarde",
                        "target_lang_word": "astrology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34cd384e-01e0-3b56-ae4a-d4ab931038eb",
                                        "entry_id": "1666a2e1-bde2-3207-a354-e37af10469c2",
                                        "glosses": [
                                            "Divination about human affairs or natural phenomena from the relative positions of celestial bodies."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab5fc069-3ae8-4235-b923-b6bc5da871ea",
                                                "sense_id": "34cd384e-01e0-3b56-ae4a-d4ab931038eb",
                                                "text": "For if astronomy is the study of the movements of the heavens, then astrology is the study of the effects of those movements."
                                            },
                                            {
                                                "example_id": "1c212fa5-7c94-4c37-b8e1-3d51469e084e",
                                                "sense_id": "34cd384e-01e0-3b56-ae4a-d4ab931038eb",
                                                "text": "Followers of pseudosciences such as astrology often draw spurious parallels between their beliefs and established science."
                                            },
                                            {
                                                "example_id": "60e37791-f6f9-4b73-802b-c56e9643e52f",
                                                "sense_id": "34cd384e-01e0-3b56-ae4a-d4ab931038eb",
                                                "text": "In some ways, astrology is perfectly suited for the internet age. There’s a low barrier to entry, and nearly endless depths to plumb if you feel like falling down a Google research hole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
