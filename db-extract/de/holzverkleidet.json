                                "example_id": "2d6f0220-6ee3-44c3-b28c-5acdcef954ac",
                                "sense_id": "8c25889e-9c8f-3f1a-98c2-0d86406cb55e",
                                "text": "„Das große holzverkleidete Haus stand ungefähr eine halbe Meile östlich der Straße.“"
                            }
