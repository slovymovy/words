                "senses": [
                    {
                        "sense_id": "8670ecf3-68f4-371f-b187-cb8dd7d13a46",
                        "entry_id": "15ee899d-3f9b-38f0-9948-8afcee2f83e5",
                        "glosses": [
                            "уменьш.-ласк. к кошка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e91ad3-04e7-4d44-8184-9560974118c8",
                                "sense_id": "8670ecf3-68f4-371f-b187-cb8dd7d13a46",
                                "text": "Чёрная кошечка Брыска ласкается и мягко мурлычет, но не трогают Оленьку эти кошачьи ласки."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba37f1c1-8e83-3fc5-87e4-bbc4b7aee017",
                        "entry_id": "15ee899d-3f9b-38f0-9948-8afcee2f83e5",
                        "glosses": [
                            "перен., разг., ласк. женщина, девушка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "224fd880-0805-4b3f-8f18-0b38021f3215",
                                "sense_id": "ba37f1c1-8e83-3fc5-87e4-bbc4b7aee017",
                                "text": "«Соня?» подумала она, глядя на спящую, свернувшуюся кошечку с её огромной косой."
                            }
                        ]
                    }
