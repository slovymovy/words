                    {
                        "sense_id": "6de3b575-2850-346d-9691-4d6e29c0da27",
                        "entry_id": "d1742814-c9f8-3d74-89b7-e09f59f0d37d",
                        "glosses": [
                            "an die Alpen grenzendes Hochland"
                        ],
                        "tags": [
                            "singular",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c97af2e3-02f2-436c-8bcc-73dd955fd696",
                                "sense_id": "6de3b575-2850-346d-9691-4d6e29c0da27",
                                "text": "„Heftige Unwetter mit Dauerregen haben in Bayern Überschwemmungen ausgelöst. Im Alpenvorland traten Bäche und Flüsse über die Ufer, im Kreis Traunstein wurde Katastrophenalarm ausgerufen.“"
                            },
                            {
                                "example_id": "aee1e7f8-3d1c-474b-9b2b-55981e7d00eb",
                                "sense_id": "6de3b575-2850-346d-9691-4d6e29c0da27",
                                "text": "„Als die Römer 65 Jahre später das Alpenvorland eroberten, war Manching eine Geisterstadt, umgeben von den Ruinen einer gewaltigen Mauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
