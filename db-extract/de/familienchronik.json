                ],
                "senses": [
                    {
                        "sense_id": "b95bf2d3-65bd-3034-82a5-a9aff5eca108",
                        "entry_id": "061621f2-9416-304d-bd3a-78f1cf89aabc",
                        "glosses": [
                            "Darstellung der Entwicklung einer Familie in zeitlicher Reihenfolge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a404443f-1d54-49a0-bdbc-36413ba6321f",
                                "sense_id": "b95bf2d3-65bd-3034-82a5-a9aff5eca108",
                                "text": "„Stadtphysikus Adolf Ruhstrat (1801-1874) begründete die Rustrat-Dynastie und hatte laut Familienchronik als Arzt das Dorf Geismar zu betreuen.“"
                            },
                            {
                                "example_id": "163194dc-2a2f-4c58-8e0c-45ce0a8f624f",
                                "sense_id": "b95bf2d3-65bd-3034-82a5-a9aff5eca108",
                                "text": "„So wurde aus der grünen Kladde im Laufe eines Vierteljahrhunderts ein kleines Ostpreußen-Kompendium, das sich zwischen gestern und heute bewegt, zwischen erlebter und geschriebener Geschichte, zwischen Familienchronik, Reportage und politischem Essay.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
