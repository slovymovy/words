                                        "sense_id": "fcca8381-1109-30c0-b953-ce5e99e1e9e2",
                                        "entry_id": "56742869-d362-31b2-9df2-7540fbf2f90d",
                                        "glosses": [
                                            "The state or quality of being snug."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
