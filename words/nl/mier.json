    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a9d0ddb-829f-35f4-9ca6-005ec0bff6c0",
                    "sense_definition": "Een klein, kruipend insect dat in grote, georganiseerde kolonies leeft.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "insecten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er loopt een kleine <w>mier</w> over de keukentafel.",
                            "target_lang_translations": {
                                "en": "There is a small <w>ant</w> walking across the kitchen table."
                            }
                        },
                        {
                            "text": "In het bos zagen we een grote hoop gebouwd door een <w>mier</w>.",
                            "target_lang_translations": {
                                "en": "In the forest, we saw a large mound built by an <w>ant</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zo vlijtig als een mier"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, crawling insect that lives in large, organized colonies."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ant",
                                "target_lang_sense_clarification": "the insect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9383539-24c1-36cd-9156-c388185871e3",
                    "sense_definition": "Een onbeduidend of onbelangrijk persoon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeleken met de machtige directeur voelde hij zich slechts een kleine <w>mier</w>.",
                            "target_lang_translations": {
                                "en": "Compared to the powerful director, he felt like just a tiny <w>ant</w>."
                            }
                        },
                        {
                            "text": "De dictator behandelde de gewone burgers als een <w>mier</w> die je zomaar kon vertrappen.",
                            "target_lang_translations": {
                                "en": "The dictator treated ordinary citizens like an <w>ant</w> you could just trample on."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Figurative use to describe insignificance"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An insignificant or unimportant person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ant",
                                "target_lang_sense_clarification": "figurative, referring to an insignificant person"
                            },
                            {
                                "target_lang_word": "nobody",
                                "target_lang_sense_clarification": "an unimportant person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f8790a3-f490-35b8-80e9-810505442795",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>mieren</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>mier</w> al de hele middag met deze kapotte computer.",
                            "target_lang_translations": {
                                "en": "I have been <w>messing around</w> with this broken computer all afternoon."
                            }
                        },
                        {
                            "text": "Als ik zo doorga met dat geklungel, <w>mier</w> ik morgen nog.",
                            "target_lang_translations": {
                                "en": "If I keep fumbling like this, I will still be <w>fussing</w> tomorrow."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'mieren' (to fuss, to mess around, to nitpick)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mess around",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            },
                            {
                                "target_lang_word": "fuss",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0992efa2-4e62-3643-a807-6ecf924f2410",
                    "sense_definition": "Gebiedende wijs van <w>mieren</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Mier</w> niet zo met die details en werk eens door!",
                            "target_lang_translations": {
