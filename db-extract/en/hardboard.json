                        ],
                        "examples": [
                            {
                                "example_id": "3b2b0b00-1b02-4303-984e-95a75e330186",
                                "sense_id": "b0803c9c-bfc5-333c-9eb9-274c3dfb6cbd",
                                "text": "The compartment ceiling panels are of plastic material backed with ply or hardboard panels."
                            },
                            {
                                "example_id": "81b9d4fa-7c7a-4a9c-a344-c5891f761264",
                                "sense_id": "b0803c9c-bfc5-333c-9eb9-274c3dfb6cbd",
                                "text": "For convenience and versatility, no mass-produced wood paneling can beat hardboard—a tough, pliable, water-resistant material made from wood fibers."
                            }
                        ]
                    }
                ],
