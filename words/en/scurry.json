{
    "word_family": [
        "scurrier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "229b5e67-2ed2-36d0-80c8-fa46ba96aafb",
                    "sense_definition": "To move quickly with short, light steps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened mouse began to <w>scurry</w> across the kitchen floor.",
                            "target_lang_translations": {
                                "zh": "受惊的老鼠开始在厨房地板上<w>碎步跑</w>过。",
                                "ru": "Испуганная мышь начала <w>семенить</w> по кухонному полу."
                            }
                        },
                        {
                            "text": "Children <w>scurry</w> about the playground during their short break.",
                            "target_lang_translations": {
                                "zh": "课间休息时，孩子们在操场上<w>疾走</w>。",
                                "ru": "Во время короткой перемены дети <w>носятся</w> по игровой площадке."
                            }
                        }
                    ],
                    "synonyms": [
                        "scamper",
                        "hurry",
                        "rush"
                    ],
                    "common_phrases": [
                        "scurry away",
                        "scurry about"
                    ],
                    "target_lang_definitions": {
                        "zh": "指小步快速地移动。",
                        "ru": "Передвигаться быстро, мелкими и легкими шагами."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "碎步跑",
                                "target_lang_sense_clarification": "形容动作轻快、急促的奔跑。"
                            },
                            {
                                "target_lang_word": "疾走",
                                "target_lang_sense_clarification": "指快速地行走或奔跑。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "семенить",
                                "target_lang_sense_clarification": "идти или бежать мелкими, частыми шагами."
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "быстро, стремительно передвигаться."
                            },
                            {
                                "target_lang_word": "бежать",
                                "target_lang_sense_clarification": "передвигаться быстрым шагом или бегом."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e0153c4-51f1-32c9-8486-e0300f88263c",
                    "sense_definition": "A short, quick dash or run.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a brief <w>scurry</w> through the woods, the fox disappeared from sight.",
                            "target_lang_translations": {
                                "zh": "在树林里一阵<w>疾跑</w>后，狐狸消失在视野中。",
                                "ru": "После короткой <w>перебежки</w> через лес лиса скрылась из виду."
                            }
                        },
                        {
                            "text": "The sudden <w>scurry</w> of the squirrels startled the hikers on the path.",
                            "target_lang_translations": {
                                "zh": "松鼠突然的<w>疾跑</w>惊吓到了小路上的徒步旅行者。",
                                "ru": "Внезапная <w>беготня</w> белок напугала туристов на тропе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指短促、快速的奔跑或冲刺。",
                        "ru": "Короткий, быстрый рывок или пробежка."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "疾跑",
                                "target_lang_sense_clarification": "指快速的奔跑动作。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перебежка",
                                "target_lang_sense_clarification": "короткое, быстрое перемещение с одного места на другое."
                            },
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое, быстрое движение."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a1a48512-5e6d-3286-9bf7-e8b908673569",
                    "sense_definition": "A family name of Irish origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian researched the genealogy of the <w>Scurry</w> family.",
                            "target_lang_translations": {
                                "zh": "历史学家研究了<w>斯卡里</w>家族的族谱。",
                                "ru": "Историк исследовал генеалогию семьи <w>Скарри</w>."
                            }
                        },
                        {
                            "text": "Many people named <w>Scurry</w> can trace their roots back to Ireland.",
                            "target_lang_translations": {
                                "zh": "许多姓<w>斯卡里</w>的人可以追溯到爱尔兰的祖先。",
                                "ru": "Многие люди по фамилии <w>Скарри</w> могут проследить свои корни до Ирландии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "源自爱尔兰的姓氏。",
                        "ru": "Фамилия ирландского происхождения."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯卡里",
                                "target_lang_sense_clarification": "用于音译该姓氏。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Скарри",
                                "target_lang_sense_clarification": "транслитерация фамилии."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b45c9c76-df9f-319a-8fd0-aeb06a70ed15",
                    "sense_definition": "A small town located in Kaufman County, Texas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to stop for lunch while driving through <w>Scurry</w>.",
                            "target_lang_translations": {
                                "zh": "他们决定在开车经过<w>斯卡里</w>时停下来吃午饭。",
                                "ru": "Они решили остановиться на обед, проезжая через <w>Скарри</w>."
                            }
                        },
                        {
                            "text": "The rural community of <w>Scurry</w> is situated in Texas.",
                            "target_lang_translations": {
                                "zh": "<w>斯卡里</w>乡村社区位于德克萨斯州。",
                                "ru": "Сельская община <w>Скарри</w> расположена в Техасе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于美国德克萨斯州考夫曼县的一个小镇。",
                        "ru": "Небольшой город в округе Кауфман, штат Техас, США."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯卡里",
                                "target_lang_sense_clarification": "用于音译该地名。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Скарри",
                                "target_lang_sense_clarification": "транслитерация названия населенного пункта."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}