                                "target_senses": [
                                    {
                                        "sense_id": "bfea3520-d984-3980-a901-7b852940daac",
                                        "entry_id": "fc796876-9510-3728-8480-d332cd7512c0",
                                        "glosses": [
                                            "zur Ruhe bringen; ruhig machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95f15673-20e2-4baf-b756-8d03cf04fefd",
                                                "sense_id": "bfea3520-d984-3980-a901-7b852940daac",
                                                "text": "Die Polizei konnte den betrunkenen Mann, der wild um sich schlug, nur schwer beruhigen."
                                            },
                                            {
                                                "example_id": "1a53e9da-df86-4971-b3b0-0d9303200823",
                                                "sense_id": "bfea3520-d984-3980-a901-7b852940daac",
                                                "text": "Die Mutter konnte das weinende Kind schnell wieder beruhigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bdd36253-596b-3302-8186-8004b443f23d",
                                        "entry_id": "fc796876-9510-3728-8480-d332cd7512c0",
                                        "glosses": [
                                            "beschwichtigen, die Sorge nehmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54a6b66e-2aa2-4c1a-81ae-fd2c8331bc45",
                                                "sense_id": "bdd36253-596b-3302-8186-8004b443f23d",
                                                "text": "Der Anruf hatte sie ganz und gar nicht beruhigt, im Gegenteil fragte sie sich, wieso ihr Mann ihn anscheinend für nötig gehalten hatte."
                                            },
                                            {
                                                "example_id": "59a54128-0a94-4c26-8e64-623e117da673",
                                                "sense_id": "bdd36253-596b-3302-8186-8004b443f23d",
                                                "text": "Der Pilot sprach ein paar beruhigende Worte."
                                            },
                                            {
                                                "example_id": "145daaa2-04dd-4e7f-b561-8bbaefa65343",
                                                "sense_id": "bdd36253-596b-3302-8186-8004b443f23d",
                                                "text": "„Auch hier sei die kontaminierte Erde abgetragen worden, beruhigt uns der Biologe, und im Übrigen werde jedes Gemüse und Milchprodukt auf Cäsium, Strontium und andere Nuklide gemessen, bevor es in den Handel gelange.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6acea816-61ef-324c-9f7a-2b0bcfe4e4da",
                                        "entry_id": "fc796876-9510-3728-8480-d332cd7512c0",
                                        "glosses": [
                                            "sich emotional wieder normalisieren (nach großer Aufregung oder Wut)"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c391c231-4d2f-49d2-a40b-5fe306cebcdd",
                                                "sense_id": "6acea816-61ef-324c-9f7a-2b0bcfe4e4da",
                                                "text": "Er hat sich endlich wieder beruhigt."
                                            },
                                            {
                                                "example_id": "935bc3eb-8bb7-4cf2-b21a-44f812a49796",
                                                "sense_id": "6acea816-61ef-324c-9f7a-2b0bcfe4e4da",
                                                "text": "Jetzt beruhige dich erst einmal!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a539ac69-efa3-31e0-902b-30eb72ed34b7",
                                        "entry_id": "fc796876-9510-3728-8480-d332cd7512c0",
                                        "glosses": [
                                            "wieder zum Normalzustand zurückkehren"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
