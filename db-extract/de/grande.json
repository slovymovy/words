                "senses": [
                    {
                        "sense_id": "64ff6266-5e6e-3c1f-9dbc-4b1a79be4abf",
                        "entry_id": "2d8f3aed-f18b-3fba-a034-280982e9fe31",
                        "glosses": [
                            "ranghoher spanischer Adeliger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8a520a-cda0-4707-b25c-41b2b7029f95",
                                "sense_id": "64ff6266-5e6e-3c1f-9dbc-4b1a79be4abf",
                                "text": "„Zudem ist der politische Charakter des spanischen Adels gar keiner. Der Grande gesellt sich wenn auch meist der konstitutionellen Partei angehörend, stets jener Fraktion bei, die eben im Vortheil ist […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1a54c871-d57f-3ee6-ac20-f5f5597bf32d",
                        "entry_id": "2d8f3aed-f18b-3fba-a034-280982e9fe31",
                        "glosses": [
                            "hochstehender Vertreter einer Gruppe oder einer Organisation"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "81519ee1-7180-424a-a77f-a1507423fde7",
                                "sense_id": "1a54c871-d57f-3ee6-ac20-f5f5597bf32d",
                                "text": "„Nach dem Krieg wurde der Betrieb der Berliner S-Bahn von der Deutschen Reichsbahn weitergeführt, die sich auf dem Gebiet der DDR bis 1990 übrigens weiterhin so nannte, obschon der Reichsgedanke den Granden der SED außerordentlich suspekt war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
