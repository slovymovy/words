{
    "word_family": [
        "bellyache",
        "bellyful",
        "potbelly",
        "underbelly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a06d6015-9d28-3add-9045-8586b29d4ee0",
                    "sense_definition": "The front part of the human body between the chest and the legs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rubbed his round <w>belly</w> after eating a very large dinner.",
                            "target_lang_translations": {
                                "ru": "Он потёр свой круглый <w>живот</w> после очень плотного ужина.",
                                "zh": "吃了一顿丰盛的晚餐后，他揉了揉圆圆的<w>肚子</w>。"
                            }
                        },
                        {
                            "text": "The little boy has a ticklish <w>belly</w> that makes him laugh.",
                            "target_lang_translations": {
                                "ru": "У маленького мальчика щекотный <w>животик</w>, отчего он смеётся.",
                                "zh": "小男孩的<w>肚子</w>很怕痒，一碰就笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abdomen",
                        "stomach",
                        "tummy",
                        "tum",
                        "midriff"
                    ],
                    "common_phrases": [
                        "beer belly",
                        "belly button",
                        "belly fat",
                        "belly laugh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передняя часть тела человека между грудью и ногами.",
                        "zh": "人体胸部和腿部之间的前部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "нейтральное, анатомическое"
                            },
                            {
                                "target_lang_word": "пузо",
                                "target_lang_sense_clarification": "разговорное, часто о большом животе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肚子",
                                "target_lang_sense_clarification": "通用词，指腹部"
                            },
                            {
                                "target_lang_word": "腹部",
                                "target_lang_sense_clarification": "正式或医学用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65501443-ed52-3536-b79f-b946913ac807",
                    "sense_definition": "The internal organ where food is digested.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>belly</w> started to rumble loudly during the quiet meeting.",
                            "target_lang_translations": {
                                "ru": "Мой <w>живот</w> начал громко урчать во время тихой встречи.",
                                "zh": "在安静的会议中，我的<w>肚子</w>开始大声咕咕叫。"
                            }
                        },
                        {
                            "text": "The hungry wolf filled its <w>belly</w> with the meat it found.",
                            "target_lang_translations": {
                                "ru": "Голодный волк набил своё <w>брюхо</w> найденным мясом.",
                                "zh": "饥饿的狼用找到的肉填饱了<w>肚子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stomach",
                        "tummy",
                        "abdomen"
                    ],
                    "common_phrases": [
                        "empty belly",
                        "full belly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренний орган, в котором переваривается пища.",
                        "zh": "消化食物的内部器官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "общеупотребительное"
                            },
                            {
                                "target_lang_word": "желудок",
                                "target_lang_sense_clarification": "анатомический термин"
                            },
                            {
                                "target_lang_word": "брюхо",
                                "target_lang_sense_clarification": "у животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胃",
                                "target_lang_sense_clarification": "解剖学上的消化器官"
                            },
                            {
                                "target_lang_word": "肚子",
                                "target_lang_sense_clarification": "口语中指代胃部或消化系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f1e8a68-8b1d-3886-963c-0e7bc820fd76",
                    "sense_definition": "The underside, deep interior, or lower surface of an object, such as a ship or aircraft.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "object_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy cargo was loaded deep into the <w>belly</w> of the plane.",
                            "target_lang_translations": {
                                "ru": "Тяжелый груз загрузили глубоко в <w>брюхо</w> самолета.",
                                "zh": "沉重的货物被装进了飞机的<w>腹部</w>深处。"
                            }
                        },
                        {
                            "text": "The pilot was forced to make a dangerous landing on the <w>belly</w> of the aircraft.",
                            "target_lang_translations": {
                                "ru": "Пилот был вынужден совершить опасную посадку на <w>брюхо</w> самолета.",
                                "zh": "飞行员被迫用飞机的<w>腹部</w>进行了一次危险的着陆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "belly landing",
                        "belly of the beast",
                        "soft underbelly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя поверхность, глубокая внутренняя часть или дно объекта, например корабля или самолета.",
                        "zh": "物体（如船只或飞机）的底部、深处或下表面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брюхо",
                                "target_lang_sense_clarification": "нижняя часть корпуса техники"
                            },
                            {
                                "target_lang_word": "нутро",
                                "target_lang_sense_clarification": "глубокая внутренняя часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腹部",
                                "target_lang_sense_clarification": "指代船只或飞机的底部空间"
                            },
                            {
                                "target_lang_word": "底部",
                                "target_lang_sense_clarification": "指物体的下侧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9145fbe-cf5b-3eec-9a2a-451631bb5f98",
                    "sense_definition": "The womb or uterus where a fetus develops.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt the baby kick inside her <w>belly</w> for the first time.",
                            "target_lang_translations": {
                                "ru": "Она впервые почувствовала, как ребенок толкается у нее в <w>животе</w>.",
                                "zh": "她第一次感觉到宝宝在<w>腹中</w>踢她。"
                            }
                        },
                        {
                            "text": "The ancient text speaks of the child formed within the mother's <w>belly</w>.",
                            "target_lang_translations": {
                                "ru": "Древний текст говорит о ребенке, сформированном во <w>чреве</w> матери.",
                                "zh": "古籍中提到了在母亲<w>腹中</w>孕育的孩子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "womb",
                        "uterus",
                        "matrix"
                    ],
                    "common_phrases": [
                        "fruit of one's belly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "common in biblical or older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Матка или утроба, где развивается плод.",
                        "zh": "胎儿发育的子宫或母体内部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрево",
                                "target_lang_sense_clarification": "устаревшее, книжное"
                            },
                            {
                                "target_lang_word": "утроба",
                                "target_lang_sense_clarification": "физиологическое"
                            },
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "子宫",
                                "target_lang_sense_clarification": "医学术语"
                            },
                            {
                                "target_lang_word": "腹中",
                                "target_lang_sense_clarification": "文学或书面语，指母体内部"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e441564-1bc0-36f7-974b-d3d6c1bda061",
                    "sense_definition": "To swell outward or bulge, often due to wind or pressure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large white sails began to <w>belly</w> out as the wind picked up.",
                            "target_lang_translations": {
                                "ru": "Большие белые паруса начали <w>надуваться</w>, когда ветер усилился.",
                                "zh": "风力增强时，巨大的白帆开始<w>鼓起</w>。"
                            }
                        },
                        {
                            "text": "His loose shirt <w>bellied</w> in the breeze as he rode his bicycle.",
                            "target_lang_translations": {
                                "ru": "Его свободная рубашка <w>раздувалась</w> на ветру, пока он ехал на велосипеде.",
                                "zh": "他骑自行车时，宽松的衬衫在微风中<w>鼓起</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "belly out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздуваться наружу или выпячиваться, часто из-за ветра или давления.",
                        "zh": "因风力或压力而向外膨胀或凸起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надуваться",
                                "target_lang_sense_clarification": "наполняться воздухом"
                            },
                            {
                                "target_lang_word": "раздуваться",
                                "target_lang_sense_clarification": "увеличиваться в объеме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鼓起",
                                "target_lang_sense_clarification": "指物体表面向外凸出"
                            },
                            {
                                "target_lang_word": "膨胀",
                                "target_lang_sense_clarification": "指体积因充气而变大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6208e4e-d7c2-309f-a277-8e9874ecf6ee",
                    "sense_definition": "To move forward close to the ground on one's stomach.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier had to <w>belly</w> through the mud to avoid being seen.",
                            "target_lang_translations": {
                                "ru": "Солдату пришлось <w>ползти</w> по грязи, чтобы его не заметили.",
                                "zh": "为了不被发现，士兵不得不<w>匍匐</w>穿过泥地。"
                            }
                        },
                        {
                            "text": "He <w>bellied</w> up to the edge of the cliff to look down at the river.",
                            "target_lang_translations": {
                                "ru": "Он <w>подполз</w> к краю обрыва, чтобы посмотреть вниз на реку.",
                                "zh": "他<w>匍匐</w>到悬崖边，俯瞰下方的河流。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ползти вперед, прижимаясь к земле животом.",
                        "zh": "腹部贴地向前爬行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ползти",
                                "target_lang_sense_clarification": "передвигаться на животе"
                            },
                            {
                                "target_lang_word": "подползать",
                                "target_lang_sense_clarification": "приближаться ползком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "匍匐",
                                "target_lang_sense_clarification": "指身体贴地爬行"
                            },
                            {
                                "target_lang_word": "爬行",
                                "target_lang_sense_clarification": "指缓慢移动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}