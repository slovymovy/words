                        "sense_id": "554a53e9-6f6c-37b8-b5f0-5271c5a97367",
                        "entry_id": "03ef5ddb-efaf-306b-943f-fb03a7ea926f",
                        "glosses": [
                            "gewohnheitsmäßige, als übertrieben eingeschätzte Verwendung der Anrede „du“ auch gegenüber Fremden"
                        ],
                        "tags": [
                            "leicht abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "65dc119d-3a52-49e7-9807-27026ee0f190",
                                "sense_id": "554a53e9-6f6c-37b8-b5f0-5271c5a97367",
                                "text": "„Das war für mich sehr ungewohnt, denn so eine allumfassende Duzerei hatte ich bis dato nicht erlebt.“"
                            },
                            {
                                "example_id": "fe0b2155-939b-4bfb-8c68-2091eccd8988",
                                "sense_id": "554a53e9-6f6c-37b8-b5f0-5271c5a97367",
                                "text": "„Im Extremfall, so erläutert ein Schreiben des Stuttgarter Kultusministeriums vom 23. März 1982, könne die Duzerei Anlaß für die verwaltungsgerichtliche Auseinandersetzung über den formal korrekten Ablauf der Prüfung werden.“"
                            }
                        ],
