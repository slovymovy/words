                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juron",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Calvaire</w>, fais attention où tu marches avec tes bottes pleines de boue !"
                        },
                        {
                            "text": "J'ai encore oublié mes clés à l'intérieur du bureau, <w>calvaire</w> !"
