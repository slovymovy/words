                "senses": [
                    {
                        "sense_id": "941ac447-fc89-3051-bd0d-9d6ee34c3ad6",
                        "entry_id": "47e23709-6dcf-3c5c-a3cd-a2cc32d556e2",
                        "glosses": [
                            "Artikel, der zu einem fachlichen Thema von jemand, der dieses Fach beherrscht, verfasst wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abad7f5c-4e24-46a2-bba6-3a729a5144da",
                                "sense_id": "941ac447-fc89-3051-bd0d-9d6ee34c3ad6",
                                "text": "„Wenn Gundel – er starb hochbetagt 2012 – bei allem Aufwand und trotz Fachartikeln in Zeitschriften wie dem Sammler-Dienst keine echte Breitenwirkung erzielte, liegt das einerseits daran, dass die leicht verdaulichen Bestandteile seiner Arbeit Eingang in zugänglichere Werke fanden und dass viele Sammler es vermutlich gar nicht so genau wissen wollten.“"
                            },
                            {
                                "example_id": "a5d53861-13b5-4b26-8113-50b6d875a580",
                                "sense_id": "941ac447-fc89-3051-bd0d-9d6ee34c3ad6",
                                "text": "„Die Chemiker Jorn Dyerberg und Hans Olaf Bang hatten – beginnend 1971 – immer wieder in Fachartikeln behauptet, dass Eskimos seltener an Herzkrankheiten und Schlaganfall leiden und eine erstaunliche Lebenserwartung aufweisen. Als Ursache wurden Fisch, Wal und Seehund auf dem Speiseplan vermutet. Die Hypothese wurde so populär, dass zu Fischölkapseln gepresste Omega-3-Fettsäure weltweit Milliarden einbrachten.“"
                            },
                            {
                                "example_id": "14a711b5-df1c-4bbd-ae68-b67c6bf6b262",
                                "sense_id": "941ac447-fc89-3051-bd0d-9d6ee34c3ad6",
                                "text": "„Zufrieden lehnt er sich in seinem ledernen Chefsessel zurück und freut sich über einen Fachartikel, den er gerade gelesen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
