                                            {
                                                "example_id": "bcb371c8-024b-49ac-8c2d-96e1252861aa",
                                                "sense_id": "3b578575-1af3-31b4-a15d-f6d9c79e3228",
                                                "text": "Ich bin nur ein mittelmäßiger Volleyballspieler."
                                            },
                                            {
                                                "example_id": "186f4d12-6fc1-4e6c-aa5f-ab7e691600a9",
                                                "sense_id": "3b578575-1af3-31b4-a15d-f6d9c79e3228",
                                                "text": "„Der jüngere Bruder, Alexander, war wortkarg und schwächlich, man mußte ihn zu allem ermutigen, seine Noten waren mittelmäßig.“"
                                            },
                                            {
                                                "example_id": "eb8012d3-d491-4be2-8fd2-f85d5694c4c6",
                                                "sense_id": "3b578575-1af3-31b4-a15d-f6d9c79e3228",
                                                "text": "„Die Geschäfte des amerikanischen Spielzeugherstellers Mattel laufen recht mittelmäßig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ff61968-6ec9-4220-91f5-d35088e52099",
                        "source_entry_id": "3c0c8e5a-dfd8-3269-b531-810f825dd006",
