                "senses": [
                    {
                        "sense_id": "e5dc022e-3a00-36ee-8312-c2d0db338151",
                        "entry_id": "406944f0-1f28-3b9b-9484-6669f00209c2",
                        "glosses": [
                            "meist aus Kunststoff hergestellte Schwimmhilfen oder Turngeräte in schlauchartiger Form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0c79da0-9d3b-48d4-9c80-70a3cdc9427c",
                                "sense_id": "e5dc022e-3a00-36ee-8312-c2d0db338151",
                                "text": "„Auffällig ist nur, wie viele Erwachsene, vor allem ältere Frauen, sich mit Schwimmflügeln, Rettungswesten oder Schwimmnudeln über Wasser halten.“"
                            },
                            {
                                "example_id": "fd18b7a3-0528-4cea-8728-07c671fda99f",
                                "sense_id": "e5dc022e-3a00-36ee-8312-c2d0db338151",
                                "text": "„Mir gefällt das Wort \"Schwimmnudel\". Das sind lange Kunststoffstangen, mit denen Kinder im Wasser spielen oder schwimmen lernen können.“"
                            },
                            {
                                "example_id": "546fab92-1dd4-4184-9ae0-1cd64d10703f",
                                "sense_id": "e5dc022e-3a00-36ee-8312-c2d0db338151",
                                "text": "Mit der Schwimmnudel trainierte sie im Wasser ihre Muskeln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
