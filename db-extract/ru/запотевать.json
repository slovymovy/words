                ],
                "senses": [
                    {
                        "sense_id": "21749bc1-a7e3-347e-a4c1-5c3085843c72",
                        "entry_id": "fd0796bf-430f-3e94-89f3-c59d4e1691ec",
                        "glosses": [
                            "покрываться потом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016da9ad-c1f1-4f9a-9488-f02ccdd98686",
                                "sense_id": "21749bc1-a7e3-347e-a4c1-5c3085843c72",
                                "text": "Он быстро запотевал, пятнами по белой рубахе."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e46cd1e-168b-3728-b760-16a80b1dca34",
                        "entry_id": "fd0796bf-430f-3e94-89f3-c59d4e1691ec",
                        "glosses": [
                            "перен. становиться влажным от осевших паров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d85bb7-bb5b-4864-9a10-eeca09ddf6dd",
                                "sense_id": "4e46cd1e-168b-3728-b760-16a80b1dca34",
                                "text": "С утра был серый и мелкий дождь, уже слетают листья; уже дышит на окна осень — от этого стёкла запотевают."
                            },
                            {
                                "example_id": "bd317873-718e-4bba-9a9c-ddd78e06c7e5",
                                "sense_id": "4e46cd1e-168b-3728-b760-16a80b1dca34",
                                "text": "При повышенной влажности в помещении влага обычно конденсируется на холодных стеклах, стекло «запотевает»."
                            }
                        ]
                    }
                ],
