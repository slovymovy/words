                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8787afde-289c-3fbd-b9a9-67df549cb03a",
                        "entry_id": "9316cd3e-5cc4-32e7-8a53-b7b71de4369f",
                        "glosses": [
                            "Abkürzung für künstliche Intelligenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ac1371d-f230-4ae9-858e-68d626212354",
                                "sense_id": "8787afde-289c-3fbd-b9a9-67df549cb03a",
                                "text": "Die KI dieses Computerspiels ist sehr ausgereift."
                            },
                            {
                                "example_id": "6c6b6ffd-8df7-4905-8a7e-d0632094c228",
                                "sense_id": "8787afde-289c-3fbd-b9a9-67df549cb03a",
                                "text": "„Damit eine KI loslegen kann, ist erstaunlich viel manuelle Vorarbeit nötig.“"
                            },
                            {
                                "example_id": "6b52fbcb-2d1a-41c7-a859-df1cfee35e8c",
                                "sense_id": "8787afde-289c-3fbd-b9a9-67df549cb03a",
                                "text": "„In der KI-Forschung wird daran gearbeitet, dass KI immer mehr Dinge so gut oder sogar besser kann als Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3623f71a-cc8d-3191-8999-9a31e4dc05d7",
                        "entry_id": "9316cd3e-5cc4-32e7-8a53-b7b71de4369f",
                        "glosses": [
                            "Abkürzung für kategorischer Imperativ"
                        ],
                        "tags": [
                            "Ethik"
                        ],
                        "examples": [
                            {
                                "example_id": "b4064bec-8d68-4ac6-a3e8-69b7bfce179c",
                                "sense_id": "3623f71a-cc8d-3191-8999-9a31e4dc05d7",
                                "text": "Der von Kant aufgestellte KI ähnelt der Goldenen Regel, verallgemeinert diese aber."
                            }
                        ],
