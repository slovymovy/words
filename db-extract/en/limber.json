                        "glosses": [
                            "To cause to become limber; to make flexible or pliant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa072c2-aeb9-4088-a23b-5ec6f73d84e2",
                                "sense_id": "8547cd1e-09d2-367f-bf34-3f0a23c7b581",
                                "text": "Her stiff hams, that have not been bent to a civility for ten years past, are now limbered into courtesies three deep at every word"
                            },
                            {
                                "example_id": "bb5c4c70-153e-4859-ab6c-06b7c37bcc59",
                                "sense_id": "8547cd1e-09d2-367f-bf34-3f0a23c7b581",
                                "text": "Go back to the Island and limber up with a few drafts."
                            }
                        ]
                    }
                ],
