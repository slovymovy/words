                        "examples": [
                            {
                                "example_id": "6a3e5c01-e9d4-4360-adf8-853b05210ccc",
                                "sense_id": "12c8785f-d6dc-31cd-852e-a3cb5d09bd3f",
                                "text": "I was on oral tet for months after I was first dx backn in '88. All I got from it was a very, very nasty and upset GI track. I had to stop it."
                            }
                        ]
