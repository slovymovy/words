                ],
                "senses": [
                    {
                        "sense_id": "f370781e-8701-35d6-9dfd-bda17eeb07dc",
                        "entry_id": "ef5c5460-728a-3f51-ba94-959ba632c949",
                        "glosses": [
                            "alle zaken die men nodig heeft om een bepaalde taak te vervullen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d4ddf4-67bf-48ed-8109-8f2156b9b27a",
                                "sense_id": "f370781e-8701-35d6-9dfd-bda17eeb07dc",
                                "text": "\"Maar het is leuk om hier nu met elkaar als collega's te trainen.\"Hun roeping is de religieuze sporters qua sportieve uitmonstering niet aan te zien. Als hij met jongeren werkt grijpt Boogers overigens juist wel eens bewust naar zijn priesterboordje. \"Niet direct op een shirt bij het sporten, maar als het qua kleding past, kom je er ook wel eens door in gesprek.\""
                            },
                            {
                                "example_id": "dfd111d5-30a7-4d96-adee-8bdd0b5fd897",
                                "sense_id": "f370781e-8701-35d6-9dfd-bda17eeb07dc",
                                "text": "Zelfs met zijn trendvolgende en bagage plettende coupéprofiel wordt een SUV nooit een sportwagen. Mijn GLC 250d in AMG-uitmonstering - 19 inch velgen, sportief bedoelde in- en exterieuraccenten - blijft met zijn meer dan 200 pk sterke viercilinder diesel die gemoedelijke lobbes met het hoge zwaartepunt dat hem in bochten altijd parten speelt."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ef32d5c-9c64-31bf-9080-fcf2a5bdac80",
                        "entry_id": "ef5c5460-728a-3f51-ba94-959ba632c949",
                        "glosses": [
                            "alle zaken waarmee iets of iemand versierd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40904667-7cac-41e4-9cb0-b2175091c097",
                                "sense_id": "9ef32d5c-9c64-31bf-9080-fcf2a5bdac80",
                                "text": "Cartouche heeft de houders van een passepartout via Facebook opgeroepen donderdag en zondag niet in oranje, de gebruikelijk uitmonstering van de Nederlanders, maar in rood te komen om de Belgische hockeyers in hun laatste wedstrijd te steunen. Ook op de club was de stemming somber. Een hockeyfeest in een grote tent op het Cartouche-complex die 500 mensen kan herbergen is echter niet afgezegd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f114f438-0fd8-46d2-ba35-d5ac40dc2b1e",
                        "source_entry_id": "ef5c5460-728a-3f51-ba94-959ba632c949",
                        "source_sense_id": "9ef32d5c-9c64-31bf-9080-fcf2a5bdac80",
                        "source_sense_description": "uitrusting",
                        "target_lang_word": "equipment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equipment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "The act of equipping, or the state of being equipped, as for a voyage or expedition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc28791-9dce-4934-a86e-1d48bb263b60",
                                                "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                                                "text": "The equipment of the fleet was therefore hastened by de Witt ; in hopes that , by striking at first a successful blow , he might inspire courage into the dismayed States"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "Any items used in equipping something or someone, for example things needed for an expedition or voyage."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a95e163-8cc9-4283-a135-9f12d3b13ef2",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "We need more gardening equipment if we want to properly landscape our yard, not just a rake and some gloves."
                                            },
                                            {
                                                "example_id": "72d04ec0-c08a-47f7-9713-c6b2ee67bf2a",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "The sports shop sells different kits of famous clubs, and equipment from all kind of sports."
                                            },
                                            {
                                                "example_id": "124b0ea7-6398-4553-8d53-ddb688c00592",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "Tompkins is considered a hero in the deep ecology movement and works hand in hand with his wife Kris, the former CEO of the outdoor clothing and equipment company Patagonia."
                                            },
                                            {
                                                "example_id": "ef7a840c-130a-43de-b4f9-c5f966a6f1c6",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "Armed and dight, In the equipments of a knight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "The male genitalia."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ce009d-1f83-49df-92b0-0c7b08d28902",
                                                "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                                                "text": "The segment advises the reader matter-of-factly that “the penis [of a whale] should be tucked inside the body and when needed enlarged into an erection”. At the very least, the statement sounds odd. At most, it could make human penis owners consider that their equipment might not represent the highest evolutionary ideal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22486ea9-9dc1-4f27-9e55-217d4155ba31",
                        "source_entry_id": "ef5c5460-728a-3f51-ba94-959ba632c949",
