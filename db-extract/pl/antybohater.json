                                    },
                                    {
                                        "sense_id": "c4df072a-1bbc-3ea6-9fff-08c58551a8ec",
                                        "entry_id": "6b3c4fd5-dbab-3aaa-b164-0468f01bb87f",
                                        "glosses": [
