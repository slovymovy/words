                    {
                        "sense_id": "9ef3b12c-c67f-3120-a274-d38d9e4479a6",
                        "entry_id": "a73a3d18-09f8-3695-abd1-7be078f1a830",
                        "glosses": [
                            "Qui tremble."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5bbc2bc5-a44a-4662-8d48-af3e23cd9c74",
                                "sense_id": "9ef3b12c-c67f-3120-a274-d38d9e4479a6",
                                "text": "Mais, dans la gloire du jour, des coulées lumineuses affluent à tes tempes parées d’un éclat solaire, des rayons y serpentent comme sur les avoines trembleuses et les blés murmurants."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a1c1622-37c2-368b-b4d0-567a440da9e3",
                        "entry_id": "a73a3d18-09f8-3695-abd1-7be078f1a830",
                        "glosses": [
                            "Qui est trop timoré, trop craintif."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c5144209-ffcf-4166-a9d2-d7fcc8eca398",
                                "sense_id": "3a1c1622-37c2-368b-b4d0-567a440da9e3",
                                "text": "— M. de Pontlevé est surtout avare et trembleur, et il redoutait l’influence du caractère décidé de madame de Constantin."
                            }
                        ]
                    }
                ],
