{
    "word_family": [
        "scheiden",
        "afscheiden",
        "onderscheiden",
        "scheiding",
        "afscheiding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9bf47de7-c3dc-387e-958f-67bfcb0430e8",
                    "sense_definition": "Ophouden of stoppen met een bepaalde handeling of activiteit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet nu echt <w>uitscheiden</w> met dat vervelende lawaai.",
                            "target_lang_translations": {
                                "en": "You really need to <w>stop</w> that annoying noise now."
                            }
                        },
                        {
                            "text": "Zij <w>scheidden</w> direct <w>uit</w> met werken toen de bel ging.",
                            "target_lang_translations": {
                                "en": "They <w>stopped</w> working immediately when the bell rang."
                            }
                        }
                    ],
                    "synonyms": [
                        "ophouden"
                    ],
                    "common_phrases": [
                        "uitscheiden met"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in spoken Dutch, especially in the imperative form."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To stop or cease a certain action or activity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to cease doing an activity"
                            },
                            {
                                "target_lang_word": "quit",
                                "target_lang_sense_clarification": "to stop doing something, often colloquially"
                            },
                            {
                                "target_lang_word": "cease",
                                "target_lang_sense_clarification": "to stop or bring to an end"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "585e238b-4a34-3ebe-afc2-1f9e11e70563",
                    "sense_definition": "Niet langer over een bepaald onderwerp praten, vaak gebruikt als een bevel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schei</w> toch <w>uit</w> over die oude problemen!",
                            "target_lang_translations": {
                                "en": "Just <w>stop</w> talking about those old problems!"
                            }
                        },
                        {
                            "text": "Hij vroeg haar vriendelijk om <w>uit</w> te <w>scheiden</w> over de mislukte vakantie.",
                            "target_lang_translations": {
                                "en": "He kindly asked her to <w>stop</w> talking about the failed vacation."
                            }
                        }
                    ],
                    "synonyms": [
                        "ophouden"
                    ],
                    "common_phrases": [
                        "uitscheiden over"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in imperative contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To stop talking about a certain topic, often used as a command."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to cease talking about something"
                            },
                            {
                                "target_lang_word": "drop it",
                                "target_lang_sense_clarification": "to stop discussing a subject"
                            },
                            {
                                "target_lang_word": "cut it out",
                                "target_lang_sense_clarification": "to stop doing or saying something annoying"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98f5c41f-49e9-38db-b971-586f72baf858",
                    "sense_definition": "Een bepaalde stof uit het lichaam of organisme laten wegvloeien of afgeven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "afscheiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De klieren in de huid <w>scheiden</w> zweet <w>uit</w> om af te koelen.",
                            "target_lang_translations": {
                                "en": "The glands in the skin <w>secrete</w> sweat to cool down."
                            }
                        },
                        {
                            "text": "Schadelijke stoffen worden door de nieren uit het lichaam <w>uitgescheiden</w>.",
                            "target_lang_translations": {
                                "en": "Harmful substances are <w>excreted</w> from the body by the kidneys."
                            }
                        }
                    ],
                    "synonyms": [
                        "afscheiden"
                    ],
                    "common_phrases": [
                        "stoffen uitscheiden"
                    ],
                    "target_lang_definitions": {
                        "en": "To discharge or release a substance from the body or an organism."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excrete",
                                "target_lang_sense_clarification": "to discharge waste matter from the body"
                            },
                            {
                                "target_lang_word": "secrete",
                                "target_lang_sense_clarification": "to produce and release a substance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}