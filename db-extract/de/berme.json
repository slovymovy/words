                ],
                "senses": [
                    {
                        "sense_id": "d8d7295f-3a17-39f0-9f40-cc475a519b79",
                        "entry_id": "5971c172-7afb-3a5a-ae0f-26c4f4637a64",
                        "glosses": [
                            "Absatz an einer Böschung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0cb9c0d-ea74-4d19-939a-37b7df6f74d7",
                                "sense_id": "d8d7295f-3a17-39f0-9f40-cc475a519b79",
                                "text": "„Die Berme dient dazu, nachrutschendes Material aufzufangen und sollte spätestens nach 3,0 Metern Grabentiefe zur Anwendung kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9127d891-b6ff-4813-a019-ee293164251d",
                        "source_entry_id": "5971c172-7afb-3a5a-ae0f-26c4f4637a64",
                        "source_sense_id": "d8d7295f-3a17-39f0-9f40-cc475a519b79",
                        "source_sense_description": "Absatz an einer Böschung",
                        "target_lang_word": "berme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25a56b5d-94d4-3565-baab-39822fb8c17d",
                                        "entry_id": "7a4099d1-03ec-33c6-a48e-9df37ffff1dc",
                                        "glosses": [
                                            "Chemin étroit entre le pied d’un rempart et un fossé, espace environné de palissades, qu’on laisse au même endroit pour recevoir les terres qui peuvent s’ébouler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8e674f-52df-449b-9b9e-851c0c2ba553",
                                                "sense_id": "25a56b5d-94d4-3565-baab-39822fb8c17d",
                                                "text": "Dreux et le duc de Mortemart chassèrent les ennemis ; ils revinrent et s’établirent sur la berme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0e6fb84-0880-3803-8db0-05aa12ebce67",
                                        "entry_id": "7a4099d1-03ec-33c6-a48e-9df37ffff1dc",
                                        "glosses": [
                                            "Partie d’accotement qui assure la jonction avec le fossé ou le talus."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00f0ecf6-caf0-4c35-a4ad-5d13f0105092",
                                                "sense_id": "e0e6fb84-0880-3803-8db0-05aa12ebce67",
                                                "text": "Les glissières de sécurité sont implantées entre la bande d'arrêt et la berme."
                                            },
                                            {
                                                "example_id": "fe7c51f9-793e-4bd4-8a7f-9aee6e06e449",
                                                "sense_id": "e0e6fb84-0880-3803-8db0-05aa12ebce67",
                                                "text": "Delmas sauta sur la berme en brandissant classiquement un poing vengeur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e6b65b-11d9-388f-a587-ee317e857c4a",
                                        "entry_id": "7a4099d1-03ec-33c6-a48e-9df37ffff1dc",
                                        "glosses": [
                                            "Chemin laissé entre une levée et le bord d’un canal ou d’un fossé."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2644d91-863f-44bc-b28d-ec61ac0bdb86",
                                                "sense_id": "80e6b65b-11d9-388f-a587-ee317e857c4a",
                                                "text": "Comme l’inconnu ne violait aucune convenance de politesse en se promenant sur la berme de la levée le colonel se remit dans le coin de sa calèche."
                                            },
                                            {
                                                "example_id": "fb1e54ed-ede7-4f78-902f-a87a0110718f",
                                                "sense_id": "80e6b65b-11d9-388f-a587-ee317e857c4a",
                                                "text": "À une pause, ivre de sommeil, je distingue mal la berme pour m’asseoir et je boule jusqu’au bas de la digue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ff73f0d-048c-316e-9fa2-0ae702a5d5a7",
                                        "entry_id": "7a4099d1-03ec-33c6-a48e-9df37ffff1dc",
                                        "glosses": [
                                            "Retraite laissée entre la magistrale (couronnement de l’escarpe) et le pied du talus extérieur du parapet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f86807cd-2cb2-45f7-a2a4-2cc0d96bbf0a",
                                                "sense_id": "2ff73f0d-048c-316e-9fa2-0ae702a5d5a7",
                                                "text": "Certaines propriétés ont fait l’objet d’améliorations très étranges, telles que des héliports protégés par des bermes de terre”, relève Korhonen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b26177f-8fbf-397f-8629-78ea2cd1b967",
                                        "entry_id": "7a4099d1-03ec-33c6-a48e-9df37ffff1dc",
                                        "glosses": [
                                            "Pierre de couronnement de l’escarpe, faisant saillie et dont la partie supérieure va en pente vers le fossé pour l’écoulement des eaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
