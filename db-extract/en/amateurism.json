                    {
                        "translation_id": "ab241dbf-ea2e-430c-bfb2-b3c73a134522",
                        "source_entry_id": "30c7c366-4b29-3588-9fed-fd19cbda9fbf",
                        "source_sense_description": "amateur beliefs and practices",
                        "target_lang_word": "amatérismus",
