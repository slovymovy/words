                "senses": [
                    {
                        "sense_id": "e0d096da-946f-39e0-9b9a-e108330832ce",
                        "entry_id": "572836fb-6969-3827-b55e-08cd46ce975b",
                        "glosses": [
                            "Resembling a waste or wasteland; desert; (by extension) deserted, desolate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b2e901-3189-4afe-a5c2-c339ea232f8f",
                                "sense_id": "e0d096da-946f-39e0-9b9a-e108330832ce",
                                "text": "But, happily, we meet with circumstances that break in upon this routine and monotony, and we thank God, as Mungo Park did, when the moss peeped up at him from the wasty desert."
                            },
                            {
                                "example_id": "3c34234d-5512-4eb9-ac0c-038794165b14",
                                "sense_id": "e0d096da-946f-39e0-9b9a-e108330832ce",
                                "text": "Frequent on wasty places and in the desert."
                            },
                            {
                                "example_id": "4d8755cc-5726-4ac6-9ff6-3842a8235893",
                                "sense_id": "e0d096da-946f-39e0-9b9a-e108330832ce",
                                "text": "These boundaries were a long way down into the desert, below a corner of that fearful wasty wild known as the Great Erg."
                            },
                            {
                                "example_id": "66e51dfd-d82d-4ee8-9496-53f2a801dc62",
                                "sense_id": "e0d096da-946f-39e0-9b9a-e108330832ce",
                                "text": "It is formed of glacial rock in all sorts of shapes and sizes and gives a wasty, desert appearance."
                            },
                            {
                                "example_id": "bc8c5c35-e981-4058-bd6f-24da029fe831",
                                "sense_id": "e0d096da-946f-39e0-9b9a-e108330832ce",
                                "text": "A red-tailed hawk swooped down into a stand of prickly pears in a “wasty” moonscape."
                            }
                        ]
                    }
                ],
