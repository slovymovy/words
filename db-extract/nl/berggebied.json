                    {
                        "sense_id": "faf06540-a7ab-3c6c-9c1a-06b4e0910a26",
                        "entry_id": "bc10837e-5c59-37ed-8dc1-c5d8f39f5fe7",
                        "glosses": [
                            "landstreek met veel bergen"
