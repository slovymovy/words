                "senses": [
                    {
                        "sense_id": "b4afad1a-b461-3a2b-acd7-172d8f980a93",
                        "entry_id": "7ce26f1e-dfff-3667-8d5d-9c8cfe246fd4",
                        "glosses": [
                            "Raccommoder, mettre un petas à un vêtement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "157cf4f5-f1ec-45a5-bc63-95584a723cdb",
                                "sense_id": "b4afad1a-b461-3a2b-acd7-172d8f980a93",
                                "text": "… et sans perdre de temps pétasser les habits, faire les chaussettes de laine ou les tricots, et préparer les bujades."
                            },
                            {
                                "example_id": "fa695ce7-8556-4dcd-946f-129d37a1275d",
                                "sense_id": "b4afad1a-b461-3a2b-acd7-172d8f980a93",
                                "text": "Et parce que le père avait toujours préservé le toit de chaume, elle continua chaque année à le pétasser, à boucher les trous de l'hiver."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd6ebac8-c7c4-3f3d-bfaa-bdd6ef1e1ea1",
