                                "target_senses": [
                                    {
                                        "sense_id": "f208fb7c-7e10-3f1a-9c15-779161da6e3d",
                                        "entry_id": "b2fed4fd-60b8-31c7-a66d-db24429e1f9f",
                                        "glosses": [
                                            "A brief explanatory note or translation of a foreign, archaic, technical, difficult, complex, or uncommon expression, inserted after the original, in the margin of a document, or between lines of a text."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c6c643e-66d3-4a15-a70d-f17beb0e2d82",
                                                "sense_id": "f208fb7c-7e10-3f1a-9c15-779161da6e3d",
                                                "text": "All this, without a gloss or comment, / He would unriddle in a moment."
                                            },
                                            {
                                                "example_id": "7265a6e8-fa44-476e-8c3d-6470ad8d0862",
                                                "sense_id": "f208fb7c-7e10-3f1a-9c15-779161da6e3d",
                                                "text": "He was a prolific annotator - writing around fifty thousand glosses in as many as twenty manuscripts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e91e11-5665-39ab-8c73-6c124b606480",
                                        "entry_id": "b2fed4fd-60b8-31c7-a66d-db24429e1f9f",
                                        "glosses": [
                                            "Synonym of glossary, a collection of such notes."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "997661d4-da2e-32c6-801a-29381be62cf0",
                                        "entry_id": "b2fed4fd-60b8-31c7-a66d-db24429e1f9f",
                                        "glosses": [
                                            "An expression requiring such explanatory treatment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c25944b-1ae0-3440-91d3-7ba18b25529d",
                                        "entry_id": "b2fed4fd-60b8-31c7-a66d-db24429e1f9f",
                                        "glosses": [
                                            "An extensive commentary on some text."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ca0c793-a280-330a-a611-8591d4112b56",
                                        "entry_id": "b2fed4fd-60b8-31c7-a66d-db24429e1f9f",
                                        "glosses": [
                                            "An interpretation by a court of a specific point within a statute or case law."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bfcc9ee-b9f3-4dd4-8263-98e9e992dbf1",
                                                "sense_id": "2ca0c793-a280-330a-a611-8591d4112b56",
                                                "text": "This volume is thus not a narrowly defined treatment of the Code of Professional Responsibility but rather represents a \"common law\" gloss on it."
                                            },
                                            {
                                                "example_id": "331b8cb0-ed62-43e0-bd6d-486c4a826607",
                                                "sense_id": "2ca0c793-a280-330a-a611-8591d4112b56",
                                                "text": "Judicial Gloss on Test [section title]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546660e3-bf59-31ca-b1d6-8ca963e794e7",
                                        "entry_id": "b2fed4fd-60b8-31c7-a66d-db24429e1f9f",
                                        "glosses": [
                                            "A definition or explanation of a word sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c5d440-683f-48a4-a732-db45d920b9e0",
                                                "sense_id": "546660e3-bf59-31ca-b1d6-8ca963e794e7",
                                                "text": "Dictionary entries comprise two essential parts, the headword ('lemma') and the author's explanation ('gloss')."
                                            },
                                            {
                                                "example_id": "992c5c0e-a7d2-4295-941f-ede34a86e582",
                                                "sense_id": "546660e3-bf59-31ca-b1d6-8ca963e794e7",
                                                "text": "Therefore, for many of the Hebrew words in this book, I have provided more than one gloss (using a slash to separate alternatives, or double slashes when a single slash would be ambiguous), in order to give you a sense of the possible meanings of nuances […]."
                                            }
                                        ]
                                    }
                                ]
