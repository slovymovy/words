                ],
                "senses": [
                    {
                        "sense_id": "00ab52cc-3404-3acf-91a5-3f74bdd95651",
                        "entry_id": "7bec2fcd-17a8-3324-a183-4fe8206fd23c",
                        "glosses": [
                            "geschlossener oder teilweise offener Raum, in dem Müll bis zur Abholung in Behältern lagert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a801a5-d3d5-4199-b6fe-a1cd75c283c4",
                                "sense_id": "00ab52cc-3404-3acf-91a5-3f74bdd95651",
                                "text": "Die von der Lüftungsanlage ausgeblasene Fortluft aus dem Müllraum im Keller stinkt gelegentlich, ganz besonders im Sommer wenn es warm ist."
                            },
                            {
                                "example_id": "094956dd-3be5-4680-83dc-bb4e1640389e",
                                "sense_id": "00ab52cc-3404-3acf-91a5-3f74bdd95651",
                                "text": "„Allein im August hat es im Müllraum des Heinz-Nittel-Hofs in Floridsdorf zweimal, seit Anfang des Jahres fünfmal gebrannt.“"
                            },
                            {
                                "example_id": "82066a54-46b9-4d12-8cd2-1b8fb0eded55",
                                "sense_id": "00ab52cc-3404-3acf-91a5-3f74bdd95651",
                                "text": "„Bei der Errichtung von Müllräumen oder Standplätzen ist darauf zu achten, dass Müllbox / Müllraum / Behälter-Standfläche und Außengelände auf gleichem Niveau liegen und weiter zur Straße (Müllfahrzeug-Halteplatz) weder Stufen, Rinnen oder andere Unebenheiten vorhanden sind; dazu gehört auch eine entsprechende Randsteinabsenkung für Großbehälter.“"
                            },
                            {
                                "example_id": "cccac716-2007-40a2-a598-d034fd4e4d43",
                                "sense_id": "00ab52cc-3404-3acf-91a5-3f74bdd95651",
                                "text": "„Erfolgt durch den Thermodifferenzialmelder eine Branderkennung im Müllraum, wird über die Brandmeldezentrale das Magnetventil für die dort installierten Löschmitteldüsen geöffnet.“"
                            },
                            {
                                "example_id": "72050656-5928-4b68-8b21-38f583a2b0cf",
                                "sense_id": "00ab52cc-3404-3acf-91a5-3f74bdd95651",
                                "text": "„Wenn die Aufbewahrung in einem Müllraum im Gebäudeinneren stattfindet, muss der Raum den Anforderungen des Absatzes 2 entsprechen.“"
                            },
                            {
                                "example_id": "015724ec-79db-4beb-8039-526287066006",
                                "sense_id": "00ab52cc-3404-3acf-91a5-3f74bdd95651",
                                "text": "„ Im Müllraum ist als Erste und Erweiterte Löschhilfe, angeschlossen an die Wasserversorgung, stationäre Rohrleitungssysteme mit offenen Sprühflutdüsen zu installieren.“"
                            },
                            {
                                "example_id": "5bacb5f4-1542-4eee-8307-0d47f5850714",
                                "sense_id": "00ab52cc-3404-3acf-91a5-3f74bdd95651",
                                "text": "„Bei der Errichtung von Müllräumen oder Standplätzen ist darauf zu achten, dass Müllbox / Müllraum / Behälter-Standfläche und Außengelände auf gleichem Niveau liegen und weiter zur Straße (Müllfahrzeug-Halteplatz) weder Stufen, Rinnen oder andere Unebenheiten vorhanden sind; dazu gehört auch eine entsprechende Randsteinabsenkung für Großbehälter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aa13a327-3c05-3b33-97a8-edb9d5789e10",
                        "entry_id": "7bec2fcd-17a8-3324-a183-4fe8206fd23c",
                        "glosses": [
                            "ein mit Müll gefüllter Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6be1cc02-020d-4cd0-b127-a4c96fecb04e",
                                "sense_id": "aa13a327-3c05-3b33-97a8-edb9d5789e10",
                                "text": "So manche Messiwohnung gleicht einem Müllraum und sollte einfach nur vom Müll befreit werden, damit der Oberbegriff: Wohnung wieder dem Sinn nach Lebensqualität nahe kommt!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
