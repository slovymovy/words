                    "frequency": "High",
                    "semantic_group_id": "tijdseenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga elk <w>jaar</w> met mijn familie op vakantie naar de bergen.",
                            "target_lang_translations": {
                                "en": "I go on vacation to the mountains with my family every <w>year</w>."
                            }
                        },
                        {
                            "text": "Het is bijna een <w>jaar</w> geleden dat we elkaar voor het laatst zagen.",
                            "target_lang_translations": {
                                "en": "It is almost a <w>year</w> ago since we last saw each other."
                            }
                        }
                    ],
