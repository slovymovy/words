        "fr-extract.jsonl": [
            {
                "entry_id": "ee1ad0c5-e3be-36d4-95df-dac2e72d41ef",
                "word": "cippe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a2fa1cb7-b157-4844-a0d9-14211967968a",
                        "entry_id": "ee1ad0c5-e3be-36d4-95df-dac2e72d41ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "cippes"
                    },
                    {
                        "form_id": "00f5ca0e-ec6c-4b23-99ce-3d44dc07edb0",
                        "entry_id": "ee1ad0c5-e3be-36d4-95df-dac2e72d41ef",
                        "tags": [],
                        "form": "cyppe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a62cf125-3e62-3f4e-84c8-91ac48e56f28",
                        "entry_id": "ee1ad0c5-e3be-36d4-95df-dac2e72d41ef",
                        "glosses": [
                            "Demi-colonne sans chapiteau, sur laquelle on grave quelquefois des inscriptions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e9a4e2-f14e-43af-8d57-0a85e5749af6",
                                "sense_id": "a62cf125-3e62-3f4e-84c8-91ac48e56f28",
                                "text": "Ce tombeau est surmonté d’un cippe."
                            },
                            {
                                "example_id": "9f6bea5b-dd9d-4f35-927c-ea6213d9a319",
                                "sense_id": "a62cf125-3e62-3f4e-84c8-91ac48e56f28",
                                "text": "J’ai regardé le tombeau de mon père que je n’avais pas vu depuis l’exil. Le cippe est noirci."
                            },
                            {
                                "example_id": "cbc99bb2-ea8f-4e87-8299-dd9bf1cd87dd",
                                "sense_id": "a62cf125-3e62-3f4e-84c8-91ac48e56f28",
                                "text": "Maintenant cette Histoire est destinée à élever un modeste cippe où soit attestée la vie de celui qui m’a légué tout son bien, sa pensée."
                            },
                            {
                                "example_id": "061835b5-64c1-4ec8-add1-cbefd331efda",
                                "sense_id": "a62cf125-3e62-3f4e-84c8-91ac48e56f28",
                                "text": "Le cippe grossier par lequel les Hellènes représentaient les Grâces leur disait plus de choses que de belles statues allégoriques."
                            },
                            {
                                "example_id": "ab22e147-1151-4a9f-a4af-2b79dc649bf3",
                                "sense_id": "a62cf125-3e62-3f4e-84c8-91ac48e56f28",
                                "text": "Le chapiteau ionique est un chapiteau dorique orné, sur l’échine duquel se trouve placé un ajoutage de volutes, canal et coussin, ajoutage qui se retrouve d’une manière semblable au bord supérieur des autels, des cippes et d’autres monuments, et qui sans doute est né de l’imitation de cornes de béliers suspendues."
                            },
                            {
                                "example_id": "8f551eb8-b296-4348-b133-7cf2be7f58dc",
                                "sense_id": "a62cf125-3e62-3f4e-84c8-91ac48e56f28",
                                "text": "Nous suivîmes les larges boulevards déserts en regardant sans rien dire, les croix, les cippes et les couronnes qui attendent chez le marchand leur funèbre clientèle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33171a6d-1b4e-4890-9109-3b43cdb92150",
                        "source_entry_id": "ee1ad0c5-e3be-36d4-95df-dac2e72d41ef",
                        "source_sense_id": "a62cf125-3e62-3f4e-84c8-91ac48e56f28",
                        "source_sense_description": "borne mémoriale",
                        "target_lang_word": "Grenzstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grenzstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72c20c09-ada3-37a1-a7da-d44b2a099163",
                                        "entry_id": "e28057d9-7ca3-375a-849d-a0ca27022abd",
                                        "glosses": [
                                            "punktuelle Markierung einer Grundstücks- oder Landesgrenze oder dergleichen durch einen Stein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7822cfe-6ed6-4864-8637-2cc05882f77d",
                                                "sense_id": "72c20c09-ada3-37a1-a7da-d44b2a099163",
                                                "text": "Der Grenzstein war unter hohem Gras verborgen."
                                            },
                                            {
                                                "example_id": "d8856f9a-51a1-4a3d-a5c2-0f61ec2a0df0",
                                                "sense_id": "72c20c09-ada3-37a1-a7da-d44b2a099163",
                                                "text": "„Seit dem 16. Jahrhundert wurde der Rennsteig durch Grenzsteine markiert, die politische Hoheitszeichen darstellten.“"
                                            },
                                            {
                                                "example_id": "a255e9d9-bbde-468e-9c9f-584249bda1f8",
                                                "sense_id": "72c20c09-ada3-37a1-a7da-d44b2a099163",
                                                "text": "„Unter den Grenzsteinen wurden Marken, die so genannten Zeugen vergraben, um die Richtigkeit der Grenze bei Verrücken oder unrechtmäßiger Entfernung des Grenzsteins zu bezeugen.“"
                                            },
                                            {
                                                "example_id": "e0142ec8-33ec-46d4-9390-fd3023892519",
                                                "sense_id": "72c20c09-ada3-37a1-a7da-d44b2a099163",
                                                "text": "„Generell gilt für alle Grenzsteine: bearbeitete Steine mit rechteckigem, dreieckigem oder rundem Grundriss, Höhe meist größer als Breite (Dicke)“"
                                            },
                                            {
                                                "example_id": "7f1fa58b-6f42-403a-a55c-17b0460a03b4",
                                                "sense_id": "72c20c09-ada3-37a1-a7da-d44b2a099163",
                                                "text": "„Voller Besitzerstolz wies er auf die Grenzsteine hin, ließ sich über Fruchtbarkeit des Bodens aus und die voraussichtlich erstklassige Ernte, die manche Felder versprachen usw. und schimpfte gleichzeitg wütend auf Hallows und seine böswillige Mißwirtschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a806989a-2971-458a-8e37-af6ce7544937",
                        "source_entry_id": "ee1ad0c5-e3be-36d4-95df-dac2e72d41ef",
