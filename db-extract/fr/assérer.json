                "senses": [
                    {
                        "sense_id": "68d3b5b1-086b-35f1-95be-4f3d8a53857e",
                        "entry_id": "3c319327-0072-3072-8412-13b422d56794",
                        "glosses": [
                            "Affirmer, assurer, émettre une assertion."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "37ba3928-a090-4152-b5b7-a42dc6d9aa22",
                                "sense_id": "68d3b5b1-086b-35f1-95be-4f3d8a53857e",
                                "text": "Conformément au sens de la langue naturelle, nier une proposition c’est en assérer la fausseté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d50b258-d145-44cc-b5eb-1e270acec8e4",
                        "source_entry_id": "3c319327-0072-3072-8412-13b422d56794",
                        "source_sense_id": "68d3b5b1-086b-35f1-95be-4f3d8a53857e",
                        "target_lang_word": "assert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7230124-690a-3316-9750-17f6ccebaadb",
                                        "entry_id": "52f7b37a-7094-3489-adbb-0733bab1aef7",
                                        "glosses": [
                                            "To declare with assurance or plainly and strongly; to state positively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f8e4dd2-882a-4a53-8851-972970864467",
                                                "sense_id": "d7230124-690a-3316-9750-17f6ccebaadb",
                                                "text": "He would often assert that there was life on other planets."
                                            },
                                            {
                                                "example_id": "6d6103dd-d548-4d1c-9f33-58db503f8594",
                                                "sense_id": "d7230124-690a-3316-9750-17f6ccebaadb",
                                                "text": "Numerous experimental tests and other observations have been offered in favor of animal mind reading, and although many scientists are skeptical, others assert that humans are not the only species capable of representing what others do and don’t perceive and know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97f494a7-cabc-3b66-b29c-cbe4267e2a81",
                                        "entry_id": "52f7b37a-7094-3489-adbb-0733bab1aef7",
                                        "glosses": [
                                            "To use or exercise and thereby prove the existence of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59ac30f7-785b-484c-ae81-f3530f2a11f0",
                                                "sense_id": "97f494a7-cabc-3b66-b29c-cbe4267e2a81",
                                                "text": "to assert one's authority"
                                            },
                                            {
                                                "example_id": "12822207-b819-4534-b5ed-e451d3186efb",
                                                "sense_id": "97f494a7-cabc-3b66-b29c-cbe4267e2a81",
                                                "text": "Salman Rushdie has asserted his right to be identified as the author of this work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d94c577-ce7c-36e8-90e4-f0ebd99cf4d8",
                                        "entry_id": "52f7b37a-7094-3489-adbb-0733bab1aef7",
                                        "glosses": [
                                            "To maintain or defend, as a cause or a claim, by words or measures; to vindicate a claim or title to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b16812b-800e-468b-aa33-815595ca2ff3",
                                                "sense_id": "9d94c577-ce7c-36e8-90e4-f0ebd99cf4d8",
                                                "text": "to assert our rights and liberties"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bb2da8f-8b9c-35c6-b81a-0b023d6eab95",
                                        "entry_id": "52f7b37a-7094-3489-adbb-0733bab1aef7",
                                        "glosses": [
                                            "To insist on the legitimacy of one's rights, opinion, etc; not to allow oneself to be dismissed; to ensure that one is taken into consideration; to make oneself respected; to be assertive. See assert oneself."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70f996bf-6c07-4860-9096-066597bc3b8a",
                                                "sense_id": "3bb2da8f-8b9c-35c6-b81a-0b023d6eab95",
                                                "text": "Since going to therapy, I've found it much easier to assert myself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83e32414-0cea-36e7-9c37-db07b990413d",
                                        "entry_id": "52f7b37a-7094-3489-adbb-0733bab1aef7",
                                        "glosses": [
                                            "To declare that a condition or expression must be true at a certain point in the source code (in some cases causing the program to fail if it is not, as a safeguard)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe97a747-5aed-39aa-a245-249d4a2e3b3f",
                                        "entry_id": "52f7b37a-7094-3489-adbb-0733bab1aef7",
                                        "glosses": [
                                            "To set a signal on a line using a voltage or electric current."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
