                        "entry_id": "205760b8-735d-3262-bce9-c518c66804aa",
                        "glosses": [
                            "przywóz towarów, usług lub kapitału z zagranicy w celu wykorzystania ich na rynku wewnętrznym"
                        ],
                        "tags": [],
                        "examples": [
