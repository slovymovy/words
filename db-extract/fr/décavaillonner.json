                ],
                "senses": [
                    {
                        "sense_id": "d3ef0fa2-46bf-3e6f-a0e7-352271d6c9b2",
                        "entry_id": "a9eb2faf-7f92-3ef9-b609-e0de36406e0c",
                        "glosses": [
                            "Travailler la terre au plus près des ceps, là où la charrue ordinaire ne peut intervenir, afin de désherber et de ramener la terre entre les rangs de vigne."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "e7b553eb-8a1b-43f3-bd4b-e646bb78d716",
                                "sense_id": "d3ef0fa2-46bf-3e6f-a0e7-352271d6c9b2",
                                "text": "Les pluies abondantes du printemps avaient encouragé le chiendent et la traînasse. Une fois les rangs décavaillonnés, il fallait tirer l'herbe à la main, soigneusement, là où le bigot ne pouvait passer, au risque de blesser les ceps de vigne."
                            },
                            {
                                "example_id": "37e169c4-28f0-4599-b304-ae7f59c4484f",
                                "sense_id": "d3ef0fa2-46bf-3e6f-a0e7-352271d6c9b2",
                                "text": "Décavaillonner c’est travailler le sol entre les pieds de vigne. La décavaillonneuse retourne le cavaillon qui est au pied des souches afin d’éliminer les adventices à la sortie de l’hiver."
                            }
                        ]
                    }
