                                    {
                                        "sense_id": "695fdc41-083a-3381-92f4-09d0b472ac7a",
                                        "entry_id": "33820123-eb7b-3bc2-9ed4-4152308e73b2",
                                        "glosses": [
                                            "The act of pressing; compression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa0ff55-ff01-4ec8-ad3e-65f7c4be8bf6",
                                                "sense_id": "695fdc41-083a-3381-92f4-09d0b472ac7a",
                                                "text": "Starting at the point of shoulder, use muscle squeezings, picking-ups, kneadings and gentle frictions, interspersed with effleurages, over the triceps muscle as well as the fleshy part of the flexor and extensor muscle groups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f699e7-f676-31fb-a12e-928625c797f9",
                                        "entry_id": "33820123-eb7b-3bc2-9ed4-4152308e73b2",
                                        "glosses": [
                                            "That which is forced out by pressure; dregs."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d11cfc9-36d7-4453-90a8-b63d01a1b84a",
                                                "sense_id": "f3f699e7-f676-31fb-a12e-928625c797f9",
                                                "text": "An exceedingly minute portion of Prussian blue suspended in water was similarly affected with muriatic acid. A portion of the squeezings of the sponge, which exhibited a greenish colour, evaporated to dryness, and ignited, left a calx […]"
                                            }
                                        ]
                                    }
