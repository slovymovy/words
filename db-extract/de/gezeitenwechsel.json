                "senses": [
                    {
                        "sense_id": "808e789c-4977-32bb-9c23-7fc105cf766e",
                        "entry_id": "94a713ff-1db9-3c7f-b3cf-9506c86c1012",
                        "glosses": [
                            "Wechsel von Ebbe zu Flut und zurück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d67ce77-8920-4079-a98f-1ac541bff237",
                                "sense_id": "808e789c-4977-32bb-9c23-7fc105cf766e",
                                "text": "„Der ausgeprägte Gezeitenwechsel der Nordsee und das rauhe Klima sorgen für extreme Lebensbedingungen und höchste biologische Produktivität gleichermaßen.“"
                            },
                            {
                                "example_id": "11ce35af-5f6d-4a1c-8d00-1ee1b8a8d334",
                                "sense_id": "808e789c-4977-32bb-9c23-7fc105cf766e",
                                "text": "„In der schnellen Strömung trieben ein paar abgestorbene Bäume; bei Flut mußte das Flußwasser eine ganze Strecke zurückgetrieben werden, der Seemann überlegte sich gleich, wie man den Gezeitenwechsel als Transportmittel ausnützen könne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
