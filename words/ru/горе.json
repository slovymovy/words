{
    "word_family": [
        "горевать",
        "горестный",
        "горемыка",
        "пригорюниться"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d154bed7-c743-3cf2-9d8a-104fcd63abdf",
                    "sense_definition": "Глубокая душевная печаль, скорбь, тяжёлое переживание.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_neg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она не могла сдержать слёз от большого <горя>.",
                            "target_lang_translations": {
                                "en": "She could not hold back tears of great <grief>.",
                                "tr": "Büyük <w>kederinden</w> gözyaşlarını tutamadı."
                            }
                        },
                        {
                            "text": "После потери работы он начал пить <с горя>.",
                            "target_lang_translations": {
                                "en": "After losing his job, he started drinking <out of grief>.",
                                "tr": "İşini kaybettikten sonra <w>kederinden</w> içmeye başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "скорбь",
                        "печаль"
                    ],
                    "antonyms": [
                        "радость",
                        "счастье",
                        "веселье"
                    ],
                    "common_phrases": [
                        "убитый горем",
                        "с горя",
                        "хлебнуть горя",
                        "горе луковое"
                    ],
                    "target_lang_definitions": {
                        "en": "Deep emotional sadness, grief, or heavy suffering.",
                        "tr": "Derin ruhsal acı, keder, üzüntü, ağır ıstırap."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grief",
                                "target_lang_sense_clarification": "intense sorrow caused by loss"
                            },
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "a feeling of deep distress"
                            },
                            {
                                "target_lang_word": "misery",
                                "target_lang_sense_clarification": "state of great unhappiness"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "keder",
                                "target_lang_sense_clarification": "büyük acı veya üzüntü"
                            },
                            {
                                "target_lang_word": "üzüntü",
                                "target_lang_sense_clarification": "ruhsal sıkıntı, elem"
                            },
                            {
                                "target_lang_word": "ıstırap",
                                "target_lang_sense_clarification": "çekilen büyük acı, keder"
                            },
                            {
                                "target_lang_word": "elem",
                                "target_lang_sense_clarification": "derin üzüntü, acı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62caf330-9ab6-35ef-9877-bd772930ccfa",
                    "sense_definition": "Несчастье, беда, бедствие; событие, приносящее страдание.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "event_neg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В их семью пришло страшное <горе>.",
                            "target_lang_translations": {
                                "en": "A terrible <misfortune> befell their family.",
                                "tr": "Ailelerine korkunç bir <w>felaket</w> geldi."
                            }
                        },
                        {
                            "text": "Слезами <горю> не поможешь, нужно действовать.",
                            "target_lang_translations": {
                                "en": "Tears won't help the <trouble>, one must act.",
                                "tr": "Ağlamak <w>derde</w> çare olmaz, harekete geçmek gerekir."
                            }
                        }
                    ],
                    "synonyms": [
                        "несчастье",
                        "наве́рх"
                    ],
                    "antonyms": [
                        "счастье",
                        "радость"
                    ],
                    "common_phrases": [
                        "помочь горю",
                        "на моё горе",
                        "случилось горе"
                    ],
                    "target_lang_definitions": {
                        "en": "Misfortune, disaster, or a tragic event causing suffering.",
                        "tr": "Felaket, bela, musibet; acı getiren olay."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "misfortune",
                                "target_lang_sense_clarification": "bad luck or an unfortunate event"
                            },
                            {
                                "target_lang_word": "calamity",
                                "target_lang_sense_clarification": "a disastrous event"
                            },
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "difficulty or problems"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dert",
                                "target_lang_sense_clarification": "sıkıntı, bela"
                            },
                            {
                                "target_lang_word": "bela",
                                "target_lang_sense_clarification": "büyük sıkıntı veren olay"
                            },
                            {
                                "target_lang_word": "felaket",
                                "target_lang_sense_clarification": "büyük yıkım veya musibet"
                            },
                            {
                                "target_lang_word": "musibet",
                                "target_lang_sense_clarification": "ansızın gelen felaket"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60bf6048-4fbb-3f8d-aa61-bc7c3cd1c449",
                    "sense_definition": "Форма дательного или предложного падежа единственного числа существительного <w>гора</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы разбили лагерь на высокой <горе>.",
                            "target_lang_translations": {
                                "en": "The tourists set up camp on a high <mountain>.",
                                "tr": "Turistler yüksek bir <w>dağda</w> kamp kurdular."
                            }
                        },
                        {
                            "text": "Мы медленно подошли к крутой <горе>.",
                            "target_lang_translations": {
                                "en": "We slowly approached the steep <mountain>.",
                                "tr": "Sarp <w>dağa</w> yavaşça yaklaştık."
                            }
                        }
                    ],
                    "common_phrases": [
                        "на горе",
                        "к горе"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Form of the noun 'mountain' (гора) in the dative or prepositional case.",
                        "tr": "'Dağ' (гора) isminin yönelme (-e) veya bulunma (-de) hali."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mountain",
                                "target_lang_sense_clarification": "large natural elevation of the earth's surface"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dağda",
                                "target_lang_sense_clarification": "dağ üzerinde"
                            },
                            {
                                "target_lang_word": "dağa",
                                "target_lang_sense_clarification": "dağ yönüne"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d5768002-9692-3816-a72c-6be42d356722",
                    "sense_definition": "Употребляется как первая часть сложных слов для обозначения того, что кто-либо или что-либо является плохим, ненастоящим или не заслуживает своего названия.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот <горе>-строитель испортил нам весь ремонт.",
                            "target_lang_translations": {
                                "en": "This <lousy> builder ruined our whole renovation.",
                                "tr": "Bu <w>beceriksiz</w> inşaatçı tüm tadilatımızı mahvetti."
                            }
                        },
                        {
                            "text": "Наш <горе>-руководитель совершенно не умеет управлять людьми.",
                            "target_lang_translations": {
                                "en": "Our <would-be> manager doesn't know how to manage people at all.",
                                "tr": "Bizim <w>sözde</w> yöneticimiz insanları yönetmeyi hiç beceremiyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "горе-мастер",
                        "горе-ученик",
                        "горе-охотник"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a prefix to indicate that someone or something is bad, fake, or incompetent.",
                        "tr": "Birinin veya bir şeyin kötü, beceriksiz veya adını hak etmeyen biri olduğunu belirtmek için birleşik kelimelerin ilk parçası olarak kullanılır."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lousy",
                                "target_lang_sense_clarification": "very poor quality (colloquial)"
                            },
                            {
                                "target_lang_word": "wannabe",
                                "target_lang_sense_clarification": "aspiring but lacking skill (colloquial)"
                            },
                            {
                                "target_lang_word": "would-be",
                                "target_lang_sense_clarification": "desiring or professing to be"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sözde",
                                "target_lang_sense_clarification": "gerçekte öyle olmayan"
                            },
                            {
                                "target_lang_word": "beceriksiz",
                                "target_lang_sense_clarification": "işini yapamayan"
                            },
                            {
                                "target_lang_word": "çakma",
                                "target_lang_sense_clarification": "sahte, kalitesiz (argo)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08af2224-7ad2-3002-9951-26c3e703ba2d",
                    "sense_definition": "Вверх, в вышину.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Священник возвёл очи <горе> и начал молитву.",
                            "target_lang_translations": {
                                "en": "The priest raised his eyes <upwards> and began the prayer.",
                                "tr": "Rahip gözlerini <w>göğe</w> dikti ve duaya başladı."
                            }
                        },
                        {
                            "text": "Дым от жертвенного костра поднимался <горе>.",
                            "target_lang_translations": {
                                "en": "Smoke from the sacrificial fire rose <on high>.",
                                "tr": "Kurban ateşinin dumanı <w>yukarıya</w> yükseliyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "вверх",
                        "кверху",
                        "высоко"
                    ],
                    "antonyms": [
                        "долу",
                        "вниз",
                        "книзу"
                    ],
                    "common_phrases": [
                        "очи горе",
                        "руки горе"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "poetic/high style"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Upwards, towards the sky or heights (archaic/poetic).",
                        "tr": "Yukarıya, göğe doğru (eski/edebi dil)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upwards",
                                "target_lang_sense_clarification": "towards a higher place"
                            },
                            {
                                "target_lang_word": "on high",
                                "target_lang_sense_clarification": "in heaven or the sky"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yukarıya",
                                "target_lang_sense_clarification": "yukarı doğru"
                            },
                            {
                                "target_lang_word": "göğe",
                                "target_lang_sense_clarification": "gökyüzüne doğru"
                            }
                        ]
                    }
                }
            ]
        },
