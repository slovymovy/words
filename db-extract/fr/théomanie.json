                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d661b55e-ddfd-450d-ad14-8944266f48ae",
                        "entry_id": "a13b5d4c-58a3-3b56-8925-21f09385938c",
                        "tags": [
                            "plural"
