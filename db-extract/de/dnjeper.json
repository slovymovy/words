                "senses": [
                    {
                        "sense_id": "4fc19789-5b93-30c5-94ff-eacbb44b50fe",
                        "entry_id": "abcff48b-f14d-352c-8d48-60f952627e32",
                        "glosses": [
                            "mit 2.201 Kilometern der drittlängste Fluss in Europa, der durch Russland, Weißrussland und die Ukraine führt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "0687ef17-98c5-4d4f-bd5d-ccb90cd34137",
                                "sense_id": "4fc19789-5b93-30c5-94ff-eacbb44b50fe",
                                "text": "„Die Flüsse des Landes sind der Dnjeper, Dnjester, Bug, Ingul und Inguletz.“"
                            },
                            {
                                "example_id": "dc4fa632-c77c-4249-a350-b257388414a6",
                                "sense_id": "4fc19789-5b93-30c5-94ff-eacbb44b50fe",
                                "text": "„Um die Schreckensherrschaft zu brechen, setzten sich seit 16. Februar die Armeen der Mittelmächte noch einmal in Bewegung: aus Galizien und Wolhynien rückten deutsche Truppenteile, denen später auch Österreicher nachfolgten, in die Ukraine ein und säuberten Kiew und alles Gebiet bis an den Dnjeper und das Schwarze Meer einschließlich der Krim von seinen Bedrängern.“"
                            },
                            {
                                "example_id": "f6751658-e4aa-49ef-8621-944b03d224bc",
                                "sense_id": "4fc19789-5b93-30c5-94ff-eacbb44b50fe",
                                "text": "„Ich glaube, die meisten Rebellen haben Boote gestohlen und sich flussabwärts auf dem Dnjeper davongemacht.“"
                            },
                            {
                                "example_id": "9bf90244-a23b-4177-ad89-97b1bf5bc069",
                                "sense_id": "4fc19789-5b93-30c5-94ff-eacbb44b50fe",
                                "text": "„Das Herzogtum Warschau, 2778 Quadratmeilen, mit 3 774 000 Einwohnern, wäre nur der kleinere Teil des neuen Reiches gewesen, aber die ehemals polnischen Provinzen reichten bis an die Düna und den Dnjeper.“"
                            },
                            {
                                "example_id": "5cdef9c8-48ba-4579-9444-2ca1530c3a2d",
                                "sense_id": "4fc19789-5b93-30c5-94ff-eacbb44b50fe",
                                "text": "„Von Kiev zogen die Ungern weiter über den Dnjeper nach Pannonien, bemächtigten sich desselben und treten unter dem Namen der verheerenden Magyaren in der Geschichte auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
