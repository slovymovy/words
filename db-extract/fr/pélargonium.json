                                        "glosses": [
                                            "Any of various flowering plants of the genus Pelargonium, similar to (and often confused with) true geraniums, but less hardy and often cultivated as annuals for ornamental purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afab526f-e455-48c9-90fd-01d8555f41a6",
                                                "sense_id": "09f7198b-f7dd-3940-a427-db0a995af510",
                                                "text": "The growing of pelargoniums in this country is increasing and they are destined to come to the front and stay there. The pelargoniums that have been distributed during the past several years are giving great satisfaction, combining as they do new shades of color […]."
                                            }
                                        ]
