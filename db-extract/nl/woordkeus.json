                "translations": [
                    {
                        "translation_id": "70242af2-b866-48b8-a0e9-71914c57553b",
                        "source_entry_id": "93a5d9df-8529-3487-ac41-4e762feb1a7a",
                        "source_sense_id": "052b49a9-c235-3e4c-8eef-9449ca25c7dc",
                        "target_lang_word": "Wortwahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortwahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "111909ca-742c-3658-b980-81d5872edbb9",
                                        "entry_id": "4c801266-cd43-35b9-a583-7fbb0fc5467f",
                                        "glosses": [
                                            "(bewusste) Auswahl der Wörter, die man für eine mündliche oder schriftliche Äußerung benutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da53112-20d8-459f-9f5b-4b0fcdbe3751",
                                                "sense_id": "111909ca-742c-3658-b980-81d5872edbb9",
                                                "text": "Durch eine geschickte Wortwahl kann man harsche Kritik wie ein Lob aussehen lassen."
                                            },
                                            {
                                                "example_id": "31c1b7b5-ad6f-41d9-a831-d2aa52034248",
                                                "sense_id": "111909ca-742c-3658-b980-81d5872edbb9",
                                                "text": "„Als Stilblüte bezeichnet man Formulierungen, die durch einen Missgriff in der Wortwahl, Wortstellung oder durch Doppeldeutigkeit ungewollt komisch wirken. Viele angebliche Stilblüten sind Phantasieprodukte.“"
                                            },
                                            {
                                                "example_id": "d6c7e95f-bc4f-46fa-b9ea-9b300230e115",
                                                "sense_id": "111909ca-742c-3658-b980-81d5872edbb9",
                                                "text": "„Britting schrieb nicht in Mundart; seine künstlerisch komponierte Sprache spiegelt jedoch in Satzbau und Wortwahl Eigenheiten des süddeutschen Idioms.“"
                                            },
                                            {
                                                "example_id": "7793b879-afbe-4a32-afbc-0035b0d4ce93",
                                                "sense_id": "111909ca-742c-3658-b980-81d5872edbb9",
                                                "text": "„Doch auch wenn die Politiker von heute eine eher biedere Wortwahl treffen, so schaffen sie es dennoch, der deutschen Sprache immer wieder frische, neue Energie zu verleihen.“"
                                            },
                                            {
                                                "example_id": "ef6a3113-b978-47e0-adcb-7562e538b0ff",
                                                "sense_id": "111909ca-742c-3658-b980-81d5872edbb9",
                                                "text": "„Seine Betrachtungen prüften die Wortwahl und die Verwendung bildlicher Ausdrücke.“"
                                            },
                                            {
                                                "example_id": "194f091d-7af8-4577-be4b-e997badee787",
                                                "sense_id": "111909ca-742c-3658-b980-81d5872edbb9",
                                                "text": "„Ihr Tod war genauso wenig ein Unfall, wie mein Hintern ein Unfall ist, sagte ich zu Svanhvít und hoffte, dass sie nicht empfindlich war, eine klitzekleine Portion grober Wortwahl zu ertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
