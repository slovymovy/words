                        "entry_id": "16dcd479-ea99-3952-accf-fedc7a8b9e8b",
                        "glosses": [
                            "beweeglijk lichaamsdeel in de mond zoals die door een vrouwelijk persoon wordt gebruikt om te spreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0643455f-635e-4cec-945b-1c91af231f23",
                                "sense_id": "9c426550-a4c6-3d83-8a2d-1ba12b0e412e",
                                "text": "Zijn eerste cover: een foto van Cornelie Tollens van een vrouwentong die aan een raketijsje likt."
                            },
                            {
                                "example_id": "85f8b81d-298c-4dd7-9515-5135d87c0f22",
                                "sense_id": "9c426550-a4c6-3d83-8a2d-1ba12b0e412e",
                                "text": "Vrouwen vechten nooit. Vrouwen doen alles met hun mond. Een vrouwentong is vaak zo scherp als een pas afgebroken stuk glas."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5c681f2-a716-3248-bf75-3327bc6a54bb",
                        "entry_id": "16dcd479-ea99-3952-accf-fedc7a8b9e8b",
                        "glosses": [
                            "bepaald soort loofboom, Populus tremula, die inheems is in de Benelux en tot 35 meter hoog kan worden\\nOok gebruikt als benaming voor een blaadje van deze boom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b03afe-b1e9-4cef-8cd7-a4acf0c6da51",
                                "sense_id": "b5c681f2-a716-3248-bf75-3327bc6a54bb",
                                "text": "Wie niet gelooft dat het vooral mannen zijn die planten bijnamen geven, die moet die van de ratel­populier (Populus tremula) maar eens op zich laten inwerken: vrouwentong."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0a38434-84a9-3b1e-82a3-521a25372509",
                        "entry_id": "16dcd479-ea99-3952-accf-fedc7a8b9e8b",
                        "glosses": [
                            "bepaald soort vetplant, Dracaena trifasciata, die als kamerplant wordt gebruikt\\nOok gebruikt als benaming voor een blad van deze plant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13f938bb-dbf1-499c-b655-882f59655885",
                                "sense_id": "b0a38434-84a9-3b1e-82a3-521a25372509",
                                "text": "Toen mijn Nani [oma] naar Nederland reisde nam zij een plant mee die in Suriname beter bekend staat als de vrouwentong."
                            }
                        ]
                    }
