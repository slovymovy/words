        "fr-extract.jsonl": [
            {
                "entry_id": "f6704031-362f-382a-b8cb-6612c52a663e",
                "word": "antiterroriste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "372903e9-ed15-4f08-81b9-f35001607f12",
                        "entry_id": "f6704031-362f-382a-b8cb-6612c52a663e",
