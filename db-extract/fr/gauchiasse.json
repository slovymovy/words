                                            "derogatory",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7635b857-cf9c-4133-81c8-c7a175ecc0dd",
                                                "sense_id": "6a4c1131-2ea3-37ef-8e01-3ec89295988e",
                                                "text": "I agree, you were owned, libturd bitch!!!"
                                            },
                                            {
                                                "example_id": "070466c2-aff4-4368-a008-f2d1089e03d2",
                                                "sense_id": "6a4c1131-2ea3-37ef-8e01-3ec89295988e",
                                                "text": "What secret information? And what the fuck libturd?"
                                            },
                                            {
                                                "example_id": "c1fa7e21-54ac-4781-8a89-040fc0170a33",
                                                "sense_id": "6a4c1131-2ea3-37ef-8e01-3ec89295988e",
                                                "text": "If all of that bothers you so much, you libturd assholes should have come up with a nominee other than Hillary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "131dae2e-6bc1-450c-9ce9-8731771380b0",
