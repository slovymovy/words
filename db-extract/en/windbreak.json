                ],
                "senses": [
                    {
                        "sense_id": "f913bd8b-5746-3cdf-a6d5-5ef33d8394a1",
                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                        "glosses": [
                            "A hedge, fence or row of trees positioned to reduce wind damage to crops."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                        "glosses": [
                            "A sheet or stack of material used to protect people or fire from wind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6085be42-aec6-4987-8367-598072573d22",
                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                "text": "I built my windbreak on a second-story wooden deck, as you can see above, but it would work just as well at ground level."
                            },
                            {
                                "example_id": "7f3df31c-5d77-41d8-bd4d-cad960480918",
                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                "text": "Although Birdibil was warm in his family wungkurr or windbreak that night, lying next to a crackling fire and covered with some paperbark blankets (kawan), he had little sleep."
                            },
                            {
                                "example_id": "6ae7bdfc-29b9-4dc9-803b-7f8823fe60ae",
                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                "text": "A wide range of materials was used for windbreaks, including rigid bark sheets inserted in sand, piles of grass or foliage, and stone walls."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                        "glosses": [
                            "The act of breaking wind; flatulence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8478b154-9c4f-4944-93d4-e50e41d86ffc",
                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                "text": "(chapter title for chapter on flatulence)"
                            },
                            {
                                "example_id": "134f05a7-fb41-4aad-a2eb-890500225562",
                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                "text": "(see chapter title)"
                            },
                            {
                                "example_id": "1658470f-b4bb-45b4-91d3-aa5da3247039",
                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                "text": "(see title)"
                            },
                            {
                                "example_id": "e6c3dcd2-f50d-465f-a3f8-a6227978a914",
                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                "text": "Another of Roy's room-clearing wind breaks snapped my head back."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eec85c1-461d-4dde-a478-fbedbfed9c20",
                        "source_entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                        "source_sense_description": "hedge, fence or row of trees to reduce wind damage",
                        "target_lang_word": "brise-vent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brise-vent",
