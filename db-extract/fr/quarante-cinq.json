                                        "entry_id": "d7602926-71f7-3bcc-b16f-46af2cfad9b8",
                                        "glosses": [
                                            "die Kardinalzahl zwischen vierundvierzig und sechsundvierzig, welche mit dem Zahlzeichen 45 dargestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0286b921-be49-4c37-b603-7203b9b1e823",
                                                "sense_id": "876015ef-96b0-306e-8d5e-4a95e1760150",
                                                "text": "„In den letzten fünfzig Jahren sank der Anteil der Menschen, die in den Entwicklungsländern nicht genug zu essen hatten, von fünfundvierzig auf achtzehn Prozent.“"
                                            },
                                            {
                                                "example_id": "b232f621-8dc2-4389-8391-174a2572fe64",
                                                "sense_id": "876015ef-96b0-306e-8d5e-4a95e1760150",
                                                "text": "„Die Fußleisten sind geschnitzt und gefirnisst und fünfundvierzig Zentimeter hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
