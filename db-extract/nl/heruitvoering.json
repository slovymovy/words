                        "examples": [
                            {
                                "example_id": "b3042507-e251-44f9-9c0d-66695c74d92b",
                                "sense_id": "52a4dc70-81c2-346a-b699-ea46ea53d682",
                                "text": "\"Het is een triomf\", zegt Freek de Jonge. Hij komt uit de kleedkamer in Carré. Het is tien minuten voor de eenmalige heruitvoering van het werk van Neerlands Hoop, begonnen in 1968, in een cabaretrevolte samen met wijlen Bram Vermeulen."
                            },
                            {
                                "example_id": "8ab80f60-a902-4151-af53-13aa721334c8",
                                "sense_id": "52a4dc70-81c2-346a-b699-ea46ea53d682",
                                "text": "ENSCHEDE - De luchthaven Twente is in september de beoogde locatie voor de heruitvoering van de operette Insel der Träume uit 1938. De operette, die destijds in Gronau dankzij een unieke Nederlands-Duitse samenwerking in première ging, wordt uitgevoerd door het Amsterdamse gezelschap Opera aan het IJ."
                            }
