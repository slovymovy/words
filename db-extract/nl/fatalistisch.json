                "senses": [
                    {
                        "sense_id": "4b85300f-dfed-37f9-961d-9f374a26c3fa",
                        "entry_id": "2ef79dea-dde4-3924-99c2-6720b4172318",
                        "glosses": [
                            "betrekking hebbend op de neiging je neer te leggen bij het onvermijdelijk geachte noodlot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8cbc2b9-01ae-4cd1-8fa7-136db826f7a7",
                                "sense_id": "4b85300f-dfed-37f9-961d-9f374a26c3fa",
                                "text": "Alles pais en vree, tot Gary smoorverliefd wordt op Karole, de vriendin van zijn collega. Een liefde die wederzijds blijkt. Lea Seydoux speelt deze volkse en wulpse vrouw voortreffelijk en Tahar Rahim overtuigt als de even kwetsbare als stoere Gary. Een gebroken hart maakt fatalistisch. Een kerncentrale is dan de slechtst denkbare werkplek."
                            },
                            {
                                "example_id": "d7902eed-65f7-4829-be19-858402c4c941",
                                "sense_id": "4b85300f-dfed-37f9-961d-9f374a26c3fa",
                                "text": "Nick benadrukt dat als ze Duitsland willen gaan veroveren, dan moet dat nu gebeuren. De zanger is net 30 geworden en zou qua leeftijd betreft een paar jaar stil blijven staan. \"Het leven kan op elk moment afgelopen zijn – niet fatalistisch bedoeld – dus als je dingen wilt doen, dan moet je dat nú doen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78015deb-add0-46a1-b7a1-87723ef045b3",
                        "source_entry_id": "2ef79dea-dde4-3924-99c2-6720b4172318",
                        "source_sense_id": "4b85300f-dfed-37f9-961d-9f374a26c3fa",
                        "target_lang_word": "fatalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07c206db-0438-3b23-a5ac-d16aa3e7b901",
                                        "entry_id": "a45ec80e-4376-371c-95f6-438185b52ff2",
                                        "glosses": [
                                            "One who maintains that all things happen by inevitable necessity; a person who believes in fatalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de3ca73c-2e2a-47e3-b7cd-279580bae371",
                                                "sense_id": "07c206db-0438-3b23-a5ac-d16aa3e7b901",
                                                "text": "....it is that, with every day, my love for you increases—though that would seem to be almost an impossibility. Why should I not become a fatalist? Remember how, on the third day that we ascended the Shlangenberg, I was moved to whisper in your ear: 'Say but the word, and I will leap into the abyss.' Had you said it, I should have leapt. Do you not believe me?\""
                                            },
                                            {
                                                "example_id": "9e86723a-56ab-4c3e-8d40-fa6603f7cd7b",
                                                "sense_id": "07c206db-0438-3b23-a5ac-d16aa3e7b901",
                                                "text": "“Maybe the problem is that you’re a romantic,” says my former lover-slash-friend-slash-male-sensitivity-reader. “And maybe so are the other fatalists.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "333d07ef-abab-40f8-9277-f1620e85760b",
                        "source_entry_id": "2ef79dea-dde4-3924-99c2-6720b4172318",
