{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed8b73eb-9c70-346a-af47-44b61eee5b7e",
                    "sense_definition": "Башенные или большие комнатные часы с музыкальным боем, с мелодичным перезвоном.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "часы",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В новогоднюю ночь вся страна замирает и слушает кремлёвские <w>куранты</w>.",
                            "target_lang_translations": {
                                "en": "On New Year's Eve, the whole country holds its breath and listens to the Kremlin <w>chimes</w>."
                            }
                        },
                        {
                            "text": "Старинные <w>куранты</w> на городской ратуше громко били каждый час.",
                            "target_lang_translations": {
                                "en": "The old <w>chiming clock</w> on the town hall chimed loudly every hour."
                            }
                        }
                    ],
                    "common_phrases": [
                        "бой курантов",
                        "кремлёвские куранты"
                    ],
                    "target_lang_definitions": {
                        "en": "Tower or large indoor clocks with musical chimes or bells."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chiming clock",
                                "target_lang_sense_clarification": "clock that plays a chime"
                            },
                            {
                                "target_lang_word": "chimes",
                                "target_lang_sense_clarification": "striking or chiming clock/bells"
                            },
                            {
                                "target_lang_word": "carillon",
                                "target_lang_sense_clarification": "tower clock bells"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77bfd66b-4e5b-3fb2-86a2-c437a98c41b8",
                    "sense_definition": "Мелодичный звон или бой таких часов.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "звук",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сквозь открытое окно доносились размеренные <w>куранты</w> башенных колоколов.",
                            "target_lang_translations": {
                                "en": "Through the open window came the measured <w>chimes</w> of the tower bells."
                            }
                        },
                        {
                            "text": "В тишине старинного зала послышались мелодичные <w>куранты</w> напольных часов.",
                            "target_lang_translations": {
                                "en": "In the silence of the old hall, the melodious <w>chimes</w> of the grandfather clock were heard."
                            }
                        }
                    ],
                    "synonyms": [
                        "перезвон"
                    ],
                    "target_lang_definitions": {
                        "en": "The melodious ringing, striking, or chiming sound of such clocks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chimes",
                                "target_lang_sense_clarification": "melodic ringing sound"
                            },
                            {
                                "target_lang_word": "peal",
                                "target_lang_sense_clarification": "ringing sound of bells"
                            },
                            {
                                "target_lang_word": "tolling",
                                "target_lang_sense_clarification": "slow, rhythmic striking sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59efb4a6-97c3-369a-b3b7-74b33f595e9c",
                    "sense_definition": "Музыкальный механизм или система колоколов в башенных или комнатных часах.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "механизм",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный мастер тщательно настроил <w>куранты</w> башенных часов.",
                            "target_lang_translations": {
                                "en": "The experienced craftsman carefully tuned the tower clock's <w>carillon</w>."
                            }
                        },
                        {
                            "text": "Сложные старинные <w>куранты</w> состояли из множества маленьких колоколов.",
                            "target_lang_translations": {
                                "en": "The intricate antique <w>carillon</w> consisted of many small bells."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A musical striking mechanism or carillon set of bells inside a tower or room clock."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carillon",
                                "target_lang_sense_clarification": "musical bell mechanism"
                            },
                            {
                                "target_lang_word": "chime mechanism",
                                "target_lang_sense_clarification": "clockwork striking unit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}