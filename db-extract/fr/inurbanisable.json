                        "glosses": [
                            "Qui ne peut pas être urbanisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a94db9-44e3-4b5c-b2db-17856e535103",
                                "sense_id": "76873dbb-f2a8-3da4-a576-c7d656f9a0fb",
                                "text": "Ces terres souvent inurbanisables, dépourvues de tout lotissement préalable, sont parfois éloignées du centre d’une distance pouvant aller jusqu’à 20 kilomètres."
                            },
                            {
                                "example_id": "9d61a772-3ee8-41fe-a2d4-46d575cb618a",
                                "sense_id": "76873dbb-f2a8-3da4-a576-c7d656f9a0fb",
                                "text": "Les constructions le plus haut situées sont toujours là, quasiment intactes, protégées par de raides pentes inurbanisables."
                            },
                            {
                                "example_id": "7d3a1d85-8fad-4d3f-815d-342a78d2f326",
                                "sense_id": "76873dbb-f2a8-3da4-a576-c7d656f9a0fb",
                                "text": "Les migrants se retrouvent sans parcelles viabilisées pour la plupart et sont obligés de coloniser les zones non aedificandi, inurbanisables."
                            }
                        ]
                    }
