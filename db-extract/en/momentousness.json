    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4799adb5-b8cc-3775-983d-7445df4b1530",
                "word": "momentousness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b918aa66-d85a-3dff-b6ac-9eedc5702ba4",
                        "entry_id": "4799adb5-b8cc-3775-983d-7445df4b1530",
                        "glosses": [
                            "The quality of being momentous."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "59b881fb-e6df-4b4d-bfd9-79774c526bf8",
                                "sense_id": "b918aa66-d85a-3dff-b6ac-9eedc5702ba4",
                                "text": "There's a scene near the end in which our ensemble receives some wholesome wisdom from a woman selling balloons in the park, portrayed by Angela Lansbury. Her presence and the momentousness appended to it make no sense, because this role was very clearly conceived for Julie Andrews, who wanted no part in all this."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0dbdfd0-adbb-4937-b3c0-3fce9d39cc8c",
                        "source_entry_id": "4799adb5-b8cc-3775-983d-7445df4b1530",
                        "source_sense_id": "b918aa66-d85a-3dff-b6ac-9eedc5702ba4",
                        "source_sense_description": "quality of being momentous",
                        "target_lang_word": "Bedeutsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bedeutsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                        "entry_id": "431ced26-cfa0-3203-a0f6-60a849736903",
                                        "glosses": [
                                            "Eigenschaft, bedeutsam, wichtig, ausschlaggebend zu sein; Wichtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087414e0-12f3-4bb5-a149-274a73ee82fe",
                                                "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                                "text": "„In der Corona-Pandemie zeigt sich die ungeheure Bedeutsamkeit des Individuums in der modernen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "1840a7c7-73ee-44df-afee-b09a4862b93b",
                                                "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                                "text": "„Der Glanz und die Farbe stechen hervor und machen die Bedeutsamkeit des Anlasses deutlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                        "entry_id": "431ced26-cfa0-3203-a0f6-60a849736903",
                                        "glosses": [
                                            "Sinn von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16635d33-8716-462c-b47e-217d1f156cc9",
                                                "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                                "text": "„Ich wollte die tiefe Bedeutsamkeit von allem, was geschehen war, nicht abschwächen, deshalb schaltete ich weder den Fernsehapparat an noch nahm ich ein Buch zur Hand oder zerstreute mich auf irgendeine andere Weise.“"
                                            },
                                            {
                                                "example_id": "7fabda17-9cec-4ffb-8ccc-4f3318bb7158",
                                                "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                                "text": "„Die Idee der Feier war echt künstlerisch aufgefasst und geschmackvoll und glänzend ausgeführt; die musikalische Begleitung, die Dichtung gaben die tiefe Bedeutsamkeit des Festes schön und ansprechend wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c348e75-e8a7-45d7-aebb-863b977c82a4",
                        "source_entry_id": "4799adb5-b8cc-3775-983d-7445df4b1530",
                        "source_sense_id": "b918aa66-d85a-3dff-b6ac-9eedc5702ba4",
                        "source_sense_description": "quality of being momentous",
                        "target_lang_word": "Tragweite",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tragweite",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06f5eaa6-f05f-37d3-815d-7769f065cb6a",
                                        "entry_id": "f3dba9ac-ae9f-3889-8edc-5685ef6340e4",
                                        "glosses": [
                                            "die Entfernung, die etwas erreichen/überbrücken kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8110d57b-5977-4dec-9955-064182c78f86",
                                                "sense_id": "06f5eaa6-f05f-37d3-815d-7769f065cb6a",
                                                "text": "„Die Tragweite war wie in der vorhergegangenen Periode: Die Kerndistanz betrug bei den kleineren Geschützen 120 - 200 Schritt, bei den schweren und kurzen Karthaunen 350 - 400, bei den leichteren, aber längeren Schlangen bis 450 Schritt. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bfba5cc4-9f7e-3018-a515-3c1a0fa15d23",
                                        "entry_id": "f3dba9ac-ae9f-3889-8edc-5685ef6340e4",
                                        "glosses": [
                                            "die Entfernung, bis zu der ein Leuchtsignal gesehen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c817478-e518-34dd-a16e-483de8c3be81",
                                        "entry_id": "f3dba9ac-ae9f-3889-8edc-5685ef6340e4",
                                        "glosses": [
                                            "die Bedeutung, die etwas hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1041fd9f-5892-4232-8988-588e400fc743",
                                                "sense_id": "2c817478-e518-34dd-a16e-483de8c3be81",
                                                "text": "Die Tragweite seiner Entscheidung war ihm in keiner Weise bewusst."
                                            },
                                            {
                                                "example_id": "dac61a10-7890-45e9-8419-89389c58da3f",
                                                "sense_id": "2c817478-e518-34dd-a16e-483de8c3be81",
                                                "text": "„Die Tragweite solcher Ehrenbeleidigungen lässt sich auch daran erkennen, dass es schon im frühen Mittelalter Bußgeldsätze für den Gebrauch von Schimpfwörtern gab.“"
                                            },
                                            {
                                                "example_id": "095097e6-9229-4b97-9c90-134105740e86",
                                                "sense_id": "2c817478-e518-34dd-a16e-483de8c3be81",
                                                "text": "„Der Tragweite dieser Verfehlung waren sie sich schwerlich bewußt; denn in aller Arglosigkeit ließen sie die kleine Flottille sogar vor dem tarentinischen Hafen Anker werfen und waren deshalb sehr erstaunt, als die Tarentiner mit einem äußerst starken Akt der Selbsthilfe antworteten und eine Anzahl Schiffe kurzerhand versenkten.“"
                                            },
                                            {
                                                "example_id": "5cddae58-67a5-41f3-9810-737c113a86ac",
                                                "sense_id": "2c817478-e518-34dd-a16e-483de8c3be81",
                                                "text": "„Seine Träger haben ihn im Stich gelassen und der feindlichen Natur ausgeliefert - ein schlimmer Schock, dessen Tragweite nachträglich zu schildern fast unmöglich ist.“"
                                            },
                                            {
                                                "example_id": "96dec8f1-f965-43ad-a6b2-61dc6ea90ef1",
                                                "sense_id": "2c817478-e518-34dd-a16e-483de8c3be81",
                                                "text": "„Die ganze Tragweite dieser Entscheidung konnte ich als Achtjährige noch nicht ahnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b799fdad-8c41-4813-83de-b7fa30c66501",
                        "source_entry_id": "4799adb5-b8cc-3775-983d-7445df4b1530",
                        "source_sense_id": "b918aa66-d85a-3dff-b6ac-9eedc5702ba4",
                        "source_sense_description": "quality of being momentous",
                        "target_lang_word": "Wichtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wichtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3410d853-f7a4-3e47-a52d-8701410b2d42",
                                        "entry_id": "723de02a-de9c-3a25-b6ee-cde8e96d22d7",
                                        "glosses": [
                                            "Eigenschaft, bedeutsam, wichtig zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9814a7a2-aaf3-464c-a01e-c57a0ad6159e",
                                                "sense_id": "3410d853-f7a4-3e47-a52d-8701410b2d42",
                                                "text": "Eine Aufgabe von solcher Wichtigkeit kann ich nur dir zusprechen."
                                            },
                                            {
                                                "example_id": "559c5c38-4f58-45da-931d-904ee7a73167",
                                                "sense_id": "3410d853-f7a4-3e47-a52d-8701410b2d42",
                                                "text": "„Was andere die objektive Wichtigkeit der Kunst nennen, ist mir schnuppe, aber wo es gar keine Aufsichtsräte gibt, über Aufsichtsräte zu spotten, das würde mir gemein vorkommen.“"
                                            },
                                            {
                                                "example_id": "48a090e5-80f8-4632-9980-4788a14b40bd",
                                                "sense_id": "3410d853-f7a4-3e47-a52d-8701410b2d42",
                                                "text": "„Da wurde zum Beispiel nach der Wichtigkit einer Titelanrede für Priester gefragt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "d8a5bf65-24d3-3e42-81ee-9ae6e771e7c8",
                                        "entry_id": "723de02a-de9c-3a25-b6ee-cde8e96d22d7",
                                        "glosses": [
                                            "Eigenschaft, notwendig zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0833c515-8e5d-406c-a670-e11ec19934ab",
                                                "sense_id": "d8a5bf65-24d3-3e42-81ee-9ae6e771e7c8",
                                                "text": "Die Wichtigkeit dieses Schrittes hat er leider zu spät erkannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "b580aedc-4ac8-3bb9-b36c-99483dc80ad7",
                                        "entry_id": "723de02a-de9c-3a25-b6ee-cde8e96d22d7",
                                        "glosses": [
                                            "Eigenschaft, ausschlaggebend zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad446536-279e-4cc1-9840-07d17e11e8dc",
                                                "sense_id": "b580aedc-4ac8-3bb9-b36c-99483dc80ad7",
                                                "text": "Das ist nicht von großer Wichtigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "698373ae-4a4e-3447-98ac-c01f3b05f665",
                                        "entry_id": "723de02a-de9c-3a25-b6ee-cde8e96d22d7",
                                        "glosses": [
                                            "eine wichtige, bedeutsame Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e97fcd-04ee-4513-b504-fe54bb93fcaa",
                                                "sense_id": "698373ae-4a4e-3447-98ac-c01f3b05f665",
                                                "text": "Folgende Wichtigkeit hat er vergessen zu erwähnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "601e535e-63c4-35c9-a13a-9f2242d66ba2",
