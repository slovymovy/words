                        ]
                    },
                    {
                        "translation_id": "a7e6f077-2e9e-48cc-a307-61b3bc0be1d1",
                        "source_entry_id": "462ca9d8-4d66-380f-91c0-8a2911435fff",
                        "source_sense_id": "a8fb7e1b-2d59-310a-80f4-da7a26750711",
                        "target_lang_word": "Fotograf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fotograf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                        "entry_id": "8078ae2f-39fb-3956-9736-15810da72568",
                                        "glosses": [
                                            "Person, die sich beruflich mit dem Herstellen und Bearbeiten von Lichtbildern beschäftigt"
                                        ],
                                        "tags": [
                                            "(ungeschützte) Berufsbezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9adce3a5-b1c6-4662-961c-1c2c9cc2b486",
                                                "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                                "text": "„Der Gehirn-Anatom also, der auf ein der Leiche entnommenes Gehirn starrt, um hier Residuen von Gedanken zu finden, begeht von seinem Denken aus denselben Fehler, wie ein Fotograf, der aus Betrachtung einer Negativ-Platte Schlüsse auf die Natur — des Lichts ziehen wollte.“"
                                            },
                                            {
                                                "example_id": "35aa9e2b-6090-4da5-8808-68ef29d618f3",
                                                "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                                "text": "„Denn Herr Jürgens, der Standesbeamte von Glowitz, Kreis Stolp in Pommern, ist eigentlich der Fotograf unseres Kirchspiels, allgegenwärtig bei Taufen, Konfirmationen und Hochzeiten in den Dörfern ringsum.“"
                                            },
                                            {
                                                "example_id": "db96e323-a39e-4d5a-8512-749bcc3a6f46",
                                                "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                                "text": "„Jan erzählte von seinem Beruf, von den Vorzügen, von den Schwierigkeiten, sich als freier Fotograf zu etablieren.“"
                                            },
                                            {
                                                "example_id": "c91d357b-12cf-4c04-a15e-3d09d43032f0",
                                                "sense_id": "3841dfac-454d-35b4-b5b1-7a710ec02a8e",
                                                "text": "„Die Gang verstellte dem Fotografen den Weg und stellte ihm die Frage, was er denn hier mache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85842899-6eb8-4f59-af48-f1733c6f4bf6",
