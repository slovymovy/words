{
    "word_family": [
        "thematiek",
        "thematisch",
        "thematiseren"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4e0d4f8-c518-3869-a96c-322c188f6379",
                    "sense_definition": "Een onderwerp dat wordt behandeld in een gesprek, boek, film of discussie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>thema</w> van het boek is de vriendschap tussen twee jonge mannen.",
                            "target_lang_translations": {
                                "en": "The <w>theme</w> of the book is the friendship between two young men."
                            }
                        },
                        {
                            "text": "Tijdens de vergadering bespraken we een actueel <w>thema</w> over het milieu.",
                            "target_lang_translations": {
                                "en": "During the meeting, we discussed a current <w>topic</w> concerning the environment."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderwerp",
                        "issue",
                        "item"
                    ],
                    "common_phrases": [
                        "actueel thema",
                        "belangrijk thema",
                        "centraal thema"
                    ],
                    "target_lang_definitions": {
                        "en": "A subject that is treated in a conversation, book, film, or discussion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "theme",
                                "target_lang_sense_clarification": "recurring idea or subject in a work"
                            },
                            {
                                "target_lang_word": "topic",
                                "target_lang_sense_clarification": "subject of discussion or conversation"
                            },
                            {
                                "target_lang_word": "issue",
                                "target_lang_sense_clarification": "important topic or problem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0253104e-bab0-3a5b-acd1-e7702a69df4c",
                    "sense_definition": "Een herkenbare melodie of grondgedachte die de basis vormt van een muziekstuk of kunstwerk.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kunst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het muzikale <w>thema</w> werd herhaald in verschillende delen van de symfonie.",
                            "target_lang_translations": {
                                "en": "The musical <w>theme</w> was repeated in different parts of the symphony."
                            }
                        },
                        {
                            "text": "De componist varieert voortdurend op het hoofd <w>thema</w> van het stuk.",
                            "target_lang_translations": {
                                "en": "The composer constantly varies the main <w>theme</w> of the piece."
                            }
                        }
                    ],
                    "synonyms": [
                        "motief",
                        "grondgedachte"
                    ],
                    "common_phrases": [
                        "muzikaal thema",
                        "leidend thema"
                    ],
                    "target_lang_definitions": {
                        "en": "A recognizable melody or basic idea that forms the basis of a piece of music or artwork."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "theme",
                                "target_lang_sense_clarification": "main melody in music"
                            },
                            {
                                "target_lang_word": "motif",
                                "target_lang_sense_clarification": "recurring artistic or musical element"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1690f826-b9ec-3b5a-a1f8-5af1d5ae0524",
                    "sense_definition": "Het deel van een woord dat overblijft als men de uitgangen weglaat; de <w>stam</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "taalkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de taalkunde wordt de basis van een verbogen woord het <w>thema</w> genoemd.",
                            "target_lang_translations": {
                                "en": "In linguistics, the base of an inflected word is called the <w>stem</w>."
                            }
                        },
                        {
                            "text": "De studenten bestudeerden hoe het <w>thema</w> van het werkwoord verandert.",
                            "target_lang_translations": {
                                "en": "The students studied how the <w>stem</w> of the verb changes."
                            }
                        }
                    ],
                    "synonyms": [
                        "stam",
                        "woordstam"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The part of a word that remains when the endings are removed; the stem."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stem",
                                "target_lang_sense_clarification": "base part of a word in linguistics"
                            },
                            {
                                "target_lang_word": "theme",
                                "target_lang_sense_clarification": "inflectional base of a word"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}