                        "glosses": [
                            "Synonym of poker machine, an electronic game of chance played for money, especially slot machines."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "in-plural",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cdd6183d-fee7-4b59-98b0-254273cadd9b",
                                "sense_id": "f08d2fcb-0e90-3b0b-853c-c069b57c95a2",
                                "text": "For several decades until the early 1990s, Echuca–Moama existed in the consciousness of Melburnians as the destination for pokie bus-trips. All of this changed when the Kennett Government legalised pokies in Victoria in 1993."
                            },
                            {
                                "example_id": "a22ee3e4-123f-4e91-af37-18648eacaf53",
                                "sense_id": "f08d2fcb-0e90-3b0b-853c-c069b57c95a2",
                                "text": "2006, author not known, Sydney City Guide, Lonely Planet, page 148,\nIn reality, the cheap beer and walls of pokies attract anyone and everyone."
                            },
                            {
                                "example_id": "ad2ef600-9534-4356-b70a-1dcee44d071f",
                                "sense_id": "f08d2fcb-0e90-3b0b-853c-c069b57c95a2",
                                "text": "None of these people around me punching the pokies has walked in here today expecting to be a loser."
                            },
                            {
                                "example_id": "e8a96839-1ef0-46d2-8ba5-f02d7f3ac4a3",
                                "sense_id": "f08d2fcb-0e90-3b0b-853c-c069b57c95a2",
                                "text": "I was also shocked that the poker machines (which we call pokies back home) were on full display, as in Australia, they legally have to be in a separate room."
                            }
                        ]
                    }
