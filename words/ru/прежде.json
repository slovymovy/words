                            "target_lang_translations": {
                                "en": "The guests gathered <w>before</w> the appointed time.",
                                "zh": "客人们在预定时间<w>之前</w>就到了。",
                                "nl": "De gasten verzamelden zich <w>vóór</w> de afgesproken tijd.",
