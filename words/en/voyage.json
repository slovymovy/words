                            },
                            {
                                "target_lang_word": "путевые заметки",
                                "target_lang_sense_clarification": "записи о поездке"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "seyahatname",
                                "target_lang_sense_clarification": "gezi yazısı türündeki eser"
                            },
                            {
                                "target_lang_word": "gezi notları",
                                "target_lang_sense_clarification": "yolculuk sırasında tutulan kayıtlar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8685ae00-6e2b-34bf-8296-a05c112def21",
                    "sense_definition": "To go on a long journey.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "travel_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave crew <w>voyaged</w> across the ocean to find new lands.",
                            "target_lang_translations": {
                                "ru": "Отважная команда <w>отправилась в плавание</w> через океан в поисках новых земель.",
                                "tr": "Cesur mürettebat, yeni topraklar bulmak için okyanusu aşarak <w>deniz yolculuğuna çıktı</w>."
                            }
                        },
                        {
                            "text": "He <w>voyaged</w> through many strange countries before returning home.",
                            "target_lang_translations": {
                                "ru": "Он <w>странствовал</w> по многим диковинным странам, прежде чем вернуться домой.",
                                "tr": "Eve dönmeden önce birçok yabancı ülkede <w>seyahat etti</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "journey"
                    ],
                    "common_phrases": [
                        "voyage across",
                        "voyage through"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
