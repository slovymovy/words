                            {
                                "example_id": "b2380f3a-1028-4a32-ad0e-fcf934f44109",
                                "sense_id": "afec5d88-54e4-38e9-9d79-2554a52b733f",
                                "text": "De motivatie is er onverminderd. Er is op dit moment niets dat ze liever doet dan snowboarden. Op de overdekte skibaan van SnowWorld in Zoetermeer wijst ze naar de foto van een besneeuwde Alpentop. 'Dat is mijn kantoor, nog altijd.'"
                            },
                            {
                                "example_id": "10cd0418-98bb-44a4-96dc-f72d60799f65",
                                "sense_id": "afec5d88-54e4-38e9-9d79-2554a52b733f",
                                "text": "De voorzitter van de stichting Alpe d'HuZes, Johan van der Waal, maakte het recordbedrag vanavond op de Franse alpentop bekend. Het gaat om een voorlopige opbrengst. Het definitieve bedrag wordt op 7 oktober bekendgemaakt."
                            },
                            {
                                "example_id": "4b2d1696-f2c2-4cd1-875e-a617dbb933c0",
                                "sense_id": "afec5d88-54e4-38e9-9d79-2554a52b733f",
                                "text": "De politie en de hulpdiensten nemen vooralsnog geen maatregelen met het oog op het voorspelde noodweer dat donderdag in de Alpen losbarst, bevestigt de Nederlandse politieagent Wiger Gommers. Hij assisteert samen met collega Marcel Ooms 800 man van de Franse gendarmerie op de Alpentop."
                            },
                            {
                                "example_id": "4af835db-9507-4cf2-a141-7c4e5e6986e7",
                                "sense_id": "afec5d88-54e4-38e9-9d79-2554a52b733f",
                                "text": "Een windvlaag tuimelt over het bevroren graniet van een alpentop."
                            }
                        ]
