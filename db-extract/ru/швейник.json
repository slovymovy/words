                    },
                    {
                        "translation_id": "f1fc12f3-fd13-4fcb-8986-d3fe194df64f",
                        "source_entry_id": "350791f9-2a0f-398b-a120-f7e7f9ce0e19",
                        "source_sense_id": "e725b43c-150f-3cd9-ae16-8867f93be160",
                        "target_lang_word": "garment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7435d16-5701-3b6d-b207-fd404436aa10",
                                        "entry_id": "9c1c03d6-bddd-36d7-83a0-5941c4df9927",
                                        "glosses": [
                                            "A single item of clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb84280a-b181-456a-a7eb-e3a8f22a0490",
                                                "sense_id": "f7435d16-5701-3b6d-b207-fd404436aa10",
                                                "text": "The woman ſhall not weare that which pertaineth vnto a man, neither ſhall a man put on a womans garment: foꝛ all that doe ſo, are abomination vnto the Lord thy God."
                                            },
                                            {
                                                "example_id": "4e43d956-8991-4340-9c00-856d4f65aa13",
                                                "sense_id": "f7435d16-5701-3b6d-b207-fd404436aa10",
                                                "text": "This new-comer was a man who in any company would have seemed striking.[…]Indeed, all his features were in large mold, like the man himself, as though he had come from a day when skin garments made the proper garb of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58db220-5d4b-331b-8fa8-84c200ade179",
                                        "entry_id": "9c1c03d6-bddd-36d7-83a0-5941c4df9927",
                                        "glosses": [
                                            "The visible exterior in which a thing is invested or embodied."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab07759d-4243-4bf5-88a7-884f020857a4",
                                                "sense_id": "b58db220-5d4b-331b-8fa8-84c200ade179",
                                                "text": "The highest state in which the soul completely casts away its garment of flesh and becomes a disembodied spirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412097a1-b940-3948-a8f8-2d136900db80",
                                        "entry_id": "9c1c03d6-bddd-36d7-83a0-5941c4df9927",
                                        "glosses": [
                                            "Ellipsis of temple garment."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
