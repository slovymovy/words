    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f8a25cb-d4cb-3909-9a91-b1201787c76e",
                    "sense_definition": "Традиционная женская одежда в виде платья без рукавов, надеваемого поверх рубашки или на голое тело.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом она часто носит лёгкий ситцевый <w>сарафан</w> в цветочек.",
                            "target_lang_translations": {
                                "en": "In summer, she often wears a light cotton floral <w>sundress</w>."
                            }
                        },
                        {
                            "text": "На праздник девочка надела красивый русский <w>сарафан</w> с вышивкой.",
                            "target_lang_translations": {
                                "en": "For the holiday, the girl put on a beautiful Russian <w>sarafan</w> with embroidery."
                            }
                        }
                    ],
                    "synonyms": [
                        "платье"
                    ],
                    "common_phrases": [
                        "летний сарафан",
                        "русский сарафан",
                        "носить сарафан"
                    ],
                    "target_lang_definitions": {
                        "en": "A traditional sleeveless dress worn by women, typically over a shirt or on its own in summer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sundress",
                                "target_lang_sense_clarification": "a light, sleeveless dress for warm weather"
                            },
                            {
                                "target_lang_word": "sarafan",
                                "target_lang_sense_clarification": "specifically referring to the Russian traditional costume"
                            },
                            {
                                "target_lang_word": "pinafore dress",
                                "target_lang_sense_clarification": "a sleeveless dress intended to be worn over a blouse or top"
                            },
                            {
                                "target_lang_word": "jumper",
                                "target_lang_sense_clarification": "American English term for a sleeveless dress worn over a shirt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6024dbd3-f62a-3161-ae67-1352a63df85a",
                    "sense_definition": "Неформальный способ передачи информации от человека к человеку; сокращение от «сарафанное радио».",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "связь",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У этого фильма не было рекламы, но сработал хороший <w>сарафан</w>.",
                            "target_lang_translations": {
                                "en": "This movie had no advertising, but good <w>word of mouth</w> worked."
                            }
                        },
                        {
                            "text": "Мы узнали об этом мастере через <w>сарафан</w> от знакомых.",
                            "target_lang_translations": {
                                "en": "We found out about this craftsman through the <w>grapevine</w> from acquaintances."
                            }
                        }
                    ],
                    "synonyms": [
                        "сарафанное радио",
                        "молва"
                    ],
                    "common_phrases": [
                        "хороший сарафан",
                        "запустить сарафан"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal way of spreading information or news from person to person; short for 'word-of-mouth radio'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "word of mouth",
                                "target_lang_sense_clarification": "information passed naturally between people"
                            },
                            {
                                "target_lang_word": "grapevine",
                                "target_lang_sense_clarification": "an informal person-to-person means of circulating information or gossip"
                            },
                            {
                                "target_lang_word": "buzz",
                                "target_lang_sense_clarification": "informal excitement or talk about something among the public"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}