                                        "examples": [
                                            {
                                                "example_id": "d042c932-8d0a-45f8-a06f-574bd15f6ebd",
                                                "sense_id": "fe25411a-08f6-3d80-9841-3207c105fda5",
                                                "text": "The Yummies were the women who, next to the Starlets and Professional Have-It-Alls, Meredith envied most, and therefore half-despised. You could see them at the latte bars, drinking green tea smoothies, hoisting their fat-cheeked offspring from one hip to the other, comparing notes on washable diapers and baby-friendly resorts."
                                            }
