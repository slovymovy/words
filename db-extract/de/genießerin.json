                "senses": [
                    {
                        "sense_id": "8068857e-8475-3208-a7a2-360c7aab349f",
                        "entry_id": "1630257a-3824-3a32-beda-7a02bf5ca807",
                        "glosses": [
                            "weibliche Person, die zu genießen weiß; weibliche Person, die es liebt, bestimmte Dinge zu genießen (wie etwa gutes Essen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "304fcdea-03e2-4f9a-8048-141eac890788",
                                "sense_id": "8068857e-8475-3208-a7a2-360c7aab349f",
                                "text": "„In ihren Rezepten feiert die erfahrene Hobbyköchin und Genießerin Manuela Hager die Ehrlichkeit und Nachhaltigkeit der veganen Küche, baut aber auch ganz unkompliziert schmackhafte Alternativen für Flexitarier ein.“"
                            },
                            {
                                "example_id": "a41b12c9-c3bf-4f1a-a669-20c09e6d3f22",
                                "sense_id": "8068857e-8475-3208-a7a2-360c7aab349f",
                                "text": "„Die Rezepte in diesem Buch sind eine Essenz dessen, was mich als Köchin und Genießerin ausmacht.“"
                            },
                            {
                                "example_id": "eee83e4a-bf97-4961-872c-11bddb24bff1",
                                "sense_id": "8068857e-8475-3208-a7a2-360c7aab349f",
                                "text": "„Da sie eine große Genießerin kulinarischer Köstlichkeiten ist und Essen lange Zeit als eine ihrer Lieblingsbeschäftigungen ansah, beschloss sie, die zuerst vereinzelten Kurzgeschichten in einer Chronik zusammenzufassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
