                ],
                "senses": [
                    {
                        "sense_id": "1bc077a6-912e-330c-8973-f14490fbfc16",
                        "entry_id": "3dcd0e30-88a7-3fc1-81fc-39c28fa5a529",
                        "glosses": [
                            "Faire perdre son caractère coranique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea8ed80c-8f23-4c8f-9600-edbc3f6b1e4c",
                                "sense_id": "1bc077a6-912e-330c-8973-f14490fbfc16",
                                "text": "Il serait temps de décoraniser et de laïciser l'arabe littéraire."
                            },
                            {
                                "example_id": "2f727c22-65bf-4c2f-89e7-46b167afab7d",
                                "sense_id": "1bc077a6-912e-330c-8973-f14490fbfc16",
                                "text": "Les clivages sociaux ont sauté puisque les nobles eux-mêmes ont « décoranisé » partiellement, certes, leur descendance."
                            },
                            {
                                "example_id": "90c7ea0d-8165-4649-adad-389a16bd3bf2",
                                "sense_id": "1bc077a6-912e-330c-8973-f14490fbfc16",
                                "text": "Et que le Coran ait à fond pétri l’âme de la multitude musulmane, c’est tout de même à partir de lui que les chefs arabes actuels poussent leurs peuples à s’aligner sur les usages ennemis, les nôtres, tant vestimentaires qu’industriels, c’est-à-dire à se décoraniser."
                            }
                        ]
                    }
                ],
