                                            {
                                                "example_id": "03bcddff-a57f-40e6-8662-8124bd4fcff9",
                                                "sense_id": "817a8d2c-8bb1-3485-9e4a-73c10c5d871e",
                                                "text": "Israëlische ordetroepen hebben een Palestijnse demonstratie tegen de gehate afscheidingsmuur met traangas uiteengejaagd. De demonstratie was vandaag groter dan normaal, omdat de betogingen precies tien jaar geleden begonnen."
                                            },
                                            {
                                                "example_id": "82c09409-8663-4c91-a8b8-67f9fa99b861",
                                                "sense_id": "817a8d2c-8bb1-3485-9e4a-73c10c5d871e",
                                                "text": "De Britse straatartiest Banksy heeft een nieuw hotel geopend in Bethlehem. Een mooi uitzicht kan je wel vergeten, want vanuit alle kamers kijk je uit op controversiële afscheidingsmuur aan de grens van Israël"
                                            }
                                        ]
