                        "entry_id": "7cf7a073-dcca-3f7c-94c9-aaacf8e5047b",
                        "glosses": [
                            "Inflammation du tissu cellulaire sous-cutané, accompagnée de rougeur, de gonflement et de douleur, et qui se termine soit par résolution, soit par suppuration."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a28f5ae7-cc45-44e8-9573-7590a01f6bcb",
                                "sense_id": "1649e93c-b56c-3240-9ec8-0c2c11ac3e50",
                                "text": "Au-dessus du poignet, un phlegmon superficiel, bien circonscrit, semble déjà collecté."
                            },
                            {
                                "example_id": "4fe4e905-8210-478a-90a6-acd23a345866",
                                "sense_id": "1649e93c-b56c-3240-9ec8-0c2c11ac3e50",
                                "text": "Passer des heures à faire chauffer le coke, ça leur filait des brûlures dedans, dehors, des maladies des yeux, des phlegmons, tout un tas de trucs dégueulasses que les patrons attrapent jamais."
                            }
                        ]
                    }
