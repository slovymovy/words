{
    "word_family": [
        "surnamed",
        "surnaming"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70fcc6b4-8f90-3b88-ba5e-a7addbbb689d",
                    "sense_definition": "The hereditary name shared by members of a family and used to distinguish them from others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "family_name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write your first name and your <w>surname</w> on the top of the form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите ваше имя и <w>фамилию</w> в верхней части бланка."
                            }
                        },
                        {
                            "text": "Smith is a very common <w>surname</w> in many English-speaking countries.",
                            "target_lang_translations": {
                                "ru": "Смит — очень распространенная <w>фамилия</w> во многих англоязычных странах."
                            }
                        }
                    ],
                    "synonyms": [
                        "family name",
                        "last name"
                    ],
                    "common_phrases": [
                        "common surname",
                        "maiden surname",
                        "legal surname"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наследственное имя, общее для членов семьи и используемое для их отличия от других людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фамилия",
                                "target_lang_sense_clarification": "основное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad958a23-cf81-3d59-8602-d1410d33f0e3",
                    "sense_definition": "An additional name or epithet often derived from a person's quality, achievement, or place of origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "additional_name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was known by the <w>surname</w> of the Lionheart due to his bravery.",
                            "target_lang_translations": {
                                "ru": "Король был известен под <w>прозвищем</w> Львиное Сердце за свою храбрость."
                            }
                        },
                        {
                            "text": "In historical texts, a <w>surname</w> often referred to a descriptive epithet rather than a family name.",
                            "target_lang_translations": {
                                "ru": "В исторических текстах под <w>прозвищем</w> часто подразумевался описательный эпитет, а не фамилия."
                            }
                        }
                    ],
                    "synonyms": [
                        "epithet"
                    ],
                    "common_phrases": [
                        "historical surname"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительное имя или эпитет, часто происходящий от качеств человека, его достижений или места происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прозвище",
                                "target_lang_sense_clarification": "характеризующее имя"
                            },
                            {
                                "target_lang_word": "эпитет",
                                "target_lang_sense_clarification": "определение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b07021be-87eb-31cf-9f9e-c844afde848c",
                    "sense_definition": "A nickname or byname given to a person, place, or thing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "additional_name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city earned the <w>surname</w> of the Big Apple over many decades.",
                            "target_lang_translations": {
                                "ru": "За многие десятилетия город заслужил <w>прозвище</w> «Большое яблоко»."
                            }
                        },
                        {
                            "text": "He was often called by a <w>surname</w> that reflected his jovial personality.",
                            "target_lang_translations": {
                                "ru": "Его часто называли по <w>кличке</w>, отражавшей его веселый характер."
                            }
                        }
                    ],
                    "synonyms": [
                        "nickname"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кличка или прозвище, данное человеку, месту или предмету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прозвище",
                                "target_lang_sense_clarification": "неофициальное имя"
                            },
                            {
                                "target_lang_word": "кличка",
                                "target_lang_sense_clarification": "обиходное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc14fc52-4e07-3444-82c8-cfa33af9c9e7",
                    "sense_definition": "The third name of a citizen of ancient Rome, originally a nickname but later hereditary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "family_name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the name Marcus Tullius Cicero, Cicero is the <w>surname</w> or cognomen.",
                            "target_lang_translations": {
                                "ru": "В имени Марк Туллий Цицерон, Цицерон — это <w>когномен</w> или родовое прозвище."
                            }
                        },
                        {
                            "text": "Roman aristocrats often had a <w>surname</w> that indicated their specific branch of the clan.",
                            "target_lang_translations": {
                                "ru": "У римских аристократов часто было <w>прозвище</w>, указывавшее на конкретную ветвь их рода."
                            }
                        }
                    ],
                    "synonyms": [
                        "cognomen"
                    ],
                    "common_phrases": [
                        "Roman surname"
                    ],
                    "target_lang_definitions": {
                        "ru": "Третье имя гражданина Древнего Рима, изначально прозвище, но позже ставшее наследственным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когномен",
                                "target_lang_sense_clarification": "римское родовое прозвище"
                            },
                            {
                                "target_lang_word": "прозвище",
                                "target_lang_sense_clarification": "в контексте Рима"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c56f19b-df63-3574-85ec-608b011d0772",
                    "sense_definition": "To call or designate someone by a specific surname or epithet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was <w>surnamed</w> the Bold after his victory in the tournament.",
                            "target_lang_translations": {
                                "ru": "Рыцаря <w>прозвали</w> Смелым после его победы в турнире."
                            }
                        },
                        {
                            "text": "History has <w>surnamed</w> him the Great because of his many conquests.",
                            "target_lang_translations": {
                                "ru": "История <w>нарекла</w> его Великим за его многочисленные завоевания."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Называть или обозначать кого-либо определенной фамилией или эпитетом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прозвать",
                                "target_lang_sense_clarification": "дать прозвище"
                            },
                            {
                                "target_lang_word": "наречь",
                                "target_lang_sense_clarification": "торжественно назвать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "041ab861-c38a-3ab3-b088-14cb5c6de214",
                    "sense_definition": "To give a surname to a person or a group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local authorities decided to <w>surname</w> the foundling after the street where he was discovered.",
                            "target_lang_translations": {
                                "ru": "Местные власти решили <w>дать фамилию</w> подкидышу в честь улицы, на которой он был найден."
                            }
                        },
                        {
                            "text": "It was common practice to <w>surname</w> individuals based on their father's occupation.",
                            "target_lang_translations": {
                                "ru": "Было обычной практикой <w>давать фамилии</w> людям на основе профессии их отца."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать фамилию человеку или группе лиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать фамилию",
                                "target_lang_sense_clarification": "официально или по обычаю"
                            },
                            {
                                "target_lang_word": "называть по фамилии",
                                "target_lang_sense_clarification": "использовать фамилию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}