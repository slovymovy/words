                ],
                "senses": [
                    {
                        "sense_id": "15db9996-0f72-39cc-8158-044f64580398",
                        "entry_id": "b3120bc3-4fba-33ae-b992-a6f8e8278dda",
                        "glosses": [
                            "wild, uitgelaten, ondeugend, overmoedig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c0f47bd-5ebd-4171-9827-6ba6fb095007",
                                "sense_id": "15db9996-0f72-39cc-8158-044f64580398",
                                "text": "Je hebt je handen zeker vol aan dat baldadige kind, of niet?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adce0304-7342-4fa4-ad0a-0055971d6e81",
                        "source_entry_id": "b3120bc3-4fba-33ae-b992-a6f8e8278dda",
                        "source_sense_id": "15db9996-0f72-39cc-8158-044f64580398",
                        "source_sense_description": "wild, uitgelaten",
                        "target_lang_word": "wanton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wanton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8dceb2f-b994-30f3-88f3-d812199544be",
                                        "entry_id": "91c417b0-0f47-300e-8da5-90607df44360",
                                        "glosses": [
                                            "Undisciplined, unruly; not able to be controlled."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04f9a836-b04a-4811-9346-eb1ad3d81b28",
                                                "sense_id": "c8dceb2f-b994-30f3-88f3-d812199544be",
                                                "text": "As Flies to wanton Boyes are we to th' Gods, / They kill us for their sport."
                                            },
                                            {
                                                "example_id": "b8830579-b6ed-4246-94d4-9fd84c833acc",
                                                "sense_id": "c8dceb2f-b994-30f3-88f3-d812199544be",
                                                "text": "'Tis the cruel gripe, / That lean hard-handed poverty inflicts, / The hope of better things, the chance to win, / The wiſh to ſhine, the thirſt to be amus'd, / That at the found of Winter's hoary wing, / Unpeople all our counties, of ſuch herds, / Of flutt'ring, loit'ring, cringing, begging, looſe, / And wanton vagrants, as make London, vaſt / And boundless as it is, a crowded coop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4185a75-d438-3d1f-b77a-712535e27892",
                                        "entry_id": "91c417b0-0f47-300e-8da5-90607df44360",
                                        "glosses": [
                                            "Playful, sportive; merry or carefree."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39d833e0-b335-4fbf-8fb1-883f6ec25d05",
                                                "sense_id": "f4185a75-d438-3d1f-b77a-712535e27892",
                                                "text": "The grave simplicity of the philosopher was ill calculated to engage her wanton levity, or to fix that unbounded passion for variety, which often discovered personal merit in the meanest of mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2fc085f-84d6-3e40-8138-f109057190a0",
                                        "entry_id": "91c417b0-0f47-300e-8da5-90607df44360",
                                        "glosses": [
                                            "Lewd, immoral; sexually open, unchaste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "febe3403-9ea1-404b-b8aa-a7bbae74b774",
                                                "sense_id": "b2fc085f-84d6-3e40-8138-f109057190a0",
                                                "text": "if wenches will hang out lures for fellows, it is no matter what they suffer: I detest such creatures; and it would be much better for them that their faces had been seamed with the smallpox: but I must confess I never saw any of this wanton behaviour in poor Jenny [...]."
                                            },
                                            {
                                                "example_id": "61275162-9e65-4cf5-9e7c-33e881120709",
                                                "sense_id": "b2fc085f-84d6-3e40-8138-f109057190a0",
                                                "text": "I know I ought never to have dreamt of sending that valentine—forgive me, sir—it was a wanton thing which no woman with any self-respect should have done."
                                            },
                                            {
                                                "example_id": "5257314d-9d0b-482c-be47-5d76dd273fb4",
                                                "sense_id": "b2fc085f-84d6-3e40-8138-f109057190a0",
                                                "text": "People should not marry too young, because, if they do, the children will be weak and female, the wives will become wanton, and the husbands stunted in their growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d6c4a8-c5af-358f-b5ec-07672cd58ac2",
                                        "entry_id": "91c417b0-0f47-300e-8da5-90607df44360",
                                        "glosses": [
                                            "Capricious, reckless of morality, justice etc.; acting without regard for the law or the well-being of others; gratuitous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c546cac8-9521-42c0-80ca-0889f6251413",
                                                "sense_id": "58d6c4a8-c5af-358f-b5ec-07672cd58ac2",
                                                "text": "Edward himself, now thoroughly enlightened on her character, had no scruple in believing her capable of the utmost meanness of wanton ill-nature."
                                            },
                                            {
                                                "example_id": "2d883b28-9d17-429d-bea8-bde07f23d9b4",
                                                "sense_id": "58d6c4a8-c5af-358f-b5ec-07672cd58ac2",
                                                "text": "these developments in Gaza are a consequence of the state of siege that the tiny territory has been under – a society that has been fenced-in, starved, and seen its very fabric torn apart by unemployment and wanton military destruction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b737ad8-8c3d-3f18-b839-e2799bd03505",
                                        "entry_id": "91c417b0-0f47-300e-8da5-90607df44360",
                                        "glosses": [
                                            "Extravagant, unrestrained, excessive."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "685a4462-2ac8-4ace-bbcb-cc908f264329",
                                                "sense_id": "9b737ad8-8c3d-3f18-b839-e2799bd03505",
                                                "text": "the market price will rise more or less above the natural price, according as either the greatness of the deficiency, or the wealth and wanton luxury of the competitors, happen to animate more or less the eagerness of the competition."
                                            },
                                            {
                                                "example_id": "7d82f10a-b9dc-441f-afa9-e21118a2360f",
                                                "sense_id": "9b737ad8-8c3d-3f18-b839-e2799bd03505",
                                                "text": "But do not think it argues change of temper since I wrote the Frère review, or a wanton praise of one man and blame of another."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wanton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36d858f6-462b-3d90-b81a-eb4f13cf8eda",
                                        "entry_id": "fdc93c0b-812a-3785-8d23-89b5daec6dcb",
                                        "glosses": [
                                            "A pampered or coddled person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb77cb9-876f-4ed3-85cf-0f3939637b97",
                                                "sense_id": "36d858f6-462b-3d90-b81a-eb4f13cf8eda",
                                                "text": "I would have thee gone — / And yet no farther than a wanton's bird, / That lets it hop a little from her hand, / Like a poor prisoner in his twisted gyves, / And with a silken thread plucks it back again[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6927f3c-6d3b-39f1-ba5c-1a7028c2bf54",
                                        "entry_id": "fdc93c0b-812a-3785-8d23-89b5daec6dcb",
                                        "glosses": [
                                            "An overly playful person; a trifler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499a66d5-a62e-41df-a0a9-ffe2cdd60f20",
                                                "sense_id": "d6927f3c-6d3b-39f1-ba5c-1a7028c2bf54",
                                                "text": "you but dally, / I pray you passe with your best violence, / I am afeard you make a wanton of me."
                                            },
                                            {
                                                "example_id": "7f517438-6755-4eeb-8175-6c71e93f67fd",
                                                "sense_id": "d6927f3c-6d3b-39f1-ba5c-1a7028c2bf54",
                                                "text": "Peace, my wantons; he will do / More than you can aim unto."
                                            },
                                            {
                                                "example_id": "4e9bd920-fc2d-4548-94a0-151670f0f8a4",
                                                "sense_id": "d6927f3c-6d3b-39f1-ba5c-1a7028c2bf54",
                                                "text": "This quiet remark serves to remind one, among other things that, Dickens was not without his reasons for a spirit of distrust towards religion by law established, as well as towards sundry other forms of religion--the spirit which, especially in his early career, was often misunderstood as hostility to religion in itself, a wanton mocking at sacred things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef7e91d-1835-3c2c-8e69-c7982b971565",
                                        "entry_id": "fdc93c0b-812a-3785-8d23-89b5daec6dcb",
                                        "glosses": [
                                            "A self-indulgent person, fond of excess."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7150c1d-1484-36a3-9c3f-7837d1d613b5",
                                        "entry_id": "fdc93c0b-812a-3785-8d23-89b5daec6dcb",
                                        "glosses": [
                                            "A lewd or immoral person, especially a prostitute."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "426bd131-e7c8-4957-aac3-b8fe16e6afb2",
                                                "sense_id": "f7150c1d-1484-36a3-9c3f-7837d1d613b5",
                                                "text": "...paints with tremendous force the adulteries of the two wantons Aholah and Aholibah, Israel and Judah, and their love of strangers..."
                                            },
                                            {
                                                "example_id": "6176f9ae-b2ba-4936-a265-9a08c5d1d6e1",
                                                "sense_id": "f7150c1d-1484-36a3-9c3f-7837d1d613b5",
                                                "text": "However, terrible as it may seem to the tall maiden sisters of J.P.'s in Queen Anne houses with walled vegetable gardens, this courtesan, strumpet, harlot, whore, punk, fille de joie, street-walker, this trollop, this trull, this baggage, this hussy, this drab, skit, rig, quean, mopsy, demirep, demimondaine, this wanton, this fornicatress, this doxy, this concubine, this frail sister, this poor Queenie—did actually solicit me, did actually say ‘coming home to-night, dearie’ and my soul was not blasted enough to call a policeman."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wanton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f425a4b-d0f9-3a8d-a9c2-c9a100f37b7d",
                                        "entry_id": "8ca223b3-efb0-3c97-afc5-101a579a6fa0",
                                        "glosses": [
                                            "To rove and ramble without restraint, rule, or limit; to revel; to play loosely; to frolic."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7744374-8687-41c3-aaa4-38ac1229781d",
                                                "sense_id": "5f425a4b-d0f9-3a8d-a9c2-c9a100f37b7d",
                                                "text": "[…] We will fetch thee straight / Adonis painted by a running brook, / And Cytherea all in sedges hid, / Which seem to move and wanton with her breath / Even as the waving sedges play wi’ th’ wind."
                                            },
                                            {
                                                "example_id": "b20888f2-71e1-4509-8785-6c096a794f0d",
                                                "sense_id": "5f425a4b-d0f9-3a8d-a9c2-c9a100f37b7d",
                                                "text": "[…] Nature here / Wantond as in her prime, and plaid at will / Her Virgin Fancies […]"
                                            },
                                            {
                                                "example_id": "751556fe-639c-49f4-a6aa-d8fb3ff85d7b",
                                                "sense_id": "5f425a4b-d0f9-3a8d-a9c2-c9a100f37b7d",
                                                "text": "How merrily we would sally into the fields; and strip under the first warmth of the sun; and wanton like young dace in the streams […]"
                                            },
                                            {
                                                "example_id": "947e2d6a-d10f-45aa-b656-460f5963dcec",
                                                "sense_id": "5f425a4b-d0f9-3a8d-a9c2-c9a100f37b7d",
                                                "text": "As for her soft brown hair, it was free to wanton in the winds, save where a strip of velvet restrained it around her brows."
                                            },
                                            {
                                                "example_id": "9d80f336-590c-48e1-b2e4-f271865db88b",
                                                "sense_id": "5f425a4b-d0f9-3a8d-a9c2-c9a100f37b7d",
                                                "text": "It might well be, said Mrs. McNab, wantoning on with her memories […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95227551-75f7-31de-80e5-5ae256477975",
                                        "entry_id": "8ca223b3-efb0-3c97-afc5-101a579a6fa0",
                                        "glosses": [
                                            "To waste or squander, especially in pleasure (most often with away)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05742679-73ee-4f01-807b-1697e00aba2a",
                                                "sense_id": "95227551-75f7-31de-80e5-5ae256477975",
                                                "text": "The young man wantoned away his inheritance."
                                            },
                                            {
                                                "example_id": "57881089-a847-4ed7-8013-591fd2224b71",
                                                "sense_id": "95227551-75f7-31de-80e5-5ae256477975",
                                                "text": "[W]ith this money the King shall wanton away his time in pleasures […]"
                                            },
                                            {
                                                "example_id": "3c860e45-635e-4813-a481-50e3cff4af1f",
                                                "sense_id": "95227551-75f7-31de-80e5-5ae256477975",
                                                "text": "[…] Samson, having wantoned away his strength and paying the penalty […]"
                                            },
                                            {
                                                "example_id": "a37bf12c-fc3c-430d-a1ff-a20bd68e22eb",
                                                "sense_id": "95227551-75f7-31de-80e5-5ae256477975",
                                                "text": "And never would he wanton his cause away with wine."
                                            },
                                            {
                                                "example_id": "143bb089-d5de-47b1-8db3-95cbefc3b7a0",
                                                "sense_id": "95227551-75f7-31de-80e5-5ae256477975",
                                                "text": "1948, Digby George Gerahty (as Robert Standish), Elephant Walk, New York: Macmillan, 1949, Chapter 15, p. 214,\nIf either of us felt the respect for George that you imply by your manner, you know perfectly well that we wouldn’t have wantoned away the day as we have."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91c77b94-41fb-338c-a5cd-1b8c850d9479",
                                        "entry_id": "8ca223b3-efb0-3c97-afc5-101a579a6fa0",
                                        "glosses": [
                                            "To act wantonly; to be lewd or lascivious."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed246d20-a994-42cc-bdcc-50dba81deced",
                                                "sense_id": "91c77b94-41fb-338c-a5cd-1b8c850d9479",
                                                "text": "Be loving and courteous to your fellow Servants, not gigling or idling out your time, or wantoning in the society of men […]"
                                            },
                                            {
                                                "example_id": "b6423313-5c2e-44ac-bf38-4c559cd55fb1",
                                                "sense_id": "91c77b94-41fb-338c-a5cd-1b8c850d9479",
                                                "text": "Happy he that ſips Eternally ſuch Nectar dovvn, that unconfin'd may Lave, and VVanton there in ſateleſs Draughts of ever ſpringing Beauty— […]"
                                            },
                                            {
                                                "example_id": "662f8959-f689-4491-b346-2a43a3ec12e8",
                                                "sense_id": "91c77b94-41fb-338c-a5cd-1b8c850d9479",
                                                "text": "[…] whole herds or flocks of other women securely, and scarce regarded, traverse the park, the play, the opera, and the assembly; and though, for the most part at least, they are at last devoured, yet for a long time do they wanton in liberty, without disturbance or controul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wanton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a9d4160-7cc6-310c-808f-d8f1d0cee7c2",
                                        "entry_id": "901a1f40-5c2c-3ed2-babf-a626d8f039bc",
                                        "glosses": [
                                            "wonton (Chinese dumpling)"
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "Singapore"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae3075d6-4d15-40f2-b491-95c343897293",
                                                "sense_id": "9a9d4160-7cc6-310c-808f-d8f1d0cee7c2",
                                                "text": "Add wanton, chives and vegetables to broth and season with 1 tablespoon salt, ½ teaspoon sesame oil, and 1 chicken cube."
                                            },
                                            {
                                                "example_id": "c166752e-538f-4708-b263-d5efa0d94f28",
                                                "sense_id": "9a9d4160-7cc6-310c-808f-d8f1d0cee7c2",
                                                "text": "Spread mayonnaise sparingly on one side of each of the wantons. Now make a stepped sandwich so that you can see about one-third of each type of fish on your serving plate. Start with one wanton, mayonnaise-side up, cover with a slice of tuna add another wanton, mayonnaise-side up, leaving one-third of the tuna showing."
                                            },
                                            {
                                                "example_id": "40628690-c278-4562-bbbb-b071bce99fc8",
                                                "sense_id": "9a9d4160-7cc6-310c-808f-d8f1d0cee7c2",
                                                "text": "Dumplings, wanton, and spring rolls are typical Han foods."
                                            },
                                            {
                                                "example_id": "013d2c26-2305-4be3-bac8-2f3034a5d3c9",
                                                "sense_id": "9a9d4160-7cc6-310c-808f-d8f1d0cee7c2",
                                                "text": "I settled on Chinese takeout for dinner—vegetable lo mein, beef and broccoli, hot and sour soup with wantons and egg rolls."
                                            },
                                            {
                                                "example_id": "aab253da-9d9f-40c6-a5ab-2405387116fa",
                                                "sense_id": "9a9d4160-7cc6-310c-808f-d8f1d0cee7c2",
                                                "text": "Also in 2012, he [Joey Chestnut] consumed 390 shrimp wantons in eight minutes at the finale of the CP Biggest Eater Competition in Bangkok, Thailand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
