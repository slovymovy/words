                },
                {
                    "sense_id": "e854ea6d-50e9-31d1-96db-767ae5e58a76",
                    "sense_definition": "Im Inneren noch zartrosa und saftig gebraten, besonders bei Rindfleisch oder Steak",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Restaurant bestellt mein Vater sein Rumpsteak fast immer <w>medium</w> gebraten."
                        },
                        {
                            "text": "Wenn das Fleisch perfekt <w>medium</w> ist, bleibt es wunderbar saftig und zart."
                        }
                    ],
                    "synonyms": [
                        "rosa",
                        "à point"
                    ],
                    "antonyms": [
                        "blutig",
                        "durch",
                        "englisch",
                        "rare",
                        "well done"
                    ],
                    "common_phrases": [
                        "ein Steak medium braten",
                        "das Rinderfilet medium bestellen"
                    ]
                }
            ]
        }
    ]
}