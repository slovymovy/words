                "senses": [
                    {
                        "sense_id": "640391ea-065e-38cd-8217-55b40631b883",
                        "entry_id": "c92d74b1-6987-31e6-8b86-9d63ac6c0085",
                        "glosses": [
                            "selbsttätige oder technische Luftzirkulation in und aus einem Zelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99cfb636-96b6-42aa-91e3-5917cd90e8ad",
                                "sense_id": "640391ea-065e-38cd-8217-55b40631b883",
                                "text": "„Selbst in dieser Extremsituation war die Zeltlüftung gerade noch ausreichend wenn man die Außentüren auf läßt.“"
                            },
                            {
                                "example_id": "40ece84f-e355-4a39-81de-16383ee7c24a",
                                "sense_id": "640391ea-065e-38cd-8217-55b40631b883",
                                "text": "„Die Zeltlüftung wird nicht nur durch die Anzahl der Eingänge bestimmt, sondern auch durch gut konstruierte Lüfter. “"
                            },
                            {
                                "example_id": "cdd509bd-9159-49ae-9653-f82b0e147b63",
                                "sense_id": "640391ea-065e-38cd-8217-55b40631b883",
                                "text": "„Die Zeltlüftung ist begrenzt.“"
                            },
                            {
                                "example_id": "5905c925-0800-40d8-a524-314c68693333",
                                "sense_id": "640391ea-065e-38cd-8217-55b40631b883",
                                "text": "Stampfer Zelte bietet Zubehör wie Beheizung, Heizung, Lüftung, WC-Anlagen, Toiletten, Zeltwände, Bühnen, Zeltböden, Theken, Heizschirme, Heizcontainer, Kühlanlagen, Zeltlüftung im Bereich Baustellen, Bierzelt, Exklusivzelt, VIP-Zelt, Messezelt, Lagerzelt."
                            },
                            {
                                "example_id": "e0a9cdd3-c69d-43d3-a3c5-831ab7967694",
                                "sense_id": "640391ea-065e-38cd-8217-55b40631b883",
                                "text": "Dann schloss ich die Reißverschlüsse und beobachtete durch einen kleinen Schlitz in der Zeltlüftung, dass auch er gleich darauf losfuhr."
                            }
                        ],
                        "sense_index_json": "\"1\""
