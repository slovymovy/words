                    {
                        "sense_id": "f987a95f-1d4a-3cdf-a530-8d864208dc1e",
                        "entry_id": "fb0bd91d-526c-3793-aac7-38943534e78a",
                        "glosses": [
                            "iemand die door middel van verkiezingen is verkozen om de bevolking van een land te vertegenwoordigen in het parlement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71fb8d41-98e9-4795-aa3f-c3a8df7d6611",
                                "sense_id": "f987a95f-1d4a-3cdf-a530-8d864208dc1e",
                                "text": "De Duitse parlementariërs stemmen komende donderdag over het wetsvoorstel."
                            },
                            {
                                "example_id": "db1cef7f-dbef-4a31-833a-07c84e8536fd",
                                "sense_id": "f987a95f-1d4a-3cdf-a530-8d864208dc1e",
                                "text": "Vrij onverwacht stemden negentig Slowaakse parlementariërs voor de grondwetswijziging waarmee het land nog slechts twee genders erkent. „Dit is een zwarte dag voor Slowakije.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a71e09d2-e6b2-45a6-826a-9c67f8a88980",
                        "source_entry_id": "fb0bd91d-526c-3793-aac7-38943534e78a",
                        "source_sense_id": "f987a95f-1d4a-3cdf-a530-8d864208dc1e",
                        "source_sense_description": "iemand die door middel van verkiezingen is verkozen om de bevolking van een land te vertegenwoordigen in het parlement",
                        "target_lang_word": "Abgeordneter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abgeordneter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                        "entry_id": "320be795-09f7-3600-9b59-61e34b163d47",
                                        "glosses": [
                                            "gewähltes Mitglied einer parlamentarischen Versammlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a31a69c-c122-4cd9-b858-7a403a854df1",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Die Abgeordneten des Deutschen Bundestages werden in allgemeiner, unmittelbarer, freier, gleicher und geheimer Wahl gewählt.“"
                                            },
                                            {
                                                "example_id": "bdc2636b-df4a-4534-885c-8dcb44f8d089",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„MS Exchange ist ein sogenannte Groupware, mit deren Hilfe die Abgeordneten nicht nur Mails verschicken und empfangen können wie bisher, sondern auch ihre Adressbücher zentral verwalten und Termine miteinander abstimmen.“"
                                            },
                                            {
                                                "example_id": "621eb680-29c2-44b4-a9db-b4ff89c281cd",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Als junger Abgeordneter hielt ich in den Dörfern des westlichen Landkreises von Fürstenfeldbruck Bauernversammlungen im Trachtenanzug.“"
                                            },
                                            {
                                                "example_id": "962606fa-c9e3-4a71-ad68-66f6d0fd6204",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Am Sonntag, 9. Juni, wählen die Menschen in Deutschland ihre Abgeordneten im Europäischen Parlament.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49fb9a0f-5013-4fab-8b10-eecc2d6e83fb",
                        "source_entry_id": "fb0bd91d-526c-3793-aac7-38943534e78a",
                        "source_sense_id": "f987a95f-1d4a-3cdf-a530-8d864208dc1e",
                        "source_sense_description": "iemand die door middel van verkiezingen is verkozen om de bevolking van een land te vertegenwoordigen in het parlement",
                        "target_lang_word": "Parlamentarier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parlamentarier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93320495-d735-3575-b04c-ef17eafda843",
                                        "entry_id": "bd0d71a5-26be-37eb-93aa-e306f9a715f7",
                                        "glosses": [
                                            "gewählter Angehöriger eines bürgerlichen Parlamentes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132a38b3-589a-466b-8a12-bc229c63d377",
                                                "sense_id": "93320495-d735-3575-b04c-ef17eafda843",
                                                "text": "Vormittags kommen die Parlamentarier in Arbeitsgruppen zusammen und besprechen die Ausschusssitzungen."
                                            },
                                            {
                                                "example_id": "10f222b9-6f1e-451f-81ff-7659d47f1a05",
                                                "sense_id": "93320495-d735-3575-b04c-ef17eafda843",
                                                "text": "Malta stellt mit 400.000 Einwohnern fünf Europaabgeordnete, Deutschland mit ca. 80 Millionen 99 Parlamentarier."
                                            },
                                            {
                                                "example_id": "8c23d330-3b1f-4cf7-917a-708a67d8b85a",
                                                "sense_id": "93320495-d735-3575-b04c-ef17eafda843",
                                                "text": "Die Bundesregierung hat offiziell zu der Kleinen Anfrage der Bündnis-90/Die-Grünen-Fraktion und mehrerer Parlamentarier Stellung bezogen."
                                            },
                                            {
                                                "example_id": "5ab6990b-9924-45ac-8d92-ba02ae5672a7",
                                                "sense_id": "93320495-d735-3575-b04c-ef17eafda843",
                                                "text": "„Und in der Tatsache, dass nach Neuwahlen, wenn sich das Parlament neu konstituiert, der älteste Parlamentarier die erste Sitzung leitet, in der dann der Bundestagspräsident gewählt wird, der nicht mehr der Älteste sein muss und meist auch nicht ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
