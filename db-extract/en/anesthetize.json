                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dbb6c89-8574-49d1-a7d2-eb67f5352fc5",
                                                "sense_id": "93144499-0c02-38eb-baa2-71e556973663",
                                                "text": "Es ist nur ein kleiner Eingriff, für den der Patient aber trotzdem anästhesiert werden sollte."
                                            },
                                            {
                                                "example_id": "f4943ad1-17cc-46eb-aeed-301cccc375c4",
                                                "sense_id": "93144499-0c02-38eb-baa2-71e556973663",
                                                "text": "Als erstes wird die Hornhaut des Auges anästhesiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
