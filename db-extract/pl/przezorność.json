                    {
                        "translation_id": "941c3c90-15cb-43d2-b2e0-b50307764d8f",
                        "source_entry_id": "8bdaf161-7aef-3f3f-a30f-1d2a359129a1",
                        "source_sense_id": "73626b11-31ed-398f-b7e8-228ce5d6a907",
                        "target_lang_word": "Vorsicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorsicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                        "entry_id": "6ac3bc0f-6575-3a1d-a621-df7de79ddc1e",
                                        "glosses": [
                                            "Verhalten, bei dem man versucht, durch Wachsamkeit und/oder Zurückhaltung negative Folgen oder Schäden zu vermeiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af99a14-6bdd-477b-9d3a-3d82779f0c60",
                                                "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                                "text": "Im Straßenverkehr ist immer Vorsicht geboten."
                                            },
                                            {
                                                "example_id": "96b1fd1b-09d2-4d9b-8292-321d59069131",
                                                "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                                "text": "Man muss beim Umgang mit ihm immer einige Vorsicht walten lassen."
                                            },
                                            {
                                                "example_id": "83c8e2e7-d7b9-4b66-9ca8-85ebf777b391",
                                                "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                                "text": "„Keine Investition ohne vorherige Renditenkalkulation. Doch Vorsicht, wenn die Rendite-Versprechungen allzu vollmundig sind.“"
                                            },
                                            {
                                                "example_id": "5843dddf-b870-4f83-8c76-d59b8c3bd188",
                                                "sense_id": "4d7ea8a4-a33c-35c7-9a77-3e7c19415018",
                                                "text": "„Vorsicht und Aufmerksamkeit waren gefragt, um nicht in den Dreck zu treten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0da9938-ef64-3d3b-ba53-69923034e4a7",
                                        "entry_id": "6ac3bc0f-6575-3a1d-a621-df7de79ddc1e",
                                        "glosses": [
                                            "Hinweis auf eine Gefahr, meist als Ausrufesatz oder auf Schildern; Aufforderung zu [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95a7465-af6b-47c4-96ad-0e126d48f293",
                                                "sense_id": "f0da9938-ef64-3d3b-ba53-69923034e4a7",
                                                "text": "Vorsicht! Sonst fällst du noch die Treppe runter, Mensch."
                                            },
                                            {
                                                "example_id": "f70eff03-030a-4ea0-bc7c-85774b46b295",
                                                "sense_id": "f0da9938-ef64-3d3b-ba53-69923034e4a7",
                                                "text": "Auf einem Schild steht: Vorsicht vor herunterfallenden Lasten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88ed69c3-8314-4bb9-973b-6a305318f60a",
                        "source_entry_id": "8bdaf161-7aef-3f3f-a30f-1d2a359129a1",
                        "source_sense_id": "73626b11-31ed-398f-b7e8-228ce5d6a907",
                        "target_lang_word": "Umsicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umsicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                        "entry_id": "60645f6c-d455-370f-a483-88de3360a949",
                                        "glosses": [
                                            "das Beachten aller bedeutsamen Umstände, vorausschauendes Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c7df2f-b019-42fb-8e45-83b5a43bab00",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "Durch Umsicht werden Fehler vermieden."
                                            },
                                            {
                                                "example_id": "10f14003-206c-4dff-8476-3847746acde7",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "„Händler/innen haben mit der gebotenen Umsicht zur Einhaltung der anwendbaren Sicherheitsanforderungen beizutragen, indem sie insbesondere keine Produkte liefern, von denen sie wissen oder auf Grund der ihnen bei zumutbarer Sorgfalt zugänglichen Informationen wissen müssten, dass sie diesen Anforderungen nicht genügen.“"
                                            },
                                            {
                                                "example_id": "ca5bf55c-9967-40aa-95ae-2596f8b6550b",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "„Die goldene Regel des Drachenfliegens heißt, möglichst viel Umsicht walten lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                        "entry_id": "60645f6c-d455-370f-a483-88de3360a949",
                                        "glosses": [
                                            "Rundblick, Aussicht"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc035f98-3af8-4ee4-9446-1b2248bd01d2",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Von der Höhe des Damms, auf dem der Wettlauf gehalten wurde, bietet sich eine prachtvolle Umsicht dar.“"
                                            },
                                            {
                                                "example_id": "dc6d35c6-118d-469d-ba12-c4a91c79d117",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Erst 1845 hören wir von einem acht Meter hohen hölzernen Gerüst auf dem Gipfel, welches »eine fast unbeschränkte Umsicht gewähre«.“"
                                            },
                                            {
                                                "example_id": "fadc99af-3a69-4841-ba1c-89cd0e267ffa",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Denn die Aussicht von diesem Thurm ist so entzückend schön, so über alle Maßen reichhaltig, daß kein Berg in dem großen Riesengebirge diese herrliche Umsicht gewährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
