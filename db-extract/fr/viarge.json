                        ],
                        "examples": [
                            {
                                "example_id": "a3e8a62a-b2a0-48a9-a638-7e52fe4a6bfc",
                                "sense_id": "506091e6-0514-37ec-a2b7-fb3cc0f7a8d3",
                                "text": "Viarge, qu’il fait beau dehors !\nCette langue de nos minorités d’amitiés\nDe nos maximes, de nos fatigues\nDépêchons[-nous] viarge de Bon Yeu\nÀ la frencher à qui mieux mieux"
                            },
                            {
                                "example_id": "05e6e259-b4a5-4472-bb6e-28346322b0fc",
                                "sense_id": "506091e6-0514-37ec-a2b7-fb3cc0f7a8d3",
                                "text": "Viarge ! Son sacre préféré [à Pierre Bourgault], rarissime mais spectaculaire, lâché comme une bombe H dans un discours policé."
                            },
                            {
                                "example_id": "94cd366e-6091-4459-919b-304d947b1119",
                                "sense_id": "506091e6-0514-37ec-a2b7-fb3cc0f7a8d3",
                                "text": "Voyons, bout de viarge, vas-tu finir par accoucher ?"
                            }
                        ]
                    }
                ],
