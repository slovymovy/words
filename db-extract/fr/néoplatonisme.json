                ],
                "senses": [
                    {
                        "sense_id": "1a63a5dc-ea20-3997-b03a-c0847c2d366b",
                        "entry_id": "a0cfc75c-e52e-3bef-9327-0b25af185ae9",
                        "glosses": [
                            "Doctrine philosophique, élaborée à Rome à partir de 232 par Ammonios Saccas et surtout par Plotin pour tenter de concilier la philosophie de Platon avec certains courants de la spiritualité orientale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cfedd08-5082-4853-baae-aeb666b53e01",
                                "sense_id": "1a63a5dc-ea20-3997-b03a-c0847c2d366b",
                                "text": "Loin de paraître comme inconciliables avec la piété, les commentaires nouveaux pouvaient sembler à certains mystiques parisiens un compromis heureux entre le néoplatonisme augustinien, l’abélardisme aristotélicien et l’esprit positif des savants ou des astrologues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "587ad129-96db-4f53-ada9-6866c833b05a",
                        "source_entry_id": "a0cfc75c-e52e-3bef-9327-0b25af185ae9",
                        "source_sense_id": "1a63a5dc-ea20-3997-b03a-c0847c2d366b",
                        "target_lang_word": "Neuplatonismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuplatonismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4185b54-885d-3843-9f50-403d1cd0ab4a",
                                        "entry_id": "9b83d954-6697-3591-8a31-0b1736222eff",
                                        "glosses": [
                                            "eine spätantike philosophische Geistesströmung im 3. bis 6. Jahrhundert, die auf Platons Ideenlehre basierte und mit aristotelischem, stoischem und pythagoreischem Gedankengut angereichert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ff3b5a-1fde-4e62-bd59-26e1e1371664",
                                                "sense_id": "f4185b54-885d-3843-9f50-403d1cd0ab4a",
                                                "text": "Plotin ist wohl der bedeutendste Vertreter des Neuplatonismus."
                                            },
                                            {
                                                "example_id": "c7693008-07ee-4186-9ca0-da30e53a9ef2",
                                                "sense_id": "f4185b54-885d-3843-9f50-403d1cd0ab4a",
                                                "text": "„Hauptlehren des Neuplatonismus sind die mystisch-intuitive Erkenntnis des Höchsten, die Stufengliederung vom Höchsten, vom Ein und Alles bis zur Materie hinab und die Befreiung des stoffwechselgefesselten Menschen zur reinen Geistigkeit durch Ekstase oder Askese.“"
                                            },
                                            {
                                                "example_id": "69c710b5-beb1-4090-a015-781e40c44627",
                                                "sense_id": "f4185b54-885d-3843-9f50-403d1cd0ab4a",
                                                "text": "„Die bemerkenswerteste philosophische Strömung der Spätantike dagegen war vor allem von Platons Ideenlehre inspiriert. Wir nennen sie deshalb Neuplatonismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c127471a-fd07-44f7-822a-c283cae76d67",
                        "source_entry_id": "a0cfc75c-e52e-3bef-9327-0b25af185ae9",
