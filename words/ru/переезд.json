                                "target_lang_sense_clarification": "railway intersection (US)"
                            },
                            {
                                "target_lang_word": "grade crossing",
                                "target_lang_sense_clarification": "technical term"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bahnübergang",
                                "target_lang_sense_clarification": "Kreuzung von Straße und Schiene"
                            },
                            {
                                "target_lang_word": "Bahnübergang",
                                "target_lang_sense_clarification": "allgemeiner Begriff für Bahnübergang"
