                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "37dfb37f-a6ab-4144-b0b3-c924677580f7",
                        "entry_id": "1d9591b8-8e50-391b-9d16-29b37fbb1876",
                        "tags": [
                            "plural"
                        ],
                        "form": "spirulines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9597b68-6edd-35f5-a519-577bb4aecd59",
                        "entry_id": "1d9591b8-8e50-391b-9d16-29b37fbb1876",
                        "glosses": [
                            "Nom vernaculaire de deux genres différents de cyanobactéries filamenteuses (Arthrospira, exploité commercialement et alimentaire ; Spirulina, inexploité et sans intérêt alimentaire relevé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec24c1c-bc82-44e6-8059-b9ca2053297d",
                                "sense_id": "a9597b68-6edd-35f5-a519-577bb4aecd59",
                                "text": "La spiruline est une micro-algue riche en protéine, fer, acides aminés, chlorophylle…"
                            }
                        ]
                    },
                    {
                        "sense_id": "89ce39f0-8bb9-3a2b-830b-31fb270f2dd3",
                        "entry_id": "1d9591b8-8e50-391b-9d16-29b37fbb1876",
                        "glosses": [
                            "Aliment, ingrédient alimentaire ou complément alimentaire tiré des cyanobactéries du genre Arthrospira."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "386e89eb-f09e-48a9-bb7f-588c4cd14de0",
                                "sense_id": "89ce39f0-8bb9-3a2b-830b-31fb270f2dd3",
                                "text": "La spiruline, micro-algue d’eau douce, pousse de façon naturelle dans les eaux chaudes de lacs en Inde, au Tchad, au Mexique et est de plus en plus produite en Bretagne."
                            },
                            {
                                "example_id": "d35c2c13-240d-457c-bd1b-1cf84faf7293",
                                "sense_id": "89ce39f0-8bb9-3a2b-830b-31fb270f2dd3",
                                "text": "L’herbe de blé et la spiruline sont des ingrédients qui ont du caractère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5e88d1d-e1b3-48a1-9f19-21fdd1f844ee",
