                    {
                        "translation_id": "e80d3af0-a774-42ab-a503-d4343a4dfc44",
                        "source_entry_id": "06a86f7f-bec1-3170-8fe1-7f004366f472",
                        "source_sense_id": "ee274563-d8a8-330d-a72f-857e9be60133",
