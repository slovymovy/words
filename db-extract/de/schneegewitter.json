                ],
                "senses": [
                    {
                        "sense_id": "68071c7e-b32c-307a-99f1-fb76d517f48b",
                        "entry_id": "75792614-50b9-31ef-969d-ad53e7f52b6c",
                        "glosses": [
                            "Wetterphänomen mit Blitz, Donner, und (meist starkem) Schneefall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43e6ad3-cfd2-4ee6-a82e-9a0c2580d2e5",
                                "sense_id": "68071c7e-b32c-307a-99f1-fb76d517f48b",
                                "text": "„Schneegewitter sind ein seltenes meteorologisches Phänomen, da Gewitter ja meist durch große Temperaturunterschiede entstehen.“"
                            },
                            {
                                "example_id": "6542555d-b111-44b5-a138-42da640d6604",
                                "sense_id": "68071c7e-b32c-307a-99f1-fb76d517f48b",
                                "text": "„Nach Schneegewittern mit Blitz und Donner wurden für den späten Morgen allerdings wieder Sonnenschein und Temperaturen etwas über null erwartet.“"
                            },
                            {
                                "example_id": "b2dfd386-d1bb-43a0-b7bc-041318ecd221",
                                "sense_id": "68071c7e-b32c-307a-99f1-fb76d517f48b",
                                "text": "„Am Vortag hatte ein heftiger Schneesturm eingesetzt, der am Mittwoch auch von Schneegewittern begleitet wurde.“"
                            },
                            {
                                "example_id": "a885b5d4-86c2-4471-8971-02b6448c4faa",
                                "sense_id": "68071c7e-b32c-307a-99f1-fb76d517f48b",
                                "text": "„Ein Problem, so sieht es Klaus Hagmeyer, stellvertretender Leiter der Autobahnmeisterei Heidenheim, sei, dass es mittlerweile deutlich häufiger als früher zu plötzlichen Schneegewittern oder heftigen Schauern mit mehreren Zentimetern Schnee in wenigen Minuten komme.“"
                            },
                            {
                                "example_id": "ceefadb3-70c2-4b31-aee5-c908ef79d5e7",
                                "sense_id": "68071c7e-b32c-307a-99f1-fb76d517f48b",
                                "text": "„Schon beim Aufstieg am Tag zuvor waren wir in ein Schneegewitter geraten, es fiel unglaublich viel nasser, schwerer Schnee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
