{
    "word_family": [
        "dynamism",
        "dynamize",
        "dynamically",
        "dynamics",
        "dynamo",
        "dynamite",
        "thermodynamic",
        "aerodynamic",
        "hydrodynamic"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96613236-b1d0-315c-97e2-fa46b2c6b131",
                    "sense_definition": "Full of energy, enthusiasm, and new ideas; having a powerful personality.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>dynamic</w> and engaging speaker who always captures the audience's attention.",
                            "target_lang_translations": {
                                "ru": "Она — <w>динамичный</w> и обаятельный оратор, который всегда удерживает внимание аудитории.",
                                "zh": "她是一位<w>充满活力</w>且引人入胜的演讲者，总能抓住听众的注意力。"
                            }
                        },
                        {
                            "text": "The company is looking for a <w>dynamic</w> leader to help them expand into new markets.",
                            "target_lang_translations": {
                                "ru": "Компания ищет <w>энергичного</w> лидера, который поможет им выйти на новые рынки.",
                                "zh": "公司正在寻找一位<w>精力充沛</w>的领导者来帮助他们开拓新市场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "energetic",
                        "vibrant",
                        "vigorous",
                        "spirited",
                        "lively"
                    ],
                    "common_phrases": [
                        "dynamic leader",
                        "dynamic personality",
                        "dynamic speaker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный энергии, энтузиазма и новых идей; обладающий сильной личностью.",
                        "zh": "充满活力、热情和新想法；拥有强大的个性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "динамичный",
                                "target_lang_sense_clarification": "о человеке или характере"
                            },
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "активный и деятельный"
                            },
                            {
                                "target_lang_word": "напористый",
                                "target_lang_sense_clarification": "обладающий сильной волей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充满活力的",
                                "target_lang_sense_clarification": "形容人或性格"
                            },
                            {
                                "target_lang_word": "精力充沛的",
                                "target_lang_sense_clarification": "形容积极进取的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4276fa91-7f01-38cd-9729-0ba558407304",
                    "sense_definition": "Characterized by constant change, activity, or progress.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The business environment is <w>dynamic</w>, changing rapidly with the years and the seasons.",
                            "target_lang_translations": {
                                "ru": "Бизнес-среда <w>динамична</w> и быстро меняется с годами и сезонами.",
                                "zh": "商业环境是<w>动态</w>的，随着年份和季节的变化而迅速改变。"
                            }
                        },
                        {
                            "text": "A <w>dynamic</w> economy requires constant innovation to remain competitive in the global market.",
                            "target_lang_translations": {
                                "ru": "<w>Динамичная</w> экономика требует постоянных инноваций, чтобы оставаться конкурентоспособной на мировом рынке.",
                                "zh": "一个<w>动态</w>发展的经济体需要不断的创新，才能在全球市场中保持竞争力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "active",
                        "changing",
                        "fluid",
                        "variable"
                    ],
                    "antonyms": [
                        "static"
                    ],
                    "common_phrases": [
                        "dynamic environment",
                        "dynamic economy",
                        "dynamic process"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся постоянными изменениями, активностью или прогрессом.",
                        "zh": "以不断的变化、活动或进步为特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "динамичный",
                                "target_lang_sense_clarification": "быстро развивающийся"
                            },
                            {
                                "target_lang_word": "изменчивый",
                                "target_lang_sense_clarification": "постоянно меняющийся"
                            },
                            {
                                "target_lang_word": "активный",
                                "target_lang_sense_clarification": "находящийся в движении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动态的",
                                "target_lang_sense_clarification": "处于变化发展中的"
                            },
                            {
                                "target_lang_word": "活跃的",
                                "target_lang_sense_clarification": "处于运动状态的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "465d8baa-556f-32d5-a0b0-fdc422386fd0",
                    "sense_definition": "Relating to processes that happen at runtime rather than being fixed in advance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software uses <w>dynamic</w> allocation to manage memory more efficiently while the program runs.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение использует <w>динамическое</w> распределение для более эффективного управления памятью во время работы программы.",
                                "zh": "该软件使用<w>动态</w>分配来在程序运行时更有效地管理内存。"
                            }
                        },
                        {
                            "text": "Most home internet connections use <w>dynamic</w> IP addresses that change every time you reconnect.",
                            "target_lang_translations": {
                                "ru": "Большинство домашних интернет-соединений используют <w>динамические</w> IP-адреса, которые меняются при каждом переподключении.",
                                "zh": "大多数家庭互联网连接使用<w>动态</w>IP地址，每次重新连接时都会改变。"
                            }
                        }
                    ],
                    "antonyms": [
                        "static"
                    ],
                    "common_phrases": [
                        "dynamic allocation",
                        "dynamic IP address",
                        "dynamic content"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к процессам, которые происходят во время выполнения программы, а не задаются заранее.",
                        "zh": "指在程序运行时发生而非预先固定的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "динамический",
                                "target_lang_sense_clarification": "в программировании и ИТ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动态的",
                                "target_lang_sense_clarification": "计算机编程术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57e16f3d-f21b-30d0-a724-a81a0e86b1b9",
                    "sense_definition": "Relating to the volume of sound or musical notes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dynamic</w> marking in bar forty is forte, indicating the passage should be played loudly.",
                            "target_lang_translations": {
                                "ru": "<w>Динамическое</w> обозначение в сороковом такте — форте, что указывает на то, что отрывок следует играть громко.",
                                "zh": "第四十小节的<w>动态</w>标记是强音，表示这段音乐应该大声演奏。"
                            }
                        },
                        {
                            "text": "The singer's <w>dynamic</w> range allowed her to transition from a whisper to a powerful belt.",
                            "target_lang_translations": {
                                "ru": "<w>Динамический</w> диапазон певицы позволял ей переходить от шепота к мощному пению.",
                                "zh": "这位歌手的<w>动态</w>范围使她能够从耳语过渡到强有力的歌唱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dynamic range",
                        "dynamic marking"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "musical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к громкости звука или музыкальных нот.",
                        "zh": "与声音或音符的音量有关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "динамический",
                                "target_lang_sense_clarification": "о силе звука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动态的",
                                "target_lang_sense_clarification": "音乐中关于音量变化的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e184c345-ac08-3a37-a6bb-a138b291ba5d",
                    "sense_definition": "Of a verb: indicating an action or process rather than a state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the sentence 'I am running', the word 'run' is a <w>dynamic</w> verb because it describes an action.",
                            "target_lang_translations": {
                                "ru": "В предложении «Я бегу» слово «бежать» является <w>динамическим</w> глаголом, так как оно описывает действие.",
                                "zh": "在句子“我正在跑步”中，“跑”是一个<w>动态</w>动词，因为它描述了一个动作。"
                            }
                        },
                        {
                            "text": "Linguists distinguish between <w>dynamic</w> and stative verbs to explain grammatical progression.",
                            "target_lang_translations": {
                                "ru": "Лингвисты различают <w>динамические</w> глаголы и глаголы состояния, чтобы объяснить грамматическое развитие.",
                                "zh": "语言学家区分<w>动态</w>动词和状态动词来解释语法演变。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dynamic verb"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О глаголе: обозначающий действие или процесс, а не состояние.",
                        "zh": "指动词：表示动作或过程而非状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "динамический",
                                "target_lang_sense_clarification": "о типе глагола"
                            },
                            {
                                "target_lang_word": "глагол действия",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动态的",
                                "target_lang_sense_clarification": "语言学中关于动词类型的"
                            },
                            {
                                "target_lang_word": "动作动词",
                                "target_lang_sense_clarification": "语言学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7571c63-9ac7-3c1d-962a-eced8f3275ac",
                    "sense_definition": "The way in which people or things behave and react to each other in a particular situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should watch the <w>dynamic</w> between the husband and wife when they disagree on a topic.",
                            "target_lang_translations": {
                                "ru": "Вам стоит понаблюдать за <w>динамикой</w> отношений между мужем и женой, когда они не согласны друг с другом.",
                                "zh": "当夫妻双方在某个话题上意见不合时，你应该观察他们之间的<w>动态</w>。"
                            }
                        },
                        {
                            "text": "The group <w>dynamic</w> changed significantly after the new manager was hired last month.",
                            "target_lang_translations": {
                                "ru": "<w>Динамика</w> внутри группы значительно изменилась после того, как в прошлом месяце наняли нового менеджера.",
                                "zh": "上个月聘请了新经理后，团队的<w>动态</w>发生了显著变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interplay",
                        "interaction",
                        "workings"
                    ],
                    "common_phrases": [
                        "group dynamic",
                        "family dynamic",
                        "power dynamic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым люди или вещи ведут себя и реагируют друг на друга в определенной ситуации.",
                        "zh": "人们或事物在特定情境下相互行为和反应的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "динамика",
                                "target_lang_sense_clarification": "взаимоотношения в группе"
                            },
                            {
                                "target_lang_word": "взаимодействие",
                                "target_lang_sense_clarification": "характер общения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动态",
                                "target_lang_sense_clarification": "群体内部的互动关系"
                            },
                            {
                                "target_lang_word": "互动",
                                "target_lang_sense_clarification": "人际交往的性质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "038abb8e-43c0-3069-9591-0cc3b23cd239",
                    "sense_definition": "A force that stimulates change or progress within a system or process.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Market forces act as a powerful <w>dynamic</w> for innovation in the technology sector.",
                            "target_lang_translations": {
                                "ru": "Рыночные силы выступают в качестве мощной движущей <w>динамики</w> для инноваций в технологическом секторе.",
                                "zh": "市场力量是科技行业创新的强大<w>动力</w>。"
                            }
                        },
                        {
                            "text": "The study of fluid <w>dynamics</w> quantifies how different forces affect turbulent and laminar flows.",
                            "target_lang_translations": {
                                "ru": "Изучение <w>динамики</w> жидкостей количественно определяет, как различные силы влияют на турбулентные и ламинарные потоки.",
                                "zh": "流体<w>动力</w>学研究量化了不同力如何影响湍流和层流。"
                            }
                        }
                    ],
                    "synonyms": [
                        "force",
                        "impetus",
                        "driver"
                    ],
                    "common_phrases": [
                        "central dynamic",
                        "underlying dynamic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила, стимулирующая изменения или прогресс внутри системы или процесса.",
                        "zh": "在系统或过程中刺激变化或进步的力量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "динамика",
                                "target_lang_sense_clarification": "ход развития процесса"
                            },
                            {
                                "target_lang_word": "движущая сила",
                                "target_lang_sense_clarification": "фактор развития"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动力",
                                "target_lang_sense_clarification": "推动发展的因素"
                            },
                            {
                                "target_lang_word": "动态",
                                "target_lang_sense_clarification": "事物发展的过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}