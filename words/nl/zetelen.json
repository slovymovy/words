{
    "word_family": [
        "zetel",
        "zeteling",
        "hoofdzetel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7657c3ca-8e29-3cec-a4f7-97d7b0a123d3",
                    "sense_definition": "Een zetel bezitten en als lid functioneren in een parlement, raad of commissie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politiek_bestuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zal vanaf volgende maand in het Europees Parlement <w>zetelen</w>.",
                            "target_lang_translations": {
                                "en": "She will <w>sit</w> in the European Parliament starting next month."
                            }
                        },
                        {
                            "text": "Hij <w>zetelde</w> jarenlang in de gemeenteraad voor zijn partij.",
                            "target_lang_translations": {
                                "en": "He <w>held a seat</w> on the municipal council for his party for years."
                            }
                        }
                    ],
                    "synonyms": [
                        "zitting hebben"
                    ],
                    "common_phrases": [
                        "in het parlement zetelen",
                        "in de gemeenteraad zetelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hold a seat and function as a member in a parliament, council, or committee."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sit",
                                "target_lang_sense_clarification": "as a member of a parliament or council"
                            },
                            {
                                "target_lang_word": "to hold a seat",
                                "target_lang_sense_clarification": "in a legislative body or committee"
                            },
                            {
                                "target_lang_word": "to have a seat",
                                "target_lang_sense_clarification": "in a council or parliament"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1486e57b-8085-3dab-9175-a700f78ff2ec",
                    "sense_definition": "Gevestigd zijn of kantoor houden (van een organisatie, rechtbank of bedrijf).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "politiek_bestuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het Internationaal Gerechtshof <w>zetelt</w> in Den Haag.",
                            "target_lang_translations": {
                                "en": "The International Court of Justice <w>is based</w> in The Hague."
                            }
                        },
                        {
                            "text": "De raad van bestuur <w>zetelt</w> in het nieuwe hoofdkantoor.",
                            "target_lang_translations": {
                                "en": "The board of directors <w>is headquartered</w> in the new main office."
                            }
                        }
                    ],
                    "synonyms": [
                        "gevestigd zijn",
                        "resideren"
                    ],
                    "common_phrases": [
                        "in Den Haag zetelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be established, based, or have offices (of an organization, court, or company)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be based",
                                "target_lang_sense_clarification": "of an organization or court"
                            },
                            {
                                "target_lang_word": "to be headquartered",
                                "target_lang_sense_clarification": "of a company or board"
                            },
                            {
                                "target_lang_word": "to sit",
                                "target_lang_sense_clarification": "of a court or official body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c2e7057-9fb6-38d4-924c-11e14bb3e733",
                    "sense_definition": "Op een formele of plechtige wijze op een stoel of troon zitten.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "zitten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning <w>zetelt</w> op zijn troon tijdens de ceremonie.",
                            "target_lang_translations": {
                                "en": "The king <w>sits</w> on his throne during the ceremony."
                            }
                        },
                        {
                            "text": "De paus <w>zetelt</w> in het Vaticaan.",
                            "target_lang_translations": {
                                "en": "The pope <w>resides</w> in the Vatican."
                            }
                        }
                    ],
                    "synonyms": [
                        "zitten",
                        "resideren"
                    ],
                    "common_phrases": [
                        "op de troon zetelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Formeel of plechtig taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To sit on a chair or throne in a formal, solemn, or official manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sit",
                                "target_lang_sense_clarification": "on a throne or in a formal manner"
                            },
                            {
                                "target_lang_word": "to be enthroned",
                                "target_lang_sense_clarification": "sitting on a throne"
                            },
                            {
                                "target_lang_word": "to reside",
                                "target_lang_sense_clarification": "of a monarch or pope"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}