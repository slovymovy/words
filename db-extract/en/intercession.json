                    {
                        "translation_id": "e0dffc37-891c-414a-9e16-68787adb172a",
                        "source_entry_id": "4eac190e-c2ef-3181-b6bc-bdf2bb047a60",
                        "source_sense_description": "a prayer to God on behalf of another person",
                        "target_lang_word": "Fürbitte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fürbitte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1eb99a3f-777b-3f6e-9f3c-843d83ffcbb1",
                                        "entry_id": "0099c2be-b48b-3be2-845e-2906bc28e4d8",
                                        "glosses": [
                                            "Gebet für jemand anderen (sowohl im persönlichen Gebet als auch innerhalb der kirchlichen Liturgie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56f8431-2a0f-4f53-af79-b58e42edea2d",
                                                "sense_id": "1eb99a3f-777b-3f6e-9f3c-843d83ffcbb1",
                                                "text": "Diese Wünsche vertraue ich der Fürbitte der Heiligen Jungfrau, der Mutter des Erlösers an …"
                                            },
                                            {
                                                "example_id": "b518e1cb-a044-4171-ab6d-a5c6ac3a910f",
                                                "sense_id": "1eb99a3f-777b-3f6e-9f3c-843d83ffcbb1",
                                                "text": "„Ganze Kirchspiele hatten sich vereinigt und kamen 10, 20 und mehr Meilen weit her, um der schönen Mutter Gottes zu opfern und sich ihrer Fürbitte zu empfehlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e50b475a-6e54-466a-9119-b4919dad406f",
                        "source_entry_id": "4eac190e-c2ef-3181-b6bc-bdf2bb047a60",
                        "source_sense_description": "a prayer to God on behalf of another person",
                        "target_lang_word": "Fürsprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fürsprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a5a42fd-328d-312f-b4d4-a7af046f547b",
                                        "entry_id": "31d7b911-1e43-311c-b184-d966d47b838d",
                                        "glosses": [
                                            "Bemühung zugunsten einer anderen Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5997199c-461c-4b86-8fe1-d3f41db782d6",
                                                "sense_id": "0a5a42fd-328d-312f-b4d4-a7af046f547b",
                                                "text": "„Die Fürsprache eines Landtagsabgeordneten, so hoffte sie, würde vielleicht Eindruck machen und den Vater umstimmen.“"
                                            },
                                            {
                                                "example_id": "66f35227-5dc4-4e5e-867e-1ff4b805689e",
                                                "sense_id": "0a5a42fd-328d-312f-b4d4-a7af046f547b",
                                                "text": "„Die vier Männer Tschö Dan und Genossen hätten wiederholt Fürsprache gesucht und gebeten, sie maßvoll zu behandeln.“"
                                            },
                                            {
                                                "example_id": "3a9afec0-5ca3-4a8c-aab0-0d3265f8ec8b",
                                                "sense_id": "0a5a42fd-328d-312f-b4d4-a7af046f547b",
                                                "text": "„Dabei zeigte sie mir die Papiere einer anderen Dame, der sie ihre Fürsprache zugesagt hatte; aber sie versprach mir, sie mir zu opfern, und sie hielt Wort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
