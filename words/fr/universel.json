    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6403518c-bf8a-3cdc-91c7-baebb00f1639",
                    "sense_definition": "Qui s'étend ou s'applique à la totalité des êtres, des choses ou de l'espace.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "generalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suffrage <w>universel</w> permet à chaque citoyen adulte d'exprimer sa voix lors des élections."
                        },
                        {
                            "text": "La loi de la gravitation <w>universelle</w> régit le mouvement des planètes autour du Soleil."
                        }
                    ],
                    "synonyms": [
                        "général"
                    ],
                    "antonyms": [
                        "particulier",
                        "restreint"
                    ],
                    "common_phrases": [
                        "suffrage universel",
                        "gravitation universelle",
                        "exposition universelle"
                    ]
                },
                {
                    "sense_id": "9a3f084f-e619-36c3-a777-5be7ae4dfee5",
                    "sense_definition": "Qui est conçu pour s'adapter à plusieurs appareils, usages ou situations différents ; polyvalent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "polyvalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai acheté une télécommande <w>universelle</w> pour faire fonctionner mon téléviseur et mon lecteur."
                        },
                        {
                            "text": "Il emporte toujours un adaptateur <w>universel</w> lorsqu'il part en voyage à l'étranger."
                        }
                    ],
                    "synonyms": [
                        "polyvalent"
                    ],
                    "common_phrases": [
                        "télécommande universelle",
                        "adaptateur universel",
                        "clé universelle"
                    ]
                },
                {
                    "sense_id": "ff03b5c6-2287-3466-8981-7b19603bb84b",
                    "sense_definition": "Qui est partagé par l'ensemble des êtres humains ou reconnu à travers toutes les cultures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "humanite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La musique est souvent considérée comme un langage <w>universel</w> compris par tout le monde."
                        },
                        {
                            "text": "Le respect des droits humains représente une valeur <w>universelle</w> essentielle."
                        }
                    ],
                    "synonyms": [
                        "commun"
                    ],
                    "antonyms": [
                        "particulier"
                    ],
                    "common_phrases": [
                        "langage universel",
                        "valeur universelle"
                    ]
                },
                {
                    "sense_id": "71d30fce-8054-371d-8fa7-6213b8e50e8b",
                    "sense_definition": "Qui s'intéresse à tous les domaines du savoir ou possède des compétences très variées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "erudition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Léonard de Vinci était un esprit <w>universel</w> qui maîtrisait la peinture et l'ingénierie."
                        },
                        {
                            "text": "Ce penseur de la Renaissance cherchait à bâtir une science véritablement <w>universelle</w>."
                        }
                    ],
                    "synonyms": [
                        "érudit"
                    ],
                    "antonyms": [
                        "singulier"
                    ],
                    "common_phrases": [
                        "esprit universel",
                        "génie universel"
                    ]
                },
                {
                    "sense_id": "192fe898-7cd6-3405-a985-fa727e7e4954",
                    "sense_definition": "Qui affecte ou concerne un tout dans son intégralité.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "generalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à la terrible nouvelle, un effroi <w>universel</w> s'empara des membres de l'assemblée."
                        },
                        {
                            "text": "Un tremblement <w>universel</w> secoua tout son corps au moment de prendre la parole."
                        }
                    ],
                    "synonyms": [
                        "total"
                    ],
                    "antonyms": [
                        "particulier"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "d'un emploi littéraire ou vieilli pour désigner une émotion ou réaction totale"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cc95560-5ef2-38c1-a58e-535cd0453ee8",
                    "sense_definition": "En philosophie, concept général ou réalité abstraite commune à tous les individus d'une même catégorie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les philosophes médiévaux ont longuement débattu sur le statut ontologique de l'<w>universel</w>."
                        },
                        {
                            "text": "Dans son traité, il passe habilement de l'<w>universel</w> au cas particulier pour illustrer son propos."
                        }
                    ],
