                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d0d0420-d19d-404a-a479-7062845c5a85",
                                                "sense_id": "75fbb87b-ada7-367d-9da5-9f8040543082",
                                                "text": "Corde fondamentale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90928253-eda5-3e5f-b8ed-92526ab9ee33",
                                        "entry_id": "a3154b4e-c5fd-35af-820c-ed977b1230b6",
                                        "glosses": [
                                            "Segment joignant les deux extrémités d’un arc, en particulier d’un arc de cercle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f112515-2f4a-4f46-970f-344fa7cd094c",
                                                "sense_id": "90928253-eda5-3e5f-b8ed-92526ab9ee33",
                                                "text": "Toute corde partage le cercle en deux parties, égales ou inégales en surface, qui se nomment segments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb90faf4-ba2d-349b-8be0-70492ce37de5",
                                        "entry_id": "a3154b4e-c5fd-35af-820c-ed977b1230b6",
                                        "glosses": [
                                            "Fils dont le drap est tissu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88de9043-efe4-40d0-b06c-89c8cb8c4d70",
                                                "sense_id": "fb90faf4-ba2d-349b-8be0-70492ce37de5",
                                                "text": "Son habit est tout râpé, il montre la corde, il est usé jusqu’à la corde."
                                            },
                                            {
                                                "example_id": "306273bf-1bcb-4fd5-8784-d5158497df3c",
                                                "sense_id": "fb90faf4-ba2d-349b-8be0-70492ce37de5",
                                                "text": "Cet homme montre la corde, il fait voir qu’il en est aux expédients, à ses dernières ressources."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71459fa0-b3bb-3a07-93cc-313627fe8ebc",
                                        "entry_id": "a3154b4e-c5fd-35af-820c-ed977b1230b6",
                                        "glosses": [
                                            "Quantité de bois à brûler, qu’on mesurait autrefois avec une corde, et qui, à Paris, équivalait à 3,8 stères."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1b74dd-a25c-4353-b08b-e1b92110252e",
                                                "sense_id": "71459fa0-b3bb-3a07-93cc-313627fe8ebc",
                                                "text": "Cent cordes de bois."
                                            },
                                            {
                                                "example_id": "67dd15af-b6a4-43af-bef9-206efb50d841",
                                                "sense_id": "71459fa0-b3bb-3a07-93cc-313627fe8ebc",
                                                "text": "Avoir mené cette vie-là, avoir déjà vécu quatre années d’une autre guerre et se retrouver à espérer une corde de bois et à compter ses mégots !"
                                            },
                                            {
                                                "example_id": "655fc134-7d21-4206-a8fb-63755f08bb36",
                                                "sense_id": "71459fa0-b3bb-3a07-93cc-313627fe8ebc",
                                                "text": "Ici, le bois se compte par cordes, dont l’unité de mesure peut varier d’un canton à l’autre, une corde, aux Crozets, vaut quatre stères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4d187f1-2d8a-302e-9c03-df7b0682f546",
                                        "entry_id": "a3154b4e-c5fd-35af-820c-ed977b1230b6",
                                        "glosses": [
                                            "Un des cinq engins utilisés en gymnastique rythmique."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": []
                                    },
