{
    "word_family": [
        "ohnehin",
        "ohnedies"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "1bdc15c6-a7ff-323e-a348-ecfdc8c06e42",
                    "sense_definition": "Drückt das Fehlen, Nichtvorhandensein oder den Ausschluss von jemandem oder etwas aus (mit Akkusativ)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich trinke meinen Kaffee am liebsten schwarz und ganz <w>ohne</w> Zucker."
                        },
                        {
                            "text": "<w>Ohne</w> deine Hilfe hätte ich die schwere Prüfung sicher nicht bestanden."
                        }
                    ],
                    "synonyms": [
                        "außer",
                        "ausgenommen",
                        "exklusive"
                    ],
                    "antonyms": [
                        "mit",
                        "einschließlich",
                        "inklusive",
                        "samt"
                    ],
                    "common_phrases": [
                        "ohne Zweifel",
                        "ohne Grund",
                        "ohne Erfolg"
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "530fe571-0b4e-30b0-81bf-a94a269dee1b",
                    "sense_definition": "Leitet einen Nebensatz ein, der ein Nichtgeschehen oder einen fehlenden Begleitumstand ausdrückt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er verließ das Zimmer leise, <w>ohne</w> ein einziges Wort des Abschieds zu sagen."
                        },
                        {
                            "text": "Sie hat die schwere Aufgabe gelöst, <w>ohne</w> dass sie Hilfe brauchte."
                        }
                    ],
                    "common_phrases": [
                        "ohne zu zögern",
                        "ohne zu fragen"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "37e9fd00-f246-3233-8504-50c46df0be23",
                    "sense_definition": "Ohne die zuvor erwähnte Sache, Person oder Begleitung",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich mag moderne Technik sehr, aber im Urlaub kann ich auch gut <w>ohne</w> leben."
                        },
                        {
                            "text": "Hast du keinen Schirm dabei oder kommst du heute ganz <w>ohne</w> aus?"
                        }
                    ],
                    "common_phrases": [
                        "ganz ohne auskommen",
                        "auch ohne gehen"
                    ]
                }
            ]
        }
    ]
