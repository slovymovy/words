    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                "word": "gyre",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "73d74cd1-957a-4bca-9fcb-41f5a922dfad",
                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                        "tags": [
                            "plural"
                        ],
                        "form": "gyres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "718d3788-e125-3b46-b27c-b1a1e1361931",
                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                        "glosses": [
                            "A swirling vortex."
                        ],
                        "tags": [
                            "literary",
                            "poetic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "33a92c0d-f211-39a7-a7d9-a080390898dd",
                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                        "glosses": [
                            "A circular or spiral motion; also, a circle described by a moving body; a revolution, a turn."
                        ],
                        "tags": [
                            "literary",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "e67a51b6-ed49-4103-86cd-97247ae1fafd",
                                "sense_id": "33a92c0d-f211-39a7-a7d9-a080390898dd",
                                "text": "Quick, and more quick he ſpins in giddy Gires, / Then falls, and in much Foam his Soul expires."
                            },
                            {
                                "example_id": "03b2c751-9f0f-4cc5-a793-1191c937ac8c",
                                "sense_id": "33a92c0d-f211-39a7-a7d9-a080390898dd",
                                "text": "What is art, / But life upon the larger scale, the higher, / When, graduating up in a spiral line / Of still expanding and ascending gyres, / It pushes toward the intense significance / Of all things, hungry for the Infinite? / Art's life,—and where we live, we suffer and toil."
                            },
                            {
                                "example_id": "ef52bfb3-b668-4bb3-a729-691ac0968dcf",
                                "sense_id": "33a92c0d-f211-39a7-a7d9-a080390898dd",
                                "text": "Turning and turning in the widening gyre / The falcon cannot hear the falconer; / Things fall apart; the centre cannot hold; / Mere anarchy is loosed upon the world, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d8c754d7-24ce-34d9-ad4a-588a61d991a4",
                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                        "glosses": [
                            "Synonym of gyrus (“a fold or ridge on the cerebral cortex of the brain”)."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1082d88c-74ea-304d-b91a-0ac00026d407",
                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                        "glosses": [
                            "An ocean current caused by wind which moves in a circular manner, especially one that is large-scale and observed in a major ocean."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1c8866-f703-425e-a0e3-e2f914c8ddcc",
                                "sense_id": "1082d88c-74ea-304d-b91a-0ac00026d407",
                                "text": "Most ships that tried to cross the Pacific in the past would get stuck in the gyres and never make it out."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2906c975-9b6a-4c5a-b04b-204c403ef923",
                        "source_entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                        "source_sense_description": "swirling vortex",
                        "target_lang_word": "Strudel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                        "entry_id": "183c24c9-2a05-397e-9e77-2c47dfbf6776",
                                        "glosses": [
                                            "(kleiner) Wasserwirbel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfe762d-19b3-445d-b047-60e0e78f27e0",
                                                "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                                "text": "Durch den Strudel wurde das Boot in die Tiefe gezogen."
                                            },
                                            {
                                                "example_id": "0143b94f-f78f-4165-9ba7-f390fcbf0b04",
                                                "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                                "text": "„Wie benommen waren die Deutschen aus den kataklysmischen Strudeln des Krieges aufgetaucht, taub noch von den Explosionsgeräuschen der Fliegerbomben und Artilleriegranaten, abgestumpft durch die Tristesse der Umstände, erschöpft von der schieren Mühsal des Überlebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                        "entry_id": "183c24c9-2a05-397e-9e77-2c47dfbf6776",
                                        "glosses": [
                                            "gefüllte Teigspeise"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6be6c02-c6e2-43c8-9beb-53a3b6f070c6",
                                                "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                                "text": "Omas Strudel schmeckt einfach am besten."
                                            },
                                            {
                                                "example_id": "44d2a95c-d2d6-47b7-a377-9eb0590af3b7",
                                                "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                                "text": "„Sie backte die besten Strudel der Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
