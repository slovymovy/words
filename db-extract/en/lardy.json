                    },
                    {
                        "sense_id": "c4539d2f-d2bc-38d6-9b29-d502c34a821f",
                        "entry_id": "8c344682-0cef-3268-bfdb-a3564afdc26c",
                        "glosses": [
                            "Fat or overweight."
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a44f3df1-11e8-4681-8618-55d28ae2975e",
                                "sense_id": "c4539d2f-d2bc-38d6-9b29-d502c34a821f",
                                "text": "Well as you mentioned it. It's that fucking useless fat arse lardy bitch at Energis, you know the one who eats at [...]"
                            },
                            {
                                "example_id": "17349468-da00-4339-ac22-7809f868edaa",
                                "sense_id": "c4539d2f-d2bc-38d6-9b29-d502c34a821f",
                                "text": "Go back to snarfling down your microwave lasagna, you lardy bitch."
                            },
                            {
                                "example_id": "93f7650e-cc64-47b6-a652-296afed29afc",
                                "sense_id": "c4539d2f-d2bc-38d6-9b29-d502c34a821f",
                                "text": "Look, Jeffy didn't start this, you lardy bitch. He tried to tell you."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fce9f4c6-aae1-363b-8034-e6c8f93f0313",
                "word": "lardy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3b158f3d-f418-46ee-84db-b7f081213b30",
                        "entry_id": "fce9f4c6-aae1-363b-8034-e6c8f93f0313",
                        "tags": [
                            "plural"
