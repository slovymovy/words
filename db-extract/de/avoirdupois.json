                        "entry_id": "dabe41dc-ff3f-31b1-9499-f0ec782f9b7f",
                        "glosses": [
                            "Handelsgewicht im Vereinigten Königreich und Nordamerika, das 16 Ounces entspricht"
                        ],
                        "tags": [
                            "Metrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "632c0189-233a-4853-afae-a333b8ff1a3f",
                                "sense_id": "72d35a72-0c52-34af-86f4-bc98e3fcef47",
                                "text": "„In der englischen Rezeptur werden sowohl die Gewichte und Maße des Imperial- (auch Avoirdupois genannten) Systems wie auch diejenigen des alten Apothecaries System gebraucht, wobei zu berücksichtigen ist, daß flüssige Arzneimittel stets gemessen und nicht gewogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
