                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0135a0f3-a67e-48b4-8c56-3507f94ea3a8",
                        "source_entry_id": "b8625d2f-0697-308b-a38c-a996480956f2",
                        "source_sense_id": "aff0478b-a5cf-3983-8115-73acf6d918a1",
                        "source_sense_description": "Gynäkologie: erste Regelblutung, Menstruation",
                        "target_lang_word": "menarche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menarche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0b27986-18a2-356b-8c35-f5fa78bcd163",
                                        "entry_id": "1af7157a-ebc5-332f-8d73-8a7a382e1583",
                                        "glosses": [
                                            "The onset of menstruation; a girl's first period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e40683b-b6ac-4e04-ad62-37a3f605cee9",
                                                "sense_id": "f0b27986-18a2-356b-8c35-f5fa78bcd163",
                                                "text": "How old is she? Nine? Ten? The menarche is not far off – a hint of a bosom, poor child."
                                            },
                                            {
                                                "example_id": "5ed08204-4f42-4535-a0f8-e60076fb4b9e",
                                                "sense_id": "f0b27986-18a2-356b-8c35-f5fa78bcd163",
                                                "text": "The most potent and indeed dangerous of all menstrual blood was the menarche, the first day's flow of the first menstruation of a virgin girl."
                                            },
                                            {
                                                "example_id": "edee5066-ed16-4bc7-b29c-3555002e4036",
                                                "sense_id": "f0b27986-18a2-356b-8c35-f5fa78bcd163",
                                                "text": "Initiation is imagined, but the initiate is not the young girl in menarche, about to be wed to the moon, but a young man about to become a great hunter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4da8362-3c54-4e89-844a-14a9277afcaf",
                        "source_entry_id": "b8625d2f-0697-308b-a38c-a996480956f2",
                        "source_sense_id": "aff0478b-a5cf-3983-8115-73acf6d918a1",
                        "source_sense_description": "Gynäkologie: erste Regelblutung, Menstruation",
                        "target_lang_word": "ménarche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ménarche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbe7d8e6-997a-31ed-97b4-5e78ef5097d8",
                                        "entry_id": "daab44e5-ce58-3d69-8ac4-61adb3f17326",
                                        "glosses": [
                                            "Période où apparaissent les premières règles."
                                        ],
                                        "tags": [
                                            "Gynécologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a73f5c-629d-48d2-9be8-ea3862bffa47",
                                                "sense_id": "cbe7d8e6-997a-31ed-97b4-5e78ef5097d8",
                                                "text": "Dans un délai de cinq années suivant la ménarche, 90% des jeunes filles présenteront des cycles ovulatoires réguliers."
                                            },
                                            {
                                                "example_id": "eed1dabb-89e0-4ec7-b813-0ed0b54549e9",
                                                "sense_id": "cbe7d8e6-997a-31ed-97b4-5e78ef5097d8",
                                                "text": "Les cycles anovulatoires sont fréquents pendant les 12-18 mois qui suivent la ménarche et de nouveau durant la période qui précède la ménopause."
                                            },
                                            {
                                                "example_id": "ffc79062-4dab-43fc-b611-ca44949411d6",
                                                "sense_id": "cbe7d8e6-997a-31ed-97b4-5e78ef5097d8",
                                                "text": "Dans la plupart des cas, ça se passe comme ça : d’abord, votre corps atteint sa capacité de reproduction et vous commencez à avoir vos règles au cours de l’adolescence — la période de la première menstruation s’apelle la ménarche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca1789b3-ea41-3eae-8808-e20ea1ede40d",
                                        "entry_id": "daab44e5-ce58-3d69-8ac4-61adb3f17326",
                                        "glosses": [
                                            "Âge aux premières règles ^([1])."
                                        ],
                                        "tags": [
                                            "Gynécologie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6de76ec1-41d5-4438-a08f-726ddbadc798",
                        "source_entry_id": "b8625d2f-0697-308b-a38c-a996480956f2",
                        "source_sense_id": "aff0478b-a5cf-3983-8115-73acf6d918a1",
