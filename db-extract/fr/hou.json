                "forms": [],
                "senses": [
                    {
                        "sense_id": "c2a039ae-287c-3cd7-8e16-1aacb01cd3b1",
                        "entry_id": "cf71aaee-ac29-37f0-be97-256595c46bd8",
                        "glosses": [
                            "Suppose le cri d’un fantôme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8cf12ea-30c4-4845-9ee8-3ba12427a25d",
                                "sense_id": "c2a039ae-287c-3cd7-8e16-1aacb01cd3b1",
                                "text": "Il effrayait les enfants en criant « hou hou »."
                            }
                        ]
                    },
                    {
                        "sense_id": "97ba2416-a3ac-3194-9915-ef721449e622",
                        "entry_id": "cf71aaee-ac29-37f0-be97-256595c46bd8",
                        "glosses": [
                            "Onomatopée pour huer ou se moquer de quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0674c6dc-00d9-45c1-bfb3-4c6830220436",
                                "sense_id": "97ba2416-a3ac-3194-9915-ef721449e622",
                                "text": "Hou qu’ils sont vilains et dégénérés, ces pays riches!"
                            }
                        ]
                    },
                    {
                        "sense_id": "4a6f0c65-96c0-38c0-861e-c2db4c9e21ee",
                        "entry_id": "cf71aaee-ac29-37f0-be97-256595c46bd8",
                        "glosses": [
                            "Onomatopée pour signifier un doute ou une emphase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa0493aa-60e8-4e2e-881f-8a061b0c850f",
                                "sense_id": "4a6f0c65-96c0-38c0-861e-c2db4c9e21ee",
                                "text": "Quand ils sont arrivés, je te parle de ça, hou, ça remonte à loin, eh bien les niaqués savaient quasiment rien foutre."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
