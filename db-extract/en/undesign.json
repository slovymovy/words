                "senses": [
                    {
                        "sense_id": "161e8dbd-73bd-388a-828a-57298fa26289",
                        "entry_id": "5fa38db7-3503-3579-8804-bd40b31af630",
                        "glosses": [
                            "To reverse or fail to implement a design; to design something in a way that deliberately rejects the conventions of designing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde80343-1bca-4410-9d86-3581b6bbf805",
                                "sense_id": "161e8dbd-73bd-388a-828a-57298fa26289",
                                "text": "When not to design and when to undesign? When should we refuse to design something? Are there situations when the use of a particular technology, or even of any technology, is not beneficial?"
                            },
                            {
                                "example_id": "ba858e25-de17-42d0-b1a7-940202d03478",
                                "sense_id": "161e8dbd-73bd-388a-828a-57298fa26289",
                                "text": "If there is a design in these actions, it is to undesign—to provide supplies for recirculation and recontextualization in which a new meaning may be found."
                            }
                        ]
                    }
                ],
