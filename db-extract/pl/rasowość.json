                        "source_sense_id": "94b96397-d700-3754-b0aa-d90704456e71",
                        "target_lang_word": "чистокровность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чистокровность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3834e5ba-a3ca-346a-9a37-1d3deb2e88d3",
                                        "entry_id": "9f31baba-4c57-3c98-89c6-2041ccb7355b",
                                        "glosses": [
                                            "зоол., с.-х.; обладание чистой кровью, несмешанной породой"
                                        ],
                                        "tags": [
                                            "о домашних животных"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976d4f65-b560-4bfb-8aa5-465f52fdf251",
                                                "sense_id": "3834e5ba-a3ca-346a-9a37-1d3deb2e88d3",
                                                "text": "«Чѝстокро́вность», генетическая чистота сама по себе не определяет сохранения породных качеств."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2e06760-e8f0-3094-8af9-539b5c0581ce",
                                        "entry_id": "9f31baba-4c57-3c98-89c6-2041ccb7355b",
                                        "glosses": [
                                            "перен., чистота рода; принадлежность к старинной, знатной, родовитой династии"
                                        ],
                                        "tags": [
                                            "о человеке"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f48ba962-8ab5-45ab-a3ff-7bef9d9950eb",
                                                "sense_id": "f2e06760-e8f0-3094-8af9-539b5c0581ce",
                                                "text": "И заметьте, это не только справедливо, но и мудро: кто может поручиться за чѝстокро́вность своего рода?"
                                            },
                                            {
                                                "example_id": "3f7f92ba-084b-4986-8218-037d4ce4ed00",
                                                "sense_id": "f2e06760-e8f0-3094-8af9-539b5c0581ce",
                                                "text": "Чистокровные! Никогда не были в прислужниках князей! Чик и в деревне слышал разговоры о чѝстокро́вности того или иного крестьянского рода. Он сначала удивлялся этому, а потом объяснил это себе так. В Абхазии до революции было столько князей, что именно чѝстокро́вность крестьянского рода особенно ценилась."
                                            },
                                            {
                                                "example_id": "89b0ede0-6a00-4f77-ac0f-31b680b9cd58",
                                                "sense_id": "f2e06760-e8f0-3094-8af9-539b5c0581ce",
                                                "text": "Эта зоркость и памятливость особо обострена (у впечатлительного, начитанного) обстоятельствами семейного разорения, неурядиц, унизительной бедности, ущемлённостью тщеславного чувства своей родовитости, дворянской чѝстокро́вности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
