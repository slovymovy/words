                        "sense_id": "0698f64f-5b35-34b0-9cc9-0d6c7b5b762c",
                        "entry_id": "4d9196f5-f836-3157-ab80-a298b30eaaf0",
                        "glosses": [
                            "Dans une phase de cristal liquide où les molécules s’arrangent parallèlement par couches."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "08cd0c78-a5d7-450a-892b-2e2ddfbbc391",
                                "sense_id": "0698f64f-5b35-34b0-9cc9-0d6c7b5b762c",
                                "text": "Les cristaux liquides étant structurellement semblables aux formes que prend le savon en solution, cette phase est nommée smectique."
                            }
                        ]
                    }
