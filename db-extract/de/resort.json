                    {
                        "sense_id": "da20ecbc-abc2-3def-ad00-729c69bcdfd8",
                        "entry_id": "28d3ba40-217a-30f4-b50e-3946ff557f5f",
                        "glosses": [
                            "Hotel, das über großzügige, exklusive Vergnügungs- oder/und Freizeitanlagen verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9340ec68-29e5-4668-bc51-53721a3e8834",
                                "sense_id": "da20ecbc-abc2-3def-ad00-729c69bcdfd8",
                                "text": "In Thailand werden noch rund hundert vermutlich überwiegend deutsche Urlauber vermisst, die sich in einem Resort aufgehalten haben sollen."
                            },
                            {
                                "example_id": "d187676e-8a3b-47b3-85e1-d992d06eacac",
                                "sense_id": "da20ecbc-abc2-3def-ad00-729c69bcdfd8",
                                "text": "Wieder ist sehr wahrscheinlich eine ungesicherte Abflussvorrichtung in einem Pool des „Marmaris Resort Hotels“ einem Kind zum Verhängnis geworden."
                            },
                            {
                                "example_id": "ffb989a8-986b-4872-87c7-cb08d6d08d06",
                                "sense_id": "da20ecbc-abc2-3def-ad00-729c69bcdfd8",
                                "text": "„Mit Souveniers bepackt ziehen sie zu den mondänen Hotels, den teuren Resorts mit zahlungskräftigen Touristen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80dec3b2-34cc-447e-83d0-68fd7c3423d8",
                        "source_entry_id": "28d3ba40-217a-30f4-b50e-3946ff557f5f",
                        "source_sense_id": "da20ecbc-abc2-3def-ad00-729c69bcdfd8",
                        "source_sense_description": "Hotel, das über großzügige, exklusive Vergnügungs- oder/und Freizeitanlagen verfügt",
                        "target_lang_word": "resort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19e72420-dde4-3103-b37f-578ee246c8a5",
                                        "entry_id": "f476caf3-e328-3782-8fe6-8a65b16047d2",
                                        "glosses": [
                                            "A place where people go for recreation, especially one with facilities such as lodgings, entertainment, and a relaxing environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a2d44b-565c-4973-965a-17610b0830a7",
                                                "sense_id": "19e72420-dde4-3103-b37f-578ee246c8a5",
                                                "text": "Was it deliberate that the first week of October 1961 was chosen to conduct a national survey of passenger usage? Why October of all months, when the holiday season was over and families back at work and at school? Was this a fiddling of the figures to make an unfair case against rail-dependent resorts such as those in the West Country, Norfolk, Lincolnshire and East Yorkshire, where previously overloaded summer services would now only have a handful of locals on board?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeb62425-a72f-309d-bf0c-5e8a626671c0",
                                        "entry_id": "f476caf3-e328-3782-8fe6-8a65b16047d2",
                                        "glosses": [
                                            "Recourse, refuge (something or someone turned to for safety)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2470a5-9416-4260-8798-0cc57cf3a165",
                                                "sense_id": "eeb62425-a72f-309d-bf0c-5e8a626671c0",
                                                "text": "to have resort to violence"
                                            },
                                            {
                                                "example_id": "df4bd665-cc53-47a2-aa07-98eefa532f21",
                                                "sense_id": "eeb62425-a72f-309d-bf0c-5e8a626671c0",
                                                "text": "Ioyne with me to forbid him her reſort,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c342ae04-9feb-3bf6-9c9d-3c26b21fafa4",
                                        "entry_id": "f476caf3-e328-3782-8fe6-8a65b16047d2",
                                        "glosses": [
                                            "A place where one goes habitually; a haunt."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6509fda1-1f23-47fd-96b5-c1dc86730f0b",
                                                "sense_id": "c342ae04-9feb-3bf6-9c9d-3c26b21fafa4",
                                                "text": "Far from all reſort of mirth,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77e812b8-47d9-363a-a7ba-f8264636c9ce",
                                        "entry_id": "f476caf3-e328-3782-8fe6-8a65b16047d2",
                                        "glosses": [
                                            "A subdivision of Suriname; a division of the country's districts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "resort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7fd8693-e7ef-39db-8b3d-608e2c0a860c",
                                        "entry_id": "04071d4b-3395-3e64-a79c-0c54017136d9",
                                        "glosses": [
                                            "To have recourse (to), now especially from necessity or frustration."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09eca240-9b3f-4e33-b782-12f8fc994d92",
                                                "sense_id": "c7fd8693-e7ef-39db-8b3d-608e2c0a860c",
                                                "text": "The king thought it time to resort to other counsels."
                                            },
                                            {
                                                "example_id": "c365b2db-bb7d-479e-b205-791c3024ae0e",
                                                "sense_id": "c7fd8693-e7ef-39db-8b3d-608e2c0a860c",
                                                "text": "He resorted to his pint of wine for consolation, drank it all in a few minutes, and fell asleep on his arms, with his hair straggling over the table […]"
                                            },
                                            {
                                                "example_id": "42fb669c-4a9b-4a4d-b54d-1e483b2e61ec",
                                                "sense_id": "c7fd8693-e7ef-39db-8b3d-608e2c0a860c",
                                                "text": "Just beyond that station the first step is encountered and the rack resorted to, taking the line on a gradient of 1 in 9 over a steeply inclined bridge and through a spiral tunnel."
                                            },
                                            {
                                                "example_id": "61c454ec-8d34-462c-b848-a480b0751709",
                                                "sense_id": "c7fd8693-e7ef-39db-8b3d-608e2c0a860c",
                                                "text": "The North British Railway was always anxious to connect its line to Helensburgh Pier but the local residents would not permit their foreshore or promenade to be disfigured, so the company had to resort further east and on May 18, 1882, opened the railway pier and station at Craigendoran."
                                            },
                                            {
                                                "example_id": "9e7ecb36-1803-46bf-9111-ff7cf7d74b3d",
                                                "sense_id": "c7fd8693-e7ef-39db-8b3d-608e2c0a860c",
                                                "text": "Becoming more aware of the progress that scientists have made on behavioral fronts can reduce the risk that other natural scientists will resort to mystical agential accounts when they exceed the limits of their own disciplinary training."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a5b45d6-3a45-32bf-bd97-7c34dc4dfb59",
                                        "entry_id": "04071d4b-3395-3e64-a79c-0c54017136d9",
                                        "glosses": [
                                            "To fall back; to revert."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e38226a-43e2-4b3b-b8ae-e0783862cd67",
                                                "sense_id": "2a5b45d6-3a45-32bf-bd97-7c34dc4dfb59",
                                                "text": "But the Inheritance of the Son never reſorted to the Mother, or to any of her Anceſtors, but both ſhe and they were totally excluded from the Succeſſion."
                                            },
                                            {
                                                "example_id": "4e561de3-9de7-46d3-9e33-e2b3a0fdf43f",
                                                "sense_id": "2a5b45d6-3a45-32bf-bd97-7c34dc4dfb59",
                                                "text": "I eschew the idea of plugging in my laptop to take notes and resort to old-fashioned pen and paper instead, so that I can enjoy more of the view and not be distracted by bashing a keyboard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99d5781a-229c-3103-a5a6-5ce98a9c4649",
                                        "entry_id": "04071d4b-3395-3e64-a79c-0c54017136d9",
                                        "glosses": [
                                            "To make one's way, go (to)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50b253df-d85e-4635-8e2e-4c99a3bb2be4",
                                                "sense_id": "99d5781a-229c-3103-a5a6-5ce98a9c4649",
                                                "text": "The same daye went Jesus out off the housse, and sat by the seesyde, and moch people resorted unto him, so gretly that he went and sat in a shyppe, and all the people stode on the shoore."
                                            }
                                        ]
                                    }
                                ]
                            },
