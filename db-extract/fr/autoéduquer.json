                "senses": [
                    {
                        "sense_id": "b71d15f8-a7a4-384c-8c2d-6425bc076c9b",
                        "entry_id": "90f3a7c2-b8cd-3b23-ab89-c19171790c9d",
                        "glosses": [
                            "Faire en sorte que quelqu’un s’éduque soi-même."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "15aeefee-08b1-3495-860e-d997b705b5c4",
                        "entry_id": "90f3a7c2-b8cd-3b23-ab89-c19171790c9d",
                        "glosses": [
                            "S’éduquer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "35f5f3f3-87b4-482d-87dc-59cc5240f2d1",
                                "sense_id": "15aeefee-08b1-3495-860e-d997b705b5c4",
                                "text": "Si l'être humain est conçu comme étant tout à fait capable de s'autoéduquer, le rôle de l'éducateur-formateur devient évidemment très limité, sinon tout à fait nul."
                            },
                            {
                                "example_id": "dcd88c6d-2a38-4454-988e-5ed6306ddc50",
                                "sense_id": "15aeefee-08b1-3495-860e-d997b705b5c4",
                                "text": "Seulement, ce travailleur devra se déchaîner pour s'autoéduquer et se mettre à même de suivre les développements technologiques et ainsi rester compétitif sur le « télémarché »."
                            }
                        ]
                    }
