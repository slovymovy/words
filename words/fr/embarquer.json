    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8bfd302-ce00-337b-a0f6-30723976e093",
                    "sense_definition": "Monter à bord d'un navire, d'un avion ou d'un véhicule de transport pour entreprendre un déplacement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les passagers doivent <w>embarquer</w> dans l'avion vingt minutes avant le décollage."
                        },
                        {
                            "text": "Nous allons bientôt <w>embarquer</w> sur le ferry pour traverser la mer."
                        }
                    ],
                    "antonyms": [
                        "débarquer"
                    ],
                    "common_phrases": [
                        "embarquer à bord",
                        "embarquer dans l'avion"
                    ]
                },
                {
                    "sense_id": "010f67aa-6654-3fb0-8044-d4d3cf71ebd8",
                    "sense_definition": "Charger des marchandises ou faire monter des passagers dans un bâtiment ou un véhicule de transport.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipage a fini d'<w>embarquer</w> toutes les provisions nécessaires pour le voyage."
                        },
                        {
                            "text": "Le cargo fait escale dans ce port pour <w>embarquer</w> du matériel lourd."
                        }
                    ],
                    "antonyms": [
                        "débarquer"
                    ],
                    "common_phrases": [
                        "embarquer des passagers",
                        "embarquer des vivres"
                    ]
                },
                {
                    "sense_id": "ed38e1f2-9b69-3c0c-90e4-b4bf948fcac1",
                    "sense_definition": "S'engager ou entraîner autrui dans une affaire, un projet ou une aventure difficile ou risquée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a réussi à m'<w>embarquer</w> dans un projet complètement imprévu et audacieux."
                        },
                        {
                            "text": "Elle a refusé de s'<w>embarquer</w> dans cette négociation sans garanties solides."
                        }
                    ],
                    "common_phrases": [
                        "embarquer dans une aventure",
                        "embarquer dans une affaire"
                    ]
                },
                {
                    "sense_id": "1205cd65-e14f-389c-9d98-b723567b4d48",
                    "sense_definition": "Interpeller une personne et l'emmener au poste de police.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les agents de police ont fini par <w>embarquer</w> le suspect après une brève interpellation."
                        },
                        {
                            "text": "Le fauteur de troubles s'est fait <w>embarquer</w> sous le regard des riverains rassemblés."
                        }
                    ],
                    "common_phrases": [
                        "se faire embarquer",
                        "embarquer un suspect"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "0f5b03db-988f-3bc2-ae1b-7db795258582",
                    "sense_definition": "Laisser pénétrer une vague ou une masse d'eau par-dessus le bord, en parlant d'un navire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nautisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la tempête nocturne, le voilier a commencé à <w>embarquer</w> de l'eau par l'avant."
                        },
                        {
                            "text": "Une vague puissante s'est abattue sur la barque, qui a failli <w>embarquer</w> un gros paquet de mer."
                        }
                    ],
                    "common_phrases": [
                        "embarquer de l'eau",
                        "embarquer une lame"
                    ]
                }
            ]
        }
    ]
}