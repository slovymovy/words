                        "sense_id": "a2ce58ce-5c0c-3e21-8855-065e12edcb14",
                        "entry_id": "a5f55dd8-da0f-3fef-b5d5-80ee5108a340",
                        "glosses": [
                            "bepaald soort zoogdier, Ursus maritimus, een grote witte beer die van nature in het Noordpoolgebied leeft"
                        ],
                        "tags": [
                            "roofdieren"
                        ],
                        "examples": [
                            {
                                "example_id": "a41867d3-d818-4963-92ca-59165c06c39c",
                                "sense_id": "a2ce58ce-5c0c-3e21-8855-065e12edcb14",
                                "text": "Een witte ijsbeer."
                            },
                            {
                                "example_id": "922db234-0cdc-4b5c-9e3c-79e45f46f143",
                                "sense_id": "a2ce58ce-5c0c-3e21-8855-065e12edcb14",
                                "text": "De hele discussie over het gedrag van de ijsbeer was niet zo relevant omdat er op IJsland, afgezien van een verdwaald exemplaar op een ijsschots, normaal geen ijsberen voorkomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7edd1873-2310-42bb-a0b7-5b2f82d619ac",
                        "source_entry_id": "a5f55dd8-da0f-3fef-b5d5-80ee5108a340",
                        "source_sense_id": "a2ce58ce-5c0c-3e21-8855-065e12edcb14",
                        "source_sense_description": "bepaald soort zoogdier, Ursus maritimus",
                        "target_lang_word": "Eisbär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisbär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f857327f-4ad7-333b-9dea-6db00198754b",
                                        "entry_id": "91c5a01a-6649-3ec9-990e-0e8222b61564",
                                        "glosses": [
                                            "Bär mit weißem Fell, lebt in den nördlichen Polargebieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6837e9fa-2315-42d6-9d6d-e45df4e44a4e",
                                                "sense_id": "f857327f-4ad7-333b-9dea-6db00198754b",
                                                "text": "Eisbären jagen keine Pinguine, sondern Robben."
                                            },
                                            {
                                                "example_id": "ddd5f508-a5a9-46e8-b603-d97abcb0fedc",
                                                "sense_id": "f857327f-4ad7-333b-9dea-6db00198754b",
                                                "text": "Eine umfassende Erbgut-Analyse belegt, dass Eisbären bereits vor 600.000 Jahren lebten. Die Tiere sind fünfmal älter als gedacht und weniger eng mit Braunbären verwandt. […] Ursus maritimus war der heimliche Star unter Evolutionsbiologen: Unfassbar schnell, so glaubten Forscher, hatte sich der Eisbär den eisigen Gegebenheiten der Arktis angepasst."
                                            },
                                            {
                                                "example_id": "0aebdb33-adbc-4352-b857-9457c031a790",
                                                "sense_id": "f857327f-4ad7-333b-9dea-6db00198754b",
                                                "text": "Zwischen 20.000 und 25.000 Eisbären sollen in der Arktis leben. Genau weiß man es nicht, denn Eisbären sind schwer zu zählen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5315bb8a-04e3-468e-b6a6-4c9235f278e8",
                        "source_entry_id": "a5f55dd8-da0f-3fef-b5d5-80ee5108a340",
                        "source_sense_id": "a2ce58ce-5c0c-3e21-8855-065e12edcb14",
