                "senses": [
                    {
                        "sense_id": "acc9bed5-d8ea-30e7-bb1d-804db271d95c",
                        "entry_id": "32ad2fcd-c381-36a8-ac30-50a20f893665",
                        "glosses": [
                            "Griff am Hals, um einer Person die Luft zu nehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e249199b-2b11-432d-9a17-c792e06dbdd5",
                                "sense_id": "acc9bed5-d8ea-30e7-bb1d-804db271d95c",
                                "text": "„Elma konnte sich nur schwer vorstellen, wie Ása im Würgegriff Elísabets Hals umfasste.“"
                            },
                            {
                                "example_id": "59f2fdee-7f2a-4ecb-8604-97e866ce9146",
                                "sense_id": "acc9bed5-d8ea-30e7-bb1d-804db271d95c",
                                "text": "„Vor Cindys Augen packte er den Wachmann von hinten mit einem Würgegriff und schnitt ihm die Luftzufuhr ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53ca1cbc-821d-49cb-a341-a68e84e1854a",
                        "source_entry_id": "32ad2fcd-c381-36a8-ac30-50a20f893665",
                        "source_sense_id": "acc9bed5-d8ea-30e7-bb1d-804db271d95c",
                        "source_sense_description": "Griff am Hals, um einer Person die Luft zu nehmen",
                        "target_lang_word": "chokehold",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chokehold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6a3b0df-3bd1-39df-a3c4-66e235f488f3",
                                        "entry_id": "59fb2472-9f75-310c-bfd2-8afd61309c36",
                                        "glosses": [
                                            "A grappling hold around a person's neck, especially one in which the neck is grasped tightly from behind with an arm, cutting off the flow of blood to the brain and restricting breathing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02652496-da20-4b31-af41-63127d54cd87",
                                                "sense_id": "c6a3b0df-3bd1-39df-a3c4-66e235f488f3",
                                                "text": "He put his opponent in a chokehold."
                                            },
                                            {
                                                "example_id": "d170881d-9d0c-4016-97dc-16ea1092dd6c",
                                                "sense_id": "c6a3b0df-3bd1-39df-a3c4-66e235f488f3",
                                                "text": "Within five to ten seconds, one officer began to apply a choke hold by pressing his forearm into [Adolph] Lyons' throat. As Lyons was struggling for air, the officer handcuffed him and continued to apply the choke hold until Lyons blacked out. He was almost choked to death. […] Between 1975 and 1982, sixteen people died from the LAPD [Los Angeles Police Department]'s use of choke holds."
                                            },
                                            {
                                                "example_id": "f3928aeb-e673-43f3-9f0e-25f05aab9e14",
                                                "sense_id": "c6a3b0df-3bd1-39df-a3c4-66e235f488f3",
                                                "text": "In competition, judo matches typically have a standing phase (opponents attempt to throw each other) and a ground phase (once an opponent is on the ground, then both opponents can use a hold down, literally holding an opponent down for 15 to 25 seconds, or using a choke hold or similar controlling technique to force an opponent to submit)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "250ffcb5-58ae-3191-8599-3f9f1a4fbc97",
                                        "entry_id": "59fb2472-9f75-310c-bfd2-8afd61309c36",
                                        "glosses": [
                                            "A powerful and restrictive control or influence over something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "331d36d4-6e28-4240-b945-1da519eb51ae",
                                                "sense_id": "250ffcb5-58ae-3191-8599-3f9f1a4fbc97",
                                                "text": "One country has a chokehold on another country's economy."
                                            },
                                            {
                                                "example_id": "fcf54867-c5a5-4f2c-91ed-06bc0f26f6c7",
                                                "sense_id": "250ffcb5-58ae-3191-8599-3f9f1a4fbc97",
                                                "text": "With the music industry releasing their chokehold on these television talent shows, it too is looking to other sources like social media – [Rob] Wade calls TikTok \"one giant talent show\" – to find new talent rather than primetime TV."
                                            },
                                            {
                                                "example_id": "2b22180a-2d40-4c8d-a3e0-ffdb061e1bd5",
                                                "sense_id": "250ffcb5-58ae-3191-8599-3f9f1a4fbc97",
                                                "text": "Fellow fashionistas know the hype of GAP athleisure wear. The nostalgic look mixed with its soft design have the girlies in a chokehold!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chokehold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1a16035-80ae-309c-9381-cca731d0854b",
                                        "entry_id": "0675b4ca-febc-35db-a3c2-e97a542463f5",
                                        "glosses": [
                                            "To put a hold around the neck of (someone), especially one in which the neck is grasped tightly from behind with an arm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "182c69e9-e5c4-47b2-92ed-c04b942b8f69",
                        "source_entry_id": "32ad2fcd-c381-36a8-ac30-50a20f893665",
                        "source_sense_id": "acc9bed5-d8ea-30e7-bb1d-804db271d95c",
                        "source_sense_description": "Griff am Hals, um einer Person die Luft zu nehmen",
                        "target_lang_word": "stranglehold",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stranglehold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9484eb6-2739-33b6-8c94-a7f3e2ba31a8",
                                        "entry_id": "be1b9318-3d60-36af-95f5-62f00b8d65c0",
                                        "glosses": [
                                            "A grip or control so strong as to stifle or cut off."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47e6523-5bfb-48f3-99f2-d14a7ffe4d1c",
                                                "sense_id": "f9484eb6-2739-33b6-8c94-a7f3e2ba31a8",
                                                "text": "For years the company had a stranglehold on the rest of the industry."
                                            },
                                            {
                                                "example_id": "50f8a70d-057a-4b86-8f8d-160642cb681c",
                                                "sense_id": "f9484eb6-2739-33b6-8c94-a7f3e2ba31a8",
                                                "text": "Numerous witnesses had come forward at that time to state that they had watched Kelly tackle Symaco and pin her on the floor in a strangle-hold until investigating officers arrived to pry him loose."
                                            },
                                            {
                                                "example_id": "2291c52f-90a2-490f-8c58-a9500b7a66c9",
                                                "sense_id": "f9484eb6-2739-33b6-8c94-a7f3e2ba31a8",
                                                "text": "That record felt like ancient history as the Djokovic of 2011 overcame a slightly edgy start to take a stranglehold on the match."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stranglehold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c80bd98-eafb-3518-8fbe-ab776ba7da8c",
                                        "entry_id": "20f03d80-7b1a-30b6-9686-33ea7fd0bf26",
                                        "glosses": [
                                            "To hold a tight grip or control."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4a19857-11b9-4a00-9a60-756098b1e3a4",
                                                "sense_id": "2c80bd98-eafb-3518-8fbe-ab776ba7da8c",
                                                "text": "\"She does not hold a partner; she strangleholds him. As soon as a man realizes how tightly she holds on, he leaves her.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc6efed0-22bc-4c9f-95f5-6632b2bbd1a7",
                        "source_entry_id": "32ad2fcd-c381-36a8-ac30-50a20f893665",
                        "source_sense_id": "acc9bed5-d8ea-30e7-bb1d-804db271d95c",
                        "source_sense_description": "Griff am Hals, um einer Person die Luft zu nehmen",
                        "target_lang_word": "étranglement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étranglement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "806df093-78e0-3b97-91bf-adf0806b7d2e",
                                        "entry_id": "c925c590-855c-3fae-be7d-4a2ec34e33cf",
                                        "glosses": [
                                            "Action d’étrangler, et plus ordinairement état de celui qui est étranglé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbda8781-dd42-4d28-83ae-c13c992cace3",
                                                "sense_id": "806df093-78e0-3b97-91bf-adf0806b7d2e",
                                                "text": "L’expertise révéla que le premier squelette trouvé, celui d’un homme, présentait une fracture de l’os hyoïde tout à fait typique d’une mort par étranglement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2034193e-1115-3f19-8c9c-e92c2cb84b6c",
                                        "entry_id": "c925c590-855c-3fae-be7d-4a2ec34e33cf",
                                        "glosses": [
                                            "Resserrement, rétrécissement, accidentel ou naturel, dans quelque partie d’une chose plus ou moins allongée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e24fd47b-daa5-4673-ac94-765dffa602af",
                                                "sense_id": "2034193e-1115-3f19-8c9c-e92c2cb84b6c",
                                                "text": "La gaine isolante que constitue la stratification myélinique est interrompue à intervalles réguliers par des étranglements (nœuds de Ranvier) au niveau desquels l’axone est dénudé."
                                            },
                                            {
                                                "example_id": "60b62607-9435-4365-aaae-baa2d2d32693",
                                                "sense_id": "2034193e-1115-3f19-8c9c-e92c2cb84b6c",
                                                "text": "L’étranglement des vaisseaux gêne la circulation du sang, d’une hernie."
                                            },
                                            {
                                                "example_id": "19724323-b96c-4e48-8c3b-8889d3abbb0b",
                                                "sense_id": "2034193e-1115-3f19-8c9c-e92c2cb84b6c",
                                                "text": "Je ne fus pas longtemps à comprendre que la haine du travail avait encore en cette occasion inspiré un mensonge à Polycarpe : il avait redouté, non l’étranglement de la rivière, mais la nécessité d’aider Miguel à pagayer sur le canot."
                                            },
                                            {
                                                "example_id": "1744e48c-2b8a-4b86-b491-c41fcaef30e4",
                                                "sense_id": "2034193e-1115-3f19-8c9c-e92c2cb84b6c",
                                                "text": "Le corps de plusieurs insectes, tels que l’araignée, la guêpe, est divisé en deux par un étranglement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a4b568-2233-3fe7-a4fb-6649f994d0c6",
                                        "entry_id": "c925c590-855c-3fae-be7d-4a2ec34e33cf",
                                        "glosses": [
                                            "Déformation, bourrelet formé par la présence d’un objet enroulé autour du tronc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "029722df-00d6-479c-9c97-62a50161fc89",
                                                "sense_id": "29a4b568-2233-3fe7-a4fb-6649f994d0c6",
                                                "text": "La tige de cette plante a plusieurs étranglements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
