                ],
                "senses": [
                    {
                        "sense_id": "82705c5a-2ea0-3318-b070-f26a6260e4f8",
                        "entry_id": "873ecf14-0d85-3422-b648-c4022495207e",
                        "glosses": [
                            "Angehöriger des isiXhosa sprechendes Volkes der Bantu in Südafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06210eb7-9e52-4824-8ccb-d4c3fc7a4cb6",
                                "sense_id": "82705c5a-2ea0-3318-b070-f26a6260e4f8",
                                "text": "„Die Xhosa dagegen betrachten sich als Denker. […] Nelson Mandela war ein Xhosa.“"
                            },
                            {
                                "example_id": "89613de9-fbd3-449c-9565-b1977fa0b2f0",
                                "sense_id": "82705c5a-2ea0-3318-b070-f26a6260e4f8",
                                "text": "„Der Hausmeister war ein alter Xhosa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7155bdc5-44df-4878-812c-5e70b4e66fdb",
                        "source_entry_id": "873ecf14-0d85-3422-b648-c4022495207e",
                        "source_sense_id": "82705c5a-2ea0-3318-b070-f26a6260e4f8",
                        "source_sense_description": "Angehöriger des isiXhosa sprechendes Volkes der Bantu in Südafrika",
                        "target_lang_word": "Xhosa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xhosa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6628879-6921-3f33-b265-decf16c57fc7",
                                        "entry_id": "b7a909ba-7a9c-33b7-98d3-ab242adba7de",
                                        "glosses": [
                                            "Any member of a Bantu people from South Africa, most of whom live in the Eastern Cape."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2bcf376-1dae-4186-9dce-2e1eb97e93d9",
                                                "sense_id": "a6628879-6921-3f33-b265-decf16c57fc7",
                                                "text": "my father remained aloof from Christianity and instead reserved his own faith for the great spirit of the Xhosas, Qamata, the God of his fathers."
                                            },
                                            {
                                                "example_id": "2b799402-ca61-406f-a61e-8c4c1789f2d8",
                                                "sense_id": "a6628879-6921-3f33-b265-decf16c57fc7",
                                                "text": "In many Xhosa households, Wednesday is umngqusho day. It's the way we all grew up. Like Fridays in the Eastern Cape are always dumplings with meat day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a505cc2f-c21d-3090-8998-6cc42f6b26dc",
                                        "entry_id": "b7a909ba-7a9c-33b7-98d3-ab242adba7de",
                                        "glosses": [
                                            "The language of these people, a Bantu language related to Zulu."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc5d8a94-1383-417a-9222-f0cec0b53b3c",
                                                "sense_id": "a505cc2f-c21d-3090-8998-6cc42f6b26dc",
                                                "text": "“With the food packages that we drop off, we are adding messages in the local dialect of Xhosa, because this is predominately for the Xhosa areas,” Kolisi said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b0fee50-0fd9-4095-af14-dcb76b78a04f",
                        "source_entry_id": "873ecf14-0d85-3422-b648-c4022495207e",
                        "source_sense_id": "82705c5a-2ea0-3318-b070-f26a6260e4f8",
                        "source_sense_description": "Angehöriger des isiXhosa sprechendes Volkes der Bantu in Südafrika",
                        "target_lang_word": "Xhosa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xhosa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d527d852-ad49-371b-93e5-65bc261e2dab",
                                        "entry_id": "391ca932-4201-3aee-a402-62ff453bff91",
                                        "glosses": [
                                            "Personne d’extraction xhosa, parlant le xhosa."
                                        ],
                                        "tags": [
                                            "Ethnonymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20261233-e340-41c7-a5b8-409b9a2299ac",
                                                "sense_id": "d527d852-ad49-371b-93e5-65bc261e2dab",
                                                "text": "Contestations, razzias et contre-razzias, périodes de calme ; déplacements incessants de frontière de part et d’autre de plusieurs rivières ; affrontements des fermiers boers et des éleveurs xhosas, des Anglais (parfois) et Xhosas, des Boers du Grand Trek et de certains clans xhosas, matabélés et zoulous ; tous ces événements se succédèrent jusqu’au milieu du XIXᵉ siècle, fin des guerres de frontière que furent ces nombreuses « guerres cafres ».\nEn ces lieux apaisés, je traversai la rivière Kei et pénétrai dans la réserve des Xhosas au Transkei pour laquelle le gouvernement de Pretoria envisageait l’autonomie."
                                            },
                                            {
                                                "example_id": "917f6041-bff8-41c4-85f5-1167bfefc024",
                                                "sense_id": "d527d852-ad49-371b-93e5-65bc261e2dab",
                                                "text": "…Le peuple zoulou, comme presque tous les peuples cafres de la région – les Ndébélés, les Shangaan, les Xhosa – sont tous des Nguni, eux-mêmes issus de la vaste famille des Bantous. Donc, pour nous, les Blancs, tout ça c’est un peu la même engeance…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
