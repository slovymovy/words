                                        "examples": [
                                            {
                                                "example_id": "9460946b-d129-4d32-874e-cddd4e04eea6",
                                                "sense_id": "cfad6717-2885-3778-94f4-a38eb0f80a16",
                                                "text": "Nadat ik dat allemaal had verteld waren we een hele poos stil, tot hij ten slotte zei: 'Mijn moeder heeft na haar aneurysma iets van een halfjaar in het ziekenhuis gelegen."
                                            },
                                            {
                                                "example_id": "88735aed-397b-46fb-aa94-baeda01383e5",
                                                "sense_id": "cfad6717-2885-3778-94f4-a38eb0f80a16",
                                                "text": "'Mijn moeder is al jaren dood' En zo is het. Aneurysma. Eén geknapte ader en boem. Het vogeltje lag op haar kant. Beter zo, zeiden de mensen. Beter zo, zei ik. En dat was dat."
                                            }
                                        ]
                                    }
