                ],
                "senses": [
                    {
                        "sense_id": "330c2c28-d0f1-3798-8170-fedbb3c45ca2",
                        "entry_id": "8f47a4e7-cf77-39e3-94df-772733012156",
                        "glosses": [
                            "ein großes, politisches Reich, das mehrere Länder umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf72728-304c-43af-84bc-803849c452b1",
                                "sense_id": "330c2c28-d0f1-3798-8170-fedbb3c45ca2",
                                "text": "Das römische Reich war in der Antike ein Weltreich."
                            },
                            {
                                "example_id": "866fba72-4a12-4fa3-be45-4bc27c7871aa",
                                "sense_id": "330c2c28-d0f1-3798-8170-fedbb3c45ca2",
                                "text": "„Während die Niederlande aufblühten, sank die ökonomische Bedeutung des portugiesischen Weltreichs.“"
                            },
                            {
                                "example_id": "d02f8a70-437c-417e-acd6-4066d819bda4",
                                "sense_id": "330c2c28-d0f1-3798-8170-fedbb3c45ca2",
                                "text": "„Nachdem wir eine Viertelstunde bergauf gestiegen waren, gelangten wir in die Stadt; dort verbrachte ich zwei Stunden damit, die römischen Altertümer zu besichtigen, denn die Stadt war eine wichtige Siedlung des antiken Weltreiches.“"
                            },
                            {
                                "example_id": "a8c8a751-d783-48ff-9312-3455878009f1",
                                "sense_id": "330c2c28-d0f1-3798-8170-fedbb3c45ca2",
                                "text": "„Der Habsburger Herrscher träumte von einem Weltreich, in dem »die Sonne nie untergeht«, wollte die »Neue Welt« erkunden und besiedeln lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
