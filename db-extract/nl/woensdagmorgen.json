                    {
                        "sense_id": "c7e39939-c128-3b57-a59b-3603032a4757",
                        "entry_id": "40789132-12db-37b2-8a30-a645bb7e957f",
                        "glosses": [
                            "de uren van een woensdag tussen de nachtelijke uren en de middag, de morgen van woensdag"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "2c2dcbf4-fae2-4d50-9047-f76d6dd32acc",
                                "sense_id": "c7e39939-c128-3b57-a59b-3603032a4757",
                                "text": "We hebben die hele woensdagmorgen in het ziekenhuis doorgebracht."
                            },
                            {
                                "example_id": "61080d28-16a9-422d-8088-3839009d56fc",
                                "sense_id": "c7e39939-c128-3b57-a59b-3603032a4757",
                                "text": "De vrijwillige brandweer van Ammeloe is woensdagmorgen in alle vroegte uitgerukt voor een autobrandje in Zwillbrock, waarbij de eigenaar van de auto met een poederblusser al meteen de boel had gesmoord."
                            },
                            {
                                "example_id": "1a2ffcb0-95ab-4d66-b274-3b9d796f5b43",
                                "sense_id": "c7e39939-c128-3b57-a59b-3603032a4757",
                                "text": "In de Baptistenkerk aan de Hoofdweg zijn deze woensdagmorgen de groepen 6, 7 en 8 van de basisscholen De Blokstoeke en De Fontein bijeen. Want het is Dankdag voor Gewas en Arbeid. En waar in grote delen van Nederland deze christelijke feestdag een vrijwel onbekend fenomeen is geworden, wordt er hier in Westerhaar volop aandacht aan besteed."
                            }
                        ]
                    }
