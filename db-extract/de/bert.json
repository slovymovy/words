                            "plural"
                        ],
                        "form": "die Berts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3accc10d-e575-3e95-8530-5a5cbc1f2f0e",
                        "entry_id": "53396dd7-d6e7-35d9-8bf8-35a87202d56d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61b52501-0b24-473f-9de8-cefaae96b4ba",
                                "sense_id": "3accc10d-e575-3e95-8530-5a5cbc1f2f0e",
                                "text": "Frau Bert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "09fb9c7c-12e8-46da-9249-fad3194c28b8",
                                "sense_id": "3accc10d-e575-3e95-8530-5a5cbc1f2f0e",
                                "text": "Herr Bert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c8325972-c8b8-4970-ac2f-d49afb7caba4",
                                "sense_id": "3accc10d-e575-3e95-8530-5a5cbc1f2f0e",
                                "text": "Die Berts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a8b920de-8b25-4535-aa20-180fdb7c49d0",
                                "sense_id": "3accc10d-e575-3e95-8530-5a5cbc1f2f0e",
                                "text": "Der Bert trägt nie die Schals, die die Bert ihm strickt."
                            },
                            {
                                "example_id": "4ddd1741-2dc2-46cb-9463-f6445c4f4967",
                                "sense_id": "3accc10d-e575-3e95-8530-5a5cbc1f2f0e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bert kommt, geht der Herr Bert.“"
                            },
                            {
                                "example_id": "8afac6b5-2e7e-49a2-a87e-66a88f825875",
                                "sense_id": "3accc10d-e575-3e95-8530-5a5cbc1f2f0e",
                                "text": "Bert kommt und geht."
                            },
                            {
                                "example_id": "930cce70-10c7-423e-9abd-ba03fd0b824c",
                                "sense_id": "3accc10d-e575-3e95-8530-5a5cbc1f2f0e",
                                "text": "Berts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
