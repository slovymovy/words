                                        "glosses": [
                                            "A forensic inspection to assess compliance with regulations or some code."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1184ada-15a1-4fb0-a4e2-7a0b6a2707e8",
                                                "sense_id": "cfaaf26a-ca14-3e5a-954f-4fad14026ea0",
                                                "text": "The regulators demanded a review against NYSE practices."
                                            },
                                            {
                                                "example_id": "e5a344ec-8440-43c7-89df-de365009bda8",
                                                "sense_id": "cfaaf26a-ca14-3e5a-954f-4fad14026ea0",
                                                "text": "The decision to place a young child in group home care is usually done after much review, but it is done more readily if there is substantial reason to believe that a resource-rich and structured program will result in a more speedy reunification or prompt adoption."
