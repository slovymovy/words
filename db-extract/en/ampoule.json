                    {
                        "translation_id": "70d95c33-ecda-4a7b-a207-3b48443d092e",
                        "source_entry_id": "22805342-6c5d-3a97-9bc4-952c6b922e01",
                        "source_sense_id": "2b0fad83-8586-3314-b84b-7bdae1d56ed1",
                        "source_sense_description": "small glass vial hermetically sealed",
                        "target_lang_word": "ampoule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ampoule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1627f2-f596-3e2e-97f8-e96221e6b561",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Récipient en verre, sorte de fiole, à col effilé."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76721af4-7ac5-4b17-b2ad-f5ac9c9475c3",
                                                "sense_id": "ad1627f2-f596-3e2e-97f8-e96221e6b561",
                                                "text": "Si le vase 140 a pu, à la rigueur, envelopper les trois ampoules aux saintes huiles, le vase 141 pouvait plus facilement encore être l'une de ces trois ampoules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80580cbf-c41a-3632-98a7-0b18034cbb8b",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Très petit récipient en verre en forme de tube fermé, dont une ou deux extrémités sont effilées et limées afin d’être cassées par simple pression."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1f341de-47af-48eb-9005-6f591aa58ea3",
                                                "sense_id": "80580cbf-c41a-3632-98a7-0b18034cbb8b",
                                                "text": "Si cet accident vous arrive, vous devez alors apprendre à contrôler vous-même votre glycémie à l'aide d'un glucomètre et prendre l'habitude d'avoir à portée de main du sucre rapidement assimilable et une ampoule injectable de glucagon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4500241a-c029-313f-af0e-bd7ef1ee4341",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Boule de verre, contenant un gaz et traversé par un filament métallique, servant à l’éclairage électrique ; ampoule électrique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c7168f-d424-4004-824b-f9092fef3328",
                                                "sense_id": "4500241a-c029-313f-af0e-bd7ef1ee4341",
                                                "text": "L’ampoule, qui éclairait cette dégringolade d'objets de toute provenance […] se balançait poussiéreuse, au bout de son fil, sous la voûte basse où le salpêtre faisait des croûtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3493832d-f049-3252-960a-c6ac15b7cbff",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Globe (ou autre forme) de verre ou de plastique contenant quelque chose qui émet de la lumière grâce à l'électricité et que l'on peut introduire dans une douille spéciale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a64a9c66-d471-3582-b2a4-5d89109b58a6",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Vésicule remplie de liquide qui se forme sous la peau, et causée par des frottements répétés ou une brûlure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c1e52c7-8581-4202-aab6-6e6dc72bf844",
                                                "sense_id": "a64a9c66-d471-3582-b2a4-5d89109b58a6",
                                                "text": "Les talons battaient de fièvre, la plante s’était couverte d’ampoules, dont la peau arrachée se collait à ses bas."
                                            },
                                            {
                                                "example_id": "bf1cccef-84e2-4b1c-837d-d84c15b8ff69",
                                                "sense_id": "a64a9c66-d471-3582-b2a4-5d89109b58a6",
                                                "text": "Vous pouvez aussi prévenir les ampoules en tannant la peau du pied avant le départ, avec du jus de citron en application locale, […].,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2990036-3a55-35ee-89a8-6df7a260401d",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Emphase, enflure en parlant d’un style."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2f3c182-2649-35f7-9307-3d9258fda42f",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Renflements qu’on observe sur la tige des plantes aquatiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "648d20ce-3210-38c1-ac2b-aa1553ebccc7",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Monticule de dimensions variables."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9762a839-18cc-4312-8588-8047a31e9ca6",
                                                "sense_id": "648d20ce-3210-38c1-ac2b-aa1553ebccc7",
                                                "text": "La montagne Sainte-Geneviève y faisait au Sud-Est une ampoule énorme, et c’était une chose à voir du haut de Notre-Dame que cette foule de rues étroites et tortues …."
                                            },
                                            {
                                                "example_id": "803b31d4-b7b8-47e8-bcd3-a195488c1a58",
                                                "sense_id": "648d20ce-3210-38c1-ac2b-aa1553ebccc7",
                                                "text": "Sue ce tapis de billard qui forme le sol des Provinces-Unies …, un mouvement de terrain n’existe qu’autant qu’on le crée ; de là l’ambition de tout propriétaire de doter son parc d’une colline, d’une ondulation, d’une ampoule de terrain quelconque."
                                            },
                                            {
                                                "example_id": "d9027404-ab6d-4b12-b107-f44dbcc7c99b",
                                                "sense_id": "648d20ce-3210-38c1-ac2b-aa1553ebccc7",
                                                "text": "Autour d’Helsingborg s’étendent quelques champs d’orge et de seigle fréquemment interrompus par des ampoules pierreuses couvertes de la végétation tourmentée des houx et des pins nains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c521fd-d582-331c-90a9-add0c38b4ded",
                                        "entry_id": "0718de31-bf1b-32ab-ad13-e2fdc2578777",
                                        "glosses": [
                                            "Vase d’étain ou d’argent destiné à contenir les saintes huiles au sein de l’Église catholique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e98fef-9b09-4abe-834f-c1e5f13802ff",
                        "source_entry_id": "22805342-6c5d-3a97-9bc4-952c6b922e01",
                        "source_sense_id": "2b0fad83-8586-3314-b84b-7bdae1d56ed1",
                        "source_sense_description": "small glass vial hermetically sealed",
                        "target_lang_word": "Ampulle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ampulle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5b2548e-4d53-35c5-8547-0e2784e68236",
                                        "entry_id": "d09bd3f4-174d-3f77-865c-1cc8fee89410",
                                        "glosses": [
                                            "luftdicht, oft unter Vakuum, verschlossenes Glasgefäß zur Aufbewahrung von Stoffen, die ihre Eigenschaften unter Lufteinfluss ändern würden, zum Beispiel luftempfindliche, flüchtige oder hochreaktive Substanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9248b471-a42e-4ac0-886b-0384e12231ce",
                                                "sense_id": "b5b2548e-4d53-35c5-8547-0e2784e68236",
                                                "text": "Er stach die Nadel in die Ampulle und zog die Spritze mit der klaren Flüssigkeit auf."
                                            },
                                            {
                                                "example_id": "5c9139c0-2ae1-41d9-bc03-891807041270",
                                                "sense_id": "b5b2548e-4d53-35c5-8547-0e2784e68236",
                                                "text": "„Als ebenso seltsam empfand er, dass sie ihm ein Päckchen Ampullen mitgab, das er auch Dr. Cerny übergeben sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "212b41ee-031e-331f-b206-a4a310f765bf",
                                        "entry_id": "d09bd3f4-174d-3f77-865c-1cc8fee89410",
                                        "glosses": [
                                            "Erweiterung von Hohlorganen (zum Beispiel beim Mastdarm)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714c957c-7057-466b-907b-1410a4fac55b",
                                                "sense_id": "212b41ee-031e-331f-b206-a4a310f765bf",
                                                "text": "„Die grundsätzliche Aufgabe des Enddarms, wie aller Dickdarmanteile, ist, dem Speisebrei Flüssigkeit zu entziehen. Anschließend wird in der sogenannten Ampulle der Stuhl gesammelt, bis er über den Anus ausgeschieden wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9216d4d1-fb18-3b12-87c3-e896a998144c",
                                        "entry_id": "d09bd3f4-174d-3f77-865c-1cc8fee89410",
                                        "glosses": [
                                            "Kännchen für Wasser, Öl, Wein und Ähnliches zur Benutzung während der Messe"
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2e50f00-13e1-42c1-af27-afb92aba1ce7",
                                                "sense_id": "9216d4d1-fb18-3b12-87c3-e896a998144c",
                                                "text": "Die Salbung, liebe Brüder, ist nicht dafür da, uns selber in Duft zu hüllen, und erst recht nicht, damit wir sie in einer Ampulle aufbewahren, denn das Öl würde ranzig… und das Herz bitter."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
