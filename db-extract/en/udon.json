                    {
                        "sense_id": "e51f4a93-1c72-359e-a730-d244217c29c7",
                        "entry_id": "f5e4d765-40db-3cf4-b358-bca93e5d0483",
                        "glosses": [
                            "A Japanese wheat noodle."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f18e8cee-2bc8-4939-80d8-e2bbc2abca97",
                                "sense_id": "e51f4a93-1c72-359e-a730-d244217c29c7",
                                "text": "The first time I had niku udon was at a Japanese convenience store, now long closed, near Columbia University in the mid-1990s. For about $5, the attendants would plop a handful of freshly boiled udon into a Styrofoam cup and add a ladle of dashi broth seasoned with soy sauce and mirin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32c9457a-fe19-413b-aa71-a5ad4864884c",
                        "source_entry_id": "f5e4d765-40db-3cf4-b358-bca93e5d0483",
                        "source_sense_id": "e51f4a93-1c72-359e-a730-d244217c29c7",
                        "source_sense_description": "udon",
                        "target_lang_word": "udon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "udon",
                                "target_lang_code": "fr",
