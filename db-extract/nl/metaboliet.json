                                                "example_id": "412943bb-428c-4d97-aa3a-51fb9d8e2800",
                                                "sense_id": "753ad3cd-1dad-35d7-9218-fc6604e09c06",
                                                "text": "In addition to looking at gene expression, Bozek and her colleagues analyzed levels of metabolites, a diverse group of small molecules that includes sugars, nucleic acids and neurotransmitters. Many metabolites are either necessary for metabolism or produced by it."
                                            }
                                        ]
