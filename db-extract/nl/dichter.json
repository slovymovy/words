                    {
                        "translation_id": "c3f11362-9dc1-4be1-a20b-58517bc7e773",
                        "source_entry_id": "6bb127ff-dc6a-34a3-9268-f179c2b21cb7",
                        "source_sense_id": "57a560a5-96b8-3cf1-b3eb-f5db02470162",
                        "source_sense_description": "iemand die poëtische kunst voortbrengt",
                        "target_lang_word": "поэт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поэт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7a05ec03-96bc-31c0-a792-72c9cd1d5193",
                                        "entry_id": "a952d934-8b6a-30ab-bc78-02ed7e9e7d36",
                                        "glosses": [
                                            "писатель, художник слова, сочиняющий поэтические произведения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe11cbf4-7019-40f0-8f8b-416fdf417e54",
                                                "sense_id": "7a05ec03-96bc-31c0-a792-72c9cd1d5193",
                                                "text": "Погиб поэт! ― невольник чести ―"
                                            },
                                            {
                                                "example_id": "f4c8a985-dc0f-422a-b183-058c349fa10b",
                                                "sense_id": "7a05ec03-96bc-31c0-a792-72c9cd1d5193",
                                                "text": "Но спасибо, наш кудесник, // Живописец и поэт, // Малодушным внукам вестник // Богатырских оных лет!"
                                            },
                                            {
                                                "example_id": "e8a8e677-2e76-473c-86d6-795ebc9e6fbf",
                                                "sense_id": "7a05ec03-96bc-31c0-a792-72c9cd1d5193",
                                                "text": "◆ Поэтом можешь ты не быть, // Но гражданином быть обязан."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4472dc0-e736-3f58-bc34-e6f947e0acf2",
                                        "entry_id": "a952d934-8b6a-30ab-bc78-02ed7e9e7d36",
                                        "glosses": [
                                            "перен., книжн. или шутл. человек, наделённый сильным творческим воображением либо склонный к мечтательности и фантазированию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5db76a5-71e4-4a1b-8ffc-0cab6508494b",
                                                "sense_id": "a4472dc0-e736-3f58-bc34-e6f947e0acf2",
                                                "text": "Мысль превосходная… . ты должен быть поэт"
                                            },
                                            {
                                                "example_id": "8c235427-8b84-4fa5-9896-cf768f2414bb",
                                                "sense_id": "a4472dc0-e736-3f58-bc34-e6f947e0acf2",
                                                "text": "Он так привык теряться в этом, // Что чуть с ума не своротил, // Или не сделался поэтом."
                                            }
                                        ]
                                    }
