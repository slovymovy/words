                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "573ad41e-e455-4087-9659-5c0f1e81ac56",
                        "source_entry_id": "6af4a581-2896-33a4-acdb-9d663ceed85e",
                        "source_sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                        "source_sense_description": "hoher Hocker in Lokalen an der Theke (= Bar) oder hohen Tischen",
                        "target_lang_word": "tabouret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tabouret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8394f0-27c0-3b6c-8c50-fc0b11e61c69",
                                        "entry_id": "dad591fe-eefe-3567-98ba-b6900a8a5237",
                                        "glosses": [
                                            "Petit siège sans dossier ni bras, souvent avec trois ou quatre pieds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e50afe-67c8-44bc-9d72-0783d2242af0",
                                                "sense_id": "6f8394f0-27c0-3b6c-8c50-fc0b11e61c69",
                                                "text": "C'était en vérité un sinistre bouge : point de meubles, deux tabourets de paille à demi déformés, une planche posée sur deux ais boîteux, puis dans les coins des amas de haillons qui, à coup sûr, servaient de lit."
                                            },
                                            {
                                                "example_id": "b1fc652c-75ee-489f-9d9b-4b43649ae1d0",
                                                "sense_id": "6f8394f0-27c0-3b6c-8c50-fc0b11e61c69",
                                                "text": "Il nous appelle fainéants ? un crampu qui ne saurait lever ses quilles du tabouret. Mais les jambes te remonteraient jusqu'à la gruette, pauvre bouif !"
                                            },
                                            {
                                                "example_id": "53e74e66-8c62-4545-b0a6-e225e81b1c93",
                                                "sense_id": "6f8394f0-27c0-3b6c-8c50-fc0b11e61c69",
                                                "text": "Les tables peintes en marbre, les tabourets en velours d’Utrecht rouge, le quinquet à globe plein d’huile alimentant deux becs, attaché par une chaîne au plafond et enjolivé de cristaux, commencèrent la célébrité du Café de la Guerre."
                                            },
                                            {
                                                "example_id": "67dbdb93-87db-40c5-bd9a-3a13ba372348",
                                                "sense_id": "6f8394f0-27c0-3b6c-8c50-fc0b11e61c69",
                                                "text": "Au comptoir, perché sur un tabouret, on déguste un verre de blanc, un café, avec une farandole de tapas et chipoteries, «grignoteries» en tout genre."
                                            },
                                            {
                                                "example_id": "4fdfc742-b2f9-44e9-879d-9076ce2c6897",
                                                "sense_id": "6f8394f0-27c0-3b6c-8c50-fc0b11e61c69",
                                                "text": "la vachère s’agenouille pour traire ses vaches ; elle serait plus à son aise si elle était assise sur un petit tabouret très bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d12a8384-3282-33a1-b67b-3fa4429fed26",
                                        "entry_id": "dad591fe-eefe-3567-98ba-b6900a8a5237",
                                        "glosses": [
                                            "Siège utilisé par les duchesses pour s’asseoir en présence du roi, de la reine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd241bfb-3519-4968-9ff7-ba0d11c0b8b1",
                                                "sense_id": "d12a8384-3282-33a1-b67b-3fa4429fed26",
                                                "text": "Et moi, je vais séduire sa fille! rendre impossible peut-être ce mariage avec le marquis de Croisenois qui fait le charme de son avenir: s’il n’est pas duc, du moins sa fille aura un tabouret."
                                            },
                                            {
                                                "example_id": "a07340bb-c94e-4c1a-bc85-58df84858878",
                                                "sense_id": "d12a8384-3282-33a1-b67b-3fa4429fed26",
                                                "text": "Si le tabouret joua un grand rôle à la cour de Louis XIV, il fut aussi le prétexte d’une guerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c129ddc-68e7-3103-8903-327a8c19c1a0",
                                        "entry_id": "dad591fe-eefe-3567-98ba-b6900a8a5237",
                                        "glosses": [
                                            "Siège sur lequel étaient exposés en place publique ceux qui avaient été condamnés à une peine infamante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f183b4d-0437-4dab-818d-90df95964b74",
                                                "sense_id": "0c129ddc-68e7-3103-8903-327a8c19c1a0",
                                                "text": "Dans le vestibule du greffe, tout est prêt pour la dernière toilette du condamné : le tabouret, les ciseaux, les entraves […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a465be-b4af-31f5-947a-81e50ca11e37",
                                        "entry_id": "dad591fe-eefe-3567-98ba-b6900a8a5237",
                                        "glosses": [
                                            "Dispositif de raccordement d’une canalisation au réseau."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "597a288c-8df5-49f1-8515-963b0d3ccb78",
                                                "sense_id": "55a465be-b4af-31f5-947a-81e50ca11e37",
                                                "text": "Ce tabouret est destiné à permettre l’écoulement des effluents, la ventilation de la canalisation et une visite du système d'évacuation des vannes et des eaux usées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b2d59b3-8475-3a96-8b1e-65aff8905329",
                                        "entry_id": "dad591fe-eefe-3567-98ba-b6900a8a5237",
                                        "glosses": [
                                            "Charpente supportant la flèche d’une église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71383231-54a0-46d2-a644-fd0c03604a7e",
                                                "sense_id": "5b2d59b3-8475-3a96-8b1e-65aff8905329",
                                                "text": "La pose du tabouret qui supportera la nouvelle flèche sera achevée samedi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cf7d1b-c54e-3f8e-a685-5da4f3251fdc",
                                        "entry_id": "dad591fe-eefe-3567-98ba-b6900a8a5237",
                                        "glosses": [
                                            "Nom donné à diverses Brassicaceae du genre Iberis, du genre Noccaea et du genre Thlaspi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
