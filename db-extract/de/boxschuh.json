                "senses": [
                    {
                        "sense_id": "1615006c-aacc-3e2c-b5e5-3ef330d0d33a",
                        "entry_id": "d0fa3379-1019-3479-bc75-9af5990a944f",
                        "glosses": [
                            "spezieller Schuh für den Boxsport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb907b86-eb25-4e29-8173-cd473b2ae288",
                                "sense_id": "1615006c-aacc-3e2c-b5e5-3ef330d0d33a",
                                "text": "„Er trug einen alten blauen Pullover, eine Hose und Boxschuhe.“"
                            },
                            {
                                "example_id": "c7f6b6a6-a030-4ad3-a3a3-a3238f26ac9c",
                                "sense_id": "1615006c-aacc-3e2c-b5e5-3ef330d0d33a",
                                "text": "„So sind zwar die Boxschuhe und Handschuhe zu erkennen, Muskelpartien besonders im Rücken und Oberarmbereich herausgearbeitet und beim vorderen Boxer deutlich die abstehenden Ohren sichtbar, aber auffällig ist das Fehlen der Gesichtszüge des zweiten Boxers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
