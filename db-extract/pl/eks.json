                                            {
                                                "example_id": "bf4d1d4f-6b3e-476b-ae66-7b652127ec61",
                                                "sense_id": "75c54310-fb6f-39da-9ff7-15d3e1bdb45b",
                                                "text": "You upset cuz your friend got exed\nI got pissed cuz my bro got knifed"
