                        "examples": [
                            {
                                "example_id": "87e60988-bb2a-472f-9e05-28b8bb350708",
                                "sense_id": "d7a63efc-c362-3a43-836c-d1c9d273234f",
                                "text": "But so unpracticable is this design, that although sometimes conceived, it is never executed; the civil magistrate knows that it would be utterly destructive of human society; sublime as may be the ideal justice that it supposes, he sets it aside on the calculation of its bad consequences."
                            },
                            {
                                "example_id": "15232d1d-555d-4ddd-88f4-513040431ab1",
                                "sense_id": "d7a63efc-c362-3a43-836c-d1c9d273234f",
                                "text": "It has been urged, \"You are unpracticable; you want a world of tramps--how are you going to live?\""
                            }
                        ]
                    }
