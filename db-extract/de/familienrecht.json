                            "singular"
                        ],
                        "form": "das Familienrecht"
                    },
                    {
                        "form_id": "99c9d86e-8285-4d09-943e-7320e0ab24e0",
                        "entry_id": "147f8dea-0b7e-3ccd-8b41-ea98aed5ae8f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Familienrechte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1309875e-53e4-3549-89ad-91bb2559b6ca",
                        "entry_id": "147f8dea-0b7e-3ccd-8b41-ea98aed5ae8f",
                        "glosses": [
                            "die Gesamtheit aller Rechtsnormen einer Rechtsordnung, die das Verhältnis der Mitglieder einer Familie zueinander betreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ed6c0c-f5d3-4862-a5e2-c87890a37c53",
                                "sense_id": "1309875e-53e4-3549-89ad-91bb2559b6ca",
                                "text": "„Das deutsche Familienrecht ist in diesen Fragen eher konservativ.“"
                            },
                            {
                                "example_id": "8a77148e-7104-4b38-bfd5-29e22e0d4a90",
                                "sense_id": "1309875e-53e4-3549-89ad-91bb2559b6ca",
                                "text": "„Die Wissenschaftler sind der Auffassung, dass das Instrumentarium des Internationalen Privatrechts und die Aktivitäten des Europarats und der EU nicht ausreichen, um eine Harmonisierung der nationalen Familienrechte in Europa zu fördern.“"
                            },
                            {
                                "example_id": "7dfb715f-cf3d-4e90-a954-5112a3dece0f",
                                "sense_id": "1309875e-53e4-3549-89ad-91bb2559b6ca",
                                "text": "„Wie bei den Prinzipien zum Scheidungsrecht ist das Committee stets bemüht gewesen, aus den nationalen Familienrechten einen ›common core‹ abzuleiten.“"
                            },
                            {
                                "example_id": "eeddff80-83b4-4afb-9f63-7c50c008b3ab",
                                "sense_id": "1309875e-53e4-3549-89ad-91bb2559b6ca",
                                "text": "„Die speziellen Rückforderungsansprüche in den Familienrechten der europäischen Länder können hier nicht im einzelnen dargestellt werden […]“"
                            },
                            {
                                "example_id": "ddf912ec-9f93-47bf-a5ab-3c2c909d70dc",
                                "sense_id": "1309875e-53e4-3549-89ad-91bb2559b6ca",
                                "text": "„Diese Vielfalt der Paarbeziehungsregime ist nicht ein außereuropäisches Phänomen, sondern lässt sich auch in den Familienrechten der Europäischen Union nachweisen.“"
                            },
                            {
                                "example_id": "f795239e-af17-4f35-b288-e7ce213ab2f6",
                                "sense_id": "1309875e-53e4-3549-89ad-91bb2559b6ca",
                                "text": "„Nationale Familienrechte entstanden hingegen erst mit der Begründung unabhängiger Nationalstaaten im Nahen und Mittleren Osten nach dem Ersten und Zweiten Weltkrieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "421984df-b988-3b50-ad44-d1abc4cf537e",
                        "entry_id": "147f8dea-0b7e-3ccd-8b41-ea98aed5ae8f",
                        "glosses": [
                            "eines der subjektiven Rechte (Ansprüche, Rechtspositionen), die Familienmitglieder – oder im nichttechnischen Sinne auch Familien – aufgrund von [1] haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a1bee20-37bb-4617-9872-6328625c4763",
                                "sense_id": "421984df-b988-3b50-ad44-d1abc4cf537e",
                                "text": "„Von den Persönlichkeitsrechten unterscheiden sich die persönlichen Familienrechte darin, dass sie im Verhältnis zu einer anderen Person bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
