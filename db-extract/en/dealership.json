                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557d06a2-697d-40b8-ba65-802c8d60ae18",
                                "sense_id": "ae92a4e1-7710-343c-b138-7df619d36f18",
                                "text": "I visited the car dealership today."
                            },
                            {
                                "example_id": "df08b73e-5012-4920-a9ad-03d8db817b41",
                                "sense_id": "ae92a4e1-7710-343c-b138-7df619d36f18",
                                "text": "It comes as a series of weekly protests branded “Tesla Takedown” have occurred at various locations across the U.S., which has seen a number of vehicles set on fire and various charging stations and dealerships vandalized by protesters.\nOn Tuesday, a masked man used molotov cocktails to firebomb a Tesla dealership in Las Vegas before firing rounds into the burning vehicles."
                            }
                        ]
