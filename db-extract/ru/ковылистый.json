                "senses": [
                    {
                        "sense_id": "aef1724a-6f04-36a5-8d74-baeac2e676d8",
                        "entry_id": "554ba1bf-52ba-31c1-a6f2-27684420a9e2",
                        "glosses": [
                            "поросший ковылём. Ковылистый луг."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c4055220-da30-32af-84eb-f0896026ecfa",
                        "entry_id": "554ba1bf-52ba-31c1-a6f2-27684420a9e2",
                        "glosses": [
                            "похожий на ковыль. Пырей ковылистый. Паренек маял гармонь, роняя на мехи ковылистый чуб, изредка оглядывая бражников синеватыми, но опустевшими, пьяно размытыми глазами."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fbba98b-e6b0-4de3-ba86-464868d6419c",
                        "source_entry_id": "554ba1bf-52ba-31c1-a6f2-27684420a9e2",
                        "target_lang_word": "feather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c79298e2-8de0-3432-a681-0d0355ebf3f9",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "A branching, hair-like structure that grows on the bodies of birds, used for flight, swimming, protection and display."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c5e0d1-e24a-4917-85b6-ffcef048f2ab",
                                                "sense_id": "c79298e2-8de0-3432-a681-0d0355ebf3f9",
                                                "text": "Notice, too, that the shaft is not straight, but bent so that the upper surface of the feather is convex, and the lower concave."
                                            },
                                            {
                                                "example_id": "462609a4-fb62-48c2-a1bb-110376d7a077",
                                                "sense_id": "c79298e2-8de0-3432-a681-0d0355ebf3f9",
                                                "text": "Big fellows they were, all of them, their barbaric headdresses and grotesquely painted faces, together with their many metal ornaments and gorgeously coloured feathers, adding to their wild, fierce appearance."
                                            },
                                            {
                                                "example_id": "f756740b-447b-46bb-85af-6515506ca1ec",
                                                "sense_id": "c79298e2-8de0-3432-a681-0d0355ebf3f9",
                                                "text": "Nesting birds pluck some of their own feathers to line the nest, but feather plucking in pet birds is entirely different."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c1c480-dc8e-32cb-b2f0-f78adc6b5c0c",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "Long hair on the lower legs of a dog or horse, especially a draft horse, notably the Clydesdale breed. Narrowly only the rear hair."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d2183e6-f75a-3f9b-85c6-50a5cf40b9de",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "One of the fins or wings on the shaft of an arrow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e4e4c62-226d-3126-b888-39b592386450",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "A longitudinal strip projecting from an object to strengthen it, or to enter a channel in another object and thereby prevent displacement sideways or rotationally but permit motion lengthwise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa896e45-37bd-45b0-9083-dde7ff6f3dc9",
                                                "sense_id": "7e4e4c62-226d-3126-b888-39b592386450",
                                                "text": "Near-synonym: spline"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "312ca9d5-392e-3190-8446-eed02752fcd5",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "Kind; nature; species (from the proverbial phrase \\\"birds of a feather\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a477965a-d219-4916-8bc0-7114b5887195",
                                                "sense_id": "312ca9d5-392e-3190-8446-eed02752fcd5",
                                                "text": "I am not of that feather to shake off / My friend when he must need me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96da4d00-b6bc-35c7-8ea3-974deb1d7212",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "One of the two shims of the three-piece stone-splitting tool known as plug and feather or plug and feathers; the feathers are placed in a borehole and then a wedge is driven between them, causing the stone to split."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c353fd39-de9e-32d7-9a6f-62da20cb164a",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "The angular adjustment of an oar or paddle-wheel float, with reference to a horizontal axis, as it leaves or enters the water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e752fdee-ae7a-360a-943c-764502e22ff4",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "Anything petty or trifling; a whit or jot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0519c755-3fb0-42bd-88e9-4d2a47674de0",
                                                "sense_id": "e752fdee-ae7a-360a-943c-764502e22ff4",
                                                "text": "To some pew purchasers he gave deeds, to others he gave, none, but both were promised security, and both it seems were equally secure, for the pew deed as Mr. Melledge declared to Mr. G. was not worth a feather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0efcb32d-7cfd-370c-9239-13189e6516c3",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "Partridges and pheasants, as opposed to rabbits and hares (called fur)."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "263cb751-475b-3707-b9c0-bde4cf927707",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "A junction indicator attached to a colour-light signal at an angle, which lights up, typically with four white lights in a row, when a diverging route is set up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b0dee4c-b60c-45bf-aa70-ab9108fe3b7f",
                                                "sense_id": "263cb751-475b-3707-b9c0-bde4cf927707",
                                                "text": "Signal M123 is a conventional 3-aspect colour light with three Junction Indicators - commonly known as 'feathers'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a99ae1dc-66f9-3880-9e1a-f0ff311c4257",
                                        "entry_id": "dd1af5c5-ed17-3e6a-b2b9-c85a3707fbf4",
                                        "glosses": [
                                            "A faint edge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "feather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d561fb1-4461-3215-b960-6af8b7238d45",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To cover or furnish with feathers; (when of an arrow) to fletch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f30ab41f-5661-4a21-a600-c63bc06f8a85",
                                                "sense_id": "1d561fb1-4461-3215-b960-6af8b7238d45",
                                                "text": "An Eagle had the ill Hap to be Struck with an Arrow Feather'd from her own Wing."
                                            },
                                            {
                                                "example_id": "15f8a812-f4f6-4fe9-977b-5c96db1a634b",
                                                "sense_id": "1d561fb1-4461-3215-b960-6af8b7238d45",
                                                "text": "Olondaw had taught Hazeleye how to use her bow and arrows, and that each might know the result of his or her own shooting, he had feathered her arrow with white and his own with red. How strange are the events of this life, […]"
                                            },
                                            {
                                                "example_id": "ac338437-60f9-43e4-961e-113fb02b1e54",
                                                "sense_id": "1d561fb1-4461-3215-b960-6af8b7238d45",
                                                "text": "She feathered her arrows in the Seneca fashion, two lengths of feather tied on with a spiral twist, so they would spin in flight. The trick was to glue both sides in place with a little sticky pine sap so they would stay put while she tied them […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "902a6ab8-aee2-3bd5-b28a-2fffe1f3ab79",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To adorn, as if with feathers; to fringe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4055705-b13c-4431-a7e2-4acd35f165ba",
                                                "sense_id": "902a6ab8-aee2-3bd5-b28a-2fffe1f3ab79",
                                                "text": "A few birches and oaks still feathered the narrow ravines, or occupied in dwarf clusters the hollow plains of the moor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7131b729-8d90-31fd-bca2-98c43e486b2b",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To arrange in the manner or appearance of feathers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c25c504-8c43-4fb3-a57b-d6fd0d43d099",
                                                "sense_id": "7131b729-8d90-31fd-bca2-98c43e486b2b",
                                                "text": "The stylist feathered my hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceeec7c7-afd2-37ba-93a4-06fd4944d1b1",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To rotate the oars while they are out of the water to reduce wind resistance."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8feee15a-4758-3a4e-b7ba-1e68020b5eaf",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To streamline the blades of an aircraft's propeller by rotating them perpendicular to the axis of the propeller when the engine is shut down so that the propeller does not windmill during flight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "763a4d35-11ee-4f8e-a69d-d76ad5ea5229",
                                                "sense_id": "8feee15a-4758-3a4e-b7ba-1e68020b5eaf",
                                                "text": "After striking the bird, the pilot feathered the damaged left engine’s propeller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5688cc-82c2-3daa-99f7-0a4723b0bc8f",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To finely shave or bevel an edge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c79dbab1-ee5a-3f99-bf4d-0abbe576c679",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To intergrade or blend the pixels of an image with those of a background or neighboring image."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a26de44-b85a-3644-b036-212a1e1f5298",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "Of written or printed ink: to take on a blurry appearance as a result of spreading through the receiving medium."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a45d823-7e3a-482f-94bc-3ee1497905cc",
                                                "sense_id": "2a26de44-b85a-3644-b036-212a1e1f5298",
                                                "text": "Whether or not the ink feathers depends upon the paper or card, and also upon the nature of the dye in the ink."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbdd9c5f-eb79-3641-a084-8c3662b24c96",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To render light as a feather; to give wings to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea57c992-c1d4-4402-839b-7ee96ebbd67b",
                                                "sense_id": "cbdd9c5f-eb79-3641-a084-8c3662b24c96",
                                                "text": "c. 1650, Robert Loveday, letter to Mr. C.\nThe Polonian story, which perhaps may feather some tedious hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043a7129-75e6-3e11-8767-58cec3919fc0",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To enrich; to exalt; to benefit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1255d92f-5f0c-47c8-9157-cca17b745fd7",
                                                "sense_id": "043a7129-75e6-3e11-8767-58cec3919fc0",
                                                "text": "They stuck not to say that the king cared not to plume his nobility and people to feather himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd4ed59d-4384-308e-9931-59fe9d1bb797",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To tread, as a cockerel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95217a0-715e-4221-81e6-434bbe3b7486",
                                                "sense_id": "bd4ed59d-4384-308e-9931-59fe9d1bb797",
                                                "text": "Ardent in love[…]He feather'd her a hundred times a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a1cef75-702b-3093-b45c-ceca0d827c07",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To move the cue back and forth along the bridge in preparation for striking the cue ball."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6a1e0b9-7a34-3c52-9add-ebd9b2817568",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To accidentally touch the cue ball with the tip of the cue when taking aim."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "deecae36-d9d5-3f22-990f-41beea290e63",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To touch lightly, like (or as if with) a feather."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fe4bf17-ff67-4948-a962-513d627165f6",
                                                "sense_id": "deecae36-d9d5-3f22-990f-41beea290e63",
                                                "text": "His breath feathered her lips; her spine, her legs weakened, went soft at the wafting warmth."
                                            },
                                            {
                                                "example_id": "4900b376-e796-4340-bcc9-415ad7b40a4e",
                                                "sense_id": "deecae36-d9d5-3f22-990f-41beea290e63",
                                                "text": "A soft breeze feathered her face and hair. The smell of honeysuckle blanketed the air. She concentrated on shutting out every sound except the whisper of her heart. Gradually the inner distractions became fewer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e64057f-1a65-3aee-b098-ecc2dae691a3",
                                        "entry_id": "224b4e0f-c249-3292-9889-5b325116df6d",
                                        "glosses": [
                                            "To move softly, like a feather."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a093357a-02d8-4c13-9a3f-ae492413da8f",
                                                "sense_id": "9e64057f-1a65-3aee-b098-ecc2dae691a3",
                                                "text": "She feathered her fingers through Mitchell's hair. “Besides, I like you a whole lot better than Frye.”"
                                            },
                                            {
                                                "example_id": "76759bdf-dc2a-4c8c-b306-faf25d9fe8a3",
                                                "sense_id": "9e64057f-1a65-3aee-b098-ecc2dae691a3",
                                                "text": "“Asking me not to breathe would be simpler,” Drake said. “If I could spare you what's coming—” “No.” Drake feathered her fingers through Sylvan's hair. “We fight together.” Sylvan nodded and relaxed in her embrace. Drake didn't fear death."
                                            }
                                        ]
                                    }
                                ]
                            }
