                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ziezo</w>, dat ziet er een stuk beter uit.",
