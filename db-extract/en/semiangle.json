                        "glosses": [
                            "The angle formed between the axis of a cone and a line drawn from the apex of the cone to the edge of its base."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05cccbea-4d06-4361-b6f3-51058a4ec9ad",
                                "sense_id": "f588f3a2-d2f7-3f1e-b4cf-9ccf9b344878",
                                "text": "The results show that the optimum cone semiangle decreases slightly when the Mach number increases and, in the range of Mach numbers considered, is in the range of 22° to 25° for supersonic entrance flow."
                            },
                            {
                                "example_id": "74700da9-cfe5-4849-8c9e-8d46c834f3ed",
                                "sense_id": "f588f3a2-d2f7-3f1e-b4cf-9ccf9b344878",
                                "text": "The author's theory is almost perfect for 5° semiangle, is good for M_∞ ≤ 2 with 10° semiangle, and is beginning to be a serious overestimate for 15° semiangle."
                            },
                            {
                                "example_id": "fad584e9-28dc-4606-a15c-ca91cef87da0",
                                "sense_id": "f588f3a2-d2f7-3f1e-b4cf-9ccf9b344878",
                                "text": "Variations in cone semiangle had no significant effects on the longitudinal stability at the two test Mach numbers ."
                            }
                        ]
                    }
