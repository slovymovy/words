                                "example_id": "cc65fc2d-4018-484f-8dc8-fc76d21fad23",
                                "sense_id": "f18a9b5c-d7b0-3665-b171-770139face6e",
                                "text": "Daj Jędrkowi wody, niech pije."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0d58cb6d-3804-3a06-a06c-3e893e9dbf5b",
