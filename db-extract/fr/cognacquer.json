                        "glosses": [
                            "S'adonner au cognac, à l'alcool."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "acb00b8b-d964-41ce-a4b5-97dc0132c5ac",
                                "sense_id": "a8af484f-5bc9-3064-8606-d890057afc34",
                                "text": "Voilà pourquoi la passion pour le cognac et pour les longues stations au cabaret se développa de plus en plus chez lui ; « se cognacquer » ne faisait pas grand mal à ses nouveaux amis, tandis que c’était du poison pour sa nature nerveuse et maladive."
                            },
                            {
                                "example_id": "b34a427f-1289-41b7-8706-8e07bb277d4f",
                                "sense_id": "a8af484f-5bc9-3064-8606-d890057afc34",
                                "text": "Plus tard, l’un de ses compagnons d’alors, un certain V., me racontait que leur compagnie avait adopté un mot spécial: « se cognacquer», et qu’elle le réalisait dans toute la force du terme."
                            }
                        ]
                    }
