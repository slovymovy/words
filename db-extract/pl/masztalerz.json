                        "source_sense_id": "69b3271d-6632-3c1a-9220-ef9d60e31a90",
                        "target_lang_word": "palafrenero",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palafrenero",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8d69e873-61b1-365e-a0b0-f1684401e10d",
                                        "entry_id": "40d90ac6-a2bb-311a-90c3-d8acb27f831b",
                                        "glosses": [
                                            "Criado que lleva del freno el caballo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27897111-5766-42bd-8c92-5322118924db",
                                                "sense_id": "8d69e873-61b1-365e-a0b0-f1684401e10d",
                                                "text": "«Precedido por chambelanes reales, que portaban en un cojín de terciopelo rojo las condecoraciones del finado, la carroza fúnebre era arrastrada por seis caballos, guiados por los palafreneros reales y escoltados en ambas márgenes por delegaciones de estudiantes, que llevaban las simbólicas palmeras, laureles y azaleas […]»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d959482f-b79a-384a-ae8c-ec8799c1c09f",
                                        "entry_id": "40d90ac6-a2bb-311a-90c3-d8acb27f831b",
                                        "glosses": [
                                            "Mozo de caballos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a403dd-6c0f-47db-b1e0-ea8bdeca2a61",
                                                "sense_id": "d959482f-b79a-384a-ae8c-ec8799c1c09f",
                                                "text": "«Mientras tanto, en las Caballerizas Reales del Campo del Moro, al pie del Palacio Real, palafreneros, lacayos, cocheros y mozos de cuadras revisan y preparan las diferentes carrozas, los correajes, los adornos y penachos, los corceles que constituirán la gran y suntuosa comitiva regia»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b809f992-3dd0-3ffb-96a7-448884982d6a",
                                        "entry_id": "40d90ac6-a2bb-311a-90c3-d8acb27f831b",
                                        "glosses": [
                                            "Criado que monta el palafrén."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a55b33f6-12b7-3a3c-a153-d893ac20f275",
                                        "entry_id": "40d90ac6-a2bb-311a-90c3-d8acb27f831b",
                                        "glosses": [
                                            "En las caballerizas reales, picador, jefe de la regalada, que tiene de la cabezada el caballo cuando monta el rey."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2eb68823-be3d-4993-a5fe-b3fcf56008e5",
