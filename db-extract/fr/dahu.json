                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dahu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd64bea8-5400-3f72-9ff2-bc0bda95229d",
                                        "entry_id": "d87829cf-177a-32ea-a85c-57e5736ce5d6",
                                        "glosses": [
                                            "A legendary goat-like animal reputed to live in the mountains of France, Switzerland, and Italy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49e8e6c5-0f36-4882-964b-8be6db089677",
                                                "sense_id": "fd64bea8-5400-3f72-9ff2-bc0bda95229d",
                                                "text": "Perhaps still sore at being called crétins des Alpes by lowlanders, the Savoyards, in the early days of mass tourism, would sometimes take gullible visitors on dahu hunts. These entailed all-night vigils out in the open, where the would-be trophy hunter had to crouch and hide so as not to be seen by the sharp-eyed dahu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dahu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5ffb2d5-f806-37ae-b426-0a57c3cb8202",
                                        "entry_id": "f666768a-e11a-364b-8ea5-0259285c99a3",
                                        "glosses": [
                                            "A large bowed two-stringed chordophone of Chinese origin, a tenor part of the erhu family of instruments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
