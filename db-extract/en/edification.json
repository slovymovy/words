                                        "glosses": [
                                            "een constructie van enige omvang die verbonden is met de grond en waarin men kan wonen of werken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23582cfc-cde3-4cbf-8fa2-ee4c29b9a9f6",
                                                "sense_id": "84a91fe8-8a25-3315-8107-6e9565b12b72",
                                                "text": "Dit gebouw is in jugendstil opgetrokken."
                                            },
                                            {
                                                "example_id": "86028499-bbab-434a-9521-8947466b0a48",
                                                "sense_id": "84a91fe8-8a25-3315-8107-6e9565b12b72",
                                                "text": "Er komen oude twijfels naar boven nu het gebouw langzaam wordt onthuld, en ze merkt dat ze er nog steeds bang voor is."
                                            },
                                            {
                                                "example_id": "a74205ff-f7b2-43cb-886d-83b2dfb6577d",
                                                "sense_id": "84a91fe8-8a25-3315-8107-6e9565b12b72",
                                                "text": "Op de zijkant van het geschetste gebouw heeft Otto ook iets geschreven."
                                            }
                                        ]
