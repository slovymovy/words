                "senses": [
                    {
                        "sense_id": "0f5756ea-f9d3-3075-8491-552316e583ce",
                        "entry_id": "5ea430f1-7eec-32d2-88ed-093f23cbbe9a",
                        "glosses": [
                            "Qui guerroye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14408d6d-0cad-4203-af16-9f9f73a4e3cf",
                                "sense_id": "0f5756ea-f9d3-3075-8491-552316e583ce",
                                "text": "Je n'avais pas précisément l’humeur guerroyante ; la botanique, la chimie, que je cultivais par goût, sont peu propres à former des héros."
                            },
                            {
                                "example_id": "e86269f1-b152-46b1-9967-e407a1165a35",
                                "sense_id": "0f5756ea-f9d3-3075-8491-552316e583ce",
                                "text": "Je sentis que, dans cette vie sacrifiée et isolée, il avait besoin de faire du bien pour se consoler secrètement de la rudesse de sa mission toujours guerroyante."
                            },
                            {
                                "example_id": "a5322aed-5e05-4903-b830-96e7b0b6ddb3",
                                "sense_id": "0f5756ea-f9d3-3075-8491-552316e583ce",
                                "text": "Dans ce but il demanda à la régence d’Ensisheim communication de l’engagement pris par les parties guerroyantes de respecter les possessions autrichiennes, ainsi que les villes impériales."
                            }
                        ]
                    }
