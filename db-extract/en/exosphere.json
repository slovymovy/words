                                "example_id": "2ac90dc8-559e-4b0a-b990-db326e84ddd1",
                                "sense_id": "13e663a5-be6f-334b-9101-7ca211b5bfc1",
                                "text": "\"Scientists weren't even sure Dione would be big enough to hang on to an exosphere\" ('Cassini Detects Hint of Fresh Air at Dione', , JPL, Mar. 02, 2012)"
                            }
                        ]
