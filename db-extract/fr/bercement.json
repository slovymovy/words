                    }
                ],
                "senses": [
                    {
                        "sense_id": "d26b9b3e-4886-390b-bab0-7fbfd4a18995",
                        "entry_id": "369d7240-ff32-3e0a-8707-c7edb344694b",
                        "glosses": [
                            "Action de bercer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b19df1-1568-422c-8615-476443d47b40",
                                "sense_id": "d26b9b3e-4886-390b-bab0-7fbfd4a18995",
                                "text": "La nuit fut effroyable ; une tempête de fin d’automne régna sans discontinuité depuis le soir jusqu’après le soleil levé. Je ne fis pas autre chose, dans le morne bercement de ce long murmure de vent et de pluie, que de penser au tumulte que le vent devait produire autour de la chambre et du sommeil de Madeleine, si Madeleine dormait."
                            },
                            {
                                "example_id": "1efe52c7-4566-4ba2-ac48-beede324ca1c",
                                "sense_id": "d26b9b3e-4886-390b-bab0-7fbfd4a18995",
                                "text": "Et quelle bonne sieste ensuite sur le sable ! un sommeil tout plein du bercement de la mer, où les mille écailles luisantes des petites vagues papillotaient encore aux yeux fermés."
                            },
                            {
                                "example_id": "c6067c96-0140-4db5-b2de-27fd33c80ff7",
                                "sense_id": "d26b9b3e-4886-390b-bab0-7fbfd4a18995",
                                "text": "Ma pitié avait des bercements de mère penchée au lit de son enfant malade."
                            },
                            {
                                "example_id": "b4c0508a-d31e-47bb-afd4-6b352374ade3",
                                "sense_id": "d26b9b3e-4886-390b-bab0-7fbfd4a18995",
                                "text": "– C’est le bercement du bateau qui m’a brouillé le cœur."
                            },
                            {
                                "example_id": "50beeae0-0b66-4a81-b6b6-7973afcfcc6a",
                                "sense_id": "d26b9b3e-4886-390b-bab0-7fbfd4a18995",
                                "text": "Oubliez un instant la douceur des plages et le bercement de la mer, la magie de la Martinique ne tient pas uniquement à ses eaux limpides bordées de plages."
                            }
                        ]
                    }
                ],
