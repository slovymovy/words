                        ],
                        "examples": [
                            {
                                "example_id": "17f5502b-3130-405e-b9b3-e7c23154431a",
                                "sense_id": "288b6b94-a3ec-3561-988a-bc6fec9ab7e6",
                                "text": "Funkcja dragomana miała szczególne znaczenie w imperium osmańskim"
                            }
                        ],
