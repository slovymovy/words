                "senses": [
                    {
                        "sense_id": "6888013b-d785-3142-8eb4-c5166d0bfb00",
                        "entry_id": "58d93643-af7b-3ebe-a2c4-58d9f076c7f6",
                        "glosses": [
                            "Syndrome prémenstruel."
                        ],
                        "tags": [],
