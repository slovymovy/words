                "senses": [
                    {
                        "sense_id": "772b34b2-d751-354b-9a79-b61b2881166e",
                        "entry_id": "d27cba86-feef-34ed-bbd1-818b88870b42",
                        "glosses": [
                            "dat wat er goed bij hoort of op van toepassing is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41bfe3bc-c7a3-4663-bad0-e04604bd1392",
                                "sense_id": "772b34b2-d751-354b-9a79-b61b2881166e",
                                "text": "Hij weet altijd wel enige toepasselijke woorden te vinden."
                            },
                            {
                                "example_id": "d1fbba8a-798f-4104-920f-0efbcf0eb1c8",
                                "sense_id": "772b34b2-d751-354b-9a79-b61b2881166e",
                                "text": "Ze heette heel toepasselijk Jetfighter en alle standaardvragen passeerden de revue: ‘waar kom je vandaan’, ‘wanneer ben je begonnen?’ en ‘hoeveel liter neem je mee?’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8acf2f79-74a0-4533-8234-6bf548dd019e",
                        "source_entry_id": "d27cba86-feef-34ed-bbd1-818b88870b42",
                        "source_sense_id": "772b34b2-d751-354b-9a79-b61b2881166e",
                        "source_sense_description": "dat wat er goed bij hoort of op van toepassing is",
                        "target_lang_word": "anwendbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anwendbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1cedbe-3868-306c-8f04-85c07299138d",
                                        "entry_id": "d35c3ff4-4b2e-3415-8169-5d8a5306d9c6",
                                        "glosses": [
                                            "zur Verwendung geeignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f3e11c-28b7-4321-9cfd-76af71bfa484",
                                                "sense_id": "dd1cedbe-3868-306c-8f04-85c07299138d",
                                                "text": "„Da die ausländischen Erkenntnisse nicht bedingungslos auf die österreichischen (Wiener) Verhältnisse anwendbar waren, veranlasste dies Martin Ehrmann um 1825, die Gründung einer österreichischen pharmazeutischen Zeitschrift in Erwägung zu ziehen; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8805336-c0ce-4e0c-8d89-ab386c2fc18c",
                        "source_entry_id": "d27cba86-feef-34ed-bbd1-818b88870b42",
                        "source_sense_id": "772b34b2-d751-354b-9a79-b61b2881166e",
                        "source_sense_description": "dat wat er goed bij hoort of op van toepassing is",
                        "target_lang_word": "brauchbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brauchbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ea3197d-e2e5-391c-8d95-3fc6145b89d8",
                                        "entry_id": "dd9200f2-0ccf-3c94-b0f1-a78045793367",
                                        "glosses": [
                                            "für etwas geeignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f74834-5b7c-40f7-af1c-8624e17cafed",
                                                "sense_id": "0ea3197d-e2e5-391c-8d95-3fc6145b89d8",
                                                "text": "\"Dein Vorschlag ist leider nicht brauchbar. Wir müssen uns etwas anderes überlegen.\""
                                            },
                                            {
                                                "example_id": "41b759d0-e23e-4829-bf0e-e31f64784a3e",
                                                "sense_id": "0ea3197d-e2e5-391c-8d95-3fc6145b89d8",
                                                "text": "Geophysiker Birger-Gottfried Lühr: \"Noch einmal: bislang sind wir noch nicht soweit, dass man diese Parameter [Grundwasserabsenkung] brauchbar für eine konkrete [Erdbeben-]Vorhersage einsetzen kann, um beispielsweise eine Evakuierung durchzuführen."
                                            },
                                            {
                                                "example_id": "ec98759d-5833-4041-8b84-38764552ac3a",
                                                "sense_id": "0ea3197d-e2e5-391c-8d95-3fc6145b89d8",
                                                "text": "Degradierte Weideflächen kommen wieder in Einsatz. \"Es handelt sich dabei um Weideland, das bereits seit 20 oder 30 Jahren genutzt wurde und nun nicht mehr brauchbar ist. Jetzt wird dort Soja angebaut\", sagt Endrigo Dalcin, Direktor des Soja-Anbauverbands Aprosoja."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26031322-58f2-4a53-ab2f-f82b0a3efa12",
                        "source_entry_id": "d27cba86-feef-34ed-bbd1-818b88870b42",
                        "source_sense_id": "772b34b2-d751-354b-9a79-b61b2881166e",
                        "source_sense_description": "dat wat er goed bij hoort of op van toepassing is",
                        "target_lang_word": "useful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "useful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49b08327-580e-3cd4-9164-e916608eddc9",
                                        "entry_id": "fc3d5f8a-bc32-3739-bee4-9d420b905584",
                                        "glosses": [
                                            "Having a practical or beneficial use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6efbc811-8277-4a3f-b723-96517d265efe",
                                                "sense_id": "49b08327-580e-3cd4-9164-e916608eddc9",
                                                "text": "prove useful"
                                            },
                                            {
                                                "example_id": "b34c574f-03d3-48b5-bc83-96244dcbd5ad",
                                                "sense_id": "49b08327-580e-3cd4-9164-e916608eddc9",
                                                "text": "practically useful"
                                            },
                                            {
                                                "example_id": "71438d7c-35e2-4f67-92bf-6c16a336c808",
                                                "sense_id": "49b08327-580e-3cd4-9164-e916608eddc9",
                                                "text": "That’s a very useful tool for gardeners."
                                            },
                                            {
                                                "example_id": "29c05acc-059f-4d05-925f-d7d77334d58c",
                                                "sense_id": "49b08327-580e-3cd4-9164-e916608eddc9",
                                                "text": "She found the information extremely useful."
                                            },
                                            {
                                                "example_id": "fff27f8f-ab4e-4d5d-88b7-4171ff8c0614",
                                                "sense_id": "49b08327-580e-3cd4-9164-e916608eddc9",
                                                "text": "In the early days troubles were experienced with oscillation from the rod drive and with the transformers, but were overcome later, and these machines performed useful service until superseded by more modern locomotives less costly in maintenance."
                                            },
                                            {
                                                "example_id": "873c490b-9732-4b61-aaae-6569f666bae0",
                                                "sense_id": "49b08327-580e-3cd4-9164-e916608eddc9",
                                                "text": "Turbines have been around for a long time—windmills and water wheels are early examples. The name comes from the Latin turbo, meaning vortex, and thus the defining property of a turbine is that a fluid or gas turns the blades of a rotor, which is attached to a shaft that can perform useful work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
