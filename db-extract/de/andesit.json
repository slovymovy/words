                                        "entry_id": "928b5b10-c42d-37fd-beb5-88837a41338e",
                                        "glosses": [
                                            "Any of a class of fine-grained intermediate igneous rock, of volcanic origin, containing mostly plagioclase feldspar."
                                        ],
