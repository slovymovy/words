{
    "word_family": [
        "closeted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "083fc6f8-0687-3826-8289-23490596b3b9",
                    "sense_definition": "A small room, cupboard, or enclosed space used for storing clothes, food, or household items.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "storage_room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please hang your coat in the <w>closet</w> by the door.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, повесь свое пальто в <w>шкаф</w> у двери.",
                                "zh": "请把你的外套挂在门边的<w>衣柜</w>里。"
                            }
                        },
                        {
                            "text": "We keep all our extra towels in the linen <w>closet</w>.",
                            "target_lang_translations": {
                                "ru": "Мы храним все запасные полотенца в бельевом <w>шкафу</w>.",
                                "zh": "我们把所有多余的毛巾都放在亚麻布<w>储藏室</w>里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cabinet",
                        "cupboard",
                        "wardrobe"
                    ],
                    "common_phrases": [
                        "walk-in closet",
                        "linen closet",
                        "broom closet",
                        "skeleton in the closet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая комната, шкаф или закрытое пространство для хранения одежды, еды или бытовых предметов.",
                        "zh": "用于存放衣服、食物或家庭用品的小房间、柜子或封闭空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкаф",
                                "target_lang_sense_clarification": "мебель для хранения"
                            },
                            {
                                "target_lang_word": "чулан",
                                "target_lang_sense_clarification": "подсобное помещение"
                            },
                            {
                                "target_lang_word": "кладовка",
                                "target_lang_sense_clarification": "комната для хранения вещей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衣柜",
                                "target_lang_sense_clarification": "存放衣服的家具"
                            },
                            {
                                "target_lang_word": "储藏室",
                                "target_lang_sense_clarification": "存放杂物的小房间"
                            },
                            {
                                "target_lang_word": "壁橱",
                                "target_lang_sense_clarification": "嵌入墙壁的储物空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbd6d58b-889b-34c3-b06d-7835ea108fef",
                    "sense_definition": "A state of secrecy, particularly regarding one's sexual orientation or gender identity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "secrecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took a lot of courage for him to come out of the <w>closet</w> to his parents.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось много мужества, чтобы выйти из <w>шкафа</w> (открыться) перед родителями.",
                                "zh": "他鼓起很大勇气才向父母<w>出柜</w>。"
                            }
                        },
                        {
                            "text": "Living in the <w>closet</w> can be very isolating for young people.",
                            "target_lang_translations": {
                                "ru": "Жизнь в <w>шкафу</w> (скрывание ориентации) может быть очень изолирующей для молодых людей.",
                                "zh": "对于年轻人来说，<w>隐瞒</w>真实身份可能会让他们感到非常孤立。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the closet",
                        "out of the closet",
                        "come out of the closet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние секретности, особенно касающееся чьей-либо сексуальной ориентации или гендерной идентичности.",
                        "zh": "一种保密状态，特指关于某人的性取向或性别认同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкаф",
                                "target_lang_sense_clarification": "в идиомах о скрытности"
                            },
                            {
                                "target_lang_word": "подполье",
                                "target_lang_sense_clarification": "тайное положение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隐瞒",
                                "target_lang_sense_clarification": "指代隐藏身份的状态"
                            },
                            {
                                "target_lang_word": "出柜",
                                "target_lang_sense_clarification": "指代公开身份的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9370e3ad-4647-3a09-adc8-13dcd0f748ba",
                    "sense_definition": "A room containing a toilet; a water closet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toilet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmhouse still has a small water <w>closet</w> under the stairs.",
                            "target_lang_translations": {
                                "ru": "В старом фермерском доме до сих пор есть маленькая <w>уборная</w> под лестницей.",
                                "zh": "这座老农舍的楼梯下还有一个小<w>厕所</w>。"
                            }
                        },
                        {
                            "text": "He excused himself to find the <w>closet</w>.",
                            "target_lang_translations": {
                                "ru": "Он извинился и пошел искать <w>туалет</w>.",
                                "zh": "他找了个借口去寻找<w>洗手间</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bathroom"
                    ],
                    "common_phrases": [
                        "water closet"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in the phrase 'water closet' or historically"
                        },
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комната, в которой находится унитаз; уборная.",
                        "zh": "设有马桶的房间；厕所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уборная",
                                "target_lang_sense_clarification": "туалетная комната"
                            },
                            {
                                "target_lang_word": "туалет",
                                "target_lang_sense_clarification": "санузел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厕所",
                                "target_lang_sense_clarification": "卫生间"
                            },
                            {
                                "target_lang_word": "洗手间",
                                "target_lang_sense_clarification": "较为礼貌的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5e831a2-ea1a-37f6-b75a-af21fe8c2479",
                    "sense_definition": "A small private room used for prayer, study, or meditation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "private_room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The queen retired to her <w>closet</w> to write letters in peace.",
                            "target_lang_translations": {
                                "ru": "Королева удалилась в свой <w>кабинет</w>, чтобы спокойно написать письма.",
                                "zh": "女王退回到她的<w>书房</w>里安静地写信。"
                            }
                        },
                        {
                            "text": "He spent hours in his <w>closet</w> contemplating the scriptures.",
                            "target_lang_translations": {
                                "ru": "Он часами сидел в своей <w>келье</w>, размышляя над писанием.",
                                "zh": "他在自己的<w>密室</w>里花了几个小时沉思经文。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая личная комната, используемая для молитвы, учебы или размышлений.",
                        "zh": "用于祈祷、学习或冥想的小型私人房间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинет",
                                "target_lang_sense_clarification": "личная комната"
                            },
                            {
                                "target_lang_word": "каморка",
                                "target_lang_sense_clarification": "тесная комната"
                            },
                            {
                                "target_lang_word": "келья",
                                "target_lang_sense_clarification": "комната для уединения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "书房",
                                "target_lang_sense_clarification": "用于学习或工作的私人空间"
                            },
                            {
                                "target_lang_word": "密室",
                                "target_lang_sense_clarification": "私密的小房间"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47ab827e-c850-3824-8353-132157ef48a5",
                    "sense_definition": "Secret or private; describing someone who hides a specific habit, belief, or identity from others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "secret_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>closet</w> romantic who secretly loves watching sentimental movies.",
                            "target_lang_translations": {
                                "ru": "Он <w>тайный</w> романтик, который втайне любит смотреть сентиментальные фильмы.",
                                "zh": "他是个<w>隐蔽的</w>浪漫主义者，私下里很喜欢看感伤的电影。"
                            }
                        },
                        {
                            "text": "The politician was a <w>closet</w> supporter of the opposing party's policies.",
                            "target_lang_translations": {
                                "ru": "Этот политик был <w>скрытым</w> сторонником политики оппозиционной партии.",
                                "zh": "这位政客是反对党政策的<w>秘密</w>支持者。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "closet drinker",
                        "closet smoker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайный или частный; описывает того, кто скрывает определенную привычку, убеждение или идентичность от других.",
                        "zh": "秘密的或私下的；形容某人向他人隐瞒特定的习惯、信仰或身份。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тайный",
                                "target_lang_sense_clarification": "скрывающий свои пристрастия"
                            },
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "неявный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秘密的",
                                "target_lang_sense_clarification": "不公开的"
                            },
                            {
                                "target_lang_word": "隐蔽的",
                                "target_lang_sense_clarification": "隐藏身份或倾向的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05f139f9-7ac8-3830-aece-50b184fe2a4a",
                    "sense_definition": "To shut away in a private room for a confidential discussion or meeting.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_discuss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two leaders were <w>closeted</w> together for hours discussing the treaty.",
                            "target_lang_translations": {
                                "ru": "Два лидера <w>заперлись</w> вместе на несколько часов, обсуждая договор.",
                                "zh": "两位领导人<w>闭门</w>商谈了几个小时，讨论这项条约。"
                            }
                        },
                        {
                            "text": "She was <w>closeted</w> with her lawyers all afternoon preparing for the trial.",
                            "target_lang_translations": {
                                "ru": "Она <w>уединилась</w> со своими адвокатами на весь день, готовясь к суду.",
                                "zh": "她整个下午都与律师<w>密谈</w>，为审判做准备。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрыться в отдельной комнате для конфиденциального обсуждения или встречи.",
                        "zh": "关在私人房间里进行机密讨论或会议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запираться",
                                "target_lang_sense_clarification": "уединяться для разговора"
                            },
                            {
                                "target_lang_word": "уединяться",
                                "target_lang_sense_clarification": "изолироваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "密谈",
                                "target_lang_sense_clarification": "私下讨论"
                            },
                            {
                                "target_lang_word": "闭门",
                                "target_lang_sense_clarification": "关起门来商议"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}