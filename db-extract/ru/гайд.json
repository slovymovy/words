                "senses": [
                    {
                        "sense_id": "a1da76dc-3544-3b67-83e6-6ed60189aa94",
                        "entry_id": "ab8b3c58-e327-3b1e-b6e0-631330541f26",
                        "glosses": [
                            "справочник; справочное руководство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d04c6959-2822-4f92-a6de-1ba9ac0dd4f5",
                                "sense_id": "a1da76dc-3544-3b67-83e6-6ed60189aa94",
                                "text": "Вообще, мы тебе по пиктограммам решили хелпануть по полной программе, и замутили вот такой вот гигантский гайд ― фигли, я сам всегда парюсь, когда очередную вижу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
