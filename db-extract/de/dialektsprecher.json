                "senses": [
                    {
                        "sense_id": "81607d88-7a4b-359c-852d-c4fe528384ac",
                        "entry_id": "b5bff15e-764b-3a74-b7c0-930734b73aac",
                        "glosses": [
                            "Person, die einen Dialekt beherrscht und spricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c20ce892-f520-4ff6-b6f4-2160115f5bb6",
                                "sense_id": "81607d88-7a4b-359c-852d-c4fe528384ac",
                                "text": "„Im Norden lag der Anteil der Dialektsprecher an der Bevölkerung schon in den 1970er Jahren in der Regel unter der Hälfte, im Süden in der Regel über zwei Dritteln.“"
                            },
                            {
                                "example_id": "78233761-67e6-446e-8ae2-4e67c9fb7eab",
                                "sense_id": "81607d88-7a4b-359c-852d-c4fe528384ac",
                                "text": "„Dialektsprecher sind in der Regel imstande, nicht nur entweder ihre Mundart oder die Hochsprache zu verwenden, sondern ebenfalls verschiedene Mischformen zwischen diesen.“"
                            }
                        ],
