    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7f4968fa-8a5b-3812-afa1-fbbe67aadfeb",
                "word": "swank",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "70124261-8705-4d30-9517-0dd90b7bb791",
                        "entry_id": "7f4968fa-8a5b-3812-afa1-fbbe67aadfeb",
                        "tags": [
                            "comparative"
                        ],
                        "form": "swanker"
                    },
                    {
                        "form_id": "b12693c7-0151-49c0-950c-653d595f1638",
                        "entry_id": "7f4968fa-8a5b-3812-afa1-fbbe67aadfeb",
                        "tags": [
                            "superlative"
                        ],
                        "form": "swankest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                        "entry_id": "7f4968fa-8a5b-3812-afa1-fbbe67aadfeb",
                        "glosses": [
                            "Fashionably elegant, posh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e656827-316b-49f7-a834-8e67fd118e8b",
                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                "text": "The fish house or shack is built without windows, covered with tar paper to keep out the light and wind, and set on the ice over about ten feet of water in a spot off shore where fish have been known to habitate habitually. […] A couple of boxes to sit on and a plank or mat for your feet and a small airtight stove, if you want swank comfort."
                            },
                            {
                                "example_id": "bcf63841-3046-4023-9d27-6c62bd4d2c45",
                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                "text": "\"You live in that swank apartment round the corner.\"\n\"Yes.\"\n\"Hey you must be rich.\""
                            },
                            {
                                "example_id": "cec5eda0-02ce-428a-83dd-8322d45b77ae",
                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                "text": "You know it's swank when … It's very shiny / It's very tan / It's got Royale in its name"
                            },
                            {
                                "example_id": "38332447-0b7e-4d75-a0b5-8a7eada90ea2",
                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                "text": "[T]he Montgomery Block was the commercial and social center of San Francisco. […] Above [the ground floor] were a law library, the three rooms of the Mercantile Library Association, and a swank billiard room that ran nearly the entire length of the second floor."
                            },
                            {
                                "example_id": "3b975b3a-c160-4f5a-8602-55e01bea986b",
                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                "text": "Mr. Heinz belonged to a very swank club in Pittsburgh."
                            },
                            {
                                "example_id": "cb9fa33e-6cb5-4749-8fca-dd89f083ed6a",
                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                "text": "She arrived at a very swank studio, where Mr. Feldman introduced himself as the director of auditions."
                            },
                            {
                                "example_id": "1bdf9705-785a-462c-8b61-e7c3b1ccf407",
                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                "text": "As we were enjoying this lovely meal, a very swank and sophisticated older woman came over to our table and excused herself, more so to Jerry than me."
                            },
                            {
                                "example_id": "025a058e-25c7-40b7-b89a-04b2d07ec527",
                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                "text": "Warren, Emerald City's owner, had thrown a swank party at his house and invited the whole staff, along with about fifty others."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
