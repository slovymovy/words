                                "ru": "Нападающий полностью <w>смутил</w> защиту соперника своими резкими ускорениями.",
                                "de": "Der Stürmer hat die gegnerische Abwehr mit seinen plötzlichen Antritten völlig <w>verwirrt</w>.",
                                "es": "El delantero ha <w>desconcertado</w> por completo a la defensa rival con sus repentinas arrancadas.",
                                "zh": "这名前锋凭借突然的加速，彻底<w>扰乱</w>了对方的防守。"
                            }
