                ],
                "senses": [
                    {
                        "sense_id": "5a2cd4bb-6046-36e6-b658-2ab649ffaf89",
                        "entry_id": "30f404b8-c874-378d-a546-4e579b5a642d",
                        "glosses": [
                            "Mitglied eines Drogenkartells (vor allem in Amerika)"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "daf2b4d1-3d1f-4371-99ad-630a3c9da2f6",
                                "sense_id": "5a2cd4bb-6046-36e6-b658-2ab649ffaf89",
                                "text": "„Das Drogendezernat besitzt kein Boot, obwohl jeder weiß, dass die Narcos die Inseln vor der Küste nutzen.“"
                            },
                            {
                                "example_id": "f30657f4-17f9-4f83-ad28-964210bee775",
                                "sense_id": "5a2cd4bb-6046-36e6-b658-2ab649ffaf89",
                                "text": "„Wenn in der Tierra Caliente im Westen von Mexiko die schwarzen Geländewagen der Narcos auf den langgestreckten Hügelketten auftauchen, verstecken die Dorfbewohner ihre Töchter in Erdlöchern.“"
                            },
                            {
                                "example_id": "b557fa1c-597d-4f1c-b7f6-25000bd5e388",
                                "sense_id": "5a2cd4bb-6046-36e6-b658-2ab649ffaf89",
                                "text": "„Im April griffen Narcos auf der Westautobahn von Mexiko-Stadt nach Guadalajara einen Konvoi der Bundespolizei mit Sturmgewehren und Granatwerfern an.“"
                            },
                            {
                                "example_id": "8327e58b-ebbd-4a76-a042-92688a2bf713",
                                "sense_id": "5a2cd4bb-6046-36e6-b658-2ab649ffaf89",
                                "text": "„Mitten in der Stadt rammten Narcos das Auto des Fotografen und erschossen ihn und seinen Beifahrer.“"
                            },
                            {
                                "example_id": "e40d1ab0-e62e-4c4f-b901-2efcff6c0336",
                                "sense_id": "5a2cd4bb-6046-36e6-b658-2ab649ffaf89",
                                "text": "„Auch hat der Narco keine frischen Informationen über einen Kokaintransport erhalten, den er sich gern unter den Nagel reißen möchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
