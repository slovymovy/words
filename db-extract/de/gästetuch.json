                ],
                "senses": [
                    {
                        "sense_id": "508f022e-e53a-3bc4-88bf-5d2bf9a35194",
                        "entry_id": "3c981888-9c14-327e-89b1-7ca13f47243d",
                        "glosses": [
                            "mittelkleines Tuch, mit dem man sich hauptsächlich die Hände abtrocknet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97cb064c-55ec-413a-97a6-8c93a6d8c355",
                                "sense_id": "508f022e-e53a-3bc4-88bf-5d2bf9a35194",
                                "text": "„Ein Duschtuch hat meist 70 x 140 cm, ein Badetuch oder auch Strandtuch misst 100 x 180 cm, Gästetücher sind durchweg 50 x 30 cm und Gesichtstücher haben 30 x 30 cm.“"
                            },
                            {
                                "example_id": "986dcdb4-d192-4967-9bcd-9953e3cf1c9d",
                                "sense_id": "508f022e-e53a-3bc4-88bf-5d2bf9a35194",
                                "text": "„Der Sinn eines Gästetuches ist es, dass für Besucher ein eigenes Handtuch bereit hängt und somit der Gast nicht auf die von dem Wohnungseigentümer genutzten Badezimmerutensilien zurückgreifen muss.“"
                            },
                            {
                                "example_id": "78e11475-d69c-4bc8-8f8a-5e7f368aa34b",
                                "sense_id": "508f022e-e53a-3bc4-88bf-5d2bf9a35194",
                                "text": "„Meist besteht ein Gästetuch aus reiner Baumwolle und ist als Frottiertuch gefertigt.“"
                            },
                            {
                                "example_id": "a39b560e-cbf1-4eb5-b19c-8cb8094da5d7",
                                "sense_id": "508f022e-e53a-3bc4-88bf-5d2bf9a35194",
                                "text": "„Gerade für das Abtrocknen nach dem Händewaschen bieten sich die Gästetücher an.“"
                            },
                            {
                                "example_id": "aeeb75d9-812e-4300-94e1-b3caa65d656e",
                                "sense_id": "508f022e-e53a-3bc4-88bf-5d2bf9a35194",
                                "text": "„Ob zu Hause oder unterwegs, die geringen Maße erlauben es, ob auf Reisen oder zum Picknick, ein Gästetuch überall hin mitzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
