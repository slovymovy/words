                "senses": [
                    {
                        "sense_id": "bc7f77dc-28ae-3294-a2d6-70e34dfbc8bc",
                        "entry_id": "2a7a6277-ad4f-344d-931e-1bdedd4122be",
                        "glosses": [
                            "Apfelbaum, Apfel (Malus)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
