                        "examples": [
                            {
                                "example_id": "234242c5-a69f-4938-a3f5-c6fd10c82983",
                                "sense_id": "b4129fbf-cd5d-3d90-8ccc-68d98d9a0b46",
                                "text": "„Bis jemand eine App mit einem generellen Anrufschutz entwickelt, die Ausnahmen nur im Notfall zulässt, wird das weiterhin schwierig bleiben.“"
                            },
                            {
                                "example_id": "52dbd76b-5732-4f24-9e44-270e197b1aa3",
                                "sense_id": "b4129fbf-cd5d-3d90-8ccc-68d98d9a0b46",
                                "text": "„Eine Möglichkeit besteht darin, den Anrufschutz nur über die Vermittlung durchbrechen zu lassen (Stufe 3).“"
                            },
                            {
                                "example_id": "8fe13088-b6fc-4438-9044-2863014f8e00",
                                "sense_id": "b4129fbf-cd5d-3d90-8ccc-68d98d9a0b46",
                                "text": "„Sollte keine Berechtigung zum Durchbrechen des Anrufschutzes vorliegen, ist gezieltes Pickup nur durch Wahl der Rufnummer nach der Prozedur möglich.“"
                            }
