                                    {
                                        "sense_id": "325b0204-4433-3791-91bc-8b5120e4ac70",
                                        "entry_id": "72954dc8-51ff-3d4d-8380-5173273473c8",
                                        "glosses": [
                                            "Neusein, das noch nicht dagewesen Sein"
                                        ],
                                        "tags": [],
