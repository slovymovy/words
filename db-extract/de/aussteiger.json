                "senses": [
                    {
                        "sense_id": "723638d9-f0f5-30f3-8599-112257a6ae81",
                        "entry_id": "1ecb8676-dadb-3e23-8f59-bcad3f9d1e3f",
                        "glosses": [
                            "Person, die etwas (plötzlich und komplett) aufgegeben hat, zum Beispiel den Beruf oder die Zugehörigkeit zu einer bestimmten Gruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a80f8b31-11aa-4747-a32a-f83d1c5a5829",
                                "sense_id": "723638d9-f0f5-30f3-8599-112257a6ae81",
                                "text": "Ein Aussteiger berichtet von seinem verbesserten Gesundheitszustand, seit er die beruflichen Verpflichtungen los ist."
                            },
                            {
                                "example_id": "3a65a77f-a820-4513-b0f6-1e48a2cbba4f",
                                "sense_id": "723638d9-f0f5-30f3-8599-112257a6ae81",
                                "text": "„Kein Wunder, daß die Zahl der Aussteiger aus dem klösterlichen Leben wächst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
