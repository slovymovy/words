                            "canonical"
                        ],
                        "form": "let’s"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5f1b389-26f2-33ba-8387-50ff8435049f",
                        "entry_id": "47bcaa8e-a128-3e77-b7a3-d1bbd4aed977",
                        "glosses": [
                            "Used to form the cohortative of verbs, equivalent of the first-person plural imperative in some other languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccf6bfb-d973-4940-ba8f-13982ffe321e",
                                "sense_id": "e5f1b389-26f2-33ba-8387-50ff8435049f",
                                "text": "Let’s eat lunch sometime, shall we?"
                            },
                            {
                                "example_id": "f24609d0-8994-4d65-b943-51ddec4cbcdf",
                                "sense_id": "e5f1b389-26f2-33ba-8387-50ff8435049f",
                                "text": "I say let’s dance."
                            },
                            {
                                "example_id": "79c2b67f-17d0-4570-a9f0-6e9324b822e1",
                                "sense_id": "e5f1b389-26f2-33ba-8387-50ff8435049f",
                                "text": "Let's buy a bottle of champagne if Mom comes, we’ll wait and see.)"
                            },
                            {
                                "example_id": "84f6c938-f19d-4b6d-b4bb-f5c1f6b77dc1",
                                "sense_id": "e5f1b389-26f2-33ba-8387-50ff8435049f",
                                "text": "Let's go for a walk, shall we? -Sure, let’s."
                            },
                            {
                                "example_id": "7ddcfadc-fcc2-4f2e-8dc3-7a840a28a06f",
                                "sense_id": "e5f1b389-26f2-33ba-8387-50ff8435049f",
                                "text": "Let’s get coffee!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e9e815d0-298b-3cec-8e0e-a206665aff5c",
                        "entry_id": "47bcaa8e-a128-3e77-b7a3-d1bbd4aed977",
                        "glosses": [
                            "Used to form the hortative of verbs, equivalent of the second-person plural imperative in some other languages, chiefly instructional"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d1d7caf-c613-4a1c-bfad-1537f799600b",
                                "sense_id": "e9e815d0-298b-3cec-8e0e-a206665aff5c",
                                "text": "Let’s make sure we don’t forget proper punctuation, let's not let those mistakes happen again."
                            },
                            {
                                "example_id": "414e0133-a09c-4687-8d07-2432e3bd08d9",
                                "sense_id": "e9e815d0-298b-3cec-8e0e-a206665aff5c",
                                "text": "Hey guys, let’s check to make sure that we proofread."
                            },
                            {
                                "example_id": "b6d03c79-f3bc-4990-8e36-b1f9dcbde3b5",
                                "sense_id": "e9e815d0-298b-3cec-8e0e-a206665aff5c",
                                "text": "Y’all, let’s stop talking please, y’all are driving me up the wall!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9ef29fa-1cd9-470c-9157-c9ae633a15a5",
                        "source_entry_id": "47bcaa8e-a128-3e77-b7a3-d1bbd4aed977",
                        "source_sense_description": "let us; forming first-person plural imperative",
                        "target_lang_word": "我們",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "我們",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                        "entry_id": "c5c25719-759c-3e2d-a3ea-735e7eb7be18",
                                        "glosses": [
                                            "（官話）第一人稱複數代詞。包括話者在內。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5181c28a-f891-4988-8b18-bd3cf1bffbc0",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "我們是朋友。"
                                            },
                                            {
                                                "example_id": "5fd3e20f-360f-465c-b280-d6ad92170526",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "我们是朋友。"
                                            },
                                            {
                                                "example_id": "072c1e6d-72cc-43cc-bbc4-5e3e488e9f05",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "他跟我們不一樣。"
                                            },
                                            {
                                                "example_id": "c501dd92-2e68-41a0-8d8d-66e3593660a5",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "他跟我们不一样。"
                                            },
                                            {
                                                "example_id": "068747b5-ae5f-49c2-9bcd-728f99ccd833",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "我們到時候再說吧。"
                                            },
                                            {
                                                "example_id": "07f0bf44-6c1d-4e59-8657-e6d58798c2b4",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "我们到时候再说吧。"
                                            },
                                            {
                                                "example_id": "9d156155-8187-415a-8cf7-ce92a1809af3",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "我們的汽車尾巴被撞壞了。"
                                            },
                                            {
                                                "example_id": "b72998d5-4b5e-4197-aed1-f6b31c8154cd",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "我们的汽车尾巴被撞坏了。"
                                            },
                                            {
                                                "example_id": "b23b1a17-74b9-44ae-9475-b519f745ca56",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "最終我們都活成了自己討厭的樣子。"
                                            },
                                            {
                                                "example_id": "37b7903e-7a45-4107-bc47-9bbf713a491f",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "最终我们都活成了自己讨厌的样子。"
                                            },
                                            {
                                                "example_id": "f4bb417f-d618-4ef6-a28a-f7a7fb71b030",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "今日我們傳你來，有遵旨問你的事。",
                                                "translation": "我們今天叫你過來，是因為我們要服從皇帝的命令並問你一些問題。"
                                            },
                                            {
                                                "example_id": "a2846e48-8454-440d-ab11-d88b15374f2e",
                                                "sense_id": "d08128da-b688-3d7b-a350-d84feb409c61",
                                                "text": "今日我们传你来，有遵旨问你的事。",
                                                "translation": "我們今天叫你過來，是因為我們要服從皇帝的命令並問你一些問題。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
