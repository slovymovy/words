                        ],
                        "examples": [
                            {
                                "example_id": "f42187f8-2799-4fa0-95ed-fbce586743f4",
                                "sense_id": "c31f48c5-8af0-34ee-beb3-934f2b878e26",
                                "text": "Even worse than being caught in daylight is the mortification, by Mr. Moore’s nocturnal lights, of wearing black clothes so overwashed that they start to look gray."
                            }
                        ]
                    },
                    {
