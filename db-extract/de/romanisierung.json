                                        "entry_id": "3055aeb7-9f97-35ad-88d6-65c4d5ddb26e",
                                        "glosses": [
                                            "The act or process of putting text into the Latin (Roman) alphabet, by means such as transliteration and transcription."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
