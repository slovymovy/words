                        "examples": [
                            {
                                "example_id": "2a2c6fda-b1dc-4d63-acd5-2f5ce103801a",
                                "sense_id": "cfbeac44-5157-3457-9af3-a89ec86a4da7",
                                "text": "' De jongen begon verheugd rond de vijver te lopen terwijl hij nadacht over wat hij zou wensen, maar voordat hij een besluit had genomen, sneed een angstkreet door de lucht."
                            },
                            {
                                "example_id": "28c9ef60-a5b4-4cb2-a646-642e45f7d7b9",
                                "sense_id": "cfbeac44-5157-3457-9af3-a89ec86a4da7",
                                "text": "Als ze mij rennend aan zien komen, slaken ze een angstkreet, ze vluchten de trapjes op en schieten een van de hutten in."
                            }
                        ]
                    }
