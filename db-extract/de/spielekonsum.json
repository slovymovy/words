                "senses": [
                    {
                        "sense_id": "5f854b6e-2417-3278-9acd-10b288a034ed",
                        "entry_id": "2ce616bb-eccf-3a66-beef-7ecfc3b72003",
                        "glosses": [
                            "unreflektiertes übermäßiges Aneinanderreihen von vielerlei Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5fdf120-7049-4917-aba0-52461ff3a16e",
                                "sense_id": "5f854b6e-2417-3278-9acd-10b288a034ed",
                                "text": "„Demnach gäbe es einen Zusammenhang zwischen dem Bildungsniveau und dem Spielekonsum, der so bisher noch nicht tituliert wurde.“"
                            },
                            {
                                "example_id": "f3783eec-361b-4fa6-9ad9-d6e2d5d4fcdf",
                                "sense_id": "5f854b6e-2417-3278-9acd-10b288a034ed",
                                "text": "„Was sich vom Spielekonsum schon deswegen unterscheidet, weil wir akustisch und optisch auf eine ganz persönliche, unprätentiöse Ästhetik stoßen.“"
                            },
                            {
                                "example_id": "dabb37a7-5cb6-467e-944d-5f2022986203",
                                "sense_id": "5f854b6e-2417-3278-9acd-10b288a034ed",
                                "text": "„Spielesammlungen verführen und führen leicht zu gedankenlosem Spielekonsum: Der Konsument verabschiedet sich vom Nachdenken über das Spielen, von der Reflexion seines Sinns, vom kreativen Spiel mit dem Spiel.“"
                            },
                            {
                                "example_id": "eba765fd-4387-40e5-a2e7-45282cc36660",
                                "sense_id": "5f854b6e-2417-3278-9acd-10b288a034ed",
                                "text": "„Der Verein befürchtet durch übermäßigen Spielekonsum langfristig schlimme Auswirkungen auf Einstellungen der Jugendlichen in ihrem Verkehrsverhalten.“"
                            },
                            {
                                "example_id": "26173fa9-b2cc-4ac9-959d-cdde62e50a34",
                                "sense_id": "5f854b6e-2417-3278-9acd-10b288a034ed",
                                "text": "„Am Wochenende steigt der Spielekonsum der Mädchen moderat auf 57 Minuten, bei den Jungen explodiert er auf durchschnittlich 152 Minuten!“"
                            },
                            {
                                "example_id": "b014cd57-6f04-4c0c-bd3a-a469dbe14f07",
                                "sense_id": "5f854b6e-2417-3278-9acd-10b288a034ed",
                                "text": "„Den besten Schutz vor den Risiken von übermäßigem Spielekonsum bietet ein starkes Selbstvertrauen der Kinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
