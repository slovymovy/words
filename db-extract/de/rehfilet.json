                "senses": [
                    {
                        "sense_id": "e97dfb97-9260-31df-9f4b-173f10417ba2",
                        "entry_id": "66348a5b-0683-38d0-9bea-78cb299e3545",
                        "glosses": [
                            "Filet eines Rehs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "671de414-f68a-4dbd-bc21-ed2ce34b4f73",
                                "sense_id": "e97dfb97-9260-31df-9f4b-173f10417ba2",
                                "text": "Zum Abendessen wurde Rehfilet an Kroketten und jungen Möhrchen serviert."
                            },
                            {
                                "example_id": "34197b75-062e-41c8-99fd-aa053188bfe3",
                                "sense_id": "e97dfb97-9260-31df-9f4b-173f10417ba2",
                                "text": "„In seinem Blog \"haut-gout.de\" stellt er Rezepte wie Flammkuchen mit Rehfilet oder Damwildsteaks in Kirschmarinade vor und zeigt, wie man Hackfleisch aus Rehschulter oder Rehnieren zubereitet.“"
                            },
                            {
                                "example_id": "492faa20-853e-44fa-b593-b2b40968f21f",
                                "sense_id": "e97dfb97-9260-31df-9f4b-173f10417ba2",
                                "text": "„Über Jahre hatte er den Rôtisseur-Platz in seiner Küche inne, jene Position in der Haute Cuisine also, an dem der Lammrücken gedämpft, die Kalbsniere gegrillt und das Rehfilet gebraten werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
