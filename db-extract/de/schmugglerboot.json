                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "67e0beec-9057-4c0c-aa74-fe36f0cc5088",
                                "sense_id": "ce9db5e3-1fc9-30cc-b475-d7982cdce401",
                                "text": "„Dieses Signal wurde bald beantwortet, und dann hieß es Ausschau halten nach den Schmugglerbooten.“"
                            },
                            {
                                "example_id": "1cddfaf1-bf0c-443f-bc06-4e064bc2f41c",
                                "sense_id": "ce9db5e3-1fc9-30cc-b475-d7982cdce401",
                                "text": "„Das Schmugglerboot sei bereits am Samstag vor der Küste Galiciens abgefangen, doch erst drei Tage später nach der Bergung untersucht worden, teilte die Polizei am Mittwoch mit.“"
                            }
                        ],
