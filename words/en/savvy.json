                    "sense_id": "4658fd88-462c-3223-8126-a9d851143c00",
                    "sense_definition": "Shrewd, well-informed, and perceptive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>savvy</w> businesswoman who knows how to negotiate the best deals.",
                            "target_lang_translations": {
