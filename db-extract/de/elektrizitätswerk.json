                ],
                "senses": [
                    {
                        "sense_id": "fc0117a4-3b2a-3765-8e3c-05191015b74d",
                        "entry_id": "7f151734-bcfa-3c48-8370-16fc01ff594e",
                        "glosses": [
                            "Centrale électrique, usine, produisant de l’énergie électrique à partir d’autres formes d’énergie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "89480417-181c-472e-88f0-c86456b14828",
                                "sense_id": "fc0117a4-3b2a-3765-8e3c-05191015b74d",
                                "text": "Am Mittwoch aber wurde von der Hamburger Bürgerschaft einstimmig die Entschließung angenommen, daß sie den Senat auffordern werde, zurückzutreten, wenn die beiden größten Hamburger Elektrizitätswerke wirklich, wie angekündigt, an Rußland ausgeliefert würden."
                            },
                            {
                                "example_id": "8108499a-b289-433d-bd7b-0cd415da6b8a",
                                "sense_id": "fc0117a4-3b2a-3765-8e3c-05191015b74d",
                                "text": "Häufig sind Elektrizitätswerke Bestandteil von Stadtwerken. — Les centrales électriques font souvent partie intégrante des services municipaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "01f95782-c956-325d-9c66-9c20783a8a1b",
                        "entry_id": "7f151734-bcfa-3c48-8370-16fc01ff594e",
                        "glosses": [
                            "Nom ou partie du nom d’une entreprise de production d’énergie"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bafb5e28-360e-3046-8038-4d6b32ad9db7",
                        "entry_id": "7f151734-bcfa-3c48-8370-16fc01ff594e",
                        "glosses": [
                            "Carte à jouer au jeu de Monopoly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df17686b-9ac0-498d-9f09-7c5acd1bc318",
                                "sense_id": "bafb5e28-360e-3046-8038-4d6b32ad9db7",
                                "text": "Ich möchte das Elektrizitätswerk kaufen. — Je souhaite acheter l’usine électrique."
                            }
                        ]
                    }
                ],
