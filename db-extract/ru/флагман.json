                        ],
                        "form": "фла́гманах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "169f5eb5-1ab4-33d0-ad88-2b6514cd013b",
                        "entry_id": "3b4f28fd-4101-379b-8122-9c9e63e190ba",
                        "glosses": [
                            "одуш. истор. начальник эскадры, командующий эскадрой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deb98d7f-fb0d-402f-a4cb-381fa679441f",
                                "sense_id": "169f5eb5-1ab4-33d0-ad88-2b6514cd013b",
                                "text": "Граф Алексей Григорьевич Орлов имел под главным начальством своим русский флот, плававший в Средиземном море под флагом старшего флагмана, контр-адмирала Самуила Карловича Грейга, англичанина."
                            },
                            {
                                "example_id": "425f900d-101f-4377-bd8e-f698053cb1d3",
                                "sense_id": "169f5eb5-1ab4-33d0-ad88-2b6514cd013b",
                                "text": "Нахимов, обращаясь к флагманам и командирам судов своего отряда с последними словами…"
                            }
                        ]
                    },
                    {
                        "sense_id": "3188bcba-9cf8-320d-908d-6375e97240e2",
                        "entry_id": "3b4f28fd-4101-379b-8122-9c9e63e190ba",
                        "glosses": [
                            "одуш. воен. военное звание командного состава морских сил СССР"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8fcbc4a7-77d7-3913-a176-ecb997b16af6",
                        "entry_id": "3b4f28fd-4101-379b-8122-9c9e63e190ba",
                        "glosses": [
                            "неодуш. крупный корабль, на котором обычно находится командующий каким-нибудь соединением, эскадрой, флотом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83b6395-0d52-4e66-887c-125f5a6e1ac0",
                                "sense_id": "8fcbc4a7-77d7-3913-a176-ecb997b16af6",
                                "text": "Матросы с флагмана «Орьян» и фрегата «Артемис» с утра до вечера перетаскивали в трюмы набитые золотом бочки и погребцы."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed2dd04d-f1a8-3deb-beb6-04515df5ed9c",
                        "entry_id": "3b4f28fd-4101-379b-8122-9c9e63e190ba",
                        "glosses": [
                            "неодуш. самое крупное или лучшее судно флота данного района, специальной флотилии, данного типа судов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32b73c30-9a9b-48e6-ad23-199fc8a0d651",
                                "sense_id": "ed2dd04d-f1a8-3deb-beb6-04515df5ed9c",
                                "text": "Даже флагман пассажирского флота ― теплоход «Советский Союз» принимает на борт лишь 700 человек, а желающих ― десятки и сотни тысяч."
                            },
                            {
                                "example_id": "6dfaa161-1467-4cb5-9e52-c127789ba51a",
                                "sense_id": "ed2dd04d-f1a8-3deb-beb6-04515df5ed9c",
                                "text": "Дизель-электроход «Обь», тогдашний флагман нашего антарктического флота, должен был отправиться с участниками очередной, 12-й полярной экспедиции из Ленинграда в сентябре 1966 года."
                            }
                        ]
                    },
                    {
                        "sense_id": "370cf992-ddf3-315f-95e7-72b3c9c84b41",
                        "entry_id": "3b4f28fd-4101-379b-8122-9c9e63e190ba",
                        "glosses": [
                            "неодуш. перен. о чём-то главном, ведущем в отрасли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8973df-2d36-406f-8733-da5284d053fa",
                                "sense_id": "370cf992-ddf3-315f-95e7-72b3c9c84b41",
                                "text": "Самая крупная в мире Красноярская ГЭС и современный флагман Аэрофлота Ту-144 говорят сами за себя и за своих создателей."
                            },
                            {
                                "example_id": "9512260b-00b7-4580-bec1-23bc755fb445",
                                "sense_id": "370cf992-ddf3-315f-95e7-72b3c9c84b41",
                                "text": "Автомобиль Skoda Superb иначе как флагманом чешско-немецкого концерна не величают."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9ee123d-5eec-4792-ad04-19605d461530",
                        "source_entry_id": "3b4f28fd-4101-379b-8122-9c9e63e190ba",
                        "target_lang_word": "flagship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flagship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7f08b5d-9bee-33fd-b561-4c1bf92c2963",
                                        "entry_id": "5488494a-f3e0-3d0c-b232-1f8b13a3aee4",
                                        "glosses": [
                                            "The ship occupied by the fleet's commander (usually an admiral); it denotes this by flying his flag."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5720f80a-e46a-4ad0-8f46-11094d93f3fa",
                                                "sense_id": "a7f08b5d-9bee-33fd-b561-4c1bf92c2963",
                                                "text": "After Russia’s flagship in the Black Sea, the Moskva, sank last week, the authorities said that the entire crew of more than 500 had been rescued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1bb5206-4f98-30f0-b471-35c0a4bca113",
                                        "entry_id": "5488494a-f3e0-3d0c-b232-1f8b13a3aee4",
                                        "glosses": [
                                            "The ship regarded as most important out of a group, e.g. a nation's navy or company's fleet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "189d0d98-7a59-3a5e-88ae-c6fbf3ac2523",
                                        "entry_id": "5488494a-f3e0-3d0c-b232-1f8b13a3aee4",
                                        "glosses": [
                                            "The most important one out of a related group."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "broadly",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f1d52d3-44c2-4299-a1d6-b71800109246",
                                                "sense_id": "189d0d98-7a59-3a5e-88ae-c6fbf3ac2523",
                                                "text": "The retail company's store in London is their flagship."
                                            },
                                            {
                                                "example_id": "0b280ba3-85c3-46d1-b76d-ad571ebf4ecc",
                                                "sense_id": "189d0d98-7a59-3a5e-88ae-c6fbf3ac2523",
                                                "text": "Ars Technica’s Ron Amadeo considered the two smartphones together, and claimed them worthy flagships for Android: […]"
                                            },
                                            {
                                                "example_id": "c6555124-793d-4e1b-a264-d270d9125308",
                                                "sense_id": "189d0d98-7a59-3a5e-88ae-c6fbf3ac2523",
                                                "text": "Next year, Stella McCartney’s London flagship store will move from Bruton Street to a landmark Old Bond Street location. The move is the most prominent symbol of the label’s strong financial results."
                                            },
                                            {
                                                "example_id": "ceef6e14-8716-488a-ab8a-48cfd254c298",
                                                "sense_id": "189d0d98-7a59-3a5e-88ae-c6fbf3ac2523",
                                                "text": "Transport Minister Baroness Vere has conceded that the Government does not yet know how its flagship £96 billion Integrated Rail Plan \"will actually work on the ground\"."
                                            },
                                            {
                                                "example_id": "deb313ee-ed01-4928-957e-db94f946bb91",
                                                "sense_id": "189d0d98-7a59-3a5e-88ae-c6fbf3ac2523",
                                                "text": "The latest prime minister, the recently reappointed Sébastien Lecornu, may have bought himself a stay of execution on Tuesday, sacrificing Emmanuel Macron’s flagship pensions overhaul in exchange for opposition Socialist votes as the price for his government’s survival."
                                            }
                                        ]
                                    }
                                ]
                            },
