                        "examples": [
                            {
                                "example_id": "1f7d03b1-7fd8-4649-9e89-3429b1b48cae",
                                "sense_id": "8771ebf5-a3b3-387c-af29-6a6f9b0835d4",
                                "text": "Kobieta trzyma w ręce krzesiwo w kształcie podkowy, jakby to było ucho dzbanka, i uderza nim o krzemień trzymany w drugiej dłoni"
                            }
