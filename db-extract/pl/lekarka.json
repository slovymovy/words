                    },
                    {
                        "translation_id": "69428bfd-1bf6-46e4-9c33-09762b124809",
                        "source_entry_id": "7bf15c46-013b-31ba-91c7-110fbf3c2fbd",
                        "source_sense_id": "a61d0ab1-862b-327b-bd7a-9ddff155ad18",
                        "target_lang_word": "Ärztin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ärztin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                        "entry_id": "ee24931e-ff0f-3ebb-9449-64f97d1f562c",
                                        "glosses": [
                                            "Heilkundige, die ein Medizinstudium abgeschlossen hat und nach Erlangung der medizinischen Approbation körperliche und seelische Krankheiten behandelt"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Gesundheitswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd22190-ac45-4d86-ad83-d4c18b74d11e",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "Meine Ärztin hat mir dieses Medikament empfohlen."
                                            },
                                            {
                                                "example_id": "dd8cc088-4b8e-4939-926e-200ddfc584a5",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "Samanthas Töchter sind beide Ärztinnen geworden."
                                            },
                                            {
                                                "example_id": "622ffc90-c9c0-48e5-975a-e098e1b8b756",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "„Joyce sagt, dass sie früher Ärztin werden wollte.“"
                                            },
                                            {
                                                "example_id": "7e0d3d3e-16f8-4039-9cad-dba3faeb1eb4",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "„Besonders im Examen mußten sich die angehenden Ärztinnen auf alles gefaßt machen.“"
                                            },
                                            {
                                                "example_id": "7ba0af31-bfdb-432d-9f45-3fda516d30fa",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "„Das berufsernste Gesicht der Ärztin entspannt sich, ihre Wangen zeigen farbige Zeichen innerer Freude.“"
                                            },
                                            {
                                                "example_id": "ada7d190-3c90-4c75-8038-c5896fa0b167",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "„Die Ärztin sagte dies sehr entschieden und erst jetzt fiel mir auf, dass sie gar keinen Arztkittel trug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "380aa86a-b86f-4fbe-9ee3-6355892180fc",
                        "source_entry_id": "7bf15c46-013b-31ba-91c7-110fbf3c2fbd",
                        "source_sense_id": "a61d0ab1-862b-327b-bd7a-9ddff155ad18",
