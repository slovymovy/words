                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7fe5fa2-5773-4991-848e-04c225835f8f",
                                "sense_id": "9fc4f1ad-9c4b-3648-94b2-cd6e89445ccc",
                                "text": "In the conflict theory, there is an impulse or a motive, and an opposing counterimpulse or countermotive."
                            },
                            {
                                "example_id": "428cfa29-c847-4749-8d3e-c1f96841b21c",
                                "sense_id": "9fc4f1ad-9c4b-3648-94b2-cd6e89445ccc",
                                "text": "If the presence of a counterimpulse were sufficient to determine a mistake all of us should and would be constantly making mistakes."
                            },
                            {
                                "example_id": "2ee15b3f-86a5-44f3-9aa9-6153e01c547c",
                                "sense_id": "9fc4f1ad-9c4b-3648-94b2-cd6e89445ccc",
                                "text": "This counterimpulse tends to embrace everything difficult and European with juvenile zeal."
                            }
                        ]
