                "senses": [
                    {
                        "sense_id": "18a7bf86-1855-3f44-9c80-e6b58790dcc0",
                        "entry_id": "16549072-d332-3f3f-a0d9-7aed4a5da9a9",
                        "glosses": [
                            "Faire des scoops, donner des scoops à, annoncer une nouvelle avant un autre média."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "ab2522a0-d574-4151-9be7-33623f044663",
                                "sense_id": "18a7bf86-1855-3f44-9c80-e6b58790dcc0",
                                "text": "À la télévision, dans les journaux, on scoope, on flashe, on raisonne peu..."
                            },
                            {
                                "example_id": "0dcc42b3-7b69-4b10-bdf1-3dda69f8f333",
                                "sense_id": "18a7bf86-1855-3f44-9c80-e6b58790dcc0",
                                "text": "une sérieuse concurrence : en deux mois d'existence, MSNBC, forte de l'équipe de rédaction de NBC et de ses stars (Tom Brokaw, Jane Pauley, Bryant Gumbel), a déjà « scoopé » plusieurs fois son aînée."
                            },
                            {
                                "example_id": "4d8a0439-17e0-4601-a58b-3f85c95ff1ec",
                                "sense_id": "18a7bf86-1855-3f44-9c80-e6b58790dcc0",
                                "text": "Ces deux faits nouveaux - les journaux qui se «scoopent» eux-mêmes et les cyber-médias capables de «scooper» les journaux - propulsaient soudain la presse écrite dans une nouvelle ère : l’ère de l’instantanéité."
                            }
                        ]
                    }
