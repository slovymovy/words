                "senses": [
                    {
                        "sense_id": "101bfb8e-8aa3-39fb-b2c3-6752802e100e",
                        "entry_id": "b6479568-4a47-362c-aa34-f4b31bf84bb8",
                        "glosses": [
                            "Politik, Demonstration militärischer Stärke als Drohung"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "df6cf211-2547-41b9-ae3a-04acf08b2091",
                                "sense_id": "101bfb8e-8aa3-39fb-b2c3-6752802e100e",
                                "text": "„Durch blutrünstige Reden, auftrumpfendes Säbelrasseln und diplomatische Taktlosigkeiten schlimmster Art habe er für einen permanenten Alarmzustand gesorgt und das Misstrauen der anderen Mächte in die Absichten der deutschen Politik geschürt.“"
                            },
                            {
                                "example_id": "1d37c599-5953-436a-b3d8-2fb9254696fb",
                                "sense_id": "101bfb8e-8aa3-39fb-b2c3-6752802e100e",
                                "text": "„In den letzten Jahren muss man besonders Delhi eine gewisse Besonnenheit zugute halten, da es sich von den letzten größeren Anschlägen - wie in Mumbai 2011 - wenig beeindrucken ließ und auf ein Säbelrasseln verzichtete.“"
                            },
                            {
                                "example_id": "6df05e04-20ca-45de-8d0f-a7b4f438081c",
                                "sense_id": "101bfb8e-8aa3-39fb-b2c3-6752802e100e",
                                "text": "„Doch folgten diesem Säbelrasseln nur Scharmützel, da Iran kein direktes Eingreifen in den Afghanistankonflikt anstrebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
