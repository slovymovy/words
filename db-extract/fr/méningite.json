        "fr-extract.jsonl": [
            {
                "entry_id": "75a20fed-373e-3fc3-9a6a-2afad39f66dd",
                "word": "méningite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "971c0fca-412d-4284-bfd0-a32b5f17e954",
                        "entry_id": "75a20fed-373e-3fc3-9a6a-2afad39f66dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "méningites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07294434-af18-3b79-9f92-f9602773e0b6",
                        "entry_id": "75a20fed-373e-3fc3-9a6a-2afad39f66dd",
                        "glosses": [
                            "Nom générique donné aux diverses inflammations des méninges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4487272-e0f1-464b-a6b0-df0fdaf2975d",
                                "sense_id": "07294434-af18-3b79-9f92-f9602773e0b6",
                                "text": "Il ne m’avait été que trop facile de constater les symptômes d’une méningite aiguë. Je prescrivis des révulsifs aux pieds et des sangsues derrière les oreilles."
                            },
                            {
                                "example_id": "101cd0a4-43f2-4e71-8670-bcde0cbcc4e2",
                                "sense_id": "07294434-af18-3b79-9f92-f9602773e0b6",
                                "text": "Un réserviste du 6ᵉ dragons rentre dans sa famille, dans le Calvados, le 15 février 1909. Il s'alite le 16 et le 17 pour une angine légère. Le 22 février, sa jeune domestique, âgée de quatorze ans, est prise de méningite."
                            },
                            {
                                "example_id": "cc296d4a-40f3-490c-82ef-fb3a3280f41e",
                                "sense_id": "07294434-af18-3b79-9f92-f9602773e0b6",
                                "text": "Les médecins parlèrent de méningite, d’encéphalite, on ne sut rien de précis."
                            },
                            {
                                "example_id": "4edd7992-d83c-4bf0-91ac-e162131dcebe",
                                "sense_id": "07294434-af18-3b79-9f92-f9602773e0b6",
                                "text": "Puis viennent le pneumocoque, qui tue 10 personnes par an chez nous, et la méningite à méningocoque, qui ne tue qu’une personne par an, en dépit de sa médiatisation extrême, la moindre infection au méningocoque – même non mortelle –, faisant la une des journaux et de Google."
                            },
                            {
                                "example_id": "ea849f28-fad2-487c-b45a-c8d6467fb16e",
                                "sense_id": "07294434-af18-3b79-9f92-f9602773e0b6",
                                "text": "La situation humanitaire dans l'enclave palestinienne est catastrophique, la population manque de tout et les premières victimes sont les enfants. Parmi les risques sanitaires figurent la méningite, qui se propage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "302cdd64-505d-4860-bd75-a6b8cdfca9ec",
                        "source_entry_id": "75a20fed-373e-3fc3-9a6a-2afad39f66dd",
                        "source_sense_id": "07294434-af18-3b79-9f92-f9602773e0b6",
                        "target_lang_word": "Meningitis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meningitis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbe7ada2-278e-373a-96d7-7522acf049f4",
                                        "entry_id": "14b67ab5-7a8d-31d0-aaab-5fc6ace842c1",
                                        "glosses": [
                                            "Hirnhautentzündung, genauer: Entzündung der Pia mater und der Arachnoidea mater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e83fdc-dd97-42d5-8c88-5e08596d2f2d",
                                                "sense_id": "bbe7ada2-278e-373a-96d7-7522acf049f4",
                                                "text": "Klinisch unterscheidet man jedoch die weitgehend harmlose lymphozytäre Meningitis durch Viren von der hochgefährlichen und unbehandelt fast stets zum Tode führenden eitrigen Meningitis durch Bakterien."
                                            },
                                            {
                                                "example_id": "2a92b459-0f6e-4480-95f6-6217572124d2",
                                                "sense_id": "bbe7ada2-278e-373a-96d7-7522acf049f4",
                                                "text": "„Pastor lacht glucksend und biegt dabei den Kopf in den Nacken, als litte er an den Symptomen einer akuten Meningitis.“"
                                            },
                                            {
                                                "example_id": "2cba1e29-ae99-4ec1-9f70-bf4b2142aa12",
                                                "sense_id": "bbe7ada2-278e-373a-96d7-7522acf049f4",
                                                "text": "„Eine neue Blutung schwemmt die Tuberkelbazillen in den Blutkreislauf und erzeugt die todbringende Meningitis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
