                "senses": [
                    {
                        "sense_id": "126f149a-cbf0-38a2-bd09-dd1207219344",
                        "entry_id": "a2db40e8-f0b5-37bd-81ba-d7591bc34658",
                        "glosses": [
                            "veraltet: kleines Einzelhandelsgeschäft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f3d2345-c003-48f4-bada-43ac08957b01",
                                "sense_id": "126f149a-cbf0-38a2-bd09-dd1207219344",
                                "text": "„Zwei Discounter-Supermärkte haben den ursprünglichen Kaufmannsladen seit den Jahren 2001/2002 abgelöst und stellen die Grundversorgung sicher.“"
                            },
                            {
                                "example_id": "00a950ad-e276-4981-9563-630fdf3f7027",
                                "sense_id": "126f149a-cbf0-38a2-bd09-dd1207219344",
                                "text": "„Neben der Ausstellung von Gebrauchsgegenständen und Einrichtungen wie einem Kaufmannsladen aus dem 19. Jahrhundert dokumentiert es die Geschichte der Region.“"
                            },
                            {
                                "example_id": "74375387-9be2-4a1b-9d03-62378b41bf35",
                                "sense_id": "126f149a-cbf0-38a2-bd09-dd1207219344",
                                "text": "„Chrissi betrat den Kaufmannsladen dann mit einem Buch, in das alles eingetragen wurde, was sie einholte.“"
                            },
                            {
                                "example_id": "f41beda5-16ed-4351-9305-01fa7f1fe7a4",
                                "sense_id": "126f149a-cbf0-38a2-bd09-dd1207219344",
                                "text": "„Sie stiegen bei dem Kaufmannsladen ab, sprachen mit den Gehilfen des Kaufmanns, zeigten ihre Briefe und verlangten, mit dem Schiffsführer zu sprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7dabebff-34d1-3edf-86fa-366ab7c2b779",
                        "entry_id": "a2db40e8-f0b5-37bd-81ba-d7591bc34658",
                        "glosses": [
                            "Einzelhandelsgeschäft als Kinderspielzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb5f52eb-bd92-4807-a898-be3bbae922f6",
                                "sense_id": "7dabebff-34d1-3edf-86fa-366ab7c2b779",
                                "text": "„Es gab auch einen Kaufmannsladen mit einer klingelnden Registrierkasse und einer kleinen Waage.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
