                                "target_senses": [
                                    {
                                        "sense_id": "f04dcc52-c355-3150-8114-8ac9ce26d3c7",
                                        "entry_id": "e0e89554-d7eb-3353-b311-9507d2cf4611",
                                        "glosses": [
                                            "…występująca bezpośrednio po wyrazie, który mówca chce podkreślić (i tym samym swoje uniesienie, euforię lub rozgoryczenie)"
                                        ],
                                        "tags": [
