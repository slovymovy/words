                ],
                "senses": [
                    {
                        "sense_id": "388790af-1ab1-3d6c-abe2-6f5e3bc2902b",
                        "entry_id": "540bb1f8-bc2a-35e1-adc5-300ce24effc6",
                        "glosses": [
                            "разг. абсолютно новый, ни разу не использовавшийся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87fb5b7-372d-49af-a9e0-2d3b591fe5bc",
                                "sense_id": "388790af-1ab1-3d6c-abe2-6f5e3bc2902b",
                                "text": "Делать было нечего — простившись наскоро с родными и друзьями, я легко прыгнул в свой нулёвый шестисотый и помчался в аэропорт."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a33fbdf-14d1-3553-b23a-dc8b2d3a90ca",
                        "entry_id": "540bb1f8-bc2a-35e1-adc5-300ce24effc6",
                        "glosses": [
                            "спец. то же, что нулевой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "263e4f10-7103-41a6-bd75-bd9966ec29eb",
                                "sense_id": "2a33fbdf-14d1-3553-b23a-dc8b2d3a90ca",
                                "text": "А подошву кулера настоятельно рекомендую доработать нулёвой шкуркой на куске стекла."
                            }
                        ]
                    },
                    {
                        "sense_id": "19ea249a-7d60-3c4b-9c7e-f87ebf77c77a",
                        "entry_id": "540bb1f8-bc2a-35e1-adc5-300ce24effc6",
                        "glosses": [
                            "жарг., : ничтожный, никчемный, полный ноль; необразованный, невежественный, не знающий азов"
                        ],
                        "tags": [
                            "о человеке"
                        ],
                        "examples": [
                            {
                                "example_id": "e66b1cc0-d907-4488-8786-21c68efb5e61",
                                "sense_id": "19ea249a-7d60-3c4b-9c7e-f87ebf77c77a",
                                "text": "Нулёвая твоя рожа, с нуля начнёшь!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6487543-8a06-4b78-917f-b31ac0bd59ff",
                        "source_entry_id": "540bb1f8-bc2a-35e1-adc5-300ce24effc6",
                        "target_lang_word": "brand new",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brand new",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6319c99a-d104-3fb4-91ee-473372568b38",
                                        "entry_id": "01d7d6e0-8b8f-3ea2-bf46-210bff972c2b",
                                        "glosses": [
                                            "Utterly new, as new as possible."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c838b530-aca4-4abb-8c8f-4af3a8bb3fc3",
                                                "sense_id": "6319c99a-d104-3fb4-91ee-473372568b38",
                                                "text": "New bodies, new minds ... and all thinges new, brande-newe"
                                            },
                                            {
                                                "example_id": "501109ec-fe90-4f61-8ed6-a41bf9f109c7",
                                                "sense_id": "6319c99a-d104-3fb4-91ee-473372568b38",
                                                "text": "two pair of bran-new plumpers"
                                            },
                                            {
                                                "example_id": "e764b2d2-0063-4082-9878-26d1583c9f39",
                                                "sense_id": "6319c99a-d104-3fb4-91ee-473372568b38",
                                                "text": "He ain't no drag / Papa's got a brand new bag"
                                            },
                                            {
                                                "example_id": "89f37bc4-d383-4cdd-9002-30f31ed9f885",
                                                "sense_id": "6319c99a-d104-3fb4-91ee-473372568b38",
                                                "text": "Dream on white boy / Dream on black girl / And wake up to a brand new day / To find your dreams have washed away"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c336fbcb-5dfa-3846-9248-2e68b6d36003",
                                        "entry_id": "01d7d6e0-8b8f-3ea2-bf46-210bff972c2b",
                                        "glosses": [
                                            "Acting in a way unusual for oneself."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00663ecc-a80b-4e0a-afba-674050fabad8",
                                                "sense_id": "c336fbcb-5dfa-3846-9248-2e68b6d36003",
                                                "text": "Man, quit actin' brand new, bruh. You only being this way 'cause there's a girl."
                                            }
