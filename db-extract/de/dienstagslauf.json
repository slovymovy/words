                "senses": [
                    {
                        "sense_id": "ce5a6420-52e8-3037-b5db-f8a6c2613d27",
                        "entry_id": "c902acba-c620-3ce5-a742-f70d90da1c19",
                        "glosses": [
                            "Laufen/Joggen an einem Dienstag"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "9601ca34-b3b9-412f-975f-4e3ac99527f8",
                                "sense_id": "ce5a6420-52e8-3037-b5db-f8a6c2613d27",
                                "text": "„Der übliche Dienstagslauf der Gruppe wurde auf 8 Uhr vorgezogen, damit alle beim Kinderlauf helfen konnten.“"
                            },
                            {
                                "example_id": "17912def-7529-44da-8b4b-6f408e50e843",
                                "sense_id": "ce5a6420-52e8-3037-b5db-f8a6c2613d27",
                                "text": "„Der Lauf ist für alle geeignet, die bei unseren Dienstagsläufen mitmachen – ob schnell oder nicht so schnell.“"
                            },
                            {
                                "example_id": "c8a283cf-35ae-4aa2-b878-f6fe4560aa8e",
                                "sense_id": "ce5a6420-52e8-3037-b5db-f8a6c2613d27",
                                "text": "„Deshalb stellt sich bei den Dienstagsläufen in der Winterzeit die Frage, ob Stirn- oder Taschenlampen eingesetzt werden sollten.“"
                            },
                            {
                                "example_id": "61d0f0c6-516f-4049-9a22-5c36cfaebc05",
                                "sense_id": "ce5a6420-52e8-3037-b5db-f8a6c2613d27",
                                "text": "„Wie hoch die Motivation in dieser tollen Gruppe ist, zeigt auch die Teilnahme am individuellen Dienstagslauf, bei dem die Sportler:innen [sic], einen individuellen Trainingsplan selbstständig absolvieren.“"
                            },
                            {
                                "example_id": "196f11f6-589c-452b-9492-8e86ad2ee599",
                                "sense_id": "ce5a6420-52e8-3037-b5db-f8a6c2613d27",
                                "text": "„Ich modifiziere den Plan, lege Sonntagsläufe auf Samstage, Dienstagsläufe auf Mittwoch und so weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
