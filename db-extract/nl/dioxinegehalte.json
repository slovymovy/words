                        "examples": [
                            {
                                "example_id": "a8285f27-961f-4ce6-90a5-fe9ce6e094f7",
                                "sense_id": "7c436741-ed77-3255-b3c7-e98942ca9135",
                                "text": "De Nederlandse Voedsel- en Warenautoriteit (NVWA) heeft uitgebreid onderzoek gedaan naar het dioxinegehalte van vlees van runderen uit 14 uiterwaarden. Bij ruim twee derde van de onderzochte runderen was het dioxinegehalte hoger dan de wettelijke norm."
                            },
                            {
                                "example_id": "e8236570-3295-4b99-a10e-8c561a97295b",
                                "sense_id": "7c436741-ed77-3255-b3c7-e98942ca9135",
                                "text": "Het Rijksinstituut voor Volksgezondheid en Milieu doet in de gemeente Harlingen onderzoek naar eieren met een zeer hoog dioxinegehalte nadat een bezorgde toxicoloog aan de bel trok. Ondertussen weten de bewoners van Harlingen niet meer waar ze aan toe zijn."
                            }
