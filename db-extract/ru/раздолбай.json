                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "goof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9631d0f-5ed2-3610-911d-42ee06ed23c1",
                                        "entry_id": "8fe30dc7-89da-3410-8ee9-09cb0a04ca68",
                                        "glosses": [
                                            "To make a mistake."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bde73b4a-2c7b-45da-ac04-e4cfe574467f",
                                                "sense_id": "e9631d0f-5ed2-3610-911d-42ee06ed23c1",
                                                "text": "It's my fault. I goofed."
                                            },
                                            {
                                                "example_id": "dd9bf306-fc37-4e14-93ae-07ee259e23c4",
                                                "sense_id": "e9631d0f-5ed2-3610-911d-42ee06ed23c1",
                                                "text": "GCN is in a sticky situation because we goofed and bought 10 pounds of a type of wax that we cannot use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6750c6c1-30ac-361b-bd33-14efe93e568e",
                                        "entry_id": "8fe30dc7-89da-3410-8ee9-09cb0a04ca68",
                                        "glosses": [
                                            "To engage in mischief."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec5d1563-3dc6-41a6-886e-636ebda9db63",
                                                "sense_id": "6750c6c1-30ac-361b-bd33-14efe93e568e",
                                                "text": "We were just goofing by painting the neighbor's cat green."
                                            }
                                        ]
