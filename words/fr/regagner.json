    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b031fe7e-bf65-3b67-8113-13202d16d9b9",
                    "sense_definition": "Retourner dans un lieu que l'on avait quitté ; rentrer chez soi ou à sa place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de travail au bureau, il a préféré <w>regagner</w> son domicile sans tarder."
                        },
                        {
                            "text": "À la fin de la pause, chaque élève doit rapidement <w>regagner</w> sa place en classe."
                        }
                    ],
                    "synonyms": [
                        "rentrer",
                        "retourner",
                        "rejoindre"
                    ],
                    "antonyms": [
                        "quitter",
                        "partir"
                    ],
                    "common_phrases": [
                        "regagner son domicile",
                        "regagner sa place"
                    ]
                },
                {
                    "sense_id": "c7cb33b5-8532-3876-ba81-ece28726c507",
                    "sense_definition": "Reconquérir ou recouvrer un avantage, un sentiment ou un état que l'on avait perdu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recuperation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat tente de <w>regagner</w> la confiance des électeurs avant le second tour."
                        },
                        {
                            "text": "Grâce à des réformes efficaces, notre entreprise commence enfin à <w>regagner</w> du terrain face aux concurrents."
                        }
                    ],
                    "synonyms": [
                        "reconquérir",
                        "recouvrer",
                        "récupérer"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "regagner la confiance",
                        "regagner du terrain"
                    ]
                },
                {
                    "sense_id": "f66c76a0-913f-386d-b5c8-235a6117af93",
                    "sense_definition": "Récupérer par un nouveau gain une somme d'argent ou du temps que l'on avait perdu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recuperation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur espérait désespérément <w>regagner</w> au casino l'argent qu'il venait d'égarer."
                        },
                        {
                            "text": "Le train accélère pour tenter de <w>regagner</w> le temps perdu lors de l'arrêt imprévu."
