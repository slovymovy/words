                            "singular"
                        ],
                        "form": "die Schutzschicht"
                    },
                    {
                        "form_id": "12f2504d-5b0f-4cb9-8d60-897bbbb26759",
                        "entry_id": "dcbd27f3-a715-35fb-8757-79a78ad79e5c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schutzschichten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                        "entry_id": "dcbd27f3-a715-35fb-8757-79a78ad79e5c",
                        "glosses": [
                            "dünner Überzug auf einem Gegenstand, der diesen (vor Korrosion, Schädigung) schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324f2f2f-04ae-4c6e-8843-bf087a8aba1a",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Zwei große Deutsche Lebensmittelhändler bieten derzeit Avocados, Orangen und Mandarinen mit einer Schutzschicht an, die direkt auf die Schalen aufgetragen werden.“"
                            },
                            {
                                "example_id": "827372de-1bba-40fb-b726-0ffc161a36ca",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Die Schutzschicht macht das Obst länger haltbar und hält Keime fern.“"
                            },
                            {
                                "example_id": "13099177-a4ca-47f0-8ef0-44e98835c1a9",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Künftig sollen auch andere Obst- und Gemüsesorten mit der Schutzschicht besprüht werden.“"
                            },
                            {
                                "example_id": "014763c0-6df5-4b39-bc92-56c1d23a6b25",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Brünieren“ […] „dient der Bildung einer dünnen Schutzschicht auf eisenhaltigen Oberflächen, um Korrosion zu vermindern,“ […]."
                            },
                            {
                                "example_id": "087dc3de-386e-4ec5-88b0-b5029b23af1c",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "[Eloxal-Verfahren:] „Im Gegensatz zu den galvanischen Überzugsverfahren wird beim Eloxieren die Schutzschicht nicht auf dem Werkstück niedergeschlagen, sondern durch Umwandlung der obersten Metallschicht ein Oxid bzw. Hydroxid gebildet.“"
                            },
                            {
                                "example_id": "b3cc087e-0fc1-44a9-a687-34ee533dcc67",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "[Kampf der Korrosion:] „Neben der regelmäßigen Reinigung und der trockenen Lagerung überzieht man Metallgegenstände häufig mit einer fest haftenden Schutzschicht.“"
                            },
                            {
                                "example_id": "0c90789a-edce-4f1d-977e-077cca105453",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Für das Aufbringen von Schutzschichten aus Metallen gibt es verschiedene Verfahren.“"
                            },
                            {
                                "example_id": "23d4da84-d284-4bdd-851c-0500a0ff9f34",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Deshalb wird die Oberfläche der Elektrode mit Gold oder Platin als Schutzschicht überzogen, um die Haltbarkeit“ […] „zu gewährleisten.“"
                            },
                            {
                                "example_id": "56f075b0-0eca-4f7d-924b-9ebf16557841",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„In der Handgalvanik taucht der 23-Jährige die Werkstücke in verschiedene chemische Bäder. Bei den Kleinteilen handelt es sich beispielsweise um Schrauben oder Muttern. Durch die Beschichtung erhalten sie eine Schutzschicht und werden dadurch rostfrei.“"
                            },
                            {
                                "example_id": "d553b0d8-4d5b-47da-a82e-277212995b7c",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Böden und Möbel aus rohem, unbehandeltem Holz, wie z.B. Bauernmöbel, reinigt man am besten mit Wasser und etwas Kernseife. Das Holz saugt die Feuchtigkeit auf und erhält durch die Kernseife eine feine Schutzschicht.“"
                            },
                            {
                                "example_id": "64958dbc-97b0-46cd-b699-9d6b23ebfcc3",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Wie oft die Schutzschicht erneuert werden muss, hängt davon ab, wie stark das Holz beansprucht wird.“"
                            },
                            {
                                "example_id": "d10cbf2f-b15a-4b74-9e22-f2ceca99b8f3",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Eier mögen keine Temperaturunterschiede. Durch einen Temperaturanstieg bildet sich Kondenswasser auf der Schale und die natürliche Schutzschicht wird geschädigt, so dass Keime in das Innere gelangen können.“"
                            },
                            {
                                "example_id": "b1678e39-4ee7-4c10-bd52-a19bb5431fb6",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Unter Coating versteht man das Ummanteln von verderblichen Lebensmitteln wie Obst und Gemüse mit einer hauchdünnen Schutzschicht, die nicht giftig ist. Das Verfahren macht Lebensmittel haltbarer“ […]."
                            },
                            {
                                "example_id": "c76f6f60-5e17-4d9b-859e-a4f43afaac29",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Zu häufiges Duschen hat viele Nachteile: Es verbraucht viel Wasser, Strom und zerstört die natürliche Schutzschicht der Haut.“"
                            },
                            {
                                "example_id": "6049d618-5d58-474d-aeee-2d45abde677b",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "[Säureschutzmantel der Haut:] „Doch wenn die Haut geschädigt ist, können Pilze diese Schutzschicht überwinden und mit ihren Zellfäden, den Hyphen, in die Hornschicht eindringen und sich verbreiten.“"
                            },
                            {
                                "example_id": "e163d5ef-4d03-4aef-ae25-2beaf7331abc",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Der Zahnschmelz funktioniert als Schutzschicht für den Zahn.“"
                            },
                            {
                                "example_id": "0865b1d2-dec1-4928-b56d-4fb269dcf152",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "„Die Schutzschicht unserer Augen, die Hornhaut, kann tatsächlich einen Sonnenbrand bekommen.“"
                            },
                            {
                                "example_id": "79193517-0555-4340-a225-f04fa79f8c2c",
                                "sense_id": "fa181481-27eb-369d-82fc-6f2a93eb7d74",
                                "text": "[Erkältungen:] „Ohne diese Schutzschicht aus Schleim können Viren sehr schnell in unseren Körper gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
