                        "cross_references": [
                            {
                                "target_word": "zmetek",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "57dca9cc-8e8c-3593-9dec-b38eecb7a99c",
                                        "entry_id": "0baa5809-87b6-38e1-ad32-3609c8e0e990",
                                        "glosses": [
                                            "zkažený, nepovedený výrobek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0629edf7-f552-43a2-b5b0-e97a4ba3b594",
                                                "sense_id": "57dca9cc-8e8c-3593-9dec-b38eecb7a99c",
                                                "text": "Podle generálního ředitele České spořitelny Pavla Kysilky se ukazuje, že zákon zavádějící sKartu je legislativní zmetek."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zmetek",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e0dae3e6-ab15-36bc-b01d-abd8cb98dde0",
                                        "entry_id": "c7d2a940-e719-3028-b848-5a2ac20b85d9",
                                        "glosses": [
                                            "zlý, zkažený člověk"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea649a3-e513-4aab-ae17-6bd0bdd27875",
                                                "sense_id": "e0dae3e6-ab15-36bc-b01d-abd8cb98dde0",
                                                "text": "…a ten Jarda, kterej nedokončil ani osmiletku, hodil po mně láhví se zvoláním „Zmetku!“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "757f9cb9-2285-4b37-abba-72bb20ddb8ce",
                        "source_entry_id": "5e2cc46c-ac36-3dab-8c2e-db3e9ef6af6e",
                        "source_sense_id": "c08f909a-12d4-3209-a92f-7e6893cf5ad4",
                        "target_lang_word": "šmejd",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "šmejd",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d62fe875-2f7c-3803-9a36-8d3b9c1ebd19",
                                        "entry_id": "d454fe3a-591c-3ce0-ab91-7f663bffca40",
                                        "glosses": [
                                            "nekvalitní výrobek; nekvalitní věc"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "841d3ba6-922f-43c5-b451-56ef27436e15",
                                                "sense_id": "d62fe875-2f7c-3803-9a36-8d3b9c1ebd19",
                                                "text": "Táta hulí nějakej balenej šmejd, co kupuje u Pákistánců."
                                            },
                                            {
                                                "example_id": "220cbb6e-1582-4388-b6e5-d721d75a2643",
                                                "sense_id": "d62fe875-2f7c-3803-9a36-8d3b9c1ebd19",
                                                "text": "Nyní je u nás spousta nových nakladatelství, vychází sice i kdejaký šmejd, ale to je daň za svobodu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "šmejd",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "be7578b2-df1b-32d0-8bd0-6d0040dc4808",
                                        "entry_id": "0ca633f5-92d6-39b1-bf5b-69f4ae8c25cf",
                                        "glosses": [
                                            "darebák, ničema, podvodník"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0edf1c16-6304-451e-b687-329421e95210",
                                                "sense_id": "be7578b2-df1b-32d0-8bd0-6d0040dc4808",
                                                "text": "Na ty feťácký šmejdy jsme upozorňovali několikrát."
                                            },
                                            {
                                                "example_id": "e17f774a-ade5-4bbf-b53d-1992d8ae3762",
                                                "sense_id": "be7578b2-df1b-32d0-8bd0-6d0040dc4808",
                                                "text": "Česká pošta opětovně varuje před šmejdy, kteří se vydávají za Českou poštu a podvodně lákají z klientů jejich údaje a data."
                                            },
                                            {
                                                "example_id": "80af6ede-e072-41b6-b4d7-d94ede73e1ef",
                                                "sense_id": "be7578b2-df1b-32d0-8bd0-6d0040dc4808",
                                                "text": "Paní ministryně financí Alena Schillerová vydá do 12 hodin rozhodnutí o cenové regulaci, abychom předešli různým šmejdům, kteří se snaží současné situace zneužít."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a99a2b79-04a2-3c63-9f37-8450dbabca2a",
                                        "entry_id": "0ca633f5-92d6-39b1-bf5b-69f4ae8c25cf",
                                        "glosses": [
                                            "provozovatel kontroverzních předváděcích akcí, na nichž jsou zejména důchodcům manipulativními a lichvářskými praktikami prodávány předražené výrobky"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9637c60e-12c8-45e4-bf63-c2c10a1f821f",
                                                "sense_id": "a99a2b79-04a2-3c63-9f37-8450dbabca2a",
                                                "text": "Skvělá zpráva! Se šmejdy, na jejichž hrůzné předváděcí akce deník Blesk už řadu měsíců poukazuje, se Česká obchodní inspekce (ČOI) nemazlí! Dokazují to tresty, které jim za poslední půlrok nasázela!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
