{
    "word_family": [
        "intermingle",
        "mingler",
        "minglement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08f1d106-1cb0-3507-9367-09d7eb6cee8f",
                    "sense_definition": "To socialize with different people at a social event.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "socializing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At the party, she decided to <w>mingle</w> with the other guests instead of standing in the corner.",
                            "target_lang_translations": {
                                "zh": "在派对上，她决定去和其他客人<w>交际</w>，而不是站在角落里。"
                            }
                        },
                        {
                            "text": "The host encouraged everyone to <w>mingle</w> and make new friends during the cocktail hour.",
                            "target_lang_translations": {
                                "zh": "主人鼓励大家在鸡尾酒会期间多去<w>应酬</w>，结交新朋友。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mingle with the crowd",
                        "time to mingle"
                    ],
                    "target_lang_definitions": {
                        "zh": "在社交场合与不同的人交谈、互动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "交际",
                                "target_lang_sense_clarification": "指在社交场合与人互动。"
                            },
                            {
                                "target_lang_word": "应酬",
                                "target_lang_sense_clarification": "指在社交场合与人打交道。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1b8c812-8c0d-39dc-a6ed-d26bbe3bc98e",
                    "sense_definition": "To become mixed or blended.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scents of lavender and pine <w>mingled</w> in the warm evening air.",
                            "target_lang_translations": {
                                "zh": "薰衣草和松树的香气在温暖的夜空中<w>交融</w>在一起。"
                            }
                        },
                        {
                            "text": "In his paintings, reality and fantasy <w>mingle</w> in a beautiful way.",
                            "target_lang_translations": {
                                "zh": "在他的画作中，现实与幻想以一种美妙的方式<w>混合</w>在一起。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mingle together"
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物混合在一起。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "混合",
                                "target_lang_sense_clarification": "指不同事物融合在一起。"
                            },
                            {
                                "target_lang_word": "交融",
                                "target_lang_sense_clarification": "指抽象事物或气味等融合。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1818b545-a96b-3643-9f6d-5d39fa7dcf1f",
                    "sense_definition": "To combine or join different elements together so that they are mixed but still distinguishable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist chose to <w>mingle</w> bright colors with dark shadows to create a dramatic effect.",
                            "target_lang_translations": {
                                "zh": "艺术家选择将明亮的色彩与深沉的阴影<w>掺杂</w>在一起，以营造出戏剧性的效果。"
                            }
                        },
                        {
                            "text": "He watched the two distinct liquids <w>mingle</w> in the glass without fully dissolving.",
                            "target_lang_translations": {
                                "zh": "他看着两种不同的液体在杯中<w>混合</w>，但并没有完全溶解。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将不同元素结合在一起，使之混合但仍可辨认。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "掺杂",
                                "target_lang_sense_clarification": "指将不同成分混在一起。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1dd8282-ede1-3069-8c68-9445e3fb670f",
                    "sense_definition": "To associate or unite in a figurative way, or by ties of relationship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "socializing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their family histories <w>mingle</w> back to the early days of the settlement.",
                            "target_lang_translations": {
                                "zh": "他们的家族史可以追溯到定居点建立初期，在那时就已经<w>交汇</w>了。"
                            }
                        },
                        {
                            "text": "It is fascinating to see how different cultures <w>mingle</w> in this border town.",
                            "target_lang_translations": {
                                "zh": "看到不同的文化在这个边境小镇是如何<w>交汇</w>的，真是令人着迷。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指文化、历史等在抽象层面上的融合或关联。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "交汇",
                                "target_lang_sense_clarification": "指文化或历史的融合。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b601e93-1d14-3f58-bde4-797157664991",
                    "sense_definition": "To make or prepare by mixing the ingredients of.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apothecary began to <w>mingle</w> a soothing herbal remedy for the patient.",
                            "target_lang_translations": {
                                "zh": "药剂师开始为病人<w>调配</w>一种舒缓的草药疗法。"
                            }
                        },
                        {
                            "text": "She would <w>mingle</w> various spices to create her signature seasoning.",
                            "target_lang_translations": {
                                "zh": "她会把各种香料<w>调配</w>在一起，制作出她独有的调味料。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern contexts for preparing mixtures"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "通过混合成分来制作或配制。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "调配",
                                "target_lang_sense_clarification": "指混合多种成分。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0760a44b-7f98-3a54-ad62-dd86cda2b192",
                    "sense_definition": "To deprive of purity by mixture; to contaminate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They feared that foreign influences would <w>mingle</w> and corrupt their ancient traditions.",
                            "target_lang_translations": {
                                "zh": "他们担心外来影响会<w>掺杂</w>进来并腐蚀他们古老的传统。"
                            }
                        },
                        {
                            "text": "The pure water was <w>mingled</w> with runoff from the nearby fields.",
                            "target_lang_translations": {
                                "zh": "纯净的水被附近田地流出的径流<w>掺杂</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confuse",
                        "confound"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因混合而失去纯度；污染。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "掺杂",
                                "target_lang_sense_clarification": "指混入杂质。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40513337-ee8d-3883-8a4d-7b25cf1f46cd",
                    "sense_definition": "To intermarry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two tribes began to <w>mingle</w> over generations, eventually becoming one people.",
                            "target_lang_translations": {
                                "zh": "这两个部落经过几代人的<w>通婚</w>，最终融合成了一个民族。"
                            }
                        },
                        {
                            "text": "Laws once prevented different social classes to <w>mingle</w> through marriage.",
                            "target_lang_translations": {
                                "zh": "法律曾一度禁止不同社会阶层通过<w>通婚</w>结合。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or biblical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指不同群体之间通婚。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "通婚",
                                "target_lang_sense_clarification": "指不同族群或阶层间结婚。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7929704c-fe25-38ec-b17b-a645e22f3487",
                    "sense_definition": "To cause or allow to intermarry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rulers sought to <w>mingle</w> their dynasties to secure a lasting peace treaty.",
                            "target_lang_translations": {
                                "zh": "统治者试图通过<w>联姻</w>来巩固他们的王朝，以确保长久的和平条约。"
                            }
                        },
                        {
                            "text": "The community chose not to <w>mingle</w> their children with outsiders.",
                            "target_lang_translations": {
                                "zh": "该社区选择不让他们的孩子与外人<w>联姻</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or biblical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "促使或允许不同群体通婚。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "联姻",
                                "target_lang_sense_clarification": "指通过婚姻建立联系。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "114ebaa0-b090-3ff9-bdb1-f2a044ceed3d",
                    "sense_definition": "To put together; to join.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The partners decided to <w>mingle</w> their resources to fund the ambitious project.",
                            "target_lang_translations": {
                                "zh": "合伙人决定将他们的资源<w>合并</w>起来，为这个雄心勃勃的项目提供资金。"
                            }
                        },
                        {
                            "text": "They would <w>mingle</w> their efforts to achieve a common goal.",
                            "target_lang_translations": {
                                "zh": "他们将<w>合并</w>各自的努力以实现共同的目标。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将事物放在一起；合并。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合并",
                                "target_lang_sense_clarification": "指将资源或努力结合。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb473100-09f8-3bb7-9f0f-a570a7dff32b",
                    "sense_definition": "The act of informally meeting numerous people in a group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "socializing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before the main presentation, there was a quick <w>mingle</w> where guests could chat.",
                            "target_lang_translations": {
                                "zh": "在主讲环节开始前，有一个简短的<w>社交活动</w>，客人们可以在此聊天。"
                            }
                        },
                        {
                            "text": "The event started with a brief <w>mingle</w> to help everyone feel comfortable.",
                            "target_lang_translations": {
                                "zh": "活动以一场简短的<w>社交活动</w>开场，以帮助大家放松心情。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in business or social networking contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在社交场合中非正式的交流活动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "社交活动",
                                "target_lang_sense_clarification": "指非正式的交流聚会。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8d9a884-d7cb-3ecd-88a8-e40a9e5eb0c6",
                    "sense_definition": "A mixture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salad was a colorful <w>mingle</w> of fresh greens and bright edible flowers.",
                            "target_lang_translations": {
                                "zh": "这份沙拉是新鲜蔬菜和鲜艳食用花卉的彩色<w>混合物</w>。"
                            }
                        },
                        {
                            "text": "Her music is a unique <w>mingle</w> of classical melodies and modern electronic beats.",
                            "target_lang_translations": {
                                "zh": "她的音乐是古典旋律与现代电子节拍的独特<w>混合物</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as a noun in this sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "混合物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "混合物",
                                "target_lang_sense_clarification": "指多种事物混合在一起的状态。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "97210583-d4e8-33d8-b5c6-c1416b71aad6",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Mingle</w> to speak at our local historical society meeting.",
                            "target_lang_translations": {
                                "zh": "我们邀请了<w>明格尔</w>先生在我们当地历史学会的会议上发言。"
                            }
                        },
                        {
                            "text": "The old records show that the <w>Mingle</w> family lived in this county for generations.",
                            "target_lang_translations": {
                                "zh": "旧档案显示<w>明格尔</w>家族在这个县居住了好几代人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "明格尔",
                                "target_lang_sense_clarification": "音译姓氏。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}