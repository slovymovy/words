                            {
                                "example_id": "edf28401-789c-4aa0-a70e-6a255fce4ba6",
                                "sense_id": "923f1eaa-d9a8-34a3-b793-bf61466beb6f",
                                "text": "Het model in kwestie is de 26-jarige Aymeline Valade. Ze draagt op de campagnebeelden voor Marni een jasje met driekwart mouwen en een kokerrok, die haar slanke taille en armen benadrukken."
                            },
                            {
                                "example_id": "2cbbcf65-b568-4dd3-846d-c94b12b9ed68",
                                "sense_id": "923f1eaa-d9a8-34a3-b793-bf61466beb6f",
                                "text": "Met haar blonde haar netjes in een staart, een kokerrok tot over de knie, koningsblauw truitje zonder decolleté en hoge hakken was de verleidster in een klap een onschuldige vrouw."
                            }
                        ]
                    }
