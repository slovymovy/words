                        "examples": [
                            {
                                "example_id": "31fbf63e-a238-4b62-9d4b-254439d3678c",
                                "sense_id": "2f646930-a399-329b-81e0-24a0c5edfc08",
                                "text": "Elle comprend un important appareil vocal (six solistes et un chœur) et un grand orchestre, privé de bassons et de trompettes, mais comportant une clarinette alto, un sarrussophone, un bugle et un piano."
                            },
                            {
                                "example_id": "c6159a0e-3899-4fb5-9339-cb02913f8e55",
                                "sense_id": "2f646930-a399-329b-81e0-24a0c5edfc08",
                                "text": "Les jours de fête, en particulier les dimanches honorés comme ultra-repos officiel, l’orphéon de Saint-Flebène (un sarrussophone, un triangle, deux flûtes, une grosse caisse et un bandonéon) se réunissait sur la place Boileau, au cœur de la cité."
                            }
