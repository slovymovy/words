                "senses": [
                    {
                        "sense_id": "b9027bf9-cdef-386d-82e2-97b596cd8ef0",
                        "entry_id": "2a242d08-9eff-31c8-9334-fd60b2b731b6",
                        "glosses": [
                            "militärische Einheit, die für polizeiliche Aufgaben zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a766445-4f40-40ae-a576-60040ae0bad1",
                                "sense_id": "b9027bf9-cdef-386d-82e2-97b596cd8ef0",
                                "text": "Die Militärpolizei versuchte den Einbruch am Kasernengelände aufzuklären."
                            },
                            {
                                "example_id": "b4707ba2-c98d-4353-85d5-fdcfccac1c07",
                                "sense_id": "b9027bf9-cdef-386d-82e2-97b596cd8ef0",
                                "text": "„Ihm gegenüber hatte sich in einem weißgetünchten Haus, auf dessen Dach der Davidstern welkte, die israelische Militärpolizei niedergelassen.“"
                            },
                            {
                                "example_id": "6fc97998-a5d4-4e8d-ba55-1c3a0f9a4fdc",
                                "sense_id": "b9027bf9-cdef-386d-82e2-97b596cd8ef0",
                                "text": "„Die Suche nach ihm in Bordellen und sonstigen, der Militärpolizei bekannten Absteigen blieb erfolglos; dem Boot fehlte der Kapitän.“"
                            },
                            {
                                "example_id": "33838c5b-b82e-4443-a3de-4f36c8396b67",
                                "sense_id": "b9027bf9-cdef-386d-82e2-97b596cd8ef0",
                                "text": "„Auf dem Rollfeld nimmt die Militärpolizei von Katanga die blutverschierten Häftlinge in Empfang.“"
                            },
                            {
                                "example_id": "540b929c-38d5-4f5c-907a-a303bf52b7d2",
                                "sense_id": "b9027bf9-cdef-386d-82e2-97b596cd8ef0",
                                "text": "„Fridolin hatte den Mann kurz und schmerzvoll zusammengeschlagen, und sie konnten sich noch rechtzeitig verdrücken, ehe die Militärpolizei kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
