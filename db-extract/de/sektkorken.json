                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e84f94f1-2f03-4453-9369-10ba755166cc",
                                "sense_id": "caae4038-0a49-3de5-9615-37a8ed4e4754",
                                "text": "\"Tränen, Trauer und Enttäuschung auf der einen Seite, ausgelassene Stimmung und knallende Sektkorken auf der anderen.\""
                            },
                            {
                                "example_id": "100adea0-4f51-48f5-8947-db4b02f8aed7",
                                "sense_id": "caae4038-0a49-3de5-9615-37a8ed4e4754",
                                "text": "Die Flaschen werden dann auch nicht mit den teuren Sektkorken sondern mit den einfachen und billigen Kronenkorken verschlossen; solche Schaumweine sind wenig haltbar und müssen schnell verbraucht werden."
                            }
                        ],
