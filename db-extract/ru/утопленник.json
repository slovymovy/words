                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noyé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a844d14-b3f0-3484-99f8-d05b4237f3fc",
                                        "entry_id": "189a8652-bc32-3f5b-b339-df8b5026457a",
                                        "glosses": [
                                            "Personne qui se noie ou qui a péri par noyade."
                                        ],
                                        "tags": [
                                            "Mort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a3fb01b-cfe3-485f-9d99-9a08513cf980",
                                                "sense_id": "6a844d14-b3f0-3484-99f8-d05b4237f3fc",
                                                "text": "Un grondement immense enveloppait la côte.\nSur les flots palpitaient, blêmes, de toutes parts,\nLes âmes des noyés qui moururent en faute."
                                            },
                                            {
                                                "example_id": "e89027cc-e829-4730-a2eb-548532c93b3a",
                                                "sense_id": "6a844d14-b3f0-3484-99f8-d05b4237f3fc",
                                                "text": "Des hoquets de dégoût convulsèrent de nouveau leurs faces hâlées, zébrées de rides : depuis un mois, ils avaient bu de l’eau dans laquelle mijotait ce noyé ; depuis un mois tout le pays s’abreuvait de cette pourriture."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "noyé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c755713b-4f7b-3ae8-97fb-cda10a5eecd8",
                                        "entry_id": "253c2c24-b275-34bf-b607-32f2301fe7df",
                                        "glosses": [
                                            "Mort par noyade."
                                        ],
                                        "tags": [
                                            "Mort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91ea26cb-b068-4f9e-881a-356b241a3261",
                                                "sense_id": "c755713b-4f7b-3ae8-97fb-cda10a5eecd8",
                                                "text": "Elle était hantée par l’image obsédante d’un enfant noyé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "936125b3-4d75-3e9d-882e-7f859cb86ac9",
