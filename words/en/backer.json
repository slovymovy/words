    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7341ef2b-acac-3a78-94dd-5469c7c04839",
                    "sense_definition": "A person or organisation that provides financial or moral support to an enterprise, project, or person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The startup is still seeking a wealthy <w>backer</w> to help launch its new software.",
                            "target_lang_translations": {
                                "de": "Das Startup sucht immer noch nach einem wohlhabenden <w>Geldgeber</w>, der bei der Markteinführung seiner neuen Software hilft."
                            }
                        },
                        {
                            "text": "Without the help of a generous financial <w>backer</w>, the museum would have closed.",
                            "target_lang_translations": {
                                "de": "Ohne die Hilfe eines großzügigen finanziellen <w>Förderers</w> hätte das Museum schließen müssen."
                            }
                        }
                    ],
                    "synonyms": [
                        "sponsor",
                        "supporter",
                        "patron",
                        "investor"
                    ],
                    "antonyms": [
                        "opponent"
                    ],
                    "common_phrases": [
                        "financial backer"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person oder Organisation, die ein Unternehmen, Projekt oder eine Person finanziell oder ideell unterstützt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Unterstützer",
                                "target_lang_sense_clarification": "allgemein oder finanziell"
                            },
                            {
                                "target_lang_word": "Geldgeber",
                                "target_lang_sense_clarification": "finanzielle Unterstützung"
                            },
                            {
                                "target_lang_word": "Förderer",
                                "target_lang_sense_clarification": "Gönner oder Mäzen"
                            },
                            {
                                "target_lang_word": "Sponsor",
                                "target_lang_sense_clarification": "vor allem finanziell oder werbewirksam"
                            }
                        ]
                    }
                }
            ]
        },
