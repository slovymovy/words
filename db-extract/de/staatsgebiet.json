                    {
                        "translation_id": "d7a4f6ae-016a-4f7d-adfb-6cdfaa3b2acf",
                        "source_entry_id": "0e6728f6-cc59-3b7f-9352-d56ddc377938",
                        "source_sense_id": "e5ce5e6d-224e-3fbf-bbe9-4858034b20fb",
