                        "entry_id": "46cb942a-7008-3076-b889-a8a93787b093",
                        "glosses": [
                            "oude munt, vaak van goud maar ook van zilver die vroeger in Europa gebruikt werd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ea1e28-2db2-4b69-abb3-107a1b8a52d1",
                                "sense_id": "fa4ce20a-b850-3c58-8fb3-db499ec3e50e",
                                "text": "In het wrak werd een kist met zakken vol gouden dukaten en zilveren realen gevonden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "938f975c-f07c-4e9c-8d02-dae33168a424",
