                                    },
                                    {
                                        "sense_id": "1a430ca6-ca57-32b8-91b0-4e0b9640a8e0",
                                        "entry_id": "6ad3396d-4522-3228-80da-ce31fd08ae23",
                                        "glosses": [
                                            "Of the generation of organisms that produce a hybrid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207a2fdc-548b-4ef3-85da-7da187e351b9",
                                                "sense_id": "1a430ca6-ca57-32b8-91b0-4e0b9640a8e0",
                                                "text": "This, following Bateson, we may call the parental generation or P generation. Subsequent generations are called filial generations (abbreviated F) and their numerical order is indicated by a subscript, [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "759f7053-c188-37ce-833a-66a5b1609ed6",
                                        "entry_id": "cea78231-73f2-3bb4-accf-491df078ee37",
                                        "glosses": [
                                            "A person fulfilling a parental role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc721c9f-1327-489d-b2f2-fd289fdcd2a3",
                                                "sense_id": "759f7053-c188-37ce-833a-66a5b1609ed6",
                                                "text": "Nowadays there are all kinds of potential parentals besides parents, grandparents, aunts and uncles, step-parents, in-laws, older siblings and cousins, and those in civil unions."
                                            }
                                        ]
                                    }
                                ]
                            }
