                        "examples": [
                            {
                                "example_id": "adb59e56-cae8-40cf-a681-0c81e26497b4",
                                "sense_id": "d05e756a-f246-3a6f-a1c0-e502f9bbaf24",
                                "text": "De tuinman heeft een nieuw bloembed aangelegd.",
                                "translation": "The gardener has laid out a new flower bed.",
                                "english": "The gardener has laid out a new flower bed."
                            },
                            {
                                "example_id": "33a09467-90bc-4df5-997d-54fbb5525fcd",
                                "sense_id": "d05e756a-f246-3a6f-a1c0-e502f9bbaf24",
                                "text": "Er zijn veel kleurrijke bloemen in dat bloembed.",
                                "translation": "There are many colorful flowers in that flower bed.",
                                "english": "There are many colorful flowers in that flower bed."
                            },
                            {
                                "example_id": "18e352b2-de1a-4cc0-a542-79d491d87dd6",
                                "sense_id": "d05e756a-f246-3a6f-a1c0-e502f9bbaf24",
                                "text": "Ze spendeert veel tijd aan het verzorgen van haar bloembedden.",
                                "translation": "She spends a lot of time tending to her flower beds.",
                                "english": "She spends a lot of time tending to her flower beds."
                            }
                        ]
                    }
