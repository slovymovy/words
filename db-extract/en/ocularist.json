                "senses": [
                    {
                        "sense_id": "44d90d55-cf34-302b-9dd4-d36953259ff1",
                        "entry_id": "abed36cb-7ce9-3209-8a7e-918c303b703a",
                        "glosses": [
                            "Someone who specializes in the fabrication and fitting of ocular prostheses for people who have lost an eye or eyes due to trauma or illness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7256cccf-f07b-4028-9459-d6b539536835",
                                "sense_id": "44d90d55-cf34-302b-9dd4-d36953259ff1",
                                "text": "Even among ocularists, a close-knit community filled with many second- and third-generation practitioners, he stands out. Not only because he's one of the most accomplished (though he is) and he makes all manner of unusual eyes for horses, dogs, and prisoners (though he does); but also because he is a fifth-generation ocularist (one of his distant relatives made the first glass eye)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6243ed3d-2b26-46e7-94eb-2d5ed7b57636",
                        "source_entry_id": "abed36cb-7ce9-3209-8a7e-918c303b703a",
