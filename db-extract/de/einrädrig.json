                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a8e87fb-8608-46a3-b0bc-7d2ca9571d81",
                                "sense_id": "2c7ad7ae-8a9a-35f6-a8be-2844f586b02e",
                                "text": "„So einrädrig sieht es jetzt ziemlich bedauernswert aus, was aber das kleinere Problem ist.“"
                            },
                            {
                                "example_id": "38f4f46c-4f4b-432a-a9df-57eda6183588",
                                "sense_id": "2c7ad7ae-8a9a-35f6-a8be-2844f586b02e",
                                "text": "„Die Vorderachse ist einrädrig, das Fahrzeug also sehr wendig in Kurven.“"
                            }
                        ],
