            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7126a8b6-7c24-3f90-8d05-acc097fac605",
                    "sense_definition": "To briefly immerse food in boiling water, often followed by plunging it into cold water to stop cooking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>blanch</w> the vegetables briefly before freezing them."
                        },
                        {
                            "text": "The chef instructed the apprentice to <w>blanch</w> the beans in boiling water."
                        }
                    ],
                    "common_phrases": [
                        "blanch vegetables",
                        "blanch in boiling water"
                    ]
                },
                {
