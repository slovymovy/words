                    },
                    {
                        "translation_id": "aa67adb7-9b66-498c-8700-4e363635aab1",
                        "source_entry_id": "c01d22ce-bcf6-354e-b142-fda949301948",
                        "source_sense_id": "804d721d-fa1f-38ac-9cca-cbd9b34d166d",
                        "target_lang_word": "explorateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explorateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d6e60a7-323e-30f4-9e0e-8e8323e7d4a3",
                                        "entry_id": "aa65f0eb-7d8a-30f2-884f-680907b00494",
                                        "glosses": [
                                            "Celui qui explore afin de découvrir de nouveaux lieux géographiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e1e24ed-b068-4b3e-bc65-b6225ce645b6",
                                                "sense_id": "8d6e60a7-323e-30f4-9e0e-8e8323e7d4a3",
                                                "text": "En 1951, à la frontière tibéto-népalaise, un explorateur britannique photographie une étrange trace de pas dans la neige…"
                                            },
                                            {
                                                "example_id": "8cbca306-9fbd-48f2-89b1-d627a8c9b520",
                                                "sense_id": "8d6e60a7-323e-30f4-9e0e-8e8323e7d4a3",
                                                "text": "Et, malgré les travaux d’une pléiade de savants et d’explorateurs qui en font depuis quelques années l’objet de leurs recherches, on peut dire que l’Empire chérifien, pour le grand public, est encore un pays à peu près inconnu."
                                            },
                                            {
                                                "example_id": "ff4a5851-641c-45fc-84ea-ba8f1dc7cf83",
                                                "sense_id": "8d6e60a7-323e-30f4-9e0e-8e8323e7d4a3",
                                                "text": "Le bon sens d’un chef de tribu n’a-t-il pas éclaté souvent dans les palabres, pour l’émerveillement de nos explorateurs ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca90e45-fe62-38eb-acbb-67ed427909ca",
                                        "entry_id": "aa65f0eb-7d8a-30f2-884f-680907b00494",
                                        "glosses": [
                                            "Celui qui entreprend des recherches approfondies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2ec203b-0cd0-30e4-b2bd-fefffea96f0c",
                                        "entry_id": "aa65f0eb-7d8a-30f2-884f-680907b00494",
                                        "glosses": [
                                            "Sorte de logiciel pour rechercher des informations dans un ordinateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db2da522-76c0-47d2-b9fc-a025887550ee",
                                                "sense_id": "e2ec203b-0cd0-30e4-b2bd-fefffea96f0c",
                                                "text": "En effet, on a vu précédemment que le classement arborescent atteint vite ses limites : l’explorateur de document de Google Docs, basé sur des mots-clefs, est plus efficace que l’explorateur Windows basé sur une arborescence stricte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "explorateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c6ad0f8-d710-38a7-a5ea-f904872e5014",
                                        "entry_id": "e9e4cf72-d033-3b59-b818-c65a9f6d2f3d",
                                        "glosses": [
                                            "Qui sert à explorer. On dit plutôt désormais exploratoire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd0cdafc-c8b0-42e5-979e-29388414c16a",
                                                "sense_id": "3c6ad0f8-d710-38a7-a5ea-f904872e5014",
                                                "text": "Les 329 interventions se répartissent en 98 gastrectomies totales, 48 gastrectomies subtotales, 77 dérivations palliatives et 106 laparotomies exploratrices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c66cf955-30ef-48d3-885c-48710d7ccf67",
                        "source_entry_id": "c01d22ce-bcf6-354e-b142-fda949301948",
                        "source_sense_id": "804d721d-fa1f-38ac-9cca-cbd9b34d166d",
                        "target_lang_word": "polaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9a6890d-3670-3ed3-9e35-da2f8285e82d",
                                        "entry_id": "49058f71-0a3c-3f6d-9727-2c90034dbf26",
                                        "glosses": [
                                            "Qui est voisin des pôles, qui a rapport aux pôles du monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c3ff23-e0b3-4b20-bad9-05b238e47888",
                                                "sense_id": "a9a6890d-3670-3ed3-9e35-da2f8285e82d",
                                                "text": "Et si pendant cette mémorable soirée, le poêle consomma un quintal de charbon, c’est qu’un froid de vingt-quatre degrés Fahrenheit au-dessous de zéro (32° centigr. au-dessous de glace) régnait au dehors, et que le Fort-Reliance est situé par 61° 47' de latitude septentrionale, à moins de quatre degrés du cercle polaire."
                                            },
                                            {
                                                "example_id": "3a21b777-7dfb-42c0-823c-8705ea93bf73",
                                                "sense_id": "a9a6890d-3670-3ed3-9e35-da2f8285e82d",
                                                "text": "Le « Pourquoi pas », succéda au « Français » qui conduisit dans l’Antarctique en 1903-1905 la première expédition polaire française de longue haleine."
                                            },
                                            {
                                                "example_id": "5636fab0-c725-412f-96e6-3655303f2161",
                                                "sense_id": "a9a6890d-3670-3ed3-9e35-da2f8285e82d",
                                                "text": "Le navire imperturbable cingle vers l’immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bbe6bbc-e060-3a13-81dd-fd4278553334",
                                        "entry_id": "49058f71-0a3c-3f6d-9727-2c90034dbf26",
                                        "glosses": [
                                            "Se dit d’une atmosphère, d’une relation ou d’une situation qui est froide, glaciale, tendue ou distante, par analogie avec le froid extrême des régions polaires."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377f5c2e-ebfa-4829-b170-31b9bebdbaf8",
                                                "sense_id": "7bbe6bbc-e060-3a13-81dd-fd4278553334",
                                                "text": "Andrew remonta son col et se mit en marche dans une nuit polaire. Il héla un taxi sur Hudson et se fit déposer devant le journal."
                                            },
                                            {
                                                "example_id": "19147a40-8c05-493f-8b86-7f4056fe5eaf",
                                                "sense_id": "7bbe6bbc-e060-3a13-81dd-fd4278553334",
                                                "text": "Une anecdote révèle l’ambiance polaire qui règne entre les deux pays."
                                            },
                                            {
                                                "example_id": "4545abc1-2d3e-4f9c-b922-f2c031b82e9d",
                                                "sense_id": "7bbe6bbc-e060-3a13-81dd-fd4278553334",
                                                "text": "En un an et demi, Emmanuel Macron a en effet vu l’appareil qu’il avait créé lui échapper. Désormais à la tête de Renaissance, Gabriel Attal se sent d’autant moins lié par les engagements présidentiels qu’il entretient des relations polaires avec le chef de l’État."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7191ce9f-a5f9-34ea-b9e0-470e54bbc6aa",
                                        "entry_id": "49058f71-0a3c-3f6d-9727-2c90034dbf26",
                                        "glosses": [
                                            "Qui a rapport aux pôles d’un aimant, d’un courant électrique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d706aa93-29e0-35d8-85cb-3bb8bae9dfcb",
                                        "entry_id": "49058f71-0a3c-3f6d-9727-2c90034dbf26",
                                        "glosses": [
                                            "Qui se rapporte aux pôles de certaines molécules ayant la nature d’un dipôle électrostatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c4bb13-4396-419d-bd96-eafe2ab7d88f",
                                                "sense_id": "d706aa93-29e0-35d8-85cb-3bb8bae9dfcb",
                                                "text": "Les interactions dipôle permanent-dipôle induit expliquent la solubilité de l’iode non polaire dans l’éthanol polaire."
                                            },
                                            {
                                                "example_id": "a0ac0a8e-5b4f-45e8-8f8b-a860e7bc42d2",
                                                "sense_id": "d706aa93-29e0-35d8-85cb-3bb8bae9dfcb",
                                                "text": "Pour les matériaux caoutchoutiques à caractère plus polaire (PVC), la sorption des composés polaires (2-phényléthanol, acétate de benzyle) est favorisée par rapport aux polyoléfines (Sizer et al., 1988)."
                                            },
                                            {
                                                "example_id": "7a716072-99fc-484a-b675-4146d5097dc5",
                                                "sense_id": "d706aa93-29e0-35d8-85cb-3bb8bae9dfcb",
                                                "text": "Un très grand nombre de métaux peuvent former des dérivés organométalliques (Li, Na, Mg, Ca, Al, Sn, Zn, Cd, Hg, Cu...). La polarisation de la liaison se fait dans le sens Cᵟ⁻—Mᵟ⁺, cette liaison aura un caractère d'autant plus polaire que le métal sera plus électropositif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d32e20-3646-3005-acb7-d9a1f50f73b5",
                                        "entry_id": "49058f71-0a3c-3f6d-9727-2c90034dbf26",
                                        "glosses": [
                                            "Relatif à un pôle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d86d8e05-7af9-3ef0-b294-8f585a9c4637",
                                        "entry_id": "49058f71-0a3c-3f6d-9727-2c90034dbf26",
                                        "glosses": [
                                            "Qualifie un tissu synthétique isolant et très léger."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38f3e7c-1756-4238-b1c2-19ad5ef4273b",
                                                "sense_id": "d86d8e05-7af9-3ef0-b294-8f585a9c4637",
                                                "text": "Le délégué à ce morceau d’Éden en godet est aisément identifiable à son gilet en mailles polaires vert de gris pissouille et à sa gueule de six pieds de long."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "465a6912-9d2a-3aba-ac33-033323abb7a2",
                                        "entry_id": "ac6be0d0-e7ec-31f7-953b-9a4e2ef6b316",
                                        "glosses": [
                                            "Droite passant par un pôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e418d1b7-b9cb-4fe3-802b-f8e31b27a527",
                                                "sense_id": "465a6912-9d2a-3aba-ac33-033323abb7a2",
                                                "text": "Étant donné deux droites (d) et (d’) distinctes et concourantes en un point I du plan et un point M non situé sur ces droites, l’ensemble des conjugués harmoniques du point M par rapport à (d) et (d’) est une droite passant par I. On l’appelle la polaire de M par rapport à (d) et (d’)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77107a4c-49a5-3ec7-a13c-60e83cd803a9",
                                        "entry_id": "ac6be0d0-e7ec-31f7-953b-9a4e2ef6b316",
                                        "glosses": [
                                            "Étoile située au pôle, étoile polaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0e9605c-a8bd-4a7f-922c-3a3fe541422c",
                                                "sense_id": "77107a4c-49a5-3ec7-a13c-60e83cd803a9",
                                                "text": "Des constellations d'une admirable pureté resplendissaient depuis le zénith, où brillait la polaire, jusqu’aux dernières limites de l’horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f81b95-463e-3fab-86dd-c92ac3347f49",
                                        "entry_id": "ac6be0d0-e7ec-31f7-953b-9a4e2ef6b316",
                                        "glosses": [
                                            "Tissu synthétique isolant, très léger, fait de polytéréphtalate d’éthylène (PET)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ac4d3e-3a89-48c1-9c46-94ea97e19aea",
                                                "sense_id": "f6f81b95-463e-3fab-86dd-c92ac3347f49",
                                                "text": "Les pyjamas en polaire sont de sortie : la maison, comme la plupart des bâtiments de Potosi, n’est pas chauffée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb03e1a-e654-33d7-93d9-24549883603f",
                                        "entry_id": "ac6be0d0-e7ec-31f7-953b-9a4e2ef6b316",
                                        "glosses": [
                                            "Vêtement fabriqué avec ce tissu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31e802ad-ff7e-4423-b40e-4bfdb0071a49",
                                                "sense_id": "0bb03e1a-e654-33d7-93d9-24549883603f",
                                                "text": "Un froid piquant transperçait sa polaire, et la nuit sans lune lui permettait à peine de voir les formes endormies des maisons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
