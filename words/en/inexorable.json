{
    "word_family": [
        "inexorability",
        "inexorableness",
        "inexorably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "341115d0-2a2a-330f-b5e8-53f92ab67baa",
                    "sense_definition": "Impossible to prevent or stop; inevitable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inevitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inexorable</w> demand for more memory means we will soon be storing thousands of feature films in our pockets.",
                            "target_lang_translations": {
                                "ru": "<w>Неумолимый</w> рост спроса на память означает, что скоро мы будем хранить тысячи художественных фильмов в своих карманах."
                            }
                        },
                        {
                            "text": "Despite all efforts to save the old building, its demolition seemed <w>inexorable</w> as the machines arrived.",
                            "target_lang_translations": {
                                "ru": "Несмотря на все усилия по спасению старого здания, его снос казался <w>неотвратимым</w>, когда прибыла техника."
                            }
                        }
                    ],
                    "synonyms": [
                        "inevitable",
                        "unstoppable",
                        "unavoidable",
                        "ineluctable",
                        "inescapable"
                    ],
                    "common_phrases": [
                        "inexorable demand",
                        "inexorable progress",
                        "inexorable logic",
                        "inexorable decline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, который невозможно предотвратить или остановить; неизбежный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неотвратимый",
                                "target_lang_sense_clarification": "о событиях или процессах, которые нельзя избежать"
                            },
                            {
                                "target_lang_word": "неизбежный",
                                "target_lang_sense_clarification": "то, что обязательно произойдет"
                            },
                            {
                                "target_lang_word": "неумолимый",
                                "target_lang_sense_clarification": "о ходе времени или прогрессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c68474b3-040a-3e20-a079-dc8b18e6676b",
                    "sense_definition": "Unable to be persuaded or moved by entreaty; relentless and unrelenting in purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relentlessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king remained <w>inexorable</w> despite the pleas for mercy from the prisoner's family.",
                            "target_lang_translations": {
                                "ru": "Король оставался <w>неумолим</w>, несмотря на мольбы о помиловании от семьи заключенного."
                            }
                        },
                        {
                            "text": "She faced an <w>inexorable</w> foe who refused to negotiate any terms of peace.",
                            "target_lang_translations": {
                                "ru": "Она столкнулась с <w>непреклонным</w> врагом, который отказывался обсуждать любые условия мира."
                            }
                        }
                    ],
                    "synonyms": [
                        "unrelenting",
                        "implacable"
                    ],
                    "antonyms": [
                        "exorable"
                    ],
                    "common_phrases": [
                        "inexorable judge",
                        "inexorable foe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кого невозможно переубедить или смягчить просьбами; непреклонный в своих намерениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неумолимый",
                                "target_lang_sense_clarification": "о человеке, которого нельзя упросить"
                            },
                            {
                                "target_lang_word": "непреклонный",
                                "target_lang_sense_clarification": "твердый в своем решении"
                            },
                            {
                                "target_lang_word": "беспощадный",
                                "target_lang_sense_clarification": "не знающий жалости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10e27e40-53a7-3492-93d9-3fddc8f87276",
                    "sense_definition": "Extremely severe or adamant; not permitting any deviation or exception.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law was <w>inexorable</w> in its application, leaving no room for personal circumstances.",
                            "target_lang_translations": {
                                "ru": "Закон был <w>неумолим</w> в своем применении, не оставляя места для личных обстоятельств."
                            }
                        },
                        {
                            "text": "He was known as an <w>inexorable</w> judge who followed the letter of the law without fail.",
                            "target_lang_translations": {
                                "ru": "Он был известен как <w>суровый</w> судья, который неукоснительно следовал букве закона."
                            }
                        }
                    ],
                    "synonyms": [
                        "unrelenting",
                        "implacable"
                    ],
                    "antonyms": [
                        "exorable"
                    ],
                    "common_phrases": [
                        "inexorable law",
                        "inexorable necessity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно суровый или твердый; не допускающий никаких отклонений или исключений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неумолимый",
                                "target_lang_sense_clarification": "о законе или судьбе"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "строгий и непоколебимый"
                            },
                            {
                                "target_lang_word": "жесткий",
                                "target_lang_sense_clarification": "не допускающий компромиссов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
