                                        "glosses": [
                                            "Any long tragic story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab5e0114-cc99-484c-b68b-a812075a2284",
                                                "sense_id": "a40a275e-dd75-33bd-aa28-fb863b68dbdf",
                                                "text": "[As they] listened to the tale he unfolded, some glow of pity must have possessed them; for it was an Iliad of herculean struggle against absolute disaster, ending with the bitter news of his grandfather's death."
                                            }
