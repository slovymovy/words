                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c95a1ef8-6051-4cb1-ae94-a966ff51ea8f",
                                "sense_id": "e925d9ec-16b7-3565-8a09-b3ce77a8f533",
                                "text": "Ahmad (1969) studied the personality differences among middle school girls identified as originals and unoriginals on the Minnesota's test of creative thinking."
                            },
                            {
                                "example_id": "72f3f931-798c-4668-9e7e-c48d45d72791",
                                "sense_id": "e925d9ec-16b7-3565-8a09-b3ce77a8f533",
                                "text": "The originals or the creatives were more dominant than the unoriginals or the low creatives."
                            }
                        ]
                    }
