                "senses": [
                    {
                        "sense_id": "53e53b22-41d5-34ad-9d9d-519f2e6bff2c",
                        "entry_id": "f0e12e76-9efa-3406-a87e-5477f7abb3f4",
                        "glosses": [
                            "Réfection chirurgicale d’une valve ou d'une valvule cardiaque défaillante ou anormale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa3fdee-e62f-4461-9043-8a88298a07f1",
                                "sense_id": "53e53b22-41d5-34ad-9d9d-519f2e6bff2c",
                                "text": "L’annuloplastie consiste à effectuer une plicature de l’anneau mitral en regard du foyer d'insuffisance à l'aide de points placés sur l'anneau de part et d'autre de la commissure."
                            },
                            {
                                "example_id": "d0fa388b-6fa6-42fb-9d74-a5b1595418bf",
                                "sense_id": "53e53b22-41d5-34ad-9d9d-519f2e6bff2c",
                                "text": "L’annuloplastie, ou une réparation à vue de certaines altérations des valves ou des cordages, pourraient lui être adjointes; ou, à défaut de sa possibilité, lui être substituées."
                            },
                            {
                                "example_id": "a29bb188-fbfa-4999-9163-98808be25d37",
                                "sense_id": "53e53b22-41d5-34ad-9d9d-519f2e6bff2c",
                                "text": "Au début, nous avons employé l’annuloplastie telle qu'elle fut décrite par Kay. Celle-ci a été abandonnée tout récemment pour passer à l’annuloplastie selon Wooler, qui est plus facile et plus rapide à exécuter."
                            },
                            {
                                "example_id": "2ef2e612-ecb3-4740-8de5-dafcc0f8248e",
                                "sense_id": "53e53b22-41d5-34ad-9d9d-519f2e6bff2c",
                                "text": "Néanmoins, l’annuloplastie restrictive s'accompagne fréquemment d'une récurrence de l’insuffisance mitrale fonctionnelle ou d'une altération de la capacité fonctionnelle […]."
                            }
                        ]
                    }
