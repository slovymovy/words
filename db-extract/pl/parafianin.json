                "senses": [
                    {
                        "sense_id": "bfd50c19-d149-309e-a064-3fd504a0efcb",
                        "entry_id": "415553ec-b520-3005-ab03-dcb7e5383d31",
                        "glosses": [
                            "członek wspólnoty parafialnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61069b1b-a814-451e-8a4a-4dddaa971ae5",
                                "sense_id": "bfd50c19-d149-309e-a064-3fd504a0efcb",
                                "text": "Parafianie zebrali się na niedzielnej mszy."
                            },
                            {
                                "example_id": "38987b55-978d-4b6e-930c-8f7b801190f5",
                                "sense_id": "bfd50c19-d149-309e-a064-3fd504a0efcb",
                                "text": "Zdaniem niektórych parafian postąpiono nierozważnie, stawiając kościół na tak grząskim gruncie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "27990217-d502-3f46-a3b3-12adc453011c",
                        "entry_id": "415553ec-b520-3005-ab03-dcb7e5383d31",
                        "glosses": [
                            "mężczyzna ze wsi, bez ogłady, wykształcenia, zacofany"
                        ],
