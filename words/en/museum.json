{
    "word_family": [
        "museology",
        "museologist",
        "museal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "318a1fb5-7a66-383f-8330-3ee9a5574898",
                    "sense_definition": "A building or institution where objects of historical, scientific, artistic, or cultural interest are kept and shown to the public.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to visit the history <w>museum</w> during our trip.",
                            "target_lang_translations": {
                                "ru": "Мы решили посетить исторический <w>музей</w> во время нашей поездки.",
                                "zh": "我们决定在旅行期间去参观历史<w>博物馆</w>。"
                            }
                        },
                        {
                            "text": "The city has a large art <w>museum</w> with famous paintings.",
                            "target_lang_translations": {
                                "ru": "В городе есть большой художественный <w>музей</w> со знаменитыми картинами.",
                                "zh": "这座城市有一座大型艺术<w>博物馆</w>，里面收藏着名画。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "art museum",
                        "history museum",
                        "visit a museum",
                        "science museum",
                        "national museum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание или учреждение, где хранятся и выставляются для обозрения предметы, представляющие исторический, научный, художественный или культурный интерес.",
                        "zh": "收藏并向公众展示具有历史、科学、艺术或文化价值的物品的建筑或机构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "музей",
                                "target_lang_sense_clarification": "учреждение культуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "博物馆",
                                "target_lang_sense_clarification": "文化机构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0afe0794-65fd-3984-a993-af4afcec0ac0",
                    "sense_definition": "To visit museums, typically as a leisure activity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the entire weekend <w>museuming</w> in London.",
                            "target_lang_translations": {
                                "ru": "Мы провели все выходные в Лондоне, <w>ходя по музеям</w>.",
                                "zh": "我们整个周末都在伦敦<w>逛博物馆</w>。"
                            }
                        },
                        {
                            "text": "She loves <w>museuming</w> whenever she travels to a new city.",
                            "target_lang_translations": {
                                "ru": "Она обожает <w>ходить по музеям</w>, когда приезжает в новый город.",
                                "zh": "她每到一个新城市旅行，都喜欢<w>逛博物馆</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go museuming"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посещать музеи, обычно в качестве досуга или развлечения.",
                        "zh": "参观博物馆，通常作为一种休闲活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить по музеям",
                                "target_lang_sense_clarification": "посещать выставки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逛博物馆",
                                "target_lang_sense_clarification": "参观展览"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cb21a9c-61fc-376d-95e2-cb3be7193b49",
                    "sense_definition": "To place an object in a museum for preservation or display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient artifacts were <w>museumed</w> to ensure they would be preserved for future generations.",
                            "target_lang_translations": {
                                "ru": "Древние артефакты были <w>переданы в музей</w>, чтобы обеспечить их сохранность для будущих поколений.",
                                "zh": "这些古代文物被<w>送入博物馆</w>，以确保它们能为后代保存下来。"
                            }
                        },
                        {
                            "text": "He felt that his best works had been <w>museumed</w> and forgotten.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что его лучшие работы были <w>сданы в музей</w> и забыты.",
                                "zh": "他觉得他最好的作品已经被<w>送入博物馆</w>并被遗忘了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "archive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить объект в музей для сохранения или демонстрации.",
                        "zh": "将物品放入博物馆以进行保存或展示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передать в музей",
                                "target_lang_sense_clarification": "поместить на хранение"
                            },
                            {
                                "target_lang_word": "сдать в музей",
                                "target_lang_sense_clarification": "отправить в архив"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "送入博物馆",
                                "target_lang_sense_clarification": "放入馆藏"
                            },
                            {
                                "target_lang_word": "入藏",
                                "target_lang_sense_clarification": "被博物馆收藏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}