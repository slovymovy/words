                                        "sense_id": "f86b41e2-5808-335d-bd91-571cea09e34e",
                                        "entry_id": "53fb968d-447d-3a97-bdbf-bf27588698bc",
                                        "glosses": [
                                            "Qui a quelque chose de la forme d’une doloire."
