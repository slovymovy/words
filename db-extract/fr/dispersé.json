                        "examples": [
                            {
                                "example_id": "f3f27a35-e488-4f36-b8a4-48472f59b792",
                                "sense_id": "2a209fe8-0715-3531-8b63-1a103b68f69a",
                                "text": "[Chez les Achuar] l'habitat est dispersé, donc il n'y a pas à proprement parler de \"village\"."
                            },
                            {
                                "example_id": "a9f6fd68-b78c-45c9-99d5-dacc829e86dd",
                                "sense_id": "2a209fe8-0715-3531-8b63-1a103b68f69a",
                                "text": "En ordre dispersé, Tactique de combat d’après laquelle les fantassins combattants, au lieu de se grouper, se disséminent en profitant plus aisément, pour se protéger, des accidents du terrain."
                            }
                        ]
                    }
