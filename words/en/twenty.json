                {
                    "sense_id": "35a9ac20-aa03-37bc-bbea-f2a00559fe23",
                    "sense_definition": "The cardinal number 20, occurring after nineteen and before twenty-one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "number_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are <w>twenty</w> students in the classroom.",
