                {
                    "sense_id": "039419c1-9b38-3b1d-9cd1-598cf07317e7",
                    "sense_definition": "Hoewel; ondanks het feit dat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij deed het toch, <w>terwijl</w> hij wist dat het streng verboden was.",
                            "target_lang_translations": {
                                "en": "He did it anyway, <w>although</w> he knew it was strictly forbidden.",
                                "ru": "Он всё же сделал это, <w>хотя</w> знал, что это строго запрещено.",
                                "pl": "I tak to zrobił, <w>chociaż</w> wiedział, że to surowo zabronione.",
                                "de": "Er tat es trotzdem, <w>obwohl</w> er wusste, dass es streng verboten war.",
                                "fr": "Il l'a fait quand même, <w>alors qu'</w>il savait que c'était strictement interdit.",
                                "it": "L'ha fatto lo stesso, <w>anche se</w> sapeva che era severamente vietato.",
                                "cs": "Přesto to udělal, <w>ačkoli</w> věděl, že je to přísně zakázáno.",
                                "tr": "Kesinlikle yasak olduğunu <w>bildiği hâlde</w> yine de yaptı.",
                                "es": "Lo hizo de todos modos, <w>a pesar de que</w> sabía que estaba estrictamente prohibido."
                            }
                        },
                        {
                            "text": "Ze ging op de fiets naar haar werk <w>terwijl</w> het hard regende.",
                            "target_lang_translations": {
                                "en": "She cycled to work <w>while</w> it was raining hard.",
                                "ru": "Она поехала на работу на велосипеде, <w>хотя</w> шёл сильный дождь.",
                                "pl": "Pojechała do pracy rowerem, <w>mimo że</w> mocno padało.",
                                "de": "Sie fuhr mit dem Fahrrad zur Arbeit, <w>obwohl</w> es stark regnete.",
                                "fr": "Elle est allée au travail à vélo <w>alors qu'</w>il pleuvait fort.",
                                "it": "È andata al lavoro in bicicletta <w>mentre</w> pioveva forte.",
                                "cs": "Jela do práce na kole, <w>i když</w> silně pršelo.",
                                "tr": "Bardaktan boşanırcasına yağmur yağmasına <w>rağmen</w> işe bisikletle gitti.",
                                "es": "Fue al trabajo en bicicleta <w>cuando</w> estaba lloviendo a cántaros."
                            }
                        }
