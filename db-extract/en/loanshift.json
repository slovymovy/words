                "senses": [
                    {
                        "sense_id": "86c9cbfb-9d68-3227-baac-f92eec735639",
                        "entry_id": "408ab1be-4689-3bc6-8608-fa3611e708d2",
                        "glosses": [
                            "To change a word in this way."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c193a270-91b4-443a-a243-d28acf9b4528",
                                "sense_id": "86c9cbfb-9d68-3227-baac-f92eec735639",
                                "text": "In the contest between a Spanish word and an English word for its place in the new lexical gap (the right end of a broken line), in loan homonymy an English word wins (chanza₂) and in loanshifting a Spanish word wins (apertura, extended)."
                            },
                            {
                                "example_id": "9fece384-a0f5-404d-ba07-1413516fab79",
                                "sense_id": "86c9cbfb-9d68-3227-baac-f92eec735639",
                                "text": "Early French and English explorers and settlers had never seen a bison before, and thus lacked a proper term for it. So they borrowed—or loanshifted—the name of an animal already familiar to them: buffalo."
                            },
                            {
                                "example_id": "d5ff9aae-c498-437d-95ed-9ae7709848cc",
                                "sense_id": "86c9cbfb-9d68-3227-baac-f92eec735639",
                                "text": "The loanshifted category appears first as an innovation, becomes entrenched and may be conventionalized with meaning(s) specific to recipient culture."
                            }
                        ]
                    }
                ],
