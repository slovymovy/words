                "senses": [
                    {
                        "sense_id": "af3aedd8-4985-3b65-badd-e414facdd344",
                        "entry_id": "ce6971e7-743c-3f86-ac2e-6f6eaf6f0f3d",
                        "glosses": [
                            "Qui appartient au Bloc québécois, parti fédéral canadien prônant l'indépendance du Québec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "826139c3-19a8-4db3-ba2c-c7060cc21e28",
                                "sense_id": "af3aedd8-4985-3b65-badd-e414facdd344",
                                "text": "Une motion bloquiste, la campagne bloquiste."
                            },
                            {
                                "example_id": "1b1ec4ec-5067-40a4-943d-0b94805fff0b",
                                "sense_id": "af3aedd8-4985-3b65-badd-e414facdd344",
                                "text": "Le chef bloquiste a accusé le gouvernement Trudeau d’inaction en matière de lutte aux changements climatiques."
                            },
                            {
                                "example_id": "a548dd7e-5f56-4fc1-b9e0-d60448b6d632",
                                "sense_id": "af3aedd8-4985-3b65-badd-e414facdd344",
                                "text": "Interrogé au sujet de la publicité bloquiste, M. Duceppe n'a vu « rien de mal » dans ce chapeau de cowboy faisant référence à Calgary."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7606f507-4a66-3511-bf3e-36c3233c5538",
                "word": "bloquiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dbeb499c-9823-4801-9e5a-0bbf051378e4",
                        "entry_id": "7606f507-4a66-3511-bf3e-36c3233c5538",
                        "tags": [
                            "plural"
                        ],
