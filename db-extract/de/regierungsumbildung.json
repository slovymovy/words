                        "glosses": [
                            "Änderung der Zusammensetzung einer Regierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570c6a42-7b18-4c9d-8fb8-763b8acb785e",
                                "sense_id": "23047b5b-c66d-363b-b48c-2fad54150ea6",
                                "text": "„Der ukrainische Ministerpräsident Olexii Gontscharuk hat einer Abgeordneten zufolge seinen Rücktritt eingereicht. Dies sei Teil einer umfassenden Regierungsumbildung, sagte am Dienstag Galyna Jantschenko, die zur Partei von Präsident Wolodymyr Selenskyj gehört.“"
                            },
                            {
                                "example_id": "a181381a-510e-4ea7-a328-0ae3424ec983",
                                "sense_id": "23047b5b-c66d-363b-b48c-2fad54150ea6",
                                "text": "„Zudem kündigte er eine Regierungsumbildung an, mit der der Rückzug von Ministerpräsident Dmitrij Medwedjew auf ein neues Amt einhergeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
