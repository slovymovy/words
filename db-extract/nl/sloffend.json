                "senses": [
                    {
                        "sense_id": "bf5f6d35-62cc-3d88-b603-d16687acfc4b",
                        "entry_id": "b63f5c68-9846-3b2f-95dc-adf5d085dc3e",
                        "glosses": [
                            "heel rustig lopend waarbij de voeten over de grond slepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b813d6e8-c0d5-4873-b521-7bab4c4efdcb",
                                "sense_id": "bf5f6d35-62cc-3d88-b603-d16687acfc4b",
                                "text": "Favo restaurant: ,,Balti House, dat is een Indiaas restaurant in de Amsterdamse Pijp. Ik ben dol op Indiaas eten. Ik word er warm van. Maar ook de relaxte sfeer is super. Geen stressvolle obers, maar een heerlijk sloffende bediening.’’"
                            },
                            {
                                "example_id": "25ae1035-6c38-4afa-881c-c915f1a23c4e",
                                "sense_id": "bf5f6d35-62cc-3d88-b603-d16687acfc4b",
                                "text": "Een sloffende ober brengt koffie, medialunas en de krant. Bovenin de hoek hangt een televisie, een 24-uurs-herhaling van nieuwsbeelden en schreeuwende headlines met de volumeknop op nul."
                            }
                        ]
                    }
