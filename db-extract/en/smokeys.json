                        "examples": [
                            {
                                "example_id": "20ec6e72-3854-4de4-8e65-1d6738a5f49c",
                                "sense_id": "a2d4ae57-4e64-3c77-a55a-f522d035541e",
                                "text": "The Smokeys have a high density of bears, and the situation between bears and people there illustrates that it is possible to have a visible black bear population without the animals relying on handouts."
                            },
                            {
                                "example_id": "448c867a-0897-49e5-916b-bb9e649b8bbc",
                                "sense_id": "a2d4ae57-4e64-3c77-a55a-f522d035541e",
                                "text": "Some years after moving to the \"flatlands\", I took my family on a vacation to the Smokeys."
                            },
                            {
                                "example_id": "4443ab72-890d-47e8-ade2-29aa8e79a881",
                                "sense_id": "a2d4ae57-4e64-3c77-a55a-f522d035541e",
                                "text": "Keats had his coastline, the people of the Carolinas and Tennessee have their Smokeys."
                            }
                        ]
                    }
