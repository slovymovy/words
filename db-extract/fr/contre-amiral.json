                "senses": [
                    {
                        "sense_id": "4ffdeac5-00ae-3a0d-a381-a0a704b992a2",
                        "entry_id": "ba319625-8489-3af8-8e5c-abf0fa170733",
                        "glosses": [
                            "Grade donné dans la Marine nationale française à un officier général situé entre son supérieur hiérarchique, le vice-amiral, et son subordonné, le capitaine de vaisseau. Le code OTAN : OF-6."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "916e2c18-b8cf-4343-a2f0-c4f083a54063",
                                "sense_id": "4ffdeac5-00ae-3a0d-a381-a0a704b992a2",
                                "text": "En France, on nommait autrefois chefs d’escadre les officiers auxquels on donne maintenant le titre de contre-amiral."
                            },
                            {
                                "example_id": "cb5902a4-f2bc-4c48-9557-9bcda7bdaa25",
                                "sense_id": "4ffdeac5-00ae-3a0d-a381-a0a704b992a2",
                                "text": "Je frappe. Une voix de Capitaine Haddock m’invite à entrer. Je pousse la porte et me trouve face à une demi-douzaine d’amiraux ou contre- ou vice-amiraux en retraite."
                            }
                        ]
                    },
