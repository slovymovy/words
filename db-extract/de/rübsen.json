                                        "sense_id": "d394153a-6a3f-3720-8d66-91467bf4bd19",
                                        "entry_id": "89f4dadd-4519-387b-ab71-a7684324bd2c",
                                        "glosses": [
                                            "Brassica rapa een plant uit de kruisbloemenfamilie (Brassicaceae). Het is een typische voorjaarsplant. De plant kan meer dan 1 m hoog worden. De plant kleurt eind maart en begin april in korte tijd veel bermen in een felle gele pracht. De gele kleur in bermen in mei komt vaak door de herik (Sinapis arvensis)"
                                        ],
                                        "tags": [],
