                                "target_senses": [
                                    {
                                        "sense_id": "23a7c446-1a12-37db-8aa4-0a15df0070cf",
                                        "entry_id": "c20e14b9-b88b-3e7a-ad6e-ef228133b661",
                                        "glosses": [
                                            "To send or officially charge someone or some group to do something."
