                                        "entry_id": "37ccc0ad-11f0-33f1-84f5-a63b953ffefb",
                                        "glosses": [
                                            "A light timber or metal spreader fixed athwartships part way up a mast to spread the shrouds from higher up"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2690a52-f254-4ff8-b46f-30792a113ff3",
                                                "sense_id": "75ed8dbd-6913-368c-87ed-0b6bbdf27473",
                                                "text": "Your most usual point of perch is the head of the t’ gallant-mast, where you stand upon two thin parallel sticks (almost peculiar to whalemen) called the t’ gallant crosstrees."
                                            }
                                        ]
                                    }
                                ]
