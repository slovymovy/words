                ],
                "senses": [
                    {
                        "sense_id": "4d22733f-5646-32e5-8434-733ec24b2518",
                        "entry_id": "ca6a536b-60c8-3e0c-88a1-2168a88fc4c9",
                        "glosses": [
                            "weibliche Person, die einer Regierung vorsteht und diese leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d69eb4ed-da98-4383-b447-3e3774d7c0d3",
                                "sense_id": "4d22733f-5646-32e5-8434-733ec24b2518",
                                "text": "Die Regierungschefin hat ihren Bildungsminister entlassen."
                            },
                            {
                                "example_id": "18a3e1db-4f5a-4ae5-b34c-8b44f4f66829",
                                "sense_id": "4d22733f-5646-32e5-8434-733ec24b2518",
                                "text": "„Als Publikumsmagnet erwies sich erneut das Bundeskanzleramt, und die längste Warteschlange bildete sich regelmäßig vor dem Helikopter der Regierungschefin.“"
                            },
                            {
                                "example_id": "2d6bd7bd-2f32-42a9-bd0b-b2c65fce6fcf",
                                "sense_id": "4d22733f-5646-32e5-8434-733ec24b2518",
                                "text": "„Sein Ziel war klar erkennbar, und es war auch dasjenige seiner Regierungschefin: Großbritannien wollte das lästige Problem so schnell wie möglich loswerden, koste es, was es wolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
