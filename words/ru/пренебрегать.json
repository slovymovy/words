{
    "word_family": [
        "пренебрежение",
        "пренебрежительный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71402560-49c8-3f1e-917d-a631b1520523",
                    "sense_definition": "Относиться к кому-либо или чему-либо свысока, без должного уважения или с презрением.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "презрение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не должен артист <w>пренебрегать</w> маленькими ролями, если они художественно интересны.",
                            "target_lang_translations": {
                                "de": "Ein Künstler sollte kleine Rollen nicht <w>geringschätzen</w>, wenn sie künstlerisch interessant sind."
                            }
                        },
                        {
                            "text": "Женщины им <w>пренебрегали</w>, поэтому его политическая карьера не сложилась.",
                            "target_lang_translations": {
                                "de": "Die Frauen <w>missachteten</w> ihn, weshalb seine politische Karriere nicht zustande kam."
                            }
                        }
                    ],
                    "synonyms": [
                        "презирать"
                    ],
                    "antonyms": [
                        "уважать",
                        "почитать",
                        "ценить"
                    ],
                    "common_phrases": [
                        "пренебрегать мнением",
                        "пренебрегать людьми"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden oder etwas von oben herab, ohne gebührenden Respekt oder mit Verachtung behandeln."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "geringschätzen",
                                "target_lang_sense_clarification": "jemanden oder etwas als minderwertig betrachten"
                            },
                            {
                                "target_lang_word": "missachten",
                                "target_lang_sense_clarification": "jemandem nicht die gebührende Achtung entgegenbringen"
                            },
                            {
                                "target_lang_word": "herabsehen auf",
                                "target_lang_sense_clarification": "sich über jemanden erhaben fühlen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a272d43-14f2-360a-8c55-38b52453a505",
                    "sense_definition": "Оставлять что-либо без внимания, считая это неважным или несущественным.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "невнимание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вопросами безопасности нельзя <w>пренебрегать</w> в такой опасной работе.",
                            "target_lang_translations": {
                                "de": "Sicherheitsfragen darf man bei einer solch gefährlichen Arbeit nicht <w>vernachlässigen</w>."
                            }
                        },
                        {
                            "text": "Не стоит <w>пренебрегать</w> советами профессионалов при выборе оборудования.",
                            "target_lang_translations": {
                                "de": "Man sollte die Ratschläge von Profis bei der Wahl der Ausrüstung nicht <w>außer Acht lassen</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "принимать во внимание",
                        "учитывать"
                    ],
                    "common_phrases": [
                        "пренебрегать правилами",
                        "пренебрегать советами",
                        "пренебрегать деталями"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas unbeachtet lassen, weil man es für unwichtig oder nebensächlich hält."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vernachlässigen",
                                "target_lang_sense_clarification": "sich nicht ausreichend um etwas kümmern"
                            },
                            {
                                "target_lang_word": "missachten",
                                "target_lang_sense_clarification": "Regeln oder Vorschriften nicht befolgen"
                            },
                            {
                                "target_lang_word": "außer Acht lassen",
                                "target_lang_sense_clarification": "etwas nicht berücksichtigen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}