{
    "word_family": [
        "rummager"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                    "sense_definition": "To search through something thoroughly and untidily, often by moving things around carelessly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "search_untidily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>rummage</w> through her purse for several minutes before finding her car keys.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось несколько минут <w>рыться</w> в своей сумочке, прежде чем она нашла ключи от машины."
                            }
                        },
                        {
                            "text": "The detective decided to <w>rummage</w> through the drawers in search of the missing document.",
                            "target_lang_translations": {
                                "ru": "Детектив решил <w>обшарить</w> ящики в поисках пропавшего документа."
                            }
                        }
                    ],
                    "synonyms": [
                        "ransack",
                        "rifle"
                    ],
                    "common_phrases": [
                        "rummage through drawers",
                        "rummage for keys"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно и беспорядочно искать что-либо, часто перекладывая вещи с места на место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ры́ться",
                                "target_lang_sense_clarification": "перебирать вещи в поисках чего-либо"
                            },
                            {
                                "target_lang_word": "копа́ться",
                                "target_lang_sense_clarification": "перебирать вещи в узком пространстве"
                            },
                            {
                                "target_lang_word": "обша́ривать",
                                "target_lang_sense_clarification": "тщательно осматривать всё вокруг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47ec687d-1ea7-303d-858f-589986327dd9",
                    "sense_definition": "To search a vessel thoroughly, especially for smuggled goods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "search_untidily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Customs officers boarded the vessel to <w>rummage</w> the cargo hold for contraband.",
                            "target_lang_translations": {
                                "ru": "Таможенники поднялись на судно, чтобы <w>обыскать</w> грузовой трюм на предмет контрабанды."
                            }
                        },
                        {
                            "text": "After the long voyage, the authorities <w>rummaged</w> the ship but found nothing illegal.",
                            "target_lang_translations": {
                                "ru": "После долгого плавания власти <w>обыскали</w> судно, но не нашли ничего незаконного."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rummage the ship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно осматривать судно, особенно в поисках контрабанды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обы́скивать",
                                "target_lang_sense_clarification": "производить досмотр судна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40e9db77-16a0-3c11-9115-b3ac11c9cbc3",
                    "sense_definition": "To arrange or rearrange cargo or goods in the hold of a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stowage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew had to <w>rummage</w> the heavy crates to balance the ship's weight before departure.",
                            "target_lang_translations": {
                                "ru": "Экипажу пришлось <w>переукладывать</w> тяжелые ящики, чтобы сбалансировать вес судна перед отплытием."
                            }
                        },
                        {
                            "text": "They spent hours trying to <w>rummage</w> the cargo efficiently in the tight hold.",
                            "target_lang_translations": {
                                "ru": "Они потратили часы, пытаясь эффективно <w>уложить</w> груз в тесном трюме."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Укладывать или перекладывать груз в трюме судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укла́дывать",
                                "target_lang_sense_clarification": "размещать груз в трюме"
                            },
                            {
                                "target_lang_word": "переукла́дывать",
                                "target_lang_sense_clarification": "перераспределять груз для баланса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3304977-712f-3ddb-93d2-796612650311",
                    "sense_definition": "A thorough search through something, typically resulting in disorder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "search_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have a quick <w>rummage</w> through the attic and see if you can find the old photo album.",
                            "target_lang_translations": {
                                "ru": "Быстро <w>поройся</w> на чердаке и посмотри, сможешь ли ты найти старый фотоальбом."
                            }
                        },
                        {
                            "text": "After a long <w>rummage</w> in his closet, he finally found his winter coat.",
                            "target_lang_translations": {
                                "ru": "После долгих <w>копаний</w> в шкафу он наконец нашел свое зимнее пальто."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a rummage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательный поиск чего-либо, обычно приводящий к беспорядку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́иск",
                                "target_lang_sense_clarification": "процесс нахождения чего-либо"
                            },
                            {
                                "target_lang_word": "обыск",
                                "target_lang_sense_clarification": "тщательный осмотр места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d37a6f68-f819-3af1-9038-416e4ebeae15",
                    "sense_definition": "A disorganized collection of miscellaneous objects; a jumble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jumble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drawer was filled with a confusing <w>rummage</w> of old cables, batteries, and keys.",
                            "target_lang_translations": {
                                "ru": "Ящик был заполнен запутанной <w>свалкой</w> старых кабелей, батареек и ключей."
                            }
                        },
                        {
                            "text": "She sorted through the <w>rummage</w> on the table looking for something useful.",
                            "target_lang_translations": {
                                "ru": "Она перебирала <w>мешанину</w> на столе в поисках чего-то полезного."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочная куча различных предметов; мешанина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свалка",
                                "target_lang_sense_clarification": "беспорядочное скопление вещей"
                            },
                            {
                                "target_lang_word": "меша́нина",
                                "target_lang_sense_clarification": "смесь разнородных предметов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a18f798-6707-3075-8c61-85909c3c8f9b",
                    "sense_definition": "Commotion, disturbance, or bustle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise created a great <w>rummage</w> among the nesting birds.",
                            "target_lang_translations": {
                                "ru": "Внезапный громкий шум вызвал сильную <w>суматоху</w> среди гнездящихся птиц."
                            }
                        },
                        {
                            "text": "There was a constant <w>rummage</w> in the streets during the festival preparations.",
                            "target_lang_translations": {
                                "ru": "Во время подготовки к фестивалю на улицах стояла постоянная <w>суматоха</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Суматоха, беспокойство или шумная деятельность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумато́ха",
                                "target_lang_sense_clarification": "беспокойная деятельность"
                            },
                            {
                                "target_lang_word": "шум",
                                "target_lang_sense_clarification": "громкие звуки и беспорядок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7a5c012-c290-3179-bde0-492a6c0ca415",
                    "sense_definition": "The act of stowing cargo, or the moving of packages during close stowage on a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stowage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proper <w>rummage</w> of the barrels was essential to prevent them from shifting during the storm.",
                            "target_lang_translations": {
                                "ru": "Правильная <w>укладка</w> бочек была необходима, чтобы они не сместились во время шторма."
                            }
                        },
                        {
                            "text": "The harbor master supervised the <w>rummage</w> to ensure the vessel was loaded safely.",
                            "target_lang_translations": {
                                "ru": "Капитан порта контролировал <w>укладку</w>, чтобы убедиться, что судно загружено безопасно."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс укладки груза или перемещение упаковок при плотной загрузке судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укла́дка",
                                "target_lang_sense_clarification": "процесс размещения груза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4caeffec-3ad7-3fc1-8e91-9927de667ced",
                    "sense_definition": "A place or room used for the stowage of cargo in a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stowage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors descended into the damp <w>rummage</w> to retrieve the spare ropes.",
                            "target_lang_translations": {
                                "ru": "Моряки спустились в сырой <w>трюм</w>, чтобы забрать запасные канаты."
                            }
                        },
                        {
                            "text": "Every available space in the ship's <w>rummage</w> was packed tight with spices.",
                            "target_lang_translations": {
                                "ru": "Каждое свободное место в <w>трюме</w> корабля было плотно забито специями."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или помещение для хранения груза на судне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трюм",
                                "target_lang_sense_clarification": "грузовое помещение судна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b17a6f3e-75a4-3c93-9714-5b106c52b3d3",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Rummage</w> to speak at our local historical society meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Раммеджа</w> выступить на собрании нашего местного исторического общества."
                            }
                        },
                        {
                            "text": "The old records show that a family named <w>Rummage</w> lived in this valley centuries ago.",
                            "target_lang_translations": {
                                "ru": "Старые записи показывают, что семья по фамилии <w>Раммедж</w> жила в этой долине столетия назад."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "German origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия немецкого происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Раммедж",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}