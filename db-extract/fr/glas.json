                                        "tags": [
                                            "řidčeji"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c14d63-5db4-4a6e-ab52-a30044877757",
                                                "sense_id": "bc2baf75-499b-380c-97d3-6b05373a9be3",
                                                "text": "Vezmeme komunistům budovy a využijeme je k potřebnějším účelům. „Kremlům“, jak se tehdy budovám okresních a krajských výborů komunistické strany po vzoru sídla sovětských komunistů říkalo, už zvonila hrana."
                                            },
                                            {
                                                "example_id": "58a5195c-d882-4c6d-8c46-02cab430ca12",
                                                "sense_id": "bc2baf75-499b-380c-97d3-6b05373a9be3",
                                                "text": "Zvonili nám umíráčkem, / zvonili nám hrana, / kopali hrob, i byla už / rakev uchystána."
                                            },
                                            {
                                                "example_id": "33e8753f-206f-49bd-91cb-a239537a8614",
                                                "sense_id": "bc2baf75-499b-380c-97d3-6b05373a9be3",
                                                "text": "Když to kvítko svoji / hlavu k zemi skloní, / zdá se mi, že lásce / mojí hrana zvoní."
                                            }
                                        ]
                                    }
                                ]
