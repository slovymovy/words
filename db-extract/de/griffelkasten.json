                        "glosses": [
                            "kleiner länglicher Kasten, in dem Griffel und andere Schreibutensilien aufbewahrt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5515e9d5-9c0d-4e1e-a4c7-1c50f7a05d8b",
                                "sense_id": "1961f143-bfb5-3def-b380-9164d0861d2f",
                                "text": "„Wenn ich hüpfte, klapperte die Schiefertafel gegen den Griffelkasten, den der Großvater aus Brettchen geleimt und mit Schiffen, Fröschen und Wichtelmännchen bemalt hatte, und ein gehäkeltes Läppchen an einer gedrehten Schnur hüpfte mit.“"
                            }
                        ],
