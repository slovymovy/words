                                    {
                                        "sense_id": "9d73dcfe-9a85-3204-a5e6-a4874453c5e5",
                                        "entry_id": "295df492-3e72-309e-9c3d-3b3258a4353f",
                                        "glosses": [
                                            "met een zeer uitgesproken opvatting, waarbij geen afwijkende meningen worden getolereerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01e9e953-ef00-4480-b039-745e10494ea6",
                                                "sense_id": "9d73dcfe-9a85-3204-a5e6-a4874453c5e5",
                                                "text": "Met fundamentalisme bedoelen we naar het inmiddels gangbare spraakgebruik een bigot en bekrompen conservatisme."
                                            },
                                            {
                                                "example_id": "5ad94a95-2bb5-4593-ada2-fbe162fc37cb",
                                                "sense_id": "9d73dcfe-9a85-3204-a5e6-a4874453c5e5",
                                                "text": "Deze bigotte en belachelijke redenering kan niet genoeg bestreden worden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9342b06-7bb7-3e0e-9567-3bf155ea215b",
                                        "entry_id": "295df492-3e72-309e-9c3d-3b3258a4353f",
