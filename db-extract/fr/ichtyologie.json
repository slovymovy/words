                                        "sense_id": "fc421ce2-6f57-3e61-b2a7-320ea0133dc9",
                                        "entry_id": "1389c307-4b40-36ea-8613-4227a93aff1c",
                                        "glosses": [
                                            "wissenschaftliche Lehre von und die Beschäftigung mit den Fischen; Erforschung der Biologie der Fische unter natürlichen und künstlichen Lebensbedingungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cc6188c-2809-4fef-9dea-ba691cfd9492",
                                                "sense_id": "fc421ce2-6f57-3e61-b2a7-320ea0133dc9",
                                                "text": "„Der Vater der modernen Ichthyologie war jedoch der deutsche Arzt Markus Elieser Bloch.“"
                                            },
                                            {
                                                "example_id": "c9edadb0-548b-4606-b949-b4385c72e342",
                                                "sense_id": "fc421ce2-6f57-3e61-b2a7-320ea0133dc9",
                                                "text": "„Wer in der Ichthyologie, der Fischkunde, nicht so wirklich bewandert ist, wird sich über so manche rare Erscheinungsform wundern dürfen – und wer sich traut, darf sie auch anfassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
