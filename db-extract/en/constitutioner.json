                "forms": [
                    {
                        "form_id": "1960451a-5dbe-4c22-885d-07918ee555aa",
                        "entry_id": "7ec7c25e-6bbe-3f6a-bf58-271eb948e485",
                        "tags": [
                            "plural"
                        ],
                        "form": "Constitutioners"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d6ecd13-cac0-3458-a9b7-0f401c373386",
                        "entry_id": "7ec7c25e-6bbe-3f6a-bf58-271eb948e485",
                        "glosses": [
                            "A member of the Constitution Club, a reformist Whig society at Oxford in the 1710s."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6718cd26-ecf1-4cca-bfdf-13b50f4f1d6f",
                                "sense_id": "3d6ecd13-cac0-3458-a9b7-0f401c373386",
                                "text": "And when the Constitutioners shall lay open to publick view a full State of their Case, and appeal to the Reason of Mankind, they are perswaded that the Representation of an Oxford-shire Grand-jury will appear to have proceeded either from Mistake or Prejudice."
                            },
                            {
                                "example_id": "73710958-048c-445d-a3b6-7ce2573b1e1e",
                                "sense_id": "3d6ecd13-cac0-3458-a9b7-0f401c373386",
                                "text": "One of the proctors, in particular, had the modesty and good manners to tell the convocation, that the constitutioners were […] most vile wretches who were hated by gods and men."
                            },
                            {
                                "example_id": "17e87558-5e29-495d-b5b0-bc0512a953b5",
                                "sense_id": "3d6ecd13-cac0-3458-a9b7-0f401c373386",
                                "text": "A Brasenose man was wounded by a gunshot fired by one of the Constitutioners, or their friends in Oriel, after which the crowd retired to pull down the conventicles."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b92eddb-4e59-3acc-a11a-56124a02d6d5",
                        "entry_id": "7ec7c25e-6bbe-3f6a-bf58-271eb948e485",
                        "glosses": [
                            "A member of the Constitution Party, a loosely organized far-right third party in the United States founded in 1952 and dissolved in the 1970s."
                        ],
                        "tags": [
                            "US",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "df64a3a4-0a88-44ec-b06d-d71e098a26a5",
                                "sense_id": "8b92eddb-4e59-3acc-a11a-56124a02d6d5",
                                "text": "The Constitution Party of Texas Tuesday substituted Mrs. W. Lee O’Daniel in the place of her husband as their nominee for governor of Texas. [see title]"
                            },
                            {
                                "example_id": "5db36931-b47a-48e8-abcd-ecfa55612ce1",
                                "sense_id": "8b92eddb-4e59-3acc-a11a-56124a02d6d5",
                                "text": "William P. Gale, the Constitution Party’s candidate for governor of California, says it is mixture of the races which is leading the world to Armageddon […] [see title]"
                            },
                            {
                                "example_id": "e8d68691-c7a1-4892-90fb-c9b9c40f94ca",
                                "sense_id": "8b92eddb-4e59-3acc-a11a-56124a02d6d5",
                                "text": "The Constitution Party Monday night named Charles Sullivan, 29, Clarksdale, Miss., attorney, as its presidential candidate. [see title]"
                            }
                        ]
                    }
                ],
