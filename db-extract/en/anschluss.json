    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "92f73a08-3a15-3f33-b8ca-0af6f44f61a3",
                "word": "Anschluss",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3bb8327f-5921-3c25-9db0-fbe4ee6522c9",
                        "entry_id": "92f73a08-3a15-3f33-b8ca-0af6f44f61a3",
                        "glosses": [
                            "Political annexation, specifically that of Austria into Nazi Germany in 1938."
                        ],
                        "tags": [
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "41758567-e32b-4591-b23b-231893464b6f",
                                "sense_id": "3bb8327f-5921-3c25-9db0-fbe4ee6522c9",
                                "text": "‘Some of us students protested against the Anschluss.’"
                            },
                            {
                                "example_id": "afa5c056-f9dd-4696-8e90-f56541f7ee02",
                                "sense_id": "3bb8327f-5921-3c25-9db0-fbe4ee6522c9",
                                "text": "Riane Eisler was born in Vienna in 1931. After the German Anschluss of Austria she fled with her family, first to Cuba and then to the U.S."
                            },
                            {
                                "example_id": "f20ac470-0983-4dfa-b5f6-df18c4fb2b1c",
                                "sense_id": "3bb8327f-5921-3c25-9db0-fbe4ee6522c9",
                                "text": "Anton Kuh […] was one of the Viennese coffee-house wits whose mastery of the brief critical essay reached its apotheosis in the last nervous years before the Anschluss."
                            },
                            {
                                "example_id": "7a8da5f3-43b9-4c83-8723-0267ba59d0e3",
                                "sense_id": "3bb8327f-5921-3c25-9db0-fbe4ee6522c9",
                                "text": "Not far from where we are sitting is Heldenplatz, where in March 1938 Adolf Hitler addressed a cheering crowd to proclaim the Anschluss—the annexation of Austria into Nazi Germany, in defiance of the post-first world war treaties of Versailles and Saint-Germain."
                            }
                        ]
                    }
                ],
