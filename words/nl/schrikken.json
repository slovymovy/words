                {
                    "sense_id": "50bc3f38-765c-3d85-b952-282330c47987",
                    "sense_definition": "plotseling bang worden door een onverwachte gebeurtenis",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moest erg <w>schrikken</w> toen de hond plotseling hard begon te blaffen.",
                            "target_lang_translations": {
                                "en": "I was very <w>startled</w> when the dog suddenly started barking loudly.",
                                "ru": "Я сильно <w>испугался</w>, когда собака вдруг начала громко лаять."
                            }
                        },
                        {
                            "text": "Je moet niet zo hard <w>schrikken</w> van een klein beetje lawaai in de gang.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>get such a fright</w> from a little bit of noise in the hallway.",
                                "ru": "Не стоит так сильно <w>пугаться</w> небольшого шума в коридоре."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschieten"
                    ],
                    "antonyms": [
                        "kalmeren"
                    ],
                    "common_phrases": [
                        "niet schrikken",
                        "zich rot schrikken"
                    ],
                    "target_lang_definitions": {
                        "en": "to suddenly become afraid due to an unexpected event",
                        "ru": "внезапно испугаться из-за неожиданного события"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be startled",
                                "target_lang_sense_clarification": "to be suddenly surprised or frightened"
                            },
                            {
                                "target_lang_word": "to get a fright",
                                "target_lang_sense_clarification": "to experience a sudden shock of fear"
                            },
                            {
                                "target_lang_word": "to be scared",
                                "target_lang_sense_clarification": "to feel fear suddenly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "испугаться",
                                "target_lang_sense_clarification": "внезапно почувствовать страх"
                            },
                            {
                                "target_lang_word": "вздрогнуть",
                                "target_lang_sense_clarification": "от неожиданности или испуга"
                            },
                            {
                                "target_lang_word": "перепугаться",
                                "target_lang_sense_clarification": "сильно испугаться"
                            }
                        ]
