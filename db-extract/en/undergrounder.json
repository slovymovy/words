                                "example_id": "6e021177-4cb3-4529-83e7-8fefb906bfd9",
                                "sense_id": "39be2978-2ad0-3147-8983-0d3def61e4f6",
                                "text": "1985, Abe Peck, Uncovering the Sixties: The Life and Times of the Underground Press, p. 51,\nStreet people, day-trippers, and tourists pushed the paper's circulation to 117,000, the largest any community undergrounder would reach."
                            }
                        ]
                    },
