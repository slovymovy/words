                    "frequency": "High",
                    "semantic_group_id": "raum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Wanderer suchten während des starken Regens in einer tiefen <w>Höhle</w> Schutz."
                        },
                        {
                            "text": "Tief in der <w>Höhle</w> entdeckten die Forscher jahrtausendealte Malereien an den Wänden."
                        }
                    ],
                    "synonyms": [
