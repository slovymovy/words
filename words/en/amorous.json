                            },
                            {
                                "target_lang_word": "多情的",
                                "target_lang_sense_clarification": "形容人容易动情或有爱慕之心"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zamilovaný",
                                "target_lang_sense_clarification": "pociťující silný citový vztah"
                            },
                            {
                                "target_lang_word": "chtivý",
                                "target_lang_sense_clarification": "mající silnou touhu po někom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a94959d-f6ba-395c-9779-aa3a7358750a",
                    "sense_definition": "Showing or expressing sexual desire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "love_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ignored his <w>amorous</w> suggestions during the meeting.",
                            "target_lang_translations": {
                                "zh": "会议期间，她无视了他那些<w>色情的</w>暗示。",
                                "cs": "Během schůzky ignorovala jeho <w>svůdné</w> návrhy."
                            }
                        },
                        {
                            "text": "The actor gave an <w>amorous</w> look to his co-star on stage.",
                            "target_lang_translations": {
                                "zh": "舞台上，演员向他的搭档投去了<w>色情的</w>目光。",
                                "cs": "Herec vrhl na svou kolegyni na jevišti <w>svůdný</w> pohled."
                            }
                        }
                    ],
                    "synonyms": [
                        "lustful",
                        "concupiscent"
                    ],
                    "common_phrases": [
                        "amorous suggestions",
                        "amorous look"
                    ],
                    "target_lang_definitions": {
                        "zh": "表现出或表达性欲的。",
                        "cs": "Projevující nebo vyjadřující sexuální touhu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "色情的",
                                "target_lang_sense_clarification": "指带有明显性暗示或欲望的"
                            },
                            {
                                "target_lang_word": "好色的",
                                "target_lang_sense_clarification": "指表现出强烈性欲的"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "svůdný",
                                "target_lang_sense_clarification": "mající za cíl vyvolat sexuální zájem"
                            },
                            {
                                "target_lang_word": "chtivý",
                                "target_lang_sense_clarification": "projevující sexuální žádostivost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cdba0d2-1335-35e7-9171-793eeb7ebaa3",
                    "sense_definition": "Being in love with someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "love_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had been <w>amorous</w> of her since they were children.",
                            "target_lang_translations": {
                                "zh": "他从小就一直<w>爱慕</w>着她。",
                                "cs": "Byl do ní <w>zamilovaný</w> už od dětství."
                            }
                        },
                        {
                            "text": "The poet was clearly <w>amorous</w> of his muse.",
                            "target_lang_translations": {
                                "zh": "这位诗人显然对他的灵感女神十分<w>倾心</w>。",
                                "cs": "Básník byl zjevně <w>zahleděný</w> do své múzy."
                            }
                        }
                    ],
                    "synonyms": [
                        "loving"
                    ],
                    "target_lang_definitions": {
                        "zh": "爱慕某人的。",
                        "cs": "Být do někoho zamilovaný."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爱慕的",
                                "target_lang_sense_clarification": "指对某人怀有深厚爱意"
                            },
                            {
                                "target_lang_word": "倾心的",
                                "target_lang_sense_clarification": "指对某人深深着迷"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zamilovaný",
                                "target_lang_sense_clarification": "pociťující lásku k někomu"
                            },
                            {
                                "target_lang_word": "zahleděný",
                                "target_lang_sense_clarification": "být do někoho hluboce zamilovaný"
                            }
                        ]
                    }
                }
            ]
        }
    ]
