        "fr-extract.jsonl": [
            {
                "entry_id": "bbb9de03-f5d4-31be-a332-676b6a84319c",
                "word": "d'enfer",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                        "entry_id": "bbb9de03-f5d4-31be-a332-676b6a84319c",
                        "glosses": [
                            "Très grand, très violent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30a6afa-4851-4266-8cdf-6ecb8ccbaaf2",
                                "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                                "text": "Il y a toujours un feu d’enfer dans cette verrerie, feu très ardent."
                            },
                            {
                                "example_id": "7feb80b8-b4f9-4ace-aa04-28979a353d43",
                                "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                                "text": "Jouer un jeu d’enfer, jouer très gros jeu."
                            },
                            {
                                "example_id": "31550fb2-aba0-460a-a62f-d9dcec6aa140",
                                "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                                "text": "Aller un train d’enfer, aller fort vite."
                            },
                            {
                                "example_id": "b0650a41-8145-4224-accd-9064d407f05a",
                                "sense_id": "8560a6a7-d303-3b0e-a014-7cd4e12fa5a0",
                                "text": "Rinaldo, sous bois, retrouva son cheval, sauta en selle, et, sur le coups de midi, rentra dans Paris par la porte Saint-Honoré et traversa la bonne ville de Sa Majesté Louis XIII, en un galop d’enfer, sans s’inquiéter des cris d’effroi ou des clameurs menaçantes qu’il soulevait sur son passage."
                            }
                        ]
                    },
                    {
                        "sense_id": "43b5db4f-dae3-3048-9ea4-4cfee80ec0dd",
                        "entry_id": "bbb9de03-f5d4-31be-a332-676b6a84319c",
                        "glosses": [
                            "Super, génial."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a6e9e897-5a21-4111-b8cd-6d389a56118e",
                                "sense_id": "43b5db4f-dae3-3048-9ea4-4cfee80ec0dd",
                                "text": "Avec leurs tatouages et leurs barbes aussi, j’ai trouvé qu’ils avaient une dégaine d’enfer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13dec1aa-1dab-4279-a8e7-24cbadc48182",
                        "source_entry_id": "bbb9de03-f5d4-31be-a332-676b6a84319c",
                        "target_lang_word": "hell of a",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hell of a",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2673d8b8-9fba-3f85-8ec2-9df740e0777c",
                                        "entry_id": "3bfd2162-3fdf-33f9-bebd-64acd681115e",
                                        "glosses": [
                                            "Intensifier; indicates that someone or something is especially good, bad, difficult, etc."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7639fb00-b7db-4b43-b49b-649a1e801f0f",
                                                "sense_id": "2673d8b8-9fba-3f85-8ec2-9df740e0777c",
                                                "text": "Well done! That's a hell of an achievement!"
                                            },
                                            {
                                                "example_id": "554a675d-eb5a-4cc8-b91c-2429d48a2b31",
                                                "sense_id": "2673d8b8-9fba-3f85-8ec2-9df740e0777c",
                                                "text": "She had a hell of a time trying to open the jar. In the end she gave up: it was one hell of a cover."
                                            },
                                            {
                                                "example_id": "15489923-95a9-4e99-822c-58b7973dfee5",
                                                "sense_id": "2673d8b8-9fba-3f85-8ec2-9df740e0777c",
                                                "text": "Where were you? / I got lost in the woods. / Wow! Hell of a place to get lost!"
                                            },
                                            {
                                                "example_id": "b05bf3e9-e765-4aac-856d-debf7a3c3bfb",
                                                "sense_id": "2673d8b8-9fba-3f85-8ec2-9df740e0777c",
                                                "text": "Yeah, this was one hell of a party / Nobody ever got to bed / But the morning after's killing me / And I have to rest my head"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d0f4e4b-8d4b-4ab8-82ac-bab0ce1dcf12",
                        "source_entry_id": "bbb9de03-f5d4-31be-a332-676b6a84319c",
                        "target_lang_word": "helluva",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helluva",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3be6b07a-9cc9-3f3d-93bf-f56d3c5dafb6",
                                        "entry_id": "908a8de4-0d38-3b51-a7bd-805958724216",
                                        "glosses": [
                                            "(A) hell of a; extreme."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042ec131-8ed6-449b-8e5d-3b76979782ae",
                                                "sense_id": "3be6b07a-9cc9-3f3d-93bf-f56d3c5dafb6",
                                                "text": "They had a helluva row over where to spend the weekend."
                                            },
                                            {
                                                "example_id": "7c73f9b0-92ab-4499-819b-8543c22b4ffc",
                                                "sense_id": "3be6b07a-9cc9-3f3d-93bf-f56d3c5dafb6",
                                                "text": "Where were you? - Lost in Paris. - Wow! Helluva place to get lost!"
                                            },
                                            {
                                                "example_id": "5db021c8-33e1-4214-a183-d95ab7e7d9b0",
                                                "sense_id": "3be6b07a-9cc9-3f3d-93bf-f56d3c5dafb6",
                                                "text": "Well, I got a Muppet News Flash for you, pal; it is possible for a three-year-old girl who loves to watch ducks and collect sea shells to feel bad, and then a bit worse, and then a whole helluva lot worse, and finally lousy in a way that requires machines and tubes and pills and catheters and before you know it you’re sitting in the front pew at good ol’ St. Fracis de Sales Church on Granville Street along with your wife and parents and inlaws and X-amount of your balding schoolboy chums listening to some second-rate organist eviscerate Bach’s “Sheep May Safely Graze”[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "helluva",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8af433cb-4332-38be-90a4-bc27d172a331",
                                        "entry_id": "d5cff85b-3ec9-3bb7-982a-4290e29e67ad",
                                        "glosses": [
                                            "; (expletive) (A) hell of a; extremely or very."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e25bafb-fa8f-4606-aa4b-a624b4bd80b0",
                                                "sense_id": "8af433cb-4332-38be-90a4-bc27d172a331",
                                                "text": "We had a helluva good time at the party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
