                                                "sense_id": "0d735cce-3a55-36a0-9052-db0749ccb583",
                                                "text": "Die Reste der Blutprobe wurden für spätere Untersuchungen aufbewahrt."
                                            },
                                            {
                                                "example_id": "64a46990-5c9c-4e09-9076-84b8bf71f1fe",
                                                "sense_id": "0d735cce-3a55-36a0-9052-db0749ccb583",
                                                "text": "Die Blutprobe war verunreinigt, der Test konnte daher nicht durchgeführt werden."
                                            },
                                            {
                                                "example_id": "b30aac14-392e-410c-aab7-21de992a92d1",
                                                "sense_id": "0d735cce-3a55-36a0-9052-db0749ccb583",
                                                "text": "„Diagramme, die Elissa Epel damals anhand der Blutproben ihrer pflegenden Mütter erstellte, beweisen den Zusammenhang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
