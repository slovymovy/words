                                    {
                                        "sense_id": "80c22319-e408-3238-bf49-3f025e240fde",
                                        "entry_id": "190518c8-829f-3235-bef8-d2caf66f3087",
                                        "glosses": [
                                            "Alternative form of Saint Nicholas."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94bda17-c133-4f21-ac8e-b088715087ec",
                                                "sense_id": "80c22319-e408-3238-bf49-3f025e240fde",
                                                "text": "A father whispers to his sons about the miracle of St Nicholas's manna, a pure water collected from the tomb every May."
                                            },
                                            {
                                                "example_id": "bbc1b249-b063-4119-aefc-a7f9faba1291",
                                                "sense_id": "80c22319-e408-3238-bf49-3f025e240fde",
                                                "text": "I was about seven when I first heard the story of St Nicholas and the pickled boys, among many saints' stories."
                                            },
                                            {
                                                "example_id": "81a2c9db-cd42-4c3a-94ef-42e4dfa16c36",
                                                "sense_id": "80c22319-e408-3238-bf49-3f025e240fde",
                                                "text": "Another church was built on top of the ancient basilica's foundation to protect the saint's tomb, but it was not until recently did archaeologists uncover mosaic and stone flooring from the previous sanctuary under the one that stands today that led them to St Nicholas' final resting place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b9f6022-5859-372e-9216-9f663ce3a805",
                                        "entry_id": "190518c8-829f-3235-bef8-d2caf66f3087",
                                        "glosses": [
                                            "A village in St Nicholas and Bonvilston community, Vale of Glamorgan borough county borough, Wales (OS grid ref ST0974)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
