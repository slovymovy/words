                    "frequency": "Middle",
                    "semantic_group_id": "astronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le télescope permet d'observer un <w>astre</w> lointain avec une grande précision."
                        },
                        {
                            "text": "Le soleil est l'<w>astre</w> du jour qui réchauffe notre planète."
                        }
                    ],
                    "synonyms": [
