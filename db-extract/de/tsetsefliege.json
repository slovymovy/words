                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4dcba19-9df0-4489-9e2f-38059b95095a",
                                "sense_id": "169e6292-5094-3019-a29a-cbe560443a9f",
                                "text": "Marianne wurde in ihrem Urlaub in Kongo von einer Tsetsefliege gestochen."
                            },
                            {
                                "example_id": "cda49e26-fb3f-43f2-83b0-179208cdd8d5",
                                "sense_id": "169e6292-5094-3019-a29a-cbe560443a9f",
                                "text": "„In Ostafrika ist er der einzig halbwegs wirksame Schutz gegen die Tsetsefliege.“"
                            },
                            {
                                "example_id": "52952996-c747-4eb4-96dc-2a4fac2d0022",
                                "sense_id": "169e6292-5094-3019-a29a-cbe560443a9f",
                                "text": "„Allmorgendlich schwärmten sie aus, Tsetsefliegen zu fangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
