                "senses": [
                    {
                        "sense_id": "4b90505c-5069-3d09-93bd-9ebbc3b04f25",
                        "entry_id": "78099e75-6004-394f-97c7-c36d368b2de4",
                        "glosses": [
                            "Zeitfenster, das benötigt wird, damit etwas reif wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3311507b-e40e-41f4-8b2c-96dbd858ca09",
                                "sense_id": "4b90505c-5069-3d09-93bd-9ebbc3b04f25",
                                "text": "„Während der Reifezeit [von Milch zum Käse] wird Eiweiß durch sortentypische Bakterien abgebaut, wodurch der charakteristische Geschmack entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0105e971-779a-321d-acbf-09b2f6628255",
                        "entry_id": "78099e75-6004-394f-97c7-c36d368b2de4",
                        "glosses": [
                            "anderes Wort für die pubertäre Phase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3adfee9d-90fa-403e-ab49-adfe9a092234",
                                "sense_id": "0105e971-779a-321d-acbf-09b2f6628255",
                                "text": "Während der Reifezeit verändert sich der Mensch sehr stark."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bcbd8e7-2b3c-4859-b0ef-beebc078725f",
                        "source_entry_id": "78099e75-6004-394f-97c7-c36d368b2de4",
                        "source_sense_id": "4b90505c-5069-3d09-93bd-9ebbc3b04f25",
