                "senses": [
                    {
                        "sense_id": "6a81cc8b-0675-31d5-b6ba-cfa276327514",
                        "entry_id": "774649d5-1d9e-32d0-b193-672f016116df",
                        "glosses": [
                            "свойство или состояние по значению прилагательного обыденный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0387c41e-806d-45ca-91df-34bf152c3112",
                                "sense_id": "6a81cc8b-0675-31d5-b6ba-cfa276327514",
                                "text": "По-прежнему боязно было говорить, да и не в бесцельной трате и умирании была беда, а в том, что и он узрел контраст: величие исторического момента ― и позорная обыденность происходящего."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c392112-868d-3740-930c-c89df67ebb3e",
                        "entry_id": "774649d5-1d9e-32d0-b193-672f016116df",
                        "glosses": [
                            "обыденная жизнь, обстановка, обыденные условия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9018b377-bee3-4cbd-8428-686d428a365c",
                                "sense_id": "4c392112-868d-3740-930c-c89df67ebb3e",
                                "text": "На войне же случаи чудовищные становились обыденностью."
                            }
                        ]
                    }
                ],
