                        "glosses": [
                            "To pierce with a needle; to treat with acupuncture."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5441d132-b76a-43f2-96cd-717221b08f67",
                                "sense_id": "19f372f9-be6b-376d-be09-4dfa4b9c505f",
                                "text": "In the course of these months she was bled, leeched, acupunctuated, […]."
                            },
                            {
                                "example_id": "8073036b-e0c9-4ce9-ba4d-d00c05668400",
                                "sense_id": "19f372f9-be6b-376d-be09-4dfa4b9c505f",
                                "text": "Indeed, a lady quietly remarked to the writer, with that exquisite sweet malice wherewith French ladies so much delight to acu-punctuate their English sisters, \"I have never seen any English lady handle her fan nearly so gracefully as that Basque boy does; they ALWAYS make themselves in a heat by blowing so hard, but look at him.\""
                            },
                            {
                                "example_id": "4ed213eb-0175-4fca-893b-41eae7c3f848",
                                "sense_id": "19f372f9-be6b-376d-be09-4dfa4b9c505f",
                                "text": "Who do you suppose get acupunctuated better, a Tibetan yak-herd or Chairman Mao?"
                            }
                        ]
                    }
