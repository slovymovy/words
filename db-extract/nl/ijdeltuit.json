                "senses": [
                    {
                        "sense_id": "257f9ba2-4059-3b56-b27b-000c3af90e46",
                        "entry_id": "fbc97129-5308-3348-90aa-e14bd8526a9b",
                        "glosses": [
                            "iemand met te veel aandacht en waardering voor het eigen uiterlijk"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "21f6d9c1-b31b-4b0d-bc5a-bdb559e6841d",
                                "sense_id": "257f9ba2-4059-3b56-b27b-000c3af90e46",
                                "text": "Sta je nou weer voor de spiegel? Wat ben je toch een ijdeltuit!"
                            },
                            {
                                "example_id": "7ca68c65-4fd4-45fa-b12d-8e7cea716037",
                                "sense_id": "257f9ba2-4059-3b56-b27b-000c3af90e46",
                                "text": "Oulahsen ziet eruit als een mondaine, westerse vrouw. Chique rok, sieraden, rode lippenstift. Ze is een „een ijdeltuit”, zegt ze."
                            },
                            {
                                "example_id": "4e76d953-4990-4cb6-b4ad-8478eca34a92",
                                "sense_id": "257f9ba2-4059-3b56-b27b-000c3af90e46",
                                "text": "Oud-Ajacied Sjaak Swart (73) vertelt in het internetprogramma Betweters van Hugo Borst en Koert Westerman dat hij een ijdeltuit is en een paar keer per dag in de spiegel gluurt en ook dagelijks twee keer op de weegschaal staat."
                            }
                        ]
                    },
                    {
                        "sense_id": "15731af6-cb0a-3712-9597-f27a0f234760",
                        "entry_id": "fbc97129-5308-3348-90aa-e14bd8526a9b",
                        "glosses": [
                            "iemand met overdreven aandacht en waardering voor het eigen imago"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "18c478d9-a935-4add-a755-167cf9763c8e",
                                "sense_id": "15731af6-cb0a-3712-9597-f27a0f234760",
                                "text": "„Laten we het even over die Timmermans hebben”, zei Poetin, „die man ergert me. Een ijdeltuit met z’n getwitter en getetter. (…)”"
                            }
                        ]
                    }
