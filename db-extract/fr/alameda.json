                        "glosses": [
                            "Allée plantée de peupliers, allée de promenade ombragée (par tout type d’arbre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa81c8b5-e8b9-45b2-9e91-245aedb283b8",
                                "sense_id": "30d5b625-6a7f-3b0b-8a71-b87be9e560ad",
                                "text": "Le rêve de tout jefe político, en Espagne, est d’avoir une alameda, comme celui de tout préfet, en France, une rue de Rivoli dans sa ville."
                            },
                            {
                                "example_id": "64204a36-76fb-4f2a-a8d0-800112c16929",
                                "sense_id": "30d5b625-6a7f-3b0b-8a71-b87be9e560ad",
                                "text": "L’alameda, toute dallée de pierre, est ombragée par deux ou trois allées d’arbres assez garnis de feuilles pour des arbres espagnols dont le pied ne trempe pas dans un puits."
                            }
                        ]
                    }
