                        "glosses": [
                            "Characteristic of or relating to a narrow-minded concern with the morals of others; self-righteous"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cea676d-0b57-4c5c-83d5-143712caaea2",
                                "sense_id": "72d8fa49-25cf-3032-8f54-ee8df9965a35",
                                "text": "She was glad to escape her judgmental and moralistic parents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "724b6509-73ef-4538-a410-6599d1f4a04b",
                        "source_entry_id": "830adf3d-7eb5-3bed-a48d-83ebd6453b6a",
                        "source_sense_id": "72d8fa49-25cf-3032-8f54-ee8df9965a35",
