                        ],
                        "form": "die Hungerstreiks"
                    },
                    {
                        "form_id": "0546ac07-23ad-4127-b376-1504f46733fa",
                        "entry_id": "ddea1e75-2b2d-3a1b-ac91-c0dafb744d25",
                        "tags": [
                            "accusative",
