                "word": "UFZ",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b8eec922-8d15-38b6-8a63-747c9010fc6a",
                        "entry_id": "9c3e6f5a-919d-34aa-a8de-0a354a787dda",
                        "glosses": [
                            "Helmholtz-Zentrum für Umweltforschung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aca2092-e7f2-43c7-9897-d47c47a3f4ff",
                                "sense_id": "b8eec922-8d15-38b6-8a63-747c9010fc6a",
                                "text": "Das UFZ – gegründet im Dezember 1991 – beschäftigt sich als erste und einzige Forschungseinrichtung der Hermann von Helmholtz-Gemeinschaft Deutscher Forschungszentren (HGF) ausschließlich mit Umweltforschung."
                            },
                            {
                                "example_id": "d8232187-80a8-4a4c-9950-151096482afe",
                                "sense_id": "b8eec922-8d15-38b6-8a63-747c9010fc6a",
                                "text": "Das Helmholtz-Zentrum für Umweltforschung - UFZ hat sich mit seinen 1.100 Mitarbeiterinnen und Mitarbeitern als internationales Kompetenzzentrum für Umweltwissenschaften einen hervorragenden Ruf erworben."
                            },
                            {
                                "example_id": "45d32dec-23c7-474b-abd3-7f8ff517aeed",
                                "sense_id": "b8eec922-8d15-38b6-8a63-747c9010fc6a",
                                "text": "\"Wir konnten zeigen, dass eine Belastung durch Tabakrauch auch epigenetische Veränderungen in Verstärkern der Genregulation, sogenannten Enhancern, hervorruft\", sagte Irina Lehmann, eine der Autorinnen und Forscherin am UFZ."
                            },
                            {
                                "example_id": "d3141c6f-e390-483e-ba9c-11e8b8d80a9e",
                                "sense_id": "b8eec922-8d15-38b6-8a63-747c9010fc6a",
                                "text": "Sie hatten 7256 Brutdaten der Frühlingsboten aus den Jahren 1997 bis 2010 in Ostdeutschland analysiert, wie das UFZ am Mittwoch in Leipzig mitteilte."
                            },
                            {
                                "example_id": "fd548d38-9f8b-4894-99e6-ae2c3c2f55d0",
                                "sense_id": "b8eec922-8d15-38b6-8a63-747c9010fc6a",
                                "text": "Mexiko habe ein System, bei dem Leistungen eines Ökosystems bereits angerechnet werden, schreibt das UFZ."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
