                        ]
                    },
                    {
                        "sense_id": "a55fda77-78db-30f0-ad47-2a6e877602ac",
                        "entry_id": "57279ba0-0692-3c81-b921-755c16c9804e",
                        "glosses": [
                            "iets waarmee men een opening of bekentenis kan forceren"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9a846c8e-621b-4286-a4d4-a0c241700ac6",
                                "sense_id": "a55fda77-78db-30f0-ad47-2a6e877602ac",
                                "text": "'Waarom heeft u die opname gemaakt, redacteur Levov?' vroeg de advocaat op dezelfde lichte toon als wanneer hij naar het weer zou hebben gevraagd. Wat een fantastische openingsvraag! dacht Eric. Zo briljant eenvoudig, en toch een stormram."
                            }
                        ]
                    }
