                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0565999-589a-4524-9777-5656a66d35f0",
                                                "sense_id": "f8393b9f-3189-3254-8732-4fa2ab3220ba",
                                                "text": "John blacked out at the halfway point of the marathon."
                                            }
                                        ]
                                    }
                                ]
