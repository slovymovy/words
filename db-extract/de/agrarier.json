                        "glosses": [
                            "(männliche^☆) Person, die über (meist große) landwirtschaftliche Flächen verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eca2772f-ddfd-480e-98e9-7ce7427277b9",
                                "sense_id": "a554bfcd-2a6e-34c8-8fb4-451d3e714d78",
                                "text": "Er war ein Agrarier, aber er heiratete eine arme Haushaltshilfe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4084be48-679a-348e-8568-493f0451b2e1",
                        "entry_id": "044c8c69-73fb-3fda-8e25-c8c4a719e79c",
                        "glosses": [
                            "Fachmann für Agrarwesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fbf67d-510e-4d8f-8ec8-501538f2a5ee",
                                "sense_id": "4084be48-679a-348e-8568-493f0451b2e1",
                                "text": "Er wollte Jurisprudenz studieren, aber musste aus Mangel an zureichendem Geld Agrarier werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "90b8c26e-0c81-3089-8aba-e3f65751ebad",
                        "entry_id": "044c8c69-73fb-3fda-8e25-c8c4a719e79c",
                        "glosses": [
                            "„Vertreter wirtschaftspolitischer Interessen der Landwirte“"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "81217a31-9f11-4dcf-8daf-66550211305a",
                                "sense_id": "90b8c26e-0c81-3089-8aba-e3f65751ebad",
                                "text": "„Der Hofjägermeister hielt eine Rede auf Gott, König und Vaterland der Agrarier, und Onkel Heinrich war gerührt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
