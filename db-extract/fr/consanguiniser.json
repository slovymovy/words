                "senses": [
                    {
                        "sense_id": "079b4426-221b-3c90-a1c6-e2f85668f0c3",
                        "entry_id": "f583b9ca-c89e-3bd6-b3b4-3129ba886938",
                        "glosses": [
                            "Donner un caractère consanguin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b21360fb-8ef1-4f3d-b07c-21f45b71fcd1",
                                "sense_id": "079b4426-221b-3c90-a1c6-e2f85668f0c3",
                                "text": "L’homme doit se concilier l’épouse, voire, on le verra dans la seconde partie, la « consanguiniser » à l’intérieur de son lignage."
                            },
                            {
                                "example_id": "b8f1677c-7d6d-4c36-9d63-c1f097da8486",
                                "sense_id": "079b4426-221b-3c90-a1c6-e2f85668f0c3",
                                "text": "La tendance générale est de « consanguiniser » tous ceux qui rentrent par mariage dans cette parentèle, comme les épouses des oncles et les maris des tantes."
                            }
                        ]
                    }
