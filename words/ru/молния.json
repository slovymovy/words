{
    "word_family": [
        "молниеносный",
        "молниеотвод"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e06210be-54a8-3417-b401-88f6a1f654d1",
                    "sense_definition": "атмосферное явление, вспышка света от электрического разряда во время грозы",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "природные явления",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Яркая <w>молния</w> осветила всё небо во время ночной грозы.",
                            "target_lang_translations": {
                                "en": "A bright <w>lightning bolt</w> lit up the whole sky during the night storm."
                            }
                        },
                        {
                            "text": "После того как сверкнула <w>молния</w>, раздался гром.",
                            "target_lang_translations": {
                                "en": "After the <w>lightning</w> flashed, thunder followed."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сверкает молния",
                        "удар молнии"
                    ],
                    "target_lang_definitions": {
                        "en": "An atmospheric phenomenon; a flash of light caused by an electrical discharge during a thunderstorm."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lightning",
                                "target_lang_sense_clarification": "The natural electrical discharge in the atmosphere."
                            },
                            {
                                "target_lang_word": "thunderbolt",
                                "target_lang_sense_clarification": "A flash of lightning accompanied by a crash of thunder, often used in a dramatic or literary context."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "393b7b56-a6c1-348b-a1ed-493f4d2e21e6",
                    "sense_definition": "застёжка в виде двух полос ткани с рядами сцепляемых зубцов",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня на куртке сломалась <w>молния</w>.",
                            "target_lang_translations": {
                                "en": "The <w>zipper</w> on my jacket broke."
                            }
                        },
                        {
                            "text": "Застегни <w>молнию</w> на рюкзаке, чтобы вещи не выпали.",
                            "target_lang_translations": {
                                "en": "Fasten the <w>zipper</w> on your backpack so your things don't fall out."
                            }
                        }
                    ],
                    "common_phrases": [
                        "застегнуть молнию",
                        "сломалась молния"
                    ],
                    "target_lang_definitions": {
                        "en": "A fastener consisting of two strips of fabric with interlocking teeth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zipper",
                                "target_lang_sense_clarification": "The standard term for a zip fastener (US/Australia)."
                            },
                            {
                                "target_lang_word": "zip",
                                "target_lang_sense_clarification": "The common term for a zip fastener (UK/Commonwealth)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "685eda63-4110-38af-9998-42a5c42ad68c",
                    "sense_definition": "срочное сообщение или телеграмма",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "связь",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В редакцию пришла срочная <w>молния</w> о начале событий.",
                            "target_lang_translations": {
                                "en": "An urgent <w>flash</w> about the start of the events arrived at the editorial office."
                            }
                        },
                        {
                            "text": "Начальник получил <w>молнию</w> с требованием немедленного ответа.",
                            "target_lang_translations": {
                                "en": "The boss received an urgent <w>telegram</w> demanding an immediate response."
                            }
                        }
                    ],
                    "synonyms": [
                        "срочная телеграмма"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "используется в контексте телеграфной связи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An urgent message or telegram."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flash",
                                "target_lang_sense_clarification": "A brief, urgent news report or message."
                            },
                            {
                                "target_lang_word": "express telegram",
                                "target_lang_sense_clarification": "A telegram sent with priority."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8604c4f8-5a16-36e0-a54b-b98da85f9c2a",
                    "sense_definition": "срочный выпуск газеты или информационный листок",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "связь",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты выпустили стенную <w>молнию</w> с результатами экзаменов.",
                            "target_lang_translations": {
                                "en": "The students released a wall-mounted <w>news bulletin</w> with the exam results."
                            }
                        },
                        {
                            "text": "Газетная <w>молния</w> сообщила о важном научном открытии.",
                            "target_lang_translations": {
                                "en": "A newspaper <w>newsflash</w> reported on an important scientific discovery."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An urgent edition of a newspaper or an information bulletin."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "newsflash",
                                "target_lang_sense_clarification": "A brief, urgent news update."
                            },
                            {
                                "target_lang_word": "breaking news",
                                "target_lang_sense_clarification": "Current, urgent information being reported."
                            }
                        ]
                    }
                },
                {
