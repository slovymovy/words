                            {
                                "target_lang_word": "future",
                                "target_lang_sense_clarification": "adjective"
                            },
                            {
                                "target_lang_word": "next",
                                "target_lang_sense_clarification": "upcoming"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未来",
                                "target_lang_sense_clarification": "形容词，指将来的"
                            },
                            {
                                "target_lang_word": "下",
