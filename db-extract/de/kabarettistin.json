                "senses": [
                    {
                        "sense_id": "02e5bcda-be0b-3a48-a037-b22045e3d34b",
                        "entry_id": "010e964b-9d06-3405-95bf-9c7659ce85e8",
                        "glosses": [
                            "Künstlerin, die in einem Kabarett mitwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "277ce090-803c-4242-9b61-428202ce4caf",
                                "sense_id": "02e5bcda-be0b-3a48-a037-b22045e3d34b",
                                "text": "„Die Laudatio hielt die Kabarettistin Luise Kinseher, die Auszüge aus ihrer Magisterarbeit von 1994 über den Kabarettisten einfließen ließ.“"
                            },
                            {
                                "example_id": "b304a1b6-70ec-4023-b787-56abbd5164ee",
                                "sense_id": "02e5bcda-be0b-3a48-a037-b22045e3d34b",
                                "text": "„Ausgezeichnet werden Parodistin und Kabarettistin Martina Brandl aus Geislingen, die Komödiantin und Moderatorin Rosemie aus Heidelberg sowie der Kabarettist Bernd Kohlhepp aus Tübingen, wie Toto-Lotto Baden-Württemberg am Freitag mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
