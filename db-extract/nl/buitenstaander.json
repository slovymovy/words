                "senses": [
                    {
                        "sense_id": "8964337a-5f54-3cf6-abf1-bb2365b11ddd",
                        "entry_id": "076dc041-c078-3d58-b371-f4e985e95209",
                        "glosses": [
                            "iemand die niet bij de groep hoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "625f57e5-1515-4ef6-8ad0-9d48f582c3be",
                                "sense_id": "8964337a-5f54-3cf6-abf1-bb2365b11ddd",
                                "text": "Voor een buitenstaander is carnaval maar een raar feest."
                            },
                            {
                                "example_id": "cb0152e4-3a04-468f-963c-a54c3e2a7f0f",
                                "sense_id": "8964337a-5f54-3cf6-abf1-bb2365b11ddd",
                                "text": "De ondernemer wordt niet gecorrigeerd als hij foute beslissingen neemt en bij zijn vertrek ontstaat intense onrust. Moet zijn opvolger uit de familie komen? Of kan het een buitenstaander zijn? Zakelijke overwegingen en emoties kunnen de interne verhoudingen gemakkelijk ontwrichten."
                            },
                            {
                                "example_id": "97cdaf81-645a-455a-944a-d7e61abdf731",
                                "sense_id": "8964337a-5f54-3cf6-abf1-bb2365b11ddd",
                                "text": "Het toeval wilde dat er geen buitenstaanders waren ingestapt."
                            },
                            {
                                "example_id": "c9863d80-426d-44c1-b84c-6053ce788a50",
                                "sense_id": "8964337a-5f54-3cf6-abf1-bb2365b11ddd",
                                "text": "Nee, over de situatie in Noorwegen wilde hij het niet met een buitenstaander hebben en zelfs thuis liever niet, tijdens de etentjes in het weekend in Saltsjôbaden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39f62633-5cd0-4aff-94e2-85a3533c3278",
                        "source_entry_id": "076dc041-c078-3d58-b371-f4e985e95209",
                        "source_sense_id": "8964337a-5f54-3cf6-abf1-bb2365b11ddd",
                        "source_sense_description": "iemand buiten de groep, van buiten",
                        "target_lang_word": "Außenseiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Außenseiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53fdcccc-4a3e-3054-9d55-7cb12ec1d62a",
                                        "entry_id": "484037f2-510e-37bf-8f00-a4f99293750c",
                                        "glosses": [
                                            "eine Person oder Mannschaft, von der angenommen wird, dass sie keine Gewinnchancen hat; ein Tier, ohne angenommene Gewinnchance"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f199e75-1e38-487e-9c34-934bc21d634c",
                                                "sense_id": "53fdcccc-4a3e-3054-9d55-7cb12ec1d62a",
                                                "text": "Benfica Lissabon ist im Endspiel gegen Chelsea Außenseiter."
                                            },
                                            {
                                                "example_id": "f4b6c2d1-0a29-43b5-afbd-d96977da8ee9",
                                                "sense_id": "53fdcccc-4a3e-3054-9d55-7cb12ec1d62a",
                                                "text": "Das Pferd mit der Nummer 10 ist ein totaler Außenseiter, es hat noch nie ein Rennen gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9293cf51-e770-3504-85d6-388c3f7b9622",
                                        "entry_id": "484037f2-510e-37bf-8f00-a4f99293750c",
                                        "glosses": [
                                            "Person, die nicht in einer Gruppe integriert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e550b949-52bc-4af7-9238-dffd1ac75bca",
                                                "sense_id": "9293cf51-e770-3504-85d6-388c3f7b9622",
                                                "text": "Aribert verhält sich wie ein Außenseiter, er möchte sich gar nicht der Gruppe anschließen."
                                            },
                                            {
                                                "example_id": "ffb51448-b65f-45c5-b533-541a8156023e",
                                                "sense_id": "9293cf51-e770-3504-85d6-388c3f7b9622",
                                                "text": "„Dieser Mann war allen ein Rätsel, und ich interessierte mich für jeden, der als Außenseiter galt.“"
                                            },
                                            {
                                                "example_id": "25178930-8f49-49e4-bc5d-4f8396c572de",
                                                "sense_id": "9293cf51-e770-3504-85d6-388c3f7b9622",
                                                "text": "„Klimaschutz war lange ein Thema der Außenseiter, der ewigen Warner.“"
                                            },
                                            {
                                                "example_id": "9b35db1b-373e-4d8c-8ff4-df000215b18c",
                                                "sense_id": "9293cf51-e770-3504-85d6-388c3f7b9622",
                                                "text": "„Da sich eine Gemeinschaft durch den Außenseiter immer herausgefordert, bedroht oder unterwandert fühlt, widmet sie ihm ihr ganzes Interesse, ihren Argwohn, und schließlich verfolgt sie ihn mit ihrem Haß.“"
                                            },
                                            {
                                                "example_id": "944e5b58-2f6f-4863-a964-e3640868c989",
                                                "sense_id": "9293cf51-e770-3504-85d6-388c3f7b9622",
                                                "text": "„Wallace war ein Außenseiter und kein Gentleman, jedenfalls keiner der Art, die sich in der Linné-Gesellschaft tummelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c17297e4-3f26-43d5-ab83-0459c35980a1",
                        "source_entry_id": "076dc041-c078-3d58-b371-f4e985e95209",
                        "source_sense_id": "8964337a-5f54-3cf6-abf1-bb2365b11ddd",
                        "source_sense_description": "iemand buiten de groep, van buiten",
                        "target_lang_word": "outsider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outsider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                        "entry_id": "683a71e4-8d45-3af7-acc3-6609b737c075",
                                        "glosses": [
                                            "One who is not part of a community or organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f416cb-c88d-45e5-9273-f675bc01caa9",
                                                "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                                "text": "While the initiated easily understand the symbols, they are wholly inaccessible to outsiders."
                                            },
                                            {
                                                "example_id": "d64df32d-c943-488b-8e9f-78d85c7a9be0",
                                                "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                                "text": "I'm an outsider by choice, but not truly. It's the unpleasantness of the system that keeps me out. I'd rather be in, in a good system. That's where my discontent comes from: being forced to choose to stay outside."
                                            },
                                            {
                                                "example_id": "158ede05-9eb0-4fec-9601-e4c36e76644d",
                                                "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                                "text": "We were not a big huggie family so I was very, very encased in a little stay-away-from-me shell growing-up, and here I got to open up and feel safe and able to touch and hold and be able to be with another human being, which was really a big relief, a very positive part of my understanding of myself that I wasn't just this outcast evil outsider of everything."
                                            },
                                            {
                                                "example_id": "bbb8e400-9cda-479a-bd6f-743b4a0be290",
                                                "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                                "text": "We are the only outsiders here, granted exclusive access and a private tour as the first major US news organization allowed inside Cecot late last month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8828bd-de6e-351f-8f12-5c36fa24c0ce",
                                        "entry_id": "683a71e4-8d45-3af7-acc3-6609b737c075",
                                        "glosses": [
                                            "A newcomer with little or no experience in an organization or community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f278783b-9387-4cb5-8a6d-6a868b2672d0",
                                                "sense_id": "5f8828bd-de6e-351f-8f12-5c36fa24c0ce",
                                                "text": "Seeing the mess professional politicians have made of things is it any wonder the electorate is beginning to prefer outsiders?"
                                            },
                                            {
                                                "example_id": "ded7366f-6c02-4799-9d74-78e963a2ff34",
                                                "sense_id": "5f8828bd-de6e-351f-8f12-5c36fa24c0ce",
                                                "text": "These worlds have always belonged to us, from the moment our ancestors saw them through ancient telescopes. We claimed them when our first explorers reached the stars, and they remained our worlds even after the Scourge divided us in darkness. Outsiders have no right to these treasures, and true angara must stand ready to defend our birthright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "462f6ab1-da5c-39ff-9010-443b338f87fc",
                                        "entry_id": "683a71e4-8d45-3af7-acc3-6609b737c075",
                                        "glosses": [
                                            "A competitor or contestant who has little chance of winning; a long shot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27fafb5-80da-41cd-93a9-fa13ddb30e4f",
                                                "sense_id": "462f6ab1-da5c-39ff-9010-443b338f87fc",
                                                "text": "Johnny was an outsider at this year's karate tournament, but he still managed to win second place out of sheer determination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03492aba-131b-3045-910f-d41d69039882",
                                        "entry_id": "683a71e4-8d45-3af7-acc3-6609b737c075",
                                        "glosses": [
                                            "The heel or end piece of a loaf of bread."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d51b1260-3670-4964-8c38-32a242526175",
                        "source_entry_id": "076dc041-c078-3d58-b371-f4e985e95209",
                        "source_sense_id": "8964337a-5f54-3cf6-abf1-bb2365b11ddd",
                        "source_sense_description": "iemand buiten de groep, van buiten",
                        "target_lang_word": "tiers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0feec5b7-bdb0-3c3e-87bc-32ea656d8369",
                                        "entry_id": "aa3e8426-84b9-3bb0-ac8c-ea62e4407231",
                                        "glosses": [
                                            "Partie d’une unité qui est subdivisée en trois parties égales ; résultat de la division par trois. 1/3."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309b1faf-a6b1-4189-a7ef-08d723eb3509",
                                                "sense_id": "0feec5b7-bdb0-3c3e-87bc-32ea656d8369",
                                                "text": "Chacun d’eux semblait aussi long que le Strand et aussi large que Trafalgar Square. Certains même devaient avoir un tiers de mille de longueur."
                                            },
                                            {
                                                "example_id": "510e05a9-167d-4a6f-a03b-138b79de5654",
                                                "sense_id": "0feec5b7-bdb0-3c3e-87bc-32ea656d8369",
                                                "text": "Les sociétaires soumis à l’assurance obligatoire auront à supporter deux tiers du montant des cotisations, l'autre tiers est à la charge du patron."
                                            },
                                            {
                                                "example_id": "31b3605a-0590-4d06-9705-b41a42bdc2a1",
                                                "sense_id": "0feec5b7-bdb0-3c3e-87bc-32ea656d8369",
                                                "text": "Un tiers environ du département est formé de ces causses dénudés, de ces plateaux calcaires hauts, ici de 500 à 1000 mètres […]"
                                            },
                                            {
                                                "example_id": "997844c3-aace-4372-9ce4-be61f9f8004a",
                                                "sense_id": "0feec5b7-bdb0-3c3e-87bc-32ea656d8369",
                                                "text": "Cette salle des machines est découpée en deux. Deux tiers de l'énergie sont distribués à une fréquence de 50 Hz pour alimenter des sites industriels en Bavière. Le tiers restant, qui affiche 16,7 Hz, est fourni à la Deutsche Bahn, pour faire rouler ses trains dans le land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "425c2af6-09f5-3559-abb6-0836b4cdcf79",
                                        "entry_id": "aa3e8426-84b9-3bb0-ac8c-ea62e4407231",
                                        "glosses": [
                                            "Troisième personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd8a628-20a4-4492-b184-ecb7967ca774",
                                                "sense_id": "425c2af6-09f5-3559-abb6-0836b4cdcf79",
                                                "text": "Il survint un tiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b18bab8-336e-316d-a7eb-cc664667d0d9",
                                        "entry_id": "aa3e8426-84b9-3bb0-ac8c-ea62e4407231",
                                        "glosses": [
                                            "Personne étrangère à une affaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb5ff47-5184-4524-8cd2-5a64130edfa6",
                                                "sense_id": "2b18bab8-336e-316d-a7eb-cc664667d0d9",
                                                "text": "La baronnie d’Elbeuf fut adjugée à René, duc de Lorraine ; mais Jean de Rieux déclara ne pouvoir rendre les 12 fiefs dont Bourgtheroulde faisait partie, attendu que, donnés en mariage à sa sœur, ils étaient détenus par des tiers."
                                            },
                                            {
                                                "example_id": "ce22e156-6802-4596-ad0a-33c9703ae49a",
                                                "sense_id": "2b18bab8-336e-316d-a7eb-cc664667d0d9",
                                                "text": "De telles relations, si elles m’avaient été révélées par un tiers, eussent suffi pour me tuer à demi, mais comme c’était moi qui les imaginais, j’avais soin d’y ajouter assez d’incertitude pour amortir la douleur."
                                            },
                                            {
                                                "example_id": "0a046d96-e3cc-4c8b-a4e8-a790f7664d5e",
                                                "sense_id": "2b18bab8-336e-316d-a7eb-cc664667d0d9",
                                                "text": "De nouveau j'éprouve cette fureur sourde bien connue de tous les pères de famille : ce sont les tiers, neuf fois sur dix, qui nous entraînent dans leurs aventures et, à cet égard, l'imprudence des enfants, si peu soucieux de leurs actes comme de leurs relations, multiplie les chances noires."
                                            },
                                            {
                                                "example_id": "f9dd8c74-dc95-4d66-9db2-c9dcb38bde3d",
                                                "sense_id": "2b18bab8-336e-316d-a7eb-cc664667d0d9",
                                                "text": "Il avait expliqué que les Britanniques étaient «des ressortissants de pays tiers», une catégorie de voyageurs pour laquelle le transit vers un autre pays de l'UE n'est pas permis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5af9e8a-2b0f-3c87-9b7c-92f673f0059d",
                                        "entry_id": "aa3e8426-84b9-3bb0-ac8c-ea62e4407231",
                                        "glosses": [
                                            "Troisième situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7219614-b6ad-47d9-bf50-fe03ad2a46fa",
                                                "sense_id": "a5af9e8a-2b0f-3c87-9b7c-92f673f0059d",
                                                "text": "Le principe du tiers exclus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4209bd1c-0106-38e3-b7af-0296b4715836",
                                        "entry_id": "aa3e8426-84b9-3bb0-ac8c-ea62e4407231",
                                        "glosses": [
                                            "Personne n’ayant été ni partie ni représentée à un acte juridique, tel qu'un contrat, qui n’est pas touchée par son effet obligatoire et peut tout au plus se le voir opposer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7229adb-272b-4766-a7f5-f6637bbded27",
                                                "sense_id": "4209bd1c-0106-38e3-b7af-0296b4715836",
                                                "text": "Pourtant, tous les actes unilatéraux ne sont pas réceptices alors même qu'ils produisent des effets sur des tiers. Ainsi, la reconnaissance d’enfant naturel, le testament et l'acceptation de succession sont de nature à produire des conséquences sur des tiers. Pourtant ils ne s'adressent à personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e1b1357-bc9d-3050-ad0d-17ba6126c7a7",
                                        "entry_id": "aa3e8426-84b9-3bb0-ac8c-ea62e4407231",
                                        "glosses": [
                                            "Le tiers état."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37af7a28-d844-4ae5-8e66-3290f2472bb9",
                                                "sense_id": "7e1b1357-bc9d-3050-ad0d-17ba6126c7a7",
                                                "text": "On dit que vous avez un beau nom, et que pour l’honneur vous êtes sans reproche ; mais on dit aussi que vous pourriez bien adhérer au doublement du tiers."
                                            },
                                            {
                                                "example_id": "c6d4a934-dc91-483a-b49c-6d1560996093",
                                                "sense_id": "7e1b1357-bc9d-3050-ad0d-17ba6126c7a7",
                                                "text": "Pour l’élection du député direct, la municipalité […] obtint du Garde des sceaux l’autorisation de réunir indistinctement dans les paroisses tous les membres du tiers, corporés ou non corporés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tiers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c63cde9-8574-3656-ad4c-0054f2d71406",
                                        "entry_id": "a3170e25-2995-3fe2-90b1-a2f4e11f10b1",
                                        "glosses": [
                                            "Troisième."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1cf0923-56ef-445b-b828-fa75d535a665",
                                                "sense_id": "7c63cde9-8574-3656-ad4c-0054f2d71406",
                                                "text": "L'importation en droiture des pays de provenance cesserait dès lors d'être une obligation stricte et le bénéfice du tarif de faveur serait conservé à la marchandise, même si elle empruntait la voie d'un pays tiers, pourvu que celui-ci ne fût pas soumis à des droits plus forts que le pays d'origine."
                                            },
                                            {
                                                "example_id": "36adf497-af39-49ed-ba09-d73254158d5a",
                                                "sense_id": "7c63cde9-8574-3656-ad4c-0054f2d71406",
                                                "text": "L’Angleterre ne voulait rien savoir d’une intervention au Maroc par une tierce Puissance, qui mettrait en danger la position-clef de Gibraltar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e892a632-6b65-32c3-9370-2c7126470477",
                                        "entry_id": "a3170e25-2995-3fe2-90b1-a2f4e11f10b1",
                                        "glosses": [
                                            "Qui relève de l’état de tiers, de tierce partie, donc extérieur aux parties précédemment impliquées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "567c156e-0a83-4d4f-8ffd-7abba5ce0855",
                                                "sense_id": "e892a632-6b65-32c3-9370-2c7126470477",
                                                "text": "Après avoir mis en demeure le groupement de faire réaliser les opérations d’enlèvement de la grue accidentée, le pouvoir adjudicateur attribue à une société tierce le marché de démantèlement et de mise en stock de la grue accidenté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
