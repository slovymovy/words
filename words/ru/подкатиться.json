{
    "word_family": [
        "катить",
        "катиться",
        "подкат",
        "откатиться",
        "прикатиться",
        "раскатиться"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33bdca2c-fcf1-32dd-94c0-c7eef0ff3a61",
                    "sense_definition": "Приблизиться к чему-либо, перемещаясь на колесах (о транспортном средстве).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Такси бесшумно <w>подкатилось</w> к главному входу отеля.",
                            "target_lang_translations": {
                                "it": "Il taxi ha <w>accostato</w> silenziosamente all'ingresso principale dell'hotel."
                            }
                        },
                        {
                            "text": "Автомобиль <w>подкатился</w> к тротуару, и из него вышли пассажиры.",
                            "target_lang_translations": {
                                "it": "L'auto ha <w>accostato</w> al marciapiede e i passeggeri sono scesi."
                            }
                        }
                    ],
                    "synonyms": [
                        "подъехать"
                    ],
                    "common_phrases": [
                        "подкатиться к подъезду"
                    ],
                    "target_lang_definitions": {
                        "it": "Avvicinarsi a un luogo muovendosi su ruote, riferito a un veicolo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "accostare",
                                "target_lang_sense_clarification": "avvicinarsi con un veicolo a un punto specifico"
                            },
                            {
                                "target_lang_word": "arrivare",
                                "target_lang_sense_clarification": "giungere a destinazione in auto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e24c6c0b-1985-3456-8aef-93a78af45974",
                    "sense_definition": "Приблизиться к чему-либо, перекатываясь или двигаясь по земле.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мяч <w>подкатился</w> прямо к моим ногам.",
                            "target_lang_translations": {
                                "it": "La palla <w>è rotolata</w> proprio ai miei piedi."
                            }
                        },
                        {
                            "text": "Ребёнок <w>подкатился</w> по траве к самому краю площадки.",
                            "target_lang_translations": {
                                "it": "Il bambino <w>è rotolato</w> sull'erba fino al bordo del campo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Avvicinarsi a qualcosa rotolando o muovendosi lungo il terreno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "rotolare",
                                "target_lang_sense_clarification": "muoversi girando su se stessi verso qualcuno"
                            },
                            {
                                "target_lang_word": "arrivare rotolando",
                                "target_lang_sense_clarification": "giungere in un punto tramite un movimento rotatorio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c0775ac-f259-311f-bc72-9e15b292449d",
                    "sense_definition": "Деликатно или хитро обратиться с просьбой к кому-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я долго думал, как <w>подкатиться</w> к начальнику с этой просьбой.",
                            "target_lang_translations": {
                                "it": "Ho pensato a lungo a come <w>approcciare</w> il capo con questa richiesta."
                            }
                        },
                        {
                            "text": "Нужно уметь правильно <w>подкатиться</w> к человеку, чтобы он согласился помочь.",
                            "target_lang_translations": {
                                "it": "Bisogna saper <w>prendere</w> la persona <w>per il verso giusto</w> affinché accetti di aiutare."
                            }
                        }
                    ],
                    "synonyms": [
                        "подступиться",
                        "подъехать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Используется в разговорной речи."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Approcciarsi a qualcuno in modo astuto o delicato per fare una richiesta."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "approcciare",
                                "target_lang_sense_clarification": "avvicinarsi a qualcuno con uno scopo specifico"
                            },
                            {
                                "target_lang_word": "prendere per il verso giusto",
                                "target_lang_sense_clarification": "cercare il modo migliore per convincere qualcuno"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}