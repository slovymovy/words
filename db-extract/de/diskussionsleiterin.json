                "senses": [
                    {
                        "sense_id": "13d0e8e0-a40a-3b23-934f-e2b26cadbf46",
                        "entry_id": "fdce4cd3-44ab-334f-90d1-00a4931f463e",
                        "glosses": [
                            "weibliche Person, die in einer Diskussionsrunde die Leitung innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b31e3649-2bd4-4ded-82d0-3d26432ce420",
                                "sense_id": "13d0e8e0-a40a-3b23-934f-e2b26cadbf46",
                                "text": "„Ob auch Roger Köppel über diese Fähigkeit verfüge, wollte die Diskussionsleiterin, STANDARD-Chefredakteurin Alexandra Föderl-Schmid, von dem Abgeordneten der populistischen SVP wissen.“"
                            },
                            {
                                "example_id": "9c65df62-7195-4808-8231-50c005d26b97",
                                "sense_id": "13d0e8e0-a40a-3b23-934f-e2b26cadbf46",
                                "text": "„Unwissenheit, Fahrlässigkeit, aber eben auch Rücksichtslosigkeit bis zur Gewalt gegen Rettungskräfte gehören zu den Erklärungen, weshalb Notfalleinsätze erschwert oder behindert werden, sagt Monika Dorfmüller, klinische Psychologin und Diskussionsleiterin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
