                ],
                "senses": [
                    {
                        "sense_id": "1aba987b-3d66-31f5-8759-222083a04102",
                        "entry_id": "9df025c5-1bfd-3114-96ae-b8b655453727",
                        "glosses": [
                            "mit tiefliegenden Augen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc3e2414-36c2-4b0b-9667-6d99c72713dd",
                                "sense_id": "1aba987b-3d66-31f5-8759-222083a04102",
                                "text": "„Auf der Farm hatte man ihnen eingebläut, dass sie zu Mitarbeitern des besten Geheimdienstes der Welt ausgebildet würden, doch als Ferris die übergewichtigen, hohläugigen Männer und Frauen sah, die durch die Flure der Zentrale schlichen, begann er ernsthaft daran zu zweifeln und fragte sich, ob er vielleicht gerade dabei war, den größten Fehler seines Lebens zu machen.“"
                            },
                            {
                                "example_id": "87cbba67-11af-4f71-b06c-94e2f07f8213",
                                "sense_id": "1aba987b-3d66-31f5-8759-222083a04102",
                                "text": "„De la Roche stand dem Schrein mit dem hohläugigen Schädel unter dem weißen Schleier direkt gegenüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
