                                "sense_id": "0c5d96a3-6065-3cb7-bf44-70f6d97e0130",
                                "text": "Das Polizeiauto ist mit Blaulicht an mir vorbeigerast.",
                                "translation": "The police car raced past me with flashing lights.",
                                "english": "The police car raced past me with flashing lights."
                            }
                        ]
                    },
                    {
                        "sense_id": "33778e3a-28e2-38ab-94c3-f34c98c87234",
                        "entry_id": "e023d502-d395-3c32-b708-c983f0ca5dcb",
                        "glosses": [
                            "emergency vehicle(s) (with such flashing lights)"
                        ],
