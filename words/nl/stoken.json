            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c34aec60-abd0-3314-87b5-2e3249a784e1",
                    "sense_definition": "Brandstof aan een vuur of kachel toevoegen om warmte te produceren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verwarmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter <w>stoken</w> we de houtkachel om de woonkamer lekker warm te houden.",
                            "target_lang_translations": {
                                "en": "In winter, we <w>stoke</w> the wood stove to keep the living room nice and warm."
                            }
                        },
                        {
                            "text": "Het is veel te koud in huis, we moeten de kachel flink <w>stoken</w>.",
                            "target_lang_translations": {
                                "en": "It is much too cold in the house, we need to <w>heat</w> the stove up high."
                            }
                        }
                    ],
                    "synonyms": [
                        "branden",
                        "verwarmen"
                    ],
                    "common_phrases": [
                        "de kachel stoken",
                        "met hout stoken"
                    ],
                    "target_lang_definitions": {
                        "en": "To add fuel to a fire or stove to produce heat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stoke",
                                "target_lang_sense_clarification": "to feed or stir up a fire"
                            },
                            {
                                "target_lang_word": "heat",
                                "target_lang_sense_clarification": "to warm up a space using a stove or heater"
                            },
                            {
                                "target_lang_word": "burn",
                                "target_lang_sense_clarification": "to use fuel for heating"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e270ff2b-db87-39ae-b2a6-607c3317d817",
                    "sense_definition": "Bewust onrust, ruzie of onenigheid tussen mensen veroorzaken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onrust-stoken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die roddeltante zit de hele dag te <w>stoken</w>, waardoor haar buren nu ruzie met elkaar hebben.",
                            "target_lang_translations": {
                                "en": "That gossip is <w>stirring up trouble</w> all day, which is why her neighbors are now arguing with each other."
                            }
                        },
                        {
                            "text": "Probeer niet te <w>stoken</w> tussen die twee vrienden, ze lossen het zelf wel op.",
                            "target_lang_translations": {
                                "en": "Try not to <w>cause trouble</w> between those two friends, they will solve it themselves."
                            }
                        }
                    ],
                    "synonyms": [
                        "opstoken",
                        "ophitsen",
                        "intrigueren"
                    ],
                    "antonyms": [
                        "sussen",
                        "verzoenen"
                    ],
                    "common_phrases": [
                        "onrust stoken",
                        "ruzie stoken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in informele contexten over sociale relaties."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To deliberately cause unrest, arguments, or discord between people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stir up",
                                "target_lang_sense_clarification": "to provoke trouble or arguments"
                            },
                            {
                                "target_lang_word": "instigate",
                                "target_lang_sense_clarification": "to incite trouble or discord"
                            },
                            {
                                "target_lang_word": "stoke",
                                "target_lang_sense_clarification": "to encourage or fuel negative emotions or conflict"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f761896d-0fd1-32b7-9a9e-cca74ca8b5f4",
                    "sense_definition": "Alcoholische drank vervaardigen door middel van distillatie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distilleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn opa wist vroeger in het geheim sterke drank te <w>stoken</w> in de schuur.",
                            "target_lang_translations": {
                                "en": "His grandfather used to know how to secretly <w>distil</w> liquor in the shed."
                            }
                        },
                        {
                            "text": "Het is illegaal om zonder vergunning zelf jenever te <w>stoken</w>.",
                            "target_lang_translations": {
                                "en": "It is illegal to <w>distil</w> gin yourself without a permit."
                            }
                        }
                    ],
                    "synonyms": [
                        "distilleren",
                        "branden"
                    ],
                    "common_phrases": [
                        "jenever stoken",
                        "drank stoken"
                    ],
                    "target_lang_definitions": {
                        "en": "To manufacture alcoholic beverages by means of distillation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "distil",
                                "target_lang_sense_clarification": "to make spirits by distilling"
                            },
                            {
                                "target_lang_word": "brew",
                                "target_lang_sense_clarification": "to make alcoholic drinks"
                            }
                        ]
                    }
                }
            ]
        }
    ]
