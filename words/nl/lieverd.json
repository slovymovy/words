                    "sense_id": "1a3340e9-0915-3555-bd90-d24be62b661c",
                    "sense_definition": "Iemand die erg aardig, zachtaardig en behulpzaam is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affectionate_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je bent echt een <w>lieverd</w> omdat je me hebt geholpen met verhuizen.",
                            "target_lang_translations": {
                                "ru": "Ты просто <w>прелесть</w>, что помог мне с переездом.",
                                "en": "You are such a <w>sweetheart</w> for helping me move.",
                                "pl": "Jesteś prawdziwym <w>kochanie</w>, że pomogłeś mi przy przeprowadzce.",
                                "de": "Du bist wirklich ein <w>Schatz</w>, dass du mir beim Umzug geholfen hast.",
                                "fr": "Tu es vraiment <w>un amour</w> de m'avoir aidé à déménager.",
                                "it": "Sei davvero un <w>tesoro</w> per avermi aiutato con il trasloco.",
                                "cs": "Jsi opravdu <w>zlatíčko</w>, že jsi mi pomohl se stěhováním.",
                                "tr": "Taşınmama yardım ettiğin için gerçekten bir <w>tatlısın</w>.",
                                "es": "Eres un verdadero <w>encanto</w> por haberme ayudado con la mudanza.",
                                "zh": "你真是个<w>大好人</w>，谢谢你帮我搬家。"
                            }
                        },
                        {
                            "text": "Mijn oma is een grote <w>lieverd</w> die altijd koekjes voor ons bakt.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка — настоящая <w>душка</w>, она всегда печет нам печенье.",
                                "en": "My grandma is a big <w>sweetheart</w> who always bakes cookies for us.",
                                "pl": "Moja babcia to prawdziwe <w>złotko</w>, zawsze piecze dla nas ciasteczka.",
                                "de": "Meine Oma ist ein echtes <w>Goldstück</w>, die immer Kekse für uns backt.",
                                "fr": "Ma grand-mère est <w>un amour</w> qui nous prépare toujours des biscuits.",
                                "it": "Mia nonna è un vero <w>tesoro</w> che ci prepara sempre i biscotti.",
                                "cs": "Moje babička je velké <w>zlatíčko</w>, které nám vždycky peče sušenky.",
                                "tr": "Anneannem bize her zaman kurabiye yapan çok <w>tatlı biridir</w>.",
                                "es": "Mi abuela es un <w>sol</w> que siempre nos hornea galletas.",
                                "zh": "我奶奶是个<w>大好人</w>，总是给我们烤饼干。"
                            }
                        }
                    ],
                    "synonyms": [
                        "schat"
