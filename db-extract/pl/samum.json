                        "cross_references": [
                            {
                                "target_word": "σιμούν",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "91712e8f-165e-3e05-b761-69a7bc3bb970",
                                        "entry_id": "e35c293c-bbdc-3dad-8ad1-c4f1a67ec7ab",
                                        "glosses": [
                                            "καυτός ορμητικός άνεμος της ερήμου"
                                        ],
                                        "tags": [
                                            "άνεμος"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce84e96e-5e7d-4ad3-b254-0b839b33dbec",
                                                "sense_id": "91712e8f-165e-3e05-b761-69a7bc3bb970",
                                                "text": "※ Εἰς πολλά μέρη τῆς γῆς ὑπάρχουσιν ἄνεμοι φέροντες εἰδικά ὀνόματα. Οὕτω ὁ θερμός ἄνεμος, ὁ ἀπό τῆς ἐρήμου πνέων ἐπί τήν Βόρειον Ἀφρικήν ὀνομάζεται «Σιμούν»· οἱ ἄνεμοι τοῦ Ἰνδικοῦ Ὠκεανοῦ ὀνομάζονται «Μονσούν» ἢ «ἐτησίαι»· αἱ καταιγίδες τοῦ Εἰρηνικοῦ Ὠκεανοῦ «τυφῶνες» καὶ αἱ σφοδραὶ τρικυμίαι τοῦ κόλπου τῆς Γουϊνέας «σίφωνες» ἢ «tornados» ἐξ ἱσπανικῆς λέξεως σημαινούσης «στρέφεσθαι».",
                                                "translation": "περιοδικό Εστία, τόμοι 19-20, 1885, σελ. 209 https://www.google.gr/books/edition/Hestia/4bcdqyC5ZD0C?hl=el&gbpv=1&pg=PA209&printsec=frontcover"
                                            },
                                            {
                                                "example_id": "7f74583c-b7a0-44a4-a1a5-1f4586642011",
                                                "sense_id": "91712e8f-165e-3e05-b761-69a7bc3bb970",
                                                "text": "※ Η ζέστη ήταν αφόρητη και ο άνεμος σιμούν μπορούσε να ψήσει ακόμη και πτώμα.",
                                                "translation": "Μάρκο Πόλο: Ταξίδι στην αυλή του Κουμπλάι Χάν, εφημερίδα Έθνος, 21 Μαρτίου 2020"
                                            },
                                            {
                                                "example_id": "ae14082b-dea9-4739-9963-a06fccd610b7",
                                                "sense_id": "91712e8f-165e-3e05-b761-69a7bc3bb970",
                                                "text": "※ Κλέβει το χνούδι απ’ τα παιδιά, τα μονοπάτια σβήνει, / βαφτίζεται στην έρημο και γίνεται σιμούν.",
                                                "translation": "τραγούδι Σιμούν, ερμηνεία/στίχοι/μουσική: Θανάσης Παπακωνσταντίνου, 2010"
                                            },
                                            {
                                                "example_id": "119eca29-cb89-4db5-8a39-d0c7213b5d1d",
                                                "sense_id": "91712e8f-165e-3e05-b761-69a7bc3bb970",
                                                "text": "※ Η χώρα βρισκόταν στις παραμονές ενός μεγάλου κινδύνου, του Μεχμέτ Αλή της Αιγύπτου, ενός αληθινού αφρικανικού σιμούν, που επρόκειτο ύστερα από ένα μήνα να ενσκήψει σφοδρός και να κατερημώσει την Πελοπόννησο.",
                                                "translation": "Απόστολος Βακαλόπουλος, Ιστορία του Νέου Ελληνισμού, τόμος Ζʹ, Η μεγάλη Ελληνική Επανάσταση (1821–1829), Ο αφρικανικός Σιμούν στην Ελλάδα ή η επιδρομή του Ιμπραΐμ (1825–1828), Θεσσαλονίκη 1986, σελ. 7"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
