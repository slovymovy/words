                        "source_sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                        "source_sense_description": "Maßeinheit der Energie, die häufig in der Atomphysik, Kernphysik und Teilchenphysik benutzt wird",
                        "target_lang_word": "électronvolt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électronvolt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "902fcce5-258e-3b12-afb4-196992eb6c83",
                                        "entry_id": "6e7e691e-31a0-332e-acaf-9fd80ece333c",
                                        "glosses": [
                                            "Unité de mesure d’énergie qui correspond à l’énergie acquise par un électron accéléré par une différence de potentiel d’un volt, dont le symbole est eV."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b96640cb-1ae4-48bc-a2f8-650656f1c760",
                                                "sense_id": "902fcce5-258e-3b12-afb4-196992eb6c83",
                                                "text": "Un électronvolt vaut 1,602 176 53 × 10⁻¹⁹ joule."
                                            },
                                            {
                                                "example_id": "b335182b-ed96-442f-9e74-0f957c755068",
                                                "sense_id": "902fcce5-258e-3b12-afb4-196992eb6c83",
                                                "text": "Tous les phénomènes qui concernent la chimie se produisent par des processus qui mettent en jeu des énergies qui vont de quelques électronvolts à des fractions d’électronvolt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a4c0d19-6188-4abd-ab57-6e74b69d43f9",
                        "source_entry_id": "b98a19a3-d3d9-394b-b423-a79cfd3e69a9",
                        "source_sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                        "source_sense_description": "Maßeinheit der Energie, die häufig in der Atomphysik, Kernphysik und Teilchenphysik benutzt wird",
                        "target_lang_word": "électron-volt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électron-volt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6ba8aed-0751-3735-91a8-52e97c27273e",
                                        "entry_id": "35f5381b-aa3a-3d7c-8077-c004513870c8",
                                        "glosses": [
                                            "Variante orthographique de électronvolt."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4757a521-204a-4325-a1a2-26bbce272193",
                                                "sense_id": "f6ba8aed-0751-3735-91a8-52e97c27273e",
                                                "text": "Aujourd'hui les physiciens manient des synchrophasotrons de plusieurs milliards d’électrons-volts, pesant des milliers de tonnes et coûtant des sommes énormes."
                                            },
                                            {
                                                "example_id": "4fafad1e-5532-464d-97d0-b5aa083ff0da",
                                                "sense_id": "f6ba8aed-0751-3735-91a8-52e97c27273e",
                                                "text": "Les forces provocatrices sont celles que l'on doit mettre en jeu pour perturber la cohésion de l'atome. La perturbation de la structure atomique intervient d'abord au niveau des réactions chimiques où quelques électrons-volts (eV) suffisent pour modifier les liaisons électromagnétiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
