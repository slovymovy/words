                                "target_lang_sense_clarification": "official signet"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sello",
                                "target_lang_sense_clarification": "herramienta oficial o de oficina"
                            },
                            {
                                "target_lang_word": "timbre",
                                "target_lang_sense_clarification": "herramienta para marcar documentos"
                            }
                        ],
                        "fr": [
