                        "examples": [
                            {
                                "example_id": "cae0c5fb-2d8f-4e57-ad83-533e8de30a6e",
                                "sense_id": "47e8cf30-6a92-345f-87a2-31909954893d",
                                "text": "Après cette bagoulette avec le Grec, je me tire de là et je me tape un petit casse-graine dans un quick-lunch-bar tout en réfléchissant tranquillement."
                            },
                            {
                                "example_id": "82ef4c9b-9b00-46da-bdef-7e85d3267deb",
                                "sense_id": "47e8cf30-6a92-345f-87a2-31909954893d",
                                "text": "— Je crois que j’ai trouvé une technique pour se dépoivrer. La bagoulette... hein !\nLe toubib était très talon rouge, bourgeois de naissance et de comportement.\n— Comment dis-tu, la bagou... quoi ?...\n— La bagoulette... la conversation... eh, aristo de mon cœur !..."
                            },
                            {
                                "example_id": "3a51e606-12f5-474e-950a-a149afcfddb0",
                                "sense_id": "47e8cf30-6a92-345f-87a2-31909954893d",
                                "text": "Les gars de là-bas, on les retapisse rapide à leur bagoulette de ploucs, un cocktail de sons plus nasillards qu’à Paname, de déformations de mots, ils traînent sur les phrases."
                            }
                        ]
                    }
