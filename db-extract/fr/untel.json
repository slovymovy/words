                    {
                        "sense_id": "2f74a5b7-31c5-3a8f-a70b-b0c75eca25e3",
                        "entry_id": "64b9cb90-251f-3d61-9619-56e25d963170",
                        "glosses": [
                            "Désigne une personne dont on ne connait pas ou ne se souvient pas du nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bafaeeb0-65a7-4f8d-a00f-c1288d8c223a",
                                "sense_id": "2f74a5b7-31c5-3a8f-a70b-b0c75eca25e3",
                                "text": "Embrassades émues, tapes dans le dos, ça va, mon frère, hamdoullah, et ta mère, hamdoullah, et ta sœur, hamdoullah, ça va, ça va, grâce à Dieu, et la petit Narjis, ça pousse, hamdoullah, et le vieux Allal, Dieu ait son âme, ah bon ? ma cha’llah et le voisin Untel, on l’a pendu, et le chat, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "320d387b-ec68-4841-b855-b02ead605d99",
                        "source_entry_id": "64b9cb90-251f-3d61-9619-56e25d963170",
                        "source_sense_id": "2f74a5b7-31c5-3a8f-a70b-b0c75eca25e3",
                        "source_sense_description": "Nom propre arbitraire",
                        "target_lang_word": "Soundso",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soundso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3eded301-0d81-3a5e-beb3-5d8146706b1c",
                                        "entry_id": "f23178c2-2f06-3a07-8f6c-d211cf98b053",
                                        "glosses": [
                                            "wird stellvertretend benutzt für einen Namen, insbesondere Familiennamen, der unbekannt ist oder aus anderen Gründen nicht genannt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d72c2e0-f6a1-45df-9877-a18ca620166f",
                                                "sense_id": "3eded301-0d81-3a5e-beb3-5d8146706b1c",
                                                "text": "„Ich heiße Soundso, wohne im dritten Stock.“"
                                            },
                                            {
                                                "example_id": "d006780a-9bfe-47ba-b6b7-8f3989f50338",
                                                "sense_id": "3eded301-0d81-3a5e-beb3-5d8146706b1c",
                                                "text": "„Den da, den Soundso, den kannte er.“"
                                            },
                                            {
                                                "example_id": "77014b28-a78b-4507-9069-4f9975c37f4b",
                                                "sense_id": "3eded301-0d81-3a5e-beb3-5d8146706b1c",
                                                "text": "„Dem Soundso wird bescheinigt, erster Sieger im Langsamfahren gewesen zu sein.“"
                                            },
                                            {
                                                "example_id": "cecb04d8-c359-4e6f-be3a-a4743d49eb59",
                                                "sense_id": "3eded301-0d81-3a5e-beb3-5d8146706b1c",
                                                "text": "„Man sagt nicht Herr oder Frau Soundso, man sagt Chawer, das heißt Freund, und zu einer Frau sagt man Chawera, das heißt Freundin.“"
                                            },
                                            {
                                                "example_id": "715fe5be-4bc0-4a4a-8093-d92a4bac00e8",
                                                "sense_id": "3eded301-0d81-3a5e-beb3-5d8146706b1c",
                                                "text": "„‚Ja‘, sagte der Wachtmeister in empörtem Ton, ‚beim Pfarrer haben sie nachts die Obstbäume beschnitten. Und bei den Soundsos die Haustür von außen zugekettet! […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Soundso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f25c809d-801b-358a-8ebf-3d537dc979dd",
                                        "entry_id": "88d30981-b5af-32a4-be94-7b17c8523f80",
                                        "glosses": [
                                            "wird stellvertretend benutzt für einen Namen, insbesondere Familiennamen, der unbekannt ist oder aus anderen Gründen nicht genannt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97ca6928-32eb-42ad-9ac0-0a9309ecc017",
                                                "sense_id": "f25c809d-801b-358a-8ebf-3d537dc979dd",
                                                "text": "„Sehen Sie, da gab es mal ein Buch, von einer Amerikanerin, Betsy oder Dorothy oder Kathryn Soundso, aber der Name tut ja nichts, das Buch hieß ‚Das Ei und ich‘, war ein unerhörter Bestseller und handelte wirklich nur von Eiern und von dieser Betsy.“"
                                            },
                                            {
                                                "example_id": "8bc528ae-069b-4545-b9dd-4c59da74e70e",
                                                "sense_id": "f25c809d-801b-358a-8ebf-3d537dc979dd",
                                                "text": "„Der ‚Tiger‘ (‚Mein Vater verdient über 100 000 Dollar im Jahr‘) entfloh dem heimischen Wohlstand, weil er ‚den Schmus der alten Damen über Frau Soundsos prächtigen Sohn‘ nicht mehr hören konnte.“"
                                            },
                                            {
                                                "example_id": "0842f91f-d214-460a-93b6-ae2b155a1478",
                                                "sense_id": "f25c809d-801b-358a-8ebf-3d537dc979dd",
                                                "text": "„Man sagt nicht Herr oder Frau Soundso, man sagt Chawer, das heißt Freund, und zu einer Frau sagt man Chawera, das heißt Freundin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eccf3780-6d1c-4194-af71-342e73c861f5",
                        "source_entry_id": "64b9cb90-251f-3d61-9619-56e25d963170",
                        "source_sense_id": "2f74a5b7-31c5-3a8f-a70b-b0c75eca25e3",
                        "source_sense_description": "Nom propre arbitraire",
                        "target_lang_word": "Sowieso",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sowieso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d09c576-3162-330c-91df-aa933b65b32e",
                                        "entry_id": "3830f0df-3d15-32d7-978a-a280e2f4d675",
                                        "glosses": [
                                            "wird stellvertretend benutzt für einen Personennamen, insbesondere Familiennamen, der unbekannt ist oder aus anderen Gründen nicht genannt wird"
                                        ],
                                        "tags": [
                                            "zumeist mit vorangestelltem »Herr« und dergleichen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9610dfc0-0e36-4233-a44c-c629fed4ca17",
                                                "sense_id": "3d09c576-3162-330c-91df-aa933b65b32e",
                                                "text": "„Der Verleiher sagte: Da haben wir doch den Sowieso unter Vertrag, der muß die Hauptrolle spielen, und seine Partnerin, das ist natürlich die Sowieso.“"
                                            },
                                            {
                                                "example_id": "1d3f330b-9852-4b66-a204-68b70653bd65",
                                                "sense_id": "3d09c576-3162-330c-91df-aa933b65b32e",
                                                "text": "„Da die ‚Carrozzieri‘ nicht von den Aufträgen eines einzigen Autoherstellers leben können, passiert es, daß ein Kunde mit dem Vorwurf kommt: ‚Warum hast du dem Sowieso etwas Moderneres gemacht als mir?‘, und der Hinweis, daß jener Entwurf später entstanden sei, beschwichtigt nicht, wenn der Konkurrent rascher gearbeitet hat und eher mit dem jüngeren Typ herausgekommen ist als der Mäkler mit dem seinen.“"
                                            },
                                            {
                                                "example_id": "0dd96658-11a8-4068-b516-7047d403e977",
                                                "sense_id": "3d09c576-3162-330c-91df-aa933b65b32e",
                                                "text": "„Sie müssen unbedingt den Sowieso, die Sowieso kennenlernen!“"
                                            },
                                            {
                                                "example_id": "931682cc-4d40-4658-80ff-3bc9b6a75ef5",
                                                "sense_id": "3d09c576-3162-330c-91df-aa933b65b32e",
                                                "text": "„Vor allem aber gefällt Dreier die Idee des Adress-Services: ‚Dann können wir endlich helfen, wenn Ehemalige anrufen und sagen: Ich hab doch mal mit dem Sowieso studiert, wo steckt der jetzt?‘“"
                                            },
                                            {
                                                "example_id": "f76fb76a-dcf8-4c75-8768-4c55bc278c62",
                                                "sense_id": "3d09c576-3162-330c-91df-aa933b65b32e",
                                                "text": "„Mit Herrn oder Frau Sowieso dagegen wären wir bis zur Konferenz oder einem Abgabetermin kaum ins Gespräch gekommen. Es sei denn, ein besonders freudiges oder besonders unangehmes Ereignis hätte das nötig gemacht. ‚Ah, übrigens: Herzlichen Glückwunsch zum Geburtstag!‘ fand sich selbstverständlich im Repertoire der Sowiesos; […]“"
                                            },
                                            {
                                                "example_id": "3bab1b65-254b-409a-b88e-29c0b2b4aa3a",
                                                "sense_id": "3d09c576-3162-330c-91df-aa933b65b32e",
                                                "text": "„Man ertappt sich, dass man in den Figuren manchmal den Sowieso oder die Dingsda zu erkennen meint.“"
                                            },
                                            {
                                                "example_id": "3b01a800-e176-4d6e-97f1-b98f24038ed5",
                                                "sense_id": "3d09c576-3162-330c-91df-aa933b65b32e",
                                                "text": "„Der Sowieso, das ist ein außerordentlich interessanter Mann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sowieso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82e750c1-f07e-323e-bd6a-9413d2bd4d44",
                                        "entry_id": "0d4d82a8-05bf-33f7-8594-02dc73703e3c",
                                        "glosses": [
                                            "wird stellvertretend benutzt für einen Personennamen, insbesondere Familiennamen, der unbekannt ist oder aus anderen Gründen nicht genannt wird"
                                        ],
                                        "tags": [
                                            "zumeist mit vorangestelltem »Frau« und dergleichen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02531c3c-353f-46a5-bdaa-e3b8749272dc",
                                                "sense_id": "82e750c1-f07e-323e-bd6a-9413d2bd4d44",
                                                "text": "„Für die Hauptrolle ist die Sowieso ideal, phänomenal.“"
                                            },
                                            {
                                                "example_id": "9c8ebeda-9264-445a-8574-a78b3a017de0",
                                                "sense_id": "82e750c1-f07e-323e-bd6a-9413d2bd4d44",
                                                "text": "„Der Verleiher sagte: Da haben wir doch den Sowieso unter Vertrag, der muß die Hauptrolle spielen, und seine Partnerin, das ist natürlich die Sowieso.“"
                                            },
                                            {
                                                "example_id": "1b8d19fe-56ea-490f-aeee-dd2ea7e3e2c3",
                                                "sense_id": "82e750c1-f07e-323e-bd6a-9413d2bd4d44",
                                                "text": "„Sie müssen unbedingt den Sowieso, die Sowieso kennenlernen!“"
                                            },
                                            {
                                                "example_id": "389e5da9-71dc-41a9-af54-586795db4176",
                                                "sense_id": "82e750c1-f07e-323e-bd6a-9413d2bd4d44",
                                                "text": "„Gehen sie einmal ungeschminkt nur schnell zum Gemüseladen, heißt es gleich, hast du die Sowieso gesehen?“"
                                            },
                                            {
                                                "example_id": "3c4e4494-f584-41c6-b578-9b0cc795584e",
                                                "sense_id": "82e750c1-f07e-323e-bd6a-9413d2bd4d44",
                                                "text": "„Mit Herrn oder Frau Sowieso dagegen wären wir bis zur Konferenz oder einem Abgabetermin kaum ins Gespräch gekommen. Es sei denn, ein besonders freudiges oder besonders unangehmes Ereignis hätte das nötig gemacht. ‚Ah, übrigens: Herzlichen Glückwunsch zum Geburtstag!‘ fand sich selbstverständlich im Repertoire der Sowiesos; […]“"
                                            },
                                            {
                                                "example_id": "1735b25e-465d-4c51-900f-c01e8dbf45dc",
                                                "sense_id": "82e750c1-f07e-323e-bd6a-9413d2bd4d44",
                                                "text": "„Da kommt ein Mitbewohner im schwarzen Anzug, sagt mit Trauer in der Stimme, dass der oder die Sowieso aus dem Dorf gestorben ist und bittet im Namen der Angehörigen um den Besuch der Beerdigung, die dann und dort ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acfc1cdc-471a-4eeb-ac28-38d9cc11cd95",
