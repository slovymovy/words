                    {
                        "sense_id": "fd40d4ab-b334-32d0-9c83-b582592bc865",
                        "entry_id": "1d717cc2-ebe1-397d-8ba5-5607bdda60b0",
                        "glosses": [
                            "Genre d’insecte hémiptère suceur, semblable à une petite cigale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9c4ba2-576b-40ab-b686-8de0ab8bc90c",
                                "sense_id": "fd40d4ab-b334-32d0-9c83-b582592bc865",
                                "text": "La maladie du \"dragon jaune\" est transmise par un tout petit insecte, qu’on appelle un psylle."
                            },
                            {
                                "example_id": "294d522d-3b96-48b5-9ef1-1d242541f0c1",
                                "sense_id": "fd40d4ab-b334-32d0-9c83-b582592bc865",
                                "text": "La psylle a été ainsi appelée, à cause de la propriété de sauter qu'ont la plupart des espèces qui composent ce genre."
                            }
                        ]
                    }
                ],
