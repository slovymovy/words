                        ],
                        "form": "es ist windgepeitscht"
                    },
                    {
                        "form_id": "3529752b-f77a-4a51-ade8-0ecef487883a",
                        "entry_id": "2c089801-b859-325d-a785-bac58bab8ef4",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind windgepeitscht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0733549a-d297-35c1-ae3d-41711eeacd7f",
                        "entry_id": "2c089801-b859-325d-a785-bac58bab8ef4",
                        "glosses": [
                            "von Wind heftig bewegt, aufgewirbelt und/oder geschleudert werdend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135a8358-dcaf-4eeb-b8b8-eab5b3fc8b5f",
                                "sense_id": "0733549a-d297-35c1-ae3d-41711eeacd7f",
                                "text": "„Nicht ein Laut war zu hören, abgesehen von dem des windgepeitschten Holzes und des Meeres.“"
                            },
                            {
                                "example_id": "f1a4bba6-e7c5-43d1-9324-de3da0d54c4a",
                                "sense_id": "0733549a-d297-35c1-ae3d-41711eeacd7f",
                                "text": "„Ingels hetzte an den Backsteinhäusern und windgepeitschten Gärten mit ihren abgeknickten Blumen vorbei, hielt auf die geflickte Stelle in der Straße zu, an der, wie er wusste, früher eine Gaslaterne vor dem Theater Wache gehalten hatte.“"
                            },
                            {
                                "example_id": "8b1284da-43d3-4b2b-a589-60234d19accb",
                                "sense_id": "0733549a-d297-35c1-ae3d-41711eeacd7f",
                                "text": "„Eine Wüste umgibt das Anwesen, nicht viel mehr als ein felsiges, windgepeitschtes Ödland.“"
                            },
                            {
                                "example_id": "c091c257-1dd4-4844-bb2a-87f5c79640bc",
                                "sense_id": "0733549a-d297-35c1-ae3d-41711eeacd7f",
                                "text": "„An vielen Winternachmittagen, wenn das schwache Licht des Tages verblasste, beschatteten diese Aufpasser sie auf einsamen Farmfeldern, schlängelten sich zwischen den toten, windgepeitschten Maisstängeln hindurch, wenn sie von der Schule nach Hause trottete.“"
                            },
                            {
                                "example_id": "a8bfd8ee-2f4c-4125-87fb-f1267a4efe3c",
                                "sense_id": "0733549a-d297-35c1-ae3d-41711eeacd7f",
                                "text": "„Hoch loderten die Flammen, und Rauch stieg schwarz wie Gewitterwolken auf und rankte sich in windgepeitschten Säulen um Evaghs hohe Türme auf der Klippe.“"
