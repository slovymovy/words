                    {
                        "sense_id": "9239c9ea-749b-3548-b2b3-f3badf6ee652",
                        "entry_id": "f85a56ef-b0c1-3e50-9bda-474d98a69154",
                        "glosses": [
                            "iets door middel van strijd in bezit genomen hebben"
                        ],
