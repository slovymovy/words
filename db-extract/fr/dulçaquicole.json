                                "target_senses": [
                                    {
                                        "sense_id": "97c05331-f3ae-315f-b567-37272548d7a1",
                                        "entry_id": "5e70dbbc-a53c-3628-bdcc-09fbd72a06ce",
                                        "glosses": [
                                            "Living in fresh water."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1321521-c25b-420e-9f90-1d86b5a7878c",
                                                "sense_id": "97c05331-f3ae-315f-b567-37272548d7a1",
                                                "text": "The trout is a freshwater fish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "453d532a-aa2a-35f1-bab0-edfbaea9ea98",
                                        "entry_id": "5e70dbbc-a53c-3628-bdcc-09fbd72a06ce",
                                        "glosses": [
                                            "Consisting of fresh water."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2351de21-68b9-4581-ab19-1c90e401898f",
                                                "sense_id": "453d532a-aa2a-35f1-bab0-edfbaea9ea98",
                                                "text": "Lake Baikal is the world's largest freshwater lake in terms of volume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb334cf-cfdd-3616-8a3e-0756897bea80",
                                        "entry_id": "5e70dbbc-a53c-3628-bdcc-09fbd72a06ce",
                                        "glosses": [
                                            "Unskilled as a seaman."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74985db7-4e38-432d-97e7-efea23ecb490",
                                                "sense_id": "9eb334cf-cfdd-3616-8a3e-0756897bea80",
                                                "text": "“Mate,” said the captain in a low voice, “you talk like a fresh-water sailor. I can only attribute this shyness to some strange delusion, for surely,”—his voice assumed a slightly sneering tone as he said this—“surely I am not to suppose that you have become soft-hearted! […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d5dc22a-ee88-3e2a-912f-687b1e4ea618",
                                        "entry_id": "5e70dbbc-a53c-3628-bdcc-09fbd72a06ce",
                                        "glosses": [
                                            "neoclassical, in reference to U.S. macroeconomics and economics departments near the Great Lakes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63e95b66-91ee-4d9a-aca2-4698f597bb11",
                                                "sense_id": "7d5dc22a-ee88-3e2a-912f-687b1e4ea618",
                                                "text": "2012, John Quiggin, Zombie Economics: How Dead Ideas Still Walk Among Us, Princeton University Press (expanded paperback ed., 1st ed. from 2010), →ISBN, page 86.\nMeanwhile, the freshwater side of the dispute rapidly reverted to arguments from the nineteenth century, which had been debunked by Keynes and Irving Fisher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "freshwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                        "entry_id": "62133f73-cd62-38db-82f7-5c043b4642d7",
                                        "glosses": [
                                            "A body of fresh water"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f20015-3fd6-4ebf-bf29-4be608e82e14",
                                                "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                                "text": "Fossils with low Sr/Ca ratios indicating origin in a freshwater of a type which has a low Sr/Ca ratio: […]"
                                            },
                                            {
                                                "example_id": "122b19ae-b471-42cc-9e3f-1bd02f4194d0",
                                                "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                                "text": "Smith (1958) found that N. limnicola in Lake Merced, virtually a freshwater, had no paragnaths or at the most one on section I against the \"normal\" 1–2."
                                            },
                                            {
                                                "example_id": "60531192-2ca8-4879-acec-af9d5dcebd73",
                                                "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                                "text": "The chances of long-term preservation of fossils in freshwaters are minimal, for freshwaters are readily disturbed and destroyed by drought on the land masses."
                                            },
                                            {
                                                "example_id": "8e8e87f5-d937-43bd-aa6f-de5859305f40",
                                                "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                                "text": "Freshwaters are portrayed in many artforms, including books such as Kenneth Grahame's childrens'^([sic]) story Wind in the Willows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                        "entry_id": "62133f73-cd62-38db-82f7-5c043b4642d7",
                                        "glosses": [
                                            "Alternative spelling of fresh water."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be84f026-bc25-42c3-9efb-1946b9a79ccd",
                                                "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                                "text": "Schematic diagram of the viscosity effect during the injection of freshwater."
                                            },
                                            {
                                                "example_id": "62f8ddf8-7463-42bd-81b8-f01508f5903f",
                                                "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                                "text": "Above 200m, high-salinity water was being carried southward out of the Arabian Sea. This implies that most of the freshwater was imported into the Arabian Sea in the upper layer."
                                            },
                                            {
                                                "example_id": "8c47a784-6a43-44f2-bb78-7a142b3a98c4",
                                                "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                                "text": "Actual field data of Cl distribution in soil after irrigation with TWW and freshwater were obtained in a field experiment in Israel (Feigin et al., 2005; Fine et al. 2007)."
                                            },
                                            {
                                                "example_id": "7c1f1e09-175c-4435-b651-5d4ea1acb5f7",
                                                "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                                "text": "Alewives are anadromous fish: Born in freshwater, they spend their lives in the ocean, returning annually to their birthplaces to spawn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
