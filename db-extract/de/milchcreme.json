                    {
                        "sense_id": "84a4219f-4a76-34bd-ae56-4b47ac3011b7",
                        "entry_id": "68e10e3e-d40d-390e-8aef-bfa59ae9e88f",
                        "glosses": [
                            "aus verdickter Milch hergestellte süße Masse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56c302f3-6479-47b6-aff3-efb5a2f25083",
                                "sense_id": "84a4219f-4a76-34bd-ae56-4b47ac3011b7",
                                "text": "Die von Schokolade bezogenen Waffeln sind mit Milchcreme gefüllt."
                            },
                            {
                                "example_id": "78d636f9-b532-4c44-87dc-ed19198eec9f",
                                "sense_id": "84a4219f-4a76-34bd-ae56-4b47ac3011b7",
                                "text": "Bei beiden handelt es sich um gefüllte Schokoladekugeln - in einem Fall besteht die Füllung aus Brausegranulat in Milchcreme mit kandierten Orangenstückchen, im anderen Fall nur aus Milchcreme …"
                            },
                            {
                                "example_id": "453a041e-817a-403b-bb0b-8fa906392bb7",
                                "sense_id": "84a4219f-4a76-34bd-ae56-4b47ac3011b7",
                                "text": "Geh in die Küche, Mama, und bringe die Mädel in Ordnung, sonst werfen Sie dir den Braten in die Suppe, die Suppe in’s Gemüse, das Gemüse in die Milchcreme."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
