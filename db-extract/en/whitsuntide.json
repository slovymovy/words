                        "sense_id": "d808d8cf-c736-3ef8-9017-2edf9225f806",
                        "entry_id": "8dc310b7-10d7-36d9-a405-c9836bc4322c",
                        "glosses": [
                            "The week that begins with Whitsunday."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e9eb39c0-d8fa-47a3-b835-9e1efab9561d",
                                "sense_id": "d808d8cf-c736-3ef8-9017-2edf9225f806",
                                "text": "The third year he had a tailor staying with him before Whitsuntide, making new clothes for the holidays."
                            },
                            {
                                "example_id": "ed902710-04bd-42ce-912a-253604f889c5",
                                "sense_id": "d808d8cf-c736-3ef8-9017-2edf9225f806",
                                "text": "There are eight 4-wheel coaches of the open toastrack type, but provided with roofs, and during the holiday season, usually beginning at Whitsuntide, trains are run as required on the one-engine-in-steam principle."
                            },
                            {
                                "example_id": "eaec76f3-fd97-456f-b826-a6c9672f2047",
                                "sense_id": "d808d8cf-c736-3ef8-9017-2edf9225f806",
                                "text": "The museum purchased the photo album for £420 (about $515). […] The photo album is titled \"Reminiscences of a visit to Shaftesbury. Whitsuntide 1892. A present to Auntie from Ernest.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "703dfb88-bfaa-3a78-b426-efbeff30eab3",
