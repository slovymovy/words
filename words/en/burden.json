        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "afe44992-9362-3e95-ab74-d64d448c5e24",
                    "sense_definition": "To load someone or something heavily, either physically or with difficulties, responsibilities, or work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "load_responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not wish to <w>burden</w> you with my personal problems right now.",
                            "target_lang_translations": {
                                "ru": "Я не хочу сейчас <w>обременять</w> вас своими личными проблемами.",
                                "zh": "我现在不想拿自己的私人问题来<w>加重你的负担</w>。"
                            }
                        },
                        {
                            "text": "The company is <w>burdened</w> with a huge amount of debt from the merger.",
                            "target_lang_translations": {
                                "ru": "Компания <w>обременена</w> огромным долгом после слияния.",
                                "zh": "这家公司因合并而<w>背负</w>了巨额债务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "encumber",
                        "saddle",
                        "weigh down",
                        "load",
                        "oppress",
                        "tax"
                    ],
                    "antonyms": [
                        "unburden",
                        "relieve",
                        "lighten",
                        "free"
                    ],
                    "common_phrases": [
                        "burden someone with",
                        "be burdened with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно нагружать кого-либо или что-либо, физически или трудностями, обязанностями, работой.",
                        "zh": "使某人或某物承受沉重负荷，可指身体上的装载，也可指困难、责任或工作上的压担。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обременять",
                                "target_lang_sense_clarification": "доставлять хлопоты"
                            },
                            {
                                "target_lang_word": "отягощать",
                                "target_lang_sense_clarification": "делать тяжёлым"
                            },
                            {
                                "target_lang_word": "нагружать",
                                "target_lang_sense_clarification": "давать работу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加重负担",
                                "target_lang_sense_clarification": "使某人承担更多烦恼、责任或工作"
                            },
                            {
                                "target_lang_word": "背负",
                                "target_lang_sense_clarification": "使人承担沉重事物，如债务、责任"
                            },
                            {
                                "target_lang_word": "使负担过重",
                                "target_lang_sense_clarification": "较正式，指使人负担过重"
                            }
                        ]
                    }
                }
            ]
        },
        {
