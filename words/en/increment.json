{
    "word_family": [
        "incremental",
        "incrementally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a333b591-faa4-3c37-9060-a0686817407f",
                    "sense_definition": "The amount by which something increases.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was completed in small <w>increments</w> over several months.",
                            "target_lang_translations": {
                                "ru": "Проект был завершен небольшими <w>приростами</w> в течение нескольких месяцев."
                            }
                        },
                        {
                            "text": "The salary <w>increment</w> was much smaller than expected this year.",
                            "target_lang_translations": {
                                "ru": "В этом году <w>прибавка</w> к зарплате оказалась намного меньше, чем ожидалось."
                            }
                        }
                    ],
                    "synonyms": [
                        "addition",
                        "supplement"
                    ],
                    "antonyms": [
                        "decrement"
                    ],
                    "common_phrases": [
                        "salary increment",
                        "small increments"
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина, на которую что-либо увеличивается; прибавка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приро́ст",
                                "target_lang_sense_clarification": "увеличение количества или величины"
                            },
                            {
                                "target_lang_word": "приба́вка",
                                "target_lang_sense_clarification": "дополнительное количество чего-либо"
                            },
                            {
                                "target_lang_word": "шаг",
                                "target_lang_sense_clarification": "небольшая часть процесса увеличения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3143efdf-90b7-3601-9bce-36088267d653",
                    "sense_definition": "The process of becoming greater in size or quantity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steady <w>increment</w> of population growth requires better infrastructure.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>увеличение</w> численности населения требует улучшения инфраструктуры."
                            }
                        },
                        {
                            "text": "We observed a gradual <w>increment</w> in the temperature throughout the day.",
                            "target_lang_translations": {
                                "ru": "В течение дня мы наблюдали постепенное <w>повышение</w> температуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlargement",
                        "expansion"
                    ],
                    "antonyms": [
                        "decrement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс увеличения размера или количества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увеличе́ние",
                                "target_lang_sense_clarification": "общий процесс роста чего-либо"
                            },
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "процесс развития или количественного увеличения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8070487-df86-3afb-9e5e-ecbb077f4220",
                    "sense_definition": "Extra time added to a player's clock after each move in a game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chess tournament rules specify a three-second <w>increment</w> per move.",
                            "target_lang_translations": {
                                "ru": "Правила шахматного турнира предусматривают <w>добавление</w> трех секунд на каждый ход."
                            }
                        },
                        {
                            "text": "Players often rely on the <w>increment</w> to avoid running out of time.",
                            "target_lang_translations": {
                                "ru": "Игроки часто полагаются на <w>добавочное время</w>, чтобы не просрочить лимит."
                            }
                        }
                    ],
                    "common_phrases": [
                        "time increment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительное время, добавляемое к часам игрока после каждого хода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доба́вочное вре́мя",
                                "target_lang_sense_clarification": "время, прибавляемое в играх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76c2357b-f370-3990-a7ca-52cdc92a8032",
                    "sense_definition": "A rhetorical device involving the addition of words to build emphasis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker used <w>increment</w> to emphasize the importance of the virtues listed.",
                            "target_lang_translations": {
                                "ru": "Оратор использовал <w>градацию</w>, чтобы подчеркнуть важность перечисленных добродетелей."
                            }
                        },
                        {
                            "text": "Literary analysis shows how the author employs <w>increment</w> to create a powerful climax.",
                            "target_lang_translations": {
                                "ru": "Литературный анализ показывает, как автор использует <w>градацию</w> для создания мощной кульминации."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Риторический прием, заключающийся в добавлении слов для усиления выразительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "града́ция",
                                "target_lang_sense_clarification": "стилистическая фигура, усиливающая значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "499eb9d7-6fac-3339-a4e1-8ad4d2094a61",
                    "sense_definition": "A syllable added to a word form compared to its nominative singular.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Latin grammar, the <w>increment</w> often changes the stress pattern of the word.",
                            "target_lang_translations": {
                                "ru": "В латинской грамматике <w>нарост</w> часто меняет ударение в слове."
                            }
                        },
                        {
                            "text": "Students must identify the <w>increment</w> to correctly decline the noun.",
                            "target_lang_translations": {
                                "ru": "Студенты должны определить <w>нарост</w>, чтобы правильно просклонять существительное."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слог, добавляемый к основе слова при склонении или спряжении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наро́ст",
                                "target_lang_sense_clarification": "лингвистический термин для дополнительного слога"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8898f3b1-2656-3733-8cab-eaaf76f38514",
                    "sense_definition": "To increase a value by a specific amount, usually one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program will <w>increment</w> the counter after every successful loop.",
                            "target_lang_translations": {
                                "ru": "Программа будет <w>увеличивать</w> счетчик после каждого успешного цикла."
                            }
                        },
                        {
                            "text": "You need to <w>increment</w> the variable to track the total count.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>инкрементировать</w> переменную, чтобы отслеживать общее количество."
                            }
                        }
                    ],
                    "antonyms": [
                        "decrement"
                    ],
                    "common_phrases": [
                        "increment the value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличить значение переменной на определенную величину, обычно на единицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увеличи́ть",
                                "target_lang_sense_clarification": "сделать больше"
                            },
                            {
                                "target_lang_word": "инкременти́ровать",
                                "target_lang_sense_clarification": "технический термин в программировании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}