                        "entry_id": "41a7316d-4bbc-35d4-a943-86116ddb09e3",
                        "glosses": [
                            "een hinderlijk, ruisend geluid in het oor zonder dat er een uitwendige geluidsbron is dit dit geluid veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b71eed9-3c7e-486f-8ca2-5c31675f0402",
                                "sense_id": "e80c0fba-7e32-3337-8d7d-5ef9d00e4d5b",
                                "text": "De vrouw had haar man uitdrukkelijk verzocht haar te helpen. Zij wilde niet verder leven, na jarenlang te zijn gekweld door harde, pulserende oorsuizingen en overgevoeligheid voor geluid."
                            },
                            {
                                "example_id": "df9f46fd-a4d8-4484-b000-a325bf1bf43f",
                                "sense_id": "e80c0fba-7e32-3337-8d7d-5ef9d00e4d5b",
                                "text": "De 21-jarige Duitser kampt met vertigo, ook wel draaiduizeligheid genoemd. Die aandoening kan onder meer leiden tot hoofdpijn, gehoorverlies, misselijkheid of oorsuizingen."
                            }
                        ]
                    }
