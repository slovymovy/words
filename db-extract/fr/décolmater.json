                        "examples": [
                            {
                                "example_id": "156db5e9-e636-4d6e-8c7c-1a9ebf38e911",
                                "sense_id": "3da92047-39de-3e9c-ba84-c54dbf6a92b3",
                                "text": "On peut ainsi décolmater sur une très grande profondeur, mais il suffît habituellement d'un mètre ou deux."
                            },
                            {
                                "example_id": "773b0f4b-cc62-4e4c-b853-da3b712fbabf",
                                "sense_id": "3da92047-39de-3e9c-ba84-c54dbf6a92b3",
                                "text": "En effet, l'invasion de filtrat est facilitée dans une formation très perméable, le mud cake formé est plus épais et par conséquent l'effort pour décolmater doit être plus important."
                            }
                        ]
                    }
