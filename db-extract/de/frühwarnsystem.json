                ],
                "senses": [
                    {
                        "sense_id": "6937e171-14c9-35fc-8f27-6f357068585f",
                        "entry_id": "a914448d-e58b-387d-91b4-094218332a3b",
                        "glosses": [
                            "technische und organisatorische Maßnahmen, die zusammen ein System bilden, mit dem man bereits erste Anzeichen für einen zu erwartenden Ernstfall gemeldet bekommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e0d84a-439e-46a1-a486-a34d4b7f5cdd",
                                "sense_id": "6937e171-14c9-35fc-8f27-6f357068585f",
                                "text": "Die Auswirkungen des Tsunami vom 26.12.2004 waren so verheerend, weil es im Indischen Ozean kein ausreichendes Frühwarnsystem gab."
                            },
                            {
                                "example_id": "a343cc1e-ddbf-48e3-af2e-f6b37c44ec89",
                                "sense_id": "6937e171-14c9-35fc-8f27-6f357068585f",
                                "text": "„Ein weiterer Vorteil mobiler Trägerraketen ist darin zu sehen, dass sie weniger auf ein effektives Frühwarnsystem angewiesen sind als fixierte Raketen bzw. Raketen mit einer langen Startvorbereitungsphase.“"
                            },
                            {
                                "example_id": "b055c79f-fa0d-4789-9eba-08cc56c0c833",
                                "sense_id": "6937e171-14c9-35fc-8f27-6f357068585f",
                                "text": "Ein verpflichtendes Frühwarnsystem für Banken könnte für den Steuerzahler teure Bankenrettungen vermeiden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
