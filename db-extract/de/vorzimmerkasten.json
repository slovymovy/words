                ],
                "senses": [
                    {
                        "sense_id": "7b6af582-8639-3582-b15d-a87da194fa63",
                        "entry_id": "a23840ca-57c0-33ad-84bc-8d39f709a9b3",
                        "glosses": [
                            "großes hohes Möbelstück in einem Vorzimmer zur verschlossenen Aufbewahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "423a2284-b9ad-463d-97ce-f487becae7bb",
                                "sense_id": "7b6af582-8639-3582-b15d-a87da194fa63",
                                "text": "„Ich weiß nur, daß ich in dem Bewußtsein am Vorzimmerkasten gestanden bin, daß jederzeit die Tür aufgehen, Handwerker kommen und meine Ordnung zunichte machen könnten.“"
                            },
                            {
                                "example_id": "f46f34cf-ee8f-462c-b547-90105af457ac",
                                "sense_id": "7b6af582-8639-3582-b15d-a87da194fa63",
                                "text": "„Aus welchem Jahrzehnt stammt der Vorzimmerkasten?“"
                            },
                            {
                                "example_id": "8c7c37e4-1756-4823-bce1-532cb302045b",
                                "sense_id": "7b6af582-8639-3582-b15d-a87da194fa63",
                                "text": "„Ich habe es im Vorzimmerkasten entdeckt, eingewickelt in mehreren Bögen Packpapier.“"
                            },
                            {
                                "example_id": "d8fabe3e-eab0-4256-8c0c-7a41a8deee5b",
                                "sense_id": "7b6af582-8639-3582-b15d-a87da194fa63",
                                "text": "„Der verdammte Mistkerl hatte nicht einmal seine Tür zugesperrt, dachte Vince bitter, während er sich mit dröhnenden Kopfschmerzen und einer angeschlagenen Schulter am Vorzimmerkasten hochzog.“"
                            },
                            {
                                "example_id": "5cce07dd-e01e-493c-b43b-f791d9b58a73",
                                "sense_id": "7b6af582-8639-3582-b15d-a87da194fa63",
                                "text": "„Zu diesem Zweck wurde das kostbare Geschirr aus dem riesigen Vorzimmerkasten geholt, denn Vaters Kunden, Freunde und Bekannte sollten sich an dem fast schon aristokratisch zu nennenden Luxus freuen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
