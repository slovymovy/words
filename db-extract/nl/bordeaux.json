                        "cross_references": [
                            {
                                "target_word": "bordeaux",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a304d89-554b-3813-997f-52039736fe41",
                                        "entry_id": "af4182e4-f468-3043-b665-8a2116418fbf",
                                        "glosses": [
                                            "Alternative letter-case form of Bordeaux (“fungicide; wine”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df6a34da-cf32-4f31-8bbf-788f64d9dc3c",
                                                "sense_id": "2a304d89-554b-3813-997f-52039736fe41",
                                                "text": "Twelve fungicides; bordeaux mixture, strong, weak and with soap, bordeaux powder, modified eau celeste and ammoniacal copper carbonate, alone and with soap. As between the stronger and weaker bordeauxs an intermediate was [considered]."
                                            },
                                            {
                                                "example_id": "38eb23bd-a5f4-49ed-8e2d-9ba23e7ad321",
                                                "sense_id": "2a304d89-554b-3813-997f-52039736fe41",
                                                "text": "The bordeauxs seem to have been the most efficient fungicides, with the proprietary lime-sulfur mixtures a close second."
                                            },
                                            {
                                                "example_id": "9d572673-4e97-493c-b1fc-b958b8ec0fac",
                                                "sense_id": "2a304d89-554b-3813-997f-52039736fe41",
                                                "text": "If these commercial materials are used to make a bordeaux or a copper-lime mixture for grape sprays, [...]"
                                            },
                                            {
                                                "example_id": "64be0562-3d51-4c8e-8927-f8d78708a72c",
                                                "sense_id": "2a304d89-554b-3813-997f-52039736fe41",
                                                "text": "For under Charlemagne, in particular, this industry greatly expanded, as the wine masters of Gaul began to produce their own high quality burgandies and bordeauxes in the very regions in which those modern wines now derive their names."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
