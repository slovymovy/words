        "fr-extract.jsonl": [
            {
                "entry_id": "2a57d7da-d9bd-3b51-89a4-c4f2c09c560a",
                "word": "déconstructivisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fbc7cfa8-1d44-4b42-ad8e-e4b9b45c2b25",
                        "entry_id": "2a57d7da-d9bd-3b51-89a4-c4f2c09c560a",
                        "tags": [
                            "plural"
                        ],
                        "form": "déconstructivismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31d4f0a4-b941-3f4e-984f-f257efe97a93",
                        "entry_id": "2a57d7da-d9bd-3b51-89a4-c4f2c09c560a",
                        "glosses": [
                            "Mouvement artistique contemporain, parallèle mais différent du postmodernisme, qui a trouvé son nom dans celui du mouvement littéraire de la déconstruction de Derrida, et du mouvement du constructivisme russe des années 1920, dont il reprend certaines des inspirations formelles comme l’opposition à la rationalité ordonnée de l’architecture moderne, mais qui assume pleinement la rupture avec l’histoire, la société, le site, les traditions techniques et figuratives, au détriment de la vie sociale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b35e066-a198-446d-9ea1-9f38a2fe4366",
                                "sense_id": "31d4f0a4-b941-3f4e-984f-f257efe97a93",
                                "text": "Il serait impossible, enfin, de passer sous silence l’influence du déconstructivisme sur l’architecture iconique."
                            },
                            {
                                "example_id": "2da78848-f9d3-4217-9853-03734d2be441",
                                "sense_id": "31d4f0a4-b941-3f4e-984f-f257efe97a93",
                                "text": "Le déconstructivisme a émergé à la fin du XXᵉ siècle en réaction au modernisme et à l’architecture fonctionnaliste. Les architectes de ce mouvement ont remis en question les idées préconçues sur la forme et la fonction, et ont cherché à créer des structures qui défient les conventions architecturales traditionnelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11360016-33c0-4cb7-862b-03785c74beed",
                        "source_entry_id": "2a57d7da-d9bd-3b51-89a4-c4f2c09c560a",
                        "source_sense_id": "31d4f0a4-b941-3f4e-984f-f257efe97a93",
                        "target_lang_word": "Dekonstruktivismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dekonstruktivismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "739ab4d2-e094-3d6b-9f67-332450ff23e3",
                                        "entry_id": "b27ccc14-e33c-3bde-b657-1d86ae8c9f63",
                                        "glosses": [
                                            "kritisches Hinterfragen und Auflösen eines Textes im weiteren Sinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50860fd-ac93-4eea-a8f4-84624c487e11",
                                                "sense_id": "739ab4d2-e094-3d6b-9f67-332450ff23e3",
                                                "text": "„Neben Formalismus und Ideologiekritik betont auch der Dekonstruktivismus, dass Texte generell keinen Erkenntnisanspruch erheben können, weil sich Sprache als ein in sich geschlossenes System nicht auf die Welt beziehen könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f77c010-2f92-3272-b809-6aa54679d088",
                                        "entry_id": "b27ccc14-e33c-3bde-b657-1d86ae8c9f63",
                                        "glosses": [
                                            "eine architektonische Stilrichtung, die den Anspruch einer Ablösung der Postmoderne erhebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00035168-6d09-4ec7-9a7d-845b16631dd4",
                                                "sense_id": "5f77c010-2f92-3272-b809-6aa54679d088",
                                                "text": "„Der Dekonstruktivismus ist in seinen Intentionen und Wirkungen auf die Betrachter und Benutzer entsprechender Gebäude schwer einzuordnen; eindeutige zeittypische, gesellschaftskritische und sozialphilosophische Verortungen sind daher kaum möglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41599a3f-e71d-43aa-bf6e-79d7964f1580",
                        "source_entry_id": "2a57d7da-d9bd-3b51-89a4-c4f2c09c560a",
                        "source_sense_id": "31d4f0a4-b941-3f4e-984f-f257efe97a93",
                        "target_lang_word": "deconstructivism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deconstructivism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e29a95-13b9-3066-90ca-1ecdd90f616b",
                                        "entry_id": "06e0f69d-4354-3152-abc0-01dbfc3f3af7",
                                        "glosses": [
                                            "A development of postmodern architecture that began in the late 1980s, characterized by ideas of fragmentation, an interest in manipulating ideas of a structure's surface or skin, and non-rectilinear shapes which serve to distort and dislocate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc25ac4b-3cf3-45c2-b870-a3fd4cf3a684",
                                                "sense_id": "a9e29a95-13b9-3066-90ca-1ecdd90f616b",
                                                "text": "As an artist I have to ask: How much God is there in art theories like appropriation, deconstructivism, simulation and consumerism, which from the mid-1970s on have dominated the syllabus of many institutions that teach, critique and exhibit art?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da772819-ce80-3865-a813-ae5329350341",
                                        "entry_id": "06e0f69d-4354-3152-abc0-01dbfc3f3af7",
                                        "glosses": [
                                            "The practice of deconstructing dishes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
