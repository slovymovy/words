                ],
                "senses": [
                    {
                        "sense_id": "67dac52b-1e07-3899-ae02-f58dbe7daa6b",
                        "entry_id": "bf1faa6c-1386-3df9-b37a-206da8ddb3be",
                        "glosses": [
                            "Partir rapidement."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d9767ddc-89de-4392-af6e-11f938fa070b",
                                "sense_id": "67dac52b-1e07-3899-ae02-f58dbe7daa6b",
                                "text": "Ils avaient été obligés de se déhotter du plumard plus tôt qu’à l’accoutumée."
                            },
                            {
                                "example_id": "93bad0f2-63e1-49a7-b8dc-1854b4a64b46",
                                "sense_id": "67dac52b-1e07-3899-ae02-f58dbe7daa6b",
                                "text": "Gardé par deux hommes qui possèdent les meilleurs prétextes anodins en apparence, pour ne pas déhotter du coin."
                            },
                            {
                                "example_id": "2afc1d37-5a63-4bed-bc23-9e65ea4bd68b",
                                "sense_id": "67dac52b-1e07-3899-ae02-f58dbe7daa6b",
                                "text": "De temps à autre, un minuscule engin surgissait brusquement sous le nez de leur taxi, qui déhottait alors brusquement, sans que cela paraisse émouvoir le moins du monde le chauffeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1a5885c-bc03-33ca-8e9b-35d372b64558",
                        "entry_id": "bf1faa6c-1386-3df9-b37a-206da8ddb3be",
                        "glosses": [
                            "Chasser, faire partir."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4ee671c3-5aa8-4fd0-ae2e-e28108de2130",
                                "sense_id": "a1a5885c-bc03-33ca-8e9b-35d372b64558",
                                "text": "On se prélassait là jusqu’à la nuit… à moins qu’un orage, une ondée nous déhotte."
                            }
                        ]
                    }
                ],
