{
    "word_family": [
        "serfdom",
        "serf-like"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8cc75df6-8c39-3c3d-8ea9-6c5033c81ac8",
                    "sense_definition": "A person in a feudal system who is legally bound to work on land owned by a lord.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feudal_laborer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>serf</w> worked the fields from dawn until dusk for his master.",
                            "target_lang_translations": {
                                "zh": "那名<w>农奴</w>从黎明到黄昏都在为他的领主耕种田地。"
                            }
                        },
                        {
                            "text": "Life for a <w>serf</w> was defined by hard labor and very few personal rights.",
                            "target_lang_translations": {
                                "zh": "<w>农奴</w>的生活充满了繁重的劳作，几乎没有任何个人权利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peasant"
                    ],
                    "common_phrases": [
                        "feudal serf"
                    ],
                    "target_lang_definitions": {
                        "zh": "封建制度下依附于领主土地上的农业劳动者，人身自由受到严格限制"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "农奴",
                                "target_lang_sense_clarification": "封建制度下无人身自由的农业劳动者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48e5ad9d-0368-3971-b3ec-b4d6209a1644",
                    "sense_definition": "An agricultural laborer in historical Europe who lived under conditions similar to those of a feudal serf.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feudal_laborer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many a <w>serf</w> in the nineteenth century struggled to gain their freedom.",
                            "target_lang_translations": {
                                "zh": "十九世纪的许多<w>农奴</w>都曾为了获得自由而抗争。"
                            }
                        },
                        {
                            "text": "The history books describe the difficult life of the Russian <w>serf</w>.",
                            "target_lang_translations": {
                                "zh": "历史书描绘了俄罗斯<w>农奴</w>的艰难生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peasant"
                    ],
                    "target_lang_definitions": {
                        "zh": "欧洲历史上处境类似于封建农奴的农业劳工（如俄国农奴）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "农奴",
                                "target_lang_sense_clarification": "近代历史上依附领主的农业劳工"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dd33940-715e-3e5a-8234-f537de20f288",
                    "sense_definition": "A person who is forced to perform menial or repetitive labor for little reward.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "laborer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a <w>serf</w> in the office, doing the same boring tasks every day.",
                            "target_lang_translations": {
                                "zh": "他觉得自己就像办公室里的一个<w>苦工</w>，每天重复着同样枯燥乏味的工作。"
                            }
                        },
                        {
                            "text": "The modern <w>serf</w> is often trapped by debt and low wages.",
                            "target_lang_translations": {
                                "zh": "现代“<w>农奴</w>”往往被债务和微薄的工资所困。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peon"
                    ],
                    "target_lang_definitions": {
                        "zh": "被迫从事报酬微薄且单调繁重劳动的苦工或底层打工者"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "苦工",
                                "target_lang_sense_clarification": "从事繁重机械劳动的劳动者"
                            },
                            {
                                "target_lang_word": "奴隶",
                                "target_lang_sense_clarification": "比喻受严重剥削、缺乏自主权的人"
                            },
                            {
                                "target_lang_word": "农奴",
                                "target_lang_sense_clarification": "比喻底层受剥削的打工人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}