                ],
                "senses": [
                    {
                        "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                        "entry_id": "04c23e19-8672-3438-8274-100a5b43dca1",
                        "glosses": [
                            "waagerechter, länglicher Wandvorsprung über einem Kamin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27db0a67-2ed1-485f-a04a-a2be78f06f1a",
                                "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                "text": "„Er stand auf, nahm die Sanduhr vom Kaminsims, und drehte sie um.“"
                            },
                            {
                                "example_id": "300c114c-0b7c-4f7a-8891-ae7aba370ab4",
                                "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                "text": "„Die Urne bewahrte sie auf, stellte sie im Vorderzimmer auf den Kaminsims und füllte sie mit den langen Rispen des Strandhafers.“"
                            },
                            {
                                "example_id": "b9aff487-2a47-4947-9f57-a7a06e8cf27b",
                                "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                "text": "„Marie sprang herzu, ließ die halb Ohnmächtige in den Fauteuil nieder und griff nach dem Kölnischen Wasser, das auf dem Kaminsims stand.“"
                            },
                            {
                                "example_id": "a703b7b6-ba99-45d6-94fa-c69b31946187",
                                "sense_id": "5772075f-876f-3395-b72b-000f8cb1ec8c",
                                "text": "„Eine Anubis-Statue aus schwarzem Holz auf dem Kaminsims hat mich auf diesen abschweifenden Gedanken gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
