                        "glosses": [
                            "das Tätigsein als Seeräuber"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "264a5149-aedc-4eab-993e-001bb4c7797e",
                                "sense_id": "4ec7094b-4811-3c3c-90b6-ea610ea860c9",
                                "text": "Wegen jahrelanger Seeräuberei hatte man ihn zu wenigstens einhundert Peitschenhieben verurteilt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a1b7cda-641d-3ac0-a8a8-6d1ba9bad4e1",
                        "entry_id": "4e2e73b8-64b7-3462-8fff-1f1553649d84",
                        "glosses": [
                            "einzelne Handlung, sich fremdes Eigentum (ein Schiff und/oder dessen Fracht) auf See (gewaltsam) anzueignen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1978418e-416d-4d92-8fcd-56e9e09adaf6",
                                "sense_id": "4a1b7cda-641d-3ac0-a8a8-6d1ba9bad4e1",
                                "text": "Viele Seeräubereien bleiben auch heute noch ungesühnt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0a11134d-e4e2-3924-9f8a-2c6650d75010",
                        "entry_id": "4e2e73b8-64b7-3462-8fff-1f1553649d84",
                        "glosses": [
                            "Gesamtheit dessen, was mit [1] beziehungsweise [2] in Verbindung steht"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "cb189bb7-c70c-4405-b4f5-9555549f4aba",
                                "sense_id": "0a11134d-e4e2-3924-9f8a-2c6650d75010",
                                "text": "Die Anwesenden beschlossen einstimmig, künftig härter gegen die Seeräuberei vorzugehen."
                            }
                        ],
