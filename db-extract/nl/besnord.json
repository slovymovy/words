                                        "glosses": [
                                            "Having a moustache."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec43fc32-fee7-424c-af2d-6297f3fa4ff3",
                                                "sense_id": "c33edcc5-1cb5-3b80-b8b5-aabbab88d142",
                                                "text": "British military officers are usually moustached."
                                            },
                                            {
                                                "example_id": "f9053eb9-5b0a-40ab-a60c-6279f42b5655",
                                                "sense_id": "c33edcc5-1cb5-3b80-b8b5-aabbab88d142",
                                                "text": "[T]hey were baffled by tears in moustached sixth-formers, by walls of impassivity in the Lower School, by silent conspiracies which nullified the rules."
                                            },
                                            {
                                                "example_id": "4aff0818-e7f1-48d4-9884-f16902f20f7b",
                                                "sense_id": "c33edcc5-1cb5-3b80-b8b5-aabbab88d142",
                                                "text": "One of his best stories was \"Barney Oldfield's Race for a Life\" (1914), of which there survives only an amusing still, showing poor Mabel Normand chained to the rails by two toughs, the moustached villain threatening her with a sledge-hammer, and an awful sense of that inexorably approaching express!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
