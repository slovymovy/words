{
    "word_family": [
        "dust",
        "dusty",
        "dustbin",
        "dustpan"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec09ba03-f4b8-34f4-b75f-515d3a78f114",
                    "sense_definition": "A cloth or implement used for removing dust from surfaces.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She picked up a yellow <w>duster</w> to clean the wooden bookshelf.",
                            "target_lang_translations": {
                                "ru": "Она взяла жёлтую <w>тряпку</w>, чтобы протереть деревянный книжный шкаф."
                            }
                        },
                        {
                            "text": "I need a fresh yellow <w>duster</w> before I begin cleaning the living room furniture.",
                            "target_lang_translations": {
                                "ru": "Мне нужна свежая жёлтая <w>тряпка для пыли</w>, прежде чем я начну чистить мебель в гостиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "dustcloth"
                    ],
                    "common_phrases": [
                        "yellow duster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тряпка или приспособление для удаления пыли с поверхностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тряпка",
                                "target_lang_sense_clarification": "для удаления пыли"
                            },
                            {
                                "target_lang_word": "щётка",
                                "target_lang_sense_clarification": "для вытирания пыли"
                            },
                            {
                                "target_lang_word": "пипидастр",
                                "target_lang_sense_clarification": "метелка для пыли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f41115dc-9f68-30fc-a59c-e927f2c99f3c",
                    "sense_definition": "An eraser made of felt strips used for wiping chalk off a chalkboard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher used a heavy felt <w>duster</w> to clear the chalkboard.",
                            "target_lang_translations": {
                                "ru": "Учитель использовал тяжёлую войлочную <w>стиралку</w>, чтобы очистить школьную доску."
                            }
                        },
                        {
                            "text": "Please grab a blackboard <w>duster</w> and clean the board before the next lesson starts.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, возьми <w>тряпку для доски</w> и протри доску до начала следующего урока."
                            }
                        }
                    ],
                    "synonyms": [
                        "blackboard eraser"
                    ],
                    "common_phrases": [
                        "blackboard duster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Войлочная стиралка или губка для стирания мела с школьной доски."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиралка",
                                "target_lang_sense_clarification": "для школьной доски"
                            },
                            {
                                "target_lang_word": "тряпка",
                                "target_lang_sense_clarification": "для доски"
                            },
                            {
                                "target_lang_word": "губка",
                                "target_lang_sense_clarification": "для стирания мела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5a1db55-4c3d-3043-b80d-7b6cc0df330f",
                    "sense_definition": "A long, light, loose-fitting coat originally worn to protect clothing from dust.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a long leather <w>duster</w> while riding his motorcycle down the dusty road.",
                            "target_lang_translations": {
                                "ru": "На нём был длинный кожаный <w>пыльник</w>, когда он ехал на мотоцикле по пыльной дороге."
                            }
                        },
                        {
                            "text": "She wore a lightweight <w>duster</w> coat over her outfit to keep the wind away.",
                            "target_lang_translations": {
                                "ru": "Она накинула лёгкий <w>пыльник</w> поверх наряда, чтобы защититься от ветра."
                            }
                        }
                    ],
                    "synonyms": [
                        "duster coat"
                    ],
                    "common_phrases": [
                        "duster coat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинное лёгкое свободное пальто или плащ, защищающий одежду от пыли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пыльник",
                                "target_lang_sense_clarification": "лёгкий плащ или пальто"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65f34720-5c8b-3d8c-9672-8bf3d71b5fd5",
                    "sense_definition": "A person who removes dust or applies powder.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crop <w>duster</w> flew low over the cornfields early in the morning.",
                            "target_lang_translations": {
                                "ru": "<w>Самолёт-опылитель</w> пролетал низко над кукурузными полями ранним утром."
                            }
                        },
                        {
                            "text": "He worked as a crop <w>duster</w> for many years, flying low over vast fields.",
                            "target_lang_translations": {
                                "ru": "Он много лет работал <w>пилотом сельскохозяйственной авиации</w>, летая низко над бескрайними полями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crop duster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или машина, стирающая пыль или распыляющая порошок/удобрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уборщик",
                                "target_lang_sense_clarification": "вытирающий пыль"
                            },
                            {
                                "target_lang_word": "самолёт-опылитель",
                                "target_lang_sense_clarification": "сельскохозяйственная авиация (crop duster)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81d63e98-232f-320a-8a87-dd0d9417af28",
                    "sense_definition": "A loose-fitting dress worn casually at home.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She relaxed in her comfortable house <w>duster</w> all Sunday morning.",
                            "target_lang_translations": {
                                "ru": "Всё воскресное утро она отдыхала в своём удобном <w>домашнем халате</w>."
                            }
                        },
                        {
                            "text": "Her grandmother preferred wearing a cotton house <w>duster</w> while doing light chores.",
                            "target_lang_translations": {
                                "ru": "Её бабушка предпочитала носить хлопковое <w>домашнее платье</w>, выполняя несложную работу по дому."
                            }
                        }
                    ],
                    "synonyms": [
                        "housedress"
                    ],
                    "common_phrases": [
                        "house duster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободное домашнее платье или халат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домашнее платье",
                                "target_lang_sense_clarification": "свободная одежда для дома"
                            },
                            {
                                "target_lang_word": "халат",
                                "target_lang_sense_clarification": "легкий домашний халат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32865311-dc4d-3d59-a79a-a5c682539dd8",
                    "sense_definition": "A dry well that yields no oil or gas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company spent millions drilling the well, only to find it was a complete <w>duster</w>.",
                            "target_lang_translations": {
                                "ru": "Компания потратила миллионы на бурение скважины только для того, чтобы обнаружить, что она абсолютно <w>сухая</w>."
                            }
                        },
                        {
                            "text": "After weeks of work, the test well turned out to be a dry <w>duster</w>.",
                            "target_lang_translations": {
                                "ru": "После нескольких недель работы разведочная скважина оказалась <w>пустой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dry hole"
                    ],
                    "common_phrases": [
                        "dry duster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сухая скважина, не давшая нефти или газа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сухая скважина",
                                "target_lang_sense_clarification": "без нефти или газа"
                            },
                            {
                                "target_lang_word": "пустая скважина",
                                "target_lang_sense_clarification": "нерезультативная буровая скважина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3597036-13c8-3985-801c-bdac84fa60af",
                    "sense_definition": "A severe dust storm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The severe <w>duster</w> rolled across the plains, blotting out the sun.",
                            "target_lang_translations": {
                                "ru": "Сильная <w>пыльная буря</w> пронеслась по равнинам, затмевая солнце."
                            }
                        },
                        {
                            "text": "A sudden severe <w>duster</w> forced all vehicles off the highway until visibility returned.",
                            "target_lang_translations": {
                                "ru": "Внезапная мощная <w>пыльная буря</w> заставила весь транспорт съехать с шоссе, пока не вернулась видимость."
                            }
                        }
                    ],
                    "synonyms": [
                        "duststorm",
                        "sandstorm"
                    ],
                    "common_phrases": [
                        "severe duster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная пыльная буря."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пыльная буря",
                                "target_lang_sense_clarification": "сильный пылевой шторм"
                            },
                            {
                                "target_lang_word": "песчаная буря",
                                "target_lang_sense_clarification": "буря с пылью и песком"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}