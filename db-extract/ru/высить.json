                "senses": [
                    {
                        "sense_id": "7963afb4-0302-38c0-8f84-b6df06563ccc",
                        "entry_id": "8161c9e5-be21-3eb9-a912-509ed063cb3a",
                        "glosses": [
                            "подымать вверх"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca71568-3d32-4552-a540-63ca22f310da",
                                "sense_id": "7963afb4-0302-38c0-8f84-b6df06563ccc",
                                "text": "Наш громадный пароход неподвижно высит в небо свои мачты и трубы."
                            }
                        ]
                    },
                    {
                        "sense_id": "64209990-dd4a-3fc1-a2b3-833505ab353b",
                        "entry_id": "8161c9e5-be21-3eb9-a912-509ed063cb3a",
                        "glosses": [
                            "охотн. попадать выше цели (при стрельбе, метании и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9cfbaaf-1b7f-4999-a8d1-e857769902db",
                                "sense_id": "64209990-dd4a-3fc1-a2b3-833505ab353b",
                                "text": "У меня вот винтовка старая, высит очень."
                            }
                        ]
                    },
                    {
                        "sense_id": "34804574-724e-3087-9724-8663fcff39e3",
                        "entry_id": "8161c9e5-be21-3eb9-a912-509ed063cb3a",
                        "glosses": [
                            "церк.-слав. повышать, возвышать, возводить на высшую степень достоинства, почета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990d6e6f-6237-49f9-abf5-910e82bdbc9d",
                                "sense_id": "34804574-724e-3087-9724-8663fcff39e3",
                                "text": "Господь смиряет и высит, мертвит и живит, низводит во ад и возводит (1 Цар. 2, 7, 6)."
                            }
                        ]
                    }
