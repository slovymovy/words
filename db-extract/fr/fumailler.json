                ],
                "senses": [
                    {
                        "sense_id": "d482de77-8afe-3f17-8461-63db02fb8813",
                        "entry_id": "4fe01bc1-bde5-358d-a0f8-d9fce87fe7d9",
                        "glosses": [
                            "Fumer (un peu)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f2367d8-a4d2-47c1-a01f-a6c78773ea5e",
                                "sense_id": "d482de77-8afe-3f17-8461-63db02fb8813",
                                "text": "Quand je veux me chauffer un brin, je vais fumailler une pipe avec lui."
                            },
                            {
                                "example_id": "929e6cc5-8cf6-49e1-97d0-1757f3741653",
                                "sense_id": "d482de77-8afe-3f17-8461-63db02fb8813",
                                "text": "Et puis nous rentrions, plus que lents, par la route\nUn peu des écoliers, chez moi, chez nous plutôt,\nY déjeuner de rien, fumailler vite et tôt,\nEt dépêcher longtemps une vague besogne.\n Mon pauvre enfant, ta voix dans le Bois de Boulogne !"
                            },
                            {
                                "example_id": "ba53d794-338f-491a-afa1-be712d62fe00",
                                "sense_id": "d482de77-8afe-3f17-8461-63db02fb8813",
                                "text": "Au milieu de ma toilette, je me prenais à fumailler, à ouvrir un livre."
                            },
                            {
                                "example_id": "1c216bd7-8db4-4ee4-82b1-cc3505c35e07",
                                "sense_id": "d482de77-8afe-3f17-8461-63db02fb8813",
                                "text": "Lorsque Évelyne rentra, peu après 7 heures, elle trouva Dorgères dans la salle de bains, en train de feuilleter des revues de fesses tout en fumaillant un énorme cigare."
                            }
                        ]
                    }
                ],
