                    {
                        "sense_id": "5845c486-33a6-32a5-ba24-236bf1e5625d",
                        "entry_id": "f5b1d061-2578-3190-90d1-460716bf4310",
                        "glosses": [
                            "tobacco usage habit"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "54cba6c1-0d20-42ec-a494-b2ed8d0921ab",
                                "sense_id": "5845c486-33a6-32a5-ba24-236bf1e5625d",
                                "text": "Y.-M. D, \"Tabagisme passif infantile : les fumeurs pris par les cheveux\", Option/Bio, Volume 26, Issue 523 (March 2015), 10.\nLe tabagisme passif est un risque pour les enfants d’une maison où l’on fume quels que soient les fumeurs qu’ils côtoient.",
                                "translation": "Passive tobacco smoking is a risk for children from a house where people smoke, no matter who the smokers to whom they are close are.",
                                "english": "Passive tobacco smoking is a risk for children from a house where people smoke, no matter who the smokers to whom they are close are."
                            }
                        ]
                    },
                    {
                        "sense_id": "38758fee-bd04-3e9b-9dc1-459b7ee3f9d8",
                        "entry_id": "f5b1d061-2578-3190-90d1-460716bf4310",
                        "glosses": [
                            "nicotine addiction"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4cbc750f-65c6-4f92-892e-d168eaf4a88c",
                                "sense_id": "38758fee-bd04-3e9b-9dc1-459b7ee3f9d8",
                                "text": "D. Boussiron, \"Alcaloïdes du tabac, neurobiologie de la dépendance tabagique\", in Jean Perriot (ed.), Tabacologie et sevrage tabagique, 2003, 56.\nLe tabagisme est une dépendance, ce serait même un modèle d'addiction pure."
                            }
                        ]
                    }
                ],
