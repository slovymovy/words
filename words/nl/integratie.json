                                "target_lang_sense_clarification": "the process of being united"
                            },
                            {
                                "target_lang_word": "consolidation",
                                "target_lang_sense_clarification": "combining things into a single more effective whole"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66956924-60f3-3fe8-8bbe-de9e0904b8f7",
