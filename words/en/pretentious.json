{
    "word_family": [
        "pretend",
        "pretendedly",
        "pretender",
        "pretense",
        "pretension",
        "pretentiously",
        "pretentiousness",
        "unpretentious",
        "unpretentiously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46cd539f-e49f-317f-8fd0-966cbc4720a4",
                    "sense_definition": "Attempting to impress others by affecting greater importance, talent, culture, or wealth than is actually possessed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ostentatious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her evening dress was far more <w>pretentious</w> than comfortable for a casual gathering.",
                            "target_lang_translations": {
                                "zh": "在随意的聚会上，她的晚礼服显得过于<w>炫耀</w>，而且穿起来并不舒服。"
                            }
                        },
                        {
                            "text": "He tried to sound cultured by dropping French phrases, but everyone thought he was merely being <w>pretentious</w>.",
                            "target_lang_translations": {
                                "zh": "他时不时夹杂几句法语以显得有文化，但大家都觉得他只是在<w>做作</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affected",
                        "highfalutin",
                        "precious"
                    ],
                    "antonyms": [
                        "unpretentious",
                        "modest",
                        "natural",
                        "humble"
                    ],
                    "common_phrases": [
                        "pretentious nonsense",
                        "sound pretentious",
                        "a bit pretentious"
                    ],
                    "target_lang_definitions": {
                        "zh": "虚夸的，做作的；试图通过装出比实际更有才华、财富或文化来炫耀自己。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自命不凡的",
                                "target_lang_sense_clarification": "自以为高人一等、炫耀虚夸"
                            },
                            {
                                "target_lang_word": "做作的",
                                "target_lang_sense_clarification": "装模作样、矫揉造作"
                            },
                            {
                                "target_lang_word": "炫耀的",
                                "target_lang_sense_clarification": "爱出风头、虚张声势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c6576c7-003b-3f98-ba9b-7dc95ff409f8",
                    "sense_definition": "Characterized by an unwarranted claim to distinction, artistic depth, or grand importance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ostentatious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics dismissed the film as <w>pretentious</w> art house cinema with no real emotional substance.",
                            "target_lang_translations": {
                                "zh": "影评人对这部电影不屑一顾，认为它只是一部缺乏真实情感内核、<w>故作高深</w>的艺术片。"
                            }
                        },
                        {
                            "text": "The band's elaborate song titles seemed quite <w>pretentious</w> given how simple their lyrics actually were.",
                            "target_lang_translations": {
                                "zh": "鉴于歌词其实非常简单，该乐队那些精心构思的歌名显得相当<w>华而不实</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affected",
                        "stilted"
                    ],
                    "antonyms": [
                        "unpretentious",
                        "modest"
                    ],
                    "common_phrases": [
                        "pretentious dialogue",
                        "pretentious novel"
                    ],
                    "target_lang_definitions": {
                        "zh": "（作品、风格等）故作高深的，哗众取宠的；缺乏真正深度或价值却妄自尊大。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "故作高深的",
                                "target_lang_sense_clarification": "常形容艺术、言论等无实质内容却假装深奥"
                            },
                            {
                                "target_lang_word": "华而不实的",
                                "target_lang_sense_clarification": "形式夸张而缺乏实际内涵"
                            },
                            {
                                "target_lang_word": "假装有艺术品位的",
                                "target_lang_sense_clarification": "艺术作品自命不凡、附庸风雅"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}