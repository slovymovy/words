                    {
                        "translation_id": "fc314602-0f33-4549-bec8-17a1abcbb167",
                        "source_entry_id": "6e5247a7-8ca2-3180-b859-94e6a565a6ee",
                        "source_sense_id": "917e7055-34a9-3d72-8d3d-f4a9e95003ce",
