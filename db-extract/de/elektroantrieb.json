                ],
                "senses": [
                    {
                        "sense_id": "33b8ec79-e09c-31a9-9eb1-3df54fc14826",
                        "entry_id": "7e4254c8-eae3-3181-b3c5-1ba39a0e0d83",
                        "glosses": [
                            "Antrieb mit Elektromotor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a4b1ead-e48c-4106-bed5-18211495216d",
                                "sense_id": "33b8ec79-e09c-31a9-9eb1-3df54fc14826",
                                "text": "„Es ist ein BMW i3, das erste Fahrzeug, das der deutsche Automobilbauer ausschließlich mit Elektroantrieb anbietet.“"
                            },
                            {
                                "example_id": "26853040-c67a-4cf8-a388-0bee5a0dd7c6",
                                "sense_id": "33b8ec79-e09c-31a9-9eb1-3df54fc14826",
                                "text": "„Die Busse mit Elektroantrieb haben noch Schwächen, die Entwicklung hänge noch den Anforderungen hinterher, argumentieren die Wiener Linien. Und Wasserstoffbusse seien überhaupt noch nicht in Serienreife erhältlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
