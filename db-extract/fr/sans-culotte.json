        "fr-extract.jsonl": [
            {
                "entry_id": "74c344c0-bc6f-329f-bb26-43092ff83100",
                "word": "sans-culotte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b83c461-b887-4222-808c-1620ee080a55",
                        "entry_id": "74c344c0-bc6f-329f-bb26-43092ff83100",
                        "tags": [
                            "plural"
                        ],
                        "form": "sans-culottes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                        "entry_id": "74c344c0-bc6f-329f-bb26-43092ff83100",
                        "glosses": [
                            "Nom que se donnaient les révolutionnaires de 1793, qui portaient le pantalon au lieu de la culotte courte."
                        ],
                        "tags": [
                            "Histoire de France"
                        ],
                        "examples": [
                            {
                                "example_id": "ced95d01-3bb5-4e45-99d2-5d960155e42a",
                                "sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                                "text": "La Révolution ne convient qu’au peuple, aux hommes de toutes les conditions qui ont une âme pure et élevée, aux philosophes amis de l’humanité, aux sans-culottes, qui se sont, en France, parés avec fierté de ce titre, […]."
                            },
                            {
                                "example_id": "8b85e212-e21f-4eb2-81cf-0d768eaf71d8",
                                "sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                                "text": "Je courus vers l’angle de la place où j’avais entendu le cri, et je vis, à la lueur de la lune sortant d’un nuage, une femme qui se débattait au milieu d’une patrouille de sans-culottes."
                            },
                            {
                                "example_id": "112287c6-803f-4b1f-b704-0911bae7c1b0",
                                "sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                                "text": "— Citoyen substitut, dit-il, tu sais que depuis deux ans je conspire contre tes amis et que je suis l’auteur de l’écrit intitulé : Les Sans-culottes dévoilés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf4e4a2c-3e84-4f55-a876-7dd7fccfad69",
                        "source_entry_id": "74c344c0-bc6f-329f-bb26-43092ff83100",
                        "source_sense_id": "69c715ac-1024-3b44-bd68-50d113f44e6b",
                        "target_lang_word": "sans-culotte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans-culotte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56e3be18-8c03-35bc-947c-391706a89724",
                                        "entry_id": "94159e5b-b7ce-3a79-a23c-9b36dc38a3cc",
                                        "glosses": [
                                            "A plebeian Parisian, especially a lower-class republican during the French Revolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caebb052-c42e-4804-a271-74310273138b",
                                                "sense_id": "56e3be18-8c03-35bc-947c-391706a89724",
                                                "text": "One necessary fashion item for the dutiful sans-culotte, for example, was the red cap (bonnet rouge), which was alleged to recall the cap worn in Antiquity by emancipated slaves."
                                            },
                                            {
                                                "example_id": "b590f876-8efb-4b3d-a2b0-421633e125c8",
                                                "sense_id": "56e3be18-8c03-35bc-947c-391706a89724",
                                                "text": "More's sensational attacks on Paine's Rights of Man [...] were echoed in prints, mass-produced by Reeves's Association, which contrasted the happy condition of the English cottager to the brutalised domestic life of the Parisian sans-culotte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
