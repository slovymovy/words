    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d966e42-757e-3418-a073-f32c6ae6613b",
                    "sense_definition": "A bright green biennial herb used in cooking",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden is full of fresh <w>parsley</w>.",
                            "target_lang_translations": {
                                "ru": "В саду полно свежей <w>петрушки</w>."
                            }
                        },
                        {
                            "text": "She chopped some <w>parsley</w> to sprinkle over the soup.",
                            "target_lang_translations": {
                                "ru": "Она нарезала немного <w>петрушки</w>, чтобы посыпать суп."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fresh parsley",
                        "chopped parsley"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двулетнее травянистое растение, часто используемое в кулинарии как пряность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петру́шка",
                                "target_lang_sense_clarification": "ботаническое название растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4f02dd0-cba1-360b-a6cf-b15e8853f0f4",
                    "sense_definition": "The leaves of the parsley plant used as a culinary herb",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Garnish the dish with a little bit of <w>parsley</w>.",
                            "target_lang_translations": {
                                "ru": "Украсьте блюдо небольшим количеством <w>петрушки</w>."
                            }
                        },
                        {
                            "text": "The recipe calls for a handful of fresh <w>parsley</w>.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется горсть свежей <w>петрушки</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garnish with parsley"
                    ],
                    "target_lang_definitions": {
                        "ru": "Листья или корень растения, используемые в качестве приправы к блюдам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петру́шка",
                                "target_lang_sense_clarification": "кулинарная зелень или корень"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b973e4e5-876b-3962-94a8-152ace8450ba",
                    "sense_definition": "Any herb that looks similar to parsley",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cilantro is sometimes referred to as Chinese <w>parsley</w>.",
                            "target_lang_translations": {
                                "ru": "Кинзу иногда называют китайской <w>петрушкой</w>."
                            }
                        },
                        {
                            "text": "Chervil is often called French <w>parsley</w> because of its appearance.",
                            "target_lang_translations": {
                                "ru": "Кервель часто называют французской <w>петрушкой</w> из-за его внешнего вида."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, внешне напоминающее петрушку."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e05491a7-a6f6-3a8d-8cce-b5c88b917349",
                    "sense_definition": "To add parsley to food",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>parsley</w> the potatoes before serving them.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>посыпать картофель петрушкой</w> перед подачей."
                            }
                        },
                        {
                            "text": "It is common to <w>parsley</w> the fish to improve its presentation.",
                            "target_lang_translations": {
                                "ru": "Обычно рыбу <w>посыпают петрушкой</w> для улучшения внешнего вида."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять петрушку в блюдо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посыпать петрушкой",
                                "target_lang_sense_clarification": "добавлять зелень в блюдо"
                            }
                        ]
                    }
                }
            ]
        },
        {
