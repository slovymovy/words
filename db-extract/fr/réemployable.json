                    {
                        "sense_id": "8964cf39-48ba-32e1-8074-2ad3d16bc35a",
                        "entry_id": "aa89acc0-6f13-3fa6-a87f-7045fe7af7fa",
                        "glosses": [
                            "Réutilisable, que l’on peut employer de nouveau, qui trouve un nouvel emploi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c862e619-51eb-48ac-811e-7c5f0711c8e1",
                                "sense_id": "8964cf39-48ba-32e1-8074-2ad3d16bc35a",
                                "text": "Votre objectif ? Vendre les matériaux réemployables issus de vos chantiers de construction ou de déconstruction, ou en acquérir afin de les incorporer à votre prochain projet."
                            },
                            {
                                "example_id": "905fa358-b244-4d62-9993-38dd851e7abd",
                                "sense_id": "8964cf39-48ba-32e1-8074-2ad3d16bc35a",
                                "text": "On voulait promouvoir le vrac en vue de supprimer emballages et suremballages grâce à des contenants réemployables."
                            },
                            {
                                "example_id": "15c391e4-91ae-4042-9870-04f2b427de6c",
                                "sense_id": "8964cf39-48ba-32e1-8074-2ad3d16bc35a",
                                "text": "Les ouvriers se sont formés sur le chantier, non seulement à distinguer ce qui est recyclable ou réemployable de ce qui ne l’est pas (en fonction de la conformité des gabarits par exemple, de la qualité …) mais aussi à déconstruire soigneusement et en toute sécurité."
                            }
                        ]
                    }
                ],
