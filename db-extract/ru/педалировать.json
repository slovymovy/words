                                                "example_id": "ff037d8a-a924-49f8-a1c1-58fb6c4407a8",
                                                "sense_id": "e5254461-ba9c-3037-8136-22a2d9b522c2",
                                                "text": "I rubbed my hands together for warmth."
                                            },
