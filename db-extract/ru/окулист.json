                                "target_senses": [
                                    {
                                        "sense_id": "2831ddab-2351-3a5e-b84f-f3474d9c86eb",
                                        "entry_id": "581b9afb-2fe3-3f51-abaf-8274e38ce597",
                                        "glosses": [
                                            "lekarz specjalista zajmujący się rozpoznawaniem, profilaktyką i leczeniem chorób oczu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf6eb5e9-d790-4f4e-b45b-0ff69c066d9c",
                                                "sense_id": "2831ddab-2351-3a5e-b84f-f3474d9c86eb",
                                                "text": "Jutro idę do okulisty, bo ostatnio coraz słabiej widzę."
                                            }
