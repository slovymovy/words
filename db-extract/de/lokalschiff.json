                "senses": [
                    {
                        "sense_id": "82727859-d489-301b-9fd0-ec0dbaf9a19c",
                        "entry_id": "cc205b09-3f46-35aa-a6ea-4cc2c442dbfe",
                        "glosses": [
                            "Personenschiff für den Linienverkehr im Nahbereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe8fd58-a70c-479b-92e8-33020524ceff",
                                "sense_id": "82727859-d489-301b-9fd0-ec0dbaf9a19c",
                                "text": "„Im Jahre 1830 verkehrte bereits der Dampfer Franz I. zwischen Wien und Budapest. In den folgenden Jahrzehnten entwickelte sich die DDSG nach Bewältigung enormer nautischer Probleme bis 1880 zur größten Binnenreederei der Welt. Im Jahr 1889 wurden 1.615.850 Personen mit Passagierschiffen (im Vergleich zu 1.612.520 im Jahr 1888) und 155.400 Personen mit Überfuhr- und Lokalschiffen befördert.“"
                            },
                            {
                                "example_id": "a72ee9e5-1c77-40db-ae75-45a959bbe785",
                                "sense_id": "82727859-d489-301b-9fd0-ec0dbaf9a19c",
                                "text": "„Kurz danach im Januar 1942 wurden die Lokalschiffe \"Sørøy\" und \"Ingøy\" torpediert, und 18 Menschen sind dabei umgekommen. “"
                            },
                            {
                                "example_id": "31ba5dce-4d5c-454b-8043-650da33a1091",
                                "sense_id": "82727859-d489-301b-9fd0-ec0dbaf9a19c",
                                "text": "„Das Lokalschiff war durch Jahrzehnte das einzige öffentliche Verkehrsmittel am rechten Donauufer.“"
                            },
                            {
                                "example_id": "010d24f4-1506-4c02-936c-c9fc3ec70ee5",
                                "sense_id": "82727859-d489-301b-9fd0-ec0dbaf9a19c",
                                "text": "„1939 bestellt die Reederei VDS ein neues Lokalschiff für die Verbindung zwischen den Lofoten und den Vesterålen.“"
                            },
                            {
                                "example_id": "86dd6f90-f96a-4522-a420-cb01a62456ca",
                                "sense_id": "82727859-d489-301b-9fd0-ec0dbaf9a19c",
                                "text": "„In den meisten Fällen konnten die ortsansässigen Reedereien, die Flusskreuzfahrt- oder Lokalschiffe betreiben, für das Thema Trinkwasserhygiene von den Gesundheitsbehörden sensibilisiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
