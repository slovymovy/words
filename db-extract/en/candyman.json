                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dealer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "216e1049-c5fb-310c-a047-c97bc0a6ecdd",
                                        "entry_id": "1f18f092-fdfd-3988-ae33-76fd1f80c686",
                                        "glosses": [
                                            "Vendeur de drogue, de stupéfiants."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3bd6ef5-9520-49bc-9291-e633327d84c3",
                                                "sense_id": "216e1049-c5fb-310c-a047-c97bc0a6ecdd",
                                                "text": "À l’avenir, je ne prendrai que de la neige de qualité supérieure. J’y veillerai. Je ne remettrai jamais les pieds chez ce dealer de Brentwood. Jamais."
                                            },
                                            {
                                                "example_id": "e4ba589a-a918-4379-a1cf-6e969b06496a",
                                                "sense_id": "216e1049-c5fb-310c-a047-c97bc0a6ecdd",
                                                "text": "J’avais fait le poireau de neuf heures du matin jusqu’à dix heures, avant que l’autre bouffon de dealer s’amène. Je l’imaginais qui devait prendre son petit déj’ peinard pendant que je me pelais le jonc à l’attendre."
                                            },
                                            {
                                                "example_id": "eeb0db9b-5118-4f23-b784-8194e9aac34d",
                                                "sense_id": "216e1049-c5fb-310c-a047-c97bc0a6ecdd",
                                                "text": "Ce dernier connaissait en effet par cœur tout ce que La Réunion comptait de voyous et autres dealers. Et ce, du battant des lames au sommet des montagnes…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "522c3547-f1a0-362b-ac44-beaedc1f6558",
                                        "entry_id": "1f18f092-fdfd-3988-ae33-76fd1f80c686",
                                        "glosses": [
                                            "Joueur qui distribue les cartes."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f8e0b8-42d2-4758-a1b8-a1a0a4152dce",
                                                "sense_id": "522c3547-f1a0-362b-ac44-beaedc1f6558",
                                                "text": "Le dealer distribue les cartes une par une, dans le sens des aiguilles d'une montre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dealer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "365ff0ac-8ce6-3aa3-a169-2769cc52b2d9",
                                        "entry_id": "24d819e8-f25f-36db-9278-219cdf8da166",
                                        "glosses": [
                                            "Revendre de la drogue, de produits illicites ou dopants."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "169d0846-d63d-4fa8-9f27-77d08107fadc",
                                                "sense_id": "365ff0ac-8ce6-3aa3-a169-2769cc52b2d9",
                                                "text": "Le narrateur est un petit gars de 23 ans qui deale du shit sans grand succès, se fait bastonner, essaie d’exister […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca8c92b-b36c-31b1-90f5-f4c8621b140d",
                                        "entry_id": "24d819e8-f25f-36db-9278-219cdf8da166",
                                        "glosses": [
                                            "Négocier, marchander."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63216b7-6458-4fbf-b496-93156eb4ffbd",
                                                "sense_id": "2ca8c92b-b36c-31b1-90f5-f4c8621b140d",
                                                "text": "Il n’y a eu aucun conciliabule, aucun échange sur le fond, insiste encore Hayat. C’est bien mal me connaître que d’imaginer que l’on puisse « dealer » avec moi. Je considère, pour être tout à fait clair, que je dois pouvoir préserver mon indépendance de magistrat du siège, dans l’exercice de mes fonctions de chef de juridiction."
                                            },
                                            {
                                                "example_id": "0d54f482-7239-4f85-87e4-4d8fe86d0f5f",
                                                "sense_id": "2ca8c92b-b36c-31b1-90f5-f4c8621b140d",
                                                "text": "\"C’est différent, \"dealer\" avec des adultes qui savent qu’ils sont à la job qu’avec des jeunes qui veulent se prouver et aller chercher un contrat\", ajoute celle qui a aussi sondé à ce sujet sa consœur Alexandra Clarke, juge de ligne dans la Ligue de l’Ouest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
