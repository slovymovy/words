                                "target_senses": [
                                    {
                                        "sense_id": "66541e44-25b4-3b07-88ca-ae33d8956abe",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "The young of certain animals, chiefly large carnivorous mammals, including the bear, wolf, fox, lion and tiger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1448021-2f9e-4069-baa5-2650aae96006",
                                                "sense_id": "66541e44-25b4-3b07-88ca-ae33d8956abe",
                                                "text": "a Childe of Lacedemon suffered all his belly and gutts to be torne out by a Cubbe or young Foxe, which he had stolne, and kept close under his garment, rather then he would discover his theft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96bc4898-aeb7-311e-9220-5c21dad5b838",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "A child, especially an awkward, rude, ill-mannered boy."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07a0901-829e-46ee-b541-613165d412b3",
                                                "sense_id": "96bc4898-aeb7-311e-9220-5c21dad5b838",
                                                "text": "O, thou dissembling cub! what wilt thou be / When time hath sowed a grizzle on thy case?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7451d989-a0a8-349c-9b6d-3e1ad0726455",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "A young man who seeks relationships with older women, or \\\"cougars\\\"."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cf5ef45-4750-367a-a1d3-3239ee573016",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "A stall for cattle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c959ab3-db19-4039-9d45-c77f818000a8",
                                                "sense_id": "0cf5ef45-4750-367a-a1d3-3239ee573016",
                                                "text": "[...] I would rather have such a good mother in cub or kennel, than in my closet, or at my table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "934cba93-71a2-3067-ba79-55704ea91b7b",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "Synonym of cub reporter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab1b6e68-00ac-4712-a985-19421dccdfd1",
                                                "sense_id": "934cba93-71a2-3067-ba79-55704ea91b7b",
                                                "text": "Swain has interviewed 67 reporters on 16 metropolitan dailies in 10 cities — from cubs to veterans — who talk candidly […]"
                                            },
                                            {
                                                "example_id": "09d15bfb-4457-4557-9da5-2d3ea0e4fe38",
                                                "sense_id": "934cba93-71a2-3067-ba79-55704ea91b7b",
                                                "text": "[…] from competing publications and the editors of publications that might buy freelance material from cubs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1964bf6-77df-3f3a-b46d-4fcbc7783d1a",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "A furry character that is a child (i.e. under the age of adulthood)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7616ffcd-d87c-39ae-95b8-c4cc2ab5c345",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "Clipping of cub porn or cub art."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b422c9-ecdd-486b-a959-c3d7b95da997",
                                                "sense_id": "7616ffcd-d87c-39ae-95b8-c4cc2ab5c345",
                                                "text": "Ew, I didn't know he also drew cub..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "522e6a1f-a891-3683-8303-492264bfeb7d",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "A boy or young man."
                                        ],
                                        "tags": [
                                            "Northern-Ireland",
                                            "Ulster"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "181c04eb-1a55-4f32-ad83-6f83f497b6d1",
                                                "sense_id": "522e6a1f-a891-3683-8303-492264bfeb7d",
                                                "text": "A man who reared ten cubs and three cutties."
                                            },
                                            {
                                                "example_id": "446764af-1b47-46f1-adff-656588271ef2",
                                                "sense_id": "522e6a1f-a891-3683-8303-492264bfeb7d",
                                                "text": "The point of the example is educational, moral, and the moral qualities of the stories attracted Peter Flanagan who remembered them from childhood and told them to the cutties and cubs when he was, for them, a funny old man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40525a11-a31a-3d51-b015-26d37f360162",
                                        "entry_id": "e05d0345-2140-38fc-8a54-a2b02c1fbe43",
                                        "glosses": [
                                            "a younger (or younger-looking) \\\"bear\\\" type of man."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d906d372-217d-3cf0-86e4-cba5ada0a415",
                                        "entry_id": "6e6b4c0d-06ea-3f00-91ab-d85641ec339d",
                                        "glosses": [
                                            "To give birth to cubs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3fe2945-1e1d-3309-9146-7b05662debe5",
                                        "entry_id": "6e6b4c0d-06ea-3f00-91ab-d85641ec339d",
                                        "glosses": [
                                            "To hunt fox cubs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32e5c14-86ff-4552-a081-f8f4353f958c",
                                                "sense_id": "f3fe2945-1e1d-3309-9146-7b05662debe5",
                                                "text": "He knew that, only a few hours from London, the Hunt was cubbing over his ancestral and much-mortgaged acres, while his own horse ate its head off in a stable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c6e192a-45ed-324c-9b31-2a3a8610bbf9",
                                        "entry_id": "6e6b4c0d-06ea-3f00-91ab-d85641ec339d",
                                        "glosses": [
                                            "To shut up or confine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "628a17d0-2139-4e0f-8dd1-063eb42ca4a3",
                                                "sense_id": "8c6e192a-45ed-324c-9b31-2a3a8610bbf9",
                                                "text": "to fall from heaven to hell, to be cubbed up upon a sudden"
                                            }
                                        ]
