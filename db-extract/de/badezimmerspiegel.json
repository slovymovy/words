                "senses": [
                    {
                        "sense_id": "cfc6f31c-0f56-342a-bb3b-8335e87d76f0",
                        "entry_id": "5e61c58d-c9cf-3b26-9c7b-fe958a055e55",
                        "glosses": [
                            "Spiegel, der im Badezimmer angebracht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f4d1a54-7ad6-41d1-b96b-255fca08144c",
                                "sense_id": "cfc6f31c-0f56-342a-bb3b-8335e87d76f0",
                                "text": "„Überprüfe im Badezimmerspiegel deine Zähne.“"
                            },
                            {
                                "example_id": "2a0fd33e-29b3-4355-8b8b-f61e8d71cbfb",
                                "sense_id": "cfc6f31c-0f56-342a-bb3b-8335e87d76f0",
                                "text": "„Ja, wenn ich bisweilen vor dem Badezimmerspiegel versuche, dieses ironische Lächeln, das ich mir unterstelle, zustande zu bringen, gelingt es mir nicht.“"
                            },
                            {
                                "example_id": "800c55f5-61b6-4423-9fd5-d9af3667290b",
                                "sense_id": "cfc6f31c-0f56-342a-bb3b-8335e87d76f0",
                                "text": "„Der Onkel hatte festgestellt, daß sie nichts begreife, und sich in ihrem erschreckten Beisein vor dem Badezimmerspiegel das Gesicht mit Ölfarben bunt angemalt und das Haus verlassen.“"
                            },
                            {
                                "example_id": "96578b56-e229-4797-a7cf-d2fcb4f991e8",
                                "sense_id": "cfc6f31c-0f56-342a-bb3b-8335e87d76f0",
                                "text": "„Er nahm ein Bad und betrachtete im Badezimmerspiegel die Austrittswunde im unteren Teil seines Rückens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
