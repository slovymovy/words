                "senses": [
                    {
                        "sense_id": "00fa4df5-738c-3fe8-bfa9-642ed18de7e9",
                        "entry_id": "3083915e-75f7-3944-b905-3db39ad16cd2",
                        "glosses": [
                            "Wertzeichen für Postsendungen von Behörden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b713a87-d41e-4377-ad17-44205767f0a3",
                                "sense_id": "00fa4df5-738c-3fe8-bfa9-642ed18de7e9",
                                "text": "„Die ersten Dienstmarken der Welt kamen 1854 in Spanien zum Einsatz.“"
                            },
                            {
                                "example_id": "f183489d-33a7-490c-8d4b-969a2a35bb38",
                                "sense_id": "00fa4df5-738c-3fe8-bfa9-642ed18de7e9",
                                "text": "„Freimarken des Deutschen Reiches wurden ab 1. April 1902 benutzt, wobei auf eigene Freimarken verzichtet wurde, doch erschienen noch Dienstmarken bis das inzwischen zum Freistaat (November 1918 Abdankung des Königs) gewordene Württemberg am 1. April 1920 auf sein Postregal völlig verzichtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "021c4287-4927-30d1-b5a5-be69277de9eb",
                        "entry_id": "3083915e-75f7-3944-b905-3db39ad16cd2",
                        "glosses": [
                            "Gegenstand, mit dem sich zivile Beamte der Polizei ausweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5560ff45-3a58-48d2-8e29-727770c968bf",
                                "sense_id": "021c4287-4927-30d1-b5a5-be69277de9eb",
                                "text": "Würden Sie mir bitte mal Ihre Dienstmarke zeigen?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
