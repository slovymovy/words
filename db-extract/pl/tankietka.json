                "senses": [
                    {
                        "sense_id": "08b8d84a-4b28-3bd9-9380-b0f340d931f9",
                        "entry_id": "c4e47197-3d06-3ae4-8682-54649216802b",
                        "glosses": [
                            "mały, lekki czołg najczęściej bez wieży"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d4a784-0b38-480b-837d-9277646b3c2e",
                                "sense_id": "08b8d84a-4b28-3bd9-9380-b0f340d931f9",
                                "text": "Między Tygrysami, trochę z tyłu, za nimi, jeszcze zakryty dywanami, będzie ten mały czołg, ta mała tankietka – opancerzony wóz amunicyjny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
