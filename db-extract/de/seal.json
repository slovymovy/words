                "senses": [
                    {
                        "sense_id": "7749565a-04c9-3b4c-92df-352029b91e35",
                        "entry_id": "132a55e4-97bc-3fb9-9419-2ff9bf81abfc",
                        "glosses": [
                            "Mitglied der Spezialeinheit United States Navy SEALs der US-Marine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ab46b1-1f5c-4720-a0f0-ec2793b4b92b",
                                "sense_id": "7749565a-04c9-3b4c-92df-352029b91e35",
                                "text": "„Die Agenten von SOG holte man sich vorwiegend aus den Reihen von Deltas und SEALs.“"
                            },
                            {
                                "example_id": "42b100dd-c9dd-4918-83f6-cf119c238245",
                                "sense_id": "7749565a-04c9-3b4c-92df-352029b91e35",
                                "text": "„›Die Teams? Du warst ein SEAL?‹“"
                            },
                            {
                                "example_id": "9e799ae2-0e6b-425c-9205-d826339064a1",
                                "sense_id": "7749565a-04c9-3b4c-92df-352029b91e35",
                                "text": "„Doch wie die SEALs zu sagen pflegten: Der einzige leichte Tag war gestern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
