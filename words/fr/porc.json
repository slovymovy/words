            "senses": [
                {
                    "sense_id": "e5966c15-bba4-3d19-9e9b-d87f992adf12",
                    "sense_definition": "Mammifère omnivore domestique trapu, au museau terminé par un groin, élevé pour sa chair.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier gère un grand élevage de <w>porcs</w> dans sa propriété à la campagne."
                        },
                        {
                            "text": "Dans ce pré, plusieurs <w>porcs</w> se roulent paisiblement dans la boue sous le soleil."
                        }
                    ],
                    "synonyms": [
                        "cochon"
                    ],
                    "common_phrases": [
                        "élevage de porcs"
                    ]
                },
                {
                    "sense_id": "86740bc4-60e3-3e60-aeed-527a83c0e1aa",
                    "sense_definition": "Viande provenant de cet animal, consommée comme aliment.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma grand-mère prépare un délicieux rôti de <w>porc</w> avec des pommes de terre."
                        },
                        {
                            "text": "Certaines traditions culinaires interdisent formellement la consommation de viande de <w>porc</w>."
                        }
                    ],
                    "synonyms": [
                        "cochon"
                    ],
                    "common_phrases": [
                        "côtelette de porc",
                        "rôti de porc",
                        "viande de porc"
                    ]
                },
                {
                    "sense_id": "da1dde2a-9b1c-333e-88d4-0f9395888371",
                    "sense_definition": "Personne particulièrement sale, malpropre, grossière ou excessivement gloutonne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de manger comme un <w>porc</w> et utilise ta serviette pour t'essuyer."
                        },
                        {
                            "text": "Sa chambre est tellement en désordre qu'il vit véritablement comme un <w>porc</w>."
                        }
                    ],
                    "synonyms": [
                        "cochon"
                    ],
                    "common_phrases": [
                        "manger comme un porc"
                    ],
