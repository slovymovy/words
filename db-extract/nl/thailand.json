                    {
                        "translation_id": "eb33fce8-e9e8-43e2-bd22-5b2b95f6b273",
                        "source_entry_id": "e1fec76f-3b87-3645-91d8-3b5a080246a5",
                        "source_sense_id": "8d7dc1fe-1ecf-39de-8230-039c135b7e93",
                        "source_sense_description": "een land in Azië dat vroeger Siam heette",
                        "target_lang_word": "Thailand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thailand",
