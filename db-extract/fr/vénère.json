                    {
                        "translation_id": "7b8ead23-b385-4811-997a-2827231115f2",
                        "source_entry_id": "fc0f9063-86cc-3eff-b1ec-dd574bec8cae",
                        "source_sense_id": "6c18e80c-5df8-3bc7-895e-21d43cef7033",
                        "source_sense_description": "umgangssprachlich: genervt, angepisst, sauer, verärgert",
                        "target_lang_word": "verärgert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verärgert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14eacb3a-8705-301c-a7ab-61d5b77525e9",
                                        "entry_id": "b77e9062-2a3a-3a95-9edc-5bc9a9163900",
                                        "glosses": [
                                            "als Person Ärger empfindend, beispielsweise wegen jemandes Äußerungen oder Benehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a776f81-f18b-4ca1-a718-ed76e56a2f57",
                                                "sense_id": "14eacb3a-8705-301c-a7ab-61d5b77525e9",
                                                "text": "„Ich bin sehr verärgert wegen deiner erneuten Verspätung!“"
                                            },
                                            {
                                                "example_id": "207cb411-999e-4f64-bd4c-8b6fd8c99b68",
                                                "sense_id": "14eacb3a-8705-301c-a7ab-61d5b77525e9",
                                                "text": "„Verärgerte Kunden kann man durch guten Service, Freundlichkeit, Glaubwürdigkeit und natürlich gute Produkte vermeiden.“"
                                            },
                                            {
                                                "example_id": "c0fb1934-79c4-42e0-8c71-4ddf998539fd",
                                                "sense_id": "14eacb3a-8705-301c-a7ab-61d5b77525e9",
                                                "text": "Mehrere sichtlich verärgerte und geschockte Angehörige der verunglückten Germanwings-Maschine haben sich Dienstagmittag am Flughafen El Prat in Barcelona eingefunden."
                                            },
                                            {
                                                "example_id": "38415863-6f0e-4c73-925d-b6c414e70e77",
                                                "sense_id": "14eacb3a-8705-301c-a7ab-61d5b77525e9",
                                                "text": "\"Unser Team ist im Halbschlaf\", murmelte ein verärgerter Fan auf der Tribüne Mitte der zweiten Halbzeit des Testspiels gegen Australien."
                                            },
                                            {
                                                "example_id": "a04e052e-34c9-496a-bcf1-4dd7ee1bf623",
                                                "sense_id": "14eacb3a-8705-301c-a7ab-61d5b77525e9",
                                                "text": "„Sie waren sichtlich enttäuscht und verärgert, dass wir vor ihnen „ihre“ Route [hoch auf den Hagshu] erklommen hatten“, schreibt Prezelj in seinem Expeditionsbericht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
