                "senses": [
                    {
                        "sense_id": "8ee8f8d3-c80a-3f6e-a102-72efe012b67b",
                        "entry_id": "c49aebf1-60a4-3618-986c-5a1f726e3248",
                        "glosses": [
                            "familiengeführtes Gut; Ländereien, die von einer Familie bewirtschaftet und genutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ccffe6-2bf8-4c2d-906b-0bfe0ba76a6b",
                                "sense_id": "8ee8f8d3-c80a-3f6e-a102-72efe012b67b",
                                "text": "„Gemeinsam mit seinem Bruder saniert er das heruntergewirtschaftete pommersche Familiengut, nach dem Tod des Vaters siedelt er 1846 nach Schönhausen über.“"
                            },
                            {
                                "example_id": "45d36ba8-3ccf-441d-ab29-002a2dd90ff0",
                                "sense_id": "8ee8f8d3-c80a-3f6e-a102-72efe012b67b",
                                "text": "„Ich suchte Kontakt zu Menschen, die noch Erinnerungen an Götzlack und Kukehnen hatten, den beiden Familiengütern südlich von Königsberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
