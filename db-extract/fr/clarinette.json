                                        "entry_id": "8190c5a9-ea2c-3d07-aad7-6fc7f60491dd",
                                        "glosses": [
                                            "Holzblasinstrument mit zylindrischer Bohrung und einem einfachen Rohrblatt-Mundstück"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c23c526-2aa2-4f8a-975b-9021a2ed9969",
                                                "sense_id": "6014a9be-cf09-380e-80a4-9f9017ff5e6e",
                                                "text": "Sie spielt sehr gut Klarinette."
                                            },
                                            {
                                                "example_id": "758204bb-187f-425b-9fc6-dce7bad35e11",
                                                "sense_id": "6014a9be-cf09-380e-80a4-9f9017ff5e6e",
                                                "text": "„Und wo Hoffmann in einem Brief an Hippel die Flöten, Klarinetten und Jagdhörner erwähnt, die in der Silvesternacht vom Turm herabschallen, ist es wiederum ihr Echo, das ihn über die Jahre hinweg erreicht, die ihn von der Kindheit trennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
