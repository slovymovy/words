                "senses": [
                    {
                        "sense_id": "5f11d02f-bc09-33b3-9f7e-25c807ede9d3",
                        "entry_id": "7fe6b104-61d2-30a4-b6a3-6ba1b3b04db4",
                        "glosses": [
                            "Faire perdre son caractère iranien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ae9dc0-b9ee-4553-bdcf-a29e1c22e5f3",
                                "sense_id": "5f11d02f-bc09-33b3-9f7e-25c807ede9d3",
                                "text": "De même en Perse, les successives conquêtes turques n'avaient pu désiraniser le pays, pourtant d'assez faible densité démographique, parce que les conquérants ne représentaient jamais que des clans turcomans peu nombreux."
                            },
                            {
                                "example_id": "e8a55492-faf1-4972-8265-c6b66f9859e1",
                                "sense_id": "5f11d02f-bc09-33b3-9f7e-25c807ede9d3",
                                "text": "L’administration mésopotamienne mit quatre siècles à se désiraniser (assiette cadastrale de l’impôt : les 12 aslân et les 60 tassoûdj)."
                            }
                        ]
                    }
