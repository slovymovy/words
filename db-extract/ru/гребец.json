                                    {
                                        "sense_id": "809cfe02-daf8-3464-9deb-519e65c1f76c",
                                        "entry_id": "9683a646-c311-3e89-be34-01a097e00498",
                                        "glosses": [
                                            "Plus généralement, personne qui se déplace en canot ou dans une autre embarcation propulsée à la pagaie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc1dd0d-364b-4555-b9f5-6388772baa44",
                                                "sense_id": "809cfe02-daf8-3464-9deb-519e65c1f76c",
                                                "text": "Et, dès le XVIIᵉ siècle, les rivières de l'Outaouais, servant de voie aux explorateurs, coureurs des bois et draveurs, ont retenti des chants des pagayeurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
