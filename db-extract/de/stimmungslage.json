                        "glosses": [
                            "Art der Stimmung, in der sich jemand befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37538bef-4798-413b-b540-121161669119",
                                "sense_id": "a4da260a-5613-3a72-902a-8234561d6286",
                                "text": "„Das Jahr endet in dieser Stimmungslage.“"
                            },
                            {
                                "example_id": "6c3f3153-206d-467f-be91-4edf75ad9b98",
                                "sense_id": "a4da260a-5613-3a72-902a-8234561d6286",
                                "text": "„Der säkular lebende Agnostiker unserer Zeit gibt sich je nach momentaner Stimmungslage erleichtert oder frustriert damit zufrieden, zu wissen, dass er nicht weiß, ob es Gott gibt.“"
                            }
                        ],
