                                        "sense_id": "5c2d3237-85c9-3301-8458-faa4a2845410",
                                        "entry_id": "157fcfec-3f19-3d89-9e0b-c43cd8cdeac9",
                                        "glosses": [
                                            "Used in reply to a spiteful or catty comment."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff863799-5a2b-3b3d-bc07-bf0b7b93fd6c",
                                        "entry_id": "157fcfec-3f19-3d89-9e0b-c43cd8cdeac9",
                                        "glosses": [
                                            "Used to express seductiveness, mimicking a growl."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
