                ],
                "senses": [
                    {
                        "sense_id": "032723c7-fe87-3db9-9d74-3144b0e6ee98",
                        "entry_id": "a492b4f8-6053-3bca-8978-76cfb6d88a45",
                        "glosses": [
                            "op drama betrekking hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cbe4c9c-6bcf-49e3-8451-57bc19947733",
                                "sense_id": "032723c7-fe87-3db9-9d74-3144b0e6ee98",
                                "text": "Haar dramatische expressie was buitengewoon indrukwekkend."
                            }
                        ]
                    },
                    {
                        "sense_id": "3359a732-db44-30a1-a4bb-70e9b4bc5d45",
                        "entry_id": "a492b4f8-6053-3bca-8978-76cfb6d88a45",
                        "glosses": [
                            "bijzonder indrukwekkend, schokkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e241b593-9f87-44c1-9fd2-3714963a9e80",
                                "sense_id": "3359a732-db44-30a1-a4bb-70e9b4bc5d45",
                                "text": "De toename van het aantal nieuwe banen in maart is dramatisch te noemen."
                            },
                            {
                                "example_id": "4d35f8c8-d452-41dc-8d3d-88375d9bed17",
                                "sense_id": "3359a732-db44-30a1-a4bb-70e9b4bc5d45",
                                "text": "De dramatische afname van de economische activiteit leidde tot een toename van het aantal zelfmoorden."
                            },
                            {
                                "example_id": "370f7d69-5e42-4e04-a946-6fa192b478d1",
                                "sense_id": "3359a732-db44-30a1-a4bb-70e9b4bc5d45",
                                "text": "De opwarming van de oceanen naar recordtemperaturen heeft het afgelopen jaar tot een dramatische verbleking van de koraalriffen in de oceanen geleid. Wereldwijd lijdt 84 procent van de riffen onder hittestress, meer dan ooit eerder is vastgesteld, blijkt uit onderzoek van landen en gespecialiseerde organisaties in het International Coral Reef Initiative."
                            }
                        ]
                    },
                    {
                        "sense_id": "705e4d1c-fae1-3b4d-aace-3abe0da2e5d1",
                        "entry_id": "a492b4f8-6053-3bca-8978-76cfb6d88a45",
                        "glosses": [
                            "aanstellerig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec57e49e-c146-457c-aa67-81191d021d57",
                                "sense_id": "705e4d1c-fae1-3b4d-aace-3abe0da2e5d1",
                                "text": "Voor het kind waren die dramatische woedeaanvallen een middel om aandacht te krijgen van zijn familieleden."
                            },
                            {
                                "example_id": "a8ee9f26-e2e7-443b-ab5a-2f4574c1587f",
                                "sense_id": "705e4d1c-fae1-3b4d-aace-3abe0da2e5d1",
                                "text": "De voetballer ging dramatisch neer binnen het strafschopgebied, maar de scheidsrechter trapte er niet in."
                            }
                        ]
                    }
                ],
