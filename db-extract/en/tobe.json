                        "glosses": [
                            "A cotton garment worn in parts of northern Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0c9f1eb-fdce-45d1-a5ea-9d9becd59d1a",
                                "sense_id": "69f733de-23a2-32e4-8413-1dd5fbb6f457",
                                "text": "It consists, for men and women alike, of a ‘tobe,’ or straight piece of cotton cloth (printed, or white with a crimson border), two breadths wide, and some twelve feet long, draped in graceful folds about the body, and fastened on the left shoulder."
                            },
                            {
                                "example_id": "e647addf-add0-48ef-9b21-91d19f4638d6",
                                "sense_id": "69f733de-23a2-32e4-8413-1dd5fbb6f457",
                                "text": "She loved travelling to Egypt, and how she didn’t have to wear a tobe in Cairo."
                            }
                        ]
