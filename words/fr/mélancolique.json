                        "humeur mélancolique"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a2ffdcc-bcf7-3902-85af-c5f42b525ba9",
                    "sense_definition": "Personne qui est atteinte de mélancolie ou d'un abattement profond.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin observe attentivement le <w>mélancolique</w> pour comprendre l'origine de son profond désespoir."
                        },
                        {
                            "text": "Ces poètes romantiques se voyaient souvent comme des <w>mélancoliques</w> incompris par le reste du monde."
