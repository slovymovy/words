        "nl-extract.jsonl": [
            {
                "entry_id": "068f87d4-37c6-3b54-baec-3d7dc56df918",
                "word": "getob",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3a19e17-88b8-3ead-ad76-596dadb3d92f",
                        "entry_id": "068f87d4-37c6-3b54-baec-3d7dc56df918",
                        "glosses": [
                            "langdurig bezorgd zijn over en vergeefs oplossingen zoeken voor een probleem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a36885c7-fab4-434e-9531-36d5987292d6",
                                "sense_id": "c3a19e17-88b8-3ead-ad76-596dadb3d92f",
                                "text": "In zijn brief aan de PvdA-achterban schetst Samsom dat de idealen van de PvdA niets aan betekenis hebben ingeboet, maar als die niet vertaald worden in heldere keuzes er alleen getob over de koers overblijft. Onder de keuzes die hij met de PvdA wil maken, vallen onder meer het openbreken van de arbeidsmarkt voor gehandicapten, het omvormen van de hypotheekrenteaftrek en investeringen in duurzame energie."
                            },
                            {
                                "example_id": "8118d5cf-2780-4ac5-8ad2-b27851abb8e3",
                                "sense_id": "c3a19e17-88b8-3ead-ad76-596dadb3d92f",
                                "text": "De olympisch kampioen op de 10 kilometer moest in de laatste rit het antwoord schuldig blijven op Pedersen. Die reed, ondanks getob met een bandje om zijn arm, naar een winnende tijd van 6.22,15."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "babb1050-0863-47d9-bc63-007f438a25db",
                        "source_entry_id": "068f87d4-37c6-3b54-baec-3d7dc56df918",
                        "source_sense_id": "c3a19e17-88b8-3ead-ad76-596dadb3d92f",
                        "target_lang_word": "worrying",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worrying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7f70d6-f5f3-3b3c-a796-9da0b6a1ea7a",
                                        "entry_id": "3e6c487e-b8d8-351a-9825-d03577209bc7",
                                        "glosses": [
                                            "Inducing worry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2443d5cc-e2e0-4a43-8aac-66c5f9a24a9e",
                                                "sense_id": "7e7f70d6-f5f3-3b3c-a796-9da0b6a1ea7a",
                                                "text": "Moldova did give England's under-employed keeper Joe Hart a worrying moment when Igor Armas sent a free header wide but otherwise it was an easy night."
                                            },
                                            {
                                                "example_id": "457b784a-9bfb-4b48-bf53-22169fd387fb",
                                                "sense_id": "7e7f70d6-f5f3-3b3c-a796-9da0b6a1ea7a",
                                                "text": "Redundancies accounted for a smaller proportion of the change, although no less significant to those affected. Rail News, BR's staff magazine, included a coda to its August 1964 assessment of the Beeching cuts: \"For the individuals involved it is a worrying time [...] Rail News feels deeply for those affected and expresses the sympathy of its readers with them.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "worrying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb029c27-5f78-3591-aa2b-3ec707ecd66e",
                                        "entry_id": "01201ae5-04b4-3a95-bf51-4039e509146b",
                                        "glosses": [
                                            "present participle and gerund of worry"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "worrying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0af8382d-98b3-3cef-a068-e074eb5dbadd",
                                        "entry_id": "7bf4310a-1214-3a10-9d26-16627862d379",
                                        "glosses": [
                                            "The act of worrying or harassing somebody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "670f749f-5164-4403-925a-603e698c3772",
                                                "sense_id": "0af8382d-98b3-3cef-a068-e074eb5dbadd",
                                                "text": "There is a snaky gleam in her hard grey eye, as of anticipated rounds of buttered toast, relays of hot chops, worryings and quellings of young children, sharp snappings at poor Berry, and all the other delights of her Ogress's castle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29a853db-1d2b-4e95-bee8-ec8beb20b9e2",
                        "source_entry_id": "068f87d4-37c6-3b54-baec-3d7dc56df918",
                        "source_sense_id": "c3a19e17-88b8-3ead-ad76-596dadb3d92f",
                        "target_lang_word": "worry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cc11cd8-a2ca-3312-a646-7cc991ada4ca",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To be troubled; to give way to mental anxiety or doubt."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e9e1546-1bff-4c85-b4dd-90a364d24ff6",
                                                "sense_id": "0cc11cd8-a2ca-3312-a646-7cc991ada4ca",
                                                "text": "So you go along for a long time / And nothing seems to worry your mind / But what it adds up to / It's the side effect / That finally gets to you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "593dd36e-d102-3dd0-a984-c99c46966a40",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "Disturb the peace of mind of; afflict with mental agitation or distress; to exercise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ecd0999-c356-49fb-be7e-7d62079ca989",
                                                "sense_id": "593dd36e-d102-3dd0-a984-c99c46966a40",
                                                "text": "Your tone of voice worries me."
                                            },
                                            {
                                                "example_id": "0e27cd34-44d1-48c7-8dae-db43ac4fdc15",
                                                "sense_id": "593dd36e-d102-3dd0-a984-c99c46966a40",
                                                "text": "That worries the government, which fears that environmental activism could become the foundation for more general political opposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f92b81-f7f2-3a83-8c5b-ad32b036ee5f",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To harass; to irritate or distress."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cdffd4-aef1-49b7-9526-48a5ebc438c4",
                                                "sense_id": "f8f92b81-f7f2-3a83-8c5b-ad32b036ee5f",
                                                "text": "The President was worried into military action by persistent advisors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b589498c-c60b-3871-aabe-44da3200b11c",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To seize or shake by the throat, especially of a dog or wolf."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b021e9e2-15b1-40f9-8776-e91f56dbe2a2",
                                                "sense_id": "b589498c-c60b-3871-aabe-44da3200b11c",
                                                "text": "Your dog’s been worrying sheep again."
                                            },
                                            {
                                                "example_id": "a6d5903d-d459-4d69-b001-bbd77cc27301",
                                                "sense_id": "b589498c-c60b-3871-aabe-44da3200b11c",
                                                "text": "This is the Dog, that worried the Cat, that killed the Rat, that ate the Malt, that lay in the Houſe that Jack built."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To touch repeatedly; to fiddle with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21211eff-80b2-4ce5-8586-22c34578ba34",
                                                "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                                                "text": "Christian paced the caravan, worrying his beard."
                                            },
                                            {
                                                "example_id": "aa6f70ba-68a0-46f2-bdbb-69f7926bd72e",
                                                "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                                                "text": "So what if I wanted to touch my nose to the windshield? Who was it hurting? Why was it that he could repeatedly worry his change and bite his lower lip without the threat of punishment?"
                                            },
                                            {
                                                "example_id": "e5fd7ef6-23ce-4d2a-9abd-464f0215f6ad",
                                                "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                                                "text": "No stories, no arguments. He just worries his prayer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc7ba904-e344-33af-b363-18521406ec6b",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To strangle."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be6c123d-cccd-4941-908e-b97f53a6bb5f",
                                                "sense_id": "cc7ba904-e344-33af-b363-18521406ec6b",
                                                "text": "We read (Law's Memor. Pref. lix.) that \"one John Brugh, a notorious warlock (wizard) in the parochin of Fossoquhy, by the space of thirty-six years, was worried at a stake and burned, 1643.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "worry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "182e9c1f-0b23-3860-8a56-f2e1b2f198c0",
                                        "entry_id": "35de140f-a3e1-3a68-9cef-ea2301fc27c7",
                                        "glosses": [
                                            "A strong feeling of anxiety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f43a88c-6027-465f-8225-9b7c6fce0ab2",
                                                "sense_id": "182e9c1f-0b23-3860-8a56-f2e1b2f198c0",
                                                "text": "I'm afflicted by worry throughout the night."
                                            },
                                            {
                                                "example_id": "02cd96df-057e-47da-a368-edc1acad5c52",
                                                "sense_id": "182e9c1f-0b23-3860-8a56-f2e1b2f198c0",
                                                "text": "\"Worry never solved any problems. Only gives you ulcers.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e33985b-7744-3a68-a60b-b5a3348f0e6c",
                                        "entry_id": "35de140f-a3e1-3a68-9cef-ea2301fc27c7",
                                        "glosses": [
                                            "An instance or cause of such a feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2da2f7b7-3186-4711-b332-4270f83a48af",
                                                "sense_id": "4e33985b-7744-3a68-a60b-b5a3348f0e6c",
                                                "text": "My main worry is that I'll miss the train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3edf384a-2209-3c03-b920-27637e02c59b",
                                        "entry_id": "35de140f-a3e1-3a68-9cef-ea2301fc27c7",
                                        "glosses": [
                                            "A person who causes worry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb315a5b-0fbc-4a15-875a-9bbd221036eb",
                                                "sense_id": "3edf384a-2209-3c03-b920-27637e02c59b",
                                                "text": "They could never make him speak a word, although he was old enough, in short, he was a perfect worry night and day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
