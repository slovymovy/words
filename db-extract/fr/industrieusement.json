                "entry_id": "c99c5e99-3722-39d5-96f0-d85c9478b393",
                "word": "industrieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "73c9fc90-969a-3347-ab21-a462778b6f27",
                        "entry_id": "c99c5e99-3722-39d5-96f0-d85c9478b393",
                        "glosses": [
                            "D'une manière industrieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b9a0ae-3d70-4628-b3cf-ef2ad467e3bf",
                                "sense_id": "73c9fc90-969a-3347-ab21-a462778b6f27",
                                "text": "Les fausses couleurs, quelque industrieusement qu'on les applique, ne tiennent pas."
                            },
                            {
                                "example_id": "1d8f3477-bd03-4b77-abf8-b70ff5e88039",
                                "sense_id": "73c9fc90-969a-3347-ab21-a462778b6f27",
                                "text": "On y montait par trois marches industrieusement faites avec des piquets, avec des planches et remplies de pierrailles."
                            },
                            {
                                "example_id": "b3fac5ad-2b66-4777-b56c-2465be9e907c",
                                "sense_id": "73c9fc90-969a-3347-ab21-a462778b6f27",
                                "text": "Les mains de la princesse industrieusement occupées s'exerçaient à des ouvrages dont la piété avait donné le dessin."
                            },
                            {
                                "example_id": "02549f73-a2d0-49d2-8975-5497e4e8024e",
                                "sense_id": "73c9fc90-969a-3347-ab21-a462778b6f27",
                                "text": "Mêlant industrieusement l'or et la soie."
                            },
                            {
                                "example_id": "7db9f795-922d-425b-94aa-64e179cd026f",
                                "sense_id": "73c9fc90-969a-3347-ab21-a462778b6f27",
                                "text": "Cela est fait industrieusement."
                            },
                            {
                                "example_id": "44371a17-b15a-4095-8384-15e53cc583b9",
                                "sense_id": "73c9fc90-969a-3347-ab21-a462778b6f27",
                                "text": "Il travaille industrieusement."
                            },
                            {
                                "example_id": "0874564f-9b8c-46e8-9945-8dba97845cf4",
                                "sense_id": "73c9fc90-969a-3347-ab21-a462778b6f27",
                                "text": "Ouvrage industrieusement exécuté."
                            }
                        ]
                    }
                ],
