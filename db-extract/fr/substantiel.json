                        ],
                        "form": "substantielle"
                    },
                    {
                        "form_id": "415e3de7-14a5-48b3-a4a9-8eec1c58d78d",
                        "entry_id": "8629b6d3-95ce-3cdc-abf9-4d4800cb795b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "substantielles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fda73563-215e-31d5-85f0-e8e9fefdc94d",
                        "entry_id": "8629b6d3-95ce-3cdc-abf9-4d4800cb795b",
                        "glosses": [
                            "Qui est succulent, nourrissant, rempli de substance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f9b051c-e270-46bd-8662-a87d18762bb7",
                                "sense_id": "fda73563-215e-31d5-85f0-e8e9fefdc94d",
                                "text": "Il faut pour ce convalescent des aliments plus substantiels."
                            },
                            {
                                "example_id": "68fb4d0f-e15b-4882-ae63-75a51c6ec91e",
                                "sense_id": "fda73563-215e-31d5-85f0-e8e9fefdc94d",
                                "text": "Une nourriture substantielle."
                            }
                        ]
                    },
                    {
                        "sense_id": "4452746b-bb1a-35fe-93a2-e063c8f04ff8",
                        "entry_id": "8629b6d3-95ce-3cdc-abf9-4d4800cb795b",
                        "glosses": [
                            "Important, volumineux, considérable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45aaa0fc-9b2f-4d40-906b-93fa2cb634e6",
                                "sense_id": "4452746b-bb1a-35fe-93a2-e063c8f04ff8",
                                "text": "Obtenir des avantages substantiels."
                            },
                            {
                                "example_id": "c2fb1c03-9ef8-4bea-8631-ea15c216a648",
                                "sense_id": "4452746b-bb1a-35fe-93a2-e063c8f04ff8",
                                "text": "Avec ses tarifs toujours aussi avantageux […] l’Assec a permis des économies substantielles à ses adhérents."
                            },
                            {
                                "example_id": "2e72f185-1768-4108-9e9c-145080ab0603",
                                "sense_id": "4452746b-bb1a-35fe-93a2-e063c8f04ff8",
                                "text": "Ces façons de procéder ne valent toutefois que pour les modifications d’ampleur limitée. Pour les modifications substantielles, il convient de procéder à une saisine rectificative ou complémentaire, qui est de la compétence exclusive du secrétariat général du Gouvernement."
                            }
                        ]
                    },
                    {
                        "sense_id": "16215f67-3188-3e81-a26b-1406448f7697",
                        "entry_id": "8629b6d3-95ce-3cdc-abf9-4d4800cb795b",
                        "glosses": [
                            "Qui en fait le corps, la substance, l’essentiel, en parlant des ouvrages de l’esprit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "901372e3-45ac-406b-81dc-c39201d673b0",
                                "sense_id": "16215f67-3188-3e81-a26b-1406448f7697",
                                "text": "On a extrait de ce livre, de ce discours ce qu’il y a de plus substantiel."
                            },
                            {
                                "example_id": "a407339b-1ef8-493a-85a7-fece0db92abc",
                                "sense_id": "16215f67-3188-3e81-a26b-1406448f7697",
                                "text": "L’enquête menée dans les archives de Russie, d’Allemagne, de Biélorussie, d’Ukraine et de Washington nourrit un livre substantiel."
                            }
                        ]
                    },
                    {
                        "sense_id": "62cec812-9fdf-3b78-9190-f8e3dfa105e4",
                        "entry_id": "8629b6d3-95ce-3cdc-abf9-4d4800cb795b",
                        "glosses": [
                            "Qui est inhérent à la substance, forme qui détermine l’essence de chaque être."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03ae1b22-31eb-41f7-915b-bc5049ed5c86",
                                "sense_id": "62cec812-9fdf-3b78-9190-f8e3dfa105e4",
                                "text": "Descartes admet donc véritablement la création, c'est-à-dire l'existence substantielle ou séparée des êtres finis ; …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "957273d4-8468-4ee6-ab35-28d818c79804",
                        "source_entry_id": "8629b6d3-95ce-3cdc-abf9-4d4800cb795b",
                        "target_lang_word": "erheblich",
