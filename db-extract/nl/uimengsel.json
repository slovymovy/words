                        "examples": [
                            {
                                "example_id": "40ba58d2-30b1-4986-8143-8cd18e2e72b1",
                                "sense_id": "c3f28c3f-4f16-32ed-a778-17c57d7a7d94",
                                "text": "Roer 2 eetlepels warm stoofperenvocht door het uimengsel. Verdeel het vlees over vier borden, schep het uimengsel erbij. Serveer met de aardappelpuree en de stoofperen."
                            },
                            {
                                "example_id": "2a033867-e892-4cf4-ac54-2f71ba2000dc",
                                "sense_id": "c3f28c3f-4f16-32ed-a778-17c57d7a7d94",
                                "text": "Snijd de ui in ringen en pers de knoflook uit. Bak beide in een beetje olijfolie aan, tot de ui glazig ziet. Schil de appel en snijd het in blokjes, bak dit even met het uimengsel mee."
                            }
                        ]
                    }
