                    "frequency": "High",
                    "semantic_group_id": "méfiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'attitude mystérieuse de cet homme a rapidement éveillé les <w>soupçons</w> de la police locale."
                        },
                        {
                            "text": "Elle a été lavée de tout <w>soupçon</w> après la découverte de nouvelles preuves irréfutables."
                        }
                    ],
                    "synonyms": [
