                ],
                "senses": [
                    {
                        "sense_id": "415104a7-b746-31da-9858-6cc61afab1ea",
                        "entry_id": "3afbfe10-2d37-30cc-b715-00be7bd19c64",
                        "glosses": [
                            "het verzet tegen iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13b72344-1c1d-4400-9b52-a70420d8e70f",
                                "sense_id": "415104a7-b746-31da-9858-6cc61afab1ea",
                                "text": "Hij blijft er naar eigen zeggen tegenkanting krijgen van ‘kleine groep die het aan het verpesten is’."
                            },
                            {
                                "example_id": "e6f3da4c-4b7c-470b-babf-18c84b02e323",
                                "sense_id": "415104a7-b746-31da-9858-6cc61afab1ea",
                                "text": "Er waren dit jaar al verschillende signalen dat beide havens toenadering zoeken. Er bleek ook geen politieke tegenkanting meer te zijn van de betrokken gemeenteraden. Nu gaan ze dus een stapje verder."
                            },
                            {
                                "example_id": "e97d316e-5488-4f7c-bd99-9eaac18316f0",
                                "sense_id": "415104a7-b746-31da-9858-6cc61afab1ea",
                                "text": "Ondanks alle tegenkantingen en racistische uitlatingen, is Carl Brashear vastberaden een carrière uit te bouwen bij de Amerikaanse marine. Na getuige te zijn van een redding op zee, staat zijn besluit vast: hij wil de eerste kleurling zijn die het schopt tot duiker. Hij moet hiervoor wel eerst slagen in zijn opleiding, die in handen is van de autoritaire instructeur Billy Sunday. Brashear wordt op alle mogelijke manieren tegengewerkt door zijn collega’s en oversten, die tot het uiterste gaan om hem te doen falen. Tot ieders verbazing geeft hij echter niet op."
                            }
                        ]
                    }
                ],
