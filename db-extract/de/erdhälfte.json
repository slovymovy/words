                ],
                "senses": [
                    {
                        "sense_id": "a5addbcb-71b6-3a45-9cd1-a9af896923fb",
                        "entry_id": "9f358047-cb59-32e7-bd34-543312d1b316",
                        "glosses": [
                            "bei einer Unterteilung der Erde in je zwei Hemisphären – eine nördliche und eine südliche beziehungsweise eine östliche und eine westliche – einer der beiden Teile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0bfca9d-c457-40e0-b64f-c83074142709",
                                "sense_id": "a5addbcb-71b6-3a45-9cd1-a9af896923fb",
                                "text": "„Auf der südlichen Erdhälfte, die größtenteils mit Wasser bedeckt ist, schließen sich die Isothermen den Breitenparallelen ziemlich gut an.“"
                            },
                            {
                                "example_id": "acd2d572-f552-4c11-9fe0-a918c9beade7",
                                "sense_id": "a5addbcb-71b6-3a45-9cd1-a9af896923fb",
                                "text": "„Der Südmagnetismus der nördlichen Erdhälfte zieht eben den Nordmagnetismus in der Eisenstange an und führt ihn in ihr unteres Ende, während er den Südmagnetismus der Stange in deren oberes Ende treibt.“"
                            },
                            {
                                "example_id": "2164e728-e660-4d20-b636-e9fc8ca0af21",
                                "sense_id": "a5addbcb-71b6-3a45-9cd1-a9af896923fb",
                                "text": "„Diese Strecke weist, wie schon erwähnt, auf der nördlichen Erdhälfte immer nach oben, auf der südlichen immer nach unten.“"
                            },
                            {
                                "example_id": "548da645-ba9d-4d63-9b7d-cbd8199299b0",
                                "sense_id": "a5addbcb-71b6-3a45-9cd1-a9af896923fb",
                                "text": "„Auf der nördlichen Erdhälfte ist es Winter, kurze Tageszeit; auf der südlichen Sommer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
