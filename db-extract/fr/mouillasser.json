                ],
                "senses": [
                    {
                        "sense_id": "24fe69c7-2d3f-37d6-8e09-1b854ec568d3",
                        "entry_id": "eab6a8dd-4fab-32d6-95ea-405e22e3ff73",
                        "glosses": [
                            "Bruiner (aussi utilisé pour une pluie de faible intensité)."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "8d0654ec-b0b9-46d7-a5ec-b68bcea1b182",
                                "sense_id": "24fe69c7-2d3f-37d6-8e09-1b854ec568d3",
                                "text": "Rentrons sans tarder à la maison, ça mouillasse ! lui lança-t-elle."
                            },
                            {
                                "example_id": "a2031343-27bc-439b-a462-fa6b43d3f5c7",
                                "sense_id": "24fe69c7-2d3f-37d6-8e09-1b854ec568d3",
                                "text": "Le surlendemain, alors qu’il mouillassait, il m’avait emmené jouer un dix-huit trous."
                            },
                            {
                                "example_id": "4ea14120-ae86-45ea-838e-758de89494ac",
                                "sense_id": "24fe69c7-2d3f-37d6-8e09-1b854ec568d3",
                                "text": "Mais maintenant, c’est juste du crachin. Ça mouillasse, sans plus."
                            }
                        ]
                    }
