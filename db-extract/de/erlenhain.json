                "senses": [
                    {
                        "sense_id": "68630a4b-9bb3-3cb0-920e-5e34eef5fa68",
                        "entry_id": "4163bc44-ee1f-346a-a8a3-93b8b51f60f9",
                        "glosses": [
                            "mit Erlen bewachsener Hain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3fcc7d9-67de-451a-9ae8-36b7a6fdec13",
                                "sense_id": "68630a4b-9bb3-3cb0-920e-5e34eef5fa68",
                                "text": "„Aus den Erlenhainen und feuchten Sumpfinseln drangen undeutliche Laute, ob von Menschen oder Tieren, war schwer auszumachen.“"
                            },
                            {
                                "example_id": "3c067468-a5c0-4323-9479-db40b08d70ec",
                                "sense_id": "68630a4b-9bb3-3cb0-920e-5e34eef5fa68",
                                "text": "„Die Sonne war noch nicht über den Berg aufgestiegen, in dessen Schatten sie lagerten, doch wurde ein Stück Kiefernwald oben an der gegenüberliegenden Bergseite bereits von der frühen Sonne angestrahlt; ein Erlenhain flammte dunkelgolden im Grün der Kiefern auf.“"
                            },
                            {
                                "example_id": "685097a4-fe78-4d23-b69b-91089c27ac5f",
                                "sense_id": "68630a4b-9bb3-3cb0-920e-5e34eef5fa68",
                                "text": "„Er bog vom Bach ab, gelangte auf trockeneren Grund und zog dann in halbem Laufschritt durch einen Erlenhain, bis er vor einem kleinen Kolk stand; ein Reiher brach träge hervor und stieg mit schwerem mächtigem Flügelschlag in die Höhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
