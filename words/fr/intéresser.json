                    ]
                },
                {
                    "sense_id": "e32369fe-edb7-3bf3-929b-15ff18fe6382",
                    "sense_definition": "Affecter, toucher un organe ou un tissu corporel, en parlant d'une maladie ou d'une lésion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a confirmé que l'infection n'<w>intéressait</w> heureusement pas le système nerveux central."
                        },
                        {
                            "text": "Cette lésion sévère peut <w>intéresser</w> plusieurs organes vitaux à la fois."
                        }
                    ],
                    "synonyms": [
