                ],
                "senses": [
                    {
                        "sense_id": "d9e49fb8-4673-3e55-8c61-d30cae6e0f45",
                        "entry_id": "1a145884-e178-3622-ac2d-4851b131603b",
                        "glosses": [
                            "künstlich (technisch) erzeugte Umwelt; von Technik bestimmter/beherrschter Lebensraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58eede64-7073-4d6d-b736-d7140cd5ac09",
                                "sense_id": "d9e49fb8-4673-3e55-8c61-d30cae6e0f45",
                                "text": "„Auf der Erde hat sich eine neue Realität entfaltet: die Technosphäre. Sie überzieht den Planeten mittlerweile nahezu lückenlos und macht uns immer abhängiger.“"
                            },
                            {
                                "example_id": "8d1006e6-5b84-4556-ab2c-3dd0c5c9bf39",
                                "sense_id": "d9e49fb8-4673-3e55-8c61-d30cae6e0f45",
                                "text": "„Die Vorstellung einer Technosphäre ist von planetarischem Ausmaß. Sie evoziert das Bild einer Vereinheitlichung weltumspannender Technik. Ihr extremes Gegenbild ist ein vom Menschen gänzlich unberührter, lebendiger Planet.“"
                            },
                            {
                                "example_id": "bb3eb55d-d2d4-47a0-93bb-402d600a99e0",
                                "sense_id": "d9e49fb8-4673-3e55-8c61-d30cae6e0f45",
                                "text": "„Unter den Palmen, Reisfeldern und Kunstfelsen versteckten sich die Eingeweide der \"Biosphäre 2\": eine ausgefeilte Technosphäre, bestehend aus Computern, Pumpen, Sprinkleranlage für den Regenwald, Gezeitensimulator für den Ozean.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
