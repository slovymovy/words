                                                "example_id": "add07f41-1010-47df-8202-c92259d3f2c7",
                                                "sense_id": "bf01eb83-31ab-3f93-b4f6-5d52116b38b2",
                                                "text": "Tellement habitant, il couche en cuillère à soupe."
