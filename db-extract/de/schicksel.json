                "senses": [
                    {
                        "sense_id": "cf16979b-37c7-3890-9344-59e570288a04",
                        "entry_id": "86955742-e859-34d9-96e0-27fb15c1d6ae",
                        "glosses": [
                            "Schickse"
                        ],
                        "tags": [
                            "colloquial",
                            "variant"
                        ],
                        "examples": [
                            {
                                "example_id": "c4f8825d-b26a-420a-b301-909473505ae0",
                                "sense_id": "cf16979b-37c7-3890-9344-59e570288a04",
                                "text": "„›Sie sind wohl recht artig, die Herren, du hübsches Schicksel‹, sagte ich, denn mit Floretten gewinnt man die Weiber.“"
                            },
                            {
                                "example_id": "c755683b-01c9-4474-9f37-8a0fb70cbddc",
                                "sense_id": "cf16979b-37c7-3890-9344-59e570288a04",
                                "text": "„»Gott, Susel, armes Schicksel, so gern hast du ihn?« sagte Borich, dem das Herz schwer wurde, als Susel da saß, die Schürze vor den Augen.“"
                            },
                            {
                                "example_id": "4b651fee-9cca-4cec-ad9d-29028108d089",
                                "sense_id": "cf16979b-37c7-3890-9344-59e570288a04",
                                "text": "„Eine Schicksel fragte: »Was ist denn das, Volkswirtschaft?!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
