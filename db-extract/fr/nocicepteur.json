                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45e0b81-6523-4a35-abb6-2497d0449489",
                                "sense_id": "b9f69fc7-04a0-3ed3-966c-4805d4e595dc",
                                "text": "Les chercheurs suédois affirment aujourd'hui, dans une étude parue dans la revue Science, avoir identifié un nouveau type de cellules de Schwann qui seraient capables de ressentir directement la douleur, indépendamment des cellules nociceptrices elles-mêmes."
                            }
                        ]
