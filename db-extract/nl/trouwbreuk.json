                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "083bdc9d-64ce-3072-8ab3-163afaf4ad0a",
                                        "entry_id": "b24e273e-4184-36cc-bfc4-107423cadf59",
                                        "glosses": [
                                            "Unfaithfulness in a marriage or an intimate (sexual or romantic) relationship: practice or instance of having a sexual or romantic affair with someone other than one's spouse, without the consent of the spouse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fed94e2-4fa3-49d2-8d9f-4d2d336d1eac",
                                                "sense_id": "083bdc9d-64ce-3072-8ab3-163afaf4ad0a",
                                                "text": "Your friends tell you rumors about your girlfriend's infidelity or you remember being broken up around the time the baby was conceived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "923bd588-71d0-37d3-b3b9-296eae928622",
                                        "entry_id": "b24e273e-4184-36cc-bfc4-107423cadf59",
                                        "glosses": [
                                            "Unfaithfulness in some other moral obligation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2c1a01d-fdb8-4be4-aa2d-af741ffb43a2",
                                                "sense_id": "923bd588-71d0-37d3-b3b9-296eae928622",
                                                "text": "It was disastrous that England's infidelity towards Frederick the Great — which no one, not even a German, condemned more strongly than did William Pitt — had to affect one of the most popular heroes of our national history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e9cc991-41c2-3c40-99cb-1f2f5adc4029",
                                        "entry_id": "b24e273e-4184-36cc-bfc4-107423cadf59",
                                        "glosses": [
                                            "Lack of religious belief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f61b23d2-5806-4261-adfa-1a681eccc365",
                                                "sense_id": "2e9cc991-41c2-3c40-99cb-1f2f5adc4029",
                                                "text": "The means used to this purpose are partly didactical, and partly protreptical; demonstrating the truth of the gospel, and then urging the professors of those truths to be stedfast^([sic]) in the faith, and to beware of infidelity."
                                            }
                                        ]
                                    }
                                ]
