{
    "word_family": [
        "supersession",
        "superseder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71eae2c9-df44-3bd4-b0aa-7dbd92707136",
                    "sense_definition": "To take the place of something that is now considered old or less effective.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "replace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New technology will soon <w>supersede</w> the older models currently in use."
                        },
                        {
                            "text": "These regulations were <w>superseded</w> by a more modern set of rules."
                        }
                    ],
                    "synonyms": [
                        "replace",
                        "supplant"
                    ],
                    "common_phrases": [
                        "supersede older versions",
                        "supersede existing rules"
                    ]
                },
                {
                    "sense_id": "eb3eb9d6-bf28-340c-b584-2c1d572e6573",
                    "sense_definition": "To force something out of its position and take its place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "replace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Global trends often <w>supersede</w> local traditions in many urban areas."
                        },
                        {
                            "text": "The new management team <w>superseded</w> the previous board after the merger."
                        }
                    ],
                    "synonyms": [
                        "usurp"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f542910-cf79-3b5a-b73a-bd34919d3188",
                    "sense_definition": "An updated post that replaces an earlier version of a message.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "replace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system automatically issued a <w>supersede</w> to correct the error in the original post."
                        },
                        {
                            "text": "Users should ignore the first message as a <w>supersede</w> has been sent."
                        }
                    ]
                }
            ]
        }
