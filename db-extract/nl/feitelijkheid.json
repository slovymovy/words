                        "glosses": [
                            "iets dat gebaseerd is op feiten; iets waarvan de werkelijkheid bewezen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77be5644-ead9-4034-a8db-b98a76e5d431",
                                "sense_id": "b4545957-5907-38b3-aa12-ff18c3044505",
                                "text": "Hij keek om en had het gevoel of zijn ogen met azijn werden afgezeemd, zijn ziel samenkromp onder het lekkende zuur: schuin opzij liep Bergsma, messcherp feit tegen de prompt gefixeerde feitelijkheid van de stad."
                            },
                            {
                                "example_id": "1a19e1db-e312-4261-87f1-ab143d5e3c95",
                                "sense_id": "b4545957-5907-38b3-aa12-ff18c3044505",
                                "text": "Een roekeloze actie, vond Azarkan, die naar de beroepscommissie stapte. Die oordeelde afgelopen donderdag dat het bestuur hem het lidmaatschap niet had mogen ontnemen, onder meer omdat de feitelijkheid van de beschuldigingen aan zijn adres niet kon worden bewezen."
                            }
