                    },
                    {
                        "translation_id": "6316ed34-dee0-416f-882f-da0ce493d0c0",
                        "source_entry_id": "d1b94a0b-00f4-3d07-9534-4e8d2f071be1",
                        "source_sense_description": "воин, вооружённый щитом",
                        "target_lang_word": "écuyer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écuyer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35ce3805-3491-39a1-b52e-8a9fcadf9c40",
                                        "entry_id": "9a6858cf-89c9-3690-a7dc-b633df824a57",
                                        "glosses": [
                                            "Relatif aux écuyers et aux écuyères."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bb25a36-10a6-4a7c-846e-d7639ddef5a5",
                                                "sense_id": "35ce3805-3491-39a1-b52e-8a9fcadf9c40",
                                                "text": "Mais maintenant, ami, contez-moi quelle bonne fortune vous avez tirée de vos fonctions écuyères ; quelle jupe à la savoyarde m’apportez-vous ? et quels souliers mignons à vos enfants ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écuyer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f0d8e8c-89cc-3f12-aa22-54f2662a181d",
                                        "entry_id": "42f1e8c0-a70f-368b-8fe9-1184c9422a72",
                                        "glosses": [
                                            "Gentilhomme qui suivait et accompagnait un chevalier, qui portait son écu et l’aidait à prendre ses armes et armure, et à se désarmer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a44aebd-cacd-45f4-9c7f-4bb71d191755",
                                                "sense_id": "4f0d8e8c-89cc-3f12-aa22-54f2662a181d",
                                                "text": "La cour était pleine d’écuyers, de valets, de chevaux et de litières, car, ainsi que nous l’avons dit, il y avait fête à Godesberg."
                                            },
                                            {
                                                "example_id": "765859c1-6ede-464c-896f-3fa6120849ec",
                                                "sense_id": "4f0d8e8c-89cc-3f12-aa22-54f2662a181d",
                                                "text": "Un second écuyer tenait droite la lance de son maître, à l’extrémité de laquelle flottait une petite banderole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65fabcfc-a124-3ee6-9b86-88449481bef6",
                                        "entry_id": "42f1e8c0-a70f-368b-8fe9-1184c9422a72",
                                        "glosses": [
                                            "Gentilhomme qui suivait et accompagnait un chevalier, qui portait son écu et l’aidait à prendre ses armes et armure, et à se désarmer.",
                                            "Titre que portaient anciennement les jeunes nobles, jusqu’à leur adoubement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8568670d-5cf3-3fa5-a911-bf0a945c48ef",
                                        "entry_id": "42f1e8c0-a70f-368b-8fe9-1184c9422a72",
                                        "glosses": [
                                            "Gentilhomme qui suivait et accompagnait un chevalier, qui portait son écu et l’aidait à prendre ses armes et armure, et à se désarmer.",
                                            "Titre que portaient autrefois, en France, les gentilshommes et les anoblis. Cette qualification est encore usitée en Angleterre (squire)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e1e8a54-7840-326c-b41c-74b9db8bdb05",
                                        "entry_id": "42f1e8c0-a70f-368b-8fe9-1184c9422a72",
                                        "glosses": [
                                            "Gentilhomme qui suivait et accompagnait un chevalier, qui portait son écu et l’aidait à prendre ses armes et armure, et à se désarmer.",
                                            "Celui qui donnait la main à une reine, une princesse ou une grande dame pour la mener."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60f2df0c-6175-3be1-8913-66d3e7ac0b71",
                                        "entry_id": "42f1e8c0-a70f-368b-8fe9-1184c9422a72",
                                        "glosses": [
                                            "Celui qui avait la charge ou l’intendance de l’écurie d’un prince, d’un grand seigneur ou du roi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d69718-5fa5-4baf-8768-d1d25b8be8e1",
                                                "sense_id": "60f2df0c-6175-3be1-8913-66d3e7ac0b71",
                                                "text": "Le système de Buffon sera surtout repris par le plus grand hippiatre de l’époque, le fondateur de la science vétérinaire, l’écuyer le plus célèbre de son temps : Claude Bourgelat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95a07780-acb0-3f6f-875d-9d0710822ece",
                                        "entry_id": "42f1e8c0-a70f-368b-8fe9-1184c9422a72",
                                        "glosses": [
                                            "Celui qui enseigne à monter à cheval et qui dresse les chevaux au manège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce58b45c-f1e5-4566-9b42-c0fc5f2baeb2",
                                                "sense_id": "95a07780-acb0-3f6f-875d-9d0710822ece",
                                                "text": "Enguerrand Lorien, l’ami intime de mon défunt mari, Perrot Travigny, et l’ancien écuyer des comtes de Vimoutiers, nos voisins, vous instruisirent aux armes, au maniement de la lance et de l’épée, à l’équitation, enfin à toutes les choses de la chevalerie, […]."
                                            },
                                            {
                                                "example_id": "5c2887b8-8e25-4565-9e5f-5e23e02392eb",
                                                "sense_id": "95a07780-acb0-3f6f-875d-9d0710822ece",
                                                "text": "Chaque cirque possède, en outre, un maître de manège, appelé chef de piste ou chef d’équitation, qui a la responsabilité de la cavalerie. Écuyer consommé, le dressage en liberté ou en haute école ne doit avoir pour lui aucun secret."
                                            },
                                            {
                                                "example_id": "e9c86cae-0758-40a8-8a6f-846e35598c77",
                                                "sense_id": "95a07780-acb0-3f6f-875d-9d0710822ece",
                                                "text": "[…] ; nous n’avons point parlé, par exemple, d’une loi faite uniquement pour défendre aux écuyers protestans de donner des leçons d’équitation; les jésuites qui n’avaient jamais fréquenté de maîtres de manège, supposaient, apparemment, que ces écuyers étaient de profonds théologiens qui argumenteraient contre leurs élèves, en leur apprenant à faire la volte, ou à partir du bon pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9319bde-4f59-3d9e-9869-7174e10843e2",
                                        "entry_id": "42f1e8c0-a70f-368b-8fe9-1184c9422a72",
                                        "glosses": [
                                            "Celui qui fait des exercices équestres dans un spectacle public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103857a2-64a9-435e-a22a-aae1e7ff0db9",
                                                "sense_id": "f9319bde-4f59-3d9e-9869-7174e10843e2",
                                                "text": "Déguisé en écuyer du cirque Fernando il fit la cour à une noble étrangère qu’il savait au mieux avec les anarchistes du temps."
                                            },
                                            {
                                                "example_id": "88f9e463-dd6c-4472-9482-d149a8ab3e51",
                                                "sense_id": "f9319bde-4f59-3d9e-9869-7174e10843e2",
                                                "text": "… et, fort beau gars encore, malgré sa corpulence, présentait dans l’ensemble l’allure d’un écuyer de cirque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32e0faa-0650-3fd4-996c-3a539aebb916",
                                        "entry_id": "42f1e8c0-a70f-368b-8fe9-1184c9422a72",
                                        "glosses": [
                                            "Appui rampant ou console qui supporte une main courante le long d’un mur d’escalier."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
