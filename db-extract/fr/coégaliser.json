                "senses": [
                    {
                        "sense_id": "1df0376f-d87f-3090-b09b-6d9e5603bdc3",
                        "entry_id": "ba996247-7eab-36a9-9008-9b91f8fefaa5",
                        "glosses": [
                            "Égaliser avec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e63adb5-de95-4d1d-a0c1-eb0ba85b2f8b",
                                "sense_id": "1df0376f-d87f-3090-b09b-6d9e5603bdc3",
                                "text": "En outre, l’application (a₀,a₁):L(D)₁ → D₀xD₀ doit coégaliser d₀ et d₁."
                            },
                            {
                                "example_id": "b840f4e0-7c9c-473d-a3b0-ea714f16c60c",
                                "sense_id": "1df0376f-d87f-3090-b09b-6d9e5603bdc3",
                                "text": "L’action de C sur R1, R2 vérifiant la relation de distribution, on montre que l’action de c ∈ C sur T(P,R1 ⊕R2) coégalise d1, d2."
                            },
                            {
                                "example_id": "eda133b4-f006-47f7-8a47-5b457e6f1391",
                                "sense_id": "1df0376f-d87f-3090-b09b-6d9e5603bdc3",
                                "text": "Si ξ: C ᪲ (R) → X coégalise les deux flèches du diagramme, alors ξ(id)² = 0 dans X."
                            }
                        ]
                    }
