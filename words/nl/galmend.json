                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niet meer <w>galmend</w> zoals vroeger, maar ingetogen en sober zong zij haar lied.",
                            "target_lang_translations": {
                                "en": "No longer <w>echoing</w> as before, she sang her song in a modest and sober way."
                            }
