                "senses": [
                    {
                        "sense_id": "f5aaf70c-046f-3773-9092-c7b8a6e53c07",
                        "entry_id": "1b8593c9-07f4-35c8-b549-9825e452a450",
                        "glosses": [
                            "ботан. многолетнее травянистое растение семейства розовых с красными сладкими ягодами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e34db61-f952-4858-b00e-6919f5851f23",
                                "sense_id": "f5aaf70c-046f-3773-9092-c7b8a6e53c07",
                                "text": "Встретилась княженика. Ягоды напоминают костянику, а листья как у земляники."
                            }
                        ]
                    },
                    {
                        "sense_id": "4164b280-ae34-3e94-bc80-305bd1be8a7f",
                        "entry_id": "1b8593c9-07f4-35c8-b549-9825e452a450",
                        "glosses": [
                            "ягоды этого растения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "138800cf-78e7-4df6-873d-bc65db8de353",
                                "sense_id": "4164b280-ae34-3e94-bc80-305bd1be8a7f",
                                "text": "И на всей этой полянке княженика, а кругом нигде этой ягоды не найдешь."
                            }
                        ]
                    }
                ],
