                                "sense_id": "b526577b-9b09-308c-93e2-664505e54391",
                                "text": "Auf de_dust haben wir die Noobs voll geownt."
                            },
                            {
                                "example_id": "b56278b6-4435-4eda-8bda-2f44c5be134f",
                                "sense_id": "b526577b-9b09-308c-93e2-664505e54391",
                                "text": "Ich werde Eilert bei der nächsten Lan ownen."
                            },
                            {
                                "example_id": "c46c225e-0b1f-44a6-a87f-e5de3c0b79fe",
                                "sense_id": "b526577b-9b09-308c-93e2-664505e54391",
                                "text": "„Ich würde so derbe Feiern wenn D. alle ownt und T. mit 6 zu 0 aus der GP Phase geht und am Ende die Worlds holt :D “"
                            },
                            {
                                "example_id": "c3ce40e2-edde-4575-aff0-bf39b745ce19",
                                "sense_id": "b526577b-9b09-308c-93e2-664505e54391",
                                "text": "„pWn3d, klar alter :D der is so cool haben 3 knife rounds gemacht und einmal hab ich den mit der pumpe geownt und er hat net gemeckert :D“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
