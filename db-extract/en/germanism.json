                    {
                        "translation_id": "1572daa3-7716-4abe-b6c7-9e74976c2213",
                        "source_entry_id": "e4fd2ebc-162f-3985-96aa-1ee0bd77849a",
                        "source_sense_description": "a word or idiom of the German language",
