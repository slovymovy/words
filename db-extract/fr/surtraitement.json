                        "sense_id": "15b3d72f-d6c1-37f5-b476-0d8aca8d9b52",
                        "entry_id": "bcc4ec47-edc7-3c4e-84b7-6af7cbd85e84",
                        "glosses": [
                            "Traitement dépassant le nécessaire, inutile ou même nuisible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a73838b-555c-4638-b270-4389a4d2a7ea",
                                "sense_id": "15b3d72f-d6c1-37f5-b476-0d8aca8d9b52",
                                "text": "En effet, le risque d’hypotension en ambulatoire lié à un surtraitement est toujours à craindre chez ces sujets."
                            }
                        ]
                    },
                    {
                        "sense_id": "25ee981e-8855-33f5-bcc4-bbc12cce334b",
                        "entry_id": "bcc4ec47-edc7-3c4e-84b7-6af7cbd85e84",
                        "glosses": [
                            "Traitement dépassant le nécessaire, à l’aide d’une réaction ou d’une manipulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c3a6c4-16ed-448b-9ca7-50a88db791c6",
                                "sense_id": "25ee981e-8855-33f5-bcc4-bbc12cce334b",
                                "text": "Seule la contamination par surtraitement en chaux ou par le ciment a été expérimentée tant au laboratoire que sur chantier."
                            }
                        ]
                    }
                ],
