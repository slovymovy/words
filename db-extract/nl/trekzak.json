                                    {
                                        "sense_id": "31d3c6d4-673c-36e0-b5ab-527200f400cb",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "A unit of length equal to ¹⁄₁₂ inch."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c49c71a-402c-3fcb-9156-2e3ee28beb2e",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "The means for initiating a nuclear strike or similar cataclysmic occurrence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c934e8a-dc04-42ce-bd6b-998f449793e3",
                                                "sense_id": "3c49c71a-402c-3fcb-9156-2e3ee28beb2e",
                                                "text": "It's Christmas at ground zero / The button has been pressed / The radio / Just let us know / That this is not a test"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01fc3946-89c7-3ee8-bd4e-43f889b6d9c6",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "The oblate spheroidal mass of glass attaching a stem to either its bowl or foot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea2c9e78-8581-3c5b-81a5-d138e67544bd",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "In an instrument of the violin family, the near-semicircular shape extending from the top of the back plate of the instrument, meeting the heel of the neck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d385ae25-7c98-35f8-af16-e9df6c324e99",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "Synonym of endbutton, part of a violin-family instrument."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7deb6245-fe45-30da-a3aa-f6e5b106683d",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "Synonym of adjuster."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1886e99-526e-32d5-8f3a-221fba035b5e",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "The least amount of care or interest; a whit or jot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "383dc512-b612-4d53-ae93-29df6d507ff5",
                                                "sense_id": "f1886e99-526e-32d5-8f3a-221fba035b5e",
                                                "text": "'She has heard from us this morning,' said Mr. Gamble, grinning on his watch, 'and she knows all by this time, and 'tisn't a button to her.'"
                                            },
                                            {
                                                "example_id": "d6149c8a-fee9-4ab6-9d21-f010de406dd1",
                                                "sense_id": "f1886e99-526e-32d5-8f3a-221fba035b5e",
                                                "text": "As to that I did not care a button, but I had wanted to hear about Betty, and now her name was barely mentioned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baaca75f-cdd8-361d-8e1d-4e1ea4a1b718",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "The punchy or suspenseful line of dialogue that concludes a scene."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f40db7e6-cd6d-47f7-8458-955bcf11bd54",
                                                "sense_id": "baaca75f-cdd8-361d-8e1d-4e1ea4a1b718",
                                                "text": "One thing you definitely don't want to do is write past the button. For example, a scene's natural button might run something like this:\nTONY: That kind of talk is exactly what I'm talking about.\nWhereas an example of writing past the button would sound something like this:\nTONY: That kind of talk is exactly what I'm talking about.\nCARMELLA: Okay. 'Bye.\nTONY: Bye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6daa553f-eacc-326f-8dfb-1b0abb4eb0bf",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "The final joke at the end of a comedic act (such as a sketch, set, or scene)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ac6531-d832-4bee-a3e4-b25befe2f46b",
                                                "sense_id": "6daa553f-eacc-326f-8dfb-1b0abb4eb0bf",
                                                "text": "Scenes usually go out on a laugh line, a stinger or a button. End your script with a twist!"
                                            },
                                            {
                                                "example_id": "21ccee93-6ad8-4e1e-8ec5-02fd5eb9d1a8",
                                                "sense_id": "6daa553f-eacc-326f-8dfb-1b0abb4eb0bf",
                                                "text": "With our show, one thing we wanted to do was give our best effort to always put a button on the scene."
                                            },
                                            {
                                                "example_id": "ef138144-18a9-4e3c-9217-dfb735125a9a",
                                                "sense_id": "6daa553f-eacc-326f-8dfb-1b0abb4eb0bf",
                                                "text": "Is there a best way to end a comedy sketch? Endings — or outs, or buttons as writers call them — are notoriously difficult to nail. The ideal ending needs to be satisfying and surprising while staying true to the comedic game that preceded it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63e86a3d-6a5b-3ada-80ac-1e718a074dfd",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "A button man; a professional assassin."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eefa710-579c-4a86-b35b-087a938d517e",
                                                "sense_id": "63e86a3d-6a5b-3ada-80ac-1e718a074dfd",
                                                "text": "FREDO: Mikey, why would they ever hit poor old Frankie Five-Angels? I loved that ole sonuvabitch. I remember when he was just a 'button,' when we were kids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c00294-9e10-3de6-be36-a9ae008f60c2",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "The final segment of a rattlesnake's rattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a166ae-8801-4dff-9b33-6445526bc2dc",
                                                "sense_id": "b8c00294-9e10-3de6-be36-a9ae008f60c2",
                                                "text": "Hardly a rattler is ever reported in the newspapers unless it is stated to have had \"blank rattles and a button\". But here button usually means the terminal lobe of the last rattle, even though the string may not be complete, the true button and additional rattles having been lost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83c5a719-37b8-3740-a562-c45c0676b357",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "A clove (of garlic)."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c9d6e32-fa42-37ec-b408-dfaaf7c5c4aa",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "Pedicle; the attachment point for antlers in cervids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
