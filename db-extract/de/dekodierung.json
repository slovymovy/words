                "senses": [
                    {
                        "sense_id": "688a7a17-6ea3-3ed6-a9d5-8e5c3d0c1836",
                        "entry_id": "21e6921b-d625-354c-994b-0a4d3edbeeaa",
                        "glosses": [
                            "Entschlüsselung von Botschaften mit Hilfe eines Codes"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "95236b35-f8e4-499c-9c3f-7a401c023be5",
                                "sense_id": "688a7a17-6ea3-3ed6-a9d5-8e5c3d0c1836",
                                "text": "Durch Dekodierung werden verschlüsselte Botschaften entschlüsselt und damit verstehbar gemacht."
                            },
                            {
                                "example_id": "bbc58d5c-b628-46a1-8b25-3cf3ff7820cf",
                                "sense_id": "688a7a17-6ea3-3ed6-a9d5-8e5c3d0c1836",
                                "text": "„Dieser Hinweis zur Dekodierung kann zum Beispiel mit dem Buchstaben im Alphabet angegeben werden, dessen Buchstabenwert der Anzahl der Schritte entspricht; in diesem Beispiel mit den drei Stellen würde der Schlüssel, passend zu Caesar, dann »C« lauten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5592c3fb-5e72-304c-ae68-26f255e19563",
                        "entry_id": "21e6921b-d625-354c-994b-0a4d3edbeeaa",
                        "glosses": [
                            "Teil eines Kommunikationsmodells: Prozess der Verarbeitung einer Nachricht auf allen sprachlichen Ebenen (phonetisch/phonologisch, grammatisch, semantisch) durch den Hörer oder Leser; Entschlüsselung der aufgenommenen Botschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0face19f-7352-4517-a163-0e577039e1eb",
                                "sense_id": "5592c3fb-5e72-304c-ae68-26f255e19563",
                                "text": "Die Dekodierung einer Nachricht ist Voraussetzung dafür, dass der Hörer oder Leser versteht, was der Sprecher oder Schreiber gemeint hat."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
