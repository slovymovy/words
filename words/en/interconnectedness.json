{
    "word_family": [
        "connect",
        "connection",
        "connected",
        "interconnect",
        "interconnected",
        "interconnection"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2873250-189d-3c55-9655-34810d78099f",
                    "sense_definition": "The state or condition of being interconnected or mutually linked.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linkage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The global economy depends on the <w>interconnectedness</w> of trade networks.",
                            "target_lang_translations": {
                                "ru": "Мировая экономика зависит от <w>взаимосвязанности</w> торговых сетей."
                            }
                        },
                        {
                            "text": "Scientists study the complex <w>interconnectedness</w> of species in the forest.",
                            "target_lang_translations": {
                                "ru": "Учёные изучают сложную <w>взаимосвязь</w> видов в лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "interconnection",
                        "interdependence"
                    ],
                    "antonyms": [
                        "isolation",
                        "separation"
                    ],
                    "common_phrases": [
                        "global interconnectedness",
                        "growing interconnectedness",
                        "complex interconnectedness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние взаимной связи, переплетённости или зависимости между частями единого целого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взаимосвязанность",
                                "target_lang_sense_clarification": "состояние взаимной связи между явлениями или системами"
                            },
                            {
                                "target_lang_word": "взаимосвязь",
                                "target_lang_sense_clarification": "обоюдная связь, соединение"
                            },
                            {
                                "target_lang_word": "взаимозависимость",
                                "target_lang_sense_clarification": "зависимость элементов друг от друга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "037a65d7-35c9-37bf-b2e8-c91e70abce25",
                    "sense_definition": "The philosophical or spiritual concept of a fundamental unity among all living things and the universe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linkage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meditation helped her feel a deep sense of <w>interconnectedness</w> with all life.",
                            "target_lang_translations": {
                                "ru": "Медитация помогла ей ощутить глубокое чувство <w>единства</w> со всем живым."
                            }
                        },
                        {
                            "text": "Many indigenous cultures emphasize the spiritual <w>interconnectedness</w> of nature and humanity.",
                            "target_lang_translations": {
                                "ru": "Многие коренные культуры подчёркивают духовную <w>взаимосвязь</w> природы и человечества."
                            }
                        }
                    ],
                    "synonyms": [
                        "oneness",
                        "unity"
                    ],
                    "antonyms": [
                        "alienation",
                        "separation"
                    ],
                    "common_phrases": [
                        "spiritual interconnectedness",
                        "sense of interconnectedness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Философская или духовная концепция глубинного единства всего живого и вселенной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единство",
                                "target_lang_sense_clarification": "целостность, неразрывная связь всего сущего"
                            },
                            {
                                "target_lang_word": "взаимосвязанность",
                                "target_lang_sense_clarification": "всеобщая духовная или природная связь"
                            },
                            {
                                "target_lang_word": "взаимосвязь",
                                "target_lang_sense_clarification": "глубинное единение элементов мироздания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}