                ],
                "senses": [
                    {
                        "sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
                        "entry_id": "157203be-fc83-3e45-b38e-3e0b0160326a",
                        "glosses": [
                            "Schriftgattung und Schriftart, die im deutschsprachigen Raum eine Druck- oder Screenschrift ist; die lateinische Druckschrift im Gegensatz zur Fraktur"
                        ],
                        "tags": [
                            "Typografie"
                        ],
                        "examples": [
                            {
                                "example_id": "7319593a-9a19-4490-a314-b98fe26689af",
                                "sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
                                "text": "In der westlichen Welt ist die Antiqua die führende Verkehrsschrift."
                            },
                            {
                                "example_id": "df9b948f-7c84-4d18-8024-d034e7ae1785",
                                "sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
                                "text": "Bei der Antiqua sind die Großbuchstaben (Versalien) der römischen Schrift und die Kleinbuchstaben (Gemeine) der karolingischen Minuskel entlehnt."
                            },
                            {
                                "example_id": "f22f4788-7c07-4e57-9bb4-54b5f45948f3",
                                "sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
                                "text": "„Die Frakturschrift und ihre Abwandlungen waren nicht nur in Deutschland neben der Antiqua die hauptsächliche Buch- und Zeitungsschrift, sondern auch bei Polen, Tschechen, Slowaken und in den baltischen und skandinavischen Ländern gebräuchlich.“"
                            },
                            {
                                "example_id": "808edaa7-e650-49e4-83df-9a967df3f78c",
                                "sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
                                "text": "„Es ist die Zeit nach 1941. Diese ist in schriftgestalterischer Hinsicht vom Übergang von der Fraktur zur Antiqua gekennzeichnet, was sich in postalischer Hinsicht am deutlichsten an der Gestaltung der Postwertzeichen festmachen lässt.“"
                            },
                            {
                                "example_id": "edfd0a94-96ae-4a04-a30c-5799d9e56892",
                                "sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
                                "text": "„Stempel schrieb diese Antiqua dem in Leipzig lebenden Friesländer Anton Janson zu.“"
                            },
                            {
                                "example_id": "20b50e41-55e6-4f30-8c68-5e68cc1b8597",
                                "sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
                                "text": "„Fremdsprachige Wörter und Wortgruppen, die nicht durch Schreibung, Beugung oder Lautung als eingedeutscht erscheinen, müssen im Fraktursatz in Antiqua gesetzt werden.“"
                            },
                            {
                                "example_id": "5d462dfe-f7fb-43ff-8577-84b947b6ba01",
                                "sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
                                "text": "„Wie viele zeitgenössische holländische Antiquas ist [die FF Scala] kein Revival einer einzelnen historischen Schrift, sondern zeigt Einflüsse verschiedener Vorbilder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8da2a9d-91c1-4ffe-b0d6-58464cb63385",
                        "source_entry_id": "157203be-fc83-3e45-b38e-3e0b0160326a",
                        "source_sense_id": "e63bcdb9-6d45-354a-98ab-3bfb9e35722b",
