                                        "glosses": [
                                            "In-vitro-Fertilisation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a03f81b-035b-4231-80ec-b66e84a2e719",
                                                "sense_id": "6432c995-eb0f-3641-a857-59efbb79c93f",
                                                "text": "Die IVF ist eine Methode der Reproduktionsmedizin, mit deren Hilfe die Unfruchtbarkeit von Patienten, meist Ehepaare, behandelt werden kann."
                                            }
