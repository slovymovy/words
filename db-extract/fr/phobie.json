                    {
                        "translation_id": "2aadaced-ec0a-451a-ad0f-27576d387958",
                        "source_entry_id": "cccef9cd-3dc4-3659-ad22-9397bc3c1564",
                        "target_lang_word": "фобия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фобия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa954a2-0cb6-3cae-b138-3580b9211ad5",
                                        "entry_id": "84f5b44f-16df-3423-bbb7-1d89a8e95ccf",
                                        "glosses": [
                                            "психиатр. устойчивые патологические проявления различных страхов, разновидность навязчивых состояний"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6256823a-836b-4bb1-8af3-58ecba19587b",
                                                "sense_id": "2aa954a2-0cb6-3cae-b138-3580b9211ad5",
                                                "text": "Эмоциональное запустение, вносимое в психику шизофреническим процессом, наступило в I случае сравнительно быстро, чем и объясняется то обстоятельство, что фобии, постепенно бледнея, приблизительно через 7 месяцев совершенно оставили нашего пациента."
                                            },
                                            {
                                                "example_id": "6b3d75a1-a4b9-440b-9660-f175117456ca",
                                                "sense_id": "2aa954a2-0cb6-3cae-b138-3580b9211ad5",
                                                "text": "Навязчивые состояния — всегда сложное явление, включающее в себе различные элементы; деление собственно на навязчивые идеи, фобии и навязчивые влечения, которого мы держались, имеет raison d'être только в удобствах описания."
                                            },
                                            {
                                                "example_id": "8ff743a7-bd47-4078-92de-5feeeabaf802",
                                                "sense_id": "2aa954a2-0cb6-3cae-b138-3580b9211ad5",
                                                "text": "Существенным признаком невротических фобий является выраженный компонент борьбы с ними."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b464ee75-92dc-33af-8428-1900e6548b87",
                                        "entry_id": "84f5b44f-16df-3423-bbb7-1d89a8e95ccf",
                                        "glosses": [
                                            "(обычно в составе сложных слов) устойчивая неприязнь и ненависть к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a7c39aa-6fc0-4175-9345-01cea77b3ac0",
                        "source_entry_id": "cccef9cd-3dc4-3659-ad22-9397bc3c1564",
                        "target_lang_word": "fobie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fobie",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "51c2ecee-b0eb-3516-a0b8-220e05a566bf",
                                        "entry_id": "e2da0b5a-fd88-3c77-a71d-62e85d0623f4",
                                        "glosses": [
                                            "chorobný strach, úzkost"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546e6ad7-32f3-484b-8f2e-80e49cef3030",
                                                "sense_id": "51c2ecee-b0eb-3516-a0b8-220e05a566bf",
                                                "text": "Podle známého ruského politického komentátora Matveje Ganapolského se Putin prostě ocitl v zajetí fobií. Třeba fobie, že vlast je všude tam, kam došlápne holínka ruského vojáka, že celý svět je Rusku něco dlužen, že můžete zabít každého, kdo je vám trnem v oku, že můžete lhát kdykoli a o čemkoli. Jak se ale Ganapolskij domnívá, nejtěžší Putinovou fobií je, že celá země, její ekonomika, lidská práva a mezinárodní pověst se dají obětovat ve jménu patologické touhy jediného člověka nadobro se stát doživotním prezidentem. A právě tahle fobie je pro Rusko obzvlášť nebezpečná."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
