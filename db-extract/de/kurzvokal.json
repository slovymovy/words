                ],
                "senses": [
                    {
                        "sense_id": "ed645cad-5cd9-3dda-9609-0905315cf4da",
                        "entry_id": "1e374b20-1680-3061-a594-09808c3bd96d",
                        "glosses": [
                            "Vokal, dessen Aussprachedauer im Verhältnis zu Langvokalen kürzer ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea87a29c-2a0b-4318-88ec-d6565247d32b",
                                "sense_id": "ed645cad-5cd9-3dda-9609-0905315cf4da",
                                "text": "Kurzvokale unterscheiden sich von Langvokalen dadurch, dass sie kürzer ausgesprochen werden."
                            },
                            {
                                "example_id": "d339f89d-165e-4bf4-a859-99a9c5546d0f",
                                "sense_id": "ed645cad-5cd9-3dda-9609-0905315cf4da",
                                "text": "Der Vokal in \"Bett\" ist ein Kurzvokal, der in \"Beet\" ein Langvokal."
                            },
                            {
                                "example_id": "9f4fe554-3b93-4b6c-b719-425806c2a8bb",
                                "sense_id": "ed645cad-5cd9-3dda-9609-0905315cf4da",
                                "text": "„In dieser Position sind im Deutschen ursprüngliche Kurzvokale zu langen Vokalen geworden…“"
                            },
                            {
                                "example_id": "43abac80-a6d0-4fd1-b3d7-e89c86ff18af",
                                "sense_id": "ed645cad-5cd9-3dda-9609-0905315cf4da",
                                "text": "„Beim Vokalismus werden drei Teilsysteme, nämlich Kurzvokale, Langvokale und Diphthonge, unterschieden.“"
                            },
                            {
                                "example_id": "24441720-665e-4cb0-bc03-ee1e08c7873c",
                                "sense_id": "ed645cad-5cd9-3dda-9609-0905315cf4da",
                                "text": "„Die Parallelen zum Deutschen in bezug auf die allophonischen Realisierungen von Kurz- und Langvokalen (in Haupttonsilben) liegen auf der Hand: Die Langvokale sind immer gespannt, während die Kurzvokale meist ungespannt oder zentralisiert sind.“"
                            },
                            {
                                "example_id": "c76ff634-8a42-4379-be3c-ad11d574bd74",
                                "sense_id": "ed645cad-5cd9-3dda-9609-0905315cf4da",
                                "text": "„In Fremdwörtern kommen Kurzvokale vor, die im Vergleich mit den Kurzvokalen der deutschen Erbwörter geschlossener (gespannt) artikuliert werden und dadurch in unseren Ohren wie Langvokale klingen.“"
                            },
                            {
                                "example_id": "95742162-57ce-4144-8ee2-dbe159823d75",
                                "sense_id": "ed645cad-5cd9-3dda-9609-0905315cf4da",
                                "text": "„Übersehen werden zumeist die Kurzvokale, die aber entscheidend sind für die Rechtschreibung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
