                                        "glosses": [
                                            "Geschäft für Tee und Teezubehör"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e27c60f9-067b-3b0e-bd38-44cf20bf618b",
                                        "entry_id": "02a004c2-01b9-363b-a2be-21054cb09200",
                                        "glosses": [
                                            "Pavillon für den zeremoniellen Teegenuss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af7cf35-2a75-454c-820d-bd69ddca3c2f",
                                                "sense_id": "e27c60f9-067b-3b0e-bd38-44cf20bf618b",
                                                "text": "In China gibt es viele Teehäuser."
                                            }
                                        ],
