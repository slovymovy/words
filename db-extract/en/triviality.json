                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "65bb916a-e80d-385a-b7e9-8adc9ab44d28",
                                        "entry_id": "9160e3c5-881e-3efd-b228-7e190b3d562c",
                                        "glosses": [
                                            "używany dla podkreślenia znikomości liczby, ilości, kosztu, pracy, trudu itp."
                                        ],
