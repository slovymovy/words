    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "21e65371-527c-3a1b-b28a-61e2b144fa3e",
                    "sense_definition": "intimidated, bullied, or subjugated by someone in authority",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subjugation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The employees looked completely <w>browbeaten</w> after the aggressive meeting with their demanding supervisor.",
                            "target_lang_translations": {
                                "it": "I dipendenti sembravano completamente <w>intimiditi</w> dopo l'aggressiva riunione con il loro esigente supervisore."
                            }
                        },
                        {
                            "text": "He lived in fear of displeasing his father and grew up feeling quiet and <w>browbeaten</w>.",
                            "target_lang_translations": {
                                "it": "Viveva nel timore di dispiacere a suo padre ed è cresciuto sentendosi taciturno e <w>sottomesso</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidated",
                        "cowed",
                        "bullied",
                        "oppressed"
                    ],
                    "common_phrases": [
                        "look browbeaten",
                        "feel browbeaten"
                    ],
                    "target_lang_definitions": {
                        "it": "Intimidito, maltrattato o sottomesso da qualcuno che esercita un'autorità."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "intimidito",
                                "target_lang_sense_clarification": "reso insicuro o impaurito con minacce o arroganza"
                            },
                            {
                                "target_lang_word": "soggiogato",
                                "target_lang_sense_clarification": "sottomesso moralmente o psicologicamente"
                            },
                            {
                                "target_lang_word": "vessato",
                                "target_lang_sense_clarification": "tormentato o maltrattato continuamente"
                            },
                            {
                                "target_lang_word": "sottomesso",
                                "target_lang_sense_clarification": "ridotto all'obbedienza forzata"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "061704fe-81c2-36cb-957a-3bb7101d77e8",
                    "sense_definition": "past participle of <w>browbeat</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subjugation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect claimed that detectives had <w>browbeaten</w> him into signing a false confession.",
                            "target_lang_translations": {
                                "it": "Il sospettato ha sostenuto che i detective lo avevano <w>intimidito</w> fino a fargli firmare una falsa confessione."
                            }
                        },
                        {
                            "text": "She was not the kind of person who could easily be <w>browbeaten</w> by aggressive colleagues.",
                            "target_lang_translations": {
                                "it": "Non era il tipo di persona che potesse essere facilmente <w>sopraffatta</w> da colleghi aggressivi."
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidated",
                        "badgered",
                        "bullied"
                    ],
                    "common_phrases": [
                        "be browbeaten into"
                    ],
                    "target_lang_definitions": {
                        "it": "Participio passato di browbeat: intimidito, sopraffatto con arroganza."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "intimidito",
                                "target_lang_sense_clarification": "spinto a cedere attraverso minacce o aggressività"
                            },
                            {
                                "target_lang_word": "tormentato",
                                "target_lang_sense_clarification": "assillato o costretto con insistenza aggressiva"
                            },
                            {
                                "target_lang_word": "sopraffatto",
                                "target_lang_sense_clarification": "messo a tacere con modi prepotenti"
                            }
                        ]
                    }
                }
            ]
        }
    ]
