                        "entry_id": "dc99955c-d9eb-30e3-af52-a6f13f6c5594",
                        "glosses": [
                            "geneigd tot het verlenen van zorg aan anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed692a6-88a0-4158-bc6c-599b9b9bf625",
                                "sense_id": "59e97c67-7eaf-3556-bab8-7e0de8b195b4",
                                "text": "De zorgzame verpleegkunde was zeer vriendelijk tegen haar oude patiënt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fd43c1f-0b0a-40cd-8981-9f01cdb1a84e",
