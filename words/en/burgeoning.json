            "senses": [
                {
                    "sense_id": "08735de6-907f-3d53-90ce-c2c3d39997f7",
                    "sense_definition": "Growing, expanding, or developing rapidly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city struggled to support its <w>burgeoning</w> population with adequate public transport.",
                            "target_lang_translations": {
                                "de": "Die Stadt hatte Mühe, ihre <w>rasch wachsende</w> Bevölkerung mit ausreichend öffentlichen Verkehrsmitteln zu versorgen."
                            }
                        },
                        {
                            "text": "Many small startups are finding success in the <w>burgeoning</w> market for clean energy.",
                            "target_lang_translations": {
                                "de": "Viele kleine Start-ups haben Erfolg im <w>boomenden</w> Markt für saubere Energie."
                            }
                        }
