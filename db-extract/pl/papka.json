                ],
                "senses": [
                    {
                        "sense_id": "ac937a56-0fa9-347f-9433-0106c677a8c1",
                        "entry_id": "1e1ca8d7-c689-387f-9e85-813a50f35d3b",
                        "glosses": [
                            "półpłynna, miękka, gęsta masa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d3d7a0-67d7-4f08-b009-003383d4439f",
                                "sense_id": "ac937a56-0fa9-347f-9433-0106c677a8c1",
                                "text": "Na śniadanie dostaliśmy gęstą, kleistą papkę przygotowaną z mąki kukurydzianej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cdfff6f-df55-4f88-a40a-33b8f7e579f4",
                        "source_entry_id": "1e1ca8d7-c689-387f-9e85-813a50f35d3b",
                        "source_sense_id": "ac937a56-0fa9-347f-9433-0106c677a8c1",
                        "target_lang_word": "кашица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кашица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f271e777-dd5f-35b2-be80-f151541687a9",
                                        "entry_id": "c6c276cf-7271-367b-869d-6d6c615e1501",
                                        "glosses": [
                                            "жидкая каша"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed275874-44d9-4107-8a76-e70d9cea7ad2",
                                                "sense_id": "f271e777-dd5f-35b2-be80-f151541687a9",
                                                "text": "На большие столы без скатертей поставили по нескольку деревянных крашеных и золоченых мисок с жидкою пшенною кашицею; больные уселись на лавки; им роздали по ломтю черного хлеба."
                                            },
                                            {
                                                "example_id": "59dd6f6c-5ef3-4243-aa0b-081529e3ab90",
                                                "sense_id": "f271e777-dd5f-35b2-be80-f151541687a9",
                                                "text": "От нее мог произойти только нежнейший запах рисовой кашицы или вкусно изготовленного сена, которым госпожа Нордман-Северова так долго кормила знаменитого художника Илью Репина."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf85293-f49b-30a9-982e-20ff137d1175",
                                        "entry_id": "c6c276cf-7271-367b-869d-6d6c615e1501",
                                        "glosses": [
                                            "полужидкая, вязкая масса, смесь из каких-либо веществ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c021084-e640-46f7-ae35-ba4072a20901",
                                                "sense_id": "0cf85293-f49b-30a9-982e-20ff137d1175",
                                                "text": "Для того чтобы знать, сколько находится сухой окиси ртути в кашице, получаемой при промывании отстаиванием и сливанием, взвешенное количество ее подвергается выпариванию досуха, и остаток сухой окиси взвешивается."
                                            },
                                            {
                                                "example_id": "074fbcf5-fe58-498e-8afb-31d03b7bf270",
                                                "sense_id": "0cf85293-f49b-30a9-982e-20ff137d1175",
                                                "text": "Очистить средней величины яблоко, нарезать кубиками и сварить в небольшом количестве молока до образования густой кашицы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
