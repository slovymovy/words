                                    {
                                        "sense_id": "6fb26b72-344e-3d9b-b4b2-a30a66aa6b52",
                                        "entry_id": "dcd6bb8c-06dc-3731-87a1-f23c87b4d53c",
                                        "glosses": [
                                            "The narrow strait beside Istanbul, Turkey connecting the Black Sea to the Sea of Marmara, the northern end of the Turkish Straits connecting the Black Sea with the Aegean and Mediterranean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7232405c-474c-4034-9ff2-8793079af827",
                                                "sense_id": "6fb26b72-344e-3d9b-b4b2-a30a66aa6b52",
                                                "text": "The 20-min. crossing of the Bosphorus by ferry steamer from the Golden Horn, the busy river-fed harbour that divides old and new Istanbul on the European side of the Bosphorus, was a pleasure in itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "365510a3-ce5a-402a-8dd1-9180810e5c0c",
                        "source_entry_id": "4f8a233a-2cd2-3e40-aa23-78e762c7b125",
                        "source_sense_id": "873f3602-d030-3e98-bcf5-ce4fbdc1fae2",
                        "source_sense_description": "Meerenge zwischen Schwarzem und Marmarameer",
                        "target_lang_word": "Bosphore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bosphore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b3bc1d7-fda6-3b29-be39-4e8ccc4f2b9e",
                                        "entry_id": "0493d862-5663-3732-a76c-dab9828b7911",
                                        "glosses": [
                                            "Détroit qui relie la mer Noire à la mer de Marmara et marque, avec les Dardanelles, la limite entre l’Europe et l’Asie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7bbd511-f4e8-49b7-b1c1-d797829dc3ef",
                                                "sense_id": "7b3bc1d7-fda6-3b29-be39-4e8ccc4f2b9e",
                                                "text": "À partir de cet endroit, la mer s'élargit pour se resserrer de nouveau ; la partie large s'appelle Propontide, le nouveau détroit, Bosphore de Thrace."
                                            },
                                            {
                                                "example_id": "2534b9a9-3dd7-4ab5-b742-fbcace60e273",
                                                "sense_id": "7b3bc1d7-fda6-3b29-be39-4e8ccc4f2b9e",
                                                "text": "De telles expériences seraient très risquées au Bosphore, l’homme-grenouille pouvant être entraîné par les courants très forts existant en ce détroit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60682b6c-1a37-316f-9693-b451688361cb",
                                        "entry_id": "0493d862-5663-3732-a76c-dab9828b7911",
                                        "glosses": [
                                            "Ancien nom du détroit de Kertch qui relie la mer Noire à la mer d'Azov."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe0c7a8c-1962-4d97-bc7a-26f13caa14e2",
                                                "sense_id": "60682b6c-1a37-316f-9693-b451688361cb",
                                                "text": "Il communique avec l'ouverture du Palus-Méotide. Cette ouverture s'appelle Bosphore Cimmérien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6660ebfa-4fd0-323d-beff-596a3c613842",
                                        "entry_id": "0493d862-5663-3732-a76c-dab9828b7911",
                                        "glosses": [
                                            "Royaume grec antique établi sur les rives du détroit de Kertch."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72f1d8c-2f41-4462-ac69-2b35da983505",
                                                "sense_id": "6660ebfa-4fd0-323d-beff-596a3c613842",
                                                "text": "Le royaume du Bosphore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
