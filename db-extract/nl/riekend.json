                        "examples": [
                            {
                                "example_id": "5924639e-ce84-46d3-bd83-cdc96e585204",
                                "sense_id": "9fae9595-147a-365d-8f4f-5262e9a4a0ca",
                                "text": "Witoorpenseelaapjes hebben daarnaast de natuurlijke gewoonte om de hele dag hun territorium af te bakenen met stinkende urine, schetst Van Gennep. ,,En als ze opgewonden of bang zijn kunnen ze je besproeien met een flinke straal van die riekende plas."
                            },
                            {
                                "example_id": "9c11a569-d5f0-4937-9475-bd1cc495764c",
                                "sense_id": "9fae9595-147a-365d-8f4f-5262e9a4a0ca",
                                "text": "Een rel rond een mobiel mortuarium, in werkelijkheid een smerig riekende vrachtwagentrailer vol doden van crimineel geweld, heeft in Mexico de kop gekost aan twee hoge functionarissen."
                            }
                        ]
                    },
                    {
                        "sense_id": "34a2f271-3185-310d-a718-7caadd0223d1",
                        "entry_id": "989b9650-7c71-3cc7-8ad2-3057421003de",
