                ],
                "senses": [
                    {
                        "sense_id": "949dc3ea-2b70-3ae8-9490-aa7b98b4c642",
                        "entry_id": "835c1b8d-df6f-369f-b742-1c0ce8927d76",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17bff672-dafc-4c2d-a77b-b035b12b2f50",
                                "sense_id": "949dc3ea-2b70-3ae8-9490-aa7b98b4c642",
                                "text": "Frau Raabe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "99e17101-ac7e-4806-88b7-d0f8e60c85e0",
                                "sense_id": "949dc3ea-2b70-3ae8-9490-aa7b98b4c642",
                                "text": "Herr Raabe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0075d245-5124-4677-81e4-30a3a75a1802",
                                "sense_id": "949dc3ea-2b70-3ae8-9490-aa7b98b4c642",
                                "text": "Die Raabes fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "2dd14419-8f02-4595-9924-3f73baf24fe4",
                                "sense_id": "949dc3ea-2b70-3ae8-9490-aa7b98b4c642",
                                "text": "Der Raabe trägt nie die Pullover, die die Raabe ihm strickt."
                            },
                            {
                                "example_id": "713a7294-74a3-4ba5-b3d9-86938d820790",
                                "sense_id": "949dc3ea-2b70-3ae8-9490-aa7b98b4c642",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Raabe kommt, geht der Herr Raabe.“"
                            },
                            {
                                "example_id": "11790378-3c7a-426e-82c4-95badaaa17b6",
                                "sense_id": "949dc3ea-2b70-3ae8-9490-aa7b98b4c642",
                                "text": "Raabe kommt und geht."
                            },
                            {
                                "example_id": "8cf71a5a-6b64-49bb-9748-82088b54cd5a",
                                "sense_id": "949dc3ea-2b70-3ae8-9490-aa7b98b4c642",
                                "text": "Raabes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
