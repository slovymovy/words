{
    "word_family": [
        "plaideur",
        "plaidoirie",
        "plaidoyer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "997ad94a-0e5d-3a67-a02f-f434f708f429",
                    "sense_definition": "Défendre, appuyer ou soutenir vigoureusement une idée, un projet ou une cause.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette organisation non gouvernementale <w>plaide</w> pour un meilleur accès aux soins médicaux."
                        },
                        {
                            "text": "Le directeur est venu en personne <w>plaider</w> la cause de son équipe auprès des investisseurs."
                        }
                    ],
                    "synonyms": [
                        "défendre",
                        "soutenir"
                    ],
                    "antonyms": [
                        "combattre"
                    ],
                    "common_phrases": [
                        "plaider la cause",
                        "plaider en faveur de"
                    ]
                },
                {
                    "sense_id": "2aefe0c1-6e58-333b-b958-a361e9d42732",
                    "sense_definition": "Défendre oralement les droits ou les intérêts d'une personne devant un juge ou un tribunal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune juriste a pu <w>plaider</w> devant le tribunal pour la toute première fois."
                        },
                        {
                            "text": "Une avocate brillante a été engagée afin de <w>plaider</w> pour cet accusé."
                        }
                    ],
                    "synonyms": [
                        "défendre"
                    ],
                    "common_phrases": [
                        "plaider un dossier",
                        "plaider devant le tribunal"
                    ]
                },
                {
                    "sense_id": "53230498-4aa7-3ed2-9014-af5a171abdbb",
                    "sense_definition": "Déclarer formellement sa position ou faire valoir un argument juridique déterminé lors d'un procès.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a choisi de <w>plaider</w> coupable pour espérer une réduction de peine."
                        },
                        {
                            "text": "Son avocat va sans doute <w>plaider</w> la légitime défense au cours de l'audience."
                        }
                    ],
                    "common_phrases": [
                        "plaider coupable",
                        "plaider non coupable"
                    ]
                },
                {
                    "sense_id": "60ce8059-0741-39c5-846a-06dfb6f90277",
                    "sense_definition": "Être en procès ou engager des poursuites judiciaires contre quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux voisins <w>plaident</w> depuis des années au sujet de la propriété d'un terrain."
                        },
                        {
                            "text": "Il a perdu une fortune à <w>plaider</w> contre ses anciens associés."
                        }
                    ],
                    "synonyms": [
                        "litigier",
                        "procéder"
                    ]
                }
            ]
        }
    ]
}