                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a3f7855-bbae-4e73-9f63-d99228705db9",
                                "sense_id": "c6d52d2f-29e7-3f78-9960-877870f9edc8",
                                "text": "„Nach Neujahr 1940 setzte eine lange, strenge Frostperiode ein, wie sie sich die lebende Generation nicht mehr erinnern konnte.“"
                            },
                            {
                                "example_id": "89c04089-ec81-438e-9117-aad3c5bdfe73",
                                "sense_id": "c6d52d2f-29e7-3f78-9960-877870f9edc8",
                                "text": "„Die Frostperiode dauert mittlerweile bereits so lange, dass die Vorräte an Tausalz und Rollsplit in den US-Lagern zur Neige gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
