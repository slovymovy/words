                "senses": [
                    {
                        "sense_id": "dab8425d-26ac-3421-b2a5-d21672c1c71b",
                        "entry_id": "71916fc2-c263-39ed-abf2-aea635eb6ef8",
                        "glosses": [
                            "Reaktion des Körpers auf Fremdkörper (auch Allergene), besonders auf die Infizierung mit krankheitsauslösenden Mikroorganismen, Viren, Bakterien, Parasiten, Pilzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf086052-245f-43c0-a60b-0fd46de5e433",
                                "sense_id": "dab8425d-26ac-3421-b2a5-d21672c1c71b",
                                "text": "„Als humorale Immunantwort bezeichnet man den Teil der Immunreaktion, der durch nicht-zelluläre Bestandteile in Körperflüssigkeiten (Blut, Lymphflüssigkeit…) vermittelt wird. Die humorale, antikörpervermittelte Immunantwort läuft grob in drei Phasen ab.“"
                            },
                            {
                                "example_id": "807a3899-90be-4c7d-899f-4934839b9066",
                                "sense_id": "dab8425d-26ac-3421-b2a5-d21672c1c71b",
                                "text": "„Spezifität und Diversität des Immunsystems und damit der [zellulären] Immunantwort sind abhängig von Rezeptoren auf den B- und T-Lymphocyten, die diese Zellen in die Lage versetzen, ein bestimmtes Antigen zu erkennen und darauf zu reagieren.“"
                            },
                            {
                                "example_id": "8f50f812-e714-4e6e-a0f5-4b9024d38cae",
                                "sense_id": "dab8425d-26ac-3421-b2a5-d21672c1c71b",
                                "text": "„Frauen bilden effektiver Antikörper, bei Impfungen fällt ihre Immunantwort daher stärker aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
