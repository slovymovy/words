                "senses": [
                    {
                        "sense_id": "88c32a2d-731e-3a89-8429-f433668ab6ec",
                        "entry_id": "213217dc-0016-3d4d-bd55-6a2b13859ea4",
                        "glosses": [
                            "An arrival at the shore by a ship, or sighting of the shore from a ship."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "03448d71-8e53-4cef-a30e-e1e26de4050d",
                                "sense_id": "88c32a2d-731e-3a89-8429-f433668ab6ec",
                                "text": "Lighthouses are usually the first aids seen when making landfall."
                            },
                            {
                                "example_id": "a6fe7fc4-830e-4392-8561-7c77729963f3",
                                "sense_id": "88c32a2d-731e-3a89-8429-f433668ab6ec",
                                "text": "We made landfall at the most god-forsaken, barren, desolate, and hellish location possible to image; and we were grateful, anything to get off that ship!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e3ed7027-9715-3b39-b2d6-e0e4dff0a34c",
                        "entry_id": "213217dc-0016-3d4d-bd55-6a2b13859ea4",
                        "glosses": [
                            "The point at which a hurricane or similar storm reaches land."
