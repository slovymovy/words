                    {
                        "translation_id": "843b40fc-4036-485b-aec2-fe31a6100e95",
                        "source_entry_id": "6c8258f0-16b6-34f9-ac22-3f4f38ad3412",
                        "source_sense_id": "593b6825-e082-3dfd-b424-2bb84869826b",
                        "target_lang_word": "rigueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                        "entry_id": "3f82d068-b1c2-382e-90a0-73f80ee0e7a8",
                                        "glosses": [
                                            "Sévérité inflexible, dureté, austérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fffd381-b841-4c0f-93d1-2e47b189da19",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Grande, extrême, insupportable rigueur."
                                            },
                                            {
                                                "example_id": "df55128a-7ab1-41cb-85b1-7037a4ebec37",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Vous me traitez avec la dernière rigueur, avec trop de rigueur."
                                            },
                                            {
                                                "example_id": "2eb24b2f-31da-4f61-93fc-81f842d34cdb",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Tenir rigueur à quelqu’un."
                                            },
                                            {
                                                "example_id": "53587b9a-526a-4807-8bb0-a33b2b34e52d",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Avoir trop de rigueur pour quelqu’un."
                                            },
                                            {
                                                "example_id": "fa6682fb-97a2-4c86-ad26-e68de0705cd9",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "User de rigueur à l’égard de quelqu’un, envers quelqu’un."
                                            },
                                            {
                                                "example_id": "8fc39563-c7e5-4ae9-be40-86f7b298b3c3",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "La rigueur d’une peine, d’une condamnation."
                                            },
                                            {
                                                "example_id": "a3f0eed7-c9d0-48aa-814e-375646889761",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Les rigueurs d’une prison."
                                            },
                                            {
                                                "example_id": "6481bceb-3ed8-43e4-acbf-59c5503dae4c",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Elle sortit du couvent, parce qu’elle ne put supporter la rigueur de la règle."
                                            },
                                            {
                                                "example_id": "15dd8f36-7752-4b30-af0c-49cfe40abd81",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Un châtiment d’une extrême rigueur."
                                            },
                                            {
                                                "example_id": "c31626c0-ea3b-47d9-bf86-784d66aa4ea2",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "La rigueur du destin."
                                            },
                                            {
                                                "example_id": "8d15312c-bfcb-4f34-ac28-dab20fb8da93",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Les rigueurs du sort."
                                            },
                                            {
                                                "example_id": "f53e5d1c-496b-4b26-b708-f0be171bff94",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Il se plaint des rigueurs de cette femme."
                                            },
                                            {
                                                "example_id": "9990941a-66d9-411b-9b12-fb0c160231fa",
                                                "sense_id": "0134d58e-5ed4-38fe-927a-c990be46e623",
                                                "text": "Il faut y rajouter sa politique de rigueur budgétaire, adoptée par le gouvernement allemand pour se prémunir de la logique de l’endettement et de déficit excessifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb980f48-03a1-3d88-9fd1-e1e7e74f9190",
                                        "entry_id": "3f82d068-b1c2-382e-90a0-73f80ee0e7a8",
                                        "glosses": [
                                            "Température de dureté, d'âpreté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "205af26b-ef00-4f16-8671-89df59176a4d",
                                                "sense_id": "fb980f48-03a1-3d88-9fd1-e1e7e74f9190",
                                                "text": "Les atlantiques se sont répandues dans les plaines, mais restent arrêtées par la rigueur des hivers."
                                            },
                                            {
                                                "example_id": "0ee485c8-d75d-44ed-aa37-85767bae1dcb",
                                                "sense_id": "fb980f48-03a1-3d88-9fd1-e1e7e74f9190",
                                                "text": "La rigueur de la saison."
                                            },
                                            {
                                                "example_id": "8a80a102-0525-46a2-b14c-882bc7ebe36e",
                                                "sense_id": "fb980f48-03a1-3d88-9fd1-e1e7e74f9190",
                                                "text": "La rigueur du climat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                        "entry_id": "3f82d068-b1c2-382e-90a0-73f80ee0e7a8",
                                        "glosses": [
                                            "Exactitude inflexible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75ddaafa-97c0-47f8-94b6-b55fc7ced7e6",
                                                "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                                "text": "Les juges sont obligés de suivre la rigueur des lois."
                                            },
                                            {
                                                "example_id": "cb252d9c-c7b9-4fb3-85e2-7f20e3c02ca1",
                                                "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                                "text": "Juger suivant la rigueur des lois."
                                            },
                                            {
                                                "example_id": "debd3013-90c3-4d7e-b3c1-5b412780c44e",
                                                "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                                "text": "Tempérer, adoucir la rigueur des lois."
                                            },
                                            {
                                                "example_id": "b6c1e311-1067-496d-9e83-1f043595d196",
                                                "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                                "text": "La rigueur des règles."
                                            },
                                            {
                                                "example_id": "41279c4d-919b-463c-b38e-3abe85d1038e",
                                                "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                                "text": "La rigueur d’un raisonnement."
                                            },
                                            {
                                                "example_id": "eb373daf-dc24-4a48-a518-628833e94cb0",
                                                "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                                "text": "Terme, délai de rigueur, Terme, délai au- delà duquel aucune prolongation ne sera accordée."
                                            },
                                            {
                                                "example_id": "a6f28f54-187d-41f5-9d7e-dbf1ad69949d",
                                                "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                                "text": "Cette chose est de rigueur, Elle est indispensable."
                                            },
                                            {
                                                "example_id": "ae6a47f1-a91b-471e-8be5-a88839eb989b",
                                                "sense_id": "7d822488-47de-3400-9a67-8f62b6c32921",
                                                "text": "L’habit est de rigueur à cette cérémonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
