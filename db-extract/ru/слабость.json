                ],
                "senses": [
                    {
                        "sense_id": "4467f4d7-0bad-33c8-b6af-1920ebdc5a7c",
                        "entry_id": "89bdca16-7f7a-3d31-b3a6-1fde3eb9c121",
                        "glosses": [
                            "свойство или состояние по значению прилагательного слабый (особенно применительно к живому существу — недостаток физических сил, энергии)"
                        ],
                        "tags": [
                            "только ед."
                        ],
                        "examples": [
                            {
                                "example_id": "fd81cba4-759a-496b-ae7a-7d8d9f60abc2",
                                "sense_id": "4467f4d7-0bad-33c8-b6af-1920ebdc5a7c",
                                "text": "Количественная военная слабость на Дальнем Востоке ― в особенности военно-морская (15–20 лет)."
                            },
                            {
                                "example_id": "17444642-373b-4707-9d34-404147a03889",
                                "sense_id": "4467f4d7-0bad-33c8-b6af-1920ebdc5a7c",
                                "text": "И грипп меня оставил. Только слабость — руки не поднять."
                            }
                        ]
                    },
                    {
                        "sense_id": "43336a19-7b5e-389d-ae89-a9dd12ba0956",
                        "entry_id": "89bdca16-7f7a-3d31-b3a6-1fde3eb9c121",
                        "glosses": [
                            "перен. недостаточная твёрдость (в организации и осуществлении задуманного и т. п.)"
                        ],
                        "tags": [
                            "только ед."
                        ],
                        "examples": [
                            {
                                "example_id": "8f6c08df-62b0-4a42-b108-15785d1f72b9",
                                "sense_id": "43336a19-7b5e-389d-ae89-a9dd12ba0956",
                                "text": "Он проявляет слабость в этом деле."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e1fde41-c8a3-3f60-93f1-0d05aeb8c345",
                        "entry_id": "89bdca16-7f7a-3d31-b3a6-1fde3eb9c121",
                        "glosses": [
                            "разг. перен. пристрастие, влечение, наклонность, симпатия, которую трудно преодолеть; объект этого пристрастия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2529f7e6-7b1e-4233-ac59-28f9d086dac2",
                                "sense_id": "9e1fde41-c8a3-3f60-93f1-0d05aeb8c345",
                                "text": "Я знал о слабости прекрасного пола к Савке и знал, как он неохотно говорил о ней, а потому не продолжал своего допроса."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d60f91fc-07e8-44a9-8480-26bc4c72c93f",
                        "source_entry_id": "89bdca16-7f7a-3d31-b3a6-1fde3eb9c121",
                        "target_lang_word": "weakness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weakness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf62c1ad-7cdb-3dc5-89ae-9868969c3972",
                                        "entry_id": "ba773e2e-a9ba-3c50-9f10-a05a2b3fcf3b",
                                        "glosses": [
                                            "The condition of being weak."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "709aee5d-bb55-43ac-84df-fab26df812a5",
                                                "sense_id": "cf62c1ad-7cdb-3dc5-89ae-9868969c3972",
                                                "text": "Near-synonyms: debility, frailty, vulnerability; vincibility"
                                            },
                                            {
                                                "example_id": "a437495d-6c64-4e54-833d-b1ab903abc18",
                                                "sense_id": "cf62c1ad-7cdb-3dc5-89ae-9868969c3972",
                                                "text": "In a small number of horses, muscle weakness may progress to paralysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c811d018-84c5-3adf-aa53-a0a99342ec6f",
                                        "entry_id": "ba773e2e-a9ba-3c50-9f10-a05a2b3fcf3b",
                                        "glosses": [
                                            "An inadequate quality; fault."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88afc5dd-7121-4978-abd7-b97342343b2c",
                                                "sense_id": "c811d018-84c5-3adf-aa53-a0a99342ec6f",
                                                "text": "His inability to speak in front of an audience was his weakness."
                                            },
                                            {
                                                "example_id": "1568eabd-6c6b-40be-a520-5c52857e92df",
                                                "sense_id": "c811d018-84c5-3adf-aa53-a0a99342ec6f",
                                                "text": "The only weakness in her plan was its reliance on the electricity being up and running."
                                            },
                                            {
                                                "example_id": "41e51333-8a44-43b2-97be-797095ec7f99",
                                                "sense_id": "c811d018-84c5-3adf-aa53-a0a99342ec6f",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen. No one queried it. It was in the classic pattern of human weakness, mean and embarrassing and sad."
                                            },
                                            {
                                                "example_id": "3798e124-0445-4315-927e-ca7b8cdc2fc5",
                                                "sense_id": "c811d018-84c5-3adf-aa53-a0a99342ec6f",
                                                "text": "Bradford had preyed on Villa's inability to defend set pieces, corners in particular, in their first-leg win and took advantage of the weakness again as Hanson equalised to restore their two-goal aggregate lead."
                                            },
                                            {
                                                "example_id": "875688e3-c30a-4b39-8dbc-bfbe881cdc8b",
                                                "sense_id": "c811d018-84c5-3adf-aa53-a0a99342ec6f",
                                                "text": "The compulsion to expose, renegotiate, or reinvent the strengths and weaknesses of dance tradition offers little in its final outcome to attract the average dance-goer."
                                            },
                                            {
                                                "example_id": "c34c3ff1-098c-4b7b-8bd4-bcbf7eccce38",
                                                "sense_id": "c811d018-84c5-3adf-aa53-a0a99342ec6f",
                                                "text": "Such a male-dominated environment is also likely to contribute to the lingering presence of an outdated belief that expressing feelings and demonstrating emotion is a sign of weakness, deterring some men from discussing their problems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dad797c-d116-39c2-b843-4e23c71b420f",
                                        "entry_id": "ba773e2e-a9ba-3c50-9f10-a05a2b3fcf3b",
                                        "glosses": [
                                            "A special fondness or obsessing desire."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2e13932-9d15-4fbd-8371-295abdf5df71",
                                                "sense_id": "4dad797c-d116-39c2-b843-4e23c71b420f",
                                                "text": "She is an athlete who has a weakness for chocolate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef6051d6-2692-4a6c-a523-430f729da7bf",
                        "source_entry_id": "89bdca16-7f7a-3d31-b3a6-1fde3eb9c121",
                        "target_lang_word": "Schwäche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwäche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "mangelnde körperliche oder geistige Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4057b4a-6120-4b59-895c-f424d19b1b53",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "Mich überkam plötzlich eine unerklärliche Schwäche in den Beinen."
                                            },
                                            {
                                                "example_id": "38775ebb-8556-4968-b538-df9495bfbd74",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Wobei ich eine klitzekleine Schwäche habe, die ich den Damen gern verschweige.“"
                                            },
                                            {
                                                "example_id": "6d99c57e-2a2d-4df2-a74c-807093a9b6a7",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Allgemeine Schwäche des Körpers und erhöhte Reizbarkeit des Nervensystems gesellen sich dazu.“"
                                            },
                                            {
                                                "example_id": "867dee60-c3ac-4dbb-aa75-25fae341ac8d",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Meine Schwäche ist wie weggeblasen.“"
                                            },
                                            {
                                                "example_id": "69ee443b-1417-461c-aed3-2dd30c8a8259",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "[Covid-19-Erkrankungen:] „Andere Genesene leiden unter einem Taubheitsgefühl, Schwäche und Gedächtniseinschränkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bfe74d3-0a00-3352-9c54-fc41f4caba5a",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "charakterlicher Mangel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8faae0-9017-4c24-8858-e56f63d34ea9",
                                                "sense_id": "5bfe74d3-0a00-3352-9c54-fc41f4caba5a",
                                                "text": "Mangelnder Einsatzwille ist keine Schwäche von ihm."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45dd42d1-6602-3255-b38f-426ccae9eb59",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "besondere Neigung zu etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de28c156-b7e8-4512-b221-e7e364694eb3",
                                                "sense_id": "45dd42d1-6602-3255-b38f-426ccae9eb59",
                                                "text": "Er hat eine Schwäche für dunkle Schokolade."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "sachliche Unvollkommenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a97410-90d0-42ab-9170-41197bf05ba6",
                                                "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                                "text": "Die Literaturkritiker versuchen, die Schwächen literarischer Werke herauszufinden."
                                            },
                                            {
                                                "example_id": "8f4b0b50-764a-4d76-bec9-c288d966b321",
                                                "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                                "text": "„Die Schwäche des E-Autos liegt darin, dass es so viel mehr mineralische Rohstoffe benötigt als die Verbrenner, darunter etliche kritische Materialien, die oft unter fragwürdigen Bedingungen abgebaut werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
