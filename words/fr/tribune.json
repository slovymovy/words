    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2ea7083-44ca-3a20-8c71-01f5ea5fbf46",
                    "sense_definition": "Estrade ou pupitre surélevé d'où une personne s'adresse à une assemblée ou à un auditoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eloquence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le député est monté à la <w>tribune</w> pour présenter son nouveau projet de loi."
                        },
                        {
                            "text": "Le conférencier a parlé pendant une heure depuis la <w>tribune</w> de l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "estrade",
                        "podium"
                    ],
                    "common_phrases": [
                        "monter à la tribune",
                        "discours de tribune"
                    ]
                },
                {
                    "sense_id": "e1fb2490-8d26-321e-9b37-1704ce296bc8",
                    "sense_definition": "Emplacement surélevé ou gradins aménagés pour accueillir les spectateurs dans un stade, une salle ou une église.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les supporters ont envahi la <w>tribune</w> pour fêter la victoire de leur équipe."
                        },
                        {
                            "text": "Nous avons réservé des places dans la <w>tribune</w> d'honneur pour assister à la compétition."
                        }
                    ],
                    "common_phrases": [
                        "tribune d'honneur",
                        "tribune présidentielle"
                    ]
                },
                {
                    "sense_id": "8031e81f-a14c-3734-b91b-f9f2dc1b2a5e",
                    "sense_definition": "Article de presse ou espace d'expression accordé à une personnalité pour exposer son point de vue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "presse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs scientifiques renommés ont signé une <w>tribune</w> dans un grand quotidien national."
                        },
                        {
                            "text": "Le philosophe a décidé de publier une <w>tribune</w> pour dénoncer ces dérives politiques."
                        }
                    ],
                    "common_phrases": [
                        "signer une tribune",
                        "publier une tribune"
                    ]
                },
                {
                    "sense_id": "14660cc2-c40e-3182-9afb-1f7788e72208",
                    "sense_definition": "Dans l'Antiquité grecque et romaine, lieu surélevé d'où les orateurs s'adressaient aux citoyens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur haranguait les citoyens rassemblés devant la <w>tribune</w> aux harangues."
                        },
                        {
                            "text": "Cicéron monta sur la <w>tribune</w> pour défendre ses idées devant le peuple romain."
                        }
                    ],
                    "common_phrases": [
                        "tribune aux harangues"
                    ]
                }
            ]
        }
    ]
