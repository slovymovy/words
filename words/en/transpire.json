{
    "word_family": [
        "transpiration",
        "transpiratory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5701449c-3a5e-309f-aba6-5dc0f265eda3",
                    "sense_definition": "To happen or take place",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "happen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody knows exactly what <w>transpired</w> during the secret meeting last night.",
                            "target_lang_translations": {
                                "nl": "Niemand weet precies wat er <w>gebeurd is</w> tijdens de geheime vergadering van gisteravond."
                            }
                        },
                        {
                            "text": "We will wait to see what <w>transpires</w> after the new law is passed.",
                            "target_lang_translations": {
                                "nl": "We wachten af wat er <w>gaat gebeuren</w> nadat de nieuwe wet is aangenomen."
                            }
                        }
                    ],
                    "synonyms": [
                        "happen",
                        "occur",
                        "take place"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gebeuren of plaatsvinden"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gebeuren",
                                "target_lang_sense_clarification": "algemeen woord voor iets dat plaatsvindt"
                            },
                            {
                                "target_lang_word": "plaatsvinden",
                                "target_lang_sense_clarification": "iets dat officieel of gepland gebeurt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "663005d4-41ba-3506-9684-8d952a05a281",
                    "sense_definition": "To become known or escape from secrecy",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "become_known",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It eventually <w>transpired</w> that the company had been hiding its financial losses.",
                            "target_lang_translations": {
                                "nl": "Uiteindelijk <w>kwam aan het licht</w> dat het bedrijf zijn financiële verliezen had verborgen."
                            }
                        },
                        {
                            "text": "The details of the scandal <w>transpired</w> only after the investigation was completed.",
                            "target_lang_translations": {
                                "nl": "De details van het schandaal <w>werden pas bekend</w> nadat het onderzoek was afgerond."
                            }
                        }
                    ],
                    "synonyms": [
                        "come to light",
                        "emerge"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bekend worden of aan het licht komen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aan het licht komen",
                                "target_lang_sense_clarification": "iets dat verborgen was wordt openbaar"
                            },
                            {
                                "target_lang_word": "bekend worden",
                                "target_lang_sense_clarification": "informatie die voorheen onbekend was wordt gedeeld"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd961540-38fa-3ff1-ba7e-463a23b0a4d7",
                    "sense_definition": "To perspire or sweat",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete began to <w>transpire</w> heavily after running for several miles.",
                            "target_lang_translations": {
                                "nl": "De atleet begon hevig te <w>zweten</w> na enkele kilometers hardlopen."
                            }
                        },
                        {
                            "text": "The hot weather caused everyone in the room to <w>transpire</w>.",
                            "target_lang_translations": {
                                "nl": "Door het warme weer begon iedereen in de kamer te <w>transpireren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweat"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zweten of transpireren"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zweten",
                                "target_lang_sense_clarification": "het meest gebruikelijke woord voor transpireren"
                            },
                            {
                                "target_lang_word": "transpireren",
                                "target_lang_sense_clarification": "formeler synoniem voor zweten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99c24993-5567-3c2d-9a1a-b9bb0a83323c",
                    "sense_definition": "Of plants, to give off water through the stomata",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plants <w>transpire</w> more rapidly when the air is dry and warm.",
                            "target_lang_translations": {
                                "nl": "Planten <w>verdampen</w> sneller wanneer de lucht droog en warm is."
                            }
                        },
                        {
                            "text": "The forest helps cool the environment as the trees <w>transpire</w>.",
                            "target_lang_translations": {
                                "nl": "Het bos helpt de omgeving af te koelen doordat de bomen <w>verdampen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het verdampen van water door planten via de huidmondjes"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verdampen",
                                "target_lang_sense_clarification": "het proces waarbij planten vocht afgeven"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d5e50fe-8c0b-3500-aa1e-5254c4e5e59b",
                    "sense_definition": "To give off vapour or an odour",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemical began to <w>transpire</w> a strong and unpleasant smell.",
                            "target_lang_translations": {
                                "nl": "De chemische stof begon een sterke en onaangename geur <w>af te geven</w>."
                            }
                        },
                        {
                            "text": "The damp walls seemed to <w>transpire</w> a cold mist.",
                            "target_lang_translations": {
                                "nl": "De vochtige muren leken een koude nevel <w>uit te wasemen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Damp of geur afgeven"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afgeven",
                                "target_lang_sense_clarification": "het uitstralen of verspreiden van een geur of damp"
                            },
                            {
                                "target_lang_word": "uitwasemen",
                                "target_lang_sense_clarification": "het langzaam afgeven van damp of geur"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}