                                        "entry_id": "58ae964c-2c63-3275-93a8-eaabcc66d8f6",
                                        "glosses": [
                                            "iemand die voor zijn beroep aandelen in- en verkoopt hij kan voor eigen rekening werken, voor klanten of voor een werkgever"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961f5d31-bb87-4064-9abe-ca2980285a8e",
                                                "sense_id": "72202bde-3e7c-3a43-a71e-6787fdeb9e6a",
                                                "text": "De aandelenhandelaar houdt rekening met alle factoren die de koers van de aandelen kunnen beïnvloeden."
                                            },
                                            {
                                                "example_id": "86e96b9e-603f-44d8-8189-f8a7ab6e6094",
                                                "sense_id": "72202bde-3e7c-3a43-a71e-6787fdeb9e6a",
                                                "text": "De aandelenhandelaar probeerde de geleden verliezen de compenseren door steeds risicovollere transacties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d260a2ec-543a-4624-9ff0-db16429deabd",
                        "source_entry_id": "acb90d8d-a59f-3594-b8b6-0f20fce727e0",
