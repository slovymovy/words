                                "target_lang_word": "мимо",
                                "target_lang_sense_clarification": "не попадая в цель"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "naast",
                                "target_lang_sense_clarification": "niet in het doel"
                            },
                            {
                                "target_lang_word": "mis",
                                "target_lang_sense_clarification": "het doel niet rakend"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karavana",
                                "target_lang_sense_clarification": "hedefi ıska geçerek"
                            },
                            {
                                "target_lang_word": "dışarı",
                                "target_lang_sense_clarification": "hedefin dışına doğru"
                            }
