                        "sense_id": "f274d529-3d15-3e5d-9097-0313bb615a3e",
                        "entry_id": "a53e186b-7372-3b49-8764-55264b2dccbf",
                        "glosses": [
                            "miteinander zusammenhängen; sich gegenseitig beeinflussen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c307f2a7-a189-47c3-835b-2e9e1c1d5b9a",
                                "sense_id": "f274d529-3d15-3e5d-9097-0313bb615a3e",
                                "text": "„Der Begriff des Schönen impliziert ja, das das Ganze und seine Teile nicht zu trennen sind, dass sie in doppelter Richtung interdependieren: In jedem Teil ist das Ganze repräsentiert, und im Ganzen sind alle Teile aufgehoben.“"
                            },
                            {
                                "example_id": "42b56e43-d0c5-4e16-a9f0-fd94cb6ec8c0",
                                "sense_id": "f274d529-3d15-3e5d-9097-0313bb615a3e",
                                "text": "„Der Verzicht auf die Bindung interdependiert somit nicht zuletzt mit der >Privatisierung< der Stammbuchsitte, die im späteren 18. Jahrhundert festgestellt werden kann.“"
                            },
                            {
                                "example_id": "24f5b49d-a4ff-463c-9612-8bbf6556f6bb",
                                "sense_id": "f274d529-3d15-3e5d-9097-0313bb615a3e",
                                "text": "„Im Folgenden will ich darstellen, wie diese Zugehörigkeitskonstruktion mit Spuren anderer Diskurse interdependiert.“"
                            },
                            {
                                "example_id": "1afd3e43-38a6-47b6-a417-6e35c0f180af",
                                "sense_id": "f274d529-3d15-3e5d-9097-0313bb615a3e",
                                "text": "„Jede neue Entwicklungsstufe bedingt die vorangegangene und korrespondiert, interdependiert mit ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
