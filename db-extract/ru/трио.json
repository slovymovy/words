                                        "entry_id": "73891a75-67ab-3256-9aa6-5d9a164f5595",
                                        "glosses": [
                                            "Groupe de trois chanteurs ou instrumentistes qui font les différentes parties d’un même morceau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01e0e049-81f2-42b2-b50c-88910de6c2a7",
                                                "sense_id": "fd90f78e-f1f2-3b58-a366-5ae574205d8f",
                                                "text": "Ils proposent un programme qui réunit des œuvres d’Astor Piazzolla et des compositions originales du trio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a05a2d4-a636-3f0f-a119-44c8924e586c",
                                        "entry_id": "73891a75-67ab-3256-9aa6-5d9a164f5595",
                                        "glosses": [
                                            "Groupe de trois personnes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b47806a-6e6b-4819-a387-1e7901b19e06",
                                                "sense_id": "3a05a2d4-a636-3f0f-a119-44c8924e586c",
                                                "text": "Une voyoute, une michetonneuse et une pute. Un trio aussi infernal que redoutable."
                                            },
                                            {
                                                "example_id": "aabed148-a41b-4914-8aec-bbcad4fd5d9a",
                                                "sense_id": "3a05a2d4-a636-3f0f-a119-44c8924e586c",
                                                "text": "Ali Assani, un Comorien surnommé Kaf’Bob en hommage à Bob Marley, mais surtout à cause de sa tignasse poussiéreuse de Rasta, et de son goût immodéré pour le reggae et le zamal – pas forcément dans cet ordre de prédilection, d’ailleurs – complétait le trio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366cbb32-419f-38db-8509-3a6d30f8feb5",
                                        "entry_id": "73891a75-67ab-3256-9aa6-5d9a164f5595",
                                        "glosses": [
                                            "Ensemble formé de trois éléments."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50bbae02-e854-46c8-b55d-da7861b991e6",
                                                "sense_id": "366cbb32-419f-38db-8509-3a6d30f8feb5",
                                                "text": "Quoique nous ne nous connaissions que depuis un trio de semaines, je commence à bien discerner les motifs de Kakuro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ff5bd16-3917-3173-8cc4-516d742e7ebd",
                                        "entry_id": "73891a75-67ab-3256-9aa6-5d9a164f5595",
                                        "glosses": [
                                            "Pari hippique consistant à trouver les trois premiers chevaux d'une course, tiercé."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8800fdc6-ba4c-30fe-b14e-b891a7a1d134",
                                        "entry_id": "73891a75-67ab-3256-9aa6-5d9a164f5595",
                                        "glosses": [
                                            "Triolisme, groupe de trois personnes ayant des relations sexuelles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
