                                "target_lang_word": "откладывать",
                                "target_lang_sense_clarification": "перенос дел на потом"
                            },
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "перенос встречи на другой срок"
                            },
                            {
                                "target_lang_word": "отсрочивать",
                                "target_lang_sense_clarification": "перенос срока платежа"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verschieben",
                                "target_lang_sense_clarification": "Termine und Veranstaltungen"
                            },
                            {
                                "target_lang_word": "aufschieben",
                                "target_lang_sense_clarification": "Erledigung von Aufgaben"
                            },
                            {
                                "target_lang_word": "vertagen",
                                "target_lang_sense_clarification": "Sitzungen und Verhandlungen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aplazar",
                                "target_lang_sense_clarification": "citas, eventos y plazos"
                            },
                            {
                                "target_lang_word": "posponer",
                                "target_lang_sense_clarification": "tareas y decisiones pendientes"
                            },
                            {
                                "target_lang_word": "diferir",
                                "target_lang_sense_clarification": "uso formal, trámites y pagos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推迟",
                                "target_lang_sense_clarification": "把日期或时间往后挪"
                            },
                            {
                                "target_lang_word": "延期",
                                "target_lang_sense_clarification": "活动或会议改期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b5d5a89-d839-320f-b4b0-95fad1520cdc",
                    "sense_definition": "Ralentir l'avancement, le déroulement ou le développement de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ralentissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette panne technique risque de <w>retarder</w> l'ensemble des travaux sur le chantier.",
                            "target_lang_translations": {
                                "en": "This technical breakdown could <w>delay</w> all the work on the site.",
                                "ru": "Эта техническая неисправность может <w>задержать</w> все работы на стройке.",
                                "de": "Diese technische Panne könnte die gesamten Arbeiten auf der Baustelle <w>verzögern</w>.",
                                "es": "Esta avería técnica podría <w>retrasar</w> todos los trabajos de la obra.",
                                "zh": "这次技术故障可能会<w>延误</w>工地上的全部工程。"
                            }
                        },
                        {
                            "text": "Le froid intense a <w>retardé</w> la floraison des arbres fruitiers au début du printemps.",
                            "target_lang_translations": {
                                "en": "Intense cold <w>delayed</w> the flowering of the fruit trees at the start of spring.",
                                "ru": "Сильные холода <w>задержали</w> цветение плодовых деревьев в начале весны.",
                                "de": "Die starke Kälte hat zu Beginn des Frühlings die Blüte der Obstbäume <w>verzögert</w>.",
                                "es": "El intenso frío <w>retrasó</w> la floración de los frutales al principio de la primavera.",
                                "zh": "早春时节，严寒<w>延缓</w>了果树的开花。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ralentir",
                        "freiner"
                    ],
                    "antonyms": [
                        "accélérer"
                    ],
                    "common_phrases": [
                        "retarder la croissance",
                        "retarder les progrès"
                    ],
                    "target_lang_definitions": {
                        "en": "To slow down the progress, course or development of something.",
                        "ru": "Замедлить продвижение, ход или развитие чего-либо.",
                        "de": "Den Fortschritt, den Ablauf oder die Entwicklung von etwas verlangsamen.",
                        "es": "Hacer más lento el avance, el desarrollo o el curso de algo.",
                        "zh": "使某事的进展、进程或发展速度变慢。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delay",
                                "target_lang_sense_clarification": "slowing progress of work"
                            },
                            {
                                "target_lang_word": "slow",
                                "target_lang_sense_clarification": "reducing speed of development"
                            },
                            {
                                "target_lang_word": "set back",
                                "target_lang_sense_clarification": "hindering progress or development"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "замедлять",
                                "target_lang_sense_clarification": "замедление хода работ"
                            },
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "задержка сроков проекта"
                            },
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "мешать развитию процесса"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verzögern",
                                "target_lang_sense_clarification": "Ablauf von Arbeiten"
                            },
                            {
                                "target_lang_word": "verlangsamen",
                                "target_lang_sense_clarification": "Tempo eines Prozesses senken"
                            },
                            {
                                "target_lang_word": "hemmen",
                                "target_lang_sense_clarification": "Wachstum und Entwicklung"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "retrasar",
                                "target_lang_sense_clarification": "avance de obras y proyectos"
                            },
                            {
                                "target_lang_word": "ralentizar",
                                "target_lang_sense_clarification": "ritmo de un proceso"
                            },
                            {
                                "target_lang_word": "frenar",
                                "target_lang_sense_clarification": "crecimiento y desarrollo económico"
                            }
                        ],
                        "zh": [
