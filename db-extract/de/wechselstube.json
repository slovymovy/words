                    {
                        "sense_id": "2bada02f-ce98-3446-ae6a-7486c2ae4d53",
                        "entry_id": "8d24c9ac-7058-38f9-bfe5-2cf46da08fcf",
                        "glosses": [
                            "Einrichtung/Institution, bei der man Geld in eine andere Währung wechseln kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82c6028-5041-4276-9e56-9b2a68831044",
                                "sense_id": "2bada02f-ce98-3446-ae6a-7486c2ae4d53",
                                "text": "„Auch in den entlegensten Vororten wurden diese Wechselstuben in den Weg gestellt.“"
                            },
                            {
                                "example_id": "6bf35205-623d-4130-865a-f1f118147e39",
                                "sense_id": "2bada02f-ce98-3446-ae6a-7486c2ae4d53",
                                "text": "„Den Leiter dieser Wechselstube bekam er wenig zu sehen.“"
                            },
                            {
                                "example_id": "c48c48d2-804b-42e0-becf-1dc962ff4cc5",
                                "sense_id": "2bada02f-ce98-3446-ae6a-7486c2ae4d53",
                                "text": "„Als wir an einer »Bar Kantor« vorbeikamen, einer Wechselstube mit Ausschank, stoppte ich den Wagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
