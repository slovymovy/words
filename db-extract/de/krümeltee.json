                "senses": [
                    {
                        "sense_id": "7d11b525-4eca-30ca-a03f-866ea0eed0cc",
                        "entry_id": "ff085ed2-6665-3b4c-897c-5533cdfd737e",
                        "glosses": [
                            "löslicher Tee; Tee, bei dem der Tee-Extrakt in Granulat- oder Pulverform mit Wasser aufgegossen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b92f8804-00ed-4ccf-8ed9-f185063a141e",
                                "sense_id": "7d11b525-4eca-30ca-a03f-866ea0eed0cc",
                                "text": "„Sie trinkt Krümeltee, er Orangensaft.“"
                            },
                            {
                                "example_id": "7f31f502-ef5b-4141-992b-ba75dbd8f5de",
                                "sense_id": "7d11b525-4eca-30ca-a03f-866ea0eed0cc",
                                "text": "„In der linken Hälfte des Zimmers steht an der Wand ein Tisch mit zwei Stühlen, darüber befindet sich ein kleines Regal mit meinen drei Büchern sowie allerlei merkwürdigen Gefäßen wie einstigen Kaffee- und Joghurtbechern oder Schraubgläsern, in denen sich Kaffeeweißer, Seelachsschnitzel oder Krümeltee befanden.“"
                            },
                            {
                                "example_id": "7eae7b14-a801-428d-a058-4d0d1071f6c1",
                                "sense_id": "7d11b525-4eca-30ca-a03f-866ea0eed0cc",
                                "text": "„‚Die große gelbe Sau!‘ schnaubt Ulrike Hoinkis, als sie nach knapp zwei Stunden durchs Ziel läuft und anschließend becherweise Wasser und „Krümeltee“ in sich hineinschüttet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
