                ],
                "senses": [
                    {
                        "sense_id": "22c0830c-78f4-33c2-96bc-b3b4e5215bee",
                        "entry_id": "ce063b8f-f50d-3cae-a6c2-9a064208e671",
                        "glosses": [
                            "филос., психол. термин схоластической философии, обозначающий намерение, цель, направленность сознания, мышления на какой-либо предмет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4422351a-66d5-4b78-aa67-d4fa5771fe77",
                                "sense_id": "22c0830c-78f4-33c2-96bc-b3b4e5215bee",
                                "text": "Знак не имеет значения, но направлен на значение в интенции, чем не обладает, например, слог."
                            },
                            {
                                "example_id": "ac5ffed1-2ef7-4ccf-9a83-e1f1fcdc3019",
                                "sense_id": "22c0830c-78f4-33c2-96bc-b3b4e5215bee",
                                "text": "Но в силу того, что в соответствии с той идеалистической философией, из которой исходила вюрцбургская школа, мышление было внешне противопоставлено всему чувственному содержанию действительности, направленность мышления на предмет (интенция) превратилась в чистый акт (своеобразный actus purus схоластической философии), в мистическую активность вне всякого содержания."
                            },
                            {
                                "example_id": "550669b4-1bee-4df4-bb89-d3a092480512",
                                "sense_id": "22c0830c-78f4-33c2-96bc-b3b4e5215bee",
                                "text": "Очевидно, что нарративы активно участвуют в организации опыта, формировании интенций, структурировании памяти и общении."
                            }
                        ]
                    },
                    {
                        "sense_id": "acbc2816-c3a1-3a17-aa21-bc81a20bfebb",
                        "entry_id": "ce063b8f-f50d-3cae-a6c2-9a064208e671",
                        "glosses": [
                            "устар. намерение, умысел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7930515c-3db3-4382-ac65-8e2b041ff627",
                                "sense_id": "acbc2816-c3a1-3a17-aa21-bc81a20bfebb",
                                "text": "Ma mère, я имею интенцию ваш диспут финировать…"
                            }
                        ]
                    },
                    {
                        "sense_id": "309f16bc-5179-30fb-97f0-50745fcd573d",
                        "entry_id": "ce063b8f-f50d-3cae-a6c2-9a064208e671",
                        "glosses": [
                            "религ. поминание на богослужении и пожертвование, связанное с ним"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccbbfdf5-d7f1-42b2-8c34-d5fc701149cc",
                        "source_entry_id": "ce063b8f-f50d-3cae-a6c2-9a064208e671",
                        "target_lang_word": "intention",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80094402-ad50-3f99-9711-cb941b183911",
                                        "entry_id": "c32e519e-a782-3cd5-8dee-7c71bfdea326",
                                        "glosses": [
                                            "A course of action that a person intends to follow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2222d45b-50d2-46e5-a006-4322695dfea3",
                                                "sense_id": "80094402-ad50-3f99-9711-cb941b183911",
                                                "text": "My intention was to marry a wealthy widow."
                                            },
                                            {
                                                "example_id": "fb0daffc-5fec-4120-aa59-a068926739d5",
                                                "sense_id": "80094402-ad50-3f99-9711-cb941b183911",
                                                "text": "It’s easy to promise anything when you have no intention of fulfilling any of it."
                                            },
                                            {
                                                "example_id": "9601e43b-98c9-4ec9-a5bc-8d27a511ae5a",
                                                "sense_id": "80094402-ad50-3f99-9711-cb941b183911",
                                                "text": "a. 1784, attributed to Samuel Johnson\nHell is paved with good intentions."
                                            },
                                            {
                                                "example_id": "12882ee7-9e28-4ac6-a69c-5212249806aa",
                                                "sense_id": "80094402-ad50-3f99-9711-cb941b183911",
                                                "text": "“My Continental prominence is improving,” I commented dryly. ¶ Von Lindowe cut at a furze bush with his silver-mounted rattan. ¶ “Quite so,” he said as dryly, his hand at his mustache. “I may say if your intentions were known your life would not be worth a curse.”"
                                            },
                                            {
                                                "example_id": "02fb74b9-d1cf-42a1-ab18-b13fbd30e3b5",
                                                "sense_id": "80094402-ad50-3f99-9711-cb941b183911",
                                                "text": "It had been his intention to go to Wimbledon, but as he himself said: “Why be blooming well frizzled when you can hear all the results over the wireless. And results are all that concern me.[…]”"
                                            },
                                            {
                                                "example_id": "eb9902db-3507-4ab4-8ed3-a24f6101c8b0",
                                                "sense_id": "80094402-ad50-3f99-9711-cb941b183911",
                                                "text": "Zevala was ablaze, and all the insurgents — as they called themselves — were scurrying about like chickens with their heads cut off. There was talk of an attack. A second invading force. Perhaps the Foundation. Perhaps something worse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c48aab-1430-3bec-9f4d-0f127d147ee6",
                                        "entry_id": "c32e519e-a782-3cd5-8dee-7c71bfdea326",
                                        "glosses": [
                                            "The goal or purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b82bdb-c5c1-4811-8e1a-3679e232a724",
                                                "sense_id": "67c48aab-1430-3bec-9f4d-0f127d147ee6",
                                                "text": "The intention of this legislation is to boost the economy."
                                            },
                                            {
                                                "example_id": "60401600-7481-4855-8a1a-f3fff903c96b",
                                                "sense_id": "67c48aab-1430-3bec-9f4d-0f127d147ee6",
                                                "text": "Though most of the cases here cover European encounters with non-Europeans, it is not the intention of the book to give the impression that genocide is a function of European colonialism and imperialism alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3cc9b35-6ea4-3f17-8e3a-d9db60100c9a",
                                        "entry_id": "c32e519e-a782-3cd5-8dee-7c71bfdea326",
                                        "glosses": [
                                            "Tension; straining, stretching."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e9850e-7f15-498a-9c8f-0546dc996ca4",
                                                "sense_id": "f3cc9b35-6ea4-3f17-8e3a-d9db60100c9a",
                                                "text": "cold in those inner parts, cold belly, and hot liver, causeth crudity, and intention proceeds from perturbations […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "704cb2f1-36da-3974-96a7-e84e7d8e5004",
                                        "entry_id": "c32e519e-a782-3cd5-8dee-7c71bfdea326",
                                        "glosses": [
                                            "A stretching or bending of the mind toward an object or a purpose (an intent); closeness of application; fixedness of attention; earnestness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96986848-d52b-4520-ab72-9617bf24b105",
                                                "sense_id": "704cb2f1-36da-3974-96a7-e84e7d8e5004",
                                                "text": "it is attention: when the mind with great earnestness, and of choice, fixes its view on any idea, considers it on all sides, and will not be called off by the ordinary solicitation of other ideas, it is that we call intention or study"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e61f453-6ddf-32ce-b717-f96187dcce72",
                                        "entry_id": "c32e519e-a782-3cd5-8dee-7c71bfdea326",
                                        "glosses": [
                                            "The object toward which the thoughts are directed; end; aim."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da3800e-0455-455f-92fc-4b7ac970e989",
                                                "sense_id": "2e61f453-6ddf-32ce-b717-f96187dcce72",
                                                "text": "In a Word, the most part of chronical Distempers proceed from Laxity of Fibres; in which Case the principal Intention is to restore the Tone of the solid Parts; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d357068b-cdf5-3ceb-b451-8da8adf68344",
                                        "entry_id": "c32e519e-a782-3cd5-8dee-7c71bfdea326",
                                        "glosses": [
                                            "Any mental apprehension of an object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28ae7e6b-4da4-3e85-9a35-eb1fd18b4305",
                                        "entry_id": "c32e519e-a782-3cd5-8dee-7c71bfdea326",
                                        "glosses": [
                                            "The process of the healing of a wound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f37dbdf7-ba78-4fcb-9839-bbac94b5e60a",
                                                "sense_id": "28ae7e6b-4da4-3e85-9a35-eb1fd18b4305",
                                                "text": "When healing occurs by primary intention, the wound is basically closed with all areas of the wound connecting and healing simultaneously."
                                            }
                                        ]
                                    }
                                ]
                            },
