                        "entry_id": "daa06a3e-ee85-3854-8bb0-04b8326e4136",
                        "glosses": [
                            "Élément ordinal, correspondant au cardinal vingt-trois. L’élément placé au rang dont le numéro est vingt-trois (23)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a67921-912e-4cd3-b1c9-961ab2cb120b",
                                "sense_id": "d5e4de0e-8ee7-3adf-8cd6-2dfc405a6b69",
                                "text": "Le vingt-troisième précède le vingt-quatrième et suit le vingt-deuxième."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff85bb4c-7ef0-36e4-95a2-f639af037bc0",
                        "entry_id": "daa06a3e-ee85-3854-8bb0-04b8326e4136",
                        "glosses": [
                            "Fraction obtenue en divisant vingt-trois fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62591397-188d-4d21-9fd7-041dbfc3f9e5",
                                "sense_id": "ff85bb4c-7ef0-36e4-95a2-f639af037bc0",
                                "text": "Donnez-moi le vingt-troisième de ce gâteau."
                            }
                        ]
                    }
