                ],
                "senses": [
                    {
                        "sense_id": "7948b49a-e1b4-3678-862a-7c8732e9ba02",
                        "entry_id": "022806b2-71bd-3b7e-84dd-7dd499100099",
                        "glosses": [
                            "der aus religiösen Motiven bedingte Rückzug aus der Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7552a8be-7230-4a0b-83c8-3bfcbcf9dfe6",
                                "sense_id": "7948b49a-e1b4-3678-862a-7c8732e9ba02",
                                "text": "„Weltflucht ist nicht so sehr die christliche Absage an den „Geist dieser Welt“ […], sondern die grundsätzliche Abwertung der Weltbedingtheit des Menschen, wie sie […] alle Gnostik kennzeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32765860-1e87-4fcf-83fa-2cce29b7b537",
                        "source_entry_id": "022806b2-71bd-3b7e-84dd-7dd499100099",
                        "source_sense_id": "7948b49a-e1b4-3678-862a-7c8732e9ba02",
                        "source_sense_description": "Religion: der aus religiösen Motiven bedingte Rückzug aus der Welt",
                        "target_lang_word": "anachorèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachorèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73dfefa7-b03f-3bdd-bc85-48715456e391",
                                        "entry_id": "39b0c135-036b-35ae-9acc-da101f96c3de",
                                        "glosses": [
                                            "Mode de vie des anachorètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ed65be-006c-4de5-aa5e-f6c6acf98dab",
                                                "sense_id": "73dfefa7-b03f-3bdd-bc85-48715456e391",
                                                "text": "En d'autres mots les bergers sont supérieurs aux autres hommes, parce qu’ils sont purifiés en faisant retraite (anachorèse) et en vivant loin des foules, dans la quiétude et le silence (hésychid)."
                                            },
                                            {
                                                "example_id": "f84b32d4-6b73-4358-bf19-e2e4872fce82",
                                                "sense_id": "73dfefa7-b03f-3bdd-bc85-48715456e391",
                                                "text": "J’aurais voulu relancer l’épidémie d’anachorèse des anciens Romains, lorsque Auguste imposa dans le sang l’empire, ou l’exil baroque des Solitaires que Rome, le ministère et le roi pourchassaient et désiraient éradiquer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83b1f6c0-55e9-4b54-9473-ca2c3ed96cfd",
                        "source_entry_id": "022806b2-71bd-3b7e-84dd-7dd499100099",
                        "source_sense_id": "7948b49a-e1b4-3678-862a-7c8732e9ba02",
                        "source_sense_description": "Religion: der aus religiösen Motiven bedingte Rückzug aus der Welt",
                        "target_lang_word": "escapisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escapisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e91c32f0-1270-3d55-a151-211601853b66",
                                        "entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                                        "glosses": [
                                            "Attitude qui consiste à se retirer du monde et de la vie civique, par fuite ou désabusement, par opposition à la prise de parole ou à l’action individuelle ou sociale."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c5c1a9a-1393-43c3-8628-1204ca2ac7d3",
                                                "sense_id": "e91c32f0-1270-3d55-a151-211601853b66",
                                                "text": "Tous les morticoles du ciboulot font bloc autour de leur petit patient qui n’en peut mais : il souffre d’escapisme aigu, cette drôle d’attitude qui consiste à se retirer lentement du monde et de toute vie civique, par fuite, par désabusement, en opposition à la prise de décision publique et à toute action individuelle ou sociale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                                        "entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                                        "glosses": [
                                            "Évasion de la réalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7dc9cb-a66a-4005-a50c-c0617b0131d3",
                                                "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                                                "text": "Du coup, du fait de la répétitivité de ces violences une forme d’indifférence ou d’escapisme s’était installée."
                                            },
                                            {
                                                "example_id": "2215991f-7405-4c52-87f9-81657250041f",
                                                "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                                                "text": "C'est une attitude de fuite qui se dégage de cette chanson [la Paloma], un escarpisme au goût du jour et dont le vrai nom serait : le refoulement du passé et du présent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
