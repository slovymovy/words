            {
                "entry_id": "1b670495-f0f9-3544-9c26-5648dfb42571",
                "word": "ballast",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c73f83b-1b4e-3510-b8e0-2bf851f07088",
                        "entry_id": "1b670495-f0f9-3544-9c26-5648dfb42571",
                        "glosses": [
                            "vervanging van de nuttige lading door iets dat voldoende weegt om een schip te stabiliseren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90708aba-3e1a-4f06-9006-04eb7c5f8b25",
                                "sense_id": "9c73f83b-1b4e-3510-b8e0-2bf851f07088",
                                "text": "Door de ballast komt het zwaartepunt van het schip lager te liggen en kan het dus minder makkelijk omslaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8b56932-d5f8-319e-b772-717f37ea1430",
                        "entry_id": "1b670495-f0f9-3544-9c26-5648dfb42571",
                        "glosses": [
                            "steenslag die men op het spoorbed stort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70be1621-0db1-4d08-91ec-1e85a6e5c893",
                                "sense_id": "c8b56932-d5f8-319e-b772-717f37ea1430",
                                "text": "Door middel van betonnen dwarsliggers kan men tegenwoordig ook ballastvrije spoorwegen maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "909b0237-80fa-3dc1-b1ac-937bad11e085",
                        "entry_id": "1b670495-f0f9-3544-9c26-5648dfb42571",
                        "glosses": [
                            "iets dat hinderlijk zwaar is zowel letterlijk als ook figuurlijk gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2aba9cb-5d5b-4046-98d2-fbb4dc7ca2d3",
                                "sense_id": "909b0237-80fa-3dc1-b1ac-937bad11e085",
                                "text": "De lastige kinderen zijn een hele ballast voor de overspannen ouders."
                            },
                            {
                                "example_id": "8b506959-b95b-4b35-a121-3bf449d90a26",
                                "sense_id": "909b0237-80fa-3dc1-b1ac-937bad11e085",
                                "text": "Neem toch niet al te veel bagage mee op vakantie, het is alleen maar ballast."
                            },
                            {
                                "example_id": "f5d0efe8-40fb-4994-bb0c-3e8269c8bd68",
                                "sense_id": "909b0237-80fa-3dc1-b1ac-937bad11e085",
                                "text": "'Bram, je moet je hart volgen. Doe maar wat je wilt. Je moet je talent ontwikkelen. Vrouwen...' en hier zuchtte ze, 'zijn een ballast.' Ze gaf me een kus op mijn voorhoofd en verdween onhoorbaar mijn kamer uit."
                            },
                            {
                                "example_id": "3d8a8c8a-b174-4b75-a4ba-7b807b84674a",
                                "sense_id": "909b0237-80fa-3dc1-b1ac-937bad11e085",
                                "text": "Wellicht was ergens onderweg onwelkome ballast afgeworpen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a214fa1-f918-4098-8c97-42e20b419bb1",
                        "source_entry_id": "1b670495-f0f9-3544-9c26-5648dfb42571",
                        "source_sense_id": "9c73f83b-1b4e-3510-b8e0-2bf851f07088",
                        "source_sense_description": "vervanging van de nuttige lading door iets dat voldoende weegt om een schip te stabiliseren",
                        "target_lang_word": "Ballast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ballast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "257b97b8-ae2a-37d9-924a-60fcead10189",
                                        "entry_id": "3d801f8d-7fc8-37d1-9790-90780e5804a1",
                                        "glosses": [
                                            "Stoff oder Bauteil, das für seine Größe vergleichsweise schwer ist und zur Stabilisierung des Objektes, auf welchem es geladen ist (zum Beispiel auf Schiffen, Ballonen, U-Booten und anderen Tauchfahrzeugen) dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86da2426-6310-4b3e-a0fd-25d0a95d98ff",
                                                "sense_id": "257b97b8-ae2a-37d9-924a-60fcead10189",
                                                "text": "„Acht Säcke Ballast sind vorhanden, Meßapparate, hundert Meter Tau“"
                                            },
                                            {
                                                "example_id": "48252ba3-e3a4-4444-a44f-bce5db1101f4",
                                                "sense_id": "257b97b8-ae2a-37d9-924a-60fcead10189",
                                                "text": "„Das Boot war mit starkem Ballast versehen.“"
                                            },
                                            {
                                                "example_id": "b6718492-a4f0-4731-aa93-24f651e6577d",
                                                "sense_id": "257b97b8-ae2a-37d9-924a-60fcead10189",
                                                "text": "„Nachdem wir jedoch etwas von unserem Ballast losgeworden waren und unsere Fracht Bleiblöcke neu arrangiert hatten, war unser Schiff leichter und lief doch nicht dort ein.“"
                                            },
                                            {
                                                "example_id": "1f033090-f707-4330-b644-9862b2a20517",
                                                "sense_id": "257b97b8-ae2a-37d9-924a-60fcead10189",
                                                "text": "„Ich war also in Orsara von Bord gegangen, während man Ballast im Bauch unseres Schiffes verstaute, das wegen seines zu geringen Tiefganges schlecht zu steuern war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "511e388e-1fa4-3edd-a128-587243804966",
                                        "entry_id": "3d801f8d-7fc8-37d1-9790-90780e5804a1",
                                        "glosses": [
                                            "überflüssige Ladung, nicht benötigtes Gepäck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcb7fd59-a901-4dfe-a36e-1d2aea63a672",
                                                "sense_id": "511e388e-1fa4-3edd-a128-587243804966",
                                                "text": "„Das Boot war mit starkem Ballast versehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d6000995-5f91-37aa-9173-2b9bab8df323",
                                        "entry_id": "3d801f8d-7fc8-37d1-9790-90780e5804a1",
                                        "glosses": [
                                            "Belastung, Last, Bürde"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8423cded-6665-4a89-8238-2a8b3f0eee23",
                                                "sense_id": "d6000995-5f91-37aa-9173-2b9bab8df323",
                                                "text": "Niko Paech stellt sich aber ein Zeitalter vor, in dem sich Menschen von unnötigem Ballast befreien, der nur Zeit, Geld und auch Ressourcen kostet."
                                            },
                                            {
                                                "example_id": "e333f7ac-c0f9-416f-abfc-200654e8f9bf",
                                                "sense_id": "d6000995-5f91-37aa-9173-2b9bab8df323",
                                                "text": "In allen Weltreligionen, ob im Islam, Christen- oder Judentum, auch in den Naturreligionen gibt es diese Anrufung, die von Gläubigen und Nichtgläubigen aus tiefster Seele und größter Not hinaus und hinauf soll: das Gebet, das Stoßgebet. Es hat keine Form, keine festgelegten Worte, es ist nicht rituell und bedarf keines besonderen Ortes. Es übergreift alle Religionen, ist ein zutiefst menschlicher, ein von allem ideologisch-religiösen Ballast befreiter Hilferuf, der letztlich auch keiner Sprache bedarf."
                                            },
                                            {
                                                "example_id": "64cb5c75-5122-4b01-9a75-dbfa5eacf51b",
                                                "sense_id": "d6000995-5f91-37aa-9173-2b9bab8df323",
                                                "text": "„Auch im Lokal, in Schule und Elternhaus, in Politik und Wirtschaft ließe ein kurzes Tippen des Zeigefingers allen förmlichen Ballast vergessen, der den Kontakt von Mensch zu Mensch bisher so erschwerte.“"
                                            },
                                            {
                                                "example_id": "d4fd6c7e-5943-49cb-a0f8-f8a7b0ad20c5",
                                                "sense_id": "d6000995-5f91-37aa-9173-2b9bab8df323",
                                                "text": "„Es sind ja manche so, schleppen aus einem religiös-doktrinären Elternhaus diesen schrecklichen emotionellen Ballast mit sich herum, obgleich er dem eigenen Intellekt und ebenso den eigenen, nur nicht recht durchschauten Gefühlen widerspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b4c8457-d0fd-4aa9-87aa-7d71853e6a0d",
                        "source_entry_id": "1b670495-f0f9-3544-9c26-5648dfb42571",
                        "source_sense_id": "9c73f83b-1b4e-3510-b8e0-2bf851f07088",
                        "source_sense_description": "vervanging van de nuttige lading door iets dat voldoende weegt om een schip te stabiliseren",
                        "target_lang_word": "ballast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12abd206-3fb5-3e69-893c-5af0d4a4ba33",
                                        "entry_id": "eb5242ab-e71e-398a-8585-9f462816933a",
                                        "glosses": [
                                            "Heavy material that is placed in the hold of a ship (or in the gondola of a balloon), to provide stability."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06733c7-4353-4a07-b229-23f16ff2616e",
                                                "sense_id": "12abd206-3fb5-3e69-893c-5af0d4a4ba33",
                                                "text": "“Oh, for the-- how much did you waste on that little boondoggle?” “Well, it's not that so much as--” “Krieger.” “Well, I needed ballast, and what better to simulate bricks of cocaine than, you know, bricks of cocaine.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80745d9a-72e7-36ba-ba07-ed1a6dc433b2",
                                        "entry_id": "eb5242ab-e71e-398a-8585-9f462816933a",
                                        "glosses": [
                                            "Anything that steadies emotion or the mind."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b093b08a-26ce-3f2d-8e51-ad546457efa7",
                                        "entry_id": "eb5242ab-e71e-398a-8585-9f462816933a",
                                        "glosses": [
                                            "Coarse gravel or similar material laid to form a bed for roads or railroads, or in making concrete; track ballast."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80df5f2f-cb50-3e98-b8a9-8a3180ffde04",
                                        "entry_id": "eb5242ab-e71e-398a-8585-9f462816933a",
                                        "glosses": [
                                            "A material, such as aggregate or precast concrete pavers, which employs its mass and the force of gravity to hold single-ply roof membranes in place."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "489cec3c-3151-339b-9f6d-73536722e2f6",
                                        "entry_id": "eb5242ab-e71e-398a-8585-9f462816933a",
                                        "glosses": [
                                            "device used for stabilizing current in an electric circuit (e.g. in a tube lamp supply circuit)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3bdde62-e8d4-3768-b611-9f1a53d9ec54",
                                        "entry_id": "eb5242ab-e71e-398a-8585-9f462816933a",
                                        "glosses": [
                                            "That which gives, or helps to maintain, uprightness, steadiness, and security."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "681eabfa-b932-4667-8cdb-4836b4d192f2",
                                                "sense_id": "c3bdde62-e8d4-3768-b611-9f1a53d9ec54",
                                                "text": "With 73 minutes gone Rafael Márquez came on to add ballast at the back, appearing in his fifth World Cup aged 39 and with alleged links to drug trafficking, which he denies, on hold for now. And so they sat deep with a thin green line of five defenders ranged across their own penalty area as the game became a Mexican stand-off, attack versus defence."
                                            },
                                            {
                                                "example_id": "756804d8-8e0f-4b15-af86-ff6c79a874de",
                                                "sense_id": "c3bdde62-e8d4-3768-b611-9f1a53d9ec54",
                                                "text": "It [piety] is the right ballast of prosperity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ballast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b354b72a-9028-389e-8ef7-d6121b3b4e65",
                                        "entry_id": "0fa343bc-1d08-35b8-a5eb-05947192d09c",
                                        "glosses": [
                                            "To stabilize or load a ship with ballast."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "754b9c10-9126-36cd-a4da-77e970b60091",
                                        "entry_id": "0fa343bc-1d08-35b8-a5eb-05947192d09c",
                                        "glosses": [
                                            "To lay ballast on the bed of a railroad track."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c45948a-858e-497f-87d7-36e2b9217b53",
                                                "sense_id": "754b9c10-9126-36cd-a4da-77e970b60091",
                                                "text": "The task of a Railway Construction Company, R.E., is to lay and ballast the track; [...]."
                                            },
                                            {
                                                "example_id": "ae5a1056-2e74-4e61-9247-b1ba2951861d",
                                                "sense_id": "754b9c10-9126-36cd-a4da-77e970b60091",
                                                "text": "Although the track is ballasted, it does not prevent clouds of reddish dust from the laterite soil blowing about when the train is in motion; after a journey with the windows open a bath is a necessity!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d07fc509-151f-36f4-9c5e-c7bddeefe017",
                                        "entry_id": "0fa343bc-1d08-35b8-a5eb-05947192d09c",
                                        "glosses": [
                                            "To weigh down with a ballast."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a3f5b2-8921-46de-bca2-c7342320fa1b",
                                                "sense_id": "d07fc509-151f-36f4-9c5e-c7bddeefe017",
                                                "text": "The noosance was […] that to make the umbrella effective he would have to carry abroad such weight to ballast it as would put the whole contraption out of action for carrying abroad at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aedc728f-b230-45df-b042-ee6bdb5c0605",
                        "source_entry_id": "1b670495-f0f9-3544-9c26-5648dfb42571",
                        "source_sense_id": "9c73f83b-1b4e-3510-b8e0-2bf851f07088",
                        "source_sense_description": "vervanging van de nuttige lading door iets dat voldoende weegt om een schip te stabiliseren",
                        "target_lang_word": "lest",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lest",
