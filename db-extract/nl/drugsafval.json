                        "examples": [
                            {
                                "example_id": "c6f9f4d5-5e3b-4b58-a4f8-8a6e82d64b72",
                                "sense_id": "579e5e98-a695-3087-b9c3-0d57689ef2ed",
                                "text": "De kosten voor de sanering van het drugsafval probeert het provinciebestuur nu te verhalen op daders en als dat niet lukt op het Rijk. Snel saneren zit er daardoor niet in: na schoonmaken heeft ze niet meer de juridische mogelijkheid om de kosten te verhalen op de veroorzaker."
                            },
                            {
                                "example_id": "c36c7e6d-2c0f-4729-9a0f-7dc9b827f8a4",
                                "sense_id": "579e5e98-a695-3087-b9c3-0d57689ef2ed",
                                "text": "Opvallend genoeg werd er het afgelopen jaar wel vaker drugsafval gedumpt. Dat gebeurde ruim 200 keer, een stijging van 14 procent ten opzichte van het jaar ervoor. Volgens de politie wordt het afval nu vaker in kleinere hoeveelheden achtergelaten."
                            },
                            {
                                "example_id": "89252faf-de97-4da7-b387-376c9767b7a7",
                                "sense_id": "579e5e98-a695-3087-b9c3-0d57689ef2ed",
                                "text": "Veel drugsafval komt in het riool terecht. Ook zegt de provincie dat afval met een vrachtwagen of giertank over het land wordt uitgereden. Ook zijn er signalen dat resten van de xtc-productie in gierkelders worden gedumpt."
                            }
                        ]
