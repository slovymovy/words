                        "examples": [
                            {
                                "example_id": "a82410bf-fa36-4d12-843c-674509f066fa",
                                "sense_id": "3d7b1ca8-b1ef-31e8-8937-2fdb564222fa",
                                "text": "Univision now has an entire Saturday morning slate of cartoons and kidvids."
                            },
                            {
                                "example_id": "45268cfb-dd84-45cc-a98f-d043ab8ea192",
                                "sense_id": "3d7b1ca8-b1ef-31e8-8937-2fdb564222fa",
                                "text": "Stumpy and Gristle must have all the cutesy mannerisms of their kiddy-show forebears, and the pacing and tempo of the dialogue must parallel exactly those of pre-Sesame Street kidvid, if the maximum horror is to result when the action suddenly takes a Stephen King turn."
                            },
                            {
                                "example_id": "5bef5199-b5d1-43b3-9ab1-cc2620aa9972",
                                "sense_id": "3d7b1ca8-b1ef-31e8-8937-2fdb564222fa",
                                "text": "They had their biggest successes in kidvid in the late 60s and early 70s, with shows like The Bugaloos, Lidsville, Sigmund and the Sea Monsters, and most prominently H.R. Pufnstuf, which aired between 1969 and 1974."
                            },
                            {
                                "example_id": "ec618d77-d1ed-4bee-9b99-4aee793b000c",
                                "sense_id": "3d7b1ca8-b1ef-31e8-8937-2fdb564222fa",
                                "text": "Babies weaning on kidvid!"
                            }
                        ]
                    }
