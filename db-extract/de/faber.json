                "senses": [
                    {
                        "sense_id": "4481f147-52c6-3aee-bb66-efa924b65375",
                        "entry_id": "bdaa8b49-0d89-3345-8379-3702eb420594",
                        "glosses": [
                            "latinisierter, deutschsprachiger Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed51210d-1ddd-4329-a35d-6b27da1ea208",
                                "sense_id": "4481f147-52c6-3aee-bb66-efa924b65375",
                                "text": "Frau Faber ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "71285ab0-24a5-4adc-9165-5cb37bfb599e",
                                "sense_id": "4481f147-52c6-3aee-bb66-efa924b65375",
                                "text": "Herr Faber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a0f47ce1-5134-4a8e-8e3e-56eb7cc9bfec",
                                "sense_id": "4481f147-52c6-3aee-bb66-efa924b65375",
                                "text": "Die Fabers fliegen heute nach Sri Lanka."
                            },
                            {
                                "example_id": "485f475c-1dfc-4f10-8be8-92afcc4424e5",
                                "sense_id": "4481f147-52c6-3aee-bb66-efa924b65375",
                                "text": "Der Faber trägt nie die Pullover, die die Faber ihm strickt."
                            },
                            {
                                "example_id": "baa01630-c24e-4bc5-bad9-092396931d41",
                                "sense_id": "4481f147-52c6-3aee-bb66-efa924b65375",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Faber kommt, geht der Herr Faber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
