                ],
                "senses": [
                    {
                        "sense_id": "221bc2e7-207b-35b7-a37b-126bf8971a7c",
                        "entry_id": "efeba070-35bb-304e-a39a-28b6c5541b6a",
                        "glosses": [
                            "aus miteinander verknüpften Ästen bestehende stabile Grundkonstruktion, an/auf der ein Vogel sein Nest bauen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a6e0279-0216-49d5-8da1-1042a2f43458",
                                "sense_id": "221bc2e7-207b-35b7-a37b-126bf8971a7c",
                                "text": "„Viele Sträucher ziehen Vögel in den Garten, weil ihre Äste und Zweige dornig und stachelig sind und Nistquirle bilden.“"
                            },
                            {
                                "example_id": "b22d333f-9f38-473c-bdde-e01b64c66b5a",
                                "sense_id": "221bc2e7-207b-35b7-a37b-126bf8971a7c",
                                "text": "„An Sträuchern und Bäumen können Nisttaschen und Nistquirle für Freibrüter angebracht werden.“"
                            },
                            {
                                "example_id": "1994ff51-4ba3-4bca-8fd6-c54ae0921857",
                                "sense_id": "221bc2e7-207b-35b7-a37b-126bf8971a7c",
                                "text": "„An der etwa 1 m über dem Erdboden befindlichen Bindestelle entwickelt sich ebenfalls ein Nistquirl.“"
                            },
                            {
                                "example_id": "5c58464f-c27e-4aa0-95d8-57d8b0349859",
                                "sense_id": "221bc2e7-207b-35b7-a37b-126bf8971a7c",
                                "text": "„Für die Freibrüter hat es sich bewährt, dort, wo es noch an richtig gezogenen Nistquirlen fehlt, den Notbehelf anzuwenden, dass wir drei oder vier, in gleicher Höhe verzweigte, im Dreieck zueinander stehende Triebe des Unterholzes durch ein Weidenband derart vereinigen, dass sie einander an der Verzweigungsstelle kreuzen und so einen Nistquirl bilden, dessen Spitzen, entsprechend den durch Schnitt erzeugten Quirlen, eingekürzt werden.“"
                            },
                            {
                                "example_id": "b262f470-aada-4e4f-bd0e-fa0e0d6d7bc2",
                                "sense_id": "221bc2e7-207b-35b7-a37b-126bf8971a7c",
                                "text": "„Weiter erhält man Nistquirle, indem man in ein bis zwei Meter ab Boden die Zweige geschmeidiger Gehölzarten zusammenbindet; dies darf aber erst Anfang Mai geschehen, wenn die Blätter voll entwickelt sind […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
