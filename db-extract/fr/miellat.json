        "fr-extract.jsonl": [
            {
                "entry_id": "21dbed64-ce3b-3b24-8493-17c82b1f6469",
                "word": "miellat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "515ab8bd-fd1b-4920-90b6-7a54c6b31150",
                        "entry_id": "21dbed64-ce3b-3b24-8493-17c82b1f6469",
                        "tags": [
                            "plural"
                        ],
                        "form": "miellats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3af8e147-c73c-322e-80ec-ffd65c28f8e6",
                        "entry_id": "21dbed64-ce3b-3b24-8493-17c82b1f6469",
                        "glosses": [
                            "Excrétion liquide, produite par des insectes suceurs comme le puceron à partir de la sève des plantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c41b5308-e08c-421f-9047-2ece1a80eb81",
                                "sense_id": "3af8e147-c73c-322e-80ec-ffd65c28f8e6",
                                "text": "L’image est pertinente même si, en fait de lait, c’est du miellat que produit le cheptel des fourmis."
                            },
                            {
                                "example_id": "08de9ee4-3b00-4ebc-b84a-c2b19832b52d",
                                "sense_id": "3af8e147-c73c-322e-80ec-ffd65c28f8e6",
                                "text": "On sait que les pucerons tirent leur alimentation du phloème ; ils rejettent la sève en excès, sous forme de gouttelettes de miellat."
                            }
                        ]
                    },
                    {
                        "sense_id": "937bff73-bacb-392b-8ddc-6c3d4b4a9e34",
                        "entry_id": "21dbed64-ce3b-3b24-8493-17c82b1f6469",
                        "glosses": [
                            "Maladie des graminées caractérisée par un exsudat sucré de la plante dû au parasitisme d’un champignon."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27236cc6-8a04-468c-bb05-7a7e48681e87",
                        "source_entry_id": "21dbed64-ce3b-3b24-8493-17c82b1f6469",
                        "source_sense_description": "Excrétion liquide produite par des insectes suceurs",
                        "target_lang_word": "honeydew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honeydew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfce8667-1e0d-35b2-96e6-e2002dedebcd",
                                        "entry_id": "30bf978e-9bbc-37d4-994f-239d51fbe0e4",
                                        "glosses": [
                                            "A sweet, sticky substance deposited on leaves and other plant parts by insects (especially aphids and scale insects) feeding on plant sap, or by fungi."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2cba197-e88c-4c84-8a78-2d004b2589e2",
                                                "sense_id": "bfce8667-1e0d-35b2-96e6-e2002dedebcd",
                                                "text": "[T]here reſteth on the leaves of this tree a kinde of red thicke dew in the hotteſt time of Summer more then on any other tree round about it, which will be rather dry then bedewed at all, which honey dew being taken doth ſlake the thirſt wonderfully: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea5958fd-d277-326a-add5-d11afc5f0a15",
                                        "entry_id": "30bf978e-9bbc-37d4-994f-239d51fbe0e4",
                                        "glosses": [
                                            "A sweet liquid substance resembling the substance mentioned in sense 1, such as honey, nectar, or manna in the Bible."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfebd281-447d-4f43-8b27-c3372e21766e",
                                                "sense_id": "ea5958fd-d277-326a-add5-d11afc5f0a15",
                                                "text": "[F]reſh teares / Stood on her cheeks, as doth the honie devv, / Vpon a gathred Lillie almoſt vvithered."
                                            },
                                            {
                                                "example_id": "5054eec9-7a2c-4edf-9c88-93c8e9ff9f9c",
                                                "sense_id": "ea5958fd-d277-326a-add5-d11afc5f0a15",
                                                "text": "In India, and eſpecially in the region of the Praſians, it raineth many times a dew like liquid hony falling vppon the hearbs and graſſe of the earth: wherefore the ſhepheards lead their flocks vnto thoſe places, wherwithal their cattle are much delighted, and ſuch as is the food they eat, ſuch alſo is the taſt of the milke they render; […] Such a kind of dew the Hæbrewes call Manna, the Græcians Aeromelos, and Droſomelos: The Germaines Himmelhung: and in Engliſh Honny-dew: […]"
                                            },
                                            {
                                                "example_id": "f6445b93-57b9-4d84-9b0c-d66e9ee22699",
                                                "sense_id": "ea5958fd-d277-326a-add5-d11afc5f0a15",
                                                "text": "Weave a circle round him thrice, / And close your eyes with holy dread: / For he on honey-dew hath fed, / And drank the milk of Paradise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e28d8c-22f1-349c-aab4-73a6171abe3b",
                                        "entry_id": "30bf978e-9bbc-37d4-994f-239d51fbe0e4",
                                        "glosses": [
                                            "A blackish mould (often called sooty mould) produced by fungi of the order Dothideales, feeding on the substance mentioned in sense 1."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df0fa057-bce9-3e93-b141-84c8cf718530",
                                        "entry_id": "30bf978e-9bbc-37d4-994f-239d51fbe0e4",
                                        "glosses": [
                                            "In full honeydew tobacco: a fine sort of tobacco moistened with a sweet substance (originally molasses)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acf47d28-28fc-3ef2-9d2e-1ff4bcf123b2",
                                        "entry_id": "30bf978e-9bbc-37d4-994f-239d51fbe0e4",
                                        "glosses": [
                                            "Ellipsis of honeydew melon (“a melon from the Cucumis melo Inodorus cultivar group, with sweet, light green or white flesh and a smooth greenish-white or yellow rind”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "broadly",
                                            "countable",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b57f3e3e-33cb-3a0a-a4d0-491a974a07f6",
                                        "entry_id": "30bf978e-9bbc-37d4-994f-239d51fbe0e4",
                                        "glosses": [
                                            "Ellipsis of honeydew melon (“a melon from the Cucumis melo Inodorus cultivar group, with sweet, light green or white flesh and a smooth greenish-white or yellow rind”).",
                                            "A light green colour, like the flesh of some honeydew melons."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb2ec23a-9a55-3512-9c88-8b78d5d5c1ce",
                                        "entry_id": "30bf978e-9bbc-37d4-994f-239d51fbe0e4",
                                        "glosses": [
                                            "Something that is enjoyable or pleasant."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4bee68-5c1d-4ba4-a933-33f80a8fd574",
                                                "sense_id": "cb2ec23a-9a55-3512-9c88-8b78d5d5c1ce",
                                                "text": "He was held vnworthy euer after to ſucke the Hony dew of Peace, that (againſt his comming, by whom our Peace weares a triple Wreathe) would offer to play the Droane."
                                            }
                                        ]
                                    }
                                ]
                            },
