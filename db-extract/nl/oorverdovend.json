                ],
                "senses": [
                    {
                        "sense_id": "6d2b5722-140f-353a-baaa-1f98043dbb1c",
                        "entry_id": "9c1d679b-ae53-30a3-b069-42b368116af4",
                        "glosses": [
                            "heel erg luid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f63b55ec-50d2-40f0-8be8-6fe3a049e4fd",
                                "sense_id": "6d2b5722-140f-353a-baaa-1f98043dbb1c",
                                "text": "Na het winnende doelpunt was er een oorverdovend gejuich in het stadion."
                            },
                            {
                                "example_id": "f46ef987-37fb-4a01-8183-4a60453d9472",
                                "sense_id": "6d2b5722-140f-353a-baaa-1f98043dbb1c",
                                "text": "Ik ontspande mijn knieën en werd zo ingeklemd door de lichamen om mij heen. Ik wiegde mee met het ritme van de metro en het oorverdovende lawaai ging dwars door me heen. Ik voelde hete adem in mijn nek en ik schaamde me."
                            }
                        ]
                    }
                ],
