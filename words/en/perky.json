{
    "word_family": [
        "perk",
        "perkiness",
        "perkily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a35ed8d0-fc56-3c6c-91ea-9d33fb8955f7",
                    "sense_definition": "Cheerful, lively, and full of energy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She greeted everyone with a <w>perky</w> smile and sat down.",
                            "target_lang_translations": {
                                "ru": "Она поприветствовала всех <w>задорной</w> улыбкой и села."
                            }
                        },
                        {
                            "text": "Even early in the morning, he always seems surprisingly <w>perky</w>.",
                            "target_lang_translations": {
                                "ru": "Даже рано утром он всегда кажется удивительно <w>бодрым</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "bubbly",
                        "upbeat",
                        "sprightly"
                    ],
                    "antonyms": [
                        "gloomy",
                        "lethargic",
                        "sullen"
                    ],
                    "common_phrases": [
                        "perky smile",
                        "perky attitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жизнерадостный, оживлённый и полный энергии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бойкий",
                                "target_lang_sense_clarification": "о живом и энергичном характере или поведении"
                            },
                            {
                                "target_lang_word": "жизнерадостный",
                                "target_lang_sense_clarification": "полный оптимизма и веселья"
                            },
                            {
                                "target_lang_word": "задорный",
                                "target_lang_sense_clarification": "о настроении, взгляде или улыбке"
                            },
                            {
                                "target_lang_word": "бодрый",
                                "target_lang_sense_clarification": "энергичный и свежий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f4390e5-c780-33a3-8154-25df12b0fc06",
                    "sense_definition": "Standing upright, firm, or pointing upward rather than drooping.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flowers looked much <w>perkier</w> after being placed in fresh water.",
                            "target_lang_translations": {
                                "ru": "Цветы стали выглядеть гораздо <w>бодрее</w>, после того как их поставили в свежую воду."
                            }
                        },
                        {
                            "text": "The puppy pricked up its small, <w>perky</w> ears at the sound.",
                            "target_lang_translations": {
                                "ru": "Щенок насторожил свои маленькие <w>торчащие</w> ушки, услышав звук."
                            }
                        }
                    ],
                    "synonyms": [
                        "upright",
                        "firm",
                        "erect"
                    ],
                    "antonyms": [
                        "drooping",
                        "sagging"
                    ],
                    "common_phrases": [
                        "perky ears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торчащий вверх, упругий или не поникший."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торчащий",
                                "target_lang_sense_clarification": "направленный вверх, не опущенный"
                            },
                            {
                                "target_lang_word": "упругий",
                                "target_lang_sense_clarification": "сохраняющий плотную форму и не увядший"
                            },
                            {
                                "target_lang_word": "бодрый",
                                "target_lang_sense_clarification": "о растениях, выглядящих свежими"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1091a148-4911-3a04-a812-f38357ce8679",
                    "sense_definition": "A tablet of the pain medication Percocet; alternative spelling of <w>percy</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He admitted to buying an illicit <w>perky</w> on the street corner.",
                            "target_lang_translations": {
                                "ru": "Он признался, что купил нелегальную <w>таблетку перкосета</w> на углу улицы."
                            }
                        },
                        {
                            "text": "The police seized several pills including a <w>perky</w> from the vehicle.",
                            "target_lang_translations": {
                                "ru": "Полиция изъяла из автомобиля несколько таблеток, включая <w>перкосет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "percy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in street slang for prescription painkillers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Таблетка рецептурного обезболивающего «Перкоцет» (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перкосет",
                                "target_lang_sense_clarification": "сленговое обозначение таблетки наркотического анальгетика"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}