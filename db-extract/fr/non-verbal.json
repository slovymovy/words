                                "example_id": "1ef424b7-28c9-46eb-8e9b-4045f2391d2e",
                                "sense_id": "f51afd87-6836-38bf-a461-987cc51597d6",
                                "text": "Les moyens d’expression non-verbaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86a51ec7-f2c5-4bd7-b3a3-c262a9e8fafd",
