                                "example_id": "6ab74127-4c3c-44c6-9a06-ef30f6e2733d",
                                "sense_id": "ac8df624-a4bc-3d61-a0f1-67fc46139408",
                                "text": "„Spontankäufe führen zwangsläufig zu mehr Tierleid, da sich die Käuferinnen und Käufer oft nicht über die Haltungsbedingungen informieren.“"
                            },
                            {
                                "example_id": "7c213ac6-6507-4be9-b82b-31e4d01d73a1",
                                "sense_id": "ac8df624-a4bc-3d61-a0f1-67fc46139408",
                                "text": "„Eine geradezu perfekte Gelegenheit für Spontankäufe aller Art, meinen Handelsexperten.“"
