                    {
                        "form_id": "929385a6-8f38-4a99-b485-929d7a441a60",
                        "entry_id": "d46481af-2d14-3bd0-97af-4e1d2db738c7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zeitverschwendungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
                        "entry_id": "d46481af-2d14-3bd0-97af-4e1d2db738c7",
                        "glosses": [
                            "sinnlose Aktivität; etwas, das unnötigen Aufwand verursacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7d0e4c-e6dd-4f4e-93b9-f6c7ae700126",
                                "sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
                                "text": "Es ist Zeitverschwendung, die Kontrolle fünfmal durchzuführen."
                            },
                            {
                                "example_id": "bab7bd9a-34b0-4907-a0a2-a0f3a257e643",
                                "sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
                                "text": "Diese Aufgabe ist Zeitverschwendung, da sie uns nicht weiterhelfen wird."
                            },
                            {
                                "example_id": "2fd9d163-0721-461e-9a66-fc8363628582",
                                "sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
                                "text": "„Es war reine Zeitverschwendung gewesen, mit diesem Journalisten zu reden, damit er keinen Unsinn schreibt.“"
                            },
                            {
                                "example_id": "39fdc3c6-f112-4a28-b8ee-581fee639ff7",
                                "sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
                                "text": "„Die surrealen Bildwelten des Spaniers erkennen normalerweise sogar diejenigen auf Anhieb, die Besuche in Kunstmuseen für Zeitverschwendung halten.“"
                            },
                            {
                                "example_id": "b817c39e-74b0-4363-b377-908e053845c8",
                                "sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
                                "text": "„Die Aussicht, noch weitere sechzig Male die geringen Verschiebungen im Felde zu sehen, kam ihr als eine ähnliche Zeitverschwendung vor wie die Stunden vor ihrer Abreise aus dem Sanatorium.“"
                            },
                            {
                                "example_id": "10ed5d98-1704-4462-84c7-0f74afc48d7e",
                                "sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
                                "text": "„Ich glaube, dass sehr viele Menschen zumindest etwas Talent zum Schreiben oder Erzählen besitzen und dass dieses Talent verfeinert und gefördert werden kann. Wäre ich davon nicht überzeugt, wäre es reine Zeitverschwendung, ein Buch wie dieses zu schreiben.“"
                            },
                            {
                                "example_id": "2d6bd114-3d2a-40da-a87d-a373fe68e329",
                                "sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
                                "text": "„Mein Studium ging voran, ich lernte, wie man alte Handschriften ausbesserte und Wandmalereien restaurierte, und obwohl ich weniger zum Lesen kam, da Philip das für eine unnütze Zeitverschwendung hielt und lieber fernsah, war ich zufrieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a6f698a-fe36-4744-b069-a9222d21e662",
                        "source_entry_id": "d46481af-2d14-3bd0-97af-4e1d2db738c7",
                        "source_sense_id": "99404d8c-a43c-3e18-b3c5-99f8ab797e70",
