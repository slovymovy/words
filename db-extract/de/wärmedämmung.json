                "senses": [
                    {
                        "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                        "entry_id": "3abbf3e7-1eda-32a9-aef5-cbc083c2b87c",
                        "glosses": [
                            "Schutz gegen den Verlust von Wärme; das Material, das für den Schutz sorgt"
                        ],
                        "tags": [
                            "Bautechnik",
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "f5e58cd6-c15a-4a55-92d3-1213f1e46e05",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Im Winter verbessern Gründächer die Wärmedämmung, im Sommer schirmen sie Hitze ab.“"
                            },
                            {
                                "example_id": "2c0611e9-8556-4236-bc31-04e63427114b",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "[Ulaanbaatar:] „In der kältesten Hauptstadt der Welt zeigen Grundschulen, wie Wärmedämmung Energie sparen kann.“"
                            },
                            {
                                "example_id": "e2dbfd55-9e38-499e-9e55-64d175888b5e",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Bis Mitte des 20. Jahrhunderts hatte die Wärmedämmung von Gebäuden einen geringen Stellenwert. Man behalf sich durch wärmende Bekleidung und das Zusammenrücken in wenigen, tagsüber mit vorwiegend wärmestrahlenden Einzelöfen beheizten Räumen.“"
                            },
                            {
                                "example_id": "abb9d7b4-8d33-4968-b929-e37c55696b17",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "[…] „Viele Häuser besitzen keine oder nur eine sehr bescheidene Wärmedämmung,“ […]."
                            },
                            {
                                "example_id": "d18137ab-7b18-456c-87f6-b3b2efb5fcb1",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Eine verbreitete nachträgliche Wärmedämmung, in Altbauten wie auch bei Neubauten, ist die Beschichtung der Außenwand mit einer Wärmedämmschicht, die mit Putz abgedeckt wird.“"
                            },
                            {
                                "example_id": "06a66386-1ee8-407b-9a9c-f7b4de5c3008",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Fenster haben eine deutlich schlechtere Wärmedämmung als Wände.“"
                            },
                            {
                                "example_id": "e69cb3ba-49f5-4883-ba4c-0cdff0a3f19a",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "[Fenster:] „Ab Anfang der 2000er Jahre werden Dreifach-Isoliergläser mit immer besserer Wärmedämmung gebaut, die Wärmedämmung der Fenster wird gesteigert und ermöglicht den Bau von Niedrig-Energie- und Passivhäusern.“"
                            },
                            {
                                "example_id": "f92fb30b-9333-484c-b908-d6dcc5e9b84d",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Manfred G. aus Pinneberg in Schleswig-Holstein hat sich zur Wärmedämmung eine Schiebetür mit Dreifachverglasung einbauen lassen.“"
                            },
                            {
                                "example_id": "7ed95fdc-349d-4179-bd8a-39a4fbd6640a",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Zwischen baulichen Maßnahmen zur Schall- und Wärmedämmung gibt es Unterschiede, die nicht immer leicht nachzuvollziehen sind. Eine Faustregel sagt: Schallschutzverbesserungen sind auch Wärmeschutzverbesserungen. Diese Regel gilt jedoch nicht umgekehrt!“"
                            },
                            {
                                "example_id": "ffcb75c3-5d3d-4d25-b687-e9c1adf66fbf",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Je geringer die Wärmeleitfähigkeit einer Wand ist, desto besser ist die Wärmedämmung.“"
                            },
                            {
                                "example_id": "b4b7e57d-b978-4caa-8a0c-4d068aa084bf",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Das Problem bei vielen Häusern: Sie sind mit einer Wärmedämmung verkleidet, üblicherweise aus Polystyrol-Platten (Styropor) - und die können Feuer fangen.“"
                            },
                            {
                                "example_id": "632158b7-6ceb-4d7d-8f71-8b7f942f316c",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Für sparsame Heizungen erhält der Aargauer Hausbesitzer also weniger Geld. Dafür gibt es neuerdings höhere Förderbeiträge für die Wärmedämmung von Fassaden, Dächern, Wänden und Böden.“"
                            },
                            {
                                "example_id": "10b971bd-f7a0-4374-ada3-0a9c4b94a131",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Damit eine Wärmepumpe effektiv arbeitet, empfehlen Energieberater gerade bei älteren Häusern eine umfangreiche Wärmedämmung. Doch das erschien vielen Hausbesitzern bislang zu teuer.“"
                            },
                            {
                                "example_id": "7b2df75a-24c2-4135-acb7-ca641fc23ef9",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "„Früher hatten Fassaden Verzierungen, Nischen und Holzverkleidungen, an und in denen Spatzen ihr Nest bauen konnten. Heute sind Fassaden glatt und die Wärmedämmung schließt alle Lücken oder Spalten.“"
                            },
                            {
                                "example_id": "6ea5606a-ccc7-4f36-a20b-1d3468965c9a",
                                "sense_id": "16220327-1880-3c64-8fae-bef58d64a111",
                                "text": "Meist sind es „Spechte oder Dohlen, die Löcher in die Wärmedämmung reinhämmern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
