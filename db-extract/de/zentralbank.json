                "senses": [
                    {
                        "sense_id": "570b42c7-59a3-3644-ac44-162582c2c211",
                        "entry_id": "0d64f79d-6929-35d1-baa3-ebd41b716d77",
                        "glosses": [
                            "Notenbank, die gleichzeitig währungspolitische Aufgaben eines Landes wahrnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584f0a3a-b0f1-478a-9be4-6ae0e0e9d072",
                                "sense_id": "570b42c7-59a3-3644-ac44-162582c2c211",
                                "text": "„Mit der Errichtung von Zentralbanken war oft auch eine Zentralisierung des Geldwesens und die Schaffung einer einheitlichen Währung verbunden.“"
                            },
                            {
                                "example_id": "360b671e-4740-49ad-bd11-3725e46aef62",
                                "sense_id": "570b42c7-59a3-3644-ac44-162582c2c211",
                                "text": "„Die primäre und unverzichtbare Funktion der Zentralbanken ist die Stabilisierung des Finanzsystems.“"
                            },
                            {
                                "example_id": "21549b2a-516c-4871-9014-e943e51d2c5a",
                                "sense_id": "570b42c7-59a3-3644-ac44-162582c2c211",
                                "text": "„Alle nationalen Zentralbanken der Eurozone müssen abgeschafft und deren Befugnisse auf die EZB übertragen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00b88bc3-50b8-469d-a89f-fd57484b6ee9",
                        "source_entry_id": "0d64f79d-6929-35d1-baa3-ebd41b716d77",
                        "source_sense_id": "570b42c7-59a3-3644-ac44-162582c2c211",
                        "source_sense_description": "Wirtschaft: Notenbank, die gleichzeitig währungspolitische Aufgaben eines Landes wahrnimmt",
                        "target_lang_word": "central bank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "central bank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fcd639b-6e7b-315d-9f64-2ea8d4701728",
                                        "entry_id": "6ddc0711-ed9e-31b3-bd9f-3e7ec5254591",
                                        "glosses": [
                                            "The principal monetary authority of a polity or monetary union; it normally regulates the supply of money, issues currency and controls interest rates. It usually oversees banking activity within its country's borders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f5c7947-536a-499b-9145-04c2e88a0772",
                        "source_entry_id": "0d64f79d-6929-35d1-baa3-ebd41b716d77",
                        "source_sense_id": "570b42c7-59a3-3644-ac44-162582c2c211",
                        "source_sense_description": "Wirtschaft: Notenbank, die gleichzeitig währungspolitische Aufgaben eines Landes wahrnimmt",
                        "target_lang_word": "banque centrale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banque centrale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8adf771-bf6e-3a1b-8e08-99f47f67f7e1",
                                        "entry_id": "46bca452-9190-3835-8bde-414bc1ec9402",
                                        "glosses": [
                                            "Institution chargée, par un État ou un ensemble d’États, de décider et d'appliquer une politique monétaire."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d020549-ab3f-4c1e-b203-fbe3ba7d3816",
                                                "sense_id": "d8adf771-bf6e-3a1b-8e08-99f47f67f7e1",
                                                "text": "Le statut d'indépendance des banques centrales s'est largement imposé dans les pays développés depuis une dizaine d'années. En Europe notamment, l'avancée vers l'Union Économique et Monétaire a conduit une dizaine de pays à modifier l'organisation de leur banque centrale et à adopter ce statut."
                                            },
                                            {
                                                "example_id": "1fdc4152-8e07-438f-9c16-dfc1c75a7085",
                                                "sense_id": "d8adf771-bf6e-3a1b-8e08-99f47f67f7e1",
                                                "text": "Lorsque la Banque centrale européenne décide d'augmenter les taux des réserves obligatoires, elle accroît le besoin de refinancement des banques."
                                            },
                                            {
                                                "example_id": "1cab03d8-afd7-4add-9d19-1513813a0b19",
                                                "sense_id": "d8adf771-bf6e-3a1b-8e08-99f47f67f7e1",
                                                "text": "C’est pourquoi des banques centrales indépendantes et focalisées sur l’inflation sont aujourd’hui comme hier les conditions nécessaires bien que non suffisantes au maintien du niveau de vie des ménages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e4dbb77-f41b-4f7c-aaf3-182b2856630d",
                        "source_entry_id": "0d64f79d-6929-35d1-baa3-ebd41b716d77",
                        "source_sense_id": "570b42c7-59a3-3644-ac44-162582c2c211",
