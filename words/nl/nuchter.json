    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b26578b-8d30-3429-bb28-f72594e8d9b6",
                    "sense_definition": "praktisch en zakelijk ingesteld, zonder zich door emoties of fantasie te laten leiden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mentaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij staat bekend om zijn <w>nuchtere</w> kijk op de complexe problemen van het bedrijf.",
                            "target_lang_translations": {
                                "en": "He is known for his <w>down-to-earth</w> view on the company's complex problems.",
                                "ru": "Он известен своим <w>трезвым</w> взглядом на сложные проблемы компании."
                            }
                        },
                        {
                            "text": "Nederlanders worden vaak omschreven als een <w>nuchter</w> volk dat met beide benen op de grond staat.",
                            "target_lang_translations": {
                                "en": "Dutch people are often described as a <w>sober</w> people who keep both feet on the ground.",
                                "ru": "Голландцев часто описывают как <w>прагматичный</w> народ, который крепко стоит на ногах."
                            }
                        }
                    ],
                    "antonyms": [
                        "emotioneel",
                        "zweverig",
                        "romantisch"
                    ],
                    "common_phrases": [
                        "nuchtere kijk",
                        "nuchter bekijken"
                    ],
                    "target_lang_definitions": {
                        "en": "practical and business-like, without being led by emotions or fantasy",
                        "ru": "практичный и деловой, не позволяющий эмоциям или фантазиям руководить собой"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "down-to-earth",
                                "target_lang_sense_clarification": "practical and realistic"
                            },
                            {
                                "target_lang_word": "sober",
                                "target_lang_sense_clarification": "serious and realistic"
                            },
                            {
                                "target_lang_word": "level-headed",
                                "target_lang_sense_clarification": "calm and sensible"
                            },
                            {
                                "target_lang_word": "matter-of-fact",
                                "target_lang_sense_clarification": "unemotional and practical"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "трезвый",
                                "target_lang_sense_clarification": "рассудительный и реалистичный"
                            },
                            {
                                "target_lang_word": "прагматичный",
                                "target_lang_sense_clarification": "деловой и практичный"
                            },
                            {
                                "target_lang_word": "приземленный",
                                "target_lang_sense_clarification": "реалистичный, без лишних фантазий"
                            },
                            {
                                "target_lang_word": "здравомыслящий",
                                "target_lang_sense_clarification": "обладающий здравым смыслом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40dcc6c5-2d4f-36d9-b09f-f7c2aee7f047",
                    "sense_definition": "niet onder invloed van alcohol of drugs",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nu hij weer <w>nuchter</w> was, bleek hij een heel redelijk mens te zijn.",
                            "target_lang_translations": {
                                "en": "Now that he was <w>sober</w> again, he turned out to be a very reasonable person.",
                                "ru": "Теперь, когда он снова был <w>трезв</w>, он оказался вполне разумным человеком."
                            }
                        },
                        {
                            "text": "Je mag alleen autorijden als je volledig <w>nuchter</w> bent en geen alcohol hebt gedronken.",
                            "target_lang_translations": {
                                "en": "You are only allowed to drive if you are completely <w>sober</w> and have not consumed any alcohol.",
                                "ru": "Водить машину можно только в том случае, если вы полностью <w>трезвы</w> и не употребляли алкоголь."
                            }
                        }
                    ],
                    "synonyms": [
                        "sober"
                    ],
                    "antonyms": [
                        "dronken",
                        "zat",
                        "onder invloed"
                    ],
                    "common_phrases": [
                        "weer nuchter worden",
                        "volledig nuchter"
                    ],
                    "target_lang_definitions": {
                        "en": "not under the influence of alcohol or drugs",
                        "ru": "не находящийся под воздействием алкоголя или наркотиков"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sober",
                                "target_lang_sense_clarification": "not intoxicated"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "трезвый",
                                "target_lang_sense_clarification": "не пьяный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c876330-017f-392f-aa6b-2df6026ad3c4",
                    "sense_definition": "nog niets gegeten of gedronken hebbend sinds het ontwaken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest die medicijnen op een <w>nuchtere</w> maag inslikken voor het beste resultaat.",
                            "target_lang_translations": {
                                "en": "He had to swallow those medicines on an <w>empty</w> stomach for the best result.",
                                "ru": "Для достижения наилучшего результата ему нужно было принимать эти лекарства на <w>голодный</w> желудок."
                            }
                        },
                        {
                            "text": "Voor het bloedonderzoek in het ziekenhuis moet de patiënt morgenochtend <w>nuchter</w> blijven.",
                            "target_lang_translations": {
                                "en": "For the blood test at the hospital, the patient must <w>fast</w> tomorrow morning.",
                                "ru": "Для анализа крови в больнице пациент завтра утром должен быть <w>натощак</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op nuchtere maag",
                        "nuchter blijven"
                    ],
                    "target_lang_definitions": {
                        "en": "having had nothing to eat or drink since waking up",
                        "ru": "ничего не евший и не пивший с момента пробуждения"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fasting",
                                "target_lang_sense_clarification": "on an empty stomach for medical reasons"
                            },
                            {
                                "target_lang_word": "on an empty stomach",
                                "target_lang_sense_clarification": "without having eaten"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "натощак",
                                "target_lang_sense_clarification": "на пустой желудок"
                            },
                            {
                                "target_lang_word": "голодный",
                                "target_lang_sense_clarification": "не евший с утра (в медицинском контексте)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b20e8dd0-b631-34fb-84da-2cf64dd20146",
                    "sense_definition": "pasgeboren, met name gebruikt voor dieren",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "leeftijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer controleerde het <w>nuchtere</w> kalfje dat net in de wei was geboren.",
                            "target_lang_translations": {
                                "en": "The farmer checked the <w>newborn</w> calf that had just been born in the meadow.",
                                "ru": "Фермер осматривал <w>новорожденного</w> теленка, который только что родился на лугу."
                            }
                        },
                        {
                            "text": "Een <w>nuchter</w> dier heeft direct na de geboorte extra zorg en warmte nodig.",
                            "target_lang_translations": {
                                "en": "A <w>newborn</w> animal needs extra care and warmth immediately after birth.",
                                "ru": "<w>Новорожденному</w> животному сразу после рождения требуются дополнительный уход и тепло."
                            }
                        }
                    ],
                    "synonyms": [
                        "pasgeboren"
                    ],
                    "common_phrases": [
                        "nuchter kalf"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Vaak gebruikt in agrarische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "newborn, specifically used for livestock animals",
                        "ru": "новорожденный, в частности используется для сельскохозяйственных животных"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "newborn",
                                "target_lang_sense_clarification": "just born, used for calves"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "новорожденный",
                                "target_lang_sense_clarification": "только что родившийся (о телятах)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d9d76b30-cac3-3fce-8cc7-fcb71f2332bb",
                    "sense_definition": "op een zakelijke en emotieloze manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij reageerde heel <w>nuchter</w> op het slechte nieuws van de directie.",
                            "target_lang_translations": {
                                "en": "She reacted very <w>matter-of-factly</w> to the bad news from the board.",
                                "ru": "Она очень <w>трезво</w> отреагировала на плохие новости от руководства."
                            }
                        },
                        {
                            "text": "De feiten werden <w>nuchter</w> gepresenteerd zonder enige vorm van overdrijving.",
                            "target_lang_translations": {
                                "en": "The facts were presented <w>soberly</w> without any form of exaggeration.",
                                "ru": "Факты были изложены <w>беспристрастно</w>, без какого-либо преувеличения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nuchter reageren",
                        "nuchter vaststellen"
                    ],
                    "target_lang_definitions": {
                        "en": "in a business-like and unemotional manner",
                        "ru": "деловым и беспристрастным образом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "matter-of-factly",
                                "target_lang_sense_clarification": "without emotion"
                            },
                            {
                                "target_lang_word": "soberly",
                                "target_lang_sense_clarification": "in a serious and sensible way"
                            },
                            {
                                "target_lang_word": "dispassionately",
                                "target_lang_sense_clarification": "without being influenced by emotion"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "трезво",
                                "target_lang_sense_clarification": "без лишних эмоций"
                            },
                            {
                                "target_lang_word": "хладнокровно",
                                "target_lang_sense_clarification": "спокойно и рассудительно"
                            },
                            {
                                "target_lang_word": "прагматично",
                                "target_lang_sense_clarification": "с практической точки зрения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
