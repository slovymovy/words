                "senses": [
                    {
                        "sense_id": "2e737826-8fb0-3892-93b4-b50f0723a866",
                        "entry_id": "a05543be-8202-39a9-931c-39ff56b84677",
                        "glosses": [
                            "odczytywanie wartości numerologicznej ze słów na podstawie liter, z których się składają, popularne w dawnej żydowskiej hermeneutyce biblijnej i współczesnym wróżbiarstwie"
                        ],
                        "tags": [
                            "esoteric"
                        ],
                        "examples": [
                            {
                                "example_id": "d1c2056b-315e-46fe-a154-4a45e7b9d1f4",
                                "sense_id": "2e737826-8fb0-3892-93b4-b50f0723a866",
                                "text": "Do dywinacji wykorzystywano także liczby (arytomancja) i litery (gematria, onomancja). Starożytni Grecy porównywali liczbę i wartość liter w imionach zawodników i na tej podstawie typowali zwycięzcę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5391816e-184e-4395-a032-82f6c9fc44ff",
                        "source_entry_id": "a05543be-8202-39a9-931c-39ff56b84677",
