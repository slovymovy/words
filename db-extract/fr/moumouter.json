                "senses": [
                    {
                        "sense_id": "bab2a4e1-c492-3167-b656-b62572b80474",
                        "entry_id": "d9578e62-fcf8-3449-a19a-f2fd18ae513c",
                        "glosses": [
                            "Mignoter, faire des mignardises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23ccd08-efc3-4e3a-9f99-f2a972addb34",
                                "sense_id": "bab2a4e1-c492-3167-b656-b62572b80474",
                                "text": "Des femmes noires et coties, leurs jupes sentent le beurre oublié dans le garde-manger, rien à voir avec les mamies sucrées du livre de lectures, surmontées d’un chignon neigeux et qui moumoutent leurs petits-enfants en leur racontant des histoires de fées, des aïeules ça s’appelle."
                            },
                            {
                                "example_id": "6f32cd66-e166-4fe1-a392-f95100f77bca",
                                "sense_id": "bab2a4e1-c492-3167-b656-b62572b80474",
                                "text": "Tôt ou tard, maman Langrishe allait découvrir ce que son fils chéri fabriquait quand il n’était pas auprès d’elle à la maison à se faire moumouter les cheveux."
                            }
                        ]
                    }
                ],
