                "translations": [
                    {
                        "translation_id": "5c161a27-41f0-4ee6-ad88-a6af9f1b7b20",
                        "source_entry_id": "cc260ff3-0f68-35db-803f-8001226fdf58",
                        "source_sense_id": "f37d279d-f3c4-34f3-aa47-0fbd6b363722",
                        "target_lang_word": "reconnaissance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reconnaissance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1503dd8e-c3b4-3259-8888-c5c9ee8a899b",
                                        "entry_id": "bc857fea-18fe-3251-b00d-1df913a4b365",
                                        "glosses": [
                                            "The act of scouting or exploring (especially military or medical) to gain information."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b7fdc30-c76a-405f-b17b-729628635d91",
                                                "sense_id": "1503dd8e-c3b4-3259-8888-c5c9ee8a899b",
                                                "text": "The third member, Sergeant Pieter Rousseau, had been with the back-up teams at the Hub; he was an expert on space reconnaissance instrumentation, but on this trip he would have to depend on his own eyes and a small portable telescope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abdc35ec-88e6-49db-86e6-e5601796e4a7",
                        "source_entry_id": "cc260ff3-0f68-35db-803f-8001226fdf58",
                        "source_sense_id": "f37d279d-f3c4-34f3-aa47-0fbd6b363722",
                        "target_lang_word": "Aufklärung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufklärung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25e83324-956d-37a0-b770-51a56a8b04d8",
                                        "entry_id": "e56353e7-b94e-3eaf-98c6-96dded76fc7e",
                                        "glosses": [
                                            "Information über Sachverhalte, Zusammenhänge oder Gefahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0abf63cc-188c-459c-bbc1-24ea4503812f",
                                                "sense_id": "25e83324-956d-37a0-b770-51a56a8b04d8",
                                                "text": "Deine Gruppe war maßgeblich an der Aufklärung des Verbrechens beteiligt."
                                            },
                                            {
                                                "example_id": "52596965-1db6-4f98-a849-79845e45db0a",
                                                "sense_id": "25e83324-956d-37a0-b770-51a56a8b04d8",
                                                "text": "Eltern überlassen die sexuelle Aufklärung größtenteils immer noch der Schule."
                                            },
                                            {
                                                "example_id": "2c3b0ce9-eb70-4b69-9b65-b66b71d9466b",
                                                "sense_id": "25e83324-956d-37a0-b770-51a56a8b04d8",
                                                "text": "Ja, Angst ist ein Herrschaftsinstrument, ein sehr effektives, das bestehende Verhältnisse verfestigt und zementiert. […] Aufklärung ist ein klassisches Instrument gegen Angst. Ich [Designtheoretiker Friedrich von Borries] glaube an Aufklärung. Und so verstehe ich natürlich auch meine Arbeit, als Appell, statt alles zu glauben, analytisch hinter die Dinge zu gucken und ihre wahre Bedeutung oder noch andere Dimensionen von Bedeutung zu entdecken."
                                            },
                                            {
                                                "example_id": "cf70c158-9d99-40c3-85f6-9e3816d89bee",
                                                "sense_id": "25e83324-956d-37a0-b770-51a56a8b04d8",
                                                "text": "„Nach Aufklärung durch den Referee war zumindest eines klar – wer zuerst Punkte erzielt, ist der neue Champion.“"
                                            },
                                            {
                                                "example_id": "d822daa6-2040-4c05-946f-0b2c7ce9dc49",
                                                "sense_id": "25e83324-956d-37a0-b770-51a56a8b04d8",
                                                "text": "Die Aufklärung bezeichnet eine geistes- und kulturgeschichtliche Epoche, ist aber auch ein militärischer Fachausdruck. Manche Eltern machte der Begriff früher nervös und trieb ihnen die Schamröte ins Gesicht. Warum? Aufklärung hieß die ungeliebte Pflicht, den heranwachsenden Mädchen und Jungen beibringen zu müssen, dass es nicht der Storch war, der sie ins Haus gebracht hatte, sondern dass sie auf anderem Wege entstanden sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b82023b0-235e-33f0-890f-ffe4ff00a6a1",
                                        "entry_id": "e56353e7-b94e-3eaf-98c6-96dded76fc7e",
                                        "glosses": [
                                            "geistesgeschichtliche Epoche im 18. Jahrhundert"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca5a8c1-8b8c-4844-bd1b-8689d2606a96",
                                                "sense_id": "b82023b0-235e-33f0-890f-ffe4ff00a6a1",
                                                "text": "Die Bewegung für vernunftgemäßes Denken, gegen Vorurteile und religiösen Aberglauben sowie zur Verbreitung von Wissenschaft und Bildung im 18. Jahrhundert wird auch als Aufklärung bezeichnet."
                                            },
                                            {
                                                "example_id": "4cd87684-f275-45c1-b2bd-0bcbca820e60",
                                                "sense_id": "b82023b0-235e-33f0-890f-ffe4ff00a6a1",
                                                "text": "„Die 1544 gegründete Königsberger Universität war unschätzbar wichtig für die Entwicklung der Wissenschaft und der Aufklärung in ihren Nachbarländern.“"
                                            },
                                            {
                                                "example_id": "15e7ab2c-c0cc-4f16-98a4-8f4fa11de9b6",
                                                "sense_id": "b82023b0-235e-33f0-890f-ffe4ff00a6a1",
                                                "text": "„Im Zeitalter der Aufklärung war Denken mit den Mitteln der Vernunft, losgelöst von altherbrachten, starren und überholten Vorstellungen angesagt.“"
                                            },
                                            {
                                                "example_id": "6449281e-e2aa-49be-84e1-be0d0d6c0721",
                                                "sense_id": "b82023b0-235e-33f0-890f-ffe4ff00a6a1",
                                                "text": "„Im Zeitalter der Aufklärung fand die Idee von der Gleichheit aller Menschen weite Verbreitung unter den Intellektuellen des deutschen Bürgertums und weckte bei vielen Juden Hoffnung auf Akzeptanz, wenn nicht völlige Gleichberechtigung.“"
                                            },
                                            {
                                                "example_id": "22c7d9a3-8c1b-4345-b4b0-f373c7d489c0",
                                                "sense_id": "b82023b0-235e-33f0-890f-ffe4ff00a6a1",
                                                "text": "„Der Geist der Aufklärung, ihr Optimismus und Fortschrittsglaube erlitten einen heftigen (äußeren) Stoß.“"
                                            },
                                            {
                                                "example_id": "d4010712-504a-46ee-95b0-2302ea280d3f",
                                                "sense_id": "b82023b0-235e-33f0-890f-ffe4ff00a6a1",
                                                "text": "Die Aufklärung bezeichnet eine geistes- und kulturgeschichtliche Epoche, ist aber auch ein militärischer Fachausdruck. Manche Eltern machte der Begriff früher nervös und trieb ihnen die Schamröte ins Gesicht. Warum? Aufklärung hieß die ungeliebte Pflicht, den heranwachsenden Mädchen und Jungen beibringen zu müssen, dass es nicht der Storch war, der sie ins Haus gebracht hatte, sondern dass sie auf anderem Wege entstanden sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "528dd163-d95e-3001-a03d-4b1533f30e36",
                                        "entry_id": "e56353e7-b94e-3eaf-98c6-96dded76fc7e",
                                        "glosses": [
                                            "die Erkundung, das Auskundschaften, die Spionage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898f74d9-dc31-42b5-88ba-a2ff805b41de",
                                                "sense_id": "528dd163-d95e-3001-a03d-4b1533f30e36",
                                                "text": "Um mehr über die militärische Stellung zu erfahren, sollten wir eine Drohne zur Aufklärung hinschicken."
                                            },
                                            {
                                                "example_id": "fac11565-b0cc-42cd-bac8-bf6150bd9907",
                                                "sense_id": "528dd163-d95e-3001-a03d-4b1533f30e36",
                                                "text": "Die Aufklärung bezeichnet eine geistes- und kulturgeschichtliche Epoche, ist aber auch ein militärischer Fachausdruck. Manche Eltern machte der Begriff früher nervös und trieb ihnen die Schamröte ins Gesicht. Warum? Aufklärung hieß die ungeliebte Pflicht, den heranwachsenden Mädchen und Jungen beibringen zu müssen, dass es nicht der Storch war, der sie ins Haus gebracht hatte, sondern dass sie auf anderem Wege entstanden sind."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e84db763-86ed-4162-bf4b-ec3196c1d584",
                        "source_entry_id": "cc260ff3-0f68-35db-803f-8001226fdf58",
                        "source_sense_id": "f37d279d-f3c4-34f3-aa47-0fbd6b363722",
                        "target_lang_word": "Erkundung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erkundung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85a3f402-f44a-3bf9-a9b5-f1fbde3801fb",
                                        "entry_id": "79fd94c0-cb34-32be-b44e-b8a25e17f8e6",
                                        "glosses": [
                                            "Aktion, um sich über etwas Gewissheit/Wissen zu verschaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc62e4b-5b9e-4973-892f-f0636afd2acc",
                                                "sense_id": "85a3f402-f44a-3bf9-a9b5-f1fbde3801fb",
                                                "text": "„Unser Besuch in Heyerode aber war keine Forschungsreise zur Erkundung von Animositäten, sondern das Resultat des noch immer reibungslos funktionierenden Thüringer Buschfunks.“"
                                            },
                                            {
                                                "example_id": "3bad4ee0-e653-431e-9b57-59aa3fc85532",
                                                "sense_id": "85a3f402-f44a-3bf9-a9b5-f1fbde3801fb",
                                                "text": "„In Deutschland dagegen erlosch eigenartigerweise das brennende Interesse an der Erkundung Zentralasiens nach der Zeit der Berliner Geographen Ritter und Richthofen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
