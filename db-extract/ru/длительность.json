                                                "example_id": "77b0768d-de60-42a5-8f2e-8c848b1f277c",
                                                "sense_id": "83467fbc-fa0f-3d69-969b-5abe661fe53f",
                                                "text": "La vie de l’homme est de courte durée."
                                            },
                                            {
                                                "example_id": "794cae43-5120-49b6-8961-ff04bd10d61c",
                                                "sense_id": "83467fbc-fa0f-3d69-969b-5abe661fe53f",
                                                "text": "Son règne fut de peu de durée, de longue durée."
                                            },
                                            {
                                                "example_id": "6ccf0662-233e-477b-9167-76e29f524bfe",
                                                "sense_id": "83467fbc-fa0f-3d69-969b-5abe661fe53f",
                                                "text": "Cette mode eut peu de durée."
                                            },
                                            {
                                                "example_id": "f753af77-5c95-4bd5-ba37-b1c1eaaa608a",
                                                "sense_id": "83467fbc-fa0f-3d69-969b-5abe661fe53f",
                                                "text": "La durée d’un traitement médical."
                                            },
                                            {
                                                "example_id": "2855ce90-6814-4a8e-ac80-23b755d79a38",
                                                "sense_id": "83467fbc-fa0f-3d69-969b-5abe661fe53f",
                                                "text": "La durée ordinaire des études."
                                            }
                                        ]
                                    },
