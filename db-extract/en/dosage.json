                        "entry_id": "da4a921b-51c5-37d9-af13-ee4b2c6bbaaf",
                        "glosses": [
                            "The administration of a medication etc, in a measured amount; dosing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f9036343-8624-3b2d-9596-9cd82ff938fa",
                        "entry_id": "da4a921b-51c5-37d9-af13-ee4b2c6bbaaf",
                        "glosses": [
                            "The addition of a small measured amount of a substance to something, e.g. sugar to wine."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c6f31b9f-d16c-3c38-bc47-5d7758417f5d",
                        "entry_id": "da4a921b-51c5-37d9-af13-ee4b2c6bbaaf",
                        "glosses": [
                            "The measured amount so administered or added (the dose), combined with the frequency of administration and the time period for which it is taken."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "84ea88a9-2fe2-4474-8b73-ae9a71824206",
                                "sense_id": "c6f31b9f-d16c-3c38-bc47-5d7758417f5d",
                                "text": "Why did he give you only a single 500 mg dose? The correct dosage of this antibiotic is one 500 mg tablet twice a day for 10 days."
                            }
                        ]
                    }
                ],
