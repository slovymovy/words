                "senses": [
                    {
                        "sense_id": "a90047f9-6fb1-385f-b7b3-49792fa46e17",
                        "entry_id": "e7003329-cf67-3b14-ae1b-45a5b50ec4f0",
                        "glosses": [
                            "To thrust with a sword; to stab at."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1002b32e-b2c0-4863-883c-cc3419e7fb2c",
                                "sense_id": "a90047f9-6fb1-385f-b7b3-49792fa46e17",
                                "text": "And then he flue on hir as he were wood, / And on hir breeche did hack and foyne a-good."
                            },
                            {
                                "example_id": "4d1fdf95-47ca-4541-8178-5b814f6d3b14",
                                "sense_id": "a90047f9-6fb1-385f-b7b3-49792fa46e17",
                                "text": "They lash, they foin, they pass, they strive to bore / Their corselets, and the thinnest parts explore."
                            },
                            {
                                "example_id": "20853acc-fceb-4784-b9c0-51332dc0214c",
                                "sense_id": "a90047f9-6fb1-385f-b7b3-49792fa46e17",
                                "text": "These Fastulfrs and Falsts could drink as well as they could foin or fight, and this has also been the case with me."
                            },
                            {
                                "example_id": "e77f2f34-77b5-4464-ad2a-79d39ddb47f5",
                                "sense_id": "a90047f9-6fb1-385f-b7b3-49792fa46e17",
                                "text": "He stroke, he soust, he foynd, he hewd, he lasht,"
                            }
                        ]
                    },
                    {
                        "sense_id": "3cf97e7e-e11e-3eea-9f26-39f550cca501",
                        "entry_id": "e7003329-cf67-3b14-ae1b-45a5b50ec4f0",
                        "glosses": [
                            "To prick; to sting."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    }
