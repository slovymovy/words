        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1a498a5-8260-3450-a074-3b2b7dc90578",
                    "sense_definition": "To give a solemn promise or pledge, especially of marriage or loyalty.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "promise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young couple stood before the altar to <w>plight</w> their troth to one another.",
                            "target_lang_translations": {
                                "ru": "Молодая пара стояла перед алтарем, чтобы <w>дать клятву</w> верности друг другу.",
                                "it": "La giovane coppia stava davanti all'altare per <w>giurarsi</w> eterna fedeltà."
                            }
                        },
                        {
                            "text": "He swore to <w>plight</w> his eternal loyalty to the crown.",
                            "target_lang_translations": {
                                "ru": "Он поклялся <w>дать обет</w> вечной верности короне.",
                                "it": "Giurò di <w>promettere</w> solennemente eterna lealtà alla corona."
                            }
                        }
                    ],
                    "synonyms": [
                        "pledge",
                        "vow",
                        "promise",
                        "swear"
                    ],
                    "common_phrases": [
