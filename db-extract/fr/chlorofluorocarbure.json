                        ]
                    },
                    {
                        "translation_id": "7b248964-ebb4-4932-bb1f-d613ad7e208d",
                        "source_entry_id": "0ac6d0f6-89fc-3b97-a44b-640359ab818d",
                        "source_sense_id": "d896dad4-2420-3318-8c4e-e037a5240306",
                        "source_sense_description": "Chimie",
                        "target_lang_word": "FCKW",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "FCKW",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "018696c3-7c32-37b4-83f4-918196617ffa",
                                        "entry_id": "dbe2ff73-8c17-3466-943f-6156ac5d653d",
                                        "glosses": [
                                            "Fluorchlorkohlenwasserstoffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c10af92-68e7-41ff-a9fa-37bf2a478c86",
                                                "sense_id": "018696c3-7c32-37b4-83f4-918196617ffa",
                                                "text": "Verantwortlich für die Lücke im Ozonschutzschild sind chemische Prozesse, die vom ultravioletten Licht der Sonne angetrieben, zunächst einzelne Chloratome aus den FCKW abspalten."
                                            },
                                            {
                                                "example_id": "63082d4e-7bfd-4e7e-afce-9e0f00dda9d4",
                                                "sense_id": "018696c3-7c32-37b4-83f4-918196617ffa",
                                                "text": "In dem Umweltabkommen wurde 1987 zum Schutz der Ozonschicht ein Verzicht auf Fluorchlorkohlenwasserstoffe (FCKW) vereinbart."
                                            },
                                            {
                                                "example_id": "64f9808a-aa01-40ae-a9e3-cc13736275bd",
                                                "sense_id": "018696c3-7c32-37b4-83f4-918196617ffa",
                                                "text": "„Ich wollte all das Schöne zerstören, das ich nie haben würde. Die Regenwälder am Amazonas niederbrennen. FCKW in die Atmosphäre pumpen, um das Ozon zu killen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2647473-fefe-4b42-b875-56b53d3f9560",
                        "source_entry_id": "0ac6d0f6-89fc-3b97-a44b-640359ab818d",
                        "source_sense_id": "d896dad4-2420-3318-8c4e-e037a5240306",
                        "source_sense_description": "Chimie",
                        "target_lang_word": "chlorofluorocarbon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlorofluorocarbon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3ffb2c-aab2-36b4-86ae-9c051355d9c8",
                                        "entry_id": "6a65cd30-0b59-3db4-a110-6afe3ac74657",
                                        "glosses": [
                                            "Any of a class of organic compounds in which the hydrogen atoms of a hydrocarbon are replaced with those of chlorine and fluorine; formerly used as refrigerants and aerosol can propellants but withdrawn due to causing damage to the ozone layer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f539c74f-b757-4fe4-9d1f-c5f9aa9da03c",
                                                "sense_id": "8a3ffb2c-aab2-36b4-86ae-9c051355d9c8",
                                                "text": "The proposed replacement for CFC-11, a chlorofluorocarbon used to make plastic foam and in central air-conditioning systems, is a compound called HCFC-22. This is a chlorofluorocarbon already in use in home air-conditioners, but it is more expensive than CFC-11 and its potential applications are limited by its inferior characteristics."
                                            },
                                            {
                                                "example_id": "881269e4-0d6f-4f27-bf38-7c140f0728d4",
                                                "sense_id": "8a3ffb2c-aab2-36b4-86ae-9c051355d9c8",
                                                "text": "The Renew is also free of polyvinyl chloride, asbestos, chlorofluorocarbons and halons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bffcf72-4df8-4812-be39-7fb02f5036cd",
