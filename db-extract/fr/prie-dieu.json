                        "cross_references": [
                            {
                                "target_word": "prie-dieu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e98d114-e771-391d-a8b7-607814d1be50",
                                        "entry_id": "7d1ae6ec-e73c-3d73-91a8-91f970df63f1",
                                        "glosses": [
                                            "A piece of furniture on which someone can pray, consisting of a cushioned area to kneel on, with a built-in ledge for books."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ccd463-4e53-439b-908b-81b52cb76db7",
                                                "sense_id": "2e98d114-e771-391d-a8b7-607814d1be50",
                                                "text": "Leaning her childish face and full chin on the shelf of the prie-Dieu, her eyes fixed, she laughed, out of some hidden capacity, some lost subterranean humour [...]."
                                            },
                                            {
                                                "example_id": "a7a7020e-9b0f-4054-97a0-b84b2253a034",
                                                "sense_id": "2e98d114-e771-391d-a8b7-607814d1be50",
                                                "text": "thinking to improve his hour, he took to kneeling at a prie-dieu and ventured upon some propitiatory prayers to the Virgin which might serve as a sort of scaffolding to the more important confession which was to follow."
                                            },
                                            {
                                                "example_id": "ed977a5d-d39f-470d-b9f7-bdef8e5d9323",
                                                "sense_id": "2e98d114-e771-391d-a8b7-607814d1be50",
                                                "text": "At her prie-dieu, she read in a calm voice the prayers for the dying."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c19e1d8-d77e-4147-8f5c-c8552af07904",
                        "source_entry_id": "b45637ab-ec74-348e-92bc-8c59a21c978c",
                        "source_sense_id": "760b1336-467d-3045-9e83-7333cedd62b2",
