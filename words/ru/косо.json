{
    "word_family": [
        "косой",
        "косить",
        "косина",
        "косоглазие"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b011c186-c33a-335e-b518-ab5a108215d2",
                    "sense_definition": "В наклонном, неровном или перекошенном направлении.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он начал <w>косо</w> смотреть на своих новых соседей.",
                            "target_lang_translations": {
                                "cs": "Začal se na své nové sousedy dívat <w>křivě</w>."
                            }
                        },
                        {
                            "text": "Картина висела на стене совсем <w>косо</w>.",
                            "target_lang_translations": {
                                "cs": "Obraz visel na stěně úplně <w>křivě</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "криво",
                        "набок"
                    ],
                    "antonyms": [
                        "прямо"
                    ],
                    "common_phrases": [
                        "смотреть косо"
                    ],
                    "target_lang_definitions": {
                        "cs": "V nakloněném, nerovném nebo zkřiveném směru; často vyjadřuje nedůvěru nebo nesouhlas."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "křivě",
                                "target_lang_sense_clarification": "obecně pro nesprávný úhel nebo nerovnost"
                            },
                            {
                                "target_lang_word": "šikmo",
                                "target_lang_sense_clarification": "pro vyjádření náklonu nebo úhlu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b81b02f0-8303-3ffb-8a94-6b11da3c0629",
                    "sense_definition": "Наречие к <w>косой</w>; не прямо, под углом.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дождь лил <w>косо</w> из-за сильного ветра.",
                            "target_lang_translations": {
                                "cs": "Déšť padal kvůli silnému větru <w>šikmo</w>."
                            }
                        },
                        {
                            "text": "Линия была проведена <w>косо</w> через весь лист бумаги.",
                            "target_lang_translations": {
                                "cs": "Čára byla vedena <w>šikmo</w> přes celý list papíru."
                            }
                        }
                    ],
                    "synonyms": [
                        "наискосок"
                    ],
                    "antonyms": [
                        "прямо"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ne přímo, pod úhlem, šikmo k rovině nebo linii."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šikmo",
                                "target_lang_sense_clarification": "ve směru pod úhlem"
                            },
                            {
                                "target_lang_word": "našikmo",
                                "target_lang_sense_clarification": "v poloze pod úhlem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50ae6150-0e14-3e61-9eb9-35ed1c3b7680",
                    "sense_definition": "Краткая форма среднего рода от прилагательного <w>косой</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его лицо было <w>косо</w> и неприятно искажено гримасой.",
                            "target_lang_translations": {
                                "cs": "Jeho obličej byl <w>křivě</w> a nepříjemně zkřiven grimasou."
                            }
                        },
                        {
                            "text": "Всё в этой комнате казалось <w>косо</w> поставленным.",
                            "target_lang_translations": {
                                "cs": "Všechno v té místnosti vypadalo, že je postaveno <w>nakřivo</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátký tvar přídavného jména vyjadřující stav zkřivení nebo náklonu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "křivě",
                                "target_lang_sense_clarification": "ve smyslu zkřiveného stavu"
                            },
                            {
                                "target_lang_word": "šikmo",
                                "target_lang_sense_clarification": "ve smyslu nakloněného stavu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}