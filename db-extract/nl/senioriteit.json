                                "target_senses": [
                                    {
                                        "sense_id": "56e03c02-f4b4-3f29-90e5-7b714f12fa3a",
                                        "entry_id": "5facdc22-957c-370f-b434-2e5bdf71f705",
                                        "glosses": [
                                            "Ancienneté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23fde1ed-ac0c-4a70-9c94-6213779b0b42",
                                                "sense_id": "56e03c02-f4b4-3f29-90e5-7b714f12fa3a",
                                                "text": "Est-ce qu’il vous impressionnait par sa séniorité, sa réputation."
                                            },
                                            {
                                                "example_id": "7546cfa4-ad6d-4cab-8993-9840e03e4e5b",
                                                "sense_id": "56e03c02-f4b4-3f29-90e5-7b714f12fa3a",
                                                "text": "Pourquoi la séniorité doit elle être roi et maitre dans les horaires."
                                            },
                                            {
                                                "example_id": "383985cc-3bdd-4410-84e8-7b82d8285202",
                                                "sense_id": "56e03c02-f4b4-3f29-90e5-7b714f12fa3a",
                                                "text": "Leur protégé se trouvait naturellement appelé à devenir lord maire par la position de séniorité qu’il occupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fdb083b-8255-3ffd-8dd7-c63fd2322fe0",
                                        "entry_id": "5facdc22-957c-370f-b434-2e5bdf71f705",
                                        "glosses": [
                                            "Priorité dans le remboursement, fondée sur le statut juridique d'une dette vis-à-vis d'autres dettes. → voir dette junior et dette sénior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf5f97d3-5ad4-4992-9e6a-49189c1c1237",
                                                "sense_id": "3fdb083b-8255-3ffd-8dd7-c63fd2322fe0",
                                                "text": "La perte de séniorité du MES reste « strictement limitée au cas espagnol », a précisé une source allemande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "059dcbc1-713c-3354-8f9f-baee4e06f872",
