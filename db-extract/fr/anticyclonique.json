                "senses": [
                    {
                        "sense_id": "6b67e2ee-e6b2-369b-a6d8-782e628b9135",
                        "entry_id": "d23d546a-f887-3ac9-9b05-832782bf03b6",
                        "glosses": [
                            "Relatif aux anticyclones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "241f09ea-a47f-498c-869d-291e8234bb2d",
                                "sense_id": "6b67e2ee-e6b2-369b-a6d8-782e628b9135",
                                "text": "La houle, qui pourrait se glisser sous le flux anticyclonique, se superpose à la mer du vent. La frégate est allée jusqu'au goulet de Brest."
                            }
                        ]
                    },
                    {
                        "sense_id": "6935e3d3-7611-3238-9eb8-b4ec0b1fb6a7",
                        "entry_id": "d23d546a-f887-3ac9-9b05-832782bf03b6",
                        "glosses": [
                            "Qualifie ce qui est propre à résister aux effets destructeurs des cyclones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c312346a-0ab3-45b5-87b2-e9e9ac740a9d",
                                "sense_id": "6935e3d3-7611-3238-9eb8-b4ec0b1fb6a7",
                                "text": "La construction paracyclonique ou anticyclonique est conçue pour résister à des vents d’au moins 210 km/h pour un coefficient de site de 1,20 (une construction de 10 mètres de hauteur doit pouvoir résister à des pressions de vent de plus de 250 kg par m2), aux débris aériens et à la pluie."
                            }
                        ]
                    }
