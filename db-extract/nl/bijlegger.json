                        "glosses": [
                            "iemand die zorgt dat bij het jeu-de-boules spelen de eigen ballen zo dicht mogelijk bij de but liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec37c37c-f6a5-45b9-9bab-550498f3b51d",
                                "sense_id": "826ce71b-33d3-362e-8425-48e13f64b7a7",
                                "text": "Reintjes speelt met haar vaste speelpartner Johan Heuvel. Hij is een echte wegschieter „die met zijn boules tegen die van de tegenstander stoot”. Reintjes is meer een bijlegger. „Ik zorg dat de eigen boules op de juiste plek eindigen”. Nederlands kampioenen zijn er op de club niet."
                            }
