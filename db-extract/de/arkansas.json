                    {
                        "translation_id": "5917f6c7-7d33-435c-8c16-e6757d58b9dd",
                        "source_entry_id": "c659b002-24d0-3b05-8286-86a42d0d1183",
                        "source_sense_id": "2ca1fb47-4266-3345-aa75-e7d14b676ba3",
                        "source_sense_description": "US-Bundesstaat im Süden der USA",
                        "target_lang_word": "Arkansas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arkansas",
