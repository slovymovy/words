                        "glosses": [
                            "Mettre dans une certaine atmosphère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d31cf89-9aa9-42f8-90ab-693221c49cdd",
                                "sense_id": "409a4e00-f30c-3b5a-9fb9-ce5b624b6a24",
                                "text": "Nous ajouterons que notre rôle consiste ici à \"atmosphériser\" la souffrance du sujet pour la mettre en présentation sous la forme d’un compos de formes mouvantes."
                            },
                            {
                                "example_id": "d641abd4-6298-4a06-a08c-091221282e3f",
                                "sense_id": "409a4e00-f30c-3b5a-9fb9-ce5b624b6a24",
                                "text": "Étrange propriété qu’a l’affectivité de « s’atmosphériser » avec et dans un Phantomleib alors même qu’elle peut être réellement (reell) vécue comme affect (dépourvu de significativité reconnaissable dans la figuration) par le Moi actuel."
                            }
                        ]
                    }
