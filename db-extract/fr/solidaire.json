                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1737a5f8-41a7-47a8-b1a6-01cdcafb8ce0",
                                "sense_id": "4f742e6b-8ccd-3fa3-997e-8df34ef140b1",
                                "text": "Des débiteurs solidaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "185e9ab4-a0a6-3891-809e-4d649bcbe789",
                        "entry_id": "2ed6cd29-305c-3d23-a7b3-5507ee16a5af",
                        "glosses": [
                            "Se dit des personnes qui répondent en quelque sorte les unes des autres, qui ont entre elles un lien de solidarité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d938b4f0-cfc0-49d0-b47c-3b6a7984934e",
                                "sense_id": "185e9ab4-a0a6-3891-809e-4d649bcbe789",
                                "text": "Nous sommes solidaires ; les torts de l’un de nous retombent sur tous les autres."
                            },
                            {
                                "example_id": "8b2bea96-adcc-4232-9110-21c341f95380",
                                "sense_id": "185e9ab4-a0a6-3891-809e-4d649bcbe789",
                                "text": "Les membres d’une famille sont tous moralement solidaires."
                            },
                            {
                                "example_id": "fce4dfa1-b853-4439-bda5-e9a5d28a4d09",
                                "sense_id": "185e9ab4-a0a6-3891-809e-4d649bcbe789",
                                "text": "Considérez-moi comme solidaire avec vous dans cet engagement."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f488865-b479-3c05-9ca0-b91921f11154",
                        "entry_id": "2ed6cd29-305c-3d23-a7b3-5507ee16a5af",
                        "glosses": [
                            "Qualifie des parties qui sont liées dans le fonctionnement d'un mécanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2237fc9-6532-410f-83cd-61bb5a16823f",
                                "sense_id": "2f488865-b479-3c05-9ca0-b91921f11154",
                                "text": "Cette protection mobile doit recouvrir la partie extérieure de la fraise de désilage et doit rester solidaire de la machine."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6290a35-7f93-374b-8e92-345543ea6070",
                        "entry_id": "2ed6cd29-305c-3d23-a7b3-5507ee16a5af",
