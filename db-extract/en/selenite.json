                                    {
                                        "sense_id": "f24d1d5d-b717-3652-ba64-4282a595b970",
                                        "entry_id": "437a735a-74cf-3820-a2c8-03eef70e8e9f",
                                        "glosses": [
                                            "(fiktiver) Bewohner des Mondes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65835359-612f-4a8d-a854-614f8974dbfc",
                                                "sense_id": "f24d1d5d-b717-3652-ba64-4282a595b970",
                                                "text": "„Möglicherweise haben die Seleniten längst die Fahne auf ihren Polen aufgepflanzt, während die irdischen Polfahrten der Franklin, Ross, Kane, Dumont d'Urville und Lambert allesamt kläglich scheiterten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Selenit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72bc929e-227b-3141-81d0-be0c44a64069",
                                        "entry_id": "8609ba16-7bbf-3d63-862c-85c03f9e6ae0",
                                        "glosses": [
                                            "Salz der selenigen Säure"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db09c2f-66c0-41b0-9294-56dd0bef4f93",
                                                "sense_id": "72bc929e-227b-3141-81d0-be0c44a64069",
                                                "text": "Selenite entstehen bei der Reaktion von seleniger Säure H₂SeO₃ mit Metallen. 2Mᴵ + H₂SeO₃ → M₂SeO₃ + H₂"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e698838-c70a-40de-9176-946d4d9f62d5",
