                                "example_id": "dd51209c-346d-491d-b824-08457eded097",
                                "sense_id": "bc80343f-de66-369d-bd6f-3597b4ca2f84",
                                "text": "Il ya en effet un commerce malhonnête qui consiste à suralcooliser les vins ordinaires et qui demande à être surveillé de près."
                            }
