                        ],
                        "examples": [
                            {
                                "example_id": "b2948d05-935b-4165-a3fa-e9018c0facd6",
                                "sense_id": "08954006-e9e1-334f-8663-e532a9e578db",
                                "text": "ACARE, subst. mas. (a-kare), ciron, petit ver de fromage.\nACARÉ, E, part. pass. de Acarer.\nACARER ou ACCARER, v. act. (a-ka-ré), (vieux mot formé de la prép. lat. ad, à ou vers, et du grec κάρη, tête, visage). Il signifiait confronter, mettre en face. Il n’est plus usité, on dit aujourd’hui confronter.\nACARIATION ou ACCARIATION, subst. fém. (a-ka-ri-a-cion), vieux mot formé d’acarer, il est inusité ; aujourd’hui on dit confrontation."
                            }
                        ]
                    }
