    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e1fcb0d-9e98-32b8-8774-556348361754",
                    "sense_definition": "Characteristic of or acting like an adversary; hostile, combative, or in conflict.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee meeting quickly turned into an <w>adversarial</w> debate between the two political parties.",
                            "target_lang_translations": {
                                "nl": "De commissievergadering mondde al snel uit in een <w>confronterend</w> debat tussen de twee politieke partijen."
                            }
                        },
                        {
                            "text": "Both sides agreed to adopt a less <w>adversarial</w> tone during the final negotiations.",
                            "target_lang_translations": {
                                "nl": "Beide partijen kwamen overeen om een minder <w>vijandige</w> toon aan te slaan tijdens de uiteindelijke onderhandelingen."
                            }
                        }
                    ],
                    "synonyms": [
                        "combative",
                        "hostile",
                        "confrontational",
                        "antagonistic"
                    ],
                    "antonyms": [
                        "cooperative"
                    ],
                    "common_phrases": [
                        "adversarial relationship",
                        "adversarial stance",
                        "adversarial tone"
                    ],
                    "target_lang_definitions": {
                        "nl": "Kenmerkend voor of handelend als een tegenstander; vijandig, strijdvaardig of confronterend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vijandig",
                                "target_lang_sense_clarification": "als een tegenstander"
                            },
                            {
                                "target_lang_word": "confronterend",
                                "target_lang_sense_clarification": "gericht op strijd of botsing"
                            },
                            {
                                "target_lang_word": "antagonistisch",
                                "target_lang_sense_clarification": "formeel, tegenovergesteld werkend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9346c6e1-0992-3162-be79-8bf82d3cbe67",
                    "sense_definition": "Relating to a legal system in which opposing parties present evidence and arguments to an impartial judge or jury.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country relies on an <w>adversarial</w> legal system to resolve major criminal disputes.",
                            "target_lang_translations": {
                                "nl": "Het land vertrouwt op een <w>adversatoir</w> rechtsstelsel om grote strafrechtelijke geschillen op te lossen."
                            }
                        },
                        {
                            "text": "Critics argue that an <w>adversarial</w> approach sometimes values winning over uncovering the truth.",
                            "target_lang_translations": {
                                "nl": "Critici stellen dat een <w>adversatoire</w> benadering het winnen soms belangrijker vindt dan het achterhalen van de waarheid."
                            }
                        }
                    ],
                    "common_phrases": [
                        "adversarial system",
                        "adversarial process"
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op een juridisch systeem waarin tegenpartijen bewijsmateriaal en argumenten voorleggen aan een onpartijdige rechter of jury (partijproces)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "adversatoir",
                                "target_lang_sense_clarification": "van een juridisch partijstelsel"
                            },
                            {
                                "target_lang_word": "op tegenspraak gebaseerd",
                                "target_lang_sense_clarification": "juridische procedure"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}