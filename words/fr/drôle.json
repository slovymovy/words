        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a29e1dd1-6e59-38a3-b63b-fd238b5d577e",
                    "sense_definition": "Personne rouée, mauvais sujet ou fripon dont il faut se méfier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "individu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde ordonna d'arrêter ce <w>drôle</w> qui tentait de s'enfuir avec le butin.",
                            "target_lang_translations": {
                                "en": "The guard ordered the arrest of that <w>rogue</w> who was trying to escape with the loot.",
                                "ru": "Охранник приказал задержать этого <w>плута</w>, который пытался скрыться с добычей.",
                                "nl": "De bewaker gaf het bevel om die <w>boef</w> aan te houden, die met de buit probeerde te vluchten.",
                                "de": "Der Wächter befahl, diesen <w>Gauner</w> festzunehmen, der mit der Beute zu fliehen versuchte.",
                                "pl": "Strażnik rozkazał aresztować tego <w>łotra</w>, który próbował uciec z łupem.",
                                "it": "La guardia ordinò di arrestare quel <w>furfante</w> che cercava di scappare con il bottino.",
                                "cs": "Strážný nařídil zatknout toho <w>lotra</w>, který se s kořistí pokoušel utéct.",
                                "tr": "Bekçi, ganimetle kaçmaya çalışan şu <w>düzenbazı</w> tutuklamayı emretti.",
                                "es": "El guardia ordenó arrestar a ese <w>bribón</w> que intentaba escapar con el botín.",
                                "zh": "卫兵下令逮捕那个想带着赃物逃跑的<w>恶棍</w>。"
                            }
                        },
                        {
                            "text": "Méfie-toi de cet homme, c'est un fieffé <w>drôle</w> sans foi ni loi.",
                            "target_lang_translations": {
                                "en": "Be wary of that man, he's a total <w>scoundrel</w> with no scruples whatsoever.",
                                "ru": "Остерегайся этого человека: он законченный <w>негодяй</w>, без чести и совести.",
                                "nl": "Wees op je hoede voor die man, hij is een complete <w>schurk</w> zonder geweten of principes.",
                                "de": "Hüte dich vor diesem Mann, er ist ein richtiger <w>Schurke</w>, der weder Gesetz noch Gewissen kennt.",
                                "pl": "Uważaj na tego człowieka, to kompletny <w>łajdak</w>, bez honoru i sumienia.",
