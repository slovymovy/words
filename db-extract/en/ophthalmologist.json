                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621c242a-a002-40e5-9e34-f59ec1b0c747",
                                                "sense_id": "f54753e4-5641-33a1-a3fa-174429177485",
                                                "text": "Après approbation par le tribunal, un ophtalmologiste expert peut demander à un autre ophtalmologiste son aide comme sapiteur sur une question précise."
                                            },
                                            {
                                                "example_id": "6ecc473a-9fd4-444e-93ef-805389da6770",
                                                "sense_id": "f54753e4-5641-33a1-a3fa-174429177485",
                                                "text": "Je pense notamment au LBD dont le Défenseur des droits a demandé l’interdiction et sur lequel même des ophtalmologistes ont alerté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b2ea73a-29ad-4aec-9df3-b3e8619f7774",
                        "source_entry_id": "063d8f97-ac71-3d7e-aff4-dc7b0472b7e0",
                        "source_sense_id": "057f94e8-71b3-3fb2-aaf1-757cd442e820",
                        "source_sense_description": "eye specialist",
                        "target_lang_word": "Augenarzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augenarzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5028f04e-a8ac-3a40-b88c-cf0af4b86cd5",
                                        "entry_id": "45491331-e27e-3fff-8ae9-88161626bad1",
                                        "glosses": [
                                            "Person, dessen Beruf es ist, Erkrankungen der Sehorgane des Menschen zu diagnostizieren und zu behandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bdaf226-dce8-4ebe-80ef-fb3082b7fbf8",
                                                "sense_id": "5028f04e-a8ac-3a40-b88c-cf0af4b86cd5",
                                                "text": "Mein Augenarzt diagnostizierte bei mir latentes Auswärtsschielen."
                                            },
                                            {
                                                "example_id": "48fb53f6-a339-4af6-a5c7-98b6b3aaf8e6",
                                                "sense_id": "5028f04e-a8ac-3a40-b88c-cf0af4b86cd5",
                                                "text": "„Er sprach zu jedermann von seinen Operationen und verurteilte den Augenarzt, der seit zwanzig Jahren in Warschau ansässig war, weil dieser nicht wisse, wie man einen Star steche; der andere verdammte ihn als Scharlatan, der vom Bau des Auges keine Ahnung habe.“"
                                            },
                                            {
                                                "example_id": "d00fb7b4-e8ea-4d1c-8314-ede5afec180f",
                                                "sense_id": "5028f04e-a8ac-3a40-b88c-cf0af4b86cd5",
                                                "text": "„Auf sein Verlangen hin darf ihn der beste Augenarzt von Paris behandeln: nicht zuletzt durch sein übermäßiges Arbeitspensum bei schlechtem Licht hat er sich eine recht lästige Hornhautentzündung zugezogen.“"
                                            },
                                            {
                                                "example_id": "fcb559e2-798f-4df6-ba69-d8063aafb851",
                                                "sense_id": "5028f04e-a8ac-3a40-b88c-cf0af4b86cd5",
                                                "text": "„Glücklicherweise war der Augenarzt Dr. Louis Borsch an dem Nachmittag in seiner Praxis und bereit, sie so kurzfristig zu empfangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc252ce-75b6-46c7-82d0-1e4aaf6cdf1b",
                        "source_entry_id": "063d8f97-ac71-3d7e-aff4-dc7b0472b7e0",
                        "source_sense_id": "057f94e8-71b3-3fb2-aaf1-757cd442e820",
                        "source_sense_description": "eye specialist",
                        "target_lang_word": "Augenärztin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augenärztin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33cd2ed6-c6bd-3b1c-b4a1-21d77c7eee0c",
                                        "entry_id": "a2777461-5121-34fd-84e4-912dfd08df73",
                                        "glosses": [
                                            "Ärztin, die sich mit der Augenheilkunde (Ophthalmologie) beschäftigt; Fachärztin für Augenheilkunde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6df09929-cf84-4511-9368-4a650cbc8f17",
                                                "sense_id": "33cd2ed6-c6bd-3b1c-b4a1-21d77c7eee0c",
                                                "text": "Meine Augenärztin diagnostizierte bei mir latentes Auswärtsschielen."
                                            },
                                            {
                                                "example_id": "00331e4c-cfca-45fd-bee8-eb45e26541cf",
                                                "sense_id": "33cd2ed6-c6bd-3b1c-b4a1-21d77c7eee0c",
                                                "text": "„Elena ist Augenärztin, müssen Sie wissen, und hat sich mit enormer Energie und innerer Kraft aus kleinsten Verhältnissen emporgearbeitet.“"
                                            },
                                            {
                                                "example_id": "423f104e-ed68-464a-b5f1-6b8cc00b7198",
                                                "sense_id": "33cd2ed6-c6bd-3b1c-b4a1-21d77c7eee0c",
                                                "text": "„Sie hat behauptet, ihre Brille sei zu schwach und hat der Augenärztin nicht geglaubt, die ihr erklärte, es läge nicht an der Brille, sondern an ihren Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
