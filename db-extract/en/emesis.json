    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8cb19b0b-43b5-356b-91e2-f30b28162637",
                "word": "emesis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "16c12cbc-2dc5-47b5-bd88-e158b41f7172",
                        "entry_id": "8cb19b0b-43b5-356b-91e2-f30b28162637",
                        "tags": [
                            "plural"
                        ],
                        "form": "emeses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7331f8e-d993-31af-a973-9aa8bfecacec",
                        "entry_id": "8cb19b0b-43b5-356b-91e2-f30b28162637",
                        "glosses": [
                            "The act or process of vomiting."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "82c99023-1be1-4a67-8596-34667d68a073",
                                "sense_id": "a7331f8e-d993-31af-a973-9aa8bfecacec",
                                "text": "Syrup of ipecac almost always forces an emesis."
                            },
                            {
                                "example_id": "54dfc078-ba3f-41ed-a273-9d96806d1b5f",
                                "sense_id": "a7331f8e-d993-31af-a973-9aa8bfecacec",
                                "text": "A female, aged 57 years, was left affected with abdominal dropsy after an attack of fever. On the 3d of March, 1836, she took 6 drops of croton oil, and in the substances rejected by emeses, four living caterpillars were perceived at first, and subsequently ten others."
                            },
                            {
                                "example_id": "4f3735b6-b7e5-469a-a3f9-655fcfd524e7",
                                "sense_id": "a7331f8e-d993-31af-a973-9aa8bfecacec",
                                "text": "Information included coexisting diseases, alcohol misuse, other substance misuse, medications taken at the same time as antituberculosis treatment (focusing on antiretroviral and azole antifungal agents), and the presence of gastrointentinal symptoms (nausea, emesis, diarrhoea, abdominal pain)."
                            },
                            {
                                "example_id": "f01a1e94-2c1b-4b58-b52a-fbbac1364351",
                                "sense_id": "a7331f8e-d993-31af-a973-9aa8bfecacec",
                                "text": "Several nurses stood outside the doors holding clipboards and dispensing yellow plastic emesis basins to a restless line of a least^([sic]) a dozen patients in long sleeves, heavy trousers, and work boots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62ef7373-8a0a-4410-9009-6a0c1872b0f4",
                        "source_entry_id": "8cb19b0b-43b5-356b-91e2-f30b28162637",
                        "source_sense_id": "a7331f8e-d993-31af-a973-9aa8bfecacec",
                        "source_sense_description": "act of vomiting",
                        "target_lang_word": "рво́та",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рво́та",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fc24af3b-2017-39eb-a4c8-dea634e587bb",
                                        "entry_id": "58cbbf1a-47fc-3464-93eb-7b4b20ef5fff",
                                        "glosses": [
                                            "непроизвольное извержение содержимого желудка (иногда вместе с содержимым кишечника) наружу через рот (реже и через нос)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30e0f6cd-883a-40e7-855e-003e8d9245af",
                                                "sense_id": "fc24af3b-2017-39eb-a4c8-dea634e587bb",
                                                "text": "Он уверял, что заболел головною болью и рвотой на квартире у Гаганова, к которому забежал случайно ранним утром."
                                            },
                                            {
                                                "example_id": "b0b9581c-01a9-4f4f-b555-8734d3f72662",
                                                "sense_id": "fc24af3b-2017-39eb-a4c8-dea634e587bb",
                                                "text": "У неё сделалась головная боль, рвота, и она всё утро не могла встать с постели."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8e4a599-c614-37cd-87ab-8f3066915f56",
                                        "entry_id": "58cbbf1a-47fc-3464-93eb-7b4b20ef5fff",
                                        "glosses": [
                                            "разг. масса, извергнутая таким образом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852a7cc4-8c68-4f8e-bb03-c21e87181082",
                                                "sense_id": "f8e4a599-c614-37cd-87ab-8f3066915f56",
                                                "text": "Она убрала таз со рвотой, вытерла его лицо влажным горячим полотенцем."
                                            },
                                            {
                                                "example_id": "1107b72e-376e-4a19-a53b-22baf0a9f253",
                                                "sense_id": "f8e4a599-c614-37cd-87ab-8f3066915f56",
                                                "text": "Щека, шея и подушка были запачканы рвотой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e3ef386-bb20-48c2-afca-4cb3f57d92a8",
                        "source_entry_id": "8cb19b0b-43b5-356b-91e2-f30b28162637",
                        "source_sense_id": "a7331f8e-d993-31af-a973-9aa8bfecacec",
                        "source_sense_description": "act of vomiting",
                        "target_lang_word": "блева́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "блева́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1b62ed2-d5af-347b-a317-3ab8e6569e70",
                                        "entry_id": "2178f31a-e296-3edb-83f7-257b9b04dda4",
                                        "glosses": [
                                            "разг., сниж. действие по значению гл. блевать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f87078c-73d3-4cee-8878-08223d90fd01",
                                                "sense_id": "c1b62ed2-d5af-347b-a317-3ab8e6569e70",
                                                "text": "У человека под пазухами или на шее садится болячка червена, и в теле колотьё почюет, и внутри негасимое горячество или во удесех некая студёность и тяжкое воздыхание и не может воздыхати — дух в себя тянет и паки воспускает; сон найдёт, что не может перестать спать; явится горесть, кислость и блевание; в лице человек сменится, станет образом глиностен и борзо помирает."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b2f03cb-ebfc-48e9-bd1a-fb236eb95256",
                        "source_entry_id": "8cb19b0b-43b5-356b-91e2-f30b28162637",
                        "source_sense_id": "a7331f8e-d993-31af-a973-9aa8bfecacec",
                        "source_sense_description": "act of vomiting",
                        "target_lang_word": "блево́та",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "блево́та",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa6597f7-c4ca-3ebb-8a71-2fb570ecc9c0",
                                        "entry_id": "4868f0f7-1635-3b49-a597-8e6f6cae0609",
                                        "glosses": [
                                            "действие по значению гл. блевать; рвота"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e22d08-532e-452e-8985-ad0dd9fdaac9",
                                                "sense_id": "aa6597f7-c4ca-3ebb-8a71-2fb570ecc9c0",
                                                "text": "Но во всех, кто остался мне верен, тупая Его величавость вызывала мигрень и блевоту."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d9584eb-0467-31d1-8ad3-a150276dc0a5",
                                        "entry_id": "4868f0f7-1635-3b49-a597-8e6f6cae0609",
                                        "glosses": [
                                            "разг. масса, изверженная желудком при рвоте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe65d58-c108-4388-97ef-789bdbc5e9e6",
                                                "sense_id": "8d9584eb-0467-31d1-8ad3-a150276dc0a5",
                                                "text": "Медленно поднимает седую голову из тарелки; физиономия — сморщенная, в усах — лапша, под столом — лужа блевоты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77b0d253-cb67-4c43-ae5a-ed881a55ffbc",
                        "source_entry_id": "8cb19b0b-43b5-356b-91e2-f30b28162637",
