                "senses": [
                    {
                        "sense_id": "2bac85f9-42ea-3b76-8817-8bc2bc7755ad",
                        "entry_id": "b74f8c53-5d5b-3bbc-b811-f55fd228d9fb",
                        "glosses": [
                            "Geldzahlung, die als Strafe auferlegt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d96dfbe-ff33-439b-a0cf-f330160479d8",
                                "sense_id": "2bac85f9-42ea-3b76-8817-8bc2bc7755ad",
                                "text": "„In Indien wurde kürzlich ein großer Lebensmittelkonzern zu einer Strafzahlung verurteilt, nachdem ein Labor 2015 und 2016 gleich mehrere bedenkliche Substanzen wie Blei, Asche und den Geschmacksverstärker Mononatriumglutamat in einem Instantnudelgericht nachgewiesen hatte.“"
                            },
                            {
                                "example_id": "9a140c7a-6e61-46ad-9ea5-59badce6d45c",
                                "sense_id": "2bac85f9-42ea-3b76-8817-8bc2bc7755ad",
                                "text": "„Das Oberverwaltungsgericht Berlin-Brandenburg bestätigte ein Urteil des Verwaltungsgerichts Berlin aus dem Jahr 2021, wonach die AfD eine hohe Strafzahlung wegen der Annahme der Spende leisten muss.“"
                            },
                            {
                                "example_id": "d1c4ed18-ad39-4a00-a613-ff0a06e7d175",
                                "sense_id": "2bac85f9-42ea-3b76-8817-8bc2bc7755ad",
                                "text": "„Der dritte Punkt betrifft die Strafzahlungen bei Verstößen, hälftig an den Rat und an die Zunft zu zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
