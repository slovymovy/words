                "senses": [
                    {
                        "sense_id": "158647f3-b7cc-3795-9c3d-3b29fd7464f1",
                        "entry_id": "eeaa18e0-637b-3dfb-b304-a8775ca86880",
                        "glosses": [
                            "deel van een apparaat dat zorgt dat de kracht van een motor wordt omgezet in een voortbeweging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d7aa17-eed3-47ae-ba88-31dc6c4a82ef",
                                "sense_id": "158647f3-b7cc-3795-9c3d-3b29fd7464f1",
                                "text": "Een vijftig kilo zware stoomlocomotief die het echt doet. Een stoomtrekker met een aandrijfmechanisme dat daadwerkelijk heen en weer gaat."
                            },
                            {
                                "example_id": "3f1e9cb8-33c1-45df-b661-6b62aff87093",
                                "sense_id": "158647f3-b7cc-3795-9c3d-3b29fd7464f1",
                                "text": "Volgens nieuwe theoretische modellen kan een warpdrive echter met aanzienlijk minder energie worden aangedreven en zou het zelfs haalbaar zijn een dergelijk aandrijfmechanisme te bouwen."
                            },
                            {
                                "example_id": "a8148ad9-110c-4239-a9da-9a6c5c8234eb",
                                "sense_id": "158647f3-b7cc-3795-9c3d-3b29fd7464f1",
                                "text": "Ongeveer 80 toeristen hebben zondag enige uren vastgezeten in de cabines van een kabelbaan in de Franse Pyreneeën, bij de plaats Bagnères-de-Luchon. Door een storing in het aandrijfmechanisme stopte de kabelbaan ermee."
                            }
                        ]
                    }
