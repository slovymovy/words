                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "ce3124d1-c3c8-4ded-bf24-55a5264fcca6",
                                "sense_id": "98d5ad02-9872-3fd8-abbc-808169b79b0f",
                                "text": "Ten stół jest upierdolony. Wytrzyj go."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "438dccfb-2ffc-3419-9ce4-83b697bfc43a",
                        "entry_id": "6d8e3ce9-f3da-348f-9f67-d461aca65f71",
                        "glosses": [
