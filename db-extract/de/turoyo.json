                "senses": [
                    {
                        "sense_id": "cb860dac-bca8-37c4-99c0-a0a1dedc6973",
                        "entry_id": "037ed32a-c3ad-3bae-b21d-63e8349e9b4e",
                        "glosses": [
                            "aramäische Sprache, die im Gebiet des Tur Abdin im Südosten der heutigen Türkei und im Nordosten von Syrien von syrisch-orthodoxen Christen gesprochen wurde und wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624927c7-9a8b-4208-9410-4362a0847161",
                                "sense_id": "cb860dac-bca8-37c4-99c0-a0a1dedc6973",
                                "text": "„Turoyo wurde primär mündlich überliefert.“"
                            },
                            {
                                "example_id": "db5891c0-8b66-4684-91da-8eefdabfd415",
                                "sense_id": "cb860dac-bca8-37c4-99c0-a0a1dedc6973",
                                "text": "„Der Zielsetzung von Semítica Viva — Series Didactica entsprechend soll dieses Lehrbuch Semitisten und Aramaisten zur Beschäftigung mit dem Turoyo anregen und zu einer stärkeren Berücksichtigung lebender semitischer Sprachen im akademischen Unterricht beitragen.“"
                            },
                            {
                                "example_id": "aa6c8549-5bed-4786-bf48-62eb2f9d25f2",
                                "sense_id": "cb860dac-bca8-37c4-99c0-a0a1dedc6973",
                                "text": "„Zusätzlich zu der Tatsache, daß die neuaramäische Sprache des Tur Abdin, das Turoyo, bis heute, von wenigen Ausnahmen abgesehen, eine illiterate Sprache geblieben ist, war sie bis vor kurzem auch eine Sprache ohne eigene Dicht- und Gesangskunst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
