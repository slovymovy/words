                        "glosses": [
                            "Agiter l'eau avec la main pour faire des remous et des glouglous."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "79d89cda-1a58-4537-8e99-a083dc0b5c9c",
                                "sense_id": "9e6eecdf-e9db-313d-97be-ff81b12b6151",
                                "text": "Et sans prendre le temps de plonger sa main dans le grand bénitier de pierre où les camarades gavouillaient en passant, il traversa la nef en filant tel un zèbre pour aller endosser son surplis de thuriféraire ou d'acolyte."
                            }
                        ]
                    }
