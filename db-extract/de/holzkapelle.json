                "senses": [
                    {
                        "sense_id": "589b5664-f5ed-3e67-b58e-cd9887d7f947",
                        "entry_id": "8392dc69-16f4-3d75-a7bb-0b226cb2bf19",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ed7511b-e2ea-4bc9-b6a0-31d5c822eb0e",
                                "sense_id": "589b5664-f5ed-3e67-b58e-cd9887d7f947",
                                "text": "„In Rohrmoos, bei Tiefenbach, steht die älteste Holzkapelle Süddeutschlands aus dem 16. Jahrhundert.“"
                            },
                            {
                                "example_id": "4a0e7c26-01f3-45b9-9a58-67935c8df7d5",
                                "sense_id": "589b5664-f5ed-3e67-b58e-cd9887d7f947",
                                "text": "„Die Holzkapelle in Rappoltsberg ist geschätzte 300 Jahre alt, in Holzblockbauweise errichtet und mit Holzschindeln verkleidet.“"
                            },
                            {
                                "example_id": "660a7f7c-1dae-4cf8-9621-78575a886968",
                                "sense_id": "589b5664-f5ed-3e67-b58e-cd9887d7f947",
                                "text": "„Die kleine Holzkapelle in Riesen in der Gemeinde Steingaden ist die Hofkapelle des ehemaligen Klosterjägerhofs.“"
                            },
                            {
                                "example_id": "e6aa579e-e63e-481b-984e-de2655865ae0",
                                "sense_id": "589b5664-f5ed-3e67-b58e-cd9887d7f947",
                                "text": "„An seinem nördlichen Rand, in der Nähe von einem Forsthaus Kiełbasów befindet sich eine schlichte, aber äußerst wunderbare Holzkapelle, die mit dem Dach mit den Schindeln zugedeckt und mit einem schmalen Kirchenglöcklein verziert ist.“"
                            },
                            {
                                "example_id": "eaaf77ed-1a66-40a4-aa43-7281170d781e",
                                "sense_id": "589b5664-f5ed-3e67-b58e-cd9887d7f947",
                                "text": "„Seit 1631 wird das Altarbild in der Holzkapelle als Gnadenbild verehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
