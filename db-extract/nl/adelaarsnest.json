                "senses": [
                    {
                        "sense_id": "cfe43304-f665-3596-9f0a-8787d9c48ce4",
                        "entry_id": "49e4f0b6-7830-33cc-aab7-c13891f3e0b7",
                        "glosses": [
                            "verblijf- en broedplaats van arenden, doorgaans op een heel hoge plek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "640b0141-06b5-4718-aae9-6c89fcb7f328",
                                "sense_id": "cfe43304-f665-3596-9f0a-8787d9c48ce4",
                                "text": "Een mus werd tot adelaar benoemd. (…) Onze mus zit op de adelaarsrots, in het adelaarsnest, en voelt zich erg weinig op zijn gemak. Het tocht ontzettend!...."
                            }
                        ]
                    },
                    {
                        "sense_id": "21949c99-c9a4-316b-87eb-0ec70f358b28",
                        "entry_id": "49e4f0b6-7830-33cc-aab7-c13891f3e0b7",
                        "glosses": [
                            "hoog gelegen plaats"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0dbceaf2-7291-4089-8b51-302329d69a64",
                                "sense_id": "21949c99-c9a4-316b-87eb-0ec70f358b28",
                                "text": "Ik had voor twee maanden een geïsoleerd huis op een heuvel gehuurd. () Een butagasfles naar zo'n adelaarsnest krijgen kostte een halve dag, een schrijfmachinelint een hele, de geiserreparateur had nog meer moeite mij te vinden dan ik hem en verplichtte mij na de eerste poging tot op hem wachten in een café."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d4363ec-82a5-38da-89e6-b8168f12ac4d",
                        "entry_id": "49e4f0b6-7830-33cc-aab7-c13891f3e0b7",
                        "glosses": [
                            "verheven positie"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bc567fe5-9a9b-4843-bd70-3ef41efb5c44",
                                "sense_id": "7d4363ec-82a5-38da-89e6-b8168f12ac4d",
                                "text": "Hij verlaat het superieure uitzicht van het adelaarsnest, om aan te schuiven in een koffiehuis, waar hij als een man van middelbare leeftijd in de tijdschriften bladert, en anderen de naakte waarheid toont, de besmeurde centerfold van hervormd Nederland."
                            }
                        ]
                    }
