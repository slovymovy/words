{
    "word_family": [
        "cropper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f20852db-fb51-30c6-8676-146a8cbc54db",
                    "sense_definition": "A plant grown in large quantities for food, fuel, or other economic purposes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "agriculture_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers are worried that the dry weather will ruin the <w>crop</w>.",
                            "target_lang_translations": {
                                "ru": "Фермеры обеспокоены тем, что сухая погода погубит <w>посевы</w>.",
                                "zh": "农民们担心干旱天气会毁了<w>庄稼</w>。"
                            }
                        },
                        {
                            "text": "Corn is the most important <w>crop</w> grown in this valley.",
                            "target_lang_translations": {
                                "ru": "Кукуруза — самая важная <w>сельскохозяйственная культура</w>, выращиваемая в этой долине.",
                                "zh": "玉米是这个山谷里种植的最重要的<w>农作物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cash crop",
                        "staple crop",
                        "main crop",
                        "rotation of crops"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, выращиваемое в больших количествах для еды, топлива или других экономических целей.",
                        "zh": "为食用、燃料或其他经济目的而大量种植的植物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельскохозяйственная культура",
                                "target_lang_sense_clarification": "вид растения"
                            },
                            {
                                "target_lang_word": "посев",
                                "target_lang_sense_clarification": "растения на полях"
                            },
                            {
                                "target_lang_word": "культура",
                                "target_lang_sense_clarification": "краткая форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "农作物",
                                "target_lang_sense_clarification": "种植的植物"
                            },
                            {
                                "target_lang_word": "庄稼",
                                "target_lang_sense_clarification": "田里的作物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4952072b-e93a-3477-9702-a8908892d210",
                    "sense_definition": "The total amount of agricultural produce harvested at one time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "agriculture_yield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a record <w>crop</w> of strawberries this summer.",
                            "target_lang_translations": {
                                "ru": "Этим летом у нас был рекордный <w>урожай</w> клубники.",
                                "zh": "今年夏天我们的草莓获得了创纪录的<w>产量</w>。"
                            }
                        },
                        {
                            "text": "The potato <w>crop</w> was damaged by the late frost.",
                            "target_lang_translations": {
                                "ru": "<w>Урожай</w> картофеля пострадал от поздних заморозков.",
                                "zh": "土豆<w>收成</w>受到了晚霜的损害。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harvest",
                        "yield",
                        "produce"
                    ],
                    "common_phrases": [
                        "bumper crop",
                        "heavy crop",
                        "crop failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее количество сельскохозяйственной продукции, собранной за один раз.",
                        "zh": "一次收获的农产品总量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урожай",
                                "target_lang_sense_clarification": "собранная продукция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产量",
                                "target_lang_sense_clarification": "收获的数量"
                            },
                            {
                                "target_lang_word": "收成",
                                "target_lang_sense_clarification": "收获的成果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0cedede-4158-34f2-a083-dd47a2bb895b",
                    "sense_definition": "An image or photograph that has been reduced by removing the outer parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "editing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer asked for a tighter <w>crop</w> of the profile picture.",
                            "target_lang_translations": {
                                "ru": "Дизайнер попросил сделать более плотное <w>кадрирование</w> фотографии профиля.",
                                "zh": "设计师要求对头像进行更紧凑的<w>裁剪</w>。"
                            }
                        },
                        {
                            "text": "This image is actually a <w>crop</w> from a much larger scene.",
                            "target_lang_translations": {
                                "ru": "Это изображение на самом деле — <w>фрагмент</w> гораздо большей сцены.",
                                "zh": "这张图实际上是从一个更大的场景中<w>截取</w>出来的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tight crop",
                        "square crop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение или фотография, уменьшенная путем удаления внешних частей.",
                        "zh": "通过去除边缘部分而缩小的图像或照片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кадрирование",
                                "target_lang_sense_clarification": "процесс или результат обрезки"
                            },
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "часть изображения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裁剪图",
                                "target_lang_sense_clarification": "裁剪后的图像"
                            },
                            {
                                "target_lang_word": "局部",
                                "target_lang_sense_clarification": "图像的一部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                    "sense_definition": "A group or collection of people or things appearing at the same time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The current <w>crop</w> of university graduates faces a tough job market.",
                            "target_lang_translations": {
                                "ru": "Нынешнее <w>поколение</w> выпускников университетов сталкивается с трудностями на рынке труда.",
                                "zh": "当前这<w>一批</w>大学毕业生面临着严峻的就业市场。"
                            }
                        },
                        {
                            "text": "A whole new <w>crop</w> of action movies will be released this winter.",
                            "target_lang_translations": {
                                "ru": "Целая новая <w>партия</w> боевиков выйдет этой зимой.",
                                "zh": "今年冬天将有整整<w>一批</w>新的动作电影上映。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "new crop",
                        "current crop",
                        "fresh crop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа или коллекция людей или вещей, появившихся в одно и то же время.",
                        "zh": "同一时期出现的一群人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поколение",
                                "target_lang_sense_clarification": "о людях"
                            },
                            {
                                "target_lang_word": "партия",
                                "target_lang_sense_clarification": "о вещах или продуктах"
                            },
                            {
                                "target_lang_word": "плеяда",
                                "target_lang_sense_clarification": "книжное, о выдающихся людях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一批",
                                "target_lang_sense_clarification": "指代人或事物"
                            },
                            {
                                "target_lang_word": "一代",
                                "target_lang_sense_clarification": "指代人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ca2fc1c-5fee-3c60-a10a-94a1176eb4d0",
                    "sense_definition": "A short whip with a loop, typically used in horse riding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jockey tapped the horse gently with his <w>crop</w>.",
                            "target_lang_translations": {
                                "ru": "Жокей легонько ударил лошадь своим <w>хлыстом</w>.",
                                "zh": "骑师用<w>马鞭</w>轻轻拍了拍马。"
                            }
                        },
                        {
                            "text": "She held the riding <w>crop</w> firmly in her right hand.",
                            "target_lang_translations": {
                                "ru": "Она крепко держала <w>хлыст</w> для верховой езды в правой руке.",
                                "zh": "她右手紧紧握着<w>马鞭</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whip",
                        "riding crop",
                        "hunting crop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий кнут с петлей, обычно используемый при верховой езде.",
                        "zh": "一种带环的短鞭，通常用于骑马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлыст",
                                "target_lang_sense_clarification": "для верховой езды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马鞭",
                                "target_lang_sense_clarification": "骑马用的鞭子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                    "sense_definition": "A very short hairstyle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to cut her long hair into a stylish <w>crop</w>.",
                            "target_lang_translations": {
                                "ru": "Она решила состричь свои длинные волосы и сделать стильную <w>короткую стрижку</w>.",
                                "zh": "她决定把长发剪成时髦的<w>短发</w>。"
                            }
                        },
                        {
                            "text": "The soldier wore his hair in a military <w>crop</w>.",
                            "target_lang_translations": {
                                "ru": "Солдат носил армейскую <w>короткую стрижку</w>.",
                                "zh": "那个士兵留着军人式的<w>寸头</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "short crop",
                        "close crop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень короткая прическа.",
                        "zh": "非常短的发型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короткая стрижка",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "стрижка под машинку",
                                "target_lang_sense_clarification": "очень коротко"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短发",
                                "target_lang_sense_clarification": "通称"
                            },
                            {
                                "target_lang_word": "寸头",
                                "target_lang_sense_clarification": "极短的发型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                    "sense_definition": "A pouch in the throat of a bird where food is stored before digestion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother bird regurgitated food from her <w>crop</w> to feed the chicks.",
                            "target_lang_translations": {
                                "ru": "Птица-мать отрыгнула пищу из своего <w>зоба</w>, чтобы покормить птенцов.",
                                "zh": "母鸟从<w>嗉囊</w>里吐出食物来喂养雏鸟。"
                            }
                        },
                        {
                            "text": "You can feel seeds in the pigeon's <w>crop</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете нащупать семена в <w>зобе</w> голубя.",
                                "zh": "你可以摸到鸽子<w>嗉囊</w>里的种子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "craw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мешок в горле птицы, где пища хранится перед перевариванием.",
                        "zh": "鸟类喉部用于在消化前储存食物的囊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зоб",
                                "target_lang_sense_clarification": "анатомия птиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗉囊",
                                "target_lang_sense_clarification": "鸟类解剖结构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "daebfadd-04ac-3b1c-bd8f-a3ad9e9766c1",
                    "sense_definition": "To remove the outer parts of a photograph or image to improve framing or focus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "editing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>crop</w> this picture to fit it into the frame.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>кадрировать</w> эту фотографию, чтобы она поместилась в рамку.",
                                "zh": "我需要<w>裁剪</w>这张照片以使其适合相框。"
                            }
                        },
                        {
                            "text": "She decided to <w>crop</w> her ex-boyfriend out of the photo.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>вырезать</w> своего бывшего парня с фотографии.",
                                "zh": "她决定把前男友从照片里<w>截取</w>掉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crop out",
                        "crop closely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять внешние части фотографии или изображения для улучшения композиции или фокуса.",
                        "zh": "去除照片或图像的边缘部分以改善构图或焦点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кадрировать",
                                "target_lang_sense_clarification": "термин фоторедактирования"
                            },
                            {
                                "target_lang_word": "обрезать",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裁剪",
                                "target_lang_sense_clarification": "图像处理动作"
                            },
                            {
                                "target_lang_word": "截取",
                                "target_lang_sense_clarification": "截取部分图像"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55ddab2e-6dee-3f24-a35f-f08a44c9f421",
                    "sense_definition": "To bite off or cut the tops of plants; to cut hair very short.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture_cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sheep were left to <w>crop</w> the grass in the meadow.",
                            "target_lang_translations": {
                                "ru": "Овец оставили <w>щипать</w> траву на лугу.",
                                "zh": "羊群被留在草地上<w>啃食</w>青草。"
                            }
                        },
                        {
                            "text": "The barber will <w>crop</w> your hair if you ask for a military style.",
                            "target_lang_translations": {
                                "ru": "Парикмахер <w>коротко подстрижет</w> вам волосы, если вы попросите армейский стиль.",
                                "zh": "如果你要求军人风格，理发师会把你头发<w>剪短</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crop the grass",
                        "crop short"
                    ],
                    "target_lang_definitions": {
                        "ru": "Откусывать или срезать верхушки растений; очень коротко стричь волосы.",
                        "zh": "啃食或剪掉植物的顶部；将头发剪得很短。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щипать",
                                "target_lang_sense_clarification": "о животных, поедающих траву"
                            },
                            {
                                "target_lang_word": "подстригать",
                                "target_lang_sense_clarification": "о волосах или растениях"
                            },
                            {
                                "target_lang_word": "коротко стричь",
                                "target_lang_sense_clarification": "о волосах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "啃食",
                                "target_lang_sense_clarification": "动物吃草"
                            },
                            {
                                "target_lang_word": "修剪",
                                "target_lang_sense_clarification": "剪短头发或植物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}