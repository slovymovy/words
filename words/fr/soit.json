                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise emploie cinquante personnes, <w>soit</w> le double de l'an dernier."
                        },
                        {
                            "text": "Il a couru dix kilomètres en cinquante minutes, <w>soit</w> une très bonne moyenne."
