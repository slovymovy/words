                    },
                    {
                        "translation_id": "61cae60a-dd52-4822-bcd9-84431d779f14",
                        "source_entry_id": "49e35c88-5598-303e-ae5d-f0fca4e17467",
                        "source_sense_id": "f182542c-abbd-3f7b-a37f-7c7b7127edfd",
                        "source_sense_description": "relating to anabolism",
                        "target_lang_word": "anabolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anabolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca247422-e525-345e-986c-30e5df929880",
                                        "entry_id": "0059dc6e-ae95-30cc-a416-005bb2c79ee3",
                                        "glosses": [
                                            "Relatif à l’anabolisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d08cea-4f22-4745-9496-8acf3e28740d",
                                                "sense_id": "ca247422-e525-345e-986c-30e5df929880",
                                                "text": "Le cycle de l’acide citrique est donc amphibolique, dans la mesure où il intervient à la fois dans des voies cataboliques et dans des voies anaboliques."
                                            },
                                            {
                                                "example_id": "da00009b-fb5b-4f78-a7b1-b315bbc9d898",
                                                "sense_id": "ca247422-e525-345e-986c-30e5df929880",
                                                "text": "Les cellules masculines sont essentiellement cataboliques - actives et énergiques - tandis que les cellules féminines sont anaboliques - destinées à conserver l’énergie et soutenir la vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5009af15-650c-4240-94fe-fa301a525546",
                        "source_entry_id": "49e35c88-5598-303e-ae5d-f0fca4e17467",
                        "source_sense_id": "f182542c-abbd-3f7b-a37f-7c7b7127edfd",
                        "source_sense_description": "relating to anabolism",
                        "target_lang_word": "anabol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anabol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0253b78d-7510-3d11-b94c-8961e65defec",
                                        "entry_id": "4fcc8ad2-0e30-3fd7-b628-e281e8750c0a",
                                        "glosses": [
                                            "anregend auf den Eiweißstoffwechsel wirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ddf20e0-ed6c-4041-ac14-bd015241210b",
                                                "sense_id": "0253b78d-7510-3d11-b94c-8961e65defec",
                                                "text": "Bei Minderwuchs werden unter anderem anabole Substanzen verschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c97139e-fd84-4eaa-bd44-7b40c746e914",
                        "source_entry_id": "49e35c88-5598-303e-ae5d-f0fca4e17467",
                        "source_sense_id": "f182542c-abbd-3f7b-a37f-7c7b7127edfd",
                        "source_sense_description": "relating to anabolism",
                        "target_lang_word": "anabolisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anabolisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a21ead22-d94c-3b17-865d-aa9c4c2ac6a8",
                                        "entry_id": "257b917a-4fbe-38b7-ae23-b48bebf85af5",
                                        "glosses": [
                                            "den Anabolismus oder aufbauenden Stoffwechsel betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5585f2-fd4c-4fd7-8130-671d5c270ef5",
                                                "sense_id": "a21ead22-d94c-3b17-865d-aa9c4c2ac6a8",
                                                "text": "„Demnach stellt sich der Stoffwechsel, der in der Jugend anabolisch, also aufbauend, arbeitet, im Alter auf eine katabolische Funktion um.“"
                                            },
                                            {
                                                "example_id": "9d153856-aa63-468a-a854-80f8047ce44c",
                                                "sense_id": "a21ead22-d94c-3b17-865d-aa9c4c2ac6a8",
                                                "text": "„Er wurde in Moskau und Tashkent ohne Erfolg mit Blutinfusionen, Korticosteroiden, anabolischen Steroiden und Vitaminpräparaten behandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
