                "senses": [
                    {
                        "sense_id": "9523e9b6-b161-30a7-8321-c0354611a77a",
                        "entry_id": "7240d3f9-7088-3e69-abc9-a2d3d58acfd0",
                        "glosses": [
                            "Person, die bei Olympischen Spielen einen zweiten Platz erreicht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7296fed4-2f5c-49d4-aff5-f2492eae2b79",
                                "sense_id": "9523e9b6-b161-30a7-8321-c0354611a77a",
                                "text": "Der Olympiazweite wurde nachträglich wegen eines Dopingvergehens disqualifiziert."
                            },
                            {
                                "example_id": "facc9c31-0f4b-4800-88d4-8d45dbff3ad9",
                                "sense_id": "9523e9b6-b161-30a7-8321-c0354611a77a",
                                "text": "„Da hab ich auch gegen euren Ludwig Paischer gekämpft, ich erinnere mich gut an ihn, er war 2005 WM-Zweiter und 2008 Olympiazweiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
