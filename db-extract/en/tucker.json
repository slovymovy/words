                        ],
                        "form": "tuckers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "391e82d9-9b44-3e95-be59-d26d0340ceaf",
                        "entry_id": "dbe25e38-e2ce-3be6-b81e-3aa318adaed3",
                        "glosses": [
                            "One who or that which tucks."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "69d8729c-dfd0-4409-a37c-3e2cc632e0a8",
                                "sense_id": "391e82d9-9b44-3e95-be59-d26d0340ceaf",
                                "text": "Discrimination. Firm, after having had a long controversy with its tuckers, laid off the whole tucking department for a week. Union maintained it was a clear case cf discrimination against the tuckers on account of the recent controversy.\nDetermination:\nComplaint of the union was sustained. Tuckers were paid the amount of money they were deprived of through being discriminated against, $158.90."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9c69191-cc2f-3518-a4f6-a975013c97db",
                        "entry_id": "dbe25e38-e2ce-3be6-b81e-3aa318adaed3",
                        "glosses": [
                            "Food; tuck."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "colloquial",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "65be4867-ab8d-3e13-9956-0eb1b64ad2b3",
                        "entry_id": "dbe25e38-e2ce-3be6-b81e-3aa318adaed3",
                        "glosses": [
                            "Work that scarcely yields a living wage."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "slang",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
