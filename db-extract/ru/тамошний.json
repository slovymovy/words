                        ],
                        "examples": [
                            {
                                "example_id": "9ea81ebf-e36b-48d3-91f4-2376e11ddbd0",
                                "sense_id": "f4620b39-0be6-339e-abce-68d209367a18",
                                "text": "та́мошние жи́тели",
                                "translation": "the inhabitants there; the inhabitants of that place; locals",
                                "english": "the inhabitants there; the inhabitants of that place; locals"
                            },
                            {
                                "example_id": "587a13b0-10fb-4a31-a8a5-6f3d83cd833f",
                                "sense_id": "f4620b39-0be6-339e-abce-68d209367a18",
                                "text": "— Ах! — взви́згнул за́яц от бо́ли, но в одну́ мину́ту сдержа́л себя́ и молоде́цки попра́вился, — э́то я, ва́ше высо́кое степе́нство, о та́мошних ли́сах говорю́, а зде́шние лиси́цы, ска́зывают, до́брые.",
                                "translation": "Mikhail Saltykov-Shchedrin",
                                "english": "Mikhail Saltykov-Shchedrin"
                            }
                        ]
