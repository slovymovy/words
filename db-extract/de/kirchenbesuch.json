                "senses": [
                    {
                        "sense_id": "e5c5dbab-e9d4-371b-ab82-b6489ba6492f",
                        "entry_id": "b2086f5e-a46d-3b01-aaf9-c136bdfb7e36",
                        "glosses": [
                            "Besichtigung einer Kirche oder Aufenthalt in einer Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ed2831-30a9-4711-9e07-e38363582b77",
                                "sense_id": "e5c5dbab-e9d4-371b-ab82-b6489ba6492f",
                                "text": "„Nach dem Kirchenbesuch zeigte ich Papa, wo sich bestimmte Geschäfte und Läden und der kleine Markt befunden hatten, auf dem die Mama eingekauft hatte.“"
                            },
                            {
                                "example_id": "407b845e-05b4-405b-a81c-eeeed52b6c50",
                                "sense_id": "e5c5dbab-e9d4-371b-ab82-b6489ba6492f",
                                "text": "„Kirchenbesuche sind ja meist nichts für Kinder.“"
                            },
                            {
                                "example_id": "521fe9d4-34e2-4bdd-9034-ced23b52180f",
                                "sense_id": "e5c5dbab-e9d4-371b-ab82-b6489ba6492f",
                                "text": "Überschrift: „Kirchenbesuche sind für Muslime kein Fauxpas“"
                            },
                            {
                                "example_id": "09e21cb4-d2d9-41c7-8ce1-2593564a47fc",
                                "sense_id": "e5c5dbab-e9d4-371b-ab82-b6489ba6492f",
                                "text": "„Dazu noch unzählige entsetzlich nervende Kirchenbesuche – auch im Urlaub. Jede Kirche und Kapelle, an der wir vorbeikamen, musste geentert und besichtigt sowie abfotografiert werden.“"
                            },
                            {
                                "example_id": "5c30a644-f3cf-429a-a231-c7a238aaac93",
                                "sense_id": "e5c5dbab-e9d4-371b-ab82-b6489ba6492f",
                                "text": "Überschrift: „Italien lässt Touristen für Kirchenbesuche zahlen“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d30f4c1-349f-3711-8b11-2edaabf521a3",
                        "entry_id": "b2086f5e-a46d-3b01-aaf9-c136bdfb7e36",
                        "glosses": [
                            "Teilnahme an einem Gottesdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b10468-9ff7-4174-b692-9d1a05778468",
                                "sense_id": "9d30f4c1-349f-3711-8b11-2edaabf521a3",
                                "text": "„Direkt vor dem hier wiedergegebenen Ausschnitt haben sich Elena, Angela und Christina über weihnachtliche Kirchenbesuche unterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
