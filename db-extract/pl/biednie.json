                "translations": [
                    {
                        "translation_id": "315d1903-7479-461a-a7ae-0ed20090caa2",
                        "source_entry_id": "10b96710-98d9-3109-8400-660785d0d79b",
                        "source_sense_id": "65aebf2f-7f30-3f2a-9486-d7c64427b164",
                        "source_sense_description": "von Armut zeugend: arm, ärmlich",
                        "target_lang_word": "arm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                        "entry_id": "0b70e212-78c5-3ded-9ded-594bf8bda0a9",
                                        "glosses": [
                                            "mittellos, kein Geld besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75dca6a5-59f4-4380-b8db-86c0fc408276",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "Bei großen sozialen Einschnitten werden viele Leute arm."
                                            },
                                            {
                                                "example_id": "e843af5c-ce26-4f80-8464-d76b91ea7d14",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "„Reiche und Superreiche tragen zur Erderwärmung zigmal stärker bei als ärmere Menschen.“"
                                            },
                                            {
                                                "example_id": "75023686-5273-4b20-a819-b709f88208e7",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "[Über den Astronomen Johannes Kepler:] „Als Kepler um sie warb, lehnte ihr Vater, ein wohlhabender Müller, eine Heirat mit dem aus seiner Sicht armen Kepler zunächst ab und brachte damit die Verbindung beinahe zum Scheitern.“"
                                            },
                                            {
                                                "example_id": "beee9704-2b34-4009-8dc3-ff2de15ac870",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "„Jeder kennt das Stereotyp vom reichen Juden, von einem, der gerne Geschäfte macht. […] Mit der Realität hat es nichts zu tun, besonders in Deutschland nicht. Hier sind die meisten Jüdinnen und Juden arm.“"
                                            },
                                            {
                                                "example_id": "c2fe3e3b-fabf-4faf-84b9-3eb52f37a50f",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "[2024:] „Wer in Deutschland arm ist, hat weniger als 917 Euro im Monat. So hoch ist derzeit die so genannte Armutsgefährdungsschwelle.“"
                                            },
                                            {
                                                "example_id": "47f2a3b8-4311-464a-957e-c838d01a0694",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "„Für viele arme Menschen wird es dieses Jahr nur für die Reise nach Balkonien reichen“"
                                            },
                                            {
                                                "example_id": "1ec560a4-b257-4286-86d3-4f2bf589ea67",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "Das ist eine arme Gegend hier."
                                            },
                                            {
                                                "example_id": "e648d3c9-3e7e-4346-8ff8-8f73475a326e",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "„Ehemals arme Arbeiterviertel wandelten sich zu „IN“-Gegenden; die Immobilienpreise stiegen stark.“"
                                            },
                                            {
                                                "example_id": "445099b1-4223-4ba6-b4d7-b2d9e3da05d8",
                                                "sense_id": "9a1f1336-26d8-3831-b07f-a373efbdfc47",
                                                "text": "„Klimafonds versprechen ärmeren Staaten, beim Klimaschutz zu helfen - und beim Umgang mit den Folgen des Klimawandels.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0de2b10-35dd-36e1-b6c9-80b264895b1f",
                                        "entry_id": "0b70e212-78c5-3ded-9ded-594bf8bda0a9",
                                        "glosses": [
                                            "Mitleid erregend, in einer schlimmen/bedauernswerten Lage sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b5642e-63e1-401b-82a1-26a6ed12ee12",
                                                "sense_id": "f0de2b10-35dd-36e1-b6c9-80b264895b1f",
                                                "text": "„Armes Häschen bist du krank, dass du nicht mehr hüpfen kannst?“ (Kinderlied)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5568da0c-fc3d-30bd-9317-21c328303c8f",
                                        "entry_id": "0b70e212-78c5-3ded-9ded-594bf8bda0a9",
                                        "glosses": [
                                            "gering ausgestattet mit etwas; über wenig Ressourcen verfügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6154a3eb-6ccc-4e26-97f4-cbbbb77a1b8f",
                                                "sense_id": "5568da0c-fc3d-30bd-9317-21c328303c8f",
                                                "text": "Mitteleuropa ist arm an Bodenschätzen, weil diese seit Jahrhunderten ausgebeutet werden."
                                            },
                                            {
                                                "example_id": "91c526c6-7af5-4074-b0d4-c6f5e2616d4e",
                                                "sense_id": "5568da0c-fc3d-30bd-9317-21c328303c8f",
                                                "text": "„Während dort [Anm.: im Nordosten Niedersachsens] ärmere Sandböden der Geest vorherrschen, finden sich im mittleren Osten und Südosten in der Lössbördenzone ertragreiche Böden mit hoher natürlicher Fruchtbarkeit.“"
                                            },
                                            {
                                                "example_id": "442f291e-6ddf-4e8b-8b17-956812d8c4a5",
                                                "sense_id": "5568da0c-fc3d-30bd-9317-21c328303c8f",
                                                "text": "Weil die Sommer arm an Ereignissen waren, wurde das Sommerloch erfunden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c91c49d5-64c8-4db9-ad88-01d25442b9dd",
                        "source_entry_id": "10b96710-98d9-3109-8400-660785d0d79b",
                        "source_sense_id": "65aebf2f-7f30-3f2a-9486-d7c64427b164",
