                    },
                    {
                        "translation_id": "adaa70fa-092a-4bef-ac56-23844650ae10",
                        "source_entry_id": "e859e644-9470-3681-b984-76db7c873b94",
                        "source_sense_id": "123c9ba3-1d17-3811-b7e5-ac8ccdaf5f81",
                        "source_sense_description": "system of therapy",
                        "target_lang_word": "natuurgeneeskunde",
