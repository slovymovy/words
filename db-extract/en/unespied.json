    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "73083288-5292-3789-9dce-3d7431096cff",
                "word": "unespied",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37bbebe4-5e67-30ff-b41d-10d61c85cba4",
                        "entry_id": "73083288-5292-3789-9dce-3d7431096cff",
                        "glosses": [
                            "Not espied or having been espied; unseen, unnoticed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bc6ddbdf-a187-4fa0-bfbe-7158ea8c409a",
                                "sense_id": "37bbebe4-5e67-30ff-b41d-10d61c85cba4",
                                "text": "So did ſhe ſteale his heedeleſſe hart away, / And ioyd his loue in ſecret vneſpyde."
                            },
                            {
                                "example_id": "13c850e2-02bc-4755-896f-f4f69d1a41e8",
                                "sense_id": "37bbebe4-5e67-30ff-b41d-10d61c85cba4",
                                "text": "Then from his loftie ſtand on that high Tree / Down he alights among the ſportful Herd / Of thoſe fourfooted kindes, himſelf now one, / Now other, as thir ſhape ſervd beſt his end / Neerer to view his prey, and uneſpi’d / To mark what of thir ſtate he more might learn / By word or action markt:[…]."
                            },
                            {
                                "example_id": "c5e75fd4-2ac7-4613-bf3f-6169920dcec0",
                                "sense_id": "37bbebe4-5e67-30ff-b41d-10d61c85cba4",
                                "text": "Plays are like Towns, which how e're fortify'd / By Engineers, have still ſome weaker ſide / By the o're-ſeen Defendant uneſpy'd."
                            },
                            {
                                "example_id": "69e4cfaa-6900-4a4a-9be9-f606a2b472ac",
                                "sense_id": "37bbebe4-5e67-30ff-b41d-10d61c85cba4",
                                "text": "Think they their sleights are not already perceived, and that they can walk now unespied, as though they had Gyges' ring, to go invisibly by, upon their finger?"
                            },
                            {
                                "example_id": "73773ab8-3c85-4103-9572-ca7e99e914ba",
                                "sense_id": "37bbebe4-5e67-30ff-b41d-10d61c85cba4",
                                "text": "The queen's majesty then living, being departed from his presence the next way toward her lodging, he following soon after happened to find her garter, which slacked by chance and so fell from her leg, unespied in the throng by such as attended upon her."
                            }
                        ]
                    }
                ],
