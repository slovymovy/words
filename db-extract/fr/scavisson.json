                        "glosses": [
                            "Nom donné à la cannelle. Note : selon le dictionnaire Quillet, il s'agirait de casse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ebbde0fc-0012-480b-9359-deea573762ff",
                                "sense_id": "25ba1297-0327-3346-9342-11a558b29479",
                                "text": "Scavisson. On donne, dans le commerce, cette dénomination … à une écorce qu'on assure provenir de vieux canneliers."
                            },
                            {
                                "example_id": "199c3b23-5a5a-45e7-855e-c5f87a7b05df",
                                "sense_id": "25ba1297-0327-3346-9342-11a558b29479",
                                "text": "Faut mettre en poudre : souffre, résine, gomme de genièvre, « encens, myrrhe, benjoin, scavisson de cannelle, laudanum, anis vert, « calamus, aristoloche ronde, gingembre, poivre, yris de Florence, lavande, mauve, …"
                            },
                            {
                                "example_id": "a8ed5144-f0fa-429d-b683-2287a8b2be15",
                                "sense_id": "25ba1297-0327-3346-9342-11a558b29479",
                                "text": "On retrouve le terme scaviscon joint à celui de cannelle, dans le Journal officiel des Communautés Européennes: Législation, Volume 13, de 1970, sans qu'il soit précisé la nature du scaviscon"
                            }
                        ]
                    }
