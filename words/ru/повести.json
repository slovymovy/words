{
    "word_family": [
        "вести",
        "поведение",
        "проводник",
        "повод",
        "предводитель",
        "путеводитель",
        "ведение"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b1bb703-f3be-3409-9387-44347290bf65",
                    "sense_definition": "Начать вести кого-либо или что-либо в определённом направлении, указывая путь или сопровождая.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "motion_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отец взял сына за руку и <повёл> его домой.",
                            "target_lang_translations": {
                                "en": "The father took his son by the hand and <led> him home.",
                                "tr": "Baba oğlunun elinden tuttu ve onu eve <götürdü>."
                            }
                        },
                        {
                            "text": "Экскурсовод <повёл> группу туристов к старому замку.",
                            "target_lang_translations": {
                                "en": "The tour guide <led> the group of tourists to the old castle.",
                                "tr": "Rehber, turist grubunu eski kaleye doğru <götürmeye başladı>."
                            }
                        }
                    ],
                    "synonyms": [
                        "зати́хнуть",
                        "проводить",
                        "сопроводить"
                    ],
                    "common_phrases": [
                        "повести за руку",
                        "повести в школу",
                        "повести домой"
                    ],
                    "target_lang_definitions": {
                        "en": "To start leading someone or something in a certain direction, indicating the way or accompanying.",
                        "tr": "Birine veya bir şeye belirli bir yönde rehberlik etmeye, yol göstermeye veya eşlik etmeye başlamak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "to guide or conduct someone"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "to escort or guide someone to a place"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "götürmek",
                                "target_lang_sense_clarification": "birini bir yere eşlik ederek ulaştırmak"
                            },
                            {
                                "target_lang_word": "yönlendirmek",
                                "target_lang_sense_clarification": "yol göstermek, kılavuzluk etmek"
                            },
                            {
                                "target_lang_word": "götürmeye başlamak",
                                "target_lang_sense_clarification": "hareketi başlatmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14da02b3-d80c-304f-9af5-0b70f8991d30",
                    "sense_definition": "Начать управлять транспортным средством, заставляя его двигаться.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "motion_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель уверенно <повёл> автобус по горной дороге.",
                            "target_lang_translations": {
                                "en": "The driver confidently <drove> the bus along the mountain road.",
                                "tr": "Sürücü otobüsü dağ yolunda güvenle <sürmeye başladı>."
                            }
                        },
                        {
                            "text": "Капитан <повёл> корабль в открытое море.",
                            "target_lang_translations": {
                                "en": "The captain <steered> the ship into the open sea.",
                                "tr": "Kaptan gemiyi açık denize doğru <yöneltti>."
                            }
                        }
                    ],
                    "synonyms": [
                        "угомони́ться"
                    ],
                    "common_phrases": [
                        "повести машину",
                        "повести корабль"
                    ],
                    "target_lang_definitions": {
                        "en": "To start operating a vehicle, making it move.",
                        "tr": "Bir taşıtı hareket ettirerek sürmeye, yönetmeye başlamak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drive",
                                "target_lang_sense_clarification": "to operate a vehicle"
                            },
                            {
                                "target_lang_word": "steer",
                                "target_lang_sense_clarification": "to guide a vessel or vehicle"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sürmek",
                                "target_lang_sense_clarification": "taşıt yönetmek"
                            },
                            {
                                "target_lang_word": "yöneltmek",
                                "target_lang_sense_clarification": "gemi veya aracı bir yöne doğru sevk etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4885ea22-72ee-30a7-95b5-64e92193c1c3",
                    "sense_definition": "Выйти вперёд в счёте во время спортивного состязания или игры.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_lead",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Уже на десятой минуте матча наша команда <повела> в счёте.",
                            "target_lang_translations": {
                                "en": "Already in the tenth minute of the match, our team <took the lead> in the score.",
                                "tr": "Maçın daha onuncu dakikasında takımımız skorda <öne geçti>."
                            }
                        },
                        {
                            "text": "После точного броска баскетболисты <повели> с разницей в два очка.",
                            "target_lang_translations": {
                                "en": "After an accurate shot, the basketball players <took the lead> by two points.",
                                "tr": "İsabetli atıştan sonra basketbolcular iki sayı farkla <öne geçti>."
                            }
                        }
                    ],
                    "synonyms": [
                        "присмире́ть"
                    ],
                    "antonyms": [
                        "отстать"
                    ],
                    "common_phrases": [
                        "повести в счёте",
                        "команда повела"
                    ],
                    "target_lang_definitions": {
                        "en": "To go ahead in the score during a sports competition or game.",
                        "tr": "Bir spor müsabakasında veya oyunda skorda öne geçmek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take the lead",
                                "target_lang_sense_clarification": "to go ahead in a game"
                            },
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "to be ahead in score"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "öne geçmek",
                                "target_lang_sense_clarification": "skorda üstünlüğü ele geçirmek"
                            },
                            {
                                "target_lang_word": "liderliği ele geçirmek",
                                "target_lang_sense_clarification": "yarışta veya maçta öne geçmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b014919-6893-3323-bb39-233e86b0b4b2",
                    "sense_definition": "Стать причиной чего-либо, иметь что-либо своим следствием.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это необдуманное решение может <повести> к серьёзным проблемам.",
                            "target_lang_translations": {
                                "en": "This rash decision could <lead> to serious problems.",
                                "tr": "Bu düşüncesizce karar ciddi sorunlara <yol açabilir>."
                            }
                        },
                        {
                            "text": "Его слова <повели> за собой долгую дискуссию.",
                            "target_lang_translations": {
                                "en": "His words <led> to a long discussion.",
                                "tr": "Onun sözleri uzun bir tartışmaya <neden oldu>."
                            }
                        }
                    ],
                    "synonyms": [
                        "приути́хнуть",
                        "ути́хнуть"
                    ],
                    "common_phrases": [
                        "повести к последствиям",
                        "повести за собой"
                    ],
                    "target_lang_definitions": {
                        "en": "To become the cause of something, to have something as its consequence.",
                        "tr": "Bir şeye sebep olmak, bir şeyi sonuç olarak doğurmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lead to",
                                "target_lang_sense_clarification": "to result in something"
                            },
                            {
                                "target_lang_word": "result in",
                                "target_lang_sense_clarification": "to cause an outcome"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yol açmak",
                                "target_lang_sense_clarification": "bir sonuca neden olmak"
                            },
                            {
                                "target_lang_word": "götürmek",
                                "target_lang_sense_clarification": "bir duruma veya sonuca ulaştırmak"
                            },
                            {
                                "target_lang_word": "neden olmak",
                                "target_lang_sense_clarification": "sebep olmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7df020f-4158-3fad-b4bf-4158ecc4f407",
                    "sense_definition": "Сделать плавное движение частью тела (обычно бровями, плечами, глазами).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На мой вопрос он лишь удивлённо <повёл> плечами.",
                            "target_lang_translations": {
                                "en": "To my question, he only <shrugged> his shoulders in surprise.",
                                "tr": "Soruma karşılık sadece şaşkınlıkla omuzlarını <silkti>."
                            }
                        },
                        {
                            "text": "Он даже ухом не <повёл>, когда услышал эту новость.",
                            "target_lang_translations": {
                                "en": "He didn't even <bat an eyelid> when he heard this news.",
                                "tr": "Bu haberi duyduğunda kılını bile <kıpırdatmadı>."
                            }
                        }
                    ],
                    "synonyms": [
                        "уле́чься"
                    ],
                    "common_phrases": [
                        "повести бровью",
                        "повести плечами",
                        "ухом не повести"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a smooth movement with a body part (usually eyebrows, shoulders, eyes).",
                        "tr": "Vücudun bir kısmıyla (genellikle kaş, omuz, göz) hafif ve yumuşak bir hareket yapmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrug",
                                "target_lang_sense_clarification": "of shoulders"
                            },
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "of body parts"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "oynatmak",
                                "target_lang_sense_clarification": "vücut azasını hafifçe hareket ettirmek"
                            },
                            {
                                "target_lang_word": "silkmek",
                                "target_lang_sense_clarification": "omuz silkmek anlamında"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cf45920-9e20-37ea-8fc7-696b664d2b50",
                    "sense_definition": "О непроизвольном отклонении в сторону при движении (обычно о транспортном средстве или человеке).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На скользкой дороге автомобиль внезапно <повело> влево.",
                            "target_lang_translations": {
                                "en": "On the slippery road, the car suddenly <skidded> to the left.",
                                "tr": "Kaygan yolda otomobil aniden sola doğru <savruldu>."
                            }
                        },
                        {
                            "text": "От сильной усталости и головокружения его <повело> в сторону.",
                            "target_lang_translations": {
                                "en": "From severe fatigue and dizziness, he <staggered> to the side.",
                                "tr": "Aşırı yorgunluk ve baş dönmesinden dolayı yana doğru <yalpaladı>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ослабе́ть"
                    ],
                    "common_phrases": [
                        "машину повело",
                        "меня повело"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "безличный глагол"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding an involuntary deviation to the side during movement (usually of a vehicle or person).",
                        "tr": "Hareket halindeyken (genellikle bir taşıt veya insan için) istem dışı olarak yana doğru sapmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "skid",
                                "target_lang_sense_clarification": "of a vehicle sliding sideways"
                            },
                            {
                                "target_lang_word": "stagger",
                                "target_lang_sense_clarification": "of a person walking unsteadily"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "savrulmak",
                                "target_lang_sense_clarification": "taşıtın kontrolsüzce yana kayması"
                            },
                            {
                                "target_lang_word": "yalpalamak",
                                "target_lang_sense_clarification": "insanın halsizlikten yana doğru sendelemesi"
                            },
                            {
                                "target_lang_word": "kaymak",
                                "target_lang_sense_clarification": "yoldan sapmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f373a00-23ce-35ba-b060-96d6c4be1c08",
                    "sense_definition": "Искривиться, деформироваться под воздействием влаги, температуры или времени (о материалах).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От сырости деревянную раму окна сильно <повело>.",
                            "target_lang_translations": {
                                "en": "The wooden window frame <warped> badly from the dampness.",
                                "tr": "Rutubetten dolayı ahşap pencere çerçevesi iyice <eğrildi>."
                            }
                        },
                        {
                            "text": "Если сушить доски неправильно, их может <повести>.",
                            "target_lang_translations": {
                                "en": "If boards are dried incorrectly, they might <warp>.",
                                "tr": "Tahtalar yanlış kurutulursa <bükülebilir>."
                            }
                        }
                    ],
                    "synonyms": [
                        "смо́лкнуть"
                    ],
                    "common_phrases": [
                        "дверь повело",
                        "доски повело"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "безличный глагол"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To warp or deform under the influence of moisture, temperature, or time (about materials).",
                        "tr": "Nem, sıcaklık veya zamanın etkisiyle eğrilmek, deforme olmak (malzemeler için)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "warp",
                                "target_lang_sense_clarification": "to become bent or twisted out of shape"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eğrilmek",
                                "target_lang_sense_clarification": "şekli bozulmak"
                            },
                            {
                                "target_lang_word": "bel vermek",
                                "target_lang_sense_clarification": "tahta vb. malzemelerin bükülmesi"
                            },
                            {
                                "target_lang_word": "çıkmak",
                                "target_lang_sense_clarification": "kapı veya pencerenin çarpılması"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f187bbc8-7c2d-383f-9e9b-a02d5c6f0faf",
                    "sense_definition": "Форма родительного, дательного или предложного падежа единственного числа существительного <w>повесть</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В сюжете этой <повести> много неожиданных поворотов.",
                            "target_lang_translations": {
                                "en": "There are many unexpected twists in the plot of this <novella>.",
                                "tr": "Bu <uzun hikayenin> olay örgüsünde pek çok beklenmedik gelişme var."
                            }
                        },
                        {
                            "text": "Мы долго говорили о новой <повести> известного писателя.",
                            "target_lang_translations": {
                                "en": "We talked for a long time about the famous writer's new <novella>.",
                                "tr": "Ünlü yazarın yeni <romanı> hakkında uzun uzun konuştuk."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "существительное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Form of the genitive, dative, or prepositional case singular of the noun 'povest' (novella).",
                        "tr": "'Повесть' (uzun hikaye, roman) isminin tekil hâldeki -in, -e veya -de durumu formu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "novella",
                                "target_lang_sense_clarification": "literary genre"
                            },
                            {
                                "target_lang_word": "story",
                                "target_lang_sense_clarification": "narrative tale"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzun hikayenin",
                                "target_lang_sense_clarification": "povest kelimesinin çekimli hali"
                            },
                            {
                                "target_lang_word": "romanın",
                                "target_lang_sense_clarification": "edebi türün çekimli hali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "474d70b2-535b-394b-aadf-7bbac9324201",
                    "sense_definition": "Форма именительного или винительного падежа множественного числа существительного <w>повесть</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эти <повести> были написаны в прошлом веке.",
                            "target_lang_translations": {
                                "en": "These <novellas> were written in the last century.",
                                "tr": "Bu <uzun hikayeler> geçen yüzyılda yazılmıştı."
                            }
                        },
                        {
                            "text": "Я люблю читать исторические <повести>.",
                            "target_lang_translations": {
                                "en": "I love reading historical <novellas>.",
                                "tr": "Tarihi <romanlar> okumayı severim."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "существительное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Form of the nominative or accusative case plural of the noun 'povest' (novella).",
                        "tr": "'Повесть' (uzun hikaye, roman) isminin çoğul hâldeki yalın veya belirtme durumu formu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "novellas",
                                "target_lang_sense_clarification": "plural of novella"
                            },
                            {
                                "target_lang_word": "stories",
                                "target_lang_sense_clarification": "plural of story"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzun hikayeler",
                                "target_lang_sense_clarification": "povest kelimesinin çoğul hali"
                            },
                            {
                                "target_lang_word": "romanlar",
                                "target_lang_sense_clarification": "edebi türün çoğul hali"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}