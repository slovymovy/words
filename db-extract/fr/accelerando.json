                    {
                        "form_id": "63e4572b-e8f8-4a69-8b26-cd7978423de5",
                        "entry_id": "b1fc4f71-3d90-3339-8f83-57d7bbd16b97",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "accélérando"
