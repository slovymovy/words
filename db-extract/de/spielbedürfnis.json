                ],
                "senses": [
                    {
                        "sense_id": "6e3384ba-33a3-352c-940a-367f53092c73",
                        "entry_id": "f5608ceb-218e-3c87-8219-cc4e68ea9dbf",
                        "glosses": [
                            "innerer Drang, Trieb zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc485dac-376f-45e9-a4f7-b03a00d833cc",
                                "sense_id": "6e3384ba-33a3-352c-940a-367f53092c73",
                                "text": "„Auch hier gilt, wie bei den Kampfspielen, dass wir die Spiele nicht einfach im Sinne unserer Erzieherwünsche verändern und damit den Kindern ihre Spielbedürfnisse und Spielthematik verderben sollen.“"
                            },
                            {
                                "example_id": "23cb550d-a490-4bac-be78-9c1c3ef6d7a4",
                                "sense_id": "6e3384ba-33a3-352c-940a-367f53092c73",
                                "text": "„Spiel und Spielbedürfnis, Spielwagnis und Simulation gehören offenbar zum Potential der Erneuerung in der modernen Welt.“"
                            },
                            {
                                "example_id": "f1745052-6722-4d37-be96-7d691248e9f0",
                                "sense_id": "6e3384ba-33a3-352c-940a-367f53092c73",
                                "text": "„Er kann dem Spielbedürfnis des jugendlichen Menschen entgegenkommen und ihm ein Betätigungsfeld eröffnen, ohne seinen fachlichen und pädagogischen Auftrag zu missachten.“"
                            },
                            {
                                "example_id": "af752fb0-9d73-4352-846a-d724aeec2e78",
                                "sense_id": "6e3384ba-33a3-352c-940a-367f53092c73",
                                "text": "„Wenn ein so starkes Spielbedürfnis besteht, dann drängt sich auch die Vermutung auf, dass ein unmittelbar auf das Spielen gerichteter Antrieb, der Spieltrieb, diesem Geschehen zugrunde liegen müsse.“"
                            },
                            {
                                "example_id": "75bd92a7-05d9-4689-8d58-e70183849112",
                                "sense_id": "6e3384ba-33a3-352c-940a-367f53092c73",
                                "text": "„Frustrationen entstehen, wenn der Spielende sich überfordert sieht, wenn Spielbedürfnisse nicht befriedigt werden oder wenn eine erwartete Anerkennung versagt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
