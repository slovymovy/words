                ],
                "senses": [
                    {
                        "sense_id": "5fbc10c6-c969-3082-9a7c-b4b64e2c20cf",
                        "entry_id": "fba9b365-d456-3c35-b544-9793eec4e422",
                        "glosses": [
                            "een gewapende strijd tussen twee of meer bevolkingsgroepen binnen hetzelfde land, waarbij soms ook het leger betrokken is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db32501-ec49-4465-918b-cfc33b3750bf",
                                "sense_id": "5fbc10c6-c969-3082-9a7c-b4b64e2c20cf",
                                "text": "Tijdens de burgeroorlog werd de Tweede Spaanse Republiek vernietigd."
                            },
                            {
                                "example_id": "afbeaed1-f918-4b3e-b78d-ec74e578ee91",
                                "sense_id": "5fbc10c6-c969-3082-9a7c-b4b64e2c20cf",
                                "text": "Als de stoffelijke resten van de dictator worden overgebracht zoals gepland, komt er een einde aan bijna een jaar van verzet van de nakomelingen van de “Généralissime”, die de bloedige burgeroorlog van 1936-1939 won, en ook aan het benedictijnenklooster dat het mausoleum onderhoudt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e0ef804-a384-4e37-884a-d3d55c474d6f",
                        "source_entry_id": "fba9b365-d456-3c35-b544-9793eec4e422",
                        "source_sense_id": "5fbc10c6-c969-3082-9a7c-b4b64e2c20cf",
                        "source_sense_description": "een gewapende strijd tussen twee of meer bevolkingsgroepen binnen hetzelfde land, waarbij soms ook het leger betrokken is",
                        "target_lang_word": "Bürgerkrieg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgerkrieg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a047194c-3b10-3d69-a3e8-ef28be046e81",
                                        "entry_id": "bc87205d-1211-392c-8b65-34d9b7d05fc4",
                                        "glosses": [
                                            "bewaffneter Konflikt zwischen unterschiedlichen (politischen, nationalen, sozialen oder religiösen) Gruppen innerhalb der Grenzen eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f812726-0a2a-411b-bc87-b2ad29ef24d3",
                                                "sense_id": "a047194c-3b10-3d69-a3e8-ef28be046e81",
                                                "text": "Der Sezessionskrieg war ein Bürgerkrieg."
                                            },
                                            {
                                                "example_id": "5380e4a1-4f12-4c2c-8a33-5b9c30ad5f44",
                                                "sense_id": "a047194c-3b10-3d69-a3e8-ef28be046e81",
                                                "text": "„Hören wir Gracchus Babeuf, der in seiner berühmten Rede nach dem Massaker auf dem Marsfeld in Paris ausrief: »Ihr Niederträchtigen, ihr schreit, man müsse den Bürgerkrieg verhindern, man dürfe die Fackel der Zwietracht nicht unter das Volk werfen. Und welcher Bürgerkrieg ist empörender als derjenige, der alle Mörder auf einer Seite und alle wehrlosen Opfer auf der andern präsentiert!«“"
                                            },
                                            {
                                                "example_id": "16c94b00-e499-4415-bf01-0b71a461db2d",
                                                "sense_id": "a047194c-3b10-3d69-a3e8-ef28be046e81",
                                                "text": "„Dann war der Bürgerkrieg so gut wie vorbei.“"
                                            },
                                            {
                                                "example_id": "9e07f942-44fb-4b2e-a807-7c54da94043f",
                                                "sense_id": "a047194c-3b10-3d69-a3e8-ef28be046e81",
                                                "text": "„Seine Ermordung nur zwei Jahre später hatte einen bitteren Bürgerkrieg zur Folge.“"
                                            },
                                            {
                                                "example_id": "908191b0-c9aa-469f-83fb-d76fd874af31",
                                                "sense_id": "a047194c-3b10-3d69-a3e8-ef28be046e81",
                                                "text": "„Jener Oktober war einer der allerschlimmsten Monate des Bürgerkrieges.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17348ab1-70b5-302d-bb17-d02606c75e60",
                                        "entry_id": "bc87205d-1211-392c-8b65-34d9b7d05fc4",
                                        "glosses": [
                                            "der unter [1] beschriebene bewaffnete Konflikt derartiger Gruppen mit der Regierung des Staates, in dem der Konflikt herrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6e748ad-d9a6-4c2d-8b5c-230df523f8bc",
                                                "sense_id": "17348ab1-70b5-302d-bb17-d02606c75e60",
                                                "text": "„Der Bürgerkrieg in Dschibuti war eine Auseinandersetzung zwischen der Afar-Rebellengruppe FRUD und der von Issa dominierten Regierung Dschibutis unter der RPP von 1991 bis 1994.“"
                                            },
                                            {
                                                "example_id": "e8fd3a87-3c47-4e70-bcfe-89c339bd045f",
                                                "sense_id": "17348ab1-70b5-302d-bb17-d02606c75e60",
                                                "text": "„Durch den seit Jahren anhaltenden Bürgerkrieg ist die medizinische Versorgung des Jemen, ungeachtet des zuletzt geschlossenen Waffenstillstands, weitgehend lahmgelegt.“"
                                            },
                                            {
                                                "example_id": "4baec9c7-a2cc-4cc1-8be8-4a6020058a07",
                                                "sense_id": "17348ab1-70b5-302d-bb17-d02606c75e60",
                                                "text": "[Nordirland:] „Eine solche Einheitsregierung beider Lager ist durch das Karfreitagsabkommen von 1998 vorgeschrieben, mit dem der Bürgerkrieg beendet worden war.“"
                                            },
                                            {
                                                "example_id": "80917ac4-5614-4381-9ead-3eb3e43e0af3",
                                                "sense_id": "17348ab1-70b5-302d-bb17-d02606c75e60",
                                                "text": "„Seit zwei Jahren tobt ein Bürgerkrieg im Norden Äthiopiens an der Grenze zu Eritrea.“"
                                            },
                                            {
                                                "example_id": "863f7c3d-31bc-4b59-87b4-949f54e3516a",
                                                "sense_id": "17348ab1-70b5-302d-bb17-d02606c75e60",
                                                "text": "„In Syrien ist Bürgerkrieg.“"
                                            },
                                            {
                                                "example_id": "3406e145-5f62-4451-9d3b-f0bf56f27116",
                                                "sense_id": "17348ab1-70b5-302d-bb17-d02606c75e60",
                                                "text": "„Hunderttausende waren im Bürgerkrieg dieses Landes gestorben, und die Welt hatte sich kaum dafür interessiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40da8ba1-1d0d-4868-86ad-cea831149a27",
                        "source_entry_id": "fba9b365-d456-3c35-b544-9793eec4e422",
                        "source_sense_id": "5fbc10c6-c969-3082-9a7c-b4b64e2c20cf",
                        "source_sense_description": "een gewapende strijd tussen twee of meer bevolkingsgroepen binnen hetzelfde land, waarbij soms ook het leger betrokken is",
                        "target_lang_word": "civil war",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civil war",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd32a91-b47a-3de8-a3d1-cd30b910fed3",
                                        "entry_id": "b981803a-6881-3588-8641-e3e6f472dc4c",
                                        "glosses": [
                                            "A war fought between factions of the inhabitants of a single country, or a similar political entity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11980378-57a1-4f47-9a82-50a75b39de8a",
                                                "sense_id": "1cd32a91-b47a-3de8-a3d1-cd30b910fed3",
                                                "text": "Our Father’s Death\nWould fill up all the Guilt of Civil War,\nAnd cloſe the Scene of Blood."
                                            },
                                            {
                                                "example_id": "f8bedc4c-396e-43b1-953e-6c5c65b936bb",
                                                "sense_id": "1cd32a91-b47a-3de8-a3d1-cd30b910fed3",
                                                "text": "At about the time the salarians and asari were forming the Council, the turians were embroiled in a bitter civil war. The Unification War, as it was later named, began with hostilities between the colonies furthest from the turian homeworld, Palaven."
                                            },
                                            {
                                                "example_id": "1e005543-6d60-4b2d-bca0-b0776d7f041f",
                                                "sense_id": "1cd32a91-b47a-3de8-a3d1-cd30b910fed3",
                                                "text": "The “little green men”—faces covered, wearing unmarked olive uniforms, speaking Russian and using Russian weapons—have played a significant role in both the occupation of Crimea and the civil war in eastern Ukraine.¹⁹⁶"
                                            },
                                            {
                                                "example_id": "54f3fda4-c999-40bf-b21d-a5f6e601d5f4",
                                                "sense_id": "1cd32a91-b47a-3de8-a3d1-cd30b910fed3",
                                                "text": "Civil war is now casually discussed on cable TV shows in between ads for haemorrhoid creams and car insurance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb3e7c35-d39f-4250-83c9-43f50c9727ce",
                        "source_entry_id": "fba9b365-d456-3c35-b544-9793eec4e422",
                        "source_sense_id": "5fbc10c6-c969-3082-9a7c-b4b64e2c20cf",
                        "source_sense_description": "een gewapende strijd tussen twee of meer bevolkingsgroepen binnen hetzelfde land, waarbij soms ook het leger betrokken is",
                        "target_lang_word": "guerre civile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guerre civile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                        "entry_id": "c608b11a-d16b-3327-aa58-7912ef3044f3",
                                        "glosses": [
                                            "Guerre entre citoyens d’un même État ou entre citoyens et le gouvernement, ou l’armée, de leur État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f889ab-41ca-437c-8d85-86a8ef0ee726",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "Il attaquait dans le moment unique et irretrouvable d’une guerre civile qui armait les uns contre les autres les princes de la branche allemande ; […]"
                                            },
                                            {
                                                "example_id": "84094599-9a4d-4f7d-a3b9-0fd425a1f973",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "Sous la première République, au moment même où toute l’Europe nous tombait sur le dos, c'est les curés qui ont excités la guerre civile en Vendée, fanatisant les paysans, les menant au combat, et leur promettant le paradis s'ils étaient tués."
                                            },
                                            {
                                                "example_id": "20deab6a-4ff2-4738-9972-c4abbd57f3a2",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "On a remarqué plus d’une fois que les États qui sortaient des guerres civiles ont été très supérieurs à leurs ennemis, car tout est soldat dans une guerre civile."
                                            },
                                            {
                                                "example_id": "8e2bd49d-1de1-4f67-931d-1bef8978e78b",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "Dans ce charmant district de la joyeuse Angleterre qu’arrose le Don, s’étendait, aux jours reculés, une vaste forêt […] ; là, furent livrées plusieurs des batailles désespérées qui ensanglantèrent les guerres civiles des Deux-Roses ; […]"
                                            },
                                            {
                                                "example_id": "9b514988-df64-47aa-8b0f-a3c87bb95544",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "[…] le comte d’Artois, le prince de Condé, et les Polignac sortaient de France pour aller demander à l’étranger non-seulement un asile, mais des secours contre la révolution. C’était les premiers de émigrés qui bientôt vont allumer la guerre civile dans leur patrie et former contre elle une coalition européenne."
                                            },
                                            {
                                                "example_id": "6c98a2b8-86b2-4e27-91dc-b219484e51e1",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "La guerre civile est devenue bien difficile depuis la découverte des nouvelles armes à feu et depuis le percement des voies rectilignes dans les métropoles."
                                            },
                                            {
                                                "example_id": "3fddcd5e-58e0-4d1a-9708-ce1ec34cbde6",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "Mais la gravité des événements lui donna tout-à-coup une acuité tragique. Ce fut la guerre civile dans toute son horreur, laquelle ne devait prendre fin que par l'occupation étrangère."
                                            },
                                            {
                                                "example_id": "3eb2a941-8123-410b-b640-622829a85be1",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "Pendant les deux premiers mois de la guerre civile, Staline n’avait pas songé à intervenir en Espagne."
                                            },
                                            {
                                                "example_id": "bc418a79-9830-4da7-8b0f-2dc477152290",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "Je suis la Guerre civile, je suis la bonne guerre, celle où l’on sait pourquoi l’on tue et qui l’on tue […]"
                                            },
                                            {
                                                "example_id": "795f2d7b-62f2-441b-9e1d-bc275e038c24",
                                                "sense_id": "5d068cfd-395b-31d0-9abb-624e765572d0",
                                                "text": "Le Coran, comme la sunna du Prophète furent pratiquement périmés en tant que guides pratiques de la vie moins d'une génération après la mort du Prophète, dès 660-661, lors de la première guerre civile de la communauté musulmane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
