                                        "sense_id": "180adb1c-f072-3489-9473-3ef899d09ad0",
                                        "entry_id": "92d6e9e5-ca8f-3b5b-8276-158607bf6103",
                                        "glosses": [
                                            "A drop of clear, salty liquid produced from the eyes by crying or irritation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "084b9aa2-2859-4de2-9075-bbc1964cc19b",
                                                "sense_id": "180adb1c-f072-3489-9473-3ef899d09ad0",
                                                "text": "Big tears streamed from Lisa's eyes, rolling down her cheeks."
                                            },
                                            {
                                                "example_id": "1646ce84-c1cf-40ce-9164-ad8a6a5ef0e3",
                                                "sense_id": "180adb1c-f072-3489-9473-3ef899d09ad0",
                                                "text": "Ryan wiped the tear from the paper he was crying on."
                                            },
                                            {
                                                "example_id": "4929cbac-3f03-4ef9-8d29-ef72ae409c9f",
                                                "sense_id": "180adb1c-f072-3489-9473-3ef899d09ad0",
                                                "text": "I pray you in your Letters, / When you ſhall theſe vnluckie deeds relate, / Speake of me, as I am. […] / Of one, whoſe ſubdu'd Eyes, / Albeit un-vsed to the melting moode, / Drops teares as faſt as the Arabian Trees / Their Medicinable gumme."
                                            },
                                            {
                                                "example_id": "3c00a843-1d27-408d-92c6-08b54e452a3b",
                                                "sense_id": "180adb1c-f072-3489-9473-3ef899d09ad0",
                                                "text": "'[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because \"it was wicked to dress us like charity children\".[…]'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a96431cb-83df-39c9-ac6c-82a8098d975e",
                                        "entry_id": "92d6e9e5-ca8f-3b5b-8276-158607bf6103",
                                        "glosses": [
                                            "Something in the form of a transparent drop of fluid matter; also, a solid, transparent, tear-shaped drop, as of some balsams or resins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f409b935-79ea-4202-a39a-2e5486e58a55",
                                                "sense_id": "a96431cb-83df-39c9-ac6c-82a8098d975e",
                                                "text": "Let Araby extol her happy coast, / Her fragrant flowers, her trees with precious tears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d23877e8-c021-34ae-be86-e092062726bf",
