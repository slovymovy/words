                        "examples": [
                            {
                                "example_id": "5c59f787-ce01-4319-8a5f-ef485a4b799b",
                                "sense_id": "5846884f-ed3f-3fbe-ada0-65a6a64ed4c4",
                                "text": "Het Zwitserse dorp dat vorige maand werd ontruimd wegens instortingsgevaar van een bergwand, is vannacht ontsnapt aan een rotslawine. Een enorme steenmassa kwam vlak voor de eerste gebouwen van Brienz tot stilstand."
                            },
                            {
                                "example_id": "03977252-107a-4647-9aef-659646e8601f",
                                "sense_id": "5846884f-ed3f-3fbe-ada0-65a6a64ed4c4",
                                "text": "Een 22-jarige vrouw uit Nederland is gewond geraakt door de steenmassa, meldt de politie van het Zwitserse kanton Wallis dinsdag. De alpinisten waren bezig met een beklimming van de Aiguille du Tour, een berg ten noordoosten van de Mont Blanc."
                            }
                        ]
                    }
