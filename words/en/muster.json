{
    "word_family": [
        "mustering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "556df80c-4173-381c-b7b7-b6695655c5d2",
                    "sense_definition": "An assembling or review of troops, as for parade, verification of numbers, inspection, or introduction into service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general ordered a <w>muster</w> of all active soldiers at dawn to prepare for the inspection.",
                            "target_lang_translations": {
                                "ru": "Генерал приказал провести <w>смотр</w> всех действующих солдат на рассвете, чтобы подготовиться к инспекции."
                            }
                        },
                        {
                            "text": "The soldiers stood in formation during the morning <w>muster</w> on the parade ground.",
                            "target_lang_translations": {
                                "ru": "Солдаты стояли в строю во время утренней <w>поверки</w> на плацу."
                            }
                        }
                    ],
                    "synonyms": [
                        "parade",
                        "military parade",
                        "review"
                    ],
                    "common_phrases": [
                        "morning muster",
                        "muster of troops"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбор или смотр войск для парада, проверки численности, инспекции или призыва на службу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смотр",
                                "target_lang_sense_clarification": "военный смотр войск"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "военный сбор личного состава"
                            },
                            {
                                "target_lang_word": "поверка",
                                "target_lang_sense_clarification": "перекличка или проверка присутствующих"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b203fb2-3102-3a1c-9d03-a82c9acb7640",
                    "sense_definition": "An assemblage, gathering, or collection of people or things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a great <w>muster</w> of local artists and writers at the gallery opening.",
                            "target_lang_translations": {
                                "ru": "На открытии галереи было большое <w>скопление</w> местных художников и писателей."
                            }
                        },
                        {
                            "text": "The annual festival brought a splendid <w>muster</w> of traditional musicians to the town.",
                            "target_lang_translations": {
                                "ru": "Ежегодный фестиваль собрал в городе великолепный <w>состав</w> традиционных музыкантов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрание, скопление или коллекция людей или предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "собрание или встреча людей"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "сосредоточение людей или вещей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df586c11-f5c9-3338-b483-df17dce421bd",
                    "sense_definition": "A roundup of livestock for inspection, branding, shearing, or other management purposes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "livestock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stockmen spent three days in the desert completing the annual cattle <w>muster</w>.",
                            "target_lang_translations": {
                                "ru": "Скотоводы провели три дня в пустыне, завершая ежегодный <w>сгон</w> скота."
                            }
                        },
                        {
                            "text": "They prepared the horses early in the morning for the sheep <w>muster</w>.",
                            "target_lang_translations": {
                                "ru": "Рано утром они подготовили лошадей для <w>сбора</w> овец."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cattle muster",
                        "sheep muster"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгон или сбор скота для осмотра, клеймения, стрижки или других хозяйственных целей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгон",
                                "target_lang_sense_clarification": "сбор скота в одно место"
                            },
                            {
                                "target_lang_word": "сбор скота",
                                "target_lang_sense_clarification": "окружение и созыв животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dec51a3-17c4-3212-805f-3cc6ab3fe03e",
                    "sense_definition": "The sum total of an army when assembled for review; the whole number of effective men.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commander checked the official <w>muster</w> to see how many men were fit for duty.",
                            "target_lang_translations": {
                                "ru": "Командир проверил официальный <w>списочный состав</w>, чтобы узнать, сколько человек пригодно к службе."
                            }
                        },
                        {
                            "text": "Our total <w>muster</w> was far smaller than the enemy's forces.",
                            "target_lang_translations": {
                                "ru": "Наша общая <w>численность</w> была намного меньше сил противника."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая численность собранной армии; общее количество боеспособных солдат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "численность",
                                "target_lang_sense_clarification": "списочный состав войск"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "общее число собранных сил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d336fc5a-7c7c-3bf6-9316-35d6c7031ee0",
                    "sense_definition": "A sample of goods or pattern shown for imitation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sample",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant provided a <w>muster</w> of silk to the buyer before the deal was finalized.",
                            "target_lang_translations": {
                                "ru": "Купец предоставил покупателю <w>образец</w> шелка до завершения сделки."
                            }
                        },
                        {
                            "text": "He asked the tailor for a <w>muster</w> of the fabric to check its quality.",
                            "target_lang_translations": {
                                "ru": "Он попросил у портного <w>лоскут</w> ткани, чтобы проверить её качество."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historically used in trade contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образец товаров или узор, предназначенный для копирования или демонстрации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "проба товара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f91202b-366c-3788-b927-1d5e98f93a52",
                    "sense_definition": "An act of showing something; a display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a poor <w>muster</w> of his manners during the formal dinner.",
                            "target_lang_translations": {
                                "ru": "Он показал плохое <w>проявление</w> своих манер во время официального ужина."
                            }
                        },
                        {
                            "text": "The team put on a fine <w>muster</w> of their skills during the exhibition match.",
                            "target_lang_translations": {
                                "ru": "Команда устроила отличный <w>показ</w> своего мастерства во время показательного матча."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт демонстрации чего-либо; показ или проявление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показ",
                                "target_lang_sense_clarification": "демонстрация или проявление качеств"
                            },
                            {
                                "target_lang_word": "проявление",
                                "target_lang_sense_clarification": "демонстрация навыков или манер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45aa4adb-49b8-3ba0-a0f0-7dc8418cc746",
                    "sense_definition": "A collective term for a group of peafowl.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were delighted to spot a beautiful <w>muster</w> of peacocks roaming the palace gardens.",
                            "target_lang_translations": {
                                "ru": "Мы были в восторге, заметив красивую <w>стаю</w> павлинов, гуляющих по дворцовым садам."
                            }
                        },
                        {
                            "text": "A colorful <w>muster</w> gathered near the lawn to feed.",
                            "target_lang_translations": {
                                "ru": "Красочная <w>группа</w> собралась у лужайки, чтобы покормиться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muster of peacocks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное название для группы павлинов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа павлинов"
                            },
                            {
                                "target_lang_word": "семейство",
                                "target_lang_sense_clarification": "группа птиц"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac53fcbf-f386-306c-af06-29827162974c",
                    "sense_definition": "To collect, call, or assemble together (such as troops, people, or resources) for inspection, action, or display.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "assemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>muster</w> all her courage before walking onto the stage to deliver the speech.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>собрать</w> все свое мужество, прежде чем выйти на сцену для произнесения речи."
                            }
                        },
                        {
                            "text": "The captain managed to <w>muster</w> the crew on the deck within minutes of the alarm.",
                            "target_lang_translations": {
                                "ru": "Капитану удалось <w>собрать</w> команду на палубе в течение нескольких минут после сигнала тревоги."
                            }
                        }
                    ],
                    "synonyms": [
                        "rally"
                    ],
                    "common_phrases": [
                        "muster courage",
                        "muster support",
                        "muster the energy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать, призывать или объединять (войска, людей или ресурсы) для осмотра, действий или демонстрации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "силы, мужество или людей"
                            },
                            {
                                "target_lang_word": "набираться",
                                "target_lang_sense_clarification": "набираться смелости"
                            },
                            {
                                "target_lang_word": "мобилизовать",
                                "target_lang_sense_clarification": "ресурсы или волю"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4edeaeb6-3aca-3ca6-a2d7-e8a60a675d5c",
                    "sense_definition": "To gather or come together for parade, inspection, or exercise (especially of a military force).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The volunteers were told to <w>muster</w> in the town square at eight o'clock.",
                            "target_lang_translations": {
                                "ru": "Добровольцам велели <w>собраться</w> на городской площади в восемь часов."
                            }
                        },
                        {
                            "text": "The soldiers began to <w>muster</w> on the field as the bugle sounded.",
                            "target_lang_translations": {
                                "ru": "Солдаты начали <w>строиться</w> на поле, как только затрубил горн."
                            }
                        }
                    ],
                    "synonyms": [
                        "parade"
                    ],
                    "common_phrases": [
                        "muster in the square"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться вместе для парада, смотра или учений (особенно о военных силах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "для смотра или построения"
                            },
                            {
                                "target_lang_word": "строиться",
                                "target_lang_sense_clarification": "выстраиваться на плацу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "673fb2d3-0074-3ad0-92b2-18632f048a1a",
                    "sense_definition": "To gather or round up livestock.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "livestock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers had to <w>muster</w> the sheep from the hills before the winter storm arrived.",
                            "target_lang_translations": {
                                "ru": "Фермерам пришлось <w>согнать</w> овец с холмов до начала зимней бури."
                            }
                        },
                        {
                            "text": "It took them all afternoon to <w>muster</w> the cattle into the main yard.",
                            "target_lang_translations": {
                                "ru": "У них ушел весь день на то, чтобы <w>загнать</w> скот во внутренний двор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muster cattle",
                        "muster sheep"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать или сгонять скот вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгонять",
                                "target_lang_sense_clarification": "собирать скот в стадо"
                            },
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "животных с пастбищ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57338671-fa28-35f4-ab23-e20421069cc4",
                    "sense_definition": "To show, exhibit, or display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "assemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could not <w>muster</w> any enthusiasm for the new project during the meeting.",
                            "target_lang_translations": {
                                "ru": "На собрании он не смог <w>найти в себе</w> никакого энтузиазма по поводу нового проекта."
                            }
                        },
                        {
                            "text": "She tried to <w>muster</w> a smile despite feeling incredibly tired.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>выдавить</w> улыбку, несмотря на невероятную усталость."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muster a smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать, проявлять или выражать (чувство, улыбку)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавить",
                                "target_lang_sense_clarification": "выдавить из себя улыбку"
                            },
                            {
                                "target_lang_word": "найти в себе",
                                "target_lang_sense_clarification": "найти в себе силы или энтузиазм"
                            },
                            {
                                "target_lang_word": "проявить",
                                "target_lang_sense_clarification": "показать эмоцию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9d2e4a2-e17b-3470-be29-92c078f791f0",
                    "sense_definition": "To enroll into military service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "assemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young recruits were <w>mustered</w> into the army at the beginning of the war.",
                            "target_lang_translations": {
                                "ru": "Молодые новобранцы были <w>призваны</w> в армию в начале войны."
                            }
                        },
                        {
                            "text": "He was officially <w>mustered</w> into service after passing his physical exam.",
                            "target_lang_translations": {
                                "ru": "Он был официально <w>зачислен</w> на службу после прохождения медосмотра."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muster into service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зачислять на военную службу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призывать",
                                "target_lang_sense_clarification": "на военную службу"
                            },
                            {
                                "target_lang_word": "зачислять",
                                "target_lang_sense_clarification": "в состав армии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}