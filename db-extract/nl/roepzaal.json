                        "glosses": [
                            "zaal van een veilinghuis waar men zijn bod mag uitbrengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adaf564-2e8f-4e90-b4c3-55dcd822e4ce",
                                "sense_id": "2365b8c3-936d-3ad7-baeb-5c7167b487c0",
                                "text": "Het publiek mag de dieren komen bekijken en keuren. In de roepzaal is er donderdag geen plaats meer, alle zitjes voor de veiling zijn ingenomen. De voorbiedingen stromen intussen binnen, met een recordbedrag van 10.000 euro voor één olifant."
                            },
                            {
                                "example_id": "95071e81-5c30-4569-9e79-68f129c2f41e",
                                "sense_id": "2365b8c3-936d-3ad7-baeb-5c7167b487c0",
                                "text": "We leken wel trouwe veilingbezoekers geworden die elke dag ergens in een denkbeeldige roepzaal machteloos toekeken hoe en tegen welke prijs Europese overheden hun staatspapier probeerden te slijten."
                            }
                        ]
                    }
