                        "examples": [
                            {
                                "example_id": "90e6e245-9a35-4371-88ad-5658b37b2291",
                                "sense_id": "ecf01472-ffce-36be-9cb8-0fbe2b64607b",
                                "text": "Tegenover die onzekerheid en dalende aandelenkoersen staat een stijgende goudprijs. Voor een ounce goud (31,1 gram) wordt nu 1175 dollar betaald, een stijging van meer dan 10 procent in vergelijking met begin dit jaar. Ook de obligatieprijzen dalen."
                            },
                            {
                                "example_id": "2f6b1231-ebb4-4b23-ae6f-0b98d8f1dbbf",
                                "sense_id": "ecf01472-ffce-36be-9cb8-0fbe2b64607b",
                                "text": "De goudprijs is door al die beursturbulenties flink gestegen. Goud wordt vaak gezien als een veilige haven en wordt nu ruim boven de 1220 dollar voor een ounce (31,1 gram) verhandeld."
                            }
