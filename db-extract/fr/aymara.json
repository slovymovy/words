                        "glosses": [
                            "Relatif aux Aymaras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af84b07-caf1-4b03-bc66-d1e542c0a095",
                                "sense_id": "d39c5208-cf16-392b-8bae-2d4baca95487",
                                "text": "La langue aymara."
                            },
                            {
                                "example_id": "513a8690-5a13-434d-adaf-b132abc3602a",
                                "sense_id": "d39c5208-cf16-392b-8bae-2d4baca95487",
                                "text": "Une légende aymara − la plus belle des légendes, − veut que le Créateur ait peuplé le monde de statues et les ait animées pour le civiliser. Est-ce vraiment une légende ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f69eb8c-debe-418d-b2d6-7d5ebad695b2",
