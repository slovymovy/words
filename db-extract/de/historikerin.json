                "senses": [
                    {
                        "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                        "entry_id": "16aeedd9-aa19-34b9-8f19-b0007dcb6de3",
                        "glosses": [
                            "Wissenschaftlerin, die sich mit der Erforschung und Darstellung der Geschichte beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3702486-ad27-4c72-a2e0-dd7077a84ab9",
                                "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                "text": "Zur Beurteilung des Wertes der Fundgegenstände wurde eine Historikerin hinzugezogen."
                            },
                            {
                                "example_id": "9933b7f8-b211-4849-9603-c9ee046553e8",
                                "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                "text": "„Mehr als 200 Porträts solcher »Hofmohren« hat ein Forscherteam um die Bremer Historikerin Rebekka von Mallinckrodt für ein Projekt zu Sklaven im Heiligen Römischen Reich in Archiven entdeckt.“"
                            },
                            {
                                "example_id": "7e09fab9-3d85-4e04-bde3-d1e208e2643e",
                                "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                "text": "„Die pakistanische Historikerin Ayesha Jalal verwies zutreffend darauf, dass Pakistan zwar für eine Minderheit (die Muslime Südasiens) Britisch-Indiens geschaffen wurde, seinen eigenen religiösen Minderheiten jedoch keinen Schutz vor Verfolgung gewährt.“"
                            },
                            {
                                "example_id": "db5cb8cf-fd69-48e7-8f45-425fc38adaab",
                                "sense_id": "fcac3496-c884-386f-a943-7c18afbe7245",
                                "text": "„Im Januar 1932 wählte die Abteilung Heinrich Mann, den Großschriftsteller der bürgerlichen Linken, zum Vorsitzenden und die geschätzte Dichterin, Historikerin und Philosophin Ricarda Huch zu seiner Stellvertreterin, obgleich sie mit ihm inhaltlich und persönlich wenig gemein hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
