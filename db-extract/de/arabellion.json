                ],
                "senses": [
                    {
                        "sense_id": "205d0d7f-fc77-345e-bd69-5f7ab258fd33",
                        "entry_id": "697007da-ee54-3d23-8807-5dce754ddfc6",
                        "glosses": [
                            "eine Serie von Aufständen in der arabischen Welt, die im Jahre 2010 begann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80d4083-93de-4047-915b-339f69581942",
                                "sense_id": "205d0d7f-fc77-345e-bd69-5f7ab258fd33",
                                "text": "„Unpolitische Jugend? Von wegen! In diesem Jahr bewegte der Protest der Jungen die Welt. In Nordafrika brachten sie die Arabellion in Gang.“"
                            },
                            {
                                "example_id": "a5954488-7be2-4237-b20f-c7fecb25e64a",
                                "sense_id": "205d0d7f-fc77-345e-bd69-5f7ab258fd33",
                                "text": "„Auch unsere Wahrnehmung der sogenannten Arabellion folgte einem ähnlichen Muster aus naiver Euphorie und Enttäuschung: blindes Vertrauen ins Zivilisierende des Mehrheitsprinzips (das man sich wohl als Herrschaft weltzugewandter Facebook-Nutzer und Twitterer geträumt hatte) und Katzenjammer nach den Wahlsiegen der Islamisten.“"
                            },
                            {
                                "example_id": "dfecc63f-e7d2-4eff-8957-7f172457a725",
                                "sense_id": "205d0d7f-fc77-345e-bd69-5f7ab258fd33",
                                "text": "„Die Arabellion geriete zu einer möglicherweise bewaffneten Auseinandersetzung zwischen einem sunnitischen und einem schiitischen Block, Falken und Hardliner auf beiden Seiten setzten sich durch, das Feindbild Schiiten ließe den Einfluss fundamentalistischer Sunniten über die Gesellschaften noch wachsen.“"
                            },
                            {
                                "example_id": "41bd3263-0020-407c-b22e-b8e4dace0a77",
                                "sense_id": "205d0d7f-fc77-345e-bd69-5f7ab258fd33",
                                "text": "„Auch ein Husni Mubarak galt als Präsident für die Ewigkeit, bevor ihn die Arabellion wegfegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
