                                        "sense_id": "f1a5a725-d332-34e3-9357-cdef47a9204f",
                                        "entry_id": "54938267-df22-30a2-8cef-e042e6cc5561",
                                        "glosses": [
                                            "Tat, die juristisch mit Strafe belegt ist, ungesetzliche Handlung, gesetzwidrige Handlung, kriminelle Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72993c22-0c23-439e-9957-828c3bda3c1d",
                                                "sense_id": "f1a5a725-d332-34e3-9357-cdef47a9204f",
                                                "text": "Diebstahl ist eine Straftat."
                                            },
                                            {
                                                "example_id": "f4cf95dd-cca7-455a-af03-3e8e6507f47d",
                                                "sense_id": "f1a5a725-d332-34e3-9357-cdef47a9204f",
                                                "text": "Die Staatsanwaltschaft legte mir eine Straftat zur Last."
                                            },
                                            {
                                                "example_id": "31e995ae-6d77-4c12-9580-9efd3e1d86c5",
                                                "sense_id": "f1a5a725-d332-34e3-9357-cdef47a9204f",
                                                "text": "Die beiden Räuber begingen bereits mehrere Straftaten."
                                            },
                                            {
                                                "example_id": "413c612c-548d-47ec-8f41-91148a051d35",
                                                "sense_id": "f1a5a725-d332-34e3-9357-cdef47a9204f",
                                                "text": "Die Strafe bemisst sich an der Schwere der Straftaten."
                                            },
                                            {
                                                "example_id": "34442960-76cd-457c-8390-ad7036c6be74",
                                                "sense_id": "f1a5a725-d332-34e3-9357-cdef47a9204f",
                                                "text": "„Er spricht davon, wie eine Straftat einen Menschen verändert.“"
                                            },
                                            {
                                                "example_id": "ef888fe0-d154-45f0-8aa5-c522c227d9f1",
                                                "sense_id": "f1a5a725-d332-34e3-9357-cdef47a9204f",
                                                "text": "„So gesehen sind Straftaten dieser Art eine etwas exzentrischere Form von Unternehmertum und damit eine bewusste und freie Entscheidung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
