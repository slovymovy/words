        "fr-extract.jsonl": [
            {
                "entry_id": "74c6f34f-8d57-3887-95bf-cba88880cc9e",
                "word": "imprévisiblement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d374e750-4754-30d4-bfb2-c4acc8cfea24",
                        "entry_id": "74c6f34f-8d57-3887-95bf-cba88880cc9e",
                        "glosses": [
                            "De façon imprévisible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbafb3ec-fcdc-4042-b276-5415003a2a7c",
                                "sense_id": "d374e750-4754-30d4-bfb2-c4acc8cfea24",
                                "text": "La mort est le prévisible qui arrive imprévisiblement."
                            },
                            {
                                "example_id": "cf4ca692-03b3-4d3c-8591-29bba6bc92fe",
                                "sense_id": "d374e750-4754-30d4-bfb2-c4acc8cfea24",
                                "text": "Chaque fois, selon les temps, Dieu a besoin d’avoir à son service un homme tantôt imprévisiblement élevé et tantôt imprévisiblement humilié."
                            },
                            {
                                "example_id": "9d920134-a22e-4b7f-8683-085080d56756",
                                "sense_id": "d374e750-4754-30d4-bfb2-c4acc8cfea24",
                                "text": "Mais, autant Heidegger, comme Kierkegaard, et toute la pensée de l’existence, dégage bien la liberté vraie qui choisit imprévisiblement, par rupture, autant il ne peut, pas plus que le reste de la pensée de l’existence, poser cette liberté dans un savoir, et donc justifier ce choix comme essentiel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c046cff4-9319-42a7-87cd-649e281a05ab",
                        "source_entry_id": "74c6f34f-8d57-3887-95bf-cba88880cc9e",
                        "source_sense_id": "d374e750-4754-30d4-bfb2-c4acc8cfea24",
                        "target_lang_word": "unvorhersehbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
