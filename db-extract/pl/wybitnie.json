                        "examples": [
                            {
                                "example_id": "f1620cbf-b130-4af4-aaf8-9238d486de79",
                                "sense_id": "e5c87278-4454-3579-88ac-a7093907a306",
                                "text": "Wpół do piątej… Postawiła wodę na herbatę i poszła do łazienki. W lustrze pokazała sobie język. Była z siebie wybitnie, ale to wybitnie niezadowolona"
                            }
