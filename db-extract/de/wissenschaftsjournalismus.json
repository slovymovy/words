                "senses": [
                    {
                        "sense_id": "e88e4998-ef58-3c5c-8439-e6a542c0c2d7",
                        "entry_id": "fc7f537e-62a6-3ff0-b201-4926df61fc0b",
                        "glosses": [
                            "journalistische Beschäftigung mit Forschung; Bericht und Aufarbeitung wissenschaftlicher Themen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb551cc-a205-4ef8-82d6-1a9811084f19",
                                "sense_id": "e88e4998-ef58-3c5c-8439-e6a542c0c2d7",
                                "text": "„Weil die Aussagen der Wissenschaft zum Thema GMO stärker als je zuvor von den Interessen der Industrie geprägt sind, schlägt dies bis auf den Wissenschaftsjournalismus durch.“"
                            },
                            {
                                "example_id": "5bdcc8d2-e3a1-4584-9b46-8357b3c2d5ec",
                                "sense_id": "e88e4998-ef58-3c5c-8439-e6a542c0c2d7",
                                "text": "„Mit der Angst vor saurem Regen, mit Tschernobyl und Aids-Hysterie waren die 1980er das Jahrzehnt, in dem die Bedeutung von Wissenschaftsjournalismus augenfällig wurde.“"
                            },
                            {
                                "example_id": "e7a6c4b1-8cc5-46d2-9d38-0b94a8fd0043",
                                "sense_id": "e88e4998-ef58-3c5c-8439-e6a542c0c2d7",
                                "text": "„Solange die meisten Wissenschaftler es nicht verstehen (oder auch gar nicht erst wollen), was sie wissen oder erforscht haben in allgemeinverständlicher und interessanter, das heißt allgemeines Interesse findender Form für ein weiteres Publikum darzustellen, bedarf es in der Tat einer Zwischenschaltung des sogenannten Wissenschaftsjournalismus, der genau das tut, was die Wissenschaft selbst versäumt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
