                ],
                "senses": [
                    {
                        "sense_id": "f2611c47-4792-32b8-8524-d05fc396bb57",
                        "entry_id": "3f4811f5-bad7-3d47-a918-c56eb8aee4e8",
                        "glosses": [
                            "Gesamtheit breit angelegter, koordinierter und vorbeugender Maßnahmen, um Leben, Gesundheit von Bürgern oder die Umwelt in einem Katastrophenfall schützen zu können als Teil des Zivilschutzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "388b91f9-c972-4160-ace2-2985d4246a37",
                                "sense_id": "f2611c47-4792-32b8-8524-d05fc396bb57",
                                "text": "„Es besteht daher bereits jetzt eine enge Zusammenarbeit von Bund und Ländern in der Art, dass der friedensmäßige Katastrophenschutz auch im Verteidigungsfall Aufgaben zum Schutz der Bevölkerung wahrnimmt.“"
                            },
                            {
                                "example_id": "f95b9917-3dab-45fd-b521-f46b3f87fef1",
                                "sense_id": "f2611c47-4792-32b8-8524-d05fc396bb57",
                                "text": "Der Bund und das Technische Hilfswerk unterhalten Einheiten des Katastrophenschutzes."
                            },
                            {
                                "example_id": "e0e33e2b-4af6-40da-8703-8b5f46c00f34",
                                "sense_id": "f2611c47-4792-32b8-8524-d05fc396bb57",
                                "text": "„Doch die Brände, so der Chef des indonesischen Katastrophenschutzes, seien vor allem ein »Verbrechen gegen die Menschheit«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
