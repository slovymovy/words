                        "entry_id": "a4de7753-9889-3ae3-af95-f456f668104b",
                        "glosses": [
                            "Brettspiel für 2 bis 4 Personen, mit je 13 oder 19 Figuren, die man so schnell wie möglich auf die andere Spielfeldseite bringen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "339484d9-e183-423c-a35f-bd5eddb7e713",
                                "sense_id": "7affcd8e-90bd-3807-9a4e-7da98d8f0342",
                                "text": "„Bei den meisten Brettspielen werden die Figuren gegen feindliche Steine gerückt, um diese zu schlagen (Mühle, Dame, Schach, Belagerung) oder um bestimmte Stellungen zu beziehen (Halma, Einsiedlerspiel).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
