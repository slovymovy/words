                        "examples": [
                            {
                                "example_id": "21e345ff-8d63-4eb7-8893-547919a62739",
                                "sense_id": "72457737-8a9e-396a-972e-3117d970cb3f",
                                "text": "It drummed tackily to gather my attention, coughed, spat, cleared its throat, and, on the eve of that portentous communication, retired up stage as a multitude whispering."
                            },
                            {
                                "example_id": "266cbace-2804-44bd-a11e-29484a3ded44",
                                "sense_id": "72457737-8a9e-396a-972e-3117d970cb3f",
                                "text": "They lived comfortably if tackily in big, plain houses, and were too much like us in town to interest me."
                            },
                            {
                                "example_id": "acd696ac-d7c3-4332-bcd2-f5c890e64104",
                                "sense_id": "72457737-8a9e-396a-972e-3117d970cb3f",
                                "text": "Ceviche is inoffensive but not great, tackily served in a carved-out pineapple, and even more tackily served with those same smoky crab claws."
                            }
                        ]
                    }
