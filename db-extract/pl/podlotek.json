                    },
                    {
                        "translation_id": "24ffe3a3-a60e-43c0-9614-cca82947bf6b",
                        "source_entry_id": "1af0b9e2-4bad-3998-b183-ff5267c9a804",
                        "source_sense_id": "9901edad-d9ce-3a0b-8955-1a15ec50a573",
                        "target_lang_word": "Backfisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Backfisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                        "entry_id": "5ebec1aa-8f7b-3ec3-99e9-2bfc84eff49b",
                                        "glosses": [
                                            "ein gebackener oder paniert gebratener Fisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a3d3f07-533f-4bab-adce-8ab07aad88cc",
                                                "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                                "text": "Nimm doch bitte den Backfisch aus dem Ofen."
                                            },
                                            {
                                                "example_id": "d767ea5f-ac19-467e-be72-6a2d9b5cd987",
                                                "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                                "text": "„‚Jetzt haben wir dich ertappt‘, sagte ein Bursche, dem die Nase von einem Faustschlag schraeg stand, aber, so sah es aus, nur momentan, sie musste gleich wieder richtig rucken, ‚du kaufst ja deine Backfische auf dem Markt.‘“"
                                            },
                                            {
                                                "example_id": "97b333e8-843a-4d3e-8635-97ff1e6d0978",
                                                "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                                "text": "„Heute gibt es Backfisch auf Weizenfladen.“"
                                            },
                                            {
                                                "example_id": "348fbea6-a6b4-4ba9-bdad-7e8ff4e5ebb3",
                                                "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                                "text": "„Die Straßen Londons waren überlaufen von Kindern, die Orangen verkauften, und Jungen, die Backfisch klauten, und Frauen ohne Geld, die auf öffentlichen Plätzen schliefen, und Männern mit Geld, die vor geschlossenen Kneipen warteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                        "entry_id": "5ebec1aa-8f7b-3ec3-99e9-2bfc84eff49b",
                                        "glosses": [
                                            "heranwachsendes (mitunter launisches) Mädchen etwa im Alter zwischen 13 und 17 Jahren"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a794e2f0-6b04-4dc4-b8d0-e461d8363463",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "Alle seine Freundinnen waren ohne Ausnahme Backfische."
                                            },
                                            {
                                                "example_id": "24acf5ad-50b4-4b0d-9180-5e6a40558f26",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Und ich in Beſitz des ſtrittigen Stuͤcks [Land], und druͤber den huͤbſch[es]ten Backfiſch im ganzen Dorf.“"
                                            },
                                            {
                                                "example_id": "59270301-2b3a-4091-9a4a-f8585dd00803",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Zum Glück kam ſein Unmut zu keinem Ausbruch, denn von dem, was ſeine Frau vermiſſen ließ, hatten ſeine Töchter deſto mehr, bildhübſche Backfiſche von vierzehn und dreizehn, die ganz nach dem Vater ſchlugen.“"
                                            },
                                            {
                                                "example_id": "99410928-92f3-4dcc-9e1f-215a65379b05",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Aber unser Aufenthalt erfuhr eine jähe Unterbrechung, veranlaßt durch einen Besuch in einem Mädchenpensionat, wo meine jüngste Schwester Mathilde als 17-jähriger Backfisch zur jungen Dame erzogen wurde.“"
                                            },
                                            {
                                                "example_id": "758bd407-d21a-4d38-a4e3-bc0a73debde3",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Sie war noch auf, als ich ankam, und ausgelassen lustig konnte sie sein, so dalberig, recht wie ein Backfisch.“"
                                            },
                                            {
                                                "example_id": "98fc58d1-c36f-4e40-9c52-b26b27c21349",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Ich suchte einen Backfisch auf, der mir einmal zu einer Liebesgabe einen naiven Brief an Unbekannt geschrieben hatte, was damals zu einer lustigen längeren Korrespondenz führte.“"
                                            },
                                            {
                                                "example_id": "0e4a73bb-a719-4e15-ae17-a686946a96bf",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Als Käthe, eine Lampe in der Hand, die Straße überquerte, fragte sie sich, warum sie und die beiden Thelen-Töchter sich auf dem Speicher wie Backfische benommen hatten, obwohl sie doch alle drei längst und in jeder Beziehung aus dem Backfischalter heraus waren.“"
                                            },
                                            {
                                                "example_id": "de89bf35-1c42-4724-bade-a9f506cc6d54",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Vor wenigen Jahren verschied nach längerem seelischen Leiden sanft der Backfisch, und es begann der Einmarsch der Teenager.“"
                                            },
                                            {
                                                "example_id": "ebded8b3-9af0-42dc-b42a-242b659ae7dd",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Andrew ist so unpraktisch und versponnen wie ein Backfisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
