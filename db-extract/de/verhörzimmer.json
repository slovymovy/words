                        "examples": [
                            {
                                "example_id": "53b11b17-ea3d-4975-a470-928afca39134",
                                "sense_id": "a68aed43-1a6b-3afc-acd0-09aad5a02b00",
                                "text": "„Er ließ Ferris allein und ging in das Verhörzimmer, wo er einen der beiden Stühle etwa zehn Meter von dem anderen entfernt mit der Lehne an die Wand stellte.“"
                            },
                            {
                                "example_id": "4b0a6f84-fdba-4be0-b94b-49013c396fed",
                                "sense_id": "a68aed43-1a6b-3afc-acd0-09aad5a02b00",
                                "text": "„Auf dem Revier mache ich erneut Bekanntschaft mit dem Verhörzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
