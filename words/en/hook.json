{
    "word_family": [
        "hooked",
        "hooker",
        "unhook",
        "fishhook",
        "hookup",
        "billhook",
        "boathook"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c081572d-d723-3b29-a692-47f41b961f94",
                    "sense_definition": "A curved piece of metal, plastic, or other material used for catching, holding, or pulling something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please hang your coat on the <w>hook</w> behind the door.",
                            "target_lang_translations": {
                                "zh": "请把外套挂在门后的<w>挂钩</w>上。"
                            }
                        },
                        {
                            "text": "He used a long metal <w>hook</w> to pull the box closer.",
                            "target_lang_translations": {
                                "zh": "他用一个长长的金属<w>钩子</w>把箱子拉近了些。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "coat hook",
                        "metal hook",
                        "wall hook"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种弯曲的金属、塑料或其他材料制成的物件，用来钩住、挂住或拉动某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钩子",
                                "target_lang_sense_clarification": "一般指弯曲的挂物或拉物工具"
                            },
                            {
                                "target_lang_word": "挂钩",
                                "target_lang_sense_clarification": "尤指固定在墙上或门后的挂物件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aac9eb33-3d32-3547-ad0e-bf9554467c42",
                    "sense_definition": "A curved piece of wire with a sharp point and a barb, used for catching fish.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman put a worm on the <w>hook</w> before casting his line.",
                            "target_lang_translations": {
                                "zh": "渔夫甩线前先把一条虫子挂在<w>鱼钩</w>上。"
                            }
                        },
                        {
                            "text": "Be careful not to hurt your finger on the sharp fish <w>hook</w>.",
                            "target_lang_translations": {
                                "zh": "小心别被锋利的<w>鱼钩</w>弄伤手指。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fish hook",
                        "bait the hook",
                        "hook and line"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种弯曲的金属丝制成、带尖头和倒刺的器具，用来钓鱼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鱼钩",
                                "target_lang_sense_clarification": "钓鱼用的带倒刺尖钩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd58bd45-79a5-3f39-98ad-f6db95670af6",
                    "sense_definition": "A short, swinging punch delivered with the arm bent, used in boxing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer knocked his opponent down with a powerful left <w>hook</w>.",
                            "target_lang_translations": {
                                "zh": "那名拳击手用一记有力的左<w>勾拳</w>把对手击倒了。"
                            }
                        },
                        {
                            "text": "He practiced his jab and <w>hook</w> at the gym every day.",
                            "target_lang_translations": {
                                "zh": "他每天都在健身房练习刺拳和<w>勾拳</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "left hook",
                        "right hook"
                    ],
                    "target_lang_definitions": {
                        "zh": "拳击中手臂弯曲、短促挥出的摆拳。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "勾拳",
                                "target_lang_sense_clarification": "拳击中手臂弯曲挥出的摆拳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f27894d-31db-3cc4-99e9-56b47e313364",
                    "sense_definition": "A catchy musical phrase or melody that makes a song easy to remember and appealing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_appeal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The song became a hit because of its incredibly catchy <w>hook</w>.",
                            "target_lang_translations": {
                                "zh": "这首歌因为它极其抓耳的<w>记忆点</w>而走红。"
                            }
                        },
                        {
                            "text": "Pop music producers often focus on creating a strong <w>hook</w> for the chorus.",
                            "target_lang_translations": {
                                "zh": "流行音乐制作人常常会着重为副歌打造一个强烈的<w>记忆点</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "catchy hook",
                        "melodic hook"
                    ],
                    "target_lang_definitions": {
                        "zh": "歌曲中朗朗上口、容易让人记住并产生吸引力的一小段旋律或乐句。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "记忆点",
                                "target_lang_sense_clarification": "歌曲中最抓耳、最容易记住的部分"
                            },
                            {
                                "target_lang_word": "吸引人的乐句",
                                "target_lang_sense_clarification": "音乐中吸引人的一小段旋律或乐句"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "305ea797-2a54-3ed6-a39c-119cdfd19c3f",
                    "sense_definition": "An interesting idea or event in a story or speech designed to attract people's attention.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_appeal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The first chapter needs a good <w>hook</w> to keep the reader interested.",
                            "target_lang_translations": {
                                "zh": "第一章需要一个好的<w>引子</w>来抓住读者的兴趣。"
                            }
                        },
                        {
                            "text": "The marketing campaign lacked a real <w>hook</w> to draw in customers.",
                            "target_lang_translations": {
                                "zh": "这次营销活动缺少真正能吸引顾客的<w>卖点</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "narrative hook",
                        "marketing hook"
                    ],
                    "target_lang_definitions": {
                        "zh": "故事或演讲中为了吸引别人注意而设计的有趣点子、情节或事件。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "引子",
                                "target_lang_sense_clarification": "故事开头或讲话中的吸引人设置"
                            },
                            {
                                "target_lang_word": "卖点",
                                "target_lang_sense_clarification": "营销或宣传中真正吸引人的点"
                            },
                            {
                                "target_lang_word": "噱头",
                                "target_lang_sense_clarification": "泛指吸引注意力的巧妙点子或设计"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5543b5c5-dde0-35c8-b2c5-a891f6000628",
                    "sense_definition": "A prostitute.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested a <w>hook</w> working on the street corner.",
                            "target_lang_translations": {
                                "zh": "警方逮捕了一名在街角拉客的<w>妓女</w>。"
                            }
                        },
                        {
                            "text": "He used a derogatory slang term, calling her a <w>hook</w>.",
                            "target_lang_translations": {
                                "zh": "他用了一个带侮辱性的俚语，骂她是<w>妓女</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hooker"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "俚语，带贬义，指妓女。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "妓女",
                                "target_lang_sense_clarification": "俚语，贬义，指从事卖淫的女性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f7ab4fc-6886-3afd-bdf2-81395bc17529",
                    "sense_definition": "To fasten, connect, or hang something using a hook or similar object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_connect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you help me <w>hook</w> the trailer to the back of the truck?",
                            "target_lang_translations": {
                                "zh": "你能帮我把拖车<w>挂上</w>卡车后面吗？"
                            }
                        },
                        {
                            "text": "She managed to <w>hook</w> the strap onto the buckle.",
                            "target_lang_translations": {
                                "zh": "她设法把带子<w>钩在</w>搭扣上了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hook up",
                        "hook onto"
                    ],
                    "target_lang_definitions": {
                        "zh": "用钩子或类似物把某物固定、连接或挂起来。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挂上",
                                "target_lang_sense_clarification": "用钩子或类似东西连上、挂上"
                            },
                            {
                                "target_lang_word": "钩在",
                                "target_lang_sense_clarification": "使某物钩住另一物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b82f990-536b-38eb-841b-89ab88fe9cfc",
                    "sense_definition": "To catch or ensnare something, especially a fish, with a hook.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_catch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was lucky enough to <w>hook</w> a large salmon on my first cast.",
                            "target_lang_translations": {
                                "zh": "我运气真好，第一次抛线就<w>钓到</w>了一条大鲑鱼。"
                            }
                        },
                        {
                            "text": "He tried to <w>hook</w> the floating branch with a stick.",
                            "target_lang_translations": {
                                "zh": "他试着用一根棍子<w>钩住</w>那根漂浮的树枝。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hook a fish"
                    ],
                    "target_lang_definitions": {
                        "zh": "用钩子钩住或捕获某物，尤其指鱼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钓到",
                                "target_lang_sense_clarification": "用钩子钓住，尤指鱼"
                            },
                            {
                                "target_lang_word": "钩住",
                                "target_lang_sense_clarification": "用钩状物勾住并拉住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8c76eaa-96d3-3740-b642-3d69f396f73c",
                    "sense_definition": "To cause someone to become addicted to or extremely interested in something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_captivate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new TV series will <w>hook</w> you from the very first episode.",
                            "target_lang_translations": {
                                "zh": "这部新剧从第一集开始就会把你<w>迷住</w>。"
                            }
                        },
                        {
                            "text": "Companies use free trials to <w>hook</w> customers on their products.",
                            "target_lang_translations": {
                                "zh": "公司利用免费试用来<w>让</w>顾客对其产品<w>上瘾</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get hooked",
                        "hooked on"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人对某事物上瘾，或对其产生强烈兴趣。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "迷住",
                                "target_lang_sense_clarification": "使人非常着迷或立刻被吸引"
                            },
                            {
                                "target_lang_word": "让……上瘾",
                                "target_lang_sense_clarification": "使人对某物产生依赖或上瘾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3321a87-93ff-32cb-8d04-06a595290e45",
                    "sense_definition": "To move or go with a sudden turn or curve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road <w>hooks</w> sharply to the left just after the bridge.",
                            "target_lang_translations": {
                                "zh": "这条路一过桥就突然向左<w>急转</w>。"
                            }
                        },
                        {
                            "text": "He watched the ball <w>hook</w> around the post and go into the net.",
                            "target_lang_translations": {
                                "zh": "他看着球绕过门柱<w>画弧线</w>飞入球网。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hook left",
                        "hook right"
                    ],
                    "target_lang_definitions": {
                        "zh": "突然转向，或沿着弯曲的路线移动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "急转",
                                "target_lang_sense_clarification": "突然转弯"
                            },
                            {
                                "target_lang_word": "画弧线",
                                "target_lang_sense_clarification": "沿弯曲路线移动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8981cc37-ec20-3d05-81b1-8e13d3649cf3",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "proper_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Captain <w>Hook</w> is the famous villain in the story of Peter Pan.",
                            "target_lang_translations": {
                                "zh": "<w>虎克</w>船长是《彼得·潘》故事里著名的反派。"
                            }
                        },
                        {
                            "text": "Mr. <w>Hook</w> has been working at the company for ten years.",
                            "target_lang_translations": {
                                "zh": "<w>胡克</w>先生已经在这家公司工作十年了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胡克",
                                "target_lang_sense_clarification": "英语姓氏"
                            },
                            {
                                "target_lang_word": "虎克",
                                "target_lang_sense_clarification": "《彼得·潘》中人物名常译作此"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e79772d7-e2f5-38c9-8a80-5646118cee33",
                    "sense_definition": "A place name used for various locations in the United Kingdom.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proper_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Hook</w> during their trip to England.",
                            "target_lang_translations": {
                                "zh": "他们在英格兰旅行时造访了名叫<w>胡克</w>的小村庄。"
                            }
                        },
                        {
                            "text": "The train stops at <w>Hook</w> station on its way to London.",
                            "target_lang_translations": {
                                "zh": "这趟火车开往伦敦途中会停靠<w>胡克</w>站。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "英国多个地点使用的地名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胡克",
                                "target_lang_sense_clarification": "英国一些地名的常见音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}