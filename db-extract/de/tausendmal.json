                        "source_sense_id": "2f997518-62c9-3ed5-bfd0-c6dc5c151dde",
                        "source_sense_description": "bestimmtes Wiederholungszahlwort (Angabe, wie oft etwas wiederkehrt): tausend Male",
                        "target_lang_word": "mille fois",
                        "target_lang_code": "fr",
