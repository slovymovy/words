{
    "word_family": [
        "artificial",
        "artificer",
        "artificially"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c870b329-1ee1-3215-b6d8-d119be5c60a4",
                    "sense_definition": "A clever or cunning trick used to deceive someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician used every <w>artifice</w> to hide the truth from the public.",
                            "target_lang_translations": {
                                "ru": "Политик использовал любую <w>уловку</w>, чтобы скрыть правду от общественности."
                            }
                        },
                        {
                            "text": "Her smile was merely an <w>artifice</w> to mask her deep disappointment.",
                            "target_lang_translations": {
                                "ru": "Ее улыбка была лишь <w>хитростью</w>, чтобы скрыть глубокое разочарование."
                            }
                        }
                    ],
                    "synonyms": [
                        "deception",
                        "trickery",
                        "guile"
                    ],
                    "antonyms": [
                        "honesty",
                        "sincerity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хитрая уловка или обман, используемые для введения кого-либо в заблуждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый прием или маневр"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "способность обманывать или действовать коварно"
                            },
                            {
                                "target_lang_word": "ухищрение",
                                "target_lang_sense_clarification": "сложный, искусный прием для достижения цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44def4e3-a2e5-3477-a393-5a49752dc67b",
                    "sense_definition": "A complex object or device created with technical skill.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clockwork bird was a mechanical <w>artifice</w> of incredible complexity.",
                            "target_lang_translations": {
                                "ru": "Заводная птица была <w>механическим устройством</w> невероятной сложности."
                            }
                        },
                        {
                            "text": "Ancient builders created an <w>artifice</w> of stone to channel water into the city.",
                            "target_lang_translations": {
                                "ru": "Древние строители создали <w>каменное сооружение</w> для подачи воды в город."
                            }
                        }
                    ],
                    "synonyms": [
                        "contrivance",
                        "device"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложный предмет или устройство, созданное с применением технических навыков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "механизм",
                                "target_lang_sense_clarification": "сложное устройство или аппарат"
                            },
                            {
                                "target_lang_word": "искусное изделие",
                                "target_lang_sense_clarification": "предмет, созданный с большим мастерством"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6a0ed2b-6d33-3a5f-9004-6b9778ae6f0d",
                    "sense_definition": "To create or construct something using specialized skill.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master craftsman <w>artificed</w> a beautiful frame for the painting.",
                            "target_lang_translations": {
                                "ru": "Мастер <w>смастерил</w> красивую раму для картины."
                            }
                        },
                        {
                            "text": "They <w>artificed</w> a temporary shelter using only branches and leaves.",
                            "target_lang_translations": {
                                "ru": "Они <w>соорудили</w> временное укрытие, используя только ветки и листья."
                            }
                        }
                    ],
                    "synonyms": [
                        "construct",
                        "fashion",
                        "craft"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This verb is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать или конструировать что-либо, используя специальные навыки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастерить",
                                "target_lang_sense_clarification": "изготавливать что-либо своими руками"
                            },
                            {
                                "target_lang_word": "сооружать",
                                "target_lang_sense_clarification": "строить или создавать что-то сложное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}