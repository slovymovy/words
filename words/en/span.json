                                "target_lang_sense_clarification": "从一边延伸到另一边"
                            },
                            {
                                "target_lang_word": "遍及",
                                "target_lang_sense_clarification": "范围覆盖很广时用"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "overspannen",
                                "target_lang_sense_clarification": "een afstand of rivier overbruggen"
                            },
                            {
                                "target_lang_word": "overbruggen",
                                "target_lang_sense_clarification": "een opening of afstand verbinden"
                            },
                            {
                                "target_lang_word": "omspannen",
                                "target_lang_sense_clarification": "zich uitstrekken over een gebied"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0cf531f-e579-33a0-9d1e-f676e92cd461",
                    "sense_definition": "To last or continue for a particular period of time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history of this ancient civilization <w>spans</w> three thousand years.",
                            "target_lang_translations": {
                                "ru": "История этой древней цивилизации <w>насчитывает</w> три тысячи лет.",
                                "zh": "这个古代文明的历史<w>长达</w>三千年。",
                                "nl": "De geschiedenis van deze oude beschaving <w>bestrijkt</w> drieduizend jaar."
                            }
                        },
                        {
                            "text": "Their professional partnership has <w>spanned</w> decades of innovation.",
                            "target_lang_translations": {
                                "ru": "Их профессиональное партнерство <w>охватывало</w> десятилетия инноваций.",
                                "zh": "他们的职业合作<w>持续</w>了数十年的创新历程。",
                                "nl": "Hun professionele partnerschap heeft decennia van innovatie <w>omspannen</w>."
                            }
