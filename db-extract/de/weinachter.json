                "senses": [
                    {
                        "sense_id": "946ea76c-de2a-365f-aa3d-8bb2159716cd",
                        "entry_id": "15da1d58-f748-3dbf-ba85-afcd575785de",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1bf0b7-8022-429e-bfde-ff38ae07e749",
                                "sense_id": "946ea76c-de2a-365f-aa3d-8bb2159716cd",
                                "text": "Frau Weinachter ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1e01679f-9991-4da0-86ad-ff3071d8519d",
                                "sense_id": "946ea76c-de2a-365f-aa3d-8bb2159716cd",
                                "text": "Herr Weinachter wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9861c092-ed4f-4eb4-ac3c-a91e8b3f5f65",
                                "sense_id": "946ea76c-de2a-365f-aa3d-8bb2159716cd",
                                "text": "Die Weinachters fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2312b533-fa9b-4aeb-8bc6-4b8811dcbb78",
                                "sense_id": "946ea76c-de2a-365f-aa3d-8bb2159716cd",
                                "text": "Der Weinachter trägt nie die Schals, die die Weinachter ihm strickt."
                            },
                            {
                                "example_id": "0e17d497-c1ea-4ce4-abba-4425125f705a",
                                "sense_id": "946ea76c-de2a-365f-aa3d-8bb2159716cd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weinachter kommt, geht der Herr Weinachter.“"
                            },
                            {
                                "example_id": "c861ea84-b5ba-436d-b176-781bb9e85b4c",
                                "sense_id": "946ea76c-de2a-365f-aa3d-8bb2159716cd",
                                "text": "Weinachter kommt und geht."
                            },
                            {
                                "example_id": "6bd2163d-494f-4205-91e6-552893c336d4",
                                "sense_id": "946ea76c-de2a-365f-aa3d-8bb2159716cd",
                                "text": "Weinachters kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
