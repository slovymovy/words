                    {
                        "translation_id": "1579cb84-d13e-4978-b2c6-dd0b48064571",
                        "source_entry_id": "6ea5037b-91f9-34a6-97ef-8d41d57e16e1",
                        "source_sense_id": "60e31c82-0d80-38df-94f9-3786ec37b1d3",
                        "target_lang_word": "Hexenschuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hexenschuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                        "entry_id": "738b0db5-63a6-33de-a381-648ba554c4a8",
                                        "glosses": [
                                            "plötzlich auftretender Schmerz im Bereich des unteren Rückens, der Lendenwirbel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ccb77a-f5b0-4e92-93d1-f3f720da432c",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "Sein Hexenschuss hinderte ihn daran, zum Volleyballtraining zu gehen."
                                            },
                                            {
                                                "example_id": "2d59fd96-296b-4238-a334-3aac8f20a9c4",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "Ein Hexenschuss kann äußerst schmerzhaft sein."
                                            },
                                            {
                                                "example_id": "bea439ab-adb5-4037-9166-f073dc46309d",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "Eine perfekte Sportart zur Stärkung der Rückenmuskulatur und Vorbeugung gegen den Hexenschuss ist Rudern."
                                            },
                                            {
                                                "example_id": "0a008e87-e795-43d9-910d-bcf02c879101",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "[Die Ärztin] setzt eine Spritze gegen den Hexenschuss."
                                            },
                                            {
                                                "example_id": "0123c7dc-6780-4f7b-aa54-e63470658fcd",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "Ein unachtsames Aufrichten und schon ist es passiert: Wer einmal von einem Hexenschuss heimgesucht wurde, will das so schnell nicht wieder erleben."
                                            },
                                            {
                                                "example_id": "e341299f-62a4-4fbb-95c8-0c4f5c0c1df3",
                                                "sense_id": "c9144d52-e5c7-3dff-b8ae-e9d0973dc838",
                                                "text": "„Hans Werner Kettenbach kennt die Klischees des Erzählens und erfüllt sie zuweilen auch augenzwinkernd: Ein in die Jahre gekommener Playboy, kann eines Tages auf dem Parkplatz vor seinem Tennisklub nicht mehr aus seinem Porsche Carrera aussteigen. Der Grund: ein Hexenschuss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
