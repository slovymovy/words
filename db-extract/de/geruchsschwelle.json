                "senses": [
                    {
                        "sense_id": "2a8b1b18-fb79-3013-b195-caa8f476c064",
                        "entry_id": "f01c6cd7-c11e-3597-8a0d-5c76433deb2c",
                        "glosses": [
                            "individueller Minimalwert der Geruchsempfindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b118afc7-59c2-46c3-9add-a4b59b7b6f95",
                                "sense_id": "2a8b1b18-fb79-3013-b195-caa8f476c064",
                                "text": "„Die Gegenüberstellung der Raumluftkonzentrationen mit den Geruchsschwellen zeigt, dass die Chloranisole mit einem Geruchswert von 25 im wesentlichen zur Geruchsbildung beitragen.“"
                            },
                            {
                                "example_id": "6663e858-567b-4535-9829-f1f0b5055a2c",
                                "sense_id": "2a8b1b18-fb79-3013-b195-caa8f476c064",
                                "text": "„Es wurden geruchsintensive Stoffe (d. h. solche mit niedriger Geruchsschwelle; vgl. Tabelle unten) mit deutlichen Konzentrationsunterschieden festgestellt.“"
                            },
                            {
                                "example_id": "d649130a-48ba-4e3a-88ce-80c3dd22b5f8",
                                "sense_id": "2a8b1b18-fb79-3013-b195-caa8f476c064",
                                "text": "„Die Angaben zur Geruchsschwelle reichen von 0,07 bis 7mg/m³ (0,016 – 1,6ppm) (Verschueren 1983).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
