                "senses": [
                    {
                        "sense_id": "c1f8c0f3-82a8-386d-8696-075dda85e754",
                        "entry_id": "eae24220-db59-3c8c-aae1-02733cccd6b5",
                        "glosses": [
                            "Personne qui s’occupe du paillage des chaises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94f9bbb7-4631-436f-a7ec-fee114e92ca4",
                                "sense_id": "c1f8c0f3-82a8-386d-8696-075dda85e754",
                                "text": "C’était surtout comme rempailleuse qu’elle était connue de la ville entière. On fait, dans le Midi, une grande consommation de chaises de paille, qui y sont d’un usage commun."
                            },
                            {
                                "example_id": "51226520-7eb9-49b1-a6fe-999962706dc6",
                                "sense_id": "c1f8c0f3-82a8-386d-8696-075dda85e754",
                                "text": "Quant à elle, la femme, vous l’avez connue aussi, c’est la vieille rempailleuse de chaises qui venait tous les ans au château."
                            },
                            {
                                "example_id": "19c1c297-0340-45c9-a03c-4608e7d86bcd",
                                "sense_id": "c1f8c0f3-82a8-386d-8696-075dda85e754",
                                "text": "J’ai beaucoup lu sur Péguy, ce fils de rempailleuse de chaises devenu Normalien, dreyfusard acharné, socialiste de sang et de flammes, polémiste frontal."
                            }
                        ]
                    }
                ],
