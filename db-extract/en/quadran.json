                ],
                "senses": [
                    {
                        "sense_id": "a8a26491-00fc-34b5-9ff7-b07c388e9423",
                        "entry_id": "64ed3680-3f8a-30bd-803a-ec40a238c9a6",
                        "glosses": [
                            "Alternative form of quadrans (“Roman coin”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "1244dbef-8ca7-4d5b-b524-c81f1c860049",
                                "sense_id": "a8a26491-00fc-34b5-9ff7-b07c388e9423",
                                "text": "Truly I say to you, You shall by no means come out from there until you pay the last quadrans."
                            },
                            {
                                "example_id": "8a12d283-3f85-42ba-87c3-3ceda9378971",
                                "sense_id": "a8a26491-00fc-34b5-9ff7-b07c388e9423",
                                "text": "He tells us that the widow gave “two small copper coins,” or a quadran, adding up to one penny. A quadran was about 1/64 of a denarius, which was a worker's daily wage."
                            },
                            {
                                "example_id": "8c007ea1-53c8-472c-b3e4-8f0537656210",
                                "sense_id": "a8a26491-00fc-34b5-9ff7-b07c388e9423",
                                "text": "A quadran's not enough, she was saying, I need two thousand sesterces."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
