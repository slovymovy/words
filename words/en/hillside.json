    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ec26ba3-ae96-32e2-9f63-5ef31d74fc90",
                    "sense_definition": "The sloping side of a hill.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house was built on a steep <w>hillside</w> overlooking the valley.",
                            "target_lang_translations": {
                                "tr": "Ev, vadiye bakan dik bir <w>yamaç</w> üzerine inşa edilmişti.",
                                "zh": "那座房子建在俯瞰山谷的陡峭<w>山坡</w>上。"
                            }
                        },
                        {
                            "text": "Wildflowers covered the sunny <w>hillside</w> during the spring.",
                            "target_lang_translations": {
                                "tr": "İlkbaharda güneşli <w>yamaç</w> kır çiçekleriyle kaplanmıştı.",
                                "zh": "春天里，向阳的<w>山坡</w>上开满了野花。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slope",
                        "incline"
                    ],
                    "common_phrases": [
                        "steep hillside",
                        "grassy hillside"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir tepenin eğimli yamacı.",
                        "zh": "小山或山丘倾斜的侧面；山坡。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yamaç",
                                "target_lang_sense_clarification": "Bir dağın veya tepenin eğimli yüzeyi."
                            },
                            {
                                "target_lang_word": "tepe yamacı",
                                "target_lang_sense_clarification": "Özellikle bir tepenin eğimli tarafını belirtmek için kullanılır."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "山坡",
                                "target_lang_sense_clarification": "山丘或小山的斜坡"
                            },
                            {
                                "target_lang_word": "山腰",
                                "target_lang_sense_clarification": "山坡的中部或侧面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b3dc52cd-24c6-3a6e-abd0-42e88e0da1c1",
                    "sense_definition": "A place name referring to various small settlements or neighborhoods in English-speaking countries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to move to a quiet village called <w>Hillside</w>.",
                            "target_lang_translations": {
                                "tr": "<w>Hillside</w> adında sessiz bir köye taşınmaya karar verdiler.",
                                "zh": "他们决定搬到一个名叫<w>希尔赛德</w>的宁静村庄。"
                            }
                        },
                        {
                            "text": "The local council in <w>Hillside</w> announced new road improvements.",
                            "target_lang_translations": {
                                "tr": "<w>Hillside</w>'daki yerel konsey yeni yol iyileştirmelerini duyurdu.",
                                "zh": "<w>希尔赛德</w>的地方委员会宣布了新的道路改善计划。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İngilizce konuşulan ülkelerdeki çeşitli küçük yerleşim yerleri veya mahalleler için kullanılan bir yer adı.",
                        "zh": "地名，指英语国家中的一些小村镇或社区（通常音译为“希尔赛德”）。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Hillside",
                                "target_lang_sense_clarification": "Özel isim olduğu için Türkçede de aynı şekilde bırakılır."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希尔赛德",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}