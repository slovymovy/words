                        "entry_id": "ee92a13e-a4db-39da-9ee2-1468d4876c5b",
                        "glosses": [
                            "Raum, der für Wohnzwecke kaum akzeptabel ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c35dfe2-0930-4a5c-99d5-39e66043fd1b",
                                "sense_id": "f4282bc3-662a-3bad-805b-cb44324f765c",
                                "text": "„Auf eine Robert noch unerklärliche Weise muten die Wohnverschläge an wie Zellen eines riesigen Gefängnisses.“"
                            },
                            {
                                "example_id": "5b8f18c3-153d-41a2-83ad-59aebdba7a73",
                                "sense_id": "f4282bc3-662a-3bad-805b-cb44324f765c",
                                "text": "„Das Kind, das sonst in einem städtischen Wohnverschlag gehalten wird, war so entzückt über die Erfindung des Apfelbaums, dass es nacheinander sieben Äpfel pflückte, anbiss und fortwarf.“"
                            }
                        ],
