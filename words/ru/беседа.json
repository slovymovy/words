                },
                {
                    "sense_id": "7721edb1-50ed-3991-b625-8caa8912e314",
                    "sense_definition": "Официальный или деловой разговор, обсуждение какого-либо вопроса.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conversation_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор пригласил сотрудника в кабинет на серьёзную <w>беседу</w>.",
                            "target_lang_translations": {
                                "en": "The director invited the employee to the office for a serious <w>talk</w>.",
                                "de": "Der Direktor lud den Mitarbeiter zu einem ernsten <w>Gespräch</w> ins Büro ein."
                            }
                        },
                        {
                            "text": "Эта деловая <w>беседа</w> помогла нам решить сложную проблему.",
                            "target_lang_translations": {
                                "en": "This business <w>discussion</w> helped us solve a complex problem.",
                                "de": "Diese geschäftliche <w>Besprechung</w> half uns, ein komplexes Problem zu lösen."
                            }
                        }
                    ],
                    "synonyms": [
                        "диалог"
                    ],
                    "common_phrases": [
                        "деловая беседа",
                        "профилактическая беседа",
                        "провести беседу"
                    ],
                    "target_lang_definitions": {
                        "en": "An official or business conversation; a discussion of a specific issue.",
                        "de": "Ein offizielles oder geschäftliches Gespräch; eine Erörterung eines bestimmten Themas."
                    },
