                "senses": [
                    {
                        "sense_id": "6ebdba31-e38d-33c4-910f-a58005340434",
                        "entry_id": "5fcc9b92-2f70-3b43-ac72-612914ffcc36",
                        "glosses": [
                            "Femme DJ, femme qui fait tourner les platines pendant les soirées, qui met de l’ambiance en musique."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c93fbc1d-2694-4fb4-9e13-a0e16aba6989",
                                "sense_id": "6ebdba31-e38d-33c4-910f-a58005340434",
                                "text": "Cette nuit-là, le-23 août dernier, Jillian, la DJette dont le journaliste venait de tomber amoureux, avait pris un risque démesuré :celui de répondre à l'invitation de Teknokiller."
                            },
                            {
                                "example_id": "728cc496-9f8a-4a44-ba40-7a016557365b",
                                "sense_id": "6ebdba31-e38d-33c4-910f-a58005340434",
                                "text": "C'était elle. Elle est DJette. Et vlan. Ce n'est donc pas de moi dont elle parlait. Penser à demander aux copines de se renseigner sur les techniques d'approche entre femmes."
                            },
                            {
                                "example_id": "320ab6ce-a946-4f39-add3-8f3a4044cd2a",
                                "sense_id": "6ebdba31-e38d-33c4-910f-a58005340434",
                                "text": "Je vous dis que mes copines m'attendent, Juliette et Natacha, elles sont les DJettes, argumente Sophie, épuisée, à un agent de sécurité qui lui barre l'entrée de la soirée."
                            },
                            {
                                "example_id": "67cd3482-70e3-4248-bc5f-a9f451c521a6",
                                "sense_id": "6ebdba31-e38d-33c4-910f-a58005340434",
                                "text": "Le soir, des DJettes s’installent aux platines à l’arrière d’une caravane ramenée on ne sait comment jusqu’ici, dans son décor kitsch pétillant et coloré : un baby-foot, des strings qui sèchent au-dessus du comptoir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7ab8573-3870-4035-98b7-61577d11e2f4",
                        "source_entry_id": "5fcc9b92-2f70-3b43-ac72-612914ffcc36",
                        "source_sense_id": "6ebdba31-e38d-33c4-910f-a58005340434",
                        "target_lang_word": "DJane",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "DJane",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2fa9f3d-6ad7-3774-9da2-82b33c286bd8",
                                        "entry_id": "2dc3f150-7304-3c1f-ae6c-076818188ab6",
                                        "glosses": [
                                            "weibliche Person, die (vor allem in Diskotheken) vor einem Publikum Musiktitel abspielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2af2a5f-9717-4d99-aedf-c25a0bf2766d",
                                                "sense_id": "f2fa9f3d-6ad7-3774-9da2-82b33c286bd8",
                                                "text": "„Nun hat eine weit größere Nummer des Showgeschäfts als die deutsch-griechische DJane ihre Sympathie für die deutsche Regierungschefin zum Ausdruck gebracht.“"
                                            },
                                            {
                                                "example_id": "c5145ff8-ac6e-48fe-b0d0-095810b1c669",
                                                "sense_id": "f2fa9f3d-6ad7-3774-9da2-82b33c286bd8",
                                                "text": "„Neben den zahlreichen VIPs, die bis spät in den Abend ausgelassen zu den Beats von DJane Palina Power feierten, machte der Schweiger-Sprössling aber auch solo eine gute Figur.“"
                                            },
                                            {
                                                "example_id": "7b0e0033-fb96-4387-bafd-d1be06180881",
                                                "sense_id": "f2fa9f3d-6ad7-3774-9da2-82b33c286bd8",
                                                "text": "„Ausdrucksstarke Musikerinnen und angesagte DJanes machen dabei Stimmung für Frauenhäuser in Österreich.“"
                                            },
                                            {
                                                "example_id": "89658502-dd64-4e80-b7d4-63767849954d",
                                                "sense_id": "f2fa9f3d-6ad7-3774-9da2-82b33c286bd8",
                                                "text": "„Leider gibt es mittlerweile viel zu viele DJanes, die sich nicht mit Technik, sondern mit Schönheit und Promistatus in die Szene mogeln. Darunter leidet der Ruf der DJanes zeitweise.“"
                                            },
                                            {
                                                "example_id": "3e8fe8fc-eb96-4e3f-b0eb-ae4a1862af2a",
                                                "sense_id": "f2fa9f3d-6ad7-3774-9da2-82b33c286bd8",
                                                "text": "„Etwas, das ich oft zu hören bekomme ist: ‚Du bist meine Lieblings-DJane‘ oder ‚Du bist meine liebste weibliche DJ‘, so als wäre Frau-sein ein eigenes Subgenre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
