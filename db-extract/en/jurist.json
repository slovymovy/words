                                "target_senses": [
                                    {
                                        "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                        "entry_id": "c1c9374c-f0ca-399f-a87d-6e5f41fd99f2",
                                        "glosses": [
                                            "jemand, der Rechtswissenschaft studiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9fca6f-83bf-4b35-aa69-1b269fda5f57",
                                                "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                                "text": "Unter den Studenten bilden die Juristen eine besondere Spezies."
                                            },
                                            {
                                                "example_id": "cb0f161e-4a66-4d50-af4d-5a21b1f7831d",
                                                "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                                "text": "„Trotz der Einsicht der Juristen in die Verbesserungswürdigkeit von Gesetzestexten sei noch viel zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                        "entry_id": "c1c9374c-f0ca-399f-a87d-6e5f41fd99f2",
                                        "glosses": [
                                            "Deutschland: jemand, der das Jurastudium mit dem zweiten Staatsexamen abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b9cbf30-57c7-4f60-b814-ca7b5538ea25",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "Ein Jurist weiß, wie ein Gerichtsurteil zu lesen ist."
                                            },
                                            {
                                                "example_id": "4eb67c8c-10f2-4485-93d7-cb948b7a48b3",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Sie hatte in Berlin Schauspielerin werden wollen und war in Jerusalem die Frau eines langweiligen Juristen geworden.“"
                                            },
                                            {
                                                "example_id": "d40b4a2b-b269-4ec6-b928-33f401dbe0f4",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Nachdem Juristen, Software-Experten und Plagiatsforscher eine Woche lang das Werk des Ministers gefilzt haben, steht fest: Guttenberg hat in seiner Doktorarbeit nicht nur vereinzelt Fremdautoren zitiert, ohne dies nach üblichem Verfahren in einer Fußnote auszuweisen.“"
                                            },
                                            {
                                                "example_id": "3353bac5-ebd6-4c9b-9635-d1de6d82b1c3",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Leider hatten die Stadtväter die Rechnung ohne die Juristen gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea26ddcc-f4c0-4c85-a6cc-ae9c0cbf5a09",
                        "source_entry_id": "c6bc8627-fc4f-3528-adad-798d87a39a8e",
                        "source_sense_description": "expert of law",
                        "target_lang_word": "Juristin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
