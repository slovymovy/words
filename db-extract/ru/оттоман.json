                        "entry_id": "b84b66a4-3a07-36f6-a50c-8c33283862b4",
                        "glosses": [
                            "archaic form of Осма́н (Osmán), the name borne by",
                            "Osman I (d. 1323/4), founder of the Ottoman Empire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abefdd60-cc1e-4a1a-8dce-eefeba9ef857",
                                "sense_id": "ff18a33b-b194-35c3-8ce9-5abb6294eeca",
                                "text": "Оттоманъ, или Османъ І, первый Турецкїй Императоръ […]"
                            },
                            {
                                "example_id": "cd5f42ba-9b4c-47a8-9c81-373cc490a77c",
                                "sense_id": "ff18a33b-b194-35c3-8ce9-5abb6294eeca",
                                "text": "[…] Императоръ Турецкїй, Оттоманъ І […]"
                            },
                            {
                                "example_id": "f42df162-0d94-4e7b-b6f5-ba4657010b2d",
                                "sense_id": "ff18a33b-b194-35c3-8ce9-5abb6294eeca",
                                "text": "[…] Османъ или Оттоманъ, сынъ Эртогрула […]"
                            }
                        ]
                    }
