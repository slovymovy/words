                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c484cfd-cfae-3045-85e2-0a845801d789",
                        "entry_id": "bbf76685-6a39-383f-befa-2d36d6b31005",
                        "glosses": [
                            "Forme de harcèlement de rue de nature sexuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b2da9e-f1dc-4a8e-8321-9c748457f241",
                                "sense_id": "0c484cfd-cfae-3045-85e2-0a845801d789",
                                "text": "Le terme sexhuage (en anglais, catcalling) est employé plus précisément pour faire référence aux sifflements ou aux commentaires de nature sexuelle tenus en public. Il s'agit d'un mot-valise formé à partir des noms sexe et huage (du verbe huer)."
                            },
                            {
                                "example_id": "b7923d01-d2d1-4657-bd67-a98af76a8804",
                                "sense_id": "0c484cfd-cfae-3045-85e2-0a845801d789",
                                "text": "CONSIDÉRANT QUE le sexhuage (« catcalling »), le harcèlement sexuel et le sexisme présents dans les écoles sont directement liés aux normes hétéronormatives de la société et basés sur des inégalités entre les femmes et les hommes;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99eb40c1-dca2-4330-a42a-2ba72171a31f",
                        "source_entry_id": "bbf76685-6a39-383f-befa-2d36d6b31005",
                        "source_sense_id": "0c484cfd-cfae-3045-85e2-0a845801d789",
                        "target_lang_word": "catcall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catcall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc02d18-5b9a-38e0-aaf2-50b51e3ce332",
                                        "entry_id": "49434d4e-5c8a-31fb-b6cb-147fb36ee89e",
                                        "glosses": [
                                            "A shout or whistle expressing dislike, especially from a crowd or audience; a jeer, a boo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110ffaa7-8e19-40b9-955e-a8b4ae3a7e46",
                                                "sense_id": "2bc02d18-5b9a-38e0-aaf2-50b51e3ce332",
                                                "text": "There, amid the curses and catcalls of sweaty beer drinkers, the tour's headliners are set to engage in a hallowed feminist ritual:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5876679b-304c-313c-8b91-a7e568f4011a",
                                        "entry_id": "49434d4e-5c8a-31fb-b6cb-147fb36ee89e",
                                        "glosses": [
                                            "A shout, whistle, or comment of a harassingly sexual nature, usually made toward a passing woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1fa7d1-7370-4c1e-a596-6c6c8bf38aff",
                                                "sense_id": "5876679b-304c-313c-8b91-a7e568f4011a",
                                                "text": "In the Room for Debate forum Stopping Street Harassment, the editors ask four people to weigh in on the question, Should current laws dealing with harassment be strengthened to include catcalling, or will that go too far in controlling speech and behavior? (A catcall in this context is defined as “a whistle, shout, or comment of a sexual nature to a woman passing by.”)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b185293b-42ed-3f39-8bb5-0e73b468163f",
                                        "entry_id": "49434d4e-5c8a-31fb-b6cb-147fb36ee89e",
                                        "glosses": [
                                            "A whistle blown by a theatre-goer to express disapproval."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d6a0729-4bef-4d0e-a6fb-52d6fc516266",
                                                "sense_id": "b185293b-42ed-3f39-8bb5-0e73b468163f",
                                                "text": "At what period was the custom of blowing catcalls at the theatre discontinued?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "catcall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ee83b39-f813-366b-b6df-6180458510aa",
                                        "entry_id": "bf97863d-7551-3889-9b49-1e648fc9cc6d",
                                        "glosses": [
                                            "To make such an exclamation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81ea998f-8144-4ccd-9a0e-0af99c971795",
                                                "sense_id": "7ee83b39-f813-366b-b6df-6180458510aa",
                                                "text": "When Susan Seligson thinks about breasts — and, since she’s a DDD-endowed (touché) middle-aged woman who’s been groped and catcalled her whole life, that’s often, too — she thinks about ... her own DDDs."
                                            }
                                        ]
                                    }
                                ]
                            },
