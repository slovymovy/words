                        "tags": [],
                        "examples": [
                            {
                                "example_id": "391ddc6c-f40e-4588-b14c-6ebcc54e5811",
                                "sense_id": "90b7005a-582b-3972-b1b7-777a264d3aa1",
                                "text": "Bientôt se montrèrent des symptômes hypothymiques, du délire."
                            },
                            {
                                "example_id": "11596e1f-1115-488b-a00e-1c336bd8c6d7",
                                "sense_id": "90b7005a-582b-3972-b1b7-777a264d3aa1",
                                "text": "Si l’on s’en tient à la distinction du plan du syndrome et du plan de la maladie, il n’est pas possible d’opposer à la cyclophrénie, maladie hyperthymique, le syndrome schizophrénique mais bien l’hébéphrénie, maladie hypothymique."
                            },
                            {
                                "example_id": "6b0db80a-8a46-4a3d-9b3d-0eb0faeeee27",
                                "sense_id": "90b7005a-582b-3972-b1b7-777a264d3aa1",
                                "text": "L’aspect clinique est celui d’un personnage hypothymique, ayant donc une vie émotive insuffisante."
                            }
                        ]
                    }
                ],
