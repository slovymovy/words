                ],
                "senses": [
                    {
                        "sense_id": "3d4f7dd3-8dff-3000-a622-0a4b710c280b",
                        "entry_id": "b181e70d-1f45-372e-953c-55ab63257c26",
                        "glosses": [
                            "schwimmfähiger Torus zur Rettung von Personen aus dem Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1915a94-a8bf-4201-8eb0-4808ea4c90ae",
                                "sense_id": "3d4f7dd3-8dff-3000-a622-0a4b710c280b",
                                "text": "Als er zu weit hinaus schwamm und drohte zu ertrinken, warf ihm der Rettungsschwimmer einen Rettungsring zu."
                            },
                            {
                                "example_id": "6e2ce7a4-982e-4cb5-ad32-868a7b037578",
                                "sense_id": "3d4f7dd3-8dff-3000-a622-0a4b710c280b",
                                "text": "„Wie an einen Rettungsring klammerten sie sich monatelang an diese Vorstellung.“"
                            },
                            {
                                "example_id": "85b86293-e5bb-4e8f-a862-0882090cd3db",
                                "sense_id": "3d4f7dd3-8dff-3000-a622-0a4b710c280b",
                                "text": "„Ihre Schwester war für sie wie ein Rettungsring in stürmischer See.“"
                            },
                            {
                                "example_id": "d2afeec8-7351-4cf2-a67c-580a284ea688",
                                "sense_id": "3d4f7dd3-8dff-3000-a622-0a4b710c280b",
                                "text": "„Sie schnappte danach, als hättest du ihr einen Rettungsring zugeworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f33b0f99-b71e-3d54-ac2d-c3bf7879fc31",
                        "entry_id": "b181e70d-1f45-372e-953c-55ab63257c26",
                        "glosses": [
                            "Fett beziehungsweise Gewebe mit Fett, das am Oberkörper oder der Hüfte herunterhängt"
                        ],
                        "tags": [
                            "colloquial",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "c497fc6a-8928-438d-967d-366e7b25a22a",
                                "sense_id": "f33b0f99-b71e-3d54-ac2d-c3bf7879fc31",
                                "text": "Dass er zu dick war, konnte man bereits an seinen Rettungsringen erkennen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24fe7dea-c38a-43f8-b735-42dc40ef1c10",
                        "source_entry_id": "b181e70d-1f45-372e-953c-55ab63257c26",
                        "source_sense_id": "3d4f7dd3-8dff-3000-a622-0a4b710c280b",
                        "source_sense_description": "schwimmfähiger Torus zur Rettung von Personen aus dem Wasser",
                        "target_lang_word": "lifebuoy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lifebuoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8018f1c-b611-3720-8d0b-a2ba25845b0f",
                                        "entry_id": "a9c929c2-f387-3563-8537-f38987ec3903",
                                        "glosses": [
                                            "Alternative spelling of life buoy."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c410192-f49b-409e-aa5c-47ee1e61b2c3",
                                                "sense_id": "d8018f1c-b611-3720-8d0b-a2ba25845b0f",
                                                "text": "The gray rock mocked me, bobbing on the water easy as a lifebuoy."
                                            },
                                            {
                                                "example_id": "e07c35ba-7aa7-463f-af90-710728977bc3",
                                                "sense_id": "d8018f1c-b611-3720-8d0b-a2ba25845b0f",
                                                "text": "There was a lifebuoy in the boat with a rope tied to it."
                                            },
                                            {
                                                "example_id": "4b90867b-7a48-46dc-b671-81a58bb35693",
                                                "sense_id": "d8018f1c-b611-3720-8d0b-a2ba25845b0f",
                                                "text": "'News?' Andy said, reaching for the lifebuoy of the coffee pot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cf2cce0-32eb-4990-8fdb-4ea87edca6ed",
                        "source_entry_id": "b181e70d-1f45-372e-953c-55ab63257c26",
                        "source_sense_id": "3d4f7dd3-8dff-3000-a622-0a4b710c280b",
                        "source_sense_description": "schwimmfähiger Torus zur Rettung von Personen aus dem Wasser",
                        "target_lang_word": "life preserver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "life preserver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45a16ccd-6d62-3415-8e82-52099751c209",
                                        "entry_id": "0a54c0f6-2948-3d0d-b797-21de68b83bf1",
                                        "glosses": [
                                            "A buoyant ring or vest intended to keep a person afloat."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d75a3613-ba5a-3fdf-bf30-1265dc78ed8b",
                                        "entry_id": "0a54c0f6-2948-3d0d-b797-21de68b83bf1",
                                        "glosses": [
                                            "A short club with a weighted end."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43092220-d00c-4487-a1f6-a716df67cb40",
                                                "sense_id": "d75a3613-ba5a-3fdf-bf30-1265dc78ed8b",
                                                "text": "Here's your crowbar / And your centre-bit; / Your life-preserver— / You may want to hit!"
                                            },
                                            {
                                                "example_id": "45802912-d2cf-4887-a7d5-255b364782a5",
                                                "sense_id": "d75a3613-ba5a-3fdf-bf30-1265dc78ed8b",
                                                "text": "But when I gave him every particular that had occurred, he tried to bluster, and took down a life-preserver from the wall. I knew my man, however, and I clapped a pistol to his head before he could strike."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bce206f-3956-383d-b48c-e1f166a3d09d",
                                        "entry_id": "0a54c0f6-2948-3d0d-b797-21de68b83bf1",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see life, preserver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c86587-92bb-4611-aea8-0fd6f4054e96",
                                                "sense_id": "5bce206f-3956-383d-b48c-e1f166a3d09d",
                                                "text": "In such cases, the story is told to illustrate some main truth, which, in this case, is the beer-drinking habit of the people. By this faith, that beer is a life preserver, the English live, and by this they die."
                                            },
                                            {
                                                "example_id": "079330ce-8c39-4ba2-9c2d-bac03a05f52b",
                                                "sense_id": "5bce206f-3956-383d-b48c-e1f166a3d09d",
                                                "text": "Drink as a Life Preserver.—A report on the inquiry into the connection of disease with habits of intemperance, prepared by Dr. Isambard Owen, secretary of the investigation committee of the British Medical Association, gives some startling statistics for temperance people. Particulars have been obtained by the committee of 4234 cases of deceased lives, aged 25 and upwards, in which the habits of the person in regard to alcohol were recorded in five classes—total abstainers, habitually temperate, careless drinkers, free drinkers, and decidedly intemperate."
                                            },
                                            {
                                                "example_id": "a163c799-d079-499c-a624-78ca7349dd72",
                                                "sense_id": "5bce206f-3956-383d-b48c-e1f166a3d09d",
                                                "text": "In a very similar way, in the early, barbarous, unsanitary condition of society, alcohol obtained credit as a life preserver which was not merited by any virtues the drug itself possessed."
                                            },
                                            {
                                                "example_id": "3c24b33f-0f1f-4222-8a15-f4525bc2bb48",
                                                "sense_id": "5bce206f-3956-383d-b48c-e1f166a3d09d",
                                                "text": "Sleep a Life Preserver / During sleep the pulse is slowed and all the life processes slackened to a pronounced degree. The winter sleep of plants and of hibernating animals no doubt greatly contributes to their life duration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "993113cb-06b8-4854-9fc3-742fae887d9d",
                        "source_entry_id": "b181e70d-1f45-372e-953c-55ab63257c26",
