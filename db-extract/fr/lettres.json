                                    {
                                        "sense_id": "fdedfa75-8489-3526-aeb2-b3d6b7def069",
                                        "entry_id": "db4bf691-e63d-3225-97a3-cc4754df874b",
                                        "glosses": [
                                            "Literature (school subject)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ab8fe53-54e3-4c50-8fe0-17b62f84242b",
                                                "sense_id": "fdedfa75-8489-3526-aeb2-b3d6b7def069",
                                                "text": "Rickert was the first woman (and second individual) to be awarded a Ph.D. in English letters and philology with that academic honor at the University of Chicago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddb1fa77-91c5-3b88-9c47-7b0fc46df4a8",
                                        "entry_id": "db4bf691-e63d-3225-97a3-cc4754df874b",
                                        "glosses": [
                                            "The liberal arts, humanities, learning (broad accumulated cultural knowledge)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784f6d48-bbe2-43fd-85f6-01ebf265caa6",
                                                "sense_id": "ddb1fa77-91c5-3b88-9c47-7b0fc46df4a8",
                                                "text": "Though architecture in ancient Rome was not generally considered to belong to the artes liberales, Vitruvius easily qualified as a man of letters because of his wide learning."
                                            },
                                            {
                                                "example_id": "25583b8b-0e03-40df-b63f-4c1d662fa792",
                                                "sense_id": "ddb1fa77-91c5-3b88-9c47-7b0fc46df4a8",
                                                "text": "He read widely throughout these days, for his father had a taste for modern letters, and new books lay littered about the rooms."
                                            }
                                        ]
                                    }
                                ]
