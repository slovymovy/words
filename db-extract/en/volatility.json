                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d80fc01-f38c-43ed-a8b5-2f34c1bb10d5",
                                                "sense_id": "54e4db2b-a92e-3c44-94e5-8302380d622a",
                                                "text": "Schnell entstehen dann aus Flüchtigkeit Fehler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3ad8934c-32d2-334b-92f0-59c7037caa6c",
                                        "entry_id": "0d1b5cc4-b4f5-3334-944c-0c1ae09b8262",
                                        "glosses": [
                                            "Eigenschaft, sich zu verflüchtigen, zu verdampfen/verdunsten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429be036-1718-406b-a7f6-bd2576f171dc",
                                                "sense_id": "3ad8934c-32d2-334b-92f0-59c7037caa6c",
                                                "text": "„Generell gilt, je höher der Dampfdruck einer Flüssigkeit ist, desto höher ist seine Flüchtigkeit.“"
                                            }
