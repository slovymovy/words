                                    {
                                        "sense_id": "d813f35f-027f-35a1-b6f6-d9e79881964b",
                                        "entry_id": "7a4a70ea-5957-3d97-80cf-ef5baf80efe8",
                                        "glosses": [
                                            "To play music on (a stringed) instrument using a bow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f8b7cc-ef18-4cf2-bedf-886a18c86621",
                                                "sense_id": "d813f35f-027f-35a1-b6f6-d9e79881964b",
                                                "text": "The musician bowed his violin expertly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f7e690-061a-34c1-b4d2-760a8cd9cd00",
                                        "entry_id": "7a4a70ea-5957-3d97-80cf-ef5baf80efe8",
                                        "glosses": [
                                            "To become bent or curved."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e757705-3020-439c-a465-fde6709021e7",
                                                "sense_id": "b8f7e690-061a-34c1-b4d2-760a8cd9cd00",
                                                "text": "The shelf bowed under the weight of the books."
                                            },
                                            {
                                                "example_id": "7e630570-fbcc-4841-a0d8-442549b70c10",
                                                "sense_id": "b8f7e690-061a-34c1-b4d2-760a8cd9cd00",
                                                "text": "How long wil ye imagine mischiefe against a man? ye shall be slaine all of you: as a bowing wall shall ye be, and as a tottering fence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0ec1e0-f949-3208-99ed-f67c0c197ada",
                                        "entry_id": "7a4a70ea-5957-3d97-80cf-ef5baf80efe8",
                                        "glosses": [
                                            "To make something bend or curve."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f82ecb90-1bfa-401b-9624-538e97af29fd",
                                                "sense_id": "0d0ec1e0-f949-3208-99ed-f67c0c197ada",
                                                "text": "[…] as when we bow things the contrary way, to make them come to their naturall ſtraitneſſe."
                                            },
                                            {
                                                "example_id": "cb441a7d-1023-4e90-929b-5eec8cc4b3e5",
                                                "sense_id": "0d0ec1e0-f949-3208-99ed-f67c0c197ada",
                                                "text": "The whole nation […]bowed their necks to the worst kind of tyranny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ce50764-32f3-38c5-899f-cc9818e0b743",
                                        "entry_id": "7a4a70ea-5957-3d97-80cf-ef5baf80efe8",
                                        "glosses": [
                                            "To exercise powerful or controlling influence over; to bend, figuratively; to turn; to incline."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79705778-5c0d-4517-9989-e731cb651eb2",
                                                "sense_id": "7ce50764-32f3-38c5-899f-cc9818e0b743",
                                                "text": "Adversities do more bow men's minds to religion."
                                            },
                                            {
                                                "example_id": "1e9f7cf8-416a-4bb6-91a8-c5dae8fecb01",
                                                "sense_id": "7ce50764-32f3-38c5-899f-cc9818e0b743",
                                                "text": "not to bow and bias their opinions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038f82f0-1002-35b5-894a-486c7d2768f9",
                                        "entry_id": "7a4a70ea-5957-3d97-80cf-ef5baf80efe8",
                                        "glosses": [
                                            "To humble or subdue, to make submit."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98d09079-8488-45dd-ae0c-dc7078a37d54",
                                                "sense_id": "038f82f0-1002-35b5-894a-486c7d2768f9",
                                                "text": "Know thou the secret of a spirit\nBow’d from its wild pride into shame."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4158d77-6ec4-3c68-a933-8796e6628125",
                                        "entry_id": "8c30df85-aff2-3fbe-8de4-b64026bd3dfa",
                                        "glosses": [
                                            "To bend oneself as a gesture of respect or deference."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89763544-cfe0-402d-8eee-d59ee6e26f9f",
                                                "sense_id": "b4158d77-6ec4-3c68-a933-8796e6628125",
                                                "text": "The soldier now blew upon a green whistle, and at once a young girl, dressed in a pretty green silk gown, entered the room. She had lovely green hair and green eyes, and she bowed low before Dorothy as she said, \"Follow me and I will show you your room.\""
                                            },
                                            {
                                                "example_id": "e58ceeb4-9dd8-4989-9d70-67bc1ed2e3fe",
                                                "sense_id": "b4158d77-6ec4-3c68-a933-8796e6628125",
                                                "text": "I told him about everything I could think of; and what I couldn't think of he did. He asked about six questions during my yarn, but every question had a point to it. At the end he bowed and thanked me once more. As a thanker he was main-truck high; I never see anybody so polite."
                                            },
                                            {
                                                "example_id": "c6e54ba2-eb61-4a5d-848b-bfa9efeab347",
                                                "sense_id": "b4158d77-6ec4-3c68-a933-8796e6628125",
                                                "text": "That singer always bows towards her audience for some reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e21a1851-7f51-3a4e-a1ed-f868b5ec6d7c",
                                        "entry_id": "8c30df85-aff2-3fbe-8de4-b64026bd3dfa",
                                        "glosses": [
                                            "To debut."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c93da5b7-75fe-4409-8835-e16f633e97b1",
                                                "sense_id": "e21a1851-7f51-3a4e-a1ed-f868b5ec6d7c",
                                                "text": "The show bowed in the first week of December, 1951. Dinah was ready, and so were the technicians who put on her makeup […]"
                                            },
                                            {
                                                "example_id": "67765010-8d34-45c6-8b41-621b1427057e",
                                                "sense_id": "e21a1851-7f51-3a4e-a1ed-f868b5ec6d7c",
                                                "text": "SCP recently announced that How the Grinch Stole Christmas! The Musical will bow on the newly renovated stage next December."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37876f3c-e058-33ac-b948-3c422dc2f6c3",
                                        "entry_id": "8c30df85-aff2-3fbe-8de4-b64026bd3dfa",
                                        "glosses": [
                                            "To defer (to something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "131bce60-25d5-478e-ad08-fecfb44cc94c",
                                                "sense_id": "37876f3c-e058-33ac-b948-3c422dc2f6c3",
                                                "text": "I bow to your better judgement in the matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4900ff4c-4a3c-3107-b65b-f932a1d060f6",
                                        "entry_id": "8c30df85-aff2-3fbe-8de4-b64026bd3dfa",
                                        "glosses": [
                                            "To give a direction, indication, or command to by bowing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af5c9b36-21d7-48bd-9711-f511124fae4e",
                                                "sense_id": "4900ff4c-4a3c-3107-b65b-f932a1d060f6",
                                                "text": "“This way, monsieur,” he said, and led the way up the broad, marble staircase. In another moment he had opened a door, and, drawing aside a heavy curtain, obsequiously bowed Tarzan into a dimly lighted apartment. Then Jacques vanished."
                                            },
                                            {
                                                "example_id": "df198eff-a05e-4b8e-88f4-e9a6e53ede45",
                                                "sense_id": "4900ff4c-4a3c-3107-b65b-f932a1d060f6",
                                                "text": "Poirot rose gallantly, bowed her into the seat opposite him."
                                            },
                                            {
                                                "example_id": "0abf0548-4cf3-4d89-91bf-aaa6e22dde3d",
                                                "sense_id": "4900ff4c-4a3c-3107-b65b-f932a1d060f6",
                                                "text": "He saw himself, in a smart suit and a songkok, bowed into the opulent suites of Ritzes and Waldorfs and baring, under dark glasses, a hairy chest to a milder sun by a snakeless sea."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bow",
                                "target_lang_code": "en",
                                "target_senses": [
