                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c8a79a-f1a3-43db-811e-b237f8ab1009",
                                "sense_id": "5e49a66d-700c-3471-b53a-cce1d421069f",
                                "text": "Das Wasser kocht schneller, wenn du den Topfdeckel drauflässt."
                            },
                            {
                                "example_id": "6b97e207-a228-43bf-a4f0-daf4be52d86c",
                                "sense_id": "5e49a66d-700c-3471-b53a-cce1d421069f",
                                "text": "Zu diesem Topfdeckel gibt es in meiner Küche keinen passenden Topf mehr."
                            },
                            {
                                "example_id": "952b6ba0-4438-4c55-9a49-e72b37329c1d",
                                "sense_id": "5e49a66d-700c-3471-b53a-cce1d421069f",
                                "text": "Die Kinder machten Krach, indem sie zwei Topfdeckel als Becken benutzten."
                            },
                            {
                                "example_id": "47716106-4c6c-46ce-9f30-caae61b97820",
                                "sense_id": "5e49a66d-700c-3471-b53a-cce1d421069f",
                                "text": "Trockne mal den Topfdeckel ab."
                            },
                            {
                                "example_id": "25815380-5495-4686-b158-3ceaf8559d34",
                                "sense_id": "5e49a66d-700c-3471-b53a-cce1d421069f",
                                "text": "Er verbrannte sich am heißen Topfdeckel die Finger."
                            }
                        ],
