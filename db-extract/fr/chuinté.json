                        "entry_id": "9aafe3f7-3883-34a3-8fdc-4a0db6fbf676",
                        "glosses": [
                            "Qui rend un son proche du ch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb258db-c867-4a89-8d2d-b7ff61f29d79",
                                "sense_id": "99b4371c-538c-389e-8162-0e201332297d",
                                "text": "Comme un sifflement ou un murmure chuinté."
                            },
                            {
                                "example_id": "2e59d77d-79fe-4124-ae58-bd5c8f28d19c",
                                "sense_id": "99b4371c-538c-389e-8162-0e201332297d",
                                "text": "Il s’entendait déjà dire au malheureux : « Mais c’est épouvantable… » d’une voix chuintée qui faisait accourir dans le confessionnal les plus noires ténèbres de l’église."
                            },
                            {
                                "example_id": "20c7e7b7-f0f8-46a7-bd18-b77be3302b05",
                                "sense_id": "99b4371c-538c-389e-8162-0e201332297d",
                                "text": "Les sibilantes chuintées sont des éléments constitutifs des diphthongues palatales."
                            }
                        ]
                    }
