                                "example_id": "934ae4cd-9f59-4989-8734-76bdbac248b7",
                                "sense_id": "e8ac95d7-c46d-3aef-9e8e-af2948ac131f",
                                "text": "„Die letzte Zarenfamilie, am 17. Juli 1918 in Jekaterinburg von den Bolschewiki ermordet, wurde am 20. August 2000 heiliggesprochen.“"
                            }
