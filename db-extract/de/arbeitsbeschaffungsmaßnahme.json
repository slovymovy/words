                "senses": [
                    {
                        "sense_id": "dfe6ebf7-5338-37ee-badc-879b8cf9e62f",
                        "entry_id": "23c71ced-e55a-3a13-b89d-8ccf77b299fc",
                        "glosses": [
                            "von der Bundesagentur für Arbeit organisierte Maßnahme, die dazu dient, mehreren Personen einen Job zu verschaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c480e863-b64c-43c2-b197-c1e3a1c0f332",
                                "sense_id": "dfe6ebf7-5338-37ee-badc-879b8cf9e62f",
                                "text": "„Die Arbeitsbeschaffungsmaßnahmen (ABM) basieren auf einer Vereinbarung zwischen der Bundesagentur für Arbeit und einem Arbeitgeber.“"
                            },
                            {
                                "example_id": "c4fcde30-942a-4a60-88ac-9c4ec683e933",
                                "sense_id": "dfe6ebf7-5338-37ee-badc-879b8cf9e62f",
                                "text": "„»Das, was die Bundesagentur für Arbeit an Maßnahmen anbietet, ist ganz oft überhaupt nicht zielführend, sondern eher eine Arbeitsbeschaffungsmaßnahme für Maßnahmenanbieter.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
