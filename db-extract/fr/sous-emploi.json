                ],
                "senses": [
                    {
                        "sense_id": "7919c960-f92d-3545-b01b-50d637ce621d",
                        "entry_id": "64067c19-b9b2-3cfb-88a7-2dbb05c0a1e9",
                        "glosses": [
                            "Niveau de l'emploi en dessous du potentiel d'une personne en particulier ou d'une économie en général."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "f08594f4-c1b6-418d-be9e-f3a280e87e8c",
                                "sense_id": "7919c960-f92d-3545-b01b-50d637ce621d",
                                "text": "Le sous-emploi se caractérise par un revenu horaire insuffisant, un mauvais emploi des compétences professionnelles, etc., reflétant une productivité du travail inadéquate résultant d’une mauvaise répartition des ressources de main-d’œuvre ou d’un déséquilibre fondamental entre le travail et les autres facteurs de production"
                            },
                            {
                                "example_id": "65457587-e172-4212-a113-b619b418f7d7",
                                "sense_id": "7919c960-f92d-3545-b01b-50d637ce621d",
                                "text": "Équilibre de sous-emploi."
                            },
                            {
                                "example_id": "98a134f0-0b55-4f0c-aa8d-074062b101e8",
                                "sense_id": "7919c960-f92d-3545-b01b-50d637ce621d",
                                "text": "Dans l’histoire de Jérôme et de Sylvie était déjà inscrit le jour où ils devraient choisir : ou bien connaître le chômage, le sous-emploi, ou bien s’intégrer plus solidement à une agence, y entrer à plein temps, y devenir cadre."
                            }
                        ]
                    }
                ],
