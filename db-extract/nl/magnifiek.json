                    },
                    {
                        "sense_id": "f8620ed7-31ee-3a2c-a936-0e693ea0c87b",
                        "entry_id": "d845be54-b947-34bd-bc13-6898a664984c",
                        "glosses": [
                            "schitterend, beeldschoon, prachtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e93b96-33f0-4ee0-9fa2-9fdb72a3208e",
                                "sense_id": "f8620ed7-31ee-3a2c-a936-0e693ea0c87b",
                                "text": "Het magnifieke vuurwerk was een goed begin van het nieuwe jaar."
                            },
                            {
                                "example_id": "619a7094-3830-484f-853e-a859efe0ab1a",
                                "sense_id": "f8620ed7-31ee-3a2c-a936-0e693ea0c87b",
                                "text": "Als een slordige s in spiegelbeeld was het kanaal over de stadsplattegrond gekalkt door een dronken ontwerper die sadistisch lachte toen hij zag hoe zijn ingreep de stad zo goed als onbegaanbaar had gemaakt voor de flanerende edelen met hun satijnen schoentjes en die pas de volgende dag, weer nuchter, besefte dat hij geheel tegen zijn bedoeling in een magnifieke waterweg had geschapen die alle delen van de stad op een mooie, trage manier met elkaar verbond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d951b36-5cb0-4660-8a9c-578dbe1b16ba",
                        "source_entry_id": "d845be54-b947-34bd-bc13-6898a664984c",
                        "target_lang_word": "lovely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lovely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                                        "entry_id": "f6be7ae0-c09f-362c-b1ca-0f851b303487",
                                        "glosses": [
                                            "Delightful for beauty, harmony, or grace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e37f2a-56ff-4c8e-8945-43b7b3b70c81",
                                                "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                                                "text": "It's a lovely day and the sun is shining."
                                            },
                                            {
                                                "example_id": "132998ac-cfb2-431e-8012-8dafcb8a6c87",
                                                "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                                                "text": "The music box plays a lovely melody."
                                            },
                                            {
                                                "example_id": "a5b673d1-b290-4eec-8f1d-1d06c5e0a79a",
                                                "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                                                "text": "The castle garden enchants visitors with its lovely blooms."
                                            },
                                            {
                                                "example_id": "03fe9fa6-301e-46ae-bffe-fc7f95d84de0",
                                                "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                                                "text": "So it was this beautiful young woman Rokoff had been persecuting. Tarzan wondered in a lazy sort of way whom she might be, and what relations one so lovely could have with the surly, bearded Russian."
                                            },
                                            {
                                                "example_id": "c07ab3b6-3072-4b4a-a71d-8cfca15e549b",
                                                "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                                                "text": "His pink coat was lovely"
                                            },
                                            {
                                                "example_id": "8f8bfd28-e5a1-49c4-bba6-ead6f22e472f",
                                                "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                                                "text": "The woods are lovely, dark and deep."
                                            },
                                            {
                                                "example_id": "5ca40384-d404-4d96-9781-bdb6552cb2de",
                                                "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                                                "text": "Then I look at you / And the world's alright with me / Just one look at you / And I know it's gonna be / A lovely day"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "554696a0-3ef8-3b55-8e63-08cc82951f6e",
                                        "entry_id": "f6be7ae0-c09f-362c-b1ca-0f851b303487",
                                        "glosses": [
                                            "Nice; wonderful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec3c257-3670-49bc-94c4-81449bd1d188",
                                                "sense_id": "554696a0-3ef8-3b55-8e63-08cc82951f6e",
                                                "text": "It would be lovely to have a little more money to spend."
                                            },
                                            {
                                                "example_id": "e78e9fec-93f7-448f-a1cf-e4ab0d0c45e7",
                                                "sense_id": "554696a0-3ef8-3b55-8e63-08cc82951f6e",
                                                "text": "It is a lovely night, and why should we not prolong our ride a little?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb187878-1cd0-3c56-bf0b-1d98633e3cc5",
                                        "entry_id": "f6be7ae0-c09f-362c-b1ca-0f851b303487",
                                        "glosses": [
                                            "Inspiring love or friendship; amiable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add679aa-6f63-4189-9c60-4ab11e212f8d",
                                                "sense_id": "fb187878-1cd0-3c56-bf0b-1d98633e3cc5",
                                                "text": "a most lovely gentlemanlike man"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1849be4-4821-379c-9788-92c68900485d",
                                        "entry_id": "f6be7ae0-c09f-362c-b1ca-0f851b303487",
                                        "glosses": [
                                            "Loving, filled with love."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603e0569-e7a7-4ca1-ae40-e02def2ce9a9",
                                                "sense_id": "e1849be4-4821-379c-9788-92c68900485d",
                                                "text": "seal the title with a lovely kiss"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lovely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2578ec38-d113-3224-9172-7c72bd61ab9a",
                                        "entry_id": "9bf1ef09-55d7-32e1-a3b9-992cecd8b9bf",
                                        "glosses": [
                                            "An attractive, lovely person, especially a (professional) beauty."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a38ca992-cdf6-4533-a743-adc422554c94",
                                                "sense_id": "2578ec38-d113-3224-9172-7c72bd61ab9a",
                                                "text": "a calendar depicting young lovelies in bikinis"
                                            },
                                            {
                                                "example_id": "c91b742e-ae6a-4e40-8666-4da31ae811c9",
                                                "sense_id": "2578ec38-d113-3224-9172-7c72bd61ab9a",
                                                "text": "\"I'd sooner be on the stage than anywhere else.\" \"You mean you like being cocked up in front of an audience with nothing much on and getting a thrill out of being what those idiotic newspapers call a Lovely or a Glamour Girl. With all the damned glamour on the stage and none off it.\""
                                            },
                                            {
                                                "example_id": "dafb4a0b-b4ea-4c4f-b5d9-c17cfff8639c",
                                                "sense_id": "2578ec38-d113-3224-9172-7c72bd61ab9a",
                                                "text": "Tom Bower’s 2024 book, The House of Beckham, painted a rather snide portrait of the marriage, in which Beckham is constantly surrounded by lovelies, and Victoria is in a constant huff about it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c565bf49-60b2-338f-904f-4e6e66208aca",
                                        "entry_id": "9bf1ef09-55d7-32e1-a3b9-992cecd8b9bf",
                                        "glosses": [
                                            "Term of fond address."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e1ecb1-4004-40d6-8967-53f4367cc9a4",
                                                "sense_id": "c565bf49-60b2-338f-904f-4e6e66208aca",
                                                "text": "Goodbye, my lovely."
                                            },
                                            {
                                                "example_id": "91235257-c324-4af1-9cc9-69111552874c",
                                                "sense_id": "c565bf49-60b2-338f-904f-4e6e66208aca",
                                                "text": "But where do you go to my lovely / When you're alone in your bed?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7382b107-1c2b-3993-96d2-d7a8a6fce42e",
                                        "entry_id": "9bf1ef09-55d7-32e1-a3b9-992cecd8b9bf",
                                        "glosses": [
                                            "A lovely object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305fe09b-be88-4dd6-be69-453d98d22712",
                                                "sense_id": "7382b107-1c2b-3993-96d2-d7a8a6fce42e",
                                                "text": "In Montréal, the summer months bring in a huge variety of fruits and vegetables and this is the time to preserve them. Preserving can also refer to the storage of these fiber and vitamin rich lovelies."
                                            },
                                            {
                                                "example_id": "c8b24057-8536-4042-a63a-2bc1ef09e9d3",
                                                "sense_id": "7382b107-1c2b-3993-96d2-d7a8a6fce42e",
                                                "text": "May Bell ironed the last ruffle and then hung the dress in the wardrobe next to her other lovelies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lovely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21fe1de2-ee6c-3162-bdf6-3e7ea5ad4fd6",
                                        "entry_id": "1a8a78b9-6948-3a95-88a6-5c58ff5db2bf",
                                        "glosses": [
                                            "In a lovely fashion or manner; beautifully."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b729ed-2044-4526-aa0e-fcd9fffbbe75",
                                                "sense_id": "21fe1de2-ee6c-3162-bdf6-3e7ea5ad4fd6",
                                                "text": "She's not everyone's cup of tea, what with the way she speaks her mind and doesn't always do her hair in the morning, but she scrubs up lovely."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lovely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0861091e-890c-3163-b0c6-609c668466b9",
                                        "entry_id": "55826a5f-df77-33c4-a9f5-1d8dff69c17a",
                                        "glosses": [
                                            "Worthy of praise."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63dd7776-c098-4d5a-b619-415548ebc3d6",
                                                "sense_id": "0861091e-890c-3163-b0c6-609c668466b9",
                                                "text": "And so he is in the eyes of all who live to his praise. To them every attribute of God is lovely. The holiness and purity of his nature is most lovely to them."
                                            },
                                            {
                                                "example_id": "ee06304f-31d0-4c13-92e4-a8dfc2af78d4",
                                                "sense_id": "0861091e-890c-3163-b0c6-609c668466b9",
                                                "text": "He is altogether lovely. O, all our praises of him are poor and low things!"
                                            },
                                            {
                                                "example_id": "b9ba0614-f1d1-4ae3-b382-7b4ec4a2870e",
                                                "sense_id": "0861091e-890c-3163-b0c6-609c668466b9",
                                                "text": "О praise the Lord, for the Lord is gracious : О sing praises unto his Name, for it is lovely."
                                            },
                                            {
                                                "example_id": "737b286a-68ee-47e2-b0d9-64f3ead33a9b",
                                                "sense_id": "0861091e-890c-3163-b0c6-609c668466b9",
                                                "text": "It is the duty of all believers to join themselves cheerfully in the setting forth the Lord's care over them, and whatsoever may make his lovely Majesty known to the world: for so he requireth the present precept and example, -- sing praises to the Lord."
                                            },
                                            {
                                                "example_id": "d46d0ebd-e038-463d-b6d3-efb0f3384dc0",
                                                "sense_id": "0861091e-890c-3163-b0c6-609c668466b9",
                                                "text": "My precious Saviour's matchless name ; He's wise and holy, just and true, And altogether lovely too."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a16c695c-1905-4f17-adcb-cdc7aac30f85",
                        "source_entry_id": "d845be54-b947-34bd-bc13-6898a664984c",
                        "target_lang_word": "magnifique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnifique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8796be9-2f05-38a0-9e05-07519c22bb29",
                                        "entry_id": "e0906e2d-6ad7-3c2f-a198-375e6bd5100d",
                                        "glosses": [
                                            "Qui est plein de magnificence, somptueux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4b426fc-54b7-44a7-9fc9-a2efbd68adbc",
                                                "sense_id": "c8796be9-2f05-38a0-9e05-07519c22bb29",
                                                "text": "À Saint-Georges, un hôtel possédait une magnifique piscine, où je vis plusieurs fêtes nautiques."
                                            },
                                            {
                                                "example_id": "bbf407ed-1292-439c-8bef-e6e6a7ab01c4",
                                                "sense_id": "c8796be9-2f05-38a0-9e05-07519c22bb29",
                                                "text": "[…] — (les Martiens, au moyen d’une drogue procurant des rêves magnifiques, supprimaient les malades, les infirmes et les mal nés, de sorte que, chez eux, la pitié était des plus rudimentaires) — […]"
                                            },
                                            {
                                                "example_id": "38d496cf-6bfa-422f-bf3f-5b04f06def33",
                                                "sense_id": "c8796be9-2f05-38a0-9e05-07519c22bb29",
                                                "text": "C’était magnifique, grandiose, magique. Vous savez, tous ces mots qui n’en peuvent plus d’être éblouis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca1d2312-4636-3437-a16a-c86b963d3027",
                                        "entry_id": "e0906e2d-6ad7-3c2f-a198-375e6bd5100d",
                                        "glosses": [
                                            "Très beau, splendide."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "143b8c6f-5970-40f3-814a-f9fa5573f8b6",
                                                "sense_id": "ca1d2312-4636-3437-a16a-c86b963d3027",
                                                "text": "À cette époque où les voitures n’étaient pas inventées, les dames allaient à cheval ou en litière, et les cours pouvaient être magnifiques, sans que les chevaux ou les voitures les gâtassent."
                                            },
                                            {
                                                "example_id": "2de80019-c301-4b18-8835-c5e784670ff2",
                                                "sense_id": "ca1d2312-4636-3437-a16a-c86b963d3027",
                                                "text": "C’est ma tête inclinée qui met son ombre à ton visage ; c’est sous mes yeux que tu reposes, confiant et magnifique, et dans le grand silence, je n’entends que ton cœur qui bat."
                                            },
                                            {
                                                "example_id": "b0919a0d-b423-4b07-b421-0769d2e2b9f6",
                                                "sense_id": "ca1d2312-4636-3437-a16a-c86b963d3027",
                                                "text": "Le Caux est une terre à blé, mais la vallée verdoyante du Bray est un immense et magnifique pâturage où un élevage intensif se pratique dans des prés incomparables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7dba9af-6902-3329-a538-1150551661de",
                                        "entry_id": "e0906e2d-6ad7-3c2f-a198-375e6bd5100d",
                                        "glosses": [
                                            "Pompeux, éclatant, qui fait espérer de grandes choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4db39ec-66d0-4203-86be-0a7618f08a8e",
                                                "sense_id": "c7dba9af-6902-3329-a538-1150551661de",
                                                "text": "Philéas Beauvisage, garçon sage et plein de respect pour sa mère, eut bientôt conclu l’affaire avec son patron ; et comme il tenait de ses parents la bosse que les phrénologistes appellent l’acquisivité, son ardeur de jeunesse se porta sur ce commerce qui lui parut magnifique et qu’il voulut agrandir par la spéculation."
                                            },
                                            {
                                                "example_id": "bdb88ee4-3d27-4f4f-ab63-1ce3838fe519",
                                                "sense_id": "c7dba9af-6902-3329-a538-1150551661de",
                                                "text": "Des titres magnifiques."
                                            },
                                            {
                                                "example_id": "83cf1b56-584e-4a7a-b105-f4025c632e94",
                                                "sense_id": "c7dba9af-6902-3329-a538-1150551661de",
                                                "text": "Des promesses magnifiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e138fa1e-fb69-3407-95ff-0a658daa3d97",
                                        "entry_id": "e0906e2d-6ad7-3c2f-a198-375e6bd5100d",
                                        "glosses": [
                                            "Qui a des manières fastueuses, en parlant d’une personne, qui a grand air, qui se plaît à faire des libéralités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c54396ce-b30a-4652-afee-3483768fb70c",
                                                "sense_id": "e138fa1e-fb69-3407-95ff-0a658daa3d97",
                                                "text": "Un seigneur magnifique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ef289a-d07d-3e71-afb1-bd63858377ba",
                                        "entry_id": "e0906e2d-6ad7-3c2f-a198-375e6bd5100d",
                                        "glosses": [
                                            "Beau par sa grandeur."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6663066-64a5-4428-976a-8c347ee55055",
