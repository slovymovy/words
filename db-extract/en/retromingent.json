                        "glosses": [
                            "That urinates backwards; also used of such urination."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "87d06210-1608-4d56-ba7e-24e523487e46",
                                "sense_id": "d6b1ec20-bd70-3d62-a6c7-4e39b13e0255",
                                "text": "It sat down at last and, as if to express once and for all its disenchantment with the whole sum of canine existence, delivered itself of a retromingent puddle on the beautiful Shiraz."
                            },
                            {
                                "example_id": "67b66554-e9bb-4b20-92a2-0bfa9ec64e15",
                                "sense_id": "d6b1ec20-bd70-3d62-a6c7-4e39b13e0255",
                                "text": "\"Additionally, camels are retromingent animals, and so spectators would be advised to beware not only of flying saliva but of pitched urine as well.\""
                            }
                        ]
                    },
