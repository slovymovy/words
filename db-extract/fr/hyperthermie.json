                    {
                        "translation_id": "07a6d920-3566-4e5f-b766-773d1bd4408c",
                        "source_entry_id": "493fbe4d-3710-356e-988d-61c0cc92df4c",
                        "source_sense_id": "bbbeb444-1410-3964-8996-d1b5a0cabb91",
                        "source_sense_description": "hyperthermie",
