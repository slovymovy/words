                                                "sense_id": "4c0952c1-b655-3cba-a8bb-69e31fc82557",
                                                "text": "List był datowany na godzinę siódmą wieczorem 14 kwietnia, a zawierał informację, że oto po upływie dwunastu godzin od chwili podpisania listu wojska austriackie przekroczą granicę Księstwa Warszawskiego."
                                            },
                                            {
                                                "example_id": "d835c58e-8d62-4e63-814e-06276dfc835c",
                                                "sense_id": "4c0952c1-b655-3cba-a8bb-69e31fc82557",
                                                "text": "Koncert rozpocznie się wieczorem i potrwa całą noc."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "bad9bad0-6ea1-3d7f-87e5-d2f4cd91ae1a",
                                        "entry_id": "c0786e0a-9d37-3012-b543-f7b9ed8272dc",
                                        "glosses": [
                                            "impreza"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bba87b7-5ae9-4230-8d41-30d0e41a6f88",
                                                "sense_id": "bad9bad0-6ea1-3d7f-87e5-d2f4cd91ae1a",
                                                "text": "W dzisiejszym wieczorze wystąpi gościnnie kabaret „Potem”."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "5d922688-40d5-33e3-89eb-7792cdee69a2",
                                        "entry_id": "c0786e0a-9d37-3012-b543-f7b9ed8272dc",
                                        "glosses": [
                                            "zabawa taneczna"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1abebb-094c-4167-8cf2-edf07d32b88a",
                                                "sense_id": "5d922688-40d5-33e3-89eb-7792cdee69a2",
                                                "text": "Gdy raz na tańcujący wieczór miała iść Antolka, / to do kuzyna Bolka mówiła – płacząc – tak: / „Ja nie mam co na siebie włożyć (…)”"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "wieczór",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8417b3c4-eb87-3113-966e-18dc7aed9c73",
                                        "entry_id": "eb039dce-209d-3e7c-b2e7-cbdcfa04fbd4",
                                        "glosses": [
                                            "w czasie wieczoru (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76a5c33-d495-4049-805c-68811df8da43",
                                                "sense_id": "8417b3c4-eb87-3113-966e-18dc7aed9c73",
                                                "text": "Dziś wieczór idziemy do kina."
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
