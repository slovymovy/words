                "senses": [
                    {
                        "sense_id": "436b378d-ffe3-3e92-9c58-a6973e9fe2d5",
                        "entry_id": "37b88849-baf4-3b3b-bcdf-793860b563fe",
                        "glosses": [
                            "Faire la publicité."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "31198449-caa4-42e1-a2c0-71e2b7e6eae4",
                                "sense_id": "436b378d-ffe3-3e92-9c58-a6973e9fe2d5",
                                "text": "Avait effectivement quelques mois plus tôt découpé dans un journal un lapin SM qui pubait pour un fournisseur internet, savait pas quoi en foutre mais maintenant oui. Colle le montage photo sur une feuille blanche, […]."
                            },
                            {
                                "example_id": "fc097b0e-f14d-41f4-b6df-2d97048a78ef",
                                "sense_id": "436b378d-ffe3-3e92-9c58-a6973e9fe2d5",
                                "text": "Les causent néo-réacs s'agitent et se remuent comme si elles étaient des progrès. Et, hypocrites et clinquantes, elles se pubent, et elles se promeuvent comme du pétant, du rutilant, du flambant neuf."
                            }
                        ]
                    }
