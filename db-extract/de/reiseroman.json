                        "glosses": [
                            "Roman, in dem eine Reise dargestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53df7855-e886-482c-a750-82936467642c",
                                "sense_id": "33e62a77-3471-3502-9b98-d7f1122edf43",
                                "text": "„Diese mehrtägige Reise durch die vielen Kleinstaaten des damaligen Italien ist in ihrem Umfang fast ein zweiter Roman im Roman, äußerlich ganz im Muster des damals gängigen Reiseromans.“"
                            },
                            {
                                "example_id": "26ef3769-3a0d-4529-aa4a-78b13879cf6a",
                                "sense_id": "33e62a77-3471-3502-9b98-d7f1122edf43",
                                "text": "„Das Genre, das er auf diese Weise gewissermaßen streift, ist der Reise- und Abenteuerroman.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
