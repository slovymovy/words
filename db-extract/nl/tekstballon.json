                                "sense_id": "1a1a7b0e-3543-318a-8ea2-dfe69559726b",
                                "text": "In de strip staan de woorden in een tekstballon om aan te geven wat de personages zeggen.",
                                "translation": "In the comic, the words are placed in a speech bubble to indicate what the characters are saying.",
                                "english": "In the comic, the words are placed in a speech bubble to indicate what the characters are saying."
                            },
                            {
                                "example_id": "b9f914f0-4d50-4ac8-93bd-c12e809375b9",
                                "sense_id": "1a1a7b0e-3543-318a-8ea2-dfe69559726b",
                                "text": "De cartoonist gebruikte creatieve tekstballonnen om de grappige dialogen weer te geven.",
                                "translation": "The cartoonist used creative speech bubbles to represent the humorous dialogues.",
                                "english": "The cartoonist used creative speech bubbles to represent the humorous dialogues."
                            },
                            {
                                "example_id": "08e0cf3a-7fdf-4147-a30f-f7822fb0c34b",
                                "sense_id": "1a1a7b0e-3543-318a-8ea2-dfe69559726b",
                                "text": "In strips en stripverhalen worden vaak tekstballonnetjes gebruikt om de dialogen weer te geven.",
                                "translation": "Speech bubbles are commonly used in comics and graphic novels to display dialogues.",
                                "english": "Speech bubbles are commonly used in comics and graphic novels to display dialogues."
