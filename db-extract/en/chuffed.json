                                    {
                                        "sense_id": "e944a06f-75cc-316e-9198-00abd3bb9e22",
                                        "entry_id": "20ca727c-cc6a-31c0-8af0-b0c9d3265c30",
                                        "glosses": [
                                            "voller Genugtuung/ohne jede Beanstandung angesichts einer Situation oder eines Umstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a71194-6637-46d2-a0b7-8675d1a3fdb6",
                                                "sense_id": "e944a06f-75cc-316e-9198-00abd3bb9e22",
                                                "text": "Er arbeitete unermüdlich, nur damit sein Chef zufrieden sei."
                                            },
                                            {
                                                "example_id": "cfb42ec2-39b8-4ad9-bb28-ab8dd0413e88",
                                                "sense_id": "e944a06f-75cc-316e-9198-00abd3bb9e22",
                                                "text": "„Was frag' ich viel nach Geld und Gut, | Wenn ich zufrieden bin.“ (aus einem deutschen Volkslied)"
                                            },
                                            {
                                                "example_id": "533c2f0a-b89a-42ed-80a5-f7fb71f9b494",
                                                "sense_id": "e944a06f-75cc-316e-9198-00abd3bb9e22",
                                                "text": "„Er sagte, er sei sehr zufrieden mit der Treue und Tüchtigkeit der Leute, die jetzt noch dageblieben waren, und zu ihrer Ermutigung wolle er die Heuer der von Bord Gegangenen unter sie aufteilen lassen; er sei sehr froh, daß das Schiff nun frei sei von einem so meuterischen Haufen, der keinerlei Grund habe, aufsässig zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
