                "senses": [
                    {
                        "sense_id": "28e23376-11e7-32cb-855d-bdb183d25911",
                        "entry_id": "e3b8ac81-2856-301e-93db-9355d75d6530",
                        "glosses": [
                            "pakket met eerste benodigdheden om iets te kunnen doen of maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a640cf3-4752-419c-a60d-4bab230b7512",
                                "sense_id": "28e23376-11e7-32cb-855d-bdb183d25911",
                                "text": "Startset voor het breien van Grolse wanten: Bij de Sociëteit Grolse Wanten is een doe-het-zelf pakket verkrijgbaar voor het breien van Grolse wanten. Medewerkers van de sociëteit verkopen het startpakket zaterdag op de kerstmarkt in Groenlo, die van 's middags vier tot 's avonds negen uur in het centrum wordt gehouden."
                            },
                            {
                                "example_id": "3ce1d44d-dd40-4711-af13-60d193a313c9",
                                "sense_id": "28e23376-11e7-32cb-855d-bdb183d25911",
                                "text": "Het Hue-systeem laat zich bedienen via een app op telefoon of tablet, maar dat is niet altijd handig. Er is een Hue Tap – een draadloze afstandsbediening met vier standen – maar die kost 60 euro. Een fikse investering voor een systeem dat al prijzig is (200 euro voor een Hue-startset en 60 euro voor een los lampje)."
                            },
                            {
                                "example_id": "d042ae90-21b7-4467-ba8c-4ef97c88e7ab",
                                "sense_id": "28e23376-11e7-32cb-855d-bdb183d25911",
                                "text": "Miljoenen borden en elastiekjes gingen er dit jaar over de toonbank, zegt importeur IT Netherlands. Die levert officiële Loom-producten aan ketens als Intertoys, Bart Smit en Blokker. Sinds vorig jaar september heeft Choon meer dan 1,2 miljoen beginnerspakketten verkocht, zei hij in een interview met de Wall Street Journal. In Nederland kost zo’n startset 19,90 euro."
                            }
                        ]
                    }
