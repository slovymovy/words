                        "examples": [
                            {
                                "example_id": "200838a7-e80a-49f5-8e27-7d88eebb9bd3",
                                "sense_id": "073eb852-6135-35c6-b7c7-2bdd341a2252",
                                "text": "Jetzt tut er sich wieder hervor, der Kalfaktor."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "847b3aa4-a412-31e5-b9f7-60cd067897c1",
                        "entry_id": "6b249f4d-e0d7-3acc-a191-7f1eab50f9ad",
                        "glosses": [
                            "Gefangener, der als Hilfskraft Hilfsdienste für die Vollzugsbediensteten leistet und die Verwaltung einer Justizvollzugsanstalt oder in einem Gefängnis unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c971cb9-94eb-4872-8281-605085f162ee",
                                "sense_id": "847b3aa4-a412-31e5-b9f7-60cd067897c1",
                                "text": "»Es heißt, du seist jetzt ein Kalfaktor«, sagte er verärgert und verlieh dem Satz mit einem Schlag des Hammers Nachdruck."
                            },
                            {
                                "example_id": "958ea1ea-e2c8-4907-a672-bec9d9402282",
                                "sense_id": "847b3aa4-a412-31e5-b9f7-60cd067897c1",
                                "text": "„Als die Kalfaktoren um sechs nach Kübeln und Wasser laufen, die Zellenriegen zurückdonnern und die Schlösser knacken, ist Kufalt schon längst beim Reinigen des Zementfußbodens.“"
                            },
                            {
                                "example_id": "96f6580b-734a-46ab-ac6a-cd3f6895d265",
                                "sense_id": "847b3aa4-a412-31e5-b9f7-60cd067897c1",
                                "text": "„Zur Menagestunde sind manche Türen offen: die in die Küche, die, aus denen die Kalfaktoren kommen, um auszufegen oder Brot zu holen.“"
                            },
                            {
                                "example_id": "1514cbbd-8a91-44f3-b167-1b0da4f425fc",
                                "sense_id": "847b3aa4-a412-31e5-b9f7-60cd067897c1",
                                "text": "„Hier gibt es sogar die Möglichkeit, befördert zu werden, und Hille wird dann auch bald Kalfaktor.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
