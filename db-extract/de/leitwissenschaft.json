                "senses": [
                    {
                        "sense_id": "8cc2b90b-28c2-37c4-81c6-af79ea4d21bf",
                        "entry_id": "14e25b91-ca1b-3613-94bc-aba01268b4e4",
                        "glosses": [
                            "diejenige Wissenschaft, der von führenden Kreisen einer Gesellschaft eine wissenschaftliche Leitfunktion für andere Wissensbereiche nachgesagt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eeb40fc-02fe-4b96-95a5-eee0855523a5",
                                "sense_id": "8cc2b90b-28c2-37c4-81c6-af79ea4d21bf",
                                "text": "„Wird die Biologie im neuen Jahrhundert die Physik als Leitwissenschaft ablösen?“"
                            },
                            {
                                "example_id": "4e2165c6-11b0-4dcc-ad72-4773b9d6c873",
                                "sense_id": "8cc2b90b-28c2-37c4-81c6-af79ea4d21bf",
                                "text": "„Die Hirnforschung scheint neben der Biotechnologie zu einer Leitwissenschaft unserer Zeit geworden zu sein.“"
                            },
                            {
                                "example_id": "68774764-0d07-4892-b4f1-99e4d9fad341",
                                "sense_id": "8cc2b90b-28c2-37c4-81c6-af79ea4d21bf",
                                "text": "„Denn zu ebenjener Zeit, als die Deutschen ihre kolonialen Ambitionen entdeckten, war die Bakteriologie zur neuen Leitwissenschaft der Medizin aufgestiegen.“"
                            },
                            {
                                "example_id": "df4a283c-9f35-4447-b526-b33f921b9958",
                                "sense_id": "8cc2b90b-28c2-37c4-81c6-af79ea4d21bf",
                                "text": "„Im 19. wird die Geschichte zu einer Leitwissenschaft in Geistesdingen avancieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
