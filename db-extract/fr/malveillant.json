                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b160a5c-3b7c-35b8-a1a7-46526fe6a3df",
                        "entry_id": "86ef95d4-7e64-3dc2-873e-2c76ca56eb18",
                        "glosses": [
                            "Porté à vouloir, à souhaiter du mal à autrui."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ca33064f-9d89-359a-ab81-51b5d104f1f5",
                        "entry_id": "86ef95d4-7e64-3dc2-873e-2c76ca56eb18",
                        "glosses": [
                            "Qui a de la malveillance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed60d3f-51ae-4a55-8011-d2caaef9a8bc",
                                "sense_id": "ca33064f-9d89-359a-ab81-51b5d104f1f5",
                                "text": "Les habitants des villas et des pavillons environnants passèrent rapidement de la curiosité malveillante à l’agression."
                            }
                        ]
                    },
                    {
                        "sense_id": "63311b3c-1262-33e6-b269-4222747c2e88",
                        "entry_id": "86ef95d4-7e64-3dc2-873e-2c76ca56eb18",
                        "glosses": [
                            "Où il y a de la malveillance."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b5e72124-18d5-4624-9277-45ff559affe0",
                                "sense_id": "63311b3c-1262-33e6-b269-4222747c2e88",
                                "text": "Le code malveillant peut arriver dans des spams ou dans des messages d’hameçonnage, ou dans des courriels envoyés automatiquement par les ordinateurs de correspondants connus qui ont été infectés à leur insu."
                            },
                            {
                                "example_id": "2febd8f6-31a0-426c-ba6d-09fb15c5489a",
                                "sense_id": "63311b3c-1262-33e6-b269-4222747c2e88",
                                "text": "C’étaient les civiques, assisté de plusieurs jeunes gens de la Légion Urbaine, qui lui avaient fait faire la désagréable culbute : ma qualité de légionnaire me désigna à son ressentiment ; et, depuis lors, dans tous les journaux qui ont publié sa prose, le rancunier ex-secrétaire de Gent n’a jamais manqué l’occasion de décocher contre moi ses critiques malveillantes et rageuses."
                            },
                            {
                                "example_id": "5881e905-8230-42d2-9026-02fc792f9542",
                                "sense_id": "63311b3c-1262-33e6-b269-4222747c2e88",
                                "text": "Les ex-directeurs ou ex-directrices observent alors leurs nouveaux supérieurs du second degré avec des intentions malveillantes."
                            },
                            {
                                "example_id": "c844174f-2601-43fe-9e94-d7596c8c025f",
                                "sense_id": "63311b3c-1262-33e6-b269-4222747c2e88",
                                "text": "Toutefois, une analyse judiciaire approfondie du téléphone a permis d’identifier la présence d’un programme malveillant dans ce dernier. Ce programme a notamment pour conséquence l’émission de SMS sans action de la part de l’utilisateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61ddac1b-c841-4b6e-b23b-5a45f1190754",
                        "source_entry_id": "86ef95d4-7e64-3dc2-873e-2c76ca56eb18",
                        "target_lang_word": "böswillig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "böswillig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8826e7ae-ec93-361f-ab54-fe239e845a4f",
                                        "entry_id": "9cc92a43-d8eb-3f13-a3b4-2a206ca54075",
                                        "glosses": [
                                            "mit einer bösen Absicht handelnd, keine guten Absichten habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a974af-ae09-4e39-a051-424b161449d5",
                                                "sense_id": "8826e7ae-ec93-361f-ab54-fe239e845a4f",
                                                "text": "„Als ich meinen Bericht, der sich auf den englischen und den Schweizer Rundfunk stützte, zum besten gab, waren sie eher der Meinung, daß meine Version böswilliger Feindpropaganda entspreche, als zuzugeben, daß die ihre ein Greuelmärchen der Nazis sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b777b312-0b32-434c-b242-94abe1c1ff47",
                        "source_entry_id": "86ef95d4-7e64-3dc2-873e-2c76ca56eb18",
                        "target_lang_word": "malevolent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malevolent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15026d42-b81a-3a98-84ff-1bf740aec07b",
                                        "entry_id": "4189e2ca-2daa-3e69-b010-ca3a3173a15d",
                                        "glosses": [
                                            "Having or displaying ill will; wishing harm on others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95adf193-3f7b-469f-9a36-7a397f9ba1df",
                                                "sense_id": "15026d42-b81a-3a98-84ff-1bf740aec07b",
                                                "text": "In Iraq the bullying continued. After she witnessed the death of a colleague, Manning felt how “with enough grief, adrenaline and fear”, war can turn anyone “amoral, even malevolent”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a86dfed7-c0f3-3ed9-8093-98df04704aa2",
                                        "entry_id": "4189e2ca-2daa-3e69-b010-ca3a3173a15d",
                                        "glosses": [
                                            "Having an evil or harmful influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08618030-4610-4021-b5bd-f120fda90e77",
                                                "sense_id": "a86dfed7-c0f3-3ed9-8093-98df04704aa2",
                                                "text": "Vela, Javier Hernández and Lozano switched positions with a thrillingly malevolent sense of purpose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dac1ef72-d613-4b84-9d8f-6e969e9d7015",
                        "source_entry_id": "86ef95d4-7e64-3dc2-873e-2c76ca56eb18",
                        "target_lang_word": "κακόβουλος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
