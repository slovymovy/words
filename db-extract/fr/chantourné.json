                        "sense_id": "b8fad2c3-59eb-3090-bc42-4cc752a3df9e",
                        "entry_id": "ca92351f-3aec-3bfb-9a6a-b9a4c25e3fcf",
                        "glosses": [
                            "Qui a fait l'objet d'un chantournage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c60bbab-4f72-48d5-bfe7-25a9c6ec4a1b",
                                "sense_id": "b8fad2c3-59eb-3090-bc42-4cc752a3df9e",
                                "text": "Elle et moi nous nous trouvons maintenant à la bouche d’une station de métro, debout l’un devant l’autre, près des fontes chantournées de la balustrade."
                            },
                            {
                                "example_id": "9669f223-6464-444c-8888-62b408a0acae",
                                "sense_id": "b8fad2c3-59eb-3090-bc42-4cc752a3df9e",
                                "text": "Arthur et Mathilde l’avaient abondamment garni d’un mobilier moderne, paravents de palissandre et meubles d’ébène exagérément chantournés."
                            },
                            {
                                "example_id": "e4df7b6e-9599-4741-88fc-1c319f81aa54",
                                "sense_id": "b8fad2c3-59eb-3090-bc42-4cc752a3df9e",
                                "text": "La reine a prononcé une de ces phrases chantournées dont elle a le secret"
                            },
                            {
                                "example_id": "8ebef068-3ab8-4280-8224-0dc4c0883cf4",
                                "sense_id": "b8fad2c3-59eb-3090-bc42-4cc752a3df9e",
                                "text": "Le hasard des ombres portées qui se déplacent la journée en suivant la course du soleil a dessiné des formes chantournées dans la neige durcie."
                            }
                        ]
                    }
