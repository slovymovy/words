{
    "word_family": [
        "occasional",
        "occasionally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d9ba3dd-cd9f-3785-9f71-a83fe830cffc",
                    "sense_definition": "A particular time or instance when something happens.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "instance_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have met him on several <w>occasions</w> to discuss the project.",
                            "target_lang_translations": {
                                "ru": "Я встречался с ним несколько <w>раз</w>, чтобы обсудить проект.",
                                "zh": "我曾与他见过几<w>次</w>面，讨论这个项目。",
                                "de": "Ich habe ihn bei mehreren <w>Gelegenheiten</w> getroffen, um das Projekt zu besprechen."
                            }
                        },
                        {
                            "text": "On this <w>occasion</w>, we decided to stay home instead of going out.",
                            "target_lang_translations": {
                                "ru": "В этот <w>раз</w> мы решили остаться дома, вместо того чтобы куда-то идти.",
                                "zh": "在这次<w>场合</w>中，我们决定待在家里，而不是出去。",
                                "de": "Dieses <w>Mal</w> haben wir uns entschieden, zu Hause zu bleiben, anstatt auszugehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "time",
                        "instant",
                        "moment",
                        "juncture",
                        "point in time",
                        "instance",
                        "event"
                    ],
                    "common_phrases": [
                        "on this occasion",
                        "on several occasions",
                        "on rare occasions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное время или случай, когда что-то происходит.",
                        "zh": "指某事发生的特定时间或实例。",
                        "de": "Ein bestimmter Zeitpunkt oder ein Ereignis, zu dem etwas geschieht."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случай",
                                "target_lang_sense_clarification": "обстоятельство, происшествие"
                            },
                            {
                                "target_lang_word": "раз",
                                "target_lang_sense_clarification": "момент времени, кратное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "次",
                                "target_lang_sense_clarification": "表示动作发生的次数"
                            },
                            {
                                "target_lang_word": "场合",
                                "target_lang_sense_clarification": "指特定的时间或情境"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Mal",
                                "target_lang_sense_clarification": "Bezeichnet einen bestimmten Zeitpunkt oder die Häufigkeit eines Ereignisses."
                            },
                            {
                                "target_lang_word": "Gelegenheit",
                                "target_lang_sense_clarification": "Ein günstiger Zeitpunkt oder Umstand für eine bestimmte Handlung."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "695ffd9e-763f-3bb4-b4f3-5b638f44b978",
                    "sense_definition": "A special or important event, celebration, or ceremony.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "special_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Having the whole family together for dinner was quite an <w>occasion</w>.",
                            "target_lang_translations": {
                                "ru": "Собрать всю семью на ужин было целым <w>событием</w>.",
                                "zh": "全家人聚在一起吃晚饭真是一件<w>盛事</w>。",
                                "de": "Die ganze Familie zum Abendessen zusammenzuhaben, war ein besonderes <w>Ereignis</w>."
                            }
                        },
                        {
                            "text": "She bought a new dress for the special <w>occasion</w>.",
                            "target_lang_translations": {
                                "ru": "Она купила новое платье по особому <w>случаю</w>.",
                                "zh": "她为这个特殊<w>场合</w>买了一件新裙子。",
                                "de": "Sie hat für diesen besonderen <w>Anlass</w> ein neues Kleid gekauft."
                            }
                        }
                    ],
                    "synonyms": [
                        "event",
                        "affair",
                        "happening",
                        "occurrence",
                        "episode"
                    ],
                    "common_phrases": [
                        "special occasion",
                        "mark the occasion",
                        "quite an occasion",
                        "momentous occasion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое или важное событие, празднование или церемония.",
                        "zh": "指特殊的或重要的活动、庆典或仪式。",
                        "de": "Ein besonderes oder wichtiges Ereignis, eine Feier oder eine Zeremonie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "событие",
                                "target_lang_sense_clarification": "важное происшествие, мероприятие"
                            },
                            {
                                "target_lang_word": "торжество",
                                "target_lang_sense_clarification": "праздник, церемония"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盛事",
                                "target_lang_sense_clarification": "重大的活动或事件"
                            },
                            {
                                "target_lang_word": "场合",
                                "target_lang_sense_clarification": "指需要特别对待的特定情境"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Anlass",
                                "target_lang_sense_clarification": "Ein Ereignis, das einen Grund für eine Feier oder ein Treffen bietet."
                            },
                            {
                                "target_lang_word": "Ereignis",
                                "target_lang_sense_clarification": "Ein bedeutsames Geschehen oder eine besondere Begebenheit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b56cc35d-b481-3821-9dab-fe55dd230fcb",
                    "sense_definition": "A suitable or favorable time to do something; an opportunity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opportunity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seized the <w>occasion</w> to express his views to the board.",
                            "target_lang_translations": {
                                "ru": "Он воспользовался <w>случаем</w>, чтобы выразить свои взгляды совету директоров.",
                                "zh": "他抓住这个<w>机会</w>向董事会表达了自己的观点。",
                                "de": "Er nutzte die <w>Gelegenheit</w>, um dem Vorstand seine Ansichten darzulegen."
                            }
                        },
                        {
                            "text": "The team rose to the <w>occasion</w> and won the championship match.",
                            "target_lang_translations": {
                                "ru": "Команда оказалась на <w>высоте</w> и выиграла финальный матч чемпионата.",
                                "zh": "团队在<w>关键时刻</w>表现出色，赢得了冠军赛。",
                                "de": "Das Team wuchs über sich hinaus und gewann das Meisterschaftsspiel."
                            }
                        }
                    ],
                    "synonyms": [
                        "moment",
                        "time"
                    ],
                    "common_phrases": [
                        "seize the occasion",
                        "rise to the occasion",
                        "take the occasion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящее или благоприятное время для совершения чего-либо; возможность.",
                        "zh": "做某事的合适或有利时机；机会。",
                        "de": "Ein geeigneter oder günstiger Zeitpunkt, um etwas zu tun; eine Chance."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возможность",
                                "target_lang_sense_clarification": "шанс, благоприятное условие"
                            },
                            {
                                "target_lang_word": "случай",
                                "target_lang_sense_clarification": "удобный момент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机会",
                                "target_lang_sense_clarification": "有利的时机"
                            },
                            {
                                "target_lang_word": "时机",
                                "target_lang_sense_clarification": "适合做某事的时间"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gelegenheit",
                                "target_lang_sense_clarification": "Ein günstiger Umstand oder eine Chance, etwas zu erreichen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a73ace86-25a7-3753-b704-d115043a094c",
                    "sense_definition": "A reason, cause, or justification for doing something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reason_cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have no <w>occasion</w> to feel offended by his remarks.",
                            "target_lang_translations": {
                                "ru": "У вас нет <w>повода</w> обижаться на его замечания.",
                                "zh": "你没有<w>理由</w>因为他的话而感到被冒犯。",
                                "de": "Sie haben keinen <w>Grund</w>, sich durch seine Bemerkungen beleidigt zu fühlen."
                            }
                        },
                        {
                            "text": "I had <w>occasion</w> to visit the city last week for business.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе мне представился <w>случай</w> посетить город по делам.",
                                "zh": "上周我因公事有<w>理由</w>去了一趟那个城市。",
                                "de": "Ich hatte letzte Woche geschäftlich <w>Gelegenheit</w>, die Stadt zu besuchen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have occasion to",
                        "no occasion for"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причина, основание или оправдание для совершения чего-либо.",
                        "zh": "做某事的理由、原因或正当依据。",
                        "de": "Ein Grund, eine Ursache oder eine Rechtfertigung für eine Handlung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повод",
                                "target_lang_sense_clarification": "причина, предлог"
                            },
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "обоснование, причина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理由",
                                "target_lang_sense_clarification": "做某事的根据"
                            },
                            {
                                "target_lang_word": "缘由",
                                "target_lang_sense_clarification": "事情发生的原因"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Anlass",
                                "target_lang_sense_clarification": "Ein Grund oder Beweggrund für ein bestimmtes Verhalten."
                            },
                            {
                                "target_lang_word": "Grund",
                                "target_lang_sense_clarification": "Die Ursache oder Begründung für eine Handlung."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c3053c0-188a-3e79-bd2c-bbd77d69ffaf",
                    "sense_definition": "To cause something to happen or to bring something about.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "to_cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy <w>occasioned</w> a great deal of debate among the staff.",
                            "target_lang_translations": {
                                "ru": "Новая политика <w>вызвала</w> бурную дискуссию среди сотрудников.",
                                "zh": "新政策在员工中<w>引起</w>了大量的争论。",
                                "de": "Die neue Richtlinie hat unter den Mitarbeitern eine große Debatte <w>veranlasst</w>."
                            }
                        },
                        {
                            "text": "Her sudden departure <w>occasioned</w> much surprise in the office.",
                            "target_lang_translations": {
                                "ru": "Её внезапный отъезд <w>породил</w> большое удивление в офисе.",
                                "zh": "她的突然离职在办公室里<w>引起</w>了极大的惊讶。",
                                "de": "Ihr plötzlicher Abschied hat im Büro für viel Überraschung gesorgt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть причиной чего-либо, вызывать что-либо.",
                        "zh": "导致某事发生或引起某事。",
                        "de": "Etwas verursachen oder herbeiführen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "провоцировать появление чего-либо"
                            },
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "быть источником чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引起",
                                "target_lang_sense_clarification": "导致某种结果"
                            },
                            {
                                "target_lang_word": "导致",
                                "target_lang_sense_clarification": "造成某种后果"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "veranlassen",
                                "target_lang_sense_clarification": "Jemanden dazu bewegen, etwas zu tun, oder eine Handlung auslösen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}