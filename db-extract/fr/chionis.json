                        "examples": [
                            {
                                "example_id": "18b72f68-7c4a-495f-b9a7-5af1848c89ee",
                                "sense_id": "e757f7dd-3a95-3734-a5d3-8aab0b4561ef",
                                "text": "Chez les Vertébrés terrestres, on ne rencontre aucun mammifère et seulement 2 espèces d’oiseaux : le canard d’Eaton et le bec-en-fourreau (ou chionis)."
                            },
                            {
                                "example_id": "64cfcd36-49bf-4c9e-9db9-d99d28ef1592",
                                "sense_id": "e757f7dd-3a95-3734-a5d3-8aab0b4561ef",
                                "text": "Le Bec en Fourreau, plus couramment appelé chionis, est un opportuniste qui peut être tour à tour : omnivore, prédateur, charognard."
                            },
                            {
                                "example_id": "d6056abb-80d4-4ab6-90ad-38072ba428d6",
                                "sense_id": "e757f7dd-3a95-3734-a5d3-8aab0b4561ef",
                                "text": "La Famille des Chionis est apparentée aux Limicoles (Bécasses, Chevaliers…). Les plaques cornées du bec grandissent avec l’âge pour atteindre une taille définitive à la maturité sexuelle."
                            }
                        ]
