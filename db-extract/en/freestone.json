                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
                                        "entry_id": "e1de5e8d-93cc-329d-8c07-e83b238774e2",
                                        "glosses": [
                                            "eine bunte Vielfalt an gerundeten Gesteinsbruchstücken oder Mineralien in einer meist aus Sand, Kalk und/oder Ton bestehenden Grundmasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85730e1-9ddf-441b-9a1f-3ad1b8c80b3b",
                                                "sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
                                                "text": "Konglomerate aus Sedimentgestein bilden sich durch Verfestigung von abgelagertem Geröll in alten Schotterfeldern oder Schwemmfächern."
                                            },
                                            {
                                                "example_id": "0b37ca96-6477-4dbe-b4b6-dc4f666b6d17",
                                                "sense_id": "ed7c0b16-4caa-39e9-84f5-6117c71fcd02",
                                                "text": "„In vielen Teilen der Welt ist die Erdkruste wie ein Sandwich, das aus Schichten von Millionen Jahre altem Sedimentgestein besteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb155074-04d1-48fa-b553-7628bebd92c8",
                        "source_entry_id": "e9889fc0-30c0-3222-b78d-192d966e358b",
                        "source_sense_description": "sedimentary rock, most commonly sandstone or limestone",
                        "target_lang_word": "песча́ник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "песча́ник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7001370a-cadb-3dd9-976a-6ed607441676",
                                        "entry_id": "95cf05ee-7927-356f-b42e-a690bc29375c",
                                        "glosses": [
                                            "геол. осадочная горная порода, состоящая из спрессованных зёрен одного или нескольких минералов, образующаяся из песка посредством цементации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01004384-1aaf-4bcc-a8cd-4e36bdaa6f49",
                                                "sense_id": "7001370a-cadb-3dd9-976a-6ed607441676",
                                                "text": "Но в соседних районах часты обнажения желтоватых мергелевых песчаников, расположенных вздыбленными пластами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88a84991-a29c-42d7-8628-2a5773d20301",
                        "source_entry_id": "e9889fc0-30c0-3222-b78d-192d966e358b",
                        "source_sense_description": "sedimentary rock, most commonly sandstone or limestone",
                        "target_lang_word": "известня́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "известня́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc7c7d4-3f20-34ef-ac2b-706e12bf76bd",
                                        "entry_id": "05409479-43d7-311a-9dfb-9c5bcbda6aa3",
                                        "glosses": [
                                            "геол. минерал, осадочная горная порода органического, реже хемогенного происхождения, состоящая преимущественно из карбоната кальция, в форме кристаллов кальцита различного размера"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb41108c-7163-4b20-92c0-d805d06c27d9",
                                                "sense_id": "6dc7c7d4-3f20-34ef-ac2b-706e12bf76bd",
                                                "text": "Ярус сложен карбонатами двух типов: известняк плотный, крепкий, мелкокристаллический и известняк пористый, кавернозный, оолитовой текстуры."
                                            },
                                            {
                                                "example_id": "aeb8f704-e10c-42d7-a375-e10750dc495b",
                                                "sense_id": "6dc7c7d4-3f20-34ef-ac2b-706e12bf76bd",
                                                "text": "Сопки были покрыты болотным покровом, и только лысины безлесных сопок сверкали голым известняком, отполированным бурями и ветрами."
                                            },
                                            {
                                                "example_id": "a33e9cba-6f95-4183-985c-51eeb35f29fe",
                                                "sense_id": "6dc7c7d4-3f20-34ef-ac2b-706e12bf76bd",
                                                "text": "Обыкновенный камень ― известняк, мрамор, гранит ― это общая масса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28970d19-22a0-3dda-ac4b-8b342a7eca5d",
                                        "entry_id": "05409479-43d7-311a-9dfb-9c5bcbda6aa3",
                                        "glosses": [
                                            "неисч. строит. строительный материал из известняка [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94dbe64-c9e8-4298-b6b7-0dec665c3302",
                                                "sense_id": "28970d19-22a0-3dda-ac4b-8b342a7eca5d",
                                                "text": "Башни, бойницы, жёлтый известняк стен, церкви с игольчатыми шпилями, часовни, арки мостов, к которым просился грохот колёс и факельный свет, ― поначалу всё воспринималось как добротные декорации к грандиозному фильму о средневековье."
                                            },
                                            {
                                                "example_id": "f3eb907d-2688-4a97-b85c-46146c599ced",
                                                "sense_id": "28970d19-22a0-3dda-ac4b-8b342a7eca5d",
                                                "text": "Не подозревая, что они ему позируют, внизу, под горой, млели с ручейками между лопаток женственные стены домика из розового известняка"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
