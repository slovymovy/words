                "senses": [
                    {
                        "sense_id": "0b4deb57-a681-37bd-8705-5f37971ff3a3",
                        "entry_id": "eb353141-1e8d-3802-b448-d4fd1df043a6",
                        "glosses": [
                            "einfache, aus Holz gebaute Kapelle, die für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba246e5-e5cd-46a7-88c3-1a43a74b6b50",
                                "sense_id": "0b4deb57-a681-37bd-8705-5f37971ff3a3",
                                "text": "„Die architektonischen Kopien der Casa Santa wiederholen die wesentlichen Merkmale der originalen Blockkapelle, der reiche figurative und dekorative Außenschmuck wird meist vereinfacht bzw. durch Malerei ersetzt.“"
                            },
                            {
                                "example_id": "43cc7583-6e8b-45e3-b26f-762668797b64",
                                "sense_id": "0b4deb57-a681-37bd-8705-5f37971ff3a3",
                                "text": "„In unserer Blockkapelle beten wir jeden Tag am Abend Rosenkranz, was auch Sie sicher bei St. Ignatius machen.“"
                            },
                            {
                                "example_id": "e2eaed68-0288-4b8a-82a9-2587e982bd49",
                                "sense_id": "0b4deb57-a681-37bd-8705-5f37971ff3a3",
                                "text": "„In der Blockkapelle hielten die Priester für ihn ein Requiem, wobei sein Kpl. Peter Schlicker ihm den Nachruf hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
