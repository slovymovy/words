                ],
                "senses": [
                    {
                        "sense_id": "bd0d8714-5f63-366b-aff0-05fe3048461c",
                        "entry_id": "f9419000-4dd6-3a28-bffa-b6917dac008a",
                        "glosses": [
                            "einem Sarg ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01faf6e-ee2c-4b48-a39a-256156da7215",
                                "sense_id": "bd0d8714-5f63-366b-aff0-05fe3048461c",
                                "text": "„Er spürte den Drang, die Luke zu öffnen, um die staubige, aber kühlere Luft atmen zu können. Doch er kämpfte dagegen an, blieb in seinem sargähnlichen Versteck und schlürfte alle paar Minuten warmes Wasser aus dem Schlauch.“"
                            },
                            {
                                "example_id": "b5b1a05e-6cb3-46b0-b97f-14b4a6b6babd",
                                "sense_id": "bd0d8714-5f63-366b-aff0-05fe3048461c",
                                "text": "„Seine Form wirkt fremdartig und fantastisch, und das sargähnliche Ende dieses massiven Schlüssels verrät eindeutig, in welches Schloss er passt.“"
                            },
                            {
                                "example_id": "99dd6fdb-3e34-4b0d-9b1f-033146cfb4c5",
                                "sense_id": "bd0d8714-5f63-366b-aff0-05fe3048461c",
                                "text": "„Die eine Hälfte wird vom Tank eingenommen, einer grauen sargähnlichen Kiste, die darauf programmiert werden kann, so ziemlich alle Formen von organischer Materie auszuspucken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "1aca795d-c53f-43e3-b3e8-8afb02d47196",
