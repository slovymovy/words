                        "glosses": [
                            "To convert to the language or culture of Normandy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5edcbc8f-73a4-4143-ac84-a80ca8e65bb5",
                                "sense_id": "03b3e18f-6eda-3581-9fb2-ac135f6afc37",
                                "text": "Out of gratitude for this large inheritance, or in compliance with the fashion of that day to Normanize, the Saxon lords of Ruby thence assumed the appellation of Nevill."
                            },
                            {
                                "example_id": "dc71bf09-c306-4d5d-bd72-a1aadefa2a52",
                                "sense_id": "03b3e18f-6eda-3581-9fb2-ac135f6afc37",
                                "text": "Self-interest led the Saxon to Normanize his language, and the French to Anglicize his speech."
                            },
                            {
                                "example_id": "e1ebdd84-2d27-4eeb-bb75-a1095b341ad2",
                                "sense_id": "03b3e18f-6eda-3581-9fb2-ac135f6afc37",
                                "text": "Raised among the Normans in France, Edward spoke French and attempted to Normanize the English court."
                            }
                        ]
                    }
