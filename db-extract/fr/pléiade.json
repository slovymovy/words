                                "sense_id": "fb75820a-c972-35ac-9fcd-19ae03c79449",
                                "text": "Les Pléiades sont les sœurs des Hyades."
                            }
                        ]
                    },
                    {
                        "sense_id": "77336c13-abb3-3bf3-bd80-298f4e7ada55",
                        "entry_id": "1466a6e9-ecea-368d-84b0-81f22203a0dd",
                        "glosses": [
