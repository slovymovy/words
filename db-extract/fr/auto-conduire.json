                "senses": [
                    {
                        "sense_id": "f049c1e3-8bc5-32b7-af09-f5c31c201473",
                        "entry_id": "6bc227eb-ff99-3c33-ae00-e3a3c31fb321",
                        "glosses": [
                            "Se conduire tout seul (en parlant d’un véhicule)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9dbe19f-f562-48a3-a5bf-a4b2d4277939",
                                "sense_id": "f049c1e3-8bc5-32b7-af09-f5c31c201473",
                                "text": "La marque californienne Tesla a annoncé jeudi 30 juin que les autorités américaines avaient ouvert une enquête après l’accident mortel d’une de ses voitures électriques, équipée d’Autopilot, le système qui permet au véhicule de s’auto-conduire ou d’effectuer des manoeuvres de façon autonome."
                            },
                            {
                                "example_id": "6ef675d4-e19f-4285-87a4-277f481e360b",
                                "sense_id": "f049c1e3-8bc5-32b7-af09-f5c31c201473",
                                "text": "Depuis 2010, Google développe un concept de voiture capable de s’auto-conduire, avec ou sans personne au volant, simplement en entrant sur un ordinateur de bord les coordonnées de destination souhaitées."
                            },
                            {
                                "example_id": "065d0a56-f73b-4085-acd4-671121a8761b",
                                "sense_id": "f049c1e3-8bc5-32b7-af09-f5c31c201473",
                                "text": "Le retour de la voiture Google qui s’auto-conduit !"
                            }
                        ]
                    }
