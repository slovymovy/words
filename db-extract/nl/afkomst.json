                    }
                ],
                "senses": [
                    {
                        "sense_id": "e04df68e-f7c0-3ea4-a3f9-005d9f135a7a",
                        "entry_id": "d2bdfd27-8836-39ef-a723-bb20c5cdcf86",
                        "glosses": [
                            "de familie waarvan je afstamt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e1f50d-d20a-4f17-816a-ec17a48d3092",
                                "sense_id": "e04df68e-f7c0-3ea4-a3f9-005d9f135a7a",
                                "text": "Die jongen heeft een goede afkomst, maar is toch gaan stelen."
                            },
                            {
                                "example_id": "c0805149-0302-400d-9e91-0b67a39d5fed",
                                "sense_id": "e04df68e-f7c0-3ea4-a3f9-005d9f135a7a",
                                "text": "Hij is van adellijke afkomst."
                            },
                            {
                                "example_id": "2dda3bc7-aad4-4d7e-bc3d-ab4aaa731e5d",
                                "sense_id": "e04df68e-f7c0-3ea4-a3f9-005d9f135a7a",
                                "text": "Alleen zijn platte accent verried een afkomst die niet geheel strookte met zijn verschijning, en nadat ze waren ingestapt stelde de man zich voor als Joey."
                            },
                            {
                                "example_id": "a7cb1979-4d7a-492e-8957-a9e8b5c78779",
                                "sense_id": "e04df68e-f7c0-3ea4-a3f9-005d9f135a7a",
                                "text": "Ingeborgs vader, baron Von Freital, geloofde niet in de liefde, maar des te meer in geld en afkomst, en vooral in de gunstige combinatie van die grootheden."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0df03bd-3885-3bf3-a209-1a8de68d76c9",
                        "entry_id": "d2bdfd27-8836-39ef-a723-bb20c5cdcf86",
                        "glosses": [
                            "de plaats waar je vandaan komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd9fe2b8-0578-48cc-aca1-91b28109896e",
                                "sense_id": "d0df03bd-3885-3bf3-a209-1a8de68d76c9",
                                "text": "De afkomst van de inbrekers was onbekend."
                            },
                            {
                                "example_id": "4db67a11-9367-42ad-a00d-f50a0d9e9e98",
                                "sense_id": "d0df03bd-3885-3bf3-a209-1a8de68d76c9",
                                "text": "\"Er is sprake van institutioneel racisme als de processen, het beleid en de (geschreven en ongeschreven) regels van instituten leiden tot discriminatie van groepen mensen op grond van etniciteit, afkomst, of huidskleur\", legt het College voor de Rechten van de Mens uit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69044004-18e1-4d64-94b8-a414a0267b90",
                        "source_entry_id": "d2bdfd27-8836-39ef-a723-bb20c5cdcf86",
                        "target_lang_word": "Herkunft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herkunft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4764d0c2-2689-3fa8-92fc-3b47b750be00",
                                        "entry_id": "e58b612d-9a9b-3489-9f9b-d57a1e53cbcb",
                                        "glosses": [
                                            "woher etwas oder jemand kommt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ecdc1a6-ee71-4848-8407-b892b2bc73b3",
                                                "sense_id": "4764d0c2-2689-3fa8-92fc-3b47b750be00",
                                                "text": "Die Herkunft dieser Äpfel ist nirgends verzeichnet."
                                            },
                                            {
                                                "example_id": "0edeebe7-b616-4c07-888e-929441169002",
                                                "sense_id": "4764d0c2-2689-3fa8-92fc-3b47b750be00",
                                                "text": "„Die persönlichen Gegenstände waren es, die den Archäologen schließlich die entscheidenden Hinweise auf die Herkunft der Angreifer gaben.“"
                                            },
                                            {
                                                "example_id": "c7d8750f-609c-42d9-96bb-a59866405769",
                                                "sense_id": "4764d0c2-2689-3fa8-92fc-3b47b750be00",
                                                "text": "„Das sei zwar illegal, aber nicht wirklich zu kontrollieren, zumal wenn die Werkstatt im Impressum verschwiegen würde oder ein Kryptonym die Herkunft verschleierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fb31066-8423-3cc6-8ac9-cc89751adab5",
                                        "entry_id": "e58b612d-9a9b-3489-9f9b-d57a1e53cbcb",
                                        "glosses": [
                                            "woher jemandes Familie stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c84875-6123-4ef1-8470-fe2b9b8f3c94",
                                                "sense_id": "5fb31066-8423-3cc6-8ac9-cc89751adab5",
                                                "text": "Ein Großteil der in Deutschland lebenden Migranten ist türkischer Herkunft."
                                            },
                                            {
                                                "example_id": "160768e3-7431-434d-aa49-5f2d980c82e8",
                                                "sense_id": "5fb31066-8423-3cc6-8ac9-cc89751adab5",
                                                "text": "„In allen Bundesländern ist der Übergang ans Gymnasium in hohem Maße von der sozialen Herkunft bestimmt.“"
                                            },
                                            {
                                                "example_id": "e4167ab5-5ea1-4113-9f9a-f30f7841abc4",
                                                "sense_id": "5fb31066-8423-3cc6-8ac9-cc89751adab5",
                                                "text": "„Die soziale Herkunft spielt [Anmerkung: für den Bildungserfolg eines Kindes] immer noch eine entscheidende Rolle.“"
                                            },
                                            {
                                                "example_id": "96f957a2-794b-477d-9197-c3924c4dbe8b",
                                                "sense_id": "5fb31066-8423-3cc6-8ac9-cc89751adab5",
                                                "text": "„Meine Herkunft, meine Familiengeschichte sind keine Tabuthemen.“"
                                            },
                                            {
                                                "example_id": "a532bb60-30eb-46e5-85ca-101151347434",
                                                "sense_id": "5fb31066-8423-3cc6-8ac9-cc89751adab5",
                                                "text": "„Im trockenen Hochland Äthiopiens etwa, im Osten des Kontinents, regieren seit 1270 stolze christliche Monarchen, die sich »Negus Negest« nennen, »König der Könige«, und ihre Herkunft auf den biblischen Herrscher Salomos zurückführen (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "56454979-332e-3efa-bdd6-063ccc3efc10",
                                        "entry_id": "e58b612d-9a9b-3489-9f9b-d57a1e53cbcb",
                                        "glosses": [
                                            "Ursprung eines Wortes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1222e591-1211-4573-8eb8-8396c835dcec",
                                                "sense_id": "56454979-332e-3efa-bdd6-063ccc3efc10",
                                                "text": "Die Herkunft dieses Wortes liegt im Unklaren."
                                            },
                                            {
                                                "example_id": "f234f47a-ce98-4a8f-8dbc-662be1160d3e",
                                                "sense_id": "56454979-332e-3efa-bdd6-063ccc3efc10",
                                                "text": "„[…] viele Wörter französischer Herkunft erkennen wir an der Aussprache. An den Endungen -eur, -ent oder -ee zum Beispiel.“"
                                            },
                                            {
                                                "example_id": "cdda38df-09fd-43e6-83cb-870cf47309e8",
                                                "sense_id": "56454979-332e-3efa-bdd6-063ccc3efc10",
                                                "text": "„Die Kolonialverwaltung ist alarmiert; 1950 verbietet sie die „Mau-Mau“, wie die Briten die Bewegung nennen (die genaue Herkunft des Wortes ist unklar; sicher ist nur, dass die Rebellen sich den Namen nicht selbst gegeben haben, sondern als Schimpfwort empfinden).“"
                                            },
                                            {
                                                "example_id": "1f36f237-0d9c-42f8-bc64-1b70b3b990be",
                                                "sense_id": "56454979-332e-3efa-bdd6-063ccc3efc10",
                                                "text": "„Dieses Buch erteilt aber nicht nur über Schreibung, Herkunft und Bedeutung unserer Vornamen Auskunft, sondern erleichtert auch Eltern die Wahl des Vornamens für ihr Kind.“"
                                            },
                                            {
                                                "example_id": "282fc4fd-3658-48ed-9e74-0f4985a7185b",
                                                "sense_id": "56454979-332e-3efa-bdd6-063ccc3efc10",
                                                "text": "„Die Herkunft der Fremdwörter und einiger jüngerer Lehnwörter wird in knapper Form in Winkelklammern angegeben: meist wird die gebende Sprache, nicht die Ursprungssprache genannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ffb48a7-277d-46ae-a604-9d97693b5992",
