                                        "sense_id": "530024c4-e2b0-3fdd-a434-664bc45ac587",
                                        "entry_id": "b03bed0b-c860-3d37-8e63-30e111c37237",
                                        "glosses": [
                                            "Relatif au léninisme."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac65a8ac-e181-4166-8786-e5b466d83258",
                                                "sense_id": "530024c4-e2b0-3fdd-a434-664bc45ac587",
                                                "text": "Le parti de type léniniste a démontré l’universalité de ses normes politiques et organisationnelles, comme instrument irremplaçable de la conquête des masses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "léniniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08f2531e-c01a-3acc-8f01-3be05a63f05d",
                                        "entry_id": "1c9c2d89-eb94-341c-9ea0-39995b2cfead",
                                        "glosses": [
                                            "Partisan du léninisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "617dc796-ac34-4964-861a-23042a58e8f7",
                                                "sense_id": "08f2531e-c01a-3acc-8f01-3be05a63f05d",
                                                "text": "Les léninistes veulent l'instauration de « l'État ouvrier »."
                                            },
                                            {
                                                "example_id": "628e9f6c-9de5-4676-81c6-7604d443be26",
                                                "sense_id": "08f2531e-c01a-3acc-8f01-3be05a63f05d",
                                                "text": "Mais un léniniste de bonne race vous confiera que les « conditions objectives » étaient mûres, que les masses étaient prêtes, mais qu’il manquait la direction prolétarienne dont ses camarades et lui constituent le noyau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e91de9be-1cdb-425d-a0cf-b7da8ecc9814",
                        "source_entry_id": "4a9ee9bc-f594-3838-9da8-458d93df0a49",
