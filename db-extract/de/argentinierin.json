                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52e5902f-699a-42e5-8a8d-ecf1a21b2289",
                                                "sense_id": "6c7075f9-f329-36ed-9a12-f0e2db1ef25e",
                                                "text": "Argentine midfielder Jonas Gutierrez added a superb second when he surged past four challenges to fire in low."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Argentine",
