                        "entry_id": "cbfa10f4-2079-3ed7-b73d-95496da56d36",
                        "glosses": [
                            "Perception des stimulations produisant la douleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faed0817-7683-41ec-835e-56f6c9ba0098",
                                "sense_id": "1369e2f5-6ca8-3130-9661-4e435343d5d0",
                                "text": "Il faut, en effet, avant tout ne pas confondre douleur et nociception. La nociception est le processus sensoriel à l’origine du message nerveux qui provoque la douleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "734babf9-e2a4-4332-8203-b427a837602f",
                        "source_entry_id": "cbfa10f4-2079-3ed7-b73d-95496da56d36",
                        "source_sense_id": "1369e2f5-6ca8-3130-9661-4e435343d5d0",
