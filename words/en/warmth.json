                },
                {
                    "sense_id": "56c15497-8edc-3740-9b9c-d87dfa995408",
                    "sense_definition": "The effect of using mostly red and yellow hues.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orange curtains added <w>warmth</w> to the otherwise grey room.",
                            "target_lang_translations": {
                                "ru": "Оранжевые шторы добавили <w>тепла</w> в эту серую комнату.",
                                "zh": "橙色的窗帘为原本灰暗的房间增添了一抹<w>暖色调</w>。",
                                "es": "Las cortinas naranjas añadieron <w>calidez</w> a la habitación, que de otro modo se veía gris."
                            }
                        },
                        {
                            "text": "Critics admired the painting for the <w>warmth</w> of its tones.",
                            "target_lang_translations": {
                                "ru": "Критики восхищались картиной за <w>теплоту</w> её тонов.",
                                "zh": "评论家们赞赏这幅画作，因为它色彩的<w>暖色调</w>运用得很好。",
                                "es": "Los críticos admiraron la pintura por la <w>calidez</w> de sus tonos."
                            }
                        }
                    ],
                    "synonyms": [
