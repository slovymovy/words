                "senses": [
                    {
                        "sense_id": "703affbd-fcfc-3337-a87e-4b6c09fbe8b6",
                        "entry_id": "85cf758b-25b9-3204-b704-33fbc473bfe1",
                        "glosses": [
                            "Attribution d’une valeur excessive par rapport à la valeur réelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22a7449b-f577-4b3f-a816-818da6cb649c",
                                "sense_id": "703affbd-fcfc-3337-a87e-4b6c09fbe8b6",
                                "text": "La mégalomanie, quezaco ? Elle consiste en une surestimation de ses capacités qui se traduit par un désir immodéré de puissance et un amour exclusif ou excessif de soi."
                            },
                            {
                                "example_id": "a3254d9b-9121-47fb-b26c-a276b88ca470",
                                "sense_id": "703affbd-fcfc-3337-a87e-4b6c09fbe8b6",
                                "text": "La surestimation de la distance inter-véhiculaire dans le brouillard. — Il y a eu une surestimation des bénéfices et une sous-estimation des charges."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "371ab5b4-e094-46e2-8e0c-b06c8c50af5a",
                        "source_entry_id": "85cf758b-25b9-3204-b704-33fbc473bfe1",
                        "source_sense_id": "703affbd-fcfc-3337-a87e-4b6c09fbe8b6",
                        "target_lang_word": "overestimate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overestimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c0cb014-7dfd-3837-821b-61635c9d2c02",
                                        "entry_id": "dbdd60d4-bbb8-3686-8da0-c01854b5000b",
                                        "glosses": [
                                            "To judge or calculate too highly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b51dabc-c69a-41e4-878c-0d8db8a858cd",
                                                "sense_id": "7c0cb014-7dfd-3837-821b-61635c9d2c02",
                                                "text": "I overestimated the number of attendees, and bought far too much food for the party."
                                            },
                                            {
                                                "example_id": "4d1b7ef5-1464-4393-8142-60bafc14056a",
                                                "sense_id": "7c0cb014-7dfd-3837-821b-61635c9d2c02",
                                                "text": "Nevertheless, the role played by vertical transport (in particular, by biosedimentation) in self-purification of seas and oceans from chlorinated hydrocarbons must not be overestimated."
                                            },
                                            {
                                                "example_id": "ca99ed07-a1f8-4210-b38b-90f32f0c91b3",
                                                "sense_id": "7c0cb014-7dfd-3837-821b-61635c9d2c02",
                                                "text": "One must be especially careful when using Google to determine frequency as there is a very real risk of fantastically overestimating the frequency and subsequent importance of a term."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overestimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fad1418a-f39f-3e19-9f38-b572545eb260",
                                        "entry_id": "eed279cc-6cff-330f-a5f8-1e6d300d4eb8",
                                        "glosses": [
                                            "An estimate that is too high."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2fd931-4a8a-474f-a7f4-fd67192938dd",
                                                "sense_id": "fad1418a-f39f-3e19-9f38-b572545eb260",
                                                "text": "The employment projection for the metropolitan area for 1985 was an overestimate by about 12 percent."
                                            },
                                            {
                                                "example_id": "9d64f52e-f769-469e-aae0-b9db2809cb27",
                                                "sense_id": "fad1418a-f39f-3e19-9f38-b572545eb260",
                                                "text": "The department pointed to a study it conducted in 2017 that found that, in some states, overestimates of utility costs were giving some people too many food stamps, while in others, people were getting too few."
                                            }
                                        ]
                                    }
                                ]
                            }
