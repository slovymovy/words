                "senses": [
                    {
                        "sense_id": "9e819c3a-1d80-3639-aa99-a7cf319f2c94",
                        "entry_id": "4c20b893-cc79-3966-8286-ce4fcd980289",
                        "glosses": [
                            "schuur waarin men zaken kan bergen die men later nodig heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8158d1d4-60fe-4114-a3dc-2c24a8a79322",
                                "sense_id": "9e819c3a-1d80-3639-aa99-a7cf319f2c94",
                                "text": "Een paar jongens gingen door de achtertuinen van het dorp voor de militie op de loop en kropen, elkaar opjuttend met duwen en porren, onder de niet tot de grond reikende vloer van de eerste de beste voorraadschuur."
                            },
                            {
                                "example_id": "59c639ab-d381-4af3-8b46-21a27d99ec93",
                                "sense_id": "9e819c3a-1d80-3639-aa99-a7cf319f2c94",
                                "text": "Over het algemeen is de 'voorraadschuur' nog maar voor 20 procent gevuld, wat uitzonderlijk laag is. Maar sommige opslagcentra zijn nog maar voor 5 procent of minder met aardgas gevuld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfbe060f-b15f-4892-8201-2c30ea481ab0",
                        "source_entry_id": "4c20b893-cc79-3966-8286-ce4fcd980289",
