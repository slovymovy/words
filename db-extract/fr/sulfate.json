        "fr-extract.jsonl": [
            {
                "entry_id": "555b37eb-4762-3677-8ea1-6c713a7e56a6",
                "word": "sulfate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2179af7f-2ce6-4498-bd16-d9963489b454",
                        "entry_id": "555b37eb-4762-3677-8ea1-6c713a7e56a6",
                        "tags": [
                            "plural"
                        ],
                        "form": "sulfates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44ade6b0-9306-3017-9ce7-7ee4a2be3440",
                        "entry_id": "555b37eb-4762-3677-8ea1-6c713a7e56a6",
                        "glosses": [
                            "Composé ionique associant un ion sulfate SO₄²⁻ et d’une base cationique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "581d6066-5631-4860-a376-71eca695e49a",
                                "sense_id": "44ade6b0-9306-3017-9ce7-7ee4a2be3440",
                                "text": "L'eau de mer, solidifiée par la congélation, se libère du chlorure de sodium, mais conserve les sulfates ; les embruns peuvent la saupoudrer de sels, et un peu de saumure reste emprisonnée."
                            },
                            {
                                "example_id": "e17a474b-b168-4356-9a57-90cac3ac7e2d",
                                "sense_id": "44ade6b0-9306-3017-9ce7-7ee4a2be3440",
                                "text": "Un anneau composé de soluble dans la pyridine pour 64 % en poids, de silice (sable, diatomées, foraminifères) pour 18 % et de sulfate de calcium pour 12 %, et datant de 3500 avant J.C. a été découvert à Ur en Irak du Sud."
                            },
                            {
                                "example_id": "09d2a260-2c47-42fa-abd4-655635cca612",
                                "sense_id": "44ade6b0-9306-3017-9ce7-7ee4a2be3440",
                                "text": "Dans des nuages de sulfates, les ouvriers font les trois-huit – six à quatorze heures, quatorze à vingt-deux ou vingt-deux à six, à tour de rôle du lundi matin au samedi midi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "696a38b9-7c1f-491f-b567-e064fa58d7a2",
                        "source_entry_id": "555b37eb-4762-3677-8ea1-6c713a7e56a6",
                        "source_sense_id": "44ade6b0-9306-3017-9ce7-7ee4a2be3440",
                        "target_lang_word": "sulfate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sulfate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63969dbb-408d-32f6-b483-169462761169",
                                        "entry_id": "4b295213-275e-3131-92ce-df933fc3a5f8",
                                        "glosses": [
                                            "Any salt or ester of sulfuric acid."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1530fde-0a08-4e1a-b7b6-68f6a1e3946c",
                                                "sense_id": "63969dbb-408d-32f6-b483-169462761169",
                                                "text": "Another type, also common in the Taipei area has more chlorides than sulfates, and while it is also hot, its flavor is more salty than sour. The springs at Chinshan on the north coast are typical of this type."
                                            },
                                            {
                                                "example_id": "e0c3bee7-e61c-4bb9-99a1-3a7a8ce23d2a",
                                                "sense_id": "63969dbb-408d-32f6-b483-169462761169",
                                                "text": "Iatrogenic poisoning can result from the use of magnesium in the treatment of hypertension or of toxemia of pregnancy; deaths have been reported from the use of magnesium sulfate enemas in megacolon and from oral administration for purging."
                                            },
                                            {
                                                "example_id": "e96c2385-c004-414a-bb21-f721c9890d00",
                                                "sense_id": "63969dbb-408d-32f6-b483-169462761169",
                                                "text": "The whole world's fighting over fresh water like a pack of starving dogs with one stripped bone among them, and then Brazil started shooting all those sulfates into the stratosphere and—well, it was turning out just like the environazis said, only way worse and way fucking faster."
                                            },
                                            {
                                                "example_id": "60453515-b5fa-4e8f-a1c3-c90796f2b613",
                                                "sense_id": "63969dbb-408d-32f6-b483-169462761169",
                                                "text": "The technique would involve spraying large amounts of sulfate particles into the Earth’s lower stratosphere at altitudes as high as 12 miles. The scientists propose delivering the sulfates with specially designed high-altitude aircraft, balloons or large naval-style guns."
                                            },
                                            {
                                                "example_id": "d45a6bb5-bb1a-4961-8386-8ccb29758b86",
                                                "sense_id": "63969dbb-408d-32f6-b483-169462761169",
                                                "text": "McCoy’s team, including 66 researchers across four continents, found the salt and minerals left behind as water on Bennu, or its larger parent asteroid, evaporated. The minerals include sodium phosphates, carbonates, sulfates, chlorides and fluorides, some of which are necessary to the formation of life."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sulfate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cca2d938-59c0-3aa1-856d-fe463b29a0c3",
                                        "entry_id": "dd6d8ce8-82aa-3c11-9fb5-c420f90060af",
                                        "glosses": [
                                            "To treat something with sulfuric acid, a sulfate, or with sulfur dioxide."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
