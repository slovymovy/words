                "senses": [
                    {
                        "sense_id": "40aac946-9585-3747-94a5-a59686a9dcf2",
                        "entry_id": "bb771fa2-3a5d-30a4-a72d-9f3cc3d81cf9",
                        "glosses": [
                            "Umformungsregel, einer der Regeltypen der Transformationsgrammatik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ccb7d26-0137-427b-8b61-a7a860b8fd2a",
                                "sense_id": "40aac946-9585-3747-94a5-a59686a9dcf2",
                                "text": "Transformationsregeln können z.B. die Stellung der Wortgruppen im Satz verändern."
                            },
                            {
                                "example_id": "29bd8fc4-5288-4c8a-ac3f-4b21b5cae445",
                                "sense_id": "40aac946-9585-3747-94a5-a59686a9dcf2",
                                "text": "„Transformationsregeln einer sehr späten Stufe bringen dann die phonologisch bedingten Varianten ein, von denen die endgültige Lautgestalt abhängt.“"
                            },
                            {
                                "example_id": "6432058b-9dba-4d29-b2af-6b8a6e8638b3",
                                "sense_id": "40aac946-9585-3747-94a5-a59686a9dcf2",
                                "text": "„Nicht berücksichtigt werden die Transformationsregeln, die die syntaktischen Oberflächen erzeugen.“"
                            },
                            {
                                "example_id": "05bc8e1e-2edf-44b0-bbca-7a56aa7fdc36",
                                "sense_id": "40aac946-9585-3747-94a5-a59686a9dcf2",
                                "text": "„Es zeigt sich, daß mit zunehmendem Alter auch eine zunehmende Verwendung von Transformationsregeln festzustellen ist, ältere Kinder gebrauchen sie häufiger als jüngere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
