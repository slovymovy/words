                "senses": [
                    {
                        "sense_id": "c3425c03-965e-3e0f-95f6-655f63a78077",
                        "entry_id": "01174db4-153e-3dd8-834a-cf642ba46a63",
                        "glosses": [
                            "weibliche Person, die Kindergartenkinder betreut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c58bf1c-5740-4389-9ab9-9cbf7b9f3cf8",
                                "sense_id": "c3425c03-965e-3e0f-95f6-655f63a78077",
                                "text": "Die Kindergärtnerin hat heute mehrere schwierigere Kindern zu betreuen."
                            },
                            {
                                "example_id": "e7017645-66a7-4d44-ad4e-7d2904fe07cb",
                                "sense_id": "c3425c03-965e-3e0f-95f6-655f63a78077",
                                "text": "„Eine Kindergärtnerin hatte es geschossen und es mir zum Geburtstag geschenkt.“"
                            },
                            {
                                "example_id": "2842a8a8-24ef-4a8a-bebd-0e388179286f",
                                "sense_id": "c3425c03-965e-3e0f-95f6-655f63a78077",
                                "text": "„Ein universitärer Studiengang müsse her, dazu ein weit gefächertes Fortbildungsprogramm für Kindergärtnerinnen, ein ganzes Bündel von Forschungsprogrammen zur Früherziehung sowie internationale Vernetzung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
