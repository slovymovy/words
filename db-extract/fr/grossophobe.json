                        "glosses": [
                            "Personne qui éprouve, qui manifeste de l’aversion, de l'hostilité ou envers les personnes grosses, en surpoids ou obèses."
                        ],
                        "tags": [
                            "Grossophobie"
                        ],
                        "examples": [
                            {
                                "example_id": "8ebe2c7e-2c8d-4c45-8eb1-4275ac135f80",
                                "sense_id": "254466a9-cb44-3868-bb58-10c28fa4194d",
                                "text": "Le grossophobe est-il forcément un être sans cœur ?"
                            }
                        ]
