                        "source_entry_id": "971e68d7-7bc3-381d-be46-21f744d91c26",
                        "source_sense_description": "отряд паукообразных Opiliones",
                        "target_lang_word": "daddy longlegs",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daddy longlegs",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d67f96c-b1cc-3500-9bd2-7ac171495e24",
                                        "entry_id": "1bb50326-e951-324a-9dac-45c732b8386d",
                                        "glosses": [
                                            "The cranefly; any insect of the suborder Tipulomorpha."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be5828e-3df7-48b6-832f-7c778e5c082c",
                                                "sense_id": "1d67f96c-b1cc-3500-9bd2-7ac171495e24",
                                                "text": "Daddy longlegs adults are weak flyers, falling onto the water surface in the lightest of breezes, and even on calm days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5b2d0f-c6f6-30e8-9647-7164484cafc6",
                                        "entry_id": "1bb50326-e951-324a-9dac-45c732b8386d",
                                        "glosses": [
                                            "Any (non-spider) arachnid of the order Opiliones, mostly with long thin legs."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e62f5fa0-b221-4719-87f2-4a47ed1dfa30",
                                                "sense_id": "2b5b2d0f-c6f6-30e8-9647-7164484cafc6",
                                                "text": "Unlike spiders, daddy longlegs do not have a clearly marked division between thorax and abdomen. They are further distinguished from spiders in that they do not produce venom or silk."
                                            },
                                            {
                                                "example_id": "2d514a47-eea0-415b-9f2d-788d3ecf725b",
                                                "sense_id": "2b5b2d0f-c6f6-30e8-9647-7164484cafc6",
                                                "text": "Daddy longlegs aren′t even really spiders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "946332ed-25e4-3f6d-901a-888f95a34679",
                                        "entry_id": "1bb50326-e951-324a-9dac-45c732b8386d",
                                        "glosses": [
                                            "The daddy long-legs spider, any spider of the family Pholcidae."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b1972e-566d-4efe-8a0f-2f1ad47d8670",
                                                "sense_id": "946332ed-25e4-3f6d-901a-888f95a34679",
                                                "text": "Another spider neighbor that is commonly found in homes is the daddy longlegs. The daddy longlegs is often called a cellar spider."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
