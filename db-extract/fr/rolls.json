                        "glosses": [
                            "Voiture de marque Rolls-Royce."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "58b85561-3622-4443-80ae-e94ff080981c",
                                "sense_id": "5e907b6f-123f-39e9-a1c7-17462c656c4e",
                                "text": "C’est une très belle jeune femme qui est la présidente du Solority club et un des personnages clef du récit. Elle est extrêmement distinguée, roule en Rolls et paraît d'une douceur extrême aux premiers abords."
                            },
                            {
                                "example_id": "61aeffd6-be8e-48df-a6fa-84c2ff443226",
                                "sense_id": "5e907b6f-123f-39e9-a1c7-17462c656c4e",
                                "text": "Assis à l'arrière de sa Rolls qui l'emmène au travail, Daniel est préoccupé."
                            },
                            {
                                "example_id": "bfb10b87-5408-4fbd-afaf-496eb6821e7c",
                                "sense_id": "5e907b6f-123f-39e9-a1c7-17462c656c4e",
                                "text": "Monsieur le professeur, j’ai sorti la Rolls de Mme Buchard."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ff8c97d-1745-3b8f-8d77-710d0e3f9566",
                        "entry_id": "954afda4-e28e-321d-8a5d-5298e6db5d95",
                        "glosses": [
                            "Ce qui se fait de mieux, de plus haut de gamme dans un domaine donné."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "55028d3a-b79a-4cc9-9cdc-7a8b2afa8e58",
                                "sense_id": "3ff8c97d-1745-3b8f-8d77-710d0e3f9566",
                                "text": "Les plus âgés d’entre nous se souviennent sans nul doute de ce qui était à l’époque la Rolls des consoles et de ses titres légendaires. Peu avait pu l’acquérir à l’époque étant donné son prix très élevé, mais beaucoup ont croisé la route de ces jeux dans les salles d’arcade ou, plus tard, grâce à l’émulation."
                            }
                        ]
                    }
