{
    "word_family": [
        "destitution"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "156ac477-8d46-3b86-ad68-0571a7fa07fa",
                    "sense_definition": "Extremely poor and lacking the basic necessities of life.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families were left <w>destitute</w> after the war destroyed their homes and businesses.",
                            "target_lang_translations": {
                                "tr": "Savaş evlerini ve iş yerlerini yok ettikten sonra birçok aile <w>muhtaç</w> durumda kaldı."
                            }
                        },
                        {
                            "text": "The charity works to provide food and shelter for the <w>destitute</w> people living on the streets.",
                            "target_lang_translations": {
                                "tr": "Hayır kurumu, sokaklarda yaşayan <w>sefil</w> insanlar için yiyecek ve barınak sağlamaya çalışıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "penniless",
                        "impoverished",
                        "indigent"
                    ],
                    "antonyms": [
                        "wealthy",
                        "affluent"
                    ],
                    "common_phrases": [
                        "destitute people",
                        "left destitute"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı yoksul, temel yaşam ihtiyaçlarından yoksun."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "muhtaç",
                                "target_lang_sense_clarification": "Temel ihtiyaçlarını karşılayamayacak durumda olan."
                            },
                            {
                                "target_lang_word": "sefil",
                                "target_lang_sense_clarification": "Aşırı yoksulluk içinde yaşayan."
                            },
                            {
                                "target_lang_word": "yoksul",
                                "target_lang_sense_clarification": "Maddi durumu çok kötü olan."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3102d2cc-359c-327e-b8d2-b5d6f2585fe3",
                    "sense_definition": "Completely lacking or devoid of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lacking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The remote island is <w>destitute</w> of any natural resources or fresh water sources.",
                            "target_lang_translations": {
                                "tr": "Uzak ada, herhangi bir doğal kaynaktan veya tatlı su kaynağından <w>yoksun</w>."
                            }
                        },
                        {
                            "text": "His argument was <w>destitute</w> of any logical evidence to support his claims.",
                            "target_lang_translations": {
                                "tr": "Argümanı, iddialarını destekleyecek herhangi bir mantıksal kanıttan <w>mahrumdu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "devoid",
                        "lacking",
                        "bereft"
                    ],
                    "antonyms": [
                        "full",
                        "abundant"
                    ],
                    "common_phrases": [
                        "destitute of"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyden tamamen yoksun veya mahrum."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yoksun",
                                "target_lang_sense_clarification": "Bir şeyden mahrum olma durumu."
                            },
                            {
                                "target_lang_word": "mahrum",
                                "target_lang_sense_clarification": "Bir şeyin eksikliğini çeken."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28e92427-4307-3779-ad92-d3de596668b5",
                    "sense_definition": "To make someone extremely poor by taking away their resources or wealth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic collapse served to <w>destitute</w> many families who had previously been middle class.",
                            "target_lang_translations": {
                                "tr": "Ani ekonomik çöküş, daha önce orta sınıf olan birçok aileyi <w>yoksullaştırdı</w>."
                            }
                        },
                        {
                            "text": "The legal battle threatened to <w>destitute</w> the entire family by draining their savings.",
                            "target_lang_translations": {
                                "tr": "Hukuki mücadele, birikimlerini tüketerek tüm aileyi <w>sefalete sürüklemekle</w> tehdit etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "impoverish",
                        "bankrupt"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini kaynaklarını veya servetini elinden alarak aşırı yoksul bırakmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yoksullaştırmak",
                                "target_lang_sense_clarification": "Birini fakir duruma düşürmek."
                            },
                            {
                                "target_lang_word": "sefalete sürüklemek",
                                "target_lang_sense_clarification": "Birini aşırı yoksulluk içine itmek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}