                "forms": [
                    {
                        "form_id": "bbf30d36-16de-4c21-af2c-d41a210da943",
                        "entry_id": "ffc4c817-5590-3cae-bb57-99219ec7990d",
                        "tags": [
                            "plural"
                        ],
                        "form": "geloofsbelijdenissen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7df878bc-6bb2-39b8-81fc-ba092ed555f3",
                        "entry_id": "ffc4c817-5590-3cae-bb57-99219ec7990d",
                        "glosses": [
                            "zeggen waarin je gelooft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e895f7d1-c33c-4e96-a615-d965f82b591c",
                                "sense_id": "7df878bc-6bb2-39b8-81fc-ba092ed555f3",
                                "text": "Khan betrekt het publiek bij zijn geloofsbelijdenis met eenvoudige en concrete voorbeelden. Hij vertelt dat hij koffie ontzettend mist als hij tijdens de ramadan zijn drukke baan met vasten combineert."
                            },
                            {
                                "example_id": "bdd168a1-11db-42b3-a4cc-71dcbe6ad5b8",
                                "sense_id": "7df878bc-6bb2-39b8-81fc-ba092ed555f3",
                                "text": "De moderne mens kan voor zijn geloofsbelijdenis ook online terecht. Een digitaal kaarsje aansteken, chatten met de dominee of zelfs een zegen via e-mail: nadat zowel God als de paus al via Twitter het woord verkondigde, predikt ook de kerk vanuit de cloud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71128c8d-d451-43d2-b69c-c407056fb500",
                        "source_entry_id": "ffc4c817-5590-3cae-bb57-99219ec7990d",
                        "source_sense_id": "7df878bc-6bb2-39b8-81fc-ba092ed555f3",
                        "source_sense_description": "zeggen wat je gelooft",
                        "target_lang_word": "confession",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confession",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f147635b-2fc6-3e37-9125-da962bd8b800",
                                        "entry_id": "aa4ddc17-7814-3657-b9b9-de13e28a7225",
                                        "glosses": [
                                            "The open admittance of having done something (especially something bad)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74431e41-641f-4065-af8b-c68c8e07191c",
                                                "sense_id": "f147635b-2fc6-3e37-9125-da962bd8b800",
                                                "text": "Without the real murderer's confession, an innocent person could be jailed."
                                            },
                                            {
                                                "example_id": "a1aa552b-bcaa-4dbf-b53b-79d23f96bf88",
                                                "sense_id": "f147635b-2fc6-3e37-9125-da962bd8b800",
                                                "text": "With a crafty madness keeps aloof, / When we would bring him on to some confession / Of his true state."
                                            },
                                            {
                                                "example_id": "e19a7df5-55fb-4302-a353-3b7fd03a727b",
                                                "sense_id": "f147635b-2fc6-3e37-9125-da962bd8b800",
                                                "text": "If you’re looking for juicier confessions – that is, admissions of the kinds of sins unearthed on detective shows or reality TV – then you’ll want to look elsewhere. My sinning life is rather uneventful."
                                            },
                                            {
                                                "example_id": "184def5c-7881-478c-bc1b-911d60f19086",
                                                "sense_id": "f147635b-2fc6-3e37-9125-da962bd8b800",
                                                "text": "That all changed last month when 37-year-old Peralta borrowed a phone, called police and made a blunt confession to a crime he says he committed nearly 15 years ago, according to an arrest affidavit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33ae174e-1591-334d-b57a-dd289624c85e",
                                        "entry_id": "aa4ddc17-7814-3657-b9b9-de13e28a7225",
                                        "glosses": [
                                            "A formal document providing such an admission."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02ad8442-bbf8-4b92-8bb9-a111bf52c3f3",
                                                "sense_id": "33ae174e-1591-334d-b57a-dd289624c85e",
                                                "text": "He forced me to sign a confession!"
                                            },
                                            {
                                                "example_id": "559c2a02-65bd-4e92-b0d3-35dc5c56fd5d",
                                                "sense_id": "33ae174e-1591-334d-b57a-dd289624c85e",
                                                "text": "Both the basic idea of confession, and the techniques devised by Yezhov for extracting them, however, were to receive significant employment in Asia in the 1950s. The Chinese accused the Americans of waging bacteriological warfare in Korea. The evidence they produced consisted of feathers, insects, clams, rats, and other things riddled with germs and allegedly dropped from American planes. Such evidence was not, on the face of it, very convincing - though even this was accepted by one type of Westerner. To fortify their case, the Chinese resorted to confessions, extracted from American pilots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab5d4f8-9738-38fb-a6ef-de825586ded1",
                                        "entry_id": "aa4ddc17-7814-3657-b9b9-de13e28a7225",
                                        "glosses": [
                                            "The disclosure of one's sins to a priest for absolution. In the Roman Catholic Church, it is now also termed the sacrament of reconciliation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca8243b-fd9b-4253-bdfe-53648a18abd0",
                                                "sense_id": "2ab5d4f8-9738-38fb-a6ef-de825586ded1",
                                                "text": "I went to confession and now I feel much better about what I had done."
                                            },
                                            {
                                                "example_id": "7785c3fd-01b3-4ff3-969c-ec17385b78ca",
                                                "sense_id": "2ab5d4f8-9738-38fb-a6ef-de825586ded1",
                                                "text": "Hauing diſpleaſ'd my Father, to Lawrence Cell, / To make confeſſion, and to be abſolu'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5cf9610-e1ba-3710-89e9-8adb51a158f3",
                                        "entry_id": "aa4ddc17-7814-3657-b9b9-de13e28a7225",
                                        "glosses": [
                                            "Acknowledgment of belief; profession of one's faith."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfaafc02-4d02-431e-9feb-205506073885",
                                                "sense_id": "e5cf9610-e1ba-3710-89e9-8adb51a158f3",
                                                "text": "With the mouth confession is made unto salvation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc92b31d-9d45-3897-8bd0-37fc5851709b",
                                        "entry_id": "aa4ddc17-7814-3657-b9b9-de13e28a7225",
                                        "glosses": [
                                            "A formula in which the articles of faith are comprised; a creed to be assented to or signed, as a preliminary to admission to membership of a church; a confession of faith."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cb947ca-91e4-30db-97e5-fa7a0b1ba873",
                                        "entry_id": "aa4ddc17-7814-3657-b9b9-de13e28a7225",
                                        "glosses": [
                                            "The act of professing one's love."
                                        ],
                                        "tags": [
                                            "Japanese",
