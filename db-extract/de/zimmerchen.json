                ],
                "senses": [
                    {
                        "sense_id": "6b0243b8-6f3b-38b3-9f29-110f3fc12eb7",
                        "entry_id": "cb933992-6c6c-3f0e-8be4-790a7cf47e23",
                        "glosses": [
                            "kleines Zimmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7306e9c-c643-4f48-bad2-66139c93df5e",
                                "sense_id": "6b0243b8-6f3b-38b3-9f29-110f3fc12eb7",
                                "text": "„Sie fuhr nach Lettland zu meiner Frau, die damals dort studierte, und wohnte mit ihr in einem winzigen Zimmerchen unter unmöglichen Bedingungen.“"
                            },
                            {
                                "example_id": "c309194b-1121-4d53-98af-a548273cd245",
                                "sense_id": "6b0243b8-6f3b-38b3-9f29-110f3fc12eb7",
                                "text": "„Dort wurde ich in ein Zimmerchen gerufen.“"
                            },
                            {
                                "example_id": "47b4bb25-d669-4312-a4c5-152c713949e5",
                                "sense_id": "6b0243b8-6f3b-38b3-9f29-110f3fc12eb7",
                                "text": "„Irgendwo in einem Hinterhof hatte er ein billiges Zimmerchen, bevor er der bekannte und begehrte Paul Simmel wurde.“"
                            },
                            {
                                "example_id": "d5a0c784-6078-4fe1-a645-c0d327efd2c2",
                                "sense_id": "6b0243b8-6f3b-38b3-9f29-110f3fc12eb7",
                                "text": "„Die Hausmutter hatte sie in aller Hast nach hinten in ein stilles und abgelegenes Zimmerchen des dreistöckigen Hauses geschickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe25d747-ebc8-4a29-bd31-a7cf21ed705b",
