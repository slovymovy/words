                                            {
                                                "example_id": "cb40c195-0ff4-4b09-aaa0-9681580b53d1",
                                                "sense_id": "84f1e323-0cce-300f-b1bd-a469b4ef6f45",
                                                "text": "Executive Life : racket américain, amateurisme affairiste français."
