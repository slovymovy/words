                "senses": [
                    {
                        "sense_id": "b214eb03-fe98-3565-9f0f-6451fb24ce64",
                        "entry_id": "c7c8493c-3d0d-37c2-8ead-f6a07c1de8b0",
                        "glosses": [
                            "Kampf mit Schusswaffen; Schießerei, Schusswechsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a5638dd-2e02-45fc-b84b-536b1164ffa1",
                                "sense_id": "b214eb03-fe98-3565-9f0f-6451fb24ce64",
                                "text": "We need backup in downtown, heavy gunfight!",
                                "translation": "Wir brauchen Unterstützung in der Innenstadt, heftiger Schusswechsel!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f797a760-cb80-4ec0-b8ee-87db2ac13f18",
                        "source_entry_id": "c7c8493c-3d0d-37c2-8ead-f6a07c1de8b0",
                        "source_sense_id": "b214eb03-fe98-3565-9f0f-6451fb24ce64",
                        "source_sense_description": "Kampf mit Schusswaffen; Schießerei, Schusswechsel",
                        "target_lang_word": "Schießerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schießerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                        "entry_id": "fa579482-6284-38c2-9a29-a678cc7e0340",
                                        "glosses": [
                                            "Abfolge mehrerer Schusswechsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367bc444-f070-49aa-af56-35d1ee0e41ee",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "Gestern gab es vor dem Lokal in der Beethovenstraße mal wieder eine Schießerei."
                                            },
                                            {
                                                "example_id": "45770a2a-23b2-4c28-bd02-c6466be06d26",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "„Ich lachte den Regisseur und Mutter Mewes aus, weil sie den prachtvollen Nachmittag in der Lesehalle verbracht hatten und durch die Berichte über Schießereien und Unruhen in ganz Deutschland verstimmt waren.“"
                                            },
                                            {
                                                "example_id": "6e529256-31ae-43e4-8517-c711f9ab8bb4",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "„Übrigens hatte er, wie ihm später ein Arbeitskollege schrieb, bei seiner Schießerei wie durch ein Wunder niemand verletzt, abgesehen von einem Unbeteiligten, der sich bei dem Sprung aus dem Fenster die Beine gebrochen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                        "entry_id": "fa579482-6284-38c2-9a29-a678cc7e0340",
                                        "glosses": [
                                            "ununterbrochenes, andauerndes Schießen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7237ab9-eb79-494a-81ea-d0d641ce2bc2",
                                                "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                                "text": "Mein Mann ist völlig versessen auf seine Schießerei. Dauernd hängt er auf dem Schießplatz herum."
                                            },
                                            {
                                                "example_id": "0944bd6a-24ae-4d31-bcbe-12edfdfd6ed7",
                                                "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                                "text": "„Die Schießerei hatte unterdessen gewaltig zugenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7ead8ae-d27a-43cf-a1fc-ac605ede25ab",
                        "source_entry_id": "c7c8493c-3d0d-37c2-8ead-f6a07c1de8b0",
                        "source_sense_id": "b214eb03-fe98-3565-9f0f-6451fb24ce64",
                        "source_sense_description": "Kampf mit Schusswaffen; Schießerei, Schusswechsel",
                        "target_lang_word": "Schusswechsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schusswechsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "342e7ce7-5528-39c4-b1cb-c32baa2851bb",
                                        "entry_id": "dd1fa202-9504-3216-b5ce-b0663e7a2fd8",
                                        "glosses": [
                                            "Auseinandersetzung bei der mit Feuerwaffen aufeinander geschossen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d83c45b-eb82-4d12-a06f-943c92f95dc4",
                                                "sense_id": "342e7ce7-5528-39c4-b1cb-c32baa2851bb",
                                                "text": "„Am 03.12.2009 wurde C. bei einem Schusswechsel verletzt und flog zur Behandlung nach Marokko.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f043d66-ca08-46dc-a7bc-c27657f3d0d9",
                        "source_entry_id": "c7c8493c-3d0d-37c2-8ead-f6a07c1de8b0",
                        "source_sense_id": "b214eb03-fe98-3565-9f0f-6451fb24ce64",
                        "source_sense_description": "Kampf mit Schusswaffen; Schießerei, Schusswechsel",
                        "target_lang_word": "Feuergefecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuergefecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                        "entry_id": "c760d8b5-4b25-3898-909d-4497bf4b62c3",
                                        "glosses": [
                                            "Kampf mit Feuer-/Schusswaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97de6e66-ba62-44b5-b562-b6a03c6a6c53",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Um die Mannschaftsbaracke herum fand ein wildes Feuergefecht statt.“"
                                            },
                                            {
                                                "example_id": "7b14a0c6-c8e3-450a-9170-8b29b33ae66c",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Am 18. und 19. November rückten die Truppen noch zwei Tagemärsche weit vor, und die feindlichen Vorposten zogen sich nach unbedeutenden Feuergefechten zurück.“"
                                            },
                                            {
                                                "example_id": "1bde8cc5-b8b3-4af6-926c-3c2aa815d51d",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Aber sie hatte, noch im Backfischalter, die Gefahren des Feuergefechts erlebt, hatte die grauenvollen Berichte von Vergewaltigungen und Folterungen mitangehört, hatte gelegentlich gehungert und ständig in Angst gelebt und hatte zusehen müssen, wie eine Rotte roter Soldaten ihre Rigaer Vettern an die Wand des Hauses stellte und erschoß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
