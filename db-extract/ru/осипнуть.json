                            "participle",
                            "past"
                        ],
                        "form": "оси́пши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a36eef5-aa42-3145-a788-af8fe96228ee",
                        "entry_id": "70a39cf9-29f4-37ac-ace0-9edf6656e571",
                        "glosses": [
                            "разг. утратить чистоту и звучность; стать сиплым (о голосе)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b9b4e1b-f9fc-465e-94e9-44017db4399b",
                                "sense_id": "1a36eef5-aa42-3145-a788-af8fe96228ee",
                                "text": "― Полина! ― закричал Иона Овсеич, голос вдруг осип…"
                            }
                        ]
                    },
                    {
                        "sense_id": "565401f7-01e1-3174-a9f1-f046f8628735",
                        "entry_id": "70a39cf9-29f4-37ac-ace0-9edf6656e571",
                        "glosses": [
                            "разг. утратить способность говорить чисто и звучно; получить сиплость в голосе (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f98d6c8-ae2f-4a95-8b95-a807fe438cbf",
                                "sense_id": "565401f7-01e1-3174-a9f1-f046f8628735",
                                "text": "Не можно вас докричаться! Инда я осипла. Где вы были? Финетта."
                            },
                            {
                                "example_id": "fa018209-d9c8-4048-baeb-fdb0424189f0",
                                "sense_id": "565401f7-01e1-3174-a9f1-f046f8628735",
                                "text": "С товарищами бывало у него ещё хуже: то и дело заводит он их в такие проказы, что нянюшки и дядьки осипнут кричавши, а все толку нет."
                            },
                            {
                                "example_id": "2bcfe01f-2f19-49c1-b30a-150b15361490",
                                "sense_id": "565401f7-01e1-3174-a9f1-f046f8628735",
                                "text": "Ребёнок плачет. Он давно уже осип и изнемог от плача, но всё еще кричит и неизвестно, когда он уймётся."
                            }
                        ]
                    }
                ],
