                        "examples": [
                            {
                                "example_id": "2ac8c021-d212-49a9-92da-df68096753e7",
                                "sense_id": "7a9be7ed-24c3-348d-b500-02082c02da05",
                                "text": "Homeopathische zelfzorggeneesmiddelen zijn populair in Nederland. Jaarlijks worden er 4,5 miljoen verpakkingen verkocht. In driekwart van de huishoudens is een homeopathisch geneesmiddel aanwezig."
                            },
                            {
                                "example_id": "9448e228-4874-4dde-8620-87a70d4d8669",
                                "sense_id": "7a9be7ed-24c3-348d-b500-02082c02da05",
                                "text": "Omega Pharma produceert zelfzorggeneesmiddelen, die zonder recept verkrijgbaar zijn. De miljardendeal betekent dat de aandeelhouders een flinke financiële klapper maken. Marc Coucke en het Nederlandse private equitybedrijf Waterland haalden het bedrijf in 2012 van de beurs voor €848 miljoen."
                            }
                        ]
                    }
