    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d36b48c1-dae7-3764-aa60-b33560e2f3ee",
                    "sense_definition": "Interrogation ou recherche structurée d'informations adressée à une base de données ou à un moteur de recherche.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le système prend quelques secondes pour exécuter une <w>requête</w> complexe dans la base de données."
                        },
                        {
                            "text": "L'utilisateur a saisi une <w>requête</w> précise afin de trouver rapidement les documents souhaités."
                        }
                    ],
                    "synonyms": [
                        "interrogation"
                    ],
                    "common_phrases": [
                        "exécuter une requête",
                        "saisir une requête"
                    ]
                },
                {
                    "sense_id": "8cf97426-270b-3f63-a988-fe74fcdf1170",
                    "sense_definition": "Demande polie ou formelle adressée à une personne pour solliciter quelque chose ; prière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "demande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés ont décidé de formuler une <w>requête</w> auprès de la direction pour leurs conditions de travail."
                        },
                        {
                            "text": "Le directeur a promis de prêter une oreille attentive à notre <w>requête</w>."
                        }
                    ],
                    "synonyms": [
                        "demande",
                        "prière",
                        "sollicitation"
                    ],
                    "common_phrases": [
                        "formuler une requête",
                        "faire une requête"
                    ]
                },
                {
                    "sense_id": "b13cf7d6-dc83-3a3d-a8c8-06676a6d2c57",
                    "sense_definition": "Demande écrite officielle et motivée adressée à une autorité judiciaire ou administrative compétente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a conseillé à son client de déposer une <w>requête</w> devant le tribunal administratif."
                        },
                        {
                            "text": "Les juges ont finalement rejeté la <w>requête</w> introduite par l'association de protection de la nature."
                        }
                    ],
                    "synonyms": [
                        "pétition",
                        "recours"
                    ],
                    "common_phrases": [
                        "déposer une requête",
                        "rejeter une requête"
                    ]
                },
                {
                    "sense_id": "463533c9-5723-3740-9afb-01e68dfe7ffe",
                    "sense_definition": "Message envoyé par un ordinateur client à destination d'un serveur pour solliciter un service ou une ressource.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le navigateur web doit envoyer une <w>requête</w> au serveur pour afficher le contenu de la page."
                        },
                        {
                            "text": "Le serveur a renvoyé un code d'erreur car la <w>requête</w> envoyée était incomplète."
                        }
                    ],
                    "antonyms": [
                        "réponse"
                    ],
                    "common_phrases": [
                        "envoyer une requête",
                        "requête HTTP"
                    ]
                },
                {
                    "sense_id": "1cf435bc-8a59-34f1-abd1-f38fe08a17af",
                    "sense_definition": "Nouvelle recherche que l'on effectue pour retrouver la trace d'un animal dont la voie a été perdue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les piqueurs ont mis les chiens en <w>requête</w> après avoir perdu la voie du grand cerf."
                        },
                        {
                            "text": "La <w>requête</w> a permis à l'équipage de retrouver la piste de l'animal dans le sous-bois."
                        }
                    ],
                    "common_phrases": [
                        "mettre en requête"
                    ]
                }
            ]
        }
    ]
