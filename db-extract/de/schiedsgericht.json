                            {
                                "example_id": "70b82010-d4fc-4c27-b02a-7f1149ef85af",
                                "sense_id": "21d0eba3-a35b-3a09-b94e-3aa0321092c8",
                                "text": "Sollen europäische Energiefirmen auch weiterhin EU-Staaten vor privaten Schiedsgerichten verklagen können – wenn die Firmen sich durch staatliche Politik geschädigt sehen?",
                                "translation": "Les entreprises européennes du secteur de l’énergie doivent-elles continuer à pouvoir poursuivre les États de l'UE devant des tribunaux d'arbitrage privés si les entreprises s’estiment endommagées par les politiques publiques ?"
                            }
                        ]
                    }
