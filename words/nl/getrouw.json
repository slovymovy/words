                {
                    "sense_id": "36d2d7ab-015c-3af0-88c3-2ea0e4b2f7b5",
                    "sense_definition": "iemand die steun en loyaliteit blijft geven aan een persoon, geloof of principe",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "loyaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond bleef zijn baasje tot het einde <w>getrouw</w> volgen.",
                            "target_lang_translations": {
                                "en": "The dog continued to <w>faithfully</w> follow his owner until the end.",
                                "es": "El perro siguió a su dueño <w>fielmente</w> hasta el final."
                            }
                        },
                        {
                            "text": "Zij is een <w>getrouwe</w> aanhanger van deze politieke partij.",
                            "target_lang_translations": {
                                "en": "She is a <w>loyal</w> supporter of this political party.",
                                "es": "Ella es una partidaria <w>leal</w> de este partido político."
                            }
