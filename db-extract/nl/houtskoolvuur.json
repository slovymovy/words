                        "glosses": [
                            "warmtebron bestaande uit brandende stukjes verkoold hout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c121581a-6f4d-4780-aeec-72bf9bc76621",
                                "sense_id": "f03afa25-d4b4-3646-8509-016ecd33cc4d",
                                "text": "Allereerst moet het stuk rundvlees gemarineerd worden in de juiste kruiden. Dan wordt het gerookt in een houtskoolvuur."
                            },
                            {
                                "example_id": "efc3438d-9440-43a4-9077-7f580a214523",
                                "sense_id": "f03afa25-d4b4-3646-8509-016ecd33cc4d",
                                "text": "De geuren van kookpotten en houtskoolvuren dwarrelen de auto in."
                            },
                            {
                                "example_id": "0265804e-e191-4d97-bc8e-1d3967a65e17",
                                "sense_id": "f03afa25-d4b4-3646-8509-016ecd33cc4d",
                                "text": "Hele families kamperen op de betonnen vloer en stoken houtskoolvuurtjes om rijst te koken."
                            }
                        ]
                    }
