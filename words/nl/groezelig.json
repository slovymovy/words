{
    "word_family": [
        "groezel",
        "groezeligheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd6d45e7-3f1c-302d-ade7-1ab0cf4fa2b2",
                    "sense_definition": "Niet helemaal schoon of een beetje vuil door gebruik.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vuil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij droeg een <w>groezelige</w> broek tijdens het gesprek en werd daarom niet aangenomen.",
                            "target_lang_translations": {
                                "en": "He wore <w>grubby</w> trousers during the interview and was therefore not hired."
                            }
                        },
                        {
                            "text": "De muren in de gang zagen er na jarenlang gebruik nogal <w>groezelig</w> uit.",
                            "target_lang_translations": {
                                "en": "The walls in the hallway looked rather <w>dingy</w> after years of use."
                            }
                        }
                    ],
                    "synonyms": [
                        "viezig"
                    ],
                    "antonyms": [
                        "schoon",
                        "fris"
                    ],
                    "common_phrases": [
                        "groezelige handdoek",
                        "groezelige vingers"
                    ],
                    "target_lang_definitions": {
                        "en": "Not entirely clean or slightly dirty from use."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grubby",
                                "target_lang_sense_clarification": "slightly dirty, especially from being handled"
                            },
                            {
                                "target_lang_word": "dingy",
                                "target_lang_sense_clarification": "discolored or faded from use or age"
                            },
                            {
                                "target_lang_word": "grimy",
                                "target_lang_sense_clarification": "covered with or characterized by ingrained dirt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab21c19d-2635-3cc7-8cf2-dd5d3e68e2de",
                    "sense_definition": "Smerig en onhygiënisch, vaak met een onfrisse of armoedige uitstraling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vuil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gasten van dat <w>groezelig</w> motel klaagden over de gebrekkige hygiëne van de lakens.",
                            "target_lang_translations": {
                                "en": "The guests of that <w>seedy</w> motel complained about the poor hygiene of the sheets."
                            }
                        },
                        {
                            "text": "In die <w>groezelige</w> buurt durfde zij 's avonds laat niet alleen over straat te lopen.",
                            "target_lang_translations": {
                                "en": "She didn't dare walk the streets alone late at night in that <w>squalid</w> neighborhood."
                            }
                        }
                    ],
                    "synonyms": [
                        "viezig",
                        "schmutzig"
                    ],
                    "antonyms": [
                        "onberispelijk",
                        "helder"
                    ],
                    "common_phrases": [
                        "groezelig motel",
                        "groezelige buurt"
                    ],
                    "target_lang_definitions": {
                        "en": "Filthy and unhygienic, often with an unpleasant or shabby appearance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seedy",
                                "target_lang_sense_clarification": "shabby and squalid in appearance"
                            },
                            {
                                "target_lang_word": "squalid",
                                "target_lang_sense_clarification": "extremely dirty and unpleasant, especially as a result of poverty or neglect"
                            },
                            {
                                "target_lang_word": "shabby",
                                "target_lang_sense_clarification": "in poor condition through long or hard use or lack of care"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}