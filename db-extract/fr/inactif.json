                                                "sense_id": "7b5a9f6b-2561-33dd-92ef-156826a4fca7",
                                                "text": "The photocopier is inactive pending repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97075b02-2636-3534-8d3b-71bcabe7e377",
                                        "entry_id": "66822b41-0320-3930-b577-d72ad513313b",
                                        "glosses": [
