                "senses": [
                    {
                        "sense_id": "93251f16-0da4-388d-b058-b2b982eb6d31",
                        "entry_id": "4493b051-d1d9-3549-aab7-c6317975ddbf",
                        "glosses": [
                            "Weg, der bis zu einem bestimmten Ziel im Marsch zurückgelegt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201938d0-f5a0-4735-be9f-c9b8a353e8b7",
                                "sense_id": "93251f16-0da4-388d-b058-b2b982eb6d31",
                                "text": "„Auf Anmarschrouten von 500 und mehr Kilometern bewegten sich die Plünderer aus der Tiefe der Wildnis heraus, um die spanischen Vorposten und Bauerndörfer anzugreifen, in denen Großgrundbesitzer Haciendas betrieben und die Felder von Mestizen und versklavten Indios bestellen ließen.“"
                            },
                            {
                                "example_id": "c830dca7-9ecc-4517-bcaf-a1fb072da6fe",
                                "sense_id": "93251f16-0da4-388d-b058-b2b982eb6d31",
                                "text": "„Die Anmarschroute auf das schwach besetzte Fort Duquesne war umstritten.“"
                            },
                            {
                                "example_id": "58aee1a9-b561-41d6-bd70-1cf785f6cd91",
                                "sense_id": "93251f16-0da4-388d-b058-b2b982eb6d31",
                                "text": "Die Anmarschroute ist bereits von 1929 bekannt."
                            },
                            {
                                "example_id": "205693da-7932-4d7f-9120-ef97c73ac094",
                                "sense_id": "93251f16-0da4-388d-b058-b2b982eb6d31",
                                "text": "Leutnant Hahn bestimmte nach Karte und Kompass eine andere Marschrichtung, die von der Anmarschroute um einige Grad abwich."
                            },
                            {
                                "example_id": "69f85a04-4ba5-4587-ad32-ce1044c613be",
                                "sense_id": "93251f16-0da4-388d-b058-b2b982eb6d31",
                                "text": "Doch nur, wer die Anmarschroute durch die Quebrada de los Cedros wählt, bekommt die faszinierende Pyramidenform des Alpamayo zu Gesicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
