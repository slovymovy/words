                        "translation_id": "de42098e-52c1-4521-a2b6-0bb89402e47a",
                        "source_entry_id": "eb091076-7197-32a4-88ce-390f4d04ba33",
                        "source_sense_id": "b0087a2b-4fc5-3b79-838c-d7378032d8d3",
                        "target_lang_word": "Angriffswaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angriffswaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e4b4180-bfa8-3530-a7d0-64b4dfb4ce94",
                                        "entry_id": "320fc5dc-7a46-381b-98f7-26e25b119ad3",
                                        "glosses": [
                                            "Waffe, die besonders für das Ausführen eines Angriffs geeignet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc73a8a6-92c9-4b54-a17a-7add86485e1e",
                                                "sense_id": "2e4b4180-bfa8-3530-a7d0-64b4dfb4ce94",
                                                "text": "„Zu den Angriffswaffen rechnet man die Seil- und Schleuderwaffen hinzu, welche aus organischem Material bestanden und eine Zwischenform zwischen Fern- und Nahkampfwaffen bilden.“"
                                            },
                                            {
                                                "example_id": "5bd8cd13-261d-4ac4-bf05-077b52733d8f",
                                                "sense_id": "2e4b4180-bfa8-3530-a7d0-64b4dfb4ce94",
                                                "text": "„\"Sie wurden wegen Verdachts auf Besitz einer Angriffswaffe festgenommen, allerdings deswegen keine weiteren Schritte eingeleitet. Die Einwanderungsbehörde wurde informiert\", teilte die Polizei der Zeitung mit.“"
                                            },
                                            {
                                                "example_id": "60ea9abe-03ee-44df-9835-39b7eff1f497",
                                                "sense_id": "2e4b4180-bfa8-3530-a7d0-64b4dfb4ce94",
                                                "text": "„LANCE (Laser Advancement for Next Generation Compact Environment) ist Teil des SHiELD-Programms (Self-protect High Energy Laser Demonstrator) der USAF und zielt, wie der Name schon sagt, darauf ab, keine Angriffswaffe, sondern eine Verteidigungswaffe zu entwickeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
