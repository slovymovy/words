                                                "example_id": "9b1d5180-70a6-4278-a05b-66c1b3aa870b",
                                                "sense_id": "facab184-e36e-3ff9-ac87-67ac46a0a5a6",
                                                "text": "A woman in Sweden has been accused of necrophilia after investigators found some 100 skeleton parts in her apartment."
                                            },
