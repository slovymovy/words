                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b30ecc8d-6ecc-43e1-a4f5-5ff3b90c618f",
                                "sense_id": "f22a3b60-a868-3eb7-a40b-1cb78f6e4fee",
                                "text": "„Verena Merz ist in der fünften Generation Berufsfischerin und serviert den Gästen im familieneigenen Hotel und Restaurant den fangfrischen Fisch.“"
                            },
                            {
                                "example_id": "33d51e06-791b-4ded-8d48-3584e934ddea",
                                "sense_id": "f22a3b60-a868-3eb7-a40b-1cb78f6e4fee",
                                "text": "„Die Berufsfischerin aus Gaissau in Vorarlberg fuhr schon von kleinauf mit ihrem Vater auf den Bodensee, manchmal mit ihren drei Geschwistern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
