                "senses": [
                    {
                        "sense_id": "aac0646f-8858-3fd9-9d1d-171302bdfd46",
                        "entry_id": "eeb0c775-90b8-3ce1-b2f3-46708552edaa",
                        "glosses": [
                            "niederösterreichische Gemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd924e0-9a6b-4fee-ae69-943864c7a27d",
                                "sense_id": "aac0646f-8858-3fd9-9d1d-171302bdfd46",
                                "text": "Münchendorf ist heute mit einer guten Infrastruktur versehen."
                            },
                            {
                                "example_id": "a1f9e644-6a0a-4635-8ba6-408b60eb45a6",
                                "sense_id": "aac0646f-8858-3fd9-9d1d-171302bdfd46",
                                "text": "In Münchendorf wurde bereits Anfang des Jahres das alte Bahnhofsgebäude abgetragen und mit dem Bau des neuen Personendurchgangs begonnen. Derzeit wird dort am neuen Personendurchgang Bahnhof Münchendorf gearbeitet."
                            },
                            {
                                "example_id": "a69777a3-8d0a-4e85-a294-84a7424b2ced",
                                "sense_id": "aac0646f-8858-3fd9-9d1d-171302bdfd46",
                                "text": "Die Feuerwehren Münchendorf und Achau mussten den schwer verletzten Mann mittels hydraulischem Rettungsgerät aus dem Wagen befreien."
                            },
                            {
                                "example_id": "6085d6f0-3261-4472-b9d2-5c6f5847859f",
                                "sense_id": "aac0646f-8858-3fd9-9d1d-171302bdfd46",
                                "text": "Speziell in den Ortschaften Achau, wo bereits erste Straßen gesperrt und Sandsäcke gefüllt wurden, sowie in Münchendorf spitzt sich die Lage zu: Triesting und Schwechat führen Hochwasser, die Flusspegel sind leicht steigend."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
