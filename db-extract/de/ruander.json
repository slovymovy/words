                        "glosses": [
                            "Staatsbürger von Ruanda"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a8a167-2cf4-43a4-932c-f59ec4cc2f2d",
                                "sense_id": "a5f4d41e-c16f-3ccd-8806-5f7700b8df7a",
                                "text": "Er war Ruander, hatte aber jahrelang in Tansania gelebt."
                            }
                        ],
                        "sense_index_json": "\"1\""
