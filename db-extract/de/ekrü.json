                                "target_senses": [
                                    {
                                        "sense_id": "469213c1-23a8-3ee4-9620-ee3e597b8b85",
                                        "entry_id": "d651a797-b938-34d4-92bd-21be35a3180a",
                                        "glosses": [
                                            "образовавшийся или происходящий в природе, без участия или влияния человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3f331f0-076e-4448-bee6-b71a6c36a0cb",
                                                "sense_id": "469213c1-23a8-3ee4-9620-ee3e597b8b85",
                                                "text": "Кладка из естественного камня точно так же, как и кирпичная, требует применения определенной системы перевязки."
                                            },
                                            {
                                                "example_id": "84f9a39d-1fc3-432e-b7e1-465ee3b1d9b7",
                                                "sense_id": "469213c1-23a8-3ee4-9620-ee3e597b8b85",
                                                "text": "Естественный отбор."
                                            },
                                            {
                                                "example_id": "a42daddc-471b-4425-9f6b-9b7f0c32d1a2",
                                                "sense_id": "469213c1-23a8-3ee4-9620-ee3e597b8b85",
                                                "text": "Луна — огромный естественный спутник нашей планеты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c6572e-01de-3493-9c6c-54542cfb8e18",
                                        "entry_id": "d651a797-b938-34d4-92bd-21be35a3180a",
                                        "glosses": [
                                            "нормальный, без отклонений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa18309-d916-47d8-bde3-fccd058a5855",
                                                "sense_id": "35c6572e-01de-3493-9c6c-54542cfb8e18",
                                                "text": "Таким образом, минимальный естественный возраст для отлучения ребенка от груди — 2.5 года, максимальный — 7 лет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd250291-affa-488f-ae13-2c9ff6508143",
                        "source_entry_id": "214ba6de-221a-3b7d-8aa0-a171570ac251",
                        "source_sense_id": "359c43bb-9990-3f49-8e92-7d5bfbf510ff",
                        "source_sense_description": "von Textilien: naturfarben, ungebleicht",
                        "target_lang_word": "сырой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сырой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0610d3c0-0bb3-3b70-b8b8-d3d224bb6330",
                                        "entry_id": "c25272af-a3ff-3e96-a039-35d6ed529866",
                                        "glosses": [
                                            "влажный, мокрый, содержащий жидкость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b820f055-c268-4a78-9c3d-78da8fd9345e",
                                                "sense_id": "0610d3c0-0bb3-3b70-b8b8-d3d224bb6330",
                                                "text": "Охотники шли рядом по сырой, поросшей травою дороге."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba1ebf99-50b9-396a-8239-37c6168dd9a0",
                                        "entry_id": "c25272af-a3ff-3e96-a039-35d6ed529866",
                                        "glosses": [
                                            "(о погоде) дождливый, слякотный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d5d02f0-c225-4e1f-8dc6-0c37886a0b2a",
                                                "sense_id": "ba1ebf99-50b9-396a-8239-37c6168dd9a0",
                                                "text": "Я люблю, как поют под шарманку в холодный, тёмный и сырой осенний вечер, непременно в сырой, когда у всех прохожих бледнозелёные и больные лица…"
                                            },
                                            {
                                                "example_id": "14bb3067-ea68-4923-a782-fa568ffad0ab",
                                                "sense_id": "ba1ebf99-50b9-396a-8239-37c6168dd9a0",
                                                "text": "Лето выдалось сырое и холодное, деревья были мокрые, всё в саду глядело неприветливо, уныло, хотелось в самом деле работать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2adf582-1b73-347f-bfcd-4149aeb8d83e",
                                        "entry_id": "c25272af-a3ff-3e96-a039-35d6ed529866",
                                        "glosses": [
                                            "не подвергавшийся варке, кипячению, жарению и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0345ddf-f222-4dc4-b2b9-262e0df6f88d",
                                                "sense_id": "a2adf582-1b73-347f-bfcd-4149aeb8d83e",
                                                "text": "Одна кучка французов стояла близко у дороги, и два солдата — лицо одного из них было покрыто болячками — разрывали руками кусок сырого мяса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278b1bc1-7def-3e41-bd17-5442e4c3c9e4",
                                        "entry_id": "c25272af-a3ff-3e96-a039-35d6ed529866",
                                        "glosses": [
                                            "не доведённый до готовности"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6a07fd6-bf94-3d14-a111-1e9272ba8d41",
                                        "entry_id": "c25272af-a3ff-3e96-a039-35d6ed529866",
                                        "glosses": [
                                            "необработанный или подвергшийся лишь первичной обработке"
                                        ],
                                        "tags": [],
                                        "examples": [
