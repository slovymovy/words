{
    "word_family": [
        "order",
        "orderly",
        "disorderly",
        "disordered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe077f4c-93a0-32bc-b485-da8f2fb8b342",
                    "sense_definition": "A physical or mental health condition that disrupts normal body or mind functions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that an eating <w>disorder</w> requires both medical and psychological support.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что пищевое <w>расстройство</w> требует как медицинской, так и психологической поддержки."
                            }
                        },
                        {
                            "text": "Many people suffer from a sleep <w>disorder</w> that prevents them from feeling rested in the morning.",
                            "target_lang_translations": {
                                "ru": "Многие люди страдают от <w>нарушения</w> сна, которое мешает им чувствовать себя отдохнувшими по утрам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eating disorder",
                        "genetic disorder",
                        "mental disorder",
                        "sleep disorder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое или психическое состояние, нарушающее нормальное функционирование организма или разума."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстройство",
                                "target_lang_sense_clarification": "медицинское или психическое нарушение"
                            },
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "сбой в работе функций организма"
                            },
                            {
                                "target_lang_word": "заболевание",
                                "target_lang_sense_clarification": "болезненное состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a558fdf-cc99-3bed-9c68-12d3c3018fae",
                    "sense_definition": "A state of confusion or a lack of organization.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "lack of order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden power outage left the entire office in <w>disorder</w> for several hours.",
                            "target_lang_translations": {
                                "ru": "Внезапное отключение электричества на несколько часов погрузило весь офис в <w>беспорядок</w>."
                            }
                        },
                        {
                            "text": "After the children finished playing, the room was in complete <w>disorder</w> with toys everywhere.",
                            "target_lang_translations": {
                                "ru": "После того как дети закончили играть, в комнате воцарился полный <w>беспорядок</w>, повсюду валялись игрушки."
                            }
                        }
                    ],
                    "synonyms": [
                        "chaos",
                        "confusion",
                        "disarray",
                        "disorganization",
                        "mess",
                        "muddle"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "common_phrases": [
                        "complete disorder",
                        "total disorder",
                        "state of disorder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние путаницы или отсутствие организованности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядок",
                                "target_lang_sense_clarification": "отсутствие порядка или системы"
                            },
                            {
                                "target_lang_word": "неразбериха",
                                "target_lang_sense_clarification": "состояние путаницы"
                            },
                            {
                                "target_lang_word": "хаос",
                                "target_lang_sense_clarification": "полная дезорганизация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40085675-362c-3f46-ae02-36719c9502b2",
                    "sense_definition": "A disturbance of public peace or a situation where people behave in a violent or uncontrolled way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social unrest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police were called to the stadium to prevent further civil <w>disorder</w> after the match.",
                            "target_lang_translations": {
                                "ru": "Полиция была вызвана на стадион, чтобы предотвратить дальнейшие гражданские <w>беспорядки</w> после матча."
                            }
                        },
                        {
                            "text": "The government feared that the new law would lead to widespread public <w>disorder</w> across the country.",
                            "target_lang_translations": {
                                "ru": "Правительство опасалось, что новый закон приведет к массовым общественным <w>беспорядкам</w> по всей стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedlam",
                        "shambles"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "common_phrases": [
                        "civil disorder",
                        "public disorder",
                        "social disorder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушение общественного порядка или ситуация, когда люди ведут себя неконтролируемо или агрессивно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядки",
                                "target_lang_sense_clarification": "массовые нарушения общественного спокойствия"
                            },
                            {
                                "target_lang_word": "волнения",
                                "target_lang_sense_clarification": "народные выступления"
                            },
                            {
                                "target_lang_word": "смута",
                                "target_lang_sense_clarification": "мятеж или раздор"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "939f5ba3-54fd-3774-9f95-0a57d68b83fb",
                    "sense_definition": "To disturb the normal arrangement or state of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "to disrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden gust of wind threatened to <w>disorder</w> the carefully arranged papers on the desk.",
                            "target_lang_translations": {
                                "ru": "Внезапный порыв ветра грозил <w>привести в беспорядок</w> аккуратно разложенные на столе бумаги."
                            }
                        },
                        {
                            "text": "Moving the furniture would <w>disorder</w> the room and make it difficult to navigate.",
                            "target_lang_translations": {
                                "ru": "Перестановка мебели <w>нарушит порядок</w> в комнате и затруднит передвижение."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorganization",
                        "muddle"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушать нормальное расположение или состояние чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приводить в беспорядок",
                                "target_lang_sense_clarification": "нарушать организованность"
                            },
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "нарушать привычный строй"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c15a7095-3f75-37b2-a9a1-ad086798ac6f",
                    "sense_definition": "To disrupt a specific sequence or logical progression.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "to disrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One wrong entry in the database could <w>disorder</w> the entire filing system.",
                            "target_lang_translations": {
                                "ru": "Одна неверная запись в базе данных может <w>нарушить</w> всю систему учета."
                            }
                        },
                        {
                            "text": "The researcher was careful not to <w>disorder</w> the samples during the transportation process.",
                            "target_lang_translations": {
                                "ru": "Исследователь старался не <w>перепутать</w> образцы в процессе транспортировки."
                            }
                        }
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушать определенную последовательность или логический порядок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "сбивать последовательность"
                            },
                            {
                                "target_lang_word": "дезорганизовывать",
                                "target_lang_sense_clarification": "вносить хаос в систему"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}