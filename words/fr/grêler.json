            "senses": [
                {
                    "sense_id": "4a43fd69-037c-339d-a2b4-5fb2c0e1c10f",
                    "sense_definition": "Tomber du ciel sous la forme de petits grains de glace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "precipitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant le violent orage d'hier soir, il s'est mis à <w>grêler</w> sur tout le village."
                        },
                        {
                            "text": "Le ciel est devenu très sombre et soudainement il a commencé à <w>grêler</w>."
                        }
                    ],
                    "common_phrases": [
                        "il grêle"
                    ]
                },
                {
                    "sense_id": "8ce285be-7a5e-3c9c-bb42-901c3e7e4e03",
                    "sense_definition": "Endommager ou détruire des récoltes ou des biens en parlant de la grêle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "degats",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orage a violemment frappé la région et a <w>grêlé</w> les vergers du domaine."
                        },
                        {
                            "text": "Les fortes intempéries risquent de <w>grêler</w> les récoltes avant la moisson prochaine."
                        }
                    ],
                    "synonyms": [
                        "abîmer",
                        "ravager"
                    ],
                    "antonyms": [
                        "épargner"
                    ],
                    "common_phrases": [
                        "grêler les récoltes",
                        "grêler les vignes"
                    ]
                },
                {
                    "sense_id": "b5479bcc-b1cd-3080-b8a3-6dc6285eb4cf",
                    "sense_definition": "S'abattre ou frapper de manière continue et répétée, en grand nombre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abondance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les projectiles ont commencé à <w>grêler</w> sur les toits des maisons voisines."
                        },
                        {
                            "text": "Les critiques continuaient de <w>grêler</w> sur le ministre après son discours officiel."
                        }
                    ],
                    "synonyms": [
                        "pleuvoir",
                        "déferler"
                    ]
                }
            ]
        }
