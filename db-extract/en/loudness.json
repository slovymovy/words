                    },
                    {
                        "translation_id": "cfba2975-3455-4fcf-9851-b7affd68bd53",
                        "source_entry_id": "f6682065-69a6-3f1d-bd5e-1501292fdabf",
                        "source_sense_description": "perceptual strength or amplitude of sound pressure",
                        "target_lang_word": "Lautstärke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lautstärke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68125ac9-e577-37f6-adb0-6a03ed96b6e8",
                                        "entry_id": "df312a9f-1d69-3ef1-9eb7-091f8d4d000c",
                                        "glosses": [
                                            "Stärke/Intensität des Schalls"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e2e1ed2-39be-4f1b-9fdb-6c87238dd8b6",
                                                "sense_id": "68125ac9-e577-37f6-adb0-6a03ed96b6e8",
                                                "text": "Die Lautstärke des Presslufthammers war unerträglich."
                                            },
                                            {
                                                "example_id": "e4632c60-1b46-4d29-acac-2a18c3f97117",
                                                "sense_id": "68125ac9-e577-37f6-adb0-6a03ed96b6e8",
                                                "text": "„Während des Abendessens in der Kongreßhaus-Cafeteria war das Radio auf volle Lautstärke gestellt, und alle hatten die Nachrichten hören können.“"
                                            },
                                            {
                                                "example_id": "fb5442d5-1979-4331-af39-f08c582d8810",
                                                "sense_id": "68125ac9-e577-37f6-adb0-6a03ed96b6e8",
                                                "text": "„Mit dieser Frage begann der Jubel ein bisschen an Lautstärke zu verlieren.“"
                                            },
                                            {
                                                "example_id": "7ca6cd0d-fbbe-4c3a-8c40-d67d5e44d38d",
                                                "sense_id": "68125ac9-e577-37f6-adb0-6a03ed96b6e8",
                                                "text": "„Die Musik spielte wieder in voller Lautstärke.“"
                                            },
                                            {
                                                "example_id": "4ee91b7e-4123-49cb-aa30-b81273b1d3c5",
                                                "sense_id": "68125ac9-e577-37f6-adb0-6a03ed96b6e8",
                                                "text": "„Genaue akustische Messungen an Stätten öffentlicher Massenvergnügungen ergaben, dass die schrillen Aufschreie der Damen von hundert und mehr Phon Lautstärke jene Geräuschqualität erreicht haben, unter der auch robuste Männer nach kurzer Zeit seelisch und körperlich zusammenbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
