        "ru-extract.jsonl": [
            {
                "entry_id": "e45b1bc7-f8dd-3a5f-90bd-a7cfc4a4f419",
                "word": "добросовестно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "54e0fb4e-a3a1-3849-a43b-083fdf423173",
                        "entry_id": "e45b1bc7-f8dd-3a5f-90bd-a7cfc4a4f419",
                        "glosses": [
                            "наречие к добросовестный; честно выполняя свои обязательства; основательно; старательно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "46880efc-526f-4e7d-9f63-74bde0f975d0",
                                "sense_id": "54e0fb4e-a3a1-3849-a43b-083fdf423173",
                                "text": "Он добросовестно изучил вопрос."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54fc043d-f368-4d4b-a393-e700734c568d",
                        "source_entry_id": "e45b1bc7-f8dd-3a5f-90bd-a7cfc4a4f419",
                        "source_sense_id": "54e0fb4e-a3a1-3849-a43b-083fdf423173",
                        "target_lang_word": "bona fide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bona fide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21469870-42e0-3fe7-b61c-6b25d6bf22a1",
                                        "entry_id": "91dfeb7c-9482-3f91-b180-dcb5ae49757a",
                                        "glosses": [
                                            "In good faith; genuinely, sincerely."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee6ddab-e928-4c6b-b3f0-6783ef872c53",
                                                "sense_id": "21469870-42e0-3fe7-b61c-6b25d6bf22a1",
                                                "text": "But by the knots I am speaking of, may it please your reverences to believe, that I mean good, honest, devilish tight, hard knots, made bona fide, as Obadiah made his; […]"
                                            },
                                            {
                                                "example_id": "1db0eee2-c46f-4e07-8f51-bb32d46b8453",
                                                "sense_id": "21469870-42e0-3fe7-b61c-6b25d6bf22a1",
                                                "text": "Let thinking people, then, judge what must be the fate of a church, whose fundamental doctrines are disbelieved by men of sense and inquiry, whose articles are well known not to be subscribed bonâ fide by those who officiate in it […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bona fide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "392a1137-3b19-38ec-802c-e7f0fd599533",
                                        "entry_id": "648ed6db-832f-3610-9f57-ed78adbf970d",
                                        "glosses": [
                                            "In good faith; sincere; without deception or ulterior motive."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd94ce19-0ad2-4395-89c1-0906b7280944",
                                                "sense_id": "392a1137-3b19-38ec-802c-e7f0fd599533",
                                                "text": "Although he failed, the prime minister made a bona fide attempt to repair the nation's damaged economy."
                                            },
                                            {
                                                "example_id": "ddb8a2dd-9873-420e-af15-abc321dbb50a",
                                                "sense_id": "392a1137-3b19-38ec-802c-e7f0fd599533",
                                                "text": "It is impossible to say how far this adherence to a creed is a bona fide reversion to a devout habit of mind, and how far it is to be classed as a case of protective mimicry assumed for the purpose of an outward assimilation to canons of reputability borrowed from foreign ideals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4808476-21b4-3633-8f35-5a44e9151d43",
                                        "entry_id": "648ed6db-832f-3610-9f57-ed78adbf970d",
                                        "glosses": [
                                            "Genuine; not counterfeit."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ddb0a1-2442-4747-9276-405044d24231",
                                                "sense_id": "c4808476-21b4-3633-8f35-5a44e9151d43",
                                                "text": "This is a bona fide Roman coin."
                                            },
                                            {
                                                "example_id": "22a20d9a-d934-448e-a968-0c2d22575853",
                                                "sense_id": "c4808476-21b4-3633-8f35-5a44e9151d43",
                                                "text": "To Billy Byrne, then, Pesita was a real general, and Billy, himself, a bona fide captain."
                                            },
                                            {
                                                "example_id": "4ca6a965-4466-46f0-b424-3bca698147a4",
                                                "sense_id": "c4808476-21b4-3633-8f35-5a44e9151d43",
                                                "text": "What intrigues us is what will happen when the ersatzes for the ersatzes come along. Will characters start substituting for actors, bona fide dogs for barking ladies; will people start looking at people again instead of television and at nature instead of at documentaries?"
                                            },
                                            {
                                                "example_id": "f644a71f-d44b-48db-af2d-a9313c2e6ff7",
                                                "sense_id": "c4808476-21b4-3633-8f35-5a44e9151d43",
                                                "text": "Ulysses Everett McGill: I am the only daddy you got! I’m the damn pater familias!\nWharvey Gal: But you ain’t bona fide!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2a442ff-eeef-4a6c-86b1-19586af43fa9",
                        "source_entry_id": "e45b1bc7-f8dd-3a5f-90bd-a7cfc4a4f419",
                        "source_sense_id": "54e0fb4e-a3a1-3849-a43b-083fdf423173",
                        "target_lang_word": "b.f.",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "23ac1a0d-3d92-4630-8350-532148fa396f",
                        "source_entry_id": "e45b1bc7-f8dd-3a5f-90bd-a7cfc4a4f419",
                        "source_sense_id": "54e0fb4e-a3a1-3849-a43b-083fdf423173",
