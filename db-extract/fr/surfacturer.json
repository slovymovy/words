                ],
                "senses": [
                    {
                        "sense_id": "4bfcf8ac-bc72-3f5f-9147-1aeefa0d5387",
                        "entry_id": "50d4abdc-4cc1-3db9-8a72-cdcbd849c741",
                        "glosses": [
                            "Facturer à un prix supérieur au prix normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28097ef2-f58b-4599-911d-3562b8a8b581",
                                "sense_id": "4bfcf8ac-bc72-3f5f-9147-1aeefa0d5387",
                                "text": "Une mention spéciale pour Axel Loustau, vieille connaissance de la présidente lui aussi, passé par le GUD, et qui a, semble-t-il, profité du grand cœur de Marine pour surfacturer l’impression des tracts et affiches de campagne — une petite entourloupe classique, au FN."
                            },
                            {
                                "example_id": "824fcb6f-67d3-45d1-91bf-14b66329e3e0",
                                "sense_id": "4bfcf8ac-bc72-3f5f-9147-1aeefa0d5387",
                                "text": "C’est bien la totalité de la taxe payée en 2016, 2017 et 2018 qui sera rétrocédée et non le seul surplus surfacturé par la Métropole de Lyon (de l’ordre de 20 %)."
                            }
                        ]
                    }
                ],
