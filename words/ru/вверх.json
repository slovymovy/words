                            }
                        },
                        {
                            "text": "Мы отправились <w>вверх</w> по течению на лодке.",
                            "target_lang_translations": {
                                "en": "We went <w>up</w> the river by boat.",
                                "nl": "We gingen met de boot <w>stroomopwaarts</w>.",
                                "pl": "Popłynęliśmy łodzią <w>w górę</w> rzeki.",
                                "de": "Wir fuhren mit dem Boot <w>flussaufwärts</w>.",
                                "fr": "Nous sommes partis <w>en amont</w> en bateau.",
                                "it": "Siamo andati <w>a monte</w> lungo il fiume in barca.",
                                "cs": "Vydali jsme se na loďce <w>proti proudu</w>.",
                                "tr": "Tekneyle nehrin <w>akıntısına karşı</w> yola çıktık.",
                                "es": "Fuimos en bote <w>contra la corriente</w>.",
                                "zh": "我们乘船<w>向上游</w>出发了。"
                            }
