                "senses": [
                    {
                        "sense_id": "756408cf-54af-3984-9d82-680ea940a131",
                        "entry_id": "714a6992-9cb6-38ab-a812-f3bb9c1571ec",
                        "glosses": [
                            "częściowa ciemność, gdy barwy przestają być dostrzegalne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb8a2a12-ed91-49e8-9543-de16e821e4ce",
                                "sense_id": "756408cf-54af-3984-9d82-680ea940a131",
                                "text": "Jeszcze jedną ważną cechą Okrętu, myślał smętnie sierżant Colon, kiedy opadali w błękitny półmrok, było to, że nie dało się wybrać wody z zęzy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1191059-f19a-439c-adf6-d873d5325266",
                        "source_entry_id": "714a6992-9cb6-38ab-a812-f3bb9c1571ec",
                        "source_sense_id": "756408cf-54af-3984-9d82-680ea940a131",
                        "target_lang_word": "pénombre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pénombre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8a8ce8-7795-3f09-81c4-1bdda23ef224",
                                        "entry_id": "e83174e0-7267-3552-8249-a04c9602e8da",
                                        "glosses": [
                                            "Zone d’ombre où la lumière du corps éclairant est partiellement interceptée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b7828d-01d5-4d5b-b8ea-2c923d93e480",
                                                "sense_id": "4e8a8ce8-7795-3f09-81c4-1bdda23ef224",
                                                "text": "Cette flamboyante clarté encadrait, pour ainsi dire, la pénombre où se dessinaient vaguement les grands arbres du jardin d’hiver."
                                            },
                                            {
                                                "example_id": "51f9f925-c680-4a37-ae04-b2af799883ce",
                                                "sense_id": "4e8a8ce8-7795-3f09-81c4-1bdda23ef224",
                                                "text": "[…] ; si l'on admet que la pénombre qui baigne le cornemusiste dépend du projecteur, comment expliquer la forte lumière qui est dardée sur le violoniste ? Pourquoi ne reçoit-il pas les ombres portées de ses voisins ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518a9fee-4c6f-3075-8077-862a2fd7abad",
                                        "entry_id": "e83174e0-7267-3552-8249-a04c9602e8da",
                                        "glosses": [
                                            "Demi-jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c28c50e4-012a-45c1-b344-878bdaeeed71",
                                                "sense_id": "518a9fee-4c6f-3075-8077-862a2fd7abad",
                                                "text": "Dans la pénombre des couchettes où dorment les matelots, on devine une photo de famille et une niche remplie de bondieuseries."
                                            },
                                            {
                                                "example_id": "2da187d1-f90a-4119-953d-02ff4ed32efd",
                                                "sense_id": "518a9fee-4c6f-3075-8077-862a2fd7abad",
                                                "text": "La pénombre le dissimulait, la rumeur sourde des vaches qui ruminaient dominait le bruit de sa respiration précipitée […]"
                                            },
                                            {
                                                "example_id": "5446ffe8-2c85-46a0-9d04-57064d5879d8",
                                                "sense_id": "518a9fee-4c6f-3075-8077-862a2fd7abad",
                                                "text": "Un jour blafard éclairait les dorures de la salle dont la partie inférieure restait plongée dans la pénombre."
                                            },
                                            {
                                                "example_id": "5ecae955-5d9f-4eda-9ad4-a19d43377f42",
                                                "sense_id": "518a9fee-4c6f-3075-8077-862a2fd7abad",
                                                "text": "Quand les voisines et les pleureuses furent parties vers minuit et qu'il ne resta dans la chambre mortuaire que les femmes de la famille, on éteignit les lampes sauf une, et, dans la pénombre, Zariffa reposa en paix."
                                            },
                                            {
                                                "example_id": "fa8a662e-c501-40dd-b2a8-8545c328dba5",
                                                "sense_id": "518a9fee-4c6f-3075-8077-862a2fd7abad",
                                                "text": "De jour, le corridor était dans la pénombre et c'est presque à tâtons qu'on trouvait la clinche du salon d'attente."
                                            },
                                            {
                                                "example_id": "76bec26c-2361-464c-ab2e-5d3d3848b1c3",
                                                "sense_id": "518a9fee-4c6f-3075-8077-862a2fd7abad",
                                                "text": "Seule à une table de la buvette principale, dans la demi-pénombre, était assise une fille qui portait elle aussi un blouson de cuir noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef72ec9-f573-3d46-aac1-7efd647bfd24",
                                        "entry_id": "e83174e0-7267-3552-8249-a04c9602e8da",
                                        "glosses": [
                                            "Réserve, discrétion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb39da07-855a-402b-aa1d-67c50afceb72",
                                                "sense_id": "6ef72ec9-f573-3d46-aac1-7efd647bfd24",
                                                "text": "Malgré son mérite, il est resté dans la pénombre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
