                "senses": [
                    {
                        "sense_id": "4603d4ac-e555-3fb5-8fd9-0bd06f072adf",
                        "entry_id": "df0f8223-6f07-3391-9c55-3ddc1d433d40",
                        "glosses": [
                            "geführte Fahrt, oftmals eine Busfahrt, durch eine Stadt zwecks Besichtigung touristisch wichtiger Objekte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7849358-04f2-41fe-809f-aceac23d396b",
                                "sense_id": "4603d4ac-e555-3fb5-8fd9-0bd06f072adf",
                                "text": "„Als die Stadtrundfahrt zu Ende war, war es schon weit nach Mittag und früher Nachmittag.“"
                            },
                            {
                                "example_id": "bdf890a9-8cbb-4aeb-ad30-13de8f1e3f25",
                                "sense_id": "4603d4ac-e555-3fb5-8fd9-0bd06f072adf",
                                "text": "„In Kapstadt führen die gut beworbenen Stadtrundfahrten durch viele arme Townships, die zum Teil fast identisch sind.\""
                            },
                            {
                                "example_id": "3e075e9e-61a0-4ef5-af49-4d700d1eab79",
                                "sense_id": "4603d4ac-e555-3fb5-8fd9-0bd06f072adf",
                                "text": "„Eine Stadtrundfahrt in Lahore lässt den Besucher verstehen, warum dem Militär eher als zivilen Behörden zugetraut wird, öffentliche Aufgaben wahrzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
