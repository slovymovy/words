            "senses": [
                {
                    "sense_id": "e39a011a-7b51-3d5d-9e57-433d8eba3487",
                    "sense_definition": "Remplir un lieu ou l'atmosphère d'une odeur suave et agréable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "odeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parfum délicat des lilas <w>embaume</w> toute la maison dès le matin."
                        },
                        {
                            "text": "Cette boulangerie artisanale <w>embaumait</w> la rue d'une douce odeur de pain chaud."
                        }
                    ],
                    "synonyms": [
                        "parfumer"
                    ],
                    "antonyms": [
                        "empester"
                    ],
                    "common_phrases": [
                        "embaumer l'air",
                        "embaumer la pièce"
                    ]
                },
                {
                    "sense_id": "4a0cb568-a387-3bf1-b884-58f3036eae0d",
                    "sense_definition": "Dégager une odeur très agréable ; sentir particulièrement bon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "odeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ouvre la fenêtre pour profiter des roses qui <w>embaument</w> dans le jardin."
                        },
                        {
                            "text": "Ces épices fraîches <w>embaument</w> merveilleusement quand on commence à cuisiner."
                        }
                    ],
                    "synonyms": [
                        "fleurer"
                    ],
                    "antonyms": [
                        "puer",
                        "schlinguer"
                    ]
                },
                {
                    "sense_id": "11e09fb2-83d4-38c2-b1a7-6259bd039c07",
                    "sense_definition": "Préparer un corps sans vie avec des substances aromatiques et antiseptiques pour empêcher sa décomposition.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "funeraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les prêtres de l'Égypte antique savaient parfaitement <w>embaumer</w> les défunts."
                        },
                        {
                            "text": "Le thanatopracteur a dû <w>embaumer</w> la dépouille avant son rapatriement."
                        }
                    ],
                    "synonyms": [
