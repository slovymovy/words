                "senses": [
                    {
                        "sense_id": "b91ae8be-6e41-3310-a483-65c8e8356a25",
                        "entry_id": "a092fd98-ede7-3f3d-8720-f2fc126ad3b0",
                        "glosses": [
                            "to be a burden (on)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a505aa02-fe2b-4212-8666-c5fc8da11b27",
                                "sense_id": "b91ae8be-6e41-3310-a483-65c8e8356a25",
                                "text": "э́то меня́ не тяготи́т",
                                "translation": "I don't find it burdensome",
                                "english": "I don't find it burdensome"
                            }
                        ]
                    },
                    {
                        "sense_id": "00aead56-c1ec-3d91-b413-876779c76422",
                        "entry_id": "a092fd98-ede7-3f3d-8720-f2fc126ad3b0",
                        "glosses": [
                            "to oppress"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b29707c-eaaf-46f7-a7c2-df6f2aef1bfc",
                                "sense_id": "00aead56-c1ec-3d91-b413-876779c76422",
                                "text": "меня́ тяготи́т его́ дру́жба",
                                "translation": "his friendship irks me; I find his friendship burdensome/irksome",
                                "english": "his friendship irks me; I find his friendship burdensome/irksome"
                            },
                            {
                                "example_id": "716c4159-8738-48ce-b119-a080a81e2de6",
                                "sense_id": "00aead56-c1ec-3d91-b413-876779c76422",
                                "text": "молча́ние начина́ло тяготи́ть нас",
                                "translation": "our silence was becoming oppressive",
                                "english": "our silence was becoming oppressive"
                            },
                            {
                                "example_id": "78516161-8f0d-4de1-8145-4dfb2526631e",
                                "sense_id": "00aead56-c1ec-3d91-b413-876779c76422",
                                "text": "э́то тяготи́т его́ со́весть",
                                "translation": "it lies heavy on his conscience",
                                "english": "it lies heavy on his conscience"
                            },
                            {
                                "example_id": "e61598b3-5c44-47f7-b904-f6aa757ac8e9",
                                "sense_id": "00aead56-c1ec-3d91-b413-876779c76422",
                                "text": "одино́чество его́ тяготи́т",
                                "translation": "his loneliness oppresses/depresses him",
                                "english": "his loneliness oppresses/depresses him"
                            }
                        ]
                    }
