                                "target_senses": [
                                    {
                                        "sense_id": "f7619c50-56a4-340f-ad17-8dbeeddc132b",
                                        "entry_id": "657c581a-90b9-3dcc-9273-8d63d85fb153",
                                        "glosses": [
                                            "správce provincie perské říše"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e92cf66-ecfd-4429-8357-171d53c4297f",
                                                "sense_id": "f7619c50-56a4-340f-ad17-8dbeeddc132b",
                                                "text": "V čele provincie, satrapie, stál satrapa, persky chšatrapavan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff42f78e-3135-3f79-a3e0-625fabea6f4a",
                                        "entry_id": "657c581a-90b9-3dcc-9273-8d63d85fb153",
