    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3bc22b3-7495-3fb3-8467-07ad6866b915",
                    "sense_definition": "uwolnić kogoś od niebezpieczeństwa, kłopotów lub cierpienia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ratunek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szybka pożyczka od rodziny ostatecznie <w>wybawiła</w> go z ogromnych kłopotów finansowych.",
                            "target_lang_translations": {
                                "en": "A quick loan from his family ultimately <w>saved</w> him from massive financial trouble."
                            }
                        },
                        {
                            "text": "Rycerz przybył w samą porę i <w>wybawił</w> mieszkańców miasta z rąk najeźdźców.",
                            "target_lang_translations": {
                                "en": "The knight arrived just in time and <w>rescued</w> the townspeople from the hands of the invaders."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbawić"
                    ],
                    "common_phrases": [
                        "wybawić z opresji",
                        "wybawić z kłopotów"
                    ],
                    "target_lang_definitions": {
                        "en": "to free someone from danger, trouble, or suffering; to rescue or save"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "save",
                                "target_lang_sense_clarification": "from danger or trouble"
                            },
                            {
                                "target_lang_word": "rescue",
                                "target_lang_sense_clarification": "from a dangerous or difficult situation"
                            },
                            {
                                "target_lang_word": "deliver",
                                "target_lang_sense_clarification": "formal/literary, from evil or affliction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c42a5d97-bf34-315f-8df5-1c8272ced103",
                    "sense_definition": "spędzić czas na intensywnej, wyczerpującej zabawie lub tańcu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zabawa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młodzież na weselu wreszcie się <w>wybawiła</w> za wszystkie czasy po długim okresie nauki.",
                            "target_lang_translations": {
                                "en": "At the wedding, the young people finally <w>partied their hearts out</w> after a long period of studying."
                            }
                        },
                        {
                            "text": "Dzieci tak się <w>wybawiły</w> na placu zabaw, że zasnęły w drodze powrotnej.",
                            "target_lang_translations": {
                                "en": "The children <w>played their hearts out</w> at the playground so much that they fell asleep on the way back."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wybawić się za wszystkie czasy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie, zwłaszcza w formie zwrotnej"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to spend time partying, dancing, or playing thoroughly until satisfied or tired (usually reflexive: wybawić się)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "party one's heart out",
                                "target_lang_sense_clarification": "party intensely or fully"
                            },
                            {
                                "target_lang_word": "have a blast",
                                "target_lang_sense_clarification": "have a great, lively time"
                            },
                            {
                                "target_lang_word": "play one's heart out",
                                "target_lang_sense_clarification": "play until exhausted or satisfied"
                            }
                        ]
                    }
                }
            ]
        }
    ]
