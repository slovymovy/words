                ],
                "senses": [
                    {
                        "sense_id": "197f99fa-5b5b-3f4f-bb99-fa35810dce73",
                        "entry_id": "e9c88953-c817-3eda-b6fc-aa57dc8427c7",
                        "glosses": [
                            "eingrenzbarer Bereich, welcher für einen Zustand der äußeren Ruhe bei Menschen und Tieren geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fbe0d64-d527-441b-9336-3247ef5f3b66",
                                "sense_id": "197f99fa-5b5b-3f4f-bb99-fa35810dce73",
                                "text": "Das ist ein guter Schlafplatz!"
                            },
                            {
                                "example_id": "dc690f64-b1d0-4426-94b2-b31aa807665c",
                                "sense_id": "197f99fa-5b5b-3f4f-bb99-fa35810dce73",
                                "text": "Silvia bietet über das Internet Fremden einen Schlafplatz auf ihrem Sofa an."
                            },
                            {
                                "example_id": "713b7eea-cd32-4811-8424-904d4502807c",
                                "sense_id": "197f99fa-5b5b-3f4f-bb99-fa35810dce73",
                                "text": "Geläufige Schlafplätze sind z.B. ein Sofa, ein Bett oder eine Matratze."
                            },
                            {
                                "example_id": "5cd60f56-3721-40c8-91e3-0301c1098cb2",
                                "sense_id": "197f99fa-5b5b-3f4f-bb99-fa35810dce73",
                                "text": "„Zum zweiten Mal in wenigen Wochen bleibt nur der baufällige Wartesaal von Angermünde und mein sozusagen bereits angestammter Schlafplatz hinter der Theke.“"
                            },
                            {
                                "example_id": "876c20df-0fbc-45ac-b8f2-acf32ccef0e8",
                                "sense_id": "197f99fa-5b5b-3f4f-bb99-fa35810dce73",
                                "text": "„Ein verlaustes, graues Lumpenweib stapft von seinem Schlafplatz fort.“"
                            },
                            {
                                "example_id": "ed562f04-020a-4f51-a101-297fda8716c4",
                                "sense_id": "197f99fa-5b5b-3f4f-bb99-fa35810dce73",
                                "text": "„Als ich mir einen Schlafplatz suchte im Bahnhof von Toulouse, kletterte ich über eine liegende Frau, die zwischen Koffern, Bündeln und zusammengelegten Gewehren einem verschrumpften Kind die Brust gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
