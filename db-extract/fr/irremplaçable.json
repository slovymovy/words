                        "target_lang_word": "onvervangbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onvervangbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e928457e-a8f2-3a27-aaf9-69797a4450ad",
                                        "entry_id": "cad2d8f8-7d18-3188-8e4c-b4f75464bd95",
                                        "glosses": [
                                            "duidt de onmogelijkheid aan de plaats van iets door iets anders in te laten nemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d69005-6dfb-45ec-a076-6c30b10af9a2",
                                                "sense_id": "e928457e-a8f2-3a27-aaf9-69797a4450ad",
                                                "text": "Dit museum hangt vol met onvervangbare werken."
                                            },
                                            {
                                                "example_id": "e4fb032c-9c39-4f84-b2dc-4a4c4ebc766e",
                                                "sense_id": "e928457e-a8f2-3a27-aaf9-69797a4450ad",
                                                "text": "In een persconferentie liet Johnson weten dat de zoektocht naar zijn opvolger volgende week begint. \"In de politiek is niemand ook maar enigszins onvervangbaar. Ons geweldige systeem zal een andere leider produceren\", aldus Johnson. Hij beloofde dat hij die nieuwe leider \"alle steun zal geven die ik kan geven\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8915d4b7-a6f9-448c-a907-b75f7fde3703",
