                ],
                "senses": [
                    {
                        "sense_id": "4dbd8a06-8fb1-3e90-bcd6-9779593c89b9",
                        "entry_id": "77023979-2d37-3349-9fab-4bb4c22da713",
                        "glosses": [
                            "Kapelle, die regelmäßig Ziel von Wallfahrten ist und diesen kirchlichen Status innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba8252dc-e88e-468b-bfbe-b4d836f8b593",
                                "sense_id": "4dbd8a06-8fb1-3e90-bcd6-9779593c89b9",
                                "text": "„An die ungewöhnliche Geschichte dieses Landstrichs erinnerte nicht zuletzt Papst Benedikt XVI. mit seinem Besuch der Wallfahrtskapelle Etzelsbach.“"
                            },
                            {
                                "example_id": "f469096b-41cf-4c88-b277-661eebee26ba",
                                "sense_id": "4dbd8a06-8fb1-3e90-bcd6-9779593c89b9",
                                "text": "„In idyllischer Lage „auf einem mit Pürkenbäumen bewachsenen Felsen“, steht oberhalb von Fischbachau die Wallfahrtskapelle Birkenstein.“"
                            },
                            {
                                "example_id": "05d6035c-f826-4a02-a851-e579d9d1394f",
                                "sense_id": "4dbd8a06-8fb1-3e90-bcd6-9779593c89b9",
                                "text": "„Die Wallfahrtskapelle beherbergt das Gnadenbild der schmerzhaften Muttergottes, das um 1370 entstanden ist.“"
                            },
                            {
                                "example_id": "7d3aedeb-19c6-4fb4-b70a-52b5da8fcf1f",
                                "sense_id": "4dbd8a06-8fb1-3e90-bcd6-9779593c89b9",
                                "text": "„Man weiß nicht, wann und auf welcher Weise sie die Pfarrecht verloren und zur Wallfahrtskapelle wurde.“"
                            },
                            {
                                "example_id": "8caf79f8-8eff-4b63-b8b1-2fe6fb54429b",
                                "sense_id": "4dbd8a06-8fb1-3e90-bcd6-9779593c89b9",
                                "text": "„Mit zwei Wanderstöcken in den Fäusten spaziert sie an einem Sommertag im Jahr 2020 bedächtig über grüne Almen zur Wallfahrtskapelle Maria Birkenstein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
