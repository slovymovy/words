                {
                    "sense_id": "3bb22fc1-8f58-34e8-87ff-e173bdba57f2",
                    "sense_definition": "Prendre et éloigner d'un endroit par la force ou l'autorité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eloignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les gendarmes ont <w>emmené</w> le suspect au commissariat pour l'interroger.",
                            "target_lang_translations": {
                                "en": "The gendarmes <w>took away</w> the suspect to the police station to question him.",
                                "ru": "Жандармы <w>увели</w> подозреваемого в участок, чтобы его допросить.",
                                "nl": "De politie heeft de verdachte naar het bureau <w>meegenomen</w> om hem te ondervragen.",
                                "de": "Die Polizei hat den Verdächtigen zum Verhör aufs Revier <w>mitgenommen</w>.",
                                "pl": "Żandarmi <w>zabrali</w> podejrzanego na komisariat, żeby go przesłuchać.",
                                "it": "I carabinieri <w>hanno portato via</w> il sospettato in questura per interrogarlo.",
                                "cs": "Policisté podezřelého <w>odvedli</w> na služebnu k výslechu.",
                                "tr": "Jandarmalar, sorguya çekmek için şüpheliyi karakola <w>götürdü</w>.",
                                "es": "Los agentes <w>se llevaron</w> al sospechoso a la comisaría para interrogarlo.",
                                "zh": "警察把嫌疑人<w>带走</w>，送到警察局审讯。"
                            }
                        },
                        {
                            "text": "Les gardes ont <w>emmené</w> les prisonniers hors de la cellule au petit matin.",
                            "target_lang_translations": {
                                "en": "The guards <w>led</w> the prisoners out of the cell early in the morning.",
                                "ru": "Охранники <w>вывели</w> заключённых из камеры ранним утром.",
                                "nl": "Vroeg in de ochtend hebben de bewakers de gevangenen uit de cel <w>afgevoerd</w>.",
                                "de": "Früh am Morgen haben die Wachleute die Gefangenen aus der Zelle <w>abgeführt</w>.",
                                "pl": "Strażnicy <w>wyprowadzili</w> więźniów z celi wczesnym rankiem.",
                                "it": "Di buon mattino le guardie <w>hanno condotto via</w> i prigionieri dalla cella.",
                                "cs": "Strážní za časného rána <w>vyvedli</w> vězně z cely.",
                                "tr": "Gardiyanlar sabahın erken saatlerinde mahkûmları hücreden <w>çıkardı</w>.",
                                "es": "Los guardias <w>sacaron</w> a los presos de la celda a primera hora de la mañana.",
                                "zh": "清晨时分，看守把囚犯<w>押送</w>出牢房。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "emmener au poste",
                        "emmener de force"
                    ],
                    "target_lang_definitions": {
                        "en": "To forcibly remove someone from a place, usually under the authority of the police or guards.",
                        "ru": "Насильно увести кого-либо из места, обычно по распоряжению полиции или охраны.",
                        "nl": "Iemand met dwang of op gezag van bijvoorbeeld de politie uit een plaats verwijderen.",
                        "de": "Jemanden gewaltsam oder auf Anordnung einer Behörde von einem Ort entfernen, meist durch Polizei oder Wachpersonal.",
                        "pl": "Siłą lub na polecenie władz, zwykle policji lub straży, usunąć kogoś z jakiegoś miejsca.",
                        "it": "Allontanare qualcuno da un luogo con la forza o per ordine di un'autorità, di solito della polizia.",
                        "cs": "Násilím nebo z moci úřední odvést někoho z určitého místa, obvykle policií nebo strážemi.",
                        "tr": "Bir kişiyi, genellikle polis veya gardiyanların yetkisiyle, zorla bulunduğu yerden uzaklaştırmak.",
                        "es": "Llevar a alguien lejos de un lugar por la fuerza o por orden de una autoridad.",
                        "zh": "依靠武力或权威，把某人强行从某个地方带离。"
                    },
