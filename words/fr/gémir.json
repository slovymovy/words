{
    "word_family": [
        "gémissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c96bd451-fba6-367f-aefb-c8d3a8e0b1f2",
                    "sense_definition": "Exprimer sa douleur physique ou morale par des sons inarticulés et plaintifs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "souffrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blessé continuait de <w>gémir</w> doucement en attendant les secours."
                        },
                        {
                            "text": "L'enfant malade <w>gémit</w> de douleur au fond de son lit."
                        }
                    ],
                    "synonyms": [
                        "geindre",
                        "se plaindre",
                        "sangloter"
                    ],
                    "common_phrases": [
                        "gémir de douleur"
                    ]
                },
                {
                    "sense_id": "e3f919dc-41d8-3126-83a0-a42f3a572d99",
                    "sense_definition": "Produire un son plaintif, sourd ou continu, en parlant des éléments ou de choses inanimées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent d'automne <w>gémit</w> à travers les branches nues des arbres."
                        },
                        {
                            "text": "Nous écoutions la tempête <w>gémir</w> furieusement contre les volets de la maison."
                        }
                    ],
                    "synonyms": [
                        "murmurer",
                        "siffler"
                    ]
                },
                {
                    "sense_id": "9379a19f-610a-30c9-98bb-3522d20326ba",
                    "sense_definition": "Craquer bruyamment sous l'effet d'une charge, d'une pression ou d'un poids excessif.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux plancher de la chambre <w>gémit</w> sous le poids de nos pas."
                        },
                        {
                            "text": "La vieille charpente <w>gémissait</w> sous l'épaisse couche de neige fraîche."
                        }
                    ],
                    "synonyms": [
                        "craquer",
                        "grincer"
                    ],
                    "common_phrases": [
                        "gémir sous le poids"
                    ]
                },
                {
                    "sense_id": "09444608-e485-3902-b932-d7bc92b71ebe",
                    "sense_definition": "Subir une situation pénible en s'en lamentant, notamment sous une contrainte ou une injustice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "souffrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple a longtemps <w>gémi</w> sous le joug d'une dictature cruelle."
                        },
                        {
                            "text": "Les citoyens <w>gémissaient</w> de voir triompher une telle injustice sans pouvoir réagir."
                        }
                    ],
                    "synonyms": [
                        "pâtir",
                        "souffrir"
                    ],
                    "common_phrases": [
                        "gémir sous le joug"
                    ]
                },
                {
                    "sense_id": "caf49f09-d9df-3569-b784-dd53b943c6e2",
                    "sense_definition": "Pousser un roucoulement plaintif et doux, en parlant de la colombe ou de la tourterelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cri_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le silence de la clairière, une tourterelle solitaire <w>gémit</w> paisiblement."
                        },
                        {
                            "text": "Au lever du jour, les colombes <w>gémissaient</w> au sommet des grands pins."
                        }
                    ],
                    "synonyms": [
                        "roucouler"
                    ]
                },
                {
                    "sense_id": "838e4c99-ef1a-335f-af2e-06629696c76a",
                    "sense_definition": "Faire imprimer une grande quantité d'ouvrages, souvent de médiocre qualité.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur prolifique continue de faire <w>gémir</w> la presse avec ses romans insipides."
                        },
                        {
                            "text": "Les journalistes sans scrupules faisaient <w>gémir</w> la presse pour vendre davantage d'exemplaires."
                        }
                    ],
                    "common_phrases": [
                        "faire gémir la presse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Formule idiomatique plaisante ou désuète"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95b29b73-2ca5-363f-a7fa-bee1708485c6",
                    "sense_definition": "Bruit sourd ou plainte émise par une personne ou une chose qui gémit.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On percevait dans la nuit le <w>gémir</w> triste d'une girouette métallique rouillée."
                        },
                        {
                            "text": "Le <w>gémir</w> du vent à travers la porte entrouverte brisait le silence."
                        }
                    ],
                    "synonyms": [
                        "gémissement",
                        "plainte"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Emploi substantivé rare et littéraire"
                        }
                    ]
                }
            ]
        }
    ]
}