            {
                "entry_id": "f1046515-7110-3009-96f4-4c813792c718",
                "word": "Baa",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e3fe5aaf-cbf0-3249-88e1-50db8d968c3a",
                        "entry_id": "f1046515-7110-3009-96f4-4c813792c718",
                        "glosses": [
                            "Bein"
                        ],
                        "tags": [
                            "Erzgebirgisch"
                        ],
                        "examples": [
                            {
                                "example_id": "54fec277-5908-400e-8db0-0ec67a85a8d3",
                                "sense_id": "e3fe5aaf-cbf0-3249-88e1-50db8d968c3a",
                                "text": "„Ja, de Weihnachtszeit is do.",
                                "translation": "zieht bedachtig an dr Pfeif zu sen Zeitvertreib.“"
                            },
                            {
                                "example_id": "9c4e15c3-173f-4232-b8bd-f8783a45d087",
                                "sense_id": "e3fe5aaf-cbf0-3249-88e1-50db8d968c3a",
                                "text": "„Vom Filzteich noch de Greifenstää",
                                "translation": "De Haxen haaßen dort de Baa.“"
                            },
                            {
                                "example_id": "d625cbca-d132-42d6-a6f9-ef7892cd38fa",
                                "sense_id": "e3fe5aaf-cbf0-3249-88e1-50db8d968c3a",
                                "text": "„Eine Besonderheit sind die selteneren Bein-Engel, erzgebirgisch Baa-Engel genannt, bei denen der Rock nicht bis zum Sockel reicht, auf dem sie stehen, sondern die Füße und ein Teil des Beins zu sehen sind.“"
                            },
                            {
                                "example_id": "e909a0c1-d503-4432-b23f-21613aa1fdc3",
                                "sense_id": "e3fe5aaf-cbf0-3249-88e1-50db8d968c3a",
                                "text": "„Hot die stackndirre Baa!“",
                                "translation": "Hat die stockdürre Beine!"
                            },
                            {
                                "example_id": "5d6256fe-3356-4dae-bdf9-250bc28acc63",
                                "sense_id": "e3fe5aaf-cbf0-3249-88e1-50db8d968c3a",
                                "text": "„Seltsam ist es, dass nur eine halbe Stunde übern Berg drüben, in Oberdorf, in der Aussprache mancher Wörter ein scharfer Unterschied zur Beuthaer Sprechweise wahrzunehmen ist. Das betrifft namentlich das hochdeutsche \"ei\". Wo der Beuthaer \"naa\", \"Flasch\", \"Baa\" spricht, sagt der Oberdorfer \"nä\", \"Fläsch\", \"Bä\" (nein, Fleisch, Bein).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
