                        "glosses": [
                            "Teinter avec du thé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5823a3e8-0165-469c-9826-e152a90e1854",
                                "sense_id": "9f084440-09d6-3c1e-941b-8813c6d42b04",
                                "text": "Au pire j'en achète des neuves et je les théise ou les relume avec la bonne teinte!"
                            },
                            {
                                "example_id": "70be6ba1-23f6-48bf-b59b-67212167b265",
                                "sense_id": "9f084440-09d6-3c1e-941b-8813c6d42b04",
                                "text": "J'ai pensé a relumer avec la teinte ad hoc mais il me paraissait plus simple de \"théiser\", quant à la stabilité du thé dans le temps pas de problème"
                            }
                        ]
                    },
                    {
                        "sense_id": "d558ebfa-c980-3911-a982-36f9df2e4a9e",
