                                        "glosses": [
                                            "Being the subject of a hunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e548cecf-6fd4-4903-bf69-7d2b911a3eb1",
                                                "sense_id": "215a5a4c-baf3-36f7-9b0b-0af58bd52294",
                                                "text": "While there is no difference between encounter rates in the two unhunted sites, the macaques are significantly less common in the hunted areas […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "750ead86-c245-3d3c-a5d7-b83bdc07f00e",
                                        "entry_id": "63c6e2be-f00f-3780-9796-ae6f92b7fc86",
                                        "glosses": [
                                            "Nervous and agitated, as if pursued."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ff0612-e62a-4f04-936c-74a39ecf1903",
                                                "sense_id": "750ead86-c245-3d3c-a5d7-b83bdc07f00e",
                                                "text": "He looked up with a hunted expression."
                                            }
