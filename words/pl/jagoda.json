                },
                {
                    "sense_id": "ddbb45fd-15e2-3499-b0a2-36481026d19a",
                    "sense_definition": "męskie nazwisko",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwiska",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Jagoda</w> jest znanym lekarzem.",
                            "target_lang_translations": {
                                "ru": "Пан <w>Ягода</w> — известный врач."
                            }
                        },
                        {
                            "text": "Rozmawiałem wczoraj z panem <w>Jagodą</w>.",
                            "target_lang_translations": {
                                "ru": "Я разговаривал вчера с паном <w>Ягодой</w>."
                            }
                        }
                    ],
                    "traits": [
