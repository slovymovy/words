                        "sense_id": "c78c71c1-2545-370f-bc19-600708fec546",
                        "entry_id": "611eef07-5b87-35db-a5f2-3662944e8e92",
                        "glosses": [
                            "Univers fictif servant de cadre à une fiction, notamment en science-fiction et en fantasy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dc41ff44-217f-3465-95d6-2e3c6f9f549f",
                        "entry_id": "611eef07-5b87-35db-a5f2-3662944e8e92",
                        "glosses": [
                            "Ode à l'univers selon les principes de la cosmopoétique de Kenneth White."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d48e6e3-7c5d-4638-9613-9d1a9d4293ca",
                                "sense_id": "dc41ff44-217f-3465-95d6-2e3c6f9f549f",
                                "text": "Si Les Immémoriaux est un roman ethnologique, c'est aussi un grand opéra - crépuscule des dieux polynésiens, chant du cygne d'une culture - et, au-delà aussi de cela, c'est un cosmo-poème qui, tout en offrant un spectacle complet des hommes et des choses, pousse les choses et les êtres jusque dans leur principe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79c82586-22d2-4f8e-8957-38df59f3c0a6",
                        "source_entry_id": "611eef07-5b87-35db-a5f2-3662944e8e92",
                        "source_sense_description": "Univers fictif",
                        "target_lang_word": "conworld",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conworld",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bdb4ce3-4b9d-3eef-9d5e-d063f8313907",
                                        "entry_id": "ed5eacda-2884-3d6b-80b4-064e5d6c620e",
                                        "glosses": [
                                            "An imaginary world, especially one with highly-detailed cultures, languages, and geography."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "859c2af9-5404-4e85-ade8-2daeb446bd68",
                                                "sense_id": "8bdb4ce3-4b9d-3eef-9d5e-d063f8313907",
                                                "text": "However, you will have created a pile of crossword puzzles you'll be proud to submit to Will Shortz, or a conworld that's so rich and real the inhabitants have actually attained sapience and now worship you as their god."
                                            },
                                            {
                                                "example_id": "99057a3b-3023-40e1-a9a1-929cc24e17c4",
                                                "sense_id": "8bdb4ce3-4b9d-3eef-9d5e-d063f8313907",
                                                "text": "The most respected languages in the conlang community often have years of work behind them, and may even be attached to whole \"conworlds\" or \"concultures\" that help give them coherence and a model \"literature.\""
                                            },
                                            {
                                                "example_id": "cd52dade-05d2-4b3b-93cb-5fc75d2c16e7",
                                                "sense_id": "8bdb4ce3-4b9d-3eef-9d5e-d063f8313907",
                                                "text": "[…] in my conworld Almea the great navigators of southern Ereláe were the Jei, and undoubtedly Jei-based pidgins sprung up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
