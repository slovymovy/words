                    ]
                },
                {
                    "sense_id": "9a683477-47cb-3f2a-b06f-ee6342986902",
                    "sense_definition": "Zeitlicher oder metaphorischer Übergangspunkt beziehungsweise Anfang eines neuen Abschnitts oder Zustands.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uebergang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Menschheit steht heute an der <w>Schwelle</w> zu einem völlig neuen Zeitalter."
                        },
                        {
                            "text": "Sie fühlte deutlich, dass sie an der <w>Schwelle</w> eines wichtigen Lebensabschnitts stand."
                        }
                    ],
                    "common_phrases": [
