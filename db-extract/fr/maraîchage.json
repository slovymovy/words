                    {
                        "translation_id": "9eb1913d-09c7-4bb9-8e21-b3d0f69dd435",
                        "source_entry_id": "220bc581-595e-3f7c-8232-a7c9fd8dc83d",
                        "source_sense_id": "a613d7f7-6797-3908-8648-0238376e54fa",
                        "target_lang_word": "groenteteelt",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groenteteelt",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e1fd4b68-ce8d-3168-ba24-e8b7c0e95e23",
                                        "entry_id": "6db02d96-d4be-3967-b088-cd0a8ba3f07c",
                                        "glosses": [
                                            "het verbouwen van groentes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc42ee8f-4711-47cd-802f-d9a716a704e3",
                                                "sense_id": "e1fd4b68-ce8d-3168-ba24-e8b7c0e95e23",
                                                "text": "De aanhoudende droogte leidt tot steeds meer maatregelen om natuurbranden en watertekorten te voorkomen. Zo geldt onder meer in Twente en delen van Noord-Nederland een stookverbod en mogen boeren op plekken in Gelderland, Utrecht en Brabant geen water halen uit sloten, beken en kanalen. Boeren in de fruitteelt, akkerbouw en de groenteteelt krijgen mogelijk te maken met een kleinere oogst."
                                            },
                                            {
                                                "example_id": "342f7d71-3918-4b9b-99dd-e4efc79c2f75",
                                                "sense_id": "e1fd4b68-ce8d-3168-ba24-e8b7c0e95e23",
                                                "text": "In principe is het nu al mogelijk om aardappels, bonen, erwten, tuinkers, rucola, wortels en tomaten te verbouwen op Mars. Ook kunnen wormen, die belangrijk zijn bij groenteteelt, daar leven. \"We maakten ons eerst zorgen over die wormen. Het zand op Mars is zo scherp als glas, dat kan een probleem zijn als ze het binnenkrijgen.\""
                                            },
                                            {
                                                "example_id": "99e106e3-d61e-42cc-81dc-8fd4d60cbfec",
                                                "sense_id": "e1fd4b68-ce8d-3168-ba24-e8b7c0e95e23",
                                                "text": "Hij noemt de prijs de ultieme erkenning voor de miljoenen kleine boeren die van de landbouw hun bedrijf hebben kunnen maken. \"Kleinschalige groenteteelt is een geweldige manier om inkomen en werkgelegenheid op het platteland te realiseren, en tegelijkertijd het voedingspatroon voor heel veel mensen te verbeteren.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
