                ],
                "senses": [
                    {
                        "sense_id": "b7e0b10b-b08e-3bef-996f-a54582dfc2e4",
                        "entry_id": "93dfc873-07ae-3941-b732-ee73856036ec",
                        "glosses": [
                            "rechtsverbindliche Baubestimmung, die die brandschutztechnischen Anforderungen an Lüftungsanlagen in dem jeweiligen Bundesland regelt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "3e2e2e84-6b19-4056-8151-312c707d205e",
                                "sense_id": "b7e0b10b-b08e-3bef-996f-a54582dfc2e4",
                                "text": "„Seit 1984 gibt es die “Lüftungsanlagenrichtlinie”: Richtlinie über brandschutztechnische Anforderungen an Lüftungsanlagen – eine anerkannte technische Baubestimmung.“"
                            },
                            {
                                "example_id": "e47146de-e7bf-4c34-b2bb-34636423fd32",
                                "sense_id": "b7e0b10b-b08e-3bef-996f-a54582dfc2e4",
                                "text": "„In den meisten Bundesländern ist die Muster-Lüftungsanlagenrichtlinie (Fassung Januar 1984) bauaufsichtlich eingeführt.“"
                            },
                            {
                                "example_id": "986afc86-c606-43e7-8647-83413a3b4ac6",
                                "sense_id": "b7e0b10b-b08e-3bef-996f-a54582dfc2e4",
                                "text": "„Lüftungsanlagenrichtlinie: Die (LüAR) des jeweiligen Bundeslandes ist eine in Deutschland nach Landesbauordnung eingeführte technische Baubestimmung.“"
                            },
                            {
                                "example_id": "9d072209-051e-4d67-aadc-c7410074e50f",
                                "sense_id": "b7e0b10b-b08e-3bef-996f-a54582dfc2e4",
                                "text": "„Im Einzelfall kann es auch in anderen Bundesländern sinnvoll sein,insbesondere in Bezug auf den „Stand der Technik“ und die „allgemein anerkannten Regeln der Technik“ sich an der neuen sächsischen Lüftungsanlagenrichtlinie zu orientieren(vor allem in den Bereichen, in denen die Muster-Lüftungsanlagenrichtlinie (Fassung Januar1984) überholt ist.“"
                            },
                            {
                                "example_id": "76bf0b71-2473-48a3-804a-dfe9443daed4",
                                "sense_id": "b7e0b10b-b08e-3bef-996f-a54582dfc2e4",
                                "text": "„Zuluftleitungen dürfen nach der allgemeinen bauaufsichtlichen Zulassung in Anlehnung an Lüftungsanlagen nach DIN 18017-3 geführt werden und nach Lüftungsanlagenrichtlinie in die Räume einmünden, die auch abgelüftet werden dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
