                "senses": [
                    {
                        "sense_id": "6c379dc5-1fe3-370a-abac-b588b62cc4dd",
                        "entry_id": "5c68c82e-e328-359d-9adf-415abbeeb10d",
                        "glosses": [
                            "Aux formes rondes, bien pleines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca3a7b2-ba65-40c0-9c27-69eaaf51ddd0",
                                "sense_id": "6c379dc5-1fe3-370a-abac-b588b62cc4dd",
                                "text": "Hier matin, reçu Einstein, un Allemand rondouillard qui veut fonder une nouvelle revue pour lutter en faveur des tendances modernes à quoi il reproche je ne sais plus quoi."
                            },
                            {
                                "example_id": "fafa6b72-f5c8-4893-b0dd-88e5a6c29f97",
                                "sense_id": "6c379dc5-1fe3-370a-abac-b588b62cc4dd",
                                "text": "Il devient de plus en plus rondouillard, il devrait surveiller son alimentation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8166f09e-121d-4e2b-8962-de1159090b60",
                        "source_entry_id": "5c68c82e-e328-359d-9adf-415abbeeb10d",
