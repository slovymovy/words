                            "A surname."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbd04bff-0be9-4ca5-98fe-1c28cf436bb8",
                        "source_entry_id": "2810c53c-c4b7-36df-aba2-85a84e63ef34",
                        "source_sense_description": "male given name",
