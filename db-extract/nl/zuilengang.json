        "nl-extract.jsonl": [
            {
                "entry_id": "48baa1ba-f55e-38b8-9fff-59d6fea81b21",
                "word": "zuilengang",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "6b3327bc-8298-4167-95df-bad0db12b858",
                        "entry_id": "48baa1ba-f55e-38b8-9fff-59d6fea81b21",
                        "tags": [
                            "plural"
                        ],
                        "form": "zuilengangen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87dedd72-5e37-3022-8192-24e3a100ce78",
                        "entry_id": "48baa1ba-f55e-38b8-9fff-59d6fea81b21",
                        "glosses": [
                            "een rij zuilen die een overdekking draagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7ad8707-1a8a-48ba-aa8e-23835f08ff3a",
                                "sense_id": "87dedd72-5e37-3022-8192-24e3a100ce78",
                                "text": "Later op de dag werd na een bommelding de zuilengang rond het St. Pietersplein doorzocht. Er is niets gevonden."
                            },
                            {
                                "example_id": "4b639d55-800e-405d-bfb9-5ffb376d52d2",
                                "sense_id": "87dedd72-5e37-3022-8192-24e3a100ce78",
                                "text": "Krajewski heeft vervolgens besloten een douchegelegenheid te laten maken. Zo komen er drie douches bij toiletten voor pelgrims onder de zuilengang op het Sint-Pietersplein."
                            },
                            {
                                "example_id": "9ae423a2-f30b-4b1c-92fa-fa2f60145c62",
                                "sense_id": "87dedd72-5e37-3022-8192-24e3a100ce78",
                                "text": "Vanuit een bovenwoning filmt iemand hoe de politie een man tevoorschijn laat komen uit een zuilengang. Daarin is nog net zichtbaar hoe iemand anders met gespreide benen door een politieman wordt gefouilleerd. De man komt langzaam naar voren terwijl hij frontaal onder schot wordt gehouden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2f9cb27-ef22-4a47-8e03-87a8d4038043",
                        "source_entry_id": "48baa1ba-f55e-38b8-9fff-59d6fea81b21",
                        "source_sense_id": "87dedd72-5e37-3022-8192-24e3a100ce78",
                        "target_lang_word": "portico",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portico",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                        "entry_id": "33db6eed-c250-35d3-8e0c-57937e803a62",
                                        "glosses": [
                                            "A porch, or a small space with a roof supported by columns, serving as the entrance to a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e9b01-8852-43d4-8113-d603cd6b90dd",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "The amphitheatre hath two portici as that at Niſmes."
                                            },
                                            {
                                                "example_id": "29ed6276-46f1-4547-a284-dd01134f824b",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "The great house itself was a large, white, wooden building, with wings on three sides of it. In front, a large portico, extending the entire length of the building, and supported by a long range of columns, gave to the whole establishment an air of solemn grandeur."
                                            },
                                            {
                                                "example_id": "c90fc34b-33ed-4b32-9903-db0ff2d13298",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "The long-closed G.W.R. station alongside has a decidedly derelict-looking frontage, with eight gargoyles or figureheads still clinging to the portico."
                                            },
                                            {
                                                "example_id": "1efc4b19-b475-4645-9211-692f82d14c24",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "[…] Porticus Milliaria (portico of the thousand paces) which was the longest, if not the most attractive, of the many portici of ancient Rome."
                                            },
                                            {
                                                "example_id": "bf66a62e-85d4-419b-9ee7-24bc32985ca7",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "The portici enhance street life today, as they did when they were first constructed, not simply by providing protection from sun and rain, but by providing attractive public spaces for friends to meet, for business people to conduct business, for vendors to display their wares, for musicians to play their music and for beggars to beg. […] Most tours of Bologna begin in the Piazza Maggiore, on the site of the Roman forum, but it’s important to remember that the piazza didn’t begin to take its present shape till toward the end of the 13th century—after the age of medieval towers, after the citizens began to enjoy their portici."
                                            },
                                            {
                                                "example_id": "3be274a1-33a8-48c9-9223-be65389ca7ec",
                                                "sense_id": "e73e3435-97de-31ad-b844-22ef160ac1c6",
                                                "text": "These lines are possibly meant to represent two portici flanking the building on its long sides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d359b64d-0306-4eb9-a131-7042c9e8c5dd",
                        "source_entry_id": "48baa1ba-f55e-38b8-9fff-59d6fea81b21",
                        "source_sense_id": "87dedd72-5e37-3022-8192-24e3a100ce78",
                        "target_lang_word": "archway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "789caf51-93d7-3e82-9f1f-388106c34306",
                                        "entry_id": "ad787f9d-84a6-3bd7-a123-a6f8947d146b",
                                        "glosses": [
                                            "A passageway covered by an arch, particularly one made of masonry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3571ce18-359f-3f71-8637-7e7a39ab1682",
                                        "entry_id": "ad787f9d-84a6-3bd7-a123-a6f8947d146b",
                                        "glosses": [
                                            "A doorway with a semilunar-shaped top."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781f1e9e-d013-434b-ad0d-4c043e26e4f9",
                                                "sense_id": "3571ce18-359f-3f71-8637-7e7a39ab1682",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d896f63-cf54-482a-9fcd-f069e4099c3b",
                        "source_entry_id": "48baa1ba-f55e-38b8-9fff-59d6fea81b21",
                        "source_sense_id": "87dedd72-5e37-3022-8192-24e3a100ce78",
                        "target_lang_word": "gallery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "242b13c9-c670-38f5-a851-619ca85ec327",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "An institution, building, or room for the exhibition and conservation of important objects, especially works of art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14f8f0d-92a1-4771-9bcc-0bc265929120",
                                                "sense_id": "242b13c9-c670-38f5-a851-619ca85ec327",
                                                "text": "In the gallery are displayed genuine artifacts dug up from the site, and in the gift shop you can buy a replica as a souvenir."
                                            },
                                            {
                                                "example_id": "a3877d12-3e58-4def-9d2d-5ee5a35db2a0",
                                                "sense_id": "242b13c9-c670-38f5-a851-619ca85ec327",
                                                "text": "Some of her work is so impressive that it really ought to be in a gallery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f965a2-b10d-3be4-8b30-8e897486a5d9",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "An establishment that buys, sells, and displays works of art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea47043-7deb-49cf-9bcb-f7ef00c5dc14",
                                                "sense_id": "c0f965a2-b10d-3be4-8b30-8e897486a5d9",
                                                "text": "Near-synonyms: art dealer's, dealer's"
                                            },
                                            {
                                                "example_id": "c3d487f1-72d7-474d-affd-a1fa77df7dda",
                                                "sense_id": "c0f965a2-b10d-3be4-8b30-8e897486a5d9",
                                                "text": "Some of her best work can be yours: it is available at a gallery, if you can afford it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "027dd399-50bd-3f41-9e22-e24be12103e2",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "The uppermost seating area projecting from the rear or side walls of a theater, concert hall, or auditorium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c804e7-63a0-4d88-ba90-484644d09627",
                                                "sense_id": "027dd399-50bd-3f41-9e22-e24be12103e2",
                                                "text": "We could afford the less expensive seats in the gallery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c426191d-2b30-3309-ab9d-c9be87a19335",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "The spectators at an event, collectively."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d41ca867-f1ca-445f-9122-66ffba7d42ef",
                                                "sense_id": "c426191d-2b30-3309-ab9d-c9be87a19335",
                                                "text": "The politician was clearly appealing to the gallery"
                                            },
                                            {
                                                "example_id": "473ca106-8d42-476e-a95d-e031473062a3",
                                                "sense_id": "c426191d-2b30-3309-ab9d-c9be87a19335",
                                                "text": "Capello was missing his son's wedding in Milan to take charge – yet his reshaped England team gave him cause for a double celebration as they overturned the odds in front of a delighted Wembley gallery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c69ad2e2-eb5a-33e3-b624-e10fa9874ca6",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "The part of a courtroom, often elevated and in the rear, where seating for the public audience is facilitated during trial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6967aa8-0465-43f3-b41d-33e3ff467882",
                                                "sense_id": "c69ad2e2-eb5a-33e3-b624-e10fa9874ca6",
                                                "text": "appealing to the gallery"
                                            },
                                            {
                                                "example_id": "5486d46c-a3a1-483a-829f-80fd9a530363",
                                                "sense_id": "c69ad2e2-eb5a-33e3-b624-e10fa9874ca6",
                                                "text": "Rose and Valerie, screaming from the gallery\nSay he must go free"
                                            }
                                        ]
                                    },
                                    {
