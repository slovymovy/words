{
    "word_family": [
        "encroach"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "520e5ff5-e8f1-3892-b599-46e7c2bfaef1",
                    "sense_definition": "An entry into a place or area that was previously uncommon or restricted.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intrusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid <w>encroachment</w> of the desert is threatening the local farming communities."
                        },
                        {
                            "text": "Local residents protested against the <w>encroachment</w> of the new highway into their quiet neighborhood."
                        }
                    ],
                    "synonyms": [
                        "intrusion",
                        "incursion",
                        "invasion"
                    ],
                    "common_phrases": [
                        "urban encroachment",
                        "encroachment of desert"
                    ]
                },
                {
                    "sense_id": "d5c59a62-531a-385c-b292-0287f06d1896",
                    "sense_definition": "An intrusion upon another person's rights, property, or authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intrusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law is seen by many as an <w>encroachment</w> on personal privacy."
                        },
                        {
                            "text": "The company faced legal action for the <w>encroachment</w> on the intellectual property rights of its competitor."
                        }
                    ],
                    "synonyms": [
                        "infringement",
                        "violation"
                    ],
                    "common_phrases": [
                        "encroachment on rights",
                        "encroachment on privacy"
                    ]
                },
                {
                    "sense_id": "08bb4b7b-bb60-3543-83b3-f2f3ca36f94e",
                    "sense_definition": "Something that has been gained or taken through unlawful intrusion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intrusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ordered the removal of the illegal <w>encroachment</w> built on the neighbor's land."
                        },
                        {
                            "text": "The fence was identified as a clear <w>encroachment</w> onto the public park space."
                        }
                    ],
                    "synonyms": [
                        "trespass"
                    ],
                    "common_phrases": [
                        "remove encroachment"
                    ]
                },
                {
                    "sense_id": "a2ab72ce-3886-3b20-8d30-7a9daf66d1de",
                    "sense_definition": "The act of unlawfully reducing the possessions or land of another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intrusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveyor confirmed that the shed was an <w>encroachment</w> on the adjacent property."
                        },
                        {
                            "text": "Legal disputes often arise from the <w>encroachment</w> of one landowner onto another's territory."
                        }
                    ],
                    "synonyms": [
                        "trespass"
                    ],
                    "common_phrases": [
                        "property encroachment"
                    ]
                }
            ]
        }
    ]
}