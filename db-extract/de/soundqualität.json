                "senses": [
                    {
                        "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                        "entry_id": "b850d006-70cf-34ae-ab6b-b185dc19308a",
                        "glosses": [
                            "Güte von Klängen oder Musik"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "701517aa-0ceb-4477-b17e-e11065c7775a",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„Wie ist die Soundqualität?“"
                            },
                            {
                                "example_id": "0968dc82-dcec-4b5c-94e7-fe97e735635c",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„Ein intensiver Test zeigt: Die Soundqualität ist beeindruckend“ […]."
                            },
                            {
                                "example_id": "d598a357-f150-4bed-9db1-6d564b74907d",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„Die \"The Loft\"-Partys waren bekannt für ihre Soundqualität.“"
                            },
                            {
                                "example_id": "29e2dc81-339b-4e7d-bdef-b74e241b6db4",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„Zusätzlich wurden sowohl die maximale Lautstärke als auch die Soundqualität durch einen neuen Codec-Chip erhöht.“"
                            },
                            {
                                "example_id": "550dbf74-44ec-4aa4-ad6a-a488f5375e87",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "[Bluetooth-In-Ear-Kopfhörern:] „Die trendigen Hörer können noch so eine gute Soundqualität und lange Akkulaufzeit bieten. Das entscheidende Kriterium ist ein anderes: Passen sie auf das eigene Ohr oder fallen sie dauernd heraus?“"
                            },
                            {
                                "example_id": "6a84e920-d653-4512-8899-bf0c58faa81b",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„An Android-Smartphones kann man eine ganze Menge individueller und optimierender Einstellungen vornehmen - so auch die Verbesserung der Soundqualität.“"
                            },
                            {
                                "example_id": "49fb1e5f-bbdc-4c84-ac0a-4e39adf6777d",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„Musik-Kassetten sind so gut wie tot. Und eigentlich haben sie auch kein anderes Schicksal verdient: Die Soundqualität war katastrophal, Kassetten haben gerauscht ohne Ende,“ […]."
                            },
                            {
                                "example_id": "c1acd166-30a8-4b54-a1db-f9be86b4efc3",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„Trotz nicht immer klarer Soundqualität wirken die Stücke lebendig.“"
                            },
                            {
                                "example_id": "2d83b199-4966-43f6-b028-49413620e61a",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„Eder bemängelte die Soundqualität der Liveaufnahme aus den frühen 1970er Jahre, lobte jedoch das Spiel der Musiker, vor allem das von Greg Lake.“"
                            },
                            {
                                "example_id": "358160ee-bb6d-4cc8-91a7-973c06167875",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„2004 begab sich die Band dann wieder ins Studio, um das neue Album Atmen einzuspielen, die Soundqualität überzeugte allerdings nicht, so dass dieses Demo nicht veröffentlicht wurde.“"
                            },
                            {
                                "example_id": "3cf86f1d-6c74-46a8-ba4d-c05397bd9e15",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„Mit den zwei Floyds und Shirley wurde sogar ein Live-Auftritt nach den Studiosessions in London absolviert. Allerdings war die Soundqualität miserabel und Syd Barrett stellte nach vier Songs die Gitarre ab und verschwand von der Bühne.“"
                            },
                            {
                                "example_id": "097936a1-0687-4d65-8a15-ca07d111a7b5",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "„40 Jahre später präsentiert sich der Konzertfilm mit hochaufgelösten Bildern und einem Rundum-Klangerlebnis. Diese neue Soundqualität macht die ausgesprochen dichten und oft nervösen Songs der Talking Heads transparenter – und noch detailreicher.“"
                            },
                            {
                                "example_id": "fadc0bcc-b1b8-4ce6-a925-7187ee4b909e",
                                "sense_id": "610b6413-7635-3053-9187-b60396630ea6",
                                "text": "[Es] „erschien SOS als dritte Single aus dem Album. Dieser neuartige Poptitel erreichte unter anderem Platz 6 der britischen Charts sowie Platz 1 in Deutschland und war sowohl vom Arrangement als auch von der Soundqualität für ABBA nun richtungweisend für ihre weiteren Songproduktionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
