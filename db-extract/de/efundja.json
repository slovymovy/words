                "senses": [
                    {
                        "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                        "entry_id": "a887f233-1c63-3c5f-ab68-7892bd626098",
                        "glosses": [
                            "im zentralen Norden Namibias saisonal auftretendes Hochwasser"
                        ],
                        "tags": [
                            "Namibia"
                        ],
                        "examples": [
                            {
                                "example_id": "0abe971b-ceff-47e0-a28a-2138984814af",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„Nachdem der letzte Rest des Sees unter trockenen und heißen Bedingungen völlig verschwunden war, bildete sich an seiner Stelle eine Pfanne, die nur noch manchmal durch Regen oder auch Fluten in den Oshanas, den so genannten Efundjas, überflutet wird.“"
                            },
                            {
                                "example_id": "ba4e4053-f7fc-40a1-a6fe-067d1e58f558",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„Die stets steigende Überflutung (Efundja) aus Angola sowie erneute schwere Regengüsse im Norden haben selbst hartnäckig ausharrende Menschen aus 14 Wohnvierteln und angrenzenden Dörfern von Oshakati zur Evakuierung gezwungen.“"
                            },
                            {
                                "example_id": "d23187b5-5428-4985-8a07-2b3127b1baa3",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„8620 Familien seien von dem Efundja (Hochwasser) betroffen und bisher 2014 Häuser vom Wasser zerstört worden.“"
                            },
                            {
                                "example_id": "6e96eb9e-f1e7-4d16-8635-187fe0539ab9",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„‚Hoffentlich werden die Moskitonetze nicht wieder zum Fischen benutzt, wie es teilweise im vergangenen Jahr während des Efundjas geschehen ist‘, sagte der Direktor des Direktorats für Nothilfe-Management.“"
                            },
                            {
                                "example_id": "fbd88c15-b019-4293-a60b-6d439f01cbb8",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„Dem Direktor für ländliche Trinkwasserversorgung im Ministerium für Landwirtschaft, Wasserbau und Forstwirtschaft, Harald Koch, zufolge werde der Kanal seit Beginn des Hochwassers überflutet und deshalb das Wasser des Efundja für die Trinkwasserversorgung der Orte aufbereitet.“"
                            },
                            {
                                "example_id": "938f98ba-9374-4222-abad-6697c03c5a95",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„Der Efundja (Hochwasser) hat bereits wie im vergangenen Jahr einige tiefliegende Gebiete Oshakatis in der Oshana-Region im zentralen Norden des Landes überflutet und dem Chefhydrologen des Ministeriums für Landwirtschaft, Wasserbau und Forstwirtschaft, Guido van Langenhove zufolge steigen die Pegel an den Messstationen in den Oshanas (Senken) im Cuvelaisystem.“"
                            },
                            {
                                "example_id": "0f6c873f-b3ea-4e5d-8ab0-3d8603aaab5d",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„Mit einem Durchschnitt von 1,30 Meter erreichte der Efundja (Hochwasser) in Oshakati im Jahr 2009 am 2. März seinen höchsten Stand und im vergangenen Jahr mit 1,07 m am 7. April.“"
                            },
                            {
                                "example_id": "08bca7cf-f8eb-414f-a758-64d4dd5c832a",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„Der Efundja (Hochwasser) ist relativ hoch, aber hat bei weitem nicht die Ausmaße wie in den Jahren 2009 und 2011, als riesige Gebiete im Cuvelai-System wochenlang überflutet waren.“"
                            },
                            {
                                "example_id": "ce04c4c3-4ab6-4677-839c-941ad5de35c5",
                                "sense_id": "992bdbca-28b1-3e79-a285-747548f86d34",
                                "text": "„ Das als Efundja bekannte Hochwasser im zentralen Norden hat zu starker Beeinträchtigung des Unterrichts und sogar zur vorübergehenden Schließung einiger Schulen geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
