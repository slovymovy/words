                                    {
                                        "sense_id": "e3f2fc4c-0843-39ab-9975-33227d8ad252",
                                        "entry_id": "90147faf-f8b2-33a8-a789-b7d0a9721557",
                                        "glosses": [
                                            "A certain edible mushroom (Coprinus comatus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "039fd289-cb34-4a41-ad07-f21a7c416a8f",
                                                "sense_id": "e3f2fc4c-0843-39ab-9975-33227d8ad252",
                                                "text": "You find parasols and lawyer's wig more in the fields, and pholiota..."
                                            },
                                            {
                                                "example_id": "9c38e7b0-5288-4176-a7df-0f342c7c52cc",
                                                "sense_id": "e3f2fc4c-0843-39ab-9975-33227d8ad252",
                                                "text": "These Lawyer's wig fungi are for me the best tasting mushrooms, even better than cepes and they are wonderful just gently fried in butter."
                                            },
                                            {
                                                "example_id": "a5faa8a9-bcde-4aa5-83a5-b83f35b6e41e",
                                                "sense_id": "e3f2fc4c-0843-39ab-9975-33227d8ad252",
                                                "text": "In Britain, Coprinus comatus is dubbed the Lawyer's wig."
                                            }
