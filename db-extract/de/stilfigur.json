                                        "sense_id": "2f82c34c-e1aa-3055-8345-f2bce5c6ecdf",
                                        "entry_id": "be91c1a6-a97d-39cb-abfe-cc3fa61bbe04",
                                        "glosses": [
                                            "A turn of phrase that is not intended to be interpreted literally, but is used solely as a rhetorical device for the purpose of facilitating effective and nuanced communication."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
