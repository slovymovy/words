                "senses": [
                    {
                        "sense_id": "8ce1abb6-2c4d-3a7f-8dac-4d59091f5406",
                        "entry_id": "1adec00e-95b8-350a-ae89-5a17dfe027af",
                        "glosses": [
                            "einer von den zwei im Ohr verlaufenden Gängen, der den Schall von der Ohrmuschel zum Trommelfell leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a9019b-2332-416c-ab33-baaca9bf4429",
                                "sense_id": "8ce1abb6-2c4d-3a7f-8dac-4d59091f5406",
                                "text": "„Die Druckschwankungen im Gehörgang, die durch den Schall auftreten, werden vom Trommelfell aufgenommen und über die Gehörknöchelchen auf das Innenohr übertragen.“"
                            },
                            {
                                "example_id": "6e69cbb7-856e-4749-a8c8-6fb6492e4671",
                                "sense_id": "8ce1abb6-2c4d-3a7f-8dac-4d59091f5406",
                                "text": "„Ich kramte die Ohrenstöpsel aus meinem Nachtbeutel und stopfte sie so tief in die Gehörgänge, bis sie ans Trommelfell stießen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
