                        "sense_id": "ceb00ab0-625c-3393-bb9a-da17d280cd3b",
                        "entry_id": "0bb30f40-0e45-3c4b-8beb-3e696a80b4a2",
                        "glosses": [
                            "Quartier, zone périurbaine où vivent les classes populaires."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "da688b68-04a9-4536-84a9-408f6de6022a",
                                "sense_id": "ceb00ab0-625c-3393-bb9a-da17d280cd3b",
                                "text": "C’est respecte les gens, pas leur genhar,\nQu’ils pèsent ou non, qu’ils viennent ou non du tiéquar"
                            },
                            {
                                "example_id": "8ecdb448-8e1d-4edd-9924-fb4c41ee3026",
                                "sense_id": "ceb00ab0-625c-3393-bb9a-da17d280cd3b",
                                "text": "Aucune hostilité à ton égard,\nJe nous revois marcher avec un pas d’écart dans le tiéquar"
                            },
                            {
                                "example_id": "44eb7315-c6cf-4c63-90f9-e375118fc76f",
                                "sense_id": "ceb00ab0-625c-3393-bb9a-da17d280cd3b",
                                "text": "Bando, bando, je parle pas de ghetto, j’suis toujours au tiéquar avec mes gars, j’blesse"
                            }
                        ]
                    }
                ],
