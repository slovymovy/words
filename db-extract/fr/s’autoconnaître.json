                        "glosses": [
                            "Se connaître soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac1e3045-6ec0-4426-a25f-e779ed8ae209",
                                "sense_id": "0f1974ce-803e-335c-998f-5b9a774791a0",
                                "text": "Il ne veut plus dire qu’un individu cherche son identité en menant le dialogue avec soi-même pour arriver à s’autoconnaître jusqu’au tel point qu’il puisse former sa personnalité."
                            },
                            {
                                "example_id": "fefd92c2-56d8-44b2-90ab-011fe57b318b",
                                "sense_id": "0f1974ce-803e-335c-998f-5b9a774791a0",
                                "text": "Exercer librement l’art, s'approcher au possible de l’Idéal, lever le voile de Sais pour connaître et s’autoconnaître: voilà ce que cherchent les artistes balzaciens: (...)"
                            }
                        ]
