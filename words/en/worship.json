{
    "word_family": [
        "worshipper",
        "worshipful",
        "worshipfully"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "297f69c2-b52a-3f9e-a73d-9fc3068b505e",
                    "sense_definition": "to show profound religious devotion and reverence to a deity or sacred object",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religious-devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient civilizations used to <w>worship</w> the sun as a powerful god.",
                            "target_lang_translations": {
                                "ru": "Многие древние цивилизации <w>поклонялись</w> солнцу как могущественному богу.",
                                "zh": "许多古代文明曾将太阳作为强大的神来<w>崇拜</w>。"
                            }
                        },
                        {
                            "text": "They gather every Sunday morning to <w>worship</w> God in the local chapel.",
                            "target_lang_translations": {
                                "ru": "Они собираются каждое воскресное утро, чтобы <w>славить</w> Бога в местной часовне.",
                                "zh": "他们每周日早上都会聚集在当地的小教堂里<w>礼拜</w>上帝。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reverence",
                        "idolatry"
                    ],
                    "common_phrases": [
                        "worship God",
                        "worship idols"
                    ],
                    "target_lang_definitions": {
                        "ru": "проявлять глубокую религиозную преданность и почтение к божеству или священному объекту",
                        "zh": "对神灵或神圣事物表现出深厚的宗教虔诚和崇敬"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поклоняться",
                                "target_lang_sense_clarification": "веровать как в божество"
                            },
                            {
                                "target_lang_word": "почитать",
                                "target_lang_sense_clarification": "относиться с почтением"
                            },
                            {
                                "target_lang_word": "чтить",
                                "target_lang_sense_clarification": "проявлять глубокое уважение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "崇拜",
                                "target_lang_sense_clarification": "对神灵的敬奉"
                            },
                            {
                                "target_lang_word": "敬拜",
                                "target_lang_sense_clarification": "宗教仪式中的礼拜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "314b9d9b-509a-308c-ac43-36cda658a064",
                    "sense_definition": "to love or admire someone or something intensely and excessively",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intense-admiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seems to <w>worship</w> the ground she walks on and does everything for her.",
                            "target_lang_translations": {
                                "ru": "Кажется, он <w>боготворит</w> землю, по которой она ходит, и делает для неё всё.",
                                "zh": "他似乎对她<w>迷恋</w>到了极点，愿意为她做任何事。"
                            }
                        },
                        {
                            "text": "Young fans often <w>worship</w> celebrities as if they were perfect human beings.",
                            "target_lang_translations": {
                                "ru": "Юные фанаты часто <w>обожают</w> знаменитостей, как будто те — идеальные люди.",
                                "zh": "年轻的粉丝经常把名人当作完美的人来<w>崇拜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adoration",
                        "idolatry"
                    ],
                    "common_phrases": [
                        "worship the ground",
                        "worship celebrities"
                    ],
                    "target_lang_definitions": {
                        "ru": "интенсивно и чрезмерно любить или восхищаться кем-либо или чем-либо",
                        "zh": "对某人或某物怀有强烈且过度的爱慕或钦佩"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боготворить",
                                "target_lang_sense_clarification": "преклоняться перед кем-либо"
                            },
                            {
                                "target_lang_word": "обожать",
                                "target_lang_sense_clarification": "восторженно любить"
                            },
                            {
                                "target_lang_word": "преклоняться",
                                "target_lang_sense_clarification": "глубоко уважать и восхищаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "崇拜",
                                "target_lang_sense_clarification": "对人的盲目推崇"
                            },
                            {
                                "target_lang_word": "迷恋",
                                "target_lang_sense_clarification": "强烈的喜爱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3378c4f-ea9e-3486-9fbc-22be44e39f19",
                    "sense_definition": "to take part in a religious service or ceremony",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious-devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family prefers to <w>worship</w> together at the community center.",
                            "target_lang_translations": {
                                "ru": "Семья предпочитает <w>молиться</w> вместе в общественном центре.",
                                "zh": "这家人更喜欢在社区中心一起<w>做礼拜</w>。"
                            }
                        },
                        {
                            "text": "People of all faiths are welcome to <w>worship</w> at the church down the road.",
                            "target_lang_translations": {
                                "ru": "Люди всех вероисповеданий могут <w>посещать службы</w> в церкви вниз по дороге.",
                                "zh": "欢迎所有信仰的人到路那头的教堂<w>礼拜</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "worship at church",
                        "worship together"
                    ],
                    "target_lang_definitions": {
                        "ru": "принимать участие в религиозной службе или церемонии",
                        "zh": "参加宗教仪式或礼拜活动"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молиться",
                                "target_lang_sense_clarification": "участвовать в молитве"
                            },
                            {
                                "target_lang_word": "совершать богослужение",
                                "target_lang_sense_clarification": "участвовать в обрядах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做礼拜",
                                "target_lang_sense_clarification": "参加宗教仪式"
                            },
                            {
                                "target_lang_word": "礼拜",
                                "target_lang_sense_clarification": "进行宗教活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1279229a-44c0-362c-904f-c68bc4dabda0",
                    "sense_definition": "to touch or kiss someone in an intensely sensual or adoring way",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intense-admiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began <w>worshipping</w> her body with soft kisses and gentle touches.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>ласкать</w> её тело нежными поцелуями и мягкими прикосновениями.",
                                "zh": "他开始用轻柔的吻和温柔的抚摸来<w>爱抚</w>她的身体。"
                            }
                        },
                        {
                            "text": "The novel describes how the protagonist would <w>worship</w> his lover with his hands.",
                            "target_lang_translations": {
                                "ru": "В романе описывается, как главный герой <w>боготворил</w> свою возлюбленную своими руками.",
                                "zh": "小说描述了主人公是如何用双手去<w>爱抚</w>他的爱人的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "worship with kisses"
                    ],
                    "target_lang_definitions": {
                        "ru": "касаться или целовать кого-либо с чувственным обожанием",
                        "zh": "以充满感官爱慕的方式触摸或亲吻某人"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боготворить",
                                "target_lang_sense_clarification": "выражать обожание через ласки"
                            },
                            {
                                "target_lang_word": "ласкать",
                                "target_lang_sense_clarification": "нежно касаться с любовью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱抚",
                                "target_lang_sense_clarification": "充满爱意的触摸"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2eb3aa1f-1eee-3ee1-880d-9dc6e617b44b",
                    "sense_definition": "the feeling or expression of reverence and adoration for a deity",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religious-devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temple was built as a place of <w>worship</w> for the local community.",
                            "target_lang_translations": {
                                "ru": "Храм был построен как место для <w>поклонения</w> местной общины.",
                                "zh": "这座寺庙是为当地社区建造的<w>礼拜</w>场所。"
                            }
                        },
                        {
                            "text": "Their daily <w>worship</w> includes singing hymns and reading sacred texts.",
                            "target_lang_translations": {
                                "ru": "Их ежедневное <w>почитание</w> включает пение гимнов и чтение священных текстов.",
                                "zh": "他们日常的<w>崇拜</w>活动包括唱赞美诗和阅读圣经。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adoration",
                        "reverence",
                        "idolatry"
                    ],
                    "common_phrases": [
                        "place of worship",
                        "religious worship",
                        "freedom of worship"
                    ],
                    "target_lang_definitions": {
                        "ru": "чувство или выражение почтения и обожания божества",
                        "zh": "对神灵的崇敬和爱慕之情"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поклонение",
                                "target_lang_sense_clarification": "религиозное почитание"
                            },
                            {
                                "target_lang_word": "почитание",
                                "target_lang_sense_clarification": "оказание уважения божеству"
                            },
                            {
                                "target_lang_word": "культ",
                                "target_lang_sense_clarification": "система религиозных обрядов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "崇拜",
                                "target_lang_sense_clarification": "宗教上的敬奉"
                            },
                            {
                                "target_lang_word": "敬畏",
                                "target_lang_sense_clarification": "对神圣事物的尊崇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80cc4a54-b010-3721-9e06-067fd368f33d",
                    "sense_definition": "the formal religious ceremonies or acts that express devotion",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious-devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning <w>worship</w> will begin promptly at ten o'clock.",
                            "target_lang_translations": {
                                "ru": "Утреннее <w>богослужение</w> начнется ровно в десять часов.",
                                "zh": "早晨的<w>礼拜</w>仪式将于十点准时开始。"
                            }
                        },
                        {
                            "text": "Public <w>worship</w> was banned during the period of political unrest.",
                            "target_lang_translations": {
                                "ru": "Публичные <w>богослужения</w> были запрещены в период политических беспорядков.",
                                "zh": "在政治动荡时期，公共<w>礼拜</w>活动被禁止了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "morning worship",
                        "public worship"
                    ],
                    "target_lang_definitions": {
                        "ru": "формальные религиозные церемонии или действия, выражающие преданность",
                        "zh": "表达虔诚的正式宗教仪式或行为"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богослужение",
                                "target_lang_sense_clarification": "церковная служба"
                            },
                            {
                                "target_lang_word": "служба",
                                "target_lang_sense_clarification": "религиозный обряд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "礼拜",
                                "target_lang_sense_clarification": "宗教仪式"
                            },
                            {
                                "target_lang_word": "崇拜仪式",
                                "target_lang_sense_clarification": "正式的宗教活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23c4f7f5-c099-395a-baf1-ed7110d05c1a",
                    "sense_definition": "intense love, admiration, or devotion shown towards a person",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intense-admiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>worship</w> of the famous singer bordered on obsession.",
                            "target_lang_translations": {
                                "ru": "Её <w>обожание</w> знаменитого певца граничило с одержимостью.",
                                "zh": "她对那位著名歌手的<w>崇拜</w>近乎痴迷。"
                            }
                        },
                        {
                            "text": "The young man's <w>worship</w> of his mentor was evident to everyone.",
                            "target_lang_translations": {
                                "ru": "<w>Преклонение</w> молодого человека перед своим наставником было очевидно всем.",
                                "zh": "那个年轻人对他导师的<w>崇拜</w>是显而易见的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adoration",
                        "idolatry"
                    ],
                    "common_phrases": [
                        "hero worship"
                    ],
                    "target_lang_definitions": {
                        "ru": "сильная любовь, восхищение или преданность, проявляемые к человеку",
                        "zh": "对某人表现出的强烈爱慕、钦佩或忠诚"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обожание",
                                "target_lang_sense_clarification": "восторженная любовь"
                            },
                            {
                                "target_lang_word": "преклонение",
                                "target_lang_sense_clarification": "глубокое восхищение"
                            },
                            {
                                "target_lang_word": "почитание",
                                "target_lang_sense_clarification": "оказание высокого уважения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "崇拜",
                                "target_lang_sense_clarification": "对人的推崇"
                            },
                            {
                                "target_lang_word": "迷恋",
                                "target_lang_sense_clarification": "极度的喜爱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d65c60d3-5980-3111-a26e-2cf51e6e9f11",
                    "sense_definition": "a title of honor used when addressing certain officials like mayors or magistrates",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "honorific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer addressed the magistrate as Your <w>Worship</w> during the trial.",
                            "target_lang_translations": {
                                "ru": "Адвокат обращался к судье «Ваша <w>милость</w>» во время процесса.",
                                "zh": "在审判期间，律师称呼地方法官为“<w>阁下</w>”。"
                            }
                        },
                        {
                            "text": "I beg your <w>worship</w>'s pardon for the late arrival of the documents.",
                            "target_lang_translations": {
                                "ru": "Прошу прощения у вашей <w>милости</w> за позднюю доставку документов.",
                                "zh": "因文件送达迟延，我恳请<w>阁下</w>原谅。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "your worship"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used as a formal title"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "почетный титул, используемый при обращении к определенным должностным лицам",
                        "zh": "对市长或地方法官等官员的尊称"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милость",
                                "target_lang_sense_clarification": "в обращении 'ваша милость'"
                            },
                            {
                                "target_lang_word": "судья",
                                "target_lang_sense_clarification": "в контексте обращения в суде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阁下",
                                "target_lang_sense_clarification": "对官员的尊称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "508304f8-1090-3e83-a3ec-0f1fdea656bf",
                    "sense_definition": "the act of an artist's work being very obviously influenced by another artist",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intense-admiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band's new album is a clear example of Velvet Underground <w>worship</w>.",
                            "target_lang_translations": {
                                "ru": "Новый альбом группы — яркий пример <w>преклонения</w> перед Velvet Underground.",
                                "zh": "这支乐队的新专辑显然是对“地下丝绒”乐队的<w>模仿</w>。"
                            }
                        },
                        {
                            "text": "Critics dismissed the film as mere Hitchcock <w>worship</w> without any original ideas.",
                            "target_lang_translations": {
                                "ru": "Критики отвергли фильм как простое <w>подражание</w> Хичкоку без каких-либо оригинальных идей.",
                                "zh": "评论家们认为这部电影只是对希区柯克的<w>模仿</w>，没有任何原创思想。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "unapologetic worship"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in arts and music criticism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "явное влияние творчества одного художника на работу другого",
                        "zh": "艺术作品明显受到另一位艺术家影响的行为"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преклонение",
                                "target_lang_sense_clarification": "перед творчеством мастера"
                            },
                            {
                                "target_lang_word": "культ",
                                "target_lang_sense_clarification": "чрезмерное подражание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模仿",
                                "target_lang_sense_clarification": "对艺术风格的效仿"
                            },
                            {
                                "target_lang_word": "崇拜",
                                "target_lang_sense_clarification": "对大师的盲目追随"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "dbbdccd7-7730-3778-abcb-aecd4856fdeb",
                    "sense_definition": "a <w>surname</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
