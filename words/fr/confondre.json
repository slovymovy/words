{
    "word_family": [
        "confusion",
        "confus",
        "confusément",
        "inconfondable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b6c7095-90bf-3b01-ac1b-034ac80ec2f1",
                    "sense_definition": "Prendre une personne ou une chose pour une autre par erreur ou manque de discernement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai souvent <w>confondu</w> ces deux collègues parce qu'ils portent les mêmes lunettes."
                        },
                        {
                            "text": "Il ne faut pas <w>confondre</w> la vitesse avec la précipitation dans ce travail."
                        }
                    ],
                    "synonyms": [
                        "mélanger"
                    ],
                    "antonyms": [
                        "distinguer",
                        "différencier"
                    ],
                    "common_phrases": [
                        "confondre avec",
                        "confondre deux choses"
                    ]
                },
                {
                    "sense_id": "54a564b2-0bf5-363a-bdab-ded17f424b5d",
                    "sense_definition": "Mêler ou réunir des éléments distincts de manière à ce qu'ils forment un tout continu ou deviennent indiscernables.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au loin sur l'océan, la mer semble se <w>confondre</w> avec le ciel gris."
                        },
                        {
                            "text": "La couleur du pelage de ce félin lui permet de se <w>confondre</w> dans le décor."
                        }
                    ],
                    "synonyms": [
                        "fusionner",
                        "mêler",
                        "associer"
                    ],
                    "antonyms": [
                        "séparer",
                        "dissocier"
                    ],
                    "common_phrases": [
                        "se confondre avec",
                        "se confondre dans le décor"
                    ]
                },
                {
                    "sense_id": "878c960d-170a-3599-8ecf-091933a501f3",
                    "sense_definition": "Démasquer une personne en apportant la preuve irréfutable de sa faute ou de son mensonge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs ont réussi à <w>confondre</w> le suspect grâce aux traces d'ADN retrouvées sur place."
                        },
                        {
                            "text": "Ce document officiel a permis de <w>confondre</w> le coupable devant le tribunal."
                        }
                    ],
                    "synonyms": [
                        "démasquer",
                        "piéger"
                    ],
                    "antonyms": [
                        "innocenter"
                    ],
                    "common_phrases": [
                        "confondre le coupable",
                        "confondre un imposteur"
                    ]
                },
                {
                    "sense_id": "dddb994c-a30a-38ff-8fd6-3f3609d3759d",
                    "sense_definition": "Exprimer avec profusion et insistance des marques de politesse, de gratitude ou de regret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrivé très en retard au dîner, il s'est <w>confondu</w> en excuses auprès de ses amis."
                        },
                        {
                            "text": "La cliente s'est <w>confondue</w> en remerciements après avoir retrouvé son sac égaré."
                        }
                    ],
                    "common_phrases": [
                        "se confondre en excuses",
                        "se confondre en remerciements"
                    ]
                },
                {
                    "sense_id": "94454f3a-c6a9-3599-875a-4307ed95d96d",
                    "sense_definition": "Frapper d'un grand étonnement ou laisser sans voix par son caractère déconcertant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une telle mauvaise foi ne cesse de me <w>confondre</w> à chaque nouvelle discussion."
                        },
                        {
                            "text": "L'audace extraordinaire de ce projet artistique <w>confond</w> les critiques les plus sévères."
                        }
                    ],
                    "synonyms": [
                        "abasourdir",
                        "déconcerter",
                        "stupéfier"
                    ],
                    "common_phrases": [
                        "confondre la raison"
                    ]
                }
            ]
        }
    ]
}