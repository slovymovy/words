                        "glosses": [
                            "w sposób tchórzliwy, właściwy tchórzowi; bez odwagi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d518fecc-d200-4931-95d9-769158d08e36",
                                "sense_id": "f93b29da-decd-3cf6-bffc-e47cc3e9e478",
                                "text": "Czesi, Rumuni, Węgrzy zachowali się bardziej tchórzliwie, i wykładali Łysenkę"
                            },
                            {
                                "example_id": "e0f295d5-ed43-4587-b3e4-ead32d8c96aa",
                                "sense_id": "f93b29da-decd-3cf6-bffc-e47cc3e9e478",
                                "text": "Niestety, nie mogłem namówić pana Macieja na energiczną akcję; było widoczne, że tchórzliwie chciał mieć już tę sprawę za sobą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
