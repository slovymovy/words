                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cdeffd53-c3d4-4a7c-a785-7a93c324b6c1",
                        "entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "légistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                        "entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                        "glosses": [
                            "Celui qui est versé dans la connaissance et l’étude des lois."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "648b9a57-3549-419c-a7de-cc9d09bb2194",
                                "sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                                "text": "Tous les légistes sont du même avis sur cette question."
                            },
                            {
                                "example_id": "65235c1d-6475-4abc-937d-38bba5d35bf5",
                                "sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                                "text": "Réduit à cette seule preuve, la vérité m’échappe, — et il n'y a pas un légiste qui ne fût fondé à contester l’existence matérielle de l’individu !"
                            }
                        ]
                    },
                    {
                        "sense_id": "fa5cf992-799e-3f7d-969a-0061d0845180",
                        "entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                        "glosses": [
                            "Juriste qui, en France, a soutenu et organisé l’autorité monarchique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73c11e87-73d4-4646-bfa8-2a57ea42e4d0",
                                "sense_id": "fa5cf992-799e-3f7d-969a-0061d0845180",
                                "text": "Philippe le Bel s’appuya sur les légistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "802cb1cb-0ae4-353e-9371-b2c282204400",
                        "entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                        "glosses": [
                            "Médecin légiste."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "3d452ea2-72f1-4784-9c8a-644b7187456a",
                                "sense_id": "802cb1cb-0ae4-353e-9371-b2c282204400",
                                "text": "Le légiste reboutonna prestement son imperméable, avec une satisfaction visible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be49b665-89f6-4327-bb94-715ed3ff8267",
                        "source_entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                        "source_sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                        "source_sense_description": "Celui qui est versé dans la connaissance et l’étude des lois",
                        "target_lang_word": "Legist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Legist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fa17804-cc8f-3a5a-81e7-4a7e1d609e50",
                                        "entry_id": "adf90de8-02e1-3c07-80e0-3d27b21f239b",
                                        "glosses": [
                                            "Jurist, der sich mit Gesetzestexten beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34973c59-540f-4644-bce5-c94ff3746d3a",
                                                "sense_id": "8fa17804-cc8f-3a5a-81e7-4a7e1d609e50",
                                                "text": "„Im österreichischen Sprachgebrauch ist Legist (Latein lex = Gesetz) die Berufsbezeichnung für Juristen, die ausschließlich oder überwiegend mit dem Ausarbeiten von Gesetzes- oder Verordnungstexten betraut sind.“"
                                            },
                                            {
                                                "example_id": "6e13dddd-4f27-4b3c-b888-2f231b3545f1",
                                                "sense_id": "8fa17804-cc8f-3a5a-81e7-4a7e1d609e50",
                                                "text": "„Ziel dieses Leitfadens ist es demgemäß der Legistin bzw. dem Legisten das nötige Gespür dafür zu geben, ob die facettenreichen Anforderungen der IKT durch den zu erstellenden bzw. vorliegenden Entwurf erfüllt sind, oder aber ob Anpassungsbedarf besteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7af95f9-b6e5-452c-a0f1-d2f4a32b3d38",
                        "source_entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                        "source_sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                        "source_sense_description": "Celui qui est versé dans la connaissance et l’étude des lois",
                        "target_lang_word": "Legistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7d077fc2-0375-46b0-bdce-a9c4fd070d35",
                        "source_entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                        "source_sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                        "source_sense_description": "Celui qui est versé dans la connaissance et l’étude des lois",
                        "target_lang_word": "Jurist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jurist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                        "entry_id": "c1c9374c-f0ca-399f-a87d-6e5f41fd99f2",
                                        "glosses": [
                                            "jemand, der Rechtswissenschaft studiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9fca6f-83bf-4b35-aa69-1b269fda5f57",
                                                "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                                "text": "Unter den Studenten bilden die Juristen eine besondere Spezies."
                                            },
                                            {
                                                "example_id": "cb0f161e-4a66-4d50-af4d-5a21b1f7831d",
                                                "sense_id": "76620988-9eda-3875-af07-18e8c184fbfe",
                                                "text": "„Trotz der Einsicht der Juristen in die Verbesserungswürdigkeit von Gesetzestexten sei noch viel zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                        "entry_id": "c1c9374c-f0ca-399f-a87d-6e5f41fd99f2",
                                        "glosses": [
                                            "Deutschland: jemand, der das Jurastudium mit dem zweiten Staatsexamen abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b9cbf30-57c7-4f60-b814-ca7b5538ea25",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "Ein Jurist weiß, wie ein Gerichtsurteil zu lesen ist."
                                            },
                                            {
                                                "example_id": "4eb67c8c-10f2-4485-93d7-cb948b7a48b3",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Sie hatte in Berlin Schauspielerin werden wollen und war in Jerusalem die Frau eines langweiligen Juristen geworden.“"
                                            },
                                            {
                                                "example_id": "d40b4a2b-b269-4ec6-b928-33f401dbe0f4",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Nachdem Juristen, Software-Experten und Plagiatsforscher eine Woche lang das Werk des Ministers gefilzt haben, steht fest: Guttenberg hat in seiner Doktorarbeit nicht nur vereinzelt Fremdautoren zitiert, ohne dies nach üblichem Verfahren in einer Fußnote auszuweisen.“"
                                            },
                                            {
                                                "example_id": "3353bac5-ebd6-4c9b-9635-d1de6d82b1c3",
                                                "sense_id": "4be105c1-2ca5-33d3-9c8d-083ae3d47a64",
                                                "text": "„Leider hatten die Stadtväter die Rechnung ohne die Juristen gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3704195-bdf1-425b-9644-6f83ef85b532",
                        "source_entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                        "source_sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                        "source_sense_description": "Celui qui est versé dans la connaissance et l’étude des lois",
                        "target_lang_word": "Juristin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juristin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                        "entry_id": "0f07dfe0-49c3-31b2-bf6f-e03925baa512",
                                        "glosses": [
                                            "weibliche Person, die Jura studiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c55217-1442-4ea2-b5de-aaaa05729417",
                                                "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                                "text": "„Das Jurastudium war die Erfüllung ihres Vaters gewesen. Andrew hatte ebenfalls Ambitionen in dieser Richtung gehabt, sie selbst hatte jedoch nie in Erwägung gezogen, Juristin zu werden.“"
                                            },
                                            {
                                                "example_id": "83992708-0acc-4848-8ec5-f095f5cafcfe",
                                                "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                                "text": "„Sie begann ein Studium der Kunstgeschichte, wechselte dann und wurde Juristin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90dc8f43-87ab-4086-a617-0c02c25cede2",
                        "source_entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
