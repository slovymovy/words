                "senses": [
                    {
                        "sense_id": "235601a7-635a-3022-a158-7b8df98729af",
                        "entry_id": "97db1365-21dc-390c-ae5f-e96daede3c3d",
                        "glosses": [
                            "не будучи направляемым или контролируемым сознанием; без осознания, не поддающееся контролю сознания"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e17d9a69-4962-3dbf-9a60-1c6c3e0968ec",
                        "entry_id": "97db1365-21dc-390c-ae5f-e96daede3c3d",
                        "glosses": [
                            "перен. непроизвольно, безотчётно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512903e7-d861-4905-b68c-ced53c91d9e0",
                                "sense_id": "e17d9a69-4962-3dbf-9a60-1c6c3e0968ec",
                                "text": "Не хотел идти в детский сад, петь эти песенки, носить флажки, ходить строем, не хотел ходить в школу, сидеть за этой партой, смотреть на нудные рожи, учиться у людей, которым не верю, — всё это, конечно, бессознательно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82973c45-eb37-4ec5-9309-24f7eb753a3a",
                        "source_entry_id": "97db1365-21dc-390c-ae5f-e96daede3c3d",
                        "target_lang_word": "unconsciously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unconsciously",
