                    {
                        "translation_id": "7e2d908f-3e96-4d28-8b22-843efa95c563",
                        "source_entry_id": "9f9257af-1186-3ffa-8f07-6f2e32960da5",
                        "source_sense_id": "f40b361a-060d-34b2-bf9e-3691a3c37472",
                        "target_lang_word": "конфиденциальность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "конфиденциальность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6defed98-823d-38a0-80c6-59c5b6d8a626",
                                        "entry_id": "68cd9864-7f19-3d81-8d3e-3e9072c5aeb9",
                                        "glosses": [
                                            "устар. свойство по значению прилагательного конфиденциальный; доверительность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4509e3b2-6b3b-4d70-8b75-1047cfa2d1c6",
                                                "sense_id": "6defed98-823d-38a0-80c6-59c5b6d8a626",
                                                "text": "Конечно ж, ― не «флирт»: платоническая сердечность; и чистая дружба; но требовала «культа дружбы»; и тут проявляла ревнивость; она добивалась горячей конфиденциальности, чтобы профессор, идя на свидание с ней, запевал про себя: Сияй же, указывай путь, Веди к недоступному счастью…"
                                            },
                                            {
                                                "example_id": "c110207e-1056-4891-a95f-9786acca4646",
                                                "sense_id": "6defed98-823d-38a0-80c6-59c5b6d8a626",
                                                "text": "Он очень ценил безусловную конфиденциальность их бесед и то женственное начало, с которым Женька откровенно предпочитала согласие и мир, как бы далеко ни заводили споры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c4c0f92-ad8b-3696-a725-83bb1174730e",
                                        "entry_id": "68cd9864-7f19-3d81-8d3e-3e9072c5aeb9",
                                        "glosses": [
                                            "секретность, закрытость какой-либо информации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e07dd7c2-b4a9-46b2-a9d3-81bd3937d1b8",
                                                "sense_id": "0c4c0f92-ad8b-3696-a725-83bb1174730e",
                                                "text": "Эта проблема прямо связана с правом человека на конфиденциальность прочитанной генетической информации."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
