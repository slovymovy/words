{
    "word_family": [
        "ash"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "083ac73e-4836-35b8-815b-49f02d157582",
                    "sense_definition": "A container used for holding ash and cigarette or cigar butts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He emptied the full <w>ashtray</w> into the trash can.",
                            "target_lang_translations": {
                                "ru": "Он вытряхнул полную <w>пе́пельницу</w> в мусорное ведро."
                            }
                        },
                        {
                            "text": "Please do not leave your cigarette butts in the <w>ashtray</w> for too long.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не оставляйте окурки в <w>пе́пельнице</w> слишком надолго."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glass ashtray",
                        "empty the ashtray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ёмкость, предназначенная для сбора пепла и окурков сигарет или сигар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пе́пельница",
                                "target_lang_sense_clarification": "стандартное название предмета для сбора пепла"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0753786a-0497-335d-b135-e808ab52c2b6",
                    "sense_definition": "To place or dispose of cigarette or cigar ash and butts into an ashtray.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully <w>ashtrayed</w> his cigarette before walking inside.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно <w>стряхнул пепел</w> со своей сигареты, прежде чем войти внутрь."
                            }
                        },
                        {
                            "text": "It is polite to <w>ashtray</w> your cigarette properly rather than dropping it on the floor.",
                            "target_lang_translations": {
                                "ru": "Вежливо будет <w>потушить</w> сигарету в пепельнице, а не бросать её на пол."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стряхивать пепел или тушить сигарету в пепельнице."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стряхивать пепел в пепельницу",
                                "target_lang_sense_clarification": "описательный глагол для действия"
                            },
                            {
                                "target_lang_word": "тушить в пепельнице",
                                "target_lang_sense_clarification": "действие по завершению курения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}