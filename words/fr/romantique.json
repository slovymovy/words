            "senses": [
                {
                    "sense_id": "e0b5e554-d19f-3f21-975f-9f1e6b5b4b81",
                    "sense_definition": "Qui est empreint de sentimentalisme, de tendresse ou d'amour délicat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont passé une soirée très <w>romantique</w> dans un restaurant au bord de l'eau."
                        },
                        {
                            "text": "Mon frère préfère regarder une comédie <w>romantique</w> plutôt qu'un film d'action."
                        }
                    ],
                    "synonyms": [
                        "sentimental",
                        "tendre"
                    ],
                    "common_phrases": [
