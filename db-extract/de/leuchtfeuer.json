                "senses": [
                    {
                        "sense_id": "d6aeb1b4-f535-3f36-ace1-208921f5d46b",
                        "entry_id": "a39e2a59-d24e-3c02-b8e7-c32504332224",
                        "glosses": [
                            "Lichtzeichen für die Navigation von Schiffen und Flugzeugen bei schlechter Sicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937db7fd-7e8d-4053-bfe2-2c39e7564519",
                                "sense_id": "d6aeb1b4-f535-3f36-ace1-208921f5d46b",
                                "text": "„Etwas weiter östlich bemerkte Moore auf der Steuerbordseite den einzelnen weißen Lichtblitz des Kajhar-Creek-Leuchtfeuers, der alle zwölf Sekunden aufleuchtete. “"
                            },
                            {
                                "example_id": "6c73548e-1565-4387-af64-7d18398a6ace",
                                "sense_id": "d6aeb1b4-f535-3f36-ace1-208921f5d46b",
                                "text": "„Die Arme der Leuchtfeuer auf der Corniche und auf den Inseln waren noch matt in der Dämmerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0243f221-0b33-47ff-85e0-15cd2e0e4ef3",
                        "source_entry_id": "a39e2a59-d24e-3c02-b8e7-c32504332224",
                        "source_sense_id": "d6aeb1b4-f535-3f36-ace1-208921f5d46b",
                        "source_sense_description": "Lichtzeichen für die Navigation von Schiffen und Flugzeugen bei schlechter Sicht",
                        "target_lang_word": "beacon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beacon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eee2abbb-d2fc-3fbe-9751-73d8a66da150",
                                        "entry_id": "acaa82ee-55eb-350b-a01a-dd72c5cdcbd7",
                                        "glosses": [
                                            "A signal fire to notify of the approach of an enemy, or to give any notice, commonly of warning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f065446f-306e-413c-90a7-5808516cc9ac",
                                                "sense_id": "eee2abbb-d2fc-3fbe-9751-73d8a66da150",
                                                "text": "No flaming Beacons caſt their Blaze afar, / The dreadful Signal of invaſive VVar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b6aaa79-67ac-396b-980a-7bb1851bf230",
                                        "entry_id": "acaa82ee-55eb-350b-a01a-dd72c5cdcbd7",
                                        "glosses": [
                                            "A signal, buoy, post, or other conspicuous mark erected on an eminence near the shore, or moored in shoal water, as a guide to mariners, particularly to warn vessels of danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d943f17b-b117-44c5-9179-25561331721f",
                                                "sense_id": "0b6aaa79-67ac-396b-980a-7bb1851bf230",
                                                "text": "Henceforth, wherever thou may’st roam, / ⁠My blessing, like a line of light, / ⁠Is on the waters day and night, / And like a beacon guards thee home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "541bc02a-7afd-39c9-84d2-2d945a28d686",
                                        "entry_id": "acaa82ee-55eb-350b-a01a-dd72c5cdcbd7",
                                        "glosses": [
                                            "A high hill or other easily distinguishable object near the shore which can serve as guidance for seafarers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "298402ed-f87a-348f-a876-8f489f847cfd",
                                        "entry_id": "acaa82ee-55eb-350b-a01a-dd72c5cdcbd7",
                                        "glosses": [
                                            "That which gives notice of danger, hope, etc., or keeps people on the correct path; a source of inspiration."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1db810e-2d70-4bf4-8dc9-d70bc4d84a3a",
                                                "sense_id": "298402ed-f87a-348f-a876-8f489f847cfd",
                                                "text": "a beacon of hope"
                                            },
                                            {
                                                "example_id": "b7e746fa-8ca2-448f-aa51-f85bb0a0390b",
                                                "sense_id": "298402ed-f87a-348f-a876-8f489f847cfd",
                                                "text": "Modest doubt is called / The beacon of the wise."
                                            },
                                            {
                                                "example_id": "dbcc80f6-42e1-4c6b-b11c-30cb4ea1ef85",
                                                "sense_id": "298402ed-f87a-348f-a876-8f489f847cfd",
                                                "text": "Latin America’s largest economy, with a population of more than 200 million people, is a beacon for China’s delivery and ride-hailing companies looking to export their ruthlessly low-cost business models."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed7f6c65-d33f-3010-87a7-22bfbe53ccc3",
                                        "entry_id": "acaa82ee-55eb-350b-a01a-dd72c5cdcbd7",
                                        "glosses": [
                                            "An electronic device that broadcasts a signal to nearby portable devices, enabling smartphones etc. to perform actions when in physical proximity to the beacon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd3f0b60-e851-307d-b2d6-0df29af553d8",
                                        "entry_id": "acaa82ee-55eb-350b-a01a-dd72c5cdcbd7",
                                        "glosses": [
                                            "Ellipsis of web beacon."
                                        ],
