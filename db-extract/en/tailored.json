                "senses": [
                    {
                        "sense_id": "854a84a4-1f72-3a57-b8b1-fa70a7892ce6",
                        "entry_id": "41823660-bc83-3cf2-ad04-9c6eef82a33a",
                        "glosses": [
                            "Adjusted by a tailor, fitted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d311a46-c806-4279-a5c2-e1ca88b06e58",
                                "sense_id": "854a84a4-1f72-3a57-b8b1-fa70a7892ce6",
                                "text": "Now that she had rested and had fed from the luncheon tray Mrs. Broome had just removed, she had reverted to her normal gaiety. She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bba5ae6-90c8-3723-a6ef-c0982dccb70d",
                        "entry_id": "41823660-bc83-3cf2-ad04-9c6eef82a33a",
                        "glosses": [
                            "Made by a tailor."
                        ],
                        "tags": [],
                        "examples": [
                            {
