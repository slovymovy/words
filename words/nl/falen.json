{
    "word_family": [
        "faal",
        "faalangst",
        "gefaald",
        "faling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66de6ef6-005b-3435-a25f-892c16f68114",
                    "sense_definition": "niet slagen in een poging of opdracht; mislukken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mislukken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks al zijn harde werk bleef hij helaas <w>falen</w> voor het examen.",
                            "target_lang_translations": {
                                "en": "Despite all his hard work, he unfortunately continued to <w>fail</w> the exam.",
                                "ru": "Несмотря на все его усердие, он, к сожалению, продолжал <w>проваливать</w> экзамен."
                            }
                        },
                        {
                            "text": "Zijn pogingen om de wedstrijd te winnen <w>faalden</w> jammerlijk.",
                            "target_lang_translations": {
                                "en": "His attempts to win the match <w>failed</w> miserably.",
                                "ru": "Его попытки выиграть соревнование с треском <w>провалились</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "feilen"
                    ],
                    "antonyms": [
                        "slagen"
                    ],
                    "common_phrases": [
                        "jammerlijk falen",
                        "pogingen faalden"
                    ],
                    "target_lang_definitions": {
                        "en": "to not succeed in an attempt or task; to be unsuccessful",
                        "ru": "не добиться успеха в попытке или задании; потерпеть неудачу"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to be unsuccessful in an attempt"
                            },
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to receive a non-passing grade"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "провалить",
                                "target_lang_sense_clarification": "не справиться с задачей или экзаменом"
                            },
                            {
                                "target_lang_word": "потерпеть неудачу",
                                "target_lang_sense_clarification": "не достичь успеха в чем-либо"
                            },
                            {
                                "target_lang_word": "не сдать",
                                "target_lang_sense_clarification": "об экзамене или тесте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf03f1ad-076e-3247-bc19-8a4a75cdcc8a",
                    "sense_definition": "het doel dat men zich gesteld had niet bereiken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mislukken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>falen</w> in hun opzet om het bedrijf dit jaar winstgevend te maken.",
                            "target_lang_translations": {
                                "en": "They are <w>failing</w> in their plan to make the company profitable this year.",
                                "ru": "Они <w>не справляются</w> со своим планом сделать компанию прибыльной в этом году."
                            }
                        },
                        {
                            "text": "Als we nu niet ingrijpen, zullen we zeker <w>falen</w> in onze missie.",
                            "target_lang_translations": {
                                "en": "If we don't intervene now, we will certainly <w>fail</w> in our mission.",
                                "ru": "Если мы не вмешаемся сейчас, мы определенно <w>потерпим неудачу</w> в нашей миссии."
                            }
                        }
                    ],
                    "antonyms": [
                        "slagen"
                    ],
                    "common_phrases": [
                        "falen in opzet"
                    ],
                    "target_lang_definitions": {
                        "en": "to not achieve a goal that one has set for oneself",
                        "ru": "не достичь поставленной перед собой цели"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to not achieve a particular goal"
                            },
                            {
                                "target_lang_word": "fall short",
                                "target_lang_sense_clarification": "to not reach a target or expectation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "провалить",
                                "target_lang_sense_clarification": "не справиться с планом или замыслом"
                            },
                            {
                                "target_lang_word": "потерпеть крах",
                                "target_lang_sense_clarification": "о полной неудаче в миссии или деле"
                            },
                            {
                                "target_lang_word": "не справиться",
                                "target_lang_sense_clarification": "не выполнить поставленную задачу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60cc54bf-f9b2-3fa6-a188-559050826c1e",
                    "sense_definition": "niet toereikend zijn of tekortschieten in kracht of werking",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tekortschieten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn krachten <w>falen</w> na deze lange en vermoeiende wandeling door de bergen.",
                            "target_lang_translations": {
                                "en": "My strength is <w>failing</w> after this long and tiring hike through the mountains.",
                                "ru": "Силы <w>изменяют</w> мне после этой долгой и утомительной прогулки по горам."
                            }
                        },
                        {
                            "text": "De remmen van de auto <w>faalden</w> op het meest kritieke moment.",
                            "target_lang_translations": {
                                "en": "The car's brakes <w>failed</w> at the most critical moment.",
                                "ru": "Тормоза машины <w>отказали</w> в самый критический момент."
                            }
                        }
                    ],
                    "common_phrases": [
                        "krachten falen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be inadequate or to fall short in strength or operation",
                        "ru": "быть недостаточным или давать сбой в силе или работе"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "of a machine or body part: to cease to operate correctly"
                            },
                            {
                                "target_lang_word": "give out",
                                "target_lang_sense_clarification": "to stop functioning due to exhaustion or wear"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отказывать",
                                "target_lang_sense_clarification": "о технике, тормозах или органах чувств"
                            },
                            {
                                "target_lang_word": "изменять",
                                "target_lang_sense_clarification": "о силах, памяти или удаче"
                            },
                            {
                                "target_lang_word": "давать сбой",
                                "target_lang_sense_clarification": "о работе системы или механизма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52b46934-2857-3a97-b1f5-bb742b5af5c6",
                    "sense_definition": "niet voldoen aan een financiële verplichting; in gebreke blijven",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf dreigt te <w>falen</w> in het betalen van de maandelijkse rente.",
                            "target_lang_translations": {
                                "en": "The company is at risk of <w>defaulting</w> on the monthly interest payments.",
                                "ru": "Компания рискует <w>не выполнить обязательства</w> по выплате ежемесячных процентов."
                            }
                        },
                        {
                            "text": "Wanneer een land gaat <w>falen</w> op zijn schulden, heeft dat grote gevolgen.",
                            "target_lang_translations": {
                                "en": "When a country <w>defaults</w> on its debts, it has major consequences.",
                                "ru": "Когда страна <w>допускает дефолт</w> по своим долгам, это имеет серьезные последствия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "falen in betaling"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in zakelijke of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to fail to meet a financial obligation; to be in default",
                        "ru": "не выполнить финансовое обязательство; допустить просрочку платежа"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "default",
                                "target_lang_sense_clarification": "to fail to fulfill a financial obligation"
                            },
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to be unable to meet financial engagements"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "не выполнить обязательства",
                                "target_lang_sense_clarification": "в финансовом или юридическом контексте"
                            },
                            {
                                "target_lang_word": "допустить дефолт",
                                "target_lang_sense_clarification": "о неспособности выплатить долг"
                            },
                            {
                                "target_lang_word": "оказаться несостоятельным",
                                "target_lang_sense_clarification": "о неспособности платить по счетам"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c28ec84-85e1-3614-84ca-948911843c13",
                    "sense_definition": "meervoud van <w>faal</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten kom je soms de <w>falen</w> van de ridders tegen.",
                            "target_lang_translations": {
                                "en": "In old texts, you sometimes encounter the <w>failings</w> of the knights.",
                                "ru": "В старинных текстах иногда встречаются описания <w>неудач</w> рыцарей."
                            }
                        },
                        {
                            "text": "Zijn vele <w>falen</w> werden hem uiteindelijk fataal in zijn carrière.",
                            "target_lang_translations": {
                                "en": "His many <w>failures</w> eventually proved fatal to his career.",
                                "ru": "Его многочисленные <w>промахи</w> в конечном итоге стали роковыми для его карьеры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammaticale vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of 'faal' (failure/fault)",
                        "ru": "множественное число от слова 'faal' (неудача, промах)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "failings",
                                "target_lang_sense_clarification": "plural of a personal weakness or failure"
                            },
                            {
                                "target_lang_word": "failures",
                                "target_lang_sense_clarification": "plural of an act of failing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неудачи",
                                "target_lang_sense_clarification": "множественное число от 'неудача'"
                            },
                            {
                                "target_lang_word": "промахи",
                                "target_lang_sense_clarification": "ошибки или недостатки в поведении"
                            },
                            {
                                "target_lang_word": "падения",
                                "target_lang_sense_clarification": "в переносном смысле о неудачах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}