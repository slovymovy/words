                    "frequency": "High",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise cherche à <w>développer</w> ses activités commerciales dans plusieurs pays d'Europe."
                        },
                        {
                            "text": "La pratique régulière d'un instrument aide à <w>développer</w> la mémoire et la concentration."
                        }
                    ],
                    "synonyms": [
                        "accroître",
                        "agrandir",
                        "étendre"
                    ],
