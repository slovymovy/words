                        "entry_id": "22d4f3bf-3733-38c9-a400-3c217de7e37e",
                        "glosses": [
                            "Système accrochable destiné aux grimpeurs et grimpeuses qui passent plusieurs jours et nuits sur des grandes voies."
                        ],
                        "tags": [
                            "Escalade"
                        ],
                        "examples": [
                            {
                                "example_id": "7c07514d-a1d2-493a-8fb8-b69e69f1e01d",
                                "sense_id": "3e016576-ad25-31df-b907-d2c0556b400f",
                                "text": "Elles ont notamment dormi dans un portaledge, une plateforme sur laquelle elles mangeaient et dormaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c6cea32-1074-4940-95c2-8c1064fdb217",
                        "source_entry_id": "22d4f3bf-3733-38c9-a400-3c217de7e37e",
                        "source_sense_id": "3e016576-ad25-31df-b907-d2c0556b400f",
                        "target_lang_word": "portaledge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portaledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "619ae322-b198-3bac-9619-bd2c0c1f75f4",
                                        "entry_id": "b4c7a883-a213-3d66-9c88-78bf21fe253f",
                                        "glosses": [
                                            "A portable tent system used by rock climbers to sleep in during a climb lasting multiple days."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c234a8e-d441-4e6d-9984-1e1409552d96",
                                                "sense_id": "619ae322-b198-3bac-9619-bd2c0c1f75f4",
                                                "text": "A ferocious storm kept the two men trapped on a portaledge—an artificial tent platform hung from pitons over the vertical void—for seven days and nights."
                                            },
                                            {
                                                "example_id": "12e07f4f-9850-4f4d-9cba-3d90bbe8187c",
                                                "sense_id": "619ae322-b198-3bac-9619-bd2c0c1f75f4",
                                                "text": "[Warren] Harding, renowned for being tough and hard headed, had climbed the route in the days before portaledges, hanging every night in cramped and claustrophobic hammocks called 'Bat tents' which would fill with water when it rained."
                                            },
                                            {
                                                "example_id": "c0bfc223-42b1-4360-9f14-9dd918f12f47",
                                                "sense_id": "619ae322-b198-3bac-9619-bd2c0c1f75f4",
                                                "text": "Have you ever been shy to go to the bathroom when you're on a date at someone else's house? Well, when you're living on a portaledge, there's no room for such modesty."
                                            },
                                            {
                                                "example_id": "597c0714-e55c-4999-8b82-5321d3d49fe8",
                                                "sense_id": "619ae322-b198-3bac-9619-bd2c0c1f75f4",
                                                "text": "It's your little pod, and on El Capitan specifically, you end up spending a tremendous amount of time in these portaledges, it becomes your home. It's where you cook. It's where you sleep. It's where you eat. It's where you go to the bathroom. Anytime you're not climbing, you're in these portaledges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
