        "fr-extract.jsonl": [
            {
                "entry_id": "d1fb4ab5-ec2f-3996-a01d-a478ea4dcd9e",
                "word": "acclimatement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "39881df6-431b-4dbf-b44b-10dd2f1f7e9b",
                        "entry_id": "d1fb4ab5-ec2f-3996-a01d-a478ea4dcd9e",
                        "tags": [
                            "plural"
