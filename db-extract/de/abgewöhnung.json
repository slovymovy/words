                "senses": [
                    {
                        "sense_id": "9a84b87a-5289-331d-a2b9-371419d5b83a",
                        "entry_id": "ff1bf398-1456-3c57-a9fc-b91729a6a624",
                        "glosses": [
                            "Aufgeben einer (meist schlechten) Gewohnheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca3d59cf-8776-4803-93ab-ca04b4539c91",
                                "sense_id": "9a84b87a-5289-331d-a2b9-371419d5b83a",
                                "text": "Zur Abgewöhnung der schlechten Manieren seines 7-jährigen Sohnes entzog der Vater ihm gelegentlich sein Spielzeug."
                            },
                            {
                                "example_id": "01a73e7a-a19c-4483-862b-381b7872c055",
                                "sense_id": "9a84b87a-5289-331d-a2b9-371419d5b83a",
                                "text": "„Vieles unternahm er zur Abgewöhnung. Er bot mir, zum Beispiel, eine Wette an, eine Woche nicht zu rauchen. Schaffte er es, musste ich einen Kasten Bier und zwei Flaschen Wodka bezahlen, wenn nicht, dann er.“"
                            },
                            {
                                "example_id": "724c5326-b8af-423f-9d4f-4f387756d7d1",
                                "sense_id": "9a84b87a-5289-331d-a2b9-371419d5b83a",
                                "text": "„Pfizer hatte im Februar mitgeteilt, einen Verkauf oder eine Abspaltung des Geschäfts zu erwägen, zu dem so bekannte Marken wie Listerine-Mundwasser und Nicorette zur Abgewöhnung des Rauchens gehören.“"
                            },
                            {
                                "example_id": "de464ce8-3bbf-49db-8440-1a9e5434aed8",
                                "sense_id": "9a84b87a-5289-331d-a2b9-371419d5b83a",
                                "text": "„Er berichtet: ‚Ich weiß, dass in Frankreich eine Kampagne zur Förderung von Nikotinprodukten läuft, um die Abgewöhnung vom Rauchen zu fördern. […]‘“"
                            },
                            {
                                "example_id": "7db15bd1-a1c5-4f3b-b92c-19b2115e3276",
                                "sense_id": "9a84b87a-5289-331d-a2b9-371419d5b83a",
                                "text": "„Der fundamentalistische Vater, der seinen Achtjährigen beim Onanieren erwischt und ihm zur Abgewöhnung eine heftige Ohrfeige gibt, macht sich strafbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
