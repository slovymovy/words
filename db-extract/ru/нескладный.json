                ],
                "senses": [
                    {
                        "sense_id": "3af8623e-575f-3163-a201-1a62f9b0b32b",
                        "entry_id": "5726f029-dc7a-3e3f-b490-d17d4548db12",
                        "glosses": [
                            "ungainly, awkward, gawky, clumsy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "694dbc00-3611-430f-8de6-fc6cbc89a759",
                                "sense_id": "3af8623e-575f-3163-a201-1a62f9b0b32b",
                                "text": "Э́то была́ нескла́дная ба́ба, с таки́м лицо́м, кото́рое как бу́дто чему́-нибудь си́льно удиви́лось когда́-то, да так на всю жизнь и оста́лось с э́тим удивле́нием.",
                                "translation": "She was an ungainly woman with the kind of face that looked as if something had once given her a big surprise – and that was the expression she wore for the rest of her life.",
                                "english": "She was an ungainly woman with the kind of face that looked as if something had once given her a big surprise – and that was the expression she wore for the rest of her life."
                            }
                        ]
