                        "cross_references": [
                            {
                                "target_word": "heliosheath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83668bfa-86e7-39ef-9c97-5309e5db1deb",
                                        "entry_id": "818a08a5-d8f7-3d70-b1a2-304fd40ce6fc",
                                        "glosses": [
                                            "A zone between the termination shock and the heliopause, in the heliosphere, at the outer border of the Solar System, where the solar wind is dramatically slower than within the termination shock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d83798c2-142c-404e-8b5a-18e0dda8ce26",
                                                "sense_id": "83668bfa-86e7-39ef-9c97-5309e5db1deb",
                                                "text": "We encroach deeper into the furthest extent of the heliosheath, which thins out all the time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
