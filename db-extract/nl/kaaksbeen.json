                    {
                        "sense_id": "bdc2d92c-d1c3-35f8-9637-d2955b3bfa48",
                        "entry_id": "dcbd76e7-f185-30b8-bcd0-44d118a62222",
                        "glosses": [
                            "het benige deel van de onderkaak of bovenkaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdcc57fe-db15-4696-9dfe-57ec2a837a48",
                                "sense_id": "bdc2d92c-d1c3-35f8-9637-d2955b3bfa48",
                                "text": "De operatie zal in twee stappen verlopen. Eerst wordt het gezwel weggehaald en daarna zal het kaaksbeen van Liu hersteld worden."
                            },
                            {
                                "example_id": "7552f032-bb6d-430e-a506-f812990298af",
                                "sense_id": "bdc2d92c-d1c3-35f8-9637-d2955b3bfa48",
                                "text": "De slachtoffers werden gedurende goed een half uur met metalen staven en knuppels bewerkt. Ze konden nadien op eigen kracht het kamp bereiken en werden door vrijwilligers naar het hospitaal gebracht waarbij minstens twee vluchtelingen het bewustzijn verloren. Er is sprake van gebroken ribben, schedelfractuur, een gebroken kaaksbeen, een gebroken oogkas en schaafwonden."
                            }
                        ]
                    }
