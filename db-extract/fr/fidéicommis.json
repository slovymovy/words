                                    }
                                ]
                            },
                            {
                                "target_word": "trust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef8e950f-619c-3399-ba4c-1815c43a685c",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To place confidence in, to rely on, to confide in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "462ddcf9-dca7-41aa-ab50-58abde5cd163",
                                                "sense_id": "ef8e950f-619c-3399-ba4c-1815c43a685c",
                                                "text": "He that trusts without reserve will at last be deceived."
                                            },
                                            {
                                                "example_id": "20fe1e12-d691-4337-862c-907bf5381234",
                                                "sense_id": "ef8e950f-619c-3399-ba4c-1815c43a685c",
                                                "text": "We cannot trust anyone who deceives us."
                                            },
                                            {
                                                "example_id": "f8728d49-f87b-4bca-96f7-a98089aadbea",
                                                "sense_id": "ef8e950f-619c-3399-ba4c-1815c43a685c",
                                                "text": "If I live to see it, I will never trust his word after."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077b0276-1fd1-36ae-9bfb-051d4c9291f6",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To have faith in; to rely on for continuing support or aid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34866822-f8c4-4c3d-9168-0681691a7ae4",
                                                "sense_id": "077b0276-1fd1-36ae-9bfb-051d4c9291f6",
                                                "text": "In God We Trust"
                                            },
                                            {
                                                "example_id": "e176e80a-6088-4449-9d69-1453f5e2650b",
                                                "sense_id": "077b0276-1fd1-36ae-9bfb-051d4c9291f6",
                                                "text": "Trust in me, just in me / Shut your eyes and trust in me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed13818d-b70a-389b-b09b-24e58e7699fd",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To give credence to; to believe; to credit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc20d542-91a0-4294-9f38-450ddd375c66",
                                                "sense_id": "ed13818d-b70a-389b-b09b-24e58e7699fd",
                                                "text": "Trust me, you looke well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ac5b8c-ce4d-300a-aec3-269967c3b192",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To hope confidently; to believe (usually with a phrase or infinitive clause as the object)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae1a0c12-568b-424d-9957-6064e242583b",
                                                "sense_id": "c7ac5b8c-ce4d-300a-aec3-269967c3b192",
                                                "text": "I trust you have cleaned your room?"
                                            },
                                            {
                                                "example_id": "b05ed2ff-503b-4b2f-945c-ad54dc9f2a67",
                                                "sense_id": "c7ac5b8c-ce4d-300a-aec3-269967c3b192",
                                                "text": "I trust to come unto you, and speak face to face."
                                            },
                                            {
                                                "example_id": "c12bdea5-7748-49d7-9e92-7e1d90f0bfaa",
                                                "sense_id": "c7ac5b8c-ce4d-300a-aec3-269967c3b192",
                                                "text": "We trust we have a good conscience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10d9209a-6bff-3545-b821-69b40dd3a84a",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "to show confidence in a person by entrusting them with something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42c29d84-5852-4b18-a9ac-1901f2ff4639",
                                                "sense_id": "10d9209a-6bff-3545-b821-69b40dd3a84a",
                                                "text": "Whom, with your power and fortune, sir, you trust, Now to suspect is vain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05f0683b-0cbe-39a1-89ea-e49800a2612b",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To commit, as to one's care; to entrust."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3c7511-d98c-4fa1-babc-b0a16b5fb59e",
                                                "sense_id": "05f0683b-0cbe-39a1-89ea-e49800a2612b",
                                                "text": "Merchants were not willing to trust precious cargoes to any custody but that of a man-of-war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38dd2c4c-2cdc-3c76-b8d9-32f7b14af41e",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To give credit to; to sell to upon credit, or in confidence of future payment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4117ea83-9d8b-4ccb-bdf5-af1aa349b2e7",
                                                "sense_id": "38dd2c4c-2cdc-3c76-b8d9-32f7b14af41e",
                                                "text": "Merchants and manufacturers trust their customers annually with goods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b281006-f722-3ecb-bcf0-853b74ac10ab",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To rely on (something), as though having trust (on it)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2a130a9-8db1-46ed-8b3d-819bffc3832d",
                                                "sense_id": "0b281006-f722-3ecb-bcf0-853b74ac10ab",
                                                "text": "to trust to luck"
                                            },
                                            {
                                                "example_id": "8e8e0129-5203-42b3-848d-9d626c320a3d",
                                                "sense_id": "0b281006-f722-3ecb-bcf0-853b74ac10ab",
                                                "text": "Having lost the book, he had to trust to his memory for further details."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9af1935d-cc01-3caa-9af3-ff1c7a73542f",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To risk; to venture confidently."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3394e5b9-b567-441a-a1fe-2c0d481d3b9c",
                                                "sense_id": "9af1935d-cc01-3caa-9af3-ff1c7a73542f",
                                                "text": "[Beguiled] by thee to trust thee from my side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643c0ce7-a001-3f2d-a3e4-2f080fa2cf5c",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To have trust; to be credulous; to be won to confidence; to confide."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9189d6ca-bd96-4705-9bf7-47a2272ce5ec",
                                                "sense_id": "643c0ce7-a001-3f2d-a3e4-2f080fa2cf5c",
                                                "text": "More ſhould I queſtion thee, and more I muſt, / Though more to know, could not be more to truſt: […]"
                                            },
                                            {
                                                "example_id": "258718d7-9386-4a55-8461-271fcae1fec7",
                                                "sense_id": "643c0ce7-a001-3f2d-a3e4-2f080fa2cf5c",
                                                "text": "I will trust and not be afraid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3805d95b-c378-3c21-917b-ff0ad54a0d21",
                                        "entry_id": "e2b69efd-c617-3e81-9538-aeb4621e987b",
                                        "glosses": [
                                            "To sell or deliver anything in reliance upon a promise of payment; to give credit."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
