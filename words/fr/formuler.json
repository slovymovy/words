                        "formuler une hypothèse",
                        "formuler des vœux",
                        "formuler des critiques"
                    ]
                },
                {
                    "sense_id": "8897932f-4c4c-3cdb-aeef-dcb120095331",
                    "sense_definition": "Rédiger un acte juridique, une prescription médicale ou une règle selon les formes établies.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "formalisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire doit <w>formuler</w> cet acte officiel dans le respect strict de la législation."
                        },
                        {
                            "text": "Le médecin a soigneusement <w>formulé</w> l'ordonnance pour éviter toute confusion à la pharmacie."
                        }
                    ],
                    "synonyms": [
                        "rédiger",
                        "stipuler"
                    ],
                    "common_phrases": [
