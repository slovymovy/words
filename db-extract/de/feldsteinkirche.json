                ],
                "senses": [
                    {
                        "sense_id": "2644d6fc-77fe-37f4-9160-2c585aeb2de3",
                        "entry_id": "e8e4de8e-3b84-3b7c-9f46-0390370bde55",
                        "glosses": [
                            "eine Kirche, die aus Feldsteinen (vor Ort vorgefundenen oder vorhandenen, unbehauenen Steinen) erbaut worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4be882-2e06-4bbf-940f-c604ba9fd675",
                                "sense_id": "2644d6fc-77fe-37f4-9160-2c585aeb2de3",
                                "text": "In der Ortsmitte steht die romanische Feldsteinkirche aus dem 13. Jahrhundert."
                            },
                            {
                                "example_id": "98e1827b-d675-4c43-b847-f6d1a0feafca",
                                "sense_id": "2644d6fc-77fe-37f4-9160-2c585aeb2de3",
                                "text": "„Am westlichen Rande der Platte liegt hinter einer schützenden Düne (Landesamt für Geologie, Bergbau und Rohstoffe, Cottbus 2006) und etwa 20 m über dem Storkower See die spätromanische Feldsteinkirche St. Thomas.“"
                            },
                            {
                                "example_id": "4575d890-becc-43c9-9257-5f43f19d1c4a",
                                "sense_id": "2644d6fc-77fe-37f4-9160-2c585aeb2de3",
                                "text": "„Feldsteinkirchen sind aus Findlingen erbaute Kirchen.“"
                            },
                            {
                                "example_id": "08687b17-a799-464f-b158-de85520f882e",
                                "sense_id": "2644d6fc-77fe-37f4-9160-2c585aeb2de3",
                                "text": "„Dieser Ecke schräg gegenüber, unmittelbar hinter dem Pfarrhause, steigt der Kirchhof lehnan, auf ihm, so ziemlich in seiner Mitte, die frühmittelalterliche Feldsteinkirche mit einem aus dem vorigen Jahrhundert stammenden Dachreiter und einem zur Seite des alten Rundbogenportals angebrachten Holzarm, dran eine Glocke hängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
