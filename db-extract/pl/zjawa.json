                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a9348b5-ee11-4129-b46c-fcfdfbda7b95",
                        "source_entry_id": "d813a38d-034b-3011-adba-d65550d71032",
                        "source_sense_id": "295ef951-aa94-3423-a415-fe35e289ddd8",
                        "target_lang_word": "banshee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banshee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "025fa516-02aa-3590-be9e-f8aa7a0c309b",
                                        "entry_id": "1cf344e4-2fb0-3462-a6f5-4aa911748c3a",
                                        "glosses": [
                                            "A female spirit, usually taking the form of a woman whose mournful wailing warns of an impending death."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "837f3361-36b9-4c64-a137-d478223761e4",
                                                "sense_id": "025fa516-02aa-3590-be9e-f8aa7a0c309b",
                                                "text": "Late had he heard, in prophet's dream, / The fatal Ben-Shie's boding scream […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db4a03c-53dd-3564-9fa1-95a4384b2534",
                                        "entry_id": "1cf344e4-2fb0-3462-a6f5-4aa911748c3a",
                                        "glosses": [
                                            "A noisy or ill-tempered woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "beef0ff3-f4e1-4f89-af5f-b29ef906a65e",
                                                "sense_id": "6db4a03c-53dd-3564-9fa1-95a4384b2534",
                                                "text": "Where's this old banshee that runs the place?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c9c92bd-f989-4dc6-bba6-3a1521092961",
                        "source_entry_id": "d813a38d-034b-3011-adba-d65550d71032",
                        "source_sense_id": "295ef951-aa94-3423-a415-fe35e289ddd8",
                        "target_lang_word": "spectre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spectre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d96c8f53-507c-3301-9642-5542cea4d1e8",
                                        "entry_id": "6746f677-f698-3859-aef7-2377b9856eae",
                                        "glosses": [
                                            "British standard spelling of specter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3691fd6-7d1d-4ca8-9ab5-960ce9b14fce",
                                                "sense_id": "d96c8f53-507c-3301-9642-5542cea4d1e8",
                                                "text": "To this extenuated spectre, perhaps, a crumb is not thrown once a year; but when ahungered and athirst to famine—when all humanity has forgotten the dying tenant of a decaying house—Divine Mercy remembers the mourner, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5490d21c-1f8a-414e-afe0-4fb92e19955f",
                        "source_entry_id": "d813a38d-034b-3011-adba-d65550d71032",
                        "source_sense_id": "295ef951-aa94-3423-a415-fe35e289ddd8",
                        "target_lang_word": "apparition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8043522e-60b2-3759-832f-272b73b360d9",
                                        "entry_id": "2f8e4ed2-9a67-3260-aa80-c879a8377c71",
                                        "glosses": [
                                            "An act of becoming visible; appearance; visibility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de3ac45b-51b6-47d6-a8a4-e221e4cf2828",
                                                "sense_id": "8043522e-60b2-3759-832f-272b73b360d9",
                                                "text": "the sudden apparition of the Spaniards"
                                            },
                                            {
                                                "example_id": "c91112a4-5336-4dbb-9b1d-9e3f90db74c2",
                                                "sense_id": "8043522e-60b2-3759-832f-272b73b360d9",
                                                "text": "The apparition of Lawyer Clippurse occasioned much speculation in that portion of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff8d21f7-819e-3119-b283-cff38236148f",
                                        "entry_id": "2f8e4ed2-9a67-3260-aa80-c879a8377c71",
                                        "glosses": [
                                            "The thing appearing; a visible object; a form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df9250ee-083f-4607-8635-7d53d23f2d86",
                                                "sense_id": "ff8d21f7-819e-3119-b283-cff38236148f",
                                                "text": "[…] which apparition, it seems, was you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57d2d9ee-3c54-3142-87fb-f1abf5914c89",
                                        "entry_id": "2f8e4ed2-9a67-3260-aa80-c879a8377c71",
                                        "glosses": [
                                            "An unexpected, wonderful, or preternatural appearance; especially, one by a ghost, phantom, or suchlike; the entity itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61cc2395-ae96-4ae3-b9e4-e4ca69bba86f",
                                                "sense_id": "57d2d9ee-3c54-3142-87fb-f1abf5914c89",
                                                "text": "The region's economy is buoyed by tourism driven by past apparitions of the Virgin Mary."
                                            },
                                            {
                                                "example_id": "49f54ded-3817-4689-b364-2321c9e74e0f",
                                                "sense_id": "57d2d9ee-3c54-3142-87fb-f1abf5914c89",
                                                "text": "The attic is said to be haunted by the ghostly apparition of a young girl who died there."
                                            },
                                            {
                                                "example_id": "371954df-261c-448c-afbb-cee1c3723089",
                                                "sense_id": "57d2d9ee-3c54-3142-87fb-f1abf5914c89",
                                                "text": "He spoke to the apparition, and although its lips did not move, he somehow heard its reply."
                                            },
                                            {
                                                "example_id": "2f24f0c5-6cd1-4332-96b5-8095ca275209",
                                                "sense_id": "57d2d9ee-3c54-3142-87fb-f1abf5914c89",
                                                "text": "I think it is the weakness of mine eyes / That shapes this monstrous apparition."
                                            },
                                            {
                                                "example_id": "f5b8f359-a821-4e67-96b5-bc92a6901317",
                                                "sense_id": "57d2d9ee-3c54-3142-87fb-f1abf5914c89",
                                                "text": "The heavenly bands […] a glorious apparition."
                                            },
                                            {
                                                "example_id": "667d9c31-6275-4b30-9589-e01c2208d896",
                                                "sense_id": "57d2d9ee-3c54-3142-87fb-f1abf5914c89",
                                                "text": "The apparition wobbled in front of Arthur's eyes, though the truth of the matter is probably that Arthur's eyes were wobbling in front of the apparition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "151b6f4e-be8f-375c-b9fa-8f3285e33c44",
                                        "entry_id": "2f8e4ed2-9a67-3260-aa80-c879a8377c71",
                                        "glosses": [
                                            "The first appearance of a star or other luminary after having been invisible or obscured; opposed to occultation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3a8d2e9-f3c1-39c4-9258-6632278d73c4",
                                        "entry_id": "2f8e4ed2-9a67-3260-aa80-c879a8377c71",
                                        "glosses": [
                                            "A period of consecutive days or nights when a particular celestial body may be observed, beginning with the heliacal rising of the body and ending with its heliacal setting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f803621-8380-48af-ab72-101a4cef880d",
                        "source_entry_id": "d813a38d-034b-3011-adba-d65550d71032",
                        "source_sense_id": "295ef951-aa94-3423-a415-fe35e289ddd8",
                        "target_lang_word": "Gespenst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gespenst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df494762-3963-3425-a966-dcbce5719836",
                                        "entry_id": "ece0ef8c-9ed4-3901-84f7-a189e03bf3a5",
                                        "glosses": [
                                            "Geist; ein meist Furcht einflößendes, übernatürliches Wesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c48572f-ea57-40ee-93af-e089c285f1ff",
                                                "sense_id": "df494762-3963-3425-a966-dcbce5719836",
                                                "text": "In der alten Villa haust ein Gespenst."
                                            },
                                            {
                                                "example_id": "caaca9c7-838c-41a1-bd8b-c5708080bbb3",
                                                "sense_id": "df494762-3963-3425-a966-dcbce5719836",
                                                "text": "„Meine Bediensteten erschienen einen Augenblick darauf; auch sie hatten von den Gespenstern gehört und wollten mich überreden, die Nacht auf dem Pachtgut zu verbringen.“"
                                            },
                                            {
                                                "example_id": "71564a5b-0573-4eca-9843-37bc43a3d04e",
                                                "sense_id": "df494762-3963-3425-a966-dcbce5719836",
                                                "text": "„Er stützte sich mit beiden Händen auf den Holztisch und starrte das Gespenst an, das vorgab, sein Vater zu sein.“"
                                            },
                                            {
                                                "example_id": "d6848e93-aea8-467c-83e2-eb942ef6e59f",
                                                "sense_id": "df494762-3963-3425-a966-dcbce5719836",
                                                "text": "„Auf einsamen Farmen des westlichen Virginien, wo die Wasser der beiden Kanawha und des Monongahela zum milderen Klima der Ohiolandschaften niederströmen, zeigt sich noch heutigentags bisweilen ein Gespenst.“"
                                            },
                                            {
                                                "example_id": "3379b2ab-f515-4aa2-a09c-2cb435ef6240",
                                                "sense_id": "df494762-3963-3425-a966-dcbce5719836",
                                                "text": "„Man sollte es nicht glauben, aber er fürchtet sich dann vor Gespenstern, und der Kanarienvogel, den er in einem Papageienkäfig über seiner Hobelbank hängen hat, ist um diese Zeit nicht genug Gesellschaft für ihn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "acf822a6-d43e-3540-9db7-72ce6d4cf496",
                                        "entry_id": "ece0ef8c-9ed4-3901-84f7-a189e03bf3a5",
                                        "glosses": [
                                            "etwas Gewaltiges und Unheimliches, das schwer zu fassen ist und doch beherrschend im Raum steht oder untrennbar mit einer Sache verbunden ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8702763d-f32f-4b41-bae9-cfe32e26390a",
                                                "sense_id": "acf822a6-d43e-3540-9db7-72ce6d4cf496",
                                                "text": "„Ein Gespenst geht um in Europa – das Gespenst des Kommunismus.“"
                                            },
                                            {
                                                "example_id": "fbe3e999-52db-4bdc-9905-3d76d5dba015",
                                                "sense_id": "acf822a6-d43e-3540-9db7-72ce6d4cf496",
                                                "text": "„Die 15 Jahre alte Agenda-Politik steht im Ruf, ein wesentlicher Faktor für die Stabilität der deutschen Wirtschaft gewesen zu sein. Trotzdem quält sie die Sozialdemokraten wie ein Gespenst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7550fbb3-e334-4e77-8fbd-5a128fb8d0dc",
                        "source_entry_id": "d813a38d-034b-3011-adba-d65550d71032",
                        "source_sense_id": "295ef951-aa94-3423-a415-fe35e289ddd8",
                        "target_lang_word": "призрак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "призрак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ef8d3255-a74b-35e1-9d96-c72268cb7086",
                                        "entry_id": "1f7c3413-7e74-3ab0-8164-b273684c0f4c",
                                        "glosses": [
                                            "то, что видится, мерещится, кажется; видение, плод воображения; привидение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c329573-132c-406c-8b34-6f0454f8c806",
                                                "sense_id": "ef8d3255-a74b-35e1-9d96-c72268cb7086",
                                                "text": "Людей тянуло туда, к круглой конусовидной горе, где им мерещились сине-зелёные призраки горных духов, плясавшие вокруг зеленоватого светящегося облака."
                                            },
                                            {
                                                "example_id": "e56cf6e2-92c7-4d7c-9c67-c7ce3e10b257",
                                                "sense_id": "ef8d3255-a74b-35e1-9d96-c72268cb7086",
                                                "text": "Затем немцы собрались в кучку, поговорили, посмеялись, — очевидно, над теми тремя, которым померещились эти зелёные призраки, — покурили и ушли."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9999f341-0663-33d5-8ce3-07753569217b",
                                        "entry_id": "1f7c3413-7e74-3ab0-8164-b273684c0f4c",
                                        "glosses": [
                                            "образ кого-либо, чего-либо, представляющийся в воображении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6949089f-0e01-4098-88c3-a799b93f288d",
                                                "sense_id": "9999f341-0663-33d5-8ce3-07753569217b",
                                                "text": "Но, думается, ближе всех к истине стоял Владимир Набоков, эмигрант поневоле: «Одни бьются за призрак прошлого, другие за призрак будущего»."
                                            },
                                            {
