                                "example_id": "b6f29777-df63-468e-ba4b-6b01aa62fbd4",
                                "sense_id": "3679c5d7-35b1-358b-9332-87ccaba0de57",
                                "text": "In het Nederlands wordt de infinitief gebruikt om een handeling of actie zonder tijd of persoon aan te duiden.",
                                "translation": "In Dutch, the infinitive is used to indicate an action or activity without specifying a time or person.",
                                "english": "In Dutch, the infinitive is used to indicate an action or activity without specifying a time or person."
                            },
                            {
                                "example_id": "458dbaa4-1f2b-408f-a8bf-e63e5af3418c",
                                "sense_id": "3679c5d7-35b1-358b-9332-87ccaba0de57",
                                "text": "Het werkwoord \"lopen\" staat in de infinitief.",
                                "translation": "The verb \"lopen\" (to walk) is in the infinitive.",
                                "english": "The verb \"lopen\" (to walk) is in the infinitive."
                            },
                            {
                                "example_id": "27e9acd5-5b51-44e8-a4c2-9c03b083eac5",
                                "sense_id": "3679c5d7-35b1-358b-9332-87ccaba0de57",
                                "text": "De infinitief wordt vaak gebruikt om instructies of opdrachten te geven.",
                                "translation": "The infinitive is often used to give instructions or commands.",
                                "english": "The infinitive is often used to give instructions or commands."
                            },
                            {
                                "example_id": "80e6bde4-f855-42ac-b5d5-0101c946b45f",
                                "sense_id": "3679c5d7-35b1-358b-9332-87ccaba0de57",
                                "text": "\"Eten\" is de infinitief van het werkwoord \"eten\".",
                                "translation": "\"Eten\" (to eat) is the infinitive of the verb \"eten\".",
                                "english": "\"Eten\" (to eat) is the infinitive of the verb \"eten\"."
                            }
                        ]
                    }
