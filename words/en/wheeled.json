{
    "word_family": [
        "wheel",
        "wheelchair",
        "wheelhouse",
        "wheelie",
        "wheeler",
        "wheelwork"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cebd87bd-5b54-3daf-83d6-5e3e0ccb1c7b",
                    "sense_definition": "Having wheels or mounted on wheels.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "wheel_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wheeled</w> suitcase made it much easier to carry my heavy clothes.",
                            "target_lang_translations": {
                                "ru": "<w>Колёсный</w> чемодан значительно облегчил переноску моих тяжёлых вещей."
                            }
                        },
                        {
                            "text": "We used a <w>wheeled</w> cart to move the boxes into the new office.",
                            "target_lang_translations": {
                                "ru": "Мы использовали <w>колёсную</w> тележку, чтобы перевезти коробки в новый офис."
                            }
                        }
                    ],
                    "synonyms": [
                        "mobile"
                    ],
                    "common_phrases": [
                        "wheeled vehicle",
                        "wheeled cart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий колёса или установленный на колёса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колёсный",
                                "target_lang_sense_clarification": "имеющий колёса или передвигающийся на них"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d666b3d7-5dcc-3dc0-8b91-c8612b1465a2",
                    "sense_definition": "Having a specific number or type of wheels.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wheel_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a new three-<w>wheeled</w> bicycle for his young daughter.",
                            "target_lang_translations": {
                                "ru": "Он купил новый <w>трёхколёсный</w> велосипед для своей маленькой дочери."
                            }
                        },
                        {
                            "text": "The antique wagon had large iron-<w>wheeled</w> axles that creaked loudly.",
                            "target_lang_translations": {
                                "ru": "У старинной повозки были большие оси с железными <w>колёсами</w>, которые громко скрипели."
                            }
                        }
                    ],
                    "common_phrases": [
                        "four-wheeled",
                        "two-wheeled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определённое количество или тип колёс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "-колёсный",
                                "target_lang_sense_clarification": "используется в составе сложных прилагательных для обозначения количества колёс"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3accf566-d06a-3d6f-88bc-ad4568b72237",
                    "sense_definition": "Simple past and past participle of <w>wheel</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse <w>wheeled</w> the patient into the operating room quickly.",
                            "target_lang_translations": {
                                "ru": "Медсестра быстро <w>вкатила</w> пациента в операционную."
                            }
                        },
                        {
                            "text": "She <w>wheeled</w> her bicycle through the park after the tire went flat.",
                            "target_lang_translations": {
                                "ru": "Она <w>катила</w> свой велосипед через парк после того, как спустило шину."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие от глагола «катить» или «везти на колёсах»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вёз на колёсах",
                                "target_lang_sense_clarification": "перемещал что-либо на транспортном средстве или устройстве с колёсами"
                            },
                            {
                                "target_lang_word": "катил",
                                "target_lang_sense_clarification": "перемещал предмет, катя его перед собой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}