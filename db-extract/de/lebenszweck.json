                "senses": [
                    {
                        "sense_id": "d4aadf09-0ada-3a5e-96b7-68d0a31dcf82",
                        "entry_id": "1afbae13-ee04-34ca-903c-13d8f162020c",
                        "glosses": [
                            "Sinn des Daseins, Ziel oder Nutzen des ganzen Lebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0818307-69d5-47ee-8b78-7d3808eaeed5",
                                "sense_id": "d4aadf09-0ada-3a5e-96b7-68d0a31dcf82",
                                "text": "„Der Lebenszweck des Schweins war schon immer sein Verzehr, nicht weniger, aber auch nicht mehr.“"
                            },
                            {
                                "example_id": "e34b1a59-cde7-49eb-938c-a28b2d1d9229",
                                "sense_id": "d4aadf09-0ada-3a5e-96b7-68d0a31dcf82",
                                "text": "„Sie hat keine Sehnsüchte, keine Träume, sie geht auf in der Fürsorge für das Kind. Früher galt dies als Lebenszweck jeder Frau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
