    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "764c00ad-a309-35f9-ab75-adcb49d9b216",
                    "sense_definition": "Iets nieuws doen ontstaan of maken, vaak vanuit het niets of als resultaat van creativiteit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar wilde een uniek kunstwerk <w>scheppen</w> voor de nieuwe tentoonstelling.",
                            "target_lang_translations": {
                                "en": "The artist wanted to <w>create</w> a unique work of art for the new exhibition."
                            }
                        },
                        {
                            "text": "Met deze nieuwe maatregelen wil de overheid meer duidelijkheid <w>scheppen</w> voor alle burgers.",
                            "target_lang_translations": {
                                "en": "With these new measures, the government wants to <w>establish</w> more clarity for all citizens."
                            }
                        }
                    ],
                    "synonyms": [
                        "creëren"
                    ],
                    "antonyms": [
                        "vernietigen"
                    ],
                    "common_phrases": [
                        "duidelijkheid scheppen",
                        "orde scheppen",
                        "ruimte scheppen",
                        "verwachtingen scheppen"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring something new into existence or make it, often from nothing or as a result of creativity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "create",
                                "target_lang_sense_clarification": "to bring into existence"
                            },
                            {
                                "target_lang_word": "establish",
                                "target_lang_sense_clarification": "to set up or create a situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3e61214-f3e8-3bd9-8fc2-22ea18010ca0",
                    "sense_definition": "Met een voorwerp zoals een lepel of schep een hoeveelheid materiaal ergens uit of in halen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verplaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kok begon voorzichtig de hete soep in de kommen te <w>scheppen</w>.",
                            "target_lang_translations": {
                                "en": "The chef carefully began to <w>ladle</w> the hot soup into the bowls."
                            }
                        },
                        {
                            "text": "Het kind bleef maar zand <w>scheppen</w> in haar kleine blauwe emmertje.",
                            "target_lang_translations": {
                                "en": "The child kept <w>scooping</w> sand into her little blue bucket."
                            }
                        }
                    ],
                    "synonyms": [
                        "oplepelen",
                        "oprapen"
                    ],
                    "common_phrases": [
                        "soep scheppen",
                        "zand scheppen",
                        "water scheppen"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove or move a quantity of material from or into something using an object like a spoon or shovel."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scoop",
                                "target_lang_sense_clarification": "to move with a scoop or ladle"
                            },
                            {
                                "target_lang_word": "ladle",
                                "target_lang_sense_clarification": "to serve liquid with a large spoon"
                            },
                            {
                                "target_lang_word": "shovel",
                                "target_lang_sense_clarification": "to move material with a spade"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e3dcb67-733e-35c5-8064-007e9541cfe7",
                    "sense_definition": "Bij een aanrijding door een voertuig geraakt worden en daardoor omhoog of op de motorkap geworpen worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ongeluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fietser werd door een auto <w>geschept</w> toen hij plotseling de weg overstak.",
                            "target_lang_translations": {
                                "en": "The cyclist was <w>hit</w> by a car when he suddenly crossed the road."
                            }
                        },
                        {
                            "text": "Het is een wonder dat de voetganger niet gewond raakte nadat hij werd <w>geschept</w>.",
                            "target_lang_translations": {
                                "en": "It is a miracle that the pedestrian was not injured after being <w>struck</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "oprapen"
                    ],
                    "common_phrases": [
                        "door een auto geschept"
                    ],
                    "target_lang_definitions": {
                        "en": "To be hit by a vehicle in a collision and consequently be thrown up or onto the hood."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hit",
                                "target_lang_sense_clarification": "to be struck by a vehicle"
                            },
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "to be hit with force"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "38f469a4-56e5-3c91-a5bd-f30d24dcd505",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>schep</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arbeiders gebruikten hun <w>scheppen</w> om een diepe geul in de tuin te graven.",
                            "target_lang_translations": {
                                "en": "The workers used their <w>shovels</w> to dig a deep trench in the garden."
                            }
                        },
                        {
                            "text": "Er liggen twee grote <w>scheppen</w> in de schuur die we kunnen gebruiken voor het zand.",
                            "target_lang_translations": {
                                "en": "There are two large <w>scoops</w> in the shed that we can use for the sand."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of schep"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'shovel' or 'scoop'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shovels",
                                "target_lang_sense_clarification": "plural of the digging tool"
                            },
                            {
                                "target_lang_word": "scoops",
                                "target_lang_sense_clarification": "plural of the bowl-shaped tool"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}