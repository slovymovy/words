                                        "glosses": [
                                            "A boat used for recreational activities, such as sport fishing or touring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1bd4265-2ef0-4755-b894-dc74bbb0b70f",
                                                "sense_id": "d8587acb-a2d4-3fb5-947c-99b1c6e98732",
                                                "text": "Steaming up the Adriatic aboard ex-King Farouk's former pleasure boat (now renamed Freedom), Egypt's President Gamal Abdel Nasser arrived last week at the beautiful Yugoslav seaport of Dubrovnik."
                                            }
                                        ]
                                    }
                                ]
