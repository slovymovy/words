    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01d5a20d-d653-39d6-9b9c-9d06da1a7400",
                    "sense_definition": "Établissement fermé où sont incarcérées les personnes condamnées à une peine privative de liberté ou en détention provisoire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect a été transféré dans une <w>prison</w> de haute sécurité."
                        },
                        {
                            "text": "Après dix ans d'enfermement, il va enfin sortir de <w>prison</w>."
                        }
                    ],
                    "synonyms": [
                        "geôle",
                        "pénitencier"
                    ],
                    "common_phrases": [
                        "gardien de prison",
                        "sortir de prison",
                        "aller en prison"
                    ]
                },
                {
                    "sense_id": "42d5eca4-1edd-3fef-b7bb-965aefeceb1e",
                    "sense_definition": "Peine judiciaire consistant en une privation de liberté dans un établissement pénitentiaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge l'a condamné à deux ans de <w>prison</w> ferme."
                        },
                        {
                            "text": "Il risque une peine de <w>prison</w> pour avoir commis ce vol."
                        }
                    ],
                    "synonyms": [
                        "emprisonnement"
                    ],
                    "common_phrases": [
                        "peine de prison",
                        "ans de prison",
                        "mois de prison"
                    ]
                },
                {
                    "sense_id": "217b5842-f4cd-3978-a8d5-7a9783c602a4",
                    "sense_definition": "Chose concrète ou abstraite qui retient, enferme ou empêche le libre mouvement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le papillon a brisé sa <w>prison</w> de soie pour s'envoler."
                        },
                        {
                            "text": "Elle se sentait piégée dans la <w>prison</w> de ses propres angoisses."
                        }
                    ]
                },
                {
                    "sense_id": "5f6ef1e9-5032-3ac2-810f-f2707fcf8c02",
                    "sense_definition": "Lieu sombre, austère et oppressant où l'on éprouve un profond sentiment d'enfermement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette bâtisse immense et grise ressemblait à une véritable <w>prison</w>."
                        },
                        {
                            "text": "Privé de lumière et de visites, son appartement était devenu une <w>prison</w>."
                        }
                    ]
                }
            ]
        }
    ]
