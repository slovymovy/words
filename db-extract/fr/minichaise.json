                        "glosses": [
                            "Toute petite chaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4658623e-434f-48a0-811c-8bb1d7c3c257",
                                "sense_id": "7cabeea5-3cd1-35cd-9872-024d61a8187b",
                                "text": "Ce matin, je m’assois dans le fond du local (sur une minichaise vert lime), car c’est la routine des jeux libres avant la collation du matin."
                            },
                            {
                                "example_id": "bd137c6d-994a-4c3b-a1d5-5758faaed951",
                                "sense_id": "7cabeea5-3cd1-35cd-9872-024d61a8187b",
                                "text": "Simone pointe les deux minichaises devant elle, puis elle s’installe sur une autre de l’autre côté de la petite table."
                            },
                            {
                                "example_id": "2b1318b9-0869-4382-b9a5-a08c72a882b9",
                                "sense_id": "7cabeea5-3cd1-35cd-9872-024d61a8187b",
                                "text": "Il se dirigea vers la maison de poupées, alluma sa lampe de poche et vit un coffre miniature dans un coin du salon, à côté des minichaises."
                            },
                            {
                                "example_id": "1d7e8613-f82e-4e9f-b94b-81d3c4e723de",
                                "sense_id": "7cabeea5-3cd1-35cd-9872-024d61a8187b",
                                "text": "Maman nous ramenait de chez Ikea où nous avions acheté une minitable et deux minichaises pour les mettre sur le minibalcon-jungle."
                            }
                        ]
                    }
