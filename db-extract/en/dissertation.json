                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                "text": "complete a dissertation"
                            },
                            {
                                "example_id": "8c46466e-da11-4d90-9a9b-a5da9bb3bd77",
                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                "text": "She spent three years writing her doctoral dissertation."
                            },
                            {
                                "example_id": "8c44a605-38ac-44fb-867b-cf1d15a8fe34",
                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                "text": "The student defended his dissertation successfully."
                            },
                            {
                                "example_id": "3ee7a600-3cc0-4495-9faa-934486d6a6b5",
                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                "text": "Her dissertation focused on medieval literature."
                            }
                        ]
