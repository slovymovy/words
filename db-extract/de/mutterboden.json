                                        "entry_id": "17255fe0-f833-348c-85c4-99078ed54767",
                                        "glosses": [
                                            "To remove the topsoil from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c03ab6fe-62f6-4fff-a675-592812dc69c1",
                        "source_entry_id": "243eecb3-9ec1-393a-82b9-89c12ce042b4",
                        "source_sense_id": "77abf440-fd7d-3845-9831-14cb0bedc57a",
                        "source_sense_description": "die im Gegensatz zum toten Untergrund von Bakterien belebte, humusreiche fruchtbare Ackerkrume",
                        "target_lang_word": "terreau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terreau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e58a4c4c-53ec-3531-99bd-26274982ce53",
                                        "entry_id": "42b2b08c-92d3-38ff-984e-302f7e25fbcb",
                                        "glosses": [
                                            "Support, substrat, majoritairement composé de débris végétaux, destiné à la culture des plantes en pot."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c196c201-1023-45c0-b88b-309b57b00c40",
                                                "sense_id": "e58a4c4c-53ec-3531-99bd-26274982ce53",
                                                "text": "Couche de terreau pour des melons, pour des fleurs."
                                            },
                                            {
                                                "example_id": "1a53b1bd-d11d-4a20-9460-7033c2cca5b5",
                                                "sense_id": "e58a4c4c-53ec-3531-99bd-26274982ce53",
                                                "text": "Le terreau que l’on trouve dans le commerce contient beaucoup de tourbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02aea4b9-ded5-36db-ad6e-a6161a9d3d4b",
                                        "entry_id": "42b2b08c-92d3-38ff-984e-302f7e25fbcb",
                                        "glosses": [
                                            "Amendement organique, mélange plus ou moins riche en humus, de produits de décomposition (compost, fumier)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c64552bb-290d-434e-8ae0-96542ec1b8b8",
                                                "sense_id": "02aea4b9-ded5-36db-ad6e-a6161a9d3d4b",
                                                "text": "Je vais chercher du terreau pour mon jardin."
                                            },
                                            {
                                                "example_id": "1751e55a-e9bc-4752-9cc8-8bae482cd01a",
                                                "sense_id": "02aea4b9-ded5-36db-ad6e-a6161a9d3d4b",
                                                "text": "Dire qu’on en arrivait là ! Économiser un morceau de vieux journal, et se chauffer avec ce qu’on jetait autrefois au pourrissoir pour en faire du terreau."
                                            },
                                            {
                                                "example_id": "a4226772-4fac-4ff5-bad3-26964213bd16",
                                                "sense_id": "02aea4b9-ded5-36db-ad6e-a6161a9d3d4b",
                                                "text": "Il faut mettre du terreau au pied de ces arbres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49b55b61-81fe-3c3b-9bc9-5a5d437b0486",
                                        "entry_id": "42b2b08c-92d3-38ff-984e-302f7e25fbcb",
                                        "glosses": [
                                            "Terre fertile."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "333552c3-33ff-4645-b5d0-20fa1c905243",
                                                "sense_id": "49b55b61-81fe-3c3b-9bc9-5a5d437b0486",
                                                "text": "Le pré dégageait une odeur de terreau humide, une marouette sifflait dans les roseaux au sud. Son chant sonnait comme des gouttes d'eau qui tombaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a0649e-5110-3c74-b340-a00fd94af9ca",
                                        "entry_id": "42b2b08c-92d3-38ff-984e-302f7e25fbcb",
                                        "glosses": [
                                            "Terrain propice, fertile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f2b3090-fe63-4230-9b80-3cc1ecf1906d",
                                                "sense_id": "91a0649e-5110-3c74-b340-a00fd94af9ca",
                                                "text": "Je poussais, herbe folle, sur le terreau de la catholicité, mes racines en pompaient les sucs et j’en faisais ma sève."
                                            },
                                            {
                                                "example_id": "96b42ac9-5adf-470a-aecf-ae4dbf513690",
                                                "sense_id": "91a0649e-5110-3c74-b340-a00fd94af9ca",
                                                "text": "Pourquoi ici plus que dans n’importe quel autre endroit, ai-je senti l’odeur vénéneuse de l’Occupation, ce terreau d’où je suis issu ?"
                                            },
                                            {
                                                "example_id": "2b49e148-65a5-4f95-bdc4-6a89706d4f2e",
                                                "sense_id": "91a0649e-5110-3c74-b340-a00fd94af9ca",
                                                "text": "Ces ignorances furent le terreau sur lequel s’épanouirent l’influence puis l’emprise que le bolchevisme gagna sur les nouveaux partis communistes, par le truchement de la IIIᵉ Internationale."
                                            },
                                            {
                                                "example_id": "68d4c801-16fc-4c85-8461-164f8e290b05",
                                                "sense_id": "91a0649e-5110-3c74-b340-a00fd94af9ca",
                                                "text": "Or, le principal terreau de la haine ne sera jamais rien d’autre que la misère."
                                            },
                                            {
                                                "example_id": "35e26250-3988-4696-800c-cc15187c719c",
                                                "sense_id": "91a0649e-5110-3c74-b340-a00fd94af9ca",
                                                "text": "Certains plaideront pour le libre choix.\n D’autres feront valoir que l’objectif est d’avoir une protection minimale pour le plus grand nombre afin de limiter les hospitalisations et réduire les décès.\n Le terreau sera fertile pour les conspirationnistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e491cdc-e490-4ca5-9720-4457e267fe72",
                        "source_entry_id": "243eecb3-9ec1-393a-82b9-89c12ce042b4",
                        "source_sense_id": "77abf440-fd7d-3845-9831-14cb0bedc57a",
                        "source_sense_description": "die im Gegensatz zum toten Untergrund von Bakterien belebte, humusreiche fruchtbare Ackerkrume",
                        "target_lang_word": "terre végétale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terre végétale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8014f644-9e7c-354c-9bcd-6adb27db90a5",
                                        "entry_id": "9ec7ac37-b608-3b9d-9247-ff3bc84ad5dd",
                                        "glosses": [
                                            "Nom que l’on donne à de la terre, riche en humus et en éléments nutritifs pour les plantes."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e49450d0-296b-483b-9783-fed9599cec06",
                                                "sense_id": "8014f644-9e7c-354c-9bcd-6adb27db90a5",
                                                "text": "Songez donc que la terre végétale que nous foulons en ce moment a été apportée par les vents parcelle par parcelle, que ce sable a volé jusqu’ici grain à grain!"
                                            },
                                            {
                                                "example_id": "2120700b-89bc-4e57-97fa-0427d5d10529",
                                                "sense_id": "8014f644-9e7c-354c-9bcd-6adb27db90a5",
                                                "text": "A côté des rochers, qui partout percent la mince couche de terre végétale, se montrent d’épais buissons de ronces, […]."
                                            },
                                            {
                                                "example_id": "eb36bb00-4c92-4c69-a822-351e001bb3aa",
                                                "sense_id": "8014f644-9e7c-354c-9bcd-6adb27db90a5",
                                                "text": "Son sol est formé d’une couche presque ininterrompue d’une terre végétale noire et grasse qui, au printemps, se couvre de blé, d’orge, de maïs, de fèves, de pois chiches."
                                            },
                                            {
                                                "example_id": "1352ba0b-77ea-4aee-931f-182542756a09",
                                                "sense_id": "8014f644-9e7c-354c-9bcd-6adb27db90a5",
                                                "text": "Il s’agissait d’une culture exigeant de forts investissements, puisque le poivrier rapporte seulement après cinq ans et que les dépenses d’établissement sont considérables; il faut soigneusement entretenir la fertilité, ce qui, à Kampot, s’obtient avant tout en apportant à la poivrière la terre végétale prélevée sur des forêts avoisinantes; cet apport peut atteindre 150 kilogrammes par mètre carré et par an : il n’est pas surprenant qu’après une trentaine d'années la poivrière se trouve surélevée par rapport au terrain environnant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
