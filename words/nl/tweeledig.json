                    "frequency": "Low",
                    "semantic_group_id": "tweeledig_fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lange <w>tweeledige</w> bus kon veel passagiers vervoeren door de stad.",
