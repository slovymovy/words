                                "target_senses": [
                                    {
                                        "sense_id": "cd45b0a7-02f2-3781-bf20-5905b37c71c7",
                                        "entry_id": "66574223-8e59-35ef-8039-63494c5bcad8",
                                        "glosses": [
                                            "Crier, en parlant des oiseaux de nuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7970d59f-12eb-47e7-9a79-2f72e63629bc",
                                                "sense_id": "cd45b0a7-02f2-3781-bf20-5905b37c71c7",
                                                "text": "Et tu auras beau houpper, hurler à l’aide, hululer comme une hulotte, la fagne est une solitude, un désert funeste à qui la nargue ; personne ne t’entendra."
                                            },
                                            {
                                                "example_id": "829a31b8-d79e-4522-b88b-326fb70bc372",
                                                "sense_id": "cd45b0a7-02f2-3781-bf20-5905b37c71c7",
                                                "text": "Un hibou hulula dans le lointain, ce qui, chez les Navajos, était un mauvais présage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "262a188a-365a-39a2-98e4-cb73d4168e6c",
                                        "entry_id": "66574223-8e59-35ef-8039-63494c5bcad8",
                                        "glosses": [
                                            "Faire un bruit répétitif semblable aux hululements."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73122ae9-c772-4af3-a22a-7cd30a506426",
                                                "sense_id": "262a188a-365a-39a2-98e4-cb73d4168e6c",
                                                "text": "On entend la sirène de départ des grands cargos hululer sur la River."
                                            },
                                            {
                                                "example_id": "0f8248b1-8e44-41db-a7a7-0d849078c8b4",
                                                "sense_id": "262a188a-365a-39a2-98e4-cb73d4168e6c",
                                                "text": "Les alarmes de voiture youyoutaient, les alarmes anti-effraction hululaient, les alarmes d'incendie beuglaient, stridentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
