                        "sense_id": "13352231-7e9c-30d6-9ccf-79844aedd039",
                        "entry_id": "b7c1b530-251e-3b42-a557-bd16ce816151",
                        "glosses": [
                            "Variante orthographique de tantouze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f989cd-23cb-4779-ba09-7216a7265a4c",
                                "sense_id": "13352231-7e9c-30d6-9ccf-79844aedd039",
                                "text": "On dirait de lui : « Fleurier, vous savez bien, ce grand blond qui aime les hommes? » Et les gens répondraient : « Ah! oui. La grande tantouse? Très bien, je sais qui c’est. »"
                            },
                            {
                                "example_id": "b314bcb6-e93d-4894-b0b6-ac0ef230c944",
                                "sense_id": "13352231-7e9c-30d6-9ccf-79844aedd039",
                                "text": "Mais ça c’était le passé, maintenant il préférait, de temps à autre, s’envoyer une petite tantouse."
                            },
                            {
                                "example_id": "c0fd3679-f0ab-4231-ab0f-f6259d0a8256",
                                "sense_id": "13352231-7e9c-30d6-9ccf-79844aedd039",
                                "text": "Êtes-vous un homo ? Êtes-vous une pédale, une tapette, une folle, une chochotte, un empaffé, un de la jaquette, une tantouse ?"
                            }
                        ]
                    }
                ],
