                {
                    "sense_id": "b82fa71b-3bd4-3cab-bb7f-5d2869623b35",
                    "sense_definition": "A large amount or quantity of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent a great <w>deal</w> of time fixing the old car.",
                            "target_lang_translations": {
                                "ru": "Он потратил <w>много</w> времени на починку старой машины.",
                                "pl": "Spędził <w>mnóstwo</w> czasu na naprawianiu starego samochodu."
                            }
