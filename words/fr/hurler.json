                {
                    "sense_id": "b03980d9-47a3-3d13-99b6-474edea1c08d",
                    "sense_definition": "Pousser un cri plaintif et prolongé, en parlant des loups ou des chiens.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cris_animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la nuit sombre, le chien solitaire a commencé à <w>hurler</w> à la lune.",
                            "target_lang_translations": {
                                "en": "During the dark night, the lonely dog began to <w>howl</w> at the moon.",
                                "ru": "Тёмной ночью одинокий пёс начал <w>выть</w> на луну.",
                                "nl": "In de donkere nacht begon de eenzame hond naar de maan <w>te janken</w>.",
                                "de": "In der dunklen Nacht begann der einsame Hund, den Mond <w>anzuheulen</w>.",
                                "pl": "W ciemną noc samotny pies zaczął <w>wyć</w> do księżyca.",
                                "it": "Nella notte buia, il cane solitario ha cominciato a <w>ululare</w> alla luna.",
                                "cs": "Za temné noci začal osamělý pes <w>výt</w> na měsíc.",
                                "tr": "Karanlık gecenin içinde yalnız köpek aya doğru <w>ulumaya</w> başladı.",
                                "es": "Durante la noche oscura, el perro solitario empezó a <w>aullar</w> a la luna.",
                                "zh": "漆黑的夜里，那只孤独的狗开始对着月亮<w>嚎叫</w>。"
                            }
                        },
                        {
                            "text": "Au fond de la forêt enneigée, nous avons entendu une meute de loups qui <w>hurlait</w>.",
                            "target_lang_translations": {
                                "en": "Deep in the snowy forest, we heard a pack of wolves <w>howling</w>.",
                                "ru": "В глубине заснеженного леса мы услышали, как стая волков <w>выла</w>.",
                                "nl": "Diep in het besneeuwde bos hoorden we een roedel wolven <w>huilen</w>.",
                                "de": "Tief im verschneiten Wald hörten wir ein Rudel Wölfe <w>heulen</w>.",
                                "pl": "W głębi zaśnieżonego lasu usłyszeliśmy stado wilków, które <w>wyły</w>.",
                                "it": "Nel profondo della foresta innevata abbiamo sentito un branco di lupi che <w>ululava</w>.",
                                "cs": "Hluboko v zasněženém lese jsme slyšeli, jak smečka vlků <w>vyla</w>.",
                                "tr": "Karlı ormanın derinliklerinde kurt sürüsünün <w>uluduğunu</w> duyduk.",
                                "es": "En lo profundo del bosque nevado, oímos una manada de lobos que <w>aullaba</w>.",
                                "zh": "在积雪覆盖的森林深处，我们听到一群狼在<w>嚎叫</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hurler à la lune",
                        "hurler à la mort"
                    ],
                    "target_lang_definitions": {
                        "en": "To give a long, mournful cry, as wolves or dogs do.",
                        "ru": "Издавать протяжный жалобный вой, как волки или собаки.",
                        "nl": "Een langgerekt, klagend geluid maken, zoals wolven en honden doen.",
                        "de": "Einen langgezogenen, klagenden Laut ausstoßen, wie Wölfe oder Hunde.",
                        "pl": "Wydawać długi, żałosny głos, charakterystyczny dla wilków i psów.",
                        "it": "Emettere un lungo grido lamentoso, come fanno lupi e cani.",
                        "cs": "Vydávat dlouhý, smutný zvuk, jako vlci nebo psi.",
                        "tr": "Kurt ya da köpek gibi hayvanların uzun ve hüzünlü bir ses çıkarması.",
                        "es": "Emitir un grito largo y lastimero, propio de lobos y perros.",
                        "zh": "像狼或狗那样拖长声音、凄厉地叫。"
                    },
