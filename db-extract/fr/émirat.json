                        "examples": [
                            {
                                "example_id": "07d2d677-9cff-4c7d-987b-b4740a7187a9",
                                "sense_id": "fe43c025-de49-3445-bab6-b9e378e6cddc",
                                "text": "Notre société fait 80 % de son chiffre d’affaires aux Émirats arabes unis."
                            },
                            {
                                "example_id": "b59b3d75-ddd9-40bf-a4f0-7c45eb425cfe",
                                "sense_id": "fe43c025-de49-3445-bab6-b9e378e6cddc",
                                "text": "La bataille pour la libération du Koweït a lieu dans l’émirat mais également au sud de l’Irak."
                            }
                        ]
                    }
                ],
                "translations": [
