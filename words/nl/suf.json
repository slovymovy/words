                {
                    "sense_id": "056c72cd-57af-3466-b3a4-c115a8d434be",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>suffen</w>.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "Vorm van suffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Suf</w> je als je lang naar een scherm staart zonder pauze?",
                            "target_lang_translations": {
                                "en": "Do you <w>get drowsy</w> if you stare at a screen for a long time without a break?"
                            }
                        },
                        {
                            "text": "<w>Suf</w> je na de vergadering, of ga je nog sporten?",
                            "target_lang_translations": {
                                "en": "Are you <w>sleepy</w> after the meeting, or are you still going to exercise?"
                            }
