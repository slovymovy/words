                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac98d01-99d9-42b8-917a-1545954fd1fa",
                                "sense_id": "1d1bbe69-540d-3276-a0da-e1e0c85d96da",
                                "text": "Włókiennictwo było dominującym przemysłem w Łodzi, ale to już daleka przeszłość.",
                                "translation": "Ткачество было преимущественным промыслом в Лодзи, но это уже далекое прошлое."
                            }
                        ]
                    },
                    {
                        "sense_id": "4df24281-8840-3eb2-ae07-90549e5bddde",
                        "entry_id": "4274f329-f5c0-37ce-a5e4-213c667668a6",
                        "glosses": [
