                "senses": [
                    {
                        "sense_id": "cf06c753-2b99-3cf8-8e16-89c3226666a8",
                        "entry_id": "c7e90433-657f-3d80-a2ae-054b103b449c",
                        "glosses": [
                            "Ein Vertreter der Affen Amerikas, die sich durch eine breite, knorpelige Nasenscheidewand auszeichnen und einen meist körperlangen Schwanz aus mindestens 14 Wirbeln besitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c54e6255-8378-4406-bb08-7973917e52f3",
                                "sense_id": "cf06c753-2b99-3cf8-8e16-89c3226666a8",
                                "text": "„Nach der Trennung der Kontinente Afrika und Amerika erfolgt auch eine unterschiedliche Entwicklung der Echten Affen in die Neuweltaffen (Breitnasenaffen) und Altweltaffen (Schmalnasenaffen), wobei die Neuweltaffen ursprünglichere Merkmale aufweisen als die Altweltaffen, was sich besonders beim Greifen (Kraftgriff) zeigt.“"
                            },
                            {
                                "example_id": "cc056f46-8bbf-4e48-845c-00764cf9f652",
                                "sense_id": "cf06c753-2b99-3cf8-8e16-89c3226666a8",
                                "text": "„Die Breitnasenaffen Südamerikas können überdies ihren Daumen nicht den anderen Fingern gegenüberstellen, wohl aber ihre große Zehe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
