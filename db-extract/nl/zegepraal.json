                                    {
                                        "sense_id": "399e6a1f-9eff-30bb-8992-d6207e41eb6c",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "A conclusive success following an effort, conflict, or confrontation of obstacles; victory; conquest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18311742-f033-4db1-9caa-cb101787e089",
                                                "sense_id": "399e6a1f-9eff-30bb-8992-d6207e41eb6c",
                                                "text": "the triumph of knowledge"
                                            },
                                            {
                                                "example_id": "1c47907a-2247-45bc-b9ec-c1da44a4a79d",
                                                "sense_id": "399e6a1f-9eff-30bb-8992-d6207e41eb6c",
                                                "text": "After being defeated in three previous finals, Roger finally tasted triumph at this year's competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f25e52b1-27ae-31d2-8540-fbc12c114ac2",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "A magnificent and imposing ceremonial performed in honor of a victor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8d1f183-5874-3c75-82da-b0eddbe3ac8e",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "Any triumphal procession; a pompous exhibition; a stately show or pageant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dba58369-e44a-4d3d-aefc-11024e96f409",
                                                "sense_id": "c8d1f183-5874-3c75-82da-b0eddbe3ac8e",
                                                "text": "We are ready, & our daughter heere, / In honour of whoſe Birth, theſe Triumphs are, / Sits heere like Beauties child,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b65c42d-6e20-3910-9986-42371507b879",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "A state of joy or exultation at success."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61644dfe-3a73-4c37-a44c-55459cedc419",
                                                "sense_id": "4b65c42d-6e20-3910-9986-42371507b879",
                                                "text": "Great triumph and rejoicing was in heaven."
                                            },
                                            {
                                                "example_id": "4693c673-a604-4b88-b243-95629f078a9a",
                                                "sense_id": "4b65c42d-6e20-3910-9986-42371507b879",
                                                "text": "Hercules from Spain / Arrived in triumph, from Geryon slain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c3cfd4c-f6f5-358c-8ab8-9444a46953c7",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "A trump card."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a951f6c-8896-4017-ae8b-2b741006c09d",
                                                "sense_id": "5c3cfd4c-f6f5-358c-8ab8-9444a46953c7",
                                                "text": "Eros has\nPackt Cards with Cæsars, and false plaid my Glory\nUnto an Enemies triumph"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df0eda7a-daaf-3f0e-9201-2836da6fd8ab",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "A card game, also called trump."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0069c3f-56ac-35ea-88e6-220d5e98ecf4",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "a ceremony held to publicly celebrate and sanctify the military achievement of an army commander."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "799ae5dc-1fc2-3ed2-a7d9-75e87b729567",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "A work of art, cuisine, etc. of very high quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0712a972-c757-412c-9bf6-4f3cda619088",
                                                "sense_id": "799ae5dc-1fc2-3ed2-a7d9-75e87b729567",
                                                "text": "Scorsese's latest film is a triumph."
                                            },
                                            {
                                                "example_id": "75b81680-e584-415a-acdc-150a95a3c8df",
                                                "sense_id": "799ae5dc-1fc2-3ed2-a7d9-75e87b729567",
                                                "text": "This wedding cake is a triumph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48133a86-7114-383d-b848-2e20be9fd159",
                                        "entry_id": "f7d86f32-237f-3566-9a24-be87f70d9830",
                                        "glosses": [
                                            "A card trick in which the cards are shuffled with half face-up and half face-down, then laid out so that only the observer's chosen card is facing upward."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "triumph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db694e77-23d8-3979-8b6f-aeaf0025eeea",
                                        "entry_id": "47f952b2-ae0e-3596-9ed7-6ad9ce535943",
                                        "glosses": [
                                            "To celebrate victory with pomp; to rejoice over success; to exult in an advantage gained; to exhibit exultation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cec6160-ed13-46f4-9db6-46b87a79e558",
                                                "sense_id": "db694e77-23d8-3979-8b6f-aeaf0025eeea",
                                                "text": "England is growne to ſuch a paſſe of late,\nThat rich men triumph to ſee the poore beg at their gate."
                                            },
                                            {
                                                "example_id": "90012565-bd07-4a63-9745-a348278e841f",
                                                "sense_id": "db694e77-23d8-3979-8b6f-aeaf0025eeea",
                                                "text": "How long shall the wicked triumph?"
                                            },
                                            {
                                                "example_id": "84562681-9127-42ac-8b43-5d27ccb9b4c6",
                                                "sense_id": "db694e77-23d8-3979-8b6f-aeaf0025eeea",
                                                "text": "Sorrow on thee, and all the packe of you\nThat triumph thus vpon my miſery:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f3cd59-60d3-3e53-979d-44ef47ab8984",
                                        "entry_id": "47f952b2-ae0e-3596-9ed7-6ad9ce535943",
                                        "glosses": [
                                            "To prevail over rivals, challenges, or difficulties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be7fed62-05b9-473d-bc10-85ee907e37c6",
                                                "sense_id": "75f3cd59-60d3-3e53-979d-44ef47ab8984",
                                                "text": "Forſake thy king and do but ioyne with me\nAnd we will triumph ouer al the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "307e635c-3441-3239-92ff-d1c7a2533a51",
                                        "entry_id": "47f952b2-ae0e-3596-9ed7-6ad9ce535943",
                                        "glosses": [
                                            "To succeed, win, or attain ascendancy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "637a2758-d642-4b5f-b0eb-6e2f57593e1d",
                                                "sense_id": "307e635c-3441-3239-92ff-d1c7a2533a51",
                                                "text": "On this occasion, however, genius triumphed."
                                            },
                                            {
                                                "example_id": "2cdcbf02-a069-4592-914e-c60f0ef39c53",
                                                "sense_id": "307e635c-3441-3239-92ff-d1c7a2533a51",
                                                "text": "No one reckoned in advance that he had anything but a very testing job as host. He had to be tough, brave, witty, engaging – and decent. He triumphed on every count, thanks to sheer ability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffa3289b-1a8c-3b95-8bd8-a8ba71658f25",
                                        "entry_id": "47f952b2-ae0e-3596-9ed7-6ad9ce535943",
                                        "glosses": [
                                            "To be prosperous; to flourish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30c2d65-c7b8-4430-a7df-02d3eaabf31c",
                                                "sense_id": "ffa3289b-1a8c-3b95-8bd8-a8ba71658f25",
                                                "text": "where commerce triumphed on the favouring gales"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fb4b30d-ec6d-3664-be9a-8816bcbce25a",
                                        "entry_id": "47f952b2-ae0e-3596-9ed7-6ad9ce535943",
                                        "glosses": [
                                            "To play a trump in a card game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa46087f-410b-49d7-b729-f4dbda5d4ad6",
                                                "sense_id": "3fb4b30d-ec6d-3664-be9a-8816bcbce25a",
                                                "text": "Of the kings and the queens that triumph in the cards"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
