                "senses": [
                    {
                        "sense_id": "835cc292-6585-3adc-b1ad-54169e302fd3",
                        "entry_id": "f83b73d4-f771-36ab-a190-2b9df8a0758a",
                        "glosses": [
                            "składający się z modrzewia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f559013e-53b4-4fce-a390-7caa38a4e63f",
                                "sense_id": "835cc292-6585-3adc-b1ad-54169e302fd3",
                                "text": "Do cmentarza prowadzi długa, modrzewiowa aleja."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "344e4c17-e6ed-38b7-a6cd-8fd1d7c47a1b",
                        "entry_id": "f83b73d4-f771-36ab-a190-2b9df8a0758a",
                        "glosses": [
                            "wykonany z drewna lub innej części modrzewia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b040f93d-2e8a-4f15-9116-294b04882c44",
                                "sense_id": "344e4c17-e6ed-38b7-a6cd-8fd1d7c47a1b",
                                "text": "Dach, pokryty korą modrzewiową, także przysypany był gliną i ziemią"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ffcd9927-07fe-389d-bab8-95a479d05c6e",
                        "entry_id": "f83b73d4-f771-36ab-a190-2b9df8a0758a",
                        "glosses": [
                            "będący częścią modrzewia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d96c85-18b7-4ce6-925c-76639f829e2d",
                                "sense_id": "ffcd9927-07fe-389d-bab8-95a479d05c6e",
                                "text": "Pomiędzy dubeltowymi oknami, na przyrudziałej wacie, szyszki jodłowe i modrzewiowe, woń stęchłego drewna szła, cień pod parapetem, też godny uwagi"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
