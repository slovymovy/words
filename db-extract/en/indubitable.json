                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44e3931e-a37c-4846-ba5f-f1f5ce30a415",
                                                "sense_id": "86691471-fd49-3c83-9afc-12d849dd1d28",
                                                "text": "Na onderzoek in een oud archief is een lijst samengesteld met 200 vrouwen, aldus de politie in een mededeling. Daarna werden de vrouwen opgespoord en uitvoerig ondervraagd vooraleer de biologische moeder met de hulp van een dna-analyse onbetwijfelbaar werd geïdentificeerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73569746-561f-431d-acd1-85c114ee5110",
                        "source_entry_id": "1687e6c8-3047-3bea-af86-107a121403da",
                        "source_sense_id": "5367b75a-2e7c-3e7b-be31-013c161fd414",
                        "source_sense_description": "not dubitable",
                        "target_lang_word": "indubitable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indubitable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                        "entry_id": "e9428b30-90bc-3d21-a72d-3e1a8f223f5b",
                                        "glosses": [
                                            "Dont on ne peut douter, qui est certain, assuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7f48a69-899a-4f60-bef7-a7bce227bec5",
                                                "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                                "text": "Il est indubitable que Cadiz affranchie reprendra tout l’avantage que Gibraltar n’a dû lui-même qu’à sa franchise."
                                            },
                                            {
                                                "example_id": "4a97e259-0f25-45b0-98e4-3e6668789803",
                                                "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                                "text": "Car ils ne peuvent ignorer que Barbey d’Aurevilly est un catholique, un indubitable chrétien romain par la tête et par le cœur, par son éducation et par ses doctrines, et voilà ce qui les désole !"
                                            },
                                            {
                                                "example_id": "ad098f15-ab12-4196-ba3b-e95641bc3c6e",
                                                "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                                "text": "À l’endroit où le sentier s’engage dans la montagne, ils trouvèrent, tout plein et garni de sa couche de crème, le pot au lait du musicien, signe indubitable qu’il avait passé par là."
                                            },
                                            {
                                                "example_id": "fc7bf502-02a5-46b7-b8d9-70f11fcb61b0",
                                                "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                                "text": "Car il est indubitable qu’en temps de guerre et en fait de mariage, les Héros de Mars procèdent souvent de manière quelque peu sommaire !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44ac94e8-266a-4f06-8912-5a3060df9216",
                        "source_entry_id": "1687e6c8-3047-3bea-af86-107a121403da",
