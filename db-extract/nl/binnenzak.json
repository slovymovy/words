                "senses": [
                    {
                        "sense_id": "8dfceff1-0885-39fc-a21f-eae018a87b0b",
                        "entry_id": "e21ed990-649e-3479-b9dc-b531ecfacb3d",
                        "glosses": [
                            "een zak aan de binnenkant van een kledingstuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778bedbb-c265-40fe-9d4c-a8474bef8f8b",
                                "sense_id": "8dfceff1-0885-39fc-a21f-eae018a87b0b",
                                "text": "De plat-holle vorm maakt de heupfles bij uitstek geschikt om in de binnenzak van een colbert of mantel te verbergen, waardoor de flacon een geliefd object is bij mensen die in het geheim alcoholische drank nuttigen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7719ae5-c113-4d64-8e13-4d7b46a95f64",
                        "source_entry_id": "e21ed990-649e-3479-b9dc-b531ecfacb3d",
                        "source_sense_id": "8dfceff1-0885-39fc-a21f-eae018a87b0b",
                        "target_lang_word": "Innentasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Innentasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fe4f78f-24f3-3f19-87cd-a70947713ae0",
                                        "entry_id": "66fd81cd-0b59-368a-96b9-01b569d6b56e",
                                        "glosses": [
                                            "Tasche, die innen an einem Kleidungsstück oder einer Tasche angebracht und von außen nicht zu sehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ea6a3d-372f-4373-8968-651c4a2f709e",
                                                "sense_id": "5fe4f78f-24f3-3f19-87cd-a70947713ae0",
                                                "text": "„Allein Ardan gab sich locker und gelöst, führte den Begleitern seine ledernen Gamaschen mit einem von ihm erdachten Schnellknöpfmechanismus vor, suchte sich eine Zigarre aus der Innentasche seines weiten Cordanzugs und steckte sie sich an, ohne daß ihm die Hand dabei zitterte.“"
                                            },
                                            {
                                                "example_id": "754053bc-f314-4578-9e93-e699c43ea923",
                                                "sense_id": "5fe4f78f-24f3-3f19-87cd-a70947713ae0",
                                                "text": "„Joe holte einen kleinen Bolzenschneider aus der Innentasche seiner Jacke und zertrennte damit einen Stacheldraht.“"
                                            },
                                            {
                                                "example_id": "6bb44c95-e8e5-4310-b68c-ca4afff93773",
                                                "sense_id": "5fe4f78f-24f3-3f19-87cd-a70947713ae0",
                                                "text": "„Dann würde er nonchalant seine Hand in die Innentasche stecken, den Pass ohne Eile herausziehen und ihn vermutlich auf den Tisch werfen.“"
                                            },
                                            {
                                                "example_id": "9ab0f289-917b-4cda-bc5e-29d399374306",
                                                "sense_id": "5fe4f78f-24f3-3f19-87cd-a70947713ae0",
                                                "text": "„Er griff in die Innentasche seiner Jacke und warf ein paar Blatt Papier auf den Schreibtisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2fd9619-949a-4108-94d9-9536ae926ca5",
                        "source_entry_id": "e21ed990-649e-3479-b9dc-b531ecfacb3d",
