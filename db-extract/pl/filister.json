        "pl-extract.jsonl": [
            {
                "entry_id": "4928d18e-12b6-390b-ab69-e400a248df54",
                "word": "filister",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "96ee3ebd-40b0-32b3-be93-6d85a2d509b5",
                        "entry_id": "4928d18e-12b6-390b-ab69-e400a248df54",
                        "glosses": [
                            "człowiek o ciasnych ambicjach, gustach czy poglądach"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8357444d-fec2-351f-9993-6b5de3a18311",
                        "entry_id": "4928d18e-12b6-390b-ab69-e400a248df54",
                        "glosses": [
                            "członek korporacji akademickiej, który został absolwentem uczelni"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30307baa-07e1-44e7-80b5-816fc9ecd293",
                        "source_entry_id": "4928d18e-12b6-390b-ab69-e400a248df54",
                        "source_sense_id": "96ee3ebd-40b0-32b3-be93-6d85a2d509b5",
                        "target_lang_word": "philistine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philistine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                        "entry_id": "86c6bb10-98aa-3e02-9e14-cf1dcaf6e115",
                                        "glosses": [
                                            "A person who is ignorant or uneducated; specifically, a person who lacks appreciation of or is antagonistic towards art or culture, and who has pedestrian tastes."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e0fd492-b8de-4bc1-9e81-512194dc4fd8",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "[W]hen he [Christoph Friedrich Nicolai] wrote against [Immanuel] Kant's philosophy, without comprehending it; and judged of poetry as he judged of Brunswick mum, by its utility, many people thought him wrong. A man of such spiritual habilitudes is now by the Germans called a Philister, Philistine: Nicolai earned for himself the painful pre-eminence of being Erz-Philister, Arch-Philistine. [...] At present the literary Philistine seldom shows, never parades, himself in Germany; and when he does appear, he is in the last stage of emaciation."
                                            },
                                            {
                                                "example_id": "20989228-bcd0-4ba6-a404-c97432492daf",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "Not only was he [Heinrich Heine] not one of Mr. [Thomas] Carlyle's \"respectable\" people, he was profoundly disrespectable; and not even the merit of not being a Philistine can make up for a man's being that."
                                            },
                                            {
                                                "example_id": "22a32c58-fc27-447e-95ae-33c510850cf8",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "If it were not for this purging effect wrought upon our minds by culture, the whole world, the future as well as the present, would inevitably belong to the Philistines."
                                            },
                                            {
                                                "example_id": "57bac62e-9414-44d6-8a1e-7223969149f9",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "Even the most pig-headed vestry-man feels that something unpleasant has been said about him when he has been called a Philistine, though he may have the vaguest possible conception of its precise meaning. [...] It is used so vaguely by people who are themselves Philistines of the deepest dye, that it is in danger of losing its meaning."
                                            },
                                            {
                                                "example_id": "d57bdb6e-a8c9-41ac-ade9-c59b67a240c0",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "Mr. [Matthew] Arnold has no patience with the middle-class ‘Philistines’ the dullards and haters of light, who care only for what is material and practical."
                                            },
                                            {
                                                "example_id": "e541227b-41ba-4eab-942e-48a801ed4ff5",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "\"Oh, the Philistine! The boorish Philistine!\" he murmured; [...]"
                                            },
                                            {
                                                "example_id": "fb7a56a3-72a1-420e-877a-4a8e9089143e",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "In politics this type of philistine has more than once denounced the \"golden rule\" as an \"iridescent dream\" of a lunatic. Such philistinism pleases the misoneism of the mediocre, whence the enthusiasm over platitudes and the reign of the philistine in newspaper art, literature and science."
                                            },
                                            {
                                                "example_id": "5b3535f4-dc85-4f50-92e8-b6b8623938a5",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "The object of such an aesthetic education is not the creation of a society of aesthetes. Aesthetes, in that pejorative sense, are as unbalanced as philistines."
                                            },
                                            {
                                                "example_id": "fdd26a9e-7786-44c4-b5f9-350adf93336c",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "War was looked upon as inherently monstrous, and those who waged it – namely, military officers – were looked upon as brutes and philistines."
                                            },
                                            {
                                                "example_id": "6d0a1b16-397f-4707-aad9-41d121ca7499",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "[A]s if to say, \"Relax, folks, we're all philistines here; we're not gonna throw you anything that's over your head\"—the Victory Gardens [Theater] invites a more sophisticated response."
                                            },
                                            {
                                                "example_id": "8c2b2126-e6c8-43cd-89cd-884addc2d990",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "[Fredric] Jameson points out that for [Theodor Wiesengrund] Adorno philistines are not 'those who do not \"understand\" art or, better still, who do not \"understand\" modern art; rather, they understand it only too well.' [...] Jameson argues that what the philistine finds incomprehensible is modern art's deferral of happiness. The modern art-lover, on the other hand, defends art's deferral of happiness as the only guarantee of preserving universal happiness at the moment of recognizing its present absence."
                                            },
                                            {
                                                "example_id": "2905bd20-31c9-4f6f-928f-80fb9fe558cb",
                                                "sense_id": "703919e2-1c05-31ce-bb69-5e0012a3b6a8",
                                                "text": "They all want to know how you get to me, let them feel how they feel and be philistines because this type of love's the epitome said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "philistine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8309e950-cf48-3072-9e34-3c623eed2026",
                                        "entry_id": "f438a464-22ae-3c6c-84c8-dc3efc03d4fd",
                                        "glosses": [
                                            "Ignorant or uneducated; specifically, lacking appreciation for or antagonistic towards art or culture, and having pedestrian tastes."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475b1a6d-ff63-4ab6-adbd-f6c204d9b276",
                                                "sense_id": "8309e950-cf48-3072-9e34-3c623eed2026",
                                                "text": "[Robert] Walpole, moreover, left England not only more corrupt than he found it, but crasser and more Philistine."
                                            },
                                            {
                                                "example_id": "8e7d1434-0028-4646-8227-2953f5814c9a",
                                                "sense_id": "8309e950-cf48-3072-9e34-3c623eed2026",
                                                "text": "Nothing is more exhilarating than philistine vulgarity. But in regard to philistine vulgarity there is no intrinsic difference between Palearctic manners and Nearctic manners."
                                            },
                                            {
                                                "example_id": "6a604ab9-a8a7-4499-8392-c6f74ba4f309",
                                                "sense_id": "8309e950-cf48-3072-9e34-3c623eed2026",
                                                "text": "There is a satisfying, down-to-earth humanness about him, a kind of philistine vigor which helps us to see things in their proper proportions. He is the voice of the philistine in all of us."
                                            },
                                            {
                                                "example_id": "4aa4b6a2-7eda-4c98-8d5b-4d10048591a2",
                                                "sense_id": "8309e950-cf48-3072-9e34-3c623eed2026",
                                                "text": "Visitors to the area are strongly recommended to have a look around the castle, for even the most Philistine of wild water canoeists cannot fail to be impressed by the enormous armoury, fine paintings and wonderful furnishings that seem to outclass all other museums and castles in the North East."
                                            },
                                            {
                                                "example_id": "5da047b7-9aac-44a5-9490-5d1dbce6f173",
                                                "sense_id": "8309e950-cf48-3072-9e34-3c623eed2026",
                                                "text": "Miles was taken seriously by the great dames of Manhattan society and was not scorned by even the most Philistine of their husbands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ea3eca5-8521-4be9-838c-4346ec31ef37",
                        "source_entry_id": "4928d18e-12b6-390b-ab69-e400a248df54",
                        "source_sense_id": "96ee3ebd-40b0-32b3-be93-6d85a2d509b5",
                        "target_lang_word": "Philister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf7d8408-06da-33e5-8b2f-ced929e0570d",
                                        "entry_id": "3faacc5d-925e-328e-93cf-a3c425246f6b",
                                        "glosses": [
                                            "kleinlicher Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f07520fb-8846-469e-927e-99cc47232c40",
                                                "sense_id": "bf7d8408-06da-33e5-8b2f-ced929e0570d",
                                                "text": "Als Nachbar war er Philister, der jeden Zweig, der über den Zaun wuchs, sauber entfernte."
                                            },
                                            {
                                                "example_id": "9c418e75-b753-452e-b179-0aaf8ed06726",
                                                "sense_id": "bf7d8408-06da-33e5-8b2f-ced929e0570d",
                                                "text": "„Die frühe Veranlagung zum Philister erwies sich als bestimmend für seinen Lebenslauf, der ja bei Erreichung seines bürgerlichen, nicht künstlerischen, Ziels aufhört, einer zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "662cab65-9d44-348c-a0c7-f11104dd13d6",
                                        "entry_id": "3faacc5d-925e-328e-93cf-a3c425246f6b",
                                        "glosses": [
                                            "nichtstudierte Person, Nichtakademiker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaf2f8dd-a540-4c85-9a53-77346d55ede6",
                                                "sense_id": "662cab65-9d44-348c-a0c7-f11104dd13d6",
                                                "text": "Später wurde aus dem Hörsaal eine Kneipe, in der sich auch Philister trafen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c4e4a1bf-35da-3170-9806-49df49fbfeb8",
                                        "entry_id": "3faacc5d-925e-328e-93cf-a3c425246f6b",
                                        "glosses": [
                                            "historisches Nachbarvolk der Israeliten"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b81203c-45c7-4bab-b95c-ad27406f0bb7",
                                                "sense_id": "c4e4a1bf-35da-3170-9806-49df49fbfeb8",
                                                "text": "„Ein Teil der Philister war vermutlich aus der Region Kreta zuerst nach Osten an die Küste des Mittelmeeres gelangt, und zwar mit den Seevölkern, die im 12. Jh. v. Chr. Ägypten angriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
