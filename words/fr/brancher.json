    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61c09179-52a8-3a5c-afb0-e2b42b83c926",
                    "sense_definition": "Raccorder un appareil à une source d'électricité ou à un réseau de transmission.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "connexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu dois <w>brancher</w> ton téléphone portable si tu veux recharger la batterie."
                        },
                        {
                            "text": "Elle a oublié de <w>brancher</w> l'ordinateur avant de commencer la réunion en ligne."
                        }
                    ],
                    "common_phrases": [
                        "brancher un appareil",
                        "brancher le chargeur",
                        "brancher sur secteur"
                    ],
                    "antonyms": [
                        "débrancher"
                    ]
                },
                {
                    "sense_id": "7e053a53-64a6-3e89-b310-603ff68a3e72",
                    "sense_definition": "Susciter l'intérêt ou l'envie de quelqu'un ; plaire ou tenter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ça te <w>brancherait</w> de venir au cinéma avec nous ce soir ?"
                        },
                        {
                            "text": "Ce genre de vacances à la montagne ne le <w>branche</w> pas du tout."
                        }
                    ],
                    "common_phrases": [
                        "ça te branche"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "bf99040a-49da-33ee-ace0-f3f326ddc3f9",
