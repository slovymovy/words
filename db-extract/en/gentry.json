                        ]
                    },
                    {
                        "sense_id": "0300f652-8a18-38bf-8ff8-83bb4540d5a3",
                        "entry_id": "4cc163c5-b49d-3c49-8e07-d7c082ca1ccb",
                        "glosses": [
                            "In a restricted sense, those people between the nobility and the yeomanry."
                        ],
                        "tags": [
                            "British",
                            "countable",
