                            {
                                "target_word": "Quinkunx",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "964954fe-0ea3-3c7a-9cc1-1391a85f75c5",
                                        "entry_id": "6b101da5-ddf6-313f-88a8-51330078cb7a",
                                        "glosses": [
                                            "antike römische Münze im Wert von fünf Unciae; allgemein für fünf Unzen oder fünf Zwölftel, zum Beispiel den Winkelabstand von 150° in der Astrologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed2c29e8-a7fc-4996-8888-806581380511",
                                                "sense_id": "964954fe-0ea3-3c7a-9cc1-1391a85f75c5",
                                                "text": "Der Quinkunx entsprach fünf römischen Unzen."
                                            },
                                            {
                                                "example_id": "93440f21-49fc-4637-afd7-619ef6fad3a4",
                                                "sense_id": "964954fe-0ea3-3c7a-9cc1-1391a85f75c5",
                                                "text": "Der Quinkunx ist ein Nebenaspekt in der Astrologie, den man als Ergänzung des Halbsextils sehen kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c8a24c6-ae00-37d0-8fac-903dbca31e5d",
                                        "entry_id": "6b101da5-ddf6-313f-88a8-51330078cb7a",
                                        "glosses": [
                                            "Anordnung von fünf Objekten, wobei vier die Ecken eines Quadrats bilden und das fünfte in der Mitte steht, zum Beispiel die fünf Augen auf einem Spielwürfel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6363060-5fe3-4984-b9cd-6b4f3f2ab690",
                                                "sense_id": "5c8a24c6-ae00-37d0-8fac-903dbca31e5d",
                                                "text": "Die Bäume wurden in kleinen Gruppen und jeweils in Form eines Quinkunx gepflanzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
