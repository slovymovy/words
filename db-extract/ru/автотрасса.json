                    },
                    {
                        "translation_id": "2f83bdce-2c96-4a40-8969-0cbea7933524",
                        "source_entry_id": "59be327f-f8f2-3fb7-91bf-ce3594324f9b",
                        "source_sense_id": "1b6bc4f1-dc5b-3f6d-bca4-8924672d43ef",
                        "target_lang_word": "autopista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autopista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "50bb3b9d-dc8a-3c8e-8654-614d461499de",
                                        "entry_id": "cf754dca-75bc-3fdf-8d31-e178805f63dc",
                                        "glosses": [
                                            "Carretera de uso público con calzadas independientes y más de un carril en cada sentido."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfae04b1-b88e-4bb1-90d5-c75f6f05fae9",
                                                "sense_id": "50bb3b9d-dc8a-3c8e-8654-614d461499de",
                                                "text": "Quiero verte desnuda\nEl día que desfilen los cuerpos\nQue han sido salvados, nena\nSobre alguna autopista\nQue tenga infinitos carteles\nQue no digan nada\nY realmente quiero que te rías\nY que digas que es un juego nomás"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad2f8f1a-3c0c-4111-aa9d-fe0bfe81371f",
                        "source_entry_id": "59be327f-f8f2-3fb7-91bf-ce3594324f9b",
                        "source_sense_id": "1b6bc4f1-dc5b-3f6d-bca4-8924672d43ef",
                        "target_lang_word": "Autobahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autobahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                        "entry_id": "ec60252a-62ab-3c30-a453-dd67a390057d",
                                        "glosses": [
                                            "kreuzungsfrei gebaute, richtungsgetrennte Schnellstraße mit mindestens zwei Fahrspuren je Fahrtrichtung"
                                        ],
                                        "tags": [
                                            "Verkehrstechnik",
                                            "Verkehrswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700c9e0f-78b5-4275-b91d-7cb79fa8255f",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Die A 45 ist eine Autobahn von Norden nach Süden."
                                            },
                                            {
                                                "example_id": "6525e309-dfb4-4340-b001-4a8e84cc13b7",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Nehmen Sie die Autobahn bis Freiburg."
                                            },
                                            {
                                                "example_id": "bb56481f-4736-444a-8d7f-18271db63a18",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Aufgrund eines Verkehrsunfalls war gestern die Autobahn nach Berlin gesperrt."
                                            },
                                            {
                                                "example_id": "e9f04a6f-a298-4e08-97b8-55d6dd8b5ed5",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "In vielen Ländern wird für die Nutzung der Autobahn eine Maut erhoben."
                                            },
                                            {
                                                "example_id": "2cc8211b-f2e2-479b-a2c3-6d5410647b43",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Besonders zu Beginn der Schulferien steht man auf der Autobahn häufig im Stau."
                                            },
                                            {
                                                "example_id": "01a7aea0-31b7-48f1-bd38-25c2a3ed74ea",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Die Autobahn schlägt eine Schneise durch einen Kiefernwald.“"
                                            },
                                            {
                                                "example_id": "8fcdb60e-cee5-4c19-a697-bb5d5bde6b9e",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Er las ihr vor, bis sie die Autobahn erreichten, deren heller Strich sich wie eine Neonröhre durch die Landschaft zog.“"
                                            },
                                            {
                                                "example_id": "9df82b3b-8274-4441-9f2d-f54c37c11b12",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Bevor ich die Autobahn sah, hörte ich sie.“"
                                            },
                                            {
                                                "example_id": "455dec8b-468b-4f1d-ab79-9bcb9a38b786",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Das Gerücht, dass die Erfindung der deutschen Autobahn auf Adolf Hitler zurückgeht, ist übrigens falsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
