            "senses": [
                {
                    "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                    "sense_definition": "A public building or room used for gambling and often entertainment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go to the <w>casino</w> to play roulette and blackjack.",
                            "target_lang_translations": {
                                "ru": "Мы решили пойти в <w>казино</w>, чтобы поиграть в рулетку и блэкджек.",
                                "zh": "我们决定去<w>赌场</w>玩轮盘赌和二十一点。"
                            }
                        },
                        {
                            "text": "Many tourists visit the famous <w>casino</w> in Monte Carlo every year.",
                            "target_lang_translations": {
                                "ru": "Многие туристы ежегодно посещают знаменитое <w>казино</w> в Монте-Карло.",
                                "zh": "每年都有许多游客参观蒙特卡洛那座著名的<w>赌场</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gambling house"
                    ],
                    "common_phrases": [
                        "online casino",
                        "casino games",
                        "casino chip",
                        "go to the casino"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общественное здание или помещение, используемое для азартных игр и развлечений.",
                        "zh": "提供赌博和娱乐活动的公共建筑或场所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "казино",
                                "target_lang_sense_clarification": "заведение"
                            },
                            {
                                "target_lang_word": "игорный дом",
                                "target_lang_sense_clarification": "устаревшее или формальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赌场",
                                "target_lang_sense_clarification": "提供赌博的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72f7f3dd-5ceb-3764-bbdb-bc3b29f45f2c",
                    "sense_definition": "A card game of Italian origin for two to four players where cards are captured from the table.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "card_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather taught me how to play <w>casino</w> with a standard deck of cards.",
                            "target_lang_translations": {
                                "ru": "Дедушка научил меня играть в <w>казино</w> обычной колодой карт.",
                                "zh": "我祖父教我如何用一副标准扑克牌玩<w>卡西诺牌戏</w>。"
                            }
                        },
                        {
                            "text": "In the game of <w>casino</w>, capturing the most spades earns you a point.",
                            "target_lang_translations": {
                                "ru": "В игре <w>казино</w> взятие наибольшего количества пик приносит очко.",
                                "zh": "在<w>卡西诺牌戏</w>中，赢得最多的黑桃牌可以得一分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play casino"
                    ],
                    "target_lang_definitions": {
                        "ru": "Карточная игра итальянского происхождения для двух-четырех игроков, в которой карты берутся со стола.",
                        "zh": "一种源自意大利的纸牌游戏，供二至四人玩，目标是从桌面上赢取纸牌。"
                    },
                    "translations": {
