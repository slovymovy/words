                "translations": [
                    {
                        "translation_id": "9f8abe75-5986-43ab-83dd-3c43de28a36a",
                        "source_entry_id": "22964e85-bca1-35bc-b72a-0b28716af603",
                        "source_sense_id": "42311c6e-40bd-3124-bf85-453def1129b9",
                        "source_sense_description": "een kamer waar men een gesprek met iemand kan voeren",
                        "target_lang_word": "Sprechzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprechzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "016df2c9-7c1b-3d95-9fea-7fa67a06711f",
                                        "entry_id": "d19e5f7c-bc04-3934-9ee8-bb31f637016c",
                                        "glosses": [
                                            "Raum, in dem eine ärztliche oder psychologische Sprechstunde/Beratung stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5110fe60-8586-44a1-ab60-1b497bf47f9f",
                                                "sense_id": "016df2c9-7c1b-3d95-9fea-7fa67a06711f",
                                                "text": "„Die Großen richten keine Sprechzimmer ein, verlangen keine Honorare, halten keine Vorträge noch schreiben sie Bücher.“"
                                            },
                                            {
                                                "example_id": "32420564-ca10-4f24-bf86-670570175fd4",
                                                "sense_id": "016df2c9-7c1b-3d95-9fea-7fa67a06711f",
                                                "text": "Arzt: \"Gehen sie schon mal vor ins Sprechzimmer, ich komme gleich nach.\""
                                            },
                                            {
                                                "example_id": "4b4ba213-fbac-407c-a23d-c26eeceb5b38",
                                                "sense_id": "016df2c9-7c1b-3d95-9fea-7fa67a06711f",
                                                "text": "„Die Tür des Sprechzimmers öffnet sich.“"
                                            },
                                            {
                                                "example_id": "b89f0e5f-5686-48f4-b3d5-9f0bd61f6570",
                                                "sense_id": "016df2c9-7c1b-3d95-9fea-7fa67a06711f",
                                                "text": "„Ich erhebe mich, trete in das Sprechzimmer ein, mache eine Verbeugung und stelle mich vor.“"
                                            },
                                            {
                                                "example_id": "e306cf59-9651-46bd-a723-f3ef3609aac4",
                                                "sense_id": "016df2c9-7c1b-3d95-9fea-7fa67a06711f",
                                                "text": "„Im nächsten Betongebäude trafen wir einen sehr heiteren Doktor, dessen kleines Sprechzimmer sehr heimelig war.“"
                                            },
                                            {
                                                "example_id": "169febfa-a782-417c-b752-611c6d26454e",
                                                "sense_id": "016df2c9-7c1b-3d95-9fea-7fa67a06711f",
                                                "text": "„Ein gutgekleideter Herr stürmt fassungslos ins Sprechzimmer eines Nervenarztes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
