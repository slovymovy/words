                                                "sense_id": "59026f02-24de-3785-93e9-5c50865563c5",
                                                "text": "Das war ein geselliger Abend."
                                            },
                                            {
                                                "example_id": "01ef90f2-7bf8-4452-8697-1dfda7b68d17",
                                                "sense_id": "59026f02-24de-3785-93e9-5c50865563c5",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b8b8e1b-a0bf-355f-9093-b1638f957229",
                                        "entry_id": "f8f87e5a-d9b6-3a93-9ae7-5afb6c505810",
                                        "glosses": [
                                            "sich leicht an andere anschließend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f255a2e5-0e3a-43ec-9161-def2f85d0986",
                                                "sense_id": "6b8b8e1b-a0bf-355f-9093-b1638f957229",
                                                "text": "Er ist ein geselliger Typ und findet leicht Anschluss."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0b690081-8f7b-3b68-be84-0a3903955168",
                                        "entry_id": "f8f87e5a-d9b6-3a93-9ae7-5afb6c505810",
                                        "glosses": [
                                            "mit anderen zusammenlebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
