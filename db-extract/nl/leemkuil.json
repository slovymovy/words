                "senses": [
                    {
                        "sense_id": "044757c1-741b-32b6-a463-7bdaab0bcc82",
                        "entry_id": "a81fbf45-bfd1-3ad9-a3ba-4fbc0810c9d1",
                        "glosses": [
                            "kuil waaruit men leem wint of heeft gewonnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf96076-d01f-4b8f-9aa1-73c16c79816c",
                                "sense_id": "044757c1-741b-32b6-a463-7bdaab0bcc82",
                                "text": "De bijenschans in het Corversbos illustreert hoe weinig men zich indertijd bekommerde om uiterlijke conventies: de bijen zitten in een oude leemkuil ter grootte van een bijenschans, een meter of twee onder het maaiveld."
                            },
                            {
                                "example_id": "656144f4-ba8d-4d8c-a081-b7ad3358aa1a",
                                "sense_id": "044757c1-741b-32b6-a463-7bdaab0bcc82",
                                "text": "Aan het boomomrande zwemmeer Surae zijn veel Brabantse jeugdherinneringen verbonden. Tachtig jaar geleden ontstonden de plassen in diepe leemkuilen van een steenfabriek."
                            },
                            {
                                "example_id": "3bac5e55-bffd-4521-8308-10b0d9673858",
                                "sense_id": "044757c1-741b-32b6-a463-7bdaab0bcc82",
                                "text": "De man kwam zijn afval storten in de leemkuil, waar recent nog opgravingen werden verricht. Tegen de boer werd proces-verbaal opgemaakt."
                            }
                        ]
                    }
                ],
