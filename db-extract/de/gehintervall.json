                ],
                "senses": [
                    {
                        "sense_id": "4ad1fe16-8c59-3432-a4b6-590b0b52b0ff",
                        "entry_id": "185ccd32-b761-3754-933b-41c0f0fd935a",
                        "glosses": [
                            "bewusst geplante, meist kurze Phase des Gehens, häufig im Rahmen von sportlichen Aktivitäten wie Lauf- oder Intervalltraining"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d5b8984b-e05d-4149-9b2d-97cd88c58229",
                                "sense_id": "4ad1fe16-8c59-3432-a4b6-590b0b52b0ff",
                                "text": "„Zu Beginn können kurze Lauf- oder Gehintervalle durchgeführt werden, die allmählich gesteigert werden können.“"
                            },
                            {
                                "example_id": "7c5636d9-ca1c-4ccb-80c3-9c82e4d0b746",
                                "sense_id": "4ad1fe16-8c59-3432-a4b6-590b0b52b0ff",
                                "text": "„Gegebenenfalls kann es sogar sinnvoll sein, in den ersten Wochen nur zu walken oder im Laufintervalle mit Gehintervallen abzuwechseln.“"
                            },
                            {
                                "example_id": "5c75d363-fa1f-4a66-94e2-af8a55ddea92",
                                "sense_id": "4ad1fe16-8c59-3432-a4b6-590b0b52b0ff",
                                "text": "„Die Jogging-Gruppe beginnt mit kurzen Lauf- und Gehintervallen durch das schöne Köllbachtal.“"
                            },
                            {
                                "example_id": "7c76bca2-27ae-4786-b08e-88c19c5dae9d",
                                "sense_id": "4ad1fe16-8c59-3432-a4b6-590b0b52b0ff",
                                "text": "„So oder so, beginnen Sie als Laufanfänger mit kurzen Lauf- oder Gehintervallen und steigern Sie ganz allmählich Ihre Distanz und Geschwindigkeit.“"
                            },
                            {
                                "example_id": "876d7592-b94e-4ffc-be81-0448d3939a97",
                                "sense_id": "4ad1fe16-8c59-3432-a4b6-590b0b52b0ff",
                                "text": "„Deswegen solltest du als blutige*r [sic] Anfänger*in [sic] zunächst mit Gehintervallen laufen, sehr langsam joggen und nur Schritt für Schritt deine Trainingsumfänge erhöhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
