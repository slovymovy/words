            {
                "entry_id": "45ca72e4-3ff9-3ea9-9d1a-cea8a3ed92ec",
                "word": "électromagnétisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e17deb0-9f84-4476-a69c-57382d18ccec",
                        "entry_id": "45ca72e4-3ff9-3ea9-9d1a-cea8a3ed92ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "électromagnétismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ad9985b-ffc1-3523-bb89-c131c54f3afa",
                        "entry_id": "45ca72e4-3ff9-3ea9-9d1a-cea8a3ed92ec",
                        "glosses": [
                            "Effet magnétique produit par un courant électrique."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "72f59083-6bb0-480b-8cbf-75ca4c520867",
                                "sense_id": "6ad9985b-ffc1-3523-bb89-c131c54f3afa",
                                "text": "Sur les temps, quelques cheveux, détachés de l’ensemble tiré vers l’arrière, dansaient comme dans la chaleur d’un projecteur ou sous l’effet d’un électromagnétisme venu d’on ne sait quelles ondes, présentes ou lointaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "9db983e2-c89a-304e-b4ae-141b4ed0903c",
                        "entry_id": "45ca72e4-3ff9-3ea9-9d1a-cea8a3ed92ec",
                        "glosses": [
                            "Branche de la physique qui étudie le champ électromagnétique et son interaction avec les particules dotées d’une charge électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "708566cd-d0c5-43f4-a6a9-636ee7b1d8b0",
                                "sense_id": "9db983e2-c89a-304e-b4ae-141b4ed0903c",
                                "text": "Quarante ans plus tard, Maxwell donnera des ondes de Fresnel une interprétation électromagnétique et, montrant ainsi que toute onde lumineuse est une perturbation électromagnétique d’un type particulier, il fera rentrer toute l’Optique dans l’Électromagnétisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc2f8bcb-3521-48cb-88ca-9aa8986100d3",
                        "source_entry_id": "45ca72e4-3ff9-3ea9-9d1a-cea8a3ed92ec",
                        "target_lang_word": "Elektromagnetismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektromagnetismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3365bf28-e928-3882-a128-2110c03e41bd",
                                        "entry_id": "1716c25c-dd53-30d7-82fa-76529220fba1",
                                        "glosses": [
                                            "die Beziehungen zwischen Magnetismus und rein elektrischen Phänomenen; eine der vier fundamentalen Wechselwirkungen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a067bf-aa37-42a7-ad6a-21a32e67a686",
                                                "sense_id": "3365bf28-e928-3882-a128-2110c03e41bd",
                                                "text": "„Die quantitative Verbindung zwischen Licht und Elektromagnetismus wird als ein großer Triumph der Physik des 19. Jahrhunderts angesehen.“"
                                            },
                                            {
                                                "example_id": "772d109d-32d0-4d04-a029-e3e42bd59232",
                                                "sense_id": "3365bf28-e928-3882-a128-2110c03e41bd",
                                                "text": "„Es gibt die vier fundamentalen Wechselwirkungen Gravitation, Elektromagnetismus, schwache Wechselwirkung, starke Wechselwirkung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
