                                "sense_id": "8cf2b438-3764-34b3-87c5-e5bca464237b",
                                "text": "Nie wyobrażała sobie pożycia dwojga ludzi, gdy już nic ich nie łączy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a9168f8a-a1c9-393a-beed-e49deeaff730",
                        "entry_id": "5e4dad99-07e2-3a38-a000-1cafa30d3edd",
