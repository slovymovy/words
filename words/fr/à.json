                },
                {
                    "sense_id": "e4bdc5ea-9be8-3a78-b202-aae6cbbd882b",
                    "sense_definition": "Forme des locutions exclamatives d'appel, d'injonction ou d'avertissement.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Entendant du bruit dans le jardin, l'homme cria <w>à</w> l'aide."
                        },
                        {
                            "text": "La pause est terminée, tout le monde doit se remettre <w>à</w> la tâche."
                        }
                    ],
                    "common_phrases": [
