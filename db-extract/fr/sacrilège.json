                                "target_senses": [
                                    {
                                        "sense_id": "27f8b213-313a-3b6d-b24e-c4def2f3d326",
                                        "entry_id": "9f0acd0c-0674-38cf-869b-654efe05e466",
                                        "glosses": [
                                            "Desecration, profanation, misuse or violation of something regarded as sacred."
                                        ],
                                        "tags": [
