{
    "word_family": [
        "silhouetter",
        "silhouettiste"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02888125-70f5-37e7-b224-b5b8cd8cb7be",
                    "sense_definition": "Contour général d'une personne ou d'une chose qui se détache sur un fond ou dans l'obscurité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la brume matinale, une sombre <w>silhouette</w> marchait lentement vers nous. Ce passant semblait hésiter à chaque pas."
                        },
                        {
                            "text": "La faible lueur de la lune laissait deviner la <w>silhouette</w> d'un grand arbre au fond du jardin."
                        }
                    ],
                    "synonyms": [
                        "ombre",
                        "profil"
                    ],
                    "common_phrases": [
                        "silhouette sombre",
                        "silhouette mystérieuse",
                        "distinguer une silhouette"
                    ]
                },
                {
                    "sense_id": "533dcd34-6b46-3477-8ea7-768f2f70cfb3",
                    "sense_definition": "Ligne générale, allure et corpulence du corps humain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette robe élégante met parfaitement en valeur sa <w>silhouette</w> élancée."
                        },
                        {
                            "text": "Il pratique la natation pour garder la ligne et affiner sa <w>silhouette</w>."
                        }
                    ],
                    "synonyms": [
                        "allure",
                        "stature"
                    ],
                    "common_phrases": [
                        "garder la silhouette",
                        "affiner la silhouette",
                        "silhouette élancée"
                    ]
                },
                {
                    "sense_id": "23df3d63-580b-3c3c-bafa-454124feb2fb",
                    "sense_definition": "Profil caractéristique d'un ensemble de monuments, d'une ville ou d'un paysage qui se découpe sur l'horizon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contour_geographique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au loin, la <w>silhouette</w> des gratte-ciel se découpait nettement sur le ciel couchant."
                        },
                        {
                            "text": "Depuis le pont, les touristes admiraient la <w>silhouette</w> de la vieille cathédrale."
                        }
                    ],
                    "synonyms": [
                        "profil"
                    ],
                    "common_phrases": [
                        "silhouette urbaine",
                        "silhouette de la ville"
                    ]
                },
                {
                    "sense_id": "290cbb7c-1308-3e21-9c52-f80f50f9e31c",
                    "sense_definition": "Dessin ou portrait monochrome représentant les contours d'un visage ou d'un corps, souvent découpé dans du papier noir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le salon ancien était accrochée une délicate <w>silhouette</w> de son arrière-grand-mère."
                        },
                        {
                            "text": "L'artiste de rue découpait la <w>silhouette</w> des passants en quelques secondes seulement."
                        }
                    ],
                    "common_phrases": [
                        "dessin à la silhouette"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a98aa73-0256-3413-8d20-4c72f456f407",
                    "sense_definition": "Première ou troisième personne du singulier du présent de l'indicatif ou du subjonctif de <w>silhouetter</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ombre de la tour se <w>silhouette</w> sur le mur blanc sous la lumière du phare."
                        },
                        {
                            "text": "Il attend que son ombre se <w>silhouette</w> nettement avant d'entrer en scène."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forme verbale fléchie"
                        }
                    ]
                },
                {
                    "sense_id": "b4968db3-102d-3406-849a-15394d20b38a",
                    "sense_definition": "Deuxième personne du singulier de l'impératif présent de <w>silhouetter</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne te montre pas en plein jour, <w>silhouette</w> ton profil derrière le rideau avant d'avancer."
                        },
                        {
                            "text": "<w>Silhouette</w> cette forme sur ton esquisse pour donner plus de relief à ta peinture."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forme verbale fléchie"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "25f0b701-e271-35f0-bb2b-2e72aa3eb26b",
                    "sense_definition": "Nom de famille français d'origine basque, célèbre notamment grâce à Étienne de Silhouette.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "onomastique",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Le mot commun provient directement du nom de Monsieur de <w>Silhouette</w>, contrôleur général sous Louis XV."
                        },
                        {
                            "text": "Plusieurs familles portent encore aujourd'hui le patronyme <w>Silhouette</w> dans différentes régions de France."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nom de famille"
                        }
                    ]
                }
            ]
        }
    ]
}