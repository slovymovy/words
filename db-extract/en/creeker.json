                "senses": [
                    {
                        "sense_id": "baf17c12-c408-31ac-9c8f-d11c162b5834",
                        "entry_id": "66925f88-e2ec-3b45-98fa-78aea33f698b",
                        "glosses": [
                            "A poor rural person."
                        ],
                        "tags": [
                            "Appalachia",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "c1a5ee3c-8317-4eed-a014-5c2da0fa7725",
                                "sense_id": "baf17c12-c408-31ac-9c8f-d11c162b5834",
                                "text": "I want, at the outset to differentiate between those Appalachians who grow up in the towns and those from rural areas—the creeks and the hollers… This is a story from rural Appalachia, recently brought to consciousness, and reported by a creeker."
                            },
                            {
                                "example_id": "a04f6db3-727d-4101-9abe-981635efef9c",
                                "sense_id": "baf17c12-c408-31ac-9c8f-d11c162b5834",
                                "text": "But at my alma mater in West Virginia, we had a unique \"Us & Them\" sorting classification: you were either a “hiller” or a “creeker.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f304c5ad-2ad8-3018-b530-fb099fda6af5",
                        "entry_id": "66925f88-e2ec-3b45-98fa-78aea33f698b",
                        "glosses": [
                            "A Viking."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3bb55a8f-2650-4d8a-8fce-2979fff7419d",
                                "sense_id": "f304c5ad-2ad8-3018-b530-fb099fda6af5",
                                "text": "Children of the old Vikings, or \"Creekers\", they took, in their great need, to the seaward and the estuaries, as other conquered races take to the mountains, and died, like their forefathers, within scent of the salt sea from whence they came."
                            },
                            {
                                "example_id": "4eb3fdb1-d3d7-401e-be6e-15825de83674",
                                "sense_id": "f304c5ad-2ad8-3018-b530-fb099fda6af5",
                                "text": "Wick, a creek or bay - Ipswich, Greenwich, Berwick. (Viking = a creeker.)"
                            }
                        ]
                    }
                ],
