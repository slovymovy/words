                                    {
                                        "sense_id": "3c51e1d1-3912-33b9-9074-13e014a15e07",
                                        "entry_id": "e46d9a84-195f-36eb-bcc8-197c98946f11",
                                        "glosses": [
                                            "Ruisseau français affluent de l’Alagnon qui coule dans le département de la Haute-Loire."
                                        ],
