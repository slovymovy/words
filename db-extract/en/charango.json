                        "glosses": [
                            "A small guitar-like stringed instrument with five courses of eighteen to fifteen strings, originating in traditional Andean folk music."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe7c42e-51a2-470e-bfd1-a59c68439400",
                                "sense_id": "8784b2ae-8ff2-325f-b4e2-899235b3798c",
                                "text": "One song the group performed on Thursday, “La Partida,” featured lovely bell harmonics from the guitars, a shifting pattern of cross‐rhythms on the guitar‐like charango, and a quena lead."
                            }
                        ]
                    }
                ],
