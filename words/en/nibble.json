{
    "word_family": [
        "nibbler",
        "nibbling",
        "nybble"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3bada9c-67fb-3a74-a999-871d0e3afd7b",
                    "sense_definition": "To take a small, quick bite, or several of such bites, of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit began to <w>nibble</w> the lettuce in the garden.",
                            "target_lang_translations": {
                                "ru": "Кролик начал <w>грызть</w> салат в огороде.",
                                "zh": "兔子开始在花园里<w>啃</w>生菜。",
                                "fr": "Le lapin a commencé à <w>grignoter</w> la laitue dans le jardin."
                            }
                        },
                        {
                            "text": "She would <w>nibble</w> a biscuit while reading her favorite book.",
                            "target_lang_translations": {
                                "ru": "Она любила <w>покусывать</w> печенье, читая любимую книгу.",
                                "zh": "她读书时喜欢<w>小口咬</w>着饼干吃。",
                                "fr": "Elle grignotait un biscuit en lisant son livre préféré."
                            }
                        }
                    ],
                    "synonyms": [
                        "bite"
                    ],
                    "common_phrases": [
                        "nibble a biscuit",
                        "nibble the lettuce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Откусывать маленькими кусочками или делать несколько быстрых мелких укусов.",
                        "zh": "指用牙齿小口地、快速地咬东西。",
                        "fr": "Prendre de petites bouchées rapides ou plusieurs petites bouchées de quelque chose."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "откусывать по чуть-чуть"
                            },
                            {
                                "target_lang_word": "покусывать",
                                "target_lang_sense_clarification": "слегка кусать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "啃",
                                "target_lang_sense_clarification": "小口地咬"
                            },
                            {
                                "target_lang_word": "咬",
                                "target_lang_sense_clarification": "轻咬或小口咬"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "grignoter",
                                "target_lang_sense_clarification": "manger petit à petit"
                            },
                            {
                                "target_lang_word": "croquer",
                                "target_lang_sense_clarification": "mordre légèrement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "318d14f0-a2b8-397d-a09c-a3b18d758149",
                    "sense_definition": "To take small, quick bites, or to eat at frequent intervals with small bites, often followed by 'at', 'away', or 'on'.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mouse was seen to <w>nibble</w> at the cheese left on the counter.",
                            "target_lang_translations": {
                                "ru": "Видели, как мышь <w>грызла</w> сыр, оставленный на столе.",
                                "zh": "有人看到那只老鼠在<w>啃</w>柜台上剩下的奶酪。",
                                "fr": "On a vu la souris <w>grignoter</w> le fromage laissé sur le comptoir."
                            }
                        },
                        {
                            "text": "I like to <w>nibble</w> on snacks throughout the afternoon.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>кусочничать</w> в течение дня.",
                                "zh": "我喜欢整个下午都在<w>吃</w>零食。",
                                "fr": "J'aime <w>grignoter</w> des en-cas tout au long de l'après-midi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble at the bait",
                        "nibble on snacks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть что-либо мелкими кусочками, часто перекусывая в течение дня.",
                        "zh": "指一点一点地吃，或在一段时间内断断续续地吃零食。",
                        "fr": "Manger par petites quantités, souvent de manière répétée ou en dehors des repas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "о еде, например, орешках или печенье"
                            },
                            {
                                "target_lang_word": "кусочничать",
                                "target_lang_sense_clarification": "перекусывать понемногу"
                            },
                            {
                                "target_lang_word": "пощипывать",
                                "target_lang_sense_clarification": "есть по чуть-чуть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "零食",
                                "target_lang_sense_clarification": "指吃零食的行为"
                            },
                            {
                                "target_lang_word": "吃",
                                "target_lang_sense_clarification": "小口地吃"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "grignoter",
                                "target_lang_sense_clarification": "manger par petites quantités"
                            },
                            {
                                "target_lang_word": "picorer",
                                "target_lang_sense_clarification": "manger un peu de tout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6273026-0d48-39bb-9584-e6b3ec84e324",
                    "sense_definition": "To lightly bite a person or animal, especially in a loving or playful manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy would <w>nibble</w> my fingers whenever we played together.",
                            "target_lang_translations": {
                                "ru": "Щенок <w>покусывал</w> мои пальцы каждый раз, когда мы играли вместе.",
                                "zh": "我们一起玩的时候，小狗总会<w>轻咬</w>我的手指。",
                                "fr": "Le chiot <w>mordillait</w> mes doigts chaque fois que nous jouions ensemble."
                            }
                        },
                        {
                            "text": "He began to <w>nibble</w> her ear playfully during the movie.",
                            "target_lang_translations": {
                                "ru": "Он начал игриво <w>прикусывать</w> её ухо во время фильма.",
                                "zh": "看电影时，他开始调皮地<w>轻咬</w>她的耳朵。",
                                "fr": "Il a commencé à lui <w>mordiller</w> l'oreille de façon espiègle pendant le film."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble playfully",
                        "nibble my fingers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка покусывать человека или животное, обычно любя или в игре.",
                        "zh": "指为了表达亲昵或玩耍而轻轻地咬人或动物。",
                        "fr": "Mordre légèrement quelqu'un ou un animal, souvent par affection ou pour jouer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покусывать",
                                "target_lang_sense_clarification": "игриво или нежно"
                            },
                            {
                                "target_lang_word": "прикусывать",
                                "target_lang_sense_clarification": "слегка зажимать зубами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻咬",
