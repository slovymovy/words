                        "entry_id": "96513649-0707-31fb-b5e1-8d01b028afba",
                        "glosses": [
                            "помещать определённое количество семян в землю"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515cb9e3-5308-432d-ab88-233d87f7adbf",
                                "sense_id": "e4b7d067-e803-30e4-809d-651db72dd413",
                                "text": "Семена антирринума высевают в открытый грунт в конце апреля."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd482c2d-f5e3-31c6-b4a0-bf15143031ee",
                        "entry_id": "96513649-0707-31fb-b5e1-8d01b028afba",
                        "glosses": [
                            "очищать что-либо от примесей, пропуская сквозь решето, сито"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f8f1781-7562-43cc-b4f2-537f50baf06f",
                        "source_entry_id": "96513649-0707-31fb-b5e1-8d01b028afba",
                        "target_lang_word": "aussäen",
