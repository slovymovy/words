                    {
                        "sense_id": "ad8d3ece-8ca4-3363-8559-98148e88a5af",
                        "entry_id": "785d6507-4488-35ef-b92b-7e5ff44cfae4",
                        "glosses": [
                            "En forme de petite tour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ec95fa-c5a9-48db-bd88-7a31832f2203",
                                "sense_id": "ad8d3ece-8ca4-3363-8559-98148e88a5af",
                                "text": "Le Roi parut, immobile dans sa robe de pourpre, droit sous ses pectoraux d’or martelé, constellé de cabochons, ponctués de gemmes, la tête couverte d’une mitre turriculée, la barbe divise et roulée en tube, la face d’un gris vineux de lave, les pommettes osseuses, en saillie sous des yeux creux."
                            }
                        ]
                    },
                    {
                        "sense_id": "32a59462-33ee-3f28-89ef-882a1960e79d",
                        "entry_id": "785d6507-4488-35ef-b92b-7e5ff44cfae4",
                        "glosses": [
                            "Caractérise une coquille en forme de petite tour."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "a31e5046-e4ca-414b-9df2-4eecca31ed2a",
                                "sense_id": "32a59462-33ee-3f28-89ef-882a1960e79d",
                                "text": "Scalaire crépue. Scalaria crispa, Lam. […]. Coquille allongée, turriculée, crépue, composée de sept à huit tours convexes, profondément disjoints entre eux, non ombiliqués au centre."
                            },
                            {
                                "example_id": "fd2082ae-c4a9-4e61-8086-8a138d43b406",
                                "sense_id": "32a59462-33ee-3f28-89ef-882a1960e79d",
                                "text": "Sous ces végétations se dérobaient et se montraient en même temps les plus rares bijoux de l’écrin de l’océan, des éburnes, des strombes, des mitres, des casques, des pourpres, des buccins, des struthiolaires, des cérites turriculées."
                            }
                        ]
                    }
