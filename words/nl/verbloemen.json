{
    "word_family": [
        "bloem",
        "bloemen",
        "bloei",
        "bloeien",
        "bebloemen",
        "herbloeien"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ce65a29-ef8c-3f9b-bcec-cb796dd289cc",
                    "sense_definition": "iets onplezierigs of negatiefs verbergen door het mooier voor te stellen dan het is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe akkoord kan de diepe verdeeldheid in de partij niet <w>verbloemen</w>.",
                            "target_lang_translations": {
                                "en": "The new agreement cannot <w>gloss over</w> the deep divisions within the party."
                            }
                        },
                        {
                            "text": "Hij probeerde zijn fouten te <w>verbloemen</w> door de schuld aan zijn collega te geven.",
                            "target_lang_translations": {
                                "en": "He tried to <w>disguise</w> his mistakes by blaming his colleague."
                            }
                        }
                    ],
                    "synonyms": [
                        "verhullen",
                        "maskeren",
                        "vergoelijken",
                        "goedpraten",
                        "inkleden"
                    ],
                    "antonyms": [
                        "onthullen",
                        "blootleggen"
                    ],
                    "common_phrases": [
                        "de waarheid verbloemen",
                        "niet te verbloemen",
                        "feiten verbloemen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hide something unpleasant or negative by presenting it more beautifully or favorably than it actually is."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gloss over",
                                "target_lang_sense_clarification": "to treat something bad as if it were not important"
                            },
                            {
                                "target_lang_word": "sugarcoat",
                                "target_lang_sense_clarification": "to make something difficult or unpleasant sound more attractive"
                            },
                            {
                                "target_lang_word": "disguise",
                                "target_lang_sense_clarification": "to hide the true nature of something negative"
                            },
                            {
                                "target_lang_word": "mask",
                                "target_lang_sense_clarification": "to conceal a feeling or situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "add78bb8-33f7-349a-be00-6d4e7f9df046",
                    "sense_definition": "iets vermijden of onuitgesproken laten om confrontatie of ongemak te voorkomen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij koos ervoor om haar kritiek te <w>verbloemen</w> om de sfeer niet te verpesten.",
                            "target_lang_translations": {
                                "en": "She chose to <w>sugarcoat</w> her criticism so as not to ruin the atmosphere."
                            }
                        },
                        {
                            "text": "In het rapport werden de risico's handig <w>verbloemd</w> door vage termen te gebruiken.",
                            "target_lang_translations": {
                                "en": "The risks were cleverly <w>veiled</w> in the report by using vague terms."
                            }
                        }
                    ],
                    "synonyms": [
                        "omzeilen",
                        "verhullen"
                    ],
                    "common_phrases": [
                        "kritiek verbloemen"
                    ],
                    "target_lang_definitions": {
                        "en": "To avoid or leave something unsaid in order to prevent confrontation or discomfort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mince words",
                                "target_lang_sense_clarification": "to use polite or vague language to avoid offense"
                            },
                            {
                                "target_lang_word": "soft-pedal",
                                "target_lang_sense_clarification": "to play down or make something seem less important"
                            },
                            {
                                "target_lang_word": "veil",
                                "target_lang_sense_clarification": "to partially hide or obscure something like criticism"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90592ca3-f76c-3e73-b586-740d0e53a95a",
                    "sense_definition": "opnieuw gaan bloeien of voor een tweede keer bloemen dragen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bloei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de zachte herfst begon de struik in de tuin weer te <w>verbloemen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the mild autumn, the shrub in the garden began to <w>re-bloom</w>."
                            }
                        },
                        {
                            "text": "Sommige planten kunnen in één seizoen twee keer <w>verbloemen</w>.",
                            "target_lang_translations": {
                                "en": "Some plants can <w>flower again</w> twice in one season."
                            }
                        }
                    ],
                    "synonyms": [
                        "herbloeien"
                    ],
                    "antonyms": [
                        "verwelken"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In deze betekenis zelden meer gebruikt in modern Nederlands."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To bloom again or bear flowers for a second time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "re-bloom",
                                "target_lang_sense_clarification": "to produce flowers again"
                            },
                            {
                                "target_lang_word": "flower again",
                                "target_lang_sense_clarification": "to bloom for a second time"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}