                        "examples": [
                            {
                                "example_id": "12df21ea-ea33-4d81-bf5f-b769b79994f9",
                                "sense_id": "4bb8b8db-22b6-3530-92e6-4ea425c3ccf5",
                                "text": "De jachthaven werd ontwikkeld door durfinvesteerder Willem Smit en René Coltof, die later loopjongen werd van de in 2004 vermoorde vastgoedman Willem Endstra. De haven werd in 1994 geopend. Endstra nam de haven na enkele jaren over. Een commercieel succes werd het nooit. Dat voedde speculaties dat Endstra de haven voor criminele doeleinden gebruikte."
                            },
                            {
                                "example_id": "d3d0b005-4e8a-4ee2-af71-9c8918ec09f3",
                                "sense_id": "4bb8b8db-22b6-3530-92e6-4ea425c3ccf5",
                                "text": "Knapen was eerder bestuurder van PCM-uitgevers. Dat concern bleef met een grote schuld achter, nadat durfinvesteerder Apax belangen in het bedrijf had genomen. De Ondernemingskamer oordeelde in mei dat PCM zich schuldig heeft gemaakt aan wanbeleid."
                            }
                        ]
                    }
