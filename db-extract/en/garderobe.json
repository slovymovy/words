                                "target_senses": [
                                    {
                                        "sense_id": "2abd6ea1-bb91-3ee4-9a48-de1dc397fac5",
                                        "entry_id": "caf5dae1-877b-302b-9c5e-89912383322b",
                                        "glosses": [
                                            "Toilettenanlage in mittelalterlichen Burgen, die als nischenartiger Abtritt mit schräg nach außen führendem Mauerkanal oder als weit über die Mauer hinausreichender Aborterker ausgeführt waren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42137598-b452-48d2-86a5-793c273ae8e8",
                                                "sense_id": "2abd6ea1-bb91-3ee4-9a48-de1dc397fac5",
                                                "text": "„Als Toiletten dienten meist Aborterker an den Außenmauern mit einem schlichten Loch im Boden.“"
                                            },
                                            {
                                                "example_id": "0e0d87ce-f7de-4402-b11a-724e5f5fa0b5",
                                                "sense_id": "2abd6ea1-bb91-3ee4-9a48-de1dc397fac5",
                                                "text": "„Und weil es vielen Bewohnern zu mühsam erschien, die Aborterker im Freien aufzusuchen, kippten sie einfach den Inhalt ihrer Nachttöpfe aus den Fenstern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
