                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26edd5b2-9a90-477c-80ba-334c02416cad",
                        "source_entry_id": "0e596b6a-0a06-365a-bc83-cc6fb203096c",
                        "source_sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                        "source_sense_description": "jemand, der sich der Ausführung einer Aufgabe entzieht",
                        "target_lang_word": "tire-au-flanc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tire-au-flanc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d954654-17aa-30e7-b0ef-88b63a20d0fd",
                                        "entry_id": "7f7ceb1b-ecb1-3537-885b-e937ff6243d7",
                                        "glosses": [
                                            "ou Quelqu’un qui cherche à échapper à une tâche, à un travail, à une corvée."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "180fb127-9506-46b5-86d6-ff5e3fd7d0e7",
                                                "sense_id": "2d954654-17aa-30e7-b0ef-88b63a20d0fd",
                                                "text": "Assimilés à des parasites suçant le lait déjà avarié de notre Hexagone déclinant, tantôt à des tire-au-flanc dont le poil dans la main prendrait, à écouter leurs contempteurs plus remontés que des coucous suisses, des allures de poutre de Bamako, ils sont devenus l'ennemi public numéro un."
                                            },
                                            {
                                                "example_id": "df8ccb9b-d7be-4d69-8098-afc2ed9d76f4",
                                                "sense_id": "2d954654-17aa-30e7-b0ef-88b63a20d0fd",
                                                "text": "Mais il fallait bien t’apporter ta feuille de température, non ? C’est quand même indispensable pour reconnaître les vrais malades des tire-au-flanc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32ecf882-9b6d-4e73-b493-f1b2cbb40ea0",
                        "source_entry_id": "0e596b6a-0a06-365a-bc83-cc6fb203096c",
                        "source_sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                        "source_sense_description": "jemand, der sich der Ausführung einer Aufgabe entzieht",
                        "target_lang_word": "fainéant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fainéant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00282551-0c23-363c-a6e0-69a4e9c54174",
                                        "entry_id": "ddde963b-8cd4-3988-9b21-c64c3380a96a",
                                        "glosses": [
                                            "Qui évite l’effort ou le travail, par paresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9245a2dc-c310-4235-b356-6b19af2715c1",
                                                "sense_id": "00282551-0c23-363c-a6e0-69a4e9c54174",
                                                "text": "Enfant fainéant."
                                            },
                                            {
                                                "example_id": "a68893bf-7834-4ba0-becd-d1b3fcecfde4",
                                                "sense_id": "00282551-0c23-363c-a6e0-69a4e9c54174",
                                                "text": "Chatte fainéante."
                                            },
                                            {
                                                "example_id": "739f9f79-f919-4dab-b6ae-687776c0fe4e",
                                                "sense_id": "00282551-0c23-363c-a6e0-69a4e9c54174",
                                                "text": "Je me suis trouvé un soir face à face avec mon père qui passait. Il m’a insulté, d’un mot, d’un geste.\n« Te voilà, fainéant ? »\nEt il a continué son chemin.\nFainéant ? — Ah ! j’avais envie de courir après lui et de lui demander pourquoi il m’avait jeté entre les dents, et sans me regarder en face, ce mot qui me faisait mal !"
                                            },
                                            {
                                                "example_id": "d62f66d6-e258-4403-9f47-975d94055f3c",
                                                "sense_id": "00282551-0c23-363c-a6e0-69a4e9c54174",
                                                "text": "Suzanne est plus joyeuse et plus dure que de coutume. On dirait que l’approche du danger la redresse et l’enivre. Je la sens prête à toutes les ruses, à tous les dévouements, à toutes les méchancetés utiles. Son impatience est batailleuse. La mienne est triste est fainéante à souhait."
                                            },
                                            {
                                                "example_id": "760c7ab4-6fb7-4f62-bfc1-a79d6ce4fdd3",
                                                "sense_id": "00282551-0c23-363c-a6e0-69a4e9c54174",
                                                "text": "Rois fainéants : dans l’histoire de France, certains rois qui abandonnaient l’exercice du pouvoir aux maires du palais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fainéant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22b4f4a4-2dfb-3742-9381-43e50c69347a",
                                        "entry_id": "77f56f95-fac7-3cb5-9b4a-816ba25d2de7",
                                        "glosses": [
                                            "Celui qui ne veut rien faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce0d5976-b2d6-4ceb-a54b-9bcb65c105d2",
                                                "sense_id": "22b4f4a4-2dfb-3742-9381-43e50c69347a",
                                                "text": "C’est ce fainéant de Gilbert, qui n’est bon à rien qu’à lire et rêvasser."
                                            },
                                            {
                                                "example_id": "66dbac86-6000-46e8-9a28-4cc7ac4e9455",
                                                "sense_id": "22b4f4a4-2dfb-3742-9381-43e50c69347a",
                                                "text": "Les chômeurs ne sont plus considérés comme des gens, mais comme des esclaves que l'on peut tuer, les faire crever de faim, les obliger à travailler contre leur patrie, les humilier, ça ne fait rien, ce sont des « fainéants »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
