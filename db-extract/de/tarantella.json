                "senses": [
                    {
                        "sense_id": "30bbcab5-8d51-320f-a780-925894191a1c",
                        "entry_id": "66f5d1ed-cc39-3d9f-a9f1-0d3ebb2fcae7",
                        "glosses": [
                            "lebhafter italienischer Volkstanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c62aa6-7b19-4c44-abd8-28c868d7fb21",
                                "sense_id": "30bbcab5-8d51-320f-a780-925894191a1c",
                                "text": "„Als die erste Tarantella angestimmt wurde, tobte der ganze Saal, alle sangen mit und lachten fröhlich.“"
                            },
                            {
                                "example_id": "9c346746-bfec-41f6-915e-d68904e4cc6b",
                                "sense_id": "30bbcab5-8d51-320f-a780-925894191a1c",
                                "text": "„Er beobachtete seinen Boss, einen dicken Mann mittleren Alters namens Peter Clemenza, der auf der Tanzfläche die jungen Mädchen in einer ausgelassenen Tarantella schwenkte.“"
                            },
                            {
                                "example_id": "f2de188d-51dc-43f5-ad0a-a7650072ee92",
                                "sense_id": "30bbcab5-8d51-320f-a780-925894191a1c",
                                "text": "„Der Schulamtsleiter lächelte und ließ sein übergeschlagenes Bein im Takt der Tarantella wippen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dceb403c-8484-4956-aeac-c0aba5e4322b",
