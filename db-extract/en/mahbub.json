                    {
                        "sense_id": "2c9e633c-09e5-3bcb-bee2-64340c0d3f22",
                        "entry_id": "15d0c3b6-6e74-355d-b6a7-d987f02e8ae0",
                        "glosses": [
                            "A gold coin used in the Ottoman Empire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0685d5b6-5356-4c0f-89a8-b842e7e24026",
                                "sense_id": "2c9e633c-09e5-3bcb-bee2-64340c0d3f22",
                                "text": "The only coins allowed by the Turkish government to be struck at Cairo are the Mahbub (or Zermahbub) Sequins, and Medini."
                            },
                            {
                                "example_id": "d1bc4a82-2ff9-497f-9231-982cddd8f414",
                                "sense_id": "2c9e633c-09e5-3bcb-bee2-64340c0d3f22",
                                "text": "His ready cash consisted of eight hundred thousand mahbub and funduclys; the rest of his treasure was in jewels, to the amount of about six million of ducats."
                            },
                            {
                                "example_id": "8ea18705-0cb5-40c4-8565-47ca3c3d6733",
                                "sense_id": "2c9e633c-09e5-3bcb-bee2-64340c0d3f22",
                                "text": "At Grand Cairo in Egypt, contracts are made in funducli and mahbub sequins; the former are reckoned at 146 medini, and 3 mahbubs are equal to 4 pataccas, so that the mahbub is worth 120 medini."
                            }
                        ]
                    }
