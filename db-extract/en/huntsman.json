                    {
                        "sense_id": "747b3a11-690a-33ad-9bca-9bfef8aea169",
                        "entry_id": "9011ffa5-d233-3b5f-bb40-8423530698a0",
                        "glosses": [
                            "One who manages the hounds during a hunt."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c02dd2d2-7adc-3aa0-8366-49a059f70d44",
                        "entry_id": "9011ffa5-d233-3b5f-bb40-8423530698a0",
                        "glosses": [
                            "Any of the many species of large spiders of the family Sparassidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b384fa-4158-4adb-8547-7017beb77ba8",
                                "sense_id": "c02dd2d2-7adc-3aa0-8366-49a059f70d44",
                                "text": "Although they do not make webs, female huntsmans at least have not lost the ability to produce silk."
                            },
                            {
                                "example_id": "85dce937-5727-461c-b462-46c3fd3efc49",
                                "sense_id": "c02dd2d2-7adc-3aa0-8366-49a059f70d44",
                                "text": "The majority of desert-dwelling spiders are large burrowing spiders; the Barking Spiders Selenoeosmia stirlingi, mouse spiders, wolf spiders (Fig. 5.47), huntsmen and trapdoor spiders (Fig. 5.48)."
                            },
                            {
                                "example_id": "03c3d0ca-e819-421c-b328-38276b803f1b",
                                "sense_id": "c02dd2d2-7adc-3aa0-8366-49a059f70d44",
                                "text": "to say trapdoors and huntsmans"
                            },
                            {
                                "example_id": "c4821120-7eab-4493-a32d-0fd2b0f308bf",
                                "sense_id": "c02dd2d2-7adc-3aa0-8366-49a059f70d44",
                                "text": "Two huntsmen spiders prowl Harry′s bedroom ceiling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
