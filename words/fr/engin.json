                    "frequency": "High",
                    "semantic_group_id": "machine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ouvrier conduit un puissant <w>engin</w> pour dégager les gravats sur la route.",
                            "target_lang_translations": {
