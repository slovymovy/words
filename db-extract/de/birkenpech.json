                                        "entry_id": "427ce67a-6107-3448-9340-e24927572f1e",
                                        "glosses": [
                                            "A substance (liquid when heated) derived from dry distillation of birch bark, and composed of phenols such as guaiacol, cresol, xylenol and creosol."
                                        ],
                                        "tags": [],
