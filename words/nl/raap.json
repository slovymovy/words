                            }
                        },
                        {
                            "text": "Als er spullen vallen, <w>raap</w> ik ze meteen van de grond.",
                            "target_lang_translations": {
                                "en": "When things fall, I immediately <w>pick</w> them <w>up</w> from the floor."
                            }
