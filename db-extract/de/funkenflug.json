                ],
                "senses": [
                    {
                        "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                        "entry_id": "ed8d27c7-9ef6-321b-8b7d-af275273940c",
                        "glosses": [
                            "Plural selten, auch Funken, die durch Luftströmung von einer Brand- oder Feuerstelle (immerzu) fortgetragen werden"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "346abf1f-64f4-458e-93e3-2c8dbf67fddd",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Ein Funkenflug habe mit großer Wahrscheinlichkeit den Waldbrand ausgelöst, so die Polizei.“"
                            },
                            {
                                "example_id": "4e7f4396-46c8-410a-8ed0-e3a2abe10569",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Auch könnte es sein, dass Funkenflug bei Schweissarbeiten den Brand auslöste.“"
                            },
                            {
                                "example_id": "07a6ee68-76d7-408c-85c4-cec80fc2a71e",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Als ihr Geschäftsführer mit einer Trennscheibe Arbeiten in dem Holzbau durchführte, kam es zum Funkenflug und Entzündung des Gebäudes.“"
                            },
                            {
                                "example_id": "d24b89ab-7e20-45ee-804c-5641448aa884",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Im Beispiel der funkensprühenden Lokomotiven wird auch nicht angenommen, daß der Bauer eine Obliegenheit hat, die Erfüllung der Pflicht, bestimmte den Funkenflug reduzierende Geräte in die Lokomotiven einzubauen, zu überwachen.“"
                            },
                            {
                                "example_id": "68dd0caf-0659-44a7-b27f-ccd1616a01ca",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Mischt man sie in Kunststoffe, werden diese elektrisch leitfähig und eignen sich damit für Plastikumhüllungen, die sich nicht mehr elektrostatisch aufladen, wodurch ein Funkenflug verhindert wird.“"
                            },
                            {
                                "example_id": "9120d688-d33a-419c-a799-20b60e0e96f3",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Als weniger hinderlich erwies sie sich nach dem Krieg jedoch für den politischen Funkenflug.“"
                            },
                            {
                                "example_id": "5a887311-9d2d-46cf-811f-be701a66a49b",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Zu einem weit tieferen Riss in der Front der evangelischen Bewegung führte der Bauernkrieg. Dieser Aufstand, der Ende 1524 ausbrach und dessen letzte Funkenflüge noch 1526 den Obrigkeiten Angst einflößten, wuchs sich zu einem Brand aus, der sich schließlich über weite Teile Deutschlands erstreckte.“"
                            },
                            {
                                "example_id": "064431de-af9f-4e22-b843-0670668d5077",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Meine Nervenenden spielen verrückt, und Botschaften rasen so schnell und gewaltig überall durch meinen Körper, dass ich sie förmlich als Funkenflüge spüren kann.“"
                            },
                            {
                                "example_id": "d43dec00-e0a8-45f8-a435-f9daf9a86579",
                                "sense_id": "a8282c2e-0d75-3a68-9f65-949ea50120a3",
                                "text": "„Die wärmere Luft ließ sich leichter ertragen und setzte Impulse in den Körpern frei, die lange im Unterbewusstsein gedämmert und nur ganz selten wie Funkenflüge das gespürte Sein berührt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
