{
    "word_family": [
        "gauntness",
        "gauntly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "692f24a9-ae18-3000-a32a-7be4267593fa",
                    "sense_definition": "Extremely thin and bony, especially from illness, hunger, or distress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "thin_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After weeks in the hospital with a severe fever, he looked terribly pale and <w>gaunt</w>.",
                            "target_lang_translations": {
                                "ru": "После недель в больнице с сильнейшим жаром он выглядел ужасно бледным и <w>измождённым</w>."
                            }
                        },
                        {
                            "text": "The stray dog was so <w>gaunt</w> that its ribs were visible through its matted coat.",
                            "target_lang_translations": {
                                "ru": "Бродячая собака была настолько <w>исхудавшей</w>, что её рёбра просвечивали сквозь свалявшуюся шерсть."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrawny",
                        "skinny",
                        "scraggy"
                    ],
                    "antonyms": [
                        "strapping"
                    ],
                    "common_phrases": [
                        "gaunt face",
                        "gaunt figure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно худой, измождённый и костлявый, особенно вследствие болезни, голода или страданий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исхудалый",
                                "target_lang_sense_clarification": "сильно потерявший в весе из-за голода или болезни"
                            },
                            {
                                "target_lang_word": "измождённый",
                                "target_lang_sense_clarification": "крайне истощённый, изнурённый"
                            },
                            {
                                "target_lang_word": "исхудавший",
                                "target_lang_sense_clarification": "осунувшийся и истончавший"
                            },
                            {
                                "target_lang_word": "тощий",
                                "target_lang_sense_clarification": "болезненно худой, с выступающими костями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0798c6f-815e-306b-ad84-a1813c3d44b2",
                    "sense_definition": "Angular, bony, and lean in physical structure or appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thin_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall man had a <w>gaunt</w> frame that made his oversized black suit hang loosely.",
                            "target_lang_translations": {
                                "ru": "У высокого мужчины было <w>сухопарое</w> телосложение, из-за чего великоватый чёрный костюм висел на нём мешком."
                            }
                        },
                        {
                            "text": "The <w>gaunt</w> branches of the leafless trees stretched upward against the darkening winter sky.",
                            "target_lang_translations": {
                                "ru": "<w>Костлявые</w> ветви голых деревьев тянулись вверх на фоне темнеющего зимнего неба."
                            }
                        }
                    ],
                    "synonyms": [
                        "lean",
                        "lank",
                        "rangy"
                    ],
                    "common_phrases": [
                        "tall and gaunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угловатый, костлявый и сухопарый по телосложению или внешнему виду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костлявый",
                                "target_lang_sense_clarification": "угловатый, с выступающими костями"
                            },
                            {
                                "target_lang_word": "сухопарый",
                                "target_lang_sense_clarification": "худой, поджарый и жилистый"
                            },
                            {
                                "target_lang_word": "худой",
                                "target_lang_sense_clarification": "лишённый полноты, сухой по сложению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88a0f767-5f25-34a0-acdc-337b31ff2800",
                    "sense_definition": "Desolate, grim, and bleak in appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bleakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>gaunt</w> stone fortress stood entirely abandoned on top of the barren cliff.",
                            "target_lang_translations": {
                                "ru": "<w>Мрачная</w> каменная крепость стояла совершенно заброшенной на вершине бесплодной скалы."
                            }
                        },
                        {
                            "text": "The empty warehouse was cold and <w>gaunt</w>, with rain leaking through broken skylights.",
                            "target_lang_translations": {
                                "ru": "Пустой склад был холодным и <w>угрюмым</w>, а сквозь разбитые фонари на крыше протекал дождь."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to describe places or objects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мрачный, унылый, суровый и пустынный по виду (о местах, пейзажах или зданиях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "унылый и суровый на вид"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "неприветливый, холодный и угрюмый"
                            },
                            {
                                "target_lang_word": "угрюмый",
                                "target_lang_sense_clarification": "пустынный и навевающий тоску"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c23f26b-8616-3185-bccd-e8ae3af7144e",
                    "sense_definition": "Harsh, eerie, or hollow, suggesting bleakness or desolation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bleakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>gaunt</w> cry echoed through the dark, abandoned tunnels of the old mine.",
                            "target_lang_translations": {
                                "ru": "<w>Глухой</w> крик эхом разнёсся по тёмным заброшенным туннелям старой шахты."
                            }
                        },
                        {
                            "text": "The wind produced a <w>gaunt</w> whistle as it rushed through the cracked window panes.",
                            "target_lang_translations": {
                                "ru": "Ветер издавал <w>заунывный</w> свист, прорываясь сквозь треснувшие оконные стёкла."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used to describe sounds"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий, жуткий, глухой или заунывный, навевающий ощущение пустоты и уныния (о звуках)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухой",
                                "target_lang_sense_clarification": "звучащий глухо, зловеще или пустотно"
                            },
                            {
                                "target_lang_word": "заунывный",
                                "target_lang_sense_clarification": "тоскливый, протяжный и мрачный"
                            },
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "устрашающий и пугающий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bc56869-2481-39ac-a2a8-bb1e41fbf8e3",
                    "sense_definition": "Ravenous, hungry, or greedy for food or plunder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The predator prowled through the dark woods, <w>gaunt</w> for its next meal.",
                            "target_lang_translations": {
                                "ru": "Хищник рыскал по тёмному лесу, <w>изголодавшись</w> по новой добыче."
                            }
                        },
                        {
                            "text": "The invaders were described as wolves, <w>gaunt</w> for the riches of the fallen city.",
                            "target_lang_translations": {
                                "ru": "Захватчиков описывали как волков, <w>алчущих</w> богатств павшего города."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historically used in the sense of ravenous or greedy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ненасытный, изголодавшийся или жадный до еды или добычи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изголодавшийся",
                                "target_lang_sense_clarification": "крайне голодный, истосковавшийся по пище"
                            },
                            {
                                "target_lang_word": "алчущий",
                                "target_lang_sense_clarification": "жаждущий добычи или поживы"
                            },
                            {
                                "target_lang_word": "ненасытный",
                                "target_lang_sense_clarification": "не могущий насытиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0109ce3-73c8-3213-a245-ca7a557b6dd7",
                    "sense_definition": "Slender, slim, or not overweight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "thin_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took great care with his diet, hoping to maintain a <w>gaunt</w> and graceful form.",
                            "target_lang_translations": {
                                "ru": "Он очень внимательно следил за диетой, надеясь сохранить <w>стройную</w> и грациозную фигуру."
                            }
                        },
                        {
                            "text": "By the end of the long march, the greyhound remained entirely healthy, though naturally <w>gaunt</w>.",
                            "target_lang_translations": {
                                "ru": "К концу долгого перехода борзая оставалась абсолютно здоровой, хотя и была от природы <w>поджарой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slender",
                        "slim",
                        "svelte"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used with a positive or neutral connotation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стройный, тонкий, поджарый (без негативной коннотации)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стройный",
                                "target_lang_sense_clarification": "изящный и тонкий"
                            },
                            {
                                "target_lang_word": "поджарый",
                                "target_lang_sense_clarification": "подтянутый, мускулистый и без лишнего веса"
                            },
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "худощавый и гибкий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1c464034-73ac-32f7-9e23-9cf197da0f0d",
                    "sense_definition": "An English surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "John of <w>Gaunt</w> was an influential royal figure in fourteenth-century English history.",
                            "target_lang_translations": {
                                "ru": "Джон <w>Гонт</w> был влиятельной персоной королевского происхождения в истории Англии четырнадцатого века."
                            }
                        },
                        {
                            "text": "The local library holds several historical records concerning the prominent <w>Gaunt</w> family.",
                            "target_lang_translations": {
                                "ru": "В местной библиотеке хранится несколько исторических документов, касающихся известной семьи <w>Гонт</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гонт",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06de93f5-4772-3e1d-8474-9b4ee18ade8b",
                    "sense_definition": "Obsolete form of <w>Ghent</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Historical chronicles often refer to the Belgian city of Ghent as <w>Gaunt</w>.",
                            "target_lang_translations": {
                                "ru": "В исторических хрониках бельгийский город Гент нередко упоминается как <w>Гонт</w>."
                            }
                        },
                        {
                            "text": "The medieval merchant traveled from London to <w>Gaunt</w> to trade wool.",
                            "target_lang_translations": {
                                "ru": "Средневековый купец отправился из Лондона в <w>Гент</w>, чтобы торговать шерстью."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical English name for Ghent"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее английское название города Гент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гент",
                                "target_lang_sense_clarification": "город в Бельгии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}