                    },
                    {
                        "form_id": "005736d2-e247-43cd-af74-1e6dff3cc948",
                        "entry_id": "2ea8f5c2-774c-3ba7-9282-985c388ddb6d",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "азиа́тках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da2018ba-fa79-3ecb-94e1-6012372cbad6",
                        "entry_id": "2ea8f5c2-774c-3ba7-9282-985c388ddb6d",
                        "glosses": [
                            "женск. к азиат; представительница одного из народов Азии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9efc4d6f-bff4-40de-bf1d-b459b6e0d175",
                                "sense_id": "da2018ba-fa79-3ecb-94e1-6012372cbad6",
                                "text": "Азиатки смуглые, за исключением китаянок, настоящих, конечно, не маньчжурок из северных провинций."
                            },
                            {
                                "example_id": "a764963a-9ccc-44be-8c90-06173e6b8471",
                                "sense_id": "da2018ba-fa79-3ecb-94e1-6012372cbad6",
                                "text": "Я убирать, готовить, Александр Григорьевич, два раза неделя, – объясняет мне на ломаном русском эта азиатка, подняв руки, на случай, если я в неё ещё что-нибудь соберусь запустить."
                            }
                        ]
                    },
                    {
                        "sense_id": "df81dbf3-64bb-322f-9196-73463766b89c",
                        "entry_id": "2ea8f5c2-774c-3ba7-9282-985c388ddb6d",
                        "glosses": [
                            "жительница или уроженка Азии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10600c4d-14aa-4725-a968-7ec49e0aab45",
                                "sense_id": "df81dbf3-64bb-322f-9196-73463766b89c",
                                "text": ".. Жанна Нгуэн-Гок, единственная дочь нового Шолонского Фу, — странное и таинственное маленькое существо; не знаешь, что она такое: европейка или азиатка."
                            },
                            {
                                "example_id": "a6d9059e-00d7-40a8-bbbd-e9bd8421a8fa",
                                "sense_id": "df81dbf3-64bb-322f-9196-73463766b89c",
                                "text": "Происхождения моего ни я сам, ни подданные мои не знают, .. женщина же по платью казалась азиатка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fed878a-9473-4a65-b9a5-45cc9044f1f9",
                        "source_entry_id": "2ea8f5c2-774c-3ba7-9282-985c388ddb6d",
                        "target_lang_word": "Asiatin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asiatin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8cf1cad-f9f3-338b-a8e6-a3c31059e837",
                                        "entry_id": "2dd9b297-ef8f-359c-bd58-17714de32876",
                                        "glosses": [
                                            "Bewohnerin von Asien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "281daebc-ec0a-43a4-b9fc-4d473993084e",
                                                "sense_id": "c8cf1cad-f9f3-338b-a8e6-a3c31059e837",
                                                "text": "Die schönsten Frauen der Welt sind Asiatinnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93255b39-3306-4289-828a-7d33710ca0c7",
                        "source_entry_id": "2ea8f5c2-774c-3ba7-9282-985c388ddb6d",
                        "target_lang_word": "Asiatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asiatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "434c3d3f-2559-3010-9273-237b6568ac71",
                                        "entry_id": "0b9aa9b8-aaae-39c4-97d5-662c1ff2dc17",
                                        "glosses": [
                                            "Personne habitant ou issue d’Asie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8fadfdb-fafa-417c-831e-735a3df496d4",
                                                "sense_id": "434c3d3f-2559-3010-9273-237b6568ac71",
                                                "text": "L’homme de la rue, lui, comprend qu’un géant vient d’entrer en scène, sur sa scène. Qu’il s’oppose à un autre géant. Et que lui — Européen, Asiatique ou Africain — est dominé par le combat que ces deux cyclopes commencent par-dessus sa tête."
                                            },
                                            {
                                                "example_id": "4801ad53-bf21-42ab-a60a-649e162ceda0",
                                                "sense_id": "434c3d3f-2559-3010-9273-237b6568ac71",
                                                "text": "Ici, les gens parlaient d’incendies et de massacres, de cruautés et de représailles, du meurtre d’inoffensifs Asiatiques par des tourbes que déchaînait la haine de race […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
