{
    "word_family": [
        "stone",
        "stoniness",
        "stony"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5ea3e8f9-ea7b-3369-b2ef-c67894b5f5b1",
                    "sense_definition": "Under the influence of drugs, especially cannabis.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We got <w>stoned</w> and ate four bags of potato chips.",
                            "target_lang_translations": {
                                "pl": "Byliśmy <w>upaleni</w> i zjedliśmy cztery paczki chipsów."
                            }
                        },
                        {
                            "text": "They were <w>stoned</w> in the park all afternoon.",
                            "target_lang_translations": {
                                "pl": "Przez całe popołudnie byli <w>upaleni</w> w parku."
                            }
                        }
                    ],
                    "synonyms": [
                        "baked",
                        "blazed",
                        "high",
                        "wasted"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "get stoned"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Będący pod wpływem narkotyków, zwłaszcza marihuany."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "naćpany",
                                "target_lang_sense_clarification": "potoczne określenie osoby pod wpływem narkotyków"
                            },
                            {
                                "target_lang_word": "upalony",
                                "target_lang_sense_clarification": "specyficzne określenie osoby pod wpływem marihuany"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6382b3a-195e-34ab-bb09-e3da476f8c8a",
                    "sense_definition": "Intoxicated by alcohol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so <w>stoned</w> on whiskey that he could barely stand up.",
                            "target_lang_translations": {
                                "pl": "Był tak <w>pijany</w> whisky, że ledwo mógł ustać na nogach."
                            }
                        },
                        {
                            "text": "The party guests were completely <w>stoned</w> by midnight.",
                            "target_lang_translations": {
                                "pl": "Goście na przyjęciu byli kompletnie <w>pijani</w> przed północą."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "hammered",
                        "sloshed"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Będący pod wpływem alkoholu, pijany."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pijany",
                                "target_lang_sense_clarification": "ogólne określenie stanu nietrzeźwości"
                            },
                            {
                                "target_lang_word": "nawalony",
                                "target_lang_sense_clarification": "bardzo potoczne i wulgarne określenie silnego upojenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "868d6aaf-51f8-3a11-aba3-3151d67e5eea",
                    "sense_definition": "Feeling extremely happy or excited, as if intoxicated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>stoned</w> on the joy of her new success.",
                            "target_lang_translations": {
                                "pl": "Była <w>oszołomiona</w> radością ze swojego nowego sukcesu."
                            }
                        },
                        {
                            "text": "He looked <w>stoned</w> on life after his long vacation.",
                            "target_lang_translations": {
                                "pl": "Wyglądał na <w>oszołomionego</w> życiem po swoich długich wakacjach."
                            }
                        }
                    ],
                    "synonyms": [
                        "elated",
                        "euphoric"
                    ],
                    "common_phrases": [
                        "stoned on life"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odczuwający ogromne szczęście lub ekscytację, jakby w stanie odurzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oszołomiony",
                                "target_lang_sense_clarification": "pod wpływem silnych emocji"
                            },
                            {
                                "target_lang_word": "uradowany",
                                "target_lang_sense_clarification": "bardzo szczęśliwy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9677562d-78dc-3574-bc59-b072cd572be1",
                    "sense_definition": "Containing stones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soil in this garden is very <w>stoned</w> and hard to dig.",
                            "target_lang_translations": {
                                "pl": "Gleba w tym ogrodzie jest bardzo <w>kamienista</w> i trudna do przekopania."
                            }
                        },
                        {
                            "text": "We found a <w>stoned</w> area near the riverbank.",
                            "target_lang_translations": {
                                "pl": "Znaleźliśmy <w>kamienisty</w> teren w pobliżu brzegu rzeki."
                            }
                        }
                    ],
                    "synonyms": [
                        "stony"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zawierający kamienie, kamienisty."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kamienisty",
                                "target_lang_sense_clarification": "o podłożu pełnym kamieni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb51db1d-9ef7-3969-a212-2c79b7d6440d",
                    "sense_definition": "Having had the stones or pits removed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use <w>stoned</w> cherries for this fruit cake recipe.",
                            "target_lang_translations": {
                                "pl": "Do tego przepisu na ciasto owocowe użyj <w>drylowanych</w> wiśni."
                            }
                        },
                        {
                            "text": "The olives were <w>stoned</w> before being added to the salad.",
                            "target_lang_translations": {
                                "pl": "Oliwki zostały <w>wydrylowane</w> przed dodaniem do sałatki."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitted"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozbawiony pestek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drylowany",
                                "target_lang_sense_clarification": "o owocach, z których usunięto pestki"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3db07fcf-5be5-37b9-8bd7-bf2c9df9fdd1",
                    "sense_definition": "Simple past and past participle of <w>stone</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd <w>stoned</w> the criminal as he walked through the square.",
                            "target_lang_translations": {
                                "pl": "Tłum <w>ukamienował</w> przestępcę, gdy przechodził przez plac."
                            }
                        },
                        {
                            "text": "The path had been <w>stoned</w> to prevent mud from forming.",
                            "target_lang_translations": {
                                "pl": "Ścieżka została <w>wyłożona kamieniami</w>, aby zapobiec powstawaniu błota."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'kamienować' lub 'wykładać kamieniami'."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ukamienowany",
                                "target_lang_sense_clarification": "w kontekście kary śmierci przez rzucanie kamieniami"
                            },
                            {
                                "target_lang_word": "wyłożony kamieniami",
                                "target_lang_sense_clarification": "w kontekście utwardzania nawierzchni"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}