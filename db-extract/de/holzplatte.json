                "senses": [
                    {
                        "sense_id": "2a1701e3-8a30-3d1f-8a2f-595cc0a756eb",
                        "entry_id": "2b30cb10-34fa-3653-b599-2bd778e50709",
                        "glosses": [
                            "Platte aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f1cd487-3875-473e-bb01-bd7acca2057a",
                                "sense_id": "2a1701e3-8a30-3d1f-8a2f-595cc0a756eb",
                                "text": "„Das Loch im Kellerfenster wurde zunächst mit einer Holzplatte gesichert.“"
                            },
                            {
                                "example_id": "428a9164-538a-4d30-b471-037b327e2189",
                                "sense_id": "2a1701e3-8a30-3d1f-8a2f-595cc0a756eb",
                                "text": "„In der Mitte zwischen den Regalen steht ein länglicher Tisch mit Stehlampe; seine relativ große Holzplatte bleibt gänzlich leer – bis auf die berühmte Phalanx penibel gespitzter Bleistifte, etwa ein gutes Dutzend oder mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
