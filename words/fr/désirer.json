            "senses": [
                {
                    "sense_id": "d6ddf686-8ddd-3abc-a768-612992c715fc",
                    "sense_definition": "Avoir la volonté ou le souhait d'obtenir ou de faire quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "souhait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Que <w>désirez</w>-vous boire avec votre repas ce midi ?"
                        },
                        {
                            "text": "Nous pouvons partir plus tôt si vous le <w>désirez</w> vraiment."
                        }
                    ],
                    "synonyms": [
                        "souhaiter",
                        "vouloir"
                    ],
                    "common_phrases": [
