                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9ff972f-6abe-3d2a-a9f2-4216a0ca9fa2",
                        "entry_id": "e17777cd-2cff-3deb-80a4-f3af255f0d22",
                        "glosses": [
                            "Progrès successif des fruits vers la maturité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1e956e5-5078-4b1d-a705-b9c750159ae0",
                                "sense_id": "c9ff972f-6abe-3d2a-a9f2-4216a0ca9fa2",
                                "text": "Ce temps est contraire à la maturation des fruits."
                            }
                        ]
                    },
                    {
                        "sense_id": "69965b42-be03-3e81-9caa-1aeaba0af616",
                        "entry_id": "e17777cd-2cff-3deb-80a4-f3af255f0d22",
                        "glosses": [
                            "Évolution, en parlant des tumeurs purulentes."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "a6d1481b-22f2-484f-926a-5d6b3ce93721",
                                "sense_id": "69965b42-be03-3e81-9caa-1aeaba0af616",
                                "text": "La maturation d’un abcès."
                            }
                        ]
                    },
                    {
                        "sense_id": "1363863a-892e-3a9b-9fd5-008f8d074823",
                        "entry_id": "e17777cd-2cff-3deb-80a4-f3af255f0d22",
                        "glosses": [
                            "Évolution, en parlant des produits de la pensée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6615a887-7504-4b0f-ad9c-fca5f8502489",
                                "sense_id": "1363863a-892e-3a9b-9fd5-008f8d074823",
                                "text": "Il sait que le temps, qui hâte la dissolution des empires vermoulus et du vieux monde, hâte aussi l’enfantement du monde nouveau et la maturation de ces grandes idées d’union, d’harmonie, de justice, d’amour qui germent dans le sein de l’humanité. Pendant que l’orage se déchaîne et renverse, il fonde; pendant que l’oppression fauche, il sème."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a45cc8c-b910-4519-9991-aec2d02cdf45",
                        "source_entry_id": "e17777cd-2cff-3deb-80a4-f3af255f0d22",
                        "target_lang_word": "Reifung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reifung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                        "entry_id": "a51492df-9718-3bfe-a73d-ae23c4c8c559",
                                        "glosses": [
                                            "die Erlangung der Reife; die Wandlung zur Reife"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96881e51-5353-4602-bf79-34a2e2f60d1a",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "Bei fast allen anderen Käsesorten bewirken Enzyme des Labs oder Milchsäurebakterien die Reifung."
                                            },
                                            {
                                                "example_id": "3ba430a3-d8ef-4b3d-b7c3-d05b9ea61b27",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "„Das Team um Amparo Acker-Palmer konnte die molekularen Komponenten identifizieren, die nach anfänglicher Signalgebung die Reifung dendritischer Dornen kontrollieren.“"
                                            },
                                            {
                                                "example_id": "ac665f8f-04b4-407c-9cae-3d54f4e4bb63",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "Reifung ist ein vom Gehirn zentral gesteuerter Entwicklungsprozeß, der sich in der Vervollkommnung einer Handlung (Aktion) oder Fähigkeit ohne jede Übung zeigt."
                                            },
                                            {
                                                "example_id": "5a1778c1-94f7-461e-b78d-3a1d46f6817a",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "Heute manipulieren Obsthändler regelmäßig die Reifung von Früchten, die auf Ethylen reagieren."
                                            },
                                            {
                                                "example_id": "7e64bbba-70cb-4369-8d22-475babbf454f",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "Die Funktion als Reproduktionsorgane bei der Bildung und Reifung der Gameten hängt von der Bildung und Ausschüttung von Releasing-Hormonen und von in der Hypophyse freigesetzten Steuerungshormonen ab, die ihrerseits die Bildung von Sexualhormonen in den Gonaden anregen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e89bcbd8-7eb0-4dee-88f4-b6d3ff712129",
                        "source_entry_id": "e17777cd-2cff-3deb-80a4-f3af255f0d22",
                        "target_lang_word": "Reifen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reifen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a40849c8-4a16-3fb5-a7da-23d73ca2f0ac",
                                        "entry_id": "1c431781-bd14-3124-abe8-4324ec599f05",
                                        "glosses": [
                                            "der auf der Felge liegende Teil eines Rades"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d88ea4-3048-4e1c-af95-54de754a87a7",
                                                "sense_id": "a40849c8-4a16-3fb5-a7da-23d73ca2f0ac",
                                                "text": "Vermehrt müssen die Reifen daran glauben und werden viel zu sehr abgefahren. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "53bcec47-c7e9-441e-8cef-bd1adc0cac90",
                                                "sense_id": "a40849c8-4a16-3fb5-a7da-23d73ca2f0ac",
                                                "text": "„Schon seit Jahren arbeiten Reifenhersteller daran, ihre Reifen umweltfreundlicher und nachhaltiger herzustellen.“"
                                            },
                                            {
                                                "example_id": "714fe725-c1e8-4da1-bdec-4fa77fb45d51",
                                                "sense_id": "a40849c8-4a16-3fb5-a7da-23d73ca2f0ac",
                                                "text": "„Dreck an Reifen und Kotflügeln kündete von Eifelfahrten, nachmittäglichen Reden vor der Jungen Union (›zusammenhalten, zusammenstehen, zusammen leiden‹).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29a8c300-376c-3889-be61-1d63a510fdc7",
                                        "entry_id": "1c431781-bd14-3124-abe8-4324ec599f05",
                                        "glosses": [
                                            "kreisförmiges Metallband zum Zusammenhalten von Fässern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a585829a-d42a-4b1c-9104-c88a99c8b712",
                                                "sense_id": "29a8c300-376c-3889-be61-1d63a510fdc7",
                                                "text": "Früher gab es den Beruf des Küfers, er stellte aus Dauben und Reifen Fässer her."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fb12ed79-aa68-3d03-815b-bec2dbcd87f8",
                                        "entry_id": "1c431781-bd14-3124-abe8-4324ec599f05",
                                        "glosses": [
                                            "ring- oder halbringförmiges Schmuckstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af55d7bd-c5c0-4c2d-9eb6-beadc02c0a27",
                                                "sense_id": "fb12ed79-aa68-3d03-815b-bec2dbcd87f8",
                                                "text": "Sie trug einen mit Rubinen besetzten Reifen im Haar."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f11cdfec-153c-318d-96a5-f3d97859549d",
                                        "entry_id": "1c431781-bd14-3124-abe8-4324ec599f05",
                                        "glosses": [
                                            "Kinderspielzeug, Hula-Hoop-Reifen"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0694d97-13e9-4095-b3f0-249cb12718fb",
                                                "sense_id": "f11cdfec-153c-318d-96a5-f3d97859549d",
                                                "text": "Nehmt die Reifen und den Ball und geht nach draußen spielen!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "cec7263b-2dda-3be8-8ca5-b193af17dc1a",
                                        "entry_id": "1c431781-bd14-3124-abe8-4324ec599f05",
                                        "glosses": [
                                            "Sport- und Gymnastikgerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cebf2482-cfe3-485d-8a03-aefca66ddbf6",
                                                "sense_id": "cec7263b-2dda-3be8-8ca5-b193af17dc1a",
                                                "text": "Bauchmuskulatur und Beckenboden trainieren wir mit Hilfsmitteln wie Reifen, Band und Ball."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
