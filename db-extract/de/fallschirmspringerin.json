                "senses": [
                    {
                        "sense_id": "4f6c3ae2-f6bb-3f76-8132-1daf16f3605c",
                        "entry_id": "76ab830e-f39f-318b-8e8a-a6369a7b5f8d",
                        "glosses": [
                            "weibliche Person, die unter Benutzung eines Fallschirms aus einem Flugzeug abspringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77feb7b6-0ae9-4de4-a5b9-70a81cfc1b6c",
                                "sense_id": "4f6c3ae2-f6bb-3f76-8132-1daf16f3605c",
                                "text": "Die Fallschirmspringerinnen machten sich für den Absprung bereit."
                            },
                            {
                                "example_id": "84e34dfb-0fa9-4d39-8c2d-7e7905c95fa3",
                                "sense_id": "4f6c3ae2-f6bb-3f76-8132-1daf16f3605c",
                                "text": "„In Krems-Gneixendorf ist Sonntagvormittag eine Fallschirmspringerin abgestürzt.“"
                            },
                            {
                                "example_id": "a77d72da-cf13-4eb0-90ea-8fa7ef757417",
                                "sense_id": "4f6c3ae2-f6bb-3f76-8132-1daf16f3605c",
                                "text": "„Eine deutsche Fallschirmspringerin ist beim Versuch gestorben, den Rekord für den größten Doppel-Formationssprung der Geschichte zu brechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
