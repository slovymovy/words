                "senses": [
                    {
                        "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                        "entry_id": "53c12b24-bc1b-3e88-a70d-b9811d97b4ec",
                        "glosses": [
                            "Bissverletzung, verursacht durch eine (Gift-)Schlange"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "428af15a-0abd-4085-9d75-fbbede13c411",
                                "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                                "text": "Er wurde wegen eines Schlangenbisses in ein Krankenhaus eingeliefert."
                            },
                            {
                                "example_id": "85cf7119-5feb-4ebc-9da3-e2c979aa6da1",
                                "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                                "text": "„Besonders in dörflichen Gesellschaften suchen viele Menschen nach einem Schlangenbiss traditionelle Heiler auf.“"
                            },
                            {
                                "example_id": "012f63cd-3451-408d-9f07-4d1fcca72341",
                                "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                                "text": "„Dem norwegischen Ethnografen Carl Sofus Lumholtz zufolge benutzten die Ureinwohner Nordamerikas Peyote, um körperliche Leiden wie Schlangenbisse, Skorpionstiche, Zahnschmerzen, Verbrennungen, Pfeilwunden oder Rheuma zu lindern.“"
                            },
                            {
                                "example_id": "354c2135-a557-4f13-8307-eeea22cedb5c",
                                "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                                "text": "„Es sah aus wie nach einem Schlangenbiss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "814ac354-33c1-432d-8065-ed36bc1e7e37",
                        "source_entry_id": "53c12b24-bc1b-3e88-a70d-b9811d97b4ec",
                        "source_sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                        "source_sense_description": "Bissverletzung, verursacht durch eine (Gift-)Schlange",
                        "target_lang_word": "snakebite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snakebite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dda74c39-2aad-38f6-a986-bfe8a5a6a33b",
                                        "entry_id": "3adb8803-691b-3ded-bfc7-c49c77b9ebcd",
                                        "glosses": [
                                            "The bite of a snake."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "366171d0-832b-4a8c-8952-14b91da78594",
                                                "sense_id": "dda74c39-2aad-38f6-a986-bfe8a5a6a33b",
                                                "text": "Mohamed's father said his son was a studious young man with a passion for soccer. \"He was someone that we all thought would go very far,\" he said. Mohamed was the third member of his family to suffer a fatal snakebite within 12 months."
                                            },
                                            {
                                                "example_id": "f9e9078f-712e-429d-b297-81f517788853",
                                                "sense_id": "dda74c39-2aad-38f6-a986-bfe8a5a6a33b",
                                                "text": "For Tim Friede, who's now the director of herpetology at Centivax, it's about helping the people impacted by venomous snakebites worldwide. When he heard that his antibodies had helped create this new antivenom cocktail, he says he was happy."
                                            },
                                            {
                                                "example_id": "50dc39b8-52ef-4545-9e3a-9b1b3dac9c13",
                                                "sense_id": "dda74c39-2aad-38f6-a986-bfe8a5a6a33b",
                                                "text": "The majority of snakebites occur on the hands, feet and ankles. […] Most modern over-the-counter snakebite kits consist of a suction device for drawing out venom from the bite wound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ab80731-f9fa-3971-9c91-14b923af4464",
                                        "entry_id": "3adb8803-691b-3ded-bfc7-c49c77b9ebcd",
                                        "glosses": [
                                            "A drink made by mixing hard cider and lager."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b339c8-79fd-4976-8752-bcf84d31975a",
                                                "sense_id": "5ab80731-f9fa-3971-9c91-14b923af4464",
                                                "text": "We agreed to go down to the bar and get a snakebite together, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ac6874e-402c-3043-9ac4-1be3f31a5513",
                                        "entry_id": "3adb8803-691b-3ded-bfc7-c49c77b9ebcd",
                                        "glosses": [
                                            "Either of a pair of lip piercings below the lower lip, resembling the fangs of a snake."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b4b624d-5902-475a-aa2f-30b2395dfe9c",
                                                "sense_id": "5ac6874e-402c-3043-9ac4-1be3f31a5513",
                                                "text": "Ellie recently got a navel piercing and snakebites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
