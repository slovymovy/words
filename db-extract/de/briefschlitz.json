                "senses": [
                    {
                        "sense_id": "4a3b7b5e-6020-3b70-80ed-c54f822159e0",
                        "entry_id": "dddcd75e-b3f1-36b1-8881-fbe6d7310c53",
                        "glosses": [
                            "schmale, längliche Öffnung, durch die Briefe und anderes Postgut eingeworfen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619f2bc6-2916-4e35-9293-950fbf061a4a",
                                "sense_id": "4a3b7b5e-6020-3b70-80ed-c54f822159e0",
                                "text": "„Im Briefschlitz steckte das Jeversche Wochenblatt, und auf dem Fußabstreifer lag die Bildzeitung, die sich Oma und Opa mit Kaufholds teilten.“"
                            },
                            {
                                "example_id": "2985dbca-a0a9-4fc9-a8bb-edc44d7a75c5",
                                "sense_id": "4a3b7b5e-6020-3b70-80ed-c54f822159e0",
                                "text": "„Es gab Wochen, in denen zwei Briefe durch den Briefschlitz fielen und die Mutter ihre Tochter fragte, ob sie sich in die Briefe oder den Briefschreiber verliebt habe.“"
                            },
                            {
                                "example_id": "a0e739b5-de68-4eb8-8740-6a9a4637a433",
                                "sense_id": "4a3b7b5e-6020-3b70-80ed-c54f822159e0",
                                "text": "„Sie erhielt die Bilder in einem weißen Umschlag, den jemand durch den Briefschlitz in der Tür gesteckt hatte.“"
                            },
                            {
                                "example_id": "76c865ba-32c2-47f5-9c47-2e6559162ff7",
                                "sense_id": "4a3b7b5e-6020-3b70-80ed-c54f822159e0",
                                "text": "„In einem Briefschlitz hing eine zur Hälfte hineingeschobene Zeitung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
