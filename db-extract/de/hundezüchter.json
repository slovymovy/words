                        "tags": [],
                        "examples": [
                            {
                                "example_id": "766a0494-a1a6-40bf-8cbb-8d780c7ce349",
                                "sense_id": "e72f9b3a-7376-327e-9443-7486d10b2ebf",
                                "text": "„Kobra hatte von seinem Polizeiinformanten erfahren, dass ein Hundezüchter namens Gen Sekine in der Nähe von Kumagaya im Verdacht stand, ein Serienmörder zu sein.“"
                            },
                            {
                                "example_id": "718ef5ab-bd10-46f6-9b47-d418bdfd74ee",
                                "sense_id": "e72f9b3a-7376-327e-9443-7486d10b2ebf",
                                "text": "„Ich hatte den Auftrag, das Zeitungsarchiv nach Informationen über den Hundezüchter und seine Tierhandlung mit dem eigenartigen Namen »Afrikanischer Zwinger« zu durchforsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
