{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef8a169b-e162-3d4c-8b80-a1920857501e",
                    "sense_definition": "A plant whose leaves and stems are covered with fine hairs that sting and cause an irritating rash when touched.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when walking through that overgrown path because it is full of <w>nettles</w>.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, когда идёшь по этой заросшей тропинке, ведь там полно <w>крапивы</w>."
                            }
                        },
                        {
                            "text": "She accidentally brushed against a <w>nettle</w> and developed a painful red rash on her leg.",
                            "target_lang_translations": {
                                "ru": "Она случайно задела <w>крапиву</w>, и на ноге появилась болезненная красная сыпь."
                            }
                        }
                    ],
                    "synonyms": [
                        "stinging nettle"
                    ],
                    "common_phrases": [
                        "stinging nettles",
                        "nettle tea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, стебли и листья которого покрыты волосками, вызывающими жжение и зудящую сыпь при прикосновении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крапива",
                                "target_lang_sense_clarification": "жгучее травянистое растение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "959552c8-ea71-3be3-8fba-195957f9214b",
                    "sense_definition": "To irritate, annoy, or provoke someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sarcastic comment clearly <w>nettled</w> her, though she tried to stay calm.",
                            "target_lang_translations": {
                                "ru": "Его саркастическое замечание явно <w>задело</w> её, хотя она и старалась сохранять спокойствие."
                            }
                        },
                        {
                            "text": "The manager was visibly <w>nettled</w> by the constant interruptions during the meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер был заметно <w>раздражён</w> постоянными прерываниями во время совещания."
                            }
                        }
                    ],
                    "synonyms": [
                        "irritate",
                        "vex",
                        "annoy",
                        "pique"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражать, злить или задевать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать досаду или злость"
                            },
                            {
                                "target_lang_word": "уязвлять",
                                "target_lang_sense_clarification": "задевать самолюбие, обижать"
                            },
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "надоедать, выводить из себя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fac0897-7994-3496-9f62-f3c201833131",
                    "sense_definition": "To sting someone or cause a burning rash, as by contact with a nettle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weeds badly <w>nettled</w> his bare ankles as he walked through the field.",
                            "target_lang_translations": {
                                "ru": "Сорняки сильно <w>обожгли</w> его голые лодыжки, пока он шёл по полю."
                            }
                        },
                        {
                            "text": "Wear thick trousers to avoid being <w>nettled</w> by the dense undergrowth.",
                            "target_lang_translations": {
                                "ru": "Наденьте плотные брюки, чтобы густой подлесок вас не <w>обжёг</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обжигать или колоть кожу (о крапиве и подобных растениях), вызывая жжение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обжигать",
                                "target_lang_sense_clarification": "о крапиве: жечь кожный покров"
                            },
                            {
                                "target_lang_word": "жечь",
                                "target_lang_sense_clarification": "вызывать ощущение ожога"
                            },
                            {
                                "target_lang_word": "стрекать",
                                "target_lang_sense_clarification": "жалить, колоть (о растениях)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}