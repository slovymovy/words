                        "sense_id": "da74ceb4-8c66-31aa-9e02-fbb165eca389",
                        "entry_id": "5b7f43be-99d4-3ab9-95ea-f6833cb42da4",
                        "glosses": [
                            "Perplexed, confused."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "8262e2cd-cf9e-40b9-97b2-09f335cdf33f",
                                "sense_id": "da74ceb4-8c66-31aa-9e02-fbb165eca389",
                                "text": "I'm stumped by this question."
                            },
                            {
                                "example_id": "c088fe39-c182-4efc-90bf-fe5f7bedae07",
                                "sense_id": "da74ceb4-8c66-31aa-9e02-fbb165eca389",
                                "text": "So if women don’t come on flirty or maternal, she thinks, some men get stumped."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e06656a-e16c-3723-8279-594dc85d7f83",
                        "entry_id": "5b7f43be-99d4-3ab9-95ea-f6833cb42da4",
                        "glosses": [
                            "out as a result of the wicket-keeper breaking the wicket with the ball while the batsman is out of his crease."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b5519fa8-ebfa-344b-828d-0f85f35d6fdc",
                        "entry_id": "5b7f43be-99d4-3ab9-95ea-f6833cb42da4",
                        "glosses": [
                            "Done for; bankrupt or ruined."
                        ],
                        "tags": [
                            "archaic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c92f7078-5a87-465f-a813-d45e3db737ee",
                                "sense_id": "b5519fa8-ebfa-344b-828d-0f85f35d6fdc",
                                "text": "\"Why, Walsher,\" said Mr. Stubber, \"how many times a day do you rub your face with a brass candlestick? Why, I lent you a pony when you were stumped, and you carried off a cool hundred.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce46cbf7-ea2d-4503-9313-53f40c8ea6b1",
