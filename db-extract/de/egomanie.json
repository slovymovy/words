                ],
                "senses": [
                    {
                        "sense_id": "3c396aab-2a3f-3c2e-b78f-13290e53973f",
                        "entry_id": "b217337d-4f1a-3e5e-98a9-40d6704f3e4b",
                        "glosses": [
                            "Haltung/Handlungsweise, die in krankhaftem Maße (Manie, manisch) selbstbezogenes Verhalten (auf das eigene Ich/Ego bezogen) zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97636ff6-1e94-4cd5-aac2-143e81786e41",
                                "sense_id": "3c396aab-2a3f-3c2e-b78f-13290e53973f",
                                "text": "„In diesem Zusammenhang machen Schlagworte wie Maßlosigkeit, Allmachtsanspruch, Größenwahn und Egomanie die Runde. Das Führungsverhalten scheint hier massiv aus dem Ruder zu laufen.“"
                            },
                            {
                                "example_id": "77228fe2-f580-4f47-9440-3678e945b3c9",
                                "sense_id": "3c396aab-2a3f-3c2e-b78f-13290e53973f",
                                "text": "„Wahre Empathie ist heute eine seltene Gabe. Wir preisen den kapitalistischen Egoismus als Motor des Fortschrittes, und verschließen die Augen dafür, was diese Egomanie anrichtet.“"
                            },
                            {
                                "example_id": "d1bf825b-1def-4e4a-bd8c-8d11b84bfce0",
                                "sense_id": "3c396aab-2a3f-3c2e-b78f-13290e53973f",
                                "text": "„Diese dämonischen Züge aber beruhen nicht auf übermenschlichen Fähigkeiten, sondern auf dem rein menschlich-psychologischen Phänomen einer ins Krankhafte gesteigerten Egomanie, die in der ovidischen Fassung das verbindende Element zwischen Mädchen, Zauberin und Kindsmörderin ist.“"
                            },
                            {
                                "example_id": "8e1c9856-4cff-4ccf-8cc8-bf6e353f9bfc",
                                "sense_id": "3c396aab-2a3f-3c2e-b78f-13290e53973f",
                                "text": "„Für heute fallen mir spontan folgende ein: Süchte aller Art wie Drogen-, Spiel- oder Kaufsucht, Jugend- und Schönheitswahn, Sexsucht, Magersucht, die Sucht nach Unterhaltung und Ablenkung, krankhafte Egomanie, die keinen Raum für Mitgefühl lässt, Mobbing usw.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
