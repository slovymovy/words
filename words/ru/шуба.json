                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После того известия у него случилась настоящая <w>шуба</w>.",
                            "target_lang_translations": {
                                "en": "After that news, he fell into a real state of <w>panic</w>."
                            }
