                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbbd2727-fc0b-425a-9975-3064cdea47e8",
                                "sense_id": "a66df0a6-bf6c-3073-b49f-4abc77d28d56",
                                "text": "„Die einzige Antwort waren die anschwellenden Sturmwinde, die der fliegenden Flammensäule hinterherrasten.“"
                            },
                            {
                                "example_id": "c7a55f65-fd12-4bb6-b56b-c20b464615cb",
                                "sense_id": "a66df0a6-bf6c-3073-b49f-4abc77d28d56",
                                "text": "„Das von ihm gemalte Gebilde stellte einen Stern mit einem Auge im Zentrum dar, dessen Pupille einer flackernden Flammensäule ähnelte.“"
                            },
                            {
                                "example_id": "fbd3c0d9-8694-41fd-a447-490b22f431af",
                                "sense_id": "a66df0a6-bf6c-3073-b49f-4abc77d28d56",
                                "text": "„Ich erinnere mich daran, dass ich, anders als eigentlich zu erwarten, keine Hitze spürte, als wir uns der lodernden Flammensäule näherten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
