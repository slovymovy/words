                                                "sense_id": "800ecc8a-34f6-3606-abf6-ccad8703257d",
                                                "text": "C’est un bon prix mais il est grincheux ton maillot"
                                            },
                                            {
                                                "example_id": "5a514048-6484-481d-bd6a-b3738b345895",
                                                "sense_id": "800ecc8a-34f6-3606-abf6-ccad8703257d",
