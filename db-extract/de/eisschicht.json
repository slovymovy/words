                ],
                "senses": [
                    {
                        "sense_id": "1ee2857c-1ab8-33ed-a68c-a1bfa6e46dca",
                        "entry_id": "26448ed1-9389-3e83-829f-4991f35d10c0",
                        "glosses": [
                            "Schicht aus Eis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c06dba-2e86-4777-b4fd-a92d0a7f47de",
                                "sense_id": "1ee2857c-1ab8-33ed-a68c-a1bfa6e46dca",
                                "text": "Auf dem Teich im Stadtpark hatte sich eine dünne Eisschicht gebildet."
                            },
                            {
                                "example_id": "ec286dd4-aeac-4576-8b8a-3d63c11cfeb9",
                                "sense_id": "1ee2857c-1ab8-33ed-a68c-a1bfa6e46dca",
                                "text": "„Die flachen Wasserspiegel waren mit einer feinen Eisschicht überzogen, die verharschten Schneereste knirschten unter ihren Schuhen.“"
                            },
                            {
                                "example_id": "a4742bc4-2e5b-4559-bdd4-a83fff525af0",
                                "sense_id": "1ee2857c-1ab8-33ed-a68c-a1bfa6e46dca",
                                "text": "„Niemand bezweifelte, dass die Eisschicht tragen würde – seit Wochen hatte es gefroren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
