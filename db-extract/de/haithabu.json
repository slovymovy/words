                "senses": [
                    {
                        "sense_id": "0d6d6c2f-890a-317d-a1a5-b4382e51a935",
                        "entry_id": "3348c857-003e-37df-919b-ffcc6d975358",
                        "glosses": [
                            "bedeutende frühmittelalterliche Siedlung im heutigen deutschen Bundesland Schleswig-Holstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f32c8f8-d1b7-460a-a1ce-f933ec024df5",
                                "sense_id": "0d6d6c2f-890a-317d-a1a5-b4382e51a935",
                                "text": "„Haithabu, dessen Rang als Handelsmetropole des Ostseeraumes durch umfassende Ausgrabungen immer deutlicher hervortritt, war im 9. und 10. Jahrhundert der wichtigste Umschlagplatz für den Handel zwischen dem Westen und der skandinavisch-slawischen Welt.“"
                            },
                            {
                                "example_id": "2c5c0b70-1594-4dbe-9f1c-7e62b6dd4d4e",
                                "sense_id": "0d6d6c2f-890a-317d-a1a5-b4382e51a935",
                                "text": "„Eine der wesentlichen Voraussetzungen für die Entstehung Haithabus bildet die im 7. Jahrhundert beginnende kulturelle und wirtschaftliche Erschließung des nordostfränkischen Raumes.“"
                            },
                            {
                                "example_id": "dca0f16f-a87d-4386-a82b-669f8b085eab",
                                "sense_id": "0d6d6c2f-890a-317d-a1a5-b4382e51a935",
                                "text": "„Nun gibt es 43 Welterbestätten in Deutschland: Die Wikingerstätten Haithabu und Danewerk in Schleswig-Holstein haben es auf die Liste der Unesco geschafft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
