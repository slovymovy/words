                "senses": [
                    {
                        "sense_id": "1ad63a87-c100-31cf-bb69-c38c1c32659a",
                        "entry_id": "a4890e58-911c-32fe-a219-dfe20134d229",
                        "glosses": [
                            "Alternative spelling of heat wave (“period of exceptionally hot weather”)"
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "7166ac95-dda4-4fe8-b7cc-fa14d4c60a5f",
                                "sense_id": "1ad63a87-c100-31cf-bb69-c38c1c32659a",
                                "text": "Various parts of the world have been experiencing heatwaves and on Thursday the EU’s climate monitoring service said the world had experienced its hottest June on record last month. […] In parts of China, an enduring heatwave has continued, with temperatures reaching above 35C."
                            },
                            {
                                "example_id": "a819c0d3-a14b-40e5-8520-5067b91bbdac",
                                "sense_id": "1ad63a87-c100-31cf-bb69-c38c1c32659a",
                                "text": "Both weather agencies forecast temperatures above 40C over the coming days and called for vigilance amid forecasts of “a very intense, even exceptional” heatwave in parts of the continent."
                            }
                        ]
                    },
                    {
                        "sense_id": "f72eeb4a-418f-3ee7-b3eb-b2f0069de132",
                        "entry_id": "a4890e58-911c-32fe-a219-dfe20134d229",
                        "glosses": [
                            "A heat haze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00ee8d77-faea-477b-bd84-9837f0d6096f",
                                "sense_id": "f72eeb4a-418f-3ee7-b3eb-b2f0069de132",
                                "text": "On a hot summer's day, one can literally see heatwaves shimmering off the surfaces of inanimate objects."
                            }
                        ]
                    }
                ],
