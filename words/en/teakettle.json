{
    "word_family": [
        "tea",
        "kettle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46986927-fd7d-34c4-a6a6-1aadfd4a2928",
                    "sense_definition": "A metal or ceramic vessel used for boiling water, typically featuring a lid, spout, and handle.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She filled the <w>teakettle</w> with cold water and set it on the stove.",
                            "target_lang_translations": {
                                "de": "Sie füllte den <w>Teekessel</w> mit kaltem Wasser und stellte ihn auf den Herd."
                            }
                        },
                        {
                            "text": "The whistling <w>teakettle</w> signaled that the water was hot enough for our tea.",
                            "target_lang_translations": {
                                "de": "Der pfeifende <w>Wasserkessel</w> signalisierte, dass das Wasser heiß genug für unseren Tee war."
                            }
                        }
                    ],
                    "synonyms": [
                        "kettle"
                    ],
                    "common_phrases": [
                        "whistling teakettle",
                        "copper teakettle"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Gefäß aus Metall oder Keramik zum Kochen von Wasser, meist mit Deckel, Ausguss und Henkel."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Teekessel",
                                "target_lang_sense_clarification": "Gefäß zum Wasserkochen"
                            },
                            {
                                "target_lang_word": "Wasserkessel",
                                "target_lang_sense_clarification": "Flötenkessel oder Kochkessel für den Herd"
                            },
                            {
                                "target_lang_word": "Kessel",
                                "target_lang_sense_clarification": "kurz für Teekessel / Kochgefäß"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0cded143-bf68-3b59-a250-9c67db21c294",
                    "sense_definition": "To make a high-pitched, shrill whistling or wheezing sound resembling that of a boiling kettle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His chest was tight from asthma and his breath began <w>teakettling</w> loudly.",
                            "target_lang_translations": {
                                "de": "Seine Brust war wegen des Asthmas verengt und sein Atem begann laut zu <w>pfeifen</w>."
                            }
                        },
                        {
                            "text": "Several small birds were <w>teakettling</w> from the high branches of the oak tree.",
                            "target_lang_translations": {
                                "de": "Mehrere kleine Vögel <w>pfiffen schrill</w> aus den hohen Ästen der Eiche."
                            }
                        }
                    ],
                    "synonyms": [
                        "whistle",
                        "wheeze"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen hohen, schrillen Pfeifton oder ein keuchendes Geräusch von sich geben, das an einen kochenden Wasserkessel erinnert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "pfeifen",
                                "target_lang_sense_clarification": "einen schrillen Ton erzeugen wie ein Teekessel"
                            },
                            {
                                "target_lang_word": "röcheln",
                                "target_lang_sense_clarification": "rasselnd oder keuchend atmen"
                            },
                            {
                                "target_lang_word": "keuchen",
                                "target_lang_sense_clarification": "mühsam und pfeifend atmen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}