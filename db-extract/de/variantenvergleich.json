                "senses": [
                    {
                        "sense_id": "1787d5f4-b8fe-38d2-989a-34aef4f6015f",
                        "entry_id": "e4c6dbb1-6026-3708-995b-0d0b3f74db12",
                        "glosses": [
                            "Vergleich, bei dem zumindest zwei mögliche Varianten betrachtet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f9fcc9-6112-45f4-bb52-66bfbeed7e63",
                                "sense_id": "1787d5f4-b8fe-38d2-989a-34aef4f6015f",
                                "text": "„\"Nicht nur mit dem Erhalt der Sundquerung als eindrucksvolles Wahrzeichen Fehmarns, sondern auch mit dem umfangreichen Variantenvergleich haben wir die Wünsche der Region in einem langen Dialogprozess maximal berücksichtigt\", sagte der FDP-Politiker.“"
                            },
                            {
                                "example_id": "5145f4a2-fc94-4290-863f-8c6ffbbb4345",
                                "sense_id": "1787d5f4-b8fe-38d2-989a-34aef4f6015f",
                                "text": "„Volkswirtschaftsdirektorin Rita Fuhrer, die neu für Teile des Tiefbauamtes zuständig ist, hat deshalb einen umfassenden Variantenvergleich initiiert.“"
                            }
                        ],
