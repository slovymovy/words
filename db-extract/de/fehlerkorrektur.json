                ],
                "senses": [
                    {
                        "sense_id": "0338982a-060b-3dbb-a342-539cb737d8ee",
                        "entry_id": "61d40ac1-8888-3170-b0e7-35519199a701",
                        "glosses": [
                            "Verbesserung, Berichtigung von Falschem, von Mängeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda8c7dc-0981-453e-a62e-b0df7abcddb1",
                                "sense_id": "0338982a-060b-3dbb-a342-539cb737d8ee",
                                "text": "Auch bei gründlicher Fehlerkorrektur können einem manchmal Fehler unterlaufen."
                            },
                            {
                                "example_id": "5cd7773a-9946-4d87-875c-e8d6a71dc92a",
                                "sense_id": "0338982a-060b-3dbb-a342-539cb737d8ee",
                                "text": "Ihr beiden seid für die Fehlerkorrektur der Artikel verantwortlich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0164b190-b0f2-31cb-863c-9f15617fde22",
                        "entry_id": "61d40ac1-8888-3170-b0e7-35519199a701",
                        "glosses": [
                            "Funktion in einem Computerprogramm, die für [1] dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f99383d-3af6-42d9-a8bb-9580651ffca5",
                                "sense_id": "0164b190-b0f2-31cb-863c-9f15617fde22",
                                "text": "„Neben Fehlerkorrektur und Kryptographie wird der Suchalgorithmus der ersten Suchmaschinen besprochen und auch jener, mit dem der Aufstieg des Konzerns Google begann.“"
                            },
                            {
                                "example_id": "0ad5e20e-9d6e-47ba-9c1b-1c224a2c9007",
                                "sense_id": "0164b190-b0f2-31cb-863c-9f15617fde22",
                                "text": "„Zwar kann in das Innerste von Betriebssystemen, den sogenannten Kernel, eine Fehlerkorrektur eingebracht werden, um einige der Angriffe abzuwehren oder zu erschweren.“"
                            },
                            {
                                "example_id": "fed8553f-ad77-4c8a-b8f6-d76a8e341e19",
                                "sense_id": "0164b190-b0f2-31cb-863c-9f15617fde22",
                                "text": "„Fehlerkorrektur funktioniert sehr gut auf der Ebene von Buchstaben, Wörtern und sogar Sätzen, nicht aber bei verlorengegangenen oder entstellten längeren Texte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4cdb831f-1df0-30ae-b9b7-8d76ef79adfb",
                        "entry_id": "61d40ac1-8888-3170-b0e7-35519199a701",
                        "glosses": [
                            "etwas Falsches, was verbessert, berichtigt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb7b446d-da1d-4c90-a46f-5e0d4a73a9a4",
                                "sense_id": "4cdb831f-1df0-30ae-b9b7-8d76ef79adfb",
                                "text": "„Windows 11 erscheint im Grunde wie eine gefälligere Version von Windows 10 mit ein paar Fehlerkorrekturen und Erweiterungen.“"
                            },
                            {
                                "example_id": "aadac349-3f2d-4d9e-8a48-5c3d4d714b07",
                                "sense_id": "4cdb831f-1df0-30ae-b9b7-8d76ef79adfb",
                                "text": "„Erst spätere, verbesserte Versionen, die sogenannten Updates, oder Fehlerkorrekturen, die sogenannten Patches, steigern Schritt für Schritt die Qualität der Programme.“"
                            },
                            {
                                "example_id": "8e3f367a-9128-4218-970f-83b6817094da",
                                "sense_id": "4cdb831f-1df0-30ae-b9b7-8d76ef79adfb",
                                "text": "„Das neueste Update soll Firmenangaben zufolge insbesondere Fehlerkorrekturen und Leistungsverbesserungen enthalten.“"
                            },
                            {
                                "example_id": "47840c1e-f259-4fbf-8ddc-e3f23452aea9",
                                "sense_id": "4cdb831f-1df0-30ae-b9b7-8d76ef79adfb",
                                "text": "„Deswegen ist es wenig überraschend, dass die kommende iOS-Generation, iOS 12, zahlreiche Fehlerkorrekturen und Anpassungen der Benutzeroberfläche beinhalten wird; insbesondere auch im Kontext des ‚Notch‘ genannten missglückten Furunkels auf der Displayseite des iPhone 10.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
