                        "source_sense_id": "173adeae-3389-3f90-ab9e-fa09b967d00d",
                        "target_lang_word": "se déplacer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se déplacer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a27271f-260d-324a-b3d2-cd0bb7c830e7",
                                        "entry_id": "c779e597-c21a-3717-b2b5-5555ee8cd211",
                                        "glosses": [
                                            "Aller à un autre lieu ; changer de place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e3c62be-eca5-41aa-8802-418fc1c1d76f",
                                                "sense_id": "3a27271f-260d-324a-b3d2-cd0bb7c830e7",
                                                "text": "Le général était podagre depuis longtemps et ne pouvait se déplacer qu’avec d’extrêmes difficultés ; aussi se faisait-il porter par ses soldats."
                                            },
                                            {
                                                "example_id": "8fa7e601-6796-4cb9-bc7d-ae4e897596ba",
                                                "sense_id": "3a27271f-260d-324a-b3d2-cd0bb7c830e7",
                                                "text": "Galley, en tant que député aubois et ministre de l’Équipement s'était déplacé en personne, le 25 juin dernier, pour prêcher la bonne parole au conseil municipal sur le thème : « Quelle chance pour notre belle région ! »."
                                            },
                                            {
                                                "example_id": "3abe7389-42c4-4369-9c08-16cf8d61f94e",
                                                "sense_id": "3a27271f-260d-324a-b3d2-cd0bb7c830e7",
                                                "text": "Ces vases fluides, appelées « crème de vase » en français, peuvent se déplacer sous l’effet des courants et de la pente du fond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
