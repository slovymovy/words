            "senses": [
                {
                    "sense_id": "df4f7e59-c001-30b4-8b38-b43c78be458d",
                    "sense_definition": "iets of iemand mooier maken door versieringen aan te brengen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "versieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bruid liet haar haar met witte bloemen <w>tooien</w> voor de ceremonie.",
                            "target_lang_translations": {
                                "en": "The bride had her hair <w>adorned</w> with white flowers for the ceremony."
                            }
                        },
                        {
                            "text": "Zij wilde de feestzaal met kleurrijke slingers <w>tooien</w>.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>decorate</w> the banquet hall with colorful garlands."
                            }
                        }
                    ],
                    "synonyms": [
                        "eren",
                        "sieren",
                        "versieren"
                    ],
                    "common_phrases": [
                        "met bloemen tooien",
                        "feestelijk tooien"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make something or someone more beautiful by applying decorations."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adorn",
                                "target_lang_sense_clarification": "to decorate or enhance beauty"
                            },
                            {
                                "target_lang_word": "decorate",
                                "target_lang_sense_clarification": "to add ornaments to something"
                            },
                            {
                                "target_lang_word": "deck",
                                "target_lang_sense_clarification": "to decorate, often for a festive occasion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1308145-9b1c-302c-a48f-98cf38fa560b",
