                        "target_lang_word": "Fondant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fondant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7528755-d05b-34c3-ae92-19842b4213b3",
                                        "entry_id": "231471fe-3315-3032-804c-266c7d9fe5e8",
                                        "glosses": [
                                            "Zuckermasse, meist aromatisiert und/oder gefärbt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3dbaca3-97c7-4455-b91f-6b282a52bdad",
                                                "sense_id": "e7528755-d05b-34c3-ae92-19842b4213b3",
                                                "text": "„Ein ganz normaler Kuchen wird mit einer weichen Zuckermasse überzogen. Fondant heißt sie und lässt sich formen, ausrollen und modellieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63f6b7f2-fbbf-3be9-9552-748cc7e8c7ab",
                                        "entry_id": "231471fe-3315-3032-804c-266c7d9fe5e8",
                                        "glosses": [
                                            "Süßware aus [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c8daf5-3f94-436c-8e36-e0ddbd0956a2",
                                                "sense_id": "63f6b7f2-fbbf-3be9-9552-748cc7e8c7ab",
                                                "text": "„Die viel gerühmten Fondants etwa werden in Strattas Zuckerküche – die vor ein paar Jahren aus Platzgründen ausgesiedelt wurde und jetzt in einem zentrumsnahen Gewerbeviertel sitzt – in einer langwierigen Prozedur hergestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c608509-ee06-4339-9ecc-22707f49d504",
                        "source_entry_id": "859f6a8c-8b26-342d-8399-061e0ca9f2f5",
                        "source_sense_id": "ea9e509e-cd26-38ab-afc0-1699a156321a",
                        "source_sense_description": "lekkernij",
                        "target_lang_word": "fondant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c674007d-5fe6-3e39-a889-7bca9ee603d0",
                                        "entry_id": "d194fb12-b357-341d-8425-a8459d7dbee3",
                                        "glosses": [
                                            "A flavored, creamy sugar preparation, used for icing cakes or as a base for candies."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de036cdf-b1eb-43c4-97a0-b92cacc4bda1",
                                                "sense_id": "c674007d-5fe6-3e39-a889-7bca9ee603d0",
                                                "text": "To produce most types of fondant, you cook sugar, corn syrup, and water and beat the cooled mixture into a creamy paste. You may find a fondant recipe that includes other ingredients, but the three primary ingredients are the ones listed here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ab94a1f-61aa-3660-9d60-77fc20a491c8",
                                        "entry_id": "d194fb12-b357-341d-8425-a8459d7dbee3",
                                        "glosses": [
                                            "A candy or cake filled with such a preparation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d814bfec-8599-4168-bc53-2293148ff74a",
                                                "sense_id": "1ab94a1f-61aa-3660-9d60-77fc20a491c8",
                                                "text": "\"Don't!\" said Mrs. Mallowe, feebly. \"You make my head ache. I'm miserable to-day. Stay me with fondants, comfort me with chocolates[.]\""
                                            },
                                            {
                                                "example_id": "53e210da-9ca4-424c-bdeb-bb750cca4d10",
                                                "sense_id": "1ab94a1f-61aa-3660-9d60-77fc20a491c8",
                                                "text": "At Chapter One, these chocolate fondants are served restaurant-style with a crème brulée ravioli and an unusual basil ice cream as well as the warm sauce given."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dfa8b8e-ea6f-324b-b22c-42eb24a8cc43",
                                        "entry_id": "d194fb12-b357-341d-8425-a8459d7dbee3",
                                        "glosses": [
                                            "A sugar dough, usually prepared as large sheets (rolled fondant), used in place of icing to cover large areas of cakes, composed of sugar, water, gelatin, glycerine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47648a26-4dbd-42de-9810-1b061db67d2b",
                                                "sense_id": "4dfa8b8e-ea6f-324b-b22c-42eb24a8cc43",
                                                "text": "Stan made a heroic attempt at a tiered cinnamon cake with a rolled fondant icing that came out gray and tore when he draped it over the cake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "886670ea-e35b-3d2e-a0ae-6e564fcb9f7f",
                                        "entry_id": "d194fb12-b357-341d-8425-a8459d7dbee3",
                                        "glosses": [
                                            "Fondue."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec25245b-30f3-4c39-a6a2-217320ee3ff2",
                                                "sense_id": "886670ea-e35b-3d2e-a0ae-6e564fcb9f7f",
                                                "text": "fondant chocolate"
                                            },
                                            {
                                                "example_id": "4a9df368-330a-4175-aacf-191b775df0d6",
                                                "sense_id": "886670ea-e35b-3d2e-a0ae-6e564fcb9f7f",
                                                "text": "fondant cheese"
                                            },
                                            {
                                                "example_id": "57a13c30-79f0-4e8f-b830-24783e53acee",
                                                "sense_id": "886670ea-e35b-3d2e-a0ae-6e564fcb9f7f",
                                                "text": "Start with a Cortland apple salad, beets with goat cheese fondant, […]"
                                            }
