                                    {
                                        "sense_id": "f16755cc-f01a-3bae-9d4c-e1f221378d62",
                                        "entry_id": "76cda153-f6b0-3980-bbe5-0a045beeaa85",
                                        "glosses": [
                                            "Related to or located in the peripheral nervous system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "265adfe4-cb92-45ba-b835-fc293aa931b0",
                                                "sense_id": "f16755cc-f01a-3bae-9d4c-e1f221378d62",
                                                "text": "We have isolated the gene encoding the Schwann cell glycoprotein P0, the major structural protein of the peripheral myelin sheath."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peripheral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97214c25-e2db-3479-afe0-0c29fed2fa75",
                                        "entry_id": "326a35c7-bc6c-32cf-8e9b-f29d1ed41a09",
                                        "glosses": [
                                            "A peripheral device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6e69ecb-2f2a-48c9-8c7c-9af48adf034e",
                                                "sense_id": "97214c25-e2db-3479-afe0-0c29fed2fa75",
                                                "text": "Check your peripheral's manual for the information you'll need."
                                            },
                                            {
                                                "example_id": "8f933baa-ef64-4d1c-8582-a95e37ed7ecb",
                                                "sense_id": "97214c25-e2db-3479-afe0-0c29fed2fa75",
                                                "text": "Check your peripheral's owners' manual to see at what speed your peripheral transmits or receives information, and then record this on the DIP Switch Information chart in the column at the left."
                                            },
                                            {
                                                "example_id": "1e136f5b-7ab0-4d4d-948f-c83ba105f0a2",
                                                "sense_id": "97214c25-e2db-3479-afe0-0c29fed2fa75",
                                                "text": "Turn on the Mac, and check your peripheral. Since you've already installed your device driver, it should be available where you need it...."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f5c987-12ae-3b85-b0fe-0440497cbbff",
                                        "entry_id": "326a35c7-bc6c-32cf-8e9b-f29d1ed41a09",
                                        "glosses": [
                                            "Peripheral vision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d1dbf8-8b89-42de-a72b-7c99030eba8b",
                                                "sense_id": "32f5c987-12ae-3b85-b0fe-0440497cbbff",
                                                "text": "We hailed a cab. The moment we got in, she stared at me with how-can-a-man-be-so-cruel eyes. I felt her glare, saw some of its fiery glow in my peripheral. The heat made me glance her way."
                                            },
                                            {
                                                "example_id": "a2b10262-a5bf-472e-9f2f-230e71ef77e2",
                                                "sense_id": "32f5c987-12ae-3b85-b0fe-0440497cbbff",
                                                "text": "Peripheral on the package\nDon't care to settle in\nTime to feed the monster\nI don't need another friend\nComfort is a mystery\nCrawling out of my own skin\nJust give me what I came for\nThen I'm out the door again"
                                            },
                                            {
                                                "example_id": "7952954b-8c4a-4c97-bd1a-145aae62018e",
                                                "sense_id": "32f5c987-12ae-3b85-b0fe-0440497cbbff",
                                                "text": "He would hear the coach's admonition, \"Always check your peripheral,\" after the ringing stopped in his ears. But before then, his eyes were fixed on the ball and a possible interception, not the receiver angling toward him."
                                            },
                                            {
                                                "example_id": "597ff5cf-bd6f-4ad8-a088-17385ef6edc3",
                                                "sense_id": "32f5c987-12ae-3b85-b0fe-0440497cbbff",
                                                "text": "As I sat by the window and read, I caught sight of the mailman in my peripheral."
                                            },
                                            {
                                                "example_id": "09c3984d-76b6-4855-9668-67076d022fef",
                                                "sense_id": "32f5c987-12ae-3b85-b0fe-0440497cbbff",
                                                "text": "2014, Bill Ladson, \"Zimmerman handles left field with ease -- and no E's\" on MLB.com\nI was kind of looking at the ball, keeping him in my peripheral and all of sudden I see him closing in on the ball."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
