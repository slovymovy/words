                ],
                "senses": [
                    {
                        "sense_id": "defffdc4-50c0-3270-b6b2-a3facd8fe8ef",
                        "entry_id": "a83da90c-0b49-3ce9-9be9-f639bedf507a",
                        "glosses": [
                            "An umbelliferous plant (Pimpinella anisum) growing naturally in Egypt, and cultivated in Spain, Malta, etc., for its carminative and aromatic seeds, which are used as a spice. It has a licorice scent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5bff81e7-2d2c-4a1e-b75c-e78bc61363da",
                                "sense_id": "defffdc4-50c0-3270-b6b2-a3facd8fe8ef",
                                "text": "A concoction consisting of saffron, orange blossoms, dried dates, anise, wild carrots, and egg yolk, boiled in clear water into which honey and the blood of two freshly killed doves have been poured, is recommended by Arabs as a sexual inducement."
                            }
                        ]
                    },
                    {
                        "sense_id": "cec4e50e-24ca-3572-888b-93cafd5bb1e2",
                        "entry_id": "a83da90c-0b49-3ce9-9be9-f639bedf507a",
                        "glosses": [
                            "Fennel, Foeniculum vulgare."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "857fa8d5-1592-44be-9a46-d57e1b90f8ec",
                                "sense_id": "cec4e50e-24ca-3572-888b-93cafd5bb1e2",
                                "text": "[…] of the butcherbirds which were perched on the electric wires skirting the road must be nesting birds, and that in the absence of trees or brush they must be nesting in some of the weeds along the highway, mostly anise (Foeniculum vulgare)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "799689a6-5d04-4912-b43b-7ca11cff8edd",
