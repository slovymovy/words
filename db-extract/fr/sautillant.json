                "senses": [
                    {
                        "sense_id": "9501206a-d9d7-3cab-8898-1207fa41af40",
                        "entry_id": "2beccf17-5e69-3457-a54c-c501db519cc0",
                        "glosses": [
                            "Qui sautille ; qui ne fait que sautiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83c862a3-a37e-4b98-af7a-21fdbbdced2f",
                                "sense_id": "9501206a-d9d7-3cab-8898-1207fa41af40",
                                "text": "Le gerfaut plane, la montagne est abrupte et déchirée.\nAux flancs de ses plus hauts rochers, l’océan qui la couvrit de ses ondes amères a laissé la trace étoilée des coquilles, comme, sur le sable des grèves, se marquent les pas sautillants des oiseaux."
                            },
                            {
                                "example_id": "a47a4c95-fd0e-448b-ac88-2e4443827234",
                                "sense_id": "9501206a-d9d7-3cab-8898-1207fa41af40",
                                "text": "L'un d'eux, un petit homme au visage chafouin et au sourire figé, s'avança d'un petit pas sautillant vers les envoyés de Pékin. C'était le professeur Tcheng."
                            },
                            {
                                "example_id": "2ea8699f-855b-492f-9236-34d361d27db4",
                                "sense_id": "9501206a-d9d7-3cab-8898-1207fa41af40",
                                "text": "Il était difficile pour moi de marcher plus rapidement encore, je heurtais sans cesse des clients chargés de présents ou alors c'étaient des bandes d'adolescents sautillants que je devais contourner avec difficulté."
                            }
                        ]
                    },
                    {
                        "sense_id": "751e5832-507f-32cc-ae97-6ed37633d245",
                        "entry_id": "2beccf17-5e69-3457-a54c-c501db519cc0",
                        "glosses": [
                            "Qualifie un style saccadé, haché, qui manque de suite et de gravité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
