                "senses": [
                    {
                        "sense_id": "0f929020-4afd-324a-8340-0fc86a934f9e",
                        "entry_id": "7de4aa4e-ecc0-3e40-b266-da67f8319905",
                        "glosses": [
                            "Verunreinigung an Oberflächen, die sich dort unerwünscht abgesetzt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e999ba0-d172-474c-97db-4362a592f296",
                                "sense_id": "0f929020-4afd-324a-8340-0fc86a934f9e",
                                "text": "Schmutzablagerungen auf der Windschutzscheibe des Autos können gerade im Winter zu einem Schmierfilm führen."
                            },
                            {
                                "example_id": "55468a23-eadb-43ca-980f-547935da92f5",
                                "sense_id": "0f929020-4afd-324a-8340-0fc86a934f9e",
                                "text": "„Wintergärten und Wohnwagen widerstehen Schmutzablagerung durch Regenwasser.“"
                            },
                            {
                                "example_id": "688868c6-4832-4260-90a5-7ae0eadf54aa",
                                "sense_id": "0f929020-4afd-324a-8340-0fc86a934f9e",
                                "text": "„Es wird eine Vorrichtung zur Verhinderung von Schmutzablagerungen an einer Wand über einer Steckdose durch darin einsteckbare Verdunster beschrieben.“"
                            },
                            {
                                "example_id": "6b0b2576-8109-431b-b879-e6d37d8618bc",
                                "sense_id": "0f929020-4afd-324a-8340-0fc86a934f9e",
                                "text": "„Dieser hochwirksame, Reiniger ist speziell für die Entfernung von Kalk und anderen Schmutzablagerungen bei höchster Materialschonung entwickelt worden.“"
                            },
                            {
                                "example_id": "281c180d-939f-48fe-a9f2-8584a74405b6",
                                "sense_id": "0f929020-4afd-324a-8340-0fc86a934f9e",
                                "text": "„Die Lebensdauer der Ionisationsröhre hängt im Wesentlichen vom Handling bzw. Transport der gesamten Ionisationsröhre und im Besonderen des Glaskolbens vor dem eigentlichen Einbau ab, da es zu Haarrissen oder Schmutzablagerungen kommen kann.“"
                            },
                            {
                                "example_id": "50e6b162-86dc-4329-b04f-aa69d0190e3a",
                                "sense_id": "0f929020-4afd-324a-8340-0fc86a934f9e",
                                "text": "„Dabei kann nicht nur die schlechte Entlüftung die Ursache sein, hervorgerufen durch eine Schmutzablagerung und Verengung in den Lüftungskanälen, sondern viele Arten von wuchernden Bakterien, die diesen Geruch verstärken“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
