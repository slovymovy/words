                ],
                "senses": [
                    {
                        "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                        "entry_id": "2739c895-f75d-3102-82f7-ce05d1a7913c",
                        "glosses": [
                            "Fassungslossein; Zustand, in dem jemand fassungslos ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2c6683-9b4e-43c6-8f0b-303f46e1353c",
                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                "text": "Manche Vorgänge in der Welt kann man nur mit Fassungslosigkeit beobachten."
                            },
                            {
                                "example_id": "1fbd4f35-4574-4a66-885e-0c3ed9735a28",
                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                "text": "„Niemand im Raum hätte auch nur im Entferntesten vermutet, dass diese Fassungslosigkeit der Furcht entsprang, sein Beschützer könne womöglich gar nicht da sein.“"
                            },
                            {
                                "example_id": "24fd89ba-7049-4236-8df6-ed3760f69c20",
                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                "text": "„Über das Gesicht den Rottenführers breitet sich Fassungslosigkeit aus, er blickt sich wie suchend um.“"
                            },
                            {
                                "example_id": "bbb2d5d7-61ed-4dac-abf2-7367b2a22cc0",
                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                "text": "„Grenfeld betrachtete Minni mit einer Mischung aus Fassungslosigkeit und Ärger.“"
                            },
                            {
                                "example_id": "696261d2-0a4f-4695-967f-a53f0f691f5f",
                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                "text": "„Noch einmal spiegelte die Stimme der Mutter die Fassungslosigkeit von damals wider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72dd95b1-0193-47e1-b1a9-7a29e6746367",
                        "source_entry_id": "2739c895-f75d-3102-82f7-ce05d1a7913c",
                        "source_sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                        "source_sense_description": "Fassungslossein; Zustand, in dem jemand fassungslos ist",
                        "target_lang_word": "consternation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                        "entry_id": "c953c29d-b9c5-3f61-852f-825947492f3a",
                                        "glosses": [
                                            "Amazement or horror that confounds the faculties, and incapacitates for reflection; terror, combined with amazement; dismay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098bfb65-8e1b-4454-bae9-e14445728e4d",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "\"Out!\" exclaimed her husband, with something like genuine consternation in his voice."
                                            },
                                            {
                                                "example_id": "602baf81-173e-4c3e-9592-ba81593c7eac",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "Their audience had been listening in increasing consternation."
                                            },
                                            {
                                                "example_id": "48b24c20-55c4-46c7-89d5-0265fe6cc51c",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "It was probably worth four millennia of consternation and regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
