                ],
                "senses": [
                    {
                        "sense_id": "f43ab552-ba23-3dc8-b54c-3941bb8d1d30",
                        "entry_id": "59f51443-a212-3633-8c9d-93a843a8f814",
                        "glosses": [
                            "Habiter à nouveau."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "da50814c-3d73-4ef4-9769-95073ea0b64d",
                                "sense_id": "f43ab552-ba23-3dc8-b54c-3941bb8d1d30",
                                "text": "[…] ; mais quelques-uns se hasardèrent de réhabiter leurs demeures pour être admis de nouveau à cultiver leurs terres…"
                            }
                        ]
                    },
                    {
                        "sense_id": "c3061c45-d53c-3fe3-8052-b3fe91dfb47f",
                        "entry_id": "59f51443-a212-3633-8c9d-93a843a8f814",
                        "glosses": [
                            "Se réapproprier."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1c520573-32af-4dad-8ad0-ecc84e9fcb53",
                                "sense_id": "c3061c45-d53c-3fe3-8052-b3fe91dfb47f",
                                "text": "Il esquisse aussi le chemin qui nous permettra de réhabiter notre humanité aujourd'hui."
                            },
                            {
                                "example_id": "4b41932d-5bd3-4fe5-878e-4e5567a20d5f",
                                "sense_id": "c3061c45-d53c-3fe3-8052-b3fe91dfb47f",
                                "text": "Je veux dire qu'il faut parvenir à réhabiter cette langue, y compris et d'abord en dehors des frontières de l'Hexagone, ce qui aura logiquement un effet en retour à l'intérieur de l'Hexagone."
                            },
                            {
                                "example_id": "2d78abdd-b509-45a6-acd5-d65b9f002ba7",
                                "sense_id": "c3061c45-d53c-3fe3-8052-b3fe91dfb47f",
                                "text": "Quand elle le quitte elle doit réhabiter son intimité, pour laquelle elle a tant lutté. La réhabiter de l'intérieur. Pour elle, les liens charnels ne sont rien. Ils se défont avec une extrême rapidité."
                            }
                        ]
                    }
                ],
