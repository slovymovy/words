                                    {
                                        "sense_id": "02ab9f2e-90f9-34f9-b6fa-2107a1476cdf",
                                        "entry_id": "ab2d5983-f1b3-3c67-a2f6-d063297d277e",
                                        "glosses": [
                                            "Anforderung eines Produkts oder einer Dienstleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d08d4207-cd3b-4491-a610-b8c38394ccc5",
                                                "sense_id": "02ab9f2e-90f9-34f9-b6fa-2107a1476cdf",
                                                "text": "Ich habe vor zwei Wochen eine Bestellung über 2000 Paar Socken aufgegeben."
                                            },
                                            {
                                                "example_id": "8f8a39ff-c2ad-432c-9931-5a5132992a50",
                                                "sense_id": "02ab9f2e-90f9-34f9-b6fa-2107a1476cdf",
                                                "text": "„Damit war die Bestellung beendet, und ehe zehn Minuten um waren, erschien die Bowle, darauf nicht mehr als drei oder vier Waldmeisterblättchen schwammen, nur gerade genug, den Beweis der Echtheit zu führen.“"
                                            },
                                            {
                                                "example_id": "49feceae-ed55-46ef-99d3-25553d8f008a",
                                                "sense_id": "02ab9f2e-90f9-34f9-b6fa-2107a1476cdf",
                                                "text": "„Jill, das Mädchen hinter der Bar, nimmt seine Bestellung auf und bemerkt seinen australischen Akzent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e5d5636-5b28-3429-93da-3b377002cad3",
                                        "entry_id": "ab2d5983-f1b3-3c67-a2f6-d063297d277e",
                                        "glosses": [
                                            "Beackerung einer landwirtschaftlichen Fläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad0827d6-79cc-4bf2-84ea-3026625f9f7b",
                                                "sense_id": "0e5d5636-5b28-3429-93da-3b377002cad3",
                                                "text": "Während der Zeit der Bestellung hat der Bauer viel zu tun."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5c608d19-8d56-3e05-a29c-7219099bc602",
                                        "entry_id": "ab2d5983-f1b3-3c67-a2f6-d063297d277e",
                                        "glosses": [
                                            "das angeforderte Produkt oder die angeforderte Dienstleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "509020ed-7fbf-4ff3-9be7-3da671f1ba0e",
                                                "sense_id": "5c608d19-8d56-3e05-a29c-7219099bc602",
                                                "text": "Die Bestellung wurde schnell geliefert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
