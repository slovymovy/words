                        "cross_references": [
                            {
                                "target_word": "inaugural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6a8841-63f5-3b1b-ab32-a52c4b853155",
                                        "entry_id": "141ff931-849e-33bc-bc8f-1c32154b572b",
                                        "glosses": [
                                            "Of inauguration; as in a speech or lecture by the person being inaugurated."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa70fbb1-3379-483e-a851-42100e9c2815",
                                                "sense_id": "7d6a8841-63f5-3b1b-ab32-a52c4b853155",
                                                "text": "The University of Cape Town hosts an inaugural lecture by Professor Ian Scott […] on Wednesday at 8pm."
                                            },
                                            {
                                                "example_id": "e468304d-a282-4740-9648-db997396366f",
                                                "sense_id": "7d6a8841-63f5-3b1b-ab32-a52c4b853155",
                                                "text": "In 1928 [Martin] Heidegger succeeded [Edmund] Husserl to take a chair at Freiburg and in his inaugural lecture made a pronouncement that earned him a reputation as an archetypal metaphysician with his claim that our awareness of people as a whole depends on our experience of dread in the face of nothingness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a589a897-8c41-390e-aaef-67b47867e50f",
                                        "entry_id": "141ff931-849e-33bc-bc8f-1c32154b572b",
                                        "glosses": [
                                            "Marking the beginning of an operation, venture, etc."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08897dfe-88b0-4db1-b94f-c4c6fa86bdf4",
                                                "sense_id": "a589a897-8c41-390e-aaef-67b47867e50f",
                                                "text": "2009 was the inaugural season for New York Yankees' new stadium."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inaugural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc1fe34d-dd35-3d4a-b255-5db3e824dbd0",
                                        "entry_id": "c8fd8b50-2b60-3558-af22-7c6c06b0e8d3",
                                        "glosses": [
                                            "An inauguration; a formal beginning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4892491f-3b6a-477f-8e7f-e0c211637985",
                                                "sense_id": "dc1fe34d-dd35-3d4a-b255-5db3e824dbd0",
                                                "text": "The inaugural of the President will take place in March."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea09ee8-c559-36cb-9fa6-c7dfe159952b",
                                        "entry_id": "c8fd8b50-2b60-3558-af22-7c6c06b0e8d3",
                                        "glosses": [
                                            "A formal speech given at the beginning of an office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaec281e-e00f-4417-a7c6-8b98688de46a",
                                                "sense_id": "1ea09ee8-c559-36cb-9fa6-c7dfe159952b",
                                                "text": "In his inaugural, President Obama proclaimed 'an end to the petty grievances and false promises, the recriminations and worn-out dogmas, that for far too long have strangled our politics'."
                                            }
                                        ]
                                    }
                                ]
