{
    "word_family": [
        "chuckling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b7ddab0-ec68-3bb0-aeb6-c26077774acd",
                    "sense_definition": "To laugh quietly or inwardly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>chuckled</w> softly at the funny story.",
                            "target_lang_translations": {
                                "zh": "他对着那个有趣的故事<w>轻笑</w>了一声。",
                                "de": "Er <w>schmunzelte</w> leise über die lustige Geschichte.",
                                "ru": "Он тихо <w>хихикнул</w> над забавной историей."
                            }
                        },
                        {
                            "text": "The audience began to <w>chuckle</w> when the comedian made a joke.",
                            "target_lang_translations": {
                                "zh": "当喜剧演员讲笑话时，观众开始<w>轻笑</w>起来。",
                                "de": "Das Publikum begann zu <w>kichern</w>, als der Komiker einen Witz machte.",
                                "ru": "Зрители начали <w>посмеиваться</w>, когда комик пошутил."
                            }
                        }
                    ],
                    "synonyms": [
                        "laugh"
                    ],
                    "common_phrases": [
                        "quietly chuckle"
                    ],
                    "target_lang_definitions": {
                        "zh": "低声地或暗自发笑。",
                        "de": "Leise oder in sich hinein lachen.",
                        "ru": "Тихо или про себя смеяться."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻笑",
                                "target_lang_sense_clarification": "指声音较小的笑。"
                            },
                            {
                                "target_lang_word": "暗笑",
                                "target_lang_sense_clarification": "指心里觉得好笑而发出的笑声。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kichern",
                                "target_lang_sense_clarification": "Leises, oft unterdrücktes Lachen."
                            },
                            {
                                "target_lang_word": "schmunzeln",
                                "target_lang_sense_clarification": "In sich hinein lächeln oder leise lachen, oft aus Vergnügen."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хихикать",
                                "target_lang_sense_clarification": "смеяться тихо или исподтишка"
                            },
                            {
                                "target_lang_word": "посмеиваться",
                                "target_lang_sense_clarification": "негромко или время от времени смеяться"
                            },
                            {
                                "target_lang_word": "усмехаться",
                                "target_lang_sense_clarification": "улыбаться, часто иронически или недоверчиво"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b50450a-7f3e-3b10-9ee2-61cb201d1442",
                    "sense_definition": "To communicate through chuckling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>chuckled</w> her agreement while nodding.",
                            "target_lang_translations": {
                                "zh": "她一边点头，一边<w>轻笑着</w>表示同意。",
                                "de": "Sie <w>schmunzelte</w> zustimmend, während sie nickte.",
                                "ru": "Она <w>хихикнула</w> в знак согласия, кивая головой."
                            }
                        },
                        {
                            "text": "He <w>chuckled</w> his approval of the plan.",
                            "target_lang_translations": {
                                "zh": "他<w>轻笑着</w>表示对该计划的赞同。",
                                "de": "Er <w>schmunzelte</w> seine Zustimmung zu dem Plan.",
                                "ru": "Он <w>усмехнулся</w>, выражая одобрение плана."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "通过轻笑来表达某种意思。",
                        "de": "Durch ein Kichern oder Schmunzeln eine Bedeutung vermitteln.",
                        "ru": "Выражать согласие или одобрение с помощью тихого смеха."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻笑着表示",
                                "target_lang_sense_clarification": "用轻笑作为沟通手段。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schmunzelnd zustimmen",
                                "target_lang_sense_clarification": "Durch ein Schmunzeln Einverständnis ausdrücken."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "посмеиваясь, выразить",
                                "target_lang_sense_clarification": "использовать смех как средство коммуникации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d144246d-5286-3d48-bec0-5376b56348eb",
                    "sense_definition": "To make the sound of a chicken; to cluck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hen began to <w>chuckle</w> in the yard.",
                            "target_lang_translations": {
                                "zh": "母鸡在院子里开始<w>咯咯叫</w>。",
                                "de": "Die Henne begann im Hof zu <w>gackern</w>.",
                                "ru": "Курица начала <w>кудахтать</w> во дворе."
                            }
                        },
                        {
                            "text": "I heard the mother hen <w>chuckling</w> to her chicks.",
                            "target_lang_translations": {
                                "zh": "我听到母鸡对着小鸡<w>咯咯叫</w>。",
                                "de": "Ich hörte, wie die Mutterhenne ihren Küken <w>gackernd</w> zuredete.",
                                "ru": "Я слышал, как наседка <w>кудахтала</w> своим цыплятам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or dialectal."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "母鸡发出咯咯声。",
                        "de": "Das Geräusch eines Huhns machen; gackern.",
                        "ru": "Издавать звуки, характерные для курицы."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咯咯叫",
                                "target_lang_sense_clarification": "母鸡发出的声音。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gackern",
                                "target_lang_sense_clarification": "Das typische Geräusch eines Huhns."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кудахтать",
                                "target_lang_sense_clarification": "издавать звуки, характерные для кур"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e1ce24b-3ff1-3fd0-b84e-cbbf3fef1383",
                    "sense_definition": "To call together, or call to follow, as a hen calls her chickens; to cluck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hen <w>chuckled</w> her brood toward the food.",
                            "target_lang_translations": {
                                "zh": "母鸡<w>咯咯叫</w>着把小鸡引向食物。",
                                "de": "Die Henne <w>lockte</w> ihre Brut mit Gackern zum Futter.",
                                "ru": "Курица <w>кудахтаньем</w> подозвала свой выводок к еде."
                            }
                        },
                        {
                            "text": "She <w>chuckled</w> the chicks into the coop.",
                            "target_lang_translations": {
                                "zh": "她<w>咯咯叫</w>着把小鸡唤进了鸡舍。",
                                "de": "Sie <w>lockte</w> die Küken gackernd in den Stall.",
                                "ru": "Она <w>кудахтаньем</w> загнала цыплят в курятник."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "母鸡发出咯咯声以召唤小鸡。",
                        "de": "Ein gackerndes Geräusch machen, um Küken zu rufen.",
                        "ru": "Издавать кудахтанье, чтобы подозвать цыплят."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咯咯叫着召唤",
                                "target_lang_sense_clarification": "母鸡通过叫声引导小鸡。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "locken",
                                "target_lang_sense_clarification": "Durch Laute herbeirufen."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подзывать кудахтаньем",
                                "target_lang_sense_clarification": "использовать звуки для привлечения внимания цыплят"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c9426be-8d2b-3c43-9e3e-23803712325a",
                    "sense_definition": "To fondle; to indulge or pamper.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmother loved to <w>chuckle</w> her grandchild.",
                            "target_lang_translations": {
                                "zh": "祖母很喜欢<w>抚爱</w>她的孙子。",
                                "de": "Die Großmutter liebte es, ihr Enkelkind zu <w>liebkosen</w>.",
                                "ru": "Бабушка любила <w>ласкать</w> своего внука."
                            }
                        },
                        {
                            "text": "He would <w>chuckle</w> the baby to keep her happy.",
                            "target_lang_translations": {
                                "zh": "他会<w>抚爱</w>婴儿来让她开心。",
                                "de": "Er würde das Baby <w>liebkosen</w>, um es bei Laune zu halten.",
                                "ru": "Он <w>баловал</w> ребенка, чтобы тот был доволен."
                            }
                        }
                    ],
                    "synonyms": [
                        "fondle",
                        "coddle",
                        "pamper"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "抚摸；溺爱或娇惯。",
                        "de": "Liebkosen; verwöhnen oder verhätscheln.",
                        "ru": "Ласкать, баловать или чрезмерно опекать."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抚爱",
                                "target_lang_sense_clarification": "指通过抚摸表达喜爱。"
                            },
                            {
                                "target_lang_word": "娇惯",
                                "target_lang_sense_clarification": "指过分宠爱。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "liebkosen",
                                "target_lang_sense_clarification": "Zärtlich berühren."
                            },
                            {
                                "target_lang_word": "verhätscheln",
                                "target_lang_sense_clarification": "Übermäßig verwöhnen."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ласкать",
                                "target_lang_sense_clarification": "проявлять нежность через прикосновения"
                            },
                            {
                                "target_lang_word": "баловать",
                                "target_lang_sense_clarification": "потакать желаниям, чрезмерно опекать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a3f65afc-7186-36e8-b7f1-de5f12ab4212",
                    "sense_definition": "A quiet laugh.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A soft <w>chuckle</w> escaped her lips.",
                            "target_lang_translations": {
                                "zh": "她嘴角溢出一声<w>轻笑</w>。",
                                "de": "Ein leises <w>Kichern</w> entwich ihren Lippen.",
                                "ru": "С её губ сорвалось тихое <w>хихиканье</w>."
                            }
                        },
                        {
                            "text": "He gave a short <w>chuckle</w> at the joke.",
                            "target_lang_translations": {
                                "zh": "他对着那个笑话发出了一声<w>轻笑</w>。",
                                "de": "Er stieß bei dem Witz ein kurzes <w>Schmunzeln</w> aus.",
                                "ru": "Он коротко <w>усмехнулся</w> над шуткой."
                            }
                        }
                    ],
                    "synonyms": [
                        "giggle",
                        "snigger",
                        "titter"
                    ],
                    "common_phrases": [
                        "short chuckle"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种低声的笑。",
                        "de": "Ein leises Lachen.",
                        "ru": "Тихий смех."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻笑声",
                                "target_lang_sense_clarification": "指发出的低笑声。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kichern",
                                "target_lang_sense_clarification": "Das Geräusch eines leisen Lachens."
                            },
                            {
                                "target_lang_word": "Schmunzeln",
                                "target_lang_sense_clarification": "Ein leises, vergnügtes Lachen."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хихиканье",
                                "target_lang_sense_clarification": "звук тихого смеха"
                            },
                            {
                                "target_lang_word": "усмешка",
                                "target_lang_sense_clarification": "короткий, часто ироничный смешок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}