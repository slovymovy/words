                        "examples": [
                            {
                                "example_id": "bd3c9666-7959-4018-a81a-0a923fe09688",
                                "sense_id": "3cb86489-2ef3-39b9-81f9-93dd95b62ed5",
                                "text": "Thou in thyself art perfect, and in thee Is no deficience found: Not so is Man, But in degree; the cause of his desire By conversation with his like to help Or solace his defects."
                            },
                            {
                                "example_id": "98a45e75-4199-4710-b757-2893565f3e5f",
                                "sense_id": "3cb86489-2ef3-39b9-81f9-93dd95b62ed5",
                                "text": "Whoever has the care of instructing others, may be charged with deficience in his duty if this book is not recommended."
                            },
                            {
                                "example_id": "fc59562b-64c5-41e5-95a6-f9821d6dfaf3",
                                "sense_id": "3cb86489-2ef3-39b9-81f9-93dd95b62ed5",
                                "text": "[H]is faults seem to be very many; some of natural deficience, and some of laborious affectation."
                            }
                        ]
                    }
