                        "glosses": [
                            "islamski przywódca religijny, a początkowo także i polityczny, tytularny następca Mahometa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fff9fb44-5c65-477f-b5df-231f860dd869",
