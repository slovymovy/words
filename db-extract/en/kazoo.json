                                "target_senses": [
                                    {
                                        "sense_id": "088b7ff1-ea41-386c-9494-252fa0d924de",
                                        "entry_id": "e01df6e9-fdca-3c16-aedd-47b2e869be21",
                                        "glosses": [
                                            "Variante de kazoo."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301ae0f6-69f3-4963-bfec-f5aa99ccedf7",
                                                "sense_id": "088b7ff1-ea41-386c-9494-252fa0d924de",
                                                "text": "Avec mon petit gazou\nJ’ai pas besoin de biniou\nNi de pipeau en bambou\nCar dès que je joue\nJ’ai toujours un succès fou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a2b2335-cf98-4518-95ec-3705493016e6",
