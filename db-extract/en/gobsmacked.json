                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estomaqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e05b74f6-aeb4-3830-8dae-e7c6d80c6e78",
                                        "entry_id": "4166a02e-8df3-3adf-8223-2348590fb41e",
                                        "glosses": [
                                            "Stupéfié, ahuri, abasourdi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e6905b-281c-4f91-a87f-c251304e91fb",
                                                "sense_id": "e05b74f6-aeb4-3830-8dae-e7c6d80c6e78",
                                                "text": "— Et vous paraissiez si malheureux, si contrit, si estomaqué de votre culot…"
                                            },
                                            {
                                                "example_id": "6c5e52f0-b20f-46ff-afd8-b9f9dc535bb9",
                                                "sense_id": "e05b74f6-aeb4-3830-8dae-e7c6d80c6e78",
                                                "text": "Mais la relecture personnelle qu’il fait des derniers événements en laisse beaucoup estomaqués."
                                            },
                                            {
                                                "example_id": "72bb060f-5826-4c8f-a04d-f9f51d5aea2e",
                                                "sense_id": "e05b74f6-aeb4-3830-8dae-e7c6d80c6e78",
                                                "text": "Elle fait partie de ceux qui ont été estomaqués par la déclaration de Christian Dubé."
                                            },
                                            {
                                                "example_id": "9ba7313e-d41e-4a9c-bc1a-1f995452b8b8",
                                                "sense_id": "e05b74f6-aeb4-3830-8dae-e7c6d80c6e78",
                                                "text": "Je suis estomaquée par la procrastination de la CAQ sur cette question."
                                            }
                                        ]
                                    }
                                ]
