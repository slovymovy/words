                    "frequency": "High",
                    "semantic_group_id": "litterature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>écrivain</w> célèbre publie un nouveau roman chaque année avec succès."
                        },
                        {
                            "text": "Mon frère rêve d'embrasser le métier d'<w>écrivain</w> depuis sa plus tendre enfance."
                        }
                    ],
                    "synonyms": [
