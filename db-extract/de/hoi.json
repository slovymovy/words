                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b1b1f6e-c719-3e7d-8e32-2eb7137f5676",
                        "entry_id": "5e820a0e-2f26-38d8-a2f2-d0dfbf402138",
                        "glosses": [
                            "Ausruf des (freudigen) Erstaunens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fa0277e-43a1-412f-9c04-e4dc6fd4b03c",
                                "sense_id": "1b1b1f6e-c719-3e7d-8e32-2eb7137f5676",
                                "text": "Hoi, das ist aber lecker!"
                            },
                            {
                                "example_id": "ec298ef3-905c-4309-a62f-f66ba4829e78",
                                "sense_id": "1b1b1f6e-c719-3e7d-8e32-2eb7137f5676",
                                "text": "Hoi, du bist ja schon fertig!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9c4ac8c-f20d-3003-aea8-45da49d3e2a5",
                        "entry_id": "5e820a0e-2f26-38d8-a2f2-d0dfbf402138",
                        "glosses": [
                            "Ausruf der ärgerlichen Feststellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eec5c8bd-e741-4879-8c2a-0040253aac63",
                                "sense_id": "e9c4ac8c-f20d-3003-aea8-45da49d3e2a5",
                                "text": "Hoi, pass doch auf!"
                            }
                        ],
