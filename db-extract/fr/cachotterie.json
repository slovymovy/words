        "fr-extract.jsonl": [
            {
                "entry_id": "5e55312c-5015-3fd8-857e-bd37537763f4",
                "word": "cachotterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8bae278-a237-49ed-977f-744f178387b4",
                        "entry_id": "5e55312c-5015-3fd8-857e-bd37537763f4",
                        "tags": [
                            "plural"
                        ],
                        "form": "cachotteries"
                    },
                    {
                        "form_id": "668358ea-9331-4b71-bddc-e0bf8a11d4ad",
                        "entry_id": "5e55312c-5015-3fd8-857e-bd37537763f4",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "cachoterie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91c69ea3-a6f1-380d-9fca-fccfeec71f01",
                        "entry_id": "5e55312c-5015-3fd8-857e-bd37537763f4",
                        "glosses": [
                            "Manière mystérieuse d’agir ou de parler qu’on emploie pour cacher des choses peu importantes."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "626a10a2-909c-4831-a14a-21979f500ea8",
                                "sense_id": "91c69ea3-a6f1-380d-9fca-fccfeec71f01",
                                "text": "À quoi servent toutes ces cachotteries ?"
                            },
                            {
                                "example_id": "3fd578c2-f4cd-491e-9496-1c02bf40e8fe",
                                "sense_id": "91c69ea3-a6f1-380d-9fca-fccfeec71f01",
                                "text": "Elle aime à faire des cachotteries."
                            },
                            {
                                "example_id": "d9dd6706-2776-4df0-bf74-89bbf7b04d50",
                                "sense_id": "91c69ea3-a6f1-380d-9fca-fccfeec71f01",
                                "text": "Elle regardait Gavard en dessous, goûtait le silence embarrassé que sa présence prolongeait, jurant qu’elle ne s’en irait pas, puisqu’on faisait « des cachotteries » avec elle."
                            },
                            {
                                "example_id": "f4a7a01c-597f-48c0-93ab-535a7b486623",
                                "sense_id": "91c69ea3-a6f1-380d-9fca-fccfeec71f01",
                                "text": "Puisqu’elle s’intéresse tant à ses locataires, ce serait la vexer que de lui faire des cachotteries !"
                            },
                            {
                                "example_id": "9095fa2d-874d-4b00-a188-936093e6d041",
                                "sense_id": "91c69ea3-a6f1-380d-9fca-fccfeec71f01",
                                "text": "Nous jouions une ample comédie aux cent sketches divers : le flirt, les malentendus vite dissipés, les taquineries débonnaires et les gronderies gentilles, le dépit amoureux, les cachotteries tendres et la passion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6e69d95-6808-43ee-854b-d240c1d48250",
                        "source_entry_id": "5e55312c-5015-3fd8-857e-bd37537763f4",
                        "source_sense_id": "91c69ea3-a6f1-380d-9fca-fccfeec71f01",
                        "source_sense_description": "Manière mystérieuse pour cacher des choses peu importantes",
                        "target_lang_word": "Geheimnistuerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheimnistuerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48528f60-8e97-3b6b-8184-4d21e243bbe3",
                                        "entry_id": "12d5de12-889b-37ef-a8f3-a8ca57d8493c",
                                        "glosses": [
                                            "Verhalten, bestimmte Dinge geheim zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831542de-b784-4015-b31c-3835787b57f1",
                                                "sense_id": "48528f60-8e97-3b6b-8184-4d21e243bbe3",
                                                "text": "„Durch die Geheimnistuerei der Contessa gewann ich die Überzeugung, daß M. M. einen Geliebten haben müsse, wollte mir aber deswegen keinen Kummer machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26bd2220-6b02-46a4-96d7-175530b920ba",
                        "source_entry_id": "5e55312c-5015-3fd8-857e-bd37537763f4",
                        "source_sense_id": "91c69ea3-a6f1-380d-9fca-fccfeec71f01",
                        "source_sense_description": "Manière mystérieuse pour cacher des choses peu importantes",
                        "target_lang_word": "Geheimniskrämerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheimniskrämerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                        "entry_id": "06bbef43-d5bc-3f60-8b22-41e9e9f334ef",
                                        "glosses": [
                                            "Verhalten, das vermuten lässt, dass jemand etwas heimlich tun (geheim halten, ein Geheimnis wahren) möchte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b872179-651b-451e-876b-423e0a72ebfd",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "„Was soll denn diese Geheimniskrämerei!“"
                                            },
                                            {
                                                "example_id": "271741e9-694c-4169-94ac-3fe7257fdf39",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "Ich sah, wie er mit Britton hastig ein paar Sätze austauschte. Sie flüsterten dabei. Mir erschien diese Geheimniskrämerei nicht ganz geheuer."
                                            },
                                            {
                                                "example_id": "58381e95-dcfe-449c-a663-db975be6e996",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "„Ein Beispiel par excellence für Apples hohe Schule der gekonnten Geheimniskrämerei war beispielsweise die Eröffnung des ersten AppleStores.“"
                                            },
                                            {
                                                "example_id": "93a914cb-15f3-4240-8b14-50610346c11f",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "Vor einem Jahr verschwanden in Mexiko 43 Studenten. Die Angehörigen werfen den Behörden immer wieder Geheimniskrämerei vor."
                                            },
                                            {
                                                "example_id": "2ebcb5f3-4f40-4173-8320-4b2f019b76ae",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "Bill Clinton, der ehemalige US-Präsident, hat […] einen Thriller geschrieben: […] weltweit ist der Thriller gleichzeitig am 4. Juni erschienen. Vorab gab es viel Geheimniskrämerei, nichts durfte vor der Veröffentlichung nach außen dringen."
                                            },
                                            {
                                                "example_id": "7cdb48de-5739-49fd-bc73-127476917c7c",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "Die Geheimniskrämerei der IHK Bremerhaven hat Tradition: Schon 1882 weigerte sie sich als einzige Kammer im damaligen Preußen, ihre Sitzungsprotokolle dem Staat vorzulegen."
                                            },
                                            {
                                                "example_id": "e18bccdc-ee3e-494d-8a79-315ad25c6cbc",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "„Es gibt kaum Probleme. Wir müssen nur darauf achten, dass kein Blackout passiert. Aber darüber möchte ich nicht reden. Das ist geheim.“ Die Geheimniskrämerei ist kein Zufall. Ende letzten Jahres stahlen Kriminelle rund 600 Computer eines Bitcoin-Konkurrenten […]"
                                            },
                                            {
                                                "example_id": "2cd6b156-1021-4296-a5f4-a48087f20e03",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "„Ein anderer Online-Musikhändler, der mir viel besser gefällt, ist Bandcamp. Da kann ich ganz genau einsehen, wie mit meiner Musik Geld gemacht wird. […] Ich denke, dass die Geheimniskrämerei, die Spotify […] betreibt, Teil seines Kapitals ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
