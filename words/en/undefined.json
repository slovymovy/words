    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7c0f2572-9b4e-3c3d-ab47-23c7cafdbb72",
                    "sense_definition": "Having no specific meaning or value assigned, especially in mathematics or computing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lack of definition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In mathematics, the result of division by zero is <w>undefined</w>.",
                            "target_lang_translations": {
                                "ru": "В математике результат деления на ноль является <w>неопределённым</w>."
                            }
                        },
                        {
                            "text": "The program crashed because it tried to access an <w>undefined</w> variable.",
                            "target_lang_translations": {
                                "ru": "Программа завершилась сбоем, так как попыталась обратиться к <w>неопределённой</w> переменной."
                            }
                        }
                    ],
                    "antonyms": [
                        "defined"
                    ],
                    "common_phrases": [
                        "undefined variable",
                        "mathematically undefined"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий присвоенного конкретного значения или смысла, особенно в математике или программировании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопределённый",
                                "target_lang_sense_clarification": "в математике или коде"
                            },
                            {
                                "target_lang_word": "не заданный",
                                "target_lang_sense_clarification": "о переменной или значении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7af9d8a6-0fb5-3ea9-ac67-5e729fb1dd3a",
                    "sense_definition": "Not clearly described, stated, or limited; vague or indistinct.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "lack of definition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project failed because the roles of the team members remained <w>undefined</w>.",
                            "target_lang_translations": {
                                "ru": "Проект провалился, потому что роли членов команды остались <w>неопределёнными</w>."
                            }
                        },
                        {
                            "text": "She possessed an <w>undefined</w> quality that made everyone in the room stop and listen.",
                            "target_lang_translations": {
                                "ru": "Она обладала неким <w>неуловимым</w> качеством, которое заставляло всех в комнате замолчать и прислушаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "indefinite",
                        "vague",
                        "indistinct"
                    ],
                    "antonyms": [
                        "defined"
                    ],
                    "common_phrases": [
                        "remain undefined",
                        "largely undefined"
                    ],
                    "target_lang_definitions": {
                        "ru": "Четко не описанный, не изложенный или не ограниченный; расплывчатый или неясный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопределённый",
                                "target_lang_sense_clarification": "неясный или нечеткий"
                            },
                            {
                                "target_lang_word": "неустановленный",
                                "target_lang_sense_clarification": "о ролях или границах"
                            },
                            {
                                "target_lang_word": "неуловимый",
                                "target_lang_sense_clarification": "о качестве или черте характера"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a1e3786-d196-3ba1-a334-299a6dfae9fe",
                    "sense_definition": "A value or variable that has not been assigned a specific definition or interpretation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lack of definition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The debugger showed several <w>undefineds</w> in the memory stack after the crash.",
                            "target_lang_translations": {
                                "ru": "Отладчик показал несколько <w>неопределённых значений</w> в стеке памяти после сбоя."
                            }
                        },
                        {
                            "text": "The array contains ten items including several <w>undefineds</w> that need to be filtered.",
                            "target_lang_translations": {
                                "ru": "Массив содержит десять элементов, включая несколько <w>неопределённых</w>, которые необходимо отфильтровать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
