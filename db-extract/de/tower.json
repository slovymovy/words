                                        "entry_id": "ad5ed156-0db0-323f-894a-04fe81e68a2e",
                                        "glosses": [
                                            "The nineteenth Lenormand card, representing structure, bureaucracy, stability and loneliness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c971698b-14c4-3295-a6c7-7df25d15567f",
                                        "entry_id": "ad5ed156-0db0-323f-894a-04fe81e68a2e",
                                        "glosses": [
