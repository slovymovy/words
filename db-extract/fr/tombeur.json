                    {
                        "translation_id": "eae63890-035d-46e3-87c5-acadb7a3c23e",
                        "source_entry_id": "3e44c482-ed80-38c6-8e35-0ac681155dd0",
                        "source_sense_description": "Séducteur",
                        "target_lang_word": "Frauenheld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frauenheld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d10cf60d-c2ea-3025-9dd6-7dc7f54127b4",
                                        "entry_id": "59b440e5-c590-3d51-860c-689302b9ccd7",
                                        "glosses": [
                                            "Mann, der bei Frauen besonders gut ankommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05246a2-119d-4fc3-94dc-9b984c86a50b",
                                                "sense_id": "d10cf60d-c2ea-3025-9dd6-7dc7f54127b4",
                                                "text": "„Wobei das Wort für ›Huhn‹, galinha, nicht, wie etwa chicken im Englischen (›Don't be a chicken about it!‹), für ›Memme‹, sondern, etwas überraschend, trotz des weiblichen a galinha, für einen Mann steht, der hinter den Frauen her ist, den Schürzenjäger oder Frauenheld.“"
                                            },
                                            {
                                                "example_id": "7332d82f-e558-4d10-be35-d8630f3aa919",
                                                "sense_id": "d10cf60d-c2ea-3025-9dd6-7dc7f54127b4",
                                                "text": "„Das sind die schrecklichsten Augenblicke im Leben eines Frauenhelden; etwas Grausameres gibt es nicht.“"
                                            },
                                            {
                                                "example_id": "f627d445-b86d-4096-8467-52e2b47b4728",
                                                "sense_id": "d10cf60d-c2ea-3025-9dd6-7dc7f54127b4",
                                                "text": "„Sie passen nur so schön zu den Klischees, die ohnehin schon über den Lebemann, Frauenheld und Trinker kursieren.“"
                                            },
                                            {
                                                "example_id": "5239fcd0-2b8d-46e4-9194-d3b3d81cec7f",
                                                "sense_id": "d10cf60d-c2ea-3025-9dd6-7dc7f54127b4",
                                                "text": "„Ersterer sei ein Frauenheld, Letztere ein Flittchen im Ansehen der meisten Leute, die dumme und frauenfeindliche Vorurteile unhinterfragt schluckten und nachplapperten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04b65fc5-1d37-403d-a367-964f00f6a188",
                        "source_entry_id": "3e44c482-ed80-38c6-8e35-0ac681155dd0",
                        "source_sense_description": "Séducteur",
                        "target_lang_word": "Playboy",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Playboy",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                        "entry_id": "1b91a141-4116-3fc9-bb5e-2ff7b83adc26",
                                        "glosses": [
                                            "Mann, der finanziell unabhängig ist und seinen Vergnügungen nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac7d601-f043-4847-8bc2-89c9dda37f64",
                                                "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                                "text": "Gunther Sachs war der Inbegriff eines Playboys."
                                            },
                                            {
                                                "example_id": "a6e4064a-fb9c-41b6-8cdb-2ac05ce88a9f",
                                                "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                                "text": "Ein echter Playboy fährt Porsche oder Jaguar, vielleicht einen Rolls, und er logiert in erstklassigen Hotels."
                                            },
                                            {
                                                "example_id": "5afbf7f9-80ea-4953-8b7b-ccbd1add59f7",
                                                "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                                "text": "„Als er nun durch die Hochzeit mit meiner Großmutter zu einem reichen Ehemann geworden war, spielte er den Playboy und fand im Spielcasino seinen liebsten Aufenthaltsort.“"
                                            },
                                            {
                                                "example_id": "936f0747-6d47-451c-9d5d-2f73a06b17bf",
                                                "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                                "text": "„Der sie liebende Mann ist nicht Rennfahrer, sondern ihr Arzt (David Niven), und ein Playboy und Rennfahrer (Richard Conte), der für viel Herzensverwirrung sorgt, ist auch da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
