                ],
                "senses": [
                    {
                        "sense_id": "ff6a0ac6-0795-34a6-9554-4a0671ee13ed",
                        "entry_id": "ea0cd929-2e9c-3138-afc6-82c41b1e4359",
                        "glosses": [
                            "człowiek, który stracił nadzieję na coś; ktoś, kto jest gotowy na wszystko, bez zwracania uwagi na konsekwencje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70608bdf-c22b-4853-9766-3d5c45fddc2e",
                                "sense_id": "ff6a0ac6-0795-34a6-9554-4a0671ee13ed",
                                "text": "Jakiś desperat wyszedł na dach i grozi, że skoczy!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "068b45b0-39e1-46d3-8fb9-38b0e1d08376",
                        "source_entry_id": "ea0cd929-2e9c-3138-afc6-82c41b1e4359",
                        "source_sense_id": "ff6a0ac6-0795-34a6-9554-4a0671ee13ed",
                        "target_lang_word": "despairer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despairer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a300a85-d441-354c-ac31-47edbfd3d8f4",
                                        "entry_id": "e51ce107-d2c9-3743-86f7-3a05b51ed493",
                                        "glosses": [
                                            "One who despairs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a86e2f3-7a6d-42ac-887d-6e5abc8cfbd9",
                                                "sense_id": "7a300a85-d441-354c-ac31-47edbfd3d8f4",
                                                "text": "He chears the fearful, and commends the bold, / And makes deſpairers hope for good ſucceſs."
                                            },
                                            {
                                                "example_id": "a3713604-eb75-4234-832f-5d5ce26b7055",
                                                "sense_id": "7a300a85-d441-354c-ac31-47edbfd3d8f4",
                                                "text": "O despairer, here is my neck, / By God! you shall not go down! Hang your whole weight upon me."
                                            },
                                            {
                                                "example_id": "10da6a51-d7db-4136-8d88-413b2239274b",
                                                "sense_id": "7a300a85-d441-354c-ac31-47edbfd3d8f4",
                                                "text": "Too quick despairer, wherefore wilt thou go?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "932698c6-fc5b-4691-83f5-44826a2a4bf7",
                        "source_entry_id": "ea0cd929-2e9c-3138-afc6-82c41b1e4359",
                        "source_sense_id": "ff6a0ac6-0795-34a6-9554-4a0671ee13ed",
                        "target_lang_word": "désespéré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désespéré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1afccbf8-5bdf-3fca-b5aa-6dff8cdfb1e7",
                                        "entry_id": "2bfdd8c2-e923-3ff8-aa70-33257b34db37",
                                        "glosses": [
                                            "Qui est dans le désespoir, qui agit par désespoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3842e0c5-5f03-486c-a56e-b76feb8861e8",
                                                "sense_id": "1afccbf8-5bdf-3fca-b5aa-6dff8cdfb1e7",
                                                "text": "Vous m’en voyez désespéré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da77222-8815-3017-bc79-e695043c1c54",
                                        "entry_id": "2bfdd8c2-e923-3ff8-aa70-33257b34db37",
                                        "glosses": [
                                            "Qui est inspiré par le désespoir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "637f1b62-08b8-421b-8882-cc5ccdae5ed0",
                                                "sense_id": "1da77222-8815-3017-bc79-e695043c1c54",
                                                "text": "Aujourd’hui nos fils sont sceptiques et blasés sur les bancs du collége. Mais en 1820, on n’était que désespéré avec Werther, René ou le Giaour, et cela était infiniment préférable ; car on pratiquait le désespoir en amateur, et on le portait en homme de goût."
                                            },
                                            {
                                                "example_id": "87f76279-8d00-4936-9d3c-17de0455f7f6",
                                                "sense_id": "1da77222-8815-3017-bc79-e695043c1c54",
                                                "text": "Il pâlit un peu, puis, tentant un effort désespéré, réussit à dégager un pied, tandis que l’autre restait prisonnier de la glu mouvante et fétide des profondeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3365ef61-80e0-31bd-b87d-a79e11a41c98",
                                        "entry_id": "2bfdd8c2-e923-3ff8-aa70-33257b34db37",
                                        "glosses": [
                                            "Qui cause du désespoir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35ee1860-b8a8-37a6-bd79-cd297cb0e11d",
                                        "entry_id": "2bfdd8c2-e923-3ff8-aa70-33257b34db37",
                                        "glosses": [
                                            "Pour lequel il n'y a aucun espoir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4730b27-2895-471d-ac63-453dbcfe9c26",
                                                "sense_id": "35ee1860-b8a8-37a6-bd79-cd297cb0e11d",
                                                "text": "Un mal désespéré."
                                            },
                                            {
                                                "example_id": "ad381ede-94e0-412a-984a-ae66565215ca",
                                                "sense_id": "35ee1860-b8a8-37a6-bd79-cd297cb0e11d",
                                                "text": "Un malade désespéré."
                                            },
                                            {
                                                "example_id": "ee557942-c62e-4b32-92b9-b8ec6bc86257",
                                                "sense_id": "35ee1860-b8a8-37a6-bd79-cd297cb0e11d",
                                                "text": "Un cas désespéré."
                                            },
                                            {
                                                "example_id": "4d1ed1e2-771b-4216-8646-293ca40bf124",
                                                "sense_id": "35ee1860-b8a8-37a6-bd79-cd297cb0e11d",
                                                "text": "L’eau, sans hâte, mais sans interruption, irrésistible et lourde, montait dans la cale, et, à mesure qu’elle montait, le navire descendait. Cela était très lent. Les naufragés de la Matutina sentaient peu à peu s’entr’ouvrir sous eux la plus désespérée des catastrophes, la catastrophe inerte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5cafe1f-4124-3446-bfe8-5ea1104ff11a",
                                        "entry_id": "2bfdd8c2-e923-3ff8-aa70-33257b34db37",
                                        "glosses": [
                                            "Qualifie l'état d'un malade à toute extrémité et qu’on s’attend à voir mourir d’un instant à l’autre, ou d’une chose dont la perte, la ruine, etc., est regardée comme inévitable."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "désespéré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bdecf68-5459-3f13-a155-aaa910ce2ec6",
                                        "entry_id": "88be9991-5f8d-3d53-a321-8155213ffbf9",
                                        "glosses": [
                                            "Celui qui agit par désespoir, dans le désespoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9268771b-a44b-4217-bbb7-bfdacf386150",
                                                "sense_id": "2bdecf68-5459-3f13-a155-aaa910ce2ec6",
                                                "text": "Et bien des fois, descendu dans la nuit des géhennes sociales, j’ai porté aux moribonds la résignation, l’espérance aux désespérés ; bien des fois j’ai changé en cris de joie les lamentations farouches de ces damnés."
                                            },
                                            {
                                                "example_id": "8f5487a3-9bdc-4097-8b30-156219b1485f",
                                                "sense_id": "2bdecf68-5459-3f13-a155-aaa910ce2ec6",
                                                "text": "Le docteur remarqua que Grand, parlant de Cottard, l’appelait toujours le « désespéré ». Il employa même à un moment l’expression « résolution fatale ». Ils discutèrent sur le motif du suicide, et Grand se montra tatillon sur le choix des termes. On s’arrêta enfin sur les mots « chagrins intimes »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "désespéré",
                                "target_lang_code": "fr",
                                "target_senses": [
