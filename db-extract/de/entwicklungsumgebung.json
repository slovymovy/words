                ],
                "senses": [
                    {
                        "sense_id": "27941956-e7cb-3929-92f9-7960a23a655c",
                        "entry_id": "dbaaf455-d49e-3889-90e0-3780d71ea5cf",
                        "glosses": [
                            "Gesamtumstände, Tools und Datenmaterial, die für den Entstehungsprozess einer EDV-Lösung bereitstehen; Testumgebung, die man verwendet, bevor ein fertiggestelltes Programm ›echte‹ Daten verarbeitet"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "0895276b-2e40-4793-80b9-bd54427d4c3b",
                                "sense_id": "27941956-e7cb-3929-92f9-7960a23a655c",
                                "text": "„Eine Entwicklungsumgebung für Schwarmrobotikexperimente umfasst diverse Systeme, die in einem System integriert werden müssen, um nahtlos in einander zu greifen.“"
                            },
                            {
                                "example_id": "53293e02-3fd3-47b2-97fb-0795a4717e3a",
                                "sense_id": "27941956-e7cb-3929-92f9-7960a23a655c",
                                "text": "„VBA ist aber noch viel mehr als nur eine Programmiersprache. VBA besitzt außerdem eine Entwicklungsumgebung (IDE = Integrated Development Environment). Zusätzliche Werkzeuge erlauben das Testen und Optimieren von Prozeduren.“"
                            },
                            {
                                "example_id": "a34b9d6b-6c3d-4e32-b29b-d75ae7f30268",
                                "sense_id": "27941956-e7cb-3929-92f9-7960a23a655c",
                                "text": "„Eine funktionierende Entwicklungsumgebung ist ein absolutes Muss für eine erfolgreiche Entwicklungsarbeit. Sie benötigen eine strukturierte Umgebung, die es Ihnen ermöglicht, Ihre Build-Prozesse effizient auszuführen und zu wiederholen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
