                    {
                        "translation_id": "ca9f2953-a9df-4ffa-95c1-a77e10b4dd6f",
                        "source_entry_id": "2172242a-12c4-378a-8da4-3c4020d09121",
                        "source_sense_id": "43be0558-0351-3e26-a228-ace0837582ad",
                        "source_sense_description": "relativ: durch welche eben erwähnte Sache",
                        "target_lang_word": "moyennant quoi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moyennant quoi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4519d0dd-a020-3e8d-bf83-854b1f194028",
                                        "entry_id": "eb81e34c-ae8b-3e11-98ef-cec98a0b0d0c",
                                        "glosses": [
                                            "À cette condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be84bb78-4b84-4a74-b559-e318f0043939",
                                                "sense_id": "4519d0dd-a020-3e8d-bf83-854b1f194028",
                                                "text": "Il fera certainement de bons ouvrages, moyennant quoi il mourra de faim, sera honni et persécuté ; mais il faut que chacun remplisse sa destinée."
                                            },
                                            {
                                                "example_id": "c0006402-64df-46a9-b1ad-63481ef3d272",
                                                "sense_id": "4519d0dd-a020-3e8d-bf83-854b1f194028",
                                                "text": "Toute caravane qui entrait dans le territoire du sultan d’Ayar devait payer cette taxe, moyennant quoi elle était, théoriquement du moins, sous la protection du sultan jusqu’à ce qu’elle quitte le territoire placé sous son commandement."
                                            },
                                            {
                                                "example_id": "702f0f3c-a0ed-4185-9cd5-3bed221dc17a",
                                                "sense_id": "4519d0dd-a020-3e8d-bf83-854b1f194028",
                                                "text": "Mes parents, ma famille, tout le monde dans ce pays — ils font quelques vagues prières tous les jours, jeûnent quand il faut, donnent une piécette au mendiant qui passe — moyennant quoi, les voilà sereins et tranquilles."
                                            },
                                            {
                                                "example_id": "e843bc6c-f634-4914-bb9c-e05d964f292d",
                                                "sense_id": "4519d0dd-a020-3e8d-bf83-854b1f194028",
                                                "text": "Moyennant quoi, cette relation devint, dans la maison Péricourt, un secret de Polichinelle. Les domestiques s’amusaient à imiter le pas de leur patronne montant l’escalier de service en tapinois, en prenant des mines gourmandes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
