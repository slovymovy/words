                "senses": [
                    {
                        "sense_id": "8f2435fe-e826-38ca-926c-b5ede6f99807",
                        "entry_id": "b8a52b91-921d-3771-986d-322feb29cf3b",
                        "glosses": [
                            "onzinnig verhaal dat geen belangrijke waarheid bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ddefee1-6559-47a8-a2e4-37314262fee6",
                                "sense_id": "8f2435fe-e826-38ca-926c-b5ede6f99807",
                                "text": "Waarom ik telkens maar weer luisterde naar dat kletsverhaal over die ongelukkige nicht; waarom ik u op grond daarvan volkomen billijkte in uw respijt; waarom ik u altijd bezwoer dat ook ik wilde dat het met genoegen van alle vrienden en magen zou zijn en dat ik liever nog wat wachtte en uitstel wou dan dat er in dezen enige wrijving zou ontstaan? Ook ik veinsde, Juffrouw, net als u."
                            },
                            {
                                "example_id": "eab5f93a-7d33-4567-8431-79636df66b36",
                                "sense_id": "8f2435fe-e826-38ca-926c-b5ede6f99807",
                                "text": "De motie om de uiteenlopende instellingstarieven voor studenten aan te pakken kwam eerder dit jaar van D66 kamerlid Paul van Meenen. Hij vindt het onjuist om vaste kosten, voor bijvoorbeeld gebouwen, te verrekenen op deze studenten. \"Dat is een kletsverhaal. Voor die vaste kosten krijgen ze toch al volledige subsidie van het rijk. Het is niet nodig om dat ook nog eens verhalen op deze studenten.\""
                            }
                        ]
                    }
