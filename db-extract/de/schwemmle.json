                "senses": [
                    {
                        "sense_id": "3cacda1f-fc9f-34fd-9e09-63a9d75c5c2b",
                        "entry_id": "967e73d5-98e3-3d9b-85b3-4a0e884f3552",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19d76ec3-4a27-4188-a1f7-a3fa0a219fed",
                                "sense_id": "3cacda1f-fc9f-34fd-9e09-63a9d75c5c2b",
                                "text": "Frau Schwemmle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f57873e6-7a6b-466c-a7ea-34577ca44c6f",
                                "sense_id": "3cacda1f-fc9f-34fd-9e09-63a9d75c5c2b",
                                "text": "Herr Schwemmle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6f5c4fc3-d324-4ede-ba3a-337ad44c1fd6",
                                "sense_id": "3cacda1f-fc9f-34fd-9e09-63a9d75c5c2b",
                                "text": "Die Schwemmles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "97cc8396-7455-431f-b1b3-f4a31c27cc13",
                                "sense_id": "3cacda1f-fc9f-34fd-9e09-63a9d75c5c2b",
                                "text": "Der Schwemmle trägt nie die Pullover, die die Schwemmle ihm strickt."
                            },
                            {
                                "example_id": "957a6859-0be6-43e9-afc0-016cf6b528f0",
                                "sense_id": "3cacda1f-fc9f-34fd-9e09-63a9d75c5c2b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schwemmle kommt, geht der Herr Schwemmle.“"
                            },
                            {
                                "example_id": "87c61c06-6215-473e-98e0-31d2ff65de59",
                                "sense_id": "3cacda1f-fc9f-34fd-9e09-63a9d75c5c2b",
                                "text": "Schwemmle kommt und geht."
                            },
                            {
                                "example_id": "82097c1a-4b24-4cca-9524-d8408dcf2546",
                                "sense_id": "3cacda1f-fc9f-34fd-9e09-63a9d75c5c2b",
                                "text": "Schwemmles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
