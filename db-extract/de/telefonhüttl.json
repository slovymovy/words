                "senses": [
                    {
                        "sense_id": "5598771d-ed74-3c12-bbb4-563bbeb1db4d",
                        "entry_id": "f0bd7471-48e9-3c33-a6a2-9dad38d0e85a",
                        "glosses": [
                            "mit einem Telefon ausgestattete Kabine im öffentlichen Raum"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1af89c3e-7e92-4e65-90a8-199c94645c52",
                                "sense_id": "5598771d-ed74-3c12-bbb4-563bbeb1db4d",
                                "text": "„Von Bücherei bis Telefonhüttl: Schüler zeigen, wo und wie Neubau sparsam mit Ressourcen umgeht.“"
                            },
                            {
                                "example_id": "8ec7faa7-4bde-4ccd-80c9-3d8dcfbe14b3",
                                "sense_id": "5598771d-ed74-3c12-bbb4-563bbeb1db4d",
                                "text": "„Für „interurbane“ Gespräche ging man aufs Postamt, für Ortsgespräche ins nächste Telefonhüttl.“"
                            },
                            {
                                "example_id": "8f8be7a4-1a32-4876-83ff-38a147e79632",
                                "sense_id": "5598771d-ed74-3c12-bbb4-563bbeb1db4d",
                                "text": "„Für seine erste nennenswerte Rolle besetzte er stundenlang ein Telefonhüttl in Hollywood, ehe der Rückruf des Produzenten (der TV-Erfolgsserie „Familienbande“, 1982–1989) kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
