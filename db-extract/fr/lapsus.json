        "fr-extract.jsonl": [
            {
                "entry_id": "19ab62f0-7db3-3763-9d88-0022b493a9a5",
                "word": "lapsus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                        "entry_id": "19ab62f0-7db3-3763-9d88-0022b493a9a5",
                        "glosses": [
                            "Erreur involontaire qui fait dire à une personne autre chose que ce qu’elle avait prévu d’exprimer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b3d9a02-d095-4d33-b70d-db11e07b8b6b",
                                "sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                                "text": "Nous sommes foudroyés, dit-il. Il voulait dire « fourvoyés », mais c'était là un lapsus léger et que rendaient excusable, d'ailleurs, ces circonstances exceptionnelles."
                            },
                            {
                                "example_id": "c7adf280-5ce4-4b90-bfc1-56450406d1d7",
                                "sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                                "text": "Un lapsus, une faute de prononciation, le soufflet sur la joue d’un clown, peuvent créer un accès irrésistible avant qu’aucun couple comparatif de concepts ait eu le temps d’intervenir. Le rire a jailli avec la rapidité du réflexe ; il est souvent aussi véloce que le geste d’un instinct élémentaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a26b146-1570-4ae9-a99e-1caf856df645",
                        "source_entry_id": "19ab62f0-7db3-3763-9d88-0022b493a9a5",
                        "source_sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                        "target_lang_word": "lapsus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6d46b83c-e5b9-4083-bd3e-3127b12132c9",
                        "source_entry_id": "19ab62f0-7db3-3763-9d88-0022b493a9a5",
                        "source_sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                        "target_lang_word": "Versprechen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versprechen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                        "entry_id": "9998ce03-3c9e-3144-9d5b-ec93dca45ced",
                                        "glosses": [
                                            "Zusicherung einer Handlungsweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b93dd546-86c5-4908-a01a-c2e8cf17dbf7",
                                                "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                                "text": "Bei einem Versprechen legt sich der Sprecher darauf fest, dass er in Zukunft etwas Bestimmtes tun oder unterlassen wird."
                                            },
                                            {
                                                "example_id": "ad289ff1-0ab2-4ab7-bea4-eafa09f2aa87",
                                                "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                                "text": "„Die Verteidigungsministerin bekräftigte zugleich ihr Versprechen, den Dienst in der Truppe attraktiver und familienfreundlicher zu gestalten.“"
                                            },
                                            {
                                                "example_id": "80e9600a-69ea-47cc-8739-80fd1ab17533",
                                                "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                                "text": "„Anna Michailowna teilte Natascha mit ein paar Worten den Inhalt des Briefes mit und nahm ihr das Versprechen ab, niemandem etwas davon zu sagen.“"
                                            },
                                            {
                                                "example_id": "76085211-730f-4ab8-b404-807138718d6a",
                                                "sense_id": "0bc55ef6-852e-35c7-85ce-f7bc8dd29af2",
                                                "text": "„Endlich befreite sie ein Herr, der das Kreuz der Ehrenlegion trug; und nachdem sie ihre Namen, Vornamen und Wohnort angegeben hatten, zogen sie ab mit dem Versprechen, in Zukunft vorsichtiger zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0dff4ed-3d69-3c47-9080-dc0f93b4a503",
                                        "entry_id": "9998ce03-3c9e-3144-9d5b-ec93dca45ced",
                                        "glosses": [
                                            "Vorgang, irrtümlich etwas Anderes zu sagen, als man sagen wollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ec685c-f80e-4990-975f-67acd2a8f46d",
                                                "sense_id": "c0dff4ed-3d69-3c47-9080-dc0f93b4a503",
                                                "text": "„Druckfehler entstehen jedoch nicht einfach nur durch einen technisch-mechanischen Fehler, sondern sie sind wie oft beim Versprechen oder Verhören auch sinnvolle Versprecher im Sinne der Psychoanalyse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d38ea10-847d-48b3-8319-4da6afb5695c",
                        "source_entry_id": "19ab62f0-7db3-3763-9d88-0022b493a9a5",
                        "source_sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                        "target_lang_word": "Sprachpanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachpanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9ad968c-25a0-30fc-9354-a03bc2a6a09d",
                                        "entry_id": "8e5393eb-8dd0-3bc4-a209-524784b115d8",
                                        "glosses": [
                                            "unabsichtlicher Fehler bei der Verwendung von Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3231122-38a2-4e96-84e4-f90cea102423",
                                                "sense_id": "b9ad968c-25a0-30fc-9354-a03bc2a6a09d",
                                                "text": "„Andererseits machte er uns die Notwendigkeit von interdisziplinären Forschungen über das Zustandekommen von »Sprachpannen« bis hin zu deren Vermeidung bewusst.“"
                                            },
                                            {
                                                "example_id": "63401056-bffc-4ea6-990d-e0a0f3097505",
                                                "sense_id": "b9ad968c-25a0-30fc-9354-a03bc2a6a09d",
                                                "text": "„Lustige Sprachpannen findet man überall auf der Welt.“"
                                            },
                                            {
                                                "example_id": "f5a05835-60cb-48f3-a68e-2bbd9514c26c",
                                                "sense_id": "b9ad968c-25a0-30fc-9354-a03bc2a6a09d",
                                                "text": "„Gerade jetzt zur Ferienzeit schnappen Touristen wieder Unmengen lustiger Sprachpannen auf.“"
                                            },
                                            {
                                                "example_id": "404dccf2-c54b-4a33-a3cd-24c3609d7b0a",
                                                "sense_id": "b9ad968c-25a0-30fc-9354-a03bc2a6a09d",
                                                "text": "„In der Rubrik »Sprachpannen« wurde uns heute mit der süffisant formulierten Frage »Hülsenfrüchte zum Segeln?« die vermeintlich falsche Überschrift aus einem Seglermagazin präsentiert: »Leinen los und Schoten dicht!«“"
                                            },
                                            {
                                                "example_id": "6932d414-7164-48e1-9b4f-19ae730ca8b2",
                                                "sense_id": "b9ad968c-25a0-30fc-9354-a03bc2a6a09d",
                                                "text": "„Einen etwas anderen Stellenwert in der Gruppe der Sprachpannen haben die Verschreiber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
