                "senses": [
                    {
                        "sense_id": "f066ba66-4496-35b5-b7f0-93cc2473891f",
                        "entry_id": "53645eb0-e132-34cf-be60-66f63ca4ecaa",
                        "glosses": [
                            "Unable to leave one's bed, especially because of illness, weakness or obesity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c823512f-d7de-4036-896a-c7e7745345a0",
                                "sense_id": "f066ba66-4496-35b5-b7f0-93cc2473891f",
                                "text": "1796, Robert Burns, letter written to Mr. Cunningham, 7 July, 1796, in The Prose Works of Robert Burns; Containing his Letters and Correspondence, Newcastle-upon-Tyne: Mackenzie & Dent, 1819, p. 278 https://books.google.ca/books?id=gzYBAAAAQAAJ&printsec=frontcover#v=onepage&q&f=false\nFor these eight or ten months I have been ailing, sometimes bedfast and sometimes not; but these last three months I have been tortured with an excruciating rheumatism, which has reduced me to nearly the last stage."
                            },
                            {
                                "example_id": "0aaa3a6c-e994-43af-b5e4-08a9c04b18d5",
                                "sense_id": "f066ba66-4496-35b5-b7f0-93cc2473891f",
                                "text": "1948, Robert Heinlein, Space Cadet (1948), from the edition reissued in 1975 by Tom Doherty Associates, LLC: p. 118, lines 13 through 15.\n\"She had been a very active woman... Now she was bed-fast and had been for three years.\""
                            },
                            {
                                "example_id": "4ab3cdc6-be84-4f64-bcdb-7585e2c68b9e",
                                "sense_id": "f066ba66-4496-35b5-b7f0-93cc2473891f",
                                "text": "1976, Carlos Fuentes, Terra Nostra (1975), translated by Margaret Sayers Peden, Dalkey Archive, 2003, p. 592,\n\"It is a place of bed-fast people, Señor, where all those who tire of life, or of whom life has tired, exhausted old men, disillusioned youths, dishonored families, take to their beds and pledge never to arise until death carries them off feet-first. […] \""
                            },
                            {
                                "example_id": "2a352e7a-f992-49c2-bf61-da94764b363a",
                                "sense_id": "f066ba66-4496-35b5-b7f0-93cc2473891f",
                                "text": "From then on Joachim assumed a permanently horizontal position, and Hans Castorp wrote to Luise Ziemssen about it—wrote to her from his splendid lounge chair that he must now add to his earlier occasional reports the news that Joachim was bedfast […]"
                            }
                        ]
                    }
                ],
