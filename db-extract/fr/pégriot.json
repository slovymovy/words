                        "glosses": [
                            "Membre sans envergure de la pègre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e574cce3-f2db-4f86-b41c-1bb115ae4bc3",
                                "sense_id": "d49d4068-29cd-3a6b-a36e-e6c09eb5de22",
                                "text": "L’enfant ignorant et abandonné devient pégriot, on l’envoie en prison, il en sort voleur, c’est toujours la même chanson avec des variations différentes."
                            },
                            {
                                "example_id": "d44276b2-1dcc-4489-b875-72d2eb6d65d7",
                                "sense_id": "d49d4068-29cd-3a6b-a36e-e6c09eb5de22",
                                "text": "Cette bande, composée de jeunes pégriots dont les scélératesses dépassaient le nombre des années, avait pour chef un voleur expérimenté qui, dès l’âge le plus tendre, avait eu maille à partir avec la justice."
                            },
                            {
                                "example_id": "125cd72c-ac56-4cc8-8868-85aee0789fbe",
                                "sense_id": "d49d4068-29cd-3a6b-a36e-e6c09eb5de22",
                                "text": "Ce type n’est pas un pégriot."
                            }
                        ]
