                        "translation_id": "f0b3fc03-ce26-4fe6-a317-d274a47bcd63",
                        "source_entry_id": "415553ec-b520-3005-ab03-dcb7e5383d31",
                        "source_sense_id": "bfd50c19-d149-309e-a064-3fd504a0efcb",
                        "target_lang_word": "Gemeindemitglied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemeindemitglied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30903214-7aec-30ff-9519-7468f01bca3b",
                                        "entry_id": "595bbe6f-bd26-30f4-9270-d227410be836",
                                        "glosses": [
                                            "Person, die zu einer Gemeinde gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a52c0f77-8f95-481e-a718-e651b21356e5",
                                                "sense_id": "30903214-7aec-30ff-9519-7468f01bca3b",
                                                "text": "„Andre Gemeindemitglieder standen in der Nähe und warteten auch auf die Antwort.“"
                                            },
                                            {
                                                "example_id": "5d414e1a-d777-469a-8820-a620fbdae996",
                                                "sense_id": "30903214-7aec-30ff-9519-7468f01bca3b",
                                                "text": "„Die jüngeren Gemeindemitglieder waren alle bei dem Rennen, die älteren mit ihrem Nachmittagsschläfchen beschäftigt gewesen.“"
                                            },
                                            {
                                                "example_id": "e06c0bca-33df-435a-9785-5799dc0215b8",
                                                "sense_id": "30903214-7aec-30ff-9519-7468f01bca3b",
                                                "text": "„Die Gemeindemitglieder haben nicht nur zu gehorchen, sondern auch für den Unterhalt derjenigen zu sorgen, denen sie Gehorsam schulden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "504e7d59-08f2-4dd8-8561-87db25d4f6d5",
                        "source_entry_id": "415553ec-b520-3005-ab03-dcb7e5383d31",
