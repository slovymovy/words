                                        "entry_id": "cafc9f02-d440-3c07-bb90-6a2df227cdff",
                                        "glosses": [
                                            "nummer bij het alpineskiën; slalom waarbij de poortjes verder uit elkaar staan dan bij een gewone slalom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5670d5d-1791-43cd-a85d-bb6c3ba20178",
                                                "sense_id": "e7105089-75c7-3c76-9543-7f4c85858638",
                                                "text": "Maarten Meiners eindigt als 26ste in Santa Caterina Vulfurva en is de eerste Nederlander die op de reuzenslalom WB-punten verovert"
                                            },
                                            {
                                                "example_id": "ee2d230b-7a56-479b-904b-af0031b5e719",
                                                "sense_id": "e7105089-75c7-3c76-9543-7f4c85858638",
                                                "text": "Mikaela Shiffrin heeft in Courchevel een reuzenslalom voor de wereldbeker gewonnen. Het was de 68ste wereldbekerzege voor de 25-jarige Amerikaanse en de twaalfde op dit nummer."
                                            }
