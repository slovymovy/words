                                "target_senses": [
                                    {
                                        "sense_id": "a8d8e82e-47e5-3b91-a121-608416cc459f",
                                        "entry_id": "0ed21b64-24a6-3301-ab2f-27df2a714cf3",
                                        "glosses": [
                                            "A large residential building or compound that is fortified and contains many defences; in previous ages often inhabited by a nobleman or king. Also, a house or mansion with some of the architectural features of medieval castles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e9310ea-c11a-380d-a7fa-04a13c518ad8",
                                        "entry_id": "0ed21b64-24a6-3301-ab2f-27df2a714cf3",
                                        "glosses": [
                                            "An instance of castling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f998661-22d6-309c-b1c5-9c9220242d36",
                                        "entry_id": "0ed21b64-24a6-3301-ab2f-27df2a714cf3",
                                        "glosses": [
                                            "A rook; a chess piece shaped like a castle tower."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5490633c-0652-37eb-ad0f-5921325e83e1",
                                        "entry_id": "0ed21b64-24a6-3301-ab2f-27df2a714cf3",
                                        "glosses": [
                                            "A defense structure in shogi formed by defensive pieces surrounding the king."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bb9e220-1b0d-3a2f-81e8-758eb9d63257",
                                        "entry_id": "0ed21b64-24a6-3301-ab2f-27df2a714cf3",
                                        "glosses": [
                                            "A close helmet."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d6d9ece-d3e0-4d78-98d7-6f787a781730",
                                                "sense_id": "6bb9e220-1b0d-3a2f-81e8-758eb9d63257",
                                                "text": "The castle was perhaps a figurative name for a close headpiece deduced from its enclosing and defending the head, as a castle did the whole body; or a corruption from the Old French word casquetel, a small or light helmet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84082b54-1e90-3470-87f8-a3e3b43ee945",
                                        "entry_id": "0ed21b64-24a6-3301-ab2f-27df2a714cf3",
                                        "glosses": [
                                            "Any strong, imposing, and stately palace or mansion."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36941ed3-2d49-3aea-aff1-e7e9a09777b8",
                                        "entry_id": "0ed21b64-24a6-3301-ab2f-27df2a714cf3",
                                        "glosses": [
                                            "A small tower, as on a ship, or an elephant's back."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8113d834-e14a-3a3d-bca0-15f9f74284c4",
                                        "entry_id": "0ed21b64-24a6-3301-ab2f-27df2a714cf3",
                                        "glosses": [
                                            "The wicket."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc3da354-d660-4dd4-85ea-d2508ed0e22d",
                                                "sense_id": "8113d834-e14a-3a3d-bca0-15f9f74284c4",
                                                "text": "Nay, he was quite an adept, and was very effective as a change bowler, for in no time he demolished the castle of any batsman."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "castle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6185e38-e0ad-3774-8eb7-255b45cfc2b1",
                                        "entry_id": "0e0690c4-b709-35fe-be45-656d1cb84ad5",
                                        "glosses": [
                                            "To house or keep in a castle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35311f9d-65fe-4b0b-9f18-93847b3f66e3",
                                                "sense_id": "a6185e38-e0ad-3774-8eb7-255b45cfc2b1",
                                                "text": "...to encastle, to Castle."
                                            },
                                            {
                                                "example_id": "c1d625ad-20cc-4b1f-b44a-0a3133851dc3",
                                                "sense_id": "a6185e38-e0ad-3774-8eb7-255b45cfc2b1",
                                                "text": "...Some fierce tribe, castled on the mountain-peak..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d5c6088-fe46-3b55-a0b3-8868be59ffba",
                                        "entry_id": "0e0690c4-b709-35fe-be45-656d1cb84ad5",
                                        "glosses": [
                                            "To protect or separate in a similar way."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3f3a823-864e-488c-8cec-34c1c1f565ec",
                                                "sense_id": "0d5c6088-fe46-3b55-a0b3-8868be59ffba",
                                                "text": "Castle me in the armes of thy everlasting strength."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c9d940-047d-3727-9acd-6e7b4f88151d",
                                        "entry_id": "0e0690c4-b709-35fe-be45-656d1cb84ad5",
                                        "glosses": [
                                            "To make into a castle: to build in the form of a castle or add (real or imitation) battlements to an existing building."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e0ad0bc-fec6-3ae5-93b9-6b2a922cfb35",
                                        "entry_id": "0e0690c4-b709-35fe-be45-656d1cb84ad5",
                                        "glosses": [
                                            "To move the king 2 squares right or left and, in the same turn, the nearest rook to the far side of the king. The move now has special rules: the king cannot be in, go through, or end in check; the squares between the king and rook must be vacant; and neither piece may have been moved before castling."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66364150-16d7-43c8-bb51-5260a62ef20a",
                                                "sense_id": "5e0ad0bc-fec6-3ae5-93b9-6b2a922cfb35",
                                                "text": "He [i.e., the king] may change (or Castle) with this Rooke, that is, he may goe two draughts at once towards this Rooke... causing the Rooke to stand next to him on either side."
                                            },
                                            {
                                                "example_id": "397be39e-e82c-4598-92a7-40930ac5850f",
                                                "sense_id": "5e0ad0bc-fec6-3ae5-93b9-6b2a922cfb35",
                                                "text": "No. 24. ¶ If your adversary make a false move, castle improperly, &c., you must take notice of such irregularity before you move, or even touch a piece, or you are no longer allowed to inflict any penalties."
                                            },
                                            {
                                                "example_id": "1ac569cd-23c6-440e-bfe8-b9616d4ba29a",
                                                "sense_id": "5e0ad0bc-fec6-3ae5-93b9-6b2a922cfb35",
                                                "text": "If a player having the move: […] touches his/her king and a rook he/she must castle on that side if it is legal to do so"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "907276d9-f151-3f5d-9aa4-726affe6241a",
                                        "entry_id": "0e0690c4-b709-35fe-be45-656d1cb84ad5",
                                        "glosses": [
                                            "To create a similar defensive position in Japanese chess through several moves."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f8bb868-90cd-3ad4-a0f5-e2160047fd43",
                                        "entry_id": "0e0690c4-b709-35fe-be45-656d1cb84ad5",
                                        "glosses": [
                                            "To bowl a batsman with a full-length ball or yorker such that the stumps are knocked over."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d079875-2477-4c7b-b890-90bc271e7b2b",
                                                "sense_id": "3f8bb868-90cd-3ad4-a0f5-e2160047fd43",
                                                "text": "And the 23-year-old brought the crowd to their feet when he castled Gayle's stumps, signalling the direction of the pavilion to his friend for good measure."
                                            },
                                            {
                                                "example_id": "13678802-9ace-4b5c-b9d8-4b765c7a92fa",
                                                "sense_id": "3f8bb868-90cd-3ad4-a0f5-e2160047fd43",
                                                "text": "He bowled Vinay with a full, straight ball that castled off stump and then dished up a yorker that RP Singh backed away to and sent onto his stumps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
