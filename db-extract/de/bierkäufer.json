                "senses": [
                    {
                        "sense_id": "b42d4377-25e4-3d2e-886c-bc5f25d6e33c",
                        "entry_id": "67ffb060-c8f7-3b57-9ee8-c1494ad84d7f",
                        "glosses": [
                            "Käufer von Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4a50ea-45ab-4db4-acf9-73ab5cef0154",
                                "sense_id": "b42d4377-25e4-3d2e-886c-bc5f25d6e33c",
                                "text": "Bierkäufer trifft man häufiger als Bierkäuferinnen."
                            },
                            {
                                "example_id": "b45fecb5-5f51-4827-9d8a-79713babe8fd",
                                "sense_id": "b42d4377-25e4-3d2e-886c-bc5f25d6e33c",
                                "text": "„Im Süden gebe es mehr kleine, lokale Brauer, mit denen sich die Bierkäufer verbunden fühlten, sagte Demleitner.“"
                            },
                            {
                                "example_id": "a7c00e68-eb1f-4303-b72a-fda1419ffabe",
                                "sense_id": "b42d4377-25e4-3d2e-886c-bc5f25d6e33c",
                                "text": "„Bezüglich der Einstellung der Bierkäufer zum alkoholfreien Bier konnte zusammenfassend festgestellt werden, dass: – bei 60 Prozent der Bierkäufer pauschale Vorurteile gegenüber dem Geschmack von alkoholfreien Bieren bestehen […]“"
                            },
                            {
                                "example_id": "1afe9d73-cc9f-4e54-8ae6-f3b87e094a6f",
                                "sense_id": "b42d4377-25e4-3d2e-886c-bc5f25d6e33c",
                                "text": "„Ob Deutschkurse für Flüchtlinge, antifaschistisches Festival oder Obdachlosencafé – wohin das Geld fließt, entscheiden die Bierkäufer online.“"
                            },
                            {
                                "example_id": "9029f38d-4628-4421-88cb-538af9ea3393",
                                "sense_id": "b42d4377-25e4-3d2e-886c-bc5f25d6e33c",
                                "text": "„Das Gedränge, stellte Häberle fest, war nahezu unerträglich, weil die Bierkäufer von allenSeiten den Verkaufsstand umlagerten und möglichst jeder der Erste sein wollte.“"
                            },
                            {
                                "example_id": "6bdb5a42-fcbb-4f99-84c4-a5ce619c5300",
                                "sense_id": "b42d4377-25e4-3d2e-886c-bc5f25d6e33c",
                                "text": "„Der Konsument wird nicht davon überzeugt, überhaupt Bier zu kaufen, sondern ein überzeugter Bierkäufer davon, Bier der Marke X statt der Marke U zu erwerben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
