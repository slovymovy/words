{
    "word_family": [
        "forge",
        "forgeage",
        "forgeron",
        "forgeur",
        "forgeable",
        "reforger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6f6e608-ae36-39e6-a5be-f50b1b0bebe3",
                    "sense_definition": "Travailler et façonner un métal chauffé au feu à l'aide d'un marteau.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travail_du_metal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan commence à <w>forger</w> une nouvelle lame dès l'aube dans son atelier."
                        },
                        {
                            "text": "Le forgeron <w>forge</w> le fer rouge sur son enclume avec une grande précision."
                        }
                    ],
                    "synonyms": [
                        "marteler",
                        "façonner"
                    ],
                    "common_phrases": [
                        "forger le fer",
                        "forger une épée"
                    ]
                },
                {
                    "sense_id": "f555b275-08d9-3fdd-a429-d2806b858014",
                    "sense_definition": "Créer, élaborer ou inventer quelque chose de manière progressive ou imaginative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les épreuves difficiles lui ont permis de se <w>forger</w> un caractère solide."
                        },
                        {
                            "text": "Cet écrivain aime <w>forger</w> des néologismes poétiques dans chacun de ses romans."
                        }
                    ],
                    "synonyms": [
                        "inventer",
                        "concevoir",
                        "élaborer"
                    ],
                    "common_phrases": [
                        "se forger une opinion",
                        "se forger un caractère",
                        "forger un mot"
                    ]
                },
                {
                    "sense_id": "80ecf12a-11fd-39f3-9485-52835c44f5ee",
                    "sense_definition": "Fabriquer frauduleusement ou falsifier un document, une preuve ou une signature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "falsification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a tenté de <w>forger</w> un faux testament pour s'emparer de l'héritage."
                        },
                        {
                            "text": "Les enquêteurs ont vite compris qu'il avait <w>forgé</w> ces preuves de toutes pièces."
                        }
                    ],
                    "synonyms": [
                        "falsifier",
                        "contrefaire"
                    ],
                    "common_phrases": [
                        "forger des preuves"
                    ]
                },
                {
                    "sense_id": "cd0511f5-250f-388e-9a61-c724b6a135b3",
                    "sense_definition": "Toucher, en marchant ou en trottant, les fers de devant avec ceux de derrière, en parlant d'un cheval.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier a remarqué que sa monture commençait à <w>forger</w> sur ce terrain accidenté."
                        },
                        {
                            "text": "Ce jeune cheval <w>forge</w> souvent au trot parce qu'il manque encore d'équilibre."
                        }
                    ]
                }
            ]
        }
    ]
}