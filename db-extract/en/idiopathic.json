                                            {
                                                "example_id": "b9d526b7-8e9d-4f64-94e1-1fbd5288610b",
                                                "sense_id": "2c7ce49e-2b39-345b-b4a4-2d0acadd536d",
                                                "text": "Während akut entzündliches Rheuma meist innerhalb weniger Wochen unter entsprechender Therapie wieder abheilt, ist die chronische Form, die Juvenile idiopathische Arthritis (JIA), eine ernsthafte Krankheit, die schwere Folgen haben kann."
                                            },
                                            {
                                                "example_id": "c3f7525c-78b3-44b9-8c48-47131761c54a",
                                                "sense_id": "2c7ce49e-2b39-345b-b4a4-2d0acadd536d",
                                                "text": "Offiziell ist das Nervengift zugelassen für die \"symptomatische Alternativbehandlung von idiopathischem Blepharospasmus und koexistierenden hemifacialen dystonen Bewegungsabläufen\"."
                                            },
                                            {
                                                "example_id": "63941774-8799-496b-bfa9-1ccef36eb726",
                                                "sense_id": "2c7ce49e-2b39-345b-b4a4-2d0acadd536d",
                                                "text": "Wenige Wochen vor dem Start stellten die Ärzte bei Slayton eine idiopathische Zerfaserung der Herzvorkammer fest."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
