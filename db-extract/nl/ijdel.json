                "senses": [
                    {
                        "sense_id": "c8bc22c5-8fe6-3465-a84a-c46e8b820e5d",
                        "entry_id": "97346424-fac7-36e6-9071-130a93fa0949",
                        "glosses": [
                            "vol van zelfbewondering, een te hoge dunk hebbend van het eigen voorkomen en/of de eigen bekwaamheden"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "570479ce-bb58-375d-bb64-34529f9c837b",
                        "entry_id": "97346424-fac7-36e6-9071-130a93fa0949",
                        "glosses": [
                            "van iets dat het mooi, maar niet realistisch is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04b5170-9b64-47dc-989d-01d113be33b7",
                                "sense_id": "570479ce-bb58-375d-bb64-34529f9c837b",
                                "text": "`Ik weet het; zei de majordomus. 'Het was ijdele hoop dat dit u zou ontgaan. Ik vraag u met klem de grootmoedigheid op te brengen om mijn nederige excuses te aanvaarden. Deze uit de toon vallende decoratie is het jammerlijke gevolg van het enthousiasme van de nieuwe eigenaar.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07fd6e5c-d600-4ec2-8c86-1af6e002e899",
                        "source_entry_id": "97346424-fac7-36e6-9071-130a93fa0949",
                        "source_sense_id": "c8bc22c5-8fe6-3465-a84a-c46e8b820e5d",
                        "source_sense_description": "vol van zelfbewondering, een te hoge dunk hebbend van het eigen voorkomen en/of de eigen bekwaamheden",
                        "target_lang_word": "vain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89f1aa16-c4c1-36f0-a613-06bb6551bfd5",
                                        "entry_id": "79ec26d2-de6f-3be4-aeb9-fa304d3ee8bf",
                                        "glosses": [
                                            "To frustrate."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2e6221a-ae86-3ef3-bbc5-fab5562ddccd",
                                        "entry_id": "98f38638-c872-392f-a323-08752db14f40",
                                        "glosses": [
                                            "Overly proud of oneself, especially concerning appearance; having a high opinion of one's own accomplishments with slight reason."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee4ee935-bde3-4f48-a971-3f77b307284a",
                                                "sense_id": "e2e6221a-ae86-3ef3-bbc5-fab5562ddccd",
                                                "text": "Every writer is a narcissist. This does not mean that he is vain; it only means that he is hopelessly self-absorbed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75718348-243a-3acc-9479-74cff293ca67",
                                        "entry_id": "98f38638-c872-392f-a323-08752db14f40",
                                        "glosses": [
                                            "Having no real substance, value, or importance; empty; void; worthless; unsatisfying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "376e01ad-fd8c-4376-9546-1d558024bf38",
                                                "sense_id": "75718348-243a-3acc-9479-74cff293ca67",
                                                "text": "I will not hear thy vain excuse"
                                            },
                                            {
                                                "example_id": "785a43a3-258b-4d95-91ca-2e6cd80d8794",
                                                "sense_id": "75718348-243a-3acc-9479-74cff293ca67",
                                                "text": "Let no man deceive you with vain words."
                                            },
                                            {
                                                "example_id": "a9e3e9f6-3968-4943-b076-dafd28bdfb32",
                                                "sense_id": "75718348-243a-3acc-9479-74cff293ca67",
                                                "text": "Vain wisdom all, and false philosophy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31491007-554a-370b-a187-6e46e31174bd",
                                        "entry_id": "98f38638-c872-392f-a323-08752db14f40",
                                        "glosses": [
                                            "Effecting no purpose; pointless, futile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987e2c5a-231c-4192-a25f-029cb153ef5b",
                                                "sense_id": "31491007-554a-370b-a187-6e46e31174bd",
                                                "text": "vain toil    a vain attempt"
                                            },
                                            {
                                                "example_id": "0076e200-17ff-441e-9897-d0c0389208eb",
                                                "sense_id": "31491007-554a-370b-a187-6e46e31174bd",
                                                "text": "Vain is the force of man / To crush the pillars which the pile sustain."
                                            },
                                            {
                                                "example_id": "fcc08920-99b7-47c8-98ee-67d8b7e6ff55",
                                                "sense_id": "31491007-554a-370b-a187-6e46e31174bd",
                                                "text": "At our old pastimes in the hall\n⁠We gambol’d, making vain pretence\n⁠Of gladness, with an awful sense\nOf one mute Shadow watching all."
                                            },
                                            {
                                                "example_id": "14e02f3c-cedc-4b07-963a-ab1222725781",
                                                "sense_id": "31491007-554a-370b-a187-6e46e31174bd",
                                                "text": "But Sophia's mother was not the woman to brook defiance. After a few moments' vain remonstrance her husband complied. His manner and appearance were suggestive of a satiated sea-lion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4566faba-5c49-3cd8-ba2f-298a4bed1a6d",
                                        "entry_id": "98f38638-c872-392f-a323-08752db14f40",
                                        "glosses": [
                                            "Showy; ostentatious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0871df17-2924-4a58-bc7c-dc5d38ce714f",
                                                "sense_id": "4566faba-5c49-3cd8-ba2f-298a4bed1a6d",
                                                "text": "Yet ſhall (my Lord) your juſt, your noble Rules / Fill half the land with imitating Fools: / VVho random dravvings from your ſheets ſhall take, / And of one beauty many blunders make; / Load ſome vain Church with old Theatric State, / Turn Arcs of Triumph to a Garden-gate, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
