                        "glosses": [
                            "Brotscheibe, die mit Honig bestrichen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a3ba49-5c36-4f68-afd1-74984bf00116",
                                "sense_id": "ed9e6fbf-a922-3e9f-86fc-949b27dd0015",
                                "text": "„Graeber erinnerte sich vage an zwei Kinder, die immerfort Honigbrote gegessen hatten.“"
                            },
                            {
                                "example_id": "30c4f66d-5d68-48cc-bfb9-8729ca88fe6b",
                                "sense_id": "ed9e6fbf-a922-3e9f-86fc-949b27dd0015",
                                "text": "„Sie weckte uns, schickte uns ins Bad und wartete in der Küche mit Honigbroten und Tee auf uns, mit sanften Augen und ruhigen Händen, und einer Stimme, die die Stille füllte, die das Verschwinden unserer Eltern hinterlassen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
