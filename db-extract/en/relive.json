                "senses": [
                    {
                        "sense_id": "e9ae9ca9-7162-314d-899b-da9ad62ef1eb",
                        "entry_id": "780bd2db-428d-3a0a-bdf8-0abc52bd9d8a",
                        "glosses": [
                            "To experience (something) again; to live over again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b25529d9-92d4-4c20-bea5-f0504f5d0d54",
                                "sense_id": "e9ae9ca9-7162-314d-899b-da9ad62ef1eb",
                                "text": "I relive that horrible accident every night and wake screaming."
                            },
                            {
                                "example_id": "e2ff8a4f-d01f-4e5a-a484-dbb8c146568b",
                                "sense_id": "e9ae9ca9-7162-314d-899b-da9ad62ef1eb",
                                "text": "Replays in video games allow you to relive your greatest moments."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc17f30e-8ff8-325d-81e5-943cb46a196d",
                        "entry_id": "780bd2db-428d-3a0a-bdf8-0abc52bd9d8a",
                        "glosses": [
                            "To bring back to life; to revive, resuscitate."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a2030fd9-4ebe-4aef-8356-12e291d9ed65",
                                "sense_id": "fc17f30e-8ff8-325d-81e5-943cb46a196d",
                                "text": "Had she not beene devoide of mortall slime, / Shee should not then have bene relyv'd againe [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "23f3ced8-7ba3-3af9-b295-3a9ef7881bfc",
                        "entry_id": "780bd2db-428d-3a0a-bdf8-0abc52bd9d8a",
                        "glosses": [
                            "To come back to life."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcd5d8ab-db46-4237-9983-eb302c0bae2b",
                        "source_entry_id": "780bd2db-428d-3a0a-bdf8-0abc52bd9d8a",
                        "source_sense_description": "to come back to life",
                        "target_lang_word": "revivre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revivre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc2881f0-f751-3f46-8d9d-034be71c3ee6",
                                        "entry_id": "5b07eebb-8750-328d-8bea-bd5308da8a5a",
                                        "glosses": [
                                            "Ressusciter, revenir à la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0642461b-dcab-4384-900f-e9ecfabca462",
                                                "sense_id": "cc2881f0-f751-3f46-8d9d-034be71c3ee6",
                                                "text": "On nous dit en vain que le grec s’est réfugié dans l’enseignement supérieur, qu'il demeure entier dans quelques chaires et dans quelques bibliothèques. C'est ici la plus grande stupidité que l'on ait dite dans les temps modernes, où pourtant on ne s'est pas privé de dire des stupidités. C'est comme si l'on disait que les anciens Égyptiens vivent et revivent dans les momies des sarcophages des salles basses du Louvre."
                                            },
                                            {
                                                "example_id": "230dec73-6d30-41e9-bd01-0e33d06bd60d",
                                                "sense_id": "cc2881f0-f751-3f46-8d9d-034be71c3ee6",
                                                "text": "Vous pleurez ; hélas! vos larmes ne la feront pas revivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8718be0a-1720-37c0-b0be-e2068496be7e",
                                        "entry_id": "5b07eebb-8750-328d-8bea-bd5308da8a5a",
                                        "glosses": [
                                            "Reprendre des forces, de la vigueur ; recevoir de l’espérance, de la joie."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ac6b25-feb3-4730-a06b-5e7885ede286",
                                                "sense_id": "8718be0a-1720-37c0-b0be-e2068496be7e",
                                                "text": "Il était dans une grande langueur, le remède qu’on lui a donné l’a fait revivre."
                                            },
                                            {
                                                "example_id": "5d925e46-70ae-47c1-ac74-c3df9a459781",
                                                "sense_id": "8718be0a-1720-37c0-b0be-e2068496be7e",
                                                "text": "Il était dans un étrange accablement d’esprit, la nouvelle qu’il a reçue l’a fait revivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f5de7c-5d9e-3e1b-acee-de9e08f3ba97",
                                        "entry_id": "5b07eebb-8750-328d-8bea-bd5308da8a5a",
                                        "glosses": [
                                            "Vivre pour ainsi dire de nouveau, se continuer en la personne d’un autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04e6cdf-a3ec-4dc1-85d9-9904dee302e5",
                                                "sense_id": "43f5de7c-5d9e-3e1b-acee-de9e08f3ba97",
                                                "text": "Les pères revivent dans leurs enfants."
                                            },
                                            {
                                                "example_id": "3f1b236b-97dc-45ca-b269-8bab8925fc9f",
                                                "sense_id": "43f5de7c-5d9e-3e1b-acee-de9e08f3ba97",
                                                "text": "On vit revivre dans cet empereur Auguste et Titus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd24f570-975e-3398-be5a-67e1d556fa07",
                                        "entry_id": "5b07eebb-8750-328d-8bea-bd5308da8a5a",
                                        "glosses": [
                                            "Retrouver une sorte de vie dans la mémoire collective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b0ebec-f1ea-4eea-9058-7a182a460061",
                                                "sense_id": "bd24f570-975e-3398-be5a-67e1d556fa07",
                                                "text": "Paresseusement et presque amèrement, il se remémora ses dernières soirées. […]. Il revécut l’instant où, après sa rapide descente à travers les nuées, il avait aperçu, tout près, au-dessous de lui, les crêtes des vagues argentées par le crépuscule."
                                            },
                                            {
                                                "example_id": "d8a534f4-8250-4e6c-8cc1-7723a2facf17",
                                                "sense_id": "bd24f570-975e-3398-be5a-67e1d556fa07",
                                                "text": "L’épopée fait revivre les héros des temps passés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7f87acf-d020-30e4-9bc2-0458cc7b07f1",
                                        "entry_id": "5b07eebb-8750-328d-8bea-bd5308da8a5a",
                                        "glosses": [
                                            "Renaître, se renouveler, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23c8298-137c-4977-af46-af26a6a63e23",
                                                "sense_id": "c7f87acf-d020-30e4-9bc2-0458cc7b07f1",
                                                "text": "La fierté, l’orgueil de ses aïeux revivait en lui."
                                            },
                                            {
                                                "example_id": "8906593b-a638-4bd9-96f3-8b3bc2c9e4fe",
                                                "sense_id": "c7f87acf-d020-30e4-9bc2-0458cc7b07f1",
                                                "text": "J’ai vu revivre cette mode, qui était passée depuis longtemps."
                                            },
                                            {
                                                "example_id": "e6fa7139-6264-4af8-9c43-d13975c913a6",
                                                "sense_id": "c7f87acf-d020-30e4-9bc2-0458cc7b07f1",
                                                "text": "À la paix, l’industrie sembla revivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                        "entry_id": "5b07eebb-8750-328d-8bea-bd5308da8a5a",
                                        "glosses": [
                                            "Se ranimer, se remettre de nouveau en honneur, en vogue, en crédit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5caa1ecb-4413-459d-8a20-a3fba07aa14d",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Faire revivre une hérésie, une opinion, un système, une mode."
                                            },
                                            {
                                                "example_id": "1a80cdc1-03ff-4091-b97a-8dd10fb04117",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Faire revivre des mots tombés en désuétude."
                                            },
                                            {
                                                "example_id": "2b183134-6752-4ada-8d98-9785f4995d93",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Il fait revivre en lui la gloire de ses ancêtres, en imitant leurs grandes actions."
                                            },
                                            {
                                                "example_id": "6e1e876c-86e6-4263-b050-e84ae95ce74e",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Je déplie une paperole de An sur Katia : Katia est une femme admirable, contrairement à Marie. J'ai décidé d'aider Katia à revoir son amant et à revivre charnellement avec lui, […]."
                                            },
                                            {
                                                "example_id": "bec74c74-2a3c-4301-8460-23360e14b9e4",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Ce nouveau procès a fait revivre la haine qui existait entre ces deux familles."
                                            },
                                            {
                                                "example_id": "03f1603a-33aa-4dc1-a303-046e1b5c8eff",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Faire revivre des droits, des prétentions, etc., Les faire valoir de nouveau."
                                            },
                                            {
                                                "example_id": "e3db53e3-dacf-45f5-9b97-92afcd16b02a",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Faire revivre une charge, Rétablir une charge qui avait été éteinte ou supprimée."
                                            },
                                            {
                                                "example_id": "9e2acc4c-a836-493e-b75c-af5cc6eff7e9",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Faire revivre les couleurs d’un tableau, Leur donner un nouvel éclat."
                                            },
                                            {
                                                "example_id": "09c836fd-49c1-45c8-ba42-dabd8dc5fafb",
                                                "sense_id": "f893b995-fc30-307e-bfd4-692b7600dcd2",
                                                "text": "Faire revivre de vieilles écritures, Les faire reparaître, les rendre lisibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
