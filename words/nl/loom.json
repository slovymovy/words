                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>loom</w> de hele dag al vanwege de extreme hitte in de stad.",
                            "target_lang_translations": {
                                "en": "I <w>feel languid</w> all day because of the extreme heat in the city."
