                "senses": [
                    {
                        "sense_id": "a054d787-2de4-3416-980b-321a2cdf1b3c",
                        "entry_id": "10b8cbaa-ae99-34c5-bb84-d814325a4229",
                        "glosses": [
                            "Donner un caractère véhiculaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c4af59-88e3-4ac2-93fe-1dbf072e1cc7",
                                "sense_id": "a054d787-2de4-3416-980b-321a2cdf1b3c",
                                "text": "Ce colinguisme, on le verra, emprunte autant à la domination internationale de l’anglais qu’à une société qui revendique farouchement sa francité et cherche à véhiculariser l’usage du français."
                            },
                            {
                                "example_id": "3b3b0c8e-649c-4b98-9005-dd17f8d26c55",
                                "sense_id": "a054d787-2de4-3416-980b-321a2cdf1b3c",
                                "text": "Présenté au début comme une langue ésotérique parlée par les jeunes délinquants, le nouchi tend à « se véhiculariser »."
                            }
                        ]
                    }
