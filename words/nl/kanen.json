{
    "word_family": [
        "kaan",
        "gekaand"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "224af548-0a26-36c1-a0f7-286459f0170c",
                    "sense_definition": "met veel smaak of gulzigheid eten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange wandeling zaten de kinderen heerlijk te <w>kanen</w> van hun pannenkoeken.",
                            "target_lang_translations": {
                                "en": "After the long walk, the children were happily <w>chowing down</w> on their pancakes."
                            }
                        },
                        {
                            "text": "Hij kan de hele avond <w>lekker kanen</w> terwijl hij naar een film kijkt.",
                            "target_lang_translations": {
                                "en": "He can spend the whole evening <w>feasting away</w> while watching a movie."
                            }
                        }
                    ],
                    "synonyms": [
                        "smullen",
                        "vreten",
                        "bikken",
                        "schransen"
                    ],
                    "common_phrases": [
                        "lekker kanen",
                        "zitten te kanen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To eat with great pleasure, gusto, or greedily, often in an informal context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to chow down",
                                "target_lang_sense_clarification": "informal, eating heartily"
                            },
                            {
                                "target_lang_word": "to pig out",
                                "target_lang_sense_clarification": "eating greedily or in large amounts"
                            },
                            {
                                "target_lang_word": "to tuck in",
                                "target_lang_sense_clarification": "to start eating enthusiastically"
                            },
                            {
                                "target_lang_word": "to feast",
                                "target_lang_sense_clarification": "to eat with great enjoyment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f331970a-2b5b-38c6-b601-c8e7de4cd264",
                    "sense_definition": "het proces van muf worden of gaan schimmelen, vaak gezegd van vloeistoffen of voedsel",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bederf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude wijn begon te <w>kanen</w> nadat de fles te lang open had gestaan.",
                            "target_lang_translations": {
                                "en": "The old wine started <w>to spoil</w> after the bottle had been open for too long."
                            }
                        },
                        {
                            "text": "Je moet die jam weggooien omdat het oppervlak al begint te <w>kanen</w>.",
                            "target_lang_translations": {
                                "en": "You should throw that jam away because the surface is already starting <w>to go moldy</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schimmelen",
                        "verschimmelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regionaal of verouderd gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The process of becoming musty or starting to mold, typically referring to liquids or food."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to go moldy",
                                "target_lang_sense_clarification": "developing fungus"
                            },
                            {
                                "target_lang_word": "to spoil",
                                "target_lang_sense_clarification": "becoming unfit for consumption"
                            },
                            {
                                "target_lang_word": "to go off",
                                "target_lang_sense_clarification": "becoming stale or bad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ce3e10a-6bc0-3d4f-a44c-4034d21a18be",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>kaan</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger werden <w>kanen</w> vaak gegeten als een hartige snack bij de borrel.",
                            "target_lang_translations": {
                                "en": "In the past, <w>greaves</w> were often eaten as a savory snack with drinks."
                            }
                        },
                        {
                            "text": "De slager verkocht versgebakken <w>kanen</w> die overbleven na het smelten van het vet.",
                            "target_lang_translations": {
                                "en": "The butcher sold freshly fried <w>cracklings</w> that remained after rendering the fat."
                            }
                        }
                    ],
                    "synonyms": [
                        "kaantjes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'kaan'; refers to greaves or cracklings, which are the fatty remains after rendering lard."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "greaves",
                                "target_lang_sense_clarification": "fibrous residue of lard rendering"
                            },
                            {
                                "target_lang_word": "cracklings",
                                "target_lang_sense_clarification": "crispy fried pieces of animal fat"
                            },
                            {
                                "target_lang_word": "pork rinds",
                                "target_lang_sense_clarification": "similar snack made from pig skin/fat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
