                    "sense_id": "bdd8361f-de19-3ac3-98bb-c7a5b88e8952",
                    "sense_definition": "omlaag stappen van een vervoermiddel zoals een fiets, motor of paard",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vervoermiddel verlaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet bij de drukke kruising even <w>afstappen</w> en met de fiets aan de hand lopen.",
                            "target_lang_translations": {
                                "en": "You have to <w>get off</w> for a moment at the busy intersection and walk with your bike in hand."
                            }
                        },
                        {
                            "text": "Toen hij bij zijn huis aankwam, kon hij eindelijk van zijn fiets <w>afstappen</w>.",
                            "target_lang_translations": {
                                "en": "When he arrived at his house, he could finally <w>dismount</w> from his bike."
                            }
                        }
                    ],
                    "synonyms": [
