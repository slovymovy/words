                "senses": [
                    {
                        "sense_id": "ba290b6d-8b24-3012-9691-f0a66a2ade9b",
                        "entry_id": "4ff0ab86-df72-3929-9417-06dc649fcd64",
                        "glosses": [
                            "ein italienischer Hartkäse aus Kuhmilch"
                        ],
                        "tags": [
                            "italienische Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "2f4873b6-39d9-44a1-8396-4fb23068a205",
                                "sense_id": "ba290b6d-8b24-3012-9691-f0a66a2ade9b",
                                "text": "„[…] er […] findet am Ortseingang einen Tante-Emma-Laden. Die Dame verkauft Ravioli, etwa zum doppelten Normalpreis. Parmesankäse hat sie nicht. Vielleicht tut es auch Gouda in Scheiben.“"
                            },
                            {
                                "example_id": "221761cd-9662-418d-b6c0-a61e6a8d9783",
                                "sense_id": "ba290b6d-8b24-3012-9691-f0a66a2ade9b",
                                "text": "„Sie legten rasch drei Gedecke auf, brachten Brot, Parmesankäse und Wasser, und unter Gelächter aßen sie und tranken mit mir den ihnen ganz ungewohnten Zyperwein, der ihnen bald in den Kopf stieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
