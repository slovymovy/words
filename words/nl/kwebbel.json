            "senses": [
                {
                    "sense_id": "d688ffca-07b5-32ee-8f35-04e075556fa4",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>kwebbelen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kwebbel</w> vaak met mijn buurvrouw over de tuin.",
                            "target_lang_translations": {
                                "en": "I often <w>chatter</w> with my neighbor about the garden."
                            }
                        },
                        {
                            "text": "Als ik zenuwachtig ben, <w>kwebbel</w> ik aan één stuk door.",
                            "target_lang_translations": {
                                "en": "When I am nervous, I <w>babble</w> on and on."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'kwebbelen' (to chatter/babble)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chatter",
                                "target_lang_sense_clarification": "to talk rapidly about trivial matters"
                            },
                            {
                                "target_lang_word": "babble",
                                "target_lang_sense_clarification": "to talk in a way that is difficult to understand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40b241be-05ae-3fca-b221-15035325de74",
