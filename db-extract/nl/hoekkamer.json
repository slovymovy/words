                "senses": [
                    {
                        "sense_id": "b101e903-efae-343f-8e70-2e81b1d3d2bb",
                        "entry_id": "98d51f49-2b8a-37ee-8847-53540bd5e69f",
                        "glosses": [
                            "een kamer die gelegen is in de hoek van een gebouw en dus ramen in meerdere muren kan hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60dac492-ff74-4428-bfec-a7dfde7bfc45",
                                "sense_id": "b101e903-efae-343f-8e70-2e81b1d3d2bb",
                                "text": "Daar hing het portret sinds 1992 in een vrij donkere hoekkamer boven een haard, waar het menig bezoeker nauwelijks opviel. Mondriaan heeft het portret van de toen zestienjarige Wilhelmina waarschijnlijk naar een foto geschilderd als een studieobject."
                            },
                            {
                                "example_id": "7dc3da4f-f1bb-4686-af0a-91336c11c8fe",
                                "sense_id": "b101e903-efae-343f-8e70-2e81b1d3d2bb",
                                "text": "Aan de ene kant twee grote ramen met een weids uitzicht over de Utrechtse achterlanden (wel even over de passerende treinen heenkijken) en aan de andere kant van deze hoekkamer zit een grote deur met dito raam dat bij helder weer uitzicht biedt op Utrecht."
                            },
                            {
                                "example_id": "aa8e5acb-3d1f-41ab-9c3b-21fe78ea2ee9",
                                "sense_id": "b101e903-efae-343f-8e70-2e81b1d3d2bb",
                                "text": "Heel spannend is het niet, de winnaar zelf weet het al. \"Maar niet alle aanwezigen,\" zegt Martijn van Schieveen. De pr-man wil nog iets van spanning erin houden, hier in de Vriendenlounge in de Hermitage, een kleine hoekkamer met drie statafels en een beamer."
                            }
                        ]
                    }
