                        "glosses": [
                            "Onomatopée qui sert à désigner un bruit rappelant celui des cloches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b8af36-1cd4-44ce-80dd-48c65d4ce921",
                                "sense_id": "c43f7ed7-f62d-3c8b-867c-3e337779365b",
                                "text": "Qu’est-ce qu’on peut mettre dans une valise qui ne pèse pas lourd et qui ne fait pas glin-glin comme des couteaux de chasse ou un pistolet à plombs devraient faire ?"
                            },
                            {
                                "example_id": "7f84134b-5810-40e1-8fbf-4bb083c9feba",
                                "sense_id": "c43f7ed7-f62d-3c8b-867c-3e337779365b",
                                "text": "Or une cloche, dans le dialecte de certaines régions, « glingue » et, à l'oreille, elle fait « glin-glin »."
                            },
                            {
                                "example_id": "6c962c58-0eb7-44cb-812b-97c42d3bc5e8",
                                "sense_id": "c43f7ed7-f62d-3c8b-867c-3e337779365b",
                                "text": "Le glin-glin du moindre seing était la condamnation au malheur, aux privations, à la famine."
                            }
                        ]
                    }
