                    },
                    {
                        "sense_id": "accaf23f-7d41-3f5f-ad9e-9bc2de7f9589",
                        "entry_id": "03bf93ec-cf25-365e-ba16-360f4df060db",
                        "glosses": [
                            "The union of something with a body already existing; association; intimate union; assimilation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c3194cb-448a-4e93-807a-094c5a2af15a",
                                "sense_id": "accaf23f-7d41-3f5f-ad9e-9bc2de7f9589",
                                "text": "After the city's incorporation into the capital district, the population rose."
                            }
                        ]
                    },
                    {
                        "sense_id": "e62880c5-bf9e-3ae5-9ec3-4f369baee97f",
                        "entry_id": "03bf93ec-cf25-365e-ba16-360f4df060db",
                        "glosses": [
                            "The act of creating a corporation."
