                },
                {
                    "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                    "sense_definition": "Zweiter, ergänzender Titel eines Buches oder Textes, der unter dem Haupttitel steht.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "text_untertitel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das neue Sachbuch trägt den <w>Untertitel</w> „Eine Einführung für Anfänger“."
                        },
                        {
                            "text": "Der Autor entschied sich kurz vor dem Druck für einen treffenderen <w>Untertitel</w>."
