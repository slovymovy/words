                                "example_id": "7a21a697-91ec-4287-a025-0ee7f8924440",
                                "sense_id": "86ad6062-1ab5-3fcb-b7c3-ffe5dcdf47b6",
                                "text": "[It] overlapped significantly with some aspects of antiblack ideologies in the United States, through forms of antiblack racism in Cuba that preceded the U.S. occupation. As de la Fuente notes, calls for de-Africanization […]"
                            },
                            {
                                "example_id": "1496443c-3558-4621-aa84-f741ba28e3ee",
                                "sense_id": "86ad6062-1ab5-3fcb-b7c3-ffe5dcdf47b6",
                                "text": "The unpublished study found that the answers revealed little evidence of antiblack bias[…]"
                            }
