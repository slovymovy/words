        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9da19504-2c0b-38c3-82ef-5fc12e7f7be4",
                "word": "er",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b3e7143f-55d6-362c-8208-cb0ade9c5402",
                        "entry_id": "9da19504-2c0b-38c3-82ef-5fc12e7f7be4",
                        "glosses": [
                            "Said when hesitating in speech."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2b77560f-a9e9-4d11-b342-4c837ffe2ba4",
                                "sense_id": "b3e7143f-55d6-362c-8208-cb0ade9c5402",
                                "text": "As the years go by, speech reverts to childhood levels of disfluency, with more pauses, more errors, more repeated words, but even the peak years are not great: up to 8 percent of the average person’s word output consists of meaningless fillers and placeholders like um, uh and er."
                            },
                            {
                                "example_id": "859c2df0-fc97-452f-b816-cfc8fa1a2e62",
                                "sense_id": "b3e7143f-55d6-362c-8208-cb0ade9c5402",
                                "text": "If he—er—disappears—well, it seems to me that we'd both benefit."
                            },
                            {
                                "example_id": "48b06899-9039-4b84-ae12-17b526381eee",
                                "sense_id": "b3e7143f-55d6-362c-8208-cb0ade9c5402",
                                "text": "Liquid Samurai: 'FORMLESS AND INFINITE ARE WE, THE LIQUID SAMURAI. I SERVE MY QUEEN, AS WE HAVE FOR COUNTLESS--' / Mona: 'HEY, I DON'T MEAN TO INTERRUPT, BUT YOU SEEM LIKE YOU'RE MADE OF POWERFUL STUFF. CAN I, ER, STUDY YOU?'"
                            }
                        ]
                    }
                ],
