                        "examples": [
                            {
                                "example_id": "0e370eb9-9d22-489c-a29c-a1dfc19a66fb",
                                "sense_id": "15c86a6a-4a9f-3cca-a1aa-31d51a1dd8d4",
                                "text": "„Diese reichen von einfachen »flachen« Modellen bis hin zu unterschiedlichen Möglichkeiten einer Gliederung der internen Silbenstruktur.“"
                            },
                            {
                                "example_id": "e7fae0d1-2145-4aa6-830d-d574a2916068",
                                "sense_id": "15c86a6a-4a9f-3cca-a1aa-31d51a1dd8d4",
                                "text": "„Seit dem Spätmittelalter werden die Länge oder Kürze von Vokalen durch die Silbenstruktur der Wurzelwörter bestimmt (…).“"
                            },
                            {
                                "example_id": "d63198fc-1208-44fa-9600-2d0872d02778",
                                "sense_id": "15c86a6a-4a9f-3cca-a1aa-31d51a1dd8d4",
                                "text": "„Ein zweites Problem betrifft die Silbenstruktur und die Anwendung der Sonoranzbeschränkung.“"
                            }
                        ],
