                "senses": [
                    {
                        "sense_id": "5b59f414-b473-394b-b8db-3f8eaf353ea8",
                        "entry_id": "96990f84-da97-3d0e-8db2-d3eac6566023",
                        "glosses": [
                            "Person, die jemanden oder etwas dringend zum Leben braucht, davon in einer gewissen Art abhängig ist, der zum Beispiel auf (finanzielle) Unterstützung/Hilfe oder Medikamente/Suchtmittel angewiesen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96d2963-4f92-4a6b-9ff6-ecd214a565f0",
                                "sense_id": "5b59f414-b473-394b-b8db-3f8eaf353ea8",
                                "text": "„Die Abhängigen, die in der Drogenklinik in Hamburg-Moorfleet ankommen, haben in der Regel Entgiftungen, geschlossene Psychiatrie und verschiedene Behandlungen hinter sich.“"
                            },
                            {
                                "example_id": "847f76ce-b614-4386-b3f1-c93386ec2c5f",
                                "sense_id": "5b59f414-b473-394b-b8db-3f8eaf353ea8",
                                "text": "„Wenn er George Geld für seine Mutter gab, so gab er dem Knaben in seiner gewöhnlichen brutalen, rohen Weise zu verstehen, daß Georges Großvater mütterlicherseits nur ein erbärmlicher alter Bankrotteur und Abhängiger sei und daß John Sedley dem Mann, dem er bereits so viel Geld schuldete, dankbar sein müsse für die Hilfe, die sein, Osbornes, Edelmut ihm gewährte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
