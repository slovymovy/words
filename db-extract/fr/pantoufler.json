                "senses": [
                    {
                        "sense_id": "c955f23d-690b-3f01-92af-62d909a226c7",
                        "entry_id": "0094347b-4b8a-3150-ba42-2acbc73ff92f",
                        "glosses": [
                            "Aller travailler dans une entreprise privée pour un haut-fonctionnaire (généralement un ancien élève de l’École polytechnique ou de l’École nationale d’administration). À une certaine époque le fonctionnaire devait payer un dédit nommé pantoufle."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a517c52d-4a9f-47dd-ab42-9fa9abe386b4",
                                "sense_id": "c955f23d-690b-3f01-92af-62d909a226c7",
                                "text": "Mais la technocratie administrative est cousine germaine de celle qui « pantoufle » au service du grand capital."
                            },
                            {
                                "example_id": "46dac4ea-d790-410b-b873-65593d2f7330",
                                "sense_id": "c955f23d-690b-3f01-92af-62d909a226c7",
                                "text": "Entre 1985 et 1990, le Conseil d’État a compté une moyenne annuelle de quatre départs de ses membres partis pantoufler."
                            }
                        ]
                    }
                ],
