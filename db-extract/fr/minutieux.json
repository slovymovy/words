                        "source_entry_id": "63d6c0f5-62ea-3bfb-885f-6176603e0e9f",
                        "target_lang_word": "painstaking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
