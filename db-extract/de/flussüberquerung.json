                "senses": [
                    {
                        "sense_id": "f30108a8-b367-3369-83e0-18cf12d1ac0d",
                        "entry_id": "17826c24-60ab-3e14-9ce0-5fe51b963a46",
                        "glosses": [
                            "Überquerung eines Flusses, Wechsel von einer Flussseite auf die andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bfd2c70-4aca-4385-9f66-0c9120d61941",
                                "sense_id": "f30108a8-b367-3369-83e0-18cf12d1ac0d",
                                "text": "„›Ertrunken‹, sagte Miller. ›Bei einer Flussüberquerung auf dem Rückweg.‹“"
                            },
                            {
                                "example_id": "90a2c626-af14-4e25-958a-0316d0cce058",
                                "sense_id": "f30108a8-b367-3369-83e0-18cf12d1ac0d",
                                "text": "„Captain Henry, der überlegte, wofür er sich entscheiden sollte, verfluchte Harris dafür, dass er ihnen nicht an einer früheren Stelle ein Zeichen zur Flussüberquerung hinterlassen hatte.“"
                            }
                        ],
