                        "ru": [
                            {
                                "target_lang_word": "издал звук",
                                "target_lang_sense_clarification": "о высоком металлическом звуке"
                            },
                            {
                                "target_lang_word": "пропищал",
                                "target_lang_sense_clarification": "о звуковом сигнале прибора"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pípl",
                                "target_lang_sense_clarification": "vydal vysoký zvuk (o přístroji)"
                            },
                            {
                                "target_lang_word": "cinknul",
                                "target_lang_sense_clarification": "vydal kovový zvuk"
                            }
                        ]
                    }
                }
            ]
        },
        {
