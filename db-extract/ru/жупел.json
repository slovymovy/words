                ],
                "senses": [
                    {
                        "sense_id": "22240ec3-3e84-35cf-b905-5dd8d56d5680",
                        "entry_id": "7744503c-f48b-340b-a690-8db5b21f38d8",
                        "glosses": [
                            "brimstone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b619d78-0b8b-467c-aa97-4def2ac3225b",
                                "sense_id": "22240ec3-3e84-35cf-b905-5dd8d56d5680",
                                "text": "Где огнь и жу́пел, дым и смрад…",
                                "translation": "Where fire and brimstone, smoke and stench…",
                                "english": "Where fire and brimstone, smoke and stench…"
                            },
                            {
                                "example_id": "de9a6f65-dc91-4824-863b-a02cfbbbe7ea",
                                "sense_id": "22240ec3-3e84-35cf-b905-5dd8d56d5680",
                                "text": "[…] осо́бенно в зако́не уголо́вном до́лжно смотре́ть, что́бы цель устраше́ния не обраща́лась в цель жесто́кости, и чтоб зако́ны не поража́ли наро́д дождём и огня́ и жу́пела, о ко́ем говори́т Писа́ние […]",
                                "translation": "[…] especial care must be taken in criminal law that the purpose of intimidation does not turn into the purpose of cruelty, and that the laws do not punish the people with the rain of fire and brimstone of which the Scripture tells […]",
                                "english": "[…] especial care must be taken in criminal law that the purpose of intimidation does not turn into the purpose of cruelty, and that the laws do not punish the people with the rain of fire and brimstone of which the Scripture tells […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "2d16a250-9b68-38dc-9490-8ceb0fa40c61",
                        "entry_id": "7744503c-f48b-340b-a690-8db5b21f38d8",
                        "glosses": [
                            "bogeyman, bête noire (something frightening or unpleasant, or something used to frighten)"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c92eb2c9-2634-4065-932d-5acf7676af8c",
                                "sense_id": "2d16a250-9b68-38dc-9490-8ceb0fa40c61",
                                "text": "А ведь захвати́ли э́тот дом как раз при том стро́е, из кото́рого сде́лали и́стинно мирово́й жу́пел.",
                                "translation": "And keep in mind that this house was taken over in the time of precisely that regime which they have turned into the world's greatest bogeyman.",
                                "english": "And keep in mind that this house was taken over in the time of precisely that regime which they have turned into the world's greatest bogeyman."
                            }
                        ]
                    }
                ],
