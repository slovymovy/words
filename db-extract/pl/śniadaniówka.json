                                                "example_id": "e57db971-9a43-4163-bfeb-cfda42d2ed25",
                                                "sense_id": "cc18c23e-fd25-378b-ba09-596821bdc129",
                                                "text": "Jack was carrying his lunchbox with him."
                                            }
                                        ]
                                    },
                                    {
