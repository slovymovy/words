                    {
                        "translation_id": "28ba9881-15ad-43ad-a043-904819170bb3",
                        "source_entry_id": "e445a051-007f-3118-b995-d1ef562b9105",
                        "source_sense_description": "public building housing courts of law",
                        "target_lang_word": "Gerichtsgebäude",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerichtsgebäude",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7d2a441-6ccf-3572-bfd6-65bd231b389f",
                                        "entry_id": "ba4a9b5f-6997-31d7-8246-3ac45bdea969",
                                        "glosses": [
                                            "Bauwerk, in dem sich ein Gericht befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f0d817-f264-4064-9add-356d3f049bdb",
                                                "sense_id": "f7d2a441-6ccf-3572-bfd6-65bd231b389f",
                                                "text": "„Für 5,5 Millionen Euro wurde das Flüchtlingsheim darum in ein Gerichtsgebäude für nur einen Prozess verwandelt, in einen Hochsicherheitsbau.“"
                                            },
                                            {
                                                "example_id": "5d02ee7a-0bb9-4d68-87a3-1106c582b363",
                                                "sense_id": "f7d2a441-6ccf-3572-bfd6-65bd231b389f",
                                                "text": "„Um halb zwei erreichte er das Gerichtsgebäude, und für einen Moment fiel alle Sorge von ihm ab.“"
                                            },
                                            {
                                                "example_id": "a9ee2771-9f7d-4cc8-b08f-287de4c8931a",
                                                "sense_id": "f7d2a441-6ccf-3572-bfd6-65bd231b389f",
                                                "text": "„Als er die Treppe vor dem Gerichtsgebäude hinuntergeht, hört er das eilige Klackern von Damenschuhen hinter sich, in denen sich Vera Priori befindet.“"
                                            },
                                            {
                                                "example_id": "064cf797-5573-46a2-b7d4-fdbdbb8dd8e0",
                                                "sense_id": "f7d2a441-6ccf-3572-bfd6-65bd231b389f",
                                                "text": "„Es war ein kalter, windiger Tag, als er das Gerichtsgebäude zum letzten Mal verließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
