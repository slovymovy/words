                "senses": [
                    {
                        "sense_id": "f360a680-5f68-37b3-b87e-f813ee4d69fc",
                        "entry_id": "eaa1865c-a2d1-31f0-9676-12ada750c7cd",
                        "glosses": [
                            "bösartiges Sarkom von Lymphknoten aus in das Nachbargewebe hinein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5944e8b7-9b8b-49f6-a896-9ec3c50536df",
                                "sense_id": "f360a680-5f68-37b3-b87e-f813ee4d69fc",
                                "text": "„Im vorigen November war bei dem Sänger von Hits wie \"Biene Maja\" und \"Schicksalsmelodie\" Lymphdrüsenkrebs festgestellt worden.“"
                            },
                            {
                                "example_id": "097b86a0-8401-493a-94c8-521ac0507743",
                                "sense_id": "f360a680-5f68-37b3-b87e-f813ee4d69fc",
                                "text": "„Heute reagiert der Körper der jungen Frau, die noch dazu seit einer Chemotherapie wegen Lymphdrüsenkrebs vor vier Jahren an den Rollstuhl gefesselt ist, allergisch auf fast alle Gerüche.“"
                            }
                        ],
