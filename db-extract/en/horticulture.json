                        "target_lang_word": "horticulture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horticulture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cca7795f-fce7-3e47-ae84-b2cb44a53a02",
                                        "entry_id": "9127a5d1-aaa5-395e-90a3-5853b7a628de",
                                        "glosses": [
                                            "Art de cultiver les jardins."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "619574f0-7f36-4571-bee2-4960f1f73268",
                                                "sense_id": "cca7795f-fce7-3e47-ae84-b2cb44a53a02",
                                                "text": "Contrairement à presque toutes les autres sphères de ma vie où je consomme les biens et les maux sans délai, en horticulture, je dois attendre."
                                            },
                                            {
                                                "example_id": "f0be6c67-73ca-4692-82c7-3ca68f3c53e7",
                                                "sense_id": "cca7795f-fce7-3e47-ae84-b2cb44a53a02",
                                                "text": "[…], M. Smallways se livrait à l’horticulture, sur ce dernier bout de terrain investi de jour en jour plus étroitement par les accaparements urbains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0e39b6d-6f66-4955-8613-47447c6f48d2",
                        "source_entry_id": "6088aa8c-e749-30d2-9320-f254d4ff7dd3",
                        "source_sense_description": "the science of caring for gardens",
                        "target_lang_word": "Gartenkultur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gartenkultur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6430623-ebd0-323a-b326-d7a116975082",
                                        "entry_id": "a4c7a344-4d5a-3205-b1b8-51223d3081cc",
                                        "glosses": [
                                            "reflektierte und schöpferische Gartengestaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00775c81-d01b-4276-a94b-074305d14204",
                                                "sense_id": "b6430623-ebd0-323a-b326-d7a116975082",
                                                "text": "„Die Gartenkultur, also die Gestaltung von Parks und Anlagen, das Arrangement aus Pflanzen, Wegen, Skulpturen und Gebäuden, die Technik, Gehölze zu schneiden und anzuordnen, die hat vor allem europäische Wurzeln.“"
                                            },
                                            {
                                                "example_id": "3dc0726f-ebe6-43d6-91dc-b3fed8fe11fe",
                                                "sense_id": "b6430623-ebd0-323a-b326-d7a116975082",
                                                "text": "„Kaum eine Pflanze hat die Gartenkultur so sehr verändert wie der Zitronenbaum.“"
                                            },
                                            {
                                                "example_id": "cd69dbd7-ffa6-458a-ad73-b9898d4b7a87",
                                                "sense_id": "b6430623-ebd0-323a-b326-d7a116975082",
                                                "text": "„Viele Epochen brachten eigene Gartenkulturen hervor, und meistens spielte der Gedanke der Selbstversorgung dabei eine wichtige Rolle.“"
                                            },
                                            {
                                                "example_id": "5a45c437-e2b7-4224-a8c4-d243ac9baafd",
                                                "sense_id": "b6430623-ebd0-323a-b326-d7a116975082",
                                                "text": "„Pflanzenzüchtung widmet sich hunderten von Acker- und Gartenkulturen, und die wichtigste Methode ist und bleibt die ‚klassische‘ Kreuzung mit anschließender Selektion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
