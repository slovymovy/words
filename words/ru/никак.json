                                "target_lang_word": "wciąż nie",
                                "target_lang_sense_clarification": "podkreślenie długotrwałego braku rezultatu"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "immer noch nicht",
                                "target_lang_sense_clarification": "betont, dass ein Zustand trotz Erwartung andauert"
                            },
                            {
                                "target_lang_word": "einfach nicht",
                                "target_lang_sense_clarification": "umgangssprachliche Betonung, dass etwas trotz Bemühungen nicht gelingt"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "toujours pas",
                                "target_lang_sense_clarification": "indique une situation qui perdure plus longtemps que prévu"
                            },
