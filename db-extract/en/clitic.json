                        "target_lang_word": "příklonka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bfde4a70-58d5-413d-805f-184f78c23e84",
                        "source_entry_id": "5171d08e-e690-3a46-9ae0-5cc699448724",
                        "source_sense_id": "c79fa90d-8eaa-3071-ae5a-925fb02c70c8",
