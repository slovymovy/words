                "senses": [
                    {
                        "sense_id": "bc7eb335-5ac6-3bb5-bea7-e542ea9baf8a",
                        "entry_id": "3ebaf8da-7f98-362b-a3f9-90fd92ebfd42",
                        "glosses": [
                            "französisches Überseedépartement im Norden Südamerikas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a87ec0d-94b4-412a-a162-a7c4597fc1af",
                                "sense_id": "bc7eb335-5ac6-3bb5-bea7-e542ea9baf8a",
                                "text": "„Drei Jahre nach seinem Start vom Weltraumbahnhof Kourou in Französisch-Guayana, wird der 300 Kilogramm schwere europäische Forschungssatellit Smart-1 auf den Erdtrabanten stürzen.“"
                            },
                            {
                                "example_id": "f362094e-271b-4cb1-a61f-e30a65213548",
                                "sense_id": "bc7eb335-5ac6-3bb5-bea7-e542ea9baf8a",
                                "text": "„Französisch-Guayana ist ein vollintegrierter Teil des französischen Staates und damit auch Teil der Europäischen Union und der NATO.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
