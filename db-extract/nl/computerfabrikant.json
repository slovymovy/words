                            {
                                "example_id": "531b47ad-c600-473c-8ac7-b918b50bf3a3",
                                "sense_id": "d69d6426-a326-3b8a-93e0-a1efee86f19a",
                                "text": "Computerfabrikant Hewlett-Packard verplaatst een deel van zijn distributie van de Rotterdamse haven naar de Griekse haven Piraeus, vlakbij Athene. Dat meldt de Griekse krant Kathimerini."
                            },
                            {
                                "example_id": "c39bc8ec-f1b4-46d0-ba40-634f876fe2dc",
                                "sense_id": "d69d6426-a326-3b8a-93e0-a1efee86f19a",
                                "text": "De Amerikaanse computerfabrikant Dell wordt mogelijk overgenomen door private investeringsmaatschappijen. Daarmee zou de fabrikant van de beurs verdwijnen. Dat meldt persbureau Bloomberg op basis van bronnen."
                            },
                            {
                                "example_id": "a93fa35b-1bae-430c-b412-9512743c8313",
                                "sense_id": "d69d6426-a326-3b8a-93e0-a1efee86f19a",
                                "text": "Computerfabrikant HP heeft miljarden verloren op de aankoop van een bedrijf. Vorig jaar kocht HP voor 10 miljard dollar het Britse Autonomy Corporation PLC. Deze onderneming is gespecialiseerd in zoekmachines op internet. Naar nu blijkt is dat bedrijf slechts 1,2 miljard dollar waard."
                            }
                        ]
