                        "entry_id": "36809fbc-fa08-3e7f-87d7-4f0abac38f4a",
                        "glosses": [
                            "rooms-katholiek geestelijke, gerangschikt direct onder een priester, die een priester helpt bij kerkdiensten"
                        ],
