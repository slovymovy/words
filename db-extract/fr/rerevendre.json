                "senses": [
                    {
                        "sense_id": "08a868f9-d33a-35e6-8232-f425f708894d",
                        "entry_id": "f6f197b2-d02c-311a-9b46-d39b07377d67",
                        "glosses": [
                            "Revendre une nouvelle fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06b1cd1e-ce55-4b77-b239-3d9fa1d353da",
                                "sense_id": "08a868f9-d33a-35e6-8232-f425f708894d",
                                "text": "Je le voulais d’autant plus que Six Hommes Morts, vendu par mon éditeur en 1931, m’avait tout juste rapporté dix-huit mille francs et que le sujet, racheté, revendu, reracheté, rerevendu, etc., avait gentiment passé le million (à ce qu’on m’a dit)."
                            },
                            {
                                "example_id": "2b7d0fda-9d2c-4838-ae85-5b812ccbcbe3",
                                "sense_id": "08a868f9-d33a-35e6-8232-f425f708894d",
                                "text": "Mais le curieux de l'affaire, c’est que l’année suivante, à la même heure, la même tabatière refaisait son entrée chez lui pour être rerevendue."
                            }
                        ]
                    }
