                },
                {
                    "sense_id": "d72c7910-ce1c-3f4f-9ba4-5e450a0508e9",
                    "sense_definition": "Extremely obvious and unacceptable; used to describe bad behavior or mistakes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "offensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was sued for <w>gross</w> negligence after the safety equipment failed.",
                            "target_lang_translations": {
                                "ru": "На компанию подали в суд за <w>грубую</w> халатность после того, как оборудование для обеспечения безопасности вышло из строя.",
                                "zh": "安全设备失效后，该公司因<w>严重</w>疏忽而被起诉。"
                            }
                        },
                        {
                            "text": "It was a <w>gross</w> injustice to blame him for something he did not do.",
                            "target_lang_translations": {
                                "ru": "Это была <w>вопиющая</w> несправедливость — обвинять его в том, чего он не совершал.",
                                "zh": "因为他没做过的事而责怪他，这简直是<w>严重</w>的不公。"
                            }
