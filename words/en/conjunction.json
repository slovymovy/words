                {
                    "sense_id": "9340d453-df1d-3163-adce-ca928bedfdec",
                    "sense_definition": "A compound proposition that is true only if all of its component propositions are true.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal logic, the symbol ∧ represents a <w>conjunction</w>.",
                            "target_lang_translations": {
                                "ru": "В формальной логике символ ∧ обозначает <w>конъюнкцию</w>.",
                                "nl": "In de formele logica vertegenwoordigt het symbool ∧ een <w>conjunctie</w>."
                            }
                        },
                        {
                            "text": "The <w>conjunction</w> is false if either of the statements is false.",
                            "target_lang_translations": {
                                "ru": "<w>Конъюнкция</w> ложна, если хотя бы одно из утверждений ложно.",
                                "nl": "De <w>conjunctie</w> is onwaar als een van de beweringen onwaar is."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "logic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложное суждение, которое истинно только тогда, когда истинны все составляющие его суждения.",
                        "nl": "Een samengestelde bewering die alleen waar is als alle onderdelen waar zijn."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конъюнкция",
                                "target_lang_sense_clarification": "логика"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "conjunctie",
                                "target_lang_sense_clarification": "logische operator"
                            }
                        ]
                    }
