                "senses": [
                    {
                        "sense_id": "76a26b23-7526-383b-a806-6b72444f6274",
                        "entry_id": "4cbbb18e-02f6-35e7-8301-0f2746a23fb7",
                        "glosses": [
                            "syntaktische Funktion eines Satzgliedes, das vom Verb abhängig ist und im Dativ steht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cee1e7b-bd98-4758-ba32-943c1b80645a",
                                "sense_id": "76a26b23-7526-383b-a806-6b72444f6274",
                                "text": "In dem Satz \"Sie hilft ihrer Freundin\" ist \"ihrer Freundin\" ein nominales Satzglied, das Dativobjekt zum Verb \"helfen\" ist."
                            },
                            {
                                "example_id": "b32ae3d3-986f-4525-8eb4-62fa7c5c32f4",
                                "sense_id": "76a26b23-7526-383b-a806-6b72444f6274",
                                "text": "„Schwieriger sind die Bewegungen im Bereich der Dativobjekte zu beurteilen; im ganzen zeichnen sich zwei Tendenzen ab: die der Präpositionalisierung und die der Akkusativierung.“"
                            },
                            {
                                "example_id": "b349c34e-85af-4861-ae20-816e83d1dda2",
                                "sense_id": "76a26b23-7526-383b-a806-6b72444f6274",
                                "text": "„Das beweisen die nicht wenigen Fälle, in denen Genitiv- und Dativobjekt nebeneinander gebraucht werden, peinlicherweise manchmal sogar in ein und demselben Text!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
