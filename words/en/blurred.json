{
    "word_family": [
        "blur",
        "blurry"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f8a2d6f-4be9-354f-97eb-240cf0e99bc5",
                    "sense_definition": "Out of focus; partially obscured; smudged.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blurred</w> image made it difficult to identify the person in the photograph.",
                            "target_lang_translations": {
                                "zh": "这张<w>模糊</w>的照片让人很难辨认出照片里的人。"
                            }
                        },
                        {
                            "text": "I could only see <w>blurred</w> margins on the old document.",
                            "target_lang_translations": {
                                "zh": "我只能看到那份旧文件上<w>模糊</w>的边缘。"
                            }
                        }
                    ],
                    "synonyms": [
                        "furry"
                    ],
                    "common_phrases": [
                        "blurred image",
                        "blurred vision"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体轮廓不清晰，看起来模糊不清。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "形容视觉上不清晰或轮廓不分明。"
                            },
                            {
                                "target_lang_word": "朦胧",
                                "target_lang_sense_clarification": "形容视线模糊，看不真切。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3f06e1c-f2fd-3684-85bb-b6341b0c7fac",
                    "sense_definition": "Simple past and past participle of <w>blur</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain <w>blurred</w> the view through the window.",
                            "target_lang_translations": {
                                "zh": "雨水<w>模糊</w>了窗外的景色。"
                            }
                        },
                        {
                            "text": "Tears <w>blurred</w> her vision as she read the sad news.",
                            "target_lang_translations": {
                                "zh": "当她读到那则悲伤的消息时，泪水<w>模糊</w>了她的视线。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使变得模糊不清。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使模糊",
                                "target_lang_sense_clarification": "指导致某物变得不清晰。"
                            },
                            {
                                "target_lang_word": "遮蔽",
                                "target_lang_sense_clarification": "指因遮挡或干扰而变得看不清。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}