                        "examples": [
                            {
                                "example_id": "152f639f-d12a-4692-b9b0-d62bfb336e7a",
                                "sense_id": "c24efe15-79fe-3be1-9589-991eab7dc51e",
                                "text": "Toen ze in Madrid was uitgestapt bij haar hotel, bleef ze de paar schakers die doorgingen naar het vliegveld nog lang nazwaaien. Een aardige wereldkampioene, dacht ik. Heel wat anders dan de vechtmachines bij de mannen."
                            },
                            {
                                "example_id": "21738b25-bd6f-41f8-bebd-21c311049a80",
                                "sense_id": "c24efe15-79fe-3be1-9589-991eab7dc51e",
                                "text": "En om het helemaal af te maken, fietste ik uiteindelijk luid schreeuwend de straat uit, haar nazwaaiend met het plastic zakje."
                            }
                        ]
                    },
                    {
                        "sense_id": "04b1ec20-069b-38f4-b37b-99cd1bd3d9f3",
