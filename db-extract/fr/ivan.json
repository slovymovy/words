                "entry_id": "fd0b6122-e060-3c09-97e3-d74fed84c390",
                "word": "Ivan",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f1a120b4-12f7-374c-893a-5f5155df0413",
                        "entry_id": "fd0b6122-e060-3c09-97e3-d74fed84c390",
                        "glosses": [
                            "Prénom masculin d’origine slave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9726ddf7-c642-4d6a-9748-34e1621a352a",
                                "sense_id": "f1a120b4-12f7-374c-893a-5f5155df0413",
                                "text": "La demeure est ouverte depuis le 22 mars et accueille une famille ukrainienne de huit enfants orphelins de 5 à 17 ans avec leurs parents adoptifs, Ivan et Svitlana Levishko."
                            },
                            {
                                "example_id": "b8852fad-1c72-4a7c-940c-b6a29e7853b0",
                                "sense_id": "f1a120b4-12f7-374c-893a-5f5155df0413",
                                "text": "C’est une mesure stupide, s’indigne Ivan Sébla, médecin dans les Yvelines."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "194c8f51-8f54-3316-b0a1-ea0da2ca384a",
                "word": "Ivan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7826a2c7-aba7-4edc-9b74-59f35171b721",
                        "entry_id": "194c8f51-8f54-3316-b0a1-ea0da2ca384a",
                        "tags": [
                            "plural"
                        ],
                        "form": "Ivans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df12bcd8-142e-3ac5-bc9d-447c9b350d7a",
                        "entry_id": "194c8f51-8f54-3316-b0a1-ea0da2ca384a",
                        "glosses": [
                            "Soldats russes à la fin de la Seconde Guerre mondiale."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "89872102-2126-49f1-bed5-0d8be96d76b5",
                                "sense_id": "df12bcd8-142e-3ac5-bc9d-447c9b350d7a",
                                "text": "Juutilainen prit cet ordre comme une récompense, tant il n’avait d’autre souhait que d’utiliser enfin son fusil et descendre quelques Ivans."
                            },
                            {
                                "example_id": "1ecdfc39-d044-4516-a89d-4ae614460c8f",
                                "sense_id": "df12bcd8-142e-3ac5-bc9d-447c9b350d7a",
                                "text": "Affamés, terrifiés, les Berlinois se terrent dans les sous-sols pour échapper aux « Ivan ». Ces soldats envoyés pour liquider les dernières poches de résistance sont décrits par la propagande nazie comme une bande de « bestiaux russes » de qui il faut tout attendre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f2f0400-8529-43fe-8c8c-f552208405b7",
                        "source_entry_id": "194c8f51-8f54-3316-b0a1-ea0da2ca384a",
                        "source_sense_id": "df12bcd8-142e-3ac5-bc9d-447c9b350d7a",
                        "target_lang_word": "Иван",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Иван",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "55531b34-d229-31f9-a113-4e8a4411e142",
                                        "entry_id": "0affbfc5-2a24-3d84-b78b-47a9dad1dbb0",
                                        "glosses": [
                                            "мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2083da8-2f23-4bc6-8df7-14666b9d8d18",
                                                "sense_id": "55531b34-d229-31f9-a113-4e8a4411e142",
                                                "text": "У подошвы скалы в кустах были привязаны три лошади; мы своих привязали тут же, а сами по узкой тропинке взобрались на площадку, где ожидал нас Грушницкий с драгунским капитаном и другим своим секундантом, которого звали Иваном Игнатьевичем; фамилии его я никогда не слыхал."
                                            },
                                            {
                                                "example_id": "29e4103a-c437-4ba1-9a32-a25d821bcad1",
                                                "sense_id": "55531b34-d229-31f9-a113-4e8a4411e142",
                                                "text": "Иван Иванович с улыбкой смотрел на него."
                                            },
                                            {
                                                "example_id": "451dcb6b-776c-4e82-9f09-32d1bbc72632",
                                                "sense_id": "55531b34-d229-31f9-a113-4e8a4411e142",
                                                "text": "— Фу ты чёрт! — воскликнул редактор, — ты знаешь, Иван, у меня сейчас едва удар от жары не сделался!"
                                            },
                                            {
                                                "example_id": "d9392209-171f-4804-84c9-925f01f5f5cc",
                                                "sense_id": "55531b34-d229-31f9-a113-4e8a4411e142",
                                                "text": "Их ещё на входе разлучили с дедом Иваном, поскольку его никак не пускали в зал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0237be5-53ab-3403-93cb-5b301bf619ee",
                                        "entry_id": "0affbfc5-2a24-3d84-b78b-47a9dad1dbb0",
                                        "glosses": [
                                            "перен. то же, что русский"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
