                        "examples": [
                            {
                                "example_id": "85735e90-e611-4e16-84c9-1634251ac2ac",
                                "sense_id": "0fc237dc-3605-30c1-8e61-7ebb9c421b3e",
                                "text": "Пропустив мимо себя все три вагона, кот вскочил на заднюю дугу последнего, лапой вцепился в какую-то кишку, выходящую из стенки, и укатил, сэкономив, таким образом, гривенник.",
                                "translation": "Letting all three cars go by, the cat jumped on to the rear coupling-pin of the last one, wrapped its paws around some hose sticking out of the side, and rode off, thus saving himself ten kopecks.",
                                "english": "Letting all three cars go by, the cat jumped on to the rear coupling-pin of the last one, wrapped its paws around some hose sticking out of the side, and rode off, thus saving himself ten kopecks."
                            }
                        ]
                    }
