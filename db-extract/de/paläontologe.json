                ],
                "senses": [
                    {
                        "sense_id": "d3f056a5-100f-3a4b-aac5-f382d34f903d",
                        "entry_id": "a3c20881-a2c6-3877-9d4b-2223a6ac406e",
                        "glosses": [
                            "jemand, der sich mit der Paläontologie, der Erforschung der Lebewesen vergangener Erdzeitalter beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98247543-1d05-49de-8f28-703cb454b576",
                                "sense_id": "d3f056a5-100f-3a4b-aac5-f382d34f903d",
                                "text": "Fossilien sind die wichtigsten Forschungsobjekte der Paläontologen."
                            },
                            {
                                "example_id": "1405678c-57db-42b0-afc4-39ce4b5cdcdf",
                                "sense_id": "d3f056a5-100f-3a4b-aac5-f382d34f903d",
                                "text": "„Die erst vor kurzem entdeckte Winneshiek-Lagerstätte ist so etwas wie ein Eldorado für Paläontologen: Es handelt sich um einen 27 Meter dicken sandigen Schiefer, der in einem Meteoritenkrater im Nordosten der USA liegt.“"
                            },
                            {
                                "example_id": "cdfc2afa-47af-461a-85d9-9cb22a3d56f3",
                                "sense_id": "d3f056a5-100f-3a4b-aac5-f382d34f903d",
                                "text": "„Die Paläontologen knackten immer mehr Konkretionen und fanden auch Schädel von Säugern der frühesten Generation, direkt nach der geologischen Zeitenwende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcf3fb45-6582-4860-a74a-3cd86c8b5788",
                        "source_entry_id": "a3c20881-a2c6-3877-9d4b-2223a6ac406e",
                        "source_sense_id": "d3f056a5-100f-3a4b-aac5-f382d34f903d",
                        "target_lang_word": "paleontologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paleontologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2039c432-d69b-33a3-8809-d8fcca0aa9a7",
                                        "entry_id": "1fa8e8b2-7e09-3c23-b5d4-84e7bc609715",
                                        "glosses": [
                                            "One who studies paleontology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e58a20-f15d-4933-abac-cb162ca3ee30",
                                                "sense_id": "2039c432-d69b-33a3-8809-d8fcca0aa9a7",
                                                "text": "An alternative approach is to break down cultures into ab-\n stract elements and to establish, between elements of the same\n type in different cultures, rather than between cultures themselves,\n the same kind of relationships of historical descent and progressive\n differentiation which the paleontologist sees in the evolution of\n species."
                                            },
                                            {
                                                "example_id": "871a0cf9-32c3-4108-ac8b-4c476e93e38d",
                                                "sense_id": "2039c432-d69b-33a3-8809-d8fcca0aa9a7",
                                                "text": "In the late nineteenth century, paleontologists began to catalog the many curious correspondences exhibited by fossils gathered on different continents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
