                "senses": [
                    {
                        "sense_id": "e752a7b4-8c39-3b9f-97b1-bef5d6ad0c20",
                        "entry_id": "e31d2286-19f4-32e6-b7f8-8114dbd39d4d",
                        "glosses": [
                            "Pour les Nord-Africains,"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "87d99daf-3f52-3ece-8a9f-5fb844010a94",
                        "entry_id": "e31d2286-19f4-32e6-b7f8-8114dbd39d4d",
                        "glosses": [
                            "Pour les Nord-Africains,",
                            "Qui est européen, occidental."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f26d70-2a8d-4530-bed9-0cb20d0755a6",
                                "sense_id": "87d99daf-3f52-3ece-8a9f-5fb844010a94",
                                "text": "Il y avait bien une fontaine dans la cour du bordj des fouilles, mais le gardien roumi, employé des Beaux-Arts, ne permettait point aux gens de la tribu de puiser l’eau pure et fraîche dans cette fontaine."
                            },
                            {
                                "example_id": "8380aa7a-14b9-4d2f-844e-a02bca864c04",
                                "sense_id": "87d99daf-3f52-3ece-8a9f-5fb844010a94",
                                "text": "Les chiffres roumis furent utilisés en Afrique du Nord du Xᵉ au XVIIᵉ siècle, principalement dans l’administration de la ville de Fez au Maroc, mais aussi par les Andalous, à partir du XIIᵉ siècle. Ils sont différents des chiffres arabes ou arabo-indiens en usage de nos jours. Ce système de numération était décimal sans être vraiment positionnel. On appelle aussi ces chiffres les « lettres zimam, lettres romaines » ou « lettres de Fez »."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5351269-19b7-33ce-8cbc-f32743287164",
                        "entry_id": "e31d2286-19f4-32e6-b7f8-8114dbd39d4d",
                        "glosses": [
                            "Pour les Nord-Africains,",
                            "D’origine européenne ou plus généralement occidentale."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e6c943f7-70c1-4688-b2e7-a80f42aceb72",
                                "sense_id": "a5351269-19b7-33ce-8cbc-f32743287164",
                                "text": "Mais dans les entretiens, les références faites à la tendreté concernent, le plus souvent, la cuisson de la viande : « le poulet roumi cuit plus vite » ou « plus rapidement» ; « le poulet beldi est difficile à cuire »."
                            }
                        ]
                    }
                ],
