                "senses": [
                    {
                        "sense_id": "4b595c5f-ab13-30bc-902c-a96ad89a30ae",
                        "entry_id": "8ff095f0-9ca9-3c99-857b-0b47ec5e8d82",
                        "glosses": [
                            "Doter d’un équipement antivol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30056238-4272-4520-98db-ca0b657bb4d0",
                                "sense_id": "4b595c5f-ab13-30bc-902c-a96ad89a30ae",
                                "text": "On pourrait quand même se demander pourquoi ces gens n'éprouvent pas le besoin d'antivoliser les saucissons pur-porc, lesquels sont pourtant hors de prix et faciles à dérober."
                            },
                            {
                                "example_id": "ca823858-6b19-4f83-b949-e0d06bc2a106",
                                "sense_id": "4b595c5f-ab13-30bc-902c-a96ad89a30ae",
                                "text": "Comme tu le dis le pince roue ne permet pas de s'antivoliser correctement avec un U."
                            },
                            {
                                "example_id": "6fa95532-322d-4a6f-bc72-10f5b661d6d1",
                                "sense_id": "4b595c5f-ab13-30bc-902c-a96ad89a30ae",
                                "text": "J'«antivolise» mon vélo mais je n'ai point à ôter mes pinces à vélo."
                            }
                        ]
                    }
