                        "glosses": [
                            "Habitant de l’île d’Oléron, en France, département de Charente-Maritime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6170b5f-d3d2-43c6-a8cd-7fc6340076ef",
                                "sense_id": "5fea4c9d-c70d-3bf7-924d-accfdd0f57e1",
                                "text": "Cela évitera aux Oléronais de se rendre aux pompes funèbres de Bourcefranc-le-Chapus, plus onéreuses."
                            },
                            {
                                "example_id": "54c7dbba-fdbc-41c9-acc9-819e9e64a962",
                                "sense_id": "5fea4c9d-c70d-3bf7-924d-accfdd0f57e1",
                                "text": "Avant lui, il y avait eu d’autres Oléronais, ostréiculteur fumeur de joints ou rugbyman…"
                            },
                            {
                                "example_id": "f9e237e1-8d85-440d-8e52-c2f280e77ad3",
                                "sense_id": "5fea4c9d-c70d-3bf7-924d-accfdd0f57e1",
                                "text": "On pense à tort que les Oléronais ne sont que des marins."
                            }
                        ]
                    }
