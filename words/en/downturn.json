{
    "word_family": [
        "downturned",
        "upturn"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                    "sense_definition": "A downward trend, especially a decline in economic activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recent economic <w>downturn</w> made it much harder for young graduates to find jobs.",
                            "target_lang_translations": {
                                "ru": "Недавний экономический <w>спад</w> значительно усложнил поиск работы для молодых выпускников."
                            }
                        },
                        {
                            "text": "Many small businesses did not survive the sharp <w>downturn</w> in the market.",
                            "target_lang_translations": {
                                "ru": "Многие малые предприятия не пережили резкого <w>снижения</w> рыночной активности."
                            }
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "drop",
                        "recession",
                        "slump"
                    ],
                    "antonyms": [
                        "upturn",
                        "uptick#Noun",
                        "increase#Noun",
                        "improvement#Noun"
                    ],
                    "common_phrases": [
                        "economic downturn",
                        "sharp downturn",
                        "market downturn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тенденция к снижению, особенно спад в экономической активности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "в экономике или активности"
                            },
                            {
                                "target_lang_word": "снижение",
                                "target_lang_sense_clarification": "показателей или активности"
                            },
                            {
                                "target_lang_word": "кризис",
                                "target_lang_sense_clarification": "экономический упадок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "868e8f37-36b5-32de-b622-7bd462e158eb",
                    "sense_definition": "To decline or experience a downward trend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists worry that the market will <w>downturn</w> further if interest rates rise.",
                            "target_lang_translations": {
                                "ru": "Экономисты опасаются, что рынок продолжит <w>идти на спад</w>, если процентные ставки вырастут."
                            }
                        },
                        {
                            "text": "When profits began to <w>downturn</w>, the company decided to reduce its staff.",
                            "target_lang_translations": {
                                "ru": "Когда прибыль начала <w>снижаться</w>, компания решила сократить штат."
                            }
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "decrease",
                        "drop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижаться или испытывать тенденцию к спаду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти на спад",
                                "target_lang_sense_clarification": "об экономике или показателях"
                            },
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "падать в цене или объеме"
                            },
                            {
                                "target_lang_word": "сокращаться",
                                "target_lang_sense_clarification": "об активности или прибыли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e87f75e0-f897-38a9-bf2a-4b5b7086ed0d",
                    "sense_definition": "To turn downwards physically.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She watched the leaves <w>downturn</w> under the weight of the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Она наблюдала, как листья <w>опускаются</w> под тяжестью сильного дождя."
                            }
                        },
                        {
                            "text": "He would always <w>downturn</w> the corners of his mouth when he was thinking deeply.",
                            "target_lang_translations": {
                                "ru": "Он всегда <w>опускал</w> уголки рта, когда глубоко задумывался."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "droop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически загибаться или опускаться вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "направляться книзу"
                            },
                            {
                                "target_lang_word": "загибаться вниз",
                                "target_lang_sense_clarification": "о краях или листьях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}