                                        "entry_id": "c98e9b13-1e0c-37c2-bee0-1da821dc1618",
                                        "glosses": [
                                            "One who travels, especially on a journey to visit sites of religious significance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88ec288a-0ae6-490a-a03e-d65305d4e23d",
                                                "sense_id": "f519bae4-041d-33e8-9fc8-7c719d296983",
                                                "text": "strangers and pilgrims on the earth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8d12096-08c8-3d9a-be02-5f2865df32bf",
                                        "entry_id": "c98e9b13-1e0c-37c2-bee0-1da821dc1618",
                                        "glosses": [
                                            "A newcomer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28916871-bee2-488f-b935-ed3fa693e8ef",
                                                "sense_id": "d8d12096-08c8-3d9a-be02-5f2865df32bf",
                                                "text": "\"I wouldn't unfork that horse yet, pilgrim. I want a good look at ya first.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d21ac64-5feb-3294-bd41-4aceb3e25884",
                                        "entry_id": "c98e9b13-1e0c-37c2-bee0-1da821dc1618",
                                        "glosses": [
                                            "A silk screen formerly attached to the back of a woman's bonnet to protect the neck."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pilgrim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4288248a-e2de-3c12-beab-7df28fd704ff",
                                        "entry_id": "92e45eea-5c72-3c00-8dd5-3fac62c3e6e1",
                                        "glosses": [
                                            "To journey; to wander; to ramble."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf40fc1-e58f-474a-b0df-f49803537830",
                                                "sense_id": "4288248a-e2de-3c12-beab-7df28fd704ff",
                                                "text": "For that he hath no certain home, or diet, but pilgrims up and down every where, feeding upon all sorts of Plants"
                                            },
                                            {
                                                "example_id": "431167bc-b38b-4112-b89f-b44b2f961805",
                                                "sense_id": "4288248a-e2de-3c12-beab-7df28fd704ff",
                                                "text": "[T]o all galleries, churches, sistine chapels, ruins, coliseums, and artistic or dilettante shrines he zealously pilgrimed[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
