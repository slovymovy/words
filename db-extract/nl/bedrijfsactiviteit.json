                ],
                "senses": [
                    {
                        "sense_id": "d6348a82-2f64-3a3d-bbc8-96cae2f0e3c0",
                        "entry_id": "108bc7c8-024c-33d6-a4e1-8ae2ba280d91",
                        "glosses": [
                            "elk van de bezigheden van een bedrijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2353b602-57ad-411f-8991-e7be086ea2b9",
                                "sense_id": "d6348a82-2f64-3a3d-bbc8-96cae2f0e3c0",
                                "text": "Het woonwerkverkeer van werknemers wordt nog steeds niet als een bedrijfsactiviteit gezien."
                            },
                            {
                                "example_id": "8f8f8302-8b85-4869-9f2e-ef73ac5f7b8a",
                                "sense_id": "d6348a82-2f64-3a3d-bbc8-96cae2f0e3c0",
                                "text": "Het bestemmingsplan schrijft voor dat de benedenruimte waarin de darkstore zit bedoeld is om in te wonen. Ook kan de locatie voor bedrijfsactiviteiten worden gebruikt, in de categorie 'Post en telecommunicatie'. De eigenaar had bij de rechter aangevoerd dat ze als een post- en telecommunicatiebedrijf gezien moet worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "27845345-bef6-34f8-9002-b71efae5b17c",
                        "entry_id": "108bc7c8-024c-33d6-a4e1-8ae2ba280d91",
                        "glosses": [
                            "mate waarin een bedrijf actief is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0062352e-891a-4693-9638-f2b7ca161fb6",
                                "sense_id": "27845345-bef6-34f8-9002-b71efae5b17c",
                                "text": "Op maandagmorgen komt de bedrijfsactiviteit in de regel slechts langzaam op gang."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a2d2a27-2c89-39f3-8962-757bd745fe0a",
                        "entry_id": "108bc7c8-024c-33d6-a4e1-8ae2ba280d91",
                        "glosses": [
                            "product- of dienstenaanbod van de onderneming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8fc44b1-e4ae-475c-b7d0-79c00d3b06e2",
                                "sense_id": "3a2d2a27-2c89-39f3-8962-757bd745fe0a",
                                "text": "Voor deze nieuwe bedrijfsactiviteit van de onderneming is een speciale introductiestrategie ontwikkeld."
                            }
                        ]
                    },
                    {
                        "sense_id": "07c7bb45-9cb2-3787-addb-ac419dc2f50b",
                        "entry_id": "108bc7c8-024c-33d6-a4e1-8ae2ba280d91",
                        "glosses": [
                            "bepaalde klasse van activiteiten van de onderneming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "009abca7-f42d-46c1-a3a8-b6a2cab79fdc",
                                "sense_id": "07c7bb45-9cb2-3787-addb-ac419dc2f50b",
                                "text": "Het geheel van ondernemingen is in de Standaard Bedrijfsindeling onderverdeeld in bedrijfsklassen en bedrijfstakken en verder naar bedrijfsactiviteit."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf5cb201-63dc-33b0-aedd-b5eb9c515e4a",
                        "entry_id": "108bc7c8-024c-33d6-a4e1-8ae2ba280d91",
                        "glosses": [
                            "functioneren van het bedrijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3c600a-c59a-4685-a231-196c59f6c913",
                                "sense_id": "bf5cb201-63dc-33b0-aedd-b5eb9c515e4a",
                                "text": "Er is sprake van beëindiging van bedrijfsactiviteiten indien een bedrijfsactiviteit niet duurzaam wordt voortgezet."
                            }
                        ]
                    }
                ],
