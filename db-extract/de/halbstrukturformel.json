                ],
                "senses": [
                    {
                        "sense_id": "900ba835-6071-3341-865f-6cc5d0159bb7",
                        "entry_id": "74d34318-9f90-328f-9696-71ff71710315",
                        "glosses": [
                            "vereinfachte Darstellung der Struktur einer chemischen Verbindung. In Gegensatz zur Strukturformel, die eine zwei- oder dreidimensionale Darstellung erlaubt, kann die Halbstrukturformel in einer Zeile geschrieben werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17931a89-2889-4605-ae15-dc2af7c0ebda",
                                "sense_id": "900ba835-6071-3341-865f-6cc5d0159bb7",
                                "text": "Die Halbstrukturformel von Essigsäure lautet CH₃–COOH."
                            },
                            {
                                "example_id": "99e2a89e-db1c-4c8c-a545-8f16c92d348e",
                                "sense_id": "900ba835-6071-3341-865f-6cc5d0159bb7",
                                "text": "„Bei der Halbstrukturformel werden bestimmte Atomgruppen eines Moleküls zusammengefasst.“"
                            },
                            {
                                "example_id": "e21ef5b9-44a5-45bf-945b-50b2ae0ad57d",
                                "sense_id": "900ba835-6071-3341-865f-6cc5d0159bb7",
                                "text": "„Da es jedoch oft nicht nötig oder möglich ist, die Strukturformel eines Moleküls zu zeichnen, wurden Halbstrukturformeln eingeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
