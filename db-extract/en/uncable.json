                        "entry_id": "12b69e0d-10d2-3e0c-baea-63036517873b",
                        "glosses": [
                            "To undo the cabling of; to disconnect a cable or cables from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0da42daf-9253-4a8c-8a93-71fcb7ce29eb",
                                "sense_id": "ed235d3b-5bc9-3e6a-877e-5d6ffc113f36",
                                "text": "For example, certain cabling techniques used for statistical multiplexers and intelligent switching systems let field-service personnel replace modules without having to uncable EIA connections."
                            },
                            {
                                "example_id": "fe385fd3-b044-4191-b0a5-f587a2e29ec2",
                                "sense_id": "ed235d3b-5bc9-3e6a-877e-5d6ffc113f36",
                                "text": "The election judge has the key to uncable the machines in a similar manner to the olden days when the election judge kept the keys to the ballot box. This way the judge could remove the ballots and count them."
                            }
                        ]
                    }
