                                    },
                                    {
                                        "sense_id": "81a204b8-3821-3b37-bc97-ccc3a31b1fdf",
                                        "entry_id": "63327ef2-6127-37a4-af6d-ec91f92cb20c",
                                        "glosses": [
                                            "συνέλευση επισκόπων, μητροπολιτών ή καρδιναλίων που αποφασίζουν για διοικητικά ή δογματικά ζητήματα"
                                        ],
                                        "tags": [
                                            "χριστιανισμός"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4291d49-1515-4872-bd53-53ec642763b1",
                                                "sense_id": "81a204b8-3821-3b37-bc97-ccc3a31b1fdf",
                                                "text": "Ιερά Σύνοδος, Διαρκής Ιερά Σύνοδος"
                                            },
                                            {
                                                "example_id": "b39fd943-325c-46ad-a625-8431e0830649",
                                                "sense_id": "81a204b8-3821-3b37-bc97-ccc3a31b1fdf",
                                                "text": "※ Επί Πατριαρχίας Αθηναγόρα, η Σύνοδος του Οικουμενικού Θρόνου ενέταξε επτά Αγίους στο Αγιολόγιο της Ορθόδοξης Εκκλησίας μεταξύ των οποίων ήταν αναγνωρισμένες προσωπικότητες όπως ο Άγιος Νικόδημος ο Αγιορείτης, ο Κοσμάς ο Αιτωλός και ο Άγιος Νεκτάριος.",
                                                "translation": "Μαρία Αντωνιάδου, Ιστορίες για αγίους, Το Βήμα, 24 Νοεμβρίου 2008"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37ba0421-c269-373a-8096-0956a40a8682",
                                        "entry_id": "63327ef2-6127-37a4-af6d-ec91f92cb20c",
                                        "glosses": [
                                            "το ουράνιο φαινόμενο κατά το οποίο δύο ουράνια σώματα εμφανίζονται στο ίδιο ουράνιο μήκος σε σχέση με τον γήινο παρατηρητή."
                                        ],
                                        "tags": [
                                            "αστρονομία"
                                        ],
                                        "examples": [
