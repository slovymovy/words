                                        "glosses": [
                                            "umwandeln, umformen"
                                        ],
                                        "tags": [
                                            "formal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5afc3fd3-9aa9-4642-9c91-34dda2ac6112",
                                                "sense_id": "14d9b361-aad7-3f39-932c-c4566751d26d",
                                                "text": "Wir erstellen eine Matrix der transformierten Variablen."
                                            },
                                            {
                                                "example_id": "f2d24379-42fd-4331-af1e-13368fcd831b",
                                                "sense_id": "14d9b361-aad7-3f39-932c-c4566751d26d",
                                                "text": "„Nicht nur die technischen Artefakte transformierten den Karlsplatz, sondern – zweitens – auch deren Nutzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "694f6570-bc86-3928-9125-0e49f84cf4d2",
                                        "entry_id": "ef72629c-1918-3668-93de-9af9a3eda10d",
                                        "glosses": [
                                            "in einem Transformator die elektrische Spannung umwandeln"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9e665fe-2238-494d-9cb2-8ef6bcfe0105",
                                                "sense_id": "694f6570-bc86-3928-9125-0e49f84cf4d2",
                                                "text": "Hier wird die Netzspannung in Hochspannung transformiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "20fd2762-b84c-312e-af8b-757a30f65954",
                                        "entry_id": "ef72629c-1918-3668-93de-9af9a3eda10d",
                                        "glosses": [
                                            "das Genom (eines Bakteriums) durch Aufnahme artfremder DNA erweitern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f71516c9-93f8-449c-90cb-ee540b535f80",
                                                "sense_id": "20fd2762-b84c-312e-af8b-757a30f65954",
                                                "text": "Die Bakterien wurden transformiert und produzieren daraufhin das gewünschte Enzym."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "40821dc5-1c20-3f38-b24d-8bac1530e2ea",
                                        "entry_id": "ef72629c-1918-3668-93de-9af9a3eda10d",
                                        "glosses": [
                                            "sprachliche Strukturen in andere überführen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "003495d4-0010-49da-881b-77f465b94b39",
                                                "sense_id": "40821dc5-1c20-3f38-b24d-8bac1530e2ea",
                                                "text": "„Die TS werden in der Transformationskomponente durch Transformationsregeln zu Oberflächenstrukturen (OS) transformiert[…]“"
