                "senses": [
                    {
                        "sense_id": "48c9c382-b5a9-38ca-8832-c99cbbfff4bf",
                        "entry_id": "afc716c9-7119-3cfb-a671-5564dcb1320f",
                        "glosses": [
                            "libanesische Miliz während des libanesischen Bürgerkriegs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b2ec14-0fb4-4aec-8861-c2d0f4d40d8d",
                                "sense_id": "48c9c382-b5a9-38ca-8832-c99cbbfff4bf",
                                "text": "„Die israelische Luftwaffe und die SLA bombardierten als Reaktion auf andauernde Attacken der Hisbollah fast täglich südlibanesische Dörfer, in denen man Stellungen der Organisation und anderer Milizen vermutete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "784a1e1f-7edd-33c2-be2a-790a799e1c8b",
                        "entry_id": "afc716c9-7119-3cfb-a671-5564dcb1320f",
                        "glosses": [
                            "loser Zusammenschluss von sudanesischen Rebellengruppen, die am Darfur-Konflikt im Sudan beteiligt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eceb84d0-65d1-4c56-b3cb-fc5633c27d5d",
                                "sense_id": "784a1e1f-7edd-33c2-be2a-790a799e1c8b",
                                "text": "„›Ja. SLA. Was seltsam ist. Die waren noch nie so weit im Osten aktiv.‹“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
