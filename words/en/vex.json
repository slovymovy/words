                        "tr": [
                            {
                                "target_lang_word": "rahatsız etmek",
                                "target_lang_sense_clarification": "huzursuzluk vermek, içini daraltmak"
                            },
                            {
                                "target_lang_word": "kahretmek",
                                "target_lang_sense_clarification": "derin üzüntü ve ızdırap vermek"
                            },
                            {
                                "target_lang_word": "üzmek",
                                "target_lang_sense_clarification": "kederlendirmek, keder vermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "使内心经受痛苦"
                            },
                            {
                                "target_lang_word": "使痛苦",
                                "target_lang_sense_clarification": "带来精神上的伤痛"
                            },
                            {
                                "target_lang_word": "煎熬",
                                "target_lang_sense_clarification": "使深受折磨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73016c01-a640-32d2-b28f-0a340e15fc4a",
                    "sense_definition": "To trouble aggressively or harass someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were ordered not to <w>vex</w> the local population during their stay.",
                            "target_lang_translations": {
                                "ru": "Солдатам было приказано не <w>притеснять</w> местное население во время их пребывания.",
                                "tr": "Askerlere, kaldıkları süre boyunca yerel halkı <w>taciz etmemeleri</w> emredildi.",
                                "zh": "士兵们奉命在驻扎期间不得<w>骚扰</w>当地民众。"
                            }
                        },
                        {
                            "text": "Enemies sought to <w>vex</w> the kingdom with frequent raids.",
                            "target_lang_translations": {
                                "ru": "Враги стремились <w>изводить</w> королевство частыми набегами.",
                                "tr": "Düşmanlar, sık sık düzenledikleri baskınlarla krallığa <w>rahat vermemeye</w> çalıştılar.",
                                "zh": "敌人企图通过频繁的突袭来<w>侵扰</w>这个王国。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harass",
                        "badger",
                        "pester",
                        "hound",
                        "persecute"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern usage prefers 'harass' or 'oppress'"
                        }
                    ],
                    "target_lang_definitions": {
