                ],
                "senses": [
                    {
                        "sense_id": "bb19d340-d976-3d8f-883f-18dcabf94fb1",
                        "entry_id": "f71b4882-f7ca-399b-ad07-2b8717e4b16d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edcb9d74-dc18-4dff-ad3a-3c0b82a0b366",
                                "sense_id": "bb19d340-d976-3d8f-883f-18dcabf94fb1",
                                "text": "Frau Bieberle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3f506fff-d717-441d-ae50-7ad1db0211d5",
                                "sense_id": "bb19d340-d976-3d8f-883f-18dcabf94fb1",
                                "text": "Herr Bieberle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "31dbdfa6-a226-42d2-84fd-6325c48ddf71",
                                "sense_id": "bb19d340-d976-3d8f-883f-18dcabf94fb1",
                                "text": "Die Bieberles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8944320b-7185-45b7-b1fc-b40b7b30071b",
                                "sense_id": "bb19d340-d976-3d8f-883f-18dcabf94fb1",
                                "text": "Der Bieberle trägt nie die Pullover, die die Bieberle ihm strickt."
                            },
                            {
                                "example_id": "e5527669-7d35-477d-b061-5cf909c67c96",
                                "sense_id": "bb19d340-d976-3d8f-883f-18dcabf94fb1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bieberle kommt, geht der Herr Bieberle.“"
                            },
                            {
                                "example_id": "d17ec9fa-e3af-4da7-82ce-8989a1095dbb",
                                "sense_id": "bb19d340-d976-3d8f-883f-18dcabf94fb1",
                                "text": "Bieberle kommt und geht."
                            },
                            {
                                "example_id": "034f5c9e-2512-454f-b8ca-04cf0384959a",
                                "sense_id": "bb19d340-d976-3d8f-883f-18dcabf94fb1",
                                "text": "Bieberles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
