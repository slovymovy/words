                    {
                        "translation_id": "addacc88-81c5-418e-a087-9d67378db27d",
                        "source_entry_id": "c7749fc7-aa57-307d-9b05-97b3059c36fa",
                        "source_sense_description": "embryology: of or relating to an embryo",
                        "target_lang_word": "embryonální",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embryonální",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ba24cbf7-8d03-3155-b6b2-2bc21fa9d775",
                                        "entry_id": "995ae426-1902-3bb5-8fdf-3dac64718576",
                                        "glosses": [
                                            "související s embryem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018bbaee-1d81-49d3-988b-f3d64f58f63b",
                                                "sense_id": "ba24cbf7-8d03-3155-b6b2-2bc21fa9d775",
                                                "text": "Z embryonální prvoledviny a vývodu Wolffova mají dospělí plazi jen nepatrné zbytky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8318d744-66b8-4a88-910b-04d17abd76a5",
                        "source_entry_id": "c7749fc7-aa57-307d-9b05-97b3059c36fa",
                        "source_sense_description": "embryology: of or relating to an embryo",
                        "target_lang_word": "embryonaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embryonaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e7853230-815b-3227-b572-bdb0a07de2c0",
                                        "entry_id": "0bd4e7c6-a91d-3fee-b490-d5a9c7e566c9",
                                        "glosses": [
                                            "in een beginfase verkerend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba8d8c84-cf03-462e-9a68-a6ef17b2caee",
                                                "sense_id": "e7853230-815b-3227-b572-bdb0a07de2c0",
                                                "text": "Ten tweede werden - zij het nog embryonaal - een aantal maatregelen genomen waarmee de speculatie tegen Europese overheidsschulden beter kan worden bestreden. Die maatregelen werden op 8 augustus meteen door de markten getest. De speculatie tegen de Italiaanse en Spaanse schuld mislukte. De Italianen zelf werden wel gedwongen in te stemmen met een ongezien streng besparingsprogramma."
                                            },
                                            {
                                                "example_id": "635a2e3e-b1af-4734-af80-a8791da6943c",
                                                "sense_id": "e7853230-815b-3227-b572-bdb0a07de2c0",
                                                "text": "Frank Ketelaar is inmiddels bezig met het schrijven van een nieuwe serie voor de VARA. \"Het wordt anders, maar wel weer over misdaad en families. Maar alles verkeert nog in een embryonaal stadium.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf88a614-9344-3ba2-adde-f7066deb3717",
                                        "entry_id": "0bd4e7c6-a91d-3fee-b490-d5a9c7e566c9",
                                        "glosses": [
                                            "betrekking hebbend op de ongeboren vrucht van een organisme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec961e7-cee4-470d-83af-c47776a324dd",
                                                "sense_id": "cf88a614-9344-3ba2-adde-f7066deb3717",
                                                "text": "Het wetenschappelijk onderzoek van embryo's en embryonale menselijke stamcellen is binnenkort niet meer verboden in Frankrijk. Het parlement in Parijs keurde een wetsverandering met die strekking goed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2ac0ff7-7f0b-453b-b41b-0c63b30cb817",
                        "source_entry_id": "c7749fc7-aa57-307d-9b05-97b3059c36fa",
                        "source_sense_description": "embryology: of or relating to an embryo",
                        "target_lang_word": "embryonnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embryonnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "806a8c76-ee71-3fc7-bda6-4edbbf9f0441",
                                        "entry_id": "2e21f38a-7cbb-3e5e-a815-b2ca2c986732",
                                        "glosses": [
                                            "Qui a rapport à l’embryon, qui est à l’état d’embryon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c66bee8-a959-4452-a72b-b55b8f6b5d81",
                                                "sense_id": "806a8c76-ee71-3fc7-bda6-4edbbf9f0441",
                                                "text": "Période embryonnaire."
                                            },
                                            {
                                                "example_id": "ac049895-9dbe-471e-a18a-6129918d2939",
                                                "sense_id": "806a8c76-ee71-3fc7-bda6-4edbbf9f0441",
                                                "text": "État embryonnaire."
                                            },
                                            {
                                                "example_id": "0d6689e3-fb0d-4a48-98aa-9d7778cb21d6",
                                                "sense_id": "806a8c76-ee71-3fc7-bda6-4edbbf9f0441",
                                                "text": "Dans une tribune publiée par « Le Monde » (31/3), ces râleurs se plaignent de cette très pieuse fondation, soutenue par le Vatican, qui ne cesse de leur mettre des bâtons dans les roues chaque fois qu’ils veulent lancer des recherches sur les cellules souches embryonnaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9be99a3-6ce5-336e-a904-367c3415190c",
                                        "entry_id": "2e21f38a-7cbb-3e5e-a815-b2ca2c986732",
                                        "glosses": [
                                            "Qui est encore qu'au tout début d'un développement éventuel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95812420-3416-4cb8-89a8-a4901972cfc5",
                                                "sense_id": "a9be99a3-6ce5-336e-a904-367c3415190c",
                                                "text": "Il me sembla voir prématurément poindre … une conception embryonnaire de la vérité…"
                                            },
                                            {
                                                "example_id": "5a2d4adb-d6f7-4497-9135-98cadc8faf3f",
                                                "sense_id": "a9be99a3-6ce5-336e-a904-367c3415190c",
                                                "text": "Lorsque la bourgeoisie embryonnaire eut à affronter le Pérou et la Bolivie, en 1879, pour décider de la propriété des mines de nitrate (monopole naturel sur l’une des plus grandes richesses de l’époque), elle se heurta pourtant aux États-Unis."
                                            },
                                            {
                                                "example_id": "00689d53-44e4-470f-8b50-539c182fe6db",
                                                "sense_id": "a9be99a3-6ce5-336e-a904-367c3415190c",
                                                "text": "Mais la recherche absolue d'égalité est un projet avant tout occidental qui reste embryonnaire dans les pays comme le Mexique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d398f3e5-f5f5-4828-965d-98b6c4bbfd6d",
                        "source_entry_id": "c7749fc7-aa57-307d-9b05-97b3059c36fa",
                        "source_sense_description": "embryology: of or relating to an embryo",
                        "target_lang_word": "embryonal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embryonal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b0e1ed4-2dcf-3ac4-b660-0d6964b3de88",
                                        "entry_id": "b8c9b560-a1be-3a7c-96aa-9c612c8fab91",
                                        "glosses": [
                                            "zum Stadium des Embryos gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "118447e8-ae6e-478a-bec5-47de7ad8ebcf",
                                                "sense_id": "2b0e1ed4-2dcf-3ac4-b660-0d6964b3de88",
                                                "text": "„Britische Forscher klonen einen Frosch aus embryonalen Zellkernen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c73a447-7583-36d0-9fd2-c6c46b2de0f4",
                                        "entry_id": "b8c9b560-a1be-3a7c-96aa-9c612c8fab91",
                                        "glosses": [
                                            "unentwickelt, unreif"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b21aab2-6c80-4112-8fce-89d7c13867ed",
                                                "sense_id": "0c73a447-7583-36d0-9fd2-c6c46b2de0f4",
                                                "text": "„Hat in Pforte III das Kind im dunklen Keller Angst, so rollen sich die Sänger embryonal zusammen.“"
                                            },
                                            {
                                                "example_id": "9b4d5aa3-12ee-451f-b5b8-8d41cd23f997",
                                                "sense_id": "0c73a447-7583-36d0-9fd2-c6c46b2de0f4",
                                                "text": "„Die zugrunde liegenden Stammesstrukturen dominierten die bestenfalls embryonalen Ansätze einer Unternehmerschaft, Arbeiterklasse oder von Mittelschichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
