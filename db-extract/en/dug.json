                "translations": [
                    {
                        "translation_id": "a5c05c77-044a-42cc-894b-0d2967a0d32f",
                        "source_entry_id": "40ddbf81-9747-37fc-9d70-eddddef90e9c",
                        "source_sense_id": "b04419d7-e0b1-3f47-b79e-d08799632516",
                        "source_sense_description": "Zitze",
                        "target_lang_word": "Zitze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zitze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "828c68d7-fd3c-33ec-ac14-7d8ac59cf65f",
                                        "entry_id": "6b53f215-76e8-3f1e-8085-a9ad72b84bdb",
                                        "glosses": [
                                            "zum Säugen dienendes Organ bei weiblichen Säugetieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb191fd-2e94-470d-9f07-608a23ecf548",
                                                "sense_id": "828c68d7-fd3c-33ec-ac14-7d8ac59cf65f",
                                                "text": "Das Junge bleibt an der Seite der Mutter, bis es eine Zitze gefunden hat."
                                            },
                                            {
                                                "example_id": "ebb0cd9b-3a30-455e-9bb2-244c5d5f6ca2",
                                                "sense_id": "828c68d7-fd3c-33ec-ac14-7d8ac59cf65f",
                                                "text": "„Oder ich sollte sie an die Zitzen ihrer Mütter legen, wenn sie zu schwach waren.“"
                                            },
                                            {
                                                "example_id": "4243bf43-daf6-4f79-8e74-64ca07dfd5e3",
                                                "sense_id": "828c68d7-fd3c-33ec-ac14-7d8ac59cf65f",
                                                "text": "„Sie lachte leise, ihr Atem materialisierte sich ins stoßende Bibbern, ihre Zitzen berührten meine Schulter, sie hielt über mir in jener Beugehaltung, die einer braucht, will er gekrümmt dem andern ins Gesicht blicken, vielleicht daß es Spuren zu entdecken gäbe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
