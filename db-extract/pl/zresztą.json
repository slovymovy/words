                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7026470f-fada-34ac-bdaf-eae6667b407a",
                        "entry_id": "bcd10ef7-09ac-3396-b5e7-3c1fd5b87fbc",
                        "glosses": [
                            "partykuła wprowadzająca nową informację, nawiązującą do wcześniejszej i uwydatniająca ją"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1c59c9-7e0e-4765-b9e3-a22b399dd96f",
                                "sense_id": "7026470f-fada-34ac-bdaf-eae6667b407a",
                                "text": "Nie mam ochoty na kino, zresztą jestem spłukany."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ad152d0-dd97-4efc-8a78-56917eca8692",
                        "source_entry_id": "bcd10ef7-09ac-3396-b5e7-3c1fd5b87fbc",
                        "source_sense_id": "7026470f-fada-34ac-bdaf-eae6667b407a",
                        "target_lang_word": "besides",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besides",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccb3d4bd-f13b-32c2-9fd2-cc72c1126d75",
                                        "entry_id": "5f25d4c4-300f-38fd-9cdb-ad3922a111fd",
                                        "glosses": [
                                            "In addition to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ff5ad72-d2b5-479a-b283-f54f8a4e9582",
                                                "sense_id": "ccb3d4bd-f13b-32c2-9fd2-cc72c1126d75",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "931a6e8b-08f9-3150-b199-0755bc339844",
                                        "entry_id": "5f25d4c4-300f-38fd-9cdb-ad3922a111fd",
                                        "glosses": [
                                            "Other than; except for; instead of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fac955-d229-4216-bbc4-562286537059",
                                                "sense_id": "931a6e8b-08f9-3150-b199-0755bc339844",
                                                "text": "I don't want to go anywhere besides India."
                                            },
                                            {
                                                "example_id": "40ee7dc3-7a61-4041-a403-4442c0a2e5ea",
                                                "sense_id": "931a6e8b-08f9-3150-b199-0755bc339844",
                                                "text": "I want to go with someone besides my father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68db9b0e-2c56-3426-bcea-870014b198ec",
                                        "entry_id": "5f25d4c4-300f-38fd-9cdb-ad3922a111fd",
                                        "glosses": [
                                            "Beside, next to."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28406662-7eee-4179-8092-718320f40ba5",
                                                "sense_id": "68db9b0e-2c56-3426-bcea-870014b198ec",
                                                "text": "1561, Geneva Bible, Acts 16:13,\nAnd on the Sabbath day, we went out of the citie, beſides a riuer, where they were wont to pray : and we ſate downe, and ſpake vnto the women, which were come together."
                                            },
                                            {
                                                "example_id": "1aaa5630-79d0-470d-9704-d095ee7c91f8",
                                                "sense_id": "68db9b0e-2c56-3426-bcea-870014b198ec",
                                                "text": "After this, was Edwin the Kings brother accuſed of ſome conſpiracie by him begun againſt the K. whervpõ he was baniſhed the land, and ſent out in an old rotten veſſell without rower or Marriner, onely accompanied with one Eſquire, ſo that beeing launched foorth from the ſhore, through very diſpaire Edwin lept into the Sea, and drowned himſelfe, but the Eſquire that was with him recouered his body, and broughte it to land at Withſand beſides Canterbury."
                                            },
                                            {
                                                "example_id": "9be98b7c-15cb-4da8-966d-62cfb1cf1d34",
                                                "sense_id": "68db9b0e-2c56-3426-bcea-870014b198ec",
                                                "text": "Beſides them both, vpon the ſoiled gras / The dead corſe of an armed knight was ſpred, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "besides",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4408860c-5ab7-3d1f-a27c-1a02973a4ef9",
                                        "entry_id": "af7347af-535a-32d1-b1fb-05abc5d9ffed",
                                        "glosses": [
                                            "Also; in addition."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b725c8-3420-4b71-885c-fadd38a6e419",
                                                "sense_id": "4408860c-5ab7-3d1f-a27c-1a02973a4ef9",
                                                "text": "It is besides used as a food, either as a sallad^([sic]), raw, or boiled as greens."
                                            },
                                            {
                                                "example_id": "a2e34614-63de-44df-83e2-0842374a0712",
                                                "sense_id": "4408860c-5ab7-3d1f-a27c-1a02973a4ef9",
                                                "text": "This was but one of Cluny’s hiding-places; he had caves, besides, and underground chambers in several parts of his country; and following the reports of his scouts, he moved from one to another as the soldiers drew near or moved away."
                                            },
                                            {
                                                "example_id": "f7f5862f-fe22-4475-9d19-8d237b452f49",
                                                "sense_id": "4408860c-5ab7-3d1f-a27c-1a02973a4ef9",
                                                "text": "In the end, Chelsea's organisation and discipline was rewarded but Di Matteo knows they will have to produce the same - and more besides - in the Nou Camp to confirm a meeting with either Real Madrid or Bayern Munich in the final in Munich next month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57354830-a4c5-31a8-aace-5f2e6050b051",
                                        "entry_id": "af7347af-535a-32d1-b1fb-05abc5d9ffed",
                                        "glosses": [
                                            "Used to emphasize an additional point, especially an important or stronger reason; moreover; furthermore."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73dd7302-85d4-42c2-87de-fbe942836e0f",
                                                "sense_id": "57354830-a4c5-31a8-aace-5f2e6050b051",
                                                "text": "I don't feel like going out tonight. Besides, I have to work tomorrow morning anyway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "967f728d-0aa9-3baa-a482-aae01f194206",
                                        "entry_id": "af7347af-535a-32d1-b1fb-05abc5d9ffed",
                                        "glosses": [
                                            "Otherwise; else."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92296ee8-672a-439e-b0e0-54b5faebb3fc",
                                                "sense_id": "967f728d-0aa9-3baa-a482-aae01f194206",
                                                "text": "I have been to Spain but nowhere besides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "904b7255-2e17-305f-bd10-495aa015ad2f",
                                        "entry_id": "af7347af-535a-32d1-b1fb-05abc5d9ffed",
                                        "glosses": [
                                            "On one side."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00b59ce-ad11-46de-9ba7-1a9013e73033",
                                                "sense_id": "904b7255-2e17-305f-bd10-495aa015ad2f",
                                                "text": "You are so strongly in my purpose bred\nThat all the world besides methinks are dead"
                                            },
                                            {
                                                "example_id": "f40907ce-8590-42d0-9ffc-3716331a5170",
                                                "sense_id": "904b7255-2e17-305f-bd10-495aa015ad2f",
                                                "text": "Yet Teucer would another shaft, at Hectors life dispose;\n So faine, he such a marke would hit: but still besides it goes;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ccdb01f-701f-44fd-b600-752e661f0be6",
                        "source_entry_id": "bcd10ef7-09ac-3396-b5e7-3c1fd5b87fbc",
                        "source_sense_id": "7026470f-fada-34ac-bdaf-eae6667b407a",
                        "target_lang_word": "anyway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anyway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "624e8085-dc54-3de9-8cb7-ad48ea71c66d",
                                        "entry_id": "ccd67228-325c-304e-80b6-0187c9512dac",
                                        "glosses": [
                                            "Regardless; anyhow."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f68e5d33-bd50-425e-9ce7-f8fd5ae95f88",
                                                "sense_id": "624e8085-dc54-3de9-8cb7-ad48ea71c66d",
                                                "text": "He didn't enjoy washing his car, but it was so dirty that he did it anyway."
                                            },
                                            {
                                                "example_id": "b3963f60-b255-4b57-b1c3-2acb6069e309",
                                                "sense_id": "624e8085-dc54-3de9-8cb7-ad48ea71c66d",
                                                "text": "Raymond Carver had only moments late at night to write after grueling day jobs, tense relationships, putting kids to bed, and dealing with his own alcoholism. And he wrote anyway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a96c8d4-d45f-3937-b84d-55451e27e6ea",
                                        "entry_id": "ccd67228-325c-304e-80b6-0187c9512dac",
                                        "glosses": [
                                            "Used to indicate that a statement explains or supports a previous statement. See anyhow and at least."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c696683-8c5f-4694-9d43-15e4778dd3af",
                                                "sense_id": "4a96c8d4-d45f-3937-b84d-55451e27e6ea",
                                                "text": "I don't think that's true. I haven't found any evidence, anyway."
                                            },
                                            {
                                                "example_id": "352438d5-acfa-4ba0-adae-e69023ff619a",
                                                "sense_id": "4a96c8d4-d45f-3937-b84d-55451e27e6ea",
                                                "text": "But I wish there were somethin’ you would do or say\nTo try and make me change my mind and stay\nWe never did too much talkin’ anyway\nDon’t think twice, it’s all right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef4644b-5caf-3353-aceb-ba8b7e78d3de",
                                        "entry_id": "ccd67228-325c-304e-80b6-0187c9512dac",
                                        "glosses": [
                                            "Used to indicate a change of subject."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa6b4851-64b8-4e21-90d4-3d445866fccc",
                                                "sense_id": "4ef4644b-5caf-3353-aceb-ba8b7e78d3de",
                                                "text": "\"I'll be ninety my next birthday, but Louella doesn't tell her age. Anyway, we're going to have you and Cynthia up for supper.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c6fa63c-7c76-35a8-abad-644040b4a8dc",
                                        "entry_id": "ccd67228-325c-304e-80b6-0187c9512dac",
                                        "glosses": [
                                            "Used at the end of a question for emphasis, or to direct the conversation to something of more broad importance (compare with more to the point)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "651cd099-071c-4858-bc65-79c5729bd100",
                                                "sense_id": "5c6fa63c-7c76-35a8-abad-644040b4a8dc",
                                                "text": "“But I say, Kid, isn't that going it a little too strong? Whisky and alcohol's bad enough; but when it comes to brandy and pepper-sauce and—” ¶ “Dump it in. Who's making this punch, anyway?”"
                                            },
                                            {
                                                "example_id": "9b0ee069-380b-4d13-bdbd-6e5817fc9b71",
                                                "sense_id": "5c6fa63c-7c76-35a8-abad-644040b4a8dc",
                                                "text": "The name, Barry Frank, the name of the game when it comes to money these days, in every sport, is television revenue. How do they get enough money- let me back up a minute. How did the United States get the World Cup anyway? Of all the countries in the world, you'd think we'd be the last one to get it."
                                            },
                                            {
                                                "example_id": "c61dbab8-c44b-4b62-ad1c-ced5b99ad7c5",
                                                "sense_id": "5c6fa63c-7c76-35a8-abad-644040b4a8dc",
                                                "text": "“We should probably wait until Luke gets here to talk about it,” Leia suggested quietly before Han could answer. Lando glanced past Han, as if only just noticing Luke's absence. “Where is he, anyway?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba4e186f-cc78-3bba-8668-19f467c702bc",
                                        "entry_id": "ccd67228-325c-304e-80b6-0187c9512dac",
                                        "glosses": [
                                            "In any way."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef9dd90-d944-40d4-87e1-696337e7574e",
                                                "sense_id": "ba4e186f-cc78-3bba-8668-19f467c702bc",
                                                "text": "He that sleeps in the day-time, or is in suspense, fear, anyway troubled in mind, or goes to bed upon a full stomach, may never hope for quiet rest in the night […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d55b19b-fe2f-4d70-8904-8c03de6ff95a",
                        "source_entry_id": "bcd10ef7-09ac-3396-b5e7-3c1fd5b87fbc",
                        "source_sense_id": "7026470f-fada-34ac-bdaf-eae6667b407a",
                        "target_lang_word": "in any case",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in any case",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "453cbeb0-1473-3adc-950c-d17ded0cea67",
                                        "entry_id": "af849dda-7a81-3b95-88c5-b02b328fd489",
                                        "glosses": [
                                            "Whatever be the case."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af30d00-9865-4f22-a5c9-844c150ca21b",
                                                "sense_id": "453cbeb0-1473-3adc-950c-d17ded0cea67",
                                                "text": "Who knows how many more inches of snow will fall tonight, but in any case, we can expect to be doing a lot of shoveling tomorrow."
                                            },
                                            {
                                                "example_id": "f040ec8d-3f13-4b49-94d7-ebf0a2060053",
                                                "sense_id": "453cbeb0-1473-3adc-950c-d17ded0cea67",
                                                "text": "Later Martin said, \"If we ever have another baby girl, I'm going to give her a simple name like Mary Jane.\" When we did have another daughter, we called her Bernice Albertine, after her two grandmothers. Not quite Mary Jane, but at least named for members of the family. In any case, she is known as Bunny,"
                                            },
                                            {
                                                "example_id": "c48be66b-bd0d-416f-ac2f-17c35390cfd1",
                                                "sense_id": "453cbeb0-1473-3adc-950c-d17ded0cea67",
                                                "text": "The Information Department is outhoused but there are operational reasons for this and it would, in any case, be physically impossible to house the staff of the Department in the main building."
                                            },
                                            {
                                                "example_id": "31550733-bd5e-4d79-878e-5ee97603a773",
                                                "sense_id": "453cbeb0-1473-3adc-950c-d17ded0cea67",
                                                "text": "Because of the juristic difficulties associated with the Donation of Constantine, the question of whether the papacy had in any case prescribed its jurisdiction in the patrimony had become a common topic amongst jurists […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ffe5d7a-0214-39b4-8ce1-a67def60f157",
                                        "entry_id": "af849dda-7a81-3b95-88c5-b02b328fd489",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see in, any, case."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44218ce-c91c-4eff-8492-ecca98ed7e40",
                                                "sense_id": "9ffe5d7a-0214-39b4-8ce1-a67def60f157",
                                                "text": "Their most popular product, an assortment of ales, is packaged such that there are always at least two bottles of India pale ale in any case."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82419c0e-e9a8-4633-a7ea-b1e74e140791",
                        "source_entry_id": "bcd10ef7-09ac-3396-b5e7-3c1fd5b87fbc",
                        "source_sense_id": "7026470f-fada-34ac-bdaf-eae6667b407a",
                        "target_lang_word": "кроме того",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
