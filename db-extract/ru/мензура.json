                "senses": [
                    {
                        "sense_id": "7ff717d9-93b5-3dad-a3d8-8f9583a59306",
                        "entry_id": "72e57e07-0cec-3495-95b8-d0f62639e30b",
                        "glosses": [
                            "the scale length (of a stringed instrument)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85264824-0431-4926-b32f-dd5ddcd46121",
                                "sense_id": "7ff717d9-93b5-3dad-a3d8-8f9583a59306",
                                "text": "В стру́нных щипко́вых и смычко́вых инструме́нтах мензу́рой называ́ют факти́ческое расстоя́ние стру́н от ве́рхнего до ни́жнего поро́жков стру́нных музыка́льных инструме́нтов, таки́х как: гита́ра, скри́пка, балала́йка и т. д.",
                                "translation": "Concerning the plucked and bowed string instruments the actual string length from the nut to the bridge saddle of the string musical instruments, such as the guitar, violin, balalaika and so forth, is called the scale length.",
                                "english": "Concerning the plucked and bowed string instruments the actual string length from the nut to the bridge saddle of the string musical instruments, such as the guitar, violin, balalaika and so forth, is called the scale length."
                            }
                        ]
                    }
