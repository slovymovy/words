                                    {
                                        "sense_id": "af168289-fb99-3490-bcb4-722c28061bc4",
                                        "entry_id": "3085b1a2-1097-3ae2-8efb-6d311016eb3a",
                                        "glosses": [
                                            "An expression of surprise, dismay, or indulgent disapproval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5540537-3b48-4da2-8a80-7350425895f9",
                                                "sense_id": "af168289-fb99-3490-bcb4-722c28061bc4",
                                                "text": "\"Dear me, Mr. Holmes. Dear me!\" said this singular epistle. There was neither superscription nor signature. I laughed at the quaint message; but Holmes showed unwonted seriousness."
                                            },
                                            {
                                                "example_id": "5c8a257c-ebaa-43dd-b808-2a272b58ef47",
                                                "sense_id": "af168289-fb99-3490-bcb4-722c28061bc4",
                                                "text": "\"Dear me,\" said Mrs. Flanders, when she read in the Scarborough and Harrogate Courier that the Rev. Andrew Floyd, etc., etc., had been made Principal of Maresfield House, \"that must be our Mr. Floyd.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
