    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "575aebc9-6dc5-3ed6-9642-f7cbd0554db0",
                "word": "crenellation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "81a47217-a5fc-476e-b47b-c24eea57da2c",
                        "entry_id": "575aebc9-6dc5-3ed6-9642-f7cbd0554db0",
                        "tags": [
                            "plural"
                        ],
                        "form": "crenellations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e12d32b7-1fef-326f-9b7e-ae782751b27c",
                        "entry_id": "575aebc9-6dc5-3ed6-9642-f7cbd0554db0",
                        "glosses": [
                            "A pattern along the top of a parapet (fortified wall), most often in the form of multiple, regular, rectangular spaces in the top of the wall, through which arrows or other weaponry may be shot, especially as used in medieval European architecture."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e3bade29-1867-4d42-bcb1-fde9de5d7334",
                                "sense_id": "e12d32b7-1fef-326f-9b7e-ae782751b27c",
                                "text": "This villa was long and low and white, and severe after its manner : for upon and about it were none of those playful ebullitions of taste, such as conical towers, domed roofs, embattlements, statues, coloured tiles and crenellations, such as are dear to architects of villas all the world over."
                            },
                            {
                                "example_id": "4161b86f-2cd6-433b-b769-63436e03eecf",
                                "sense_id": "e12d32b7-1fef-326f-9b7e-ae782751b27c",
                                "text": "And so, when the noon sun was shining over the palace, Eslaf quickly scaled the wall near the front gate and waited, hidden in the crenelations. The interior courtyard was plain and desolate, with few places to hide, but he saw that there were two wells."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e1b3c99-e919-3e09-92fb-790805737d6e",
                        "entry_id": "575aebc9-6dc5-3ed6-9642-f7cbd0554db0",
                        "glosses": [
                            "The act of crenellating; adding a top row that looks like the top of a medieval castle."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "576d7521-36a0-319a-8175-a1b12893a250",
                        "entry_id": "575aebc9-6dc5-3ed6-9642-f7cbd0554db0",
                        "glosses": [
                            "Any of a series of notches with fancied resemblance to such battlements, as for example around the bezel of a flashlight."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
