                "senses": [
                    {
                        "sense_id": "76e4cb30-9a0a-3cbc-8be8-9245b124fd4b",
                        "entry_id": "3cca8896-e0f0-3b37-9e53-0265a9f6b6ba",
                        "glosses": [
                            "voor buitenwater afsluitbare bouwplaats waar men als het te te bouwen element klaar is water kan inlaten om het betreffende bouwelement naar de plaats van bestemming te kunnen varen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0cee0f-ac0c-4b19-bb35-7cd47669e1c8",
                                "sense_id": "76e4cb30-9a0a-3cbc-8be8-9245b124fd4b",
                                "text": "De Maastunnel is de eerste afgezonken tunnel van Nederland. Losse tunneldelen, gemaakt op een bouwdok, werden over de rivier aangevoerd en stuk voor stuk afgezonken."
                            },
                            {
                                "example_id": "6b8d8811-e16a-4b0a-bb39-b40f4b3717c9",
                                "sense_id": "76e4cb30-9a0a-3cbc-8be8-9245b124fd4b",
                                "text": "Afgezonken tunnels worden meestal in een bouwdok gemaakt. Daarna worden ze door middel van sleepboten naar de plaats van bestemming gebracht, waar ze worden afgezonken met behulp van lieren. Voor het transport sluit men de buizen aan de uiteinden af met behulp van kopschotten."
                            },
                            {
                                "example_id": "8880ae85-ecda-4000-b693-58d8bc245395",
                                "sense_id": "76e4cb30-9a0a-3cbc-8be8-9245b124fd4b",
                                "text": "Een reusachtige tunneldeel van de Noord/Zuidlijn, dat in de loop van 2010 onder het IJ en onder het Centraal Station kwam te liggen, wordt vanuit het bouwdok naast de Sixhaven over het IJ weggesleept naar een tijdelijke ‘parkeerplaats’ in de Suezhaven (Westelijk Havengebied). HP de Tijd 25/09"
                            }
                        ]
                    }
                ],
