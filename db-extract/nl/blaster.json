                        "sense_id": "48748f25-f789-35be-8992-3a0466825f21",
                        "entry_id": "3190ee25-8276-34f8-b13a-415d92de3759",
                        "glosses": [
                            "iets wat een hard geluid maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59fb4953-443b-4872-b9b7-7b0a0d69a568",
                                "sense_id": "48748f25-f789-35be-8992-3a0466825f21",
                                "text": "En al die helden moeten worden aangemoedigd door juichende mensen. Want dat helpt. Net zoals dweilorkesten, gettoblasters en luidsprekers helpen. Keiharde gettoblasters op de vensterbank, dat die blasters het bijna niet meer houden: zo moet het."
                            }
                        ]
