                "senses": [
                    {
                        "sense_id": "b01064cc-afa7-368e-b1bd-6cdddaeb14ce",
                        "entry_id": "95c2425f-4d31-306b-8369-db6221c0ad86",
                        "glosses": [
                            "Étable à bœufs."
                        ],
                        "tags": [],
                        "note": "Se dit particulièrement des étables qui sont dans les environs des marchés publics",
                        "examples": [
                            {
                                "example_id": "6eb55de8-1c84-4c3a-ad5c-a588c8518c8d",
                                "sense_id": "b01064cc-afa7-368e-b1bd-6cdddaeb14ce",
                                "text": "Nous étions montés par l’escalier et non par le plan incliné qui mène à la bouverie."
                            },
                            {
                                "example_id": "b76e98c1-5302-400d-beb0-14ed062c5c7a",
                                "sense_id": "b01064cc-afa7-368e-b1bd-6cdddaeb14ce",
                                "text": "Sur un des côtés de la cour se dressait une grange, ou une bouverie, ou un cellier, le bâtiment étant vide on ne pouvait savoir à quel usage il avait servi, pour être une grange il manquait les huches, s'il s'agissait d'une bouverie où étaient passés les anneaux ordinairement fixés aux murs et il n'est pas de celliers sans tonneaux."
                            },
                            {
                                "example_id": "5608874f-06f1-472d-ae8e-c2d50583b4aa",
                                "sense_id": "b01064cc-afa7-368e-b1bd-6cdddaeb14ce",
                                "text": "Les équarrisseurs déjeunent sur le pouce, assis au pied de la bouverie, les jambes allongées dans la rue des Martyrs, bas de pantalon retenus par un tortil de paille que le sang a imprégné."
                            }
                        ]
                    }
                ],
