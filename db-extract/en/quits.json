    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d9924e3d-e564-3294-a861-c4534063f17a",
                "word": "quits",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "18c8ae58-a93e-3081-9936-6ef7d2e78827",
                        "entry_id": "d9924e3d-e564-3294-a861-c4534063f17a",
                        "glosses": [
                            "On equal monetary terms; neither owing or being owed."
                        ],
                        "tags": [
                            "British",
                            "colloquial",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3441abd8-38bb-425c-9b34-926fe513c2ee",
                                "sense_id": "18c8ae58-a93e-3081-9936-6ef7d2e78827",
                                "text": "Here's the last of the money you lent me. We're quits now, right?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6da3dec-e4ca-4278-a951-8c891bf5d2e7",
                        "source_entry_id": "d9924e3d-e564-3294-a861-c4534063f17a",
                        "source_sense_id": "18c8ae58-a93e-3081-9936-6ef7d2e78827",
                        "source_sense_description": "on equal monetary terms",
                        "target_lang_word": "quitte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quitte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                        "entry_id": "d89041a2-7e68-3892-b38f-00e26d690f1a",
                                        "glosses": [
                                            "Libéré d’une dette, d’une obligation, d’un devoir moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c62730-9afa-43f3-8d57-981f21780c66",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Reçu tant, payé tant, et partant quitte."
                                            },
                                            {
                                                "example_id": "2ebaef3e-61f2-4084-8626-30754739ca71",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Je suis quitte envers vous."
                                            },
                                            {
                                                "example_id": "1869747c-430a-4a13-90c7-ace5b89577bb",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Je vous tiens quitte de ce que vous pouvez me devoir."
                                            },
                                            {
                                                "example_id": "5ddf433e-fbe5-415c-a594-e475c4c2f70c",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Il m’a vendu ce bien franc et quitte de toutes dettes et hypothèques."
                                            },
                                            {
                                                "example_id": "75b310ed-2fb6-4aa0-a72e-f8d53f3ceb1f",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Nous sommes quittes."
                                            },
                                            {
                                                "example_id": "f4d5d79b-0cc1-4c44-869f-502030d68961",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Être quitte envers quelqu’un, s’être acquitté envers lui de ce qu’exigeait la reconnaissance."
                                            },
                                            {
                                                "example_id": "a049079f-9521-436c-a7b6-e04037a297e9",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Il m’avait rendu de grands services, mais je lui en ai rendu d’au moins équivalents : je suis quitte envers lui."
                                            },
                                            {
                                                "example_id": "cafc7dd8-8eaf-4891-8a64-6a5628baa785",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Je l’en tiens quitte, je l’en dispense."
                                            },
                                            {
                                                "example_id": "5a98099a-c5bc-4097-ad93-0ce3a22fd158",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Être quitte à quitte, au jeu, dans les affaires, dans les comptes que l’on se rend les uns aux autres, ne se devoir plus rien de part ni d’autre."
                                            },
                                            {
                                                "example_id": "655262fa-2f42-44c6-98a9-0c058199dc8c",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Nous voilà quitte à quitte."
                                            },
                                            {
                                                "example_id": "5e0f4d41-7a28-40eb-9cd2-40dbd03573e8",
                                                "sense_id": "0d1e4897-a079-3f72-a1c3-8e3bac9eb670",
                                                "text": "Nous sommes quitte à quitte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44ec5dec-0ba1-37a4-a9c9-d00ba50c9d1c",
                                        "entry_id": "d89041a2-7e68-3892-b38f-00e26d690f1a",
                                        "glosses": [
                                            "Délivré, débarrassé de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4843efb2-ac7d-413f-bfd4-2bf4dbe7178b",
                                                "sense_id": "44ec5dec-0ba1-37a4-a9c9-d00ba50c9d1c",
                                                "text": "Me voilà quitte de la corvée, du compliment, de la visite que j’avais à faire."
                                            },
                                            {
                                                "example_id": "4b8b43ff-1eaa-44d3-a860-1f60b3c59cef",
                                                "sense_id": "44ec5dec-0ba1-37a4-a9c9-d00ba50c9d1c",
                                                "text": "Il a un procès, une affaire fâcheuse, il voudrait en être quitte pour une dizaine de mille francs."
                                            },
                                            {
                                                "example_id": "96811756-b2bf-4f2b-b8fc-2a91eada6458",
                                                "sense_id": "44ec5dec-0ba1-37a4-a9c9-d00ba50c9d1c",
                                                "text": "Vous n’avez eu qu’un rhume : vous en êtes quitte à bon marché."
                                            }
                                        ]
                                    }
                                ]
                            },
