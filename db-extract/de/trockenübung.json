                "senses": [
                    {
                        "sense_id": "37d9f91b-0be3-33bc-87fa-a45824de6bf5",
                        "entry_id": "6c7f6cd7-4b2a-3167-a2a6-fbefd6b36a64",
                        "glosses": [
                            "vorbereitendes Training, bei dem Techniken oder Abläufe ohne die üblichen realen Bedingungen geübt werden"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7755a9ae-dff9-4a27-ba40-4301b41af857",
                                "sense_id": "37d9f91b-0be3-33bc-87fa-a45824de6bf5",
                                "text": "„Ein Surflehrer erklärt unterdessen einer Gruppe von Anfängern, die Trockenübungen auf ihren Brettern machen, das kleine Einmaleins des Wellenreitens.“"
                            },
                            {
                                "example_id": "701ea5ca-609e-42a0-92c0-ad6c05f24c56",
                                "sense_id": "37d9f91b-0be3-33bc-87fa-a45824de6bf5",
                                "text": "„Nach der Sitzanpassung machte sich der 32-Jährige mit einer Trockenübung über 45 Minuten im Simulator mit dem Rennwagen vertraut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b89ba4-b59b-4d74-8364-90fa396e840a",
                        "source_entry_id": "6c7f6cd7-4b2a-3167-a2a6-fbefd6b36a64",
                        "source_sense_id": "37d9f91b-0be3-33bc-87fa-a45824de6bf5",
                        "source_sense_description": "vorbereitendes Training ohne die üblichen realen Bedingungen",
                        "target_lang_word": "dry run",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dry run",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e1c8cb3-7af4-3b0d-8713-ff4f0c1aff72",
                                        "entry_id": "8b9d882f-e29c-3e11-9405-d94e7520e0b4",
                                        "glosses": [
                                            "A practice or rehearsal; especially, one that goes through all the motions of a physical process but without the raw material or workpiece present."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6acaad0d-ed99-498f-8088-04f21a14b7cb",
                                                "sense_id": "8e1c8cb3-7af4-3b0d-8713-ff4f0c1aff72",
                                                "text": "They did a dry run of the demonstration before showing it to the CEO."
                                            },
                                            {
                                                "example_id": "92d577a2-fc4a-4f67-9b71-1b9a265b8dc4",
                                                "sense_id": "8e1c8cb3-7af4-3b0d-8713-ff4f0c1aff72",
                                                "text": "When the dry run mode of a machine tool control is on, the machine can move rapidly because it is cutting only air, not metal. The operator can do a dry run and verify that the motions look correct."
                                            },
                                            {
                                                "example_id": "64b8066c-8ad4-41f3-93ab-37bb3da7ec59",
                                                "sense_id": "8e1c8cb3-7af4-3b0d-8713-ff4f0c1aff72",
                                                "text": "Next Mr. Gregory went on to make a big thing out of the fact that he had caught them climbing \"into\" the school grounds not long before. He didn't exactly say so, but it was plain that he felt he had interrupted some kind of dry run—a training exercise for a crime in the planning."
                                            },
                                            {
                                                "example_id": "4498805e-95c7-44e8-a38a-2380e35e2f21",
                                                "sense_id": "8e1c8cb3-7af4-3b0d-8713-ff4f0c1aff72",
                                                "text": "John seems to think I will have enough to say of interest to the membership to fill my minimum number of pages. I understand that some waitlisters have contributed pages before becoming full members and this seems like a good idea to me. This way I can make a dry run at putting together my contributions each mailing without worrying about having to meet minac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
