                                    {
                                        "sense_id": "17003a33-2a6c-36ac-a878-bc2a033c3f05",
                                        "entry_id": "5277e677-c045-3b91-a69a-78f1e2ef55af",
                                        "glosses": [
                                            "Vertreter der artenreichen Pflanzengattung Passiflora aus der Familie der Passionsblumengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f5b377-6ee0-4b9a-8744-853b11285efe",
                                                "sense_id": "17003a33-2a6c-36ac-a878-bc2a033c3f05",
                                                "text": "Die meisten Passionsblumen stammen aus Südamerika."
                                            },
                                            {
                                                "example_id": "6f44df3a-9047-451f-9760-046a11e9c697",
                                                "sense_id": "17003a33-2a6c-36ac-a878-bc2a033c3f05",
                                                "text": "Die Früchte einiger Passionsblumen werden als Maracuja gehandelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
