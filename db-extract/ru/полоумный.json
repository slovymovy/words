                "senses": [
                    {
                        "sense_id": "bc73187a-74d9-3b13-8957-6cfbbebe1b66",
                        "entry_id": "2be1cd0a-4c52-319d-8200-6038a10e6dce",
                        "glosses": [
                            "помешанный, слабоумный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d254ea-fc57-491a-ae52-c050b169ca22",
                                "sense_id": "bc73187a-74d9-3b13-8957-6cfbbebe1b66",
                                "text": "Ходит полоумный // Старичина, // Петуха на темень посадив."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab1cd738-84b0-3c97-97a8-ad8c00f48bbf",
                        "entry_id": "2be1cd0a-4c52-319d-8200-6038a10e6dce",
                        "glosses": [
                            "субстантивир., перен. сумасбродный, взбалмошный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d32bf79-23f9-44c7-b308-79af2398b832",
                                "sense_id": "ab1cd738-84b0-3c97-97a8-ad8c00f48bbf",
                                "text": "Когда я в восьмом часу утра вскочил как полоумный и хватил себя по лбу рукой, то тотчас же разбудил генерала, спавшего сном невинности."
                            }
                        ]
                    }
