    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "88da15f6-db4f-3dba-8f9c-479ecb626706",
                "word": "coffined",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "926c312a-e16a-3fe3-b585-a74e0c343264",
                        "entry_id": "88da15f6-db4f-3dba-8f9c-479ecb626706",
                        "glosses": [
                            "Enclosed in a coffin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe929f8e-a495-4c81-88f6-e5c32d927b83",
                                "sense_id": "926c312a-e16a-3fe3-b585-a74e0c343264",
                                "text": "As the ground became frozen more solidly during February, the coffined bodies could no longer be promptly buried."
                            },
                            {
                                "example_id": "6d41b70c-db56-4c82-94d4-876fd39f59aa",
                                "sense_id": "926c312a-e16a-3fe3-b585-a74e0c343264",
                                "text": "There is no mortuaray in Plymouth for coffined bodies awaiting burial."
                            },
                            {
                                "example_id": "69a349e7-4e62-4ce6-a6a3-04802aad3ae8",
                                "sense_id": "926c312a-e16a-3fe3-b585-a74e0c343264",
                                "text": "In my understanding, the desire for “the smile on the coffined face,” is the habitual yearning of the person to identify him or herself with an image, with a form."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4351989-f70e-38ac-ae26-492c85583ee2",
                        "entry_id": "88da15f6-db4f-3dba-8f9c-479ecb626706",
                        "glosses": [
                            "Making use of or containing a coffin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de41633d-d7ea-459e-89ab-96e4d82e9880",
                                "sense_id": "f4351989-f70e-38ac-ae26-492c85583ee2",
                                "text": "I observe, likewise, that in old tables of burial fees, a distinction of payment is made for coffined funerals and uncoffined funerals."
                            },
                            {
                                "example_id": "1199ff67-0da0-42fd-bcca-86315e323bc7",
                                "sense_id": "f4351989-f70e-38ac-ae26-492c85583ee2",
                                "text": "Adults were more likely to have had a coffined burial with evidence for 13 coffined burials out of 97 individuals (13%), four of these from within the nave of the church."
                            },
                            {
                                "example_id": "76b4574f-83ad-4d04-b6ca-88da5c99aed3",
                                "sense_id": "f4351989-f70e-38ac-ae26-492c85583ee2",
                                "text": "Coffined graves contained a burial within a wooden coffin or recptacle, and having such a grave would indicate additional expense and therefore suggest higher status."
                            }
                        ]
                    },
                    {
                        "sense_id": "61d91402-bad6-366b-bff9-aa0e24fe5be6",
                        "entry_id": "88da15f6-db4f-3dba-8f9c-479ecb626706",
                        "glosses": [
                            "Dead or locked up and without agency."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3841e300-8faa-44b0-9ce9-03802f294b81",
                                "sense_id": "61d91402-bad6-366b-bff9-aa0e24fe5be6",
                                "text": "What dead memories and coffined hopes was she bringing out to the dim light of her solitary candle?"
                            },
                            {
                                "example_id": "26709981-7b12-4c5b-9526-1ee8b07c1fd2",
                                "sense_id": "61d91402-bad6-366b-bff9-aa0e24fe5be6",
                                "text": "My heart is coffined, and I shall close the lid and bid it an eternal farewell!"
                            },
                            {
                                "example_id": "68452c19-a112-4b68-8fa6-c55ab9ca30f8",
                                "sense_id": "61d91402-bad6-366b-bff9-aa0e24fe5be6",
                                "text": "Coffined thoughts surround him."
                            }
                        ]
                    }
                ],
