            {
                "entry_id": "3b316249-cae4-3cad-b076-cd2bf8e6fd30",
                "word": "alba",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e2e422b8-63fe-4551-8839-9e30e490384e",
                        "entry_id": "3b316249-cae4-3cad-b076-cd2bf8e6fd30",
                        "tags": [
                            "plural"
                        ],
                        "form": "albas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36019e9c-50e9-388f-af26-99a3d7bae1b3",
                        "entry_id": "3b316249-cae4-3cad-b076-cd2bf8e6fd30",
                        "glosses": [
                            "Synonym of alb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b821b253-90b7-4fb7-90d1-c81ae23d1da0",
                                "sense_id": "36019e9c-50e9-388f-af26-99a3d7bae1b3",
                                "text": "On a little plot of grass near the kitchen the family were spreading out a large supply of priestly vestments—albas, casullas, capas pluviales, ornamentos, parmentos, cíngulas, estolas, frontales, etc., etc., etc."
                            },
                            {
                                "example_id": "85c10af4-77af-4170-8109-90f9b6f32404",
                                "sense_id": "36019e9c-50e9-388f-af26-99a3d7bae1b3",
                                "text": "Christ, whom they meet, must wear an alba and an amictus, be barefooted, and carry a cross on the left shoulder."
                            },
                            {
                                "example_id": "4d4cb1ec-f83d-48ba-8e76-63540d034128",
                                "sense_id": "36019e9c-50e9-388f-af26-99a3d7bae1b3",
                                "text": "Traditional styles such as cassocks and cottas, or contemporary trends in robes and collars, choir albas, skirts, caps and acolyte vestments."
                            },
                            {
                                "example_id": "8ef71580-359d-431d-89e5-7429379788ae",
                                "sense_id": "36019e9c-50e9-388f-af26-99a3d7bae1b3",
                                "text": "Another canon with a biretta in his hand, wearing an alba and an upper fur mucia, is kneeling to the left of the Crucifix;"
                            }
                        ]
                    }
                ],
