                                    {
                                        "sense_id": "8fdd78af-7a29-3ed8-8deb-5e7f21a06d74",
                                        "entry_id": "71de9932-0a0b-3be8-ace2-614afb132255",
                                        "glosses": [
                                            "The largest city and former capital of Michigan, United States, a major port on the Detroit River, known as the traditional automotive center of the U.S. It is the county seat of Wayne County."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dd558a6-e151-419f-be8b-bb380f6e6d23",
                                                "sense_id": "8fdd78af-7a29-3ed8-8deb-5e7f21a06d74",
                                                "text": "I’ll tell you what Detroit is. We’re a prideful people that love our city more than anything – even if we do, in many cases, make the difficult decision to leave the city for somewhere outside the boundaries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5b4dae-783f-3429-bf0d-1584fd4c6f06",
                                        "entry_id": "71de9932-0a0b-3be8-ace2-614afb132255",
                                        "glosses": [
                                            "The United States' automotive industry."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61bf5789-689f-4b00-8f81-0e62334f4791",
                                                "sense_id": "cb5b4dae-783f-3429-bf0d-1584fd4c6f06",
                                                "text": "'Cause in the real world they're shutting Detroit down / While the boss man takes his bonus pay and jets on out of town."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
