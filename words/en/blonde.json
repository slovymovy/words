{
    "word_family": [
        "blondness",
        "blondish"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "883bb596-e3da-3fae-98e0-dcc82d13e79c",
                    "sense_definition": "Having fair, pale yellow, or golden hair.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hair_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has long, wavy <w>blonde</w> hair that shines in the sun.",
                            "target_lang_translations": {
                                "ru": "У нее длинные волнистые <w>светлые</w> волосы, которые сияют на солнце.",
                                "zh": "她留着一头长长的波浪形<w>金发</w>，在阳光下闪闪发光。"
                            }
                        },
                        {
                            "text": "The <w>blonde</w> child played happily with his toys in the sand.",
                            "target_lang_translations": {
                                "ru": "<w>Белокурый</w> ребенок счастливо играл со своими игрушками в песке.",
                                "zh": "那个<w>金发</w>小孩正在沙子里开心地玩着玩具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fair",
                        "fair-haired",
                        "golden-haired",
                        "flaxen",
                        "light-haired",
                        "light"
                    ],
                    "antonyms": [
                        "dark",
                        "brunette",
                        "dark-haired"
                    ],
                    "common_phrases": [
                        "platinum blonde",
                        "strawberry blonde",
                        "bleach blonde",
                        "natural blonde"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий светлые, бледно-желтые или золотистые волосы.",
                        "zh": "指头发呈浅黄色或金黄色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светловолосый",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "белокурый",
                                "target_lang_sense_clarification": "о волосах или человеке"
                            },
                            {
                                "target_lang_word": "блондинистый",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金发",
                                "target_lang_sense_clarification": "指头发颜色"
                            },
                            {
                                "target_lang_word": "浅色头发",
                                "target_lang_sense_clarification": "描述发色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92e94fea-ff71-33ea-a0e7-886139184112",
                    "sense_definition": "Lacking intelligence or common sense; scatterbrained.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a <w>blonde</w> moment and completely forgot where I parked my car.",
                            "target_lang_translations": {
                                "ru": "У меня был момент <w>тупости</w>, и я совершенно забыл, где припарковал машину.",
                                "zh": "我刚才<w>犯糊涂</w>了，完全忘了把车停在哪儿。"
                            }
                        },
                        {
                            "text": "Don't be so <w>blonde</w>; the answer to the riddle is obvious.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>глупым</w>; ответ на загадку очевиден.",
                                "zh": "别那么<w>笨</w>了，这个谜语的答案显而易见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ditzy",
                        "scatterbrained",
                        "silly",
                        "foolish"
                    ],
                    "antonyms": [
                        "smart",
                        "intelligent",
                        "sharp"
                    ],
                    "common_phrases": [
                        "blonde moment"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe foolish behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый или легкомысленный; лишенный здравого смысла.",
                        "zh": "指人愚笨、缺乏常识或头脑简单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "о поведении или человеке"
                            },
                            {
                                "target_lang_word": "недалекий",
                                "target_lang_sense_clarification": "об умственных способностях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "愚笨",
                                "target_lang_sense_clarification": "形容人迟钝"
                            },
                            {
                                "target_lang_word": "糊涂",
                                "target_lang_sense_clarification": "形容行为或状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "448ed392-bc4b-3429-92ac-efc723fa31dc",
                    "sense_definition": "A woman or girl with fair or pale yellow hair.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hair_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall <w>blonde</w> walked into the room and everyone turned to look.",
                            "target_lang_translations": {
                                "ru": "Высокая <w>блондинка</w> вошла в комнату, и все обернулись, чтобы посмотреть.",
                                "zh": "那位高挑的<w>金发女郎</w>走进房间，所有人都转头去看。"
                            }
                        },
                        {
                            "text": "She is a natural <w>blonde</w>, although she sometimes adds highlights.",
                            "target_lang_translations": {
                                "ru": "Она натуральная <w>блондинка</w>, хотя иногда делает мелирование.",
                                "zh": "她是天生的<w>金发</w>，尽管有时会做些挑染。"
                            }
                        }
                    ],
                    "antonyms": [
                        "brunette"
                    ],
                    "common_phrases": [
                        "bottle blonde",
                        "dumb blonde"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина или девушка со светлыми или бледно-желтыми волосами.",
                        "zh": "指拥有浅黄色或金黄色头发的女性或女孩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блондинка",
                                "target_lang_sense_clarification": "женщина со светлыми волосами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金发女郎",
                                "target_lang_sense_clarification": "指金发女性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04b6c227-f784-36a8-9e57-89847c8123bb",
                    "sense_definition": "A pale yellow or golden color.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hair_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist chose a soft <w>blonde</w> for the background of the painting.",
                            "target_lang_translations": {
                                "ru": "Художник выбрал мягкий <w>золотистый цвет</w> для фона картины.",
                                "zh": "艺术家为画作背景选择了一种柔和的<w>金色</w>。"
                            }
                        },
                        {
                            "text": "We painted the kitchen walls a warm <w>blonde</w> to brighten the space.",
                            "target_lang_translations": {
                                "ru": "Мы покрасили стены кухни в теплый <w>блонд</w>, чтобы осветлить пространство.",
                                "zh": "我们将厨房墙壁刷成了温暖的<w>浅黄色</w>，以提亮空间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pale yellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бледно-желтый или золотистый цвет.",
                        "zh": "指浅黄色或金色的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "золотистый цвет",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "блонд",
                                "target_lang_sense_clarification": "название цвета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金色",
                                "target_lang_sense_clarification": "颜色名称"
                            },
                            {
                                "target_lang_word": "浅黄色",
                                "target_lang_sense_clarification": "颜色描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed4a92f7-5252-3daf-9edb-b05c54ff3b93",
                    "sense_definition": "A type of pale-colored beer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "beer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a refreshing <w>blonde</w> to enjoy with my lunch.",
                            "target_lang_translations": {
                                "ru": "Я заказал освежающий <w>блонд</w>, чтобы насладиться им за обедом.",
                                "zh": "我点了一杯清爽的<w>淡色啤酒</w>配午餐。"
                            }
                        },
                        {
                            "text": "This Belgian <w>blonde</w> has a distinctively fruity and spicy flavor.",
                            "target_lang_translations": {
                                "ru": "Этот бельгийский <w>блонд</w> обладает характерным фруктовым и пряным вкусом.",
                                "zh": "这种比利时<w>淡色啤酒</w>有着独特的果香和辛香味。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Belgian blonde"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сорт светлого пива.",
                        "zh": "一种浅色的啤酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлое пиво",
                                "target_lang_sense_clarification": "общая категория"
                            },
                            {
                                "target_lang_word": "блонд",
                                "target_lang_sense_clarification": "сорт эля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淡色啤酒",
                                "target_lang_sense_clarification": "啤酒种类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a97f54dc-bc19-3745-b34f-c914347ca72c",
                    "sense_definition": "A high-intensity 2,000-watt lamp used in film and television production.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lighting technician set up a <w>blonde</w> to illuminate the large set.",
                            "target_lang_translations": {
                                "ru": "Осветитель установил <w>блонд</w>, чтобы осветить большую декорацию.",
                                "zh": "灯光师架起了一盏<w>大功率聚光灯</w>来照亮大型布景。"
                            }
                        },
                        {
                            "text": "We need to move that <w>blonde</w> closer to get the right exposure.",
                            "target_lang_translations": {
                                "ru": "Нам нужно пододвинуть этот <w>блонд</w> ближе, чтобы получить правильную экспозицию.",
                                "zh": "我们需要把那盏<w>聚光灯</w>移近一点，以获得正确的曝光。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "film industry jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощная 2000-ваттная лампа, используемая в кино и на телевидении.",
                        "zh": "影视制作中使用的2000瓦高强度照明灯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блонд",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            },
                            {
                                "target_lang_word": "прожектор",
                                "target_lang_sense_clarification": "осветительный прибор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大功率聚光灯",
                                "target_lang_sense_clarification": "影视照明设备"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc097f32-a210-3420-87d6-c7a584af3c18",
                    "sense_definition": "To dye hair to a fair or pale yellow color.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hair_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>blonde</w> her hair before the summer vacation started.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>осветлить</w> волосы перед началом летнего отпуска.",
                                "zh": "她决定在暑假开始前把头发<w>漂染</w>成金色。"
                            }
                        },
                        {
                            "text": "Many women who <w>blonde</w> their hair visit the salon regularly.",
                            "target_lang_translations": {
                                "ru": "Многие женщины, которые <w>осветляют</w> волосы, регулярно посещают салон.",
                                "zh": "许多<w>漂染</w>头发的女性会定期去美发沙龙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bleach",
                        "lighten",
                        "dye"
                    ],
                    "antonyms": [
                        "darken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красить волосы в светлый или бледно-желтый цвет.",
                        "zh": "将头发染成浅色或金黄色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осветлять",
                                "target_lang_sense_clarification": "делать светлее"
                            },
                            {
                                "target_lang_word": "красить в блондинку",
                                "target_lang_sense_clarification": "менять цвет на блонд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漂染",
                                "target_lang_sense_clarification": "改变发色"
                            },
                            {
                                "target_lang_word": "染成金发",
                                "target_lang_sense_clarification": "特定颜色"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}