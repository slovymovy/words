                "senses": [
                    {
                        "sense_id": "fb008662-bd41-3ddf-a692-9e40ea3c3f72",
                        "entry_id": "acb46dd8-2e5d-3ca0-9c22-eebcaeaef02f",
                        "glosses": [
                            "Roche ultramafique (riche en magnésium ou en fer), potassique et riche en éléments incompatibles, ainsi qu’en volatils (H₂O et CO₂)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b80a161-930c-4200-95a6-fea2adf36353",
                                "sense_id": "fb008662-bd41-3ddf-a692-9e40ea3c3f72",
                                "text": "La kimberlite est surtout connue pour ses qualités diamantifères."
                            },
                            {
                                "example_id": "bd8d3606-1927-499d-aba4-60b4b5f12116",
                                "sense_id": "fb008662-bd41-3ddf-a692-9e40ea3c3f72",
                                "text": "Ce mélange s’est ensuite solidifié en une roche appelée kimberlite."
                            },
                            {
                                "example_id": "9226a460-c5c5-4bda-b48e-b464717b474c",
                                "sense_id": "fb008662-bd41-3ddf-a692-9e40ea3c3f72",
                                "text": "Les kimberlites se trouvent dans les cratons, la croûte continentale de l’Archéen, c'est-à-dire plus vieille que 2,5 milliards d'années."
                            },
                            {
                                "example_id": "962c59bf-b808-46d0-b46a-6833969d883c",
                                "sense_id": "fb008662-bd41-3ddf-a692-9e40ea3c3f72",
                                "text": "Des carottes de sondage sont prélevées dans la kimberlite, roche formée à très haute pression, et qui contient le carbone pur cristallisé sous forme de diamant."
                            }
                        ]
                    }
                ],
                "translations": [
