                        "glosses": [
                            "Full of, or covered in, gems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29c6d55-f641-4a80-b643-a6753b9db02d",
                                "sense_id": "c415537b-72b2-3396-8264-06eb0b1bb790",
                                "text": "The gemmy bridle glittered free, / Like to some branch of stars we see / Hung in the golden galaxy."
                            }
                        ]
                    },
                    {
                        "sense_id": "af5a82a8-4574-3e5c-b6d6-6c6f9c3e7887",
                        "entry_id": "6e2e093a-0227-32b8-b31d-ac8146e428af",
                        "glosses": [
                            "Bright and glittering, as though studded with gems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7810ed75-80d4-45b7-ab93-e1074c90e5ae",
                                "sense_id": "af5a82a8-4574-3e5c-b6d6-6c6f9c3e7887",
                                "text": "His mildly vivid dewy beam\nOf beryl to diffuse: the gleam\nWith elf-light tiniest figures lit\nOf shapely moon-fair elves who sit\nEach on a gemmy blade's curled tip\nIn circle."
                            }
                        ]
                    }
                ],
