                        "form": "die Strickleitern"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                        "entry_id": "6bfa356d-ba59-3d80-96e5-adb83c3271ad",
                        "glosses": [
                            "eine Leiter, deren Holme aus Stricken (Seilen) bestehen; sie kann leicht transportiert und platzsparend gelagert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e90f45d8-ce4d-4dcf-aee3-6cbf13305932",
                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                "text": "Mein Baumhaus ist nur über eine Strickleiter zu erreichen."
                            },
                            {
                                "example_id": "377ff7aa-8606-4440-a939-ac0fb5783c08",
                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                "text": "„Sie mussten mit ihren Habseligkeiten eine vier Meter hohe Strickleiter erklimmen, die mittschiffs zu einer Pforte im Schanzkleid führte.“"
                            },
                            {
                                "example_id": "07262e21-764b-44cb-8fd7-dac907f17cb8",
                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                "text": "„Als Durands Beiboot längsseits ging, ließ man von der Pontchartrain eine Strickleiter herab, sodass er an Deck klettern konnte.“"
                            },
                            {
                                "example_id": "752c94bc-99dd-43ba-882a-877146c38022",
                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                "text": "„Er entdeckte eine hinabhängende Strickleiter, die, wie er tastend feststellte, aus geflochtenem Leder bestand, und fand an der Felswand kräftige Mauergriffe.“"
                            },
                            {
                                "example_id": "4c5e91f5-467d-4fa4-893f-b6396e30d5f8",
                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                "text": "„Dafür könne man die Höhle vom Strand her auf einer Strickleiter erreichen, die sich bei Gefahr einziehen ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
