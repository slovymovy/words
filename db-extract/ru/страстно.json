                    },
                    {
                        "translation_id": "2b301eb1-da79-4182-a2c0-aaaa2ee8512f",
                        "source_entry_id": "85ec9ffc-77a1-3fc7-a375-a1297bebdd37",
                        "source_sense_id": "d50e1e10-dae2-3bd4-921c-2ce346ef01dd",
                        "target_lang_word": "fervently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fervently",
