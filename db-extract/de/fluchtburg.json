                        "examples": [
                            {
                                "example_id": "13ade4ff-1575-4e44-9d0c-e45f3d353c48",
                                "sense_id": "1e634f02-56e7-381b-a528-16a59e7a7b8c",
                                "text": "„Einige Fürstensitze wurden zu Fluchtburgen umgebaut, es kam auch zur Plünderung von Gräbern.“"
                            },
                            {
                                "example_id": "efd2b1bf-2311-4903-9873-daf4a972a6f2",
                                "sense_id": "1e634f02-56e7-381b-a528-16a59e7a7b8c",
                                "text": "„Und beinahe erscheint Hinterpommern in diesem Herbst 1944 als eine Fluchtburg des Friedens.“"
                            },
                            {
                                "example_id": "333e1698-3f38-4941-9872-8d95f6b7b4a1",
                                "sense_id": "1e634f02-56e7-381b-a528-16a59e7a7b8c",
                                "text": "„Sie sind kleiner als Oppida, umringen Berggipfel und gelten als Fluchtburgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
