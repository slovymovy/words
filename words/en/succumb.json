{
    "word_family": [
        "succumbence",
        "succumbency"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67e86b93-0ebc-3710-a80d-fbfc05737726",
                    "sense_definition": "To give up or stop resisting something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "yield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is hard not to <w>succumb</w> to the pressure of peer influence.",
                            "target_lang_translations": {
                                "tr": "Akran baskısına <w>boyun eğmemek</w> zordur."
                            }
                        },
                        {
                            "text": "He finally decided to <w>succumb</w> to their demands after hours of negotiation.",
                            "target_lang_translations": {
                                "tr": "Saatler süren müzakerelerden sonra nihayet taleplerine <w>boyun eğmeye</w> karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "capitulate",
                        "surrender",
                        "yield"
                    ],
                    "antonyms": [
                        "resist",
                        "withstand"
                    ],
                    "common_phrases": [
                        "succumb to pressure",
                        "succumb to demands"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeye karşı koymayı bırakmak veya teslim olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boyun eğmek",
                                "target_lang_sense_clarification": "Baskı veya talepler karşısında direnci bırakmak."
                            },
                            {
                                "target_lang_word": "teslim olmak",
                                "target_lang_sense_clarification": "Mücadeleyi bırakıp karşı tarafın isteğini kabul etmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ee97b2c-7f98-3e2b-922d-06842c9a66da",
                    "sense_definition": "To be overcome by an overpowering force, desire, or external influence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "yield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people <w>succumb</w> to temptation when they are tired or stressed.",
                            "target_lang_translations": {
                                "tr": "Pek çok insan yorgun veya stresli olduğunda günaha <w>yenik düşer</w>."
                            }
                        },
                        {
                            "text": "The small business eventually had to <w>succumb</w> to the influence of global competition.",
                            "target_lang_translations": {
                                "tr": "Küçük işletme sonunda küresel rekabetin etkisine <w>yenik düşmek</w> zorunda kaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "submit"
                    ],
                    "common_phrases": [
                        "succumb to temptation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Güçlü bir arzu, dış etki veya kuvvet karşısında yenik düşmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yenik düşmek",
                                "target_lang_sense_clarification": "Bir duyguya veya dış etkiye karşı koyamayıp ona kapılmak."
                            },
                            {
                                "target_lang_word": "kapılmak",
                                "target_lang_sense_clarification": "Bir duyguya veya cazibeye karşı koyamayıp teslim olmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ed0c8f2-4799-31a7-918f-b1368ecebaea",
                    "sense_definition": "To die from a disease, injury, or other cause.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "die",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly patient unfortunately <w>succumbed</w> to pneumonia after a long battle.",
                            "target_lang_translations": {
                                "tr": "Yaşlı hasta, uzun bir mücadeleden sonra maalesef zatürreye <w>yenik düştü</w>."
                            }
                        },
                        {
                            "text": "He <w>succumbed</w> to his injuries shortly after arriving at the hospital.",
                            "target_lang_translations": {
                                "tr": "Hastaneye vardıktan kısa bir süre sonra yaralarına <w>yenik düştü</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "perish"
                    ],
                    "common_phrases": [
                        "succumb to illness",
                        "succumb to injuries"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir hastalık, yaralanma veya başka bir sebep yüzünden hayatını kaybetmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yenik düşmek",
                                "target_lang_sense_clarification": "Bir hastalık veya yaralanma sonucu ölmek."
                            },
                            {
                                "target_lang_word": "hayatını kaybetmek",
                                "target_lang_sense_clarification": "Bir hastalık veya kaza nedeniyle ölmek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}