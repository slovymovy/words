                    "frequency": "Low",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the hunt, they smoked the <w>venison</w> from a young springbok over an open fire.",
                            "target_lang_translations": {
                                "pl": "Po polowaniu uwędzili nad otwartym ogniem <w>mięso</w> z młodego springboka."
                            }
                        },
                        {
                            "text": "The local market sells various types of game, including antelope <w>venison</w>.",
                            "target_lang_translations": {
