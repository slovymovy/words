                "senses": [
                    {
                        "sense_id": "495ccf5a-70b4-3e76-aa59-048474be0a06",
                        "entry_id": "65deceb8-13ee-34ec-9d39-1ec349b756f7",
                        "glosses": [
                            "Ei eines Krokodils"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ccc7ff-fe56-4fc0-a54d-b6f234fd4e4f",
                                "sense_id": "495ccf5a-70b4-3e76-aa59-048474be0a06",
                                "text": "„Um Nahrung für seine Expedition zu beschaffen, ermordet er unbewaffnete Menschen auf dem Weg zum Markt. Er erschießt Kinder beim Versuch, an ihre Kanus zu kommen. Vielleicht war all das notwendig, um vorwärtszukommen. Aber war es denn notwendig, vorwärtszukommen? Alle hatten ihm davon abgeraten, diesen Weg zu wählen. Es war nur sein eigener Ehrgeiz, der von ihm verlangte, das Unmögliche zu tun. Wodurch wiederum Morde notwendig wurden – Morde für ein paar Krokodileier und einige Bananenbüschel.“"
                            },
                            {
                                "example_id": "d8e8569b-38b7-48e7-8d38-e6b7a2909887",
                                "sense_id": "495ccf5a-70b4-3e76-aa59-048474be0a06",
                                "text": "„Wie du dir vorstellen kannst, sind Dracheneier sehr viel größer als Krokodileier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
