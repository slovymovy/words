                                        "glosses": [
                                            "The act by which something is tempered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db7bd50-180c-44fc-821a-f4f9d9abcd11",
                                                "sense_id": "f341cb65-69ac-3351-967b-0e52df0f7405",
                                                "text": "Caron has, in fact, discovered this very curious circumstance, that a bar of steel becomes shorter under successive temperings, while it increases in size, laterally, in such a manner, that there actually is an increase of volume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b56d03d-76ef-35d8-8101-8f4c390318f1",
                                        "entry_id": "ef7e8dce-b1b8-3ba3-8059-5222a6b01032",
                                        "glosses": [
                                            "A non-plastic material, such as sand, added to clay to prevent shrinkage and cracking during drying or firing; temper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab5d1a3d-7257-43ec-a5c4-aaab2efec8d8",
                                                "sense_id": "1b56d03d-76ef-35d8-8101-8f4c390318f1",
                                                "text": "Clay and tempering were packed around the pole together with plenty of water[.]"
                                            }
                                        ]
                                    }
