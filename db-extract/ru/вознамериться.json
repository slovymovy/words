                "senses": [
                    {
                        "sense_id": "89d9058f-8049-370e-8b8b-320728da2865",
                        "entry_id": "a5f311c6-deb9-3183-bda1-e41c12f4741a",
                        "glosses": [
                            "to intend, to make up one's mind, to get it into one's head"
                        ],
                        "tags": [
                            "dated",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "8cbf27a1-093f-4313-b92d-9e074e8472c4",
                                "sense_id": "89d9058f-8049-370e-8b8b-320728da2865",
                                "text": "он вознаме́рился уе́хать",
                                "translation": "he got it into his head to leave",
                                "english": "he got it into his head to leave"
                            },
                            {
                                "example_id": "b44d2283-f795-4a63-b2c3-78670afbbb6e",
                                "sense_id": "89d9058f-8049-370e-8b8b-320728da2865",
                                "text": "они́ вознаме́рились всех осчастли́вить",
                                "translation": "they conceived of the idea of making everyone happy",
                                "english": "they conceived of the idea of making everyone happy"
                            },
                            {
                                "example_id": "4032c5ab-b12b-4472-9f5f-287777db9e26",
                                "sense_id": "89d9058f-8049-370e-8b8b-320728da2865",
                                "text": "Ко́нчив гимна́зию, я то́тчас же вознаме́рился не то́лько порва́ть со все́ми радика́льно, но е́сли на́до, то со всем да́же ми́ром, несмотря́ на то что мне был тогда́ всего́ то́лько двадца́тый год.",
                                "translation": "When I left school I intended at once not only to cut myself off from my family completely, but from all the world if necessary, though I was only nineteen at the time.",
                                "english": "When I left school I intended at once not only to cut myself off from my family completely, but from all the world if necessary, though I was only nineteen at the time."
                            }
                        ]
                    }
                ],
