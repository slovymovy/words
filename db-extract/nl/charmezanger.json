                        "examples": [
                            {
                                "example_id": "5312baba-4ecd-455e-8591-122224db0f63",
                                "sense_id": "9c0302ca-6f6f-3779-88a5-af9b160526ab",
                                "text": "In het Vlaamse Zelzate is charmezanger Eddy Wally begraven. Hij overleed vorige week op 83-jarige leeftijd."
                            },
                            {
                                "example_id": "dc5a09b6-852c-48b1-9bee-49c6a63edb04",
                                "sense_id": "9c0302ca-6f6f-3779-88a5-af9b160526ab",
                                "text": "De directeur van het verzorgingstehuis liet vorig jaar weten dat de ouderenzorg een serieuze taak is. En dat gold ook voor Berlusconi. \"Voor zingen, grappen of campagnevoeren is geen tijd\", zei hij toen. Dat zou niet helemaal gelukt zijn. Het gerucht gaat dat de voormalig premier in het tehuis zijn oude beroep als charmezanger weer heeft opgepakt."
                            }
                        ]
                    }
