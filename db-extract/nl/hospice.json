        "nl-extract.jsonl": [
            {
                "entry_id": "4ea0026f-4138-3b9b-aaa8-295e8b4a6aac",
                "word": "hospice",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a825c7c9-06c4-46ef-8d99-55991eea8a9b",
                        "entry_id": "4ea0026f-4138-3b9b-aaa8-295e8b4a6aac",
                        "tags": [
                            "plural"
                        ],
                        "form": "hospices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "876645c2-effe-3ea5-9304-521563839a47",
                        "entry_id": "4ea0026f-4138-3b9b-aaa8-295e8b4a6aac",
                        "glosses": [
                            "instelling met een huiselijke sfeer die zich in terminale zorg heeft gespecialiseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9793d40-1f70-435f-a367-9102e2a12a2e",
                                "sense_id": "876645c2-effe-3ea5-9304-521563839a47",
                                "text": "Ed heeft meer dan driehonderd persoonlijke bezittingen gedoneerd voor een veiling ten behoeve van St. Elizabeth Hospice, dat hulp biedt aan jonge mensen met een terminale of progressieve ziekte."
                            },
                            {
                                "example_id": "5366ea52-a473-477a-b254-744b0dba1676",
                                "sense_id": "876645c2-effe-3ea5-9304-521563839a47",
                                "text": "Jan heeft leiding gegeven aan de woningcorporatie vanuit de gedachte de mens centraal te stellen bij het zoeken naar optimale oplossingen voor woonvragen. Hij deed dat met een enorme betrokkenheid bij de totstandkoming van de hospice, de huisvesting van bijzondere woongroepen en recent de bouw van gasloze woningen in Het Opbroek”, aldus Hofland."
                            },
                            {
                                "example_id": "374baf32-ded3-4158-ad5a-6502b7043101",
                                "sense_id": "876645c2-effe-3ea5-9304-521563839a47",
                                "text": "Samen met z'n vrouw en neef Jan (eigenaar van het restaurant In de Tonne) koos hij drie plaatselijke goede doelen uit, waar hij anders ook wel eens geld aan geeft. Dat waren de Voedselbank Hellendoorn, hospice Noetsele en het Natuurhuus Krönnenzommer. „Mijn kinderen vonden eigenlijk dat ze ook wel een goed doel waren, maar ik heb anders beslist”, lacht Olthof. Aan deze lijst werd het nationale MS Fonds later nog toegevoegd, omdat een vriend van Henk uit Marle aan deze slepende ziekte lijdt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddefa0c2-d618-4375-8e83-c7cf15ae2926",
                        "source_entry_id": "4ea0026f-4138-3b9b-aaa8-295e8b4a6aac",
                        "source_sense_id": "876645c2-effe-3ea5-9304-521563839a47",
                        "target_lang_word": "hospice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "640c312d-f9f1-30bd-9973-54cc5ced6765",
                                        "entry_id": "4271c055-084b-3e11-ae47-d9c6f8972cec",
                                        "glosses": [
                                            "A lodging for pilgrims or the destitute, normally provided by a monastic order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f4d9396-bfbd-4f4d-9a04-b0af427851fd",
                                                "sense_id": "640c312d-f9f1-30bd-9973-54cc5ced6765",
                                                "text": "At the west end of the street is the ruined 13th-century hospice, known locally as Pilgrims' Rest. It was built by Bishop Beck for the use of travellers, and was used as place of rest by pilgrims on their way from Bardsey Island to St David's Cathedral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86e280b8-363e-3014-9af2-1c21884108fc",
                                        "entry_id": "4271c055-084b-3e11-ae47-d9c6f8972cec",
                                        "glosses": [
                                            "The provision of palliative care for terminally ill patients, either at a specialized facility or at a residence, and support for the family, typically refraining from taking extraordinary measures to prolong life."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b4875bd-99c7-43f2-8ec0-42d32ccaa15b",
                                                "sense_id": "86e280b8-363e-3014-9af2-1c21884108fc",
                                                "text": "The modern concept of hospice and palliative nursing has its roots in the hospice movement. Introduced to the United States in the early 1960s, hospice has grown from one organization in 1971 to more than 3500 organizations in 2001."
                                            },
                                            {
                                                "example_id": "8308e397-1ac7-4011-b26a-a0355d93d913",
                                                "sense_id": "86e280b8-363e-3014-9af2-1c21884108fc",
                                                "text": "Thus, the introduction of hospice services marked a new beginning, not only for the care of the dying, but also for the practice of medicine as a whole."
                                            },
                                            {
                                                "example_id": "22f8c69c-40ba-401c-91dc-c99837ff8f1f",
                                                "sense_id": "86e280b8-363e-3014-9af2-1c21884108fc",
                                                "text": "With the emergence of the modern hospice movement and its institutionalization in the 1970s, however, the religious dimension of hospice moved considerably away from its Christian roots. While it is widely agreed that hospice ought to be concerned with the spiritual needs of the dying, how to do this in a pluralistic society is far from clear."
                                            },
                                            {
                                                "example_id": "e139f374-b735-4224-a945-129e650cc203",
                                                "sense_id": "86e280b8-363e-3014-9af2-1c21884108fc",
                                                "text": "Former President Jimmy Carter, who at 98 is the longest living president in American history, has decided to forgo further medical treatment and will enter hospice care at his home in Georgia, the Carter Center announced on Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beddc8a1-df79-3055-ad00-4666ca090869",
                                        "entry_id": "4271c055-084b-3e11-ae47-d9c6f8972cec",
                                        "glosses": [
                                            "A specialized facility or organization offering palliative care for the terminally ill."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eb8b40e-f1db-4464-b723-331a3857200b",
                                                "sense_id": "beddc8a1-df79-3055-ad00-4666ca090869",
                                                "text": "Medicare reimbursement of hospice care is likely to be affected by the apparent reluctance of hospices to participate in the Medicare program."
                                            },
                                            {
                                                "example_id": "5d9fb072-cc36-4eba-9ae3-4e0873b07f3c",
                                                "sense_id": "beddc8a1-df79-3055-ad00-4666ca090869",
                                                "text": "A small number of hospices were opened in the US in the 1890s, but these institutions differed from the hospices that came into being in the second part of the twentieth century in the following ways."
                                            },
                                            {
                                                "example_id": "631b4b2b-f829-4dea-b304-36fcfbb772da",
                                                "sense_id": "beddc8a1-df79-3055-ad00-4666ca090869",
                                                "text": "St Joseph's Hospice Association in Liverpool supports hospices in Guatemala, Honduras, Ecuador and Peru, as well as having links with hospices in India, Pakistan and Mexico that bear the same name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
