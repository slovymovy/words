                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>dweilen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dweil</w> jij de vloer terwijl ik de ramen was?",
                            "target_lang_translations": {
                                "en": "Will you <w>mop</w> the floor while I wash the windows?"
                            }
                        },
                        {
                            "text": "Waarom <w>dweil</w> je de gang niet even?",
                            "target_lang_translations": {
                                "en": "Why don't you <w>mop</w> the hallway?"
                            }
                        }
                    ],
                    "traits": [
