                "translations": [
                    {
                        "translation_id": "db8fda68-39d0-42d3-a661-f90b6c61b0d2",
                        "source_entry_id": "9cfc3e3d-9213-39c3-8717-34de8860edd7",
                        "source_sense_description": "оградить себя от посягательства, нападения, оборониться",
                        "target_lang_word": "defend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38233483-ca1a-33de-a685-9bb701ae28eb",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To ward off attacks against; to fight to protect; to guard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aafc4c4a-9a49-44c9-8090-0a49e52d34a1",
                                                "sense_id": "38233483-ca1a-33de-a685-9bb701ae28eb",
                                                "text": "Most Zionists hoped for a state of their own, but early in the 20th century, writers like Hillel Solotaroff and Chaim Zhitlowsky, both Yiddish-speaking immigrant intellectuals in New York, imagined another alternative: a federation of self-governing anarchist communes in Palestine that would defend Jewish life without relying on state power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9017d989-9721-3267-8349-edbb4796c218",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To support by words or writing; to vindicate, talk in favour of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861c639f-425b-461a-9054-b45212800eff",
                                                "sense_id": "9017d989-9721-3267-8349-edbb4796c218",
                                                "text": "Justice Elena Kagan on Thursday defended the code of conduct the Supreme Court created last year, but conceded there needs to be a way to enforce the rules for it to be more effective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a912649-e850-3406-bab7-2979e4f8bc89",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To make legal defence of; to represent (the accused)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a24f7a37-4628-428b-9d24-ed2f7be9ac97",
                                                "sense_id": "9a912649-e850-3406-bab7-2979e4f8bc89",
                                                "text": "Philip Miles, defending, said: \"This was a single instance, there was no allegation of continuing behaviour over a long period of time.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3835f459-e2b4-3eb6-92d2-2fb5ec2bbc54",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To focus one's energies and talents on preventing opponents from scoring, as opposed to focusing on scoring."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9802ad0-3281-3d84-8ba9-efecb964b495",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "Mostly in tests. The action of not putting force into hitting a shot, but to conserve energy and wear down bowlers so they can attack later."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be1403e-2671-408f-ae72-dcbab4c0708f",
                                                "sense_id": "c9802ad0-3281-3d84-8ba9-efecb964b495",
                                                "text": "The teams strategy was to defend but score runs as well for the first 20 overs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb59db7f-d11f-336c-a4cc-a82d724c6244",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To attempt to retain a title, or attempt to reach the same stage in a competition as one did in the previous instance of that competition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e9a1e73-0f57-3250-9ba4-df16fa2732fa",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To call a raise from the big blind."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dff1d206-6ed7-38d5-9bdc-eaa9b645a46d",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To ward off, repel (an attack or attacker)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cf7a3e-1101-4e4b-8f51-ac2f7cc95a35",
                                                "sense_id": "dff1d206-6ed7-38d5-9bdc-eaa9b645a46d",
                                                "text": "The vertue is, that neither steele, nor stone\n The stroke thereof from entrance may defend[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1720a89e-b7a9-3926-a355-28cf86ea3546",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To prevent, to keep (from doing something)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "294ac0de-4590-31ce-b24d-0f939468903b",
                                        "entry_id": "c5321784-a84f-3351-89dc-a52fdc1f7939",
                                        "glosses": [
                                            "To prohibit, forbid."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fac0a33-6ee5-4b55-9829-e78dc9801606",
                                                "sense_id": "294ac0de-4590-31ce-b24d-0f939468903b",
                                                "text": "Broder said sir launcelot wete ye wel I am ful lothe to departe oute of this realme\n but the quene hath defended me soo hyhely\n that me semeth she wille neuer be my good lady as she hath ben",
                                                "translation": "“Brother”, said Sir Launcelot, “you know full well that I would be very reluctant to leave this kingdom,\n were it not that the queen had forbidden me so strongly to remain here,\n that it seems to me that she will never again be my lover as once she was”",
