                                            {
                                                "example_id": "05e049c9-fc62-46f7-b200-aecb0ddc0d78",
                                                "sense_id": "f149d0e9-92ff-3d55-9865-f7163eb2def1",
                                                "text": "Enfin, une hémiparésie s’est produite, avec une perte de la sensibilité et de l’équilibre, et des troubles sérieux de la marche."
                                            },
                                            {
                                                "example_id": "cd9f16c4-6a90-4489-bdc6-b4a8d1b349d9",
                                                "sense_id": "f149d0e9-92ff-3d55-9865-f7163eb2def1",
                                                "text": "Après un accident de la route, je souffre d’hémiparésie (Ndlr : un déficit partiel de la force musculaire, du côté gauche) et de spasticité (une raideur musculaire involontaire, le plus souvent retrouvée au niveau de certains muscles présentant un déficit moteur.)"
                                            }
                                        ]
                                    }
