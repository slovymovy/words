                        "target_lang_word": "groot",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a294ee92-2709-3d3d-a7ff-23869a0eb9e8",
                                        "entry_id": "7d2ea2d2-6064-379d-8675-66c8e6b4fd99",
                                        "glosses": [
                                            "meer dan normaal in formaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0503158-4f0d-4708-9eb1-09185400b3d2",
                                                "sense_id": "a294ee92-2709-3d3d-a7ff-23869a0eb9e8",
                                                "text": "Ik had een grote powerbank die mijn telefoon 12 keer kon opladen, dus besloot ik het vanaf toen alleen met digitale hulpmiddelen te doen."
                                            },
                                            {
                                                "example_id": "69c27c89-1ac5-4087-8e59-ad2ac38b9848",
                                                "sense_id": "a294ee92-2709-3d3d-a7ff-23869a0eb9e8",
                                                "text": "Het werd me al snel duidelijk dat ik de trail volledig had onderschat. De bergpaden waren steiler, de zon heter, de slangen groter en de afstanden tussen waterpunten langer dan ik me had voorgesteld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39c73295-dde2-38c9-a32f-f8d0c0cb41b6",
                                        "entry_id": "7d2ea2d2-6064-379d-8675-66c8e6b4fd99",
                                        "glosses": [
                                            "bewonderenswaardig, goed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71b992ba-8b2a-4c9a-8460-a1ef5e2596b4",
                                                "sense_id": "39c73295-dde2-38c9-a32f-f8d0c0cb41b6",
                                                "text": "Hij was een groot man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca523cc-101c-39be-afbc-c7537c2686a1",
                                        "entry_id": "7d2ea2d2-6064-379d-8675-66c8e6b4fd99",
                                        "glosses": [
                                            "machtig, belangrijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3135b146-f69f-4467-bf1b-11b19a40ec9b",
                                                "sense_id": "fca523cc-101c-39be-afbc-c7537c2686a1",
                                                "text": "Mijn vrouw houdt niet van vliegen waardoor zij dertig jaar geleden de bewuste keuze heeft gemaakt dat nooit meer te doen. Ze was dan ook allang blij dat ze niet met mij mee hoefde op mijn verre reizen, maar was wel vanaf het begin mijn grootste supporter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da7482db-49bc-3580-b915-ac0253f27ad6",
                                        "entry_id": "7d2ea2d2-6064-379d-8675-66c8e6b4fd99",
                                        "glosses": [
                                            "volwassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dcbd976-fb65-4930-8b50-b3eb60fcf572",
                                                "sense_id": "da7482db-49bc-3580-b915-ac0253f27ad6",
                                                "text": "Grote mensen en kinderen."
                                            },
                                            {
                                                "example_id": "e8bef168-cb95-4837-8fb2-70a5a4a68db4",
                                                "sense_id": "da7482db-49bc-3580-b915-ac0253f27ad6",
                                                "text": "Ook boer Henk Koster kwam afscheid nemen. \"Ik heb de hele ontwikkeling meegemaakt, vanaf het begin. Lenie 't Hart kwam vroeger bij ons spullen lenen om zeehondenpups groot te krijgen. Wat hier is opgebouwd, is een succes voor Pieterburen én voor de zeehonden. Voor de levendigheid in het dorp was het beter geweest als het hier was gebleven\", zei hij."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "groot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "10e30930-8c83-3375-9eb5-98d1a348016a",
                                        "entry_id": "e4ae5473-97b9-3789-9014-f01ede639b32",
                                        "glosses": [
                                            "in ruime mate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa28f7f0-0fad-4883-88cb-966d5be5cb14",
                                                "sense_id": "10e30930-8c83-3375-9eb5-98d1a348016a",
                                                "text": "De fles was gelukkig groot genoeg en uiteindelijk kon ik met een zucht van verlichting de dop erop draaien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c1cf6b9-f098-3ffe-8136-b01c48e49d83",
                                        "entry_id": "e4ae5473-97b9-3789-9014-f01ede639b32",
                                        "glosses": [
                                            "bijwoordelijk deel van een scheidbaar werkwoord"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d540ea4-f840-4532-9892-27a82129b4d7",
                                                "sense_id": "7c1cf6b9-f098-3ffe-8136-b01c48e49d83",
                                                "text": "groothouden: Hij hield zich groot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "groot",
                                "target_lang_code": "nl",
                                "target_senses": [
