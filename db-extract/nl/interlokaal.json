                        "examples": [
                            {
                                "example_id": "0a620c85-f136-4c5e-88a2-bff435caed17",
                                "sense_id": "10fe3974-4858-3101-afe8-7731e66e85e5",
                                "text": "Chavannes' visie op de talentoekomst is blijkbaar dat iedereen in Europa, de Nederlanders voorop, “perfect tweetalig” zou moeten worden: allemaal Engels, en ieder zijn streektaal. Ik geloof daar om een aantal redenen niet zo in. Het Engels zal zeker belangrijker worden in het interlokale Europese verkeer, maar echt tweetalig zie ik het overgrote deel van het continent niet worden."
                            }
