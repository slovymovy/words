                    {
                        "translation_id": "b6c079f1-27ee-4e7f-a584-b67743941d1e",
                        "source_entry_id": "19ef9eca-4f6f-35a9-8fac-38121c41c840",
                        "source_sense_id": "d1d42929-d880-397b-a6f9-85ab46e09b11",
                        "source_sense_description": "zelfregulering, chemisch en fysiologisch evenwicht",
                        "target_lang_word": "homeostasis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homeostasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                                        "entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                                        "glosses": [
                                            "The ability of a system or living organism to adjust its internal environment to maintain a state of dynamic constancy; such as the ability of warm-blooded animals to maintain a stable temperature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a87313a-6f70-43a2-9b00-42be9dbdd88a",
                                                "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                                                "text": "His most important work concentrated on the complexities of chemical neurotransmission (for which Otto Loewi received a Nobel Prize in 1936) and on “homeostasis” (a term coined by Cannon in 1926), the maintenance of steady states in the body and the physiological processes through which they are regulated."
                                            },
                                            {
                                                "example_id": "27af30af-a9f1-4080-a108-a9e18267b4f4",
                                                "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                                                "text": "When homeostasis is disrupted by an external stressor - such as injury, lack of nutrients, or invasion by parasites or other organisms - illness may occur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c2918ed-f235-3a00-94aa-caee3a42a92c",
                                        "entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                                        "glosses": [
                                            "Such a dynamic equilibrium or balance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb8a3a27-8cc8-4e75-a894-5203d994d242",
                        "source_entry_id": "19ef9eca-4f6f-35a9-8fac-38121c41c840",
                        "source_sense_id": "d1d42929-d880-397b-a6f9-85ab46e09b11",
                        "source_sense_description": "zelfregulering, chemisch en fysiologisch evenwicht",
                        "target_lang_word": "Homöostase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homöostase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6199dc-573f-321b-b1c6-f182392d4e4c",
                                        "entry_id": "26e16073-b199-3984-bc44-971962628e2a",
                                        "glosses": [
                                            "der Vorgang eines Systems, sich durch Rückkopplung selbst innerhalb gewisser Grenzen in einem stabilen Zustand zu halten; ein sich selbst aufrecht erhaltendes Gleichgewicht"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2702aa50-9bb2-4d08-9173-b757f9b06772",
                                                "sense_id": "7a6199dc-573f-321b-b1c6-f182392d4e4c",
                                                "text": "„Lebendige Systeme wie die Familie haben zwei sich widersprechende Tendenzen, einmal die zur Homöostase, zum Gleichgewicht, zum andern die zur Veränderung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e0fdc1-8078-4ac2-8f3c-f2c467c2d40f",
                        "source_entry_id": "19ef9eca-4f6f-35a9-8fac-38121c41c840",
