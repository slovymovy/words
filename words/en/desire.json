        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0dac1ad9-d58e-3bf9-bbcc-35e4cfa4c8b6",
                    "sense_definition": "To want or wish for something earnestly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wanting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>desire</w> to speak with you about the upcoming project.",
                            "target_lang_translations": {
                                "ru": "Я <w>желаю</w> поговорить с вами о предстоящем проекте.",
                                "tr": "Gelecek proje hakkında sizinle konuşmak <w>istiyorum</w>.",
                                "de": "Ich <w>wünsche</w>, mit Ihnen über das kommende Projekt zu sprechen."
                            }
                        },
                        {
                            "text": "Many people <w>desire</w> success but few are willing to work for it.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>желают</w> успеха, но немногие готовы ради него работать.",
                                "tr": "Birçok insan başarıyı <w>arzular</w>, ancak çok azı bunun için çalışmaya isteklidir.",
                                "de": "Viele Menschen <w>begehren</w> Erfolg, aber nur wenige sind bereit, dafür zu arbeiten."
                            }
                        }
                    ],
                    "synonyms": [
                        "want",
                        "wish",
                        "hope"
                    ],
                    "common_phrases": [
                        "desire to speak"
                    ],
                    "target_lang_definitions": {
