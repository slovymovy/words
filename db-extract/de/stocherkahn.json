                                                "example_id": "33ba3f91-6c63-4f7f-80fd-6b7f413110b1",
                                                "sense_id": "ec65486e-15a5-34bb-ae83-b29b8f602a82",
                                                "text": "Anyone up for a punt on Randwick?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46fae6c9-8f60-3619-8115-55662a9f2399",
                                        "entry_id": "91b07459-ad10-3d80-b966-ab1bfd869abe",
                                        "glosses": [
                                            "Gambling, as a pastime, especially betting on horseraces or the dogs."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c400c84c-0e39-4113-8cb3-d7567d5ef9a0",
                                                "sense_id": "46fae6c9-8f60-3619-8115-55662a9f2399",
                                                "text": "Did I actually back a winner and finish in front on the punt?"
                                            },
                                            {
                                                "example_id": "191d4d06-8421-4af9-ba8e-fc17851ead2e",
                                                "sense_id": "46fae6c9-8f60-3619-8115-55662a9f2399",
                                                "text": "Wishing you all happy new year and a prosperous one on the punt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45166285-b459-348b-8d75-0458fbb7a1b3",
                                        "entry_id": "91b07459-ad10-3d80-b966-ab1bfd869abe",
                                        "glosses": [
                                            "A highly speculative investment or other commitment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467c7831-e614-4643-bc01-43c117e7547d",
                                                "sense_id": "45166285-b459-348b-8d75-0458fbb7a1b3",
                                                "text": "“Months ago, copper traders worldwide took a punt that Trump's tariff pitch for their market was real, not bluster.[…]”"
                                            }
                                        ]
