    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "980cb356-fbae-39b8-adb9-05ae6c8c16b2",
                    "sense_definition": "knik of klein terras op een helling",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Langs het pad lag een steile <w>graft</w> vol gras en wilde bloemen.",
                            "target_lang_translations": {
                                "en": "Along the path lay a steep <w>grassy bank</w> full of grass and wildflowers."
                            }
                        },
                        {
                            "text": "Boeren onderhouden de <w>graft</w> om erosie op de helling te beperken.",
                            "target_lang_translations": {
                                "en": "Farmers maintain the <w>hillside terrace</w> to limit erosion on the slope."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steile graft",
                        "gras op de graft"
                    ],
                    "target_lang_definitions": {
                        "en": "a bend or small terrace on a slope"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hillside terrace",
                                "target_lang_sense_clarification": "a small terrace or raised edge on a hillside"
                            },
                            {
                                "target_lang_word": "grassy bank",
                                "target_lang_sense_clarification": "a grassy slope-edge or embankment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3744ebc-3b45-3fc7-9193-95085205badf",
                    "sense_definition": "verouderde vorm van <w>gracht</w> in de betekenis kanaal of watergang",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de oude kaart staat een brede <w>graft</w> rond het dorp.",
                            "target_lang_translations": {
                                "en": "On the old map, a wide <w>canal</w> is shown around the village."
                            }
                        },
                        {
                            "text": "In de kroniek werd de <w>graft</w> langs de stad als bescherming genoemd.",
                            "target_lang_translations": {
                                "en": "In the chronicle, the <w>moat</w> along the city was mentioned as protection."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brede graft",
                        "graft langs de stad"
                    ],
