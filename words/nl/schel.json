{
    "word_family": [
        "schellen",
        "belschel",
        "deurbel",
        "scheltoon",
        "schelheid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10b90b78-2f68-3ba7-9f87-3c7cc05d4cfd",
                    "sense_definition": "Een instrument dat een helder geluid maakt, vaak gebruikt als deurbel.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluidsinstrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde de <w>schel</w> gaan en liep direct naar de voordeur.",
                            "target_lang_translations": {
                                "en": "I heard the <w>bell</w> go and walked straight to the front door.",
                                "ru": "Я услышал, как зазвонил <w>звонок</w>, и сразу пошел к входной двери."
                            }
                        },
                        {
                            "text": "De oude <w>schel</w> aan de muur rinkelde luid toen de klant binnenkwam.",
                            "target_lang_translations": {
                                "en": "The old <w>bell</w> on the wall rang loudly when the customer entered.",
                                "ru": "Старый <w>колокольчик</w> на стене громко зазвенел, когда вошел клиент."
                            }
                        }
                    ],
                    "synonyms": [
                        "bel",
                        "deurbel"
                    ],
                    "common_phrases": [
                        "de schel gaat",
                        "aan de schel trekken"
                    ],
                    "target_lang_definitions": {
                        "en": "An instrument that makes a clear sound, often used as a doorbell.",
                        "ru": "Инструмент, издающий чистый звук, часто используемый в качестве дверного звонка."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bell",
                                "target_lang_sense_clarification": "a general ringing instrument"
                            },
                            {
                                "target_lang_word": "doorbell",
                                "target_lang_sense_clarification": "specifically for a door"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "звонок",
                                "target_lang_sense_clarification": "дверной или электрический"
                            },
                            {
                                "target_lang_word": "колокольчик",
                                "target_lang_sense_clarification": "небольшой ручной или настенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab35ddec-5181-3780-bf23-d305fd796796",
                    "sense_definition": "Een kleine bel die een hoge, doordringende toon voortbrengt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geluidsinstrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het zilveren <w>schelletje</w> op tafel werd gebruikt om het personeel te roepen.",
                            "target_lang_translations": {
                                "en": "The silver <w>little bell</w> on the table was used to call the staff.",
                                "ru": "Серебряный <w>колокольчик</w> на столе использовался для вызова персонала."
                            }
                        },
                        {
                            "text": "Met een kleine <w>schel</w> gaf de voorzitter aan dat de vergadering begon.",
                            "target_lang_translations": {
                                "en": "With a small <w>bell</w>, the chairman indicated that the meeting was starting.",
                                "ru": "Маленьким <w>колокольчиком</w> председатель дал знак о начале собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "belletje"
                    ],
                    "common_phrases": [
                        "een kleine schel"
                    ],
                    "target_lang_definitions": {
                        "en": "A small bell that produces a high, piercing tone.",
                        "ru": "Маленький колокольчик, издающий высокий, пронзительный тон."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "handbell",
                                "target_lang_sense_clarification": "a small bell held in the hand"
                            },
                            {
                                "target_lang_word": "little bell",
                                "target_lang_sense_clarification": "a small ringing device"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "колокольчик",
                                "target_lang_sense_clarification": "маленький ручной"
                            },
                            {
                                "target_lang_word": "бубенчик",
                                "target_lang_sense_clarification": "маленький звенящий предмет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7ddc7499-4e1c-396a-ad38-1910bc641381",
                    "sense_definition": "Hoog, scherp en doordringend van geluid op een onaangename manier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluidskwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De baby liet een <w>schel</w> geluid horen toen hij wakker werd.",
                            "target_lang_translations": {
                                "en": "The baby made a <w>shrill</w> sound when he woke up.",
                                "ru": "Проснувшись, ребенок издал <w>пронзительный</w> звук."
                            }
                        },
                        {
                            "text": "Zijn stem klonk ongewoon <w>schel</w> door de luidsprekers van de zaal.",
                            "target_lang_translations": {
                                "en": "His voice sounded unusually <w>harsh</w> through the hall's speakers.",
                                "ru": "Его голос звучал необычно <w>резко</w> через динамики в зале."
                            }
                        }
                    ],
                    "synonyms": [
                        "schril",
                        "snerpend",
                        "doordringend"
                    ],
                    "antonyms": [
                        "dof",
                        "zacht"
                    ],
                    "common_phrases": [
                        "schel geluid",
                        "schelle stem"
                    ],
                    "target_lang_definitions": {
                        "en": "High, sharp, and piercing sound in an unpleasant way.",
                        "ru": "Высокий, резкий и пронзительный звук, часто неприятный для слуха."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrill",
                                "target_lang_sense_clarification": "high-pitched and piercing"
                            },
                            {
                                "target_lang_word": "harsh",
                                "target_lang_sense_clarification": "unpleasantly rough sound"
                            },
                            {
                                "target_lang_word": "piercing",
                                "target_lang_sense_clarification": "loud and sharp sound"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пронзительный",
                                "target_lang_sense_clarification": "о звуке или голосе"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "неприятно высокий"
                            },
                            {
                                "target_lang_word": "визгливый",
                                "target_lang_sense_clarification": "очень высокий и неприятный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee7d75b-6c9e-32f9-b900-5ff49585007e",
                    "sense_definition": "Zeer fel of intens, vaak met betrekking tot licht of kleuren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visuele_intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>schelle</w> licht van de tl-buizen deed pijn aan mijn ogen.",
                            "target_lang_translations": {
                                "en": "The <w>glaring</w> light from the fluorescent tubes hurt my eyes.",
                                "ru": "<w>Резкий</w> свет люминесцентных ламп резал мне глаза."
                            }
                        },
                        {
                            "text": "Zij droeg een jurk in een <w>schelle</w> kleur die van verre opviel.",
                            "target_lang_translations": {
                                "en": "She wore a dress in a <w>garish</w> color that stood out from afar.",
                                "ru": "На ней было платье <w>кричащего</w> цвета, которое было заметно издалека."
                            }
                        }
                    ],
                    "synonyms": [
                        "fel",
                        "scherp",
                        "intens"
                    ],
                    "antonyms": [
                        "mat",
                        "zacht",
                        "gedempt"
                    ],
                    "common_phrases": [
                        "schel licht",
                        "schelle kleuren"
                    ],
                    "target_lang_definitions": {
                        "en": "Very bright or intense, often regarding light or colors.",
                        "ru": "Очень яркий или интенсивный, часто по отношению к свету или цветам."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glaring",
                                "target_lang_sense_clarification": "unpleasantly bright light"
                            },
                            {
                                "target_lang_word": "garish",
                                "target_lang_sense_clarification": "excessively bright colors"
                            },
                            {
                                "target_lang_word": "harsh",
                                "target_lang_sense_clarification": "intense and unpleasant light"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о свете или цвете"
                            },
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "о слишком ярком цвете"
                            },
                            {
                                "target_lang_word": "ослепительный",
                                "target_lang_sense_clarification": "очень яркий свет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af5bccf2-6638-3ac7-92e3-be764f516c80",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>schellen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schel</w> al drie minuten bij de buren, maar er doet niemand open.",
                            "target_lang_translations": {
                                "en": "I have been <w>ringing</w> the neighbors' bell for three minutes, but no one is answering.",
                                "ru": "Я уже три минуты <w>звоню</w> соседям, но никто не открывает."
                            }
                        },
                        {
                            "text": "Als ik bij je aankom, <w>schel</w> ik wel even.",
                            "target_lang_translations": {
                                "en": "When I arrive at your place, I'll <w>ring</w> the bell.",
                                "ru": "Когда я приду к тебе, я <w>позвоню</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'to ring' (a bell).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола 'звонить' (в звонок)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "to press a doorbell or ring a bell"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "звоню",
                                "target_lang_sense_clarification": "в дверь или в колокольчик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a41e8a4-eec8-36a3-a622-e69fad6986d7",
                    "sense_definition": "Gebiedende wijs van <w>schellen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schel</w> nog een keer hard als ze de eerste keer niet opendoen.",
                            "target_lang_translations": {
                                "en": "<w>Ring</w> loudly once more if they don't open the first time.",
                                "ru": "<w>Позвони</w> еще раз посильнее, если они не откроют с первого раза."
                            }
                        },
                        {
                            "text": "<w>Schel</w> niet zo ongeduldig bij de buren!",
                            "target_lang_translations": {
                                "en": "Don't <w>ring</w> the neighbors' bell so impatiently!",
                                "ru": "Не <w>звони</w> соседям так нетерпеливо!"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'to ring' (a bell).",
                        "ru": "Повелительное наклонение глагола 'звонить' (в звонок)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "command to ring a bell"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "звони",
                                "target_lang_sense_clarification": "приказ позвонить в дверь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}