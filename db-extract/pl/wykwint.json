                        ],
                        "form": "wykwinty"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5a927d0-321d-3acc-89c1-4484f9d901f1",
                        "entry_id": "65a2e6d6-c833-3ff3-8a56-e7073b4383e1",
                        "glosses": [
                            "wytworność, komfort połączony z elegancją"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db4477f-06e5-495a-b071-af3156ef5f2e",
                                "sense_id": "e5a927d0-321d-3acc-89c1-4484f9d901f1",
                                "text": "Lśniąco biała jedwabna pościel dawała wrażenie świeżości i wykwintu, aż Hugo westchnął z zazdrością"
                            },
                            {
                                "example_id": "b4948c5c-b503-4521-89e5-c60f6435009c",
                                "sense_id": "e5a927d0-321d-3acc-89c1-4484f9d901f1",
                                "text": "Nędza i wykwint życia[,] mieszają się ze sobą[ ]; żebrak ociera się o bankiera, szynk graniczy z salonem"
                            },
                            {
                                "example_id": "49011aff-b751-4dae-abca-6847971365a8",
                                "sense_id": "e5a927d0-321d-3acc-89c1-4484f9d901f1",
                                "text": "Z wielkim wykwintem urządzony był ogród, pełen sadzawek, wodotrysków zrujnowanych, szpalerów, balustrad, grot, posągów szkaradnych, ale z[ ]dala robiących efekt bardzo malowniczy"
                            },
                            {
                                "example_id": "f8c68ad0-92f3-49b4-a32e-2c6de7e06c1a",
                                "sense_id": "e5a927d0-321d-3acc-89c1-4484f9d901f1",
                                "text": "Że stołowników wiele, jadła będzie dostatkiem[ ]: ale co dóm ma, tym się raczą wszyscy kontentować, a że wykwintów nie znajdą, z tego się[,] ile łaskawi, nie zgorszą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ff680862-bee0-3616-ba3e-6aa77bdcef10",
                        "entry_id": "65a2e6d6-c833-3ff3-8a56-e7073b4383e1",
                        "glosses": [
                            "zbytnia wymyślność"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "18bbea42-0d35-4bf6-818b-606cc0a0a1ad",
                                "sense_id": "ff680862-bee0-3616-ba3e-6aa77bdcef10",
                                "text": "Nie wystarczy życie(sic!) [życia] wytwornej pannie na wypełnienie wszystkich grymasów, wykwintów[,] i korowodów"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
