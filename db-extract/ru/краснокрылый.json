                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc455522-1ee5-46bd-9a7d-e6f585525cb7",
                                "sense_id": "c5d68c93-0b00-39c3-83a1-e958fab3895c",
                                "text": "За бродом через светлую, шумливую Тете, заваленную крупными камнями, тропа постепенно поднимается вдоль правого берега реки, но долина еще сохраняет степной характер; та же короткая сухая трава, та же крупная краснокрылая саранча, которая с сильным треском высоко перелетает с места на место."
                            }
                        ]
                    }
