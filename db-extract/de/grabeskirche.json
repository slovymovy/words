                ],
                "senses": [
                    {
                        "sense_id": "22537475-14e7-39b6-9253-77dd2d852473",
                        "entry_id": "2bea907a-7113-33cb-9131-6bbf8ee89e30",
                        "glosses": [
                            "Kirche, die mit einem Grab (meist eines Heiligen) in Verbindung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4a6a5d3-289a-4854-8584-fd51fbdf3e6e",
                                "sense_id": "22537475-14e7-39b6-9253-77dd2d852473",
                                "text": "Der Petersdom ist die Grabeskirche des heiligen Apostelfürsten Petrus."
                            },
                            {
                                "example_id": "68e406b4-07fb-4a64-8190-0bdceea184fb",
                                "sense_id": "22537475-14e7-39b6-9253-77dd2d852473",
                                "text": "„So werden z.B. mit so genannten ‚Urnenkirchen‘ oder ‚Grabeskirchen‘ einzelne Kirchen, die nicht mehr als Gottesdienstorte aufrecht erhalten werden können, alternativ zur Urnenbeisetzung genutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c2196578-9bd2-327d-90e5-d5d8ffba70bb",
                        "entry_id": "2bea907a-7113-33cb-9131-6bbf8ee89e30",
                        "glosses": [
                            "die Kirche vom Grab Jesu mit dem Felsen Golgotha in Jerusalem"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "91078cdc-8d8b-4e06-8fe5-f339f2803a16",
                                "sense_id": "c2196578-9bd2-327d-90e5-d5d8ffba70bb",
                                "text": "„Hier in der Nähe der Grabeskirche werden die angebotenen Devotionalien edler und, wie ich bald erfuhr, die Angelkünste der Pilgerfischer subtiler.“"
                            },
                            {
                                "example_id": "fd291e73-2a16-4b4e-89c6-47630ce54cf2",
                                "sense_id": "c2196578-9bd2-327d-90e5-d5d8ffba70bb",
                                "text": "„Das Fest der Kreuzerhöhung erinnert an das Auffinden des Kreuzes Christi am 13. September 326 und dessen feierliche Präsentation in der Grabeskirche am darauffolgenden Tag.“"
                            },
                            {
                                "example_id": "54715103-1f8e-4c51-8b61-d30ea431c996",
                                "sense_id": "c2196578-9bd2-327d-90e5-d5d8ffba70bb",
                                "text": "„Und dann ging er zurück in die Grabeskirche und tat dasselbe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65868641-621c-4574-87ec-6259dc5984dc",
                        "source_entry_id": "2bea907a-7113-33cb-9131-6bbf8ee89e30",
                        "source_sense_id": "22537475-14e7-39b6-9253-77dd2d852473",
                        "source_sense_description": "Christentum: Kirche, die mit einem Grab (meist eines Heiligen) in Verbindung steht",
                        "target_lang_word": "Church",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
