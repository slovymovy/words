                "senses": [
                    {
                        "sense_id": "02fe5d5a-ca12-3960-85d0-999fd654d40f",
                        "entry_id": "2d80b37b-437e-31c8-86ea-b0357100338b",
                        "glosses": [
                            "Rigoler."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b07b1711-7e9d-4492-b37c-2f3f5dfb7231",
                                "sense_id": "02fe5d5a-ca12-3960-85d0-999fd654d40f",
                                "text": "J’irai loler sur vos tombes."
                            },
                            {
                                "example_id": "4b6937d4-8c8c-49e8-a4ca-32425c6e2661",
                                "sense_id": "02fe5d5a-ca12-3960-85d0-999fd654d40f",
                                "text": "y faut loler un peu !!!"
                            },
                            {
                                "example_id": "7fb3736d-a6cd-40b5-8130-bd9752aa7664",
                                "sense_id": "02fe5d5a-ca12-3960-85d0-999fd654d40f",
                                "text": "postez après vos biographies pour qu’on puisse loler ensemble"
                            },
                            {
                                "example_id": "73dee0fa-463e-4db8-aec9-ab7243be2b9c",
                                "sense_id": "02fe5d5a-ca12-3960-85d0-999fd654d40f",
                                "text": "(Pour les gens inscrit sur facebook, allez vite rejoindre le groupe “on va loler (groupe officiel)”."
                            },
                            {
                                "example_id": "78a357fc-ae0c-4aaf-9e4b-e4c72221c560",
                                "sense_id": "02fe5d5a-ca12-3960-85d0-999fd654d40f",
                                "text": "Puis-je Loler de Nathalie Kosciusko-Morizet, génie du sarkozysme méprisant la France d’en bas....."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9028996-af87-3ee4-aafd-3bf104a16381",
                        "entry_id": "2d80b37b-437e-31c8-86ea-b0357100338b",
                        "glosses": [
                            "Agir avec lenteur, nonchalance."
                        ],
                        "tags": [
                            "Guadeloupe"
                        ],
                        "examples": [
                            {
                                "example_id": "9ca3560f-827f-4a4e-8bbf-c89306bc654a",
                                "sense_id": "a9028996-af87-3ee4-aafd-3bf104a16381",
                                "text": "Arrête de loler là ! (ou en créole guadeloupéen : las lolé la !"
                            }
                        ]
                    }
