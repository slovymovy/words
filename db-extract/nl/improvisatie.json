                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9fe7f09-a157-3f3d-8acc-57f89d18f421",
                                        "entry_id": "0fa28213-92d4-363e-9a72-b35feef9197a",
                                        "glosses": [
                                            "die Kunst, unvorbereitet, unmittelbar und spontan etwas darzubieten oder herzustellen, meist im Theater, in der Musik, oder beim Tanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aed8d5f-c7d5-4349-8b91-bfcedb398ffb",
                                                "sense_id": "d9fe7f09-a157-3f3d-8acc-57f89d18f421",
                                                "text": "Im Jazz werden sehr oft Improvisationen gespielt."
                                            },
                                            {
                                                "example_id": "b11fd8f7-c1fe-4b35-94cd-60c317a809d1",
                                                "sense_id": "d9fe7f09-a157-3f3d-8acc-57f89d18f421",
                                                "text": "„Heute kann ich mich nicht zurücklehnen und den tonreichen Improvisationen unseres besten Saxophonisten lauschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "331029a8-7c09-4018-9341-ebfcb90b8b6d",
                        "source_entry_id": "3cd76742-efe9-3747-b91e-bbac58268c2c",
