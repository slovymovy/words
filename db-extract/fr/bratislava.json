                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c1a4b254-e7fe-353b-b9aa-896fdb077fb4",
                        "entry_id": "595def83-8108-31d8-8c95-3a95fcc5c9aa",
                        "glosses": [
                            "Le gouvernement slovaque."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "422e731c-8d75-4572-ba55-b41423965d73",
                                "sense_id": "c1a4b254-e7fe-353b-b9aa-896fdb077fb4",
                                "text": "Bratislava livrera treize chasseurs MiG-29 de conception soviétique à l'Ukraine, a déclaré vendredi le premier ministre, la Slovaquie devenant ainsi le deuxième pays de l'OTAN après la Pologne à prendre une telle décision, Moscou indiquant, quant à elle, que ces appareils seront «détruits»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13a23c42-be69-42bc-9c6c-3f9530a29c50",
                        "source_entry_id": "595def83-8108-31d8-8c95-3a95fcc5c9aa",
                        "target_lang_word": "Bratislava",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bratislava",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03d714e9-206a-3e03-a775-73f6a1f84349",
                                        "entry_id": "6fa70c84-f575-3f0a-a2c6-c8386df90086",
                                        "glosses": [
                                            "Hauptstadt der Slowakei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f278887b-5e2d-449c-a038-3c2e08ad7df0",
                                                "sense_id": "03d714e9-206a-3e03-a775-73f6a1f84349",
                                                "text": "Bratislava ist die Hauptstadt der Slowakei."
                                            },
                                            {
                                                "example_id": "469b08dc-9e6f-4d03-8a86-518aefbb71f7",
                                                "sense_id": "03d714e9-206a-3e03-a775-73f6a1f84349",
                                                "text": "Im Palais Grassalkovich in Bratislava befindet sich der Sitz des Präsidenten der Slowakei."
                                            },
                                            {
                                                "example_id": "e25f570f-b1b7-42f6-bc07-606747291198",
                                                "sense_id": "03d714e9-206a-3e03-a775-73f6a1f84349",
                                                "text": "„Kurze Zeit später fand ich mich im Zentrum von Bratislava wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91d940dc-fa5f-45e3-abf5-1e458340ba2e",
                        "source_entry_id": "595def83-8108-31d8-8c95-3a95fcc5c9aa",
                        "target_lang_word": "Pressburg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pressburg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82e45c2e-478f-3ee1-b29e-f938f16dcb17",
                                        "entry_id": "863cbb2b-4bcb-3221-abd8-5b173ee5d708",
                                        "glosses": [
                                            "Hauptstadt der Slowakei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4a0fb72-a78b-4c43-a77d-ea2f78a567a8",
                                                "sense_id": "82e45c2e-478f-3ee1-b29e-f938f16dcb17",
                                                "text": "Wien ist etwa 60 km von Pressburg entfernt."
                                            },
                                            {
                                                "example_id": "baeff010-5114-4d29-b5f7-a80e20e4ac6b",
                                                "sense_id": "82e45c2e-478f-3ee1-b29e-f938f16dcb17",
                                                "text": "In Pressburg schlossen 1805 Österreich und Frankreich Frieden."
                                            },
                                            {
                                                "example_id": "6516e816-6625-4731-88f6-413cb6165fd4",
                                                "sense_id": "82e45c2e-478f-3ee1-b29e-f938f16dcb17",
                                                "text": "„Er schreibt für Zeitungen in Pressburg und Olmütz, wird Sekretär der Liga für Menschenrechte in Brünn, findet seine erste große Liebe, wird ohne Mühe wegen seines eher zufälligen Geburtsorts Deutsch-Diosek bei Pressburg tschechoslowakischer Staatsbürger, holt seine Eltern und vier Geschwister zu sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
