                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "afea1532-a441-3927-85f3-a0c029628661",
                                        "entry_id": "ee3fb981-2d49-3707-b831-8fcb4b9dcf41",
                                        "glosses": [
                                            "de plaats van de geboorte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b898b5e5-473e-4b46-832e-64814df640df",
                                                "sense_id": "afea1532-a441-3927-85f3-a0c029628661",
                                                "text": "De geboorteplaats van de schilder is Heerlen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13ee489b-667e-48a8-a4aa-4de028de5f6d",
                        "source_entry_id": "589addf7-d377-3e91-a741-45605b4a3b6b",
                        "source_sense_description": "place of birth or residence",
                        "target_lang_word": "woonplaats",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woonplaats",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5257b5ce-38ab-3d43-8e7e-edd33d8c3019",
                                        "entry_id": "666f3e2f-e0e7-3580-887a-573c568227fe",
                                        "glosses": [
                                            "plaats waar men woont, waar men ingeschreven is in het bevolkingsregister"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7eb631d-d2bc-4bf0-9bdc-3107cb3b994c",
                                                "sense_id": "5257b5ce-38ab-3d43-8e7e-edd33d8c3019",
                                                "text": "We waren daarvoor gekomen, en voor de romantische illusie om onze nieuwe woonplaats Venetië te zien door de ogen van de illustere toeristen die ons waren voorgegaan, zoals Stendhal, Lord Byron, Alexandre Dumas, Richard Wagner, Marcel Proust, Gustav Mahler, Thomas Mann, Ernest Hemingway, Rainer Maria Rilke, en die met zekerheid op deze zelfde stoelen hadden gezeten om hetzelfde uitzicht beroemd te maken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecb1f902-68a7-4dfa-b751-3da1a6ce3eee",
                        "source_entry_id": "589addf7-d377-3e91-a741-45605b4a3b6b",
                        "source_sense_description": "place of birth or residence",
                        "target_lang_word": "ville natale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "12668b94-1813-4ef1-a994-ebe65bbebf8a",
                        "source_entry_id": "589addf7-d377-3e91-a741-45605b4a3b6b",
                        "source_sense_description": "place of birth or residence",
                        "target_lang_word": "Heimat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heimat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d851f9ec-2d79-306a-8214-2d1e73f0f33f",
                                        "entry_id": "98a4a560-f955-3987-9ace-f36acb1a1cf5",
                                        "glosses": [
                                            "Ort, Gegend oder Land, wo jemand aufgewachsen ist, wo man sich wohl fühlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1fa612f-2100-45a0-be96-5325422eecd9",
                                                "sense_id": "d851f9ec-2d79-306a-8214-2d1e73f0f33f",
                                                "text": "Nach zehn Jahren kehrte er in seine alte Heimat zurück."
                                            },
                                            {
                                                "example_id": "84be2c44-5b7e-447a-8063-7fd0c5d39ec7",
                                                "sense_id": "d851f9ec-2d79-306a-8214-2d1e73f0f33f",
                                                "text": "„Denn Heimat, das ist für uns ein so schwieriges, schmerzhaftes und sehnsuchtsvolles Ding, dass es uns schwerfällt, darüber zu reden, geschweige denn, Antworten zu geben.“"
                                            },
                                            {
                                                "example_id": "af9861d5-7458-4428-9bc0-c6427b751929",
                                                "sense_id": "d851f9ec-2d79-306a-8214-2d1e73f0f33f",
                                                "text": "„Und weil neue Lacke wirklich sehr begehrenswert sind, lassen sich Damen vermehrt Nagellacke von weltreisenden Bekannten mitbringen, um in der Heimat wirklich die Erste zu sein, die diese ausführt.“"
                                            },
                                            {
                                                "example_id": "d284eae2-426f-438f-8d5e-2a0cc47f3363",
                                                "sense_id": "d851f9ec-2d79-306a-8214-2d1e73f0f33f",
                                                "text": "„Um die fragile Eintracht in ihrer Heimat zu wahren, haben die Siedler die Thinge geschaffen.“"
                                            },
                                            {
                                                "example_id": "c702904b-98a4-465e-b469-bbec4aa78040",
                                                "sense_id": "d851f9ec-2d79-306a-8214-2d1e73f0f33f",
                                                "text": "„So bitter es auch für den sechzehnjährigen Elias ist, eine seiner Heimaten verlassen zu haben, er weiß sich ganz offensichtlich auch in Frankfurt einzurichten.“"
                                            },
                                            {
                                                "example_id": "3d015580-b4e8-4122-801d-d363177eacbf",
                                                "sense_id": "d851f9ec-2d79-306a-8214-2d1e73f0f33f",
                                                "text": "„Seine Großeltern kamen als Gastarbeiter in den 1970ern nach Kreuzberg und Deutschland wurde zu ihrer neuen Heimat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52921664-254e-31fa-be23-ca24d9abcb98",
                                        "entry_id": "98a4a560-f955-3987-9ace-f36acb1a1cf5",
                                        "glosses": [
                                            "Ort, Gegend oder Land, woher etwas stammt, wo etwas seinen Ursprung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501bdaf0-6b72-467a-bf99-8ecb9349416c",
                                                "sense_id": "52921664-254e-31fa-be23-ca24d9abcb98",
                                                "text": "Amerika ist die Heimat der Kartoffel."
                                            },
                                            {
                                                "example_id": "d817d07c-7323-4175-8f48-92b5c92e4c43",
                                                "sense_id": "52921664-254e-31fa-be23-ca24d9abcb98",
                                                "text": "„Auch gab es unter den Jeckes, also jenen aus Deutschland stammenden Juden, die sprachlich und kulturell ihrer einstigen Heimat verbunden geblieben waren, so manche, die sich bereitwillig auf einen Dialog mit diesen Besuchern einließen.“"
                                            },
                                            {
                                                "example_id": "bfb47970-bbc8-4e98-914e-c344f73ee411",
                                                "sense_id": "52921664-254e-31fa-be23-ca24d9abcb98",
                                                "text": "„Sinnsuche ist die Suche nach einer neuen Heimat. Diese muss nicht auch die Heimat der anderen sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5f6a08b-ff4a-4283-b61d-7e8623d3fd59",
                        "source_entry_id": "589addf7-d377-3e91-a741-45605b4a3b6b",
                        "source_sense_description": "place of birth or residence",
                        "target_lang_word": "Heimatort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heimatort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59605572-f776-35f1-919f-173cfc1c4014",
                                        "entry_id": "72a9bebe-2c91-3efa-8894-7a5084e7082a",
                                        "glosses": [
                                            "Ort, in dem man sich zuhause fühlt (oft der Ort, in dem man geboren und aufgewachsen ist)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e6842d-c47b-4e96-b17c-4a316a43d007",
                                                "sense_id": "59605572-f776-35f1-919f-173cfc1c4014",
                                                "text": "„Wir hatten Anweisung, sie erst in unserm Heimatort abzuliefern.“"
                                            },
                                            {
                                                "example_id": "e911ae4e-1422-4f8a-9589-10370f6425b0",
                                                "sense_id": "59605572-f776-35f1-919f-173cfc1c4014",
                                                "text": "„Doch die Bindung zum Heimatort hat sich Wolfgang Rothe bewahrt.“"
                                            },
                                            {
                                                "example_id": "8a242100-9d7c-4eb3-8033-d56a041f0e0e",
                                                "sense_id": "59605572-f776-35f1-919f-173cfc1c4014",
                                                "text": "„Ich bog auf die wenig befahrene Hauptstraße meines Heimatortes und rollte auf dem Teer in Richtung Stadt.“"
                                            },
                                            {
                                                "example_id": "9f5c0a51-5494-459c-ad86-1b5c64976b0c",
                                                "sense_id": "59605572-f776-35f1-919f-173cfc1c4014",
                                                "text": "„Der Vortrag war für eine Stunde angesetzt, und die Schüler, deren Zug zu ihren Heimatorten abfuhr, hatten die Erlaubnis, früher zu gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
