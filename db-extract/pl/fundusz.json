                        ],
                        "form": "funduszach"
                    },
                    {
                        "form_id": "7fd3f044-92b6-4eb0-8c46-6ac2209b71b5",
                        "entry_id": "6fb32f9e-b44d-34cf-b553-d0475ea5e8db",
                        "tags": [
                            "singular",
