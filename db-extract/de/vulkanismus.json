                                    {
                                        "sense_id": "4345e00d-eff4-3498-98c7-257ceb5b9a4c",
                                        "entry_id": "6aa31bbf-ed4d-3ab6-a58f-b2b3fab08c45",
                                        "glosses": [
                                            "Any of the natural phenomena and processes associated with the action of volcanos, geysers and fumaroles"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14092d52-daf0-46ec-98ac-4621bc19bee7",
                                                "sense_id": "4345e00d-eff4-3498-98c7-257ceb5b9a4c",
                                                "text": "This rejuvenation-stage or post-erosional volcanism produces lava even more alkalic than late-stage volcanism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
