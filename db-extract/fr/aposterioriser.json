                "senses": [
                    {
                        "sense_id": "29af443e-d8bf-3631-ab02-de6631c41cf8",
                        "entry_id": "bf24444b-1632-31de-a016-7703d721c057",
                        "glosses": [
                            "Donner un caractère a posteriori à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d71c02-60b8-46b2-9033-3e3a9293941c",
                                "sense_id": "29af443e-d8bf-3631-ab02-de6631c41cf8",
                                "text": "Les a priori sont tenaces, surtout quand ils ont été « aposteriorisés » durant près de deux ans et des milliers de kilomètres."
                            },
                            {
                                "example_id": "28e94ab9-f2ed-48a4-84fc-617c36c4ad79",
                                "sense_id": "29af443e-d8bf-3631-ab02-de6631c41cf8",
                                "text": "On sait que, dans notre tradition, se sont au contraire affirmées les tendances symétriques à « aposterioriser » et à « aprioriser » l’idée."
                            }
                        ]
                    }
