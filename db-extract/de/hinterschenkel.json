                "senses": [
                    {
                        "sense_id": "e5c60654-9d1f-38ea-beca-acc3d3381a47",
                        "entry_id": "265ec7ba-9ff5-308a-b2ed-57c171ad811e",
                        "glosses": [
                            "bei Tieren mit vier oder mehr Beinen eine der hinteren Gliedmaßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d69a5d8-91d7-41da-87a5-6346951e4edb",
                                "sense_id": "e5c60654-9d1f-38ea-beca-acc3d3381a47",
                                "text": "„Der alte Rüde mit den verfilzten Haarbüscheln an den Hinterschenkeln, der dem Wolf den Weg hatte abschneiden wollen, war dank dem entstandenen Aufenthalt seinem Gegner bereits bis auf fünf Schritte nahe gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b137abca-48f3-4f3f-b657-c74489087f65",
                        "source_entry_id": "265ec7ba-9ff5-308a-b2ed-57c171ad811e",
                        "source_sense_id": "e5c60654-9d1f-38ea-beca-acc3d3381a47",
                        "source_sense_description": "bei Tieren mit vier oder mehr Beinen eine der hinteren Gliedmaßen",
                        "target_lang_word": "cuisse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "491d7a94-513c-3cb2-8684-578597f7915d",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "Partie du membre inférieur allant de la hanche au genou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48adbea0-a6ed-4056-8abe-b344972eeba3",
                                                "sense_id": "491d7a94-513c-3cb2-8684-578597f7915d",
                                                "text": "Les grenouilles sont un mets exquis quant aux cuisses, on le dit toutefois, car pour ma part je n’en ai jamais goûté ; ce batracien ne m’a jamais tenté en tant que victuailles."
                                            },
                                            {
                                                "example_id": "e4098121-7552-4594-8d2b-9079ccc77708",
                                                "sense_id": "491d7a94-513c-3cb2-8684-578597f7915d",
                                                "text": "Elle a les cuisses longues, mais pas de cette longueur à chaque pas émouvante comme le premier tour de bielle d’une locomotive de grand parcours. Il y a des cuisses qui se meuvent dans le creux de la poitrine des hommes. Il y a des cuisses dont la marche est majestueuse et angoissante comme le premier jour d’une guerre. Marie-Jeanne, grande, mince, à d’heureuses proportions, rien de plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa58115f-34e5-37ee-ac8b-585c7cb1438d",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "Chez les insectes, le fémur ou troisième article de la patte thoracique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13432155-615a-3439-9b12-347be9d6c2a5",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "(Vieilli) Qualifie la viscosité d’un vin sur la paroi du verre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a88a64d-361d-4443-97ac-397ad4cc7584",
                                                "sense_id": "13432155-615a-3439-9b12-347be9d6c2a5",
                                                "text": "L’examen visuel du vin est illustré à souhait dans la dégustation de M. Duchemin, alias Louis de Funès, dans le film L’aile ou la cuisse. Il en examine la robe sous une inclinaison d’environ 45°, tout en agitant délicatement le précieux liquide dans le verre, et ce, afin de permettre un contact étroit entre les différents constituants chimiques du vin et l’oxygène de l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df330c3-9c25-353a-9007-724c41d7eee1",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "Quartier de certains fruits (noix, oranges, etc.)."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d73bc561-3ead-3c19-836d-1f08c79c2736",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "L’activité sexuelle. S’utilise au singulier dans des expressions comme :"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b73b393-81ff-4148-b03f-379d4797a981",
                                                "sense_id": "d73bc561-3ead-3c19-836d-1f08c79c2736",
                                                "text": "Avoir la cuisse hospitalière, avoir la cuisse légère, être légère de la cuisse : avoir des mœurs légères."
                                            },
                                            {
                                                "example_id": "8dde341f-f362-4e9f-9fca-84ea03de3654",
                                                "sense_id": "d73bc561-3ead-3c19-836d-1f08c79c2736",
                                                "text": "− Ce n’est pas mal tourné […], mais à quoi que ça peut servir ? À montrer ses cuisses dans des beuglants de garnison."
                                            }
                                        ]
                                    }
                                ]
