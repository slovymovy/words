                        "translation_id": "d29826d9-c509-43ef-ab09-b6592f7b80bc",
                        "source_entry_id": "9f8ecf8d-8dbb-34b9-8338-2a0f314bd021",
                        "source_sense_id": "844c9eef-baee-3cb2-88ae-eb8e46d9aac2",
                        "source_sense_description": "amtliche Bescheinigung des Todes eines Menschen, sowie Ort und Zeitpunkt des Todes",
                        "target_lang_word": "death certificate",
