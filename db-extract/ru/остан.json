                "senses": [
                    {
                        "sense_id": "086200f3-3692-3d33-bffd-caa74e9a2a9c",
                        "entry_id": "aa9a1cb9-33b7-36ab-87c2-b13561cee1bd",
                        "glosses": [
                            "единица административного деления верхнего уровня в Иране"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb9baf6-7bd6-4e1f-966c-ac1df554dddd",
                                "sense_id": "086200f3-3692-3d33-bffd-caa74e9a2a9c",
                                "text": "Луры живут в западной части Ирана. Они составляют большинство населения в губернаторстве Лурестан, а также на севере остана Хузистан."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5643ae88-f3e5-45fd-9ebb-90eeaa15d93f",
                        "source_entry_id": "aa9a1cb9-33b7-36ab-87c2-b13561cee1bd",
                        "source_sense_id": "086200f3-3692-3d33-bffd-caa74e9a2a9c",
                        "target_lang_word": "province",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "province",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f112571f-8b41-3420-8bff-8be2c4bd3397",
                                        "entry_id": "d223df64-36bb-3bdc-ac7c-bf65a3dade8a",
                                        "glosses": [
                                            "A region of the earth or of a continent; a district or country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0f9e83-5c30-42c7-b926-78194d3f6961",
                                                "sense_id": "f112571f-8b41-3420-8bff-8be2c4bd3397",
                                                "text": "[…] we should find, as we do find, some groups of beings greatly, and some only slightly modified,—[…]—in the different great geographical provinces of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                                        "entry_id": "d223df64-36bb-3bdc-ac7c-bf65a3dade8a",
                                        "glosses": [
                                            "An administrative subdivision of certain countries, including Canada and China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27820726-1a04-45b2-ad41-132c2e39e036",
                                                "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                                                "text": "Chowta-Zhin, who is ſaid to be a man of buſineſs and preciſion, and cautious of advancing facts, at the requeſt of Earl Macartney, delivered to him a ſtatement taken from one of the public officers in the capitol, of the inhabitants of the fifteen ancient provinces of China, or China proper, within the great wall ; according to which the number of inhabitants, taken by a regular enumeration, amounts to 333,000,000!"
                                            },
                                            {
                                                "example_id": "70541270-2e18-4c52-a3b9-0382dbc76219",
                                                "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                                                "text": "The telegraph administration refuses to transmit messages either to or from the Provinces of Hu-Peh, Hu-Nan, Kiang-Si, Sze-Chuan, Kwei-Chow, and Yu-Nan^([sic – meaning Yun-Nan])."
                                            },
                                            {
                                                "example_id": "58d6fff6-751b-4288-8afb-243deafb5c19",
                                                "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                                                "text": "After the Hsuchow-Pengpu Battle,* with the exception of the battles fought on Tengpu Island and Kinmen Island,** Government troops put up no determined fight, and, as a result, province after province on the mainland fell into Communist hands."
                                            },
                                            {
                                                "example_id": "e2bc7e3b-cb3e-4d76-a5b6-f9e7401bd8a0",
                                                "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                                                "text": "All of Fort McMurray, with the exception of Parson’s Creek, was under a mandatory evacuation order on Tuesday, said Robin Smith, press secretary for the regional municipality of Wood Buffalo in the Canadian province [of Alberta]."
                                            },
                                            {
                                                "example_id": "acc45cfd-74da-4f69-b9f1-239b24463b6e",
                                                "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                                                "text": "Doi Inthanon National Park covers 482.40 square kilometers. As one of Thailand’s most popular provinces for tourists, Chiang Mai has plenty of great attractions but one of the best has to be Doi Inthanon National Park."
                                            },
                                            {
                                                "example_id": "2713c52b-c9fe-409b-b763-3c08e16bc600",
                                                "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                                                "text": "One of China’s poorest and most indebted provinces has admitted defeat in trying to sort out its finances and is appealing to Beijing for help to avert default. […] The Beijing-based firm — one of four funds created by the Chinese government in 1999 to process the bad loans of state-owned banks — announced Saturday that it would send a group of 50 experts to the province to help it “prevent and defuse risks” and “bail out” the real estate industry."
                                            },
                                            {
                                                "example_id": "251037fc-6924-4ea5-a124-679de9abcf14",
                                                "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                                                "text": "A group of Thai researchers found the spider during an expedition to Phang-Nga province in southern Thailand to research the diversity and distribution of tarantulas in the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb537131-891a-3a43-a9da-a6fda28774ce",
                                        "entry_id": "d223df64-36bb-3bdc-ac7c-bf65a3dade8a",
                                        "glosses": [
                                            "An area outside Italy which is administered by a Roman governor or prefect."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "Roman-Empire",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f63e4036-d386-4f55-96d7-029753445fe8",
                                                "sense_id": "eb537131-891a-3a43-a9da-a6fda28774ce",
                                                "text": "He reminded his audience of events in 88BC, when the same Mithridates invaded the Roman province of Asia, on the western coast of Turkey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4263279-1eb9-3e1a-9260-d87318bcb2ba",
                                        "entry_id": "d223df64-36bb-3bdc-ac7c-bf65a3dade8a",
                                        "glosses": [
                                            "An area under the jurisdiction of an archbishop, typically comprising a number of adjacent dioceses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f77a0fbe-da33-48ed-8eee-b33adc68e84b",
                                                "sense_id": "d4263279-1eb9-3e1a-9260-d87318bcb2ba",
                                                "text": "In 1309, neither the Archbishop of Canterbury nor his suffragans would attend in Parliament while the Archbishop of York had the cross borne erect before him in the province of Canterbury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd3667f-61c7-3ffd-8490-42fa5a754cb2",
                                        "entry_id": "d223df64-36bb-3bdc-ac7c-bf65a3dade8a",
                                        "glosses": [
                                            "An area under the jurisdiction of a provincial within a monastic order."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4895bd76-7031-3ab8-a9b1-bfb9a41fe0c2",
                                        "entry_id": "d223df64-36bb-3bdc-ac7c-bf65a3dade8a",
                                        "glosses": [
                                            "The parts of a country outside its national capital."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb3c338c-a90c-4486-9b55-17b016469fab",
                                                "sense_id": "4895bd76-7031-3ab8-a9b1-bfb9a41fe0c2",
                                                "text": "To-day the first part of the new Indian Constitution comes into force with the granting of a large measure of autonomy to the provinces."
                                            },
                                            {
                                                "example_id": "e6ddd081-e501-454a-99b0-6e06c55b7fd6",
                                                "sense_id": "4895bd76-7031-3ab8-a9b1-bfb9a41fe0c2",
                                                "text": "\"What are the Russian provinces?\" he said. \"Dirt, ruins, poverty, drunkenness. That is what we need to be working on, rather than expanding our prison to include Georgia, Ukraine, the Baltic states, and Belarus. That is the kind of Russian nationalist that I am…. There is no sense in using force to hold people that don’t want to be with you.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "477830b7-53ec-372b-b2a9-397ca68d9a26",
                                        "entry_id": "d223df64-36bb-3bdc-ac7c-bf65a3dade8a",
                                        "glosses": [
                                            "A major region defined by common geologic attributes and history."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c38b44bf-09fc-3d33-b68a-0296a192f780",
                                        "entry_id": "d223df64-36bb-3bdc-ac7c-bf65a3dade8a",
                                        "glosses": [
                                            "An area of activity, responsibility or knowledge; the proper concern of a particular person or concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acda8a34-acdf-4ce2-b7aa-470f3acbe30b",
                                                "sense_id": "c38b44bf-09fc-3d33-b68a-0296a192f780",
                                                "text": "More than half a million women are now employed on the railways of the Soviet Union, and some of them perform such duties as those of engine drivers and stationmasters, formerly considered the sole province of men."
                                            },
                                            {
                                                "example_id": "9632d2d0-57e5-446a-bace-de75b55a5313",
                                                "sense_id": "c38b44bf-09fc-3d33-b68a-0296a192f780",
                                                "text": "Just as money is the province of the economy and truth the province of science and scholarship, so love is the province of the family (Niklas Luhmann)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
