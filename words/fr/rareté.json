                    ]
                },
                {
                    "sense_id": "2fc1755c-dd86-32c8-984c-9c1b9e7a8e8c",
                    "sense_definition": "Chose, personne ou objet singulier, précieux et difficile à trouver.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée présente une collection de <w>raretés</w> historiques venues des quatre coins du monde."
                        },
                        {
                            "text": "Ce manuscrit du douzième siècle est une véritable <w>rareté</w> que tous les collectionneurs convoitent."
