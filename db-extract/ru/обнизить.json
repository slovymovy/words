                "senses": [
                    {
                        "sense_id": "3f4f952d-35e6-3343-b75a-d30a7b453aeb",
                        "entry_id": "97f5525d-4387-355b-9f5f-3c1c738cda42",
                        "glosses": [
                            "понизить или сделать ниже должного; окоротить в вышину"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d79b0827-eed4-46d5-9b6e-bfecc7cba63f",
                                "sense_id": "3f4f952d-35e6-3343-b75a-d30a7b453aeb",
                                "text": "― Надо мужикам сказать, завалину бы не обнизили, подпол промерзать станет."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5e2568a-bb46-3405-82c2-df1250eedfc1",
                        "entry_id": "97f5525d-4387-355b-9f5f-3c1c738cda42",
                        "glosses": [
                            "охотн. попасть ниже цели при стрельбе (о пули, дроби и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70280048-3413-4e55-9eca-dea3e086032c",
                                "sense_id": "c5e2568a-bb46-3405-82c2-df1250eedfc1",
                                "text": "Нет никакого сомнения, что дуло ружья потеряет цель и по большей части обнизит."
                            }
                        ]
                    }
                ],
