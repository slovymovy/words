                        "target_lang_word": "Verwalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee564d21-a8c4-3239-abb9-9d1b06ac7c3c",
                                        "entry_id": "2d995031-c8b4-340a-b275-1c0472bf9bf2",
                                        "glosses": [
                                            "Person, die etwas verwaltet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca567e1-112c-4107-90d1-100cec409db8",
                                                "sense_id": "ee564d21-a8c4-3239-abb9-9d1b06ac7c3c",
                                                "text": "„Als oberster Verwalter der Kirche ist der Papst mit der Aufsicht über das ganze kirchliche Leben betraut.“"
                                            },
                                            {
                                                "example_id": "34d0c5cb-fc9a-40eb-8310-c1284b592d48",
                                                "sense_id": "ee564d21-a8c4-3239-abb9-9d1b06ac7c3c",
                                                "text": "„Eine erste Überraschung erlebte man, als er eine Landwirtschaftslehre mit Bravour bestand und, wenn auch in auffällig häufig wechselnden Stellungen, zum tüchtigen und akkuraten Verwalter aufstieg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b89e2dab-37f8-4aca-8e50-7ea015d4e5ce",
                        "source_entry_id": "00a0a448-8e85-30e2-af12-a4aaba5a7439",
                        "source_sense_id": "02349dec-c312-302d-80d0-95af3ab46c6f",
                        "source_sense_description": "een persoon om een bepaald geheel te regelen en te onderhouden of dit beroep",
                        "target_lang_word": "Administrator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Administrator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c692a488-caab-3ce3-bed7-ad61dd57afbf",
                                        "entry_id": "caced0e8-85b4-342e-a53b-301816c40115",
                                        "glosses": [
                                            "Betreuer, Verwalter"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde3ce45-819a-41f6-a521-19a9e973074b",
                                                "sense_id": "c692a488-caab-3ce3-bed7-ad61dd57afbf",
                                                "text": "Malloch Brown, der zugleich noch Administrator der Uno-Entwicklungsorganisation UNDP ist, forderte die deutsche Regierung auf, den \"eigenen Führungsanspruch noch nachhaltig zu demonstrieren\"."
                                            },
                                            {
                                                "example_id": "d7c51db8-6658-42f4-a2d3-82f9480eca0e",
                                                "sense_id": "c692a488-caab-3ce3-bed7-ad61dd57afbf",
                                                "text": "„Ich lasse kehrtmachen, der Wagen rasselt wieder über den Hof, der Administrator ruft mir noch etwas zu, ich eile an den Geldschrank, nehme den Scheck.“"
                                            },
                                            {
                                                "example_id": "22111814-30f0-46d7-ad30-c0a7e533ce07",
                                                "sense_id": "c692a488-caab-3ce3-bed7-ad61dd57afbf",
                                                "text": "„Der Beschwerdeführer war seit dem Schuljahr 1993/1994 zur Unterstützung des Schulleiters als Administrator an dieser aus zehn Klassen bestehenden Schule bestellt.“"
                                            },
                                            {
                                                "example_id": "6c4aced9-6357-4a34-86c9-42f4a6530c24",
                                                "sense_id": "c692a488-caab-3ce3-bed7-ad61dd57afbf",
                                                "text": "„Der Staat war lediglich der Administrator, sorgte aber dafür, dass die Sklaven ebenso besteuert wurden wie Vieh oder Gerätschaften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4d9af02-c733-3838-bcd1-b374eba2aa33",
                                        "entry_id": "caced0e8-85b4-342e-a53b-301816c40115",
                                        "glosses": [
                                            "Verwalter eines Computersystems oder Computernetzes mit besonderen Rechten und Aufgaben"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b5a0a1-a84e-4188-a02e-d298b8a42f11",
                                                "sense_id": "a4d9af02-c733-3838-bcd1-b374eba2aa33",
                                                "text": "Ich kann auf unseren Server nicht zugreifen. Ich rufe mal bei den Administratoren an."
                                            },
                                            {
                                                "example_id": "aabccb10-4c55-4899-a95c-1a69da1ea678",
                                                "sense_id": "a4d9af02-c733-3838-bcd1-b374eba2aa33",
                                                "text": "„Während des Chemiestudiums wandte Tom seine umfangreichen EDV-Kenntnisse auch im Fachbereich der Uni an, indem er die dortige EDV als Administrator auf dem neuesten Stand hielt, soweit das den Vorschriften entsprechend möglich war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0c876642-5b2d-34e9-abcc-7a8bf024ae3e",
                                        "entry_id": "caced0e8-85b4-342e-a53b-301816c40115",
                                        "glosses": [
                                            "jemand mit bestimmten Funktionen in der katholischen und evangelischen Kirche"
                                        ],
                                        "tags": [
                                            "Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae6047d-75a2-493f-8b5f-a03f9ffac434",
                                                "sense_id": "0c876642-5b2d-34e9-abcc-7a8bf024ae3e",
                                                "text": "„Für das Erzbistum Magdeburg hatte das Restitutionsedikt zur nächsten Folge, daß der Erzherzog Leopold Wilhelm, des Kaisers Sohn, zu seinem Administrator ernannt wurde. Der protestantische Administrator, Christian Wilhelm, hatte bereits im Jahre 1625, als Wallenstein sich Magdeburg näherte, die Stadt verlassen ….“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc4cbac9-245d-462c-bfbb-a6918ee8cc43",
                        "source_entry_id": "00a0a448-8e85-30e2-af12-a4aaba5a7439",
                        "source_sense_id": "02349dec-c312-302d-80d0-95af3ab46c6f",
                        "source_sense_description": "een persoon om een bepaald geheel te regelen en te onderhouden of dit beroep",
                        "target_lang_word": "Geschäftsführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschäftsführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55f94b61-820f-397d-9965-5defda388e19",
                                        "entry_id": "d5caf7df-5b86-3625-8aba-feee8c49a805",
                                        "glosses": [
                                            "leitender Angestellter einer Personenvereinigung, meist eines Unternehmens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbc24bc7-e43c-472f-a753-e118323ab331",
                                                "sense_id": "55f94b61-820f-397d-9965-5defda388e19",
                                                "text": "Hartmut Neumann, der Geschäftsführer des Sport- und Freizeitzentrums Siemensstadt, ist mit seinen fünf neuen Mitarbeitern jedenfalls zufrieden."
                                            },
                                            {
                                                "example_id": "f2175500-c330-42df-814a-eb8008fa86b6",
                                                "sense_id": "55f94b61-820f-397d-9965-5defda388e19",
                                                "text": "„Erwachsenen Menschen ist es nur eine gewisse Weile erlaubt, in süßen Erinnerungen zu schwelgen, und bald wandte sich der Geschäftsführer seinem eigentlichen Thema zu.“"
                                            },
                                            {
                                                "example_id": "0115441c-436e-431b-a869-cd2ca312f3cd",
                                                "sense_id": "55f94b61-820f-397d-9965-5defda388e19",
                                                "text": "„Das schöne große Schuhgeschäft gehört einer alten Frau, die hat ihren Geschäftsführer geheiratet, und seitdem schläft sie hinten, und es geht ihr schlecht.“"
                                            },
                                            {
                                                "example_id": "b5eb8a56-4fc7-4756-8c26-3b2c650ff3da",
                                                "sense_id": "55f94b61-820f-397d-9965-5defda388e19",
                                                "text": "„Der Geschäftsführer des Restaurants erschien, und Jackson Evans ließ ihm eine ähnliche Behandlung zuteil werden.“"
                                            },
                                            {
                                                "example_id": "f17a0387-8a5f-478f-a89c-f9dba98add72",
                                                "sense_id": "55f94b61-820f-397d-9965-5defda388e19",
                                                "text": "„Ist ein Geschäftsführer dem Amt nicht gewachsen, muss er es niederlegen; andernfalls bleibt er in der Haftungsgefahr.“"
                                            },
                                            {
                                                "example_id": "6a4588cc-895d-4169-90b3-0925c6b11c3a",
                                                "sense_id": "55f94b61-820f-397d-9965-5defda388e19",
                                                "text": "„Die Übernahme einer Geschäftsführung, die mit übermäßigen Gefahren verbunden ist, denen der Geschäftsführer nicht gewachsen ist, entspricht ebenso nicht mutmaßlichen Willen des Geschäftsherrn.“"
                                            },
                                            {
                                                "example_id": "8557c44c-ef76-46ca-a693-8d3d4f4cda52",
                                                "sense_id": "55f94b61-820f-397d-9965-5defda388e19",
                                                "text": "„Hierbei kommt ein objektiver Maßstab zur Anwendung, d.h. der Geschäftsführer kann sich nicht berufen, dass er persönlich mit den Aufgaben überfordert oder ihnen nicht gewachsen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
