                                            {
                                                "example_id": "33f50732-f9b7-4439-8635-097ddb64e068",
                                                "sense_id": "28d8e66e-949c-3e2a-90ae-82de57e1c7a8",
                                                "text": "Er wohnte noch im elterlichen Haus."
                                            },
                                            {
                                                "example_id": "df8cd92c-5d9f-4a47-a625-8c515ba53c1d",
                                                "sense_id": "28d8e66e-949c-3e2a-90ae-82de57e1c7a8",
                                                "text": "„Auf elterlichen Wunsch pilgerte er schließlich nach Rom, um vom Papst Dispens zu erlangen.“"
                                            },
                                            {
                                                "example_id": "ed0f4a5b-51ec-428e-acca-90eeb47f5ada",
                                                "sense_id": "28d8e66e-949c-3e2a-90ae-82de57e1c7a8",
                                                "text": "„Hoch verschuldet und gedemütigt, kehrt er aufs elterliche Gut zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
