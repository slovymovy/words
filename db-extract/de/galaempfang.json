                "senses": [
                    {
                        "sense_id": "97d1db4b-c73f-37b5-9672-713f5e455be3",
                        "entry_id": "359c0945-9236-3c88-bb4f-456ee0101cb4",
                        "glosses": [
                            "(offizielles) Fest, festlicher Empfang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50b4e6cb-90ed-4d2f-891c-144cec68ab0b",
                                "sense_id": "97d1db4b-c73f-37b5-9672-713f5e455be3",
                                "text": "„Zum Galaempfang versammelte man sich danach im Palazzo Venezia […]“"
                            },
                            {
                                "example_id": "9a646cd7-30d3-42c4-877f-a34ccb634df0",
                                "sense_id": "97d1db4b-c73f-37b5-9672-713f5e455be3",
                                "text": "„[…] der Galaempfang und die Umarmungen mit König und Prinzen konnten nicht darüber hinwegtäuschen, dass [US-Präsident George] Bushs Reise in die Golfstaaten ein gewaltiger Misserfolg war.“"
                            },
                            {
                                "example_id": "cd1ee46d-9ccb-4b5a-9b1d-a79d917b3a61",
                                "sense_id": "97d1db4b-c73f-37b5-9672-713f5e455be3",
                                "text": "„[…] die Stadt [Wien war am 15. Mai 1955 wirklich] im Banne des großen Ereignisses, Jubel umbraust das Schloss des Prinz‘ Eugen, Schönbrunn in feenhafter Beleuchtung, Festbankett und Galaempfang, Festtagsstimmung auch bei strömendem Regen.“"
                            },
                            {
                                "example_id": "13ac1098-6861-4522-a36b-dd95930a5b37",
                                "sense_id": "97d1db4b-c73f-37b5-9672-713f5e455be3",
                                "text": "„Wie in jedem Sommer gibt es auch in diesem Jahr wieder einen Skandal, über den man sich den Mund zerreißt: Da grinst der schwerreiche Architekt Peter Cook bei einem Galaempfang mit seiner Ehefrau Christie Brinkley, einem Ex-Supermodel, in die Kamera, als wäre nichts gewesen. Doch offenbar war es mit der Zweisamkeit schon lange vorbei.“"
                            },
                            {
                                "example_id": "3644ebce-1ffe-4a70-a446-7d2043e2e9e3",
                                "sense_id": "97d1db4b-c73f-37b5-9672-713f5e455be3",
                                "text": "„[…] die \"MGM\"- Marketingexperten nutzten die Gunst der patriotischen Stunde: Sie baten die Indianer und Hauptdarsteller zu einem Galaempfang in die \"Library of Congress\" und zelebrierten das Heldentum der Navajo, die seit über hundert Jahren - wie hunderttausende Mitglieder anderer Stämme auch - ein bescheidenes Dasein im Reservat fristen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
