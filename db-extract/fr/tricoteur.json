                ],
                "senses": [
                    {
                        "sense_id": "d7559ebf-a8dd-369b-b8b4-56105b857d4f",
                        "entry_id": "60c3d4ab-efc2-352b-899e-3d2d94466c8f",
                        "glosses": [
                            "Ouvrier ou artisan qui tricote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82cd7552-ae9d-4601-8a56-26f0e5765417",
                                "sense_id": "d7559ebf-a8dd-369b-b8b4-56105b857d4f",
                                "text": "« À l'orée des année 1930. ,... nous vivions au premier. Mon père, tricoteur, avait son atelier au rez de chaussée. J'étais fasciné par les bobines, les écheveaux de laine brute de toutes les couleurs »."
                            }
                        ]
                    },
                    {
                        "sense_id": "90fec1bf-764d-3667-811c-567cb5e70ff3",
                        "entry_id": "60c3d4ab-efc2-352b-899e-3d2d94466c8f",
                        "glosses": [
                            "Homme qui sur les trains de bois, se démène avec les jambes pour assurer la flottaison."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "61b56f09-8b59-4fb1-b01d-c48135a93c24",
                                "sense_id": "90fec1bf-764d-3667-811c-567cb5e70ff3",
                                "text": "À la vérité, mes deux cousins, par leur mérite personnel, s'étaient élevés à l'emploi de facteurs, ce qui les avait tirés de la classe des tricoteurs, qu'ils commandaient; leurs voyages étaient payés comme pour un trayeur, à chacun des dix trains, descendant à Paris qui étaient sous leur inspection, et ils faisaient bien leurs affaires. , Bibliothèque de la Pléiade, Tome 1, p. 743."
                            }
                        ]
                    },
                    {
                        "sense_id": "17102ba2-8720-3a4d-85b4-b4b4c87f2db9",
                        "entry_id": "60c3d4ab-efc2-352b-899e-3d2d94466c8f",
                        "glosses": [
                            "Celui qui fait des déplacements, des mouvements rapides."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "47424fb9-04e8-4df2-9e24-7761cfdfaf26",
                                "sense_id": "17102ba2-8720-3a4d-85b4-b4b4c87f2db9",
                                "text": "Contrôle de la rondelle [de hockey], tricoteur, un peu tiède à visiter les coins et se poster devant le filet."
                            }
                        ]
                    },
                    {
                        "sense_id": "581c809f-6b8f-3a91-8d0c-31ee841ae317",
                        "entry_id": "60c3d4ab-efc2-352b-899e-3d2d94466c8f",
                        "glosses": [
                            "Celui qui fait des associations de notes de musiques, d’idées, de mots qui semblent construits, structurés et réguliers comme un tricot."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6f7a3d35-99fd-4b9b-854d-fd6c5057bdd2",
                                "sense_id": "581c809f-6b8f-3a91-8d0c-31ee841ae317",
                                "text": "Autour de Pascal Bouaziz, guitariste et chanteur, tricoteur de mots, on retrouve … et l’on assiste à quelque chose de rare."
                            }
                        ]
                    }
                ],
