                "senses": [
                    {
                        "sense_id": "7f585092-16e5-384c-b1fa-53b9bc72bd91",
                        "entry_id": "b993c67a-46f5-35be-bf58-e5ee66fb73dc",
                        "glosses": [
                            "Bereich der Hölle, der für bestimmte Sünder vorgesehen ist, in dem bestimmte Vergehen bestraft werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1e0af9-fa0a-41c2-8cff-7162e9287edc",
                                "sense_id": "7f585092-16e5-384c-b1fa-53b9bc72bd91",
                                "text": "„Heathrow Airport glich sonntagmorgens dem achten Höllenkreis.“"
                            },
                            {
                                "example_id": "9a8a8e3b-b7ad-4613-a4ae-4330ccb2f6be",
                                "sense_id": "7f585092-16e5-384c-b1fa-53b9bc72bd91",
                                "text": "„In Wahrheit hasse ich Kinder abgrundtief. An einer Grundschule zu unterrichten wäre für mich der reinste Albtraum. In Irinas Inferno wäre der siebte Höllenkreis ein Zimmer voller Fünfjähriger, die man bis in alle Ewigkeit mit Kartoffeldrucken beschäftigen muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
