                ],
                "senses": [
                    {
                        "sense_id": "bf18836d-45ae-3db0-8d2b-213cabf9d523",
                        "entry_id": "e4d2c105-f68a-3e69-a8fe-9994bd2a22d3",
                        "glosses": [
                            "Element aus Kunststoff welches Bestandteil eines Ganzen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04321e53-75f0-49f4-b058-7547db7ef8d3",
                                "sense_id": "bf18836d-45ae-3db0-8d2b-213cabf9d523",
                                "text": "„Ziel dieser Empfehlung ist es, dem Anwender Informationen zur sachgerechten manuellen und maschinellen Dekontamination dieser Kunststoffkomponenten zur Verfügung zu stellen.“"
                            },
                            {
                                "example_id": "d947e731-1110-4f56-a59b-ea37a4d148d4",
                                "sense_id": "bf18836d-45ae-3db0-8d2b-213cabf9d523",
                                "text": "„Um das Austreten von Geruchsstoffen aus einer Kunststoffkomponente im Innenraum eines Fahrzeugs zu verhindern, wird die Kunststoffkomponente mit einer eine organische Säure enthaltenden Sperrschicht für die Geruchsstoffe versehen.“"
                            },
                            {
                                "example_id": "e0a2a845-efe8-4ded-9787-584ae87435d8",
                                "sense_id": "bf18836d-45ae-3db0-8d2b-213cabf9d523",
                                "text": "„Nach spätestens 10 Minuten ist die angerührte Kunststoffkomponente (Dentin, Enamel, Transpa clear) auf die konditionierte Oberfläche aufzutragen.“"
                            },
                            {
                                "example_id": "24d3ff9f-211f-4f45-be02-9fd1433fd16a",
                                "sense_id": "bf18836d-45ae-3db0-8d2b-213cabf9d523",
                                "text": "„Die Kunststoffkomponente dient dabei zur Versteifung.“"
                            },
                            {
                                "example_id": "a57a3148-c806-4a3f-b309-63a69d272f1d",
                                "sense_id": "bf18836d-45ae-3db0-8d2b-213cabf9d523",
                                "text": "„Das Verbundteil - bestehend aus einer geschäumten und einer gespritzten Kunststoffkomponente - kann in einem weiteren Schritt als Normteil z. B. in ein geschäumtes Gehäuse integriert werden, um Medienleitungen einfach und dicht anzuschliessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
