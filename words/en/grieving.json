            "senses": [
                {
                    "sense_id": "22577abb-bcde-3fe3-9ee1-2d0f65851021",
                    "sense_definition": "An act or instance of feeling or expressing deep sadness or grief.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her silent <w>grievings</w> were only noticed by her closest friend.",
                            "target_lang_translations": {
