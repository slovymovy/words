                    }
                ],
                "senses": [
                    {
                        "sense_id": "30d18b90-0632-317d-b207-34783db2a7b5",
                        "entry_id": "db479dc2-dd2d-38b2-a234-a42f672da79c",
                        "glosses": [
                            "религ. монах, отшельник, давший обет не выходить из своей кельи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f21428c1-c9d5-4236-82b7-35f73a52e8ac",
                                "sense_id": "30d18b90-0632-317d-b207-34783db2a7b5",
                                "text": "Развернул наудачу ― и попал на житие преподобного Исакия, затворника печерского."
                            }
                        ]
                    },
                    {
                        "sense_id": "703a6b80-0e0f-3e6d-afba-ca587e7d7579",
                        "entry_id": "db479dc2-dd2d-38b2-a234-a42f672da79c",
                        "glosses": [
                            "перен. человек, ведущий уединённый образ жизни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76002ac-2e89-4fa8-8596-66c3892ddfa1",
                                "sense_id": "703a6b80-0e0f-3e6d-afba-ca587e7d7579",
                                "text": "Да, собственно говоря, кроме почты, рынка и магазина, мне и ходить-то было некуда. Итак, я сидел дома, как затворник. Были дни, когда я ничего не ел."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b3f42ca-5714-4cae-8cc7-8bd6516f2cce",
                        "source_entry_id": "db479dc2-dd2d-38b2-a234-a42f672da79c",
                        "target_lang_word": "recluse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recluse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d82034a-799f-3d3a-ace6-85dc9d38d817",
                                        "entry_id": "9ebe07f3-5174-35ff-a3ff-28aee620f76d",
                                        "glosses": [
                                            "Sequestered; secluded, isolated."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f90c6b8-64b2-4439-bc37-d24d3da79105",
                                                "sense_id": "3d82034a-799f-3d3a-ace6-85dc9d38d817",
                                                "text": "a recluse monk or hermit"
                                            },
                                            {
                                                "example_id": "a87ff717-7b05-4453-9e8c-19ec6115e92f",
                                                "sense_id": "3d82034a-799f-3d3a-ace6-85dc9d38d817",
                                                "text": "Hermits themſelves are not recluſe enough to ſeclude that ſubtile ſpirit, Vanity: […]"
                                            },
                                            {
                                                "example_id": "7ec6a4d6-7a4c-4ed4-a01a-c07add2f29d9",
                                                "sense_id": "3d82034a-799f-3d3a-ace6-85dc9d38d817",
                                                "text": "In meditation deep, recluse / From human converse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "343a13a9-e689-3bae-8b85-1172d8b6eb4d",
                                        "entry_id": "9ebe07f3-5174-35ff-a3ff-28aee620f76d",
                                        "glosses": [
                                            "Hidden, secret."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "recluse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d13d330-ae0a-3c5d-a1ac-c0f6d9483a96",
                                        "entry_id": "61fa4d9a-fd51-3081-8c2b-1abcb3eb9da4",
                                        "glosses": [
                                            "A person who lives in self-imposed isolation or seclusion from the world, especially for religious purposes; a hermit."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cd69f31-b0e8-4723-ad6d-ce888cffaa78",
                                                "sense_id": "1d13d330-ae0a-3c5d-a1ac-c0f6d9483a96",
                                                "text": "The recluse in the fable kept a cat to keep off the rats, and then a cow to feed the cat with milk, and a man to keep the cow and so on. My ambitions also grew like the family of the recluse."
                                            },
                                            {
                                                "example_id": "8007f7b9-275e-4e3c-b63f-41492c238d25",
                                                "sense_id": "1d13d330-ae0a-3c5d-a1ac-c0f6d9483a96",
                                                "text": "First, the president’s uncle died in 1985. Kaczynski was publicly revealed as the Unabomber more than a decade later, in 1996, when he was captured; before that, he had lived as a recluse in the Montana wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c78bd8e2-ef2b-39de-b789-0f41ee83eb8c",
                                        "entry_id": "61fa4d9a-fd51-3081-8c2b-1abcb3eb9da4",
                                        "glosses": [
                                            "The place where a recluse dwells; a place of isolation or seclusion."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79faf3f1-20b5-4f33-acbb-307e2e817f50",
                                                "sense_id": "c78bd8e2-ef2b-39de-b789-0f41ee83eb8c",
                                                "text": "that day of appearance taken out of the recluse and committed to safe custody"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d168264-fc14-3d84-923a-a7d92c8daa95",
                                        "entry_id": "61fa4d9a-fd51-3081-8c2b-1abcb3eb9da4",
                                        "glosses": [
                                            "A brown recluse spider."
                                        ],
                                        "tags": [
                                            "US",
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c27bc154-68d6-3c43-b586-3fb7ddfc2145",
                                        "entry_id": "61fa4d9a-fd51-3081-8c2b-1abcb3eb9da4",
                                        "glosses": [
                                            "See also Thesaurus:recluse"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
