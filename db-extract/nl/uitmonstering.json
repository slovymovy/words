                "entry_id": "ef5c5460-728a-3f51-ba94-959ba632c949",
                "word": "uitmonstering",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "056a47c8-9ee7-4669-996a-03a728620993",
                        "entry_id": "ef5c5460-728a-3f51-ba94-959ba632c949",
                        "tags": [
                            "plural"
                        ],
                        "form": "uitmonsteringen"
