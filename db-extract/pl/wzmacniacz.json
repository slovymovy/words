                                                "sense_id": "167f2d5d-276e-3ac1-8319-34a6dc4b2f31",
                                                "text": "The football team is not an extension of Iran’s leaders, but is in fact the opposite, seen as an amplifier for freedom, group expression, modernity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "381890f9-ea6c-319a-a0d2-79bb4531b0dc",
                                        "entry_id": "eb4589b5-1391-3bf8-b5bf-d80c57035012",
                                        "glosses": [
                                            "An adverb that adds intensity, such as \\\"really\\\" or \\\"totally\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a672d35-a33f-3dcb-82eb-4fa40c037679",
                                        "entry_id": "eb4589b5-1391-3bf8-b5bf-d80c57035012",
                                        "glosses": [
                                            "An appliance or circuit that increases the strength of a weak electrical signal without changing the other characteristics of the signal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d6bf5ea-ee9c-3792-b2fa-95e194c07d90",
                                        "entry_id": "eb4589b5-1391-3bf8-b5bf-d80c57035012",
                                        "glosses": [
                                            "A portable encasement that houses a large speaker, used to amplify voices and musical instruments at live performances."
                                        ],
                                        "tags": [],
