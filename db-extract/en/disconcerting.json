                    {
                        "translation_id": "5eb3c292-130c-4d9b-a47d-a6aace18f1b1",
                        "source_entry_id": "828ad5ee-0465-3f29-a3a2-496debd895f4",
                        "source_sense_id": "4ee30443-8758-3879-b399-461717158646",
                        "source_sense_description": "tending to cause discomfort, uneasiness or alarm; unsettling; troubling; upsetting",
                        "target_lang_word": "befremdlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "befremdlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b827fa92-cd9c-3432-83f2-e92415e622b5",
                                        "entry_id": "b69dddd0-41db-3bd5-b80b-f16b67095d7b",
                                        "glosses": [
                                            "unangenehme Verwunderung hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b390fa-6590-42a7-af58-15300d9aa6b4",
                                                "sense_id": "b827fa92-cd9c-3432-83f2-e92415e622b5",
                                                "text": "Das Verhalten ist befremdlich."
                                            },
                                            {
                                                "example_id": "a8f9bddc-e225-48a5-8279-9462fb7d03ef",
                                                "sense_id": "b827fa92-cd9c-3432-83f2-e92415e622b5",
                                                "text": "„Auf einmal war diese wunderbare Werbeagentur zu einem befremdlichen Arbeitsplatz geworden.“"
                                            },
                                            {
                                                "example_id": "1b0d0fe8-5794-4129-9d9d-86f08d1375df",
                                                "sense_id": "b827fa92-cd9c-3432-83f2-e92415e622b5",
                                                "text": "„Befremdlich wird es erst, als wir uns gegenseitig streicheln und dann den Rücken massieren.“"
                                            },
                                            {
                                                "example_id": "906d4e28-fcef-41dc-8cd8-eb43a64eda3d",
                                                "sense_id": "b827fa92-cd9c-3432-83f2-e92415e622b5",
                                                "text": "„Befremdlich ist jedoch, dass FDP-Chef Christian Lindner öffentlich genau diese Planspiele in den Wochen vor dem Ampel-Aus immer wieder deutlich zurückwies.“"
                                            },
                                            {
                                                "example_id": "2b5a3292-f09f-4adb-b693-2c53cd7e0fdd",
                                                "sense_id": "b827fa92-cd9c-3432-83f2-e92415e622b5",
                                                "text": "„Für einige ist es eine gesunde Art, mit der Einsamkeit im Winter umzugehen, für andere wirkt das Konzept befremdlich.“"
                                            },
                                            {
                                                "example_id": "eaeb3f9b-b46c-4bd2-b455-32e9df339793",
                                                "sense_id": "b827fa92-cd9c-3432-83f2-e92415e622b5",
                                                "text": "„Etwas befremdlich muten bei diesem Plädoyer die Umdeutung der Bekennden Kirche zur politischen Widerstandsorganisation und die Bewertung der Teilnahme an kirchlichen Veranstaltungen an, die zwar nach Artikel 39 BefrG als entlastendes Moment gewertet werden konnte, bei einem Pfarrer doch zu den selbstständlichen Berufspflichten gehörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
