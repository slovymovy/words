                "senses": [
                    {
                        "sense_id": "34d45a66-cc77-312e-9f43-796283115d22",
                        "entry_id": "0436437d-8999-3b79-b4f7-118bc8d1fb11",
                        "glosses": [
                            "Wort, das bei der maschinellen Informationssuche in Texten nicht berücksichtigt wird, da es sehr häufig auftritt und nicht direkt zum Inhalt beiträgt"
                        ],
                        "tags": [
                            "Information Retrieval"
                        ],
                        "examples": [
                            {
                                "example_id": "78103b10-a134-4085-96db-31afad635941",
                                "sense_id": "34d45a66-cc77-312e-9f43-796283115d22",
                                "text": "In deutschen Texten werden vor allem Artikel wie „die“, Präpositionen wie „in“ und Konjunktionen wie „und“ als Stoppwörter behandelt."
                            },
                            {
                                "example_id": "9bbcb5fe-b6a8-4127-8814-5298dc556c0b",
                                "sense_id": "34d45a66-cc77-312e-9f43-796283115d22",
                                "text": "„Das Weglassen von Stoppwörtern dient der Steigerung der Effizienz von Suchmaschinen. Würde man Stoppwörter bei einem Suchauftrag beachten, würde die Ergebnismenge nahezu jedes Dokument des Bestandes enthalten. Das Suchergebnis wäre unscharf, sein Nutzwert gering.“"
                            },
                            {
                                "example_id": "3ef70c08-7edf-467b-bb47-a6a41314d28f",
                                "sense_id": "34d45a66-cc77-312e-9f43-796283115d22",
                                "text": "„Obwohl der Volltextindex die Inklusion von Stoppwörtern ignoriert, berücksichtigt er ihre Position.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
