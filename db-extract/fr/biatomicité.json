                "senses": [
                    {
                        "sense_id": "98d94796-2dff-3f2d-9c22-dd5ee75d2001",
                        "entry_id": "89acc070-268e-33e8-93fc-0fe29bef896f",
                        "glosses": [
                            "Qualité d’une molécule biatomique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db11e0e-600f-40c7-a43f-1e1b6ad77e8a",
                                "sense_id": "98d94796-2dff-3f2d-9c22-dd5ee75d2001",
                                "text": "La biatomicité de l’oxygène lui confère une grande volatilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "04415ceb-ca43-34ca-8850-3992842464b9",
                        "entry_id": "89acc070-268e-33e8-93fc-0fe29bef896f",
                        "glosses": [
                            "Qualité d’un atome ayant la capacité de former des liaisons simples avec un ou deux autres atomes compatibles, ou d'accepter une liaison double ou même triple avec un autre atome."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fba8303e-359e-4f13-8034-0b3159a6300c",
                                "sense_id": "04415ceb-ca43-34ca-8850-3992842464b9",
                                "text": "La biatomicité de l'oxygène se traduit par sa capacité de former deux liaisons simples avec d'autres atomes, comme avec l'hydrogène, ce qui nous donne une molécule d'eau (H₂O), ou avec lui-même (comme dans le cas de l'ozone, O₃), ou encore par sa capacité de former une liaison double, comme avec lui-même (i.e. l'oxygène moléculaire, i.e. O₂ ou O=O), ou même triple, comme avec le carbone (dans le monoxyde de carbone, CO)."
                            }
                        ]
                    }
