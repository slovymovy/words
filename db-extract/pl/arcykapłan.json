                "senses": [
                    {
                        "sense_id": "339c2b97-87da-3c27-831a-0fc4f75aa7a5",
                        "entry_id": "844f3143-14bd-3263-bb38-13a7543f142e",
                        "glosses": [
                            "najwyższy kapłan w bliskowschodnich kultach pogańskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b67e1899-52e4-44a7-a4e7-aebe5f33958b",
                                "sense_id": "339c2b97-87da-3c27-831a-0fc4f75aa7a5",
                                "text": "W starożytnym Egipcie faraon zostawał jednocześnie arcykapłanem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "37127098-0c64-36da-8391-16a79c9eb9d2",
                        "entry_id": "844f3143-14bd-3263-bb38-13a7543f142e",
                        "glosses": [
                            "najwyższy urząd w świątyni jerozolimskiej, przełożony kapłanów i lewitów"
                        ],
                        "tags": [
                            "Jewish"
                        ],
                        "examples": [
                            {
                                "example_id": "4293cf89-7f40-4303-bda4-c632d7888104",
                                "sense_id": "37127098-0c64-36da-8391-16a79c9eb9d2",
                                "text": "Do stroju arcykapłana należały: efod, choszen i diadem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "59c9465e-b833-3100-8097-ee72dc5e6276",
                        "entry_id": "844f3143-14bd-3263-bb38-13a7543f142e",
                        "glosses": [
                            "w chrześcijaństwie tytuł jedynego pośrednika między Bogiem a ludźmi przysługujący Chrystusowi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6238d81a-71df-47ad-8282-dbb69dfc1db2",
                                "sense_id": "59c9465e-b833-3100-8097-ee72dc5e6276",
                                "text": "Chrystus jako jedyny arcykapłan zasiada po prawicy tronu Boga w niebiosach."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e64d8b5a-8599-48fe-9f99-d68e997132d2",
                        "source_entry_id": "844f3143-14bd-3263-bb38-13a7543f142e",
                        "source_sense_id": "339c2b97-87da-3c27-831a-0fc4f75aa7a5",
                        "target_lang_word": "high priest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "high priest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fcea893-16f0-3716-a1d0-bc9fdff4d2db",
                                        "entry_id": "8a39969b-25be-3195-8b89-d5bebda13e83",
                                        "glosses": [
                                            "A clergyman with a higher function than a normal priest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cbc60e4-dcb7-3656-b9de-47613b185392",
                                        "entry_id": "8a39969b-25be-3195-8b89-d5bebda13e83",
                                        "glosses": [
                                            "In the Bible, the male individual who was responsible for making the annual sacrifice on the Day of Atonement (Yom Kippur); always a descendant of Aaron, the older brother of Moses. See Kohen Gadol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "993398bb-cd7f-3ccb-b468-0a9553dba1ac",
                                        "entry_id": "8a39969b-25be-3195-8b89-d5bebda13e83",
                                        "glosses": [
                                            "Jesus Christ."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e58bdb22-e3a6-331c-8605-ec93fda2b4d2",
                                        "entry_id": "8a39969b-25be-3195-8b89-d5bebda13e83",
                                        "glosses": [
                                            "The second-lowest office in the Melchizedek priesthood."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd1c25a2-ea76-4ac5-908b-007e66e2fee2",
                                                "sense_id": "e58bdb22-e3a6-331c-8605-ec93fda2b4d2",
                                                "text": "Jake was ordained a high priest when he was called to be a counselor in a bishopric."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34b533cb-a948-394a-a3b3-94a5894c5fa9",
                                        "entry_id": "8a39969b-25be-3195-8b89-d5bebda13e83",
                                        "glosses": [
                                            "A person holding a position of power or influence; an authority in a field of study, doctrine, art or a movement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2172bce-07d3-439f-aa0e-ba2418a9e8a6",
                                                "sense_id": "34b533cb-a948-394a-a3b3-94a5894c5fa9",
                                                "text": "The global economic collapse of 2007-2008 discredited “rational expectations” economics (though its high priests have yet to recognize this) and brought both Keynes and Hayek back into posthumous contention."
                                            },
                                            {
                                                "example_id": "bbb69aa2-8993-4499-86df-3620ff5ff1d2",
                                                "sense_id": "34b533cb-a948-394a-a3b3-94a5894c5fa9",
                                                "text": "He perorated in a distinctly disturbed, and disturbing, manner, at least for a CIA high priest: “Technology is moving faster than government or law can keep up. It’s moving faster … than you can keep up: you should be asking the question of what are your rights and who owns your data.”"
                                            },
                                            {
                                                "example_id": "53d178a6-a09a-424f-86b0-83c528dc349e",
                                                "sense_id": "34b533cb-a948-394a-a3b3-94a5894c5fa9",
                                                "text": "The high priest of US arms controllers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a31dd35-0ae6-3da7-82f0-1ba49e6943cc",
                                        "entry_id": "8a39969b-25be-3195-8b89-d5bebda13e83",
                                        "glosses": [
                                            "A second or third degree male witch in Wicca."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
