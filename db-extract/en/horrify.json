                        "glosses": [
                            "To cause to feel extreme apprehension or unease; to cause to experience horror."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890326a0-6544-4029-bde1-b6cc973188cf",
                                "sense_id": "d98f10fe-6419-3ee5-b73a-acd2ddabd82d",
                                "text": "The haunted house horrified me, as I passed from one room to the next feeling more and more like I wasn’t going to survive."
                            }
                        ]
                    }
                ],
