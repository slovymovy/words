                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da9e2b36-e309-439d-9237-34d67ed681f6",
                                "sense_id": "3a9a1439-2041-37fe-bc31-fae604d3f3a7",
                                "text": "De kapitein riep alleman aan dek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81379dc6-0cc3-4067-a5bc-e655a6228cd9",
                        "source_entry_id": "d5284911-6276-336e-8a14-a96ebae8f002",
                        "source_sense_id": "3a9a1439-2041-37fe-bc31-fae604d3f3a7",
                        "target_lang_word": "each",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "each",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f8150e3-8bbb-32ea-aaea-d0483a3749d1",
                                        "entry_id": "9768df2a-9034-3c06-948f-3dba798d00cd",
                                        "glosses": [
                                            "All; every; qualifying a singular noun, indicating all examples of the thing so named seen as individual or separate items (compare every)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d36b6d9a-b751-4713-8c89-e900967c910f",
                                                "sense_id": "3f8150e3-8bbb-32ea-aaea-d0483a3749d1",
                                                "text": "Make sure you wash each bowl well."
                                            },
                                            {
                                                "example_id": "725ae0e4-1589-4d94-b3ad-168ce6438fd8",
                                                "sense_id": "3f8150e3-8bbb-32ea-aaea-d0483a3749d1",
                                                "text": "The sun comes up each morning and sets each night."
                                            },
                                            {
                                                "example_id": "07a55c63-3d28-42a6-9661-b9f776d6124f",
                                                "sense_id": "3f8150e3-8bbb-32ea-aaea-d0483a3749d1",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "each",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee69d198-1429-38f2-84ee-823558737f36",
                                        "entry_id": "6e997c9c-3174-320b-97e7-2c32286ac869",
                                        "glosses": [
                                            "For one; apiece; per."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cef53c9-cc85-4ab5-9740-65c4d57e6889",
                                                "sense_id": "ee69d198-1429-38f2-84ee-823558737f36",
                                                "text": "The apples cost 50 cents each."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26586dd7-1538-38a8-a7c9-57cee694d739",
                                        "entry_id": "6e997c9c-3174-320b-97e7-2c32286ac869",
                                        "glosses": [
                                            "Individually; separately; used in a sentence with a plural subject to indicate that the action or state described by the verb applies to all members of the described group individually, rather than collectively to the entire group."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "451a5e0d-04d0-4548-80ee-a3920c56ced2",
                                                "sense_id": "26586dd7-1538-38a8-a7c9-57cee694d739",
                                                "text": "We ordered half a chicken each, but we each got a whole one."
                                            },
                                            {
                                                "example_id": "cc3d3548-3fa9-4754-9be3-b68dddf6dc3b",
                                                "sense_id": "26586dd7-1538-38a8-a7c9-57cee694d739",
                                                "text": "You are each right in a different way."
                                            },
                                            {
                                                "example_id": "5fcb04cf-44ba-4892-aea2-10aa951436e2",
                                                "sense_id": "26586dd7-1538-38a8-a7c9-57cee694d739",
                                                "text": "There are three of us and we have five dollars each, so that means we've got 15 dollars."
                                            },
                                            {
                                                "example_id": "27e0e961-17fc-40d2-b6c4-6f5a6b5ab47e",
                                                "sense_id": "26586dd7-1538-38a8-a7c9-57cee694d739",
                                                "text": "The apartments each boast central heating."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "each",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19e12767-85bf-3f9c-a80a-789040e1cf37",
                                        "entry_id": "10062892-f4de-3dda-948e-91b3c200b55b",
                                        "glosses": [
                                            "Every one/thing individually or one by one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf0a1bc-6024-46b1-8dd9-0c6b85f2a5cb",
                                                "sense_id": "19e12767-85bf-3f9c-a80a-789040e1cf37",
                                                "text": "I'm going to give each of you a chance to win."
                                            },
                                            {
                                                "example_id": "16cf3f6f-d568-4c9a-bd4b-8d79bf49d166",
                                                "sense_id": "19e12767-85bf-3f9c-a80a-789040e1cf37",
                                                "text": "From each according to his ability, to each according to his needs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "each",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5053d4e5-836c-3b5e-8269-3d3e5816744e",
                                        "entry_id": "78ee1a00-f12b-3ede-88d5-ec1bbb4b25e9",
                                        "glosses": [
                                            "An individual item: the least quantitative unit in a grouping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7de0864-4a82-47ea-896b-aab8317d5bdf",
                                                "sense_id": "5053d4e5-836c-3b5e-8269-3d3e5816744e",
                                                "text": "In one embodiment, there is an additional charge when ordering products as an “each” compared to the unit cost of the item when ordered by the case."
                                            },
                                            {
                                                "example_id": "89a2b2f3-36d5-4c62-ae02-f89265a8ad85",
                                                "sense_id": "5053d4e5-836c-3b5e-8269-3d3e5816744e",
                                                "text": "An each, piece, single item, or individual item package."
                                            },
                                            {
                                                "example_id": "9b5cbb6b-97f1-43f5-b6f6-974f762bb608",
                                                "sense_id": "5053d4e5-836c-3b5e-8269-3d3e5816744e",
                                                "text": "The commonly used term “each” means that each individual item is one unit."
                                            },
                                            {
                                                "example_id": "5491e4f9-f47b-4936-9304-011fcdd0225f",
                                                "sense_id": "5053d4e5-836c-3b5e-8269-3d3e5816744e",
                                                "text": "Amour-propre would be able to take an interest in assuming the standpoint of reason, then, if applying 'each' to oneself in rational deliberation were simultaneously bound up with publicly establishing oneself as an 'each'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ece5d809-ff0f-4440-bf4c-290ba3700cf3",
                        "source_entry_id": "d5284911-6276-336e-8a14-a96ebae8f002",
                        "source_sense_id": "3a9a1439-2041-37fe-bc31-fae604d3f3a7",
                        "target_lang_word": "every",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "every",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                        "entry_id": "731a71f7-e1d1-379a-846d-a13d99afc167",
                                        "glosses": [
                                            "All of a countable group (considered individually), without exception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47903944-9c0c-4c92-86be-279fe5125118",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "Every person in the room stood and cheered."
                                            },
                                            {
                                                "example_id": "8fa1aa24-f8e4-4dc9-8869-d24962974f17",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "She watches my every move."
                                            },
                                            {
                                                "example_id": "299213ee-6470-4ede-933f-8efb6b8b55bb",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "At half-past nine on this Saturday evening, the parlour of the Salutation Inn, High Holborn, contained most of its customary visitors.[…]In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass."
                                            },
                                            {
                                                "example_id": "8e4b3d5d-83c1-4f2e-a0b8-55f0b999af3a",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            },
                                            {
                                                "example_id": "1d2cad47-8430-47e4-8e57-a525b99c67f9",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                        "entry_id": "731a71f7-e1d1-379a-846d-a13d99afc167",
                                        "glosses": [
                                            "Denotes equal spacing at a stated interval, or a proportion corresponding to such a spacing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf634cc-b9f5-4c24-a07d-bb50ce411679",
                                                "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                                "text": "We stopped for refreshments every ten miles."
                                            },
                                            {
                                                "example_id": "3b0d83d0-26d5-4ea5-b625-df80badd5913",
                                                "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                                "text": "The alarm is going off every few minutes."
                                            },
                                            {
                                                "example_id": "dd74ff4b-e5fb-4afe-b2ec-20f814c5e853",
                                                "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                                "text": "Every third bead was red, and the rest were blue. The sequence was thus red, blue, blue, red, blue, blue etc."
                                            },
                                            {
                                                "example_id": "ad0b7490-c321-4115-afdd-0f594706d51d",
                                                "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                                "text": "Decimation originally meant the execution of every tenth soldier in a unit; that is, ten per cent of soldiers were killed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                        "entry_id": "731a71f7-e1d1-379a-846d-a13d99afc167",
                                        "glosses": [
                                            "Denotes an abundance of something."
                                        ],
                                        "tags": [
                                            "with certain nouns"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33887e7d-0df7-4a39-ae6a-a039e26fd52a",
                                                "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                                "text": "We wish you every happiness in the future."
                                            },
                                            {
                                                "example_id": "27d13695-3867-4867-bcd4-7140cc48f6b6",
                                                "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                                "text": "He shows every sign of becoming an excellent player. I have every confidence in him."
                                            },
                                            {
                                                "example_id": "29e80e82-f29e-4ca3-9025-bb6a651e36c2",
                                                "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                                "text": "There is every reason why we shouldn't."
                                            },
                                            {
                                                "example_id": "491d8fa7-2f76-432b-bc97-d99ca965edc6",
                                                "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                                "text": "The police will make every effort to trace the missing girl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b3e059-e320-4c0d-a452-e26769a0a645",
                        "source_entry_id": "d5284911-6276-336e-8a14-a96ebae8f002",
                        "source_sense_id": "3a9a1439-2041-37fe-bc31-fae604d3f3a7",
                        "target_lang_word": "every one",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "every one",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "294d5fa9-07dc-354f-8ef4-39d12b947028",
                                        "entry_id": "a184531f-aa3f-32c6-bd32-cfa139bbd6b8",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see every, one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1401a6-285e-4397-89fe-6ac14a7d7618",
                                                "sense_id": "294d5fa9-07dc-354f-8ef4-39d12b947028",
                                                "text": "There were three hamburgers and every one (of them) was delicious."
                                            },
                                            {
                                                "example_id": "0e43222d-1c55-46ce-97f5-48ccf19c5dbb",
                                                "sense_id": "294d5fa9-07dc-354f-8ef4-39d12b947028",
                                                "text": "There were three patients and she helped every one [of them]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73c47fa-f455-306a-bd27-2fe57d5b92b4",
                                        "entry_id": "a184531f-aa3f-32c6-bd32-cfa139bbd6b8",
                                        "glosses": [
                                            "Archaic form of everyone."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f7b091c-3d01-4a67-ab5f-b73404347348",
                                                "sense_id": "c73c47fa-f455-306a-bd27-2fe57d5b92b4",
                                                "text": "[…] that Elinor’s merit should not be acknowledged by every one who knew her, was to her comprehension impossible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70d090ee-52a1-478c-bd18-815faa48e3a5",
                        "source_entry_id": "d5284911-6276-336e-8a14-a96ebae8f002",
                        "source_sense_id": "3a9a1439-2041-37fe-bc31-fae604d3f3a7",
                        "target_lang_word": "everybody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "everybody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d28fb094-324f-371f-8e16-9844732a61ff",
                                        "entry_id": "04462f4d-4e69-33a0-873b-12cab5040666",
                                        "glosses": [
                                            "All people."
                                        ],
                                        "tags": [
                                            "indefinite",
                                            "pronoun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6fd6f57-581c-4730-8fdd-601a5d908c07",
                                                "sense_id": "d28fb094-324f-371f-8e16-9844732a61ff",
                                                "text": "Does everybody have their ticket(s) at hand?"
                                            },
                                            {
                                                "example_id": "1f433952-009c-4483-bf71-d4eb54de2f84",
                                                "sense_id": "d28fb094-324f-371f-8e16-9844732a61ff",
                                                "text": "Selwyn, sitting up rumpled and cross-legged on the floor, after having boloed Drina to everybody's exquisite satisfaction, looked around at the sudden rustle of skirts to catch a glimpse of a vanishing figure—a glimmer of ruddy hair and the white curve of a youthful face, half-buried in a muff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7b2cb45-fdfd-4af0-acc5-45a9b87df907",
                        "source_entry_id": "d5284911-6276-336e-8a14-a96ebae8f002",
                        "source_sense_id": "3a9a1439-2041-37fe-bc31-fae604d3f3a7",
                        "target_lang_word": "everyone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "everyone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb22043-e421-3baf-9b8d-b89abaf9db74",
                                        "entry_id": "900017cf-2cdf-3847-82ad-f653289c17db",
                                        "glosses": [
                                            "Every person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "690048ef-5c9c-4e9e-8119-8330512a54aa",
                                                "sense_id": "cbb22043-e421-3baf-9b8d-b89abaf9db74",
                                                "text": "She was really hungry, so the chicken and tarts served to divert her attention for a time. It was well I secured this forage; or both she, I and Sophie, to whom I conveyed a share of our repast, would have run a chance of getting no dinner at all: every one down stairs was too much engaged to think of us."
                                            },
                                            {
                                                "example_id": "138a8586-2885-4db3-9c0a-3cdebab86dc4",
                                                "sense_id": "cbb22043-e421-3baf-9b8d-b89abaf9db74",
                                                "text": "Everyone’s heart palpitated as Leo Dillon handed up the paper and everyone assumed an innocent face."
                                            },
                                            {
                                                "example_id": "b5526461-319c-45de-8b97-8f0e485df903",
                                                "sense_id": "cbb22043-e421-3baf-9b8d-b89abaf9db74",
                                                "text": "Hello, everyone!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
