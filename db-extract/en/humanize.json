                                    {
                                        "sense_id": "76fa35e7-6768-3806-8135-d60221f88df7",
                                        "entry_id": "e7298ac8-ebd5-3c6d-a37c-05e8caa093ed",
                                        "glosses": [
                                            "vermenschlichen; betrachten, als ob etwas ein Mensch wäre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50032658-b295-4390-bddd-218f99cf42e3",
                                                "sense_id": "76fa35e7-6768-3806-8135-d60221f88df7",
                                                "text": "Ovid humanisiert den Eros, indem er ihn sprechen lässt."
                                            },
                                            {
                                                "example_id": "a7339232-35d1-48c6-9316-e1dd806b2fcb",
                                                "sense_id": "76fa35e7-6768-3806-8135-d60221f88df7",
                                                "text": "Sie hatte eine übertriebene Neigung, ihren Hund zu humanisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0088c1fb-33fa-3be0-9caa-dbb758742fcf",
                                        "entry_id": "e7298ac8-ebd5-3c6d-a37c-05e8caa093ed",
                                        "glosses": [
                                            "so verändern, dass es zur Anwendung im Menschen kommen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e3959a-4fd6-4ca1-8c37-f60dcd26a9da",
                                                "sense_id": "0088c1fb-33fa-3be0-9caa-dbb758742fcf",
                                                "text": "Man versucht jetzt, bereits in Tieren existierende Antikörper zu humanisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
