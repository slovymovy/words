                        "examples": [
                            {
                                "example_id": "46b23164-3c04-402b-94f9-3658add7dc79",
                                "sense_id": "e1e33570-be3b-353f-99ed-2b6fc0443063",
                                "text": "Charles Cumberworth (1811-1852), Pierre-Charles Simart (1806-1858) et Gédéon Adolphe Casimir de Forceville-Duvette (1799-1886) sont tous trois à classer dans les antiquisants."
                            }
