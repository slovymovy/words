                "forms": [],
                "senses": [
                    {
                        "sense_id": "78175666-6434-3a96-8539-91920d504d62",
                        "entry_id": "01233f70-c1a5-343e-8dc7-d752cf5d3c5b",
                        "glosses": [
                            "Par parties, en partie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c63bc35a-9434-4297-a56b-ca3b39e22c3a",
                                "sense_id": "78175666-6434-3a96-8539-91920d504d62",
                                "text": "En outre, des bandes de mitrailleuses furent trouvées, entièrement ou partiellement garnies de balles explosibles."
                            },
                            {
                                "example_id": "6b2002d0-baff-4df8-b973-bcb024e8c928",
                                "sense_id": "78175666-6434-3a96-8539-91920d504d62",
                                "text": "L'odorat, qui a pour siège les poils olfactifs est, chez lui, rudimentaire, et partiellement inhibé par la vision."
                            },
                            {
                                "example_id": "52d4ed00-503f-4b65-bc9e-dad95a39b854",
                                "sense_id": "78175666-6434-3a96-8539-91920d504d62",
                                "text": "Il ne savait aucune des paroles du grand choral de Luther, mais il ouvrait toute grande sa bouche et émettait des sons vastes, graves et partiellement harmonieux…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04691503-365a-492e-8ddc-10124000bb39",
                        "source_entry_id": "01233f70-c1a5-343e-8dc7-d752cf5d3c5b",
                        "source_sense_id": "78175666-6434-3a96-8539-91920d504d62",
                        "target_lang_word": "teilweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teilweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "565a4f6c-3fe4-3cad-8044-07b6c2db08e1",
                                        "entry_id": "627ba789-7914-3ad7-8a68-9b5238f3e268",
                                        "glosses": [
                                            "in Teilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab69f5d9-58ee-47d5-a3b4-17c58e781774",
                                                "sense_id": "565a4f6c-3fe4-3cad-8044-07b6c2db08e1",
                                                "text": "„Bei so ungleichen … Darstellungen derselben Sache fällt es überhaupt schon schwer, sich der Wahrheit zu bemächtigen, die in allen teilweise versteckt, in keiner aber ganz … vorhanden ist.“"
                                            },
                                            {
                                                "example_id": "91368eaf-3458-453e-ab37-cf985561c0e9",
                                                "sense_id": "565a4f6c-3fe4-3cad-8044-07b6c2db08e1",
                                                "text": "„Der reich ausgestattete Band präsentiert nicht nur die Funde aus dem Römerlager und Außenposten, die teilweise bereits restauriert wurden, sondern bettet die Funde auch in die römisch-germanische Geschichte der Zeitenwende ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa9f5835-07d9-39d8-83d0-f06a0d47cdc6",
                                        "entry_id": "627ba789-7914-3ad7-8a68-9b5238f3e268",
                                        "glosses": [
                                            "zu einem Teil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b069a5a-ecb7-462f-812c-5cdc76a5114e",
                                                "sense_id": "aa9f5835-07d9-39d8-83d0-f06a0d47cdc6",
                                                "text": "Wir sind teilweise erfolgreich: die meisten der Aufgaben wurden erledigt, einige jedoch nicht."
                                            },
                                            {
                                                "example_id": "2283dfbc-a840-46ec-a5f9-0612d7c5d8cd",
                                                "sense_id": "aa9f5835-07d9-39d8-83d0-f06a0d47cdc6",
                                                "text": "„Denn für Frauen ist das Kraftfahrzeug eines von sehr vielen Accessoires und wird teilweise genau so gehandhabt wie beispielsweise die Handtasche:…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "85004fa7-5384-3ad7-ab82-2a33e4e165b1",
                                        "entry_id": "627ba789-7914-3ad7-8a68-9b5238f3e268",
                                        "glosses": [
                                            "manche davon, einige davon, in Teilen davon"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1c8c2ef-695e-4c3e-9585-a2275afd3068",
                                                "sense_id": "85004fa7-5384-3ad7-ab82-2a33e4e165b1",
                                                "text": "Bei dem Unfall wurden fünf Personen teilweise schwer verletzt. (Gemeint ist: Bei dem Unfall wurden fünf Personen verletzt, eine oder mehrere von ihnen schwer, aber niemand „teilweise schwer“.)"
                                            },
                                            {
                                                "example_id": "63cea309-b733-4585-b08e-0d6ac01006e1",
                                                "sense_id": "85004fa7-5384-3ad7-ab82-2a33e4e165b1",
                                                "text": "„Die frühen christlichen Gemeinden praktizierten in gewisser Weise eine »neue Gesellschaftsordnung« – teilweise sogar mit Gütergemeinschaft.“"
                                            },
                                            {
                                                "example_id": "f83b37b1-4f10-48d5-a20b-52c404221470",
                                                "sense_id": "85004fa7-5384-3ad7-ab82-2a33e4e165b1",
                                                "text": "In Nordrhein-Westfalen soll es heute teilweise regnen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "teilweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6c0eace-35ca-3cdd-b63d-c24ec565b86f",
                                        "entry_id": "84265b79-6312-3f37-8847-c9d9b7b616d2",
                                        "glosses": [
                                            "nur einen Teil (insbesondere einer Handlung) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb330c3-fca3-4434-a228-ebeec980b1b5",
                                                "sense_id": "f6c0eace-35ca-3cdd-b63d-c24ec565b86f",
                                                "text": "„Die besten Pflanzen wachsen in einem porösen Boden aus Lehm, Humus und grobem Sand, mit reichlich Feuchtigkeit während der Triebzeit und teilweisem Schatten, […]“"
                                            },
                                            {
                                                "example_id": "1158478b-9e72-4f40-ae4b-cbd8097e91c1",
                                                "sense_id": "f6c0eace-35ca-3cdd-b63d-c24ec565b86f",
                                                "text": "„Colletet hatte nämlich nicht bemerkt, dass G. Teshault ein Pseudonym und teilweises Anagramm für G. Deshautels ist und hatte in einigen Jugendgedichten Desautels, die unter diesem Pseudonym in den ruisseaux de Charles Fontaine erschienen, das Werk eines andern Dichters gesehen.“"
                                            },
                                            {
                                                "example_id": "e50057d3-6249-4066-b2f3-4f3999f16644",
                                                "sense_id": "f6c0eace-35ca-3cdd-b63d-c24ec565b86f",
                                                "text": "„Die Tränen wuchsen in seinen Augen, und in der teilweisen Dunkelheit glaubte er, die Gestalt eines jungen Mannes zu sehen, der unter einem regenschweren Baume stand.“"
                                            },
                                            {
                                                "example_id": "5a760074-889e-4440-920c-f38b560fae0f",
                                                "sense_id": "f6c0eace-35ca-3cdd-b63d-c24ec565b86f",
                                                "text": "„Möglich ist natürlich auch, beiden ein teilweises Recht zuzuerkennen; doch nur in der Weise, daß beide Teilrechte sich harmonisch ineinander fügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd9bc7e5-6d17-4125-b364-6cb33f726c1f",
                        "source_entry_id": "01233f70-c1a5-343e-8dc7-d752cf5d3c5b",
                        "source_sense_id": "78175666-6434-3a96-8539-91920d504d62",
