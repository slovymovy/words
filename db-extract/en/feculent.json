                        "cross_references": [
                            {
                                "target_word": "verschmutzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77735640-4ac0-390d-ba2c-cd01b6475ab9",
                                        "entry_id": "d3c6ecc0-3bda-3598-9f43-f9b695131c56",
                                        "glosses": [
                                            "Flecken, Dreck oder Schadstoffe aufweisend oder enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8093637a-63ad-453c-925c-b8abff6b3b90",
                                                "sense_id": "77735640-4ac0-390d-ba2c-cd01b6475ab9",
                                                "text": "Die Umweltschutzorganisation „Blacksmith Institute“ hat eine Liste der am meisten verschmutzten Orte der Welt veröffentlicht."
                                            },
                                            {
                                                "example_id": "8cf79697-8403-4588-9cea-adfcdce3712e",
                                                "sense_id": "77735640-4ac0-390d-ba2c-cd01b6475ab9",
                                                "text": "Neu Delhi liegt unter dichtem Smog begraben. Der indische Ärztebund hat deshalb nun den Notstand ausgerufen. Die verschmutzte Luft ist jedoch ein altbekanntes Problem."
                                            },
                                            {
                                                "example_id": "54928201-6120-4228-8e09-013275a900a3",
                                                "sense_id": "77735640-4ac0-390d-ba2c-cd01b6475ab9",
                                                "text": "Der Ganges in Indien gilt wegen hoher Belastung durch Müll und Giftstoffe als einer der am stärksten verschmutzten Flüsse der Welt."
                                            },
                                            {
                                                "example_id": "02ff5553-7621-4ef7-9572-b2ec7d145d33",
                                                "sense_id": "77735640-4ac0-390d-ba2c-cd01b6475ab9",
                                                "text": "[…] mit ambitionierten Projekten engagiert sie [die finnische John Nurminen Stiftung] sich auch für die Säuberung des weltweit am stärksten verschmutzten Gewässers – der Ostsee."
                                            },
                                            {
                                                "example_id": "fbd76f05-a1e3-4b3b-88c6-fe1dcd273632",
                                                "sense_id": "77735640-4ac0-390d-ba2c-cd01b6475ab9",
                                                "text": "Unter anderem kam auch das Umweltlöschfahrzeug der Berufsfeuerwehr Kaiserslautern zum Einsatz, welches die verschmutzte Fahrbahn reinigte."
                                            },
                                            {
                                                "example_id": "89aa7d64-923d-46c1-bfba-c133a82c5fbc",
                                                "sense_id": "77735640-4ac0-390d-ba2c-cd01b6475ab9",
                                                "text": "„Leicht und normal verschmutzte Buntwäsche wird meist bei 20 bis 30 °C und Weißwäsche in der Regel bereits bei 40 °C sauber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
