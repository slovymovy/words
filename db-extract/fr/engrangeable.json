                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78bd2358-f102-4eda-af75-f4f567522b45",
                                "sense_id": "320b9329-50f5-3a2f-8e80-c18f1d34e43a",
                                "text": "l’homme primitif, collecteur de nourriture à main préhensile, prit l’habitude ingénieuse de cuisiner, avec un aliment frais immédiatement consommable, un « aliment de base » toujours à disposition tel qu’une céréale engrangeable dans un grenier."
                            },
                            {
                                "example_id": "81d780ba-d9cd-40fb-8df1-160609ce5c5e",
                                "sense_id": "320b9329-50f5-3a2f-8e80-c18f1d34e43a",
                                "text": "elle suivait mes efforts, discutait avec moi de graines et de semis, se déclarait fière de nos récoltes. Du concret tout cela ; c’était palpable, pesable, engrangeable, consommable."
                            },
                            {
                                "example_id": "cccf5910-a154-443b-a939-0614aa79039f",
                                "sense_id": "320b9329-50f5-3a2f-8e80-c18f1d34e43a",
                                "text": "Le volume engrangeable dépend la masse d’eau à évaporer."
                            }
                        ]
