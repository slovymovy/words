                "senses": [
                    {
                        "sense_id": "cb786548-99fc-35b4-8d6f-32b9dc25f66c",
                        "entry_id": "907a3c9a-6f1c-379d-9776-02b601280dd5",
                        "glosses": [
                            "Heilige, die um für die Landwirtschaft günstiges Wetter zu erbitten oder Hungersnot abzuwenden angerufen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8066dab7-df43-4644-a21f-9d94b6e16d6b",
                                "sense_id": "cb786548-99fc-35b4-8d6f-32b9dc25f66c",
                                "text": "Die Figur auf dem Altar stellt wohl eine Wetterheilige dar."
                            },
                            {
                                "example_id": "665ec764-db25-4e46-8c11-715d75116366",
                                "sense_id": "cb786548-99fc-35b4-8d6f-32b9dc25f66c",
                                "text": "„Wer am 15. Mai zum Fest lädt, muss mit der „kalten Sophie“ rechnen. Und die Wetterheilige ließ die rund 2400 Blutreiter von Aach-Linz bis Zußdorf, die vielen Musikanten und Tausende von Zuschauern am Freitag frösteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
