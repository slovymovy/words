                                        "examples": [
                                            {
                                                "example_id": "ccc54dd1-aa61-4b8e-a6d0-86353fc7abcd",
                                                "sense_id": "9055e201-229c-3bf1-9322-95391fecc734",
                                                "text": "Les trente-trois tours ont aujourd’hui généralement un diamètre de trente centimètres."
                                            },
                                            {
                                                "example_id": "e7ffab89-c290-4f2f-a614-9b828e51d8c5",
                                                "sense_id": "9055e201-229c-3bf1-9322-95391fecc734",
                                                "text": "Puis très rapidement, dès 48, survient le microsillon. Columbia et Capitol déposent respectivement les brevets du 33 tours de dix pouces (25 cm) et le 45 tours de 7 pouces (17 cm)."
                                            }
                                        ]
