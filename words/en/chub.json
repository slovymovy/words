                    "frequency": "Low",
                    "semantic_group_id": "packaging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher sold the ground beef in a convenient plastic <w>chub</w>.",
                            "target_lang_translations": {
                                "fr": "Le boucher vendait la viande hachée dans un <w>boudin</w> en plastique pratique."
                            }
                        },
                        {
                            "text": "Make sure to refrigerate the meat <w>chub</w> immediately after returning from the grocery store.",
                            "target_lang_translations": {
                                "fr": "Assurez-vous de mettre le <w>boudin</w> de viande au réfrigérateur immédiatement après votre retour de l'épicerie."
                            }
