                ],
                "senses": [
                    {
                        "sense_id": "8964965a-2a79-3e69-8875-599f18a48c78",
                        "entry_id": "a7c55436-5cdc-3af8-8d0c-935e7a0cf8c9",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2770e6d-c4ec-4a95-81a3-a09c6258fec6",
                                "sense_id": "8964965a-2a79-3e69-8875-599f18a48c78",
                                "text": "Frau Pfitzenmaier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "576b2b20-eadc-433c-b3a0-3149ae504567",
                                "sense_id": "8964965a-2a79-3e69-8875-599f18a48c78",
                                "text": "Herr Pfitzenmaier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f1e14dcd-396f-448a-a13b-144599bdadc6",
                                "sense_id": "8964965a-2a79-3e69-8875-599f18a48c78",
                                "text": "Die Pfitzenmaiers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "64d42b09-b363-4d7b-897e-fc8dd881649c",
                                "sense_id": "8964965a-2a79-3e69-8875-599f18a48c78",
                                "text": "Der Pfitzenmaier trägt nie die Schals, die die Pfitzenmaier ihm strickt."
                            },
                            {
                                "example_id": "6d7ed224-3e95-4b03-b407-949110548251",
                                "sense_id": "8964965a-2a79-3e69-8875-599f18a48c78",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pfitzenmaier kommt, geht der Herr Pfitzenmaier.“"
                            },
                            {
                                "example_id": "9dbd3952-3a83-43f1-9112-127232a0b45f",
                                "sense_id": "8964965a-2a79-3e69-8875-599f18a48c78",
                                "text": "Pfitzenmaier kommt und geht."
                            },
                            {
                                "example_id": "c106c05c-e676-4d8f-9659-7d8bd469cc2a",
                                "sense_id": "8964965a-2a79-3e69-8875-599f18a48c78",
                                "text": "Pfitzenmaiers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
