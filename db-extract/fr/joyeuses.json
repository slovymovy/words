                "word_linkages": []
            },
            {
                "entry_id": "005bf191-9fd4-3c9e-9822-937b7e3dea90",
                "word": "joyeuses",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dbaa3901-dcd6-3821-a266-6c2a640a3334",
                        "entry_id": "005bf191-9fd4-3c9e-9822-937b7e3dea90",
                        "glosses": [
                            "Testicules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9016d00e-be72-44cb-8377-357be455f2a6",
                                "sense_id": "dbaa3901-dcd6-3821-a266-6c2a640a3334",
                                "text": "Son coup de savate non plus n’a pas atteint mes joyeuses."
                            },
                            {
                                "example_id": "a0c2b7a6-0e6e-41c3-98ac-4714fc8950be",
                                "sense_id": "dbaa3901-dcd6-3821-a266-6c2a640a3334",
                                "text": "C’est un yo-yo tout simplement, c’est un instrument qui servait aux Philippins pour chasser le petit gibier, et çà c’est ma botte dans tes joyeuses pour m’avoir manqué de respect !"
                            },
                            {
                                "example_id": "e10c1128-91ae-4e45-8965-bca199d726cb",
                                "sense_id": "dbaa3901-dcd6-3821-a266-6c2a640a3334",
                                "text": "Quand le Dr Shimkin (il m’a tout raconté après coup) sollicita un petit cadeau d’adieu de sa part, elle flanqua un grand coup de pied dans ses joyeuses haletantes."
                            }
                        ]
                    }
