                "senses": [
                    {
                        "sense_id": "dbea9a04-b2a9-376d-87c4-c3c262282738",
                        "entry_id": "1d0b6676-0d2d-32b3-b86a-c8e90d872541",
                        "glosses": [
                            "związany z Jutlandią, dotyczący Jutlandii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12666af-07bd-4e54-9976-6f53900752da",
                                "sense_id": "dbea9a04-b2a9-376d-87c4-c3c262282738",
                                "text": "Malownicze zielone lasy, wzgórza, wydmy i zamglone plaże sprawiły, że jutlandzki krajobraz stał się inspiracją dla wielu pokoleń artystów."
                            },
                            {
                                "example_id": "12318b1f-602d-4154-a668-bb6710c39b0b",
                                "sense_id": "dbea9a04-b2a9-376d-87c4-c3c262282738",
                                "text": "Personel nie rozumie ani zelandzkiego, ani jutlandzkiego. Nigdy więcej tam nie przyjdę i mogę tylko polecić, aby trzymać się z dala od tego miejsca."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
