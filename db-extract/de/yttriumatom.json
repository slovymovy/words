                ],
                "senses": [
                    {
                        "sense_id": "81c7a872-4630-377c-914c-d1dd12cf94f3",
                        "entry_id": "7de9ec2e-30ec-359f-b2cc-7211adb97c9d",
                        "glosses": [
                            "Atom des Elements Yttrium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2fce46-130a-4e85-8257-e41e38635be1",
                                "sense_id": "81c7a872-4630-377c-914c-d1dd12cf94f3",
                                "text": "„Hier wird zwar je ein Calciumatom durch ein Yttriumatom ersetzt, aber für die Fluoratome müssen neue Punktlagen gefunden werden.“"
                            },
                            {
                                "example_id": "033cb0dc-258f-45c1-927f-4bb9cd50bed0",
                                "sense_id": "81c7a872-4630-377c-914c-d1dd12cf94f3",
                                "text": "„Es wird gezeigt, daß das Monoxyd sehr beständig ist und im Flammenbogen neben dem neutralen und ionisierten Yttriumatom existieren kann.“"
                            },
                            {
                                "example_id": "3f13c874-d480-4ecc-a960-af45ee4b15da",
                                "sense_id": "81c7a872-4630-377c-914c-d1dd12cf94f3",
                                "text": "„Aber das Yttriumatom ist kompliziert. Es ist ein Element der seltenen Erden, und sein magnetisches Moment enthält einen Beitrag von der Bahnbewegung der Elektronen.“"
                            },
                            {
                                "example_id": "59d4fc5e-6a0b-4f48-87d4-1ab8ffe507c3",
                                "sense_id": "81c7a872-4630-377c-914c-d1dd12cf94f3",
                                "text": "„Außerdem werden die Sauerstoffatome in der (a,b)-Ebene, die die Yttriumatome enthält, entfernt, wodurch die dreidimensionale Vernetzung der CuO6-Oktaeder zerstört wird und […]“"
                            },
                            {
                                "example_id": "a056aa6f-3801-40d6-b8e4-7feaf56f71c2",
                                "sense_id": "81c7a872-4630-377c-914c-d1dd12cf94f3",
                                "text": "„Einer der vielversprechendsten Kandidaten ist Yttriumsilber, eine intermetallische Verbindung, bei der Silber- und Yttriumatoome in genau gleicher Häufigkeit vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
