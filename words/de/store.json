                {
                    "sense_id": "bbc4c9e0-dd8a-3f9f-b22b-97eacfe1459b",
                    "sense_definition": "Geschäft oder Laden, in dem man Waren einkaufen kann.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die bekannte Modemarke eröffnet nächste Woche einen neuen <w>Store</w> in der Innenstadt."
                        },
                        {
                            "text": "Ich habe die Schuhe direkt im <w>Store</w> des Herstellers anprobiert."
                        }
                    ],
                    "common_phrases": [
                        "im Store kaufen",
                        "neuer Store"
                    ],
                    "synonyms": [
                        "Laden",
                        "Geschäft"
                    ]
                },
                {
                    "sense_id": "9b399b5c-4119-39b1-9c9d-36d2038de4f6",
                    "sense_definition": "Halbdurchsichtige Untergardine vor Fenstern als Sicht- oder Lichtschutz.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fensterschutz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch den feinen <w>Store</w> am Wohnzimmerfenster fällt am Nachmittag sanftes Licht in den Raum."
                        },
                        {
                            "text": "Zur Dekoration kombiniert man oft schwere Vorhänge mit einem leichten <w>Store</w>."
                        }
                    ],
                    "common_phrases": [
