                "senses": [
                    {
                        "sense_id": "3ec5a68a-76ad-3118-8039-317212eba3bc",
                        "entry_id": "0088ce9a-0af5-3cd8-89ce-0f85b7bf832f",
                        "glosses": [
                            "To graze; (leatherworking) to remove the outer surface of (a skin) with a knife."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b9507eda-ffb8-4231-8bf0-632a8f746b48",
                                "sense_id": "3ec5a68a-76ad-3118-8039-317212eba3bc",
                                "text": "Chamois or Shamoy leather.—The skins are first washed, limed, fleeced, and branned as above described. They are next efflowered, that is, deprived of their epidermis by a concave knife, blunt in its middle part, upon the convex horse-beam."
                            },
                            {
                                "example_id": "44eedaf8-96fc-478d-b56b-9aff33e33180",
                                "sense_id": "3ec5a68a-76ad-3118-8039-317212eba3bc",
                                "text": "In the pregnant bounds / Of delicatest breath, that but efflowers the ear / And lapses into nothingness[.]"
                            },
                            {
                                "example_id": "66e51165-27cd-470e-b8ee-3ddb929d1477",
                                "sense_id": "3ec5a68a-76ad-3118-8039-317212eba3bc",
                                "text": "Chamois leather—The skin of the Alpine goat of that name, which has been “efflowered” or deprived of the epidermis."
                            }
                        ]
                    }
