                    {
                        "translation_id": "5ec6af29-f62e-4661-b38c-38eab5a13f86",
                        "source_entry_id": "61ad9015-86aa-33eb-98f5-064ecd4c7ef6",
                        "source_sense_id": "9cfb3f08-f8cf-36d1-b902-b8cb7a2c13e3",
                        "source_sense_description": "cirkel van gelijke geografische breedten",
                        "target_lang_word": "latitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5eaee796-8a7c-3981-87f8-ab33cd4e2058",
                                        "entry_id": "aa283d15-77a2-31e8-9ac3-8ba534b72d8c",
                                        "glosses": [
                                            "The angular distance north or south from a planet's equator, measured along the meridian of that particular point."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1de3383-61de-4a06-91fa-3a37fc54c8c4",
                                                "sense_id": "5eaee796-8a7c-3981-87f8-ab33cd4e2058",
                                                "text": "The oat is hardier than wheat, and ripens in higher latitudes."
                                            },
                                            {
                                                "example_id": "05b776ba-dc79-41b4-972c-15cbe28a6c3c",
                                                "sense_id": "5eaee796-8a7c-3981-87f8-ab33cd4e2058",
                                                "text": "Far from the center of Shang civilization, Wu-ch'eng is located well south of the Yangtze at approximately the same latitude as Ch'ang-sha in the west and Wen-chou in the east."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9ff0ed7-ef91-38be-8768-bbf91121883e",
                                        "entry_id": "aa283d15-77a2-31e8-9ac3-8ba534b72d8c",
                                        "glosses": [
                                            "An imaginary line (in the form of a circumference) around a planet running parallel to the planet's equator."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8cd781d-00c8-3bce-88ac-f644a4fcf48f",
                                        "entry_id": "aa283d15-77a2-31e8-9ac3-8ba534b72d8c",
                                        "glosses": [
                                            "The relative freedom from restrictions; scope to do something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606ab28c-abac-4559-81d4-0f0b57d0f109",
                                                "sense_id": "e8cd781d-00c8-3bce-88ac-f644a4fcf48f",
                                                "text": "His parents gave him a great deal of latitude."
                                            },
                                            {
                                                "example_id": "0c1a3447-5c55-4164-a14a-15918498cfe1",
                                                "sense_id": "e8cd781d-00c8-3bce-88ac-f644a4fcf48f",
                                                "text": "\"Love!\" ejaculated the Comtesse; \"And so throw away the chances of a life upon a month of honey!—I say a month, which is allowing a latitude tenderness never took..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a92d8b41-fe31-33f2-9c07-7793bcd67a18",
                                        "entry_id": "aa283d15-77a2-31e8-9ac3-8ba534b72d8c",
                                        "glosses": [
                                            "The angular distance of a heavenly body from the ecliptic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "341b6784-204b-3970-9f7c-910acfb4ecb4",
                                        "entry_id": "aa283d15-77a2-31e8-9ac3-8ba534b72d8c",
                                        "glosses": [
                                            "The extent to which a light-sensitive material can be over- or underexposed and still achieve an acceptable result."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9a4a810-1fa6-3d7b-88d9-d9d38ef6e0f8",
                                        "entry_id": "aa283d15-77a2-31e8-9ac3-8ba534b72d8c",
                                        "glosses": [
                                            "Extent or scope; e.g. breadth, width or amplitude."
                                        ],
                                        "tags": [
                                            "countable",
