                    {
                        "sense_id": "d450444b-4c4d-34dc-9ef4-a45e1a16c0b0",
                        "entry_id": "dac8711d-6385-3839-8db4-81eb014f47b4",
                        "glosses": [
                            "the Jewish establishment of the eastern United States"
                        ],
                        "tags": [
                            "derogatory",
