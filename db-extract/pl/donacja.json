                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09fd51b7-77b3-3a82-a5e1-36ca2e2389a3",
                                        "entry_id": "55232eff-8166-3ac1-ad5e-068544516f68",
                                        "glosses": [
                                            "A voluntary gift or contribution for a specific cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e57b1b9-6baf-4a61-b3a3-26de24600b26",
                                                "sense_id": "09fd51b7-77b3-3a82-a5e1-36ca2e2389a3",
                                                "text": "They were collecting donations for the elderly at Christmas."
                                            },
                                            {
                                                "example_id": "4c3530a2-a5ff-498a-aaa3-73b0a2183fed",
                                                "sense_id": "09fd51b7-77b3-3a82-a5e1-36ca2e2389a3",
                                                "text": "And some donation freely to estate\nOn the bless'd lovers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51147776-63f3-3805-9824-a61432f1af53",
                                        "entry_id": "55232eff-8166-3ac1-ad5e-068544516f68",
                                        "glosses": [
                                            "The act of giving or bestowing; a grant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbef01c3-5e76-4076-8da8-888a17a260b5",
                                                "sense_id": "51147776-63f3-3805-9824-a61432f1af53",
                                                "text": "After donation there is an absolute change and alienation of the property of the thing given."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beb88659-b0ef-40e9-9d80-d944fc1006b8",
                        "source_entry_id": "cbeaf8a4-053e-3426-8820-f6e5720545a4",
                        "source_sense_id": "ca07b8f0-902b-35e2-ae36-d7c4a18fd4ac",
                        "target_lang_word": "donation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                        "entry_id": "5c832cfb-a6dd-30c0-9003-2fc09ad5cfec",
                                        "glosses": [
                                            "Don qui se fait par acte public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48447ca2-b75d-4d35-90e5-70bc21c7c298",
                                                "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                                "text": "Nous parlions de drame, ah ! je vous assure que si nous pouvions dire le secret de certaines donations, nos auteurs pourraient en faire de terribles tragédies bourgeoises."
                                            },
                                            {
                                                "example_id": "da998cac-a405-4a08-995c-d6b394eb101c",
                                                "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                                "text": "[…], par conséquent, il y a eu concours des volontés et réalisation de la donation le jour où la chose, offerte par le donateur (en la personne de son mandataire), a été acceptée par le donataire en personne."
                                            },
                                            {
                                                "example_id": "f3d95a30-4c30-4937-af2e-668e3d5c5993",
                                                "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                                "text": "Le 14 mars 1775, Louis-Alexandre d'Auger, par donation entre vifs et en avancement d’hoirie, laissait les 7/8 de Belestre à son fils Pierre-Alexandre, et celui-ci en faisait foi et hommage le 31 mai 1775."
                                            },
                                            {
                                                "example_id": "886cf2ac-5b3e-49dc-a737-65ea843aa5f4",
                                                "sense_id": "8a7d164b-5a61-3ccc-9c79-06b74c3535a3",
                                                "text": "III. Pour l'application du présent article, les donations entre vifs ne sont pas opposables à l'administration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf795ba-f0ef-394c-825d-45ff4c6e8e00",
                                        "entry_id": "5c832cfb-a6dd-30c0-9003-2fc09ad5cfec",
                                        "glosses": [
                                            "L’acte par lequel on fait une donation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "428d33c8-42b1-4ad4-9a74-3a57725033d7",
                                                "sense_id": "7cf795ba-f0ef-394c-825d-45ff4c6e8e00",
                                                "text": "[…] notre cité ne figure dans aucune des chartes de l'époque mérovingienne, dans aucune des donations des princes carolingiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
