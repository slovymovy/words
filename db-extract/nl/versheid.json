                    {
                        "sense_id": "e904049b-e9e4-381e-9967-69b95ce25d45",
                        "entry_id": "0cdb829e-e1e2-3f38-aea0-c68fc6532931",
                        "glosses": [
                            "de mate waarin een voedingsproduct vers is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f71e96a3-1084-45f0-9aeb-512129c7e1ae",
                                "sense_id": "e904049b-e9e4-381e-9967-69b95ce25d45",
                                "text": "Het protest in de Carrefour van Bergen is een mooi voorbeeld van de tegengestelde belangen van personeel en klanten. Voor de klanten zijn - behalve de prijs en de versheid van de producten - vooral comfort en snelheid cruciaal. Voor hen zijn technologische vooruitgang en automatisering dus een pluspunt. Voor de kassiersters, die niet meer zo talrijk nodig zijn, is het een achteruitgang."
                            },
                            {
                                "example_id": "257d65e3-b42d-4efa-a533-8f6677d56f27",
                                "sense_id": "e904049b-e9e4-381e-9967-69b95ce25d45",
                                "text": "Het draait allemaal om gemak, versheid en transparantie - alle ingrediënten en calorieën staan op de verpakking. Je kunt er terecht voor een meergranen wrap met gerookte kip, avocado, spinazie, peper en cashewsaus (€6) of een bietensalade met geitenkaas, linzen, courgette, limoen en munt (€3,50)."
                            }
                        ]
                    }
                ],
