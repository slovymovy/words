                        "entry_id": "1ccb6112-a4b1-33a9-a91d-7f40c6f9abbb",
                        "glosses": [
                            "A soft rock, rich in talc, also containing serpentine and either magnetite, dolomite or calcite."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e324a7c9-30bc-4f79-b003-677764bd1714",
                                "sense_id": "810e5067-eeb0-353f-bc43-dfe2ac493676",
                                "text": "To have a reliable fire, you'll need to carve a lamp from soapstone (you know what soapstone looks like, right?), render some oil for the lamp from blubber, and make a wick out of a particular species of moss."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce52f2f8-b4e8-3f0a-9c1d-6f08f25d0dd6",
                        "entry_id": "1ccb6112-a4b1-33a9-a91d-7f40c6f9abbb",
                        "glosses": [
                            "Synonym of saponite."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
