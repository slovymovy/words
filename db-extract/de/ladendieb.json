                    {
                        "sense_id": "bbcc02d3-51aa-31bc-9e81-1b377b11c1c4",
                        "entry_id": "d81fedf6-6d52-3d7a-aff7-430590e86c5a",
                        "glosses": [
                            "zloděj v obchodě"
                        ],
                        "tags": [
                            "který krade během prodejní doby"
                        ],
                        "examples": [
                            {
                                "example_id": "563dafa6-e338-46c1-8f70-3af5793c9239",
                                "sense_id": "bbcc02d3-51aa-31bc-9e81-1b377b11c1c4",
                                "text": "„Der schneidige Reynhard hat nicht viel Geld, er ist ein scharfer heller Kopf, aber unter den Ladendieben ein Anfänger, und darum mistet er Dietrich aus.“",
                                "translation": "Řízný Reinhard nemá moc peněz, je to ostrá hlava, ale mezi shopliftery začátečník a proto Ditricha vyhodil."
                            },
                            {
                                "example_id": "348358c3-d614-41a9-afcf-a9ec4ae7d051",
                                "sense_id": "bbcc02d3-51aa-31bc-9e81-1b377b11c1c4",
                                "text": "Im Vorbeigehen stieß der Ladendieb gegen den Passanten und entwendete ihm dabei seine Brieftasche.",
                                "translation": "Když kapesní zloděj míjel kolemjdoucího, vrazil do něj a odcizil mu přitom peněženku."
                            }
                        ]
                    }
