                "senses": [
                    {
                        "sense_id": "e0012a17-d861-38d5-9d94-a80fb8023a1b",
                        "entry_id": "4c319265-599c-3263-b920-83e8f68ca992",
                        "glosses": [
                            "Oxygéner plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69853e8d-75f8-41d6-9f78-38c860c5b2dc",
                                "sense_id": "e0012a17-d861-38d5-9d94-a80fb8023a1b",
                                "text": "On continue trop forcer ni sur les mouvements ni sur les durées (sans s’asphyxier ou se sur-oxygéner), le temps que l’on juge nécessaire."
                            },
                            {
                                "example_id": "a2c7ae31-804b-4b2f-ab93-9ad7d0caab5a",
                                "sense_id": "e0012a17-d861-38d5-9d94-a80fb8023a1b",
                                "text": "On lui retire l'hydrogène pour mieux la sur-oxygéner."
                            },
                            {
                                "example_id": "8729f753-756a-49cc-8e9b-87bf678f385c",
                                "sense_id": "e0012a17-d861-38d5-9d94-a80fb8023a1b",
                                "text": "Se sur-oxygéner pour une marche sans fatigue !"
                            }
                        ]
                    }
