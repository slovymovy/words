                "senses": [
                    {
                        "sense_id": "c923cbef-2ef8-3c80-8322-b528642bdd10",
                        "entry_id": "a456c6cd-450d-3587-8c1d-60a0a40e4151",
                        "glosses": [
                            "vorsichtiges, zögerliches Handeln aus Angst vor etwas Negativem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d72a603-ace8-447d-a95a-5ac4ea2b2075",
                                "sense_id": "c923cbef-2ef8-3c80-8322-b528642bdd10",
                                "text": "„Ängstliche Personen hingegen schrecken oft vor einer Überforderung zurück und zeigen ein Schonungsverhalten […].“"
                            },
                            {
                                "example_id": "29ac2685-a5aa-4a66-ab8e-452e745e6d56",
                                "sense_id": "c923cbef-2ef8-3c80-8322-b528642bdd10",
                                "text": "„In der Verhaltenstherapie kann der Patient lernen, körperliche Signale anders wahrzunehmen, Schonungsverhalten abzubauen und sein Verständnis von Gesundheit zu ändern.“"
                            },
                            {
                                "example_id": "077b7ab8-f6f7-4b08-9ddc-e0841821bb3a",
                                "sense_id": "c923cbef-2ef8-3c80-8322-b528642bdd10",
                                "text": "„Bauen Sie Ihr Vermeidungs- und Schonungsverhalten ab und nehmen Sie trotz aller anfänglichen Schwierigkeiten wieder Sozialkontakte auf.“"
                            },
                            {
                                "example_id": "89fec9b9-a717-443b-925b-37ff5fafebb9",
                                "sense_id": "c923cbef-2ef8-3c80-8322-b528642bdd10",
                                "text": "„Die Vermittlung von Bewältigungsstrategien im Umgang mit den Brustschmerzen, in der Regel Entspannungsstrategien, Atemtechniken und gestufte Steigerung von Aktivitäten bei Schonungsverhalten und angstbedingtem Vermeidungsverhalten.“"
                            },
                            {
                                "example_id": "80e59acf-e36e-4307-89df-ff8b423c85e6",
                                "sense_id": "c923cbef-2ef8-3c80-8322-b528642bdd10",
                                "text": "„Sie versuchen ihr Erziehungsverhalten rational zu erklären, Schutz- und Schonungsverhalten zu verschleiern oder zu leugnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
