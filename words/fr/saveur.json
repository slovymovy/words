                },
                {
                    "sense_id": "da541769-d087-3590-82f9-a63f3f9c5bad",
                    "sense_definition": "Caractère piquant, agréable ou original qui suscite l'intérêt de l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'anecdote racontée par l'auteur donne toute sa <w>saveur</w> à ce récit historique."
                        },
                        {
                            "text": "Sans un peu de risque, l'aventure perdrait toute sa <w>saveur</w> et son intérêt."
