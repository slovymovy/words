                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b787bf5-8d97-402e-a37d-c1bd4dfa1eb0",
                                "sense_id": "f10c9659-46d2-375c-8c6d-e686cf6656fd",
                                "text": "Początkowo medaliki te nazywano Medalikami Niepokalanego Poczęcia"
                            },
                            {
                                "example_id": "d2192b05-60e9-4ce6-ba83-a1adb756d021",
                                "sense_id": "f10c9659-46d2-375c-8c6d-e686cf6656fd",
                                "text": "Z masowego grobu w Katyniu wydobyto m.in. okrągłe medaliki chrzcielne i srebrne krzyżyki."
                            }
                        ],
