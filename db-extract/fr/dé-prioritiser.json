                ],
                "senses": [
                    {
                        "sense_id": "be9d6e6b-9714-3717-a3c1-d0094f0d3251",
                        "entry_id": "9fe38bf3-7ac4-30ed-bbe6-ad1fdd5a61de",
                        "glosses": [
                            "Abandonner la priorité qui avait été donnée à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f42da28-116b-4042-ac71-4700d3d50b45",
                                "sense_id": "be9d6e6b-9714-3717-a3c1-d0094f0d3251",
                                "text": "Une autre idée intéressante serait d’étudier le rôle que les effets de la santé mentale pourraient avoir sur les choix et les besoins des consommateurs, ce qu’ils pourraient dé-prioritiser en raison de leurs tendances et perceptions changeantes, et ce qu’ils attendraient d’outils et/ou de services spécifiques pour les aider."
                            },
                            {
                                "example_id": "fd92062d-bd02-4bb0-934a-cf1daee963da",
                                "sense_id": "be9d6e6b-9714-3717-a3c1-d0094f0d3251",
                                "text": "L’observation de la couche transport peut permettre d’identifier les services utilisés et d’en dé-prioritiser certains. Le chiffrement du transport peut donc aider à préserver la neutralité du réseau."
                            }
                        ]
                    }
                ],
