                        "sense_id": "f135157a-f935-30e2-ad6a-dc534341e1af",
                        "entry_id": "e3646a8a-78ba-3a0b-8b95-ee7d12292e99",
                        "glosses": [
                            "besserwisserisch sein; mit seinen Kenntnissen angeben"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "f8ab6666-7a29-4d03-a62c-b6601c827e44",
                                "sense_id": "f135157a-f935-30e2-ad6a-dc534341e1af",
                                "text": "Die meisten Wikipedianer klugscheißen gerne."
                            },
                            {
                                "example_id": "f2cd8c7b-758b-4cad-a28a-0dbaaaef25c8",
                                "sense_id": "f135157a-f935-30e2-ad6a-dc534341e1af",
                                "text": "Ich will jetzt nicht klugscheißen."
                            },
                            {
                                "example_id": "a73f35b4-f74c-489c-8940-bf10fc2c1b5c",
                                "sense_id": "f135157a-f935-30e2-ad6a-dc534341e1af",
                                "text": "„Der Unterschied aber lag darin, daß Beesendahl persönlich betroffen war und jeder Satz von ihm aus eigener Erfahrung kam, während Frank sich nur aufgespielt und kluggeschissen hatte.“"
                            },
                            {
                                "example_id": "03507b10-afaa-42ab-b986-cfc08012d0e5",
                                "sense_id": "f135157a-f935-30e2-ad6a-dc534341e1af",
                                "text": "[Anke Engelke:] »Ich kann auch super auf dem Sofa sitzen, faul sein und rülpsen wie Homer oder mich daneben benehmen wie Bart. Aber auch super klugscheißen wie Lisa.«"
                            },
                            {
                                "example_id": "310ff613-0458-404b-8806-48930a81724b",
                                "sense_id": "f135157a-f935-30e2-ad6a-dc534341e1af",
                                "text": "„‚Ich bin nicht nur ein einfaches Lehrerkind. Ich bin Lehrerkind Stufe 10!‘ Alle in der Familie sind Lehrer. Alle. Klugscheißen gehört da zur Familienfeier wie bei anderen die Geschenke unterm Christbaum.“"
                            },
                            {
                                "example_id": "c99f19ba-903f-4426-91a1-f1b9ae48cf4c",
                                "sense_id": "f135157a-f935-30e2-ad6a-dc534341e1af",
                                "text": "[Fußballländerspiel Niederlande gegen Deutschland:] „Und für alle, die vor Kollegen und Freunden klugscheißen wollen: Zoltan Sebescens erstes und einziges Länderspiel am 23. Februar 2000 in Amsterdam, das für den Deutschen schon nach 45 Minuten endete.“"
                            }
                        ],
