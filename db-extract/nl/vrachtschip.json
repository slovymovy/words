                        "translation_id": "549e31a7-9ae1-4d4e-ae62-edd1f891eb4f",
                        "source_entry_id": "c789fb23-798b-33dd-bab0-d63601932288",
                        "source_sense_id": "bf295dc9-288c-308d-bb07-4227fd348237",
                        "source_sense_description": "een schip dat uitsluitend bedoeld is voor het vervoer van goederen",
                        "target_lang_word": "Frachtschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frachtschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                        "entry_id": "0983c7d7-0ef0-36e2-a665-cfde615f6a4d",
                                        "glosses": [
                                            "ausschließlich Frachtgut transportierendes Schiff, sowohl in Binnengewässern als auch auf offener See verkehrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2240dd36-ef70-4c9a-bcca-0c1b171db63b",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "Das Frachtschiff wird erst morgen eintreffen."
                                            },
                                            {
                                                "example_id": "d4b2b256-8460-478a-a37a-93eb7d9910b7",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„An der Rolandsbrücke haben im 9. Jahrhundert die Frachtschiffe festgemacht, hier sitzt die Norddeutsche Vermögen, Kortüms Reederei.“"
                                            },
                                            {
                                                "example_id": "f075b629-5f5e-48cf-af69-97c6c5fd16b1",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Wir sitzen länger hier und sinnieren über die Ladung der Frachtschiffe.“"
                                            },
                                            {
                                                "example_id": "a6f0154c-b9fe-479a-a3e1-0d289ce8974d",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Frachtschiffe tuckerten zum Be- oder Entladen in Richtung Hafen, die ersten Ausflugsschiffe waren auch schon wieder unterwegs.“"
                                            },
                                            {
                                                "example_id": "092aaad2-8910-497d-9acc-e298f1bf1934",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Zu jener Zeit traf Lai-bau mit dem Frachtschiff aus Nanking wieder ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
