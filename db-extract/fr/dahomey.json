                "senses": [
                    {
                        "sense_id": "a1fd8c86-1ab3-3fb9-81a6-9e45df0d51a3",
                        "entry_id": "766f37a1-bdd7-37e2-8289-a3f6870e597a",
                        "glosses": [
                            "Ancien royaume fon d’Afrique de l’Ouest, situé dans le Sud du Bénin actuel, entre le XVIIᵉ siècle et la fin du XIXᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9cb163b-a6fe-4176-af7a-74d688867e18",
                                "sense_id": "a1fd8c86-1ab3-3fb9-81a6-9e45df0d51a3",
                                "text": "Le film suit, en novembre 1921, la restitution de vingt-six œuvres d’art à la République du Bénin, lesquelles avaient été pillées en 1892 par les troupes coloniales françaises – le Bénin s’appelait alors le royaume du Dahomey."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e3b379b-e03e-3baa-8013-3ece95d7aceb",
                        "entry_id": "766f37a1-bdd7-37e2-8289-a3f6870e597a",
                        "glosses": [
                            "Ancien nom de la colonie française du Bénin, colonie française de 1894 à 1958."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b6aeff10-c49a-3648-ad83-5fee5aaff773",
                        "entry_id": "766f37a1-bdd7-37e2-8289-a3f6870e597a",
                        "glosses": [
                            "Ancien nom du Bénin, État associé de la France de 1958 à 1960 et État indépendant à partir de 1960 avant d’être renommé « Bénin » en 1975 en raison de son association avec le groupe ethnique majoritaire Fon."
                        ],
                        "tags": [],
                        "examples": []
                    }
