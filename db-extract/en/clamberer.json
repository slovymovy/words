                        "examples": [
                            {
                                "example_id": "1d5d17bc-e042-4143-9705-6b1474eec64c",
                                "sense_id": "bf3df85f-4805-375c-b65d-bfcaa60bd6d1",
                                "text": "The brave clamberer among the rocky cliffs of the North Sea hears, with a thrill of pleasure at his own daring, the echoes of the gun which has brought to his feet the wild bird whose downy plumage is to minister to the luxury of a distant clime"
                            },
                            {
                                "example_id": "67351447-d052-464f-adca-d904e6b966cf",
                                "sense_id": "bf3df85f-4805-375c-b65d-bfcaa60bd6d1",
                                "text": "Up above however, and at close quarters, they afford the clamberer a surprising number of secret joys."
                            }
                        ]
                    }
