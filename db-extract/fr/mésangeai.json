                                "example_id": "c1a63160-b87a-4b81-a8a6-d784d701fefd",
                                "sense_id": "c82d3a6e-a2a7-3d7d-81b3-8ce07c78db04",
                                "text": "Le mésangeai du Canada est communément appelé geai du Canada ou geai gris."
