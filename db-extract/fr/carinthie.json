        "fr-extract.jsonl": [
            {
                "entry_id": "ead9be5c-b3d7-3d1d-99e3-505d6a992295",
                "word": "Carinthie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ad97d3f8-5b71-35f1-9f8b-99eefb6cea82",
                        "entry_id": "ead9be5c-b3d7-3d1d-99e3-505d6a992295",
                        "glosses": [
                            "État d’Autriche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16036818-e6fb-4c6e-8e7c-4421112255fc",
                                "sense_id": "ad97d3f8-5b71-35f1-9f8b-99eefb6cea82",
                                "text": "Très commune à Aussee et à Saint-Cassian, elle se montre sur le versant nord aussi bien qu’en Carinthie (Raibl) au centre et qu’au sud, dans le val di Scalve, le val Trompia et à Agordo."
                            },
                            {
                                "example_id": "31bdc253-93ca-4300-a929-714b8fcd644b",
                                "sense_id": "ad97d3f8-5b71-35f1-9f8b-99eefb6cea82",
                                "text": "Nous funambulions à 300 kilomètres de la Hongrie, dans la Carinthie du vieil empire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b71f8fa6-a102-4415-b859-b485a931b7f0",
                        "source_entry_id": "ead9be5c-b3d7-3d1d-99e3-505d6a992295",
                        "source_sense_id": "ad97d3f8-5b71-35f1-9f8b-99eefb6cea82",
                        "target_lang_word": "Kärnten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kärnten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "755ff68f-3b90-3d6a-942e-445b294c1ff4",
                                        "entry_id": "7daf32b2-7be2-3e21-a304-57535fd7ad00",
                                        "glosses": [
                                            "ein Bundesland der Republik Österreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1243e0e-954f-4790-93ff-c68880221de1",
                                                "sense_id": "755ff68f-3b90-3d6a-942e-445b294c1ff4",
                                                "text": "Kärnten gilt als Land der Berge und Seen: 93 seiner Berggipfel sind über 3.000 Meter hoch, der Großglockner ist mit 3.798 Metern der höchste Berg Österreichs, die rund 1.270 Seen und anderen stehenden Gewässer haben durchwegs Trinkwasserqualität."
                                            },
                                            {
                                                "example_id": "8f64d055-80a1-4f86-a7cd-c9b39790b789",
                                                "sense_id": "755ff68f-3b90-3d6a-942e-445b294c1ff4",
                                                "text": "Dass die Welt noch in Ordnung ist, wenigstens hier im hintersten Winkel Kärntens, unterm mächtigsten Gletscher der Ostalpen, in greifbarer Nähe zum höchsten Berg Österreichs, merkt man vor allem an der Stille."
                                            },
                                            {
                                                "example_id": "92ae18ef-8aa9-451b-a735-f8f5dfff444c",
                                                "sense_id": "755ff68f-3b90-3d6a-942e-445b294c1ff4",
                                                "text": "Dass die Küche einiges zu bieten hat, liegt auf der Hand, weil sich im Dreiländereck Spezialitäten aus Friaul, Slowenien und Kärnten vermischen."
                                            },
                                            {
                                                "example_id": "4487751b-b636-49c1-8cfc-e6dc7095112d",
                                                "sense_id": "755ff68f-3b90-3d6a-942e-445b294c1ff4",
                                                "text": "Der Volksgruppenkonflikt in Kärnten reicht bis ins 19. Jahrhundert zurück."
                                            },
                                            {
                                                "example_id": "c0cb80f5-3578-45dc-b62f-f32f7d995413",
                                                "sense_id": "755ff68f-3b90-3d6a-942e-445b294c1ff4",
                                                "text": "Seine Heimatliebe äußert sich prosaisch: »Es gibt nur zwei Dinge, die man an Kärnten vermissen kann: die Berge und die Seen.«"
                                            },
                                            {
                                                "example_id": "ad5af2c7-64a8-4e49-b843-033841daeb65",
                                                "sense_id": "755ff68f-3b90-3d6a-942e-445b294c1ff4",
                                                "text": "Denn gerade das Kärnten des 16. Jahrhunderts hat die Anwendung der CCC lange Zeit trotz gewisser Konzessionen beharrlich abgelehnt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
