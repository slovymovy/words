                                                "text": "to sheaf wheat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3be9f16a-5284-336f-89b2-97ffe8019238",
                                        "entry_id": "0ed5fc05-27a4-3544-b20e-b751307dd6ef",
                                        "glosses": [
                                            "To collect and bind cut grain, or the like; to make sheaves."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "242732d7-ab62-47fc-80aa-dbca2167ac50",
                                                "sense_id": "3be9f16a-5284-336f-89b2-97ffe8019238",
                                                "text": "They that reap must sheaf and bind; Then to cart with Rosalind."
                                            }
