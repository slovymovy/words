                        "glosses": [
                            "project dat gericht is om iets of iemand tegen gevaar te beschermen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89da96e3-b9d9-49bb-8c76-be639faea10c",
                                "sense_id": "49fb00b0-2036-37df-af52-356601601fa1",
                                "text": "Zuid-Limburg hoeft niet meer bang te zijn voor overstromingen van de Maas. Ruim twintig jaar na de grote overstromingen in 1993 en 1995 is een beveiligingsproject afgerond."
                            },
                            {
                                "example_id": "760a8969-8f52-4830-9695-e8eec024add8",
                                "sense_id": "49fb00b0-2036-37df-af52-356601601fa1",
                                "text": "De baas van G4S Nick Buckles blijft wel op zijn post. De raad van toezicht vindt dat beter voor het bedrijf en zijn aandeelhouders. De raad zegt dat Buckles niet verantwoordelijk is voor de problemen. Hij moest zich in juli nog verantwoorden voor een parlementaire commissie. Hij gaf toen toe dat het beveiligingsproject rondom de Spelen een fiasco was."
                            }
                        ]
                    }
