                "senses": [
                    {
                        "sense_id": "3342aa22-f415-3387-930c-807fac6b8589",
                        "entry_id": "05471388-2e91-3073-b96e-6a107b2f7df6",
                        "glosses": [
                            "het werk dat gedaan wordt buiten de werktijd zoals dat is bepaald in het arbeidscontract"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05080f44-97c8-49fc-a65f-467f672cfe0e",
                                "sense_id": "3342aa22-f415-3387-930c-807fac6b8589",
                                "text": "‘Werknemers langer thuis door burn-out’, ‘Studenten lijden onder keuzestress en prestatiedruk’, ‘Hoort overwerk er gewoon bij?’. Zomaar een aantal koppen uit NRC van de laatste maanden. We moeten allemaal langer werken, maar zijn we daartoe wel in staat? Stress en burn-outs teisteren werknemers. Sommige bedrijven doen het radicaal anders: meer zelfsturende teams met minder bazen. Werkt dat? Zijn de bedrijven, maar ook de vakbonden, daar wel klaar voor? Verslaggevers Ilse Van Lysebeth en Sara Van Boxtel gaan op onderzoek uit."
                            },
                            {
                                "example_id": "fe766882-d87c-47a5-8fb2-b099ee8f6311",
                                "sense_id": "3342aa22-f415-3387-930c-807fac6b8589",
                                "text": "Door middel van overwerk geven Nederlandse werknemers jaarlijks 20 miljard euro cadeau aan hun werkgevers: het equivalent van 300 duizend voltijdsbanen, becijferde TNO in opdracht van vakbond FNV"
                            }
                        ]
                    }
