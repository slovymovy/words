                {
                    "sense_id": "52bf6755-3ae3-3d42-844e-242514ff8ccc",
                    "sense_definition": "Een onsmakelijke, weke of plakkerige massa",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "smurrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was onderuitgegaan en zat nu helemaal onder de <w>smurrie</w>.",
                            "target_lang_translations": {
                                "en": "He had slipped and was now completely covered in <w>gunk</w>."
                            }
                        },
                        {
                            "text": "Wat is dat voor een vieze <w>smurrie</w> op de keukentafel?",
                            "target_lang_translations": {
                                "en": "What kind of dirty <w>goo</w> is that on the kitchen table?"
                            }
                        }
                    ],
                    "synonyms": [
