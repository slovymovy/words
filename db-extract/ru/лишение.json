                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f64da596-f36c-4dcf-8e19-8add7b038201",
                                                "sense_id": "07db577d-6a20-3868-bcf5-3ff5883a78e1",
                                                "text": "Nowotarżanin aresztowany za stalking, groźby i pozbawienie wolności kobiety"
                                            }
