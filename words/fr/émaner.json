{
    "word_family": [
        "émanation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c424a52a-85cb-3147-9904-ad949dfd7a1c",
                    "sense_definition": "Se dégager, se diffuser ou rayonner à partir d'un corps, d'une substance ou d'un lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une douce odeur de jasmin <w>émane</w> des buissons fleuris le long du sentier."
                        },
                        {
                            "text": "Une faible lueur <w>émanait</w> encore des braises éteintes au fond de la cheminée."
                        }
                    ],
                    "synonyms": [
                        "rayonner",
                        "s'exhaler",
                        "se dégager"
                    ],
                    "common_phrases": [
                        "émaner de la terre",
                        "émaner d'un parfum"
                    ]
                },
                {
                    "sense_id": "53c49cde-384a-3c5a-b7f4-2c162fbb18b2",
                    "sense_definition": "Provenir directement d'une personne, d'une autorité ou d'une source abstraite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette directive importante <w>émane</w> directement des plus hautes autorités de l'État."
                        },
                        {
                            "text": "Le projet de loi contesté <w>émanait</w> d'un comité d'experts parlementaires réunis à Paris."
                        }
                    ],
                    "synonyms": [
                        "découler",
                        "procéder",
                        "provenir"
                    ],
                    "common_phrases": [
                        "émaner d'une autorité",
                        "émaner du gouvernement"
                    ]
                },
                {
                    "sense_id": "a4f39bbb-3df2-3756-9fdb-4b220a5c4ffb",
                    "sense_definition": "Dégager ou exhaler quelque chose de façon continue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La créature étrange <w>émanait</w> une chaleur intense qui réchauffait toute la pièce sombre."
                        },
                        {
                            "text": "Les vieux fûts de chêne <w>émanaient</w> des vapeurs d'alcool perceptibles dès l'entrée de la cave."
                        }
                    ],
                    "synonyms": [
                        "dégager",
                        "exhaler",
                        "produire"
                    ],
                    "common_phrases": [
                        "émaner une odeur"
                    ]
                }
            ]
        }
    ]
