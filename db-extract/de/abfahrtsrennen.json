                                "sense_id": "8b5cdd85-163c-355a-85a8-4787f772ffb4",
                                "text": "„Was für ein Comeback: Thomas Dreßen aus Mittenwald hat im ersten Abfahrtsrennen nach seinem Kreuzbandriss gleich wieder gewonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ea787d1-5db8-40ac-af9e-45c24d427f97",
                        "source_entry_id": "24c46326-86be-3762-a2d6-1fcba9fa6848",
