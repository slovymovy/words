                "senses": [
                    {
                        "sense_id": "021e0033-6d02-3967-9eca-1460bb61de0f",
                        "entry_id": "6084d9b8-bb07-3a16-9d5b-ee9001c409b1",
                        "glosses": [
                            "Krankenpfleger, der bei Operationen assistiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e816676-6692-4004-b038-7bb587dc3f66",
                                "sense_id": "021e0033-6d02-3967-9eca-1460bb61de0f",
                                "text": "„Der Anästhesiepfleger und der Anästhesist sind während der Anästhesiologiezeit tätig, die beiden Operationspfleger sind während der Schnitt-Naht- sowie Rüstzeit anwesend, während die Ärzte nur während der Schnitt-Naht-Zeit tätig sind.“"
                            },
                            {
                                "example_id": "2420efd5-39cc-4aa4-b84c-b0c28e1228f2",
                                "sense_id": "021e0033-6d02-3967-9eca-1460bb61de0f",
                                "text": "„Der Operationspfleger bedient die Umbettanlage.“"
                            },
                            {
                                "example_id": "2de0a078-8041-42fd-baa4-ec6a3e4a14d4",
                                "sense_id": "021e0033-6d02-3967-9eca-1460bb61de0f",
                                "text": "„Nach Ernst Pfeifer, den wir von der Hofkolonne übernommen hatten, kam auch der Operationspfleger Bollmann wieder zu uns. Er wollte uns verlassen und Arzthelfer in einem Landambulatorium werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
