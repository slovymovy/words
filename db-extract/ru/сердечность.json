                    }
                ],
                "translations": [
                    {
                        "translation_id": "a932661a-d69a-4d3c-9bc1-8c184bc668b9",
                        "source_entry_id": "17a4caa2-ecff-307e-a2f9-78cd36a7e3ee",
                        "source_sense_id": "1d2f207f-649f-302f-ac55-2189f482260d",
                        "target_lang_word": "cordiality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordiality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ebf90b-dccc-365e-bdee-a90526076f00",
                                        "entry_id": "9aaf0e43-fe1a-3961-8ba3-b6ddd4913d78",
                                        "glosses": [
                                            "The quality of being cordial."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79493a29-74d4-469e-acdb-8a8073ac362f",
                                                "sense_id": "a0ebf90b-dccc-365e-bdee-a90526076f00",
                                                "text": "Upon my entrance, Usher rose from a sofa on which he had been lying at full length, and greeted me with a vivacious warmth which had much in it, I at first thought, of an overdone cordiality—of the constrained effort of the ennuyé man of the world."
                                            },
                                            {
                                                "example_id": "0a651b67-3932-42ea-be93-f26e123d80c3",
                                                "sense_id": "a0ebf90b-dccc-365e-bdee-a90526076f00",
                                                "text": "Adam gave her—the spaniel, not Mrs. Florin—a gentle prod with his foot and a lump of sugar. She licked his shoe with evident cordiality. Adam was not above feeling flattered by friendliness in dogs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "049a715e-8e5c-35dc-9fa1-68265961868e",
                                        "entry_id": "9aaf0e43-fe1a-3961-8ba3-b6ddd4913d78",
                                        "glosses": [
                                            "A friendly utterance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e1901ae-c290-46ec-9dd5-f93971405549",
                                                "sense_id": "049a715e-8e5c-35dc-9fa1-68265961868e",
                                                "text": "to exchange cordialities with people"
                                            },
                                            {
                                                "example_id": "2851b62d-5e0d-49fd-947a-7e39c93af334",
                                                "sense_id": "049a715e-8e5c-35dc-9fa1-68265961868e",
                                                "text": "Lucia rivalled these cordialities with equal fervour and about as much sincerity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41d599e8-0ef2-4655-9323-00916891dcc2",
                        "source_entry_id": "17a4caa2-ecff-307e-a2f9-78cd36a7e3ee",
                        "source_sense_id": "1d2f207f-649f-302f-ac55-2189f482260d",
                        "target_lang_word": "warmth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warmth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57099eae-059d-3a19-8239-e1378830959b",
                                        "entry_id": "f44daeaa-6b88-30a0-822f-6f28644bd01a",
                                        "glosses": [
                                            "A moderate degree of heat; the sensation of being warm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee6a3841-b827-3e03-9463-99aba2c3a462",
                                        "entry_id": "f44daeaa-6b88-30a0-822f-6f28644bd01a",
                                        "glosses": [
                                            "Friendliness, kindness or affection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "569549ef-08bc-4f38-bebc-e2b62d255694",
                                                "sense_id": "ee6a3841-b827-3e03-9463-99aba2c3a462",
                                                "text": "Included in the crowd of more than 10,000 was a gay contingent of over 100. A large banner proclaiming \"Gay American Revolution\" beckoned other gay marchers to join the contingent. Several participants said that they were pleased with the noticeable warmth of the other demonstrators toward the gay people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06e0265-e1c9-3154-a66d-a876c9eee99d",
                                        "entry_id": "f44daeaa-6b88-30a0-822f-6f28644bd01a",
                                        "glosses": [
                                            "Fervor, intensity of emotion or expression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34410d94-cedf-4c6f-959b-c1625cb06562",
                                                "sense_id": "f06e0265-e1c9-3154-a66d-a876c9eee99d",
                                                "text": "\"You don't know him—don't pronounce an opinion upon him,\" I said with warmth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c15497-8edc-3740-9b9c-d87dfa995408",
                                        "entry_id": "f44daeaa-6b88-30a0-822f-6f28644bd01a",
                                        "glosses": [
                                            "The effect of using mostly red and yellow hues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ef58c0-95b4-4cdc-a49e-4495b10db55e",
                        "source_entry_id": "17a4caa2-ecff-307e-a2f9-78cd36a7e3ee",
