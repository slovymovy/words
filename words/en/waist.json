    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7842087f-5d70-337a-aeba-bae08734b1ff",
                    "sense_definition": "The narrowing part of the human body located between the ribs and the hips.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tied a colorful belt around her <w>waist</w>.",
                            "target_lang_translations": {
                                "ru": "Она повязала цветной пояс вокруг <w>талии</w>.",
                                "zh": "她在<w>腰</w>上系了一条彩色的腰带。",
                                "fr": "Elle a noué une ceinture colorée autour de sa <w>taille</w>."
                            }
                        },
                        {
                            "text": "The water in the river was only <w>waist</w> deep.",
                            "target_lang_translations": {
                                "ru": "Вода в реке была всего лишь по <w>пояс</w>.",
                                "zh": "河水深仅及<w>腰</w>。",
                                "fr": "L'eau de la rivière ne lui arrivait qu'à la <w>taille</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "midriff",
                        "middle"
                    ],
                    "common_phrases": [
                        "waist deep",
                        "waist high",
                        "small waist",
                        "waist size"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая узкая часть человеческого тела, находящаяся между ребрами и бедрами.",
                        "zh": "人体肋骨与髋骨之间最窄的部位。",
                        "fr": "La partie la plus étroite du corps humain, située entre les côtes et les hanches."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "талия",
                                "target_lang_sense_clarification": "часть тела"
                            },
                            {
                                "target_lang_word": "пояс",
                                "target_lang_sense_clarification": "уровень тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腰",
                                "target_lang_sense_clarification": "人体部位"
                            },
                            {
                                "target_lang_word": "腰部",
                                "target_lang_sense_clarification": "人体部位"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "taille",
                                "target_lang_sense_clarification": "partie du corps"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1c350f2-6af7-3812-9a19-65843eef75b6",
                    "sense_definition": "The part of a garment that covers or fits around the middle of the body.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>waist</w> of these trousers is a bit too tight for me.",
                            "target_lang_translations": {
                                "ru": "<w>Пояс</w> этих брюк мне немного жмёт.",
                                "zh": "这条裤子的<w>腰头</w>对我来说有点紧。",
                                "fr": "La <w>taille</w> de ce pantalon est un peu trop serrée pour moi."
                            }
                        },
                        {
                            "text": "I prefer wearing skirts with an elastic <w>waist</w> for better comfort.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю носить юбки с эластичным <w>поясом</w> для большего удобства.",
                                "zh": "为了更舒适，我更喜欢穿松紧<w>腰头</w>的裙子。",
                                "fr": "Je préfère porter des jupes avec une <w>ceinture</w> élastique pour plus de confort."
                            }
                        }
                    ],
                    "synonyms": [
                        "waistband"
                    ],
                    "common_phrases": [
                        "elastic waist",
                        "drop waist",
                        "drawstring waist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть одежды, закрывающая или облегающая середину тела.",
                        "zh": "服装中覆盖或环绕身体中部的部分。",
                        "fr": "La partie d'un vêtement qui couvre ou s'ajuste autour du milieu du corps."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пояс",
                                "target_lang_sense_clarification": "деталь одежды"
                            },
                            {
                                "target_lang_word": "талия",
                                "target_lang_sense_clarification": "линия кроя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腰头",
                                "target_lang_sense_clarification": "服装结构"
                            },
                            {
                                "target_lang_word": "腰围",
                                "target_lang_sense_clarification": "服装尺寸或部位"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "taille",
                                "target_lang_sense_clarification": "ligne de coupe d'un vêtement"
                            },
                            {
                                "target_lang_word": "ceinture",
                                "target_lang_sense_clarification": "partie d'un vêtement qui serre la taille"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36ed5bd9-2d99-3651-aee9-40ba38ae981c",
                    "sense_definition": "The narrow connection between the thorax and abdomen in certain insects, such as ants and wasps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy_insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can easily identify the ant by its very thin <w>waist</w>.",
                            "target_lang_translations": {
                                "ru": "Муравья легко узнать по его очень тонкой <w>талии</w>.",
                                "zh": "你可以很容易地通过蚂蚁极细的<w>腰部</w>辨认出它。",
                                "fr": "On peut facilement identifier la fourmi grâce à sa <w>taille</w> très fine."
                            }
                        },
                        {
                            "text": "The wasp has a distinct <w>waist</w> that separates its body segments.",
                            "target_lang_translations": {
                                "ru": "У осы есть отчетливая <w>талия</w>, разделяющая сегменты её тела.",
                                "zh": "黄蜂有一个明显的<w>腰部</w>，将它的身体节段分离开来。",
                                "fr": "La guêpe possède une <w>taille</w> marquée qui sépare les segments de son corps."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкое соединение между грудью и брюшком у некоторых насекомых, например у муравьев и ос.",
                        "zh": "某些昆虫（如蚂蚁和黄蜂）胸部与腹部之间狭窄的连接处。",
                        "fr": "La connexion étroite entre le thorax et l'abdomen chez certains insectes, comme les fourmis et les guêpes."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "талия",
                                "target_lang_sense_clarification": "у насекомых"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腰部",
                                "target_lang_sense_clarification": "昆虫解剖结构"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "taille",
                                "target_lang_sense_clarification": "anatomie des insectes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4fd05c9-ee0a-38e7-b6a6-6586d7f45b51",
                    "sense_definition": "The middle portion of the hull of a ship or the fuselage of an aircraft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicle_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cargo was carefully stored in the <w>waist</w> of the ship.",
                            "target_lang_translations": {
                                "ru": "Груз был аккуратно размещен на <w>шкафуте</w> корабля.",
                                "zh": "货物被小心地存放在船的<w>中部</w>。",
                                "fr": "La cargaison a été soigneusement stockée dans la <w>partie centrale</w> du navire."
                            }
                        },
                        {
                            "text": "Engineers inspected the <w>waist</w> of the plane for structural damage.",
                            "target_lang_translations": {
                                "ru": "Инженеры осмотрели <w>среднюю часть</w> самолета на предмет структурных повреждений.",
                                "zh": "工程师检查了飞机的<w>中段</w>以查看是否有结构性损坏。",
                                "fr": "Les ingénieurs ont inspecté la <w>partie centrale</w> de l'avion pour détecter tout dommage structurel."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средняя часть корпуса судна или фюзеляжа самолета.",
                        "zh": "船体或飞机机身的中部。",
                        "fr": "La partie centrale de la coque d'un navire ou du fuselage d'un avion."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкафут",
                                "target_lang_sense_clarification": "морской термин"
                            },
                            {
                                "target_lang_word": "средняя часть",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中部",
                                "target_lang_sense_clarification": "船体或机身"
                            },
                            {
                                "target_lang_word": "中段",
                                "target_lang_sense_clarification": "船体或机身"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "partie centrale",
                                "target_lang_sense_clarification": "terme technique pour un véhicule"
                            },
                            {
                                "target_lang_word": "milieu",
                                "target_lang_sense_clarification": "section centrale"
                            }
                        ]
                    }
                }
            ]
        }
