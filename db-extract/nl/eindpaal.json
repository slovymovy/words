                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cde02fc9-19bb-47d6-b11f-affd73661c63",
                                "sense_id": "adce4224-44bb-30c7-b840-576b2bb57907",
                                "text": "Nogmaals uit datzelfde hoofdstuk déze woorden van Calvijn: ”Wat wil ik dan? Dat het doel der volkomenheid voor ogen gesteld wordt, opdat wij daarop alleen onze ijver mogen richten. Laat zij als eindpaal voor ons gezet worden, opdat wij naar haar streven en wedijveren. Want het is niet geoorloofd zo met God te delen, dat ge van die dingen, die u door Zijn Woord voorgeschreven worden, een deel aanvaardt en een deel naar uw goeddunken voorbij gaat.”"
                            }
                        ]
