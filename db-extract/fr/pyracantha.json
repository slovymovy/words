                "senses": [
                    {
                        "sense_id": "ebe540a8-d756-3fa1-ac77-169c134b9660",
                        "entry_id": "6b0bfe60-d0b5-33d9-b6c7-f54c86587ea3",
                        "glosses": [
                            "Nom de plusieurs espèces d’arbustes à feuillage persistant, très épineux, de taille facile, communément utilisés pour la décoration et la réalisation de haies défensives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58ea528-f4ca-4fe8-a567-9535021da0e9",
                                "sense_id": "ebe540a8-d756-3fa1-ac77-169c134b9660",
                                "text": "… Bois et tiges osent toutes les couleurs. Pour en jouer, il suffit de leur adjoindre quelques conifères, des arbustes à baies - pommiers d’ornement, pyracanthas..."
                            },
                            {
                                "example_id": "e071c8ff-c2ea-4612-957d-6206cc13dcff",
                                "sense_id": "ebe540a8-d756-3fa1-ac77-169c134b9660",
                                "text": "Le pyracantha est un arbrisseau au feuillage persistant qui produit de nombreux rameaux enchevêtrés et couverts de robustes épines."
                            }
                        ]
                    }
                ],
