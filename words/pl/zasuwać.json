                {
                    "sense_id": "7da02534-3525-348c-98d3-a2e2cfe882af",
                    "sense_definition": "przesuwając, umieszczać coś wewnątrz lub domykać mebel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mężczyzna odkłada dokumenty na miejsce i powoli <w>zasuwa</w> szufladę biurka.",
                            "target_lang_translations": {
                                "ru": "Мужчина кладёт документы на место и медленно <w>задвигает</w> ящик письменного стола."
                            }
                        },
                        {
                            "text": "Po wyjęciu talerzy zawsze delikatnie <w>zasuwaj</w> tę szafkę.",
                            "target_lang_translations": {
                                "ru": "Достав тарелки, всегда аккуратно <w>задвигай</w> этот шкафчик."
                            }
                        }
