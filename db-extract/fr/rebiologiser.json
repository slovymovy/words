                ],
                "senses": [
                    {
                        "sense_id": "93c3d226-969b-37c0-86d5-ee213067269b",
                        "entry_id": "0d363520-d5d7-30fa-b8a9-c862954feea4",
                        "glosses": [
                            "Réanalyser d’un point de vue strictement biologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40d4b65e-80ec-4b0e-ba71-492904489505",
                                "sense_id": "93c3d226-969b-37c0-86d5-ee213067269b",
                                "text": "Traquer et déclarer la guerre au genre, ne passe par rien d’autre que tenter de re-biologiser les rapports hommes-femmes, récréer le « masculin » et le « féminin », faire perdurer la dichotomie, la garder intacte..."
                            },
                            {
                                "example_id": "cb7cc486-f015-4988-98d2-20ec2ad25f04",
                                "sense_id": "93c3d226-969b-37c0-86d5-ee213067269b",
                                "text": "L’effet que le processus de réification va avoir sur le genre, est de le re-naturaliser et re-biologiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2119634-60d1-3998-a478-107c15013eb0",
                        "entry_id": "0d363520-d5d7-30fa-b8a9-c862954feea4",
                        "glosses": [
                            "Redonner un caractère biologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61080e55-dee8-45f7-a0ba-42a1ca1cf2a9",
                                "sense_id": "e2119634-60d1-3998-a478-107c15013eb0",
                                "text": "Sa grande passion c'est de biologiser ou rebiologiser l'aquarium récifal."
                            }
                        ]
                    }
