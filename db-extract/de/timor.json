                        "entry_id": "d482a91d-fd7c-3473-bad5-d48af07496b9",
                        "glosses": [
                            "östlichste der Kleinen Sundainseln; die Westhälfte gehört zu Indonesien, während Osttimor einen eigenen Staat bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83213e69-4448-4330-adb8-095598ab1a37",
                                "sense_id": "220c8712-19d6-3b10-a505-da39b5f0ed78",
                                "text": "Timor hat etwa drei Millionen Einwohner."
                            },
                            {
                                "example_id": "5057335d-427b-4415-a4ac-14f8f72f55ab",
                                "sense_id": "220c8712-19d6-3b10-a505-da39b5f0ed78",
                                "text": "Die Fotos zeigen das Timor der Kolonialzeit."
                            }
                        ],
