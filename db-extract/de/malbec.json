                "senses": [
                    {
                        "sense_id": "78943ba0-7136-32d2-926e-08fd82a0a05e",
                        "entry_id": "2b4ea1dd-775e-34c0-a593-7596720426f7",
                        "glosses": [
                            "eine rote Rebsorte, die vorwiegend in Frankreich im Bordeaux-Gebiet, sowie in Argentinien und Chile (dort als sortenreiner Wein) angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b203db-8873-4875-828e-36464adee003",
                                "sense_id": "78943ba0-7136-32d2-926e-08fd82a0a05e",
                                "text": "Der Malbec ist eine wichtige Rotweinrebe Frankreichs. Sie „bringt farbintensive, feine, weiche und an Finessen reiche Rotweine hervor, die früh altern.“"
                            },
                            {
                                "example_id": "69f1ff11-965d-4a88-93c3-8d076310a120",
                                "sense_id": "78943ba0-7136-32d2-926e-08fd82a0a05e",
                                "text": "„In dieser Gegend werden nur Rotweintraubensorten angebaut. Der dominierende Merlot wächst auf etwa drei Viertel der Rebflächen, … Andere zugelassene, wenn auch selten zu sehende Sorten sind Cot (Malbec) und Carmenère.“"
                            },
                            {
                                "example_id": "42cd093c-c7ae-479c-81d8-0ad514a59579",
                                "sense_id": "78943ba0-7136-32d2-926e-08fd82a0a05e",
                                "text": "„Dieser trockene, fruchtige Rotwein aus der Rebsorte Malbec stammt aus dem Weinanbaugebiet Mendoza in Argentinien und ist der ideale Begleiter für kräftige Speisen aller Art.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "34e2e626-fa4f-3df1-8b31-3df03df8edb7",
                        "entry_id": "2b4ea1dd-775e-34c0-a593-7596720426f7",
                        "glosses": [
                            "ein Rotwein der Rebsorte Malbec"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa24dc5-86a0-453b-9dab-1cbfe6c42339",
                                "sense_id": "34e2e626-fa4f-3df1-8b31-3df03df8edb7",
                                "text": "Heute haben wir einen argentinischen Malbec getrunken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
