                                    },
                                    {
                                        "sense_id": "c4f9f7a6-bf07-3a50-becc-e21dcf6767c3",
                                        "entry_id": "d4e29d1d-515b-3c18-830e-c4b8a81b996f",
                                        "glosses": [
                                            "A distinctive mark worn by servants, retainers, and followers of royalty or nobility, who, being beneath the rank of gentlemen, have no right to armorial bearings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0c40553-0d2c-31a5-bec6-b49dd776e410",
                                        "entry_id": "d4e29d1d-515b-3c18-830e-c4b8a81b996f",
                                        "glosses": [
                                            "A small overlay on an icon that shows additional information about that item, such as the number of new alerts or messages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "543a6601-7c32-3e36-b328-ad0b86e034a3",
                                        "entry_id": "d4e29d1d-515b-3c18-830e-c4b8a81b996f",
                                        "glosses": [
                                            "An icon or emblem awarded to a user for some achievement."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "734827ee-2275-49b7-b945-70c231fff519",
                                                "sense_id": "543a6601-7c32-3e36-b328-ad0b86e034a3",
                                                "text": "When you have checked in to the site from ten different cities, you unlock the Traveller badge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfbbe616-0091-32eb-a07c-bc798270e672",
                                        "entry_id": "d4e29d1d-515b-3c18-830e-c4b8a81b996f",
                                        "glosses": [
                                            "A police officer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d273b5-31ca-4236-aa53-8156768fabc4",
                                                "sense_id": "bfbbe616-0091-32eb-a07c-bc798270e672",
                                                "text": "That's why every badge back home wanted to nail him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "badge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ac4fa78-602d-38e0-963b-5471ff80fb5f",
                                        "entry_id": "ab60fdc9-1a9d-3645-a4cc-57a7c37ecec2",
                                        "glosses": [
                                            "To mark or distinguish with a badge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe9f3c3c-c2c8-44c6-8711-255a645faf1a",
                                                "sense_id": "2ac4fa78-602d-38e0-963b-5471ff80fb5f",
                                                "text": "The television was badged as ‘GE’, but wasn’t made by them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb6f30ff-e158-3c5a-ae0d-462f50fb9c52",
                                        "entry_id": "ab60fdc9-1a9d-3645-a4cc-57a7c37ecec2",
                                        "glosses": [
                                            "To show a badge to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ea7d713-abeb-4f8e-86a6-44925a048118",
                                                "sense_id": "eb6f30ff-e158-3c5a-ae0d-462f50fb9c52",
                                                "text": "He calmed down a lot when the policeman badged him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bcd6e00-46a6-32b0-82b6-8551f4419f42",
                                        "entry_id": "ab60fdc9-1a9d-3645-a4cc-57a7c37ecec2",
                                        "glosses": [
                                            "To enter a restricted area by showing one’s badge."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76eabb5-9e1d-455f-b55d-27f6849deaa7",
                                                "sense_id": "5bcd6e00-46a6-32b0-82b6-8551f4419f42",
                                                "text": "Worden and James walk […] to the […] Courthouse […], where they badge their way past sheriff’s deputies and take the elevator to the third floor."
                                            },
                                            {
                                                "example_id": "bb91605e-3367-469f-b828-e5ced30606c4",
                                                "sense_id": "5bcd6e00-46a6-32b0-82b6-8551f4419f42",
                                                "text": "And Patterson didn’t hear that Jack Egger, the studio’s director of security, said he’d seen John Orr badge his way through the pedestrian gate sometime before 4:00 pm, when the fire was still raging, […]"
                                            },
                                            {
                                                "example_id": "19b1cd19-d6cb-487f-9ba4-900d14e81cf0",
                                                "sense_id": "5bcd6e00-46a6-32b0-82b6-8551f4419f42",
                                                "text": "Our regional commissioner, his assistant commissioner and our district director, along with their wives, were hoofing it to the rotunda. Apparently they didn’t try and badge their way through."
                                            },
                                            {
                                                "example_id": "0f8ac9c2-2064-49f2-b242-a62122fd8ab2",
                                                "sense_id": "5bcd6e00-46a6-32b0-82b6-8551f4419f42",
                                                "text": "Aaron badged into the data center and escorted Geoff inside the large room with its many blinking green lights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36673eba-5893-49bf-af40-b7499bf972be",
                        "source_entry_id": "e79451dc-b56d-3ec6-8f8f-3da26a81d007",
                        "source_sense_id": "6668be7c-e3ac-36ae-9c99-498f90ab3557",
                        "target_lang_word": "honour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23c1baec-d172-3949-bf03-4ba7c2c06e4b",
                                        "entry_id": "28137fed-28bb-330e-b969-d343e916f424",
                                        "glosses": [
                                            "British, Canadian, Commonwealth, and Ireland standard spelling of honor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789d3f46-b010-4752-a142-ca50c48411e5",
                                                "sense_id": "23c1baec-d172-3949-bf03-4ba7c2c06e4b",
                                                "text": "Honours are normally awarded twice a year: on The Queen's Birthday in June and at the New Year."
                                            },
                                            {
                                                "example_id": "82e188d7-3514-41aa-9266-15773ce89b22",
                                                "sense_id": "23c1baec-d172-3949-bf03-4ba7c2c06e4b",
                                                "text": "The lorde of the honour or manour"
                                            },
                                            {
                                                "example_id": "07893f1d-cbc3-4971-a86e-f2018e4364dd",
                                                "sense_id": "23c1baec-d172-3949-bf03-4ba7c2c06e4b",
                                                "text": "A prophet is not without honour, save in his own country."
                                            },
                                            {
                                                "example_id": "dcc86017-bb3e-4dfc-9c30-c911a6340b3b",
                                                "sense_id": "23c1baec-d172-3949-bf03-4ba7c2c06e4b",
                                                "text": "And when the long-illumined cities flame, / Their ever-loyal iron leader's fame, / With honour, honour, honour, honour to him, / Eternal honour to his name."
                                            },
                                            {
                                                "example_id": "f0c477ec-242a-45dd-bb4f-61c229f8918a",
                                                "sense_id": "23c1baec-d172-3949-bf03-4ba7c2c06e4b",
                                                "text": "Prosopochrysa lemannae is a tiny soldier fly from Judbarra National Park in the Northern Territory. It was named in honour of his colleague Cate Lemann, by Bry the Fly Guy (aka Dr Bryan Lessard), an entomologist at our insect collection."
                                            }
                                        ]
                                    }
