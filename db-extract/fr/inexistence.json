        "fr-extract.jsonl": [
            {
                "entry_id": "185f0c44-2c03-3487-bbdf-04767def2686",
                "word": "inexistence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d3f2656-8857-458e-926b-b651d78701c5",
                        "entry_id": "185f0c44-2c03-3487-bbdf-04767def2686",
                        "tags": [
