                        "sense_id": "55d21f9d-a5e9-38ac-be90-f114f61d3c30",
                        "entry_id": "905d3f92-53fb-330c-8305-36e4b1fa5fb3",
                        "glosses": [
                            "ogół produktów ceramicznych – artystycznych, użytkowych lub technicznych"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "14bd727d-8986-4381-8000-5caa3782be46",
                                "sense_id": "55d21f9d-a5e9-38ac-be90-f114f61d3c30",
                                "text": "Ta ceramika jest malowana ręcznie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
