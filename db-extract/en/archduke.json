                        "entry_id": "6c8c29e3-6a71-3358-a9e9-86f49b8d9f66",
                        "glosses": [
                            "The son or male-line grandson of an emperor of the Austro-Hungarian Empire."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "621dcfc1-2e9d-4988-bef6-6e9b273f4420",
                                "sense_id": "e795058a-3573-3ef1-85ad-620ea58042d5",
                                "text": "World War I traditionally started with the assassination of Archduke Francis (Franz) Ferdinand."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef098885-13d1-3759-8e59-14f5c167c5e8",
                        "entry_id": "6c8c29e3-6a71-3358-a9e9-86f49b8d9f66",
                        "glosses": [
                            "The ruler of an archduchy, in particular the Archduchy of Austria."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f244a187-1fe3-46a7-8634-54d739c60fb6",
                        "source_entry_id": "6c8c29e3-6a71-3358-a9e9-86f49b8d9f66",
                        "source_sense_description": "rank",
                        "target_lang_word": "arcivévoda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcivévoda",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0646645f-b1f1-3931-b5fb-d1f79ae5e880",
                                        "entry_id": "0744d513-6852-316e-a1fc-ee8193efdfaa",
                                        "glosses": [
                                            "šlechtický titul (nižší než král a vyšší než vévoda)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cde56a5-3e36-4e0f-9dbc-b9385dfdd142",
                                                "sense_id": "0646645f-b1f1-3931-b5fb-d1f79ae5e880",
                                                "text": "„Tak vida, paní Müllerová. On je tedy pan arcivévoda už na pravdě boží. Trápil se dlouho?“ „Pan arcivévoda byl hned hotovej, milostpane. To vědí, že s revolverem nejsou žádný hračky.“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe4df8db-a4ef-4fe1-9ea7-b89e5ca40099",
                        "source_entry_id": "6c8c29e3-6a71-3358-a9e9-86f49b8d9f66",
                        "source_sense_description": "rank",
                        "target_lang_word": "aartshertog",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aartshertog",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "375b5a50-1b2e-3cea-a29f-4ab308ad9536",
                                        "entry_id": "dd42d9bb-4c9a-302c-9f39-545ff2d89e77",
                                        "glosses": [
                                            "een keizerlijke prins in het vroegere Oostenrijk-Hongarije"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e83eb2-7aca-41a8-a8d1-b2bc57c34077",
                                                "sense_id": "375b5a50-1b2e-3cea-a29f-4ab308ad9536",
                                                "text": "Kinderen uit morganitische huwelijken zijn geen aartshertogen maar Graaf of Gravin van Habsburg."
                                            },
                                            {
                                                "example_id": "78995793-a4a3-4b25-8d99-a5bc45939782",
                                                "sense_id": "375b5a50-1b2e-3cea-a29f-4ab308ad9536",
                                                "text": "De neef van Filips van Spanje, aartshertog Karel, was een van de gegadigden; de hertog van Savoye was een andere; vervolgens werd prins Karel van Zweden ten tonele gevoerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23b20684-33aa-4fbb-a311-21e53fb4955a",
                        "source_entry_id": "6c8c29e3-6a71-3358-a9e9-86f49b8d9f66",
                        "source_sense_description": "rank",
                        "target_lang_word": "archiduc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archiduc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "650a588a-e69e-3855-b0ca-be8827190ce9",
                                        "entry_id": "3b057be1-736d-34b3-8986-48a449fb11d4",
                                        "glosses": [
                                            "Titre de dignité des princes et des princesses de l’ancienne maison d’Autriche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5558a5b6-7d08-4bf6-a9f1-83432c605cba",
                                                "sense_id": "650a588a-e69e-3855-b0ca-be8827190ce9",
                                                "text": "Graz était la capitale de la Styrie, ce lui fut une occasion nouvelle d’étaler son érudition, parlant des Babenberg, prédécesseurs des Habsbourg, et de cet archiduc Johann qui aima tant Anna Plochi, la fille du maître de poste d’Aussee."
                                            },
                                            {
                                                "example_id": "7bf7a034-b4db-4434-af5a-07985e23a14e",
                                                "sense_id": "650a588a-e69e-3855-b0ca-be8827190ce9",
                                                "text": "L’archiduc Jean Salvator était prêt malgré tout, au nom de leur amitié à lui apporter son soutien, mais encore fallait-il que l’empereur le rétablisse dans son grade et commandement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be203578-a94d-4183-b6d3-513840a23c56",
                        "source_entry_id": "6c8c29e3-6a71-3358-a9e9-86f49b8d9f66",
                        "source_sense_description": "rank",
                        "target_lang_word": "Erzherzog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzherzog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4dd55c0-78e2-3698-b965-b36098385dae",
                                        "entry_id": "2779ec87-6fed-397e-830d-8a712b820068",
                                        "glosses": [
                                            "erblicher Adelstitel, der vom jeweiligen Herrscher in Österreich seit Mitte des 14. Jahrhunderts und von allen Prinzen seit dem 15. Jahrhundert bis Anfang des 20. Jahrhunderts geführt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10414d49-43b5-4e37-acd1-90bb1a4c799f",
                                                "sense_id": "f4dd55c0-78e2-3698-b965-b36098385dae",
                                                "text": "„… die Bezeichnung »Erzherzog« wurde zwar nicht ausdrücklich anerkannt, aber geduldet; sie sollte zum Ausdruck bringen, dass der so Titulierte über mehrere Herzogtümer herrschte, so wie zum Beispiel einem Erzbischof mehrere Bistümer unterstehen.“"
                                            },
                                            {
                                                "example_id": "7c841d48-89b9-44ca-9ead-a35a6e5615ab",
                                                "sense_id": "f4dd55c0-78e2-3698-b965-b36098385dae",
                                                "text": "„Erzherzog Eugen war der letzte Deutschmeister (von 1894 bis 1923) und Gründer eines Waisenhauses im niederösterreichischen Unterdambach, das heute nicht mehr existiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7da0c2f8-6b4d-3612-bdc4-ac746322e948",
                                        "entry_id": "2779ec87-6fed-397e-830d-8a712b820068",
                                        "glosses": [
                                            "Person, die [1] als Titel führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6721318a-3f2d-4d0e-b321-c70bfdfb7ece",
                                                "sense_id": "7da0c2f8-6b4d-3612-bdc4-ac746322e948",
                                                "text": "„Zwischen 1807 und 1836 errichtete [Kornhäusel] viele Bauten in Baden, darunter […] 1820-1823 für Erzherzog Carl die Weilburg im Helenental (zerstört).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
