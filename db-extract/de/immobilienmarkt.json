                "senses": [
                    {
                        "sense_id": "389e4a22-1ef0-39b9-b6ba-9e91fc6e7ef8",
                        "entry_id": "594fe31c-8132-33b5-b196-89042e07deaf",
                        "glosses": [
                            "Gesamtheit der Aktivitäten um die Vermarktung (und zum Teil auch für die Entwicklung) von Immobilien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5f2fe49-0523-412c-a7a5-e8c203969b58",
                                "sense_id": "389e4a22-1ef0-39b9-b6ba-9e91fc6e7ef8",
                                "text": "„Es scheint so, als hätten die Investoren mit der Immobilie ein neues gelobtes Investment-Land entdeckt. Während die einen die Wiederauferstehung des deutschen Immobilienmarktes feiern, gibt es auch erste mahnende Stimmen.“"
                            },
                            {
                                "example_id": "250d21a7-755c-43a6-8eb3-ab86a126f3b1",
                                "sense_id": "389e4a22-1ef0-39b9-b6ba-9e91fc6e7ef8",
                                "text": "Es droht ein Absturz am Immobilienmarkt - und damit die Rezession."
                            },
                            {
                                "example_id": "73d8eaec-d0c1-45d8-b263-1974756cfb7a",
                                "sense_id": "389e4a22-1ef0-39b9-b6ba-9e91fc6e7ef8",
                                "text": "„Chinas Immobilienmarkt steht vor einem massiven Einbruch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
