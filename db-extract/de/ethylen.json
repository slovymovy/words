                                    {
                                        "sense_id": "26a5430e-f6c3-33f0-9cc5-f74409cf30e8",
                                        "entry_id": "57cdac28-d28b-3a1c-971b-46027c664b3f",
                                        "glosses": [
                                            "The common name for the organic chemical compound ethene. The simplest alkene, a colorless gaseous (at room temperature and pressure) hydrocarbon with the chemical formula C₂H₄."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b15a33a-895c-44ff-a5ea-2cad1cd73029",
                                                "sense_id": "26a5430e-f6c3-33f0-9cc5-f74409cf30e8",
                                                "text": "SE onset depends on a complex network of interactions among plant growth regulators, mainly auxins and cytokinins, during the proembryogenic early stages, and ethylene and gibberellic and abscisic acids later in the development of somatic embryos."
                                            },
                                            {
                                                "example_id": "8055a0de-d438-4e06-a78c-b7facee33247",
                                                "sense_id": "26a5430e-f6c3-33f0-9cc5-f74409cf30e8",
                                                "text": "As a demonstration, we first establish the correctness of the Jacobian matrices for kinetic models of hydrogen, methane, ethylene, and isopentanol oxidation, then demonstrate the performance achievable on CPUs and GPUs using pyJac via matrix evaluation timing comparisons.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4461bf73-89e3-3d41-9619-17d16a707514",
                                        "entry_id": "57cdac28-d28b-3a1c-971b-46027c664b3f",
                                        "glosses": [
                                            "The divalent radical derived from ethane."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2142a18b-65a9-4349-a031-29b9760025b6",
                        "source_entry_id": "bd674656-845d-3320-a508-5fd6234c644f",
