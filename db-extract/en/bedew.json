                                        "examples": [
                                            {
                                                "example_id": "3ac978ec-8474-4459-b5b2-cd64eaf6d35b",
                                                "sense_id": "feeea66d-3f54-3e1a-891a-e572e0814625",
                                                "text": "„Die unteren Seiten von Steinen, Schiefern und Papier auf Gras oder Sand waren viel mehr betaut als die oberen Seiten.“"
                                            },
                                            {
                                                "example_id": "cb0000e1-2c51-44b7-a0b5-45a936369e93",
                                                "sense_id": "feeea66d-3f54-3e1a-891a-e572e0814625",
                                                "text": "„Euch kühlet des Monds Freundlicher Zauberhauch, Und euch betauen, ach, Aus diesen Augen Der ewig belebenden Liebe Voll schwellende Tränen.“ (Goethe)"
                                            }
