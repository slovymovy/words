                "senses": [
                    {
                        "sense_id": "93e1db4a-007c-3b4a-bfd3-e107cc20818a",
                        "entry_id": "d4bd003f-d55e-37f8-b67c-040d9a1d9b93",
                        "glosses": [
                            "разг. издать свиристящий звук"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7c2b05-2bf3-4407-a8e0-e2a42b776cba",
                                "sense_id": "93e1db4a-007c-3b4a-bfd3-e107cc20818a",
                                "text": "Раздув трепещущие пузыри, они [лягушки] просвиристели свое приветственное «ква»."
                            }
                        ]
                    },
                    {
                        "sense_id": "24ddb191-7357-3249-bd74-1e91a11636b4",
                        "entry_id": "d4bd003f-d55e-37f8-b67c-040d9a1d9b93",
                        "glosses": [
                            "неперех. разг. свиристеть в течение определённого времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "905ff909-4e39-4d84-97a1-1fdbaeb35aeb",
                                "sense_id": "24ddb191-7357-3249-bd74-1e91a11636b4",
                                "text": "Птицы просвиристели целый день."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd0d1d78-1ea8-38ac-9be8-a3799d5732f2",
                        "entry_id": "d4bd003f-d55e-37f8-b67c-040d9a1d9b93",
                        "glosses": [
                            "неперех. разг. пройти, издавая свиристящий звук"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ad0b12-69d2-4774-a741-3f7376899e54",
                                "sense_id": "fd0d1d78-1ea8-38ac-9be8-a3799d5732f2",
                                "text": "Поезда шумят мимо, камешки по откосу ветром метут ― устремляются люди; самолет этот новый просвиристит, белую нитку в небе скрутит ― поспешают."
                            }
                        ]
                    }
