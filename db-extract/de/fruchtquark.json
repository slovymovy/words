                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f8f3ff-da6f-414e-8787-2cca77d56954",
                                "sense_id": "083b8b11-ea21-36ba-8e56-f1e8fefc07e8",
                                "text": "„Die neuen Marketingregeln gelten auch für Lebensmittel mit einem hohen Gehalt an Zucker, Fett oder Salz wie Kartoffelchips, Fruchtquark, Cornflakes oder Tomatensaucen.“"
                            },
                            {
                                "example_id": "a3dac924-5dee-4378-af8a-6ed7b323770b",
                                "sense_id": "083b8b11-ea21-36ba-8e56-f1e8fefc07e8",
                                "text": "„Von Rio aus trat Açaí seinen Siegeszug nach Kalifornien und Florida an – von dort gelangte die Frucht nach Europa, wo es inzwischen mit Açaí versetzten Fruchtquark und Mineralwasser zu kaufen gibt.“"
                            },
                            {
                                "example_id": "c04be104-cd40-44da-9dcd-22d2b481c903",
                                "sense_id": "083b8b11-ea21-36ba-8e56-f1e8fefc07e8",
                                "text": "„Wenn er Fruchtquark essen möchte, greift er zu Milram, und wenn seine Frau anderen Fruchtquark ins Haus bringt, ist ihm das schon eine Auseinandersetzung wert; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
