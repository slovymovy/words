                "senses": [
                    {
                        "sense_id": "b02df502-1931-38ea-b85d-c1c240c8f2b8",
                        "entry_id": "fbe50a55-8d55-35a0-bb43-98d49fd635ec",
                        "glosses": [
                            "To sabotage machinery or tools as part of an industrial dispute, particularly the tools of a workman who went against the union."
                        ],
                        "tags": [
                            "Northern-England",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d71b5332-1ca3-44f1-ba3e-6f5737a369ad",
                                "sense_id": "b02df502-1931-38ea-b85d-c1c240c8f2b8",
                                "text": "Did you also employ them to ratten people if they had broken any rules of your society, for instance, by having too many apprentices?"
                            },
                            {
                                "example_id": "d6868798-be0d-4547-a795-44b6671dd272",
                                "sense_id": "b02df502-1931-38ea-b85d-c1c240c8f2b8",
                                "text": "[…] derived from the sabot or shoe beneath railway lines. The saboteur was thus a remover of metal shoes, a train-wrecker. I must leave it at that. Meanwhile why not restore ratten to its old place in the Trade Union vocabulary, that is if, in these times of scant, we must endure any such wanton hindrance of the works?"
                            }
                        ]
                    }
