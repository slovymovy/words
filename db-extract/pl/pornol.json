                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b0c0cd0-c996-4534-8e1d-78662ac20222",
                                                "sense_id": "640e7ad4-fa8c-3b73-855c-54452e03f1af",
                                                "text": "A Hollywood studio was filming on location in NYC."
                                            },
                                            {
                                                "example_id": "40be9884-da9a-4a77-bbc2-fc7817f1d8d9",
                                                "sense_id": "640e7ad4-fa8c-3b73-855c-54452e03f1af",
                                                "text": "I tried to film the UFO as it passed overhead."
                                            },
                                            {
                                                "example_id": "c95bad37-26c1-4204-97c4-3a15dfa713a3",
                                                "sense_id": "640e7ad4-fa8c-3b73-855c-54452e03f1af",
                                                "text": "It was truly one of the most horrific filming experiences of my career there, contrasting neatly with some of the best of my career - filming in various off-limits storerooms at LTM's Acton Depot."
                                            }
                                        ]
