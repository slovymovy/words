                "senses": [
                    {
                        "sense_id": "1a75061c-8626-38c6-8e8a-01edb8b90111",
                        "entry_id": "48ef4f22-fde5-374c-be02-168853997fe5",
                        "glosses": [
                            "Zustand/Verfassung, stimmungsmäßig niedergeschlagen, bedrückt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e2a4b6-e4a5-4dcc-8fe9-29ceb119d289",
                                "sense_id": "1a75061c-8626-38c6-8e8a-01edb8b90111",
                                "text": "„In ungewohnter Gedrücktheit verliefen die nächsten Tage auf dem Matthishof, der Vorfall an jenem Abend hatte seine Spuren hinterlassen.“"
                            },
                            {
                                "example_id": "a93f8414-1225-4641-a60d-33a0c0248d1c",
                                "sense_id": "1a75061c-8626-38c6-8e8a-01edb8b90111",
                                "text": "„Trotz ihrer kläglichen Gedrücktheit schien sie nicht mehr so hilflos und fügsam wie früher.“"
                            },
                            {
                                "example_id": "82d58d19-e4bf-45f1-b12d-7838cb0c0ae3",
                                "sense_id": "1a75061c-8626-38c6-8e8a-01edb8b90111",
                                "text": "„Dieser gute Wille Kants entspricht vollständig der Ohnmacht, Gedrücktheit und Misere der deutschen Bürger, deren kleinliche Interessen nie fähig waren, sich zu gemeinschaftlichen, nationalen Interessen einer Klasse zu entwickeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9f398c9-379b-4319-9cd1-ed6d462a1acf",
                        "source_entry_id": "48ef4f22-fde5-374c-be02-168853997fe5",
                        "source_sense_id": "1a75061c-8626-38c6-8e8a-01edb8b90111",
                        "source_sense_description": "Zustand/Verfassung, stimmungsmäßig niedergeschlagen, bedrückt zu sein",
                        "target_lang_word": "dejection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dejection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df24a7b8-59ca-3406-8593-14101c0e05d3",
                                        "entry_id": "a406fd40-ce51-3a09-a378-78d3a3a76538",
                                        "glosses": [
                                            "A state of melancholy or depression; low spirits, the blues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebda68d7-5357-3a06-852b-6f5d2152a5da",
                                        "entry_id": "a406fd40-ce51-3a09-a378-78d3a3a76538",
                                        "glosses": [
                                            "The act of humbling or abasing oneself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23421866-f8b1-45a7-b12d-73850b428297",
                                                "sense_id": "ebda68d7-5357-3a06-852b-6f5d2152a5da",
                                                "text": "Adoration implies submission and dejection, so that while we worship we cast down ourselves; there must be therefore some great eminence in the object worshipped, or else we should dishonor our own nature in the worship of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54747406-941e-36ea-8d15-8fb71aae6fe9",
                                        "entry_id": "a406fd40-ce51-3a09-a378-78d3a3a76538",
                                        "glosses": [
                                            "A low condition; weakness; inability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b34edf3-5c58-4547-b761-a59f92b8e89b",
                                                "sense_id": "54747406-941e-36ea-8d15-8fb71aae6fe9",
                                                "text": "Meat remaining in the stomach undigested, dejection of appetite, wind coming upwards, are signs of a phlegmatick constitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                                        "entry_id": "a406fd40-ce51-3a09-a378-78d3a3a76538",
                                        "glosses": [
                                            "Defecation or feces."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195d1cb0-bdc2-4aab-bf3a-0578752907f4",
                                                "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                                                "text": "His dejections were frequent, loose, changing in character from hour to hour, made up of undigested food, of mucus and watery fluid, varying in color, mostly green, and never healthy in consistence, color, or odor."
                                            },
                                            {
                                                "example_id": "5ace986c-5aa6-4f46-93a3-f29e02b741e9",
                                                "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                                                "text": "No dejection since his entrance, nor has he passed urine."
                                            },
                                            {
                                                "example_id": "8e3d53f6-21d2-4173-b33e-478c9bf8a277",
                                                "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                                                "text": "Chorera infantum may begin as an attack of acute indigestion, or, what is more frequently the case, suddenly, with severe vomiting and copious dejections, high fever and rapid prostration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
