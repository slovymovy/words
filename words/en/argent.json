{
    "word_family": [
        "argentine",
        "argentiferous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f05ef88b-7025-3e6d-a97d-6d20d153eeba",
                    "sense_definition": "The chemical element silver.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient alchemists often referred to the precious metal <w>argent</w> in their cryptic writings.",
                            "target_lang_translations": {
                                "zh": "古代炼金术士常在他们晦涩的著作中提到这种名为<w>银</w>的贵金属。"
                            }
                        },
                        {
                            "text": "In poetic descriptions of the moon, the light is frequently compared to the luster of <w>argent</w>.",
                            "target_lang_translations": {
                                "zh": "在对月亮的诗意描写中，其光芒常被比作<w>银</w>的光泽。"
                            }
                        }
                    ],
                    "synonyms": [
                        "silver"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in literary or poetic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "化学元素银。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银",
                                "target_lang_sense_clarification": "指代金属银的文学或古语用法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97c6f207-4d19-3421-917c-db295059d44d",
                    "sense_definition": "The white or silver color used in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms features a lion rampant in <w>argent</w> against a deep blue background.",
                            "target_lang_translations": {
                                "zh": "该纹章以深蓝色为底，绘有一只<w>银色</w>的跃立狮子。"
                            }
                        },
                        {
                            "text": "In heraldic blazon, the color <w>argent</w> represents purity and peace.",
                            "target_lang_translations": {
                                "zh": "在纹章描述中，<w>银色</w>代表纯洁与和平。"
                            }
                        }
                    ],
                    "synonyms": [
                        "silver"
                    ],
                    "target_lang_definitions": {
                        "zh": "纹章学中使用的白色或银色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银色",
                                "target_lang_sense_clarification": "纹章学中的颜色术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "862c611b-6ab9-37e8-8172-27a7f96b7d7b",
                    "sense_definition": "A state of whiteness or something that is white.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winter landscape was covered in a brilliant <w>argent</w> that blinded the travelers.",
                            "target_lang_translations": {
                                "zh": "冬日的景色被一片耀眼的<w>银白</w>覆盖，令旅人目眩。"
                            }
                        },
                        {
                            "text": "She admired the <w>argent</w> of the lilies blooming in the garden at midnight.",
                            "target_lang_translations": {
                                "zh": "她赞叹着午夜花园里盛开的百合花那如<w>银白</w>般的光泽。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "洁白的状态或白色的事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银白",
                                "target_lang_sense_clarification": "形容如银般洁白的光泽或颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d084ddb-83b7-3820-965c-fa773cde7e85",
                    "sense_definition": "A small moth belonging to the genus Argyresthia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entomologist identified the tiny specimen as an <w>argent</w> by its distinct wing pattern.",
                            "target_lang_translations": {
                                "zh": "昆虫学家通过其独特的翅膀花纹，将这个微小的标本鉴定为一只<w>银蛾</w>。"
                            }
                        },
                        {
                            "text": "Many species of <w>argent</w> are known to feed on the leaves of fruit trees.",
                            "target_lang_translations": {
                                "zh": "已知许多种类的<w>银蛾</w>以果树叶片为食。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "属于银蛾属的一种小型蛾类。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银蛾",
                                "target_lang_sense_clarification": "指代Argyresthia属的蛾类"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "15660f24-0762-3de7-9892-f5425b74641c",
                    "sense_definition": "Having the appearance or color of silver.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>argent</w> moon cast a shimmering reflection across the surface of the dark lake.",
                            "target_lang_translations": {
                                "zh": "<w>银色的</w>月亮在深色的湖面上投下粼粼波光。"
                            }
                        },
                        {
                            "text": "He wore an <w>argent</w> ring that caught the light whenever he moved his hand.",
                            "target_lang_translations": {
                                "zh": "他戴着一枚<w>银色的</w>戒指，每当他移动手时，戒指便会闪烁光芒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "silver"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or poetic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "具有银的外观或颜色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银色的",
                                "target_lang_sense_clarification": "形容具有银色光泽的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65aef3da-292c-3f00-b7a8-120844d37ee5",
                    "sense_definition": "Relating to the white or silver tincture used in a coat of arms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shield is divided into two sections, one gules and the other <w>argent</w>.",
                            "target_lang_translations": {
                                "zh": "盾徽被分为两部分，一部分为红色，另一部分为<w>银色</w>。"
                            }
                        },
                        {
                            "text": "The herald described the <w>argent</w> border as a symbol of the family's ancient lineage.",
                            "target_lang_translations": {
                                "zh": "纹章官将那道<w>银色的</w>边框描述为该家族古老血统的象征。"
                            }
                        }
                    ],
                    "synonyms": [
                        "silver"
                    ],
                    "target_lang_definitions": {
                        "zh": "与纹章中使用的白色或银色有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银色的",
                                "target_lang_sense_clarification": "纹章学中描述颜色的形容词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e29b1a4f-dfba-31aa-8064-7ffcbfe5b547",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian discovered a document signed by a man named <w>Argent</w> in the archives.",
                            "target_lang_translations": {
                                "zh": "历史学家在档案中发现了一份由一位名叫<w>阿金特</w>的男子签署的文件。"
                            }
                        },
                        {
                            "text": "Professor <w>Argent</w> gave a fascinating lecture on the history of medieval heraldry.",
                            "target_lang_translations": {
                                "zh": "<w>阿金特</w>教授就中世纪纹章学历史发表了一场精彩的演讲。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿金特",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}