            {
                "entry_id": "c9835db8-3a0a-31ae-947a-986cc46b1b76",
                "word": "Cheyennes",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d14563a6-4628-39dd-ad45-bdba4115e26f",
                        "entry_id": "c9835db8-3a0a-31ae-947a-986cc46b1b76",
                        "glosses": [
                            "Nation amérindienne des Grandes Plaines, proche alliée des Arapahos et généralement alliée des Lakotas (Sioux), dont le territoire est situé aux États-Unis."
                        ],
                        "tags": [
                            "collectively",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6d045b2e-5679-40bb-8da2-a6243dd65030",
                                "sense_id": "d14563a6-4628-39dd-ad45-bdba4115e26f",
                                "text": "Ils ont échappé à mes ruses, mais ils n’échapperont pas aux Cheyennes."
                            },
                            {
                                "example_id": "ea7ae2ad-e32a-431c-963d-199acd16df31",
                                "sense_id": "d14563a6-4628-39dd-ad45-bdba4115e26f",
                                "text": "Le tomahawk était la hache de guerre des Indiens, et les Apaches l’une des plus farouches nations indiennes qui, comme les Sioux ou les Cheyennes, furent victimes d’une effroyable épuration ethnique."
                            },
                            {
                                "example_id": "33343ac7-2fdc-461a-91bf-558073ef6915",
                                "sense_id": "d14563a6-4628-39dd-ad45-bdba4115e26f",
                                "text": "Ces territoires lointains sont peuplés de tribus indigènes aux réactions incontrôlables, les Kiowas, les Cheyennes, ou les Pawnees, peut-être les pires de tous…"
                            }
                        ]
                    }
