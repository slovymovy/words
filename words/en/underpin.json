{
    "word_family": [
        "underpinning"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6cb2e42e-eff6-3030-815d-1e81fc6702c4",
                    "sense_definition": "To provide a foundation or basis for something, or to support an idea or argument.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strong economic growth <w>underpins</w> the stability of the entire region.",
                            "target_lang_translations": {
                                "ru": "Устойчивый экономический рост <w>лежит в основе</w> стабильности всего региона."
                            }
                        },
                        {
                            "text": "Scientific evidence <w>underpins</w> the new health policy recommendations.",
                            "target_lang_translations": {
                                "ru": "Научные данные <w>подкрепляют</w> новые рекомендации по политике в области здравоохранения."
                            }
                        }
                    ],
                    "synonyms": [
                        "underlie"
                    ],
                    "common_phrases": [
                        "underpinned by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить основой, фундаментом для чего-либо или подкреплять идею, аргумент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лежать в основе",
                                "target_lang_sense_clarification": "служить фундаментом или базой"
                            },
                            {
                                "target_lang_word": "подкреплять",
                                "target_lang_sense_clarification": "обосновывать аргументами, фактами"
                            },
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "обеспечивать стабильность, сохранять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4890977a-c64f-3786-b10a-292ded016f00",
                    "sense_definition": "To physically support a structure from below using props or masonry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers had to <w>underpin</w> the old building to prevent it from sinking into the soft soil.",
                            "target_lang_translations": {
                                "ru": "Инженерам пришлось <w>укрепить</w> старое здание снизу, чтобы предотвратить его проседание в мягкий грунт."
                            }
                        },
                        {
                            "text": "The construction crew worked for weeks to <w>underpin</w> the foundation of the historic bridge.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада неделями работала над тем, чтобы <w>укрепить фундамент</w> исторического моста."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически укреплять или подпирать конструкцию снизу с помощью опор или каменной кладки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "подводить опоры или фундамент"
                            },
                            {
                                "target_lang_word": "подпирать",
                                "target_lang_sense_clarification": "ставить подпорки снизу"
                            },
                            {
                                "target_lang_word": "подводить фундамент",
                                "target_lang_sense_clarification": "в строительстве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}