                "senses": [
                    {
                        "sense_id": "8ac02fba-bfea-385d-ae57-00c1bece6acb",
                        "entry_id": "f17a3a62-f69a-3660-87e0-904c8b49f81e",
                        "glosses": [
                            "vorübergehender Aufenthalt infolge einer Unterbrechung einer Fahrt/Reise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b198da5-6308-4957-9350-db3aa5bd35da",
                                "sense_id": "8ac02fba-bfea-385d-ae57-00c1bece6acb",
                                "text": "„An jedem Zwischenhalt fand er jemanden – ein Mädchen, eins immer exotischer als das davor –, ihm für einen Matrosenpreis die Zeit zu vertreiben.“"
                            },
                            {
                                "example_id": "34501f5a-4932-4495-a394-b512f0a84743",
                                "sense_id": "8ac02fba-bfea-385d-ae57-00c1bece6acb",
                                "text": "„Während wir darauf warteten, dass der Kellner die bestellten Sachen brachte, las ich die Zeitung und trank eine der Mâcon-Flaschen aus, die ich beim letzten Zwischenhalt entkorkt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
