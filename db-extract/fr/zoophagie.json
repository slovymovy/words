                        "glosses": [
                            "Condition des animaux qui se nourrissent d’autres animaux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "435a5b9f-c519-30a9-97b6-4ebfa84f5581",
                        "entry_id": "c7b86017-fec0-33ee-9617-41757de9c675",
                        "glosses": [
                            "Alimentation dans laquelle les produits carnés rappellent l’animal dont ils sont issus, par opposition à la sarcophagie."
                        ],
                        "tags": [
                            "Nutrition"
                        ],
                        "examples": [
                            {
                                "example_id": "c32d0c07-2bde-40f8-aa99-f035bcb6fd59",
                                "sense_id": "435a5b9f-c519-30a9-97b6-4ebfa84f5581",
                                "text": "L’axe opposant zoophagie et sarcophagie s’esquisse à travers le détail des réponses et semble très pertinent pour caractériser les différences franco-allemandes. … Le bœuf apparaît donc comme l’animal à viande par excellence, pouvant se plier à la fois aux exigences de la zoophagie et à celles de la sarcophagie."
                            }
                        ]
                    }
