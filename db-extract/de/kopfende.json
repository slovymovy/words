                                    },
                                    {
                                        "sense_id": "2d9d5252-ecc8-3285-a629-fd142c212047",
                                        "entry_id": "1d0ca5d8-fa7b-39ae-a333-8dc9f3d0c40a",
                                        "glosses": [
                                            "A panel, usually of metal, attached to the head of a fore-and-aft sail for additional strength."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ced6f8d8-caab-3ebf-bf69-32330fc4df9b",
                                        "entry_id": "1d0ca5d8-fa7b-39ae-a333-8dc9f3d0c40a",
                                        "glosses": [
                                            "A board on the front of a train, carrying the train's name or that of the service it is on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195d97ed-fddc-4a17-9b02-319ad88c24bb",
                                                "sense_id": "ced6f8d8-caab-3ebf-bf69-32330fc4df9b",
                                                "text": "A new use has been found for the L.M.S.R. observation car which previously worked in the Llandudno area. Mr. W. G. S. Wike writes that, still carrying headboards with the inscription \"Llandudno and Blaenau Festiniog\", it found its way to the Blackpool District, where it was used for familiarising enginemen with the various routes of access to this populous resort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b719a8d-8afd-3394-b416-41fed805cbb2",
                                        "entry_id": "1d0ca5d8-fa7b-39ae-a333-8dc9f3d0c40a",
                                        "glosses": [
                                            "A grave marker made of wood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db5f4b19-e32c-461c-9d91-cdbfeef8adac",
                        "source_entry_id": "50a44910-3ca5-36c7-bab0-864e27635d58",
                        "source_sense_id": "f638a1e5-4385-3102-9bbf-07eedcc843ac",
                        "source_sense_description": "der Teil einer Liegestatt, an dem der Kopf liegt",
                        "target_lang_word": "chevet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3aaf6e43-c06e-384e-b324-fe432194f2f4",
                                        "entry_id": "2e377946-7215-354f-9c8a-e10f4de0c508",
                                        "glosses": [
                                            "Tête de lit ou partie de la literie où l’on pose sa tête quand on est couché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eea3bba1-d916-452f-8b7e-81688f198dd3",
                                                "sense_id": "3aaf6e43-c06e-384e-b324-fe432194f2f4",
                                                "text": "Il s’endort aussitôt qu’il a la tête sur le chevet."
                                            },
                                            {
                                                "example_id": "542cd510-9777-444e-9661-057a72b55de9",
                                                "sense_id": "3aaf6e43-c06e-384e-b324-fe432194f2f4",
                                                "text": "Il ne peut dormir, si le chevet n’est bien haut."
                                            },
                                            {
                                                "example_id": "675088f8-22e9-4cf7-a610-bf0828a6cb56",
                                                "sense_id": "3aaf6e43-c06e-384e-b324-fe432194f2f4",
                                                "text": "Il aime le chevet bien bas."
                                            },
                                            {
                                                "example_id": "4d7710dc-05ba-4115-aace-eb9bc9c55b06",
                                                "sense_id": "3aaf6e43-c06e-384e-b324-fe432194f2f4",
                                                "text": "Entretenir quelqu’un au chevet de son lit."
                                            },
                                            {
                                                "example_id": "e456bc36-9576-42c9-b183-406fb7184cf4",
                                                "sense_id": "3aaf6e43-c06e-384e-b324-fe432194f2f4",
                                                "text": "Je m’assis à son chevet."
                                            },
                                            {
                                                "example_id": "026d6101-c706-45ce-9441-ee8855f4d104",
                                                "sense_id": "3aaf6e43-c06e-384e-b324-fe432194f2f4",
                                                "text": "Sans témoigner autrement d’inquiétude, Sigognac couchait dans la chambre la plus voisine, l’épée sous le chevet et tout habillé en cas d’algarade nocturne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73713c2b-ccab-325e-857d-2ebd96692056",
                                        "entry_id": "2e377946-7215-354f-9c8a-e10f4de0c508",
                                        "glosses": [
                                            "Ce dont on ne se sépare jamais (même la nuit), dont on peut se servir dans toutes les occasions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b391978f-4f8d-4cba-bcd0-c8d0f0f24056",
                                                "sense_id": "73713c2b-ccab-325e-857d-2ebd96692056",
                                                "text": "C’est mon livre de chevet, c’est un livre de chevet."
                                            },
                                            {
                                                "example_id": "ad111807-650c-43af-9ff2-dc985bceaa05",
                                                "sense_id": "73713c2b-ccab-325e-857d-2ebd96692056",
                                                "text": "Épée de chevet, épée dont on ne se séparait jamais, qu’on voulait avoir toujours à sa portée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ffeae1f-b764-3d29-a0f7-dd19422b74d5",
                                        "entry_id": "2e377946-7215-354f-9c8a-e10f4de0c508",
                                        "glosses": [
                                            "Partie qui termine le chœur d’une église : elle est souvent circulaire et plus élevée que le reste. Désigne parfois, plus spécifiquement, l’extérieur de cette partie du bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96a18f63-8fb6-44a5-ab60-4a0ed4135899",
                                                "sense_id": "0ffeae1f-b764-3d29-a0f7-dd19422b74d5",
                                                "text": "La nef était déserte ; au chevet de l’église, deux troupes séparées de garçons et de filles écoutaient des instructions."
                                            },
                                            {
                                                "example_id": "79e88fd0-4017-4786-bca0-0949404968e6",
                                                "sense_id": "0ffeae1f-b764-3d29-a0f7-dd19422b74d5",
                                                "text": "À Baby (Seine-et-Marne), il a été encore construit en 1743, c’est-à-dire à une date avancée du XVIIIᵉ siècle, un mausolée en forme de rotonde au chevet de l’église paroissiale pour abriter le tombeau d’Alexis-Jean Durand de Lagny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc95ce27-fc45-3566-9d2c-59d4a5f3e3e5",
                                        "entry_id": "2e377946-7215-354f-9c8a-e10f4de0c508",
                                        "glosses": [
                                            "Table de chevet."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22bcdb7-0a04-4a6a-9c7c-40771de750af",
                                                "sense_id": "fc95ce27-fc45-3566-9d2c-59d4a5f3e3e5",
                                                "text": "Elle disposa les fleurs au chevet, fit arrêter le balancier de l'horloge, voiler les glaces et les miroirs, fermer les fenêtres et cacher les portraits."
                                            },
                                            {
                                                "example_id": "32af6b7d-3cd4-4c71-8aaf-b4d6d793c5bb",
                                                "sense_id": "fc95ce27-fc45-3566-9d2c-59d4a5f3e3e5",
                                                "text": "Claire ouvrit les yeux et saisit le réveil posé sur le chevet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aae2f0c5-3dcb-459a-9cf3-8cb436b64690",
                        "source_entry_id": "50a44910-3ca5-36c7-bab0-864e27635d58",
                        "source_sense_id": "f638a1e5-4385-3102-9bbf-07eedcc843ac",
                        "source_sense_description": "der Teil einer Liegestatt, an dem der Kopf liegt",
                        "target_lang_word": "tête de lit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête de lit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adf3a2a5-0d2b-35de-bbf1-f2bf2237dec8",
                                        "entry_id": "1449a2c7-2d7a-3b84-ad01-4762a98402da",
                                        "glosses": [
                                            "Pièce d’ameublement qui se fixe à l'extrémité du lit où le dormeur ou la dormeuse pose sa tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d4f0725-53d4-4e8b-9bd8-93b370bbca22",
                                                "sense_id": "adf3a2a5-0d2b-35de-bbf1-f2bf2237dec8",
                                                "text": "Enfin elle se retrouva en position assise, un peu avachie, adossée à la tête de lit, les bras écartés en l’air, les reins calés contre l’oreiller trempé de sueur dans sa taie de coton froissée."
                                            },
                                            {
                                                "example_id": "9ac8f5f8-a1b1-4045-8c30-3fc59203d9a3",
                                                "sense_id": "adf3a2a5-0d2b-35de-bbf1-f2bf2237dec8",
                                                "text": "À la différence des nôtres, les lits égyptiens ne possédaient pas de « tête de lit » mais un panneau fixé du côté des pieds, peut-être pour éviter au dormeur de glisser car les pieds du lit étaient plus hauts […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
