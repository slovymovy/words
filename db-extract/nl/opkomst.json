                                                "sense_id": "2dee1117-dbbc-377e-866a-c4d94d336863",
                                                "text": "Auf den Berg gibt es einen steilen Aufstieg und eine Gondelbahn."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c7d8637c-a015-3ba6-9276-89ae3970887e",
