                                    {
                                        "sense_id": "8e326e56-399f-34f9-b853-4b6bb1918f77",
                                        "entry_id": "17bc1cc2-768b-34db-804c-53f556ea8be3",
                                        "glosses": [
                                            "A commissioned officer in an armed military organization, typically the highest rank before flag officer ranks (generals). It is generally found in armies, air forces or naval infantry (marines)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f279a87b-bf43-462b-9c74-5861453d3508",
                                                "sense_id": "8e326e56-399f-34f9-b853-4b6bb1918f77",
                                                "text": "The colonel and his sponsor made a queer contrast: Greystone long and stringy, with a face that seemed as if a cold wind was eternally playing on it. […] But there was not a more lascivious reprobate and gourmand in all London than this same Greystone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ad816b0-ee4f-3c2e-b9e9-04745df27e41",
                                        "entry_id": "17bc1cc2-768b-34db-804c-53f556ea8be3",
                                        "glosses": [
                                            "A military leader, distinct from the modern professional military rank."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd74bb88-3dd4-4539-9624-a89dfb8e8647",
                                                "sense_id": "6ad816b0-ee4f-3c2e-b9e9-04745df27e41",
                                                "text": "General Charles-Maximilian Fiennes was made colonel of the army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dffe451-61f9-3c02-984c-64f4a656f16e",
                                        "entry_id": "17bc1cc2-768b-34db-804c-53f556ea8be3",
                                        "glosses": [
                                            "An honorary civilian title bestowed by some southern US states, most commonly Kentucky; notably Colonel Sanders of KFC."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a935be4-8219-4f7f-8f6c-7aa34083693f",
                                                "sense_id": "6dffe451-61f9-3c02-984c-64f4a656f16e",
                                                "text": "\"Colonel\" was often used as an honorific, indicating no actual military service: between 1792 and 1916, according to Ron Bryant, a curator at the Kentucky Historical Society, 400 of the 650 colonels commissioned were honorary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad4a722-46aa-3ad5-84ee-d8face10f4ba",
                                        "entry_id": "17bc1cc2-768b-34db-804c-53f556ea8be3",
                                        "glosses": [
                                            "An informal title used to address an elderly man."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff07ba86-dcd1-304e-b472-1f7abf92c382",
                                        "entry_id": "17bc1cc2-768b-34db-804c-53f556ea8be3",
                                        "glosses": [
                                            "A form of address for an auctioneer, from the American Civil War practice of commanding officers organizing the public sale of seized goods."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
