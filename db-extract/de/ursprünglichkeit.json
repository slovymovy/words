                                            {
                                                "example_id": "8d06d14c-df29-48da-990b-43ad81f18929",
                                                "sense_id": "1e4f70fa-884c-33d7-8c30-c73aaf72ebe1",
                                                "text": "A originalidade deste livro não está na história e nas estórias narradas, mas no ponto de observação do autor, no seu olhar contra-majoritário, na atitude de resistência intelectual e política ao conhecimento convencional."
                                            }
