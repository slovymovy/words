                        "examples": [
                            {
                                "example_id": "3949bba8-650c-482f-80ed-a2fed138704b",
                                "sense_id": "aaf757d2-eb3f-3474-9c23-1a691b3e0901",
                                "text": "De KLM, die graag haar luchtnet wilde uitbreiden, dacht met Texel mee: „Het terrein kan zeer goed in gebruik blijven als weiland, wanneer het aanwezige vee bij aankomst en vertrek van een vliegtuig slechts even bijeengedreven wordt.”"
                            },
                            {
                                "example_id": "879d525c-7a17-4a5c-9468-27db49d67cbe",
                                "sense_id": "aaf757d2-eb3f-3474-9c23-1a691b3e0901",
                                "text": "De commissie gaf woensdag aan dat UPS bereid was om in de 15 landen waar de bezwaren golden onderdelen van TNT te verkopen. De koper zou daarbij 5 jaar lang toegang krijgen tot het Europese luchtnetwerk van UPS en TNT. Dat was echter niet genoeg om de concurrentiebezwaren weg te nemen."
                            }
                        ]
                    }
