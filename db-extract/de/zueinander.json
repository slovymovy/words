                        "entry_id": "fd207b89-7bf3-34f2-b8af-155d29da7aff",
                        "glosses": [
                            "(zależnie od kontekstu, np.) do / wobec siebie, do / wobec siebie nawzajem, jeden do / wobec drugiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c6914e9-0f3b-4b05-85d4-1182506749d6",
                                "sense_id": "df88f4aa-84f3-3929-8198-eb86bf6a9a5f",
