                    {
                        "translation_id": "dd15aefb-cde0-43f3-b851-275da7f3ab8e",
                        "source_entry_id": "aaec1f8e-ebf1-3491-a7ba-6e1dc779745f",
                        "source_sense_id": "53ac07dd-4019-3600-9c9a-3c284d6d691e",
                        "target_lang_word": "appearance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appearance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d95b3bc-6402-3752-a995-1ca889a052b7",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "The act of appearing or coming into sight; the act of becoming visible to the eye."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77f1c73-76c1-4547-9a82-036837983fb4",
                                                "sense_id": "7d95b3bc-6402-3752-a995-1ca889a052b7",
                                                "text": "His sudden appearance surprised me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eff7e4d2-0d68-3d31-969e-1d3d9d41abb6",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "A thing seen; a phenomenon; an apparition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "289ef040-7074-42af-9101-22aad2eac15e",
                                                "sense_id": "eff7e4d2-0d68-3d31-969e-1d3d9d41abb6",
                                                "text": "There was a strange appearance in the sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53db04f8-0981-33aa-91a4-11de05997d66",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "The way something looks; personal presence"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d90ef6-cdfb-4cb4-8670-be7d67aeb4a3",
                                                "sense_id": "53db04f8-0981-33aa-91a4-11de05997d66",
                                                "text": "And now am come to ſee of whom ſuch noiſe\n Hath walk'd about, and each limb to ſurvey,\n If thy appearance anſwer loud report."
                                            },
                                            {
                                                "example_id": "10ffbe39-0993-4211-82b0-a8c04ad8f802",
                                                "sense_id": "53db04f8-0981-33aa-91a4-11de05997d66",
                                                "text": "The most rapid and most seductive transition in all human nature is that which attends the palliation of a ravenous appetite.[…]Can those harmless but refined fellow-diners be the selfish cads whose gluttony and personal appearance so raised your contemptuous wrath on your arrival?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "Apparent likeness; the way which something or someone appears to others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee4a966-67a9-4679-9dba-4c0413faf4b2",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "Some people say I'm shallow because I care so much about my appearance."
                                            },
                                            {
                                                "example_id": "b23067bd-8e42-403c-95f0-b5b1f13a6acb",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "KAWS’s first sculptures were limited edition toys for the Japanese brand Bounty Hunter, and the stylised figures distributed around YSP in a variety of postures – shielding their eyes from the sun, seated in apparent contemplation or leading a child-sized version of themselves over the sward – have the appearance of gigantic toys, with their instant legibility and machine-honed surfaces."
                                            },
                                            {
                                                "example_id": "18da7fc8-8ddf-4ef2-a8f2-6a3573d1b858",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "And on the day that the tabernacle was reared up the cloud covered the tabernacle, namely, the tent of the testimony: and at even there was upon the tabernacle as it were the appearance of fire, until the morning."
                                            },
                                            {
                                                "example_id": "42a6ca12-322a-4596-8fc2-3756b016e5cb",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "Judge not according to the appearance."
                                            },
                                            {
                                                "example_id": "a2f919a9-e27b-4770-9e2a-e743eb875651",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "'Never be taken in by false appearancesʻ was Swift's habitual satirical message. 'In most Corporeal Beings, which have fallen under my Cognizance, the Outside hath been infinitely preferable to the In,' he elsewhere proclaimed. … The sordid reality beneath the mask haunted him: was all civilisation just dirt and derangement at heart? […] Evidently man was not the homo rationalis he pretended to be but rather, at best, homo rationis capax ─ a creature capable of rationality, though by implication falling short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f19e882a-cb06-358f-8ea4-27c80bf719b3",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "That which is not substance, essence, hypostasis; the outward reality as opposed to the underlying reality"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f30912-857a-4820-a3a8-2641a26c3bf2",
                                                "sense_id": "f19e882a-cb06-358f-8ea4-27c80bf719b3",
                                                "text": "Catholicism teaches that the Eucharist, while remaining under the physical appearance of bread and wine, becomes really and truly the body and the blood of Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "The act of appearing in a particular place, or in society, a company, or any proceedings; a coming before the public in a particular character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f209a14-6e4c-436e-984b-c2b112c578c9",
                                                "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                                                "text": "A person makes his appearance as an historian, an artist, or an orator."
                                            },
                                            {
                                                "example_id": "308ba9e7-c547-40b8-aa76-71273224be0d",
                                                "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                                                "text": "David Beckham's first appearance with the LA Galaxy at Giants Stadium against the New York Red Bulls last night drew a crowd of 66237."
                                            },
                                            {
                                                "example_id": "bb3b8ae1-6cbd-46f9-90c0-8d470ed77d7f",
                                                "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                                                "text": "Will he now retire, After appearance, and again prolong Our expectation?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2684645b-0ac9-33b9-9f23-1af6d8578a21",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "An instance of someone coming into a court of law to be part of a trial, lawsuit or other proceeding, either in person or represented by an attorney or such like; a court appearance"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a8f203a-7ed2-3ada-9b40-8b53a44492b2",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "Chiefly used by nurses: the act of defecation by a patient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9d7887c-e380-4d43-97e1-ee9d5633a379",
                                                "sense_id": "1a8f203a-7ed2-3ada-9b40-8b53a44492b2",
                                                "text": "The patient had a small bowel obstruction and there was no appearance until after the obstruction resolved."
                                            }
                                        ]
