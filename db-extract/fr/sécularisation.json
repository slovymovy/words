        "fr-extract.jsonl": [
            {
                "entry_id": "92d1d938-fb0f-3f62-b27b-645d454b1275",
                "word": "sécularisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6546de02-605e-4c15-9a5b-18ca09bddbd7",
                        "entry_id": "92d1d938-fb0f-3f62-b27b-645d454b1275",
                        "tags": [
                            "plural"
                        ],
                        "form": "sécularisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67542fbb-b251-3995-80bf-0bbe24aa79c4",
                        "entry_id": "92d1d938-fb0f-3f62-b27b-645d454b1275",
                        "glosses": [
                            "Action de séculariser un religieux, une communauté régulière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8413e114-58d2-4f6c-b003-a7c8cb40613a",
                                "sense_id": "67542fbb-b251-3995-80bf-0bbe24aa79c4",
                                "text": "Bulle de sécularisation."
                            },
                            {
                                "example_id": "b2d49880-87a7-49d0-a899-b1fba1a9cc78",
                                "sense_id": "67542fbb-b251-3995-80bf-0bbe24aa79c4",
                                "text": "Obtenir la sécularisation d’un monastère, d’un chapitre."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9a6a4a4-1558-3897-acca-cc031b269151",
                        "entry_id": "92d1d938-fb0f-3f62-b27b-645d454b1275",
                        "glosses": [
                            "Acte par lequel on fait passer dans le domaine séculier, entre les mains des laïques, une principauté, un établissement ecclésiastique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06486722-570b-4a0a-88f9-795c54cd5982",
                                "sense_id": "f9a6a4a4-1558-3897-acca-cc031b269151",
                                "text": "La Prusse s’est formée en grande partie par la sécularisation de principautés ecclésiastiques."
                            },
                            {
                                "example_id": "49b75cbc-ac69-4f55-8eb6-d5d75c6c6765",
                                "sense_id": "f9a6a4a4-1558-3897-acca-cc031b269151",
                                "text": "La sécularisation des biens du clergé, loi par laquelle l’Assemblée constituante déclara le 2 novembre 1789 que les biens du clergé deviendraient biens nationaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9f01dd1-9a29-31e9-babf-0ceafdf5e194",
                        "entry_id": "92d1d938-fb0f-3f62-b27b-645d454b1275",
                        "glosses": [
                            "Action par laquelle on fait rentrer dans le domaine du pouvoir civil celles des fonctions publiques qui étaient un privilège du clergé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a1f16db7-e6c0-4825-ba57-c585d0ab3e8b",
                                "sense_id": "d9f01dd1-9a29-31e9-babf-0ceafdf5e194",
                                "text": "Comment ces hommes d’intelligence étaient-ils à ce point déroutés par le mouvement démocratique, à ce point affolés par la sécularisation de l’État que les chefs républicains, en accord avec les masses, poursuivaient ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92f41b63-8e93-4a3a-b35e-8f3f275d431a",
                        "source_entry_id": "92d1d938-fb0f-3f62-b27b-645d454b1275",
                        "target_lang_word": "Säkularisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Säkularisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "664a6ab2-fb2a-36e6-a130-0f1281db2896",
                                        "entry_id": "70de947f-90bd-380b-a391-574bd4273c50",
                                        "glosses": [
                                            "sozialer Bedeutungsverlust von Religion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4728b0f2-40bd-474d-a929-55bcac190ca8",
                                                "sense_id": "664a6ab2-fb2a-36e6-a130-0f1281db2896",
                                                "text": "„Der Begriff der Säkularisierung bündelt verschiedene Dimensionen religionskultureller Veränderungen und deutet sie als Symptome moderner Entwicklungen. Darin berühren sich das enge juristische Verständnis der Überführung von Kircheneigentum in solches staatlicher Stellen, die sozialstatistischen Befunde abnehmender Kirchenbindung und die politisch-profane Verwendung sakraler Muster wie Souveränität und Opfer.“"
                                            },
                                            {
                                                "example_id": "b9a239c7-a813-4dd1-90a0-dbc7185d38e3",
                                                "sense_id": "664a6ab2-fb2a-36e6-a130-0f1281db2896",
                                                "text": "„Er und Frei sprachen von einer ‚Säkularisierung der Sozialarbeit‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0f27069-4198-3b04-9047-0e55e9e6bf23",
                                        "entry_id": "70de947f-90bd-380b-a391-574bd4273c50",
                                        "glosses": [
                                            "Auflösung geistlicher Herrschaften, unter anderem indem kirchliches Eigentum konfisziert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b71422-b337-494d-8a5c-91ce8ca147b9",
                                                "sense_id": "f0f27069-4198-3b04-9047-0e55e9e6bf23",
                                                "text": "„Der Schwerpunkt der Revisionsausführungen liegt in der Frage, ob und inwieweit die Säkularisierung der Besitztümer und Rechte des Hochstiftes Passau durch Joseph II. die Fischereirechte der Kläger berühren konnten.“"
                                            },
                                            {
                                                "example_id": "b57ee4b0-ab01-4f6d-bb28-795f2ce22651",
                                                "sense_id": "f0f27069-4198-3b04-9047-0e55e9e6bf23",
                                                "text": "„Der Begriff der Säkularisierung bündelt verschiedene Dimensionen religionskultureller Veränderungen und deutet sie als Symptome moderner Entwicklungen. Darin berühren sich das enge juristische Verständnis der Überführung von Kircheneigentum in solches staatlicher Stellen, die sozialstatistischen Befunde abnehmender Kirchenbindung und die politisch-profane Verwendung sakraler Muster wie Souveränität und Opfer.“"
                                            },
                                            {
                                                "example_id": "9f69f050-b615-4a9e-a197-e57f751f4318",
                                                "sense_id": "f0f27069-4198-3b04-9047-0e55e9e6bf23",
                                                "text": "„Der Text war scharf romfeindlich und sprach sich für die Säkularisierung von Kirchengut, die Priesterehe und die Abschaffung der Leibeigenschaft aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
