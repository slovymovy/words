                ],
                "senses": [
                    {
                        "sense_id": "29d475d8-be30-3516-8b2d-361050d5ca7c",
                        "entry_id": "28160f25-8ff4-3aa6-92f1-039ec06e748b",
                        "glosses": [
                            "Palme utilisée en nage, en apnée et parfois en plongée ; elle comprend une surface unique, la voilure, sur laquelle sont fixés deux chaussons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc930d1-b7fe-4c42-8264-8d8733704835",
                                "sense_id": "29d475d8-be30-3516-8b2d-361050d5ca7c",
                                "text": "En faisant onduler la surface de la monopalme doucement, les plongeurs en apnée peuvent développer une grande puissance avec des mouvements lents ou de peu d’amplitude ce qui permet d’économiser de l’énergie et d’améliorer la durée ou la distance."
                            },
                            {
                                "example_id": "efc3efbb-225c-43bd-bfa8-793b1f2d5d5b",
                                "sense_id": "29d475d8-be30-3516-8b2d-361050d5ca7c",
                                "text": "Contrairement aux idées reçues la monopalme n’est pas réservée à une élite de nageur."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc15d1a0-9397-31cb-89b7-d26c0734ed04",
                        "entry_id": "28160f25-8ff4-3aa6-92f1-039ec06e748b",
                        "glosses": [
                            "Type de nage pratiquée avec cette palme."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7cf50537-f1c5-4df1-999b-e38b0d4198d5",
                                "sense_id": "bc15d1a0-9397-31cb-89b7-d26c0734ed04",
                                "text": "Une compétition de monopalme."
                            }
                        ]
                    }
