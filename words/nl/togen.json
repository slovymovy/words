                    "sense_id": "3c3978db-c1b0-3e88-8465-2930761e0c3f",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>toog</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bar_counter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De cafés in de oude straat hadden allemaal houten <w>togen</w> waar gasten aan stonden.",
                            "target_lang_translations": {
                                "en": "The pubs in the old street all had wooden <w>bars</w> where guests were standing."
                            }
                        },
                        {
                            "text": "Tijdens het drukke festival stonden er lange rijen voor de verschillende <w>togen</w>.",
                            "target_lang_translations": {
                                "en": "During the busy festival, there were long queues in front of the various <w>counters</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bars",
                        "balies"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of toog: bar counters or serving desks"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bars",
                                "target_lang_sense_clarification": "countertops in a pub or café"
                            },
                            {
                                "target_lang_word": "counters",
                                "target_lang_sense_clarification": "serving surfaces or desks"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c67ecb8-1638-3e01-a116-3794afea6407",
                    "sense_definition": "meervoud verleden tijd van <w>tijgen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijgen_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het ontbijt <w>togen</w> de wandelaars vol goede moed naar de top van de heuvel.",
                            "target_lang_translations": {
                                "en": "After breakfast, the hikers <w>set off</w> in high spirits towards the top of the hill."
                            }
                        },
                        {
                            "text": "De studenten <w>togen</w> gezamenlijk naar het centrum om te protesteren.",
                            "target_lang_translations": {
                                "en": "The students <w>marched</w> together to the city centre to protest."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ten strijde togen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verleden tijd van tijgen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past tense plural of tijgen: went, marched, or set off"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "set off",
                                "target_lang_sense_clarification": "started journeying (past tense)"
                            },
                            {
                                "target_lang_word": "marched",
                                "target_lang_sense_clarification": "moved forward deliberately"
                            },
                            {
                                "target_lang_word": "went",
                                "target_lang_sense_clarification": "proceeded towards a destination"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ca18261-063b-38a6-8356-016fcaaa3262",
                    "sense_definition": "met kracht voorwaarts bewegen; trekken of slepen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterke werkpaarden <w>togen</w> de zware kar moeizaam door de modder.",
                            "target_lang_translations": {
                                "en": "The strong workhorses <w>pulled</w> the heavy cart with difficulty through the mud."
                            }
                        },
                        {
                            "text": "Met vereende krachten <w>toogden</w> de matrozen het schip naar een veilige plek.",
                            "target_lang_translations": {
                                "en": "With joined forces, the sailors <w>hauled</w> the ship to a safe spot."
                            }
                        }
                    ],
                    "synonyms": [
                        "trekken",
                        "slepen"
                    ],
                    "antonyms": [
                        "duwen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "verouderd taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to move forward with force; to haul, pull, or drag"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull",
                                "target_lang_sense_clarification": "draw with force"
                            },
                            {
                                "target_lang_word": "haul",
                                "target_lang_sense_clarification": "pull or drag with heavy effort"
                            },
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "pull along forcefully"
                            }
                        ]
                    }
                }
            ]
