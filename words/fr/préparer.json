    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "878f1c98-96e9-3332-bde2-597e837eded0",
                    "sense_definition": "Apprêter ou confectionner quelque chose afin de le rendre prêt à l'usage.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce soir, je <w>prépare</w> une soupe chaude pour toute la famille."
                        },
                        {
                            "text": "Elle a commencé à <w>préparer</w> sa valise plusieurs jours avant le départ."
                        }
                    ],
                    "synonyms": [
                        "apprêter",
                        "confectionner",
                        "cuisiner"
                    ],
                    "common_phrases": [
                        "préparer le repas",
                        "préparer le dîner",
                        "préparer sa valise"
                    ]
                },
                {
                    "sense_id": "c13a4ff4-0d52-30ea-b449-60a27537aa10",
                    "sense_definition": "Travailler ou s'entraîner en vue d'une épreuve, d'une activité ou d'un événement futur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "entrainement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants passent beaucoup de temps à la bibliothèque pour <w>préparer</w> leurs examens."
                        },
                        {
                            "text": "Mon frère <w>prépare</w> un concours difficile pour entrer dans cette école."
                        }
                    ],
                    "synonyms": [
                        "étudier",
                        "réviser"
                    ],
                    "common_phrases": [
                        "préparer un examen",
                        "préparer un concours"
                    ]
                },
                {
                    "sense_id": "9d14edd1-4fcb-3e86-8b3b-3a7df9c0e64f",
                    "sense_definition": "Concevoir, organiser ou élaborer quelque chose par la réflexion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a passé la soirée à <w>préparer</w> son discours officiel."
                        },
                        {
                            "text": "Nous devons <w>préparer</w> une présentation claire avant la réunion de demain."
                        }
                    ],
                    "synonyms": [
                        "élaborer",
                        "concevoir",
                        "organiser"
                    ],
                    "antonyms": [
                        "improviser"
                    ],
                    "common_phrases": [
                        "préparer un discours",
                        "préparer une réunion"
                    ]
                },
                {
                    "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                    "sense_definition": "Mettre en place les conditions qui produiront un résultat ou un événement ultérieur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses collègues voulaient lui <w>préparer</w> une fête surprise pour son anniversaire."
                        },
                        {
                            "text": "Cette première négociation a permis de <w>préparer</w> le terrain pour un accord durable."
                        }
                    ],
                    "synonyms": [
                        "aménager",
                        "engendrer"
                    ],
                    "common_phrases": [
                        "préparer une surprise",
                        "préparer le terrain"
                    ]
                },
                {
                    "sense_id": "a8d5eb45-c9c0-381c-b9fa-78426d9330f3",
                    "sense_definition": "Parler à quelqu'un avec ménagement pour le disposer à recevoir une mauvaise nouvelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "psychologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a cherché les mots justes pour <w>préparer</w> la famille au diagnostic."
                        },
                        {
                            "text": "Il faut la <w>préparer</w> doucement avant de lui annoncer cette rupture soudaine."
                        }
                    ],
                    "synonyms": [
                        "ménager",
                        "conditionner"
                    ],
                    "common_phrases": [
                        "préparer les esprits",
                        "préparer quelqu'un au pire"
                    ]
                }
            ]
        }
    ]
}