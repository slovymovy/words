                        "sense_id": "d184b843-a52a-3591-a7a4-79ce0ce582de",
                        "entry_id": "a70060d3-8148-3f33-96ed-4f6f13a3b073",
                        "glosses": [
                            "Taktik, bei der die gegnerische Mannschaft permanent durch unter Druck gesetzt wird, indem zum Beispiel der ballführende Spieler sofort angegriffen wird, sodass der Gegner keine Gelegenheit hat, einen Angriff vorzutragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a4e0890-b1b1-40fe-844e-8b1e05b5e007",
                                "sense_id": "d184b843-a52a-3591-a7a4-79ce0ce582de",
                                "text": "„Mit frühem Pressing setzten die Gastgeber die Düsseldorfer unter Druck und ließen sie in der Anfangsphase nur selten aus deren Hälfte kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b93fcc67-3983-4017-a8bf-04ecf7a48000",
                        "source_entry_id": "a70060d3-8148-3f33-96ed-4f6f13a3b073",
                        "source_sense_id": "d184b843-a52a-3591-a7a4-79ce0ce582de",
                        "target_lang_word": "pressing",
                        "target_lang_code": "en",
