                "senses": [
                    {
                        "sense_id": "d682704a-2ede-3258-a43e-128ca46e617d",
                        "entry_id": "441ba6b3-c536-334e-911d-c5031c9ae871",
                        "glosses": [
                            "Réguler de façon insuffisante, ou moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee78825-6164-4567-a8bc-5f37259c586f",
                                "sense_id": "d682704a-2ede-3258-a43e-128ca46e617d",
                                "text": "Il a surtout été un prétexte pour sous-réguler ou déréguler."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0d0d31e-cc92-3fb9-8d4a-348f2e9044ce",
                        "entry_id": "441ba6b3-c536-334e-911d-c5031c9ae871",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b3ba45-7426-455b-bfbc-9a38c36a98ed",
                                "sense_id": "e0d0d31e-cc92-3fb9-8d4a-348f2e9044ce",
                                "text": "En d’autres termes, une mutation dans une protéine régulatrice peut «sur-réguler» ou «sous-réguler» le gène transcrit."
                            },
                            {
                                "example_id": "8209460b-bbf9-456c-bd58-d102041deb40",
                                "sense_id": "e0d0d31e-cc92-3fb9-8d4a-348f2e9044ce",
                                "text": "Cette substance peut sous-réguler l'activation des cellules de Kupffer en culture et in vivo."
                            },
                            {
                                "example_id": "273ba047-0448-486e-96e4-bd1676eb4ddd",
                                "sense_id": "e0d0d31e-cc92-3fb9-8d4a-348f2e9044ce",
                                "text": "Inversement, le VHC pourrait sous-réguler l'expression de la protéine Fas, rendant les hépatocytes relativement résistants à l'action des cellules cytotoxiques."
                            }
                        ]
                    }
