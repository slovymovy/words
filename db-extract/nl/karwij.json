                                "target_senses": [
                                    {
                                        "sense_id": "53c64637-2ac8-3dca-903f-dab7cea32125",
                                        "entry_id": "14e21faf-67ee-3254-8de4-76e164ffd87a",
                                        "glosses": [
                                            "A biennial plant of species Carum carvi, native to Europe and Asia, mainly grown for its seed to be used as a culinary spice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b8525f1-088e-4fb2-9704-8f69b270d37f",
                                                "sense_id": "53c64637-2ac8-3dca-903f-dab7cea32125",
                                                "text": "Caraway has a reputed aphrodisiac virtue. It is frequently mentioned in Oriental love manuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddb62807-2661-39ce-8ab0-bfeeb11fce1f",
                                        "entry_id": "14e21faf-67ee-3254-8de4-76e164ffd87a",
                                        "glosses": [
                                            "The seed-like fruit of the caraway plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07bba434-ea07-3ebc-a0b3-84085c30a1ec",
                                        "entry_id": "14e21faf-67ee-3254-8de4-76e164ffd87a",
                                        "glosses": [
                                            "A cake or sweetmeat containing caraway seeds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3e0d070-1f6c-4a43-8dfc-adac43c7b06d",
                                                "sense_id": "07bba434-ea07-3ebc-a0b3-84085c30a1ec",
                                                "text": "I'll eat her marchpane and her caraways"
                                            },
                                            {
                                                "example_id": "51e903ee-ac2b-4925-a843-ce5d468034c2",
                                                "sense_id": "07bba434-ea07-3ebc-a0b3-84085c30a1ec",
                                                "text": "the housewife of today can surely match the skill of those of three centuries ago and make \"caraways” or cheesecakes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2565d44-c6e9-49f8-ad3a-7dc87df7141d",
                        "source_entry_id": "1858873f-3185-3ce0-8b0a-35430000d474",
                        "source_sense_description": "plant, zaad en specerij",
                        "target_lang_word": "carvi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carvi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7f52173-8eb5-3b57-a8ec-7a577eb7f3a0",
                                        "entry_id": "1dc234b8-167b-3d86-ae03-7e26a6b724e4",
                                        "glosses": [
                                            "Plante aromatique originaire d’Europe centrale, proche du fenouil, de l’anis et de l’aneth, dont les graines sont employées pour leurs qualités aromatiques (comme condiments) et en médecine comme vermifuges et carminatives."
                                        ],
                                        "tags": [
                                            "Aromate"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bc17e54-6eed-4ee8-9645-817f900413f8",
                                                "sense_id": "f7f52173-8eb5-3b57-a8ec-7a577eb7f3a0",
                                                "text": "Il y a aussi les Car en Sac, appelés « torpilles » en raison de leur forme, et les fruits et graines enrobés, dont les agrumes, le fenouil, le carvi et le gingembre."
                                            },
                                            {
                                                "example_id": "cb7b448b-9d0e-4ffe-bc96-28c184d79e5b",
                                                "sense_id": "f7f52173-8eb5-3b57-a8ec-7a577eb7f3a0",
                                                "text": "L’essence de carvi dont on a enlevé la carvone devient l’essence légère de carvi qui sert à parfumer les savons bon marché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a468c9f8-1ff8-3f39-8219-77aa9a14c78c",
                                        "entry_id": "1dc234b8-167b-3d86-ae03-7e26a6b724e4",
                                        "glosses": [
                                            "Épice extraite des graines de cette plante, au goût légèrement anisé et citronné, assez souvent confondue avec le cumin, et qui est utilisée pour parfumer les pains et pâtisseries allemandes ou viennoises, les charcuteries scandinaves, les viandes en sauce, mais aussi les fromages à pâte molle comme le munster, ou encore dans la préparation de tartes aux fromages généralement forts comme le maroilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4da3713a-4081-4a2e-95f0-f8199b1602b5",
                                                "sense_id": "a468c9f8-1ff8-3f39-8219-77aa9a14c78c",
                                                "text": "On s’est accroupis et j’ai passé un bras autour de son cou. Il sentait le carvi et le poivre, la poussière et la crasse acide."
                                            },
                                            {
                                                "example_id": "7f7e5130-6390-40b5-a74f-29eb7e9e3470",
                                                "sense_id": "a468c9f8-1ff8-3f39-8219-77aa9a14c78c",
                                                "text": "Les pains de seigle (ou mélangés) dominent surtout en Europe centrale et en Allemagne. Ils sont souvent aromatisés au carvi."
                                            },
                                            {
                                                "example_id": "59e65062-919c-4472-9693-6373f7a2ecb3",
                                                "sense_id": "a468c9f8-1ff8-3f39-8219-77aa9a14c78c",
                                                "text": "Autrefois nos ancêtres employaient […] le carvi qui remplace l’anis…, et combien d’autres épices encore, comme le cubèbe, ou le sumac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
