                                        "sense_id": "a7f18b9c-ddd3-3f7d-bd84-6b61d580c9bf",
                                        "entry_id": "108d1faa-1d22-31c8-9470-3f91048034fc",
                                        "glosses": [
                                            "het opstellen van en werken volgens plannen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1486e4b2-24bd-4fba-b23a-bc3507fb0d09",
                                                "sense_id": "a7f18b9c-ddd3-3f7d-bd84-6b61d580c9bf",
                                                "text": "Je zult vast obstakels tegenkomen of het eng vinden om daadwerkelijk alleen op reis te gaan, maar dit is met tijd en planning te voorkomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b28b0607-f379-3828-9f95-008d4a885d46",
                                        "entry_id": "108d1faa-1d22-31c8-9470-3f91048034fc",
                                        "glosses": [
                                            "uitgewerkt plan van de (deel)werkzaamheden die achtereenvolgens uitgevoerd moeten worden om een werk, project enz. op een bepaald tijdstip te hebben afgerond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b023a83-5ce8-412a-9be8-411e0b2350a3",
                                                "sense_id": "b28b0607-f379-3828-9f95-008d4a885d46",
                                                "text": "De begeleider let erop dat de student werkt volgens de planning en de afspraken die gemaakt zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a92ec160-0a4e-4ad0-bd70-83f8f1443010",
                        "source_entry_id": "a5484ad2-24ee-3d65-9632-491420ddc56b",
                        "source_sense_id": "ec4ae42a-00c4-3952-8582-b385e05e305e",
                        "source_sense_description": "durchdachter Vorgang, der zu einer Zeichnung oder Beschreibung eines Vorhaben führt",
                        "target_lang_word": "opzet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
