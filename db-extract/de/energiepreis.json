                "senses": [
                    {
                        "sense_id": "cfa6a75c-abc9-390e-886c-88f80f394ec5",
                        "entry_id": "28d4f3f0-8651-38d6-bff0-87f9e4234b4d",
                        "glosses": [
                            "Preis für elektrische Energie, Gas und Öl auf dem Weltmarkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d00e2b8-a635-4b98-b7a1-de271b2a4ff7",
                                "sense_id": "cfa6a75c-abc9-390e-886c-88f80f394ec5",
                                "text": "„In der ersten Hälfte des Jahres 2008 gab es einen […] steilen Anstieg der Energiepreise, die mit der einsetzenden Wirtschaftskrise einstweilen wieder stark gesunken sind.“"
                            },
                            {
                                "example_id": "73981ac9-8d6a-4cc9-a3ac-2d922980fa95",
                                "sense_id": "cfa6a75c-abc9-390e-886c-88f80f394ec5",
                                "text": "„Wegen hoher Energiepreise haben viele Städte bereits in den vergangenen Wochen darauf verzichtet Wahrzeichen, Denkmäler und prominenten Gebäude wie Rathäuser, Museen oder Bibliotheken bei Nacht zu beleuchten.“"
                            }
                        ],
