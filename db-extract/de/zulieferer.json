                "senses": [
                    {
                        "sense_id": "1c831cdd-c5b4-3980-84e4-6115ec65bd07",
                        "entry_id": "04359e84-d21c-3bd9-bcb2-d6f65d25d72a",
                        "glosses": [
                            "Betrieb (oder auch Person), der anderen Betrieben Vorprodukte zur Weiterverarbeitung liefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "527f5fbb-e2b6-4359-a701-a1feb2fcfd97",
                                "sense_id": "1c831cdd-c5b4-3980-84e4-6115ec65bd07",
                                "text": "Autofirmen erhalten viele Bauteile für die Endmontage ihrer Fahrzeuge von Zulieferern."
                            },
                            {
                                "example_id": "19f6cd18-1723-430e-a665-01092c9c010e",
                                "sense_id": "1c831cdd-c5b4-3980-84e4-6115ec65bd07",
                                "text": "„Von der schweren Automobilkrise betroffen sind vor allem Sachsen und Thüringen, wo in den vergangenen Jahren eine umfangreiche Automobilindustrie einschließlich vieler Zulieferer entstanden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c821635f-c7f1-4fbe-b4aa-1cb73b6f6ab7",
                        "source_entry_id": "04359e84-d21c-3bd9-bcb2-d6f65d25d72a",
                        "source_sense_id": "1c831cdd-c5b4-3980-84e4-6115ec65bd07",
                        "source_sense_description": "jemand, der anderen Betrieben Vorprodukte zur Weiterverarbeitung liefert",
                        "target_lang_word": "supplier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supplier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5f56d3a-d87b-385d-8d8e-ff4511aabead",
                                        "entry_id": "0ca8105c-1b84-3e88-b29c-bf2ac0e20dc9",
                                        "glosses": [
                                            "One who supplies; a provider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440f323d-6d68-401e-92ae-80aceb40c911",
                                                "sense_id": "e5f56d3a-d87b-385d-8d8e-ff4511aabead",
                                                "text": "A farmer could place an order for a new tractor part by text message and pay for it by mobile money-transfer. A supplier many miles away would then take the part to the local matternet station for airborne dispatch via drone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1138d01b-0139-3bdc-aeb4-3ce49beb6bc7",
                                        "entry_id": "0ca8105c-1b84-3e88-b29c-bf2ac0e20dc9",
                                        "glosses": [
                                            "Someone who assists (sets up) a goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4c8a3f-3323-4190-8532-d63cddeb86c3",
                                                "sense_id": "1138d01b-0139-3bdc-aeb4-3ce49beb6bc7",
                                                "text": "Regular supplier Barton played in another teasing corner, which was headed on towards goal by the impressive Ameobi and flicked in by expert poacher Nolan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "818156d6-bf20-4953-b10c-44f2d8b033c8",
                        "source_entry_id": "04359e84-d21c-3bd9-bcb2-d6f65d25d72a",
                        "source_sense_id": "1c831cdd-c5b4-3980-84e4-6115ec65bd07",
                        "source_sense_description": "jemand, der anderen Betrieben Vorprodukte zur Weiterverarbeitung liefert",
                        "target_lang_word": "fournisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fournisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                        "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                                        "glosses": [
                                            "Celui, entreprise ou particulier, qui entreprend de faire la fourniture de marchandises, de denrées ou celui chez qui on se les procure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e93ea839-fe26-458e-8a2d-32feb99a17b4",
                                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                                "text": "Un riche propriétaire, M. Roudier, au visage grassouillet et insinuant, y discourait des heures entières, avec la passion d’un orléaniste que la chute de Louis-Philippe avait dérangé dans ses calculs. C’était un bonnetier de Paris retiré à Plassans, ancien fournisseur de la cour, qui avait fait de son fils un magistrat, comptant sur les Orléans pour pousser ce garçon aux plus hautes dignités."
                                            },
                                            {
                                                "example_id": "fc42e1b7-c8cc-4850-96f1-01910bc0626a",
                                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                                "text": "Je le crois bien, dit Henri, quand on est comme vous le fournisseur de toutes les têtes couronnées de France et de l’étranger."
                                            },
                                            {
                                                "example_id": "5eb9243d-ed70-4905-8d4f-eb9b391e5e25",
                                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                                "text": "Le soir, chacun se récria sur la qualité de ces grosses dattes entourées de sirop. Mounira elle-même les déclara plus exquises que celles des grands fournisseurs."
                                            },
                                            {
                                                "example_id": "96b53b45-a140-4bc3-9476-fb8e9411fe76",
                                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                                "text": "— Un crétin chimiquement pur… je me demande où tu vas le chercher ?\n— Quai des Orfèvres. Je suis fidèle à mes fournisseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71a078d4-cfce-3b1c-b595-8e0ae7a81f7c",
                                        "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                                        "glosses": [
                                            "Celui qui fournit et qui monte des sabres, des épées."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59212a8e-75c6-4b0f-9a8a-520fd89bf512",
                        "source_entry_id": "04359e84-d21c-3bd9-bcb2-d6f65d25d72a",
