                                    }
                                ]
                            },
                            {
                                "target_word": "logaritmus",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3452a6-b763-3f9e-bc3a-d8a204f15cc6",
