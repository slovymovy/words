                                        "entry_id": "35ae5758-88e4-340f-b1fa-c6997f3856c4",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße starres, wenig angepasstes (inflexibles) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f5070e-82d5-41d9-978d-155fe2e5773f",
                                                "sense_id": "41c02a0c-d3fe-32e2-9c11-86fced39abd0",
                                                "text": "„Durch viele Regelungen wird das Unternehmen zwar stabil, leidet aber an Inflexibilität.“"
                                            },
                                            {
                                                "example_id": "f56e105c-9c53-4b04-a9b6-bbc54864aa06",
                                                "sense_id": "41c02a0c-d3fe-32e2-9c11-86fced39abd0",
                                                "text": "Deine Inflexibilität grenzt an Altersstarrsinn."
                                            }
                                        ],
