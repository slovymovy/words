                "senses": [
                    {
                        "sense_id": "cfad403a-76cf-34c0-8cab-7db1a319f07a",
                        "entry_id": "23361882-2b97-3037-ab1e-920988cfc2d6",
                        "glosses": [
                            "elektronische Sammlung von Vornamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58092ea9-66b1-4565-bdd5-ffb34b9fb4cb",
                                "sense_id": "cfad403a-76cf-34c0-8cab-7db1a319f07a",
                                "text": "„Vor allem half bei der Erfassung und Auswertung der Vornamen 2012 eine neue Vornamendatenbank.“"
                            },
                            {
                                "example_id": "45e6d44b-bbc7-4cd9-9a1c-b5ca50de0d3e",
                                "sense_id": "cfad403a-76cf-34c0-8cab-7db1a319f07a",
                                "text": "„Die Gesellschaft für deutsche Sprache (GfdS) hat eine neue Vornamendatenbank eingerichtet.“"
                            },
                            {
                                "example_id": "bde15838-cc00-4a43-92d3-c8c025175668",
                                "sense_id": "cfad403a-76cf-34c0-8cab-7db1a319f07a",
                                "text": "„Das geht aus der Vornamendatenbank des Meertens Instituut hervor, die seit dem 3. Juni online ist (auch englisch).“"
                            },
                            {
                                "example_id": "5b225efc-912c-4011-895d-149ba3eaae50",
                                "sense_id": "cfad403a-76cf-34c0-8cab-7db1a319f07a",
                                "text": "„Es gibt viele Vornamenbücher und CD’s zu kaufen, und viele Webseiten mit Vornamendatenbanken.“"
                            },
                            {
                                "example_id": "5b861438-ba1b-4e0d-8d21-d8a01cb7a07f",
                                "sense_id": "cfad403a-76cf-34c0-8cab-7db1a319f07a",
                                "text": "„Insgesamt sind jetzt weit über 20.000 Mädchen- und Jungennamen in der kostenlosen Vornamendatenbank vorhanden.“"
                            },
                            {
                                "example_id": "f4909a5a-933f-4cf9-82f7-e34630f74979",
                                "sense_id": "cfad403a-76cf-34c0-8cab-7db1a319f07a",
                                "text": "„Die Gesellschaft für deutsche Sprache hat zu Beginn des Jahres eine neue Vornamendatenbank eingerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
