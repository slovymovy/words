                                                "example_id": "d948803a-ccc7-4022-a391-e7b6c43bf01c",
                                                "sense_id": "bd17df89-cb11-3ecd-bf26-8e140a7c6430",
                                                "text": "Solch eine Antwort ist natürlich typisch für einen Politiker - weder ja noch nein."
                                            },
