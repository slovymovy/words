                    {
                        "sense_id": "a5fc691f-131a-3574-b08e-e52024b54104",
                        "entry_id": "b7d22457-57e1-30e8-80a8-d67932e0e782",
                        "glosses": [
                            "bak om het blok van een verbrandingsmotor, als afsluiting en ook vaak als reservoir voor de smeerolie van de motor"
                        ],
                        "tags": [
                            "motortechniek"
                        ],
                        "examples": [
                            {
                                "example_id": "c4d22044-b575-47d2-82ca-8cd7c251cb2c",
                                "sense_id": "a5fc691f-131a-3574-b08e-e52024b54104",
                                "text": "Onder het carter zit een olieaftappunt."
                            },
                            {
                                "example_id": "ac531f39-1542-466c-bd80-9c0850aae214",
                                "sense_id": "a5fc691f-131a-3574-b08e-e52024b54104",
                                "text": "Door een gat in het carter stroomt buitenlucht toe, maar die buitenlucht wordt eerst door de carburateur geleid, een instrument dat de buitenlucht vermengd met een fijne benzinenevel."
                            },
                            {
                                "example_id": "b0ffdcf8-2b0c-4656-99c3-784290cd57c1",
                                "sense_id": "a5fc691f-131a-3574-b08e-e52024b54104",
                                "text": "Tegen het heet, d.w.z. te heet loopen van den motors [sic!] dient zorgvuldig gewaakt te worden, een paar pompen olie in het carter persen, den motor stoppen, en dan af en toe door middel van den slinger den motor enkele slagen ronddraaien om vast zetten ervan, bij de afkoeling te voorkomen, en dadelijk de oorzaak van de gebrekkige werking der watercirculatie nagaan, om het te heet geworden water te vervangen, is ’t redmiddel (…)"
                            }
                        ]
                    }
