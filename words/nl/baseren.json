    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8f6126d-13a0-3e01-9b3f-073e7515a1bc",
                    "sense_definition": "iets als fundament of uitgangspunt gebruiken voor een theorie, mening of besluit",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fundering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>baseerde</w> die conclusie op misleidende gegevens.",
                            "target_lang_translations": {
                                "en": "He <w>based</w> that conclusion on misleading data."
                            }
                        },
                        {
                            "text": "Je kunt een wetenschappelijk onderzoek niet alleen op een gerucht <w>baseren</w>.",
                            "target_lang_translations": {
                                "en": "You cannot <w>base</w> scientific research on a rumor alone."
                            }
                        }
                    ],
                    "synonyms": [
                        "gronden",
                        "funderen",
                        "stoelen"
                    ],
                    "common_phrases": [
                        "baseren op feiten",
                        "baseren op onderzoek"
                    ],
                    "target_lang_definitions": {
                        "en": "to use something as a foundation or starting point for a theory, opinion, or decision"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "base",
                                "target_lang_sense_clarification": "to use as a foundation"
                            },
                            {
                                "target_lang_word": "ground",
                                "target_lang_sense_clarification": "to establish on a firm basis"
                            },
                            {
                                "target_lang_word": "found",
                                "target_lang_sense_clarification": "to build a theory or idea upon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84a4320d-8451-34c0-9ad8-1b6ce4d6a222",
                    "sense_definition": "gebruikmaken van bepaalde informatie of principes als rechtvaardiging voor iemands handelen of beweringen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fundering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>baseerde</w> zich op een uitspraak van de raad uit 1923.",
                            "target_lang_translations": {
                                "en": "He <w>based</w> his position on a ruling by the council from 1923."
                            }
                        },
                        {
                            "text": "De advocaat <w>baseert</w> zich op de wet om zijn cliënt te verdedigen.",
                            "target_lang_translations": {
                                "en": "The lawyer <w>relies</w> on the law to defend his client."
                            }
                        }
                    ],
                    "synonyms": [
                        "steunen",
                        "uitgaan"
                    ],
                    "common_phrases": [
                        "zich baseren op"
                    ],
                    "target_lang_definitions": {
                        "en": "to make use of specific information or principles as a justification for one's actions or claims"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "base oneself on",
                                "target_lang_sense_clarification": "to use as a justification"
                            },
                            {
                                "target_lang_word": "rely on",
                                "target_lang_sense_clarification": "to depend on information for an argument"
                            },
                            {
                                "target_lang_word": "draw on",
                                "target_lang_sense_clarification": "to use information as a source"
                            }
                        ]
                    }
                }
            ]
        }
    ]
