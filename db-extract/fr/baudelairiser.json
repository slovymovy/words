                ],
                "senses": [
                    {
                        "sense_id": "dd3a0eee-8983-35e1-8021-445fd68fdbc1",
                        "entry_id": "8453fd42-6aa1-3276-a48d-47f12e56dd8f",
                        "glosses": [
                            "Influencer par Charles Baudelaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851f19bf-e221-4fa1-be21-dcf2e7c7cfa7",
                                "sense_id": "dd3a0eee-8983-35e1-8021-445fd68fdbc1",
                                "text": "Cette position nous la nommions « se laisser baudelairiser » et il nous paraissait bien que notre vie en était tissée."
                            },
                            {
                                "example_id": "ad25846b-e9fd-4c92-8c15-0ca3d3dcff77",
                                "sense_id": "dd3a0eee-8983-35e1-8021-445fd68fdbc1",
                                "text": "Mallarmé s’est à la fois fortement baudelairisé et « débaudelairisé » (c'est son mot)."
                            },
                            {
                                "example_id": "60f983fa-dbc7-4cf6-89df-3bc19deda47e",
                                "sense_id": "dd3a0eee-8983-35e1-8021-445fd68fdbc1",
                                "text": "Toujours ailleurs les saloperies contre les écrivains, ailleurs les petits membres pourris des familles qui témoignent selon le vœu des procureurs et cherchent à baudelairiser les poètes égarés en leur sein."
                            }
                        ]
                    }
