                    "frequency": "Middle",
                    "semantic_group_id": "voix_parlee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>intonation</w> montrait clairement qu'il était très en colère contre nous."
                        },
                        {
                            "text": "Elle a adopté une <w>intonation</w> chaleureuse pour rassurer le jeune enfant apeuré."
                        }
                    ],
                    "synonyms": [
                        "inflexion",
                        "ton"
                    ],
                    "common_phrases": [
                        "intonation chaleureuse",
                        "intonation ironique"
                    ]
                },
                {
                    "sense_id": "c346b5b6-bde5-3b72-886e-9fa79d523d0f",
                    "sense_definition": "Variation de la hauteur de la voix au cours de l'énoncé, servant à structurer le discours ou à marquer une interrogation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En français, une <w>intonation</w> montante permet de transformer une phrase en question."
                        },
                        {
                            "text": "La linguiste étudie les variations d'<w>intonation</w> chez les différents locuteurs régionaux."
                        }
                    ],
                    "synonyms": [
                        "mélodie"
                    ],
                    "common_phrases": [
