        "fr-extract.jsonl": [
            {
                "entry_id": "491454dd-f8c9-3e57-a49f-6915275cd9b4",
                "word": "spécifiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                        "entry_id": "491454dd-f8c9-3e57-a49f-6915275cd9b4",
                        "glosses": [
                            "D’une manière spécifique, particulièrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfb3ba7b-f898-4198-81f1-4ffcd58be156",
                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                "text": "Le dialogue — chose écrite et parlée — n’appartient pas spécifiquement à la scène, il appartient au livre ; et la preuve, c’est que l’on réserve dans les manuels d’histoire littéraire une place au théâtre considéré comme une branche accessoire de l’histoire du langage articulé."
                            },
                            {
                                "example_id": "10193b5d-22bb-4f2c-aa79-26451a65717d",
                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                "text": "Le jaune Lucifer (Lucifer yellow = colorant fluorescent à base de luciférine) et la péroxydase (par exemple, la péroxydase du Raifort ou péroxydase du radis de cheval = la HRP pour horse radish peroxydase) qui est une enzyme pouvant être incorporée non spécifiquement par les cellules."
                            },
                            {
                                "example_id": "4eb0dc8c-ebae-4313-8937-16f23e01f41e",
                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                "text": "On peut ainsi être assuré de collecter toute l’information désirée sans perdre de temps considérable à identifier anatomiquement et spécifiquement les innombrables débris divers laissés par le squelette ultra-complexifié des poissons."
                            },
                            {
                                "example_id": "fe76d4e9-3589-4c39-904e-92bcb1d6cc65",
                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                "text": "Ces pierres, devenues dures par la longue chaleur qu’elles ont éprouvée, deviennent en même temps spécifiquement plus pesantes."
                            },
                            {
                                "example_id": "36344da4-823f-47d0-94e5-ca45b71fe6ea",
                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                "text": "Seules la testostérone et la dihydrotestostérone sont des androgènes actifs qui se lient spécifiquement aux récepteurs des androgènes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c79612a4-0b02-485c-a0d8-24e4024b8aa3",
                        "source_entry_id": "491454dd-f8c9-3e57-a49f-6915275cd9b4",
                        "source_sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                        "target_lang_word": "specifically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "specifically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36277b08-0f8b-35a3-9d6e-701631d826c4",
                                        "entry_id": "616842b8-5dcc-32f7-b7c9-2fc6a87fd634",
                                        "glosses": [
                                            "In a specific manner, applying to or naming a particular thing or things, expressly, explicitly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ebcbb4-39bf-4e78-97a2-539255646b91",
                                                "sense_id": "36277b08-0f8b-35a3-9d6e-701631d826c4",
                                                "text": "A provision of law may not be construed as requiring a new grant to be awarded to a specified non-Federal Government entity unless that provision of law (1) specifically refers to this subsection; specifically identifies the particular non-Federal Government entity involved; and (3) specifically states that the award to that entity is required by such provision of law in contravention of the policy set forth in subsection (a)."
                                            },
                                            {
                                                "example_id": "5e67836a-6f48-44da-b81a-c4a3c42e7b9a",
                                                "sense_id": "36277b08-0f8b-35a3-9d6e-701631d826c4",
                                                "text": "Unless specifically waived by the IRB, all subjects, or their legally authorized representatives, must document that they are consenting to participate in any research project that is approved by the University of North Dakota Institutional Review Board."
                                            },
                                            {
                                                "example_id": "b1b4c608-9931-464c-82b1-bc744f823697",
                                                "sense_id": "36277b08-0f8b-35a3-9d6e-701631d826c4",
                                                "text": "Unless a rule or statute specifically states otherwise, a pleading need not be verified or accompanied by an affidavit."
                                            },
                                            {
                                                "example_id": "1d4d9587-0279-4eec-b8e9-7887fec718db",
                                                "sense_id": "36277b08-0f8b-35a3-9d6e-701631d826c4",
                                                "text": "Many laws are directed specifically at child abuse."
                                            },
                                            {
                                                "example_id": "d9b65004-4c09-4b57-8206-c23ed6018a9e",
                                                "sense_id": "36277b08-0f8b-35a3-9d6e-701631d826c4",
                                                "text": "This was widely interpreted to mean that slavery was once more firmly illegal in England. However, the \"positive law\" mentioned–i.e., a direct law specifically enabling slavery–existed in many British colonies (although not all), since these colonies had a degree of freedom to write their own law apart from that of the home country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "155634e6-0fbb-38c3-9706-1f3f0c2722a1",
                                        "entry_id": "616842b8-5dcc-32f7-b7c9-2fc6a87fd634",
                                        "glosses": [
                                            "For a specific purpose or reason."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a81f4ea4-6cea-4c7e-bbdf-f4a57ccc8d82",
                        "source_entry_id": "491454dd-f8c9-3e57-a49f-6915275cd9b4",
                        "source_sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                        "target_lang_word": "typically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48b74561-9749-3e8a-9941-32c375ce82c1",
                                        "entry_id": "ae97d92e-2877-3e6d-9d9b-65465b99bd87",
                                        "glosses": [
                                            "In a typical or common manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778a4eb1-606e-4b58-9c0b-cd2d31772733",
                                                "sense_id": "48b74561-9749-3e8a-9941-32c375ce82c1",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic[…]real kidneys[…]. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac8294e-e18a-3565-ba2a-ccf66de6e46c",
                                        "entry_id": "ae97d92e-2877-3e6d-9d9b-65465b99bd87",
                                        "glosses": [
                                            "In an expected or customary manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37acb021-f98b-4ec5-a5db-2160778b625b",
                                                "sense_id": "9ac8294e-e18a-3565-ba2a-ccf66de6e46c",
                                                "text": "And Netherlands, backed by a typically noisy and colourful travelling support, started the second period in blistering fashion and could have had four goals within 10 minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
