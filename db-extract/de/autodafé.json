                        "source_sense_description": "öffentliche Verkündung und feierliche Vollstreckung von Urteilen der Inquisition",
                        "target_lang_word": "аутодафе",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аутодафе",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bad8b9da-e9f7-387f-9238-932abb97dfd5",
                                        "entry_id": "f0bed9b2-7a3e-39c6-8885-875ac9a399a7",
                                        "glosses": [
                                            "истор. церемония оглашения приговора инквизиции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065e99d6-78dc-4ed6-b727-7d8989c5b6c4",
                                                "sense_id": "bad8b9da-e9f7-387f-9238-932abb97dfd5",
                                                "text": "Для аутодафе назначался особый день, и приговоры объявлялись по целому ряду дел сразу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad07fdcd-8a78-3460-9db9-2de9efcdbaa0",
                                        "entry_id": "f0bed9b2-7a3e-39c6-8885-875ac9a399a7",
                                        "glosses": [
                                            "истор. приведение приговора инквизиции в исполнение, сожжение на костре"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32841f2d-f70d-4790-aa66-2fb144501b5f",
                                                "sense_id": "ad07fdcd-8a78-3460-9db9-2de9efcdbaa0",
                                                "text": "Это мог быть наконец просто бред, видение девяностолетнего старика пред смертью, да ещё разгорячённого вчерашним аутодафе во сто сожжённых еретиков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd8ac7f-f755-376f-bc6b-6ef3def8b1f1",
                                        "entry_id": "f0bed9b2-7a3e-39c6-8885-875ac9a399a7",
                                        "glosses": [
                                            "перен. уничтожение кого-либо, чего-либо путём сожжения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a1a9e2-f29e-4aaa-970d-9813fa786792",
                                                "sense_id": "8fd8ac7f-f755-376f-bc6b-6ef3def8b1f1",
                                                "text": "Молодёжная организация «Идущие вместе» устраивает аутодафе книгам писателя В. Сорокина, включая уничтожение их в самом центре Москвы, в сквере напротив Большого театра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b47a4224-c1e3-36e6-af32-6167208798a3",
                                        "entry_id": "f0bed9b2-7a3e-39c6-8885-875ac9a399a7",
                                        "glosses": [
                                            "разг., ирон. публичное наказание кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea39d65d-7749-4470-b836-15d7c45e8992",
                                                "sense_id": "b47a4224-c1e3-36e6-af32-6167208798a3",
                                                "text": "И он настаивает, чтобы король жестоко наказал де Лозена и вашего мужа для острастки других. А это может довести до аутодафе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
