                        ],
                        "examples": [
                            {
                                "example_id": "03fd1521-e536-4af4-aa55-f1d28ea723b7",
                                "sense_id": "9cd1dea1-a92e-3613-91a0-01524f67e9cb",
                                "text": "Mein Pa fährt mit mir am Sonntag in den Zoo!"
                            },
                            {
                                "example_id": "fec1f2b7-636b-48d0-a4a3-24953b92225a",
                                "sense_id": "9cd1dea1-a92e-3613-91a0-01524f67e9cb",
                                "text": "„John Fletcher und sein Pa kamen nicht gut miteinander aus.“"
                            },
                            {
                                "example_id": "b6dbbb1c-4fa0-4d37-a54f-875b95df6bd2",
                                "sense_id": "9cd1dea1-a92e-3613-91a0-01524f67e9cb",
                                "text": "„Lizzies Bruder, benannt nach seinem Pa, war unfassbar dürr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
