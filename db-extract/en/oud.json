                                        "sense_id": "6d44de26-f116-371b-90bc-2fb4c7af260c",
                                        "entry_id": "cc5d4016-e08e-31c4-8276-e39053f2dbaa",
                                        "glosses": [
                                            "část těla sloužící k pohybu (paže, noha apod.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d51c66de-61be-4cc1-b82b-88b6ddafc6ed",
                                                "sense_id": "6d44de26-f116-371b-90bc-2fb4c7af260c",
                                                "text": "Než vstal z postele, protáhl si všechny údy."
                                            }
                                        ]
