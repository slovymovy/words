                            {
                                "example_id": "69db5b9f-6091-4f7a-8ab5-fabdc37a6a99",
                                "sense_id": "90e1f468-bb92-3d86-a3ac-6ad9c9438d0c",
                                "text": "„Wie oft es dadurch zu Fehlurteilen kommt, ist schwer zu sagen.“"
                            },
                            {
                                "example_id": "e8277d90-c888-4c30-aa1a-0788901e0ecf",
                                "sense_id": "90e1f468-bb92-3d86-a3ac-6ad9c9438d0c",
                                "text": "„1957 billigte das Bundesverfassungsgericht die Strafbarkeit von Homosexualität. Dies gilt heute als eines der größten Fehlurteile des Gerichts.“"
                            }
                        ],
