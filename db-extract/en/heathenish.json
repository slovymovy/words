                        "examples": [
                            {
                                "example_id": "97e6e9a1-f376-4bd8-a860-f431580390aa",
                                "sense_id": "d9fcc1ef-d2d3-33b4-a337-ec65d90df23e",
                                "text": "[…] ‘Tobit and his dog baith are altogether heathenish and apocryphal, and none but a prelatist or a papist would draw them into question. I doubt I hae been mista'en in you, friend.’"
                            },
                            {
                                "example_id": "a4b7f60d-a850-4bd6-b00c-8a574f795002",
                                "sense_id": "d9fcc1ef-d2d3-33b4-a337-ec65d90df23e",
                                "text": "The opposite wall of this entry was hung all over with a heathenish array of monstrous clubs and spears."
                            },
                            {
                                "example_id": "b1ad0c80-0b4e-4ed5-a549-99370fd75e12",
                                "sense_id": "d9fcc1ef-d2d3-33b4-a337-ec65d90df23e",
                                "text": "Let it not be lawful to use wicked observations of the calends, and to keep the gentiles' holy-days, nor to deck houses with bays or green boughs; for all this is an heathenish observation."
                            }
                        ]
                    }
