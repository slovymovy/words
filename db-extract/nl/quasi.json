                                    {
                                        "sense_id": "90d9907e-e1a7-37a6-93f6-9fe1cbda47ee",
                                        "entry_id": "ca3b9854-6ef3-37fe-b157-81866a64d4ba",
                                        "glosses": [
                                            "Resembling or having a likeness to the named thing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d79b2c1-553f-4302-a6f9-b87860c6c39f",
                                                "sense_id": "90d9907e-e1a7-37a6-93f6-9fe1cbda47ee",
                                                "text": "So in summation gentlemen. What you have before you is a troop transport that can't carry troops, a reconnaissance vehicle that's too conspicuous to do reconnaissance, and a quasi tank that has less armor than a snowblower, god has enough ammo to take out half of D.C."
                                            },
                                            {
                                                "example_id": "3435a2bd-c675-4738-bb03-e1604001afda",
                                                "sense_id": "90d9907e-e1a7-37a6-93f6-9fe1cbda47ee",
                                                "text": "The presiding officer of the assembly does not appoint a chairman of the quasi committee, but remains in the chair himself throughout its proceedings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
