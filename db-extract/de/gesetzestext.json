                "senses": [
                    {
                        "sense_id": "efbce7fd-2dc0-37fe-b580-bde2865a11dc",
                        "entry_id": "5acb9017-006b-300e-97ec-e0905939f3d2",
                        "glosses": [
                            "der genaue und vollständige Wortlaut eines Gesetzes, so wie er von einem zuständigen Gremium beschlossen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e74b4d-068c-4b7a-bbc9-a92037457a1d",
                                "sense_id": "efbce7fd-2dc0-37fe-b580-bde2865a11dc",
                                "text": "„Trotz der Einsicht der Juristen in die Verbesserungswürdigkeit von Gesetzestexten sei noch viel zu tun.“"
                            },
                            {
                                "example_id": "0273938e-8524-409c-abb4-b9a4ad4f8c55",
                                "sense_id": "efbce7fd-2dc0-37fe-b580-bde2865a11dc",
                                "text": "„Gesetzestexte, die sich auf Vorgänge des modernen Wirtschafts-, Finanz- und Alltagslebens beziehen, werden von islamischen Rechtsgelehrten auf ihre Vereinbarkeit mit der Scharia geprüft, bevor sie durch königliches Dekret wirksam werden.“"
                            },
                            {
                                "example_id": "32cdde9d-73b3-41e5-8b8b-baa557f21be3",
                                "sense_id": "efbce7fd-2dc0-37fe-b580-bde2865a11dc",
                                "text": "„Gesetzestexte sind im Allgemeinen von fester, dauerhafter Beschaffenheit, werden zumeist nur dann verändert, wenn es sachlich geboten erscheint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
