                "senses": [
                    {
                        "sense_id": "209fb4f2-5f6c-3d08-8358-fe1fb7c85bbc",
                        "entry_id": "3b78451b-1854-3b18-9c0c-3c81cf265fe3",
                        "glosses": [
                            "Behältnis für frischen Mörtel (Speis)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2233d10-af1e-434a-b057-bab41c2a9e52",
                                "sense_id": "209fb4f2-5f6c-3d08-8358-fe1fb7c85bbc",
                                "text": "„Auf ihr befindet sich ein Maurer, vor ihm steht ein Speiskübel.“"
                            },
                            {
                                "example_id": "ba43f31d-4804-4698-a765-f36138c254a6",
                                "sense_id": "209fb4f2-5f6c-3d08-8358-fe1fb7c85bbc",
                                "text": "„Das Gerüst war fertig, Mauersteine und Speiskübel wurden hochgelangt und wie erwartet, brach die Stange.“"
                            },
                            {
                                "example_id": "85658a3a-bf32-478b-aad1-61a9c6830481",
                                "sense_id": "209fb4f2-5f6c-3d08-8358-fe1fb7c85bbc",
                                "text": "„Die härteste von Frauen verrichtete Arbeit ist die der Ziegelherstellung und des Hausbaus; bei letzterem sind sie gezwungen, Karren mit großen Mörtelladungen zu ziehen, schwere Speiskübel auf die Gerüste zu tragen und Kälte und Hitze während eines Arbeitstages von sechzehn oder siebzehn Stunden zu ertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
