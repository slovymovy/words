                ],
                "senses": [
                    {
                        "sense_id": "fb46969c-3ab0-3645-b04e-ce214ca78159",
                        "entry_id": "1d2c9692-9362-3412-abd9-f1d8af814063",
                        "glosses": [
                            "Qui naît, qui commence à paraître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4884d74a-1735-4568-a4fd-3521ec46ab79",
                                "sense_id": "fb46969c-3ab0-3645-b04e-ce214ca78159",
                                "text": "Au jour naissant, il apparaît comme un miroir d’argent que le souffle a terni ; les feux de midi le font rayonner et, quand le soleil décline, il se revêt de nacre ainsi que les coquilles où chante encore la mer."
                            },
                            {
                                "example_id": "0338072f-99dd-4c10-b95b-f9a5558d673d",
                                "sense_id": "fb46969c-3ab0-3645-b04e-ce214ca78159",
                                "text": "Passion naissante. — Amour naissant."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc259af8-dce0-35b6-bd56-11a936450341",
                        "entry_id": "1d2c9692-9362-3412-abd9-f1d8af814063",
                        "glosses": [
                            "Qui commence à poindre, à pousser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ebf13cd-3904-42ee-98dd-b568c4421436",
                                "sense_id": "bc259af8-dce0-35b6-bd56-11a936450341",
                                "text": "Barbe naissante."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e059adf-aa92-3e1e-ac87-1d3cb376edd7",
                        "entry_id": "1d2c9692-9362-3412-abd9-f1d8af814063",
                        "glosses": [
                            "Qualifie l’état d’un corps envisagé au moment de sa formation, au sein même de la masse qui le provoque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd2be9b6-0aaa-4751-887d-362196539f3a",
                                "sense_id": "1e059adf-aa92-3e1e-ac87-1d3cb376edd7",
                                "text": "Oxygène à l’état naissant. '(Par ellipse) Oxygène naissant. - À l’état naissant, les corps possèdent généralement une activité particulière et on admet qu’à ce moment ils sont à l’état atomique et pas encore condensés à l’état moléculaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "d083ae01-8518-304b-ba62-b2e1b898c45d",
                        "entry_id": "1d2c9692-9362-3412-abd9-f1d8af814063",
                        "glosses": [
                            "Se dit d’un animal ou une créature dont on ne voit que la partie supérieure comme si le reste était caché. À rapprocher d’issant et mouvant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e06f76-fc41-4555-a4b4-bf30f0a7ad2f",
                                "sense_id": "d083ae01-8518-304b-ba62-b2e1b898c45d",
                                "text": "D’azur au lion naissant d’or, qui est de Saulx → voir illustration « lion naissant »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31aa46c1-4b82-44e7-8b7a-cd2f5f6109bb",
                        "source_entry_id": "1d2c9692-9362-3412-abd9-f1d8af814063",
                        "source_sense_id": "fb46969c-3ab0-3645-b04e-ce214ca78159",
