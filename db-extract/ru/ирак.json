                "senses": [
                    {
                        "sense_id": "34a391b0-6241-3f7c-a443-225b3aeb8f77",
                        "entry_id": "d892583b-c21e-3a3b-9fcd-1f1438b7bcd0",
                        "glosses": [
                            "геогр. и полит. государство на Ближнем Востоке и в Передней Азии, населённое арабами и курдами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01a62627-f2c2-4152-b29e-286d6fcd45b5",
                                "sense_id": "34a391b0-6241-3f7c-a443-225b3aeb8f77",
                                "text": "Исламистские повстанцы ведут наступление на курдские районы Ирака."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67c2db83-01cc-4ce6-848c-903115928a4a",
                        "source_entry_id": "d892583b-c21e-3a3b-9fcd-1f1438b7bcd0",
                        "source_sense_id": "34a391b0-6241-3f7c-a443-225b3aeb8f77",
                        "target_lang_word": "Iraq",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iraq",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4667c315-2bf7-33e1-8844-a29fc07b5814",
                                        "entry_id": "ec676728-7bcd-3883-b69a-bb968ab128e7",
                                        "glosses": [
                                            "A country in West Asia in the Middle East. Official name: Republic of Iraq. Capital and largest city: Baghdad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd59522d-8fd6-486f-94ee-bcbcb1267e08",
                                                "sense_id": "4667c315-2bf7-33e1-8844-a29fc07b5814",
                                                "text": "The AK-47s handed in would then be registered in the database before being redistributed to new units formed as Iraq takes over security control from U.S.-led forces, he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31d97190-c886-3a1f-8d71-e2ee7dd29f46",
                                        "entry_id": "ec676728-7bcd-3883-b69a-bb968ab128e7",
                                        "glosses": [
                                            "An expansive medieval region of West Asia, including not only the modern territories of Iraq but also large parts of western Iran (the so-called Persian Iraq)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baa90a5b-fcea-46dd-8c5c-ceeb9f6c41bc",
                        "source_entry_id": "d892583b-c21e-3a3b-9fcd-1f1438b7bcd0",
                        "source_sense_id": "34a391b0-6241-3f7c-a443-225b3aeb8f77",
                        "target_lang_word": "Irak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                        "entry_id": "48572b51-8bbf-3027-a2ea-0c517cbadaf3",
                                        "glosses": [
                                            "Staat in Vorderasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112f8540-28b8-441e-a1ae-ef368becbde3",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "Im Irak leben über 25 Millionen Menschen."
                                            },
                                            {
                                                "example_id": "35b5a624-17a1-46a7-b5f0-ebb8821c64d8",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "Mosul ist die zweitgrößte Stadt Iraks."
                                            },
                                            {
                                                "example_id": "9c29b5b9-3d9b-430c-ad3d-ea9dda971676",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Im Nordosten hat der Irak Anteil an den schroffen und verkarsteten Ketten des Taurus und des Sagrosgebirges, im Süden und Südwesten an der syrisch-arabischen Wüste.“"
                                            },
                                            {
                                                "example_id": "cbf4ca99-5deb-4a31-b734-03ed399449ab",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Da im Irak unterschiedliche Niederschlagsverhältnisse herrschen, gibt es ebenfalls unterschiedliche Vegetationsarten. Im Nordirak gibt es Strauchvegetation und vereinzelte Waldbestände.“"
                                            },
                                            {
                                                "example_id": "c5448070-7f1a-4579-9f01-ea93ae0e7112",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Angesichts des Stillstands bei der Regierungsbildung im Irak hat der UN-Sicherheitsrat Fortschritte in Bagdad angemahnt.“"
                                            },
                                            {
                                                "example_id": "4ea3bbf7-2683-4886-9fad-38b782c43094",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Die verstärkten Anschläge im Irak stellen nach den Worten von US-Präsident Barack Obama nicht die Abzugspläne für die US-Kampftruppen bis Ende August infrage.“"
                                            },
                                            {
                                                "example_id": "ca060bb8-b94a-481e-b9bb-bc6488bf576e",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Auch mit ſeinem Halbbruder Mohammed mußte er hernach theilen h); dieſer behielt Aderbidſchan und ihm ſelbst blieb nur die Herrſchaft des Oſtens und die Oberlehnsherrſchaft über beide Irak.“ (1821)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "339a9f52-6a0f-4e7e-be2f-6e850bb0c051",
                        "source_entry_id": "d892583b-c21e-3a3b-9fcd-1f1438b7bcd0",
                        "source_sense_id": "34a391b0-6241-3f7c-a443-225b3aeb8f77",
