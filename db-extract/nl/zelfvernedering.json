                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-abasement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b67841f0-9bcd-3b41-8b63-85d368f6c9c0",
                                        "entry_id": "1e383911-9e1f-3203-9584-00672e956c2d",
                                        "glosses": [
                                            "The abasement of oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb923dd6-cf2f-4f1d-9999-9d0b40a939ba",
                                                "sense_id": "b67841f0-9bcd-3b41-8b63-85d368f6c9c0",
                                                "text": "Self-abasement is a state of excessive, unwarranted humility self-inflicted humiliation and degradation."
                                            },
                                            {
                                                "example_id": "89629097-b769-4c5d-a9af-45c88972885a",
                                                "sense_id": "b67841f0-9bcd-3b41-8b63-85d368f6c9c0",
                                                "text": "This self-abasement is a widespread characteristic in Holland. Especially in the company of foreigners the Dutch tend to run their country down. By pretending to be less than they know they are, they prevent being belittled by other people."
                                            },
                                            {
                                                "example_id": "3328f1a8-10e3-4870-8a09-a94b3814a3de",
                                                "sense_id": "b67841f0-9bcd-3b41-8b63-85d368f6c9c0",
                                                "text": "Self-abasement is a process whereby through criticizing, blaming, or otherwise derogating the self, the individual seeks to allay anxiety."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
