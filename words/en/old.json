{
    "word_family": [
        "olden",
        "oldie",
        "oldness",
        "oldster",
        "old-fashioned"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90baf216-b56e-342a-b93d-a318b70a4cb4",
                    "sense_definition": "Of a living being, having lived for most of the expected years.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>old</w> man sat on the park bench watching the children play.",
                            "target_lang_translations": {
                                "ru": "<w>Старый</w> человек сидел на скамейке в парке, наблюдая за игрой детей."
                            }
                        },
                        {
                            "text": "My dog is getting <w>old</w> and cannot run as fast as he used to.",
                            "target_lang_translations": {
                                "ru": "Моя собака <w>стареет</w> и не может бегать так быстро, как раньше."
                            }
                        }
                    ],
                    "synonyms": [
                        "aged",
                        "elderly",
                        "on in years"
                    ],
                    "antonyms": [
                        "young"
                    ],
                    "common_phrases": [
                        "old man",
                        "old woman",
                        "grow old"
                    ],
                    "target_lang_definitions": {
                        "ru": "О живом существе: проживший большую часть ожидаемого срока жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "о человеке или животном"
                            },
                            {
                                "target_lang_word": "пожилой",
                                "target_lang_sense_clarification": "более вежливое о человеке"
                            },
                            {
                                "target_lang_word": "немолодой",
                                "target_lang_sense_clarification": "среднего или старшего возраста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d38d959-8add-3f24-9c82-8a59d9a2579f",
                    "sense_definition": "Of an object, concept, or relationship, having existed for a relatively long period of time.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love visiting this <w>old</w> building because of its beautiful architecture.",
                            "target_lang_translations": {
                                "ru": "Мне нравится посещать это <w>старое</w> здание из-за его красивой архитектуры."
                            }
                        },
                        {
                            "text": "He is an <w>old</w> friend from my primary school days.",
                            "target_lang_translations": {
                                "ru": "Он мой <w>старый</w> друг еще со времен начальной школы."
                            }
                        }
                    ],
                    "synonyms": [
                        "ancient",
                        "antique",
                        "long-standing"
                    ],
                    "antonyms": [
                        "new",
                        "brand new",
                        "fresh"
                    ],
                    "common_phrases": [
                        "old friend",
                        "old building",
                        "old times"
                    ],
                    "target_lang_definitions": {
                        "ru": "Об объекте, концепции или отношениях: существующий в течение относительно долгого периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "существующий давно"
                            },
                            {
                                "target_lang_word": "давний",
                                "target_lang_sense_clarification": "о друге или знакомстве"
                            },
                            {
                                "target_lang_word": "старинный",
                                "target_lang_sense_clarification": "об архитектуре или вещах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f4239a-8fb9-3844-8020-78c0884e8857",
                    "sense_definition": "Having existed or lived for the specified amount of time.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My daughter is five years <w>old</w> and just started school.",
                            "target_lang_translations": {
                                "ru": "Моей дочери пять <w>лет</w>, и она только что пошла в школу."
                            }
                        },
                        {
                            "text": "How <w>old</w> is your car? It looks like it is in great condition.",
                            "target_lang_translations": {
                                "ru": "Сколько <w>лет</w> вашей машине? Она выглядит отлично."
                            }
                        }
                    ],
                    "synonyms": [
                        "aged",
                        "of age"
                    ],
                    "common_phrases": [
                        "years old",
                        "how old",
                        "weeks old"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий возраст в указанное количество времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в возрасте",
                                "target_lang_sense_clarification": "имеющий определенный возраст"
                            },
                            {
                                "target_lang_word": "от роду",
                                "target_lang_sense_clarification": "о возрасте с момента рождения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb27387e-8ad9-3931-8758-96eba4faec76",
                    "sense_definition": "Belonging to an earlier time; former or previous.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "previous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>old</w> car was much smaller than the one I have now.",
                            "target_lang_translations": {
                                "ru": "Моя <w>прежняя</w> машина была намного меньше той, что у меня сейчас."
                            }
                        },
                        {
                            "text": "She decided to move back to her <w>old</w> neighborhood after many years.",
                            "target_lang_translations": {
                                "ru": "Спустя много лет она решила вернуться в свой <w>старый</w> район."
                            }
                        }
                    ],
                    "synonyms": [
                        "former",
                        "past",
                        "previous",
                        "one-time"
                    ],
                    "antonyms": [
                        "current",
                        "latest"
                    ],
                    "common_phrases": [
                        "old self",
                        "old neighborhood",
                        "old job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий к более раннему времени; прежний или предыдущий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прежний",
                                "target_lang_sense_clarification": "бывший ранее"
                            },
                            {
                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "о месте жительства или работе"
                            },
                            {
                                "target_lang_word": "бывший",
                                "target_lang_sense_clarification": "о статусе или предмете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f89c5a1-fc1a-3339-83a6-67b6c52a6752",
                    "sense_definition": "Having been used and thus no longer new or unused.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't throw away that <w>old</w> toothbrush; it's great for cleaning small gaps.",
                            "target_lang_translations": {
                                "ru": "Не выбрасывай ту <w>старую</w> зубную щетку; она отлично подходит для чистки узких щелей."
                            }
                        },
                        {
                            "text": "I wore my <w>old</w> clothes to paint the living room.",
                            "target_lang_translations": {
                                "ru": "Я надел свою <w>старую</w> одежду, чтобы покрасить гостиную."
                            }
                        }
                    ],
                    "synonyms": [
                        "used",
                        "worn"
                    ],
                    "antonyms": [
                        "new"
                    ],
                    "common_phrases": [
                        "old clothes",
                        "old toothbrush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывший в употреблении и, следовательно, больше не новый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "поношенный или использованный"
                            },
                            {
                                "target_lang_word": "подержанный",
                                "target_lang_sense_clarification": "бывший в употреблении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21682cc5-5654-3927-8fa3-f44430178110",
                    "sense_definition": "Of a perishable item, having existed for most of, or more than, its shelf life.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>old</w> loaf of bread has started to grow mold.",
                            "target_lang_translations": {
                                "ru": "Эта <w>черствая</w> буханка хлеба начала покрываться плесенью."
                            }
                        },
                        {
                            "text": "The milk smells <w>old</w>, so we should probably throw it out.",
                            "target_lang_translations": {
                                "ru": "У молока <w>несвежий</w> запах, так что нам, вероятно, стоит его вылить."
                            }
                        }
                    ],
                    "synonyms": [
                        "stale",
                        "expired"
                    ],
                    "antonyms": [
                        "fresh"
                    ],
                    "common_phrases": [
                        "old bread",
                        "old milk"
                    ],
                    "target_lang_definitions": {
                        "ru": "О скоропортящемся продукте: срок годности которого подходит к концу или истек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несвежий",
                                "target_lang_sense_clarification": "о продуктах"
                            },
                            {
                                "target_lang_word": "черствый",
                                "target_lang_sense_clarification": "о хлебе"
                            },
                            {
                                "target_lang_word": "прокисший",
                                "target_lang_sense_clarification": "о молоке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bc71f1c-e5f3-358a-add8-b65b8eea25a9",
                    "sense_definition": "No longer in use; obsolete or out-of-date.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "previous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is the <w>old</w> way of doing things; we have a much faster method now.",
                            "target_lang_translations": {
                                "ru": "Это <w>устаревший</w> способ ведения дел; теперь у нас есть гораздо более быстрый метод."
                            }
                        },
                        {
                            "text": "The company is still using an <w>old</w> version of the software.",
                            "target_lang_translations": {
                                "ru": "Компания все еще использует <w>старую</w> версию программного обеспечения."
                            }
                        }
                    ],
                    "synonyms": [
                        "antiquated",
                        "obsolete",
                        "outdated"
                    ],
                    "antonyms": [
                        "new-fangled"
                    ],
                    "common_phrases": [
                        "old way",
                        "old fashioned"
                    ],
                    "target_lang_definitions": {
                        "ru": "Больше не используемый; устаревший или вышедший из моды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устаревший",
                                "target_lang_sense_clarification": "вышедший из употребления"
                            },
                            {
                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "о версии или методе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59fbebef-5d4b-3449-9d1e-4db13b6f487e",
                    "sense_definition": "Tiresome or boring after prolonged repetition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your constant complaining is getting <w>old</w> very fast.",
                            "target_lang_translations": {
                                "ru": "Твои постоянные жалобы очень быстро <w>надоедают</w>."
                            }
                        },
                        {
                            "text": "The same <w>old</w> jokes aren't funny after you've heard them ten times.",
                            "target_lang_translations": {
                                "ru": "Те же <w>самые</w> шутки уже не смешны, когда слышишь их в десятый раз."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiresome",
                        "boring"
                    ],
                    "common_phrases": [
                        "get old",
                        "same old thing"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'get' or 'grow'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Утомительный или скучный после длительного повторения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надоевший",
                                "target_lang_sense_clarification": "ставший скучным"
                            },
                            {
                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "о заезженных шутках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9246f02b-46b8-35cb-8026-b51f7c020d03",
                    "sense_definition": "A grammatical intensifier used to describe something familiar or positive, often combined with another adjective.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a good <w>old</w> time at the party last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>славно</w> провели время на вечеринке вчера вечером."
                            }
                        },
                        {
                            "text": "He drives a big <w>old</w> truck that makes a lot of noise.",
                            "target_lang_translations": {
                                "ru": "Он водит <w>здоровенный</w> грузовик, который сильно шумит."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good old time",
                        "big old",
                        "little old"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal intensifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматический усилитель, используемый для описания чего-то знакомого или положительного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старый добрый",
                                "target_lang_sense_clarification": "о привычных вещах"
                            },
                            {
                                "target_lang_word": "здоровенный",
                                "target_lang_sense_clarification": "в значении 'big old'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8150b63-0ad9-3330-9e82-f62a30f01b07",
                    "sense_definition": "Indicating affection and familiarity when referring to a person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good <w>old</w> Charlie always knows how to make us laugh.",
                            "target_lang_translations": {
                                "ru": "<w>Старина</w> Чарли всегда знает, как нас рассмешить."
                            }
                        },
                        {
                            "text": "I haven't seen <w>old</w> Smith in ages; I wonder how he is.",
                            "target_lang_translations": {
                                "ru": "Я сто лет не видел <w>старину</w> Смита; интересно, как он."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good old",
                        "dear old"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used before names"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение привязанности и фамильярности при упоминании человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старина",
                                "target_lang_sense_clarification": "дружеское обращение"
                            },
                            {
                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "перед именем друга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "673fbbb7-6597-34c6-b5a8-cd869e77dc01",
                    "sense_definition": "Of a species or language, belonging to a lineage that is distantly related to others or has existed for a very long time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Basque is considered the <w>oldest</w> language in Europe with no known relatives.",
                            "target_lang_translations": {
                                "ru": "Баскский язык считается <w>древнейшим</w> языком в Европе, не имеющим известных родственников."
                            }
                        },
                        {
                            "text": "The ginkgo tree is one of the <w>oldest</w> living species on the planet.",
                            "target_lang_translations": {
                                "ru": "Дерево гинкго — один из <w>древнейших</w> видов на планете."
                            }
                        }
                    ],
                    "synonyms": [
                        "ancient",
                        "primitive"
                    ],
                    "common_phrases": [
                        "oldest language",
                        "oldest species"
                    ],
                    "target_lang_definitions": {
                        "ru": "О виде или языке: принадлежащий к линии, которая существует очень долгое время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древний",
                                "target_lang_sense_clarification": "существующий века"
                            },
                            {
                                "target_lang_word": "древнейший",
                                "target_lang_sense_clarification": "самый старый из существующих"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1e15e1c-85f7-3e18-b06e-c74014d62c74",
                    "sense_definition": "Designed for a mature audience; unsuitable for children.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This book's themes are a bit too <w>old</w> for a toddler to understand.",
                            "target_lang_translations": {
                                "ru": "Темы этой книги слишком <w>взрослые</w> для понимания малышом."
                            }
                        },
                        {
                            "text": "The movie was too <w>old</w> for the kids, so we watched a cartoon instead.",
                            "target_lang_translations": {
                                "ru": "Фильм был слишком <w>взрослым</w> для детей, поэтому мы посмотрели мультик."
                            }
                        }
                    ],
                    "synonyms": [
                        "mature",
                        "sophisticated"
                    ],
                    "common_phrases": [
                        "too old for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для взрослой аудитории; неподходящий для детей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрослый",
                                "target_lang_sense_clarification": "не для детей"
                            },
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "о темах, требующих зрелости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e62691b-f23b-3aab-94fe-10868196a320",
                    "sense_definition": "Excessive or abundant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was <w>old</w> revelry at the tavern until the early hours of the morning.",
                            "target_lang_translations": {
                                "ru": "В таверне до самого утра шло <w>великое</w> веселье."
                            }
                        }
                    ],
                    "synonyms": [
                        "abundant",
                        "excessive"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерный или обильный (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великий",
                                "target_lang_sense_clarification": "в значении обильный"
                            },
                            {
                                "target_lang_word": "изрядный",
                                "target_lang_sense_clarification": "о большом количестве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e674b47e-a1a8-3328-b245-8e1ce88c4663",
                    "sense_definition": "People who are old; the older generation taken as a group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A civilized society should always look after the <w>old</w> in the community.",
                            "target_lang_translations": {
                                "ru": "Цивилизованное общество всегда должно заботиться о <w>стариках</w>."
                            }
                        },
                        {
                            "text": "The <w>old</w> often have wisdom that the young have yet to acquire.",
                            "target_lang_translations": {
