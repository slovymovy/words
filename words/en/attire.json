{
    "word_family": [
        "attirement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddbd0acf-28de-36f5-876a-2c32916f3e5b",
                    "sense_definition": "Clothing or garments worn by a person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invitation specified that formal <w>attire</w> was required for the evening gala.",
                            "target_lang_translations": {
                                "ru": "В приглашении было указано, что для вечернего гала-концерта требуется официальная <w>одежда</w>."
                            }
                        },
                        {
                            "text": "She chose comfortable <w>attire</w> for her long flight across the country.",
                            "target_lang_translations": {
                                "ru": "Она выбрала удобную <w>одежду</w> для долгого перелета через всю страну."
                            }
                        }
                    ],
                    "synonyms": [
                        "dress"
                    ],
                    "common_phrases": [
                        "formal attire",
                        "business attire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одежда или предметы гардероба, которые носит человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оде́жда",
                                "target_lang_sense_clarification": "общее понятие для предметов, покрывающих тело"
                            },
                            {
                                "target_lang_word": "одея́ние",
                                "target_lang_sense_clarification": "торжественная или официальная одежда"
                            },
                            {
                                "target_lang_word": "фо́рма оде́жды",
                                "target_lang_sense_clarification": "установленный стиль или дресс-код"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3fcbb7f-ac2b-347c-97f5-6f5c6a359ec3",
                    "sense_definition": "The antlers or horns of a deer or stag.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter admired the impressive <w>attire</w> of the stag he had tracked through the forest.",
                            "target_lang_translations": {
                                "ru": "Охотник любовался внушительными <w>рогами</w> оленя, которого он выследил в лесу."
                            }
                        },
                        {
                            "text": "In heraldry, the <w>attire</w> is often depicted as a symbol of strength and nobility.",
                            "target_lang_translations": {
                                "ru": "В геральдике <w>рога</w> часто изображаются как символ силы и благородства."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in hunting or heraldic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рога оленя или другого копытного животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рога́",
                                "target_lang_sense_clarification": "анатомический термин для рогов оленя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bab85fb1-47c1-31bb-b7d4-18f0e0d87a6f",
                    "sense_definition": "To dress or decorate someone in specific clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>attire</w> the actors in elaborate costumes for the historical play.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>одеть</w> актеров в сложные костюмы для исторической пьесы."
                            }
                        },
                        {
                            "text": "The guests were <w>attired</w> in traditional garments for the wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Гости были <w>одеты</w> в традиционные наряды для свадебной церемонии."
                            }
                        }
                    ],
                    "synonyms": [
                        "clothe",
                        "dress",
                        "don"
                    ],
                    "common_phrases": [
                        "attired in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одевать или украшать кого-либо в определенную одежду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одева́ть",
                                "target_lang_sense_clarification": "процесс облачения кого-либо в одежду"
                            },
                            {
                                "target_lang_word": "наряжа́ть",
                                "target_lang_sense_clarification": "одевать кого-либо в красивую или праздничную одежду"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}