                "senses": [
                    {
                        "sense_id": "8e107c4d-4334-37c9-83d1-344b973b2e4a",
                        "entry_id": "166df31e-1855-35dd-b67e-664af59f848f",
                        "glosses": [
                            "gebundelde hoeveelheid bladeren papier waarin je kunt schrijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea05149-dc2b-4c51-8067-129850e9f681",
                                "sense_id": "8e107c4d-4334-37c9-83d1-344b973b2e4a",
                                "text": "Ik legde de lege cahiers die ik had meegenomen links op een stapel, met mijn vulpen ernaast."
                            },
                            {
                                "example_id": "7ea0fde0-3c7e-4a56-ae5c-e2f1544c5bac",
                                "sense_id": "8e107c4d-4334-37c9-83d1-344b973b2e4a",
                                "text": "Op zijn 70ste verjaardag, deze 16 december, schenkt Adriaan van Dis zijn literaire archief aan het Literatuurmuseum in Den Haag. Het archief bevat manuscripten van romans en novellen als Nathan Sid en Zilver, cahiers met aantekeningen voor Ik kom terug en Tikkop, foto’s, literaire cartoons en correspondentie met collega-schrijvers als Maarten ’t Hart, Geert Mak, Charlotte Mutsaers, Cees Nooteboom, Jan Siebelink, Marten Toonder en Joost Zwagerman."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2238399-044a-4bce-8630-3633baf9881b",
                        "source_entry_id": "166df31e-1855-35dd-b67e-664af59f848f",
                        "source_sense_id": "8e107c4d-4334-37c9-83d1-344b973b2e4a",
                        "source_sense_description": "gebundelde hoeveelheid bladeren papier waarin je kunt schrijven",
                        "target_lang_word": "notebook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notebook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "A book in which notes or memoranda are written."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f661450-213c-41fc-a3b8-9206f8e320a5",
                                                "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                                "text": "With an unquenchable enthusiasm for locomotives and their work, at an early age I had commenced to keep engine and traffic-recording notebooks, compiled in a schoolboy's round hand."
                                            },
                                            {
                                                "example_id": "0157a3e9-dd49-4ada-8d39-fe4dc6d334b8",
                                                "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                                "text": "For Caſſius is a-weary of the World: / Hated by one he loues, brau'd by his Brother, / Check'd like a bondman, all his faults obſeru'd, / Set in a Note-booke, learn'd, and con'd by roate / To caſt into my Teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf7f7f95-836f-3b9d-8f39-47f35b6926ec",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "A kind of user interface in literate programming, allowing calculations to be interspersed with human-readable comments, diagrams, etc."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd2549f-63de-4550-a6fc-2f2b9a683248",
                                                "sense_id": "cf7f7f95-836f-3b9d-8f39-47f35b6926ec",
                                                "text": "We have found the use of Jupyter notebooks to be a convenient way of sharing work and code in a compact and reproducible manner. Jupyter notebooks are easy to update and adapt over time compared to a static CD-ROM."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898cce50-6c35-3728-82a1-b1dc45f9598d",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "Ellipsis of notebook computer (“laptop computer”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "599f9bba-fd5d-4e01-9848-9aeb3a34ff61",
                                                "sense_id": "898cce50-6c35-3728-82a1-b1dc45f9598d",
                                                "text": "Over time, the difference in size between laptops and notebooks became a matter of no more than an inch or two in length and width, and a fraction of an inch in thickness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
