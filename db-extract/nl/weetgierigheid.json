                    }
                ],
                "senses": [
                    {
                        "sense_id": "034e6380-e7db-33b2-9535-ca13bb66809e",
                        "entry_id": "3ee13285-a850-3a79-bafc-c5a18e274d18",
                        "glosses": [
                            "het verlangen naar kennis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef49188-2aaa-4781-a386-c3f391ae23d0",
                                "sense_id": "034e6380-e7db-33b2-9535-ca13bb66809e",
                                "text": "Het boek heeft eenzelfde opzet als ”Du holde Kunst” (1994), ook qua opzet en invalshoek. ’t Hart is een man met een fenomenaal geheugen, een ongelooflijke weetgierigheid en een ongeremde hang naar volledigheid. Een ”compulsive obsessive”, zoals ze aan de overkant van de Noordzee zo treffend zeggen."
                            },
                            {
                                "example_id": "9e3d3ba3-4d4e-4281-a4e4-962947ae64cd",
                                "sense_id": "034e6380-e7db-33b2-9535-ca13bb66809e",
                                "text": "De geschiedenis moet in een roman wel iets betekenen. En dat doet het: Isidoor is met zijn onstuitbare weetgierigheid een projectiescherm voor de wederwaardigheden van de middeleeuwen, van christelijke concilies tot semi-ketterse wetenschap."
                            },
                            {
                                "example_id": "39e7fbdf-9af5-4bb9-a4d1-ddeceb5ac633",
                                "sense_id": "034e6380-e7db-33b2-9535-ca13bb66809e",
                                "text": "Maar de sprankelende taal, de lichte, heldere toon en treffende poëtische beelden waarmee ze de geheimen van het dierenrijk vervolgens vormgeeft, verraden dat ze eerder door verwondering dan weetgierigheid gedreven wordt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12cf5789-9353-4bb0-9e9b-541ab5a82699",
                        "source_entry_id": "3ee13285-a850-3a79-bafc-c5a18e274d18",
                        "source_sense_id": "034e6380-e7db-33b2-9535-ca13bb66809e",
                        "source_sense_description": "het verlangen naar kennis",
                        "target_lang_word": "eagerness to learn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
