                ],
                "senses": [
                    {
                        "sense_id": "0bffcf2d-3192-36d9-8274-b10d3b81b7af",
                        "entry_id": "9c38c996-4acc-39a8-83fd-bd40ac6a6e67",
                        "glosses": [
                            "verontreiniging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e501d9-db52-4043-8ebd-0de74b7ff58d",
                                "sense_id": "0bffcf2d-3192-36d9-8274-b10d3b81b7af",
                                "text": "In deze krankzinnige, wrede en cynische wereld is het niet langer ‘cool’ om waarden te hebben, humanist te zijn, of werkelijk empathie te voelen voor het lijden van de andere - ook als die andere je vijand is op het slagveld. Van Uri heb ik geleerd hoe belangrijk dat alles is. We moeten onszelf beschermen tegen de grootste kwalen van het leven in een rampzalige regio als de onze: we moeten ons beschermen tegen al te simplistisch denken, tegen de corruptie die inherent is aan cynisme, tegen de pollutie van het hart en tegen wreedheid jegens onze medemens.”"
                            },
                            {
                                "example_id": "0184963e-68d3-48d6-ab71-b92dcc4530f9",
                                "sense_id": "0bffcf2d-3192-36d9-8274-b10d3b81b7af",
                                "text": "Vermeulen weet het beter. Volgens Bram Vermeulen zullen alleen mensen die een ultraviolet resistente huid, een stralingsbestendig lichaam, pollutie weerbare longen, van nature dove oren, een gifbestendige maag en een stressbestendig zenuwstelsel bezitten, overleven en kinderen krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2da9779a-6c01-3d86-8eae-0f460ab9eda7",
                        "entry_id": "9c38c996-4acc-39a8-83fd-bd40ac6a6e67",
                        "glosses": [
                            "onwillekeurige zaadlozing tijdens de slaap"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f40d8a96-0899-473d-b912-b7fbeb067b51",
                        "source_entry_id": "9c38c996-4acc-39a8-83fd-bd40ac6a6e67",
                        "source_sense_id": "0bffcf2d-3192-36d9-8274-b10d3b81b7af",
                        "source_sense_description": "verontreiniging",
                        "target_lang_word": "Verschmutzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschmutzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                        "entry_id": "e0ec0acf-fd7a-301d-bc33-3a85e4a4e3dc",
                                        "glosses": [
                                            "Verunreinigung durch Schmutz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb51f470-f653-4f15-a442-399832cc3e7b",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "Aber die Meere leiden ja vor allem unter der Verschmutzung vom Land aus."
                                            },
                                            {
                                                "example_id": "cfba7b52-f718-41e9-8a83-0750c223f322",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Auch die Verschmutzung durch Mikroplastik wird in jedem Land deutlich zunehmen.“"
                                            },
                                            {
                                                "example_id": "9f08986a-95b6-4a07-9ed3-dfd33d445b0a",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Ein globales Abkommen zur Eindämmung von Verschmutzung durch Plastikmüll könnte das ändern.“"
                                            },
                                            {
                                                "example_id": "cd7c2f93-b38c-4d8f-93a3-900caf27e755",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Mikroplastik im Süßwasser - Wie lässt sich die Verschmutzung stoppen?“"
                                            },
                                            {
                                                "example_id": "d312e972-6b11-4d4a-b9c4-a5ea489d90a2",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "[Fischsterben in der Oder: Die Europaabgeordnete hat die Umweltbehörden] „aufgefordert, die Quelle der Verschmutzung zu finden und die Schuldigen zur bestrafen.“"
                                            },
                                            {
                                                "example_id": "4f5ec4bf-3b88-4a2a-afea-03da93054c8c",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "[Schlagzeile:] „Über tausend Fische sterben nach Verschmutzung in Freiburger Bach“"
                                            },
                                            {
                                                "example_id": "32cd88f1-e6bb-4fd7-85d4-dd7ef9bfe96a",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Die Ursache der Verschmutzung ist derzeit noch unbekannt.“"
                                            },
                                            {
                                                "example_id": "6c9bd5ea-8a3d-4db5-b492-af39e40ff381",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Allerdings konnten die Einsatzkräfte die Quelle der Verschmutzung im Bach Diron lokalisieren, wie die Freiburger Kantonspolizei mitteilte.“"
                                            },
                                            {
                                                "example_id": "4f6cfe66-a695-432f-8c2e-130508e331bc",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Die Verschmutzung“ [erstreckt] „sich über zwei Kilometer bis in die Sionge.“"
                                            },
                                            {
                                                "example_id": "23df0598-2ce7-4ebc-a0cf-b5e6ba795e59",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Wenn die Verschmutzung ein bestimmtes Maß nicht überschreitet, kann sich ein Gewässer selbst reinigen.“"
                                            },
                                            {
                                                "example_id": "89c2e7c5-95e9-49e3-9711-2c60312ad8c6",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "[Delfine in Flüssen:] „Doch fast überall auf der Welt sind die Populationen geschrumpft. Hauptgrund ist die Verschmutzung der Flüsse.“"
                                            },
                                            {
                                                "example_id": "a129ed48-1f1a-4f6d-802a-5f3d8c148534",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Das Mittelmeer gilt“ […] „als Hotspot für Verschmutzung durch Plastik, weil viele Küstenabschnitte dicht besiedelt sind.“"
                                            },
                                            {
                                                "example_id": "605cc91a-810b-4fde-a797-d0dcaf1c63b6",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "Die Bevölkerung wurde in vielen Fällen bisher nicht über die Verschmutzung informiert."
                                            },
                                            {
                                                "example_id": "7334bcd0-876a-451b-b905-e25fa4c478d8",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Deutlich mehr Luftverschmutzung durch Kreuzfahrten in Hamburg“ […] „Auch in Kiel nahm 2022 die Verschmutzung mit Schwefeloxiden deutlich zu, hier gab es einen Anstieg von 71 Prozent gegenüber 2019.“"
                                            },
                                            {
                                                "example_id": "b110a447-768f-4ece-ae39-9fb84e0f5657",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„So tretet den wackeren Männern in die Seite, die gegen die Überzahl ihrer veraltet sauberen Kollegen schon Hervorragendes auf dem Gebiet der öffentlichen Verschmutzung geleistet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfecdff1-688b-416b-9637-7c0407051f92",
                        "source_entry_id": "9c38c996-4acc-39a8-83fd-bd40ac6a6e67",
                        "source_sense_id": "0bffcf2d-3192-36d9-8274-b10d3b81b7af",
                        "source_sense_description": "verontreiniging",
                        "target_lang_word": "pollution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pollution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                        "entry_id": "6fd790bd-8f86-382c-9175-6afe4774037d",
                                        "glosses": [
                                            "Diffusion dans l’environnement d’un produit potentiellement toxique ou de nature à perturber le fonctionnement d’un biotope."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32632ad-be89-4e57-bac7-0e504b6488dc",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Il résulte, en effet, des études sur les pollutions des rivières anglaises récemment résumées par M. Frankland (Comptes rendus, tome LXX, p. 1054), que lorsque la température ne dépasse pas 17°,8. le parcours de trois à quatre lieues n’influe que médiocrement sur la combustion des matières dissoutes, et que même, après un parcours beaucoup plus prolongé, l’eau n'est pas encore purifiée à 300 kilomètres, l’eau reste souillée."
                                            },
                                            {
                                                "example_id": "25f0c7b2-78d3-476f-97c9-d02f5423ee59",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "La maladie de Minamata, c’est ce terrible fléau dû à la pollution par le mercure qui fit des milliers de victimes au Japon en 1950 et en 1965 : le monde entier a pu voir ces images de corps tordus d’enfants monstrueux dans les bras de leurs mères. Il y avait des cinéastes et des photographes au Japon. Il n’y en avait guère en Irak en 1956, au Pakistan en 1961, au Guatemala en 1963, au Nouveau-Mexique en 1969, où le méthyl-mercure a fait aussi des ravages."
                                            },
                                            {
                                                "example_id": "a039d072-d4ec-49d8-a53d-313b77fac282",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Ville cuvette en quelque sorte, la capitale turque est surtout la victime de la pollution lors des jours sans vent."
                                            },
                                            {
                                                "example_id": "767a7242-96a7-4c6b-b5db-452fd2bbcb96",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Il se fichait même de savoir pourquoi De Lavarice préconisait un désherbement à la main plutôt que l’application de produit herbicide. Il se fichait de savoir si c’était par souci de pollution ou d'économie."
                                            },
                                            {
                                                "example_id": "06a70777-e441-4d72-906f-c9c5e24fb30f",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Et les muges ? Pauvres muges ! On leur a fait tellement de tort avec la pollution et le mazout que les amateurs de muges aux olives sont plutôt rares. C'est un grand vide dans les traditions que la disparition de ce poisson appelé « mulet » dans le reste de la France."
                                            },
                                            {
                                                "example_id": "6bf6377a-49dd-460c-9c59-744793dea0c9",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "Hélas, l’impunité qui caractérise les pollutions et les scandales sanitaires de l’après-mine sur le sol français n’ont presque rien à envier à l’exemple brésilien. En France aujourd’hui, des cas de pollutions cachées attestent des mêmes logiques intrinsèques à une activité criminelle protégée (et donc alimentée) par les pouvoirs publics."
                                            },
                                            {
                                                "example_id": "4c493547-803e-480b-ad74-b95bdb2ac2e5",
                                                "sense_id": "1922a3f9-f50c-38e1-adef-1f9b5e24204a",
                                                "text": "La raison pour laquelle lustrer sa voiture sur la voie publique est interdit, c’est parce que cette pratique contribue à la pollution de l’environnement. Les eaux savonneuses sont déversées dans la nature au lieu de rejoindre les évacuations des eaux usées. Elles peuvent par la suite se déverser dans le cours d’eau le plus proche par ruissellement ou par infiltration, entraînant ainsi l’infiltration de résidus d’hydrocarbures et d’huiles dans le sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a358e8ef-2ed4-3964-b145-458d3950f874",
                                        "entry_id": "6fd790bd-8f86-382c-9175-6afe4774037d",
                                        "glosses": [
                                            "Tout phénomène extérieur qui peut être nuisible, dangereux pour la santé, ou désagréable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09c25ad-a42f-4f92-99e8-b566eff6574d",
                                                "sense_id": "a358e8ef-2ed4-3964-b145-458d3950f874",
                                                "text": "La pollution lumineuse empêche la bonne observation des étoiles."
                                            },
                                            {
                                                "example_id": "19af8223-3315-4f4f-ba1a-893614beba9a",
                                                "sense_id": "a358e8ef-2ed4-3964-b145-458d3950f874",
                                                "text": "La pollution acoustique est un fléau urbain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb789a0-5041-3306-825d-0568cf48ed47",
                                        "entry_id": "6fd790bd-8f86-382c-9175-6afe4774037d",
                                        "glosses": [
                                            "Émission involontaire de sperme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10de33c2-39b7-4e17-9331-733dfc906466",
                                                "sense_id": "2eb789a0-5041-3306-825d-0568cf48ed47",
                                                "text": "Je me réveillai vers cinq heures, constatai que les draps étaient largement tachés de sperme. Une pollution nocturne… c’était attendrissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0798f56-0ec1-331d-b412-44468fc29f87",
                                        "entry_id": "6fd790bd-8f86-382c-9175-6afe4774037d",
                                        "glosses": [
                                            "Profanation, souillure, péché d’impureté."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4afdd2dd-b287-4e04-ad57-60facc76bd74",
                                                "sense_id": "c0798f56-0ec1-331d-b412-44468fc29f87",
                                                "text": "La pollution d’une église dure jusqu’à ce qu’elle ait été bénite à nouveau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
