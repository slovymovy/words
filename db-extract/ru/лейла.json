                        "source_sense_description": "Перевод имени",
                        "target_lang_word": "Leila",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leila",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65bf78b9-e4cd-3de9-b944-fe1504d7446a",
                                        "entry_id": "f434138d-380a-378b-b905-399bc70002df",
                                        "glosses": [
                                            "A female given name from Arabic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005d3e6f-5c51-4877-8813-7b21d6b0fa44",
                                                "sense_id": "65bf78b9-e4cd-3de9-b944-fe1504d7446a",
                                                "text": "Oh! who young Leila’s glance could read / And keep that portion of his creed / Which saith, that woman is but dust, / A soulless toy for tyrant's lust?"
                                            },
                                            {
                                                "example_id": "3ad4b299-ba17-404d-a240-5cf368f43521",
                                                "sense_id": "65bf78b9-e4cd-3de9-b944-fe1504d7446a",
                                                "text": "\"Leila!\" she said enigmatically. \"Have you seen her?\" / \"I went to her flat last week with Dad—he likes her.\" / \"Delilah is her real name, you know. All men like her. And Captain Fort is her lover.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
