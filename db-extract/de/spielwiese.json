                        "form": "die Spielwiese"
                    },
                    {
                        "form_id": "cd9fcb77-18f1-450c-8fd4-0e73f4a7da97",
                        "entry_id": "0cb98135-bfee-36ba-b1ce-2290b619f0ca",
                        "tags": [
                            "accusative",
