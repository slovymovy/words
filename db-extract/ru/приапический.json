                                    },
                                    {
                                        "sense_id": "026b4d0c-3299-3634-9487-019533dcf8b1",
                                        "entry_id": "169c0294-e511-3b74-a7ea-8288bd6ef651",
                                        "glosses": [
                                            "gegen die sittlichen Vorstellungen sexuellen Verhaltens verstoßend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e3c16c9-ad16-4dac-879d-818a0f0754cd",
                                                "sense_id": "026b4d0c-3299-3634-9487-019533dcf8b1",
                                                "text": "„Die vielzitierten Verse aus der 7. Epistel zum Beispiel wenden sich an einen Kritiker, der zwei priapeische Gedichte Mussatos getadelt hatte.“"
                                            }
                                        ],
