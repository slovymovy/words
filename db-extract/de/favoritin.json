                        ],
                        "form": "die Favoritin"
                    },
                    {
                        "form_id": "f77a60eb-fc67-4ba1-a701-2a16802ff46e",
                        "entry_id": "c61d1fee-d31f-3c4a-938b-da4661e082f1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Favoritinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f1d14f5-d87e-3e96-8678-c00673215c15",
                        "entry_id": "c61d1fee-d31f-3c4a-938b-da4661e082f1",
                        "glosses": [
                            "weibliche Person, die von jemandem bevorzugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fae41c4a-78d1-4b7f-a9b3-5fc8e1ad15fc",
                                "sense_id": "7f1d14f5-d87e-3e96-8678-c00673215c15",
                                "text": "„Der Eingang zum Harem war schmal, wie es sich für einen orientalischen Fraueneingang gebührt; der Sondereingang für Favoritinnen war etwas besser.“"
                            },
                            {
                                "example_id": "1fe70132-eb5b-4ac5-b208-7888b97d6001",
                                "sense_id": "7f1d14f5-d87e-3e96-8678-c00673215c15",
                                "text": "„Sie war die Favoritin des Generals und, abgesehen von Signora F., die hübscheste der venezianischen Damen, die sich in Korfu aufhielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "11074cb6-b8fe-3b25-b00c-52fd4446a252",
                        "entry_id": "c61d1fee-d31f-3c4a-938b-da4661e082f1",
                        "glosses": [
                            "Teilnehmerin mit der größten Aussicht, in einem Vergleich zu gewinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42bff579-a555-474f-a009-cdcaffe66a67",
                                "sense_id": "11074cb6-b8fe-3b25-b00c-52fd4446a252",
                                "text": "„Und auch bei den Skiweltmeisterschaften, die am 6. Februar in St. Moritz beginnen, gilt Shiffrin wieder als die große Favoritin auf Gold.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7bfd9a55-9bc1-3fec-9c47-71f496841e8f",
                        "entry_id": "c61d1fee-d31f-3c4a-938b-da4661e082f1",
                        "glosses": [
                            "Geliebte eines Fürsten oder Monarchen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "a1e62c2b-40f1-4506-9d02-436d503e8003",
                                "sense_id": "7bfd9a55-9bc1-3fec-9c47-71f496841e8f",
                                "text": "„Eine sehr beliebte Marketenderin war die Favoritin des Pascha von Jerusalem geworden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25bdf6be-a8aa-478e-8eb9-0a04e305a365",
                        "source_entry_id": "c61d1fee-d31f-3c4a-938b-da4661e082f1",
                        "source_sense_id": "7f1d14f5-d87e-3e96-8678-c00673215c15",
                        "source_sense_description": "weibliche Person, die von jemandem bevorzugt wird",
                        "target_lang_word": "favorite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favorite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0025d02e-fb6b-3f31-bb68-fe227e5b8415",
                                        "entry_id": "1c528083-ab3b-33b3-b87c-8f8af0c85af4",
                                        "glosses": [
                                            "Celle qui est l’objet d’une préférence marquée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "180e2a81-ac63-43ca-a97d-89b4ccf29c47",
                                                "sense_id": "0025d02e-fb6b-3f31-bb68-fe227e5b8415",
                                                "text": "Elle avait été la favorite de sa mère, la reine de la maison sous ma grand’mère, qui ne s’amollissait que pour elle, la tutrice de ses sœurs plus jeunes, la médiatrice de ses frères…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c127e1e-d305-33b8-848e-ee6bef09404b",
                                        "entry_id": "1c528083-ab3b-33b3-b87c-8f8af0c85af4",
                                        "glosses": [
                                            "Maitresse préférée d’un souverain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bdbd05b-799f-4477-9982-7e824b0396bd",
                                                "sense_id": "6c127e1e-d305-33b8-848e-ee6bef09404b",
                                                "text": "C'est contre elles et l'air de galanterie que Mme de Chartres prévient sa fille, car cette cour est surpeuplée de femmes de petite vertu, toujours prêtes à se donner, comme des odalisques de sérail, même si elles ne sont plus favorites: […]."
                                            },
                                            {
                                                "example_id": "38c4b6f2-103d-4337-87e6-be43a7628f60",
                                                "sense_id": "6c127e1e-d305-33b8-848e-ee6bef09404b",
                                                "text": "Surtout, cette irruption de l’argent facile, avec la spéculation, et l’apparition de nouveaux riches, avait contribué à bousculer l’ordonnancement social : ainsi, était-ce la fille d'un commissaire aux vivres, une bourgeoise, une financière enrichie, la « Poisson », qui devint la favorite de Louis XV […]."
                                            },
                                            {
                                                "example_id": "bff06137-f2d7-4214-a470-dc305431d7ad",
                                                "sense_id": "6c127e1e-d305-33b8-848e-ee6bef09404b",
                                                "text": "Qu’importe qu’elle soit titrée duchesse ou qu’elle soit simple demoiselle, à partir de l’instant où la favorite fait comprendre aux courtisans son pouvoir sur le roi, elle acquière une position solide à la cour, dans l’esprit de ses membres, bien qu’elle peut la perdre du jour au lendemain sur un caprice du roi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbe4f46a-373b-3409-9fb8-d5a9428bbac0",
                                        "entry_id": "1c528083-ab3b-33b3-b87c-8f8af0c85af4",
                                        "glosses": [
                                            "Celle dont la majorité des gens prévoient la victoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc6d350-ad54-4082-9818-0efe126d4cba",
                                                "sense_id": "cbe4f46a-373b-3409-9fb8-d5a9428bbac0",
                                                "text": "La Francilienne de 28 ans, installée au Texas, assume l’étiquette de favorite, qu’elle doit aussi à son incontestable rang de nᵒ 1 tricolore."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "favorite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba50fcdc-4d34-3d56-bb5d-75699919e30d",
                                        "entry_id": "747f3920-b250-3f0f-b059-7690dd6cfbc8",
                                        "glosses": [
                                            "Féminin singulier de favori."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e637ae6-1570-4252-af7a-6e49e78ae54b",
                                                "sense_id": "ba50fcdc-4d34-3d56-bb5d-75699919e30d",
                                                "text": "[…], et le pauvre roi Charles VI passait, assure-t-on, des journées entières à entamer de parties de Bataille avec sa favorite, la « petite reine » Odette de Champdivers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40fa708f-9c15-4ed9-ae3e-f1174a12055a",
                        "source_entry_id": "c61d1fee-d31f-3c4a-938b-da4661e082f1",
                        "source_sense_id": "7f1d14f5-d87e-3e96-8678-c00673215c15",
                        "source_sense_description": "weibliche Person, die von jemandem bevorzugt wird",
                        "target_lang_word": "фаворитка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фаворитка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4b17aedc-6bb0-34b7-8731-e5cd0ca83581",
                                        "entry_id": "ddac1cd6-b713-3941-afeb-1a7bc42144e3",
                                        "glosses": [
                                            "женск. к фаворит"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f9880c-1c41-4b14-b230-28b16d371de9",
                                                "sense_id": "4b17aedc-6bb0-34b7-8731-e5cd0ca83581",
                                                "text": "Пульхерия Ивановна тотчас приказала подать ей молока и мяса и, сидя перед нею, наслаждалась жадностию бедной своей фаворитки, с какою она глотала кусок за куском и хлебала молоко."
                                            },
                                            {
                                                "example_id": "5d0a25e3-b113-48d8-a55b-0566d45e6e40",
                                                "sense_id": "4b17aedc-6bb0-34b7-8731-e5cd0ca83581",
                                                "text": "И она слабою рукою прижимала нас к груди своей; но в особенности меня целовала она горячо, называла своею милою дочерью, фавориткой и просила не забывать своей матери."
                                            },
                                            {
                                                "example_id": "f8d48421-055f-41b1-a0be-355eb7656654",
                                                "sense_id": "4b17aedc-6bb0-34b7-8731-e5cd0ca83581",
                                                "text": "Говорили, что ревнивый старик, помещая к Морозовой свою «фаворитку», имел первоначально в виду зоркий глаз старухи, чтобы наблюдать за поведением новой жилицы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
