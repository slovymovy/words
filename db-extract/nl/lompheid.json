                "entry_id": "9384e75a-c3ee-3b8a-90d6-68473497a716",
                "word": "lompheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "e184d314-9b56-405f-b47a-3d462eb64ba0",
                        "entry_id": "9384e75a-c3ee-3b8a-90d6-68473497a716",
                        "tags": [
                            "plural"
                        ],
                        "form": "lompheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f85fa63-5a3d-303c-bb97-0215f724e90c",
                        "entry_id": "9384e75a-c3ee-3b8a-90d6-68473497a716",
                        "glosses": [
                            "grove onbeleefdheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35924b0-772d-4714-a397-68e08ea81490",
                                "sense_id": "8f85fa63-5a3d-303c-bb97-0215f724e90c",
                                "text": "En zo voelt het ook voor de hoofdpersoon van de roman De meisjes waarmee de jonge Amerikaanse schrijfster Emma Cline dezer dagen furore maakt. Het gaat over een meisje dat van haar moeder leerde dat je pijn over routineuze lompheid hoort te verbijten „met beschaafd gedrag\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecf289b3-db40-3b92-8290-993e616902a2",
                        "entry_id": "9384e75a-c3ee-3b8a-90d6-68473497a716",
                        "glosses": [
                            "domheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0702f806-8c40-4fe4-b2ca-9178879274f6",
                                "sense_id": "ecf289b3-db40-3b92-8290-993e616902a2",
                                "text": "„Op sommige punten is het einde van de beschaving nabij. De boertigheid en de lompheid hebben dit jaar vrij spel gehad. Het grove taalgebruik is in de politiek en de rest van Nederland geaccepteerd en wordt vrij toegepast.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf09e59e-a863-4ba6-9f9c-d872549a40b7",
                        "source_entry_id": "9384e75a-c3ee-3b8a-90d6-68473497a716",
                        "source_sense_id": "8f85fa63-5a3d-303c-bb97-0215f724e90c",
                        "source_sense_description": "grove onbeleefdheid",
                        "target_lang_word": "rudeness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudeness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                                        "glosses": [
                                            "The property of being rude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42eb88f4-086a-4f56-b6fa-59ec8f692701",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "His rudeness was inexcusable."
                                            },
                                            {
                                                "example_id": "46cde39f-45b4-4e68-9e66-24bd843d8d29",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The rudeness of the cabin gave it a rustic charm but little comfort."
                                            },
                                            {
                                                "example_id": "e833ba91-26f7-4879-87c3-1d4c4a3e8e16",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The house was apparently very old; it had an almost prehistoric look about it, so rude and weatherbeaten was it, but the rudeness of the masonry and the lichening of the stones were no real indications of antiquity […]"
                                            },
                                            {
                                                "example_id": "e4afbf98-c900-4029-988c-7bdc0b17f05e",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The woman who deliberately yelled out in the second set, when Henin was about to serve at 5-3 for the championship, was the epitome of the absolute self-centered rudeness that was exhibited at the Open, as well as in our society today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                                        "glosses": [
                                            "A rude remark or behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0c48072-9ab4-4cfb-884d-38226ad61fea",
                                                "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                                "text": "I'm sick of his rudenesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
