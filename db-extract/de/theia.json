                "senses": [
                    {
                        "sense_id": "d7124c87-3f43-3f6f-aec9-cc30c23aae96",
                        "entry_id": "f0750201-9173-3066-a770-d80489e96dcf",
                        "glosses": [
                            "eine Titanin"
                        ],
                        "tags": [
                            "griechische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e7c58601-b613-4b1c-9a1a-42ff93669da0",
                                "sense_id": "d7124c87-3f43-3f6f-aec9-cc30c23aae96",
                                "text": "Selene, die Göttin des Mondes, ist die Tochter des Hyperion und der Theia."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "66d4f126-9cef-3bc7-9353-a8edfec91ced",
                        "entry_id": "f0750201-9173-3066-a770-d80489e96dcf",
                        "glosses": [
                            "inoffizieller Name eines hypothetischen Protoplaneten unseres Sonnensystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d039ee55-a638-433c-be3b-31bdf19971ee",
                                "sense_id": "66d4f126-9cef-3bc7-9353-a8edfec91ced",
                                "text": "„Theia entstand offenbar im gleichen Abstand von der Sonne wie die Protoerde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d2694b8-13fa-4c56-98ba-4c301330f4d1",
                        "source_entry_id": "f0750201-9173-3066-a770-d80489e96dcf",
                        "source_sense_id": "d7124c87-3f43-3f6f-aec9-cc30c23aae96",
                        "source_sense_description": "griechische Mythologie: eine Titanin",
                        "target_lang_word": "Theia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af90c228-58e8-3292-a220-0d783088e95f",
                                        "entry_id": "ab119de0-3390-3d9e-9a68-8228986d8f18",
                                        "glosses": [
                                            "A Titan, the sister-wife of Hyperion."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5df433ec-1dd8-381e-9495-bc645ba8d8fc",
                                        "entry_id": "ab119de0-3390-3d9e-9a68-8228986d8f18",
                                        "glosses": [
                                            "An Oceanid nymph (daughter of Oceanus and Tethys), the mother of the Cercopes by Oceanus."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3780c1e4-389f-3794-aaf8-296abb9cfed2",
                                        "entry_id": "ab119de0-3390-3d9e-9a68-8228986d8f18",
                                        "glosses": [
                                            "A hypothesised Mars-sized planet of the early solar system thought to have collided with the Earth to produce the Moon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68774574-891f-4f4a-8721-630ea71a4fd4",
                                                "sense_id": "3780c1e4-389f-3794-aaf8-296abb9cfed2",
                                                "text": "According to the reigning hypothesis, about 4.5 billion years ago, shortly after Earth had accreted down into a sphere from its little slub of circumsolar material, another newborn planet, still shaky on its feet, slammed obliquely into Earth with terrifying force. That \"giant impactor\", named Theia, who in Greek mythology was mother to the goddess of the moon, is thought to have been roughly the size of Mars and to have been pulverized in the encounter, along with a good chunk of the proto-Earth. From that fiery cloud of all-Theia and part-Earth, the scenario goes, our moon soon condensed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a0ec13e-f8c2-4698-b0ee-33bd287745cf",
                        "source_entry_id": "f0750201-9173-3066-a770-d80489e96dcf",
                        "source_sense_id": "d7124c87-3f43-3f6f-aec9-cc30c23aae96",
