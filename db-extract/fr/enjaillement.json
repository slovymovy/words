                        "examples": [
                            {
                                "example_id": "ef61bf1c-811a-4a29-add0-7aa3ac33b480",
                                "sense_id": "d0f9a7ce-c20e-3f6e-82ad-0275a4c86974",
                                "text": "Étape bien fréquentée par les petits fonctionnaires en déplacement professionnel, avec l’enjaillement nocturne d'un cabaret tapageur."
                            },
                            {
                                "example_id": "cca793d8-7e1f-4ffc-ab6d-b82247ae5246",
                                "sense_id": "d0f9a7ce-c20e-3f6e-82ad-0275a4c86974",
                                "text": "Ce fut un grand enjaillement (fête) comme seuls savent le faire les singes. Au désespoir des hommes, et fidèle a leurs habitudes, ils ravagèrent des plantations entières."
                            },
                            {
                                "example_id": "41625a14-5917-4659-99b0-d37dea79cd47",
                                "sense_id": "d0f9a7ce-c20e-3f6e-82ad-0275a4c86974",
                                "text": "Elle consiste selon les propos des enfants de la rue en « des mots de passe, des cris d’enjaillement, c'est-à-dire de jouissance et d'encouragement »."
                            }
                        ]
                    }
