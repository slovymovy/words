                                        "sense_id": "530ed46a-d712-32d8-9006-e1fefa7c1e05",
                                        "entry_id": "4128d331-ca18-368c-926b-0f69dd5bc716",
                                        "glosses": [
                                            "Sexual excitement."
                                        ],
