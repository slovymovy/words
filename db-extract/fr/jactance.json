            {
                "entry_id": "5f78d38c-46c1-33c2-a09a-f2de3ed75bc3",
                "word": "jactance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1eb554fa-f211-3c3d-96ec-48750784cac1",
                        "entry_id": "5f78d38c-46c1-33c2-a09a-f2de3ed75bc3",
                        "glosses": [
                            "Bavardage."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fd5736d1-fe64-4461-a93f-739d70d9fe84",
                                "sense_id": "1eb554fa-f211-3c3d-96ec-48750784cac1",
                                "text": "— Mais qu’est devenue cette belle haine du sexe que vous affichiez tout à l’heure avec tant de jactance ? Il a suffi du premier minois pour la mettre en déroute."
                            },
                            {
                                "example_id": "f603922e-ed6c-481f-99e1-addeba54fbc3",
                                "sense_id": "1eb554fa-f211-3c3d-96ec-48750784cac1",
                                "text": "Les critiques les plus honnêtes se laissent aller à leur jactance secrète."
                            },
                            {
                                "example_id": "7383f9cc-a77d-4df6-97a4-a08d05083a14",
                                "sense_id": "1eb554fa-f211-3c3d-96ec-48750784cac1",
                                "text": "Le baveux, c’est tout dans la jactance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "596ad255-201b-46d2-aa71-7f7246d8fc98",
                        "source_entry_id": "5f78d38c-46c1-33c2-a09a-f2de3ed75bc3",
                        "source_sense_id": "1eb554fa-f211-3c3d-96ec-48750784cac1",
                        "target_lang_word": "Kaffeeklatsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaffeeklatsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4c88c1a-5bd4-35b0-8b8a-70761db47322",
                                        "entry_id": "3398f7fc-48ba-326d-a931-3b1534c3b507",
                                        "glosses": [
                                            "gemütliche Gesprächsrunde, bei der meist Kaffee getrunken und Kuchen gegessen wird"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ca98d5-5b85-41b3-9d4b-64a2487b0de3",
                                                "sense_id": "a4c88c1a-5bd4-35b0-8b8a-70761db47322",
                                                "text": "Während du noch beim Kaffeeklatsch sitzt, hab ich meine Arbeit schon erledigt!"
                                            },
                                            {
                                                "example_id": "69b83fff-e851-432f-b330-8123af640608",
                                                "sense_id": "a4c88c1a-5bd4-35b0-8b8a-70761db47322",
                                                "text": "„Der Besuch der Hebamme gibt Anlaß zu einem Kaffeeklatsch.“"
                                            },
                                            {
                                                "example_id": "1faee502-d194-46a4-9ab7-55e9b231d34d",
                                                "sense_id": "a4c88c1a-5bd4-35b0-8b8a-70761db47322",
                                                "text": "„[…] sie unternahmen Dinge zusammen, veranstalteten Kaffeeklatsche oder Abendessen, gingen zu Konzerten, besuchten Töpferkurse.“"
                                            },
                                            {
                                                "example_id": "640407a5-96e5-4c4c-8ae8-3ed851dd4627",
                                                "sense_id": "a4c88c1a-5bd4-35b0-8b8a-70761db47322",
                                                "text": "„Die kleinen Teller und Löffel erinnerten Anna an das Spielzeuggeschirr, mit dem sie als Kind gespielt hatte, an die Teepartys und Kaffeeklatsche, die sie für ihren Damenzirkel aus Plüschtieren veranstaltet hatte.“"
                                            },
                                            {
                                                "example_id": "af368c25-58fd-4f26-b917-86f1204fd172",
                                                "sense_id": "a4c88c1a-5bd4-35b0-8b8a-70761db47322",
                                                "text": "„Dass, um nur den Raum zu füllen, die unbedeutendsten Vorgänge aus dem geselligen Leben — Kaffeeklatsche, Abendgesellschaften, Familienfeste, zu ‚socialen Neuigkeiten‘ aufgebauscht, die Kleider aller dabei anwesenden Frauen und Mädchen in allen Einzelheiten geschildert werden und dadurch jener abscheuliche Wetteifer des Weibsvolks in der Jagd nach Putz und Tand angespornt wird, der alljährlich in Amerika mehr Männer in die Zuchthäuser bringt, als der Branntwein.“"
                                            },
                                            {
                                                "example_id": "d06cc84b-409e-48e8-b82a-68aa2f9a46aa",
                                                "sense_id": "a4c88c1a-5bd4-35b0-8b8a-70761db47322",
                                                "text": "„Hier hat die verstorbene Frau Landrichterin ihre berühmten Kaffeeklatsche gehalten, dachte sie, indem sie ein saalartiges düsteres Zimmer durchschritt.“"
                                            },
                                            {
                                                "example_id": "e07597db-e222-4bae-8907-e87ed7cfc83e",
                                                "sense_id": "a4c88c1a-5bd4-35b0-8b8a-70761db47322",
                                                "text": "„Daß die Tante Alles ausgeplaudert hat, und daß mein Fasco ein beliebter Conversationsgegenstand bei allen ‚Kaffeeklatschen‘ ist, davon bin ich, wie gesagt, überzeugt; allein was schadet das eigentlich – ich verachte diese Kaffeeschwestern, und überhaupt verlasse ich in acht Tagen das Bad Söderköping.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
