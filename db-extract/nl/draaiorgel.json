                                                "sense_id": "6d551108-5df3-3d09-b082-28ec8aef78fd",
                                                "text": "Das ist eine Drehorgel."
                                            },
                                            {
                                                "example_id": "35d6981f-5425-4851-92eb-5dbfded6f8bb",
                                                "sense_id": "6d551108-5df3-3d09-b082-28ec8aef78fd",
