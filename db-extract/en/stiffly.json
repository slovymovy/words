                                    },
                                    {
                                        "sense_id": "533f0441-1e98-3611-8bb3-a8c829a914cb",
                                        "entry_id": "448eb42a-b8db-31a5-befc-464cce86d37a",
                                        "glosses": [
                                            "Strictement."
                                        ],
