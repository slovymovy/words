                                        "glosses": [
                                            "The protective wire mask at the front of a helmet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea02a064-f8e8-394a-825a-a9fc7ee08ef6",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "A regular graph that has as few vertices as possible for its girth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a30319d9-71e3-31a9-b257-3c4bea482c45",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
