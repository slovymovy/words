{
    "word_family": [
        "apprehend",
        "apprehensible",
        "apprehensive",
        "misapprehend",
        "misapprehension"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d6e8a1a-182e-38b7-a38c-e6db858e5507",
                    "sense_definition": "Anxiety or fear that something bad or unpleasant will happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fear_and_anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden wave of <w>apprehension</w> as she walked into the dark, empty building.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапную волну <w>тревоги</w>, когда вошла в темное пустое здание."
                            }
                        },
                        {
                            "text": "Despite her growing <w>apprehension</w>, she decided to go ahead with the presentation.",
                            "target_lang_translations": {
                                "ru": "Несмотря на растущее <w>опасение</w>, она решила продолжить презентацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "alarm",
                        "misgiving",
                        "qualm",
                        "trepidation"
                    ],
                    "common_phrases": [
                        "growing apprehension",
                        "feeling of apprehension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тревога или страх перед тем, что произойдет что-то плохое или неприятное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опасе́ние",
                                "target_lang_sense_clarification": "чувство тревоги или предчувствие опасности"
                            },
                            {
                                "target_lang_word": "предчу́вствие",
                                "target_lang_sense_clarification": "обычно дурное предчувствие чего-то неприятного"
                            },
                            {
                                "target_lang_word": "трево́га",
                                "target_lang_sense_clarification": "беспокойство о будущем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52418ebe-07cf-38eb-bb9c-c50c28a932ab",
                    "sense_definition": "The act of arresting someone, especially by the police.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_arrest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police issued a statement following the successful <w>apprehension</w> of the suspect.",
                            "target_lang_translations": {
                                "ru": "Полиция сделала заявление после успешного <w>задержания</w> подозреваемого."
                            }
                        },
                        {
                            "text": "A large reward was offered for the suspect's <w>apprehension</w> after the robbery.",
                            "target_lang_translations": {
                                "ru": "За <w>поимку</w> подозреваемого после ограбления было предложено крупное вознаграждение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apprehension of the suspect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт ареста кого-либо, особенно полицией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задержа́ние",
                                "target_lang_sense_clarification": "официальное взятие под стражу полицией"
                            },
                            {
                                "target_lang_word": "аре́ст",
                                "target_lang_sense_clarification": "заключение под стражу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15e2a543-7a83-3d3b-9daf-d214fb5dc049",
                    "sense_definition": "The cognitive faculty or act of understanding and grasping ideas.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex philosophical concept was far beyond his limited <w>apprehension</w>.",
                            "target_lang_translations": {
                                "ru": "Сложная философская концепция была далеко за пределами его ограниченного <w>понимания</w>."
                            }
                        },
                        {
                            "text": "She has a quick <w>apprehension</w> of difficult mathematical theories.",
                            "target_lang_translations": {
                                "ru": "Она быстро <w>схватывает</w> сложные математические теории."
                            }
                        }
                    ],
                    "synonyms": [
                        "awareness",
                        "sense"
                    ],
                    "antonyms": [
                        "inapprehension"
                    ],
                    "common_phrases": [
                        "beyond his apprehension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Познавательная способность или акт понимания и усвоения идей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понима́ние",
                                "target_lang_sense_clarification": "способность осознавать и усваивать идеи"
                            },
                            {
                                "target_lang_word": "постиже́ние",
                                "target_lang_sense_clarification": "глубокое понимание или осознание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48ea1531-d8cf-3eed-9a77-fed606a13358",
                    "sense_definition": "Perception or understanding of something using one's intellect without passing judgment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We live on, and in living we lose the intellectual <w>apprehension</w> of life.",
                            "target_lang_translations": {
                                "ru": "Мы живем дальше, и в процессе жизни теряем интеллектуальное <w>осмысление</w> жизни."
                            }
                        },
                        {
                            "text": "His immediate <w>apprehension</w> of the situation allowed him to react without hesitation.",
                            "target_lang_translations": {
                                "ru": "Его мгновенное <w>восприятие</w> ситуации позволило ему среагировать без колебаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "awareness",
                        "sense"
                    ],
                    "antonyms": [
                        "inapprehension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восприятие или понимание чего-либо умом без вынесения суждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмысле́ние",
                                "target_lang_sense_clarification": "процесс интеллектуального осознания"
                            },
                            {
                                "target_lang_word": "восприя́тие",
                                "target_lang_sense_clarification": "интеллектуальное схватывание сути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f083a58f-f8e9-36de-9aae-a5fe76158748",
                    "sense_definition": "An opinion, conception, or idea about something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We think we get a vague <w>apprehension</w> of what the city means from the top of a bus.",
                            "target_lang_translations": {
                                "ru": "Нам кажется, что с крыши автобуса мы получаем смутное <w>представление</w> о том, что представляет собой этот город."
                            }
                        },
                        {
                            "text": "Her personal <w>apprehension</w> of the matter differed greatly from the official report.",
                            "target_lang_translations": {
                                "ru": "Ее личное <w>видение</w> этого вопроса сильно отличалось от официального отчета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vague apprehension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мнение, концепция или представление о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представле́ние",
                                "target_lang_sense_clarification": "идея или понимание чего-либо"
                            },
                            {
                                "target_lang_word": "мне́ние",
                                "target_lang_sense_clarification": "суждение или точка зрения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "551bf0a7-8813-3c05-bab4-44e0ff13f498",
                    "sense_definition": "The physical act of seizing or taking hold of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_seizure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird's talons are perfectly adapted for the <w>apprehension</w> of prey on the ground.",
                            "target_lang_translations": {
                                "ru": "Когти птицы идеально приспособлены для <w>захвата</w> добычи на земле."
                            }
                        },
                        {
                            "text": "The physical <w>apprehension</w> of the object proved difficult due to its slippery surface.",
                            "target_lang_translations": {
                                "ru": "Физическое <w>удержание</w> предмета оказалось затруднительным из-за его скользкой поверхности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apprehension of an object"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический акт захвата или удержания чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвата́ние",
                                "target_lang_sense_clarification": "физический захват или удержание"
                            },
                            {
                                "target_lang_word": "захва́т",
                                "target_lang_sense_clarification": "физическое овладение объектом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}