            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c72af48-bd78-39e3-8a9b-5075ff31152f",
                    "sense_definition": "Déflagration soudaine et violente accompagnée de bruit, de flammes ou d'un souffle puissant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "detonation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers sont intervenus rapidement après la puissante <w>explosion</w> de gaz dans l'immeuble."
                        },
                        {
                            "text": "Le bruit de l'<w>explosion</w> a réveillé tous les habitants du quartier en pleine nuit."
                        }
                    ],
                    "synonyms": [
                        "déflagration"
                    ],
                    "antonyms": [
                        "implosion"
                    ],
                    "common_phrases": [
                        "puissante explosion",
                        "risque d explosion"
                    ]
                },
                {
                    "sense_id": "20593d63-4e3c-3eaf-aca8-3516c4cd8e00",
                    "sense_definition": "Éclatement brutal d'un récipient ou d'un mécanisme causé par une pression interne excessive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chaudière trop ancienne a cédé et provoqué une violente <w>explosion</w> dans l'atelier."
                        },
                        {
                            "text": "Le développement du moteur à <w>explosion</w> a profondément bouleversé les transports au vingtième siècle."
                        }
                    ],
                    "common_phrases": [
                        "moteur à explosion"
                    ]
                },
                {
                    "sense_id": "27f1170e-5081-3e68-92b0-07a47a8e9c7b",
                    "sense_definition": "Manifestation soudaine, spontanée et très vive d'un sentiment, d'une émotion ou d'une réaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coup de sifflet final a déclenché une immense <w>explosion</w> de joie parmi les supporters."
                        },
                        {
                            "text": "L'annonce des nouvelles mesures a provoqué une soudaine <w>explosion</w> de colère dans la foule."
                        }
                    ],
                    "common_phrases": [
                        "explosion de joie",
                        "explosion de colère"
                    ]
                },
                {
                    "sense_id": "d3126a1f-7c48-303f-891d-de6715208314",
                    "sense_definition": "Accroissement ou développement extrêmement rapide, massif et spectaculaire d'un phénomène.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hausse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite ville a connu une formidable <w>explosion</w> démographique après l'ouverture de la mine."
                        },
                        {
                            "text": "Le développement du commerce électronique a entraîné une véritable <w>explosion</w> des ventes en ligne."
                        }
                    ],
                    "synonyms": [
                        "boom"
                    ],
                    "common_phrases": [
                        "explosion démographique"
                    ]
                }
            ]
        }
