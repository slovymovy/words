                                        "entry_id": "02890f90-bdc2-3e55-9ded-16517217efce",
                                        "glosses": [
                                            "коллектив редакторов, группа работников издательства, студии и т. п., занимающихся подготовкой текста"
                                        ],
                                        "tags": [],
