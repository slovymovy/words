{
    "word_family": [
        "buzz",
        "buzzer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b2acdc50-f333-33a9-ae0d-9fed7eca2db5",
                    "sense_definition": "Slightly intoxicated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After two glasses of wine, he felt a bit <w>buzzed</w> and happy.",
                            "target_lang_translations": {
                                "cs": "Po dvou skleničkách vína se cítil trochu <w>podnapilý</w> a šťastný."
                            }
                        },
                        {
                            "text": "The party guests were feeling <w>buzzed</w> after the champagne toast.",
                            "target_lang_translations": {
                                "cs": "Hosté na večírku se po přípitku šampaňským cítili <w>v náladě</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tipsy",
                        "merry"
                    ],
                    "common_phrases": [
                        "feeling buzzed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mírně podnapilý, v náladě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podnapilý",
                                "target_lang_sense_clarification": "stav mírné opilosti"
                            },
                            {
                                "target_lang_word": "v náladě",
                                "target_lang_sense_clarification": "hovorový výraz pro veselou náladu po alkoholu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0587cce5-b4c9-3742-b739-d0eefb06b4aa",
                    "sense_definition": "Describing lips that are slightly parted to produce a buzzing sound when air is forced through them.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musical_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trumpet player uses <w>buzzed</w> lips to create the initial vibration.",
                            "target_lang_translations": {
                                "cs": "Hráč na trubku používá <w>vibrující</w> rty k vytvoření počáteční vibrace."
                            }
                        },
                        {
                            "text": "Proper technique requires <w>buzzed</w> lips against the mouthpiece of the instrument.",
                            "target_lang_translations": {
                                "cs": "Správná technika vyžaduje <w>vibrující</w> rty přitisknuté k nátrubku nástroje."
                            }
                        }
                    ],
                    "common_phrases": [
                        "buzzed lips"
                    ],
                    "target_lang_definitions": {
                        "cs": "Popisující rty, které jsou mírně pootevřené a vibrují při průchodu vzduchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vibrující",
                                "target_lang_sense_clarification": "v kontextu techniky hry na dechové nástroje"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d49fe3a-5f76-375c-ab47-dc746e4d90c9",
                    "sense_definition": "Simple past and past participle of <w>buzz</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The alarm clock <w>buzzed</w> loudly at seven in the morning.",
                            "target_lang_translations": {
                                "cs": "Budík v sedm ráno hlasitě <w>bzučel</w>."
                            }
                        },
                        {
                            "text": "The doorbell <w>buzzed</w> twice before someone finally opened the door.",
                            "target_lang_translations": {
                                "cs": "Domovní zvonek dvakrát <w>zazvonil</w>, než někdo konečně otevřel dveře."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé od slovesa bzučet."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bzučel",
                                "target_lang_sense_clarification": "minulý čas slovesa bzučet"
                            },
                            {
                                "target_lang_word": "zazvonil",
                                "target_lang_sense_clarification": "v kontextu elektrického zvonku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}