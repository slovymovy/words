                "senses": [
                    {
                        "sense_id": "a8c04dfe-f642-3e2e-988d-67a845207740",
                        "entry_id": "3caa4779-0e50-37a8-b12f-a1e6f5c79da4",
                        "glosses": [
                            "Bewegungsschema eines Dirigenten, um die verschiedenen Zählzeiten eines Taktes durch Taktieren anzuzeigen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "75135d14-4f87-4a58-8bf4-8df582753bb3",
                                "sense_id": "a8c04dfe-f642-3e2e-988d-67a845207740",
                                "text": "Schlagfiguren bilden den Grundstein der musikalischen Kommunikation zwischen Dirigenten und Orchestermusikern."
                            },
                            {
                                "example_id": "d9bfadfa-df3c-44c1-9aac-024d9f141cbf",
                                "sense_id": "a8c04dfe-f642-3e2e-988d-67a845207740",
                                "text": "Eine Phrase nach seinen eigenen Vorstellungen als Dirigent anzuzeigen, erfordert die Beherrschung der grundlegenden Schlagfiguren und absolute Flexibilität in der Ausführung der Dirigierbewegungen."
                            },
                            {
                                "example_id": "00f65947-e0a4-4166-954a-62a8d6a1afed",
                                "sense_id": "a8c04dfe-f642-3e2e-988d-67a845207740",
                                "text": "Die Schlagfiguren dienen dazu, daß die Gemeinde beim Singen im Takt gehalten und der Ausdruck des Liedes vermittelt wird."
                            },
                            {
                                "example_id": "2fc53925-8538-4e85-9284-9bbbd0a87ec4",
                                "sense_id": "a8c04dfe-f642-3e2e-988d-67a845207740",
                                "text": "Traditionsgemäß hält die rechte Hand des Dirigenten den Taktstock und führt die Schlagfiguren aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
