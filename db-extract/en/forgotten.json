                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d13ab9e-8e9c-4b07-bbc9-1df35219ac46",
                                                "sense_id": "887eb20c-404c-3d4f-a96f-518a942f037b",
                                                "text": "In veel landen leven mensen niet in vrijheid. In Nederland leven we wel in vrijheid. We moeten niet vergeten dat dat belangrijk en bijzonder is. Daarom zijn er heel het jaar herdenkingen."
                                            },
                                            {
                                                "example_id": "beb52723-8165-4c18-998d-1c23bcf0a4ea",
                                                "sense_id": "887eb20c-404c-3d4f-a96f-518a942f037b",
                                                "text": "` Welke plek noemde jij thuis voordat je hier kwam?'\n`De woestijn,' zei hij. 'Maar meneer Montebello heeft ervoor gezorgd dat ik de woestijn ben vergeten. Ik ben hem daar dankbaar voor.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "540c94e7-97fa-326f-8bb9-2e3337394f30",
                                        "entry_id": "3781c76e-c261-3afe-8cab-37cd465aa2b5",
                                        "glosses": [
                                            "niet gedaan hebben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e633e6e9-8c6f-4b67-a7c0-ec152eb4f802",
                                                "sense_id": "540c94e7-97fa-326f-8bb9-2e3337394f30",
                                                "text": "Hij was vergeten om het pak melk te halen uit de supermarkt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb65b257-84da-4ffc-b455-a0dff159f33b",
                        "source_entry_id": "c6b509cd-0aac-3c3d-b272-0322d0b81513",
                        "source_sense_id": "e993654d-0afe-3225-b86a-6db971c8c660",
