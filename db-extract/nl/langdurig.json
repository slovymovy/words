                ],
                "senses": [
                    {
                        "sense_id": "9953fff6-1e84-3540-abf9-96a8ce2ae9f4",
                        "entry_id": "16984814-397c-3652-b8eb-cc27a75b05bc",
                        "glosses": [
                            "een lange tijd durend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c1ad95-ac21-4dc6-bb42-cbe5d2233751",
                                "sense_id": "9953fff6-1e84-3540-abf9-96a8ce2ae9f4",
                                "text": "Het was een langdurige periode van regenval."
                            },
                            {
                                "example_id": "dc757322-087f-47ea-8ee8-87ce32bc4fde",
                                "sense_id": "9953fff6-1e84-3540-abf9-96a8ce2ae9f4",
                                "text": "Toen ik zei dat ik helaas nog niet wist hoelang ik van plan was te blijven en dat ik hoopte dat dat geen probleem zou zijn, wuifde hij mijn zorgen weg met een elegant handgebaar en bezwoer hij mij dat het een eer was voor het etablissement en een persoonlijk genoegen voor hemzelf om mij als gast te mogen beschouwen en dat hij alleen maar kon wensen dat deze vreugde langdurig zou mogen zijn."
                            },
                            {
                                "example_id": "2eef8096-d8e9-46d4-ac46-c08253276d9e",
                                "sense_id": "9953fff6-1e84-3540-abf9-96a8ce2ae9f4",
                                "text": "Natuurlijk had ik ook tot mijn pensioen kunnen wachten, maar ik wilde het nu. Het idee om een lange tijd alleen door te brengen trok mij enorm aan, maar vond ik tegelijkertijd doodeng omdat ik geen ervaring had met langdurig alleen zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab588206-7006-32cb-a93d-873fcc2f3962",
                        "entry_id": "16984814-397c-3652-b8eb-cc27a75b05bc",
                        "glosses": [
                            "een lange tijd geldig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5bd1fbf-fcee-4dcb-9264-56ab55faea17",
                                "sense_id": "ab588206-7006-32cb-a93d-873fcc2f3962",
                                "text": "De Franse oud-president Hollande riep vorige maand op Amerikaanse onderzoekers zo snel mogelijk langdurige visa te verlenen. Volgens hem is dat ook nodig omdat overal landen nu proberen Amerikaans toptalent binnen te halen. \"We moeten snel zijn\", aldus Hollande."
                            }
                        ]
                    }
