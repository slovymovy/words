                    {
                        "sense_id": "e4d43dc3-78de-3c7d-8c5e-c40524bf0973",
                        "entry_id": "ad00e97f-607c-30aa-a8d6-f95496d3efcc",
                        "glosses": [
                            "dam"
                        ],
                        "tags": [
                            "not-comparable",
