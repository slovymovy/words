    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88af3909-82cd-381e-b42b-0a37e8f2d92e",
                    "sense_definition": "Fonction syntaxique d'un mot ou d'un groupe de mots qui exprime une qualité ou une propriété du sujet ou de l'objet par l'intermédiaire d'un verbe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette phrase, le mot calme est l'<w>attribut</w> du sujet après le verbe être."
                        },
                        {
                            "text": "Le professeur explique la différence entre une épithète et un <w>attribut</w>."
                        }
                    ],
                    "common_phrases": [
                        "attribut du sujet",
                        "attribut du complément d'objet"
                    ]
                },
                {
                    "sense_id": "ff671a12-0f9d-39a5-924c-62a5ea72076b",
                    "sense_definition": "Ce qui est propre, essentiel ou particulier à un être ou à une chose ; caractéristique distinctive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propriete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La patience est souvent considérée comme un <w>attribut</w> indispensable des grands scientifiques."
                        },
                        {
                            "text": "Chaque espèce vivante possède des <w>attributs</w> physiques adaptés à son milieu naturel."
                        }
                    ],
                    "synonyms": [
                        "caractéristique",
                        "propriété",
                        "qualité",
                        "trait"
                    ],
                    "common_phrases": [
                        "attribut essentiel",
                        "attribut naturel"
                    ]
                },
                {
                    "sense_id": "16861deb-e1e6-3a06-89fc-3b6fdee134ce",
                    "sense_definition": "Objet symbolique ou emblème qui caractérise une figure mythologique, un saint ou une allégorie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "symbole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la mythologie romaine, le trident constitue le principal <w>attribut</w> du dieu Neptune."
                        },
                        {
                            "text": "La balance et le glaive sont les <w>attributs</w> traditionnels de la Justice."
                        }
                    ],
                    "synonyms": [
                        "emblème",
                        "symbole"
                    ]
                },
                {
                    "sense_id": "a9c46e88-291d-3a29-82d5-db7d8018100b",
                    "sense_definition": "Donnée ou variable associée à un objet ou à un élément pour en définir les propriétés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En programmation orientée objet, une classe peut comporter plusieurs <w>attributs</w>."
                        },
                        {
                            "text": "Cette balise HTML nécessite un <w>attribut</w> particulier pour afficher l'image correctement."
                        }
                    ],
                    "synonyms": [
                        "propriété"
                    ],
                    "common_phrases": [
                        "attribut de classe"
                    ]
                },
                {
                    "sense_id": "e5029a4e-b880-3f4f-8300-3a44ebf1866b",
                    "sense_definition": "Organes génitaux, principalement masculins.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est sorti de la douche en cachant maladroitement ses <w>attributs</w> avec une serviette."
                        },
                        {
                            "text": "Cette statue antique mettait clairement en valeur les <w>attributs</w> virils du héros."
                        }
                    ],
                    "common_phrases": [
                        "attributs masculins"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé par euphémisme"
                        }
                    ]
                }
            ]
        }
    ]
