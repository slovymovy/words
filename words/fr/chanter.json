            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ec7e728-e77f-3cc2-804a-eca0fb85f5d4",
                    "sense_definition": "Moduler sa voix pour produire des sons musicaux ou exécuter une chanson.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle aime <w>chanter</w> sous la douche tous les matins avant de partir."
                        },
                        {
                            "text": "Les enfants <w>chantent</w> une chanson joyeuse dans la cour de récréation."
                        }
                    ],
                    "synonyms": [
                        "vocaliser"
                    ],
                    "common_phrases": [
                        "chanter une chanson",
                        "chanter juste",
                        "chanter faux"
                    ]
                },
                {
                    "sense_id": "10b41eac-0467-323a-94b1-f03edbb488ad",
                    "sense_definition": "Émettre le cri mélodieux propre à son espèce, en parlant d'oiseaux ou d'insectes.",
