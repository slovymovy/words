                ],
                "senses": [
                    {
                        "sense_id": "74435b01-e755-3e2d-ab63-a53dca19e17e",
                        "entry_id": "b8b01742-17ea-3d6d-98ad-5e2673a9d7ce",
                        "glosses": [
                            "Alternative form of gestaltist."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "27bb0b8a-6e30-41c2-96b8-3b5ee7b720cb",
                                "sense_id": "74435b01-e755-3e2d-ab63-a53dca19e17e",
                                "text": "The Gestaltists did not say that patterns of electrochemical brain activity are the same as patterns of perceptual activity. Rather, they said that perceptual fields are always caused by underlying patterns of brain activity."
                            },
                            {
                                "example_id": "5ce5e70b-50e5-4a0a-b72e-8f1022e24235",
                                "sense_id": "74435b01-e755-3e2d-ab63-a53dca19e17e",
                                "text": "For the Gestaltist, thinking was not a reproductive recombination of learned associations but the meaningful effort to understand the fundamental nature and affordances of the given problem situation and the desired goal as a whole."
                            },
                            {
                                "example_id": "ae42a229-4aa1-4234-8a42-d31aed31da00",
                                "sense_id": "74435b01-e755-3e2d-ab63-a53dca19e17e",
                                "text": "The Gestaltist will use a variety of techniques to keep this focus. The Gestaltist might begin by asking a person, “What is your now?” or “What are you feeling right now?” The focus is always now."
                            }
                        ]
                    }
                ],
