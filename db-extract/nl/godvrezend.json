                                "target_senses": [
                                    {
                                        "sense_id": "60f16658-847c-3862-8eb1-8c305a170072",
                                        "entry_id": "653c17a0-9413-3694-9c6d-ed0e3ebc0b2b",
                                        "glosses": [
                                            "Of or pertaining to a god"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d4df7a-50dc-497c-848d-9f6b472eeb99",
                                                "sense_id": "60f16658-847c-3862-8eb1-8c305a170072",
                                                "text": "her godly powers = her superhuman powers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42067da0-092c-3a78-aab9-d92ea88a815b",
                                        "entry_id": "653c17a0-9413-3694-9c6d-ed0e3ebc0b2b",
                                        "glosses": [
                                            "Devoted to a god or God; devout; holy; righteous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14de76d3-4878-4f3a-a1c5-1f015d89ea00",
                                                "sense_id": "42067da0-092c-3a78-aab9-d92ea88a815b",
                                                "text": "For godly sorrow worketh repentance."
                                            },
                                            {
                                                "example_id": "7f452424-219e-4014-a62b-4790131c7ad7",
                                                "sense_id": "42067da0-092c-3a78-aab9-d92ea88a815b",
                                                "text": "If you would know what a man is, whether he be a godly man or not, you must inquire what his God is. If the true God be he whom he respects as his God, [...] he is doubtless a godly man [...] if the man have some other god, something else to which he pays a greater respect than to Jehovah, he is not a godly man ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe1bfdc-92ec-30e0-bece-2c09d7f5c2bf",
                                        "entry_id": "653c17a0-9413-3694-9c6d-ed0e3ebc0b2b",
                                        "glosses": [
                                            "Gloriously good."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
