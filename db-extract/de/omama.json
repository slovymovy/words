                "senses": [
                    {
                        "sense_id": "3ece657d-5f12-354c-ae57-ced07242f9ab",
                        "entry_id": "f9b83f04-f9e2-376f-bbea-3df628139526",
                        "glosses": [
                            "Großmutter"
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "b27657c7-dd44-4b3b-bf94-da074b412e07",
                                "sense_id": "3ece657d-5f12-354c-ae57-ced07242f9ab",
                                "text": "Omama backt in der Küche gerade einen leckeren Kuchen."
                            },
                            {
                                "example_id": "5bf9011a-3bed-40d6-9068-fc5789c9788e",
                                "sense_id": "3ece657d-5f12-354c-ae57-ced07242f9ab",
                                "text": "„Omama hat heute auch keine Zeit zum Liedchen singen.“"
                            },
                            {
                                "example_id": "0dd18d21-a092-464e-87f8-7b1765fc2cba",
                                "sense_id": "3ece657d-5f12-354c-ae57-ced07242f9ab",
                                "text": "„Meine Omama hat einen Arm um mich gelegt und mir eine gute Nacht gewünscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
