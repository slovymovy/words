                                    },
                                    {
                                        "sense_id": "3514b6ac-f030-3111-b0a1-de40feb6330c",
                                        "entry_id": "decc0021-69cb-3310-8210-52d271583fc0",
                                        "glosses": [
                                            "A series of stores or businesses with the same brand name."
