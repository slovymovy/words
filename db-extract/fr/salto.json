        "fr-extract.jsonl": [
            {
                "entry_id": "d109a8aa-929d-3d63-b3c2-0df604c95b26",
                "word": "Salto",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "301ad614-361d-3220-9434-7b0e1a026584",
                        "entry_id": "d109a8aa-929d-3d63-b3c2-0df604c95b26",
                        "glosses": [
                            "Ancien service français de vidéo à la demande par abonnement, qui proposait des films et des séries ainsi que des documentaires et des émissions de divertissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75aa7899-0a08-4d7b-92c4-f42de59bb6b0",
                                "sense_id": "301ad614-361d-3220-9434-7b0e1a026584",
                                "text": "Dans ce secteur très compétitif, une première victime n’a pas survécu : Salto, plateforme française montée conjointement par TF1, M6 et France Télévisions, a cessé ses activités en février."
                            },
                            {
                                "example_id": "14821fc0-0b7a-4e19-b74d-b6cf6a0dcbfb",
                                "sense_id": "301ad614-361d-3220-9434-7b0e1a026584",
                                "text": "La plateforme Salto, née en octobre 2020 d'une volonté commune de France Télévisions, TF1 et M6, ferme ses portes ce lundi."
                            },
                            {
                                "example_id": "5d84dcef-21dc-4601-8288-29d1690fe9fe",
                                "sense_id": "301ad614-361d-3220-9434-7b0e1a026584",
                                "text": "Mercredi 15 février 2023, les groupes France Télévisions, M6 et TF1 ont annoncé la fin de Salto."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
