                    },
                    {
                        "translation_id": "3c2dd7e7-a437-4234-9b3f-9f2b2e0d52a6",
                        "source_entry_id": "a42de69b-90db-3980-b6d8-ebb04dcf0a87",
                        "source_sense_description": "stone to death",
                        "target_lang_word": "lapider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55230124-0d2a-3f18-8b71-e24f598afe3c",
                                        "entry_id": "3e7e9998-508e-30d2-8d27-826d3cf9d063",
                                        "glosses": [
                                            "Tuer à coups de pierres, supplice qui était en usage en Orient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a49aea47-8b36-4f2d-ba4e-28091d2da2aa",
                                                "sense_id": "55230124-0d2a-3f18-8b71-e24f598afe3c",
                                                "text": "N'avez-vous pas entendu dire qu'il y avait un homme nommé Saul qui gardait les manteaux de ceux qui lapidaient saint Etienne?"
                                            },
                                            {
                                                "example_id": "f4142566-09e2-40c7-b999-096ba624256a",
                                                "sense_id": "55230124-0d2a-3f18-8b71-e24f598afe3c",
                                                "text": "et les cailloux manqueront pour lapider l’adultère !"
                                            },
                                            {
                                                "example_id": "64613e8f-92bd-4dae-9fed-f00e15775585",
                                                "sense_id": "55230124-0d2a-3f18-8b71-e24f598afe3c",
                                                "text": "Si j’ai volé, je n’ai ni persécuté ni tué le pauvre monde, et ce n’est pas moi qui ai gardé les vêtements de ceux qui lapidaient ce bon saint Étienne, entendez-vous, monsieur saint Paul."
                                            },
                                            {
                                                "example_id": "71a73a6b-7684-4aa3-a0d2-4361d2dc6842",
                                                "sense_id": "55230124-0d2a-3f18-8b71-e24f598afe3c",
                                                "text": "Le Temple condamne les présomptueux comme toi. A Jérusalem, tu serais déjà mort lapidé !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a55c8c87-54f7-3cb2-99fc-9ed601c5a1cf",
                                        "entry_id": "3e7e9998-508e-30d2-8d27-826d3cf9d063",
                                        "glosses": [
                                            "Attaquer, poursuivre à coups de pierres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a248656-02b8-4be0-927f-af93a0d9731b",
                                                "sense_id": "a55c8c87-54f7-3cb2-99fc-9ed601c5a1cf",
                                                "text": "Le peuple lapide de temps en temps ce brave Genevois."
                                            },
                                            {
                                                "example_id": "73b81a0d-6055-4dcd-8fad-2c2a781dce73",
                                                "sense_id": "a55c8c87-54f7-3cb2-99fc-9ed601c5a1cf",
                                                "text": "Irma achète une maison sur la route du cimetière dans l’espoir de lapider le cercueil de Juste, quand passera son enterrement, mais elle meurt la première."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a33a8f-a021-32a3-80b9-bedd6a63c189",
                                        "entry_id": "3e7e9998-508e-30d2-8d27-826d3cf9d063",
                                        "glosses": [
                                            "Se déchaîner contre quelqu’un, à plusieurs personnes."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aaa7666-7808-4c55-a20c-c4792f475f89",
                                                "sense_id": "74a33a8f-a021-32a3-80b9-bedd6a63c189",
                                                "text": "Vous vous ferez lapider si vous parlez ainsi."
                                            },
                                            {
                                                "example_id": "d7b83301-e7ff-4f3e-8d33-735bce99cbf4",
                                                "sense_id": "74a33a8f-a021-32a3-80b9-bedd6a63c189",
                                                "text": "[Les médias] Ils s’acharnèrent alors sur son pâle successeur, le leader conservateur John Major, en même temps qu’ils passèrent à la moulinette chacun des chefs de l’opposition travailliste, en particulier l’excellent Neil Kinnock, qui fut lapidé par une presse particulièrement virulente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
