                },
                {
                    "sense_id": "1ac97e30-e8b4-3854-a26f-2b4abc30930f",
                    "sense_definition": "An arithmetic computation, especially one posed to a student as an exercise.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "math_exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the students to do their <w>sums</w> quietly.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников решать <w>примеры</w> тихо.",
                                "zh": "老师让学生们安静地做<w>算术题</w>。"
                            }
                        },
                        {
                            "text": "I was never very good at <w>sums</w> when I was in school.",
                            "target_lang_translations": {
                                "ru": "В школе мне никогда не давались <w>задачи</w>.",
                                "zh": "我在学校时，<w>计算</w>一直不太好。"
                            }
                        }
