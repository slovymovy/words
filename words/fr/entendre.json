    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a36b9e9d-0a9a-372c-9c39-42981932c9d7",
                    "sense_definition": "Percevoir des sons ou des paroles par le sens de l'ouïe.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>entends</w> le chant des oiseaux depuis ma chambre chaque matin."
                        },
                        {
                            "text": "Parlez plus fort car je ne vous <w>entends</w> pas du tout."
                        }
                    ],
                    "common_phrases": [
                        "entendre parler de",
                        "faire entendre sa voix"
                    ]
                },
                {
                    "sense_id": "7350e240-8c1b-3c33-93c3-b373317a624e",
                    "sense_definition": "Avoir des relations harmonieuses ou amicales avec une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je m'<w>entends</w> très bien avec mes nouveaux collègues de bureau."
                        },
                        {
                            "text": "Les deux frères ne s'<w>entendent</w> plus depuis plusieurs années."
                        }
                    ],
                    "common_phrases": [
                        "bien s'entendre",
                        "s'entendre comme larrons en foire"
                    ]
                },
                {
                    "sense_id": "cc5ce11e-6847-3c58-9318-109a5dc117d5",
                    "sense_definition": "Saisir le sens de quelque chose ; comprendre intellectuellement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il connaît bien cette matière et <w>entend</w> parfaitement les enjeux."
                        },
                        {
                            "text": "Je ne parviens pas à <w>entendre</w> les raisons de son départ soudain."
                        }
                    ],
                    "synonyms": [
                        "comprendre"
                    ],
                    "common_phrases": [
                        "s'y entendre en",
                        "donner à entendre"
                    ]
                },
                {
                    "sense_id": "5f2c1cc6-f6a4-38ae-81e0-36db3f01a69b",
                    "sense_definition": "Vouloir dire ou signifier par des paroles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Qu'<w>entendez</w>-vous exactement par cette remarque déplacée ?"
                        },
                        {
                            "text": "Par « bientôt », il <w>entend</w> sans doute dans deux ou trois semaines."
                        }
                    ],
                    "synonyms": [
                        "vouloir dire"
                    ],
                    "common_phrases": [
                        "entendre par là"
                    ]
                },
                {
                    "sense_id": "d8f883ad-fabe-30a6-ad6c-d90e24abccd6",
                    "sense_definition": "Avoir la ferme intention de faire quelque chose ; vouloir résolument.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "volition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'association <w>entend</w> poursuivre ses actions en faveur des plus démunis."
                        },
                        {
                            "text": "Nous n'<w>entendons</w> pas renoncer à nos droits fondamentaux."
                        }
                    ],
                    "synonyms": [
                        "compter",
                        "avoir l'intention de"
                    ]
                },
                {
                    "sense_id": "6b21d9fa-b5d7-3b9c-8e80-c142889f81d8",
                    "sense_definition": "Recueillir les déclarations ou le témoignage d'une personne dans un cadre officiel ou judiciaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "judiciaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge d'instruction va <w>entendre</w> les témoins clés dès demain matin."
                        },
                        {
                            "text": "Le suspect a été <w>entendu</w> par la police pendant plusieurs heures."
                        }
                    ],
                    "common_phrases": [
                        "entendre un témoin"
                    ]
                },
                {
                    "sense_id": "85f403ed-8e45-31bd-8ff2-3a582d339725",
                    "sense_definition": "Exiger avec autorité qu'une chose soit accomplie d'une certaine façon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "volition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>entends</w> que les règles soient strictement respectées par tout le monde."
                        },
                        {
                            "text": "Le directeur <w>entendait</w> que le rapport soit terminé avant midi."
                        }
                    ],
                    "synonyms": [
                        "exiger"
                    ],
                    "common_phrases": [
                        "entendre que"
                    ]
                }
            ]
        }
    ]
