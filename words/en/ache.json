{
    "word_family": [
        "achy",
        "aching",
        "headache",
        "backache",
        "stomachache",
        "toothache",
        "heartache"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ace75484-7702-3608-8619-3629f06a75ec",
                    "sense_definition": "To suffer from a continuous, dull pain, or to be the source of such a feeling.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My legs began to <w>ache</w> after walking up the steep hill for over an hour.",
                            "target_lang_translations": {
                                "ru": "Мои ноги начали <w>болеть</w> после того, как я больше часа поднимался на крутой холм."
                            }
                        },
                        {
                            "text": "If your muscles <w>ache</w> after exercise, you should try to stretch more often.",
                            "target_lang_translations": {
                                "ru": "Если ваши мышцы <w>ноют</w> после тренировки, вам следует чаще делать растяжку."
                            }
                        }
                    ],
                    "synonyms": [
                        "hurt",
                        "suffer"
                    ],
                    "common_phrases": [
                        "muscles ache",
                        "legs ache",
                        "body ached"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать продолжительную тупую боль или быть источником такого ощущения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болеть",
                                "target_lang_sense_clarification": "о части тела"
                            },
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "о тупой, тянущей боли"
                            },
                            {
                                "target_lang_word": "ломить",
                                "target_lang_sense_clarification": "о сильной боли в костях или мышцах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05ab4959-db26-322c-aabb-288ef9948212",
                    "sense_definition": "To cause someone or something to suffer pain.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy burden seemed to <w>ache</w> his shoulders as he carried it home.",
                            "target_lang_translations": {
                                "ru": "Казалось, тяжелая ноша <w>причиняла боль</w> его плечам, пока он нес ее домой."
                            }
                        },
                        {
                            "text": "The bright lights of the stadium can <w>ache</w> your eyes if you look directly at them.",
                            "target_lang_translations": {
                                "ru": "Яркий свет стадиона может <w>резать</w> глаза, если смотреть прямо на него."
                            }
                        }
                    ],
                    "synonyms": [
                        "afflict",
                        "torment",
                        "hurt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять кому-либо или чему-либо боль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причинять боль",
                                "target_lang_sense_clarification": "вызывать физическое страдание"
                            },
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "заставлять страдать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b252629d-5e8c-3682-b1f6-a832a04a0655",
                    "sense_definition": "A continuous dull pain, rather than a sharp or sudden one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a dull <w>ache</w> in her back after sitting at the desk all day.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала тупую <w>боль</w> в спине после того, как просидела за столом весь день."
                            }
                        },
                        {
                            "text": "The doctor asked if the pain was a sharp sting or just a constant <w>ache</w>.",
                            "target_lang_translations": {
                                "ru": "Врач спросил, была ли это резкая колющая боль или просто постоянная <w>ломота</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pain",
                        "soreness"
                    ],
                    "antonyms": [
                        "pang",
                        "throe"
                    ],
                    "common_phrases": [
                        "dull ache",
                        "constant ache",
                        "aches and pains"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжительная тупая боль, в отличие от резкой или внезапной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боль",
                                "target_lang_sense_clarification": "физическое ощущение"
                            },
                            {
                                "target_lang_word": "ломота",
                                "target_lang_sense_clarification": "тупая боль в мышцах или суставах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d98638b-cc7a-3ffe-b2bb-df928e467fb4",
                    "sense_definition": "An old name for the herb parsley.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient botanical texts, the plant we call parsley was often referred to as <w>ache</w>.",
                            "target_lang_translations": {
                                "ru": "В древних ботанических текстах растение, которое мы называем петрушкой, часто упоминалось как <w>аче</w>."
                            }
                        },
                        {
                            "text": "The herbalist looked for <w>ache</w> among the various greens in the medieval garden.",
                            "target_lang_translations": {
                                "ru": "Травник искал <w>сельдерей</w> среди различной зелени в средневековом саду."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical botanical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старое название петрушки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельдерей",
                                "target_lang_sense_clarification": "в историческом контексте иногда относилось к дикому сельдерею"
                            },
                            {
                                "target_lang_word": "петрушка",
                                "target_lang_sense_clarification": "устаревшее название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8148cc2a-f1f6-31e8-b946-144b550f64f0",
                    "sense_definition": "A rare spelling of the letter <w>aitch</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alphabet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old manuscript used the spelling <w>ache</w> to refer to the eighth letter of the alphabet.",
                            "target_lang_translations": {
                                "ru": "В старой рукописи использовалось написание <w>ache</w> для обозначения восьмой буквы алфавита."
                            }
                        },
                        {
                            "text": "Linguists noted that <w>ache</w> was once a common way to write the name of the letter H.",
                            "target_lang_translations": {
                                "ru": "Лингвисты отметили, что <w>ache</w> когда-то было обычным способом написания названия буквы H."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "rare historical spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Редкое написание названия буквы H (aitch)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эйч",
                                "target_lang_sense_clarification": "название буквы H"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf343891-4da3-3fcb-94d6-80fdc217eab1",
                    "sense_definition": "An abbreviation for the enzyme acetylcholinesterase.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biochemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers measured the levels of <w>AChE</w> in the blood samples to check for nerve agent exposure.",
                            "target_lang_translations": {
                                "ru": "Исследователи измерили уровень <w>АХЭ</w> в образцах крови, чтобы проверить воздействие нервно-паралитических веществ."
                            }
                        },
                        {
                            "text": "Inhibiting <w>AChE</w> is a common strategy in the treatment of certain neurological conditions.",
                            "target_lang_translations": {
                                "ru": "Ингибирование <w>АХЭ</w> является распространенной стратегией при лечении определенных неврологических заболеваний."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура фермента ацетилхолинэстеразы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "АХЭ",
                                "target_lang_sense_clarification": "ацетилхолинэстераза"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "aad494af-9041-39a9-b222-7d3c01338b84",
