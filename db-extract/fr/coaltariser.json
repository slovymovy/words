                        "glosses": [
                            "Couvrir de coaltar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "decf9bf5-da3b-48d2-afac-312a68b59058",
                                "sense_id": "869b6311-7c91-3d14-bc57-3320b2288b4e",
                                "text": "Dans les deux cas, la couche de mélange, tout eu couvrant d'une façon absolue et égale toute la surface à coaltariser, doit être aussi mince que possible."
                            },
                            {
                                "example_id": "f240d064-1c38-4496-8b22-6eafb9a07db3",
                                "sense_id": "869b6311-7c91-3d14-bc57-3320b2288b4e",
                                "text": "A l'aide de ce matériel, deux hommes ont pu coaltariser 50 mètres carrés de parquet en chêne en trois heures environ."
                            }
                        ]
                    }
