                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c97a9c-6876-49ea-8648-31b84b9db19b",
                                                "sense_id": "2ebf6fa1-13be-3ae2-89fb-92d2058ab3aa",
                                                "text": "Ma's out, Pa's out, let's talk rude-- Pee, po, belly, bum, drawers!"
                                            },
                                            {
                                                "example_id": "5cd0d0ef-2386-4989-a921-e3d96b4fd986",
                                                "sense_id": "2ebf6fa1-13be-3ae2-89fb-92d2058ab3aa",
                                                "text": "‘Pos’ or ‘chamber pots’ were provided under the beds."
                                            },
                                            {
                                                "example_id": "2e723a9f-2a4b-430c-a622-257f976e3ae4",
                                                "sense_id": "2ebf6fa1-13be-3ae2-89fb-92d2058ab3aa",
                                                "text": "There are always several spitoons & pos [chamber pots] about the room & a loathesome smell of consumption, which I expect I shall catch."
                                            },
                                            {
                                                "example_id": "7547d66e-7801-44b1-897c-610274cbf6c3",
                                                "sense_id": "2ebf6fa1-13be-3ae2-89fb-92d2058ab3aa",
                                                "text": "Shaking the last few drops from off the end he looked down in surprise at the great head of steam that brimmed above the po, belatedly apprised of just how icy the October garret was."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "po",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b63a929-9d76-3845-8382-bc326846cbc9",
                                        "entry_id": "4ff5b1a6-173b-38ab-9ccb-f05f8182f5c3",
                                        "glosses": [
                                            "The police."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c70d95-fdc9-469c-8e04-0b5bab390111",
                                                "sense_id": "6b63a929-9d76-3845-8382-bc326846cbc9",
                                                "text": "\"Basically it's a celebration of all the gearheads in the area,\" Rob told him. \"Sometimes we get busted by the po, but we always find a new place to show off our rides. Enjoy this lot while we have it.\""
                                            },
                                            {
                                                "example_id": "b54b2851-ddce-4c57-9323-79db75629b7b",
                                                "sense_id": "6b63a929-9d76-3845-8382-bc326846cbc9",
                                                "text": "\"'Bout time the po' got here,\" someone said loud enough for Bree to hear."
                                            },
                                            {
                                                "example_id": "eafe2ff4-9a64-418e-8e0f-5c79260ea3c3",
                                                "sense_id": "6b63a929-9d76-3845-8382-bc326846cbc9",
                                                "text": "Now, one of the rules I had—this is another reason why certain police probably respected us dudes—when it was hot, when I saw certain po, we would shut it down. We left. I would just leave. I would give them they space and let them go."
                                            }
                                        ]
                                    }
                                ]
                            },
