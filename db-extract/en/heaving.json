                "senses": [
                    {
                        "sense_id": "5aef247d-da7f-32d0-9dc6-e60f7cf9e9c1",
                        "entry_id": "e0ff3874-7ad1-3e4f-967b-344da2be9028",
                        "glosses": [
                            "An occasion on which something heaves or is heaved."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "766fbe1e-5ecb-44ef-b2e9-02d42a9338a8",
                                "sense_id": "5aef247d-da7f-32d0-9dc6-e60f7cf9e9c1",
                                "text": "No swellings tell that winds may be Upon some far-off happier sea-- No heavings hint that winds have been On seas less hideously serene.\""
                            },
                            {
                                "example_id": "90dd7e97-e628-47dc-a348-5098be549761",
                                "sense_id": "5aef247d-da7f-32d0-9dc6-e60f7cf9e9c1",
                                "text": "His throne rocked with subterraneous heavings."
                            },
                            {
                                "example_id": "5c83511e-e379-43e1-b76e-63e66d2357af",
                                "sense_id": "5aef247d-da7f-32d0-9dc6-e60f7cf9e9c1",
                                "text": "Then he set the jug down wrong side up, and remained glaring at it fixedly, while his chest rose and fell in deep heavings."
                            }
                        ]
                    }
