                        "examples": [
                            {
                                "example_id": "0f4fad4e-293f-4846-a97a-ff16f545bc70",
                                "sense_id": "100ec720-bfb5-302b-8f44-27a099fc75d6",
                                "text": "De onderzoekers van de universiteit van Tokio hopen met behulp van het gedrag van de mot en zijn bewegingen, robots te kunnen maken die snel en nauwkeurig geuren of andere stimuli opsporen en dan over gaan tot actie. Uit zichzelf handelende robots dus."
                            }
