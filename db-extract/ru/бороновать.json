                ],
                "senses": [
                    {
                        "sense_id": "98128904-909b-3e48-b7aa-4c3600f6cc13",
                        "entry_id": "ddb64c52-87e1-3995-b3a6-98017d3d2f53",
                        "glosses": [
                            "с.-х. разрыхлять землю бороной или аналогичным инструментом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8862aa59-2fee-4278-a7af-f243e769fc07",
                                "sense_id": "98128904-909b-3e48-b7aa-4c3600f6cc13",
                                "text": "Пахота была превосходная; через два дня можно будет бороновать и сеять."
                            },
                            {
                                "example_id": "c2d8fb72-57aa-486b-b2aa-4b4c02715140",
                                "sense_id": "98128904-909b-3e48-b7aa-4c3600f6cc13",
                                "text": "А вот у моей соседки со стороны пешеходной дорожки есть хобби ― бороновать граблями участок шириной в метр, прилегающий к ее ряду кустов, для того чтобы заметно было, кто ступил на территорию и сорвал ягодку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a91660f6-2d94-4559-94b0-ffb0a69a65cd",
                        "source_entry_id": "ddb64c52-87e1-3995-b3a6-98017d3d2f53",
                        "source_sense_id": "98128904-909b-3e48-b7aa-4c3600f6cc13",
                        "target_lang_word": "harrow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb76f56-7c11-3e6d-9558-4ab646f91a63",
                                        "entry_id": "ece6427b-e2bf-3a6b-9b44-7af9c0348c91",
                                        "glosses": [
                                            "A device consisting of a heavy framework having several disks or teeth in a row, which is dragged across ploughed land to smooth or break up the soil, to remove weeds or cover seeds; a harrow plow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a279a3a-ff68-4181-bbb8-1341415e2157",
                                                "sense_id": "bfb76f56-7c11-3e6d-9558-4ab646f91a63",
                                                "text": "He sent for the carpenter, who was under contract to be with the threshing-machine, but it turned out that he was mending the harrows, which should have been mended the week before Lent."
                                            },
                                            {
                                                "example_id": "49ecf260-2880-4c4d-8c99-3bf5dbe22ee6",
                                                "sense_id": "bfb76f56-7c11-3e6d-9558-4ab646f91a63",
                                                "text": "“It may be fun for her,” I said with one of my bitter laughs, “but it isn't so diverting for the unfortunate toads beneath the harrow whom she plunges so ruthlessly in the soup.”"
                                            },
                                            {
                                                "example_id": "cf295812-5038-4b49-bf9f-badf9e33fa1b",
                                                "sense_id": "bfb76f56-7c11-3e6d-9558-4ab646f91a63",
                                                "text": "Part of your job would be to learn tractor ploughing and the use of planters, harrows, and cultivators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756c8159-1f2a-3bec-b4ef-172a06cbb994",
                                        "entry_id": "ece6427b-e2bf-3a6b-9b44-7af9c0348c91",
                                        "glosses": [
                                            "An obstacle formed by turning an ordinary harrow upside down, the frame being buried."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "harrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "875de670-5249-36c7-be06-d3d33c4a16a4",
                                        "entry_id": "e786862e-44ec-31d7-a051-5af441c7dfb6",
                                        "glosses": [
                                            "To drag a harrow over; to break up with a harrow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12c9060-fa77-4798-9697-7676f3e2de01",
                                                "sense_id": "875de670-5249-36c7-be06-d3d33c4a16a4",
                                                "text": "Will he harrow the valleys after thee?"
                                            },
                                            {
                                                "example_id": "15262870-0ad5-4353-b91b-46ab554a56d6",
                                                "sense_id": "875de670-5249-36c7-be06-d3d33c4a16a4",
                                                "text": "When the corn was sown, I had no harrow, but was forced to go over it myself, and drag a great heavy bough of a tree over it, to scratch it, as it may be called, rather than rake or harrow it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236ff8a9-4f0e-3927-b536-a8dd1ca2d951",
                                        "entry_id": "e786862e-44ec-31d7-a051-5af441c7dfb6",
                                        "glosses": [
                                            "To traumatize or disturb; to torment, distress or vex."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c1e2df-8820-4010-a098-217560e74c29",
                                                "sense_id": "236ff8a9-4f0e-3927-b536-a8dd1ca2d951",
                                                "text": "It harrows me with fear and wonder."
                                            },
                                            {
                                                "example_id": "37717a84-88e0-4c52-84fe-08d39b965a82",
                                                "sense_id": "236ff8a9-4f0e-3927-b536-a8dd1ca2d951",
                                                "text": "I could a Tale vnfold, vvhoſe lighteſt vvord / VVould harrovv vp thy ſoule, freeze thy young blood, / Make thy tvvo eyes like Starres, ſtart from their Spheres, / Thy knotty and combined locks to part, / And each particular haire to ſtand an end, / Like Quilles vpon the fretfull Porpentine: […]"
                                            },
                                            {
                                                "example_id": "3f2bde32-5eda-4bd8-b2d0-aa9585374a24",
                                                "sense_id": "236ff8a9-4f0e-3927-b536-a8dd1ca2d951",
                                                "text": "The headless horseman harrowed Ichabod Crane as he tried to reach the bridge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b87d7d-96ab-3588-9c85-aeabb0fcda8c",
                                        "entry_id": "e786862e-44ec-31d7-a051-5af441c7dfb6",
                                        "glosses": [
                                            "To break or tear, as if with a harrow; to wound; to lacerate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a9b24f3-b9bb-4406-be53-a9862d092a3d",
                                                "sense_id": "94b87d7d-96ab-3588-9c85-aeabb0fcda8c",
                                                "text": "my aged muscles harrow'd up with whips"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab126c0-cd73-387d-9c6c-8dc9a25ae2b4",
                                        "entry_id": "59453bcb-a9ed-3224-8d63-6ac9470f1575",
                                        "glosses": [
                                            "A call for help, or of distress, alarm etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d19546b-920a-4f79-8ffb-b636435bc1a2",
                                                "sense_id": "2ab126c0-cd73-387d-9c6c-8dc9a25ae2b4",
                                                "text": "Harrow, the flames, which me consume (said hee) / Ne can be quencht, within my secret bowels bee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
