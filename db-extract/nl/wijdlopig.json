                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "long-winded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e29fac2-bfc8-3841-af7e-33af3761b03e",
                                        "entry_id": "38c9f949-055b-39ab-8c8b-bc5424ce244c",
                                        "glosses": [
                                            "Tediously long in speaking; consuming much time; unnecessarily verbose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94cbc56-2065-4c38-9f80-e9529e2ca299",
                                                "sense_id": "2e29fac2-bfc8-3841-af7e-33af3761b03e",
                                                "text": "He launched into a long-winded discussion of the relative merits of asphalt and concrete."
                                            },
                                            {
                                                "example_id": "f42f160b-0e85-4875-acf9-d0ad6f592307",
                                                "sense_id": "2e29fac2-bfc8-3841-af7e-33af3761b03e",
                                                "text": "But which analysis is the right one? Well, as in any serious field of research, the consequences of making different assumptions about a particular phenomenon are often so complex and far-reaching that the full implications of the decision to adopt one analysis rather than another are not always immediately apparent. Thatʼs a rather long-winded way of saying that itʼs not always obvious what the right answer is!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
