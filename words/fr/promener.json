            "senses": [
                {
                    "sense_id": "d9cba5fc-716f-3674-81fb-cd4ed1496b95",
                    "sense_definition": "Faire une promenade, marcher pour se détendre ou pour le plaisir.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "promenade_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, je me <w>promène</w> dans le parc près de chez moi."
                        },
                        {
                            "text": "Les touristes aiment se <w>promener</w> le long du fleuve au coucher du soleil."
                        }
                    ],
                    "synonyms": [
                        "déambuler",
                        "flâner"
                    ],
                    "common_phrases": [
                        "aller se promener",
                        "se promener en ville"
                    ]
                },
                {
                    "sense_id": "bdd9c93c-db09-3dbb-a6f1-053744e097e1",
                    "sense_definition": "Faire faire une promenade à quelqu'un ou faire marcher un animal à l'extérieur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "promenade_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il sort tous les soirs pour <w>promener</w> le chien dans le quartier."
                        },
                        {
                            "text": "La mère utilise une poussette pour <w>promener</w> son bébé au square."
                        }
                    ],
                    "common_phrases": [
                        "promener le chien",
                        "promener un enfant"
                    ]
                },
                {
                    "sense_id": "4ae13526-db1d-3f1a-a741-faa96069a3b6",
                    "sense_definition": "Déplacer ou diriger lentement quelque chose d'un endroit à un autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_dirige",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre <w>promène</w> son regard attentif sur les paysages de la vallée."
                        },
                        {
                            "text": "Elle <w>promène</w> doucement sa main sur la couverture du vieux livre."
                        }
                    ],
                    "common_phrases": [
