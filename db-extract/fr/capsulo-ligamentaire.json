                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57368cb9-7ee9-40fb-a083-ef8ca1fa0ab4",
                                "sense_id": "0b927162-b351-3b78-aecc-83854f0d93a4",
                                "text": "Elle correspond à une atteinte du LCA, de la capsule antéro-latérale et du plan capsulo-ligamentaire médial et postéro-médial (fig. 3)."
                            },
                            {
                                "example_id": "c89d7295-1608-460a-8719-95ae826a95de",
                                "sense_id": "0b927162-b351-3b78-aecc-83854f0d93a4",
                                "text": "La réinsertion capsulo-ligamentaire antérieure ou intervention de Bankart permet de refaire l’épaule telle qu'elle était avant les accidents d’instabilité."
                            },
                            {
                                "example_id": "170035a6-4a18-445d-a7a0-ce0862105bbe",
                                "sense_id": "0b927162-b351-3b78-aecc-83854f0d93a4",
                                "text": "À l’inverse, l’articulation peut se déformer avec une rétraction du système capsulo-ligamentaire pouvant aller jusqu’à un doigt en crochet irréductible."
                            }
                        ]
