                    {
                        "sense_id": "3a3f84ac-03eb-360d-b921-f8b4914bff38",
                        "entry_id": "be301193-c955-303e-a4ad-9805e93984e7",
                        "glosses": [
                            "amtliche Bescheinigung für das Betreiben eines Gewerbes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1d10c88-8ac1-495d-8057-a7d70162000f",
                                "sense_id": "3a3f84ac-03eb-360d-b921-f8b4914bff38",
                                "text": "Für Gastronomen ist ein Gewerbeschein Pflicht."
                            },
                            {
                                "example_id": "e8665e5b-dc72-4f65-9518-6e4064e11632",
                                "sense_id": "3a3f84ac-03eb-360d-b921-f8b4914bff38",
                                "text": "„Ich bin gar nichts, also werde ich Jungunternehmerin und beantrage einen Gewerbeschein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
