                        "glosses": [
                            "To swear against; to take one's oath against."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9c8aece7-a27e-4409-b9b7-0ab76fdb0d6f",
                                "sense_id": "fe814a19-c7f7-3bd9-8009-786502b89460",
                                "text": "If the defendant denied entirely or only partially, his own oath was conclusive on the point, unless the plaintiff counterswore."
                            },
                            {
                                "example_id": "380d1b87-fa0d-486f-a019-678040d1bc81",
                                "sense_id": "fe814a19-c7f7-3bd9-8009-786502b89460",
                                "text": "One of the Irish triads stated that the oath of a woman in childbirth was one of the three oaths that could not be countersworn."
                            }
                        ]
