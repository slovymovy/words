                                "target_senses": [
                                    {
                                        "sense_id": "4fee5395-e88d-3fdd-8195-2a8179b1677d",
                                        "entry_id": "c001b560-9059-32c3-98e5-9478c8dc78a3",
                                        "glosses": [
                                            "Relâcher ce qui est serré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53265b79-adc2-4bb9-9e46-4dda05e31abc",
                                                "sense_id": "4fee5395-e88d-3fdd-8195-2a8179b1677d",
                                                "text": "Et puis, il a desserré peu à peu le crin, dégagé le cou. Il s'est assuré que la bête est indemne, la strangulation inefficace encore."
                                            },
                                            {
                                                "example_id": "34e06e82-deb9-4ed8-91c5-d2cfce79c5c4",
                                                "sense_id": "4fee5395-e88d-3fdd-8195-2a8179b1677d",
                                                "text": "Cette ceinture vous serre trop, desserrez-la."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92424a21-a45a-4525-9eaa-87293f4ef63c",
                        "source_entry_id": "737703da-18aa-30c1-98d4-eca6bd5fe1e7",
                        "source_sense_description": "ослабить, открутить что-либо завинченное",
                        "target_lang_word": "dévisser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dévisser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed38e049-6299-3e62-bff9-958fd0868dad",
                                        "entry_id": "0746b1ee-033a-3949-b55b-fc7a9ce66675",
                                        "glosses": [
                                            "Dégager une chose des vis qui servaient à la retenir, à la fixer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea42c802-1376-4cbb-9845-4c367607b56b",
                                                "sense_id": "ed38e049-6299-3e62-bff9-958fd0868dad",
                                                "text": "Dévisser une serrure."
                                            },
                                            {
                                                "example_id": "5297dec1-4f6a-46fa-bbc7-d9300612f296",
                                                "sense_id": "ed38e049-6299-3e62-bff9-958fd0868dad",
                                                "text": "Cet outil sert à dévisser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "460dde15-d9b2-35f7-a7bb-9b3f39836d88",
                                        "entry_id": "0746b1ee-033a-3949-b55b-fc7a9ce66675",
                                        "glosses": [
                                            "Enlever ce qui est vissé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d9d717-c2e3-4b03-9ec3-9bba0d87bded",
                                                "sense_id": "460dde15-d9b2-35f7-a7bb-9b3f39836d88",
                                                "text": "Dévisser un écrou."
                                            },
                                            {
                                                "example_id": "9fc6a98e-bb97-49cc-b943-535b24d3dcb0",
                                                "sense_id": "460dde15-d9b2-35f7-a7bb-9b3f39836d88",
                                                "text": "Dévisser le bouchon d’argent d’un flacon de cristal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dbb9d6b-3491-3ea4-abf9-c86a43fbdc60",
                                        "entry_id": "0746b1ee-033a-3949-b55b-fc7a9ce66675",
                                        "glosses": [
                                            "Chuter d’une paroi rocheuse ou glaciaire, sans être retenu par une corde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e109c747-d60e-4d9d-9c5f-f0c96a351db9",
                                                "sense_id": "7dbb9d6b-3491-3ea4-abf9-c86a43fbdc60",
                                                "text": "[Titre] Les six alpinistes retrouvés morts auraient dévissé"
                                            },
                                            {
                                                "example_id": "3ea69c81-a85b-4a6a-ae0e-b81998882747",
                                                "sense_id": "7dbb9d6b-3491-3ea4-abf9-c86a43fbdc60",
                                                "text": "Arrivé au sommet, étourdir par sa victoire, il a immédiatement dévissé, raflant avec ses mouvements de panique toutes les étagères à sa portée."
                                            },
                                            {
                                                "example_id": "58c94eba-b3d7-4bb0-8b10-1cac8c737dc7",
                                                "sense_id": "7dbb9d6b-3491-3ea4-abf9-c86a43fbdc60",
                                                "text": "S’il s’essoufflait, il dévisserait !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fb85237-28f2-36c3-9202-a56ea1bf8406",
                                        "entry_id": "0746b1ee-033a-3949-b55b-fc7a9ce66675",
                                        "glosses": [
                                            "Diminuer brutalement, connaître une forte et soudaine chute."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de55bee6-723d-4196-8515-88897de655e7",
                                                "sense_id": "7fb85237-28f2-36c3-9202-a56ea1bf8406",
                                                "text": "Résultat, les ventes de vins et spiritueux tricolores ont plongé sur leurs principaux marchés. Ainsi, aux Etats-Unis, première destination des alcools français, les exportations dévissent de 59 % en mai et de 29 % sur les cinq premiers mois de l’année, pour un montant total d’un milliard d’euros."
                                            },
                                            {
                                                "example_id": "4c2aeb1e-e7d0-45da-84a9-59eb942e8efb",
                                                "sense_id": "7fb85237-28f2-36c3-9202-a56ea1bf8406",
                                                "text": "L’ex-entreprise vedette de la technologie à la française fabrique les cartes SIM équipant des dizaines de millions de Smartphone ; depuis janvier, hélas, ses caisses se sont dangereusement vidées, son cours de Bourse a dévissé de 25 % et sa filiale Netsize, à Meudon, prépare une charrette de 41 salariés sur les 90 du site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb3b190-003f-33dc-a433-c0feb443d5d5",
                                        "entry_id": "0746b1ee-033a-3949-b55b-fc7a9ce66675",
                                        "glosses": [
                                            "Rater complètement (un tir qui aurait dû se diriger vers le but)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16da5917-2d08-44cb-9ade-4855711b0da9",
                                                "sense_id": "ceb3b190-003f-33dc-a433-c0feb443d5d5",
                                                "text": "Devaux se montre menaçant, et après avoir affolé la défense brestoise, alors qu’il était seul devant le but vide, sa frappe dévissée passe au ras du poteau (4’)."
                                            },
                                            {
                                                "example_id": "469e859a-deb4-43df-a7ba-e50fdc63f831",
                                                "sense_id": "ceb3b190-003f-33dc-a433-c0feb443d5d5",
                                                "text": "Mardi soir, dans un stade à l’ambiance électrico-écolo, face à une Vieille Dame plus que boiteuse, l’attaquant parisien a honteusement oublié Neymar seul dans l’axe et a préféré opter pour un tir du droit dévissé."
                                            },
                                            {
                                                "example_id": "5bc1d971-1937-4e63-aae1-918f1e06f989",
                                                "sense_id": "ceb3b190-003f-33dc-a433-c0feb443d5d5",
                                                "text": "Parfaitement lancé par Payet, Germain, seul face à Oblak, a complètement dévissé sa frappe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad9ae3fd-13b3-377e-80be-bd6eca5d513b",
                                        "entry_id": "0746b1ee-033a-3949-b55b-fc7a9ce66675",
                                        "glosses": [
                                            "Effectuer un panoramique horizontal avec une caméra dans le sens anti-horaire."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a8d94cc-be8c-4401-ad5b-50052d7db776",
                        "source_entry_id": "737703da-18aa-30c1-98d4-eca6bd5fe1e7",
                        "source_sense_description": "разнять на части, детали что-либо свинченное",
                        "target_lang_word": "démonter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démonter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd2b322a-a2ab-3e7d-87fe-f55dacf390c6",
                                        "entry_id": "af052109-c877-345f-bdf2-b2402be246de",
                                        "glosses": [
                                            "Arrêter le mouvement d’un mécanisme, qui a ensuite besoin d’être remonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41dc9e78-408d-43af-809f-02c816b4584e",
                                                "sense_id": "cd2b322a-a2ab-3e7d-87fe-f55dacf390c6",
                                                "text": "La pendule est démontée et aussi d’un mécanisme qui commence à se détraquer, à ne plus aller aussi bien qu’auparavant."
                                            },
                                            {
                                                "example_id": "57e62c75-7522-4949-a828-47c0061101ec",
                                                "sense_id": "cd2b322a-a2ab-3e7d-87fe-f55dacf390c6",
                                                "text": "Mon réveille-matin se démonte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641a213c-7bef-368d-b894-c98ef860a33a",
                                        "entry_id": "af052109-c877-345f-bdf2-b2402be246de",
                                        "glosses": [
                                            "Perdre le contrôle."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74e2f882-2f53-403f-bc25-90292e51f032",
                                                "sense_id": "641a213c-7bef-368d-b894-c98ef860a33a",
                                                "text": "Une personne démontée, dont l’énergie morale a disparu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c7ba8e8-e490-3dbf-bc12-e25978fcdaa6",
                                        "entry_id": "af052109-c877-345f-bdf2-b2402be246de",
                                        "glosses": [
                                            "Défaire pièce par pièce ce qui formait un tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9604616e-67a7-4cb7-abe0-4af6f6f3d944",
                                                "sense_id": "1c7ba8e8-e490-3dbf-bc12-e25978fcdaa6",
                                                "text": "Il faudrait tout démonter, puis reconstituer après avoir consolidé l’ensemble et « dégondolé » le carton."
                                            },
                                            {
                                                "example_id": "96fd4ea7-42cb-4a05-8bd5-0e8db3809126",
                                                "sense_id": "1c7ba8e8-e490-3dbf-bc12-e25978fcdaa6",
                                                "text": "Démonter une pendule, une montre, des diamants, des pierreries."
                                            },
                                            {
                                                "example_id": "c1ac60c6-623d-4554-9805-23a2c01c6408",
                                                "sense_id": "1c7ba8e8-e490-3dbf-bc12-e25978fcdaa6",
                                                "text": "Démonter un canon : l’ôter de dessus son affût."
                                            },
                                            {
                                                "example_id": "93122205-ca4f-4798-8bf8-b58d7dbe3877",
                                                "sense_id": "1c7ba8e8-e490-3dbf-bc12-e25978fcdaa6",
                                                "text": "Démonter un arbre : procéder à son démontage (terme technique d'arboriste)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6edb2dde-9e66-3aee-8c9f-d0dfc54aa413",
                                        "entry_id": "af052109-c877-345f-bdf2-b2402be246de",
                                        "glosses": [
                                            "Détraquer, mettre hors d’usage."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "148a5bdb-0108-4312-8239-2129975dadc3",
                                                "sense_id": "6edb2dde-9e66-3aee-8c9f-d0dfc54aa413",
                                                "text": "Démonter une batterie."
                                            },
                                            {
                                                "example_id": "0e8e8182-7063-4e13-b9f3-b5796dbc02e2",
                                                "sense_id": "6edb2dde-9e66-3aee-8c9f-d0dfc54aa413",
                                                "text": "En deux heures, on démonta toutes les batteries des ennemis."
                                            },
                                            {
                                                "example_id": "be291f6d-9c3b-415f-8de8-835dc0ae11d9",
                                                "sense_id": "6edb2dde-9e66-3aee-8c9f-d0dfc54aa413",
                                                "text": "Tout le vocabulaire qui servait jadis à la fois aux artilleurs et aux amants, on pouvait l’utiliser pour lui : Pierre mettait en batterie, démasquait, foudroyait, démontait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53cbbbe-9982-324c-986c-4d2dd6d8b0a5",
                                        "entry_id": "af052109-c877-345f-bdf2-b2402be246de",
                                        "glosses": [
                                            "Déconcerter, mettre hors d’état d’agir, de répondre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87a6c705-81e4-461f-9674-3b61eafb4334",
                                                "sense_id": "e53cbbbe-9982-324c-986c-4d2dd6d8b0a5",
                                                "text": "Cette objection le démonta tout à fait."
                                            },
                                            {
                                                "example_id": "0d905ba3-3289-4aca-9619-9a3eb179b63d",
                                                "sense_id": "e53cbbbe-9982-324c-986c-4d2dd6d8b0a5",
                                                "text": "Il fut démonté dès le premier argument."
