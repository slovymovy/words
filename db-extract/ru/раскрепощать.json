                "senses": [
                    {
                        "sense_id": "648eb2ff-844d-3d1c-9b0c-68f8c3b679ea",
                        "entry_id": "1c4cf841-746f-3eb6-aab9-89497e1663b9",
                        "glosses": [
                            "истор. освобождать от крепостной зависимости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae14e078-fc96-453f-8214-17225f0914bb",
                                "sense_id": "648eb2ff-844d-3d1c-9b0c-68f8c3b679ea",
                                "text": "Просто так царь не собирался раскрепощать крестьян, только за денежку."
                            }
                        ]
                    },
                    {
                        "sense_id": "415c1ed7-0c29-32ee-a6cd-8ba18b48c1f7",
                        "entry_id": "1c4cf841-746f-3eb6-aab9-89497e1663b9",
                        "glosses": [
                            "перен. освобождать от какой-либо зависимости, притеснений, гнёта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05955d83-2ac2-4c2c-a23d-eb5633a0ea6a",
                                "sense_id": "415c1ed7-0c29-32ee-a6cd-8ba18b48c1f7",
                                "text": "Я не сомневалась в том, что смерть тирана раскрепощает не только нас, но и тех, кто стоял за его спиной в роли ближайших соратников."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdedb939-1f4c-34af-9d35-2615bf9647a4",
                        "entry_id": "1c4cf841-746f-3eb6-aab9-89497e1663b9",
                        "glosses": [
                            "перен. делать раскованным, непринуждённым; позволять кому-либо почувствовать себя непринуждённо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a233a1fd-25dd-46df-82fc-ac5315b74c45",
                                "sense_id": "fdedb939-1f4c-34af-9d35-2615bf9647a4",
                                "text": "Барышни танцевали и украдкой поглядывали на мужчин, пытаясь определить, кто же проголосует в их пользу. Азарт раскрепощал общество."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22ebe00b-8a0d-45cf-b880-8aeae6216571",
                        "source_entry_id": "1c4cf841-746f-3eb6-aab9-89497e1663b9",
                        "target_lang_word": "set free",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "set free",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd8ba9d-d695-33dd-8362-f2987f630825",
                                        "entry_id": "de6099d0-6c80-30c1-bca7-071393e466a8",
                                        "glosses": [
                                            "To release, to free, to give freedom to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f18b88e5-70a2-4fb4-98a9-442a244d3b3b",
                                                "sense_id": "bcd8ba9d-d695-33dd-8362-f2987f630825",
                                                "text": "\"Well, you can tell Nan that she won't marry Peter Mallory with my consent. I'll never set her free to be another man's wife.\""
                                            },
                                            {
                                                "example_id": "67ac61bc-cd9b-422b-81da-fab74c421ad1",
                                                "sense_id": "bcd8ba9d-d695-33dd-8362-f2987f630825",
                                                "text": "Send it, send it / Just like it came to me / I'm gonna set it free / Send it, send it / You've got to let it go / Open up a window"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
