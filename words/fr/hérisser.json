                    ]
                },
                {
                    "sense_id": "d86904b2-43b8-39b0-9f27-876c7ddce777",
                    "sense_definition": "Remplir ou surcharger un ensemble d'obstacles, de difficultés ou d'éléments complexes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "garnir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur aime <w>hérisser</w> son texte de mots techniques particulièrement difficiles à comprendre."
                        },
                        {
                            "text": "Le juriste a tenu à ne pas trop <w>hérisser</w> le contrat de clauses inutiles."
                        }
                    ],
                    "synonyms": [
                        "charger",
                        "encombrer",
                        "truffer"
                    ],
                    "antonyms": [
