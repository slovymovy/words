                    }
                ],
                "senses": [
                    {
                        "sense_id": "932b5b2d-eb5a-3c2b-86e3-7f7e7b34ff76",
                        "entry_id": "4e7bb26b-f412-3740-bf77-1888832646e1",
                        "glosses": [
                            "ältere Frau, die Liebesbeziehungen mit jüngeren Männern hat"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "76c01d9c-62aa-472f-bf3a-5a6fdbcda7f1",
                                "sense_id": "932b5b2d-eb5a-3c2b-86e3-7f7e7b34ff76",
                                "text": "„Ein Cougar, zu Deutsch Silberlöwe, ist eine ältere Frau, die auf jüngere Männer steht.“"
                            },
                            {
                                "example_id": "a1faad65-c023-44e9-b4fa-cf00005752b7",
                                "sense_id": "932b5b2d-eb5a-3c2b-86e3-7f7e7b34ff76",
                                "text": "„Demasi ist das, was man als eine Cougar, also Silberlöwin, bezeichnet.“"
                            },
                            {
                                "example_id": "1b652a4c-5ac3-47bf-b505-7cb5808bd04e",
                                "sense_id": "932b5b2d-eb5a-3c2b-86e3-7f7e7b34ff76",
                                "text": "„Ein Cougar ist eine ältere Frau, die einen jüngeren Mann vernascht.“"
                            },
                            {
                                "example_id": "4637455c-e4bc-4ff6-b186-7f225148db56",
                                "sense_id": "932b5b2d-eb5a-3c2b-86e3-7f7e7b34ff76",
                                "text": "„Eine neue Rolle für die Frau, hurra! Ist sie in die Jahre gekommen, darf sie ihre Krallen ausfahren und - wie hier Courtney Cox in ihrer neuen TV-Serie - deutlich jüngere Männer erbeuten: Sie ist schließlich ein Cougar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef5b0b88-08f9-3890-95a6-b254a11ec5d9",
                        "entry_id": "4e7bb26b-f412-3740-bf77-1888832646e1",
                        "glosses": [
                            "verschiedene Automodelle, die die Ford Motor Company unter ihrer Marke Mercury produziert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "769df639-253d-42c6-87b5-521c6f2ab76d",
                                "sense_id": "ef5b0b88-08f9-3890-95a6-b254a11ec5d9",
                                "text": "„Der Cougar der ersten Generation (1967 bis 1970) ist eng mit dem Ford Mustang verwandt und besitzt daher eine selbsttragenden Karosserie.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21add3bd-eb22-4d48-9f2a-9e48ce56f0a9",
                        "source_entry_id": "4e7bb26b-f412-3740-bf77-1888832646e1",
                        "source_sense_id": "932b5b2d-eb5a-3c2b-86e3-7f7e7b34ff76",
                        "source_sense_description": "Slang, oft abwertend: ältere Frau, die Liebesbeziehungen mit jüngeren Männern hat",
                        "target_lang_word": "cougar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cougar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                        "entry_id": "4c15d9c7-aeca-3a38-a0a9-e7790b0df59f",
                                        "glosses": [
                                            "A wild feline, of species Puma concolor, native to the Americas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46408a23-c11a-4452-b357-ccc03eb201f1",
                                                "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                                "text": "They are found in Brasil, Paraguay, and in the country of the Amazons; and there is reason to believe that the animal, described by some travellers, under the name of the Ocorome, in Peru, is the same as the cougar, as well as that in the country of the Iroquois, which has been considered as a tiger, thought it is neither striped like that animal, nor spotted like the panther."
                                            },
                                            {
                                                "example_id": "53d63ec4-9e41-4b1a-bfa6-07b837ddcade",
                                                "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                                "text": "The Cougar has entirely disappeared, or is very rarely met with. This animal was about the size of the wolf, of a gray color, strong, active, fierce and untameable."
                                            },
                                            {
                                                "example_id": "6353ccc4-3b36-44f4-8962-d4abc39cd03e",
                                                "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                                "text": "The only indigenous long tailed cat in America north of the parallel of 30 degrees is the cougar. The wild cats, so called, are lynxes with short tails; and of these there are three distinct species."
                                            },
                                            {
                                                "example_id": "20dcba1c-0179-4d8b-834f-8fc35548a98d",
                                                "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                                "text": "Winter’s task was to illustrate cougars—also known as mountain lions—in an urban environment. His research led him to biologist Jeff Sikich, whose work with a mountain lion population in the Santa Monica Mountains National Recreation Area on the outskirts of L.A. seemed promising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                        "entry_id": "4c15d9c7-aeca-3a38-a0a9-e7790b0df59f",
                                        "glosses": [
                                            "An older woman who actively seeks the casual, often sexual, companionship of younger men, by implication a female “sexual predator”."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96ca33d2-22da-4c17-853d-b87357d1822b",
                                                "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                                "text": "A cougar approached Warren at the Palomino Club and asked for a dance."
                                            },
                                            {
                                                "example_id": "83bdd5ba-0d37-42e3-8070-8f14c6139ee8",
                                                "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                                "text": "I am 26 years old and in a respectful but super-sexual relationship with a recent divorcée in her 40s. (A \"cougar,\" in local slang.)"
                                            },
                                            {
                                                "example_id": "4d26c6d7-8693-4e28-af60-c3ad1d6d5fd5",
                                                "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                                "text": "Barney Stinson: She's a cougar, Ted! / Robin Scherbatsky: I thought you said you can't be a cougar if you're over 50."
                                            },
                                            {
                                                "example_id": "3563c9e8-0af8-4353-86fd-e9a5aab7d834",
                                                "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                                "text": "“Younger can be good. How much younger?” Regina asked, inspecting the appetizer plates for any lingering bites. “I don't know,” Alexa said frowning. “Why does that matter?” “Less than eight years makes you a Puma. Over eight years makes you a Cougar,” Regina said wisely, grinning as Lauren nodded excitedly in agreement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f45627b-56b1-4d9f-b99b-2d24759e68f9",
                        "source_entry_id": "4e7bb26b-f412-3740-bf77-1888832646e1",
                        "source_sense_id": "932b5b2d-eb5a-3c2b-86e3-7f7e7b34ff76",
                        "source_sense_description": "Slang, oft abwertend: ältere Frau, die Liebesbeziehungen mit jüngeren Männern hat",
                        "target_lang_word": "cougar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cougar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44409285-0772-3191-8e24-beb528cd6e97",
                                        "entry_id": "f72cea23-c3fd-3f19-b4c2-964015b507e7",
                                        "glosses": [
                                            "Autre nom du puma dans certaines régions d’Amérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49b03fd1-9ca1-46fd-b89a-c1bd655d2a60",
                                                "sense_id": "44409285-0772-3191-8e24-beb528cd6e97",
                                                "text": "Nous sommes de petits enfants dans la main du Seigneur, mon cher Paul. Dieu a fait les cougars et les brebis, et quand passe le cruel cougar, la sage brebis ne lui tient pas tête mais lui cède le terrain…"
                                            },
                                            {
                                                "example_id": "a54acc3c-2f7b-483b-b26e-0212568fccf9",
                                                "sense_id": "44409285-0772-3191-8e24-beb528cd6e97",
                                                "text": "Pour garantir l’intégrité de son territoire, la communauté a décidé de préserver une zone de 10,000 ha, la Playa de Oro Reserva de Tigrillos, afin de protéger les félins de la jungle — jaguars, cougars, ocelots, margays, oncillas et jaguarundis."
                                            },
                                            {
                                                "example_id": "b1c79f49-898a-48bd-a331-ea515115037e",
                                                "sense_id": "44409285-0772-3191-8e24-beb528cd6e97",
                                                "text": "Les premières constatations effectuées par la police locale laissent à penser qu’elle aurait succombé à une attaque de cougar sauvage, aussi connu sous le nom de puma. C’est la première attaque de ce type survenue cette année dans l’Oregon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cougar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3de98e35-09d4-3964-8b6b-3d48f9e573e2",
                                        "entry_id": "205c035c-bab2-399c-8f89-c5fe078f081b",
                                        "glosses": [
                                            "Femme qui recherche et séduit des hommes plus jeunes qu’elle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16888c3b-c89e-4402-84c3-bda8833e6877",
                                                "sense_id": "3de98e35-09d4-3964-8b6b-3d48f9e573e2",
                                                "text": "Une cougar, avait calmement expliqué Deborah à Barbara, c’est une femme d’âge mûr qui sort avec des jeunes hommes. Alexandre vient de l’apprendre en feuilletant un magazine féminin et il trouve ça hilarant."
                                            },
                                            {
                                                "example_id": "9d71ed85-abd6-44c8-98de-9ce25ee2dae8",
                                                "sense_id": "3de98e35-09d4-3964-8b6b-3d48f9e573e2",
                                                "text": "Moi qui connais bien Hélène, je n’ai guère été étonné de la voir entamer une idylle avec un homme jeune, de vingt ans son cadet. Elle est ce qu’on appelle aujourd’hui une cougar. Elle a toujours été une croqueuse d’hommes, rien de neuf donc…"
                                            },
                                            {
                                                "example_id": "e36e26bb-1df9-47ea-a322-e535cbdc2d25",
                                                "sense_id": "3de98e35-09d4-3964-8b6b-3d48f9e573e2",
                                                "text": "Intrigué, Barney va observer la professeure Lewis (Jane Seymour) et détecte la cougar, […] : quarante-cinquantenaire, crinière stylée, décolleté profond, griffe rouge vif, attirée par les hommes jeunes ; apparemment une proie facile pour Barney... qui se retrouve pris au piège d'une relation sexuelle essorante, où il ne sera pas à la hauteur […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cougar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6742ae5-a04a-36e3-9c3f-a7a22f5ee554",
                                        "entry_id": "a1dc5fc1-24d8-39ac-96cc-2c3823a9570f",
                                        "glosses": [
                                            "Qui recherche et qui séduit des hommes plus jeunes qu’elle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03162001-1623-464c-8440-910b5a06ed89",
                                                "sense_id": "f6742ae5-a04a-36e3-9c3f-a7a22f5ee554",
                                                "text": "Selon cette enquête, le nombre de femmes cougars est marginal et se limite principalement au monde du show business."
                                            },
                                            {
                                                "example_id": "dff4fb02-22e7-42c6-8d8f-36ce20297465",
                                                "sense_id": "f6742ae5-a04a-36e3-9c3f-a7a22f5ee554",
                                                "text": "Le phénomène des femmes cougars prend de plus en plus d’ampleur et pour cause, les cougars prolifèrent et les proies que nous sommes aussi ! Mais très peu savent comment s’y prendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
