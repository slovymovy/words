                            {
                                "example_id": "ce2ea295-a6a7-44c9-b7ab-b282f0968f8d",
                                "sense_id": "c9fc55d6-3e71-3145-9af7-8df1454e681a",
                                "text": "„Ik kom zojuist uit de operatiekamer, waar ik een aantal zeer pijnlijke injecties heb gekregen in mijn tussenwervelschijven”, zegt de zanger vanuit zijn ziekenhuisbed. „Zoals jullie begrijpen baal ik ontzettend van mijn immobiliteit.”"
                            },
                            {
                                "example_id": "d58e61ea-c91a-445b-bc78-c64d440d351f",
                                "sense_id": "c9fc55d6-3e71-3145-9af7-8df1454e681a",
                                "text": "Reizigers reageren gelaten op de immobiliteit waartoe de ijzel hen veroordeelt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f4ccf67-e931-4ebd-ab6b-6f12c802973a",
