                "senses": [
                    {
                        "sense_id": "171054c6-1e8d-35e7-acdf-d56e08e9a682",
                        "entry_id": "aa644cc8-82d6-3634-bdfd-d32a8aaeb7d3",
                        "glosses": [
                            "als Safari-Trip unternommene Pirschfahrt, um Großwild zu beobachten"
                        ],
                        "tags": [
                            "Namibia"
                        ],
                        "examples": [
                            {
                                "example_id": "aed0ce56-85c0-4ca3-a1c4-ad8e177c2916",
                                "sense_id": "171054c6-1e8d-35e7-acdf-d56e08e9a682",
                                "text": "„Warum berichtet man nur über den Staat und seine Instanzen und kreidet sie an, warum nicht auch mal so einige Privatunterkünfte, wo ein ‚Gamedrive‘ zwischen N$ 50 und 200 pro Person kostet für drei bis vier Stunden?“"
                            },
                            {
                                "example_id": "84770e0b-b37a-4328-93a0-29e855802aee",
                                "sense_id": "171054c6-1e8d-35e7-acdf-d56e08e9a682",
                                "text": "„Amüsant wirkt auch, dass laut ‚Folge Deinem Herzen‘ Weiße auf Farmen in Afrika sonntags auf Safari gehen, einen richtigen ‚Gamedrive machen‘.“"
                            },
                            {
                                "example_id": "913deb59-7f54-4d1c-9040-f69b11376fb7",
                                "sense_id": "171054c6-1e8d-35e7-acdf-d56e08e9a682",
                                "text": "„Nachdem wir uns durch das reichhaltige Angebot von Kuchen, Kaffee, Broten, Aufschnitt, Obst und Getränken hindurchgearbeitet hatten, ging es sofort auf einen Gamedrive bis Sonnunter und gleich anschließend kam der Nightdrive mit Scheinwerfer.“"
                            },
                            {
                                "example_id": "c0a82824-2be3-4fab-95e5-f9941d452e6e",
                                "sense_id": "171054c6-1e8d-35e7-acdf-d56e08e9a682",
                                "text": "„Wasserböcke, Impala, Blessböcke, Strauße, Giraffen und Elandantilopen sind nur einige der Tiere, die es auf einem zweistündigen Gamedrive zu entdecken gilt.“"
                            },
                            {
                                "example_id": "b7028802-ccd1-4168-a6c3-7db71256ea7d",
                                "sense_id": "171054c6-1e8d-35e7-acdf-d56e08e9a682",
                                "text": "„Wir haben bereits mehrtägige Flugsafaris ins Kaokoveld, Bootstouren zu den Robben am Atlantik, Gamedrive, Wüstentouren selbst auf Kamelen und viele weiter[e] Aktivitäten erlebt, die wir auch empfehlen können.“"
                            },
                            {
                                "example_id": "3f00be15-f186-4cde-af6c-29f8cbe25972",
                                "sense_id": "171054c6-1e8d-35e7-acdf-d56e08e9a682",
                                "text": "„Die meisten Lodges bieten nach Ihrer Ankunft Tierfahrten, sogenannte Gamedrives im Geländewagen an, Sundownertouren, ggf. Gepardenfütterungen etc.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
