{
    "word_family": [
        "suppose",
        "supposition",
        "supposedly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8e6dc1d6-ecb3-3f0b-842b-2bf80a18b0c5",
                    "sense_definition": "Expected or required to happen or be done (used with 'be' and 'to').",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are <w>supposed</w> to call your mother when you arrive.",
                            "target_lang_translations": {
                                "ru": "Ты <w>должен</w> позвонить маме, когда приедешь.",
                                "pl": "<w>Masz</w> zadzwonić do mamy, kiedy dotrzesz na miejsce."
                            }
                        },
                        {
                            "text": "The meeting is <w>supposed</w> to start at nine o'clock sharp.",
                            "target_lang_translations": {
                                "ru": "Собрание <w>должно</w> начаться ровно в девять часов.",
                                "pl": "Spotkanie <w>ma</w> się rozpocząć punktualnie o dziewiątej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "supposed to be",
                        "supposed to do",
                        "not supposed to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ожидаемый или требуемый к выполнению (обычно используется в конструкции 'be supposed to').",
                        "pl": "Oczekiwany lub wymagany do zrobienia (używane w konstrukcji 'be supposed to')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "должен",
                                "target_lang_sense_clarification": "выражает обязанность или ожидание"
                            },
                            {
                                "target_lang_word": "полагается",
                                "target_lang_sense_clarification": "согласно правилам или обычаям"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mieć (coś zrobić)",
                                "target_lang_sense_clarification": "wyraża powinność lub plan"
                            },
                            {
                                "target_lang_word": "powinien",
                                "target_lang_sense_clarification": "wyraża oczekiwanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed2cc4c2-3b97-306d-8b9e-02ca593c59b6",
                    "sense_definition": "Generally believed or claimed to be true, though often without proof or certainty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alleged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>supposed</w> expert could not answer even the most basic questions.",
                            "target_lang_translations": {
                                "ru": "Этот <w>мнимый</w> эксперт не смог ответить даже на самые простые вопросы.",
                                "pl": "<w>Rzekomy</w> ekspert nie potrafił odpowiedzieć nawet na najbardziej podstawowe pytania."
                            }
                        },
                        {
                            "text": "Scientists found no evidence for the <w>supposed</w> benefits of the treatment.",
                            "target_lang_translations": {
                                "ru": "Ученые не нашли доказательств <w>предполагаемой</w> пользы этого лечения.",
                                "pl": "Naukowcy nie znaleźli dowodów na <w>domniemane</w> korzyści płynące z tego leczenia."
                            }
                        }
                    ],
                    "synonyms": [
                        "reputed"
                    ],
                    "common_phrases": [
                        "supposed threat",
                        "supposed origin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считающийся таковым или заявленный как истинный, часто без доказательств.",
                        "pl": "Powszechnie uważany za prawdziwy, choć często bez dowodów lub pewności."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагаемый",
                                "target_lang_sense_clarification": "вероятный, ожидаемый"
                            },
                            {
                                "target_lang_word": "мнимый",
                                "target_lang_sense_clarification": "ложный, ненастоящий"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rzekomy",
                                "target_lang_sense_clarification": "często sugerujący brak prawdziwości"
                            },
                            {
                                "target_lang_word": "domniemany",
                                "target_lang_sense_clarification": "oparty na przypuszczeniu"
                            },
                            {
                                "target_lang_word": "przypuszczalny",
                                "target_lang_sense_clarification": "prawdopodobny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ae4deb0-5196-3bb8-83b2-21c48cb57106",
                    "sense_definition": "Simple past and past participle of <w>suppose</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>supposed</w> that he would be late again given the traffic.",
                            "target_lang_translations": {
                                "ru": "Я <w>предполагал</w>, что он снова опоздает из-за пробок.",
                                "pl": "<w>Przypuszczałem</w>, że znów się spóźni, biorąc pod uwagę korki."
                            }
                        },
                        {
                            "text": "It was generally <w>supposed</w> that the plan would fail without more funding.",
                            "target_lang_translations": {
                                "ru": "В целом <w>предполагалось</w>, что план провалится без дополнительного финансирования.",
                                "pl": "Powszechnie <w>sądzono</w>, że plan nie powiedzie się bez dodatkowego finansowania."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола suppose.",
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'suppose'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагал",
                                "target_lang_sense_clarification": "думал, считал возможным"
                            },
                            {
                                "target_lang_word": "полагал",
                                "target_lang_sense_clarification": "считал, имел мнение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przypuszczać",
                                "target_lang_sense_clarification": "zakładać coś"
                            },
                            {
                                "target_lang_word": "sądzić",
                                "target_lang_sense_clarification": "mieć opinię"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}