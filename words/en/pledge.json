{
    "word_family": [
        "pledger",
        "pledgee"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3a3b37e-2710-3b69-9a64-f795f286225d",
                    "sense_definition": "A solemn promise to do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "promise_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president unveiled the <w>pledge</w> to reduce pollution at the summit.",
                            "target_lang_translations": {
                                "ru": "На саммите президент обнародовал <w>обязательство</w> по снижению уровня загрязнения.",
                                "de": "Der Präsident stellte auf dem Gipfel das <w>Versprechen</w> vor, die Umweltverschmutzung zu verringern."
                            }
                        },
                        {
                            "text": "She made a solemn <w>pledge</w> to support the charity for another year.",
                            "target_lang_translations": {
                                "ru": "Она дала торжественное <w>обещание</w> поддерживать благотворительную организацию ещё один год.",
                                "de": "Sie gab das feierliche <w>Versprechen</w>, die Wohltätigkeitsorganisation ein weiteres Jahr zu unterstützen."
                            }
                        }
                    ],
                    "synonyms": [
                        "commitment",
                        "undertaking"
                    ],
                    "common_phrases": [
                        "make a pledge",
                        "campaign pledge",
                        "sign a pledge",
                        "take the pledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торжественное обещание или обязательство сделать что-либо.",
                        "de": "Ein feierliches Versprechen, etwas zu tun."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обещание",
                                "target_lang_sense_clarification": "торжественное"
                            },
                            {
                                "target_lang_word": "обязательство",
                                "target_lang_sense_clarification": "официальное"
                            },
                            {
                                "target_lang_word": "клятва",
                                "target_lang_sense_clarification": "священная или очень серьезная"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gelöbnis",
                                "target_lang_sense_clarification": "feierliches, eher gehobenes Versprechen"
                            },
                            {
                                "target_lang_word": "Versprechen",
                                "target_lang_sense_clarification": "allgemein und sehr natürlich"
                            },
                            {
                                "target_lang_word": "feierliche Zusage",
                                "target_lang_sense_clarification": "besonders feierlich oder förmlich"
                            },
                            {
                                "target_lang_word": "Schwur",
                                "target_lang_sense_clarification": "sehr stark, oft eidähnlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ec0b018-a2b2-3922-8a44-b8e155df2d90",
                    "sense_definition": "Something valuable given as a guarantee that a debt will be paid or a promise kept.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "security_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left his gold watch as a <w>pledge</w> that he would return with the money.",
                            "target_lang_translations": {
                                "ru": "Он оставил свои золотые часы в <w>залог</w> того, что вернётся с деньгами.",
                                "de": "Er ließ seine goldene Uhr als <w>Pfand</w> dafür zurück, dass er mit dem Geld wiederkommen würde."
                            }
                        },
                        {
                            "text": "The bank holds the property as a <w>pledge</w> against the loan.",
                            "target_lang_translations": {
                                "ru": "Банк удерживает недвижимость в качестве <w>залога</w> под кредит.",
                                "de": "Die Bank hält die Immobilie als <w>Pfand</w> für den Kredit."
                            }
                        }
                    ],
                    "synonyms": [
                        "collateral"
                    ],
                    "common_phrases": [
                        "hold in pledge",
                        "give as a pledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценная вещь, передаваемая в качестве гарантии возврата долга или выполнения обещания.",
                        "de": "Ein Wertgegenstand, der als Sicherheit dafür gegeben wird, dass eine Schuld bezahlt oder ein Versprechen eingehalten wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "залог",
                                "target_lang_sense_clarification": "гарантия выплаты"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Pfand",
                                "target_lang_sense_clarification": "Wertgegenstand als Sicherheit für eine Schuld oder Verpflichtung"
                            },
                            {
                                "target_lang_word": "Sicherheit",
                                "target_lang_sense_clarification": "betont die Funktion als Sicherung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4187c621-1feb-3252-9b0c-b8262345f14d",
                    "sense_definition": "A person who has taken a pledge of allegiance to a college fraternity, but is not yet formally approved.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fraternity_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>pledge</w>, he had to clean the fraternity house every weekend.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>кандидатом</w>, он должен был убирать дом братства каждые выходные.",
                                "de": "Als <w>Anwärter</w> musste er jedes Wochenende das Verbindungshaus putzen."
                            }
                        },
                        {
                            "text": "The <w>pledge</w> was excited to finally become a full brother next semester.",
                            "target_lang_translations": {
                                "ru": "<w>Новичок</w> был в восторге от того, что в следующем семестре наконец станет полноправным братом.",
                                "de": "Der <w>Anwärter</w> freute sich darauf, im nächsten Semester endlich ein vollwertiges Mitglied zu werden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fraternity pledge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который выразил желание вступить в студенческое братство, но еще не был официально принят.",
                        "de": "Eine Person, die einer College-Verbindung Beitrittstreue zugesagt hat, aber noch nicht offiziell als volles Mitglied aufgenommen ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кандидат",
                                "target_lang_sense_clarification": "в члены братства"
                            },
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "испытуемый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Anwärter",
                                "target_lang_sense_clarification": "allgemein: noch nicht voll aufgenommenes Mitglied einer Verbindung"
                            },
                            {
                                "target_lang_word": "Fuchs",
                                "target_lang_sense_clarification": "in deutschsprachigen Studentenverbindungen; kulturell nicht völlig deckungsgleich"
                            },
                            {
                                "target_lang_word": "Neumitglied",
                                "target_lang_sense_clarification": "betont den vorläufigen Status"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13c9a1e1-41db-3220-a2a0-b72ca7102610",
                    "sense_definition": "To make a solemn promise to do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "promise_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>pledged</w> millions of dollars for disaster relief.",
                            "target_lang_translations": {
                                "ru": "Правительство <w>пообещало выделить</w> миллионы долларов на помощь пострадавшим от стихийных бедствий.",
                                "de": "Die Regierung <w>versprach</w> Millionen Dollar für die Katastrophenhilfe."
                            }
                        },
                        {
                            "text": "Students stand up to <w>pledge</w> allegiance to the flag every morning.",
                            "target_lang_translations": {
                                "ru": "Каждое утро ученики встают, чтобы <w>поклясться</w> в верности флагу.",
                                "de": "Die Schüler stehen jeden Morgen auf, um der Flagge <w>Treue</w> zu <w>geloben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "undertake"
                    ],
                    "common_phrases": [
                        "pledge allegiance",
                        "pledge support",
                        "pledge money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать торжественное обещание сделать что-либо.",
                        "de": "Feierlich versprechen, etwas zu tun."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обещать",
                                "target_lang_sense_clarification": "давать слово"
                            },
                            {
                                "target_lang_word": "клясться",
                                "target_lang_sense_clarification": "в верности"
                            },
                            {
                                "target_lang_word": "обязываться",
                                "target_lang_sense_clarification": "брать на себя обязательство"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "versprechen",
                                "target_lang_sense_clarification": "allgemein und am häufigsten"
                            },
                            {
                                "target_lang_word": "geloben",
                                "target_lang_sense_clarification": "feierlich oder offiziell"
                            },
                            {
                                "target_lang_word": "schwören",
                                "target_lang_sense_clarification": "stärker, oft in festen Wendungen wie Treue schwören"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0590532-cc7d-3e32-9177-6e8da843b806",
                    "sense_definition": "To deposit something as a security for a loan or agreement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "security_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pledged</w> his family heirlooms to pay off the gambling debt.",
                            "target_lang_translations": {
                                "ru": "Он <w>заложил</w> свои семейные реликвии, чтобы расплатиться с игорным долгом.",
                                "de": "Er <w>verpfändete</w> seine Familienerbstücke, um die Spielschulden zu bezahlen."
                            }
                        },
                        {
                            "text": "The company <w>pledged</w> its assets to secure the new business loan.",
                            "target_lang_translations": {
                                "ru": "Компания <w>отдала в залог</w> свои активы для обеспечения нового бизнес-кредита.",
                                "de": "Das Unternehmen <w>hinterlegte</w> seine Vermögenswerte als Sicherheit für den neuen Geschäftskredit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pledge assets",
                        "pledge property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать что-либо в качестве обеспечения займа или соглашения.",
                        "de": "Etwas als Sicherheit für ein Darlehen oder eine Vereinbarung hinterlegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закладывать",
                                "target_lang_sense_clarification": "имущество"
                            },
                            {
                                "target_lang_word": "отдавать в залог",
                                "target_lang_sense_clarification": "фразовый глагол"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verpfänden",
                                "target_lang_sense_clarification": "etwas als Pfand geben, besonders für Geld"
                            },
                            {
                                "target_lang_word": "als Sicherheit hinterlegen",
                                "target_lang_sense_clarification": "allgemeiner in Finanz- und Vertragssprache"
                            },
                            {
                                "target_lang_word": "als Sicherheit einsetzen",
                                "target_lang_sense_clarification": "juristisch und wirtschaftlich gebräuchlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a307c28-5778-3563-89d2-d00efd669d71",
                    "sense_definition": "To give assurance of friendship by the act of drinking; to drink to one's health.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "toast_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight raised his goblet to <w>pledge</w> the king at the feast.",
                            "target_lang_translations": {
                                "ru": "Рыцарь поднял кубок, чтобы <w>выпить за здоровье</w> короля на пиру.",
                                "de": "Der Ritter hob beim Fest seinen Kelch, um dem König <w>zuzutrinken</w>."
                            }
                        },
                        {
                            "text": "I <w>pledge</w> you in this wine for your safe return home.",
                            "target_lang_translations": {
                                "ru": "Я <w>поднимаю тост</w> этим вином за твоё благополучное возвращение домой.",
                                "de": "Ich <w>trinke</w> dir mit diesem Wein auf deine sichere Heimkehr <w>zu</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пить за чье-либо здоровье или в знак дружбы.",
                        "de": "Jemandem durch Zutrinken Freundschaft oder gute Wünsche bekunden; auf das Wohl einer Person trinken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пить за здоровье",
                                "target_lang_sense_clarification": "произносить тост"
                            },
                            {
                                "target_lang_word": "провозглашать тост",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zutrinken",
                                "target_lang_sense_clarification": "gehoben oder altertümlich: jemandem beim Trinken ehren"
                            },
                            {
                                "target_lang_word": "auf die Gesundheit anstoßen",
                                "target_lang_sense_clarification": "die Gesundheit einer Person mit einem Getränk feiern"
                            },
                            {
                                "target_lang_word": "Brüderschaft trinken",
                                "target_lang_sense_clarification": "stärker mit sozialem Ritual des gemeinsamen Trinkens"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}