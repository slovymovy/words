                                    {
                                        "sense_id": "ac8c8b7f-2077-3007-b8c6-b61dcb968086",
                                        "entry_id": "f0e12b8c-499d-3d52-af22-90b9c5307493",
                                        "glosses": [
                                            "Staat im Süden der Arabischen Halbinsel"
