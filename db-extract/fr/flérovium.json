                        "sense_id": "8f075f15-03fb-35e0-873c-68106415b42a",
                        "entry_id": "5f558a70-8ebf-35ea-8581-d525160f3428",
                        "glosses": [
                            "Élément chimique portant le numéro atomique 114 et le symbole Fl, qui a été synthétisé pour la première fois en 1999 à Doubna, en Russie."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "3378d4d3-6e77-4a93-a67c-dc007d4a3d4a",
                                "sense_id": "8f075f15-03fb-35e0-873c-68106415b42a",
                                "text": "L’élément le plus lourd dont les propriétés chimiques ont été étudiées est le flérovium (l’élément 114, noté Fl), synthétisé pour la première fois en 1998."
                            },
                            {
                                "example_id": "ae8c808e-b41b-40a0-9e81-58677e8c9126",
                                "sense_id": "8f075f15-03fb-35e0-873c-68106415b42a",
                                "text": "Le flérovium-289 a une demi-vie de 2,6 secondes."
                            }
                        ]
                    }
                ],
