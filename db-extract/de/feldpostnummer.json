                "senses": [
                    {
                        "sense_id": "79910a03-542e-348c-8e86-bb43c536a201",
                        "entry_id": "d8019877-76ab-32e1-9040-b16e89c609d8",
                        "glosses": [
                            "Nummer für die Feldpost, die für jede militärische Einheit festgelegt war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8591e089-6723-4931-8e21-bc0d39948c5b",
                                "sense_id": "79910a03-542e-348c-8e86-bb43c536a201",
                                "text": "„An den Türen die vertraute Feldpostnummer.“"
                            },
                            {
                                "example_id": "791ad5a7-6f48-472d-bfa0-eed0fa435eb7",
                                "sense_id": "79910a03-542e-348c-8e86-bb43c536a201",
                                "text": "„Seit dem 1. Januar 2005 hat aber auch die Feldpost auf ein geordnetes System umgestellt, so dass seither aus der Feldpostnummer auf den Einsatz geschlossen werden kann.“"
                            },
                            {
                                "example_id": "7eec43ad-189e-41ce-9acf-9677feaea135",
                                "sense_id": "79910a03-542e-348c-8e86-bb43c536a201",
                                "text": "„Sie vereinbarten, daß Käthe den Versuch machen würde, ihn einmal zu treffen, in Köln vielleicht, falls er Urlaub bekäme. Hin- und Hergerede darüber, wie sie, während ihrer Reise, Post von ihm bekommen, seine Feldpostnummer erfahren würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
