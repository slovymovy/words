                "senses": [
                    {
                        "sense_id": "8d3a9074-646e-31f9-a30c-521753fca7e2",
                        "entry_id": "01b9e4cc-44c2-3348-8dbb-87c277db33fa",
                        "glosses": [
                            "Nuage dense et haut, donnant des orages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0964b6c-38b3-46b8-9c01-262598f38a55",
                                "sense_id": "8d3a9074-646e-31f9-a30c-521753fca7e2",
                                "text": "Le chasseur de nuages peut distinguer un cumulonimbus de son jeune frère,le cumulus congestus, en examinant avec attention la partie supérieure du nuage."
                            },
                            {
                                "example_id": "4fe06d61-27a0-4902-b735-d16c1be91b6b",
                                "sense_id": "8d3a9074-646e-31f9-a30c-521753fca7e2",
                                "text": "Une tornade se forme lors d’orage violent. C’est un puissant tourbillon d’air ascendant en entonnoir, dont le diamètre est généralement compris entre 50 et 1000 m. Elle prend naissance à la base d’un énorme nuage le Cumulonimbus. Le cumulonimbus pompe l’air chaud et humide des basses couches de l’atmosphère."
                            }
                        ]
                    }
                ],
