                                            },
                                            {
                                                "example_id": "cc0000ad-f86d-4d47-9c2b-a879e3a5ad46",
                                                "sense_id": "77b69c26-8c2f-37a0-a53f-4e32604b2b53",
                                                "text": "„Ionosphärische Störungen können die Satellitennavigation, die Kommunikation und die Radioastronomie beeinträchtigen.“"
