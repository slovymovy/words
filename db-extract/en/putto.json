                                "target_senses": [
                                    {
                                        "sense_id": "ca34d09a-c9e9-3fa8-a25e-ff287ab64736",
                                        "entry_id": "390c5b0d-6fc9-35fd-bec3-7f7e5a2a9d87",
                                        "glosses": [
                                            "Bezeichnung für die Figur eines kleinen nackten Knaben"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f72024ee-24ac-4867-a871-14b17c21efa2",
                                                "sense_id": "ca34d09a-c9e9-3fa8-a25e-ff287ab64736",
                                                "text": "In manchen Kirchen finden sich mehrere hundert Putten, die Altäre, Orgeln, Geländer, Gesimse, Plastiken und Fresken schmücken."
                                            },
                                            {
                                                "example_id": "5ce66beb-2067-4061-ae59-9b6f0c0e68f2",
                                                "sense_id": "ca34d09a-c9e9-3fa8-a25e-ff287ab64736",
                                                "text": "„Die Luftverschmutzung hatte die prallen Pobacken der Putten auf den Balustraden geschwärzt.“"
                                            },
                                            {
                                                "example_id": "49f6b8e1-50b2-408c-90d1-40cb91254a63",
                                                "sense_id": "ca34d09a-c9e9-3fa8-a25e-ff287ab64736",
                                                "text": "„Pajot ist Schriftsteller, klein, das Gesicht einer Putte mit Schnurrbart, enorm dick.“"
                                            },
                                            {
                                                "example_id": "2a026918-6c4c-41d9-8972-53b099a3dd25",
                                                "sense_id": "ca34d09a-c9e9-3fa8-a25e-ff287ab64736",
                                                "text": "„Er redet wie einer, der notorisch Putten betrachtet und sagt, die abstrakte Schönheit allein sei's.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7eddb4f-8f49-4e5d-ab18-7b530c1ffb28",
                        "source_entry_id": "a032586d-55fa-3cb9-a0da-df958c3767ae",
                        "source_sense_id": "a6acde49-e441-39c2-ace9-7bf0f289c1ec",
                        "source_sense_description": "representation of a small, naked, often winged child",
                        "target_lang_word": "Amorette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amorette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e04873c8-d4dc-3a6f-a2b6-1e40d183ad7f",
                                        "entry_id": "c51157ba-6529-3cf1-82eb-50b434684ed8",
                                        "glosses": [
                                            "Darstellung des Liebesgottes Amor"
                                        ],
                                        "tags": [
                                            "römische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "234a3ad3-1978-46f6-b462-24e58a4d5769",
                                                "sense_id": "e04873c8-d4dc-3a6f-a2b6-1e40d183ad7f",
                                                "text": "„Ob in den französischen Gärten des Barock oder in den englischen Gärten der Romantik und des frühindustriellen Zeitalters: Gartenbänke ohne Rückenlehne waren so widersinnig wie eine Amorette ohne Putten.“"
                                            },
                                            {
                                                "example_id": "4551298b-47dd-49dc-af7f-50bffcaeb705",
                                                "sense_id": "e04873c8-d4dc-3a6f-a2b6-1e40d183ad7f",
                                                "text": "„Daß der geflügelte Amorknabe einen in der Kunst der Neuzeit so gut wie nie dargestellten Widersacher hatte, veranschaulicht in der Florentiner Galerie Il Cartiglio eine von Giuseppe Plamontini geschaffene Marmorskulptur mit zwei sich einander bekämpfenden Amoretten, die Eros und Anteros verkörpern und somit in der Art einer Allegorie den Streit zwischen ‚Himmlischer und Irdischer Liebe‘ vorstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
