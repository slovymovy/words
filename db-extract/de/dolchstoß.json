                "senses": [
                    {
                        "sense_id": "c0ef28bf-fe61-3331-a0f7-91942e143873",
                        "entry_id": "6f92cc8a-f328-3960-ab42-f3853b60959b",
                        "glosses": [
                            "das Zustechen mit einem Dolch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2ecde3-403e-4bb4-8a0e-8415332a3317",
                                "sense_id": "c0ef28bf-fe61-3331-a0f7-91942e143873",
                                "text": "Er wurde mit einem Dolchstoß getötet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "30cfb309-0eb7-3eb0-a6b4-18c43be0fe12",
                        "entry_id": "6f92cc8a-f328-3960-ab42-f3853b60959b",
                        "glosses": [
                            "hinterhältiger Angriff auf jemanden oder etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "2fec9aaa-320b-4936-81ae-b49a5d7ffd5b",
                                "sense_id": "30cfb309-0eb7-3eb0-a6b4-18c43be0fe12",
                                "text": "Der Verrat war ein Dolchstoß gegen die Revolution."
                            },
                            {
                                "example_id": "6118cb58-1a1a-4e51-ba78-308b4aa2c771",
                                "sense_id": "30cfb309-0eb7-3eb0-a6b4-18c43be0fe12",
                                "text": "„Er donnert mächtig von der Tribüne und ist bereits beim inneren Schweinehund angekommen, beim Dolchstoß in den Rücken, bei der unbesiegten deutschen Armee und beim Gelöbnis für unsere toten Helden, die zu ehren, sie zu rächen und die deutsche Armee wieder aufzubauen.“"
                            },
                            {
                                "example_id": "b84efa15-b1ca-4149-998a-7db469adca2b",
                                "sense_id": "30cfb309-0eb7-3eb0-a6b4-18c43be0fe12",
                                "text": "„Der Dolchstoß kommt später, wenn man ihn am wenigsten erwartet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
