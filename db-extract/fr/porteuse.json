                                        "sense_id": "d3fce345-ec94-3a30-9c48-6f724618b042",
                                        "entry_id": "dc6a14de-d4d9-3342-99c9-c4663e255214",
                                        "glosses": [
                                            "A person or object that carries someone or something else."
                                        ],
                                        "tags": [],
