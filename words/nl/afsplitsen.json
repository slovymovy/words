{
    "word_family": [
        "splitsing",
        "afsplitsing",
        "splitsen",
        "gespleten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46cf6dd4-156b-32c9-ab6a-fb392e60db9a",
                    "sense_definition": "het scheiden van een deel van een groter geheel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "scheiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wetenschapper probeert een klein deeltje van de hoofdmassa <w>af</w> te <w>splitsen</w> voor onderzoek.",
                            "target_lang_translations": {
                                "en": "The scientist is trying to <w>split off</w> a small particle from the main mass for research."
                            }
                        },
                        {
                            "text": "Je kunt een stukje deeg <w>afsplitsen</w> om er een klein broodje van te bakken.",
                            "target_lang_translations": {
                                "en": "You can <w>separate</w> a piece of dough to bake a small roll from it."
                            }
                        }
                    ],
                    "synonyms": [
                        "afscheiden",
                        "losmaken"
                    ],
                    "antonyms": [
                        "samenvoegen",
                        "verbinden"
                    ],
                    "common_phrases": [
                        "een deel afsplitsen"
                    ],
                    "target_lang_definitions": {
                        "en": "the separation of a part from a larger whole"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to split off",
                                "target_lang_sense_clarification": "separating a physical part from a whole"
                            },
                            {
                                "target_lang_word": "to separate",
                                "target_lang_sense_clarification": "general act of detaching a portion"
                            },
                            {
                                "target_lang_word": "to detach",
                                "target_lang_sense_clarification": "removing a smaller piece from a main body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "525de54a-675c-38c1-a2ec-0c0266a6c8d8",
                    "sense_definition": "zich formeel of politiek van een grotere organisatie of groep losmaken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scheiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanochtend maakten de dissidenten bekend dat zij zich <w>afsplitsen</w> van de politieke partij.",
                            "target_lang_translations": {
                                "en": "This morning the dissidents announced that they are <w>breaking away</w> from the political party."
                            }
                        },
                        {
                            "text": "Er ontstond grote onrust nadat geruchten gingen dat de lokale afdeling zich wilde <w>afsplitsen</w>.",
                            "target_lang_translations": {
                                "en": "Great unrest arose after rumors spread that the local branch wanted to <w>splinter off</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "secederen",
                        "uittreden"
                    ],
                    "antonyms": [
                        "aansluiten",
                        "fuseren"
                    ],
                    "common_phrases": [
                        "zich afsplitsen van"
                    ],
                    "target_lang_definitions": {
                        "en": "to formally or politically break away from a larger organization or group"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to break away",
                                "target_lang_sense_clarification": "leaving a group to become independent"
                            },
                            {
                                "target_lang_word": "to splinter off",
                                "target_lang_sense_clarification": "a group dividing into smaller, often opposing factions"
                            },
                            {
                                "target_lang_word": "to secede",
                                "target_lang_sense_clarification": "formal withdrawal from an organization or state"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}