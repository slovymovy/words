                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b14ebade-79d0-4b0a-ae8a-212365bd6dd7",
                                "sense_id": "8ec0392a-911d-3236-9240-4d23ab88237f",
                                "text": "Je vais tubophoner au Tunisien qu’il ne nous attende pas toute la nuit, et après, on rentre."
                            },
                            {
                                "example_id": "ce871972-646e-4383-a9af-26937314ff62",
                                "sense_id": "8ec0392a-911d-3236-9240-4d23ab88237f",
                                "text": "Inquiétée par son absence, la Charretier a tubophoné aux Malapry où Bernard, le camarade d’études, a raconté ce qui venait de se passer."
                            }
                        ]
                    }
