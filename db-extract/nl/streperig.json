                ],
                "senses": [
                    {
                        "sense_id": "b4fea5d1-efc9-31fc-947a-8de39d32f5ed",
                        "entry_id": "6783046f-f526-38c7-8bad-409b171bfabb",
                        "glosses": [
                            "met strepen, strepen vertonend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e40d111f-ee10-4589-b8c1-3e425d130d69",
                                "sense_id": "b4fea5d1-efc9-31fc-947a-8de39d32f5ed",
                                "text": "Mijn oude huis ziet er vanavond uit als een spookhuis, met op de achtergrond de streperige gloed van Toronto. De sterren zitten als vuurvliegjes gekooid in het vlechtwerk van takken. 'Koplampen uit, radio uit; beveel ik de auto, waarop From Me Flows What You Call Time van Toru Takemitsu midden in een frase stilvalt."
                            },
                            {
                                "example_id": "19ea2a8a-5e2f-407f-93a4-bf3033a329fb",
                                "sense_id": "b4fea5d1-efc9-31fc-947a-8de39d32f5ed",
                                "text": "'s Avonds begon het te regenen. Wantrouwig tuurde ik het donker in. De volgende ochtend waren mijn ramen streperige zandwoestijnen. Dat zijn ze lang gebleven."
                            },
                            {
                                "example_id": "efdd0f6f-2360-496d-bd08-695346bd7ec6",
                                "sense_id": "b4fea5d1-efc9-31fc-947a-8de39d32f5ed",
                                "text": "Rond de eeuwwisseling was Howard niet de enige die, in het voetspoor van de encyclopedisten, aan een classificatie van wolken werkte. Eerder hadden andere wetenschappers logboeken bijgehouden van het weer. Ze zochten een taal voor hun wetenschappelijke observaties. De hemel was 'sponsachtig', 'gestreept', 'gegolfd', 'laaghangend'of 'bewolkt'; de wolken waren 'harig'of 'golvend', 'streperig', 'melkachtig'of 'heiig'. Je had 'wolkennevels', 'wolken als bezems'of 'gespikkelde wolken'; er waren 'schapenwolkjes'en 'stapelwolken', 'krulwolken', 'slinkwolken', 'valwolken'en 'vlechtwolken'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c92eef4-db43-4f75-9319-24857d958be3",
                        "source_entry_id": "6783046f-f526-38c7-8bad-409b171bfabb",
                        "source_sense_id": "b4fea5d1-efc9-31fc-947a-8de39d32f5ed",
                        "source_sense_description": "met strepen",
                        "target_lang_word": "streaky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "streaky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ffc510-9738-365a-a959-057a86a4b7bf",
                                        "entry_id": "cb3f3859-5c29-31b1-a8dc-71a4bff50af2",
                                        "glosses": [
                                            "Having streaks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74bf2369-f276-3303-8c89-9a5ecc7f404e",
                                        "entry_id": "cb3f3859-5c29-31b1-a8dc-71a4bff50af2",
                                        "glosses": [
                                            "Used to describe a shot where the ball deflects off the edge of the bat, but is not caught by the slips or wicket-keeper and instead results in runs for the batsman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36e1b6e5-4a18-4824-a9a8-e1e7eda42c70",
                                                "sense_id": "74bf2369-f276-3303-8c89-9a5ecc7f404e",
                                                "text": "Although the two added thirteen important runs, including four byes let through by Mongia and a streaky outside edge cum late-cut by Pollock for four, one didn't need to be blessed with gifts of insight to realise that Pollock's days at the crease were numbered."
                                            },
                                            {
                                                "example_id": "cac12b75-2b73-48fd-81ce-3e4140f26a96",
                                                "sense_id": "74bf2369-f276-3303-8c89-9a5ecc7f404e",
                                                "text": "...rather than hitting it with the middle of the bat, I jagged it off the inside edge and French-cut it over the top of the stumps for another four. That was the only streaky shot I can remember."
                                            },
                                            {
                                                "example_id": "5ecc03db-9e44-4c71-9e6f-af5d19b0ad53",
                                                "sense_id": "74bf2369-f276-3303-8c89-9a5ecc7f404e",
                                                "text": "Compton troubled Bradman with his Chinaman, and one streaky shot was edged past Crapp at slips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c505b0a4-2943-391e-98aa-2cc6b56ccf62",
                                        "entry_id": "cb3f3859-5c29-31b1-a8dc-71a4bff50af2",
                                        "glosses": [
                                            "Unpredictable, variable; having periods of good and bad (e.g. weather)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed14c71-3bd9-4971-b62a-8f9dfc0ae71c",
                                                "sense_id": "c505b0a4-2943-391e-98aa-2cc6b56ccf62",
                                                "text": "[…] to do his duty in the face of uncommonly streaky weather like a man."
                                            },
                                            {
                                                "example_id": "a2411d84-13ec-461a-b6f9-0d4dab1ca57d",
                                                "sense_id": "c505b0a4-2943-391e-98aa-2cc6b56ccf62",
                                                "text": "[Nebraska] has a reputation for streaky weather, long stretches of drouth and long seasons of rain."
                                            },
                                            {
                                                "example_id": "812dd29c-6c5f-4bc3-be25-8d00d4a370d5",
                                                "sense_id": "c505b0a4-2943-391e-98aa-2cc6b56ccf62",
                                                "text": "It was one of those streaky days you often find at the end of a Kerry winter, with little spurts of cold rain and puffs of chilling wind and now and then glimpses of weak sunshine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99435be5-dbdb-3180-a86a-b549999a0904",
                                        "entry_id": "cb3f3859-5c29-31b1-a8dc-71a4bff50af2",
                                        "glosses": [
                                            "Having alternating periods of good and bad performances; inconsistent."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e775d6b-5527-4e1b-80cc-cc3cb8f461ea",
                                                "sense_id": "99435be5-dbdb-3180-a86a-b549999a0904",
                                                "text": "Jones has always been a streaky hitter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757ad690-ee9f-36fe-8e96-212aa9bae19d",
                                        "entry_id": "cb3f3859-5c29-31b1-a8dc-71a4bff50af2",
                                        "glosses": [
                                            "Having periods of irritation or bad temper."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ad7fdd5-bbfb-3ae8-bd28-aa7ba76f142d",
                                        "entry_id": "cb3f3859-5c29-31b1-a8dc-71a4bff50af2",
                                        "glosses": [
                                            "Not well-executed, due to luck more than skill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b20e704-39a4-49b9-bb3a-51e48a47e313",
                                                "sense_id": "7ad7fdd5-bbfb-3ae8-bd28-aa7ba76f142d",
                                                "text": "Two goals from Alexis Sánchez, the second a little streakier than the first, were enough to send Arsenal into a second successive FA Cup final, once again following extra time after being held over 90 minutes by a Championship side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
