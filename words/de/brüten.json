                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Amsel <w>brütet</w> jedes Frühjahr in der dichten Hecke unseres Gartens."
                        },
                        {
                            "text": "Viele Vögel <w>brüten</w> mehrere Wochen lang geduldig auf ihren Eiern."
                        }
                    ],
                    "common_phrases": [
                        "Eier brüten",
                        "im Nest brüten"
                    ]
                },
                {
                    "sense_id": "b2cc4aa9-f670-3f6f-82d1-0ce8e52f555a",
                    "sense_definition": "Sehr angestrengt und intensiv über ein Problem, eine Idee oder eine Lösung nachdenken.",
