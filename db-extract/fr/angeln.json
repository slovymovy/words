                "entry_id": "b9826c85-a0be-3e10-b00e-085b4dedc807",
                "word": "Angeln",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "89eb2209-6d68-31b8-816a-d93ff2f7b293",
                        "entry_id": "b9826c85-a0be-3e10-b00e-085b4dedc807",
                        "glosses": [
                            "Péninsule de la côte Est du Schleswig, en Allemagne, bordée par la baie de Kiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "948c21f4-54bf-433f-b5fb-7237864310d8",
                                "sense_id": "89eb2209-6d68-31b8-816a-d93ff2f7b293",
                                "text": "Les Angles, peuple germanique qui a donné son nom à l’Angleterre sont originaires de la péninsule d’Angeln."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "323fdef2-19af-43fa-baba-efab8262537d",
                        "source_entry_id": "b9826c85-a0be-3e10-b00e-085b4dedc807",
                        "source_sense_id": "89eb2209-6d68-31b8-816a-d93ff2f7b293",
