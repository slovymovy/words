                        "entry_id": "3ebe9636-2ddd-3ce6-a7c7-40d466c7c517",
                        "glosses": [
                            "To spawn again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c74c7f0e-9fc8-4d93-9f80-3c16fb29f987",
                                "sense_id": "6d212605-4658-3ea6-a9ae-de6cb73f3b98",
                                "text": "This diminishes even further the remote chance of the fish surviving to respawn."
                            }
                        ]
                    },
                    {
                        "sense_id": "00c9fe72-5bd9-33d4-86a6-9de5c7564926",
                        "entry_id": "3ebe9636-2ddd-3ce6-a7c7-40d466c7c517",
                        "glosses": [
                            "To reappear at its spawn point."
                        ],
                        "tags": [
                            "of a collected item"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8b4be234-9e1b-318f-96f1-984b1c0cf0f5",
                        "entry_id": "3ebe9636-2ddd-3ce6-a7c7-40d466c7c517",
                        "glosses": [
                            "To re-enter play after being killed, often where the game was last saved."
                        ],
                        "tags": [
                            "of a character"
                        ],
                        "examples": [
                            {
                                "example_id": "0bddccf5-6638-4efb-b258-772eb231ea3a",
                                "sense_id": "8b4be234-9e1b-318f-96f1-984b1c0cf0f5",
                                "text": "Some top 100 websites are circumventing user deletion of HTTP cookies by respawning them using Flash cookies with identical values, […]"
                            },
                            {
                                "example_id": "8ebaf8b7-c4d2-456f-92d0-a6b84a63eec5",
                                "sense_id": "8b4be234-9e1b-318f-96f1-984b1c0cf0f5",
                                "text": "How and why he gets stuck in this constant respawn cycle is a bit unclear, […]"
                            },
                            {
                                "example_id": "c3c5dcd7-01d2-4783-a296-4b926f1412d3",
                                "sense_id": "8b4be234-9e1b-318f-96f1-984b1c0cf0f5",
                                "text": "“Everything in this cult of personality is fragile,” Borkowski said, but added that Musk had proven before that he can “re-spawn” when he encountered difficulties."
                            }
                        ]
                    }
                ],
