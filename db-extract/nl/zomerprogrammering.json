                            {
                                "example_id": "fae6666e-6bba-48c6-bdf6-79b3901b2759",
                                "sense_id": "df71ccff-de7e-3090-b44a-9ba7c9f9f815",
                                "text": "Oud RTL-baas Fons van Westerloo heeft zijn twijfels bij de nieuwe zomerprogrammering van de commerciële zender die de laatste tijd kampt met een kijkcijferdip."
                            },
                            {
                                "example_id": "fdf53e50-054c-41bd-a5a3-dfcde402f905",
                                "sense_id": "df71ccff-de7e-3090-b44a-9ba7c9f9f815",
                                "text": "De overkoepelende organisatie van de publieke omroep stelt dat zonder deze compensatie ‘eigenlijk zo’n beetje alle televisie- en radioprogramma’s het met minder budget zouden moeten doen’. Ook de dag- en zomerprogrammering kan voorlopig overeind blijven. De NPO hoopt dat de minister met een structurele oplossing komt voor het opvangen van de dalende advertentie-inkomsten zodat volgend jaar niet opnieuw een discussie over het budget plaatsvindt."
                            }
                        ]
                    },
