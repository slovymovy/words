                "senses": [
                    {
                        "sense_id": "9000bfb1-8972-3f10-977a-29b1956a7d4b",
                        "entry_id": "e0403b02-82f0-3828-a744-ae8d494ae24c",
                        "glosses": [
                            "vollständiger Name, ohne Auslassung/Kürzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd7dc4bb-6416-41a2-b353-410cbf8e81f6",
                                "sense_id": "9000bfb1-8972-3f10-977a-29b1956a7d4b",
                                "text": "„Er warnt vor allem vor der »Sucht«, die aus dem Indogermanischen ererbten Vollnamen immer deuten zu wollen (…).“"
                            },
                            {
                                "example_id": "46987c05-0b5e-48a2-968d-193d83b7f987",
                                "sense_id": "9000bfb1-8972-3f10-977a-29b1956a7d4b",
                                "text": "„Ľubotin- wird als Kurzform von Vollnamen wie Lubomir oder Luborad angesehen, welche das urslawische *ljubʺb ‚lieb‘ beinhalten.“"
                            },
                            {
                                "example_id": "8f629d33-7c33-42e6-b18b-e19928c70c25",
                                "sense_id": "9000bfb1-8972-3f10-977a-29b1956a7d4b",
                                "text": "„Es handelt sich wahrscheinlich um eine Kurzform von zweigliedrigen Vollnamen wie Giselhart oder Gisbert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
