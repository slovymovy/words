                        "entry_id": "145fcaf9-6c21-3dee-a2f0-d7d6c8d8f247",
                        "glosses": [
                            "Ensemble de saccules empilés les uns sur les autres formant l'une des composantes de l'appareil de Golgi, et qui est impliqué dans la modification post-traductionnelle (e.g. glycosylation, attachement de glycosaminoglycanes, etc.) des protéines synthétisées dans le réticulum endoplasmique, avant leur transport vers le feuillet externe de la membrane plasmique."
                        ],
                        "tags": [
                            "Biologie cellulaire"
                        ],
                        "examples": [
                            {
                                "example_id": "cd1b42ab-1b81-4c55-b3c4-9a2e84567429",
                                "sense_id": "9a499442-053d-342e-8825-7e3569b0c37c",
                                "text": "Le dictyosome est l’unité fonctionnelle de l’appareil de Golgi."
                            },
                            {
                                "example_id": "9204c86f-8559-4f9c-972c-21e7c0ac870d",
                                "sense_id": "9a499442-053d-342e-8825-7e3569b0c37c",
                                "text": "L’appareil de Golgi comporte un ou plusieurs dictyosomes, eux-mêmes incluant plusieurs lumières."
                            }
                        ]
                    }
