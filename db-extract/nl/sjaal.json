                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "szal",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "979d0005-aa16-3db1-a9aa-7ffc7277743b",
                                        "entry_id": "7b1238b9-e4c0-35f5-b4f8-e77e77c4d7bb",
                                        "glosses": [
                                            "prostokątny wyrób włókienniczy owijany wokół szyi i ramion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a0e03a8-7592-47a0-b3b4-27af0175071a",
                                                "sense_id": "979d0005-aa16-3db1-a9aa-7ffc7277743b",
                                                "text": "Żaneta przybyła na spotkanie w bogato zdobionym szalu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29a7b150-00d2-421d-a2ba-6720ce7f7a3a",
                        "source_entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
                        "source_sense_id": "b01ad822-7f5d-32fd-91ce-876ba89ce7e4",
                        "source_sense_description": "een langwerpige lap stof die om de hals gedragen wordt",
                        "target_lang_word": "шаль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шаль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c6f0807-d50f-3de9-b22d-2b41d07a50f6",
                                        "entry_id": "49d19db1-a249-37f5-8e57-e47e407c7bef",
                                        "glosses": [
                                            "большой вязаный или тканый платок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9154ab7-f0ad-46fb-9e38-caf7b4062a96",
                                                "sense_id": "5c6f0807-d50f-3de9-b22d-2b41d07a50f6",
                                                "text": "Я снял с неё скользкую от снега шубку, она сбросила с волос на руки мне мокрую пуховую шаль и быстро прошла, шурша нижней шёлковой юбкой, в спальню."
                                            },
                                            {
                                                "example_id": "2bcf8ff3-e991-4f5e-8967-edace4f72445",
                                                "sense_id": "5c6f0807-d50f-3de9-b22d-2b41d07a50f6",
                                                "text": "С плеч у нее свисала жёлтая сетчатая шаль."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "шаль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ecb19558-1f32-3d0f-a6cc-1298054558fa",
                                        "entry_id": "44620aca-1564-35d8-a624-af3445363fd4",
                                        "glosses": [
                                            "устар., рег. безрассудство, дурь, блажь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb4852e-5cf8-4e7e-8f63-7742277ea0e8",
                                                "sense_id": "ecb19558-1f32-3d0f-a6cc-1298054558fa",
                                                "text": "Опять за вином я послал и говорю невесте: «А что, мол, невестушка моя милая, не простишь ли ты мне шали моей пьяной вчерашней? Я бы, говорю, отходу тебе, что касается то-ись насчёт денег, не пожалел дать»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0556632a-5d75-3485-ae4f-5550b3a4af1c",
                                        "entry_id": "44620aca-1564-35d8-a624-af3445363fd4",
                                        "glosses": [
                                            "безрассудный поступок или слова, безрассудное поведение"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f03f9ea4-e0ca-4304-ab70-8bd7beffefe5",
                        "source_entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
                        "source_sense_id": "b01ad822-7f5d-32fd-91ce-876ba89ce7e4",
                        "source_sense_description": "een langwerpige lap stof die om de hals gedragen wordt",
                        "target_lang_word": "шарф",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шарф",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "51aa6879-c7c1-35f9-8307-fffdf061b5c2",
                                        "entry_id": "53974261-e7d7-36f9-ac15-be242aa7e836",
                                        "glosses": [
                                            "предмет одежды в виде длинной матерчатой или вязаной полосы, которым укрывают шею, голову, плечи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97369402-19bc-48fd-97dc-3f0eba9cb753",
                                                "sense_id": "51aa6879-c7c1-35f9-8307-fffdf061b5c2",
                                                "text": "Молодой регистратор, отплясывавший с дамой в голубом шарфе, во всех фигурах и во всех пяти кадрилях, которые протанцованы были в этот вечер, выкидывал всё одну и ту же штуку, а именно: он несколько отставал от своей дамы, подхватывал кончик её шарфа и на лету при переходе визави, успевал влеплять в этот кончик десятка два поцелуев."
                                            },
                                            {
                                                "example_id": "09382679-b870-45c0-a76b-e5275d57afb0",
                                                "sense_id": "51aa6879-c7c1-35f9-8307-fffdf061b5c2",
                                                "text": "Греми, моя арфа, ― // Исчез безвозвратно Игнатий Попов, // Без теплого шарфа, // С одною лишь парой холодных носков…"
                                            },
                                            {
                                                "example_id": "0ec99371-3bce-441d-8872-a7072cc2c914",
                                                "sense_id": "51aa6879-c7c1-35f9-8307-fffdf061b5c2",
                                                "text": "Сырая мягкость в воздухе глухом, // Шарфы стянувшая узлами."
                                            },
                                            {
                                                "example_id": "bf1eb22c-ce5b-4f04-9e2f-7af537bc2413",
                                                "sense_id": "51aa6879-c7c1-35f9-8307-fffdf061b5c2",
                                                "text": "Ответ лежит под белым дном, // Драконом невысоких гор, // Как дева на ветру шарфом, // загородился."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4686280-6438-3cbf-b7e2-80df6dec81d0",
                                        "entry_id": "53974261-e7d7-36f9-ac15-be242aa7e836",
                                        "glosses": [
                                            "истор. офицерский пояс или повязка через плечо георгиевского (чёрно-жёлто-серебристого) цвета, являвшиеся отличительным знаком воинских званий"
                                        ],
                                        "tags": [
                                            "в армии Российского государства до 1917 г."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2fdcbfc-eed7-4594-a29a-d331ced0db17",
                                                "sense_id": "d4686280-6438-3cbf-b7e2-80df6dec81d0",
                                                "text": "Начальники и офицеры имели знаки и шарфы сверх шуб по причине жестокого мороза."
                                            },
                                            {
                                                "example_id": "caa0dde5-3211-442f-bd29-207c96301549",
                                                "sense_id": "d4686280-6438-3cbf-b7e2-80df6dec81d0",
                                                "text": "Солдаты, видя его беспрестанно в шарфу, которого простые офицеры не носили во время экспедиции, прозвали его за эту форменность своим бессменным дежурным."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
