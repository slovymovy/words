                                            {
                                                "example_id": "033d74c0-4034-4a16-83bd-1097620bbc6c",
                                                "sense_id": "36e89511-845a-3c24-82fc-cefb0da9f2d8",
                                                "text": "Można się buntować przeciwko reklamie, pogrywającej na odwiecznych tęsknotach w celu nakręcenia konsumpcji kremów przeciw zmarszczkom i odżywek do włosów. Nie zmienia to faktu, że młode jest świeże, jędrne i apetyczne"
                                            },
                                            {
                                                "example_id": "260ed55b-af3c-4f69-b544-6e07e22e6e3d",
                                                "sense_id": "36e89511-845a-3c24-82fc-cefb0da9f2d8",
                                                "text": "Balsamy mają mniej intensywne działanie niż odżywki do włosów"
                                            },
                                            {
                                                "example_id": "12769fda-407b-4a02-838f-878b286fc81d",
                                                "sense_id": "36e89511-845a-3c24-82fc-cefb0da9f2d8",
                                                "text": "Zauważył typowe akcesoria do golenia i mycia zębów, aspirynę i lek na zgagę oraz znacznie większy wybór szamponów, odżywek do włosów i balsamów do ciała, niż jego zdaniem mógłby potrzebować Roy"
                                            }
