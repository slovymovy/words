                    "target_lang_definitions": {
                        "en": "Immediately; without any delay; at that very moment.",
                        "zh": "立刻，马上，在同一时刻。",
                        "cs": "Ihned, bez prodlení, v ten samý okamžik.",
                        "nl": "Onmiddellijk; zonder uitstel; op datzelfde moment.",
                        "pl": "Natychmiast, bez zwłoki, w tym samym momencie.",
                        "de": "Sofort, ohne Verzögerung, in diesem Moment.",
                        "fr": "Immédiatement, sans délai, à ce moment précis.",
                        "it": "Immediatamente, senza alcun ritardo, in quel preciso momento.",
                        "tr": "Gecikmeksizin, derhal, o anda.",
                        "es": "Inmediatamente; sin demora; en ese mismo instante."
                    },
