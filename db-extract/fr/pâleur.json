                                "sense_id": "39bb7d21-c72e-32e2-a0fc-a94eedbd209e",
                                "text": "La pâleur du ciel."
                            },
                            {
                                "example_id": "5c310cc6-be6d-4282-84da-467fd6557d65",
                                "sense_id": "39bb7d21-c72e-32e2-a0fc-a94eedbd209e",
                                "text": "Ma santé même s'est rétablie, et je n'ai gardé de cet événement que cette pâleur mortelle qui accompagne jusqu'au tombeau toute créature qui a subi le baiser d'un vampire."
                            },
                            {
                                "example_id": "9d61bc11-3cb8-407d-8eee-b6b997ef542a",
                                "sense_id": "39bb7d21-c72e-32e2-a0fc-a94eedbd209e",
                                "text": "Sa pâleur habituelle avait fait place aux plus vives couleurs."
                            }
                        ]
