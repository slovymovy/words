                    {
                        "translation_id": "08eb6c5e-2f45-48d4-b70f-9d25912cc049",
                        "source_entry_id": "3f2a6eac-5183-316f-b4f7-b8610861aacc",
                        "target_lang_word": "facette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a3867ef-2c70-39b7-a1f7-98402f1584a4",
                                        "entry_id": "20c0ac33-976e-36d7-b3c3-2885071e8e0a",
                                        "glosses": [
                                            "Petite face, une des petites faces d’un corps qui en a plusieurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad9e3a18-7694-4640-8947-0b3b464d188e",
                                                "sense_id": "6a3867ef-2c70-39b7-a1f7-98402f1584a4",
                                                "text": "Une sphère lumineuse, tournant au plafond, scintillait de ses mille petites facettes dont les lueurs éclairaient curieusement les visages."
                                            },
                                            {
                                                "example_id": "a08af599-fdbc-44ff-99c5-2dcaff481977",
                                                "sense_id": "6a3867ef-2c70-39b7-a1f7-98402f1584a4",
                                                "text": "Nous voici, le flacon et moi, seuls dans ma chambre. Je le tourne avec précaution en tous sens pour mieux voir ses lignes arrondies, ses surfaces lisses, son bouchon ovale taillé à facettes…"
                                            },
                                            {
                                                "example_id": "7d7ec0bc-daf9-431d-b1be-b37de4e18f87",
                                                "sense_id": "6a3867ef-2c70-39b7-a1f7-98402f1584a4",
                                                "text": "Diamant taillé à facettes."
                                            },
                                            {
                                                "example_id": "42b87063-c25b-45ca-8ce2-bdcc59e55fd4",
                                                "sense_id": "6a3867ef-2c70-39b7-a1f7-98402f1584a4",
                                                "text": "Les insectes ont des yeux à facettes."
                                            },
                                            {
                                                "example_id": "edcbecd9-1f41-4e6b-8f6b-6a401b01e919",
                                                "sense_id": "6a3867ef-2c70-39b7-a1f7-98402f1584a4",
                                                "text": "Une facette articulaire costale d’une vertèbre, permettant son articulation avec une côte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f4dc895-48f1-34ac-a2c3-346560339b8c",
                                        "entry_id": "20c0ac33-976e-36d7-b3c3-2885071e8e0a",
                                        "glosses": [
                                            "Facettes dentaires céramiques, qui se collent sur la face visible des dents antérieures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5110daaf-365c-4bd6-85af-0fa426099439",
                                                "sense_id": "4f4dc895-48f1-34ac-a2c3-346560339b8c",
                                                "text": "Le dentiste connu sous le nom de «Docteur Kevin» sur les réseaux sociaux dénonce cette tendance où certains influenceurs se filment en train de limer leurs dents pour ensuite se faire poser des facettes pour avoir un plus beau sourire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c05e9023-b180-3bc0-9bd8-205cd8ff3f20",
                                        "entry_id": "20c0ac33-976e-36d7-b3c3-2885071e8e0a",
                                        "glosses": [
                                            "Un des aspects sous lequel on peut voir une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf8fba5-564e-43eb-a7ef-b4764b577a1c",
                                                "sense_id": "c05e9023-b180-3bc0-9bd8-205cd8ff3f20",
                                                "text": "Même si les vaccins demeurent la meilleure arme pour venir à bout de la pandémie, ils ne sont pas une panacée et plusieurs facettes de leur action restent à documenter, soulignent les experts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421937cd-944b-3f55-b5e5-eb0e5e5ac80b",
                                        "entry_id": "20c0ac33-976e-36d7-b3c3-2885071e8e0a",
                                        "glosses": [
                                            "Qualité, compétence d’une personne."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7abcec3-be29-4f03-a619-e619d8d4cdd4",
                                                "sense_id": "421937cd-944b-3f55-b5e5-eb0e5e5ac80b",
                                                "text": "[Titre] Mort de Daniel Johnston, chanteur américain aux multiples facettes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1f09d44-969a-3b95-b111-bcc781b751dd",
                                        "entry_id": "20c0ac33-976e-36d7-b3c3-2885071e8e0a",
                                        "glosses": [
                                            "Élément à n−1 dimensions d’un polytope à n dimensions. Les facettes d’un polygone sont des côtés, et celles d’un polyèdre sont des faces."
                                        ],
