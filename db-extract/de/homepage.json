                                "sense_id": "cb8369dd-37b7-371a-a0cd-a0c57dec79af",
                                "text": "Auf der Homepage der Wikipedia findet man verschiedene Infokästen."
                            }
                        ],
                        "sense_index_json": "\"2\""
