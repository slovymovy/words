                        "examples": [
                            {
                                "example_id": "5cb7a80b-a1ae-4860-90f4-deef4e661339",
                                "sense_id": "d7ac917e-d7bc-3632-b28c-b2d4c52cd759",
                                "text": "Met de weken die verstreken vervaagden de beelden van die zondag en kwamen ze minder vaak naar boven. Elza keek haar vader niet aan en zei alleen het hoogstnoodzakelijke tegen hem."
                            },
                            {
                                "example_id": "079cacd0-020d-401d-a058-81fa21068f9a",
                                "sense_id": "d7ac917e-d7bc-3632-b28c-b2d4c52cd759",
                                "text": "In haar rapport pleit ze voor het binnenlaten van vrouwen, mensen met een migratieachtergrond, lhbt'ers en hoger opgeleiden. Ze stelt vast dat het al jaren lastig blijkt om het korps diverser te maken, maar dat het hoogstnoodzakelijk is voor de aansluiting bij de samenleving."
                            }
                        ]
