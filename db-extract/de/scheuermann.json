                ],
                "senses": [
                    {
                        "sense_id": "4ce2edf5-9eb6-3e13-b024-ca33445cac52",
                        "entry_id": "629255e5-166c-31b7-9a53-8e12d3fcb6e1",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3de148-b3c9-41b7-8bcb-29aa43e4ab24",
                                "sense_id": "4ce2edf5-9eb6-3e13-b024-ca33445cac52",
                                "text": "Frau Scheuermann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e4f23099-2f42-4210-a651-fea8efb5a1b4",
                                "sense_id": "4ce2edf5-9eb6-3e13-b024-ca33445cac52",
                                "text": "Herr Scheuermann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "31fae8d3-035e-4b59-a155-664a530528d6",
                                "sense_id": "4ce2edf5-9eb6-3e13-b024-ca33445cac52",
                                "text": "Die Scheuermanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "992fc1c6-c320-4c2d-802a-faf0c95780c8",
                                "sense_id": "4ce2edf5-9eb6-3e13-b024-ca33445cac52",
                                "text": "Der Scheuermann trägt nie die Schals, die die Scheuermann ihm strickt."
                            },
                            {
                                "example_id": "423a003c-92d2-4fd6-bfe2-65cdd30190fe",
                                "sense_id": "4ce2edf5-9eb6-3e13-b024-ca33445cac52",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheuermann kommt, geht der Herr Scheuermann.“"
                            },
                            {
                                "example_id": "7dcdd081-778a-4b4a-897d-bf77e68efbed",
                                "sense_id": "4ce2edf5-9eb6-3e13-b024-ca33445cac52",
                                "text": "Scheuermann kommt und geht."
                            },
                            {
                                "example_id": "3138c091-3b6a-4c41-abd6-a0a941b3b21b",
                                "sense_id": "4ce2edf5-9eb6-3e13-b024-ca33445cac52",
                                "text": "Scheuermanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
