{
    "word_family": [
        "deformation",
        "deformity",
        "deformed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e7b0c4b-236f-3cbf-bcdf-248045b97202",
                    "sense_definition": "To change the physical shape of an object, often making it irregular or abnormal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy weight caused the metal beam to <w>deform</w> under the pressure.",
                            "target_lang_translations": {
                                "zh": "重压之下，金属梁发生了<w>变形</w>。"
                            }
                        },
                        {
                            "text": "Extreme heat can <w>deform</w> plastic objects if they are left too close to the fire.",
                            "target_lang_translations": {
                                "zh": "如果塑料制品离火太近，极高的温度会使其<w>变形</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distort",
                        "contort"
                    ],
                    "common_phrases": [
                        "deform under pressure"
                    ],
                    "target_lang_definitions": {
                        "zh": "改变物体的物理形状，通常使其变得不规则或异常。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变形",
                                "target_lang_sense_clarification": "指物体因受力或受热而改变形状。"
                            },
                            {
                                "target_lang_word": "使……扭曲",
                                "target_lang_sense_clarification": "指改变形状使其变得不规则。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bcf6489-1669-32c2-b469-fbcf55dab383",
                    "sense_definition": "To spoil the appearance of something, making it look unattractive or imperfect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spoil_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Graffiti began to <w>deform</w> the beauty of the historic city walls.",
                            "target_lang_translations": {
                                "zh": "涂鸦开始<w>毁损</w>历史古城墙的美感。"
                            }
                        },
                        {
                            "text": "The scars on his face seemed to <w>deform</w> his otherwise gentle expression.",
                            "target_lang_translations": {
                                "zh": "他脸上的伤疤似乎<w>破坏</w>了他原本温和的神情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disfigure",
                        "deface"
                    ],
                    "target_lang_definitions": {
                        "zh": "破坏某物的外观，使其看起来不美观或有缺陷。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "毁损",
                                "target_lang_sense_clarification": "指破坏外观或美感。"
                            },
                            {
                                "target_lang_word": "使……破相",
                                "target_lang_sense_clarification": "特指破坏人的面容或外观。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6ad2f86-04a4-3b31-a134-ce69df50add8",
                    "sense_definition": "To ruin the quality or character of something abstract, such as a situation or a system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spoil_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech was <w>deform</w>ed by unnecessary technical jargon that confused the audience.",
                            "target_lang_translations": {
                                "zh": "他的演讲因充斥着不必要的专业术语而变得<w>扭曲</w>，令听众感到困惑。"
                            }
                        },
                        {
                            "text": "Jealousy can <w>deform</w> even the strongest of friendships over time.",
                            "target_lang_translations": {
                                "zh": "嫉妒心久而久之会<w>扭曲</w>最坚固的友谊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mar"
                    ],
                    "target_lang_definitions": {
                        "zh": "破坏抽象事物（如情况或系统）的质量或性质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扭曲",
                                "target_lang_sense_clarification": "指使抽象事物偏离正常或正确的状态。"
                            },
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "指破坏事物的本质或质量。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f0d8f0e-498c-3f43-8d87-993075a96411",
                    "sense_definition": "To undergo a change in shape or become misshapen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soft metals will <w>deform</w> easily when struck with a hammer.",
                            "target_lang_translations": {
                                "zh": "软金属被锤子敲击时很容易<w>变形</w>。"
                            }
                        },
                        {
                            "text": "The structure began to <w>deform</w> as the foundation shifted during the earthquake.",
                            "target_lang_translations": {
                                "zh": "地震中地基发生位移，建筑物结构开始<w>变形</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distort"
                    ],
                    "antonyms": [
                        "undeform"
                    ],
                    "target_lang_definitions": {
                        "zh": "经历形状改变或变得畸形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变形",
                                "target_lang_sense_clarification": "指物体自身发生形状改变。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73d57f6c-2bc5-3ac2-bf86-ee943d42a6eb",
                    "sense_definition": "Having an unusual, unattractive, or misshapen appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spoil_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old gargoyle had a <w>deform</w> face that frightened the children.",
                            "target_lang_translations": {
                                "zh": "那个古老的滴水嘴兽长着一张<w>畸形</w>的脸，吓坏了孩子们。"
                            }
                        },
                        {
                            "text": "In the poem, the monster is described as being <w>deform</w> and hideous.",
                            "target_lang_translations": {
                                "zh": "在诗中，怪物被描述为<w>畸形</w>且丑陋。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misshapen",
                        "ugly",
                        "hideous"
                    ],
                    "antonyms": [
                        "plain"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "具有不寻常、不美观或畸形的外观。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "畸形的",
                                "target_lang_sense_clarification": "指外观异常或不正常。"
                            },
                            {
                                "target_lang_word": "丑陋的",
                                "target_lang_sense_clarification": "指外观不美观。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}