                    {
                        "translation_id": "d89b4691-0270-4dc2-8cc1-f14c07619e1d",
                        "source_entry_id": "e4a729bc-5832-35df-bb48-a54f08d1c568",
                        "source_sense_id": "3fa4602a-f0a6-3721-9940-a1c626a85d36",
