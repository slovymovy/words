                ],
                "senses": [
                    {
                        "sense_id": "f6e847f0-5666-3c96-9e08-5cfc484cd5f2",
                        "entry_id": "b08d3f17-4a04-350a-ae08-f6d9e504b6a9",
                        "glosses": [
                            "Faire produire une variété différente à un individu déjà greffé en lui greffant une variété différente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11dcaf8f-6166-425a-b05e-6902fbf91d64",
                                "sense_id": "f6e847f0-5666-3c96-9e08-5cfc484cd5f2",
                                "text": "Lorsque le verger est mono-spécifique ou mal pollinisé, il faut introduire des bouquets de fleurs mâles (1 par arbre), replanter des pollinisateurs en surnombre ou sur-greffer d’autres variétés."
                            },
                            {
                                "example_id": "d3f15ed9-e59b-4390-8103-163ab7c99e21",
                                "sense_id": "f6e847f0-5666-3c96-9e08-5cfc484cd5f2",
                                "text": "Ensuite sur la tige, à deux pieds au-dessus de la greffe, sur-greffez tel Poirier de bon fruit qu’il vous plaira."
                            },
                            {
                                "example_id": "5394505e-60aa-4ec1-933d-f24f512654ff",
                                "sense_id": "f6e847f0-5666-3c96-9e08-5cfc484cd5f2",
                                "text": "Moi je crois que vous sur-greffez et c’est une chose à voir — comme de savoir distinguer un artisan d’un artiste et de ne pas trop vous attendrir sur telle « vieille petite ville vaudoise » si vous souffrez de me voir m’attendrir sur telle vieille ville valaisanne."
                            }
                        ]
                    }
                ],
