{
    "word_family": [
        "blasphemy",
        "blasphemous",
        "blasphemer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d37f52a-774d-3e57-b745-0f7c3bfa5575",
                    "sense_definition": "To speak against God or religious doctrine in an impious manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_irreverence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher warned the congregation not to <w>blaspheme</w> against the holy teachings."
                        },
                        {
                            "text": "He was accused of <w>blaspheme</w>ing the divine name during the heated argument."
                        }
                    ],
                    "synonyms": [
                        "profane"
                    ],
                    "antonyms": [
                        "revere",
                        "venerate"
                    ],
                    "common_phrases": [
                        "blaspheme against God"
                    ]
                },
                {
                    "sense_id": "bad5d7d7-f361-3638-b84f-1a33d9f19738",
                    "sense_definition": "To speak of or address something sacred with impious irreverence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_irreverence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is considered a grave sin to <w>blaspheme</w> the sacred relics of the temple."
                        },
                        {
                            "text": "The crowd was shocked to hear him <w>blaspheme</w> the ancient traditions of their faith."
                        }
                    ],
                    "synonyms": [
                        "desecrate"
                    ]
                },
                {
                    "sense_id": "063118ef-9ef7-35ce-bbba-288c99c383ca",
                    "sense_definition": "To speak abusively or slanderously about someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>blaspheme</w> the reputation of those who have worked so hard for this cause."
                        },
                        {
                            "text": "He continued to <w>blaspheme</w> his former mentors despite their past kindness."
                        }
                    ],
                    "synonyms": [
                        "calumniate",
                        "revile",
                        "slander"
                    ],
                    "antonyms": [
                        "praise",
                        "extol"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7c149ed-3631-341d-bfd7-3e0fb4509e66",
                    "sense_definition": "An <w>obsolete</w> spelling of blasphemy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old manuscript contained the word <w>blaspheme</w> used as a noun."
                        },
                        {
                            "text": "In historical texts, one might encounter <w>blaspheme</w> where we now write blasphemy."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This spelling is no longer in standard use."
                        }
                    ]
                }
            ]
        }
    ]
