                        "cross_references": [
                            {
                                "target_word": "фальсификат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d466c963-1889-3b9a-b1e9-0386b8ea959e",
                                        "entry_id": "05acc167-bcee-3f98-8f42-4a73ff9c1d4e",
                                        "glosses": [
                                            "фальсифицированный, поддельный продукт, фальсифицированное изделие; подделка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ba1bd8-a66c-4a56-a0cc-99d4051c96d2",
                                                "sense_id": "d466c963-1889-3b9a-b1e9-0386b8ea959e",
                                                "text": "Если на плитке написано, что это плитка ― перед нами, повторяю, хороший, качественный товар, если написано «шоколад» ― это фальсификат."
                                            },
                                            {
                                                "example_id": "4f62691b-bac3-4ea4-b0db-4b9dc3a8bff1",
                                                "sense_id": "d466c963-1889-3b9a-b1e9-0386b8ea959e",
                                                "text": "Оба фальсификата были изготовлены, по-видимому, во II в. н. э. и написаны по-гречески, а затем были переведены на латинский («Дневник» ― неким Луцием Септимием в IV в. , «История» ― неизвестным переводчиком в конце V в. , который выдавал фальсификат за перевод Корнелия Непота, сделанный якобы в I в. )."
                                            },
                                            {
                                                "example_id": "b27d9a10-0d00-44e3-b98f-fb804db21013",
                                                "sense_id": "d466c963-1889-3b9a-b1e9-0386b8ea959e",
                                                "text": "Я написала не свою книгу («Агентство Пинкертона»). Как кто-то сказал: сознательный литературный фальсификат."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
