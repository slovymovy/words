                        "examples": [
                            {
                                "example_id": "35571cfd-9263-4191-9319-57f9e98e0a71",
                                "sense_id": "d5c0d73d-7fe6-3220-8a46-eba1567fe360",
                                "text": "De quoi, ma chique? Y a plus d’un quart d’heure que j’vous vois d’ici farfouiller dans votre tabatière, et vous fourrer du poussier d’mottes dans le renifloir, que ça m’dégoûte et que j’n’en dis rien!"
                            },
                            {
                                "example_id": "9c036b86-6eb8-4f2e-b29b-737db9f62a25",
                                "sense_id": "d5c0d73d-7fe6-3220-8a46-eba1567fe360",
                                "text": "Celui-ci chaussa les bésicles, promena son renifloir sur son hôte, de haut en bas…\n— …Hum hum!…, fit-il."
                            },
                            {
                                "example_id": "e6bb2898-b13a-40f7-a8d0-926061700133",
                                "sense_id": "d5c0d73d-7fe6-3220-8a46-eba1567fe360",
                                "text": "Il a bientôt 80 ans et le renifloir plus imposant que jamais."
                            }
                        ]
                    }
