                ],
                "senses": [
                    {
                        "sense_id": "73efb837-ab11-3645-88e0-f1be4610d719",
                        "entry_id": "7aff9ff2-5294-3e00-8735-ade29b30f621",
                        "glosses": [
                            "Variante de tussore."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "02183903-ef1f-4989-9dc7-b67b07cf8b97",
                                "sense_id": "73efb837-ab11-3645-88e0-f1be4610d719",
                                "text": "À cinq heures, je pris le thé avec Lady Diana. Elle portait un petit costume de tussor brodé et des souliers de sport."
                            },
                            {
                                "example_id": "7493974d-214d-495c-8f1d-6af6df0c313d",
                                "sense_id": "73efb837-ab11-3645-88e0-f1be4610d719",
                                "text": "Je regardais, à travers la chemise de tussor, l’endroit où j’avais enfoncé l’épingle : curiosité dépouillée de toute passion."
                            },
                            {
                                "example_id": "9898dd32-434a-4f87-ba91-1afac45ed63b",
                                "sense_id": "73efb837-ab11-3645-88e0-f1be4610d719",
                                "text": "Les jeunes filles et les jeunes femmes étaient rondes, gourmandes, en robe de toile blanche ou de tussor écru."
                            },
                            {
                                "example_id": "a41c4301-008a-4a0b-b468-e7a3c1e732dc",
                                "sense_id": "73efb837-ab11-3645-88e0-f1be4610d719",
                                "text": "Alexis, habillé d’un pantalon de velours bleu marine, finement côtelé, d’une veste légère et d’une chemise de tussor, avait retrouvé aussitôt son air de prince, charmant, excentrique, dolent et boudeur."
                            },
                            {
                                "example_id": "90f6cc8b-4214-4b75-840e-c4e874de5161",
                                "sense_id": "73efb837-ab11-3645-88e0-f1be4610d719",
                                "text": "Mme de Noailles est couchée sur une chaise longue […] sinueusement drapée dans une sorte de chemise roumaine ou grecque de tussor noir."
                            }
                        ]
                    }
                ],
