                                    {
                                        "sense_id": "0f4a8e2c-6a5a-3cfe-a97a-a051aa54b59d",
                                        "entry_id": "161dd2e3-0f51-3b62-b761-c312e5e41e8a",
                                        "glosses": [
                                            "selbst produziertes alkoholisches Getränk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fc9dd6-6e44-48f3-82be-46436e9db360",
                                                "sense_id": "0f4a8e2c-6a5a-3cfe-a97a-a051aa54b59d",
                                                "text": "„Später habe ich erfahren, dass das die Folge eines Experiments mit Selbstgebranntem war, das so richtig in die Hose gegangen war.“"
                                            },
                                            {
                                                "example_id": "483cadf3-ba71-466c-8e84-74453c266c52",
                                                "sense_id": "0f4a8e2c-6a5a-3cfe-a97a-a051aa54b59d",
                                                "text": "„Sie fuhren Selbstgebrannten für Clyde Nale, der oben in ’n Wäldern bei Kimberlin ’n paar Destillen hatte.“"
                                            },
                                            {
                                                "example_id": "a283327a-3200-42ab-9d8d-0318dfac440a",
                                                "sense_id": "0f4a8e2c-6a5a-3cfe-a97a-a051aa54b59d",
                                                "text": "„Er scharrte mit den Füßen, nahm den Selbstgebrannten aus der Gesäßtasche, sah die Flasche an, betastete sie, steckte sie wieder weg.“"
                                            },
                                            {
                                                "example_id": "7a8181ff-44e3-4cac-8916-bcfa9aa7285f",
                                                "sense_id": "0f4a8e2c-6a5a-3cfe-a97a-a051aa54b59d",
                                                "text": "„Reza zwinkerte ihm verschwörerisch zu und flüsterte, Karim brauche wohl etwas von seinem Selbstgebrannten, dem allerbesten, den es gebe, so wie früher, als sie noch jung und leichtsinnig waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
