                    }
                ],
                "senses": [
                    {
                        "sense_id": "157fb87e-0cd6-389e-9417-1bdfb5ddd549",
                        "entry_id": "92c29a41-63e2-3a6e-a8bb-c117722303cf",
                        "glosses": [
                            "Méthode pour préserver des coups d’enfilade un ouvrage ou une troupe, ou résultat de cette méthode."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "50d67679-d879-360b-b499-2b9b91922df3",
                        "entry_id": "92c29a41-63e2-3a6e-a8bb-c117722303cf",
                        "glosses": [
                            "Déroulement d’une bande dans un appareil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e045b454-d6da-49b0-bad8-b8e17493f197",
                                "sense_id": "50d67679-d879-360b-b499-2b9b91922df3",
                                "text": "La valeur de la fréquence que l’on peut enregistrer dépend essentiellement de la dimension de l’entrefer de la tête et de la vitesse de défilement de la bande magnétique."
                            }
                        ]
                    },
                    {
                        "sense_id": "3307cd9e-b68c-397e-8633-3f9591518d81",
                        "entry_id": "92c29a41-63e2-3a6e-a8bb-c117722303cf",
                        "glosses": [
                            "Déplacement à l'écran, horizontalement ou verticalement, d'un élément graphique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e031e1b6-f84b-45e3-8841-ceafab1d02de",
                                "sense_id": "3307cd9e-b68c-397e-8633-3f9591518d81",
                                "text": "Barre de défilement."
                            },
                            {
                                "example_id": "ebb4a461-63c9-470e-84bd-0c112261ab83",
                                "sense_id": "3307cd9e-b68c-397e-8633-3f9591518d81",
                                "text": "La mise à jour que permet cette compatibilité donne la possibilité d’utiliser normalement différents gestes du trackpad, du clic gauche et droit classique au défilement horizontal ou vertical et au zoom."
                            }
                        ]
                    },
                    {
                        "sense_id": "da05f236-8684-39e4-8790-4ed6263f108c",
                        "entry_id": "92c29a41-63e2-3a6e-a8bb-c117722303cf",
                        "glosses": [
                            "Réduction du diamètre d’un arbre à mesure que l’on remonte son tronc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab9f0e1-a3e5-4d5d-a7ca-447b3b05d5e9",
                                "sense_id": "da05f236-8684-39e4-8790-4ed6263f108c",
                                "text": "Cet itinéraire présente l’avantage de produire des bois qui auraient un meilleur élagage naturel et donc un meilleur défilement ; en contrepartie les risques de chablis et de dépérissement, notamment en cas d’inadéquation entre l’essence et la station, sont plus élevés."
                            }
                        ]
                    },
                    {
                        "sense_id": "cffa66a5-ca8b-37c8-85ae-5141f8c3e006",
                        "entry_id": "92c29a41-63e2-3a6e-a8bb-c117722303cf",
                        "glosses": [
                            "Action de se défiler, de se dérober."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "f07759e4-19b7-43c3-bcc3-5d971017014f",
                                "sense_id": "cffa66a5-ca8b-37c8-85ae-5141f8c3e006",
                                "text": "Le vieux Bordon n'avait pas méconnu ce talent et en avait usé dans plusieurs remerciements, atermoiements et déﬁlements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc761a19-06fd-4bb3-a0a4-9938c44b5887",
                        "source_entry_id": "92c29a41-63e2-3a6e-a8bb-c117722303cf",
                        "source_sense_id": "157fb87e-0cd6-389e-9417-1bdfb5ddd549",
                        "source_sense_description": "(Architecture) Méthode pour préserver des coups d’enfilade un ouvrage ou une troupe",
                        "target_lang_word": "defilement",
