                "senses": [
                    {
                        "sense_id": "6fff5e8d-82b2-37de-8a5f-9f11d5f73b5f",
                        "entry_id": "88ba31dc-dbeb-3ec8-9ae7-473143597c7a",
                        "glosses": [
                            "smooth operator, womanizer"
