                                "target_word": "lelijkheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7795e306-310d-34ff-bbd2-01ad7203458e",
                                        "entry_id": "fda8eb96-ca28-3c4d-b727-4adfdfa894ce",
