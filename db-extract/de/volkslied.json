                            "singular"
                        ],
                        "form": "das Volkslied"
                    },
                    {
                        "form_id": "06f4143d-8ee4-4d03-b520-3812725b4137",
                        "entry_id": "ab73ce2e-794b-3f47-8be3-66b5a08f38ef",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Volkslieder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ff91127-e998-3cc4-a462-0fd948c9ae6f",
                        "entry_id": "ab73ce2e-794b-3f47-8be3-66b5a08f38ef",
                        "glosses": [
                            "im Volk gepflegtes und tradiertes Lied unbekannter Herkunft mit einfacher, häufig auch mehrstimmiger Melodie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c56c69-f2ab-4479-b167-022ee4efa5fd",
                                "sense_id": "2ff91127-e998-3cc4-a462-0fd948c9ae6f",
                                "text": "„Nichts in der Welt hat mehr Sprünge und kühne Würfe als das Volkslied!“"
                            },
                            {
                                "example_id": "57141ea1-339e-415a-bfe0-8486693c18c0",
                                "sense_id": "2ff91127-e998-3cc4-a462-0fd948c9ae6f",
                                "text": "„Die Freunde suchten und bearbeiteten alte Volkslieder.“"
                            },
                            {
                                "example_id": "dc2faa86-f9ba-4048-a44a-8512671ac373",
                                "sense_id": "2ff91127-e998-3cc4-a462-0fd948c9ae6f",
                                "text": "„Ich hatte aber das Glück, daheim eine bunte Sammlung schwedischer Volkslieder singen und spielen zu lernen.“"
                            },
                            {
                                "example_id": "2e80943a-6c02-4768-85bb-7674d3795c0b",
                                "sense_id": "2ff91127-e998-3cc4-a462-0fd948c9ae6f",
                                "text": "„Sie vertrieben sich die Zeit unter der sengenden Sonne damit, dass sie ein paar Volkslieder sangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ffcaec56-c591-3fe1-80c2-cf43305cba83",
                        "entry_id": "ab73ce2e-794b-3f47-8be3-66b5a08f38ef",
                        "glosses": [
                            "im Volk weit verbreitetes, gern und häufig gesungenes Lied, im Sinne eines „populären“ Liedes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0a2bbc1-8c37-49de-b7ee-5faba5799f7d",
                                "sense_id": "ffcaec56-c591-3fe1-80c2-cf43305cba83",
                                "text": "„La Paloma“ ist zum Volkslied geworden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b812b4e6-4a54-4d00-b98c-eaf6e4771944",
                        "source_entry_id": "ab73ce2e-794b-3f47-8be3-66b5a08f38ef",
                        "source_sense_id": "2ff91127-e998-3cc4-a462-0fd948c9ae6f",
