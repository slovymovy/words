                        "cross_references": [
                            {
                                "target_word": "Metz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07d9caca-7ed4-3260-8f64-b192c1fed286",
                                        "entry_id": "41287627-b1a3-3557-9377-91270339d015",
                                        "glosses": [
                                            "Ville et chef-lieu de département situé dans le département de la Moselle, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9cb1c63-9018-44df-8a9a-7bba23142151",
                                                "sense_id": "07d9caca-7ed4-3260-8f64-b192c1fed286",
                                                "text": "Si l’on signale, en 350, la présence à Metz d’un évêque du nom de Siméon, qui aurait été un juif converti, cela ne signifie pas qu’il y ait déjà eu des juifs dans cette ville."
                                            },
                                            {
                                                "example_id": "96cec2a6-32b8-4300-88e2-03d6e78028ec",
                                                "sense_id": "07d9caca-7ed4-3260-8f64-b192c1fed286",
                                                "text": "Nos grandes places de guerre, Strasbourg et Metz, les véritables boulevards de notre défense, n’avaient été ni armées, ni approvisionnées."
                                            },
                                            {
                                                "example_id": "d2aba958-9b4e-4dc4-8a5b-ea7ac2235101",
                                                "sense_id": "07d9caca-7ed4-3260-8f64-b192c1fed286",
                                                "text": "Les Citoyens de la Ville de Metz ont bien mérité de la Patrie"
                                            },
                                            {
                                                "example_id": "d9c300c9-f5e2-4761-a5d7-b573c5750785",
                                                "sense_id": "07d9caca-7ed4-3260-8f64-b192c1fed286",
                                                "text": "Il n’est pas de ville qui se fasse mieux aimer que Metz"
                                            },
                                            {
                                                "example_id": "a6c60db6-617c-4317-a07c-6b128217f54c",
                                                "sense_id": "07d9caca-7ed4-3260-8f64-b192c1fed286",
                                                "text": "Ce fut en l’année 566 que la cérémonie des noces eut lieu, avec un grand appareil, dans la ville royale de Metz."
                                            }
                                        ]
                                    }
                                ]
                            },
