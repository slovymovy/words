                        "examples": [
                            {
                                "example_id": "3d3fa3bb-2135-47b9-8f50-8da5844d4f20",
                                "sense_id": "8581e0c6-b4bd-315a-8d82-2491b98989c7",
                                "text": "La communauté du Lieu comptait alors huitante-neuf hommes adultes, dont 50 au moins étaient déjà pères de famille."
                            },
                            {
                                "example_id": "05c4572a-883a-4b83-ac74-059819410a77",
                                "sense_id": "8581e0c6-b4bd-315a-8d82-2491b98989c7",
                                "text": "Au contraire la bande de cuir correspondante de même nature, et coupée dans le même morceau, mais qui n’avoit été ni graissée, ni laminée, pesant avant son immersion huitante-neuf grains, en a pesé, après trente-deux heures de séjour dans l’eau, nonante-six."
                            }
                        ]
                    }
