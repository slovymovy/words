                                    {
                                        "sense_id": "a024a95c-6203-3d3c-a21c-7591c22e25d8",
                                        "entry_id": "4eb4ae95-3085-3fbc-bf7b-b09c2888e28e",
                                        "glosses": [
                                            "Calamus rotang planten van de soort Calamus, met liaanachtige stengels die gebruikt worden voor de vervaardiging van meubels"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rotan",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7a4fb949-db7b-3fa9-874f-b5802eb9dcaa",
