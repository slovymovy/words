                                    {
                                        "sense_id": "94197b7f-2b6a-378c-b297-83b8db256072",
                                        "entry_id": "8d59ca2a-1092-3bbf-8d00-d2819e176596",
                                        "glosses": [
                                            "Limousin (francuska kraina historyczna)"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54c45c38-4b16-4789-80e6-d7fa4d60c217",
                                                "sense_id": "94197b7f-2b6a-378c-b297-83b8db256072",
                                                "text": "Prawdziwą uroczystością w tem kółku, było pojawienie się znakomitego Turgota, gdy ten przyjeżdżał do Paryża z prowincyi, z Limuzynu, którego był intendentem, czyli gubernatorem"
                                            },
                                            {
                                                "example_id": "ad53d739-7cee-4304-a7e5-c7ae8d40e303",
                                                "sense_id": "94197b7f-2b6a-378c-b297-83b8db256072",
                                                "text": "Bernard de Ventadorn (ok. 1140—1195) • Pochodził z Limuzynu, z zamku Ventadorn. Był człekiem ubogiego rodu, synem piekarczyka zamkowego. Wyrósł dorodny i zdatny, umiał tworzyć i śpiewać, był dworny i uczony"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
