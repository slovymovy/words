                    },
                    {
                        "form_id": "cbff241b-5704-45e5-b768-dd5a435d7072",
                        "entry_id": "7d7160b9-13cc-38f0-a5de-c38657325887",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "проде́лав"
                    },
                    {
                        "form_id": "8a627a08-35d6-47db-87e5-bd77ef3fc671",
                        "entry_id": "7d7160b9-13cc-38f0-a5de-c38657325887",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "проде́лавши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5363fa4a-0bcc-3347-98f7-74a389c9b94b",
                        "entry_id": "7d7160b9-13cc-38f0-a5de-c38657325887",
                        "glosses": [
                            "сделать, образовать какое-либо отверстие, углубление, проход и т. п. в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e147ffa-f106-4ac3-a423-ab45a97ef261",
                                "sense_id": "5363fa4a-0bcc-3347-98f7-74a389c9b94b",
                                "text": "Отверстие, имеющееся в его дне, нужно значительно расширить или проделать ещё несколько отверстий."
                            },
                            {
                                "example_id": "ae53a9ed-2160-4bec-99a9-d3a5cb82d6c6",
                                "sense_id": "5363fa4a-0bcc-3347-98f7-74a389c9b94b",
                                "text": "Летнее солнце и зимние дожди вкупе с процессом эрозии проделали в крымских дорогах бесчисленное множество выбоин и трещин."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c478ec6-b094-30a6-bd83-1f867cd1d1cd",
                        "entry_id": "7d7160b9-13cc-38f0-a5de-c38657325887",
                        "glosses": [
                            "сделать, совершить, выполнить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0664a76b-e260-4da3-9fd8-5da0662cc4ce",
                                "sense_id": "7c478ec6-b094-30a6-bd83-1f867cd1d1cd",
                                "text": "Сейчас мы проделаем опыт и получим чистый сок."
                            },
                            {
                                "example_id": "50654e30-6bdd-4e52-a5c9-7d8db759b95a",
                                "sense_id": "7c478ec6-b094-30a6-bd83-1f867cd1d1cd",
                                "text": "Мишель проделал весь путь в четыре дня."
                            },
                            {
                                "example_id": "fcf77233-5c2d-42de-8843-87667173d7b8",
                                "sense_id": "7c478ec6-b094-30a6-bd83-1f867cd1d1cd",
                                "text": "Я еле успевал в течение суток проделать все необходимые дела."
                            },
                            {
                                "example_id": "222c3a5b-8af1-440f-8ece-c140251b6370",
                                "sense_id": "7c478ec6-b094-30a6-bd83-1f867cd1d1cd",
                                "text": "Но то, что проделали чиновники МНС с транспортным налогом, популярности президенту среди избирателей явно не добавит."
                            },
                            {
                                "example_id": "93314ab7-1b19-48bc-abf0-4b5965afa09c",
                                "sense_id": "7c478ec6-b094-30a6-bd83-1f867cd1d1cd",
                                "text": "Выложив на досочку, нарезать картофель небольшими кубиками. То же самое проделать с чесноком, луком и очищенными помидорами."
                            }
                        ]
                    },
                    {
                        "sense_id": "4efd78e6-a4af-302f-a352-109203185d71",
                        "entry_id": "7d7160b9-13cc-38f0-a5de-c38657325887",
                        "glosses": [
                            "совершить какую-либо каверзу, сделать что-либо во вред другому"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03c03f1a-67bd-4285-b4ff-4517f216d8f5",
                                "sense_id": "4efd78e6-a4af-302f-a352-109203185d71",
                                "text": "— Держу пари, — сказал Воланд, улыбаясь Маргарите, — что он проделал эту штуку нарочно."
                            }
                        ]
                    },
                    {
                        "sense_id": "66a850a2-5543-3571-9caa-1f4c11d754ee",
                        "entry_id": "7d7160b9-13cc-38f0-a5de-c38657325887",
                        "glosses": [
                            "разг. делать что-либо в течение какого-либо времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d01831-4deb-4f97-9e3a-b86822d40135",
                                "sense_id": "66a850a2-5543-3571-9caa-1f4c11d754ee",
                                "text": "Домашнее задание он проделал целый час."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
