                    {
                        "translation_id": "e68db67d-8b9e-49ae-8939-6508e4f3a410",
                        "source_entry_id": "20c25f00-7dab-3396-a59b-eba50e1c60de",
                        "source_sense_description": "Surface plane sur un haut-fond sous-marin",
                        "target_lang_word": "shoal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1111355a-21fe-3609-ba2e-027d56e79c5f",
                                        "entry_id": "a1017224-f23f-3399-8701-e9b29361fe1f",
                                        "glosses": [
                                            "Shallow."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c99583b-112f-4c0b-8311-f9dcde7c9b2b",
                                                "sense_id": "1111355a-21fe-3609-ba2e-027d56e79c5f",
                                                "text": "shoal water"
                                            },
                                            {
                                                "example_id": "4fae0ef4-c6ba-40a5-8d75-4e8f8b9102c3",
                                                "sense_id": "1111355a-21fe-3609-ba2e-027d56e79c5f",
                                                "text": "But that part of the coast being shoal and bare, / And rough with reefs which ran out many a mile, / His port lay on the other side o' the isle."
                                            },
                                            {
                                                "example_id": "b8a4e46c-4f3f-485b-a25e-73e5ccddb591",
                                                "sense_id": "1111355a-21fe-3609-ba2e-027d56e79c5f",
                                                "text": "All told, we had scarce two miles to run; but the navigation was delicate, the entrance to this northern anchorage was not only narrow and shoal, but lay east and west, so that the schooner must be nicely handled to be got in."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e39e736-7761-3b9a-afc0-f80ce737b239",
                                        "entry_id": "c3ed6d60-0bc8-3d2a-8f48-858cacb2794e",
                                        "glosses": [
                                            "A sandbank or sandbar creating a shallow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f718e96-4950-4be5-8c3c-a90c0346bbe1",
                                                "sense_id": "0e39e736-7761-3b9a-afc0-f80ce737b239",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            },
                                            {
                                                "example_id": "f7546fd2-22f1-48e1-a20d-d9b19518bef9",
                                                "sense_id": "0e39e736-7761-3b9a-afc0-f80ce737b239",
                                                "text": "The god himself with ready trident stands, / And opes the deep, and spreads the moving sands, / Then heaves them off the shoals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c12978cd-7113-3658-8cd1-59a02c7d7621",
                                        "entry_id": "c3ed6d60-0bc8-3d2a-8f48-858cacb2794e",
                                        "glosses": [
                                            "A shallow in a body of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c79feede-0824-440b-8adb-01edae3e9e67",
                                                "sense_id": "c12978cd-7113-3658-8cd1-59a02c7d7621",
                                                "text": "The depth of your pond should be six feet; and on the sides some shoals for the fish to sun themselves in and to lay their spawn."
                                            },
                                            {
                                                "example_id": "486ab3ba-eebe-42e8-a95c-2600a22c7f7e",
                                                "sense_id": "c12978cd-7113-3658-8cd1-59a02c7d7621",
                                                "text": "Wolsey, that once trod the ways of glory, / And sounded all the depths and shoals of honour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79de8ab5-3cb9-3964-be42-d349c6fecf2b",
                                        "entry_id": "716098c9-e000-310b-acf1-45b0085023f0",
                                        "glosses": [
                                            "To arrive at a shallow (or less deep) area."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "358ce347-5a1c-3d32-bbbe-27b0a557bae1",
                                        "entry_id": "716098c9-e000-310b-acf1-45b0085023f0",
                                        "glosses": [
                                            "To cause a shallowing; to come to a more shallow part of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ed2616a-df26-4496-a1dc-a2ee99a50020",
                                                "sense_id": "358ce347-5a1c-3d32-bbbe-27b0a557bae1",
                                                "text": "Noting the rate at which she shoals her water -[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b8886b8-13fc-3c99-8646-9027a5a0c211",
                                        "entry_id": "716098c9-e000-310b-acf1-45b0085023f0",
                                        "glosses": [
                                            "To become shallow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac0ab31e-4faf-4172-aba5-c0bbb6f49b9c",
                                                "sense_id": "0b8886b8-13fc-3c99-8646-9027a5a0c211",
                                                "text": "The colour of the water shows where it shoals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc93184c-1836-3f8e-a8b4-1c723c5e84af",
                                        "entry_id": "6825a28c-88b7-3314-b9f3-de004cdcaf1a",
                                        "glosses": [
                                            "Any large number of persons or things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd5f41c-302d-468d-b158-494aa96fc78a",
                                                "sense_id": "bc93184c-1836-3f8e-a8b4-1c723c5e84af",
                                                "text": "Shoals of tourists"
                                            },
                                            {
                                                "example_id": "8d933db8-a7ea-4941-b25b-182f647fcd20",
                                                "sense_id": "bc93184c-1836-3f8e-a8b4-1c723c5e84af",
                                                "text": "great shoals of people"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1081787b-5a69-375e-a6f7-6f14c3394e59",
                                        "entry_id": "6825a28c-88b7-3314-b9f3-de004cdcaf1a",
                                        "glosses": [
                                            "A large number of fish (or other sea creatures) of the same species swimming together."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a18dfb8d-ce3e-4804-9d91-bb44517217c6",
                                                "sense_id": "1081787b-5a69-375e-a6f7-6f14c3394e59",
                                                "text": "c. 1661, Edmund Waller, On St. James's Park\nBeneath, a shoal of silver fishes glides."
                                            },
                                            {
                                                "example_id": "092ddcef-6cb1-46c2-a1d0-c30968d13e07",
                                                "sense_id": "1081787b-5a69-375e-a6f7-6f14c3394e59",
                                                "text": "He came directly from the shoal which we had just before entered, and in which we had struck three of his companions, as if fired with revenge for their sufferings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0bb988a-c1dd-32da-878a-0d79d017b3ff",
                                        "entry_id": "f37a4596-fee3-3a5c-8992-fe45bff5e915",
                                        "glosses": [
                                            "To collect in a shoal; to throng."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "398da4e4-6727-4c0c-b0cf-28e1b5169fac",
                                                "sense_id": "f0bb988a-c1dd-32da-878a-0d79d017b3ff",
                                                "text": "The fish shoaled about the place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
