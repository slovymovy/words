                "senses": [
                    {
                        "sense_id": "61ce3d0d-3df3-30eb-9db7-61892b41815b",
                        "entry_id": "fb782fbc-611f-36e5-8df3-02ecaf889d70",
                        "glosses": [
                            "idealistisch gekennzeichnete Haltung, welche geprägt durch Gutwill dem Gegenüber Vorteile verschafft"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "62ea0a12-a018-40b6-abf1-8e5a6db7521c",
                                "sense_id": "61ce3d0d-3df3-30eb-9db7-61892b41815b",
                                "text": "Der Angeklagte war auf die Benevolenz des Richters angewiesen."
                            },
                            {
                                "example_id": "416205e8-9d06-465c-b846-dda9b0589c80",
                                "sense_id": "61ce3d0d-3df3-30eb-9db7-61892b41815b",
                                "text": "„Benevolenz beschreibt die Wahrnehmung, dass jemand anderes zum Vorteil der beobachtenden Person handelt und nicht opportunistisch ist.“"
                            },
                            {
                                "example_id": "c4558f59-36d0-4a8f-af5b-da334ce6a482",
                                "sense_id": "61ce3d0d-3df3-30eb-9db7-61892b41815b",
                                "text": "„[…]Benevolenzerwartung, wobei Benevolenz eine optimistisch-offene Haltung gegenüber anderen Menschen und Beziehungen meint, die nicht durch besondere Handlungen, sondern durch guten Willen und allgemeine Geneigtheit gekennzeichnet ist.“"
                            },
                            {
                                "example_id": "ab6778ae-aa40-4240-a3f0-2389f36e4f49",
                                "sense_id": "61ce3d0d-3df3-30eb-9db7-61892b41815b",
                                "text": "„Benevolenz gilt auch in der ökonomischen Theorie als eine Grundvoraussetzung für Austausch und Handel und ist nicht zu verwechseln mit Altruismus.“"
                            },
                            {
                                "example_id": "0a8932a9-792d-46a2-b45d-12e08d11086a",
                                "sense_id": "61ce3d0d-3df3-30eb-9db7-61892b41815b",
                                "text": "„Im folgenden Abschnitt wird der Begriff richterliche Benevolenz durch geeignete Parameter operationalisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
