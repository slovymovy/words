                                "target_senses": [
                                    {
                                        "sense_id": "bf8cdd55-86c2-3112-b69f-6c78c16dbc43",
                                        "entry_id": "e2a26f5f-a2c9-35cd-bef1-01fee810a80d",
                                        "glosses": [
                                            "Sounding sorrowful, mournful or melancholic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d944ab-85a2-4195-a40a-fffaa436c62b",
                                                "sense_id": "bf8cdd55-86c2-3112-b69f-6c78c16dbc43",
                                                "text": "a typically plaintive song from Radiohead"
                                            },
                                            {
                                                "example_id": "24ec6422-f88c-4838-9818-fb4843813c04",
                                                "sense_id": "bf8cdd55-86c2-3112-b69f-6c78c16dbc43",
                                                "text": "I can see by your plaintive smile something is wrong, so spill it."
                                            }
                                        ]
