                        "glosses": [
                            "Missing or not having enough of (a good quality, etc)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93bcb493-bcc2-450d-869a-ac980ecf40b6",
                                "sense_id": "a486056d-f0b9-36c5-98df-425f661dcb3a",
                                "text": "This cheese is lacking in pungency."
                            },
                            {
                                "example_id": "e4d248f9-d5cf-4963-b60a-4c4fed26621a",
                                "sense_id": "a486056d-f0b9-36c5-98df-425f661dcb3a",
                                "text": "The team was lacking in stamina and lost the match decidedly."
                            },
                            {
                                "example_id": "3312b3ba-3d12-4727-8c16-173dad3da25d",
                                "sense_id": "a486056d-f0b9-36c5-98df-425f661dcb3a",
                                "text": "A few of the pieces of this jigsaw puzzle are lacking."
                            }
                        ]
