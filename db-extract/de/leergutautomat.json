                "senses": [
                    {
                        "sense_id": "b484f996-9aa1-3c31-80f4-808fcb1eefcd",
                        "entry_id": "afc0a698-cd66-36af-9a80-ad30ac0fea5b",
                        "glosses": [
                            "Maschine, die pfandpflichtige Leerflaschen und Dosen entgegennimmt und einen Bon für die Erstattung des Pfandgelds ausgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa08ea6b-6e48-4eac-9d60-274a09f39254",
                                "sense_id": "b484f996-9aa1-3c31-80f4-808fcb1eefcd",
                                "text": "„Doch seit der Gesetzesänderung erkennen Leergutautomaten auch Einwegverpackungen konkurrierender Hersteller an; die Automaten scannen dabei ein Sicherheitslogo auf der Rückseite der Verpackung.“"
                            },
                            {
                                "example_id": "22ba65f7-2ea4-41d0-9ba7-9ea45cf80c74",
                                "sense_id": "b484f996-9aa1-3c31-80f4-808fcb1eefcd",
                                "text": "„Wir trafen kurz nach Weihnachten vor dem defekten Leergutautomaten der Extra-Kaufhalle aufeinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
