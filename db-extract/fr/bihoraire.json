                        "glosses": [
                            "Qualifie un compteur, un relevé, un tarif, considérant séparément la consommation d’électricité en heures dites pleines et celle en heures dites creuses."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "0f275195-c41f-49bd-8df0-27028464e79b",
                                "sense_id": "c1d536c0-abc2-34df-b6d5-859861d1c65b",
                                "text": "Un compteur bihoraire est un compteur d'électricité qui permet de comptabiliser séparément les consommations d'électricité en heures pleines (= « jour en semaine») et en heures creuses (= « nuit en semaine + WE»)."
                            },
                            {
                                "example_id": "da5fbd8e-6833-449b-b14b-c844ee882955",
                                "sense_id": "c1d536c0-abc2-34df-b6d5-859861d1c65b",
                                "text": "Pour profiter des avantages du tarif bihoraire, il est important de respecter des plages horaires spécifiques."
                            },
                            {
                                "example_id": "806312c6-addd-48a3-8cf4-b6c4e850cabd",
                                "sense_id": "c1d536c0-abc2-34df-b6d5-859861d1c65b",
                                "text": "S'il y est spécifié \"heures creuses\" et \"heures pleines\" c'est que vous avez un comptage bihoraire !"
                            }
                        ]
                    }
