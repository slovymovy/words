                ],
                "translations": [
                    {
                        "translation_id": "998b8a66-51de-4c11-a4d0-68ed9fd2e197",
                        "source_entry_id": "ffd4e1c8-276c-317f-926e-203dd3079e4e",
                        "source_sense_id": "811f5314-8013-3b10-b55e-1402d4bf0897",
                        "target_lang_word": "klippig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klippig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6249891a-6530-31bd-a309-6394de17ec24",
                                        "entry_id": "8e7bf89a-4fcb-3f71-8925-76d6e942da45",
                                        "glosses": [
                                            "mit Klippen¹ durchsetzt"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14f7f07d-f466-43ea-bbfc-9f02bddcc9d3",
                                                "sense_id": "6249891a-6530-31bd-a309-6394de17ec24",
                                                "text": "„Vom Sturm durchwühlt, sich schwarze Wogen Schaümen [sic],",
                                                "translation": "Sie branden wild ans klippige Gestad —“"
                                            },
                                            {
                                                "example_id": "96903a39-2be8-4420-95ee-d18cc410b4a7",
                                                "sense_id": "6249891a-6530-31bd-a309-6394de17ec24",
                                                "text": "„Die Ufer der Bucht sind kahl und so schroff, daß es nicht möglich ist, eine klippigere und felsigere Gegend zu sehen als die war, welche sich meinen Blicken darbot, als ich am Morgen auf das Verdeck trat.“"
                                            },
                                            {
                                                "example_id": "08ee28f0-2d61-4f19-ada3-87543bf25195",
                                                "sense_id": "6249891a-6530-31bd-a309-6394de17ec24",
                                                "text": "„Sie wirkt daher selbst nachtheilig auf das ihr vorliegende Festland zurück, von dem sie durch die klippigste Meeresgasse getrennt ist.“"
                                            },
                                            {
                                                "example_id": "cf3a6034-2d04-4372-80ec-d569b4b851f8",
                                                "sense_id": "6249891a-6530-31bd-a309-6394de17ec24",
                                                "text": "„Klippige Buchten, reich belebt mit Korallen, Brachiopoden und Strandschnecken, drangen wohl im Osten vom Gailtal her weit in das Land hinein, und ihre Wasser überfluteten in späterer Zeit den größten Teil der Zentralalpen;[…].“"
                                            },
                                            {
                                                "example_id": "25310b1e-9772-4083-a044-3ecd69cefc89",
                                                "sense_id": "6249891a-6530-31bd-a309-6394de17ec24",
                                                "text": "„An der Punta Salvore steht ein Leuchtturm, ein prächtiger Bau, und hinter ihm liegt, soweit das Auge schweift, eine klippige, flache Küste, über welche das mattglänzende Laub endloser Ölwälder flimmert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "klippig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1715208d-1738-397d-a019-bb7de197ab52",
                                        "entry_id": "105c8943-5c6b-325e-91a6-11d419301a92",
                                        "glosses": [
                                            "Namibia:"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7c185f0-b67a-3b69-bdec-2db7655356f3",
                                        "entry_id": "105c8943-5c6b-325e-91a6-11d419301a92",
                                        "glosses": [
                                            "aus Klippen¹ bestehend; mit Klippen¹ durchsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9295d29-fa72-3e5b-842c-86edcc6d9850",
                                        "entry_id": "105c8943-5c6b-325e-91a6-11d419301a92",
                                        "glosses": [
                                            "mit (vielen) Klippen² bedeckt; (zahlreiche) Klippen² aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e5cbad-d4b2-4aa9-95de-b8b76af14e05",
                                                "sense_id": "a9295d29-fa72-3e5b-842c-86edcc6d9850",
                                                "text": "„Mit solchen Abenteuern wie sechs km schlechte, klippige Pad bergauf zu fahren, um sich dort mit frechen Community-Wächtern zu amüsieren, die nur unser Bestes wollen - nämlich das, was wir in der Tasche haben - dann in einem zugegeben schönen Felspool zu baden, danach sich weiter mit schlechtem Licht nach Palmwag zu quälen, um dort um 2030h anzukommen - mit solchen witzlosen Abenteuern kann man vielleicht ausländischen Touristen imponieren, uns nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "face3ceb-ec17-3196-a758-c43b72f1022c",
                                        "entry_id": "105c8943-5c6b-325e-91a6-11d419301a92",
