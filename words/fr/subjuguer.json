{
    "word_family": [
        "subjugation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52445be2-3bfa-399a-b667-cf64ee80b293",
                    "sense_definition": "Exercer un très fort pouvoir de séduction ou d'attraction sur quelqu'un ; captiver ou fasciner profondément.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fascination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa voix mélodieuse a réussi à <w>subjuguer</w> l'ensemble du public dès les premières notes."
                        },
                        {
                            "text": "Le jeune peintre a complètement <w>subjugué</w> les critiques d'art lors de son premier vernissage."
                        }
                    ],
                    "synonyms": [
                        "captiver",
                        "envoûter",
                        "fasciner",
                        "charmer"
                    ],
                    "common_phrases": [
                        "subjuguer le public",
                        "subjuguer la foule"
                    ]
                },
                {
                    "sense_id": "9eb88a0e-86d5-3e39-889f-eea8e767be4e",
                    "sense_definition": "Soumettre une personne à son ascendant, à son autorité morale ou psychologique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "domination morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à sa forte personnalité, le directeur parvenait sans peine à <w>subjuguer</w> ses collaborateurs."
                        },
                        {
                            "text": "Elle refusait catégoriquement de se laisser <w>subjuguer</w> par les caprices de son supérieur."
                        }
                    ],
                    "synonyms": [
                        "dominer",
                        "maîtriser",
                        "soumettre"
                    ],
                    "antonyms": [
                        "libérer",
                        "émanciper"
                    ],
                    "common_phrases": [
                        "se laisser subjuguer",
                        "subjuguer la volonté"
                    ]
                },
                {
                    "sense_id": "6a449664-1795-39cf-9bc2-550fd0515606",
                    "sense_definition": "Réduire un peuple ou un pays en sujétion par la contrainte militaire ou politique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "domination politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée impériale cherchait à <w>subjuguer</w> les provinces rebelles par une démonstration de force."
                        },
                        {
                            "text": "Le conquérant est parvenu à <w>subjuguer</w> tout un peuple en supprimant ses libertés fondamentales."
                        }
                    ],
                    "synonyms": [
                        "asservir",
                        "assujettir",
                        "conquérir",
                        "soumettre"
                    ],
                    "antonyms": [
                        "affranchir",
                        "libérer"
                    ],
                    "common_phrases": [
                        "subjuguer un peuple",
                        "subjuguer une nation"
                    ]
                }
            ]
        }
    ]
}