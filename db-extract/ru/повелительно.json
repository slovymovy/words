                                        "entry_id": "3b91cf96-7bca-345d-b6fd-cd4e5e4e4c0a",
                                        "glosses": [
                                            "permanent hochmütig herrschen wollend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9536a7d9-d52e-4f7b-8954-d79ba9eb2f1f",
                                                "sense_id": "cc9fc6b0-bcbc-3362-80c9-09a7464b3b0e",
                                                "text": "Meine Schwester hat ein sehr herrisches Wesen."
                                            },
                                            {
                                                "example_id": "139dc710-0533-4b8d-aac6-a7b4913562e9",
                                                "sense_id": "cc9fc6b0-bcbc-3362-80c9-09a7464b3b0e",
                                                "text": "Mit seiner herrischen Art hat der alte Schmidt noch jede Pflegekraft vergrault."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
