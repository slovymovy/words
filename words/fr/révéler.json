    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0d37f9e-d7c8-3a01-bafe-3a79833e8f7a",
                    "sense_definition": "Faire connaître une chose secrète, cachée ou jusque-là inconnue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "divulgation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a refusé de <w>révéler</w> l'identité de sa source d'information aux enquêteurs."
                        },
                        {
                            "text": "Cette enquête approfondie a fini par <w>révéler</w> la vérité cachée depuis des années."
                        }
                    ],
                    "synonyms": [
                        "dévoiler"
                    ],
                    "common_phrases": [
                        "révéler un secret",
                        "révéler la vérité"
                    ]
                },
                {
                    "sense_id": "be5f3104-d73e-3c5d-9665-244f351ba297",
                    "sense_definition": "Apparaître tel qu'on est, faire preuve de qualités insoupçonnées ou s'avérer être.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle méthode de travail a fini par se <w>révéler</w> très efficace au quotidien."
                        },
                        {
                            "text": "Ce jeune chercheur s'est <w>révélé</w> être un collaborateur précieux pour toute l'équipe."
                        }
                    ],
                    "common_phrases": [
                        "se révéler utile",
                        "se révéler efficace"
                    ]
                },
                {
                    "sense_id": "7124a9ee-1252-3598-b542-fcc6b1096539",
                    "sense_definition": "Traiter chimiquement une surface sensible pour faire apparaître l'image photographique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "photographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le photographe utilise un bain chimique spécial pour <w>révéler</w> cette pellicule en noir et blanc."
                        },
                        {
                            "text": "Dans l'obscurité de la chambre noire, il faut du temps pour <w>révéler</w> une photographie."
                        }
                    ],
                    "common_phrases": [
                        "révéler une pellicule",
                        "révéler une photographie"
                    ]
                },
                {
                    "sense_id": "d25431e0-4e7d-3016-bb8f-5b2bfbade17c",
                    "sense_definition": "Faire connaître aux humains des vérités cachées par une inspiration surnaturelle ou divine.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon les croyants, Dieu a <w>révélé</w> sa volonté aux prophètes à travers des visions."
                        },
                        {
                            "text": "Les fidèles étudient les textes sacrés pour comprendre les mystères que la divinité a <w>révélés</w>."
                        }
                    ],
                    "common_phrases": [
                        "révéler sa volonté"
                    ]
                }
            ]
        }
    ]
