                "senses": [
                    {
                        "sense_id": "fe5cc689-8111-3b1f-a2bc-d1f56f5a021e",
                        "entry_id": "aaf23f68-6ef9-3fda-b007-0ea309846dc8",
                        "glosses": [
                            "Donner un caractère parascolaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb2d79ad-c8b8-4b77-b3da-f059cb6d3163",
                                "sense_id": "fe5cc689-8111-3b1f-a2bc-d1f56f5a021e",
                                "text": "« Un rapprochement très net s'opère en effet entre le parascolaire, qui devient de plus en plus joyeux, ludique et tonique, et le livre de jeunesse, qui se \" parascolarise \" », explique Christophe Vital-Durand, responsable du marketing parascolaire pour Bordas, Larousse et Les Éditions de La Cité."
                            }
                        ]
                    },
                    {
                        "sense_id": "757b1f36-5193-3785-afa1-62f517e69af5",
                        "entry_id": "aaf23f68-6ef9-3fda-b007-0ea309846dc8",
                        "glosses": [
                            "Faire participer à des activités parascolaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b04268c-a6ba-4fc1-8109-6402160f0544",
                                "sense_id": "757b1f36-5193-3785-afa1-62f517e69af5",
                                "text": "Ce modèle normatif du couple monogame, stable, des enfants scolarisés, et même parascolarisés, s'impose progressivement à tous les groupes sociaux, y compris les classes populaires."
                            }
                        ]
                    }
