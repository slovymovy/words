                ],
                "senses": [
                    {
                        "sense_id": "6d75f5af-c277-378a-9c02-6ce3c7695207",
                        "entry_id": "6f1cbf41-8400-3b70-8923-4eb91dbdc7ef",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "783cea4e-4657-4dad-8547-819dca83d90e",
                                "sense_id": "6d75f5af-c277-378a-9c02-6ce3c7695207",
                                "text": "Frau Pessel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "acc02535-e183-465f-add0-28943c3c4a46",
                                "sense_id": "6d75f5af-c277-378a-9c02-6ce3c7695207",
                                "text": "Herr Pessel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ac609db3-fde2-424a-b4d0-3656dbcddee6",
                                "sense_id": "6d75f5af-c277-378a-9c02-6ce3c7695207",
                                "text": "Die Pessels fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "33dd35cf-d3a0-4bdb-9bd3-b34a20f55fb7",
                                "sense_id": "6d75f5af-c277-378a-9c02-6ce3c7695207",
                                "text": "Der Pessel trägt nie die Pullover, die die Pessel ihm strickt."
                            },
                            {
                                "example_id": "62f212c8-a619-4202-992b-8cd37a9f4166",
                                "sense_id": "6d75f5af-c277-378a-9c02-6ce3c7695207",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pessel kommt, geht der Herr Pessel.“"
                            },
                            {
                                "example_id": "65d73d79-f00f-4854-823a-ad2b1fa2d469",
                                "sense_id": "6d75f5af-c277-378a-9c02-6ce3c7695207",
                                "text": "Pessel kommt und geht."
                            },
                            {
                                "example_id": "d1431f28-6c9b-4e47-b1ab-d55828d7f5f8",
                                "sense_id": "6d75f5af-c277-378a-9c02-6ce3c7695207",
                                "text": "Pessels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
