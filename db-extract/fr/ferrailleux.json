                                "example_id": "670a874c-332a-473a-bda8-47ce459ed571",
                                "sense_id": "a4be6406-1858-35b4-98c3-6199ba64cf7d",
                                "text": "Il ne reste plus que trois ferrailleux (il insista sur le terme, hautement péjoratif)."
                            },
                            {
                                "example_id": "92847488-eb14-4088-b4db-8cec7046b0ed",
                                "sense_id": "a4be6406-1858-35b4-98c3-6199ba64cf7d",
                                "text": "Dans le style industriels en tous genres, les « ferrailleux » n’étaient pas mal non plus."
                            },
                            {
                                "example_id": "56202411-5e23-4bc3-976c-9e3c5e0b9b33",
                                "sense_id": "a4be6406-1858-35b4-98c3-6199ba64cf7d",
                                "text": "À la boulangerie et à l’hôtellerie, c’était carrément les gitans, les ferrailleux qui régnaient en maîtres."
                            }
                        ]
                    }
