                },
                {
                    "sense_id": "d8f04c29-0027-345c-93cd-c4a83a90bd18",
                    "sense_definition": "de boom (Pistacia vera) waaraan de pistachenoten groeien",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pistache_boom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>pistache</w> groeit voornamelijk in droge gebieden zoals Iran en de Verenigde Staten.",
                            "target_lang_translations": {
                                "en": "The <w>pistachio tree</w> grows mainly in dry areas such as Iran and the United States."
                            }
                        },
                        {
                            "text": "In deze boomgaard staat een prachtige oude <w>pistache</w> die veel vruchten geeft.",
                            "target_lang_translations": {
                                "en": "In this orchard stands a beautiful old <w>pistachio tree</w> that yields a lot of fruit."
                            }
                        }
                    ],
                    "synonyms": [
