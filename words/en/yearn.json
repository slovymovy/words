                    "frequency": "Low",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seeing the frightened child weep, her heart <w>yearned</w> toward him with profound sympathy."
                        },
                        {
                            "text": "The mother's heart <w>yearned</w> over her sick child during the long night."
                        }
