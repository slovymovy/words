                ],
                "senses": [
                    {
                        "sense_id": "e0fdce97-b245-30b7-8e68-62ee8db2c73b",
                        "entry_id": "31b8921c-0df6-399d-bae7-b73d1fa125fc",
                        "glosses": [
                            "Enlever son caractère empirique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeaabb67-5db4-4022-b265-f39fed243a2f",
                                "sense_id": "e0fdce97-b245-30b7-8e68-62ee8db2c73b",
                                "text": "Enfin, j’ai en pour but constant, dans chaque partie de mon livre, de désempiriser la médecine en la faisant participer aux découvertes de la physiologie moderne."
                            },
                            {
                                "example_id": "49882e37-0790-409b-a022-b40ded4980f7",
                                "sense_id": "e0fdce97-b245-30b7-8e68-62ee8db2c73b",
                                "text": "J’ai toujours pensé que ce qui manquait à Habermas était une approche qui prenne en considération la relecture de Freud par Lacan : sa propre relecture de Freud est allée chercher des instruments langagiers, la pragmatique, la linguistique et les théories post-witgensteiniennes pour « désempiriser » le sujet de l’interprétation."
                            }
                        ]
                    }
                ],
