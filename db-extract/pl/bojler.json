                                            {
                                                "example_id": "ce3faac3-ef26-423d-8560-2a8d41ba0626",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "While it appears the FRM40_TEXT table is the answer, saving a form with boiler text does not seem to insert into this table."
                                            },
                                            {
                                                "example_id": "6e966bfd-cbf8-4b2d-b612-a7ad1abf7d5b",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "Note that Stuart Grey makes the assertion: \"I think rationally on all subjects.\", and then proceeds to use the standard boiler tactics and phrases of the people WHO instigate conflict and war."
                                            },
                                            {
                                                "example_id": "5ce037bc-2f6e-4089-9684-d930e9040dee",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "Nearly every employer in my field has similar terms (they all come out of a legal boiler mill somewhere)."
                                            },
                                            {
                                                "example_id": "96459558-e51f-4f41-86d5-b773c38793ab",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "Just aligning all the paragraphs of 'boiler text' is tedious but trying to insert values in alignment is impossible!"
                                            }
