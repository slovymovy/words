                "senses": [
                    {
                        "sense_id": "57e0b6e1-d233-3ed7-841c-472e2ef1df3f",
                        "entry_id": "f4a92a8e-0e8a-316d-b1c4-8697878f85e7",
                        "glosses": [
                            "dziewczyna, którą cechuje alternatywny ubiór i słuchanie niekonwencjonalnej muzyki"
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "4e82f103-499f-48dd-bc55-b4037c42b790",
                                "sense_id": "57e0b6e1-d233-3ed7-841c-472e2ef1df3f",
                                "text": "Alternatywki już nie są alternatywne, bo obecnie jest tyle alternatywek, że bardziej wyróżniają się z tłumu dziewczyny, które nie są alternatywkami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "986bba94-a3d5-41ca-9f14-804a2c4b0594",
                        "source_entry_id": "f4a92a8e-0e8a-316d-b1c4-8697878f85e7",
                        "source_sense_id": "57e0b6e1-d233-3ed7-841c-472e2ef1df3f",
                        "target_lang_word": "нестандартная",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b9925361-1e31-4750-bd2a-efd599f3fbab",
                        "source_entry_id": "f4a92a8e-0e8a-316d-b1c4-8697878f85e7",
                        "source_sense_id": "57e0b6e1-d233-3ed7-841c-472e2ef1df3f",
                        "target_lang_word": "девушка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "девушка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11bea698-2da9-3ffd-901c-a9c695bc5e33",
                                        "entry_id": "3751c608-4219-3de7-85dc-0051dc179ff1",
                                        "glosses": [
                                            "незамужнее лицо женского пола в период между отрочеством и юностью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0930bbb1-48ea-4455-9889-c5ff747adfd0",
                                                "sense_id": "11bea698-2da9-3ffd-901c-a9c695bc5e33",
                                                "text": "Подплыв ближе, он с удивлением увидел, что это был человек — женщина, молодая девушка."
                                            },
                                            {
                                                "example_id": "45120b7a-17c0-4d23-869a-2267d57723c6",
                                                "sense_id": "11bea698-2da9-3ffd-901c-a9c695bc5e33",
                                                "text": "Хозяйство невелико́, конечно, на двои́х-то… Катя — девушка проворная, долго ли ей!.. Управится и садится за какое рукоделье: сшить-связать, мало ли."
                                            },
                                            {
                                                "example_id": "3636e2e9-2466-418b-92f6-df048e7b0f68",
                                                "sense_id": "11bea698-2da9-3ffd-901c-a9c695bc5e33",
                                                "text": "Откинув голову, готовая обнять мир, с улыбкой счастья, девушка возноси́лась из бе́га морской волны, и свет влажно мерцал на крутой груди, ветер откидывал невесомые волосы, и вся она была порывом открытой солнцу юности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e264b5d-7b8f-3a70-ad96-dedcf71f60a2",
                                        "entry_id": "3751c608-4219-3de7-85dc-0051dc179ff1",
                                        "glosses": [
                                            "устар. горничная, прислуга"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a529334b-ee5d-3462-80d9-513180435cb4",
                                        "entry_id": "3751c608-4219-3de7-85dc-0051dc179ff1",
                                        "glosses": [
                                            "разг. обращение к молодой женщине"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a749847-3c2f-33b6-a722-db497290966a",
                                        "entry_id": "3751c608-4219-3de7-85dc-0051dc179ff1",
                                        "glosses": [
                                            "разг. подруга, возлюбленная или любовница, партнёрша в интимных отношениях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ced9174-06f2-4058-9700-baad3ee04f96",
                                                "sense_id": "6a749847-3c2f-33b6-a722-db497290966a",
                                                "text": "И моя девушка меня бросила ― ушла и живёт теперь с милиционером."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
