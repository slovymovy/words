                                        "entry_id": "2e46677d-61ba-3d4e-85f7-3394324873bc",
                                        "glosses": [
                                            "sich langsam und allmählich entwickelnd"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d557f3b-2e5e-4fa3-9d06-7e7d1e1f53f6",
                                                "sense_id": "6c7f5e14-c0f2-3fe3-b892-ec093aafc0de",
                                                "text": "Wir brauchen nicht immer eine Revolution, denn es reicht völlig, wenn wir uns evolutionär entwickeln."
                                            }
                                        ],
