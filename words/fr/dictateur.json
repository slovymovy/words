                {
                    "sense_id": "9820688e-2f06-3555-b65a-f1970115c528",
                    "sense_definition": "Chef d'État qui s'est emparé du pouvoir absolu et l'exerce sans contrôle constitutionnel ni démocratique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple s'est enfin soulevé pour renverser ce <w>dictateur</w> corrompu et tyrannique."
                        },
                        {
                            "text": "La chute du <w>dictateur</w> a permis d'instaurer des élections libres dans tout le pays."
                        }
                    ],
                    "synonyms": [
                        "autocrate",
                        "despote",
                        "tyran"
                    ],
                    "common_phrases": [
                        "chute du dictateur"
                    ]
                },
                {
                    "sense_id": "2041b42e-e650-37e1-b68e-681060cbd00d",
                    "sense_definition": "Personne très autoritaire qui cherche à imposer ses volontés à autrui sans tolérer la moindre contradiction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au bureau, ce chef d'équipe se comporte comme un véritable petit <w>dictateur</w> avec ses subordonnés."
                        },
                        {
                            "text": "Il refuse toute forme de dialogue et agit en <w>dictateur</w> au sein de sa famille."
                        }
                    ],
                    "synonyms": [
                        "despote",
                        "tyran"
                    ],
                    "common_phrases": [
                        "petit dictateur"
                    ]
                },
                {
                    "sense_id": "0e11d045-2d7b-3a74-be47-595bd91803e0",
                    "sense_definition": "Magistrat d'exception nommé temporairement dans la Rome républicaine en cas de crise grave.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "histoire_romaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face au danger militaire, le sénat a désigné un <w>dictateur</w> romain pour six mois."
                        },
                        {
                            "text": "Jules César a rompu les traditions républicaines en se faisant nommer <w>dictateur</w> à vie."
