                    {
                        "sense_id": "8084893f-d0d1-35ca-8f35-820d68d55d08",
                        "entry_id": "cf8cf46b-5a59-3f11-92c1-53e61ab09d5a",
                        "glosses": [
                            "Helligkeitsausbruch, der durch die Verschmelzung zweier Neutronensterne oder durch die Verschmelzung eines schwarzen Loches mit einem Neutronenstern auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8e1d74-e576-45dc-97bc-043773353091",
                                "sense_id": "8084893f-d0d1-35ca-8f35-820d68d55d08",
                                "text": "„Die Astronomen hoffen, dass künftige Beobachtungen weiterer Kilonovae mehr Licht in das Rätsel der kugelförmigen Kilonova bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f0ab3b4-a312-4598-9bdd-fa214164bd57",
                        "source_entry_id": "cf8cf46b-5a59-3f11-92c1-53e61ab09d5a",
                        "source_sense_id": "8084893f-d0d1-35ca-8f35-820d68d55d08",
                        "source_sense_description": "Helligkeitsausbruch, der durch die Verschmelzung zweier Neutronensterne oder durch die Verschmelzung eines schwarzen Loches mit einem Neutronenstern auftritt",
                        "target_lang_word": "kilonova",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kilonova",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cee00999-45f4-321b-a8ae-12a247462167",
                                        "entry_id": "2f118a85-b74f-3263-b2db-22d81ea578d1",
                                        "glosses": [
                                            "A type of supernova that is underluminous, caused by the merger of two neutron stars"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "825c94b2-3fa5-3be7-911e-2abc975f05b2",
                                        "entry_id": "2f118a85-b74f-3263-b2db-22d81ea578d1",
                                        "glosses": [
                                            "A radiation pattern typical of a kilonova."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a29d5544-0c6e-4054-b6f9-fa33567bc5b9",
                                                "sense_id": "825c94b2-3fa5-3be7-911e-2abc975f05b2",
                                                "text": "Moreover, during merger neutron-rich matter can be ejected that can shine as a kilonova due to the decay of r-process elements [2–13]."
                                            },
                                            {
                                                "example_id": "daff5ea4-bb47-4a52-a33b-941170477555",
                                                "sense_id": "825c94b2-3fa5-3be7-911e-2abc975f05b2",
                                                "text": "The observed energetics and temporal/spectral properties of the late infrared bump (ie, the \"kilonova\") are also found to be consistent with emission from the ejecta launched during a neutron star (NS)-NS merger and powered by a magnetar central engine."
                                            },
                                            {
                                                "example_id": "37121418-52c2-42c2-b066-cffe709651a0",
                                                "sense_id": "825c94b2-3fa5-3be7-911e-2abc975f05b2",
                                                "text": "Disk winds generally contribute to a ~week long transient peaking in the near-infrared (kilonova), although an optical precursor can manifest as a signature of delayed black hole formation or high black hole spin."
                                            },
                                            {
                                                "example_id": "b3ff4e06-08ce-475a-9010-294c543891bb",
                                                "sense_id": "825c94b2-3fa5-3be7-911e-2abc975f05b2",
                                                "text": "This component can give rise to an ≲1 d blue optical 'bump' in a kilonova light curve, even in the case of prompt BH formation, which may facilitate its detection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
