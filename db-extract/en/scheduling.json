                                    },
                                    {
                                        "sense_id": "24b9cbf2-64c3-39d5-b1e0-be1a576e042d",
                                        "entry_id": "c68578fd-91b9-3beb-88dd-01f3ada231b5",
                                        "glosses": [
                                            "Eigenschaft, in den Wartestand oder einstweiligen Ruhestand versetzt zu werden"
                                        ],
