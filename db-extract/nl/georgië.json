                                        "sense_id": "fbd3c4e0-2052-3792-8fdf-0db3782156f7",
                                        "entry_id": "53c64cae-8747-389b-bddf-ce432605a0e2",
                                        "glosses": [
                                            "eurasischer Staat im Südkaukasus (Transkaukasien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c2d878-3ec5-43e6-bb80-6dea424a980d",
                                                "sense_id": "fbd3c4e0-2052-3792-8fdf-0db3782156f7",
                                                "text": "Tiflis ist die Hauptstadt von Georgien."
                                            },
                                            {
                                                "example_id": "5f5a33fc-4d57-47ff-a791-e24b9a9917a3",
                                                "sense_id": "fbd3c4e0-2052-3792-8fdf-0db3782156f7",
                                                "text": "Ich komme aus Georgien."
                                            },
                                            {
                                                "example_id": "b6b3be05-ee96-440a-af69-6da01b6b50be",
                                                "sense_id": "fbd3c4e0-2052-3792-8fdf-0db3782156f7",
                                                "text": "„Jenseits der linken Leitplanke endet hier Georgiens Hoheitsgebiet. Und es beginnt Südossetien, die Separatisten-Republik von Russlands Gnaden.“"
                                            },
                                            {
                                                "example_id": "5049742a-bc37-44d7-ba1e-d651a0abd933",
                                                "sense_id": "fbd3c4e0-2052-3792-8fdf-0db3782156f7",
                                                "text": "„Der Krieg zwischen Georgien und Südossetien hat in Russland für einen ungeheueren Patriotismusschub gesorgt.“"
                                            },
                                            {
                                                "example_id": "1159e974-e05c-4ad4-a64b-09394cd418db",
                                                "sense_id": "fbd3c4e0-2052-3792-8fdf-0db3782156f7",
                                                "text": "„Dem Beispiel Georgiens folgten andere Unionsrepubliken, auch wenn das noch lange nicht hieß, dass sie aus der UdSSR ausgetreten waren, nur wussten alle, dass es über kurz oder lang so kommen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a6a5271-51a0-4b27-8e64-119fe7f258d6",
                        "source_entry_id": "4a747415-2d92-3668-afea-0f6bef6f7e7d",
                        "source_sense_id": "59ae3c80-c2be-3993-a782-31f2dfe51ceb",
                        "source_sense_description": "een soevereine staat in West-Azië, gelegen in de Kaukasus. De officiële taal is het Georgisch",
