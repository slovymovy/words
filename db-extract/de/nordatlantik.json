                ],
                "senses": [
                    {
                        "sense_id": "fcd27909-ffcf-3425-9424-9265b6ac6633",
                        "entry_id": "2bd42c69-e909-3df9-b226-36cee1bc4be2",
                        "glosses": [
                            "nördlich des Äquators liegender Teil des Atlantiks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c013908-6cf9-4938-b86e-cb82cd687faa",
                                "sense_id": "fcd27909-ffcf-3425-9424-9265b6ac6633",
                                "text": "Durch den Nordatlantik läuft der Golfstrom."
                            },
                            {
                                "example_id": "26e22616-6f83-41a9-86e6-f7ddbd7f0902",
                                "sense_id": "fcd27909-ffcf-3425-9424-9265b6ac6633",
                                "text": "„Das Wasser des Nordatlantiks wird auf sensationelle sechzehn Grad erhitzt, mediterran ist es hier trotzdem nicht.“"
                            },
                            {
                                "example_id": "75d7a48e-69bc-49bd-96f6-671203774b89",
                                "sense_id": "fcd27909-ffcf-3425-9424-9265b6ac6633",
                                "text": "„Atmosphärische Druckgradienten im Nordatlantik haben einen enormen Einfluss auf das Schicksal von Gesellschaften, von Westeuropa bis weit ins Innere Asiens.“"
                            },
                            {
                                "example_id": "f7f74b4e-d68b-4e12-8e14-f3cfa896a793",
                                "sense_id": "fcd27909-ffcf-3425-9424-9265b6ac6633",
                                "text": "„Mit den Färöer-Inseln und Grönland liegen zwei Teile Dänemarks fernab im Nordatlantik.“"
                            },
                            {
                                "example_id": "06ddeddc-94d5-4d35-b76a-f6cb76100b5c",
                                "sense_id": "fcd27909-ffcf-3425-9424-9265b6ac6633",
                                "text": "„Es war ein bitterkalter Winter am Nordatlantik, der Schnee in New York lag knietief, und als ich nach Paris zurückkam, hätte ich an der Gare de l'Est den ersten Zug nach Österreich nehmen sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
