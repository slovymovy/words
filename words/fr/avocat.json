                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son arrestation, le suspect a demandé à consulter un <w>avocat</w> sans attendre."
                        },
                        {
                            "text": "Son <w>avocat</w> a préparé tous les documents nécessaires pour le procès de demain."
                        }
                    ],
                    "synonyms": [
                        "homme de loi"
                    ],
                    "common_phrases": [
