                "senses": [
                    {
                        "sense_id": "81f8bfde-1dd1-3533-a7b0-99df4b10c6e2",
                        "entry_id": "cf2167c8-e7a1-35fa-b535-299051d6f928",
                        "glosses": [
                            "To degauss or demagnetize; especially, to degauss a ship by dragging a large powered electrical cable along its side."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "695579e4-9d06-4656-95fe-804f43f321d0",
                                "sense_id": "81f8bfde-1dd1-3533-a7b0-99df4b10c6e2",
                                "text": "Vessels wiped and depermed as outlined above were found to age towards their original state, so the processes as described were only effective for comparatively short periods and had to be repeated at regular intervals."
                            },
                            {
                                "example_id": "c0588194-551f-4c59-bd8b-275a9ba716b6",
                                "sense_id": "81f8bfde-1dd1-3533-a7b0-99df4b10c6e2",
                                "text": "Our present system deperms more reliably and is arranged to deperm the sensor each time the power source for the magnetometer is turned on."
                            },
                            {
                                "example_id": "6f23cf72-be41-4eab-b6c8-ccc8c1d5ecc8",
                                "sense_id": "81f8bfde-1dd1-3533-a7b0-99df4b10c6e2",
                                "text": "When it is not possible to deperm the assembly below 95% of the post exposure magnitude, ascertain if the component contains parts with permanent magnets such as relays which would not deperm in the 50 gauss field."
                            },
                            {
                                "example_id": "aad1b039-4474-49b3-84c5-abdc5630669f",
                                "sense_id": "81f8bfde-1dd1-3533-a7b0-99df4b10c6e2",
                                "text": "Deperming the boards individually lead to a significant decrease in the magnetic moment of the whole unit, this was then repeated on all units."
                            }
                        ]
                    }
                ],
