                        ],
                        "form": "das Schulkind"
                    },
                    {
                        "form_id": "e7743bbf-4f63-446f-b0b8-3cefee64e14c",
                        "entry_id": "aa2562f5-0734-37e0-b4ab-0b8df1b877ff",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schulkinder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60cab159-3e66-36e7-83b5-7d5230b57f63",
                        "entry_id": "aa2562f5-0734-37e0-b4ab-0b8df1b877ff",
                        "glosses": [
                            "männliches oder weibliches Kind, das eine Schule besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38123778-1d0f-449d-8e46-cfb57cdcbbee",
                                "sense_id": "60cab159-3e66-36e7-83b5-7d5230b57f63",
                                "text": "„Das Schulkind war hier nicht mehr ganz unbekannt.“"
                            },
                            {
                                "example_id": "1739581d-214d-4a84-af7f-c5656068a1b9",
                                "sense_id": "60cab159-3e66-36e7-83b5-7d5230b57f63",
                                "text": "„Ein Schulkind musste ordentlich aussehen, darüber gab es keine Diskussion, das verstand sich von selbst.“"
                            },
                            {
                                "example_id": "2f2fb534-d1cd-4f5b-bf58-1b94ae7e18ff",
                                "sense_id": "60cab159-3e66-36e7-83b5-7d5230b57f63",
                                "text": "„Die Gruppe der Schulkinder geht schnell weiter und setzt sich auf die Wiese, packt die Brotzeit aus und Limonade.“"
                            },
                            {
                                "example_id": "9553464e-49da-43b8-9ad7-020ea94c8495",
                                "sense_id": "60cab159-3e66-36e7-83b5-7d5230b57f63",
                                "text": "„Sie hatten eine kleine Druckerei gehabt, einen kleinen Verlag, eine Buchhandlung, aber jetzt hatten sie nur noch diesen kleinen Schreibwarenladen, in dem sie auch Süßigkeiten an Schulkinder verkauften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7b0d3ae-b73d-4df3-8dfe-d4ddbc4d4f4f",
                        "source_entry_id": "aa2562f5-0734-37e0-b4ab-0b8df1b877ff",
                        "source_sense_id": "60cab159-3e66-36e7-83b5-7d5230b57f63",
                        "source_sense_description": "männliches oder weibliches Kind, das eine Schule besucht",
                        "target_lang_word": "schoolchild",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schoolchild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6826a3c7-7552-32a7-a699-b78056e37581",
                                        "entry_id": "afcb9ae4-c399-3c46-b1c5-ded08f4ecb90",
                                        "glosses": [
                                            "A young person attending school or of an age to attend school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d7a3d43-5f26-42b1-be3b-bc0918a03d4e",
                                                "sense_id": "6826a3c7-7552-32a7-a699-b78056e37581",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups."
                                            },
                                            {
                                                "example_id": "4b4cd746-b67b-435f-8de0-38964dff095d",
                                                "sense_id": "6826a3c7-7552-32a7-a699-b78056e37581",
                                                "text": "[…] the Wisconsin legislature passed a law providing incentives for transfers of schoolchildren in the metropolitan area, both intradistrict and interdistrict."
                                            },
                                            {
                                                "example_id": "38810a14-37c9-4966-898c-fd24aa8efd08",
                                                "sense_id": "6826a3c7-7552-32a7-a699-b78056e37581",
                                                "text": "Spring ahead, fall back: Kathleen had once learned some rhyme about that when she was a schoolchild, but she no longer remembered it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "309f4e0c-b125-474c-a465-2aa4f8710083",
                        "source_entry_id": "aa2562f5-0734-37e0-b4ab-0b8df1b877ff",
                        "source_sense_id": "60cab159-3e66-36e7-83b5-7d5230b57f63",
                        "source_sense_description": "männliches oder weibliches Kind, das eine Schule besucht",
                        "target_lang_word": "schoolkid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schoolkid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a64da1c2-c5b1-3b59-9318-95e539231987",
                                        "entry_id": "56cd5b0c-f2e2-3525-beae-e31229d3514a",
                                        "glosses": [
                                            "A schoolchild, a kid who attends school; a schoolboy or schoolgirl."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "456890c4-0f75-4333-a88c-15fa5c8ec3d5",
                        "source_entry_id": "aa2562f5-0734-37e0-b4ab-0b8df1b877ff",
                        "source_sense_id": "60cab159-3e66-36e7-83b5-7d5230b57f63",
                        "source_sense_description": "männliches oder weibliches Kind, das eine Schule besucht",
                        "target_lang_word": "écolier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écolier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa44b404-697a-39ab-a5fd-b96ae3739dfd",
                                        "entry_id": "69826990-f04d-386a-98de-f03e1436b11a",
                                        "glosses": [
                                            "Élève des universités ; étudiant."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f8c840-175e-4a24-9b3f-92c017a37ed3",
                                                "sense_id": "fa44b404-697a-39ab-a5fd-b96ae3739dfd",
                                                "text": "[…] ; et personne ne sera de votre avis, parce que personne ne vous comprendra, si ce n'est vos écoliers, qui jurent ordinairement in verba magistri, et qui ergotisent, comme leurs maîtres, tantôt sur le froid, tantôt sur le chaud, sans trop savoir pourquoi."
                                            },
                                            {
                                                "example_id": "83ec917f-b18d-42e9-b3a4-218bee86fc24",
                                                "sense_id": "fa44b404-697a-39ab-a5fd-b96ae3739dfd",
                                                "text": "Henri, voulez-vous que je vous dise une chose ? reprit Marguerite en regardant fixement le duc, c’est que vous ne me faites plus l’effet d’un prince, mais d’un écolier ! Moi nier que je vous ai aimé !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                        "entry_id": "69826990-f04d-386a-98de-f03e1436b11a",
                                        "glosses": [
                                            "Celui qui étudie à l’école maternelle ou primaire, qui suit les petites classes d’un collège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ad43dca-df8e-49da-900e-e7e9b93153d7",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "Petit écolier."
                                            },
                                            {
                                                "example_id": "c7ac525f-2c8f-4f52-8882-42981675a1be",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "Écolier de sixième."
                                            },
                                            {
                                                "example_id": "8651905f-f502-420f-a422-f701c6aa5d78",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "Le maître et les écoliers."
                                            },
                                            {
                                                "example_id": "4fd024c5-085c-4a8d-8c77-95e0f6c146e7",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "Ce n’est qu’un écolier, il est encore écolier : Se dit de quelqu’un qui est peu habile, peu avancé dans une profession, dans un art."
                                            },
                                            {
                                                "example_id": "6aa30659-30d8-48fb-b7c8-46fd4f2fa27a",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "Une faute d’écolier : Une faute qui marque l’ignorance ou l’inexpérience."
                                            },
                                            {
                                                "example_id": "3d810e93-384d-4334-b9a4-10749466a523",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "Ce vieux diplomate a fait une faute d’écolier."
                                            },
                                            {
                                                "example_id": "6333df46-305d-4312-8155-edfd1dfa5bb6",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "Prendre le chemin des écoliers : Prendre le chemin le plus long, qui permet de flâner."
                                            },
                                            {
                                                "example_id": "6830ac5e-9a3a-450d-a9f7-b57aed84c4f1",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "Tour d’écolier, malice d’écolier : Espièglerie du genre de celles que font les écoliers."
                                            },
                                            {
                                                "example_id": "91167962-3d6d-461d-ae9e-74f799d8f0d1",
                                                "sense_id": "fc27805f-2451-3ba7-8494-ccac8c50e0b3",
                                                "text": "En ce qui vous concerne, c’est sans coups et et sans larmes, fort heureusement, que vous apprenez à lire le grec. Ce n’était pas le cas de tous les écoliers athéniens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
