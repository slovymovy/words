                ],
                "senses": [
                    {
                        "sense_id": "ff1237fd-d8f6-37d2-b862-9e6dd3018641",
                        "entry_id": "7285ee33-ce3e-3efe-89fd-ee3c4e9122ff",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce0c721b-db4c-4dbb-86b6-07cffa2b31a3",
                                "sense_id": "ff1237fd-d8f6-37d2-b862-9e6dd3018641",
                                "text": "Ends kamen, sahen und siegten."
                            },
                            {
                                "example_id": "9d39da16-7fb2-40ce-bf96-113e307ce763",
                                "sense_id": "ff1237fd-d8f6-37d2-b862-9e6dd3018641",
                                "text": "End kommt und geht."
                            },
                            {
                                "example_id": "470f6db8-0bd1-46e2-baad-b8dc122b679e",
                                "sense_id": "ff1237fd-d8f6-37d2-b862-9e6dd3018641",
                                "text": "Frau End ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "56e371e4-0ac1-4df3-a69c-5e403cefc1db",
                                "sense_id": "ff1237fd-d8f6-37d2-b862-9e6dd3018641",
                                "text": "Herr End wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3e051cfc-89b4-40e1-9217-7d43901080e1",
                                "sense_id": "ff1237fd-d8f6-37d2-b862-9e6dd3018641",
                                "text": "Die Ends fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8a16a411-1514-4ba0-ade4-861e4cc63c87",
                                "sense_id": "ff1237fd-d8f6-37d2-b862-9e6dd3018641",
                                "text": "Der End trägt nie die Pullover, die die End ihm strickt."
                            },
                            {
                                "example_id": "e13c5da8-d68e-41fd-ac25-45e2ba65ac01",
                                "sense_id": "ff1237fd-d8f6-37d2-b862-9e6dd3018641",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau End kommt, geht der Herr End.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
