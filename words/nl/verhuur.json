                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aan wie <w>verhuur</w> jij je garage?",
                            "target_lang_translations": {
