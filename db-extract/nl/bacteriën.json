                "senses": [
                    {
                        "sense_id": "72192362-7d4d-38f0-be91-39202a08e39c",
                        "entry_id": "4dafcddd-a299-3ab6-8324-199efa99d4e2",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord bacterie"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7048bd93-9714-42dd-88a5-080b37f12211",
                                "sense_id": "72192362-7d4d-38f0-be91-39202a08e39c",
                                "text": "Bacteriën zijn zeer belangrijk in vele processen in de natuur."
                            },
                            {
                                "example_id": "414a9bdd-325e-40ba-a09d-a38d735baf19",
                                "sense_id": "72192362-7d4d-38f0-be91-39202a08e39c",
                                "text": "Ik wilde absoluut niet een week in een hostel uitzieken, dus dwong ik mezelf altijd mijn filter te gebruiken, de SteriPen Ultra. Dit is een merkwaardige uitvinding die door middel van uv-licht alle parasieten en bacteriën in het water binnen negentig seconden uitschakelt."
                            }
                        ]
                    },
                    {
                        "sense_id": "89a40fa7-eef3-3b0d-a9d0-c6655957e41f",
                        "entry_id": "4dafcddd-a299-3ab6-8324-199efa99d4e2",
                        "glosses": [
                            "een van de drie taxonomische domeinen, Bacteria"
                        ],
                        "tags": [
                            "meervoudsvorm als officiële benaming"
                        ],
                        "examples": [
                            {
                                "example_id": "7a85fa1b-1b0d-41d4-8418-d05d8b40781f",
                                "sense_id": "89a40fa7-eef3-3b0d-a9d0-c6655957e41f",
                                "text": "Microbiologen maken een fundamenteel onderscheid tussen twee typen simpele eencelligen: de archaea (spreek uit: ar-gee-a) en de bacteriën."
                            }
                        ]
                    }
