                    "sense_definition": "подходить, соответствовать кому-либо или чему-либо",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта вещь <w>приходится</w> кстати в хозяйстве."
                        },
                        {
                            "text": "Новый проект <w>приходится</w> по душе всем сотрудникам."
                        }
                    ],
                    "synonyms": [
