                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1e57bf1-2ab6-3798-9e7d-a273bef837d8",
                        "entry_id": "45d5ec60-d149-3f85-a654-5f7e3e6c05db",
                        "glosses": [
                            "Wearing a cowl; hooded."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "af73d7fe-0d21-4985-ac35-6fb97fcb3215",
                                "sense_id": "c1e57bf1-2ab6-3798-9e7d-a273bef837d8",
                                "text": "She had thrown a shawl about her and, as they went together towards the tram, sprays of her fresh warm breath flew gaily above her cowled head and her shoes tapped blithely on the glassy road."
                            },
                            {
                                "example_id": "f583fec3-e4c5-401c-95df-9ffb5c0ecb89",
                                "sense_id": "c1e57bf1-2ab6-3798-9e7d-a273bef837d8",
                                "text": "Very soon I became aware that I must have got off the path, for snow-cowled shrubs lay directly in my way […]"
                            },
                            {
                                "example_id": "64d12ec4-9f63-460b-9fe5-c1d1cc05582e",
                                "sense_id": "c1e57bf1-2ab6-3798-9e7d-a273bef837d8",
                                "text": "We went out into the moonless and tortuous network of that incredibly ancient town; went out as the lights in the curtained windows disappeared one by one, and the Dog Star leered at the throng of cowled, cloaked figures that poured silently from every doorway and formed monstrous processions up this street..."
                            }
                        ]
                    },
                    {
                        "sense_id": "09eb316d-5cae-3c39-821f-a18656f69182",
                        "entry_id": "45d5ec60-d149-3f85-a654-5f7e3e6c05db",
                        "glosses": [
                            "Fitted with a cowl. (of a chimney)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6d3a5f2-bd7e-4d59-adbf-c29b89e621cf",
                                "sense_id": "09eb316d-5cae-3c39-821f-a18656f69182",
                                "text": "1977, Richard Adams, The Plague Dogs, Penguin, 1978, Fit 6, p. 234,\nThere were […] drifts of wood-smoke blowing from cowled chimneys."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e32252a-2cb5-3c36-b380-edceba9f68b6",
                        "entry_id": "45d5ec60-d149-3f85-a654-5f7e3e6c05db",
