            "senses": [
                {
                    "sense_id": "1eacf658-71e9-38fe-9eab-3e5845135274",
                    "sense_definition": "Qui a commis une faute, une infraction ou un crime.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "responsabilite_faute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a déclaré cet homme pleinement <w>coupable</w> après avoir examiné toutes les preuves."
                        },
                        {
                            "text": "Elle a préféré garder le silence parce qu'elle se sentait <w>coupable</w> de cet accident."
                        }
                    ],
                    "synonyms": [
                        "fautif",
                        "responsable"
                    ],
                    "antonyms": [
                        "innocent"
                    ],
                    "common_phrases": [
                        "reconnu coupable",
                        "se sentir coupable",
                        "se rendre coupable"
                    ]
                },
                {
                    "sense_id": "f603d05f-cdfd-3689-88fe-8b0362ea3a69",
                    "sense_definition": "Qui mérite d'être condamné ou blâmé, en parlant d'un acte, d'une attitude ou d'un sentiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsabilite_faute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son silence <w>coupable</w> a permis aux malfaiteurs de quitter la ville sans inquiétude."
                        },
                        {
                            "text": "Manger tout ce gâteau au chocolat était pour elle un véritable plaisir <w>coupable</w>."
                        }
                    ],
                    "synonyms": [
                        "condamnable",
                        "répréhensible",
                        "blâmable"
                    ],
                    "antonyms": [
                        "irréprochable",
                        "louable"
                    ],
                    "common_phrases": [
                        "plaisir coupable",
                        "négligence coupable",
                        "silence coupable"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0177c448-15b4-301a-9b26-bbcfd24a4ac7",
                    "sense_definition": "Personne qui a commis un délit, un crime ou une mauvaise action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "responsabilite_faute",
                    "name_type": "no",
                    "examples": [
                        {
