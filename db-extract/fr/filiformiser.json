                "senses": [
                    {
                        "sense_id": "7115bdf2-133c-36e4-aacc-df9667abee8f",
                        "entry_id": "96f9ea64-9b18-38dd-969e-390deac82404",
                        "glosses": [
                            "Rendre filiforme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf576f6-88be-45e7-82c1-b36ea4a13a50",
                                "sense_id": "7115bdf2-133c-36e4-aacc-df9667abee8f",
                                "text": "Le trait lui-même peut participer à ce désir d'étalement soit en s’élargissant ou en étant plus ou moins fortement appuyé, soit en se laissant « filiformiser » par le mouvement d’ensemble."
                            },
                            {
                                "example_id": "11882170-b61f-4dc2-bef8-c68809c68429",
                                "sense_id": "7115bdf2-133c-36e4-aacc-df9667abee8f",
                                "text": "Vos femmes, cher ami, dédient la plus grande partie de leur temps à s’épiler, à maigrir, à se \"filiformiser\", à se faire \"gonfler\" les seins... à s’auto-mutiler."
                            },
                            {
                                "example_id": "9f932908-35b6-41f2-a31a-c339651d08d8",
                                "sense_id": "7115bdf2-133c-36e4-aacc-df9667abee8f",
                                "text": "T'as qu'à te filiformiser"
                            }
                        ]
                    }
