{
    "word_family": [
        "minister",
        "ministerial",
        "ministration",
        "administer",
        "administration",
        "administrative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b44fec5b-8bdc-33ad-b658-ca9b78ffcc2f",
                    "sense_definition": "A government department responsible for a specific area of public administration, usually headed by a minister.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "government_department",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ministry</w> has announced new regulations regarding public health safety.",
                            "target_lang_translations": {
                                "ru": "<w>Министерство</w> объявило о новых правилах, касающихся безопасности общественного здоровья.",
                                "zh": "<w>部</w>门宣布了关于公共卫生安全的新规定。"
                            }
                        },
                        {
                            "text": "She has worked for the foreign <w>ministry</w> for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Она проработала в <w>министерстве</w> иностранных дел более двадцати лет.",
                                "zh": "她在外交<w>部</w>工作了二十多年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "department",
                        "bureau"
                    ],
                    "common_phrases": [
                        "foreign ministry",
                        "ministry of defence",
                        "ministry of education",
                        "health ministry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правительственное ведомство, отвечающее за определенную сферу государственного управления, обычно возглавляемое министром.",
                        "zh": "政府中负责特定行政领域的部门，通常由部长领导。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "министерство",
                                "target_lang_sense_clarification": "государственный орган"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部",
                                "target_lang_sense_clarification": "政府行政部门"
                            },
                            {
                                "target_lang_word": "部委",
                                "target_lang_sense_clarification": "政府部门的统称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48328dfb-e269-3ac0-81e1-bf33696f6419",
                    "sense_definition": "The vocation, duties, or period of service of a religious minister.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a strong calling to enter the <w>ministry</w> after finishing college.",
                            "target_lang_translations": {
                                "ru": "После окончания колледжа он почувствовал сильное призвание посвятить себя <w>священству</w>.",
                                "zh": "大学毕业后，他感到一种强烈的召唤，决定投身<w>圣职</w>。"
                            }
                        },
                        {
                            "text": "Her <w>ministry</w> focuses on providing support to homeless families in the city.",
                            "target_lang_translations": {
                                "ru": "Её <w>служение</w> сосредоточено на оказании поддержки бездомным семьям в городе.",
                                "zh": "她的<w>事工</w>专注于为城里的无家可归家庭提供支持。"
                            }
                        }
                    ],
                    "synonyms": [
                        "priesthood",
                        "vocation"
                    ],
                    "common_phrases": [
                        "enter the ministry",
                        "youth ministry",
                        "pastoral ministry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Призвание, обязанности или период службы религиозного служителя.",
                        "zh": "宗教神职人员的职业、职责或服务期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служение",
                                "target_lang_sense_clarification": "религиозная деятельность"
                            },
                            {
                                "target_lang_word": "священство",
                                "target_lang_sense_clarification": "духовный сан"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣职",
                                "target_lang_sense_clarification": "宗教神职工作"
                            },
                            {
                                "target_lang_word": "牧职",
                                "target_lang_sense_clarification": "牧师的职责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e116a290-714c-312d-ac6c-50f03f2c21bd",
                    "sense_definition": "The collective body of government ministers led by a prime minister.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "government_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prime minister formed a new <w>ministry</w> following the recent general election.",
                            "target_lang_translations": {
                                "ru": "Премьер-министр сформировал новый <w>кабинет министров</w> после недавних всеобщих выборов.",
                                "zh": "大选后，总理组建了新的<w>内阁</w>。"
                            }
                        },
                        {
                            "text": "Several members of the <w>ministry</w> resigned in protest against the proposed law.",
                            "target_lang_translations": {
                                "ru": "Несколько членов <w>правительства</w> ушли в отставку в знак протеста против предложенного закона.",
                                "zh": "几位<w>内阁</w>成员因抗议拟议的法律而辞职。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cabinet",
                        "administration",
                        "government"
                    ],
                    "common_phrases": [
                        "form a ministry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коллективный орган министров правительства во главе с премьер-министром.",
                        "zh": "由总理或首相领导的政府部长集体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинет министров",
                                "target_lang_sense_clarification": "состав правительства"
                            },
                            {
                                "target_lang_word": "правительство",
                                "target_lang_sense_clarification": "исполнительная власть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内阁",
                                "target_lang_sense_clarification": "政府核心决策机构"
                            },
                            {
                                "target_lang_word": "政府",
                                "target_lang_sense_clarification": "行政当局"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dff076ff-372b-3199-ac0f-e5d7884800dd",
                    "sense_definition": "The members of the clergy collectively, especially in Protestant churches.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire <w>ministry</w> gathered at the cathedral for the annual conference.",
                            "target_lang_translations": {
                                "ru": "Всё <w>духовенство</w> собралось в соборе на ежегодную конференцию.",
                                "zh": "全体<w>神职人员</w>聚集在大教堂参加年度会议。"
                            }
                        },
                        {
                            "text": "Members of the <w>ministry</w> are expected to set a moral example for the community.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что представители <w>духовенства</w> будут подавать нравственный пример обществу.",
                                "zh": "<w>神职人员</w>应当为社区树立道德榜样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clergy"
                    ],
                    "antonyms": [
                        "laity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность священнослужителей, особенно в протестантских церквях.",
                        "zh": "神职人员的统称，尤指新教教会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовенство",
                                "target_lang_sense_clarification": "сообщество священников"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神职人员",
                                "target_lang_sense_clarification": "教会圣职人员集体"
                            },
                            {
                                "target_lang_word": "牧师团",
                                "target_lang_sense_clarification": "牧师群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c82ee69-a04a-3982-a01d-2d40215a4441",
                    "sense_definition": "The act of serving, helping, or ministering to others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were grateful for the <w>ministry</w> of the nurses during the epidemic.",
                            "target_lang_translations": {
                                "ru": "Они были благодарны за <w>служение</w> медсестер во время эпидемии.",
                                "zh": "他们对疫情期间护士们的<w>照料</w>心存感激。"
                            }
                        },
                        {
                            "text": "His life was dedicated to the <w>ministry</w> of the poor and sick.",
                            "target_lang_translations": {
                                "ru": "Его жизнь была посвящена <w>служению</w> бедным и больным.",
                                "zh": "他一生致力于<w>服务</w>贫困和病患。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ministration",
                        "service",
                        "care"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность по оказанию помощи, служению или заботе о других.",
                        "zh": "为他人提供服务、帮助或照料的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служение",
                                "target_lang_sense_clarification": "самоотверженная помощь"
                            },
                            {
                                "target_lang_word": "попечение",
                                "target_lang_sense_clarification": "забота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "服务",
                                "target_lang_sense_clarification": "提供帮助的行为"
                            },
                            {
                                "target_lang_word": "照料",
                                "target_lang_sense_clarification": "对病患或弱势群体的关怀"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}