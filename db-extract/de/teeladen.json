                "senses": [
                    {
                        "sense_id": "c7082705-7868-3b74-b4c7-1fe22aa479b0",
                        "entry_id": "7422f97c-f9b1-3bab-af67-b50aaf54dab9",
                        "glosses": [
                            "Fachgeschäft für Tee und Teezubehör"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f7c399-40cc-4e6e-aeaa-e7a1601e33b7",
                                "sense_id": "c7082705-7868-3b74-b4c7-1fe22aa479b0",
                                "text": "„Nebenan war ein Teeladen, ein schmaler Raum, wo in schönen Porzellangefäßen, in Reihen rot beklebter Büchsen und grell bemalter Holzschachteln die Teesorten standen wie die Klassiker in einer ordentlichen Bibliothek.“"
                            },
                            {
                                "example_id": "bc6f8d67-8828-4c7b-a97e-e21c9c3d5b0b",
                                "sense_id": "c7082705-7868-3b74-b4c7-1fe22aa479b0",
                                "text": "„Einen edlen chinesischen Teeladen kann man mit einer Handlung für exquisite Weine in Europa vergleichen: Auch Tee kennt bessere und schlechtere Jahrgänge, für erlesene Blätter zahlen Kenner soviel wie Weinliebhaber für einen guten Tropfen, und die Zeremonie ähnelt einer Weinprobe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
