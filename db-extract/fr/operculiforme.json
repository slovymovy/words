                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80748549-8b7a-4fb9-814a-356432ce63ee",
                                "sense_id": "248ec829-40ff-386f-8deb-79a435227eea",
                                "text": "OPERCULIFORME, adject., operculiformis (operculum, couvercle, forma, forme) ; qui a la forme d’un opercule ou d’un couvercle, comme la valve plate de certaines coquilles bivalves. Ex. Ostrea."
                            },
                            {
                                "example_id": "11a4de8b-4490-4c6b-a677-f681237336bd",
                                "sense_id": "248ec829-40ff-386f-8deb-79a435227eea",
                                "text": "La valve supérieure, operculiforme, presque plane ou très légèrement concave au centre, présente les mêmes bandes, les mêmes plis et les mêmes lignes dʼaccroissement concentriques que la valve inférieure."
                            }
                        ]
                    }
