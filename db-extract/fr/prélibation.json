                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e433b4-ae57-4e3d-85c5-c5d94f18c95f",
                                "sense_id": "ad0eb060-e6ce-3fde-8f3b-c41301251a47",
                                "text": "Nous en avons parfois comme une prélibation au sommet dʼune montagne péniblement gravie : lʼespace dʼun instant, lʼexistence se densifie en une présence souveraine, presque intemporelle."
                            },
                            {
                                "example_id": "a83421ed-2538-4853-88b0-3b89eac60de1",
                                "sense_id": "ad0eb060-e6ce-3fde-8f3b-c41301251a47",
                                "text": "Elle m'a donné, à l'âge de l'innocence absolue, comme une prélibation de l'enivrante Italie et de la perversité napolitaine."
                            }
                        ]
                    }
