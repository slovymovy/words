                "senses": [
                    {
                        "sense_id": "21ca722b-417e-30e4-a9f0-89a75b5cb634",
                        "entry_id": "ea965792-9b75-33d6-a929-41ec845ae2d1",
                        "glosses": [
                            "процесс продольного складывания и спирального скручивания отдельных волокон для получения длинной и прочной нити"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42eb3df6-6255-4f1b-9072-a6a03f52761d",
                                "sense_id": "21ca722b-417e-30e4-a9f0-89a75b5cb634",
                                "text": "Раннее прядение шёлка из паутины шёлковых червей в восточной Азии предполагает высокую образованность, там некогда существовавшую."
                            },
                            {
                                "example_id": "191099ab-54c5-4fc5-bf46-79c8b80891a9",
                                "sense_id": "21ca722b-417e-30e4-a9f0-89a75b5cb634",
                                "text": "Отдельные прядильщики и ткачи … не могут достичь ни такой предварительной подготовки волокон, ни такой, как на фабриках, однородности нитей и тканей, а потому те, которые сетуют на переход к фабрикам домашнего прядения и ткачества, в сущности восстают против основных начал экономической жизни."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "faae53a5-b674-45df-8d35-8ae41484b18b",
                        "source_entry_id": "ea965792-9b75-33d6-a929-41ec845ae2d1",
                        "source_sense_id": "21ca722b-417e-30e4-a9f0-89a75b5cb634",
                        "target_lang_word": "filage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6096edd9-481e-34b8-805d-fd27ac8f4e9d",
                                        "entry_id": "56185a70-e91d-3985-a345-cda5bc1aa4ea",
                                        "glosses": [
                                            "Action ou manière de filer le chanvre, le lin, la laine, la soie, et toute fibre textile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a5d8d3-123b-48a6-9e63-94d18b65ce03",
                                                "sense_id": "6096edd9-481e-34b8-805d-fd27ac8f4e9d",
                                                "text": "Le filage de la laine destinée pour faire la chaîne d’une étoffe est différent de celui de la trame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c22470-0ff3-3b27-9d12-639a1120a691",
                                        "entry_id": "56185a70-e91d-3985-a345-cda5bc1aa4ea",
                                        "glosses": [
                                            "L’une des dernières répétitions avant la répétition générale d’un spectacle servant à en évaluer la durée, à règler les détails techniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cfe65a3-8f36-4594-a2b9-942153a8100a",
                                                "sense_id": "e1c22470-0ff3-3b27-9d12-639a1120a691",
                                                "text": "« On n’entend rien, hein ? » me dit-il funèbre, après le dernier « filage »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5376abdb-f81e-3b84-9595-ca26389a7ac5",
                                        "entry_id": "56185a70-e91d-3985-a345-cda5bc1aa4ea",
                                        "glosses": [
                                            "Procédé de fabrication de pièce en terre cuite (tuile, brique, etc.) par extrusion de la terre crue et humide au travers une filière, puis par tranchage une fois la longueur désirée de la pièce atteinte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c34dc0-e301-4a16-a458-8371736180d2",
                                                "sense_id": "5376abdb-f81e-3b84-9595-ca26389a7ac5",
                                                "text": "Tuiles canal : elles sont obtenues par filage et coupées à l'aide d'un coupeur à main dit archet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "527a350b-b432-3359-81c2-85114723cae3",
                                        "entry_id": "56185a70-e91d-3985-a345-cda5bc1aa4ea",
                                        "glosses": [
                                            "Réalisation de filets en peinture sur des encadrements, divers ornements ou trompe-l’œil."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea29f8b9-b8c0-4d12-b82a-8f62ce9d9004",
                                                "sense_id": "527a350b-b432-3359-81c2-85114723cae3",
                                                "text": "Le filage est une autre spécialité qui, dans les travaux de bâtiment, vient compléter la peinture en décor ou la peinture unie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0294c2-1d78-36c5-b11b-7b7c99bfa0d6",
                                        "entry_id": "56185a70-e91d-3985-a345-cda5bc1aa4ea",
                                        "glosses": [
                                            "École buissonnière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8198a5ff-35a4-46c4-968b-7881b03b115c",
                                                "sense_id": "1e0294c2-1d78-36c5-b11b-7b7c99bfa0d6",
                                                "text": "Et je n’ai jamais raté un filage ; je me suis empressé de manquer la classe aussi souvent que j’ai pu, pour filer en bateau sur le Furens, ou près de la forge, dans la grande usine, dont le père de Terrasson est le contre-maître."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8419c647-816a-40a8-9f27-6ecec4770d06",
                        "source_entry_id": "ea965792-9b75-33d6-a929-41ec845ae2d1",
                        "source_sense_id": "21ca722b-417e-30e4-a9f0-89a75b5cb634",
                        "target_lang_word": "filature",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filature",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71a3e828-901f-31f6-93c4-b16981afdf67",
                                        "entry_id": "45e5dfbc-60af-3d88-8e1f-04db41858f21",
                                        "glosses": [
                                            "Usine où l’on file en grand les matières textiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc189cf-08f2-4b84-acc8-ae3603c48c1f",
                                                "sense_id": "71a3e828-901f-31f6-93c4-b16981afdf67",
                                                "text": "Filature de soie, de laine, de coton."
                                            },
                                            {
                                                "example_id": "5a3807d4-2432-4d86-aef4-5ff35a064550",
                                                "sense_id": "71a3e828-901f-31f6-93c4-b16981afdf67",
                                                "text": "Le contremaître, les ouvriers d’une filature."
                                            },
                                            {
                                                "example_id": "a74fdaa1-5029-4572-9dbb-437dc10d5103",
                                                "sense_id": "71a3e828-901f-31f6-93c4-b16981afdf67",
                                                "text": "Il raviva le commerce des toiles, la ville eut une filature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31aa76ab-58f2-3e99-a51b-fe9388726ba0",
                                        "entry_id": "45e5dfbc-60af-3d88-8e1f-04db41858f21",
                                        "glosses": [
                                            "Action ou art de filer en grand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef34c5b7-d777-464a-b451-f393e853f463",
                                                "sense_id": "31aa76ab-58f2-3e99-a51b-fe9388726ba0",
                                                "text": "Le travail de filature consiste à retirer le fil du cocon dont la longueur est d'environ 480 mètres et à le dévider sans le briser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74526ec-6f85-3cfd-91f2-c0c014e36161",
                                        "entry_id": "45e5dfbc-60af-3d88-8e1f-04db41858f21",
                                        "glosses": [
                                            "Usine ou atelier où l’on élabore des andouilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508149b5-c130-4fcc-8436-cb21a66daae4",
                                                "sense_id": "f74526ec-6f85-3cfd-91f2-c0c014e36161",
                                                "text": "[..] Depuis l’achat de la Maison Danjou (filature d’andouille centenaire) jusqu’à sa vente récente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45ef8143-7ef0-353d-9dca-1daa58a26f00",
                                        "entry_id": "45e5dfbc-60af-3d88-8e1f-04db41858f21",
                                        "glosses": [
                                            "Action de suivre quelqu’un pour le surveiller."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b293b53a-7c9b-4a11-b6e3-bbe3795c1dc3",
                                                "sense_id": "45ef8143-7ef0-353d-9dca-1daa58a26f00",
                                                "text": "Dans la circonstance actuelle, le policier était obligé d’opter entre l’une ou l’autre des filatures."
                                            },
                                            {
                                                "example_id": "462d9382-32c0-46aa-9cee-bfb2a7d2da32",
                                                "sense_id": "45ef8143-7ef0-353d-9dca-1daa58a26f00",
                                                "text": "Un détective peut prendre quelqu’un en filature."
                                            },
                                            {
                                                "example_id": "054b7ddd-d509-4980-a89b-289b0789b2c6",
                                                "sense_id": "45ef8143-7ef0-353d-9dca-1daa58a26f00",
                                                "text": "Puis, à force de surveillance et de filatures, ils ont débordé sur les départements voisins et remonté les échelons d’un réseau de revendeurs de cannabis, heroïne et cocaïne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
