                                        "entry_id": "a1ed54ce-759c-3faf-b8f8-2f7cf2a88cbd",
                                        "glosses": [
                                            "~ gaan met tegelijkertijd optreden, onlosmakelijk verbonden zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e679e56-2173-4534-ba0e-1376bcd4b1e9",
                                                "sense_id": "6f55851d-ce63-38c5-8a01-3839cab1ba7d",
                                                "text": "Een onweersbui gaat vaak gepaard met slagregens, hagel en windstoten."
                                            },
                                            {
                                                "example_id": "374a33ea-fc13-4b49-a505-fabdf12f6554",
                                                "sense_id": "6f55851d-ce63-38c5-8a01-3839cab1ba7d",
                                                "text": "Zeebiologen waarschuwden begin vorig jaar al dat de aanhoudende recordtemperaturen van het zeewater tot grootschalige verbleking van het koraal zou leiden. Die hoge temperaturen zijn het gevolg van de klimaatverandering en het periodieke weerfenomeen El Niño, dat gepaard gaat met opwarming van het zeewater in de Stille Oceaan. De daarop volgende La Niña die op haar beurt voor afkoeling zorgt, duurde korter dan normaal, waardoor de riffen geen tijd hadden om te herstellen."
                                            }
                                        ]
                                    }
