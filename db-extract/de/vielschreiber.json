                "senses": [
                    {
                        "sense_id": "ae41f945-401b-3216-be3f-62e495176692",
                        "entry_id": "b8ab665e-e5e0-3259-b695-1ba4881d8ac6",
                        "glosses": [
                            "Person, die sehr viele Texte verfasst, dabei aber Qualitätsstandards oft verfehlt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "967964f0-2d62-48a6-9c1a-e31711ed5b7e",
                                "sense_id": "ae41f945-401b-3216-be3f-62e495176692",
                                "text": "„Obwohl Dik ein überaus produktiver Vielschreiber war, gelangte er dabei nicht zu Wohlstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f4f1093-dee0-440e-ba1f-73617d67e872",
                        "source_entry_id": "b8ab665e-e5e0-3259-b695-1ba4881d8ac6",
                        "source_sense_id": "ae41f945-401b-3216-be3f-62e495176692",
                        "source_sense_description": "abwertend: Person, die sehr viele Texte verfasst, dabei aber Qualitätsstandards oft verfehlt",
                        "target_lang_word": "écrivaillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écrivaillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a19d7a44-13d2-39f7-8cae-3671b64a7681",
                                        "entry_id": "473961c8-5323-321d-bde2-21cc5b550f6a",
                                        "glosses": [
                                            "Écrivain médiocre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27f020e8-d60a-4ead-b596-c3361689a4b9",
                                                "sense_id": "a19d7a44-13d2-39f7-8cae-3671b64a7681",
                                                "text": "Il a pris du poil de la bête en apprenant que j’écrivais :\n— Les écrivaillons de Saint-Germain-des-Prés, j’en fais un chaque matin.\n— Ça, lui ai-je dit, c’est un jugement littéraire.\n— À propos de jugement, vous feriez mieux de la boucler parce qu’il y a aussi des flagrants délits qui sont drôlement bien torchés."
                                            },
                                            {
                                                "example_id": "faa35312-fd1c-4109-b19e-60444d0a1174",
                                                "sense_id": "a19d7a44-13d2-39f7-8cae-3671b64a7681",
                                                "text": "Alors si un putain d’écrivaillon, pris sous votre aile, pouvait sortir un livre qui redore notre blason et fasse que les instances supérieures me lâchent un peu la bride : je prends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad3ebb18-a69c-405f-b524-e716585bf2a6",
                        "source_entry_id": "b8ab665e-e5e0-3259-b695-1ba4881d8ac6",
                        "source_sense_id": "ae41f945-401b-3216-be3f-62e495176692",
                        "source_sense_description": "abwertend: Person, die sehr viele Texte verfasst, dabei aber Qualitätsstandards oft verfehlt",
                        "target_lang_word": "écrivailleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écrivailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
                                        "entry_id": "1c9297d5-8f54-3da9-9f21-4857cdc5f52e",
                                        "glosses": [
                                            "Écrivain médiocre."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d10f3af7-5043-4e24-aa11-439686abe5c7",
                                                "sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
                                                "text": "Nini et Tangol, qui avaient connu la Fleur d’Herbes de Madagascar du temps de sa splendeur à la Réunion, n’en revenaient pas de la savoir acoquinée et mêlée aux bafouilles d’un écrivailleur."
                                            },
                                            {
                                                "example_id": "95c9c364-89d6-4f25-8c14-d09f38433607",
                                                "sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
                                                "text": "Processif, écrivailleur, il minutait des lettres douces et polies à ses locataires ; mais au fond de son style comme sous sa mine fade et prévenante se cachait l’âme de Shylock."
                                            },
                                            {
                                                "example_id": "eab7eca6-7518-4963-b492-10163d3fe919",
                                                "sense_id": "6e89a68e-d44b-31b2-b1a8-ab79f402b07e",
                                                "text": "Et tout cela, il le savait, la presse et les langues de dix milliards de personnes et les plumes ou les machines de cent millions d’écrivailleurs professionnels le diraient, l’écriraient, le chuchoteraient ou le clameraient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
