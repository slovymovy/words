                                    {
                                        "sense_id": "2e21cbdb-8894-3ff0-a8ae-2ab6413740a8",
                                        "entry_id": "558c56f6-23e0-3e0e-b764-baa5f881760b",
                                        "glosses": [
                                            "Spécialiste de l’optométrie, de la mesure des propriétés optiques de l’œil."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00cde91c-7421-45a8-8aff-2d0ebef49c07",
                                                "sense_id": "2e21cbdb-8894-3ff0-a8ae-2ab6413740a8",
                                                "text": "Un temps fort de la cérémonie a été la remise des attestations aux médecins inscrits en CES, aux techniciens spécialisés en ophtalmologie et aux optométristes."
                                            },
                                            {
                                                "example_id": "4468fdfd-404e-4b10-8cf2-09ec4880b3bf",
                                                "sense_id": "2e21cbdb-8894-3ff0-a8ae-2ab6413740a8",
                                                "text": "Dans nos trois établissements, on a des étudiants qui vont aller vers l’entrepreneuriat, qu’ils soient dentistes, optométristes, ingénieurs, comptables… ce sont des gens qui sont dans un de nos trois établissements et qui, tous, vont devoir bâtir leur entreprise."
                                            },
                                            {
                                                "example_id": "8bb748c6-05fe-4c1f-b3c0-a42c22aa177b",
                                                "sense_id": "2e21cbdb-8894-3ff0-a8ae-2ab6413740a8",
                                                "text": "Alors que cet optométriste retraité lui avait d’abord réclamé plus de 3 millions de dollars de dommages et intérêts en réparation d’un traumatisme crânien et de quatre côtes cassées, elle avait porté plainte en l’accusant de vouloir « profiter de [sa] notoriété »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17393f1a-9728-342e-8f5d-0acecb371330",
                                        "entry_id": "558c56f6-23e0-3e0e-b764-baa5f881760b",
                                        "glosses": [
                                            "Opticien sachant déterminer les défaut de l’œil et de la vision pour prescrire des lunettes adaptées."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
