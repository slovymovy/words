                "senses": [
                    {
                        "sense_id": "ee8e78ac-185e-3889-9b66-d3159955cc37",
                        "entry_id": "cfb3b814-306e-36fa-90db-4ac4c91b8538",
                        "glosses": [
                            "bestimmte Art von Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78007461-c752-49c2-b674-c7045a7b0b23",
                                "sense_id": "ee8e78ac-185e-3889-9b66-d3159955cc37",
                                "text": "„Die Vorliebe der Kelten für das Bier ist nicht zuletzt durch römische Schriftsteller gut belegt – Plinius, der Ältere, (23-79 n. Chr.) etwa berichtet von zahlreichen verschiedenen Biersorten aus Gallien und Hispanien.“"
                            },
                            {
                                "example_id": "7f6d8f62-edbc-4cf2-8240-3dc0f0732320",
                                "sense_id": "ee8e78ac-185e-3889-9b66-d3159955cc37",
                                "text": "„Einige Biersorten aber hätte es ohne die Entdeckung Amerikas wohl gar nicht gegeben.“"
                            },
                            {
                                "example_id": "ec2ad3ff-ac58-4551-a97e-751bc8309ec1",
                                "sense_id": "ee8e78ac-185e-3889-9b66-d3159955cc37",
                                "text": "„Der Brauer-Bund schätzt, dass es allein in Deutschland mittlerweile mehr als 5.500 verschiedene Biermarken gibt, wobei die Biersorte Pils mit über 50 Prozent Marktanteil in der Beliebtheit der Verbraucherinnen und Verbraucher weiterhin unangefochten auf Platz eins steht, gefolgt von Export und Weizenbier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
