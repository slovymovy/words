    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3ec8aa08-6994-3473-8a1a-8b27f07ac578",
                "word": "languorous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
