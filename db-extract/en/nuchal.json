                        "sense_id": "8980cf26-f617-31e7-bb13-b81430125b2f",
                        "entry_id": "15736324-bcb2-3f37-b98c-5092263853a6",
                        "glosses": [
                            "A neck scale, especially of a lizard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205887f1-bf5d-4aca-9f89-7fb8d25787d4",
                                "sense_id": "8980cf26-f617-31e7-bb13-b81430125b2f",
                                "text": "Dunn gives a key to a part of this group of Eumeces, based upon the number of nuchals, placing the two American species (he does not consider Eumeces altamirani Dugès) in a group having 14-17 pairs of nuchals;[…]."
                            },
                            {
                                "example_id": "95ea716f-9417-4201-b023-be6ebeba1e2f",
                                "sense_id": "8980cf26-f617-31e7-bb13-b81430125b2f",
                                "text": "Growth patterns of clavicles, cleithra, opercles, medial nuchals, dorsal scutes, and pectoral fin ray sections have been compared in white sturgeon Acipenser transmontanus."
                            },
                            {
                                "example_id": "74e72047-7bd1-4c96-8487-86cc9676936d",
                                "sense_id": "8980cf26-f617-31e7-bb13-b81430125b2f",
                                "text": "Scales are weakly differentiated, with head scales flat and smooth, nuchals small and smooth, dorsal scales small and keeled, and tail scales larger ventrally than laterally, without wings."
                            }
                        ]
                    }
