                                        "entry_id": "cc2b931a-d20b-3b85-8fbe-c9cae554de0d",
                                        "glosses": [
                                            "A location of an organization with several locations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5242677d-8ae9-4301-a9b7-b71acea87fa9",
                                                "sense_id": "d580eca7-5be2-39c0-beb6-3763731b7a84",
                                                "text": "Our main branch is downtown, and we have branches in all major suburbs."
