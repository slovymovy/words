{
    "word_family": [
        "свист",
        "свисток",
        "свистулька",
        "свистящий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa3eb92f-787c-38b8-9e7e-756955805148",
                    "sense_definition": "Издавать свист губами или с помощью специального приспособления.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "звуки",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчишки аплодировали и громко <w>свистели</w> от восторга.",
                            "target_lang_translations": {
                                "en": "The boys applauded and <w>whistled</w> loudly with delight."
                            }
                        },
                        {
                            "text": "Судья <w>свистнул</w>, чтобы остановить игру на поле.",
                            "target_lang_translations": {
                                "en": "The referee <w>whistled</w> to stop the game on the field."
                            }
                        }
                    ],
                    "synonyms": [
                        "свистать"
                    ],
                    "common_phrases": [
                        "громко свистеть"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce a whistling sound using the lips or a special device."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whistle",
                                "target_lang_sense_clarification": "to make a high-pitched sound with the mouth or a device"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5825b815-fe02-3df3-9488-b339ff0cbc46",
                    "sense_definition": "Издавать высокие звуки, похожие на свист (о птицах).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "звуки",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В лесу весело <w>свистели</w> маленькие птички.",
                            "target_lang_translations": {
                                "en": "Small birds were <w>whistling</w> cheerfully in the forest."
                            }
                        },
                        {
                            "text": "Иволга начала <w>свистеть</w> на самой верхушке старой березы.",
                            "target_lang_translations": {
                                "en": "The oriole began to <w>whistle</w> at the very top of the old birch tree."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To produce high-pitched sounds similar to whistling (of birds)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whistle",
                                "target_lang_sense_clarification": "to produce a high-pitched sound, often used for birds"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4573d60d-7f58-3f94-b513-df45e388df79",
                    "sense_definition": "Издавать резкий звук при быстром движении (о пуле, ветре).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "звуки",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Холодный ветер <w>свистел</w> в узкой оконной щели.",
                            "target_lang_translations": {
                                "en": "The cold wind <w>whistled</w> through the narrow window crack."
                            }
                        },
                        {
                            "text": "Над головой со <w>свистом</w> пролетали пули.",
                            "target_lang_translations": {
                                "en": "Bullets flew overhead with a <w>whistle</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ветер свистит"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce a sharp sound when moving quickly (of a bullet, wind)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whistle",
                                "target_lang_sense_clarification": "to move with a high-pitched sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43876269-54d8-35f2-b147-e5791206d185",
                    "sense_definition": "Говорить неправду или хвастаться.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "речь",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хватит <w>свистеть</w>, рассказывай всё как было на самом деле.",
                            "target_lang_translations": {
                                "en": "Stop <w>talking nonsense</w>, tell me how it really happened."
                            }
                        },
                        {
                            "text": "Он постоянно <w>свистит</w> о своих несуществующих богатствах.",
                            "target_lang_translations": {
                                "en": "He is constantly <w>bragging</w> about his non-existent wealth."
                            }
                        }
                    ],
                    "synonyms": [
                        "лгать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To tell lies or boast."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "talk nonsense",
                                "target_lang_sense_clarification": "to speak untruths or boast"
                            },
                            {
                                "target_lang_word": "brag",
                                "target_lang_sense_clarification": "to talk excessively about one's achievements"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}