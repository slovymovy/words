{
    "word_family": [
        "snip"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37df3056-872b-33b0-bab1-de9b006b7ce6",
                    "sense_definition": "A small part or piece of something, such as a song, text, or fabric.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "small_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the <w>snippet</w> I heard of their rehearsal, they sound pretty good.",
                            "target_lang_translations": {
                                "zh": "从我听到的他们排练的<w>片段</w>来看，他们听起来相当不错。"
                            }
                        },
                        {
                            "text": "The article included a short <w>snippet</w> of the interview.",
                            "target_lang_translations": {
                                "zh": "这篇文章包含了一段简短的采访<w>摘录</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excerpt",
                        "fragment",
                        "piece",
                        "scrap",
                        "snippet"
                    ],
                    "common_phrases": [
                        "short snippet",
                        "audio snippet"
                    ],
                    "target_lang_definitions": {
                        "zh": "指某事物（如歌曲、文本或布料）的一小部分或片段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "片段",
                                "target_lang_sense_clarification": "指从整体中截取出来的一小部分，常用于文本、音频或视频。"
                            },
                            {
                                "target_lang_word": "摘录",
                                "target_lang_sense_clarification": "指从文章或书籍中选出的部分内容。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc165f9d-3f94-3951-84a8-8c66ee7fb690",
                    "sense_definition": "A small, reusable piece of computer code intended to be inserted into a larger program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "small_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer shared a useful code <w>snippet</w> for handling user authentication.",
                            "target_lang_translations": {
                                "zh": "开发者分享了一个用于处理用户身份验证的实用<w>代码片段</w>。"
                            }
                        },
                        {
                            "text": "You can easily copy this <w>snippet</w> into your main project file.",
                            "target_lang_translations": {
                                "zh": "你可以轻松地将这段<w>代码片段</w>复制到你的主项目文件中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "fragment"
                    ],
                    "common_phrases": [
                        "code snippet"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一段可重复使用的小型计算机代码，旨在插入到更大的程序中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "代码片段",
                                "target_lang_sense_clarification": "编程中指一段功能独立、可复用的代码。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdad0f3d-6b05-3ff1-9464-e43a63312ad4",
                    "sense_definition": "To make small cuts, especially with scissors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>snippet</w> the edges of the paper to create a decorative border.",
                            "target_lang_translations": {
                                "zh": "她开始<w>剪裁</w>纸张边缘，以制作装饰性的边框。"
                            }
                        },
                        {
                            "text": "He would <w>snippet</w> the fabric carefully while working on his craft.",
                            "target_lang_translations": {
                                "zh": "他在做手工时会小心地<w>剪裁</w>布料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clip"
                    ],
                    "target_lang_definitions": {
                        "zh": "指进行细小的剪裁，通常使用剪刀。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "剪裁",
                                "target_lang_sense_clarification": "指用剪刀修剪或裁剪物品。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ddaaf13-8049-3148-a8c2-2b4ad4d2cd23",
                    "sense_definition": "To create a small excerpt from a larger work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor decided to <w>snippet</w> the long speech for the evening news.",
                            "target_lang_translations": {
                                "zh": "编辑决定为晚间新闻将长篇演讲进行<w>摘编</w>。"
                            }
                        },
                        {
                            "text": "They <w>snippet</w> the blog posts to display them on the home page.",
                            "target_lang_translations": {
                                "zh": "他们将博客文章进行<w>摘编</w>后显示在主页上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excerpt"
                    ],
                    "target_lang_definitions": {
                        "zh": "指从较长的作品中截取出一小部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摘编",
                                "target_lang_sense_clarification": "指从长篇内容中选取部分进行编辑或展示。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}