                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Burden</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "Я встретил на конференции женщину по имени Сара <w>Берден</w>.",
                                "zh": "我在会议上遇到了一位名叫萨拉·<w>伯登</w>的女士。"
                            }
                        }
                    ],
