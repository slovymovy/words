                "senses": [
                    {
                        "sense_id": "b15db0b5-c497-3487-9d6e-af577d6a24d5",
                        "entry_id": "12c3f696-c178-3f59-be6b-fc7732394c68",
                        "glosses": [
                            "Person, die nicht Anhänger des Judentums ist"
                        ],
                        "tags": [
                            "Judentum"
                        ],
                        "examples": [
                            {
                                "example_id": "9a08999e-0dc2-40bd-be67-23152cfdb897",
                                "sense_id": "b15db0b5-c497-3487-9d6e-af577d6a24d5",
                                "text": "„Man wird zwar den politischen Z[ionismus] als Folge des Antisemitismus nur insofern bezeichnen können, als in diesem zum Ausdruck kam, daß durch die Emanzipation allein noch nicht das Problem des Zusammenlebens von Juden und Nichtjuden gelöst war.“"
                            },
                            {
                                "example_id": "b3ffa7d9-b998-4670-b381-5bb7aacc61d7",
                                "sense_id": "b15db0b5-c497-3487-9d6e-af577d6a24d5",
                                "text": "„Ich wünsche, wenn es möglich ist, einem jeden zu helfen, sei er Jude oder Nichtjude, Schwarzer oder Weißer.“"
                            },
                            {
                                "example_id": "1c5484f3-2bea-43bd-a9fe-ac5bbf87bc94",
                                "sense_id": "b15db0b5-c497-3487-9d6e-af577d6a24d5",
                                "text": "„Die spätjüdische Ethik hat den Wucher im Sinn einer rücksichtslosen Ausbeutung auch gegenüber Nichtjuden mißbilligt.“"
                            },
                            {
                                "example_id": "6668f890-bf46-4870-bb59-066f44083acf",
                                "sense_id": "b15db0b5-c497-3487-9d6e-af577d6a24d5",
                                "text": "„Der sprachliche Kontakt mit den Nichtjuden verlief bis in die Neuzeit hinein überwiegend auf mündlichem Wege.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
