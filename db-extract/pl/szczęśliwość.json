                                                "sense_id": "7299d186-3fff-3213-b359-5202c09cda78",
                                                "text": "seek happiness"
                                            },
                                            {
                                                "example_id": "2139ef41-0deb-4caf-b2e7-77419496deb5",
                                                "sense_id": "7299d186-3fff-3213-b359-5202c09cda78",
                                                "text": "true happiness"
                                            },
                                            {
                                                "example_id": "9c327083-dc1a-4f83-ab60-6e83ca910bc6",
                                                "sense_id": "7299d186-3fff-3213-b359-5202c09cda78",
                                                "text": "bring happiness to others"
                                            },
                                            {
                                                "example_id": "838d45e1-4690-4036-bffd-2d78b8d63d86",
                                                "sense_id": "7299d186-3fff-3213-b359-5202c09cda78",
                                                "text": "Money can’t buy happiness."
                                            },
                                            {
                                                "example_id": "8c93dc76-2a6e-4d17-ad1d-830d969119c5",
                                                "sense_id": "7299d186-3fff-3213-b359-5202c09cda78",
                                                "text": "She found happiness in the small things."
                                            },
                                            {
                                                "example_id": "f744a230-9c52-494a-b591-4036e388dab8",
                                                "sense_id": "7299d186-3fff-3213-b359-5202c09cda78",
                                                "text": "Yes, Aline, true happiness comes of true love, and true love should be independent of external influences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e996032-d2de-306d-aabb-4507d2f745ed",
                                        "entry_id": "f31acbc7-73da-3cb5-824d-1cf884091b7b",
                                        "glosses": [
                                            "Prosperity, thriving, wellbeing."
                                        ],
                                        "tags": [
