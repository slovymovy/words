                        "glosses": [
                            "Cette redevance elle-même."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "a0b32d27-5a2a-46d3-8b3c-1750bc50be15",
                                "sense_id": "308390d4-5fef-3f5b-8f38-8b54d72e2d72",
                                "text": "C'était le cathédralique qu’on payait pendant le synode, et qu’on appelait pour cela le synodalique. Fulbert confessa que ce droit est dû aux évêques."
                            }
                        ]
