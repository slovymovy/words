                "senses": [
                    {
                        "sense_id": "cfca3a0a-9bd2-3cba-b1f1-6dd3a96c125a",
                        "entry_id": "5fd8ffcc-df10-3462-b0ff-528bce96393c",
                        "glosses": [
                            "eine Baumstrukturansicht von Dateien, Ordnern, URLs, die in einer Anwendung gefunden wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75da2736-94ac-481b-bc8f-690244ecd9e2",
                                "sense_id": "cfca3a0a-9bd2-3cba-b1f1-6dd3a96c125a",
                                "text": "„Bei Anwendungen ohne hierarchische URL-Struktur, wie Anwendungen mit Einzeleinstiegspunkt (z. B. MVC) oder Anwendungen ohne logische hierarchische Struktur, können Sie einen inhaltsbasierten Anwendungsbaum erstellen.“"
                            },
                            {
                                "example_id": "b46cbd9e-fd58-45e3-a816-713cfd712acc",
                                "sense_id": "cfca3a0a-9bd2-3cba-b1f1-6dd3a96c125a",
                                "text": "„Zunächst einmal gibt es da das WCM-Modul. Dieses ist im Standardumfang des SAP ECC enthalten. Allerdings müssen einige Schalter im Customizing betätigt werden, um das Modul zu aktivieren. Erst dadurch erscheint das WCM unter der Überschrift „Freischaltabwicklung“ im Anwendungsbaum des SAP-Standards (Dokumentation zum WCM-Modul).“"
                            },
                            {
                                "example_id": "f5b1ba0a-1198-4e69-b571-2e7266665bf5",
                                "sense_id": "cfca3a0a-9bd2-3cba-b1f1-6dd3a96c125a",
                                "text": "„Die Kernidee von React besteht in der Annahme, dass der komplette der betroffenen Komponente untergeordnete Anwendungsbaum bei jeder Änderung einer Eigenschaft der Komponente neu aufgebaut wird.“"
                            },
                            {
                                "example_id": "c0a78bb1-ad29-4a23-8ab5-dd5dfd7d488a",
                                "sense_id": "cfca3a0a-9bd2-3cba-b1f1-6dd3a96c125a",
                                "text": "„Erster Menüweg vom SAP R/3-Einstiegsbildschirm in den Bildschirm Anwendungsbaum Berichtsauswahl Stellenrechnung:“"
                            },
                            {
                                "example_id": "d86a2991-d7d0-4616-a354-f3c7140e3280",
                                "sense_id": "cfca3a0a-9bd2-3cba-b1f1-6dd3a96c125a",
                                "text": "„Wenn eine Netzwerkanwendung ausgeführt wird, wird sie automatisch im Aktitivätsbaum unter dem Anwendungsbaum dargestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
