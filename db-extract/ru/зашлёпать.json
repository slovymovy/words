                "senses": [
                    {
                        "sense_id": "54dc3063-1387-3ff4-a5cb-001119f0d5a0",
                        "entry_id": "3bb07293-2077-340c-8332-07f56acad3ad",
                        "glosses": [
                            "разг. начать шлёпать, с шумом ударять по чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab04dc04-865e-4a32-95c0-5e59858c2ac1",
                                "sense_id": "54dc3063-1387-3ff4-a5cb-001119f0d5a0",
                                "text": "Босые ноги быстро зашлёпали и невидимая рука отворила дверь в охотническую."
                            },
                            {
                                "example_id": "294d0494-c68e-4a34-a21a-152d79b1de17",
                                "sense_id": "54dc3063-1387-3ff4-a5cb-001119f0d5a0",
                                "text": "Шестая рота вдруг зашевелилась, зашлёпала ногами и как будто бы затопталась, не сходя с места."
                            },
                            {
                                "example_id": "6e6cd331-5035-4f99-aef1-875fdf483441",
                                "sense_id": "54dc3063-1387-3ff4-a5cb-001119f0d5a0",
                                "text": "Грязная юбка вздулась пузырем, и баба зашлёпала руками по воде, как кутёнок."
                            }
                        ]
                    },
                    {
                        "sense_id": "49772b66-d655-359c-bf71-45ba28c3a46a",
                        "entry_id": "3bb07293-2077-340c-8332-07f56acad3ad",
                        "glosses": [
                            "разг. пойти, шлёпая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb73be7-7076-49c8-ad76-5ffc686d5943",
                                "sense_id": "49772b66-d655-359c-bf71-45ba28c3a46a",
                                "text": "И в тот же миг банщик, не сказав ни слова, зашлёпал по мокрому полу и исчез."
                            }
                        ]
                    }
                ],
