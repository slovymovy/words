{
    "word_family": [
        "rayon",
        "rayonnage",
        "rayonnement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86655e9e-f6e1-3b03-86af-e56bb4632b6b",
                    "sense_definition": "Émettre ou projeter des rayons de lumière vive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil matinal commençait enfin à <w>rayonner</w> sur les toits de la ville."
                        },
                        {
                            "text": "À travers la fenêtre ouverte, la lampe semblait <w>rayonner</w> doucement dans l'obscurité."
                        }
                    ],
                    "synonyms": [
                        "briller",
                        "étinceler",
                        "resplendir"
                    ],
                    "common_phrases": [
                        "rayonner de lumière"
                    ]
                },
                {
                    "sense_id": "140644e7-8443-361d-b43d-914d89224d0f",
                    "sense_definition": "Manifester de façon visible un vif sentiment de joie, d'épanouissement ou de fierté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'elle a réussi ses examens, elle ne cesse de <w>rayonner</w> de bonheur."
                        },
                        {
                            "text": "Son visage <w>rayonnait</w> de joie lorsqu'il a ouvert son cadeau d'anniversaire."
                        }
                    ],
                    "synonyms": [
                        "resplendir",
                        "exulter"
                    ],
                    "common_phrases": [
                        "rayonner de bonheur",
                        "rayonner de joie"
                    ]
                },
                {
                    "sense_id": "28a48f5b-65a2-3743-a84d-0b435e2d693b",
                    "sense_definition": "Étendre son influence, son activité ou son prestige sur un large territoire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette université prestigieuse aspire à <w>rayonner</w> à l'international grâce à ses recherches."
                        },
                        {
                            "text": "Le festival culturel permet à notre petite ville de <w>rayonner</w> sur toute la région."
                        }
                    ],
                    "synonyms": [
                        "diffuser",
                        "essaimer"
                    ],
                    "common_phrases": [
                        "rayonner à l'international",
                        "rayonner sur la région"
                    ]
                },
                {
                    "sense_id": "1305b1b5-5dd5-3faf-adc9-ec3f38b08f5f",
                    "sense_definition": "Diffuser ou propager de la chaleur ou une autre forme d'énergie dans l'espace environnant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vieux murs de pierre continuent de <w>rayonner</w> de la chaleur bien après le coucher du soleil."
                        },
                        {
                            "text": "Le radiateur neuf commence enfin à <w>rayonner</w> efficacement dans la grande pièce."
                        }
                    ],
                    "synonyms": [
                        "irradier"
                    ],
                    "common_phrases": [
                        "laisser rayonner"
                    ]
                },
                {
                    "sense_id": "8cc81b4f-3cb6-338b-b19b-b8dfa7eafb01",
                    "sense_definition": "Monter ou ajuster les rayons métalliques d'une roue de bicyclette ou de tout véhicule similaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien a passé l'après-midi à <w>rayonner</w> la roue avant du vélo de course."
                        },
                        {
                            "text": "Il faut une certaine minutie pour <w>rayonner</w> une roue sans la voiler."
                        }
                    ],
                    "antonyms": [
                        "dérayonner"
                    ],
                    "common_phrases": [
                        "rayonner une roue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technique"
                        }
                    ]
                },
                {
                    "sense_id": "1d055b28-ee84-34b2-ad1f-99b44549a096",
                    "sense_definition": "Garnir ou équiper une pièce ou un meuble d'étagères ou de rayons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons fait <w>rayonner</w> cette remise afin d'y ranger tous les vieux dossiers."
                        },
                        {
                            "text": "L'artisan va <w>rayonner</w> le mur du salon pour y exposer des objets d'art."
                        }
                    ],
                    "common_phrases": [
                        "faire rayonner une pièce"
                    ]
                }
            ]
        }
    ]
}