                                                "sense_id": "32f94a57-a818-3c9d-86f4-d48346402f6b",
                                                "text": "Der Hartmann trägt nie die Pullover, die die Hartmann ihm strickt."
                                            },
                                            {
                                                "example_id": "eb7b8579-d302-4aa4-988b-1cfc31a5f455",
                                                "sense_id": "32f94a57-a818-3c9d-86f4-d48346402f6b",
                                                "text": "Frau Hartmann ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "6b360aa9-2ea5-4a4c-936d-d3c0634e56d0",
                                                "sense_id": "32f94a57-a818-3c9d-86f4-d48346402f6b",
                                                "text": "Herr Hartmann wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "df7861e1-f17d-443c-891f-d26e060cd33c",
                                                "sense_id": "32f94a57-a818-3c9d-86f4-d48346402f6b",
                                                "text": "Die Hartmanns fliegen heute nach Sri Lanka."
                                            },
                                            {
                                                "example_id": "901dee5c-49d8-4d52-bd74-12c817e15401",
                                                "sense_id": "32f94a57-a818-3c9d-86f4-d48346402f6b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hartmann kommt, geht der Herr Hartmann.“"
                                            },
                                            {
                                                "example_id": "39bde1ce-5743-4e25-bfa5-30230027545e",
                                                "sense_id": "32f94a57-a818-3c9d-86f4-d48346402f6b",
                                                "text": "Hartmann kommt und geht."
                                            },
                                            {
                                                "example_id": "1fb1ca90-beca-4de8-aeb2-47920fd276cd",
                                                "sense_id": "32f94a57-a818-3c9d-86f4-d48346402f6b",
                                                "text": "Hartmanns kamen, sahen und siegten."
                                            }
                                        ],
