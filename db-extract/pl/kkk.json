                                            "alt-of",
                                            "historical",
                                            "initialism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e5afb55-dcb5-4286-b431-555aaa44b708",
                        "source_entry_id": "e9fd7f5a-6c4f-3cb8-85c8-5dc410e6f7b7",
