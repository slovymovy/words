                    {
                        "translation_id": "6d7afedf-707c-4d41-ae80-002830808e98",
                        "source_entry_id": "c04c6ced-e176-36e9-9fd3-189f58cd57c0",
                        "source_sense_description": "cook for too long — see also overdo",
                        "target_lang_word": "zerkochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerkochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b55c1b06-1c57-3849-987a-4f0705f25564",
                                        "entry_id": "72cd60f1-5773-3391-8834-a5f1292c9740",
                                        "glosses": [
                                            "durch langes Erhitzen zerfallen"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab1fb6f1-821f-4c68-bc98-32e3199facc0",
                                                "sense_id": "b55c1b06-1c57-3849-987a-4f0705f25564",
                                                "text": "„An Mehl sind sie sehr reich, zerkochen aber nicht leicht.“"
                                            },
                                            {
                                                "example_id": "91a70d1a-54ef-4b08-ba65-4f2429d6a637",
                                                "sense_id": "b55c1b06-1c57-3849-987a-4f0705f25564",
                                                "text": "„Man kann auch alles zusammen ins Wasser schütten, aber dann sind die Paradeiser halt schon zerkocht, wenn die Erdäpfel noch hart sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ea48078-7ba1-3c03-8b56-e854ecd2c10e",
                                        "entry_id": "72cd60f1-5773-3391-8834-a5f1292c9740",
                                        "glosses": [
                                            "durch langes Erhitzen zerfallen lassen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78250637-c7fb-449f-adcd-0d4fa300e75e",
                                                "sense_id": "1ea48078-7ba1-3c03-8b56-e854ecd2c10e",
                                                "text": "„Wenn man aber das Organ vorher mit Kali zerkocht hat, so hat man nun das Glycogen nicht aschenfrei gewonnen, es enthält immer eine kleine Menge von Aschenbestandtheilen, welche mitgewogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4efbf6e8-560e-43b2-8d40-b3293388e845",
                        "source_entry_id": "c04c6ced-e176-36e9-9fd3-189f58cd57c0",
                        "source_sense_description": "cook for too long — see also overdo",
                        "target_lang_word": "verkochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verkochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72794d22-4709-3d0b-b3f1-5a39a1b30315",
                                        "entry_id": "74c17e03-3ff0-34dc-ab1f-e6294ab7f816",
                                        "glosses": [
                                            "durch den Vorgang des Erhitzens über 100 Grad hinaus verschwinden/verdampfen (den Aggregatzustand zu gasförmig ändern)"
                                        ],
                                        "tags": [
                                            "Hilfsverb sein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f113d2-878d-415c-9337-e61eaf99169a",
                                                "sense_id": "72794d22-4709-3d0b-b3f1-5a39a1b30315",
                                                "text": "In der Anlage ist das ganze Wasser verkocht, was dann zur Notabschaltung führte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4da7b018-17de-3f7c-bae3-2da4bac222e0",
                                        "entry_id": "74c17e03-3ff0-34dc-ab1f-e6294ab7f816",
                                        "glosses": [
                                            "durch den Vorgang des Erhitzens über 100 Grad hinaus die Konsistenz/Form verlieren und breiartig werden"
                                        ],
                                        "tags": [
                                            "Hilfsverb sein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8a3574a-b6f2-419e-935c-f8694f0d40c5",
                                                "sense_id": "4da7b018-17de-3f7c-bae3-2da4bac222e0",
                                                "text": "Klöße verkochen unglaublich schnell und sehen dann so zerfallen unappetitlich aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45b82e15-3a56-30c4-8487-6fe4bec54368",
                                        "entry_id": "74c17e03-3ff0-34dc-ab1f-e6294ab7f816",
                                        "glosses": [
                                            "Nahrungsmittel durch langes Erhitzen (über 100 Grad hinaus) zerfallen lassen"
                                        ],
                                        "tags": [
                                            "Hilfsverb haben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "516210a9-db7d-4196-915d-dd7bdb10107f",
                                                "sense_id": "45b82e15-3a56-30c4-8487-6fe4bec54368",
                                                "text": "Ich habe nicht auf die Uhr geschaut und die Klöße verkocht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "06bb4e90-507c-3f20-808b-a68f0b9ffa60",
                                        "entry_id": "74c17e03-3ff0-34dc-ab1f-e6294ab7f816",
                                        "glosses": [
                                            "Nahrungsmittel durch Erhitzen in ein (haltbares) Erzeugnis verwandeln"
                                        ],
                                        "tags": [
                                            "Hilfsverb haben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e36af005-6e88-4de2-a44f-e07be36a163a",
                                                "sense_id": "06bb4e90-507c-3f20-808b-a68f0b9ffa60",
                                                "text": "Was machen wir mit den ganzen Erdbeeren? Zu Marmelade verkochen?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "580c6c56-6c0b-40a3-8d92-72f2ee1dad1e",
                        "source_entry_id": "c04c6ced-e176-36e9-9fd3-189f58cd57c0",
                        "source_sense_description": "cook for too long — see also overdo",
                        "target_lang_word": "totkochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totkochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59a0d825-ddab-31de-85e9-8f61dc6bb1ec",
                                        "entry_id": "c8084c52-5416-3a17-a0e8-2808baed2ce2",
                                        "glosses": [
                                            "Nahrungsmittel durch länger als nötig andauerndes Sieden der flüssigen Bestandteile erhitzen, sodass wertvolle Inhaltsstoffe und Geschmack/gute Konsistenz reduziert werden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e62109-17a0-4906-bbc9-d28c9d8ce21c",
                                                "sense_id": "59a0d825-ddab-31de-85e9-8f61dc6bb1ec",
                                                "text": "„[…] Gemüse [sollte] noch Biss haben, wenn es auf den Teller kommt. Ihr Körper wird es Ihnen danken, wenn Sie die Nahrungsmittel nicht totkochen!“"
                                            },
                                            {
                                                "example_id": "053acf2a-aef1-4671-b02d-71854faf7158",
                                                "sense_id": "59a0d825-ddab-31de-85e9-8f61dc6bb1ec",
                                                "text": "„Überall, wo wir uns aufhalten, werden wir mit Speisen überhäuft, die zuerst totgekocht und damit ungenießbar wurden, um anschließend mit Gewürzen wieder schmackhaft gemacht zu werden.“"
                                            },
                                            {
                                                "example_id": "53ee1db9-f127-4a26-95b1-9bdd32b64e97",
                                                "sense_id": "59a0d825-ddab-31de-85e9-8f61dc6bb1ec",
                                                "text": "„[…] nur bis zum Garwerden kochen, nicht länger! / Grund: Schmackhaftes Essen, kürzere Kochzeit, kein ‚Totkochen‘ = (Vernichtung lebenswichtiger Stoffe, ‚Strohgeschmack‘).“"
                                            },
                                            {
                                                "example_id": "ccdacb10-2037-456b-82a3-f034ee686cef",
                                                "sense_id": "59a0d825-ddab-31de-85e9-8f61dc6bb1ec",
                                                "text": "„\"Die Vitamine bleiben allerdings nur erhalten, wenn man den Reis nicht totkocht\", so Seitz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
