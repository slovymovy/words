                "senses": [
                    {
                        "sense_id": "624cc013-f7be-3a48-bbc6-af5d1e716543",
                        "entry_id": "9e8e825e-f876-3cfc-93d5-c987c2ec2769",
                        "glosses": [
                            "iemand die op een kruiperige manier iemand te vriend probeert te houden"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1fabd5d8-baee-40bf-aa89-f3af02afa2cc",
                                "sense_id": "624cc013-f7be-3a48-bbc6-af5d1e716543",
                                "text": "Deze uitgave geeft ons de dichter weer terug. Door allerlei andere tussentijdse publicaties, zoals de Majakovski-biografie Een leven op scherp van Bengt Jangfeldt, kwamen we veel te weten over het ingewikkelde liefdesleven van de dichter, en over zijn gokverslaving, de tegenwerking van de censuur, zijn geflirt met zelfmoord, dwangmatige handenwasserij, poses en het wegkijken als er collega’s bij zuiveringen verdwenen, zijn propagandagedichten waarin de gedurfdheid van weleer in de hamerende boodschap ten onder ging (Karel van het Reve vond hem maar een vulgaire gatlikker van de Russische overheid), en zijn reactie op de zelfmoord van het drinkende ‘klinkslagvaardig gildelid’ de dichter Jesenin: quasi-onaangedaan, maar dat was een manier om zijn eigen zelfmoordgedachten ongedaan te maken. In de 36 jaar van zijn leven lijkt Majakovski nooit een dag in kalmte te hebben doorgebracht."
                            },
                            {
                                "example_id": "5ff2c58d-b3c0-4d13-8fb4-47ccb8cc4ecb",
                                "sense_id": "624cc013-f7be-3a48-bbc6-af5d1e716543",
                                "text": "Europa moet zich schamen. Europese leiders gedroegen zich tegenover Gaddafi als onnozele gatlikkers. Daarmee handelden ze ‘crimineel’, getuige Gaddafi’s bombardement van zijn eigen bevolking met Europese wapens. Het was Europa’s morele en politieke dieptepunt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba581690-e71c-4b5c-b590-f32b6fb24b7b",
                        "source_entry_id": "9e8e825e-f876-3cfc-93d5-c987c2ec2769",
                        "source_sense_id": "624cc013-f7be-3a48-bbc6-af5d1e716543",
                        "target_lang_word": "sycophant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sycophant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "One who uses obsequious compliments to gain self-serving favour or advantage from another; a servile flatterer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f525c996-305a-4757-96aa-e3bb251b0bc4",
                                                "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                                "text": "A sycophant will everything admire: / Each verse, each sentence, sets his soul on fire"
                                            },
                                            {
                                                "example_id": "b01c4077-ca44-40f1-8dbe-2f6d2a1bebcd",
                                                "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                                "text": "VVhile a mean Crovvd of Sycophants attend, / And favvn and flatter, creep and cringe and bend; / The Fav'rite bleſſes his ſuperior State, / Riſes o'er all, and hails Himſelf the Great."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10d5819-4588-3279-adfb-8870e50bee91",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "One who seeks to gain through the powerful and influential."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ef390e3-92cd-3b79-b84a-a1862e167e32",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "An informer; a talebearer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bcc55c3-1911-417d-a41a-cb8bbc7a37fa",
                                                "sense_id": "7ef390e3-92cd-3b79-b84a-a1862e167e32",
                                                "text": "[H]is mind had no eye to espy goodness; and therefore accusing sycophants, of all men, did best sort to his nature.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sycophant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90a02387-0ba7-3c7e-b763-ed5d3fbe6928",
                                        "entry_id": "ea1f3569-1144-3cdf-9c3e-7d5e917dee26",
                                        "glosses": [
                                            "To inform against; hence, to calumniate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e62fc6e6-b17a-4330-a1e2-fba335af3a04",
                                                "sense_id": "90a02387-0ba7-3c7e-b763-ed5d3fbe6928",
                                                "text": "As therefore he began in the title, so in the next leaf he makes it his first business to tamper with his reader by sycophanting and misnaming the work of his adversary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abfb8419-5bda-3708-b79a-90ead1b0f720",
                                        "entry_id": "ea1f3569-1144-3cdf-9c3e-7d5e917dee26",
                                        "glosses": [
                                            "To play the sycophant toward; to flatter obsequiously."
                                        ],
