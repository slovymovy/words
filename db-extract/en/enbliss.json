                "senses": [
                    {
                        "sense_id": "0d6aac25-7670-37b2-89a4-962611c9929c",
                        "entry_id": "2e6b1e9a-d023-303b-861a-958bc17f005f",
                        "glosses": [
                            "To endue or fill with bliss; impart bliss to; make happy."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fee1cda7-87f7-4df9-af0c-63aaa316aa5d",
                                "sense_id": "0d6aac25-7670-37b2-89a4-962611c9929c",
                                "text": "Oh, how I will kiss thee, How I'll embliss thee, When thou art a-bed with me!"
                            },
                            {
                                "example_id": "cd03dc99-acda-4dfb-ae21-f93505f6e3ee",
                                "sense_id": "0d6aac25-7670-37b2-89a4-962611c9929c",
                                "text": "Its beauty was so fine, so high enblissed, My heart ached for the mystery that it missed."
                            },
                            {
                                "example_id": "faba2882-5e43-4b3c-98cd-a3f0b0095b0e",
                                "sense_id": "0d6aac25-7670-37b2-89a4-962611c9929c",
                                "text": "In the world to come, Christopher Kelch would serve truth in his actions, and truth would fill him and own him and enbliss him and conquer every blood cell, every doubt, and redden every unbinary gray."
                            }
                        ]
                    }
                ],
