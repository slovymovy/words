                "senses": [
                    {
                        "sense_id": "55c77ce1-c7ec-3ab8-a7e0-f2306a4d2f71",
                        "entry_id": "45c29e94-9f49-3c2b-ad1e-068f89bec4fb",
                        "glosses": [
                            "Considérer d’un point de vue hypostatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1393aba1-a720-4baa-a44e-75934f4d1ea0",
                                "sense_id": "55c77ce1-c7ec-3ab8-a7e0-f2306a4d2f71",
                                "text": "L’ontologie ne détient aucun privilège sur le semblant ni pour l’annihiler ni pour l’hypostatiser."
                            },
                            {
                                "example_id": "f2b8e30b-55a8-47fa-9da7-2c9fb81ad16d",
                                "sense_id": "55c77ce1-c7ec-3ab8-a7e0-f2306a4d2f71",
                                "text": "mais au niveau de la mythologie poétique, la fiction linguistique, qui se donne pour tache de substantiver et, par la même, d’hypostatiser, aboutit à une image métonymique de la vie comme telle, considérée en elle-même, et substituée aux gens en vie."
                            }
                        ]
                    }
