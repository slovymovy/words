                        "веская причина"
                    ],
                    "target_lang_definitions": {
                        "en": "Significant, convincing, or having great importance.",
                        "es": "Significativo, convincente, que tiene gran importancia o valor.",
                        "fr": "Qui est significatif, convaincant, ayant une grande importance."
