                "senses": [
                    {
                        "sense_id": "6d78611a-9ecb-3ea3-a685-5a3cb1599afe",
                        "entry_id": "b0cab896-4961-3e18-92e9-77e824a654d2",
                        "glosses": [
                            "bis 1967 in Deutschland gültige Form der Umsatzsteuer, bei der kein Vorsteuerabzug möglich war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da9aeb5e-dfb3-4235-a158-1c8572e03121",
                                "sense_id": "6d78611a-9ecb-3ea3-a685-5a3cb1599afe",
                                "text": "„Bis zum 31.12.1967 wurde die Umsatzsteuer indes als Allphasen-Brutto-Umsatzsteuer erhoben.“"
                            },
                            {
                                "example_id": "2207a0ca-73ce-4c57-9797-644d7315fc5d",
                                "sense_id": "6d78611a-9ecb-3ea3-a685-5a3cb1599afe",
                                "text": "„Eine Allphasen-Brutto-Umsatzsteuer weist eine Reihe unliebsamer Eigenschaften auf: […]“"
                            },
                            {
                                "example_id": "63af2da0-c7f0-4417-a44d-b26d05708d8e",
                                "sense_id": "6d78611a-9ecb-3ea3-a685-5a3cb1599afe",
                                "text": "„Der Tatbestand, daß bei einer kumulativen Allphasen-Brutto-Umsatzsteuer die Steuerbelastung je nach der Zahl der steuerrechtlich relevanten Umsatzstufen höher oder niedriger ist, wirkt sich weiterhin in einer Förderung der vertikalen Unternehmenskonzentration aus, weil die Produkte solcher Unternehmen, die mehrere Stufen in sich vereinigen (mehrstufige Unternehmen) steuerlich weniger stark belastet werden; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
