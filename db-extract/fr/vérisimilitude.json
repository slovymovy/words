                                            {
                                                "example_id": "d6a58a71-2583-4c95-8b00-a0d7e883b0c8",
                                                "sense_id": "b3c11c06-b27c-30e6-a658-e544ee8788ea",
                                                "text": "Die Wahrhaftigkeit war ihm anerzogen."
                                            },
                                            {
                                                "example_id": "380ffa47-fc49-4aad-8bf7-213806a4ce51",
                                                "sense_id": "b3c11c06-b27c-30e6-a658-e544ee8788ea",
                                                "text": "„Maßstäbe für eine Rechtfertigung sind die Wahrhaftigkeit, Relevanz und Verständlichkeit des Gesagten.“"
                                            },
                                            {
                                                "example_id": "3ee0b875-7b71-41a9-a83d-281bad289e3b",
                                                "sense_id": "b3c11c06-b27c-30e6-a658-e544ee8788ea",
                                                "text": "„Der Priester berief sich auf die Wahrhaftigkeit der Heiligen Schrift, auf die Überlieferung der Menschheit und auf die Tiere, die man im sibirischen Eis entdeckt hat.“"
                                            }
                                        ],
