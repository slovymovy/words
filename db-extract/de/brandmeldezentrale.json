                "senses": [
                    {
                        "sense_id": "2b38161e-2c4e-38bb-920b-b25dcfbb32aa",
                        "entry_id": "1e5b5555-1f4d-3232-b66d-41dd2a9c933a",
                        "glosses": [
                            "zentraler Raum in einem Gebäude, in dem technische Anlagen installiert sind, die einen Brand melden und automatisch agieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4d3e1aa-356a-43e4-89e5-a6dd5dd138d8",
                                "sense_id": "2b38161e-2c4e-38bb-920b-b25dcfbb32aa",
                                "text": "„Die Brandmeldezentrale hatte bereits eine SMS mit Infos zum Einsatzort geschickt.“"
                            },
                            {
                                "example_id": "eb19c95e-441b-495b-b3d4-5503b256f0ef",
                                "sense_id": "2b38161e-2c4e-38bb-920b-b25dcfbb32aa",
                                "text": "„Brandmeldeanlagen haben die Aufgabe, einen entdeckten Brand an eine Brandmeldezentrale zu melden.“"
                            },
                            {
                                "example_id": "2d562de0-2183-4917-8793-20c64674bc4e",
                                "sense_id": "2b38161e-2c4e-38bb-920b-b25dcfbb32aa",
                                "text": "„Nach Ausbruch des Brandes lösen auch diese Melder in einem zweiten Schritt in der Brandmeldezentrale Alarm aus.“"
                            },
                            {
                                "example_id": "91c49dcc-34be-48f6-a8ec-00581e421d41",
                                "sense_id": "2b38161e-2c4e-38bb-920b-b25dcfbb32aa",
                                "text": "„In der Brandmeldezentrale laufen alle Informationen zu Detektionen oder Störungen der Brandmelder zusammen.“"
                            }
                        ],
