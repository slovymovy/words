                ],
                "senses": [
                    {
                        "sense_id": "c8d18a1d-6045-3e12-b2ad-3c3c1a4de0a0",
                        "entry_id": "8cb15318-2409-3ee1-9027-e942d3300e5a",
                        "glosses": [
                            "Wissenschaftler, der die Bedingungen und Grundlagen für dauerhaften Frieden zwischen Staaten, Völkern und Menschen erforscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4725f79c-6cc0-4a3a-93d5-9e427921222c",
                                "sense_id": "c8d18a1d-6045-3e12-b2ad-3c3c1a4de0a0",
                                "text": "„Die Friedensforscher müssen die Umweltbedingungen und Verhaltensmotivationen erhellen, die den Frieden bis heute in seiner Abhängigkeit vom Kriege oder der Androhung des Krieges gehalten haben.“"
                            },
                            {
                                "example_id": "babe5cee-f1ee-43a8-ade1-1ea3f3536dcf",
                                "sense_id": "c8d18a1d-6045-3e12-b2ad-3c3c1a4de0a0",
                                "text": "„Der sowjetische Friedensforscher Daniil Michailowitsch Proektor, Professor am Institut für Weltwirtschaft und Internationale Beziehungen der Moskauer Akademie der Wissenschaften, hat seine Angaben über Atomwaffen in der DDR korrigiert.“"
                            },
                            {
                                "example_id": "2a57c2f5-9605-439d-8273-5d25295c2f08",
                                "sense_id": "c8d18a1d-6045-3e12-b2ad-3c3c1a4de0a0",
                                "text": "„Anders als jene utopischen Entwürfe, die im 18. Jahrhundert in Mode waren, ist der ‚Ewige Frieden‘ nicht das Werk eines verträumten Menschheitsverbesserers oder wohlmeinenden Friedensforschers.“"
                            },
                            {
                                "example_id": "cbff3274-f9ae-4cb0-8ddd-0dce6df96f1e",
                                "sense_id": "c8d18a1d-6045-3e12-b2ad-3c3c1a4de0a0",
                                "text": "„Während von ein paar Freizeitaktivisten und einer Handvoll Friedensforschern perfekte Antworten für eine Lösung des komplexen Problems Terrorismus erwartet wird, dürfen die mit allen denkbaren finanziellen und personellen Mitteln ausgestatteten Regierenden und Militärs ohne zeitliche Begrenzung Krieg führen, ohne ein Konzept vorlegen zu müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
