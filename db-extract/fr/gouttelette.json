        "fr-extract.jsonl": [
            {
                "entry_id": "d3d7c2f4-0146-37ce-aa1d-489750eda7f7",
                "word": "gouttelette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cc09e20f-26bf-4f62-98c3-3854839b91a0",
                        "entry_id": "d3d7c2f4-0146-37ce-aa1d-489750eda7f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "gouttelettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9042560-25f9-385c-ba12-b22a7a256b90",
                        "entry_id": "d3d7c2f4-0146-37ce-aa1d-489750eda7f7",
                        "glosses": [
                            "Petite goutte de quelque liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca30e20-5d52-4dc1-86ab-19c3c73f298e",
                                "sense_id": "f9042560-25f9-385c-ba12-b22a7a256b90",
                                "text": "Le ciel sans lune et sans nuages tenait suspendues dans sa profondeur sombre des gouttelettes de lumière, presque toutes blanches comme le diamant, auxquelles se mêlaient pourtant çà et là des gouttelettes de lumière rouge ou bleue."
                            },
                            {
                                "example_id": "0a734216-6bf6-442f-9e70-6d1035ef9469",
                                "sense_id": "f9042560-25f9-385c-ba12-b22a7a256b90",
                                "text": "Elle s’est éclipsée ; elle est revenue, tiède et savonneuse ; puis, toute fraîche, la figure rosissante, essuyant des gouttelettes d’eau."
                            },
                            {
                                "example_id": "617a6dd5-5b80-444d-a085-f1b64570fcb1",
                                "sense_id": "f9042560-25f9-385c-ba12-b22a7a256b90",
                                "text": "Rapides, tendues, ou au contraire se posant en bout de course avec mollesse, les gouttelettes frappaient au petit bonheur le coin de l’œil, la tempe, la pommette, ou visaient droit au creux de l’oreille, si imprévisibles, aux paramètres si compliqués, qu’il était inutile de chercher à s’en prémunir, à moins de s’enfouir la tête dans un sac."
                            }
                        ]
                    },
                    {
                        "sense_id": "f61d8d7e-9509-3a13-b82f-ed24114e1e82",
                        "entry_id": "d3d7c2f4-0146-37ce-aa1d-489750eda7f7",
                        "glosses": [
                            "Postillon, c'est-à-dire gouttelette de salive que l’on projette en parlant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5cfcb3-15b2-422d-880c-195797b33363",
                                "sense_id": "f61d8d7e-9509-3a13-b82f-ed24114e1e82",
                                "text": "Comme avec les coronavirus communs, la transmission du SRAS-CoV a eu lieu de personne à personne par voie aérienne via des gouttelettes respiratoires …."
                            },
                            {
                                "example_id": "6c791ee9-b717-492e-ba48-197f7116ef70",
                                "sense_id": "f61d8d7e-9509-3a13-b82f-ed24114e1e82",
                                "text": "Alors que des études sont en cours pour évaluer le degré de transmissibilité des nouveaux variants, M. Barr dit que \"la propagation pourrait nécessiter moins de contact avec une personne infectée et moins d'exposition aux gouttelettes\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "210fb0ca-795e-4451-b46e-e038c771ab6a",
                        "source_entry_id": "d3d7c2f4-0146-37ce-aa1d-489750eda7f7",
                        "target_lang_word": "Tröpfchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tröpfchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab62c38f-93c2-39b1-99a2-2e6748540e40",
                                        "entry_id": "04b12e7a-d7fe-3bc9-a133-e79953de9c01",
                                        "glosses": [
                                            "winziger Tropfen einer Flüssigkeit oder eines verflüssigten Gases"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a4f393f-bdc8-4fb7-8f1d-6a35ba2230b3",
                                                "sense_id": "ab62c38f-93c2-39b1-99a2-2e6748540e40",
                                                "text": "Die Schwester springt entsetzt hinzu, um den Docht tiefer in das kaum mehr sichtbare Tröpfchen Öl zu tauchen und so wenigstens für den Augenblick das Erlöschen zu verhindern."
                                            },
                                            {
                                                "example_id": "09312c3c-afd7-4e3a-9f60-3a0f0243c968",
                                                "sense_id": "ab62c38f-93c2-39b1-99a2-2e6748540e40",
                                                "text": "Drei Werst von der Station fielen einzelne Tröpfchen, und alsbald durchnäßte mich ein Platzregen durch und durch."
                                            },
                                            {
                                                "example_id": "ad1d32ae-12f6-4a09-8d49-16729baff2d6",
                                                "sense_id": "ab62c38f-93c2-39b1-99a2-2e6748540e40",
                                                "text": "Die Düsen erzeugen so in 15 bis 20 Meter Höhe über dem Erdboden eine ausgedehnte Wolke aus feinen Tröpfchen, in der bei Temperaturen unter null Grad Celsius gute Vereisungsbedingungen herrschen."
                                            },
                                            {
                                                "example_id": "5b532c1d-040b-4a50-9f48-15b00ee69e7f",
                                                "sense_id": "ab62c38f-93c2-39b1-99a2-2e6748540e40",
                                                "text": "„Magnea achtete darauf, nicht mehr als einen ganz kleinen Schluck zu trinken, nur ein paar Tröpfchen passierten ihre rot geschminkten Lippen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a36d3d21-0a12-3e38-8bd7-e55f8e585996",
                                        "entry_id": "04b12e7a-d7fe-3bc9-a133-e79953de9c01",
                                        "glosses": [
                                            "verniedlichend: wohlschmeckender Alkohol (vornehmlich guter Wein)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2b5615-913c-413f-8d53-9adf56b1d6b4",
                                                "sense_id": "a36d3d21-0a12-3e38-8bd7-e55f8e585996",
                                                "text": "Dazu serviert Silvo Topolsek ein edles Tröpfchen aus den Weinbergen, die den auf einem Hügel des Pohorje gelegenen Hof umgeben."
                                            },
                                            {
                                                "example_id": "dc0ba1bb-9fbe-4dae-ad6e-cd5d2e09bcaa",
                                                "sense_id": "a36d3d21-0a12-3e38-8bd7-e55f8e585996",
                                                "text": "Welches Tröpfchen zum Einlegen gewählt wird, entscheidet vor allem der Geschmack. So passt zu Kirschen vor allem Kirschlikör oder -schnaps."
                                            },
                                            {
                                                "example_id": "5ad5459f-488f-4e20-bcbe-66824d18eaee",
                                                "sense_id": "a36d3d21-0a12-3e38-8bd7-e55f8e585996",
                                                "text": "Die besonders guten Tröpfchen, so das Versprechen der einfallsreichen Moselanerin, sind ihren Anlegern garantiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96c45489-0c4f-3a9c-b80f-9e9286edbc10",
                                        "entry_id": "04b12e7a-d7fe-3bc9-a133-e79953de9c01",
                                        "glosses": [
                                            "äußerst geringer Anteil von etwas (Gefühl, Emotion, Geisteshaltung, Musikrichtung etc.)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4e65833-36f6-462a-ac0d-fa6bb105808d",
                                                "sense_id": "96c45489-0c4f-3a9c-b80f-9e9286edbc10",
                                                "text": "Notopfer hießen während der Berlin-Blockade ab 1948 kleine blaue 2-Pfennig-Marken, die zusätzlich zur Briefmarke mit jeder Postsendung ein Tröpfchen Hilfe in die abgeschnittene Stadt brachten."
                                            },
                                            {
                                                "example_id": "77306620-0bf2-40bc-a894-707fdb22826f",
                                                "sense_id": "96c45489-0c4f-3a9c-b80f-9e9286edbc10",
                                                "text": "Palästinenser und Iraker haben schon gewählt, wenngleich unter Besatzungsbedingungen, selbst in der politischen Wüste Saudi-Arabien gab es demokratische Tröpfchen - die ersten Kommunalwahlen, aber nur für Männer."
                                            },
                                            {
                                                "example_id": "a208f85c-fc7c-4cb0-9593-42ebd54cc04e",
                                                "sense_id": "96c45489-0c4f-3a9c-b80f-9e9286edbc10",
                                                "text": "Berta sagte mir, als sie hörte, wie ich meine ersten Skizzen auf dem Klavier ausprobierte, habe sie bitterlich geweint, denn das Libretto hatte sie sehr beeindruckt, und sie mochte es sehr gern und sie konnte nicht verstehen, warum ich es mit dieser Art ,Tröpfchen‘-Musik ruinierte.\""
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c2f319e-cf00-46e2-904a-c56a761c2895",
