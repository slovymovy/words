                "senses": [
                    {
                        "sense_id": "c94cfdf0-ab0a-3dc6-9715-482410be5aae",
                        "entry_id": "5ff11be9-40cc-37f3-8a5b-aabdce0ffebf",
                        "glosses": [
                            "Behelfsbauwerk der Bauarbeiter mit Werkstatt- und Sozialbereichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0635aad4-5b5f-47cb-b3c2-39dcdd06153b",
                                "sense_id": "c94cfdf0-ab0a-3dc6-9715-482410be5aae",
                                "text": "In der Bauhütte liegen die Baupläne aus."
                            },
                            {
                                "example_id": "e48ef4e7-f337-43f2-984b-89a6e07d1871",
                                "sense_id": "c94cfdf0-ab0a-3dc6-9715-482410be5aae",
                                "text": "„Viel war nicht zu sehen: ein weites freies Feld, dahinter umzäuntes Gelände mit Bauhütten, einigen Kränen und Baggern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77eb4eb0-e7b1-3fac-8b3b-d2671338fb59",
                        "entry_id": "5ff11be9-40cc-37f3-8a5b-aabdce0ffebf",
                        "glosses": [
                            "Vereinigung von Handwerkern zu einem großen Bauwerk"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "9d398f14-fc95-462e-8402-4143a43320b8",
                                "sense_id": "77eb4eb0-e7b1-3fac-8b3b-d2671338fb59",
                                "text": "Die Bauhütte vereinigt viele Handwerksberufe."
                            },
                            {
                                "example_id": "e6978376-0f95-4d84-9795-05a99713d5eb",
                                "sense_id": "77eb4eb0-e7b1-3fac-8b3b-d2671338fb59",
                                "text": "„Die Freimaurer haben ihren Ursprung in den Bauhütten, die die Kirchen bauten. Maurer und Steinmetze schließen sich in den mittelalterlichen Bauhütten zusammen, daraus entwickeln sich die Logen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
