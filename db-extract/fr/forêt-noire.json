                                "target_senses": [
                                    {
                                        "sense_id": "b0177ec4-f641-33c5-b98d-6992d65fc002",
                                        "entry_id": "9211185d-ca00-380a-9206-3549abdfa616",
                                        "glosses": [
                                            "A large forest and mountain range in southwestern Germany."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Black Forest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3596ecdc-6e00-39f0-b936-abd22dd4b44c",
                                        "entry_id": "08b357c0-6c08-3e46-a742-1cf24512139d",
                                        "glosses": [
                                            "A style of confectionery that is a combination of dark chocolate, cream, and cherries."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b39ecf9c-4398-4e28-9926-8063287210a0",
                                                "sense_id": "3596ecdc-6e00-39f0-b936-abd22dd4b44c",
                                                "text": "One reader combines equal parts of cherry pie filling and chocolate pudding for a quick dessert—a sort of Black Forest pudding or parfait."
                                            },
                                            {
                                                "example_id": "ef8fdb48-ae19-450b-9c1a-bc81c4fa79ae",
                                                "sense_id": "3596ecdc-6e00-39f0-b936-abd22dd4b44c",
                                                "text": "So was perspective, Kristen learned as she entered her kitchen and found Casey sitting at her built-in peninsula, chowing through a mini mason jar full of chocolate-cherry Black Forest pie with mocha whipped cream and bittersweet chocolate shavings and almond brittle."
                                            },
                                            {
                                                "example_id": "332efc0b-24ba-4455-9e67-618269a06495",
                                                "sense_id": "3596ecdc-6e00-39f0-b936-abd22dd4b44c",
                                                "text": "She squeezed out a lump of whipped cream frosting onto two of the last batch of Black Forest cupcakes when a throat cleared in the front and startled her."
                                            },
                                            {
                                                "example_id": "958e3aa0-aba7-4010-9bca-3d376bc7f951",
                                                "sense_id": "3596ecdc-6e00-39f0-b936-abd22dd4b44c",
                                                "text": "Opened in 2018 in the ruined castle Burg Landshut, this state-of-the-art restaurant is worth the steep climb (or shuttle-bus ride) for modern German cuisine such as sauerkraut and blood-sausage soup, and pike-perch with bacon and cabbage mash, topped off by desserts like Black Forest mousse with berry coulis and Riesling sorbet with poached local peaches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
