                    {
                        "translation_id": "f52c3d3f-03fb-47e1-9ee9-b147aa0d56df",
                        "source_entry_id": "63f8457d-dece-3ce4-8480-a344df553a56",
                        "source_sense_id": "9fbcbb17-c6c2-3b1f-b4f6-e369b85476a8",
                        "target_lang_word": "à volonté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à volonté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff81bd1-e16c-366a-b560-6d0066ab17b1",
                                        "entry_id": "55458656-cd97-3f84-b2d8-21732a174652",
                                        "glosses": [
                                            "Quand on veut ; comme on veut ; autant qu’on veut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b09b831-a6f1-4e46-b28f-fa17104a18a6",
                                                "sense_id": "0ff81bd1-e16c-366a-b560-6d0066ab17b1",
                                                "text": "Je certifie que depuis la connaissance des ovaires que j'ai cités plus haut, j'ai toujours obtenu et fait obtenir à volonté le sexe désiré. Je suis maintenant bien convaincu, que, toute femme peut avoir celui qu'elle voudra, […]."
                                            },
                                            {
                                                "example_id": "83f69674-71eb-4e78-aebf-c201117bb87b",
                                                "sense_id": "0ff81bd1-e16c-366a-b560-6d0066ab17b1",
                                                "text": "Quand ces braves gens ont gagné quelque fortune, ils en dépensent une certaine partie à leur passion longtemps couvée, et y déversent les dernières oscillations d’un mouvement qui ne saurait s’arrêter à volonté."
                                            },
                                            {
                                                "example_id": "2bc501b7-df77-4621-86c0-d173aa1c970d",
                                                "sense_id": "0ff81bd1-e16c-366a-b560-6d0066ab17b1",
                                                "text": "Ils choisiront dans ce dernier Ordre un secrétaire qui ne fera pas partie des 144 députés, sera révocable à volonté, et n'aura que voix instructive ; […]."
                                            },
                                            {
                                                "example_id": "665347b4-c725-4ea4-ab5a-ceed3e32ee68",
                                                "sense_id": "0ff81bd1-e16c-366a-b560-6d0066ab17b1",
                                                "text": "Un buffet en libre-service est un buffet où l’on peut se servir à volonté."
                                            },
                                            {
                                                "example_id": "2ea0417c-a0db-439f-bb33-a06ba8ad549d",
                                                "sense_id": "0ff81bd1-e16c-366a-b560-6d0066ab17b1",
                                                "text": "Feu à volonté !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c6d7d33-ba3d-3c38-ae4b-c170a431766a",
                                        "entry_id": "55458656-cd97-3f84-b2d8-21732a174652",
                                        "glosses": [
                                            "Quand celui à qui il est dû voudra être payé, concernant le paiement d'un effet de commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca52f089-c1a4-4b9f-b8a3-8f7785ddc6d3",
                                                "sense_id": "0c6d7d33-ba3d-3c38-ae4b-c170a431766a",
                                                "text": "Billet à ordre payable à volonté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
