        "fr-extract.jsonl": [
            {
                "entry_id": "7b69018a-4d3e-38da-9bb4-cf8cb2f853db",
                "word": "faconde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c0d052b5-b165-422c-b2f7-c6270265c174",
                        "entry_id": "7b69018a-4d3e-38da-9bb4-cf8cb2f853db",
                        "tags": [
                            "plural"
                        ],
                        "form": "facondes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1397a1a-ebc3-36d6-9ceb-d3bfb166664c",
                        "entry_id": "7b69018a-4d3e-38da-9bb4-cf8cb2f853db",
                        "glosses": [
                            "Élégance de bien parler."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2588e72b-5358-409a-a67a-90c678153981",
                                "sense_id": "f1397a1a-ebc3-36d6-9ceb-d3bfb166664c",
                                "text": "Avec son aplomb imperturbable, sa faconde étourdissante, il inspirait non moins de confiance que le berger Frik — ce qui n’est pas peu dire."
                            },
                            {
                                "example_id": "aae6ddaf-43d2-44d1-99a8-19ce8e59edca",
                                "sense_id": "f1397a1a-ebc3-36d6-9ceb-d3bfb166664c",
                                "text": "Il me fallait cependant encore retrouver de la verve, de la faconde qui puisse plaire à mes nouveaux amis, de la facile."
                            },
                            {
                                "example_id": "720cfc31-2ef3-403e-af65-45fed0b02497",
                                "sense_id": "f1397a1a-ebc3-36d6-9ceb-d3bfb166664c",
                                "text": "[…] Le Kalevala est un véritable éblouissement, auquel cette traduction de Gabriel Rebourcet rend sa faconde et son ivresse furibarde."
                            }
                        ]
                    },
                    {
                        "sense_id": "1489dc97-fbac-387c-aa83-737f8715a383",
                        "entry_id": "7b69018a-4d3e-38da-9bb4-cf8cb2f853db",
                        "glosses": [
                            "Éloquence trop facile et trop abondante. Loquacité, incontinence verbale."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d4784fbd-ad04-4339-a4c6-defde2404ff7",
                                "sense_id": "1489dc97-fbac-387c-aa83-737f8715a383",
                                "text": "Il est d’une faconde insupportable."
                            },
                            {
                                "example_id": "886b9330-d820-44e3-9e27-fee66a236eac",
                                "sense_id": "1489dc97-fbac-387c-aa83-737f8715a383",
                                "text": "Je n’avais pas de préjugé favorable pour l’accent du Midi, l’assimilant plutôt à une faconde provençale mâtinée de pagnolade et d’aïoli, où triomphe souvent une insupportable prétention pour savoir-goûter-les-vraies-choses-de-la-vie. »"
                            },
                            {
                                "example_id": "702e377c-d77e-470f-8220-bea3ddbc4ab2",
                                "sense_id": "1489dc97-fbac-387c-aa83-737f8715a383",
                                "text": "Antoine Pallières ayant sonné impérieusement trois fois à ma loge et, sans me saluer, entrepris avec une vindicte [sic] faconde de me narrer la disparition de sa trottinette chromée, je lui ai claqué la porte au nez."
                            },
                            {
                                "example_id": "b3eb263f-e2cc-4d54-8fa7-1f4643b21b92",
                                "sense_id": "1489dc97-fbac-387c-aa83-737f8715a383",
                                "text": "A Champigny, dans le Val-de-Marne, où il décroche son premier job, sa faconde et son habileté à convaincre les clients de souscrire des contrats font vite grimper le chiffre d’affaires du cabinet."
                            },
                            {
                                "example_id": "3c9df17b-9ac4-4d68-9469-62469cfd1413",
                                "sense_id": "1489dc97-fbac-387c-aa83-737f8715a383",
                                "text": "Jason. - Comme un marin qui mène judicieusement sa barque, je dois serrer la toile pour échapper sous les déchaînements de ta faconde : quel accès de loquacité, femme !"
                            }
                        ]
                    }
                ],
