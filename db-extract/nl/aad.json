                "senses": [
                    {
                        "sense_id": "eb8b25e9-0e8b-3794-bf72-03a2b9855f05",
                        "entry_id": "af2ac871-939b-3bdf-95b1-5cffd521d14a",
                        "glosses": [
                            "shallow oval tub or tray used for acquiring cream from milk"
                        ],
                        "tags": [
                            "feminine",
                            "no-diminutive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "02191403-b2ef-4015-b14a-60ff758dc5c1",
                                "sense_id": "eb8b25e9-0e8b-3794-bf72-03a2b9855f05",
                                "text": "1855, \"Boterbereiding\", Tijdschrift voor nijverheid en landbouw in Nederlandsch-Indië, Vol. 2, Part 2 (extracts from Dutch and foreign magazines), page 21, quoting De Nijverheid of March 1854.\nZij nu, die uitsluitend den room willen karnen, moeten de melk korter laten bekoelen, daar zij anders te veel beroomd, en de te veel beroomde melk, in de aden overgegoten, minder room afscheidt, dan wanneer zij minder beroomd is. De melk 1 à 2 etmalen in de aden gestaan hebbende, neemt men den room met een zeer dun houten bord, dat vooraf in koud water gelegen heeft, van de melk af, en brengt hem in een molkenvat over, dat men tot aan het karnen in den kelder plaatst; is echter de room niet koud genoeg, dan koelt men hem eerst nog af, voor dat hij in het vat gegoten wordt.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "1b190b8a-c791-449f-ab0f-fa65750b0348",
                                "sense_id": "eb8b25e9-0e8b-3794-bf72-03a2b9855f05",
                                "text": "In de friesche kelders, waar men de aden op eene melkstelling rond den kelder plaatst, heeft elke aad een gemiddelde inhoud van 20 ad 25 liters, bij een oppervlak ½ □ M. zoodat men per koe ééne aad kan rekenen."
                            }
                        ]
                    }
