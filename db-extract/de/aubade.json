                        ],
                        "examples": [
                            {
                                "example_id": "9f7b638e-9d6d-4b61-a1e7-2c2a3053d975",
                                "sense_id": "1e9e75bf-718b-3026-bfe2-2f967e6a803b",
                                "text": "Die Zuschauer applaudierten für die Aubade des Gesangsvereins aus München."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4c1db8d-f354-4908-ae97-43e6be6c4beb",
                        "source_entry_id": "0fdec33f-6373-30cd-aa7e-66f2d9560aca",
                        "source_sense_id": "1e9e75bf-718b-3026-bfe2-2f967e6a803b",
                        "source_sense_description": "morgendliches Ständchen, in Form als Gesang mit musikalische Begleitung oder rein instrumental",
                        "target_lang_word": "aubade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aubade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac9f0a6d-e936-3206-9013-33cb965e581f",
                                        "entry_id": "06523b03-0b7e-3457-b178-83044f9137f1",
                                        "glosses": [
                                            "A poem or song evoking or greeting the dawn or early morning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f6148cf-e2b6-4ac3-85ba-3ff43204cb41",
                                                "sense_id": "ac9f0a6d-e936-3206-9013-33cb965e581f",
                                                "text": "And there he lingered till the crowing cock, / The Alectryon of the farmyard and the flock, / Sang his aubade with lusty voice and clear, / To tell the sleeping world that dawn was near."
                                            },
                                            {
                                                "example_id": "5a7f3d9c-ae9d-46d8-b3de-5045e847dfec",
                                                "sense_id": "ac9f0a6d-e936-3206-9013-33cb965e581f",
                                                "text": "Alladad Khan woke to the far crying of kampong cocks in the dark. That noise had been the farmyard aubade in the Punjab in his dream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65d69b5b-f1c1-39aa-ba16-ffb987bed32b",
                                        "entry_id": "06523b03-0b7e-3457-b178-83044f9137f1",
                                        "glosses": [
                                            "A poem or song evoking or greeting the dawn or early morning.",
                                            "A morning love song, or a song of lovers parting in the morning."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6927a20-3c7f-32a8-82d5-49a3cd67cdfa",
                                        "entry_id": "06523b03-0b7e-3457-b178-83044f9137f1",
                                        "glosses": [
                                            "A concert held at dawn or in the morning, especially outdoors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49e436ee-6dba-4f37-ada4-6600309584fb",
                        "source_entry_id": "0fdec33f-6373-30cd-aa7e-66f2d9560aca",
                        "source_sense_id": "1e9e75bf-718b-3026-bfe2-2f967e6a803b",
                        "source_sense_description": "morgendliches Ständchen, in Form als Gesang mit musikalische Begleitung oder rein instrumental",
                        "target_lang_word": "aubade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aubade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                        "entry_id": "f0a58340-1d53-358d-94c0-58771d991680",
                                        "glosses": [
                                            "Concert donné en plein air, vers l’aube, à la porte ou sous les fenêtres d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa649a7-29ff-4c14-8da5-9399abb15941",
                                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                                "text": "Donner une aubade."
                                            },
                                            {
                                                "example_id": "35c1c40b-a12c-4dc5-bfa3-edad18d8b663",
                                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                                "text": "Après la parade, Lucien fut d’inspection à la caserne ; à peine rentré chez lui, les trente-six trompettes vinrent sous ses fenêtres lui donner une aubade agréable."
                                            },
                                            {
                                                "example_id": "d99b6a3f-68de-4d0c-ac8b-9e2b60f93886",
                                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                                "text": "Cette coutume s’appelait aubade. Chaque année au 14 juillet, la fanfare municipale se divisait ainsi en petites formations de trois ou quatre musiciens qui allaient, sur le coup de sept heures du matin, réveiller en musique les notabilités de la ville et, quelquefois aussi, une demoiselle auprès de qui l’un de ces messieurs voulait se distinguer."
                                            },
                                            {
                                                "example_id": "2d16d7dc-13c5-448c-8002-3e46bb8cc5d5",
                                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                                "text": "J’ai graissé la patte au berger\nPour lui faire jouer une aubade"
                                            },
                                            {
                                                "example_id": "8fe4ca6e-ca39-475a-9bf5-3228dfa86344",
                                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                                "text": "Sûr, faut que je chante\nMon aubade à Lydie :\nÔ ma Lydie tu hantes\nMes rudes rêves au lit\nDis ! Tu me séduis en te\nRiant de mes ridicules\nEt vaines tentatives de conciliations\nAvec tes tantes hâtives à te marier\nAvec un marchand de tapis né à Tunis"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ff3ba4-5420-342b-a1ee-0f1f17659949",
                                        "entry_id": "f0a58340-1d53-358d-94c0-58771d991680",
                                        "glosses": [
                                            "Insulte, avanie, peur faite avec vacarme à quelqu’un."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "858695b6-bd4c-4438-be0f-59e0b649214b",
                                                "sense_id": "26ff3ba4-5420-342b-a1ee-0f1f17659949",
                                                "text": "Il a eu une furieuse aubade."
                                            },
                                            {
                                                "example_id": "5e3b72a7-893a-4e0c-9e5e-dc65743df858",
                                                "sense_id": "26ff3ba4-5420-342b-a1ee-0f1f17659949",
                                                "text": "Qu'il aille au diable avec sa sérénade,\nJe vais songer à lui donner l’aubade, moi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aubade",
                                "target_lang_code": "fr",
                                "target_senses": [
