                "senses": [
                    {
                        "sense_id": "f466b397-6944-3c6c-9e6f-1f444dc80b2c",
                        "entry_id": "f1961a8b-a141-3962-afb2-bdcea14191e3",
                        "glosses": [
                            "leichtes Hilfsgerät auf zwei Rädern zum zu Wasser lassen und aus dem Wasser holen von (leichten) Jollen und Katamaranen; Bedienung: von Hand"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "2d169b0f-2ba0-4e2a-b8a8-0df057aff5e3",
                                "sense_id": "f466b397-6944-3c6c-9e6f-1f444dc80b2c",
                                "text": "„Das Schiff, eine GFK-Sandwichkonstruktion mit hohen Kohlefaseranteilen, wird segelfertig nur gerade 45 Kilogramm wiegen […]. […] Somit kann die Flo1 auch ganz einfach auf dem Slipwagen ein- und ausgewassert werden.“"
                            },
                            {
                                "example_id": "f8d557dc-3536-47a6-8cdc-a256d309d504",
                                "sense_id": "f466b397-6944-3c6c-9e6f-1f444dc80b2c",
                                "text": "„Ruder und Schwert sind zudem aufholbar, was ein sehr leichtes Zuwasserlassen per Slipwagen ermöglicht.“"
                            },
                            {
                                "example_id": "40d1ae3c-920c-43af-8068-8be9e8cd3522",
                                "sense_id": "f466b397-6944-3c6c-9e6f-1f444dc80b2c",
                                "text": "„Einen Platz im Hafen benötigt man nicht, denn die SK2 wird wie eine Jolle auf dem Slipwagen gelagert und gewassert.“"
                            },
                            {
                                "example_id": "49aaece4-4ecb-4f2a-b11e-ca71a79b9e1c",
                                "sense_id": "f466b397-6944-3c6c-9e6f-1f444dc80b2c",
                                "text": "„Im Yachthafen des YCRa stehen mehrere Arten von Liegeplätzen ausschließlich für Segelboote zur Verfügung. […] Landliegeplätze für Jollen, die durch die Crew mit eigener Kraft per Slipwagen bewegbar sind und über die Sliprampe zu Wasser gebracht werden können.“"
                            },
                            {
                                "example_id": "a91d06c4-daeb-43a5-a191-7a92a736aae5",
                                "sense_id": "f466b397-6944-3c6c-9e6f-1f444dc80b2c",
                                "text": "[Warnemünder Woche:] „Jeder Teilnehmer auf der Mittelmole erhält beim Check-In zwei identische Slipwagenkennungen, eine um sie am Slipwagen zu befestigen und eine, um sich die Nummer zu merken. Ist das Boot im Wasser, bleibt der Aktive beim Boot und die Helfer kümmern sich um den Slipwagen. Nach der Regatta bringen die Helfer dann den Slipwagen zum Segler und dessen Boot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "07bc3df2-3a78-3b63-8cae-e746ee2462c6",
                        "entry_id": "f1961a8b-a141-3962-afb2-bdcea14191e3",
                        "glosses": [
                            "schweres Rollgerät auf Schienen zum Auf- und Abslippen von (schweren) Motorbooten, Jollenkreuzern, Kielbooten bis zu Binnenschiffen und Frachtern; Bedienung: mit einer (meist elektrischen) Winde"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "31fc84fc-ab51-45dd-97d9-776512c2f1b2",
                                "sense_id": "07bc3df2-3a78-3b63-8cae-e746ee2462c6",
                                "text": "[Ein Slip ist eine] leicht geneigte Ebene mit Schienen für den Slipwagen, auf dem ein Schiff aufs Trockene gezogen werden kann."
                            },
                            {
                                "example_id": "362af9ff-ba9a-4267-a70e-59ec7834bbe6",
                                "sense_id": "07bc3df2-3a78-3b63-8cae-e746ee2462c6",
                                "text": "„Jahresbericht des Takelmeisters 2018 – […] Dann gab es leider einige Havarien, die zu nicht unerheblichen Kosten geführt haben. […] Der Slipwagen am Südslipp lief nicht mehr und musste aufwändig überarbeitet werden. Die Kosten beliefen sich auf rund 6.000 Euro.“"
                            },
                            {
                                "example_id": "32341a2f-6437-4efb-bd45-d2c9e66c5431",
                                "sense_id": "07bc3df2-3a78-3b63-8cae-e746ee2462c6",
                                "text": "„Im Jahr 2013 haben wir eine Krananlage installiert. Wir können jetzt Boote bis 4 Tonnen vom LKW bzw. Trailer auf einen Slipwagen umladen oder auch für Reparaturen anheben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
