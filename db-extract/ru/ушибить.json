                    },
                    {
                        "form_id": "9d622846-8f0d-4bb3-9bee-ed0d1d11abad",
                        "entry_id": "0e9dd50f-b406-3767-888e-8842a873c9d0",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "ушиби́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "500d5373-791b-3a8a-a5e1-fb7723650b5a",
                        "entry_id": "0e9dd50f-b406-3767-888e-8842a873c9d0",
                        "glosses": [
                            "повредить ударом (какую-либо часть тела), причинить боль ударом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05894c11-8f5d-4413-9d48-8f9bea0c9208",
                                "sense_id": "500d5373-791b-3a8a-a5e1-fb7723650b5a",
                                "text": "Надо было согнуться, чтоб не ушибить голову о давящий и округлый череп уходящего в глубину свода."
                            }
                        ]
                    },
                    {
                        "sense_id": "f68c6555-1d28-3ac1-854b-4e00e387f91a",
                        "entry_id": "0e9dd50f-b406-3767-888e-8842a873c9d0",
                        "glosses": [
                            "разг. потрясти, нанести душевную рану, сокрушить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0733c6e-e247-407e-bcc4-4b4de62b67b4",
                                "sense_id": "f68c6555-1d28-3ac1-854b-4e00e387f91a",
                                "text": "Лягушек жалеть не надо, господь с ними! Мать пожалей, — вон как ее горе ушибло!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9db8d82-79dd-4cb1-b531-4ddae0f62e98",
                        "source_entry_id": "0e9dd50f-b406-3767-888e-8842a873c9d0",
                        "target_lang_word": "blesser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blesser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2316cf-9d89-31e6-b5dc-13a979a10808",
                                        "entry_id": "fd4ff79e-ad4c-3030-976d-a58899bf682d",
                                        "glosses": [
                                            "Frapper d’un coup qui fait une contusion, une plaie, une fracture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "625208fd-4c87-4a1f-a5dc-832ad6ca659c",
                                                "sense_id": "5e2316cf-9d89-31e6-b5dc-13a979a10808",
                                                "text": "Trois hommes tombèrent. Un avait été tué raide d'une balle dans la tête. Les deux autres n’étaient que blessés."
                                            },
                                            {
                                                "example_id": "27ba5f52-d21c-4144-8fde-b9be2739cce2",
                                                "sense_id": "5e2316cf-9d89-31e6-b5dc-13a979a10808",
                                                "text": "Il a été blessé d’un coup d’épée, d’un coup de bâton, d’un coup de pierre. Quand il est question de la Guerre, il ne se dit que de Coups qui font une plaie ou une fracture."
                                            },
                                            {
                                                "example_id": "f916c713-e422-4ccb-8bd2-13bcc990a074",
                                                "sense_id": "5e2316cf-9d89-31e6-b5dc-13a979a10808",
                                                "text": "Cet officier n’a point encore fait de campagne qu’il n’ait été blessé."
                                            },
                                            {
                                                "example_id": "4d9baecd-7424-4b65-9686-bd18c130131d",
                                                "sense_id": "5e2316cf-9d89-31e6-b5dc-13a979a10808",
                                                "text": "Il n’a pas été blessé, il n’a reçu qu’une contusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17c0fca2-0f69-3ae6-b189-8ba5753ead73",
                                        "entry_id": "fd4ff79e-ad4c-3030-976d-a58899bf682d",
                                        "glosses": [
                                            "Occasionner, par choc, pression ou frottement, quelque plaie ou contusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9473a4e7-ea40-4867-b25b-02f6a9a557bf",
                                                "sense_id": "17c0fca2-0f69-3ae6-b189-8ba5753ead73",
                                                "text": "Le canot bascule sur le berthon, se met à glisser vers l'avant écrasant une trentaine de personnes et blessant grièvement à la jambe Isaac Lehmann."
                                            },
                                            {
                                                "example_id": "79f74fb4-dddd-4af0-af76-4b1a6c604f76",
                                                "sense_id": "17c0fca2-0f69-3ae6-b189-8ba5753ead73",
                                                "text": "Le joug peut blesser les jeunes bœufs."
                                            },
                                            {
                                                "example_id": "751fdb9a-111e-4e33-be6b-e0f31f18fea1",
                                                "sense_id": "17c0fca2-0f69-3ae6-b189-8ba5753ead73",
                                                "text": "Cette selle blesse mon cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa3e778e-5026-3f7d-b313-367485b3a1e3",
                                        "entry_id": "fd4ff79e-ad4c-3030-976d-a58899bf682d",
                                        "glosses": [
                                            "Causer seulement quelque gêne, quelque douleur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "046a25bf-4e82-4583-8409-abc8b05206dd",
                                                "sense_id": "aa3e778e-5026-3f7d-b313-367485b3a1e3",
                                                "text": "Ces souliers me blessent."
                                            },
                                            {
                                                "example_id": "228c803e-e883-4f8d-994c-79eff30b6d00",
                                                "sense_id": "aa3e778e-5026-3f7d-b313-367485b3a1e3",
                                                "text": "Vous ne savez pas où le bât le blesse. Voir bât."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a73d8d7-9254-337a-960a-da94924e757c",
                                        "entry_id": "fd4ff79e-ad4c-3030-976d-a58899bf682d",
                                        "glosses": [
                                            "Causer une impression désagréable à la vue, à l’ouïe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d2bb365-075a-4100-b67c-e2f37f9699e6",
                                                "sense_id": "7a73d8d7-9254-337a-960a-da94924e757c",
                                                "text": "Les couleurs trop éclatantes blessent la vue."
                                            },
                                            {
                                                "example_id": "30fc0118-c0f5-4874-bb54-c26869f8a546",
                                                "sense_id": "7a73d8d7-9254-337a-960a-da94924e757c",
                                                "text": "Ces objets hideux blessent les regards."
                                            },
                                            {
                                                "example_id": "d94117c2-0b1e-402c-8de5-e41171f95a90",
                                                "sense_id": "7a73d8d7-9254-337a-960a-da94924e757c",
                                                "text": "Ce son blesse l’oreille."
                                            },
                                            {
                                                "example_id": "704705d7-784f-464c-a073-b642e0dc2f02",
                                                "sense_id": "7a73d8d7-9254-337a-960a-da94924e757c",
                                                "text": "— Contre le plus bas peuple de Paris, qui nous veut pour chefs, et que nous fuyons ; il est odieux : la vue, l’odeur, l’ouïe et le contact surtout sont par trop blessés, dit M. du Lude avec une gravité comique : c’est trop fort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "303a5141-d020-3462-af30-3db3ce5428b5",
                                        "entry_id": "fd4ff79e-ad4c-3030-976d-a58899bf682d",
                                        "glosses": [
                                            "Au sens moral, Offenser, choquer, déplaire, navrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9f159e-b68e-4999-9f24-9b2c6829a793",
                                                "sense_id": "303a5141-d020-3462-af30-3db3ce5428b5",
                                                "text": "Qu’a donc ce discours qui vous blesse ?"
                                            },
                                            {
                                                "example_id": "61fa60db-21c8-407c-98cc-bb8a170a81de",
                                                "sense_id": "303a5141-d020-3462-af30-3db3ce5428b5",
                                                "text": "Je ne vois rien là qui puisse blesser."
                                            },
                                            {
                                                "example_id": "3ef1beda-3ed5-4641-a223-cc1814a1e705",
                                                "sense_id": "303a5141-d020-3462-af30-3db3ce5428b5",
                                                "text": "Son orgueil en fut blessé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56acaa6-37d3-3edc-aeae-0b3a6bff3e8b",
                                        "entry_id": "fd4ff79e-ad4c-3030-976d-a58899bf682d",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d53e6945-dc3a-4eac-b307-b9b7aa31ea9a",
                                                "sense_id": "d56acaa6-37d3-3edc-aeae-0b3a6bff3e8b",
                                                "text": "Blesser quelqu’un au cœur, L’offenser dans ses affections, dans ses sentiments les plus chers."
                                            },
                                            {
                                                "example_id": "14d92ee8-1037-4b71-ab5f-b09814c07dba",
                                                "sense_id": "d56acaa6-37d3-3edc-aeae-0b3a6bff3e8b",
                                                "text": "Ces images, ces paroles blessent la pudeur, Sont contraires à la pudeur."
                                            },
                                            {
                                                "example_id": "e558a728-3974-4eee-a472-31194c9b7ee5",
                                                "sense_id": "d56acaa6-37d3-3edc-aeae-0b3a6bff3e8b",
                                                "text": "Blesser les convenances, la vraisemblance, Faire ou dire quelque chose de contraire aux convenances, ou qui s’écarte de la vraisemblance."
                                            },
                                            {
                                                "example_id": "79fa52b7-004b-4bcc-b75b-136296897682",
                                                "sense_id": "d56acaa6-37d3-3edc-aeae-0b3a6bff3e8b",
                                                "text": "Blesser les usages, les règles, les principes, le goût, etc."
                                            },
                                            {
                                                "example_id": "eaf7f51f-13e2-4312-b8c0-ef6250d2568b",
                                                "sense_id": "d56acaa6-37d3-3edc-aeae-0b3a6bff3e8b",
                                                "text": "Comme il connaissait le respect de M. Donis pour ce qui, de près ou de loin, touchait aux usages du savoir-vivre, il s’était imposé la règle de ne venir voir Marthe qu’après midi. C’était par peur de blesser ces usages qu’il avait refusé d’accepter la chambre que M. Donis lui offrait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b54c845f-1200-33c8-8885-8528396ef79a",
                                        "entry_id": "fd4ff79e-ad4c-3030-976d-a58899bf682d",
                                        "glosses": [
                                            "Faire tort, faire préjudice, porter dommage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9900e45e-57d1-4a35-b158-6fe1904021c8",
                                                "sense_id": "b54c845f-1200-33c8-8885-8528396ef79a",
                                                "text": "Jeanne n’était pas de la fête parce que, me dit-on, sa présence, contraire au règlement, aurait blessé l’égalité si nécessaire à maintenir entre tant de jeunes élèves."
                                            },
                                            {
                                                "example_id": "8aa7d44e-fe6d-4f63-acbc-0b1131d17c3c",
                                                "sense_id": "b54c845f-1200-33c8-8885-8528396ef79a",
                                                "text": "Cela ne blesse personne."
                                            },
                                            {
                                                "example_id": "f2d09a1b-5dd0-4ff4-a60e-2fb33ed03d9f",
                                                "sense_id": "b54c845f-1200-33c8-8885-8528396ef79a",
                                                "text": "La clause de cette transaction, de ce contrat blesse mes intérêts."
                                            },
                                            {
                                                "example_id": "487c2322-f380-461f-ad85-c3c2c9cf199c",
                                                "sense_id": "b54c845f-1200-33c8-8885-8528396ef79a",
                                                "text": "Blesser l’honneur, la réputation de quelqu’un, blesser l’amitié, blesser la bonne foi, la justice, etc., Faire quelque chose contre l’honneur, contre la réputation de quelqu’un, contre ce qu’on doit à l’amitié, à la bonne foi, à la justice, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blesser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "487a7cf0-144e-3e2f-b4b5-572cd0bd2069",
                                        "entry_id": "5660b15d-e51c-3ab2-8f42-5fc1405d2cdf",
                                        "glosses": [
                                            "Se faire du mal à soi-même par accident, par mégarde ou à dessein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7bd225c-6c66-4679-b4b0-03a2c752df3d",
                                                "sense_id": "487a7cf0-144e-3e2f-b4b5-572cd0bd2069",
                                                "text": "Prenez garde de vous blesser en maniant cette arme."
                                            },
                                            {
                                                "example_id": "d28e5ffb-4ed4-4a6b-bdfe-46a4f5817650",
                                                "sense_id": "487a7cf0-144e-3e2f-b4b5-572cd0bd2069",
                                                "text": "Ce poltron s’est blessé lui-même légèrement pour faire croire qu’il a pris part au combat."
                                            },
                                            {
                                                "example_id": "dbe4af8d-e019-4c79-b2cd-86b3523f13ba",
                                                "sense_id": "487a7cf0-144e-3e2f-b4b5-572cd0bd2069",
                                                "text": "Il s’est blessé en tombant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2141c526-ca0a-3e9b-a3e7-31fd54d92668",
                                        "entry_id": "5660b15d-e51c-3ab2-8f42-5fc1405d2cdf",
                                        "glosses": [
                                            "Faire une fausse couche."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe88fcb6-5da4-4b46-94b0-6cd807149e44",
                                                "sense_id": "2141c526-ca0a-3e9b-a3e7-31fd54d92668",
                                                "text": "Elle pensait que si Louise attendait un enfant, elle n'oserait jamais donner l'élan nécessaire au volant de crainte de se « blesser », comme on disait alors, c'est-à-dire de risquer une fausse couche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c453040-e4e9-301d-80ef-37d5465bc125",
                                        "entry_id": "5660b15d-e51c-3ab2-8f42-5fc1405d2cdf",
                                        "glosses": [
                                            "S’offenser de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cbb987d-f952-436d-8e27-19f15e085d74",
                                                "sense_id": "1c453040-e4e9-301d-80ef-37d5465bc125",
                                                "text": "C’est un homme qui se blesse d’un rien."
                                            },
                                            {
                                                "example_id": "b56ddaf2-1231-4229-92ab-7f48fcd0484b",
                                                "sense_id": "1c453040-e4e9-301d-80ef-37d5465bc125",
                                                "text": "C’est un homme qui se blesse aisément, qui se blesse de tout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1c693ea-798c-4082-8f49-2d105bd91905",
                        "source_entry_id": "0e9dd50f-b406-3767-888e-8842a873c9d0",
                        "target_lang_word": "contusionner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contusionner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f9f23ed-7b29-3d73-9497-30ca645ab072",
                                        "entry_id": "83fd76b8-dbd9-3809-b1ab-36d5635baec2",
                                        "glosses": [
                                            "Blesser par contusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d97ef55-bf98-411e-a1ab-0e52f116c6a5",
                                                "sense_id": "0f9f23ed-7b29-3d73-9497-30ca645ab072",
                                                "text": "Tu auras ta fessée un de ces jours, ma belle, dis-je. Ou plutôt, pour le dire plus délicatement — parce que tu es une môme bien élevée — je contusionnerai intentionnellement la partie inférieure de tes muscles lombaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40caa7ed-2c2d-42d4-b799-46d47b7f9074",
                        "source_entry_id": "0e9dd50f-b406-3767-888e-8842a873c9d0",
                        "target_lang_word": "meurtrir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meurtrir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "790fd899-884e-3f02-8e13-8e0c83b9cecb",
                                        "entry_id": "40cd139c-90d8-38b9-a833-aa163588ac52",
                                        "glosses": [
                                            "Tuer, assassiner."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93ba51ea-8247-4917-9013-994ba4286e52",
                                                "sense_id": "790fd899-884e-3f02-8e13-8e0c83b9cecb",
                                                "text": "L'ami (...) fut égorgé là (...).\nEt, pressant dans ses bras le corps meurtri qu'elle aime,\nElle a longtemps hurlé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d5ac260-c7c1-3971-b029-ac911e04085d",
                                        "entry_id": "40cd139c-90d8-38b9-a833-aa163588ac52",
                                        "glosses": [
                                            "Contusionner, blesser, choquer ou frapper au point de laisser une marque ou une ecchymose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c04e34f0-1bbd-4eb6-8018-4680c3261d43",
                                                "sense_id": "9d5ac260-c7c1-3971-b029-ac911e04085d",
                                                "text": "[…]; et voilà ma comédie flambée, pour plaire aux princes mahométans, dont pas un, je crois ne sait lire, et qui nous meurtrissent l’omoplate, en nous disant: Chiens de chrétiens !"
                                            },
                                            {
                                                "example_id": "2b6a383f-678d-4bb7-9ce3-c2a523d6d189",
                                                "sense_id": "9d5ac260-c7c1-3971-b029-ac911e04085d",
                                                "text": "Messire Goupil, vaguement étourdi par quelque plomb qui lui avait meurtri la caboche, se réveillait en effet fort opportunément."
                                            },
                                            {
                                                "example_id": "10aaf4de-caa5-4cb6-8269-67fbcce686d4",
                                                "sense_id": "9d5ac260-c7c1-3971-b029-ac911e04085d",
                                                "text": "Les bourreaux doivent savourer la même omnipotence, se livrer à pareille furie, goûter une égale joie de meurtrir sans remords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2ed8f58-dbcf-3892-9c73-af8d5179c258",
                                        "entry_id": "40cd139c-90d8-38b9-a833-aa163588ac52",
                                        "glosses": [
                                            "Blesser l'âme, en parlant d'une personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0835b1e8-ebd2-46bd-9331-e56bd533e737",
                                                "sense_id": "d2ed8f58-dbcf-3892-9c73-af8d5179c258",
                                                "text": "Ces paroles l'ont meurtri profondément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb9f0001-3c6c-3d37-b08c-135ae82c5148",
                                        "entry_id": "40cd139c-90d8-38b9-a833-aa163588ac52",
                                        "glosses": [
                                            "Gâter par des coups, en parlant de fruits."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb15211-bcc9-4b5b-ba90-7e737657e2aa",
                                                "sense_id": "bb9f0001-3c6c-3d37-b08c-135ae82c5148",
                                                "text": "La grêle a meurtri ces pêches."
                                            },
                                            {
                                                "example_id": "d91d8d17-b164-4f61-b591-fedef5ae7e3b",
                                                "sense_id": "bb9f0001-3c6c-3d37-b08c-135ae82c5148",
                                                "text": "Prenez garde de meurtrir ces poires."
                                            },
                                            {
                                                "example_id": "5435d509-ef78-418c-8bd4-5e505af70b3b",
                                                "sense_id": "bb9f0001-3c6c-3d37-b08c-135ae82c5148",
                                                "text": "Ce fruit s’est meurtri en tombant de l’arbre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
