                        "par hasard",
                        "jeu de hasard"
                    ]
                },
                {
                    "sense_id": "764e5e6c-59ec-3d2d-bc3b-e0777938143b",
                    "sense_definition": "Concours fortuit de circonstances qui amène un événement inattendu.",
