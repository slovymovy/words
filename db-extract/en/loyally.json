                        "examples": [
                            {
                                "example_id": "6a826fe1-6820-4fd2-a633-aa2875fbce32",
                                "sense_id": "e1ad01b6-09f3-3055-b54c-6bf0d501c642",
                                "text": "The old dog loyally followed his master even if he didn't really want to go out."
                            }
                        ]
                    }
