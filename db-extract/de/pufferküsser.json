                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff6911e-fff6-488f-b4fb-c72396887b8d",
                                                "sense_id": "a1b666ad-f16a-37f3-8f6c-dab19d3330a5",
                                                "text": "A previewing railfan pointed out a mistake in the animation showing articulation."
                                            },
                                            {
                                                "example_id": "975cc0fe-2ae5-4ca5-b4c5-89a063415458",
                                                "sense_id": "a1b666ad-f16a-37f3-8f6c-dab19d3330a5",
                                                "text": "From my own experience, I cannot say how one becomes a railfan […]"
                                            },
                                            {
                                                "example_id": "5f9decd3-5a6d-4d5e-b1f8-421504bfdace",
                                                "sense_id": "a1b666ad-f16a-37f3-8f6c-dab19d3330a5",
                                                "text": "A number of US and Canadian book dealers regularly channel British titles to railfan collectors […]"
                                            }
