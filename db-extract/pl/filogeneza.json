                        "source_entry_id": "da567e04-6fee-34be-a1fb-de3c78076a48",
                        "source_sense_id": "a0416ee5-d98f-37cf-8739-5027cb318031",
                        "target_lang_word": "phylogenèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phylogenèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30e2003c-7441-367a-bb55-f75fa14357b3",
                                        "entry_id": "449e8127-a6cf-32df-a10f-8d4393652885",
                                        "glosses": [
                                            "Histoire évolutive d'une espèce ou d'un groupe d'espèces."
                                        ],
                                        "tags": [
                                            "Anatomie comparée"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea9c9ac7-149c-46cf-a943-5b200bd696a3",
                                                "sense_id": "30e2003c-7441-367a-bb55-f75fa14357b3",
                                                "text": "Cette question est intimement liée à une autre, à celle de savoir, si ce sont seulement les processus phylogénétiques particuliers, comme tels, qui sont téléologiquement déterminés, ou bien si la phylogenèse, prise dans son ensemble, constitue un phénomène unique qui, comme tel, est voulu ?"
                                            },
                                            {
                                                "example_id": "68d9e39d-a518-4e7a-bce7-8c427bb442fd",
                                                "sense_id": "30e2003c-7441-367a-bb55-f75fa14357b3",
                                                "text": "On peut proposer plusieurs phylogenèses cohérentes pour cette espèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7796212-c778-3bd3-842b-f1d5fe231b06",
                                        "entry_id": "449e8127-a6cf-32df-a10f-8d4393652885",
                                        "glosses": [
                                            "Discipline scientifique étudiant ce processus."
                                        ],
                                        "tags": [
                                            "Biologie évolutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d5b4367-a593-4d8e-a4d8-00aa04aa29a4",
                                                "sense_id": "e7796212-c778-3bd3-842b-f1d5fe231b06",
                                                "text": "Le crime sexuel réalise un crime contre toutes les humanités. Il efface les constructions historisantes de l’ontogenèse et de la phylogenèse. Sa contingence est transculturelle, transconfessionnelle et transhistorique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b1da18-30e7-398c-a8a4-16a298dd7b72",
                                        "entry_id": "449e8127-a6cf-32df-a10f-8d4393652885",
                                        "glosses": [
                                            "Genèse d'un caractère ou de tout autre chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c198388-4e15-4312-9407-0d4041c1817f",
                                                "sense_id": "94b1da18-30e7-398c-a8a4-16a298dd7b72",
                                                "text": "Voici une représentation de la phylogenèse du système nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4be53db7-39ea-37c1-90db-9a344610e84a",
                                        "entry_id": "449e8127-a6cf-32df-a10f-8d4393652885",
                                        "glosses": [
                                            "Genèse de l’espèce humaine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2901c5c7-5e0c-46ba-a825-b75ad82f4b32",
                        "source_entry_id": "da567e04-6fee-34be-a1fb-de3c78076a48",
