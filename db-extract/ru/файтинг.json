                "senses": [
                    {
                        "sense_id": "4d780c22-f545-3646-9d81-7a3495a452a9",
                        "entry_id": "bbd5dbf0-0473-3dc8-8d55-1cb5a306be23",
                        "glosses": [
                            "жанр компьютерных игр, персонажи которого вступают друг с другом в рукопашный бой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b470afef-90bb-4c94-ad89-60ae31c6b0c1",
                                "sense_id": "4d780c22-f545-3646-9d81-7a3495a452a9",
                                "text": "Удивительно, что главное улучшение игры в части геймплея – коснулось драки. Файтинг из NHL получился что надо, но все же он является достаточно странным бонусом к двадцатилетию серии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b29a360-89f7-4866-90f8-7031d6074718",
                        "source_entry_id": "bbd5dbf0-0473-3dc8-8d55-1cb5a306be23",
                        "source_sense_id": "4d780c22-f545-3646-9d81-7a3495a452a9",
                        "target_lang_word": "fighting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fighting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1afc563f-7b68-3364-a31a-19f7cfad6328",
                                        "entry_id": "987bf315-77c8-3a56-ae1e-499c5b42d3c7",
                                        "glosses": [
                                            "Engaged in war or other conflict."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a50c8ca4-f96d-351f-8a11-8f58053a604a",
                                        "entry_id": "987bf315-77c8-3a56-ae1e-499c5b42d3c7",
                                        "glosses": [
                                            "Apt to provoke a fight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cf6592-cdeb-4c86-aa47-24f3f0ad129a",
                                                "sense_id": "a50c8ca4-f96d-351f-8a11-8f58053a604a",
                                                "text": "It seems like a fighting insult, but he explains."
                                            },
                                            {
                                                "example_id": "3df65cef-5c42-4321-b3a1-fe7862896ba5",
                                                "sense_id": "a50c8ca4-f96d-351f-8a11-8f58053a604a",
                                                "text": "Them's fighting words in my country!"
                                            },
                                            {
                                                "example_id": "fad944ab-b54a-49e2-a282-a3b1b5a6a942",
                                                "sense_id": "a50c8ca4-f96d-351f-8a11-8f58053a604a",
                                                "text": "Those are fighting words, of course, and the people who presently hold the high ground of economic power in society will not be amused."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fighting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34047fcd-7979-3ccf-bd5d-1c2f1c9ff70f",
                                        "entry_id": "3f01ece2-caed-34a0-8a12-64ecfd5fc727",
                                        "glosses": [
                                            "present participle and gerund of fight"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fighting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a329aee0-55ab-39a7-a547-55e0dd183a5c",
                                        "entry_id": "591d74e9-75b6-3583-a5f2-1ca5d1bd789d",
                                        "glosses": [
                                            "The act or process of contending; violence or conflict."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0168a2fc-38e1-3976-982e-654b97a9c3cc",
                                        "entry_id": "591d74e9-75b6-3583-a5f2-1ca5d1bd789d",
                                        "glosses": [
                                            "A fight or battle; an occasion on which people fight"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe214318-b8a9-435d-84be-ca1cd1bc4343",
                                                "sense_id": "0168a2fc-38e1-3976-982e-654b97a9c3cc",
                                                "text": "Then here the warres end, here our fightings marde, Yet by your leave Ile stand upon my Guard."
                                            },
                                            {
                                                "example_id": "830b3ef5-71c5-4bf2-be69-436f029aa6e3",
                                                "sense_id": "0168a2fc-38e1-3976-982e-654b97a9c3cc",
                                                "text": "Seid had fallen in the War of Tabuc, the first of Mahomet's fightings with the Greeks."
                                            },
                                            {
                                                "example_id": "18a7d810-5e01-4b6c-85d9-f3676e3fb975",
                                                "sense_id": "0168a2fc-38e1-3976-982e-654b97a9c3cc",
                                                "text": "A good many soldiers, and some officers, were present; but the expression of our dissent from all wars and fightings had not displeased them, for they shook hands with US most kindly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
