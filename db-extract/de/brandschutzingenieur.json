                "senses": [
                    {
                        "sense_id": "f6bb420b-96a1-36ff-922d-757f9c8b252a",
                        "entry_id": "21a9fe0b-e26e-338d-a1a8-8a2550c18dcd",
                        "glosses": [
                            "anerkannter Fachingenieur, der sich mit dem Feuer- und Rauchschutz auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0cd6c4-f933-44e5-9e13-bcae94734e0f",
                                "sense_id": "f6bb420b-96a1-36ff-922d-757f9c8b252a",
                                "text": "„Was beinhaltet die Richtlinien für Brandschutzingenieure in Singapur?“"
                            },
                            {
                                "example_id": "b7b546e6-2a67-4128-b7cd-ddd012bcaeb0",
                                "sense_id": "f6bb420b-96a1-36ff-922d-757f9c8b252a",
                                "text": "„Es ist somit zentrale Aufgabe des Brandschutzingenieurs, zusammen mit dem Lüftungsplaner abzustimmen, welche Vorgaben mit welchen Maßnahmen eingehalten werden können.“"
                            },
                            {
                                "example_id": "d3f14ede-d7da-4ba0-911e-5db4608b8e3a",
                                "sense_id": "f6bb420b-96a1-36ff-922d-757f9c8b252a",
                                "text": "„Regelmäßig checken Brandschutzingenieure Gebäude, in denen Menschen wohnen, die sich bei einem Feuer nicht selbst retten können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
