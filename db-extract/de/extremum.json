                "senses": [
                    {
                        "sense_id": "aa36590a-4391-32b3-9221-37d02a9c9edf",
                        "entry_id": "770c1bba-ae55-3876-9a47-80dfa94a2213",
                        "glosses": [
                            "Minimum oder Maximum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f017758-a950-4143-bf18-a14c1d62232e",
                                "sense_id": "aa36590a-4391-32b3-9221-37d02a9c9edf",
                                "text": "„Allgemeiner bezeichnet man in der Differentialgeometrie einen Punkt auf einer regulären Kurve als Scheitel oder Scheitelpunkt, wenn die Krümmung dort ein lokales Extremum (also ein lokales Maximum oder Minimum) besitzt.“"
                            },
                            {
                                "example_id": "2ab7027c-1be1-4f76-9df5-59bb4323ca94",
                                "sense_id": "aa36590a-4391-32b3-9221-37d02a9c9edf",
                                "text": "„Mathematisch gesprochen handelt es sich um ein Extremum einer Funktion, die abhängig von beliebigen Parametern in irgendeiner Weise Schlechtes oder Gutes darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "353cca53-874e-4f02-8c7e-e5845f87c63f",
                        "source_entry_id": "770c1bba-ae55-3876-9a47-80dfa94a2213",
                        "source_sense_id": "aa36590a-4391-32b3-9221-37d02a9c9edf",
                        "source_sense_description": "Minimum oder Maximum",
                        "target_lang_word": "extrême",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrême",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6c54d79-3a5c-340d-8cb3-0f08b7a6deeb",
                                        "entry_id": "d2e88a45-1f5f-328d-af71-d66f8aeb0120",
                                        "glosses": [
                                            "Qui est tout à fait au bout, tout à fait le dernier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65bb79d4-8d58-41f7-9d1e-f73f7fe675b2",
                                                "sense_id": "f6c54d79-3a5c-340d-8cb3-0f08b7a6deeb",
                                                "text": "Une promenade d’une dizaine de minutes sur la plate-forme me permet d’entrevoir les hauteurs de la frontière persane à l’extrême limite de l’horizon."
                                            },
                                            {
                                                "example_id": "7040a87b-69b0-4f53-a5e1-5d24d287014f",
                                                "sense_id": "f6c54d79-3a5c-340d-8cb3-0f08b7a6deeb",
                                                "text": "L’extrême vieillesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a9c98b5-47e3-3d7b-9b5c-366ab3cc82a6",
                                        "entry_id": "d2e88a45-1f5f-328d-af71-d66f8aeb0120",
                                        "glosses": [
                                            "Qui est au dernier point, au plus haut degré."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb7e816-cede-4c83-bb82-4d09240c661d",
                                                "sense_id": "0a9c98b5-47e3-3d7b-9b5c-366ab3cc82a6",
                                                "text": "Extrême joie."
                                            },
                                            {
                                                "example_id": "fe93f5f5-9ef3-417e-ae1c-8ea8e8bc5788",
                                                "sense_id": "0a9c98b5-47e3-3d7b-9b5c-366ab3cc82a6",
                                                "text": "Amour, désir extrême."
                                            },
                                            {
                                                "example_id": "e39e803e-2df3-4087-955a-90d23534e010",
                                                "sense_id": "0a9c98b5-47e3-3d7b-9b5c-366ab3cc82a6",
                                                "text": "Péril extrême."
                                            },
                                            {
                                                "example_id": "06d75716-446f-4b87-b87f-1c5ffee4eb58",
                                                "sense_id": "0a9c98b5-47e3-3d7b-9b5c-366ab3cc82a6",
                                                "text": "Extrême misère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97066f47-cf48-3221-b0c4-78e1dd98d26b",
                                        "entry_id": "d2e88a45-1f5f-328d-af71-d66f8aeb0120",
                                        "glosses": [
                                            "Qualifie les moyens énergiques et hasardeux que l’on n’emploie qu’après avoir essayé sans succès tous les autres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac753a2e-7976-40cc-a18f-48c3f9a8df8c",
                                                "sense_id": "97066f47-cf48-3221-b0c4-78e1dd98d26b",
                                                "text": "Le couvre-feu imposé à la population du Québec comme mesure de prévention de la COVID-19 en frustre plus d’un. C’est vrai, il s’agit d’une mesure extrême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "776f5b51-6db9-3530-9a83-7a3c414188c0",
                                        "entry_id": "d2e88a45-1f5f-328d-af71-d66f8aeb0120",
                                        "glosses": [
                                            "Qualifie un parti violent et hasardeux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ffa41ff-932d-4f34-8b0a-081860796fab",
                                                "sense_id": "776f5b51-6db9-3530-9a83-7a3c414188c0",
                                                "text": "Cela dit, à l'intérieur de l'alliance centriste, chacun essaie de conquérir la position la plus forte, ce qui le conduit à s’appuyer dans une certaine mesure sur le parti extrême correspondant à sa tendance."
                                            },
                                            {
                                                "example_id": "b7df8805-bc1e-49da-935a-a40a510eac8e",
                                                "sense_id": "776f5b51-6db9-3530-9a83-7a3c414188c0",
                                                "text": "Tout à la fois thriller haletant et chronique d’une Amérique en crise, le dernier roman de Douglas Kennedy nous plonge dans les réalités socio-économiques d’un pays où les idéologies extrêmes s’affrontent violemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038a2d20-1106-384b-82b1-666eb51e9f4f",
                                        "entry_id": "d2e88a45-1f5f-328d-af71-d66f8aeb0120",
                                        "glosses": [
                                            "Qui est excessif ; qui ne garde aucune mesure ; qui donne toujours dans l’excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a3c245-bfc0-4f3e-9313-4bb08d2204a5",
                                                "sense_id": "038a2d20-1106-384b-82b1-666eb51e9f4f",
                                                "text": "Qu'on y ajoute une liberté extrême laissée aux enfants qui sortent sans solliciter la permission, se déplacent dans la classe à leur gré, […]."
                                            },
                                            {
                                                "example_id": "9bf560dc-da14-48d3-8974-2d57af9b25da",
                                                "sense_id": "038a2d20-1106-384b-82b1-666eb51e9f4f",
                                                "text": "L’empressement des envoyés des puissances pour venir adresser leurs félicitations à la cour des Tuileries avait été extrême."
                                            },
                                            {
                                                "example_id": "dc9a2ef0-cbd3-4408-ae43-7a89b82bb5b0",
                                                "sense_id": "038a2d20-1106-384b-82b1-666eb51e9f4f",
                                                "text": "Le service vante la défense de la liberté d'expression, accueillant des discours extrêmes, rejetés par les plateformes généralistes comme Facebook et Twitter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e36b184b-aee5-3299-9365-536048afb5ea",
                                        "entry_id": "d2e88a45-1f5f-328d-af71-d66f8aeb0120",
                                        "glosses": [
                                            "Qui partage un segment selon une règle proportionnelle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2acc4d4-21d2-4c9d-830b-47121eb69034",
                                                "sense_id": "e36b184b-aee5-3299-9365-536048afb5ea",
                                                "text": "Il faut couper selon la moyenne & extrême raison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extrême",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "008446f4-b2b7-3491-86d8-475c1d502aa2",
                                        "entry_id": "0076bdfc-fcf4-37ee-a6bf-6573620d95b5",
                                        "glosses": [
                                            "Ce qui est opposé, contraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde1ec03-ef2b-4d0c-90b4-6cecbe6e15f0",
                                                "sense_id": "008446f4-b2b7-3491-86d8-475c1d502aa2",
                                                "text": "Le froid et le chaud sont les deux extrêmes."
                                            },
                                            {
                                                "example_id": "f0bc039a-c1df-4a17-8753-0aa1df90d9cb",
                                                "sense_id": "008446f4-b2b7-3491-86d8-475c1d502aa2",
                                                "text": "Si l'on suit les magazines de mode, la garde-robe de la fashion victim devrait changer toutes les semaines en passant d'un extrême à un autre, du rose au bleu canard qui seront complètement démodés dans un mois."
                                            },
                                            {
                                                "example_id": "f066047f-7dad-43df-9ed1-43f0444825b2",
                                                "sense_id": "008446f4-b2b7-3491-86d8-475c1d502aa2",
                                                "text": "La prodigalité et l’avarice sont les deux extrêmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45b9bcfe-1dc5-3aa7-b6d9-09acd576b082",
                                        "entry_id": "0076bdfc-fcf4-37ee-a6bf-6573620d95b5",
                                        "glosses": [
                                            "Parti situé aux extrémités du spectre politique. (Cf. extrême gauche et extrême droite.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133d2706-95ca-4342-b408-6c59345542b5",
                                                "sense_id": "45b9bcfe-1dc5-3aa7-b6d9-09acd576b082",
                                                "text": "En désespoir de cause, la population se tourne vers les extrêmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a34168-3e10-3ae5-9d88-679897d35811",
                                        "entry_id": "0076bdfc-fcf4-37ee-a6bf-6573620d95b5",
                                        "glosses": [
                                            "Le premier ou le dernier terme d’une proportion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b5003f-2e41-450a-9c79-deab4acb665c",
                                                "sense_id": "42a34168-3e10-3ae5-9d88-679897d35811",
                                                "text": "Dans toute proportion arithmétique, le produit des extrêmes est égal à celui des moyens. (Produit en croix)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b5029a-f015-375f-96b9-ccb5a4790c30",
                                        "entry_id": "0076bdfc-fcf4-37ee-a6bf-6573620d95b5",
                                        "glosses": [
                                            "L'un des deux termes du syllogisme, le grand ou le petit, par opposition au moyen."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
