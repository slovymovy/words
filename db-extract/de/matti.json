                                "example_id": "5ce02a4c-ade6-4b88-be55-932f4c2014d7",
                                "sense_id": "2e9fa4a0-8098-3fc9-b98f-f01b8f65c933",
                                "text": "Heute erblickte Matti das Licht der Welt."
                            },
                            {
                                "example_id": "ebc9e14c-c48b-48ad-adef-793dae55d9c0",
                                "sense_id": "2e9fa4a0-8098-3fc9-b98f-f01b8f65c933",
                                "text": "„Ich bin der Matti Altonen und freu mich, Ihre Bekanntschaft zu machen.“"
                            },
                            {
                                "example_id": "37b7cacd-4d06-40eb-ae75-801b1285c3ba",
                                "sense_id": "2e9fa4a0-8098-3fc9-b98f-f01b8f65c933",
                                "text": "„Matti gehört seit Mitte der 1990er Jahre zu den verbreiteten Vornamen in Deutschland.“"
                            }
                        ],
