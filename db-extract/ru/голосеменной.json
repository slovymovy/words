                "senses": [
                    {
                        "sense_id": "90c5a32f-1298-3577-8b07-6897378cdf51",
                        "entry_id": "6d820be8-98de-3a49-a636-b2d418424c45",
                        "glosses": [
                            "ботан. принадлежащий к группе семенных растений, к которой относятся хвойные и им подобные растения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82738bdc-4d38-4720-b3d6-c4aa05bd8fb6",
                                "sense_id": "90c5a32f-1298-3577-8b07-6897378cdf51",
                                "text": "В качестве предков голосеменных, купула которых могла бы трансформироваться в наружный интегумент беннеттитовых и покрытосеменных, рассматривают такие таксоны, как Lagenostomales и Corystospermaceae."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b84026f9-3ecb-4d31-85e5-d9ea2ef04e23",
                        "source_entry_id": "6d820be8-98de-3a49-a636-b2d418424c45",
                        "source_sense_id": "90c5a32f-1298-3577-8b07-6897378cdf51",
                        "target_lang_word": "gymnosperm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gymnosperm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "009f07f0-2439-3dc6-a060-b5e49166005d",
                                        "entry_id": "855917e4-7de0-3c66-bd3f-787ae2ba0862",
                                        "glosses": [
                                            "Any plant such as a conifer whose seeds are not enclosed in an ovary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75903692-d632-482f-8251-89f017f6f50d",
                                                "sense_id": "009f07f0-2439-3dc6-a060-b5e49166005d",
                                                "text": "Like cycads — their gymnosperm relatives — and ferns, the ginkgo produces motile sperm."
                                            },
                                            {
                                                "example_id": "6074763b-8687-44be-9fe1-a1fcde8db89e",
                                                "sense_id": "009f07f0-2439-3dc6-a060-b5e49166005d",
                                                "text": "The palynoassemblage is rich in angiosperm taxa (45.63%) followed by gymnosperms (0.45%), pteridophytes (18.49%) and fungal remains (23.88%)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
