                "senses": [
                    {
                        "sense_id": "5fee1c1e-1c78-3c1d-8cf2-91db37612f63",
                        "entry_id": "fea70f6c-7525-3494-86a6-3af43b676fa5",
                        "glosses": [
                            "Ventiler moins que la normale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cf0c1460-14c0-37f6-9e39-faf1487a0e11",
                        "entry_id": "fea70f6c-7525-3494-86a6-3af43b676fa5",
                        "glosses": [
                            "Respirer moins rapidement et moins profondément que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab11f317-9d86-4ce7-8b71-2f3ab3a8ff8b",
                                "sense_id": "cf0c1460-14c0-37f6-9e39-faf1487a0e11",
                                "text": "Sa circulation sanguine s'effectue mal, il est hypo-ventilé d'où le gros problème d'assoupissement, d'hypovigilance et de somnolence si souvent constaté."
                            },
                            {
                                "example_id": "977d1644-0902-417f-8e53-f958684a2f7a",
                                "sense_id": "cf0c1460-14c0-37f6-9e39-faf1487a0e11",
                                "text": "Entre les périodes de contractions, on assiste à des périodes de repos lors desquels la femme a tendance à hypo-ventiler."
                            },
                            {
                                "example_id": "3de2ca06-2dec-44b3-9b91-de7a6b5bdff6",
                                "sense_id": "cf0c1460-14c0-37f6-9e39-faf1487a0e11",
                                "text": "Les mutants Olig3 n'arrivent pas à développer leur respiration et hypo-ventilent rapidement."
                            }
                        ]
                    }
