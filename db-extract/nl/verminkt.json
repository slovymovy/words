                    {
                        "translation_id": "56ad5ad5-5f8c-4bca-b269-496eb39a1156",
                        "source_entry_id": "425237ed-3e3f-32d2-af26-82ae827c6e75",
                        "source_sense_id": "1aad1a71-b806-3fb3-909b-960c6e7a8c54",
                        "target_lang_word": "infirm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infirm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4362b17c-d93d-344b-b945-3bb1401c40d5",
                                        "entry_id": "2fb67fb1-c3bd-3f81-82d0-ba862ce292ab",
                                        "glosses": [
                                            "Weak or ill, not in good health."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c7c0aa-17e2-476a-901e-dc23ce50c2b5",
                                                "sense_id": "4362b17c-d93d-344b-b945-3bb1401c40d5",
                                                "text": "He was infirm of body but still keen of mind, and though it looked like he couldn't walk across the room, he crushed me in debate."
                                            },
                                            {
                                                "example_id": "eef1eade-f8ba-4351-a566-e4042b28f9ee",
                                                "sense_id": "4362b17c-d93d-344b-b945-3bb1401c40d5",
                                                "text": "[…] Here I stand your slave,\nA poor, infirm, weak, and despis’d old man."
                                            },
                                            {
                                                "example_id": "fd62f634-9f5f-4a61-9797-538f3e739f9a",
                                                "sense_id": "4362b17c-d93d-344b-b945-3bb1401c40d5",
                                                "text": "There will be special drop-off points at all polling stations for vehicles conveying voters who are sick, infirm, or disabled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0e8fd4c-0e63-3586-94a4-fd403e365ea4",
                                        "entry_id": "2fb67fb1-c3bd-3f81-82d0-ba862ce292ab",
                                        "glosses": [
                                            "Irresolute; weak of mind or will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d73fd566-4299-47b9-94f9-27463737cdcd",
                                                "sense_id": "e0e8fd4c-0e63-3586-94a4-fd403e365ea4",
                                                "text": "Infirm of purpose!\nGive me the daggers: […]"
                                            },
                                            {
                                                "example_id": "2999cb41-6df7-4362-bc96-d3c29767381f",
                                                "sense_id": "e0e8fd4c-0e63-3586-94a4-fd403e365ea4",
                                                "text": "[…] vehement passion does not always indicate an infirm judgment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13eec1d2-71ec-3ced-b9db-9ed1971beee9",
                                        "entry_id": "2fb67fb1-c3bd-3f81-82d0-ba862ce292ab",
                                        "glosses": [
                                            "Frail; unstable; insecure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d545e78-ff62-448f-a5e0-563048e51c74",
                                                "sense_id": "13eec1d2-71ec-3ced-b9db-9ed1971beee9",
                                                "text": "He who fixes upon false Principles, treads upon Infirm ground, and so sinks […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "infirm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0710e3b5-937a-3fed-b269-c0ad446c5d07",
                                        "entry_id": "3e1b1a34-2e81-30ad-aca1-8ad8a313c46f",
                                        "glosses": [
                                            "To contradict, to provide proof that something is not."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27fcadf4-9ebf-46d9-b875-1ecfdb671ccf",
                                                "sense_id": "0710e3b5-937a-3fed-b269-c0ad446c5d07",
                                                "text": "The thought is that you see an episode of observation, experiment, or reasoning as confirming or infirming a hypothesis depending on whether your probability for it increases or decreases during the episode."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
