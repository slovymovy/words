                    {
                        "sense_id": "9cc78101-f75d-3d9b-bb9c-0e415ad525f7",
                        "entry_id": "22e02cb4-4174-3011-b3cc-3a5626cf89c0",
                        "glosses": [
                            "Qui s’occupe de colombophilie, l'art d’élever et de dresser des pigeons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c071e9c-2bd7-46d4-9aa6-d9c3957a42d6",
                                "sense_id": "9cc78101-f75d-3d9b-bb9c-0e415ad525f7",
                                "text": "Ces sociétés colombophiles n'ont d'autre but que de répartir sur un grand nombre de sociétaires, d'alléger, par suite, les frais très-dispendieux de l'éducation et d'entraînement des pigeons voyageurs et de stimuler l'émulation des gens qui les élèvent par des récompenses souvent considérables."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3311faea-85d5-373f-beec-7d449921abb2",
