                        "cross_references": [
                            {
                                "target_word": "Antimon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f8d2175-7dd4-328a-b5c8-a2232b069c55",
                                        "entry_id": "8e40f808-7d8b-35d1-95f8-5594017bea23",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 51, das zu den Halbmetallen gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bad807b-4622-4530-92c0-369ee0e5da44",
                                                "sense_id": "5f8d2175-7dd4-328a-b5c8-a2232b069c55",
                                                "text": "„Der Diener Hubermann wiegt Antimon und Blei ab.“"
                                            },
                                            {
                                                "example_id": "84b0f68f-0931-4ead-b7f0-463fc3341fd7",
                                                "sense_id": "5f8d2175-7dd4-328a-b5c8-a2232b069c55",
                                                "text": "Antimon wurde in Form seiner Verbindungen schon in der Bronzezeit als Zuschlag zu Kupfer verwendet, um Bronze herzustellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba85eae3-511d-4d02-9b55-fe3f3c2a149c",
                        "source_entry_id": "65bfa2f9-1f79-3aeb-9f31-f9c8f99f4fe4",
                        "source_sense_id": "c9bf56c8-80d0-325c-8343-df28b5974cf3",
                        "target_lang_word": "antimony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6b787e6-edef-35fa-a4e4-e4d6a5dbb9dc",
                                        "entry_id": "d34615d2-53f9-30ca-8787-cf2104bc804d",
                                        "glosses": [
                                            "A chemical element (symbol Sb, from Latin stibium) with an atomic number of 51: in its stable allotrope, a lustrous gray and very brittle metal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19323fe-578f-4a5a-b6d6-de7ba91686b3",
                                                "sense_id": "c6b787e6-edef-35fa-a4e4-e4d6a5dbb9dc",
                                                "text": "Deep in the Salmon River Mountains, an Idaho mining company, Perpetua Resources, is proposing a vast open-pit gold mine that would also produce 115 million pounds of antimony — an element that may be critical to manufacturing the high-capacity liquid-metal batteries of the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70bea33b-b861-3aea-8f0a-09a373abbca9",
                                        "entry_id": "d34615d2-53f9-30ca-8787-cf2104bc804d",
                                        "glosses": [
                                            "The alloy stibnite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa9a684-4a87-4c45-9092-26ea2e4677c6",
                                                "sense_id": "70bea33b-b861-3aea-8f0a-09a373abbca9",
                                                "text": "In quality synergistic additives in a composition use oxide antimonies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3aa4f62-60b0-407c-9dba-3021c8c7cd78",
                        "source_entry_id": "65bfa2f9-1f79-3aeb-9f31-f9c8f99f4fe4",
                        "source_sense_id": "c9bf56c8-80d0-325c-8343-df28b5974cf3",
                        "target_lang_word": "antimoine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimoine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2637a82f-a7b6-3dad-87ba-8b340139ddca",
                                        "entry_id": "8c9b0470-966d-3883-b5f1-21e0d9c2941f",
                                        "glosses": [
                                            "Élément chimique dont on fait différentes préparations dans la pharmacie, telles que l’émétique. Son numéro atomique est le 51 et son symbole Sb ; il fait partie de la série des métalloïdes. Il est aussi utilisé comme ignifugeant dans l’industrie automobile et aéronautique."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a65bc67-fa6b-4ed9-997c-388d34fe994c",
                                                "sense_id": "2637a82f-a7b6-3dad-87ba-8b340139ddca",
                                                "text": "L'étain, le plomb, le bismuth, l’antimoine, qui sont séparés pendant la dissolution ou la sursaturation par l'hydroxyde d’ammonium, sont sans influence sur le résultat."
                                            },
                                            {
                                                "example_id": "e7913637-c06f-4f32-8b37-04f8b02fb42c",
                                                "sense_id": "2637a82f-a7b6-3dad-87ba-8b340139ddca",
                                                "text": "On a constaté que la cellulose sous forme de papier-filtre est soluble dans les solutions aqueuses concentrées de certains sels, tel que ceux d’antimoine, chlorure d’étain, bromure de zinc."
                                            },
                                            {
                                                "example_id": "4ec9dd78-a68c-44fb-bda7-d29d6f1a98bc",
                                                "sense_id": "2637a82f-a7b6-3dad-87ba-8b340139ddca",
                                                "text": "Aujourd’hui, avant le vôtre, j’ai déjà reçu, de S. E. Brahim el Glaoui, un flacon venu de Marrakech, empli de l’antimoine gris, tendre et pailleté dont je ne sais s’il faut l’appeler kohl, koheul ou mokoheul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab543014-7e4f-3981-a97b-627f463587ad",
                                        "entry_id": "8c9b0470-966d-3883-b5f1-21e0d9c2941f",
                                        "glosses": [
                                            "Métal de cet élément, très fragile, brillant, d’un blanc bleuâtre et d’une texture lamelleuse."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c947844-3111-4310-8905-391179965125",
                                                "sense_id": "ab543014-7e4f-3981-a97b-627f463587ad",
                                                "text": "Une caravane arrivait de Kirman, convoyant plus de six cents marchands et pèlerins, ainsi qu’une importante cargaison d’antimoine."
                                            },
                                            {
                                                "example_id": "1a3f8d71-64f3-498e-96bf-d87e7ddd343c",
                                                "sense_id": "ab543014-7e4f-3981-a97b-627f463587ad",
                                                "text": "La ville de Xikuangshan, où se situe la mine du même nom, est connue comme « capitale mondiale de l’ antimoine ». Les réserves s’y chiffrent en centaines de milliers de tonnes d’ antimoine métal. Notons parmi les autres pays exploitant encore l’ antimoine de nos jours, la Bolivie et la Russie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
