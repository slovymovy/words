                                                "sense_id": "cd772aa1-449d-3ba4-a485-aecbb012cda4",
                                                "text": "Der Muskelprotz saß draußen auf der Bank und hob schwitzend seine Hanteln, um vor den Mädchen anzugeben."
                                            },
                                            {
                                                "example_id": "18fe1db5-f23f-44f8-9669-497f6fa78f61",
                                                "sense_id": "cd772aa1-449d-3ba4-a485-aecbb012cda4",
                                                "text": "„Von meinem Geburtstagsgeld wollte ich mir in Koblenz Hanteln kaufen, aber zwei waren mir zu teuer, und ich kaufte nur eine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
