                ],
                "senses": [
                    {
                        "sense_id": "dd6eb805-2bbf-3327-ab7a-2604a78193ef",
                        "entry_id": "a56c95d1-f743-3e1b-bfe9-57a906a1a64e",
                        "glosses": [
                            "Notule qui termine un texte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "633d3b41-09d2-4aa3-a4a6-f5200e86db43",
                                "sense_id": "dd6eb805-2bbf-3327-ab7a-2604a78193ef",
                                "text": "C’est au contraire un disque salvateur, qui rend ses lettres de noblesse à des textes parfois oubliés comme le postambule de la Déclaration des droits de la femme et de la citoyenne d’Olympe de Gouges (1791), le discours lors du débat du droit au travail d’Alexandre Ledru-Rollin (1848), celui d’Hubertine Auclert lors du troisième congrès ouvrier socialiste de Marseille (1879)."
                            },
                            {
                                "example_id": "2cac6e41-296f-4960-99b4-40a3a0d6b3ad",
                                "sense_id": "dd6eb805-2bbf-3327-ab7a-2604a78193ef",
                                "text": "Tous nos articles comportent trois sections : un préambule, le corps du texte et un postambule."
                            }
                        ]
                    },
                    {
                        "sense_id": "30bb7f81-b0e2-3b4b-825e-432cacdff842",
                        "entry_id": "a56c95d1-f743-3e1b-bfe9-57a906a1a64e",
                        "glosses": [
                            "Code de programmation qui termine un programme ou un sous-programme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edf08a92-6b21-4f79-a08b-ac3412e4e66e",
                                "sense_id": "30bb7f81-b0e2-3b4b-825e-432cacdff842",
                                "text": "Une trame est composée d’un header, des informations que l’on veut transmettre, et d’un postambule (trailer)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5aac8e5-a171-4712-933e-ad8584a907ca",
                        "source_entry_id": "a56c95d1-f743-3e1b-bfe9-57a906a1a64e",
                        "source_sense_id": "dd6eb805-2bbf-3327-ab7a-2604a78193ef",
